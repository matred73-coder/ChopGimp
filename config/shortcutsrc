# GIMP shortcutsrc — PhotoGIMP Pro v2 (raccourcis Photoshop)
# Généré par tools/build_shortcuts.py — ne pas éditer à la main.
# Les actions absentes gardent leur raccourci GIMP par défaut.

(file-version 1)


# ── Outils ──────────────────────────────────────────────────────
# Déplacement
(action "tools-move" "v")
# Alignement (groupe Déplacement)
(action "tools-align" "<Shift>v")
# Rectangle de sélection
(action "tools-rect-select" "m")
# Ellipse de sélection
(action "tools-ellipse-select" "<Shift>m")
# Lasso
(action "tools-free-select" "l")
# Lasso magnétique (ciseaux intelligents)
(action "tools-iscissors" "<Shift>l")
# Baguette magique
(action "tools-fuzzy-select" "w")
# Sélection d'objet / rapide (premier plan)
(action "tools-foreground-select" "<Shift>w")
# Plage de couleurs
(action "tools-by-color-select" "<Shift><Alt>w")
# Recadrage
(action "tools-crop" "c")
# Recadrage perspective
(action "tools-perspective" "<Shift>c")
# Pipette
(action "tools-color-picker" "i")
# Règle
(action "tools-measure" "<Shift>i")
# Correcteur
(action "tools-heal" "j")
# Pinceau
(action "tools-paintbrush" "b")
# Crayon
(action "tools-pencil" "<Shift>b")
# Aérographe
(action "tools-airbrush" "<Shift><Alt>b")
# Pinceau MyPaint
(action "tools-mypaint-brush" "<Primary><Alt>b")
# Tampon de duplication
(action "tools-clone" "s")
# Tampon de motif / perspective
(action "tools-perspective-clone" "<Shift>s")
# Gomme
(action "tools-eraser" "e")
# Dégradé
(action "tools-gradient" "g")
# Pot de peinture
(action "tools-bucket-fill" "<Shift>g")
# Goutte d'eau / Netteté (R libre : pas de rotation de vue)
(action "tools-convolve" "r")
# Doigt
(action "tools-smudge" "<Shift>r")
# Densité − / +
(action "tools-dodge-burn" "o")
# Plume
(action "tools-path" "p")
# Texte
(action "tools-text" "t")
# Zoom
(action "tools-zoom" "z")
# Transformation manuelle (Ctrl+T)
(action "tools-unified-transform" "<Primary>t")
# Mise à l'échelle
(action "tools-scale" "<Primary><Alt>t")
# Rotation
(action "tools-rotate" "<Shift>t")
# Fluidité (déformation)
(action "tools-warp" "<Shift><Primary>x")
# Déformation de la marionnette (cage)
(action "tools-cage" "<Shift><Alt>t")

# ── Couleurs ────────────────────────────────────────────────────
# Couleurs par défaut
(action "context-colors-default" "d")
# Permuter premier plan / arrière-plan
(action "context-colors-swap" "x")
# Mode masque
(action "quick-mask-toggle" "q")

# ── Pinceau ─────────────────────────────────────────────────────
# Diminuer la taille [
(action "tools-size-decrease" "bracketleft")
# Augmenter la taille ]
(action "tools-size-increase" "bracketright")
# Diminuer la dureté
(action "tools-hardness-decrease" "<Shift>bracketleft")
# Augmenter la dureté
(action "tools-hardness-increase" "<Shift>bracketright")

# ── Fichier ─────────────────────────────────────────────────────
# Nouveau
(action "image-new" "<Primary>n")
# Ouvrir
(action "file-open" "<Primary>o")
# Importer (ouvrir en calques)
(action "file-open-as-layers" "<Primary><Shift><Alt>o")
# Fermer
(action "view-close" "<Primary>w")
# Tout fermer
(action "file-close-all" "<Primary><Alt>w")
# Enregistrer
(action "file-save" "<Primary>s")
# Enregistrer sous
(action "file-save-as" "<Primary><Shift>s")
# Exporter sous
(action "file-export-as" "<Primary><Shift><Alt>w")
# Exporter (ancien Enregistrer pour le Web)
(action "file-export" "<Primary><Shift><Alt>s")
# Quitter
(action "file-quit" "<Primary>q")

# ── Édition ─────────────────────────────────────────────────────
# Annuler
(action "edit-undo" "<Primary>z")
# Rétablir
(action "edit-redo" "<Primary><Shift>z")
# Annuler (pas à pas)
(action "edit-strong-undo" "<Primary><Alt>z")
# Couper
(action "edit-cut" "<Primary>x")
# Copier
(action "edit-copy" "<Primary>c")
# Copier avec fusion
(action "edit-copy-visible" "<Primary><Shift>c")
# Coller
(action "edit-paste" "<Primary>v")
# Coller sur place
(action "edit-paste-in-place" "<Primary><Shift>v")
# Coller dedans
(action "edit-paste-into" "<Primary><Shift><Alt>v")
# Coller comme nouvelle image
(action "edit-paste-as-new-image" "<Primary><Alt>v")
# Effacer
(action "edit-clear" "Delete")
# Remplir avec la couleur de premier plan
(action "edit-fill-fg" "<Alt>BackSpace")
# Remplir avec la couleur d'arrière-plan
(action "edit-fill-bg" "<Primary>BackSpace")
# Préférences
(action "dialogs-preferences" "<Primary>k")
# Raccourcis clavier
(action "dialogs-keyboard-shortcuts" "<Primary><Shift><Alt>k")

# ── Image ───────────────────────────────────────────────────────
# Niveaux
(action "filters-levels" "<Primary>l")
# Courbes
(action "filters-curves" "<Primary>m")
# Teinte / Saturation
(action "filters-hue-saturation" "<Primary>u")
# Balance des couleurs
(action "filters-color-balance" "<Primary>b")
# Désaturation
(action "filters-desaturate" "<Primary><Shift>u")
# Négatif
(action "filters-invert-perceptual" "<Primary>i")
# Seuil
(action "filters-threshold" "<Primary><Shift><Alt>t")
# Tons auto
(action "drawable-levels-stretch" "<Primary><Shift>l")
# Luminosité / Contraste
(action "filters-brightness-contrast" "<Primary><Alt>l")
# Taille de l'image
(action "image-scale" "<Primary><Alt>i")
# Taille de la zone de travail
(action "image-resize" "<Primary><Alt>c")
# Recadrer sur la sélection
(action "image-crop-to-selection" "<Primary><Alt>x")
# Dupliquer l'image
(action "image-duplicate" "<Primary><Shift><Alt>d")

# ── Calque ──────────────────────────────────────────────────────
# Nouveau calque
(action "layers-new" "<Primary><Shift>n")
# Dupliquer le calque (Calque par copie)
(action "layers-duplicate" "<Primary>j")
# Grouper les calques
(action "layers-new-group" "<Primary>g")
# Fusionner avec le calque inférieur
(action "layers-merge-down" "<Primary>e")
# Fusionner les calques visibles
(action "image-merge-layers" "<Primary><Shift>e")
# Aplatir l'image
(action "image-flatten" "<Primary><Shift><Alt>e")
# Premier plan d'un niveau
(action "layers-raise" "<Primary>bracketright")
# Arrière-plan d'un niveau
(action "layers-lower" "<Primary>bracketleft")
# Premier plan
(action "layers-raise-to-top" "<Primary><Shift>bracketright")
# Arrière-plan
(action "layers-lower-to-bottom" "<Primary><Shift>bracketleft")
# Sélectionner le calque du dessus
(action "layers-select-previous" "<Alt>bracketright")
# Sélectionner le calque du dessous
(action "layers-select-next" "<Alt>bracketleft")
# Ajouter un masque de fusion
(action "layers-mask-add" "<Primary><Alt>m")
# Ancrer la sélection flottante
(action "layers-anchor" "<Primary><Alt>h")

# ── Sélection ───────────────────────────────────────────────────
# Tout sélectionner
(action "select-all" "<Primary>a")
# Désélectionner
(action "select-none" "<Primary>d")
# Intervertir
(action "select-invert" "<Primary><Shift>i")
# Contour progressif
(action "select-feather" "<Shift>F6")
# Calque par coupure (sélection flottante)
(action "select-cut-float" "<Primary><Shift>j")

# ── Filtre ──────────────────────────────────────────────────────
# Dernier filtre
(action "filters-repeat" "<Primary><Alt>f")
# Réafficher le dernier filtre
(action "filters-reshow" "<Primary><Shift><Alt>f")

# ── Affichage ───────────────────────────────────────────────────
# Zoom avant
(action "view-zoom-in" "<Primary>plus" "<Primary>equal" "<Primary>KP_Add")
# Zoom arrière
(action "view-zoom-out" "<Primary>minus" "<Primary>KP_Subtract")
# Taille écran
(action "view-zoom-fit-in" "<Primary>0" "<Primary>KP_0")
# 100 %
(action "view-zoom-1-1" "<Primary>1" "<Primary><Alt>0")
# Règles
(action "view-show-rulers" "<Primary>r")
# Repères
(action "view-show-guides" "<Primary>semicolon")
# Grille
(action "view-show-grid" "<Primary>apostrophe")
# Magnétisme
(action "view-snap-to-guides" "<Primary><Shift>semicolon")
# Extras (afficher la sélection)
(action "view-show-selection" "<Primary>h")
# Mode plein écran
(action "view-fullscreen" "f" "F11")
# Masquer les panneaux
(action "windows-hide-docks" "Tab")
# Réinitialiser la rotation
(action "view-rotate-reset" "<Shift>Escape")

# ── Fenêtre ─────────────────────────────────────────────────────
# Pinceaux
(action "dialogs-brushes" "F5")
# Couleur
(action "dialogs-colors" "F6")
# Calques
(action "dialogs-layers" "F7")
# Infos
(action "dialogs-cursor" "F8")
# Historique
(action "dialogs-undo-history" "<Alt>F9")

# ── Raccourcis GIMP libérés (touche reprise par un raccourci Photoshop) ──
# était : <primary>G
(action "dialogs-gradients")
# était : <primary>B
(action "dialogs-toolbox")
# était : <primary>semicolon
(action "edit-fill-pattern")
# était : <primary><alt><shift>O
(action "file-open-as-link-layers")
# était : <primary><alt>F
(action "file-show-in-file-manager")
# était : <shift>V
(action "paths-selection-from-paths")
# était : <shift>L
(action "tools-handle-transform")
# était : <shift>W
(action "tools-transform-3d")
# était : <primary>J
(action "view-shrink-wrap")

# end of shortcutsrc
