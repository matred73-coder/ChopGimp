# ── PhotoGIMP Pro : réglages d'usine façon Photoshop ──────────────────
(theme "PS-Dark")
(theme-color-scheme dark)
(icon-theme "PS-Line")
(prefer-symbolic-icons yes)
(toolbox-wilber no)
(toolbox-color-area yes)
(toolbox-foo-area no)
(toolbox-image-area no)
(toolbox-groups yes)
(layer-preview-size medium)
(show-tool-tips yes)
(default-view
    (show-menubar yes)
    (show-statusbar yes)
    (show-rulers yes)
    (show-scrollbars yes)
    (show-selection yes)
    (show-layer-boundary no)
    (show-canvas-boundary no)
    (show-guides yes)
    (show-grid no)
    (show-sample-points yes)
    (snap-to-guides yes)
    (snap-to-grid no)
    (snap-to-canvas yes)
    (snap-to-bbox yes)
    (snap-to-equidistance yes)
    (padding-mode custom)
    (padding-color (color-rgb 0.118 0.118 0.118))
    (padding-in-show-all no))
(default-fullscreen-view
    (show-menubar yes)
    (show-statusbar yes)
    (show-rulers yes)
    (show-scrollbars yes)
    (show-selection yes)
    (show-layer-boundary no)
    (show-canvas-boundary no)
    (show-guides yes)
    (show-grid no)
    (show-sample-points yes)
    (snap-to-guides yes)
    (snap-to-grid no)
    (snap-to-canvas yes)
    (snap-to-bbox yes)
    (snap-to-equidistance yes)
    (padding-mode custom)
    (padding-color (color-rgb 0.118 0.118 0.118))
    (padding-in-show-all no))
(default-image
    (width 1920)
    (height 1080)
    (unit pixels)
    (xresolution 72)
    (yresolution 72)
    (resolution-unit inches)
    (image-type rgb)
    (precision u8-non-linear)
    (fill-type white))
