# GIMP sessionrc — ChopGimp (espace de travail « Peinture »)
# Généré par tools/build_layout.py. L'installeur conserve la position/taille
# de votre fenêtre principale ; GIMP réécrit ce fichier à chaque fermeture.

(session-info "toplevel"
    (factory-entry "gimp-single-image-window")
    @GEOMETRY@
    (open-on-exit)
    (aux-info
        (left-docks-width "46")
        (right-docks-width "330")
        (maximized "yes"))
    (gimp-toolbox
        (side left))
    (gimp-dock
        (side right)
        (book
            (current-page 0)
            (dockable "gimp-color-editor"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-palette-editor"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-pattern-grid"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true"))))
        (book
            (position 250)
            (current-page 0)
            (dockable "gimp-brush-grid"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-mypaint-brush-grid"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-tool-preset-list"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-dynamics-list"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true"))))
        (book
            (position 330)
            (current-page 0)
            (dockable "gimp-layer-list"
                (tab-style name)
                (preview-size 64)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-navigation-view"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-symmetry-editor"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true"))))))

(hide-docks no)
(single-window-mode yes)
(show-tabs yes)
(tabs-position 0)
(last-tip-shown 0)

# end of sessionrc
