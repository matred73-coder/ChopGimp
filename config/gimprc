# GIMP gimprc — PhotoGIMP Pro
#
# Optimized configuration with Photoshop-like defaults.
# Higher undo levels, larger cache, better interpolation,
# Photoshop-style canvas padding, and professional defaults.

(config-version "3.0.0")

# Performance
(undo-levels 60)
(undo-size 256M)
(tile-cache-size 4096M)
(num-processors 8)
(swap-compression fast)

# Interpolation: cubic (high quality by default)
(interpolation-type cubic)

# Canvas / View — Photoshop-style gray canvas padding
(default-view
    (show-menubar yes)
    (show-statusbar yes)
    (show-rulers yes)
    (show-scrollbars yes)
    (show-selection yes)
    (show-layer-boundary no)
    (show-canvas-boundary no)
    (show-guides yes)
    (show-grid no)
    (show-sample-points yes)
    (snap-to-guides yes)
    (snap-to-grid no)
    (snap-to-canvas yes)
    (snap-to-path no)
    (snap-to-bbox no)
    (snap-to-equidistance no)
    (padding-mode custom)
    (padding-color (color-rgb 0.184314 0.184314 0.184314))
    (padding-in-show-all no)
    (fullscreen yes))

(default-fullscreen-view
    (show-menubar yes)
    (show-statusbar yes)
    (show-rulers yes)
    (show-scrollbars yes)
    (show-selection yes)
    (show-layer-boundary no)
    (show-canvas-boundary no)
    (show-guides yes)
    (show-grid no)
    (show-sample-points yes)
    (snap-to-guides yes)
    (snap-to-grid no)
    (snap-to-canvas yes)
    (snap-to-path no)
    (snap-to-bbox no)
    (snap-to-equidistance no)
    (padding-mode custom)
    (padding-color (color-rgb 0.184314 0.184314 0.184314))
    (padding-in-show-all no))

# Previews — large for better visibility
(layer-preview-size extra-large)
(undo-preview-size large)
(navigation-preview-size large)
(thumbnail-size large)

# Toolbox
(toolbox-foo-area yes)

# Image defaults
(default-image
    (width 1920)
    (height 1080)
    (unit pixels)
    (xresolution 72.000000)
    (yresolution 72.000000)
    (resolution-unit inches)
    (image-type rgb)
    (precision u8-non-linear)
    (fill-type background))

# Save/Export behavior
(export-file-type chosen)
(confirm-on-close yes)

# Appearance
(theme "Dark")
(icon-theme "Symbolic")
(icon-size medium)
(font-relative-size 1.0)

# Fill/Stroke defaults
(fill-options
    (style fg-color)
    (custom-style solid-color)
    (antialias yes)
    (feather no)
    (feather-radius 10))
(stroke-options
    (style fg-color)
    (custom-style solid-color)
    (antialias yes)
    (feather no)
    (feather-radius 10)
    (method line)
    (width 6)
    (unit pixels)
    (cap-style butt)
    (join-style miter)
    (miter-limit 10)
    (dash-offset 0)
    (dash-info 0)
    (emulate-brush-dynamics no))

# Import/Export
(import-raw-plug-in "${gimp_plug_in_dir}/plug-ins/file-raw-placeholder/file-raw-placeholder")

# end of gimprc
