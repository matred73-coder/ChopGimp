# GIMP sessionrc — PhotoGIMP Pro v2 (espace de travail « Essentiel »)
# Généré par tools/build_layout.py. L'installeur conserve la position/taille
# de votre fenêtre principale ; GIMP réécrit ce fichier à chaque fermeture.

(session-info "toplevel"
    (factory-entry "gimp-single-image-window")
    @GEOMETRY@
    (open-on-exit)
    (aux-info
        (left-docks-width "46")
        (right-docks-width "330")
        (maximized "yes"))
    (gimp-toolbox
        (side left))
    (gimp-dock
        (side right)
        (book
            (current-page 0)
            (dockable "gimp-color-editor"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-palette-editor"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-gradient-list"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-pattern-grid"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true"))))
        (book
            (position 250)
            (current-page 0)
            (dockable "gimp-tool-options"
                (locked)
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-undo-history"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-brush-grid"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-cursor-view"
                (tab-style automatic)
                (aux-info
                    (show-button-bar "true")
                    (frame-1-mode "pixel")
                    (frame-2-mode "rgb-percent"))))
        (book
            (position 330)
            (current-page 0)
            (dockable "gimp-layer-list"
                (tab-style name)
                (preview-size 32)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-channel-list"
                (tab-style name)
                (preview-size 32)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-path-list"
                (tab-style name)
                (preview-size 32)
                (aux-info
                    (show-button-bar "true"))))))

(hide-docks no)
(single-window-mode yes)
(show-tabs yes)
(tabs-position 0)
(last-tip-shown 0)

# end of sessionrc
