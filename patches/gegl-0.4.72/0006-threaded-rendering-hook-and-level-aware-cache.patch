+/*  ChopGimp: at a mipmap level greater than 0 (reduced-resolution
+ *  rendering), the node's cache is neither used as the output nor
+ *  written to (see gegl_operation_context_get_target()), and
+ *  gegl_buffer_copy() only copies level-0 tiles: pass the input through.
+ */
+static gboolean
+operation_process (GeglOperation        *operation,
+                   GeglOperationContext *context,
+                   const gchar          *output_prop,
+                   const GeglRectangle  *result,
+                   gint                  level)
+{
+  if (level > 0)
+    {
+      GObject *input = gegl_operation_context_get_object (context, "input");
+
+      if (! input)
+        return FALSE;
+
+      gegl_operation_context_take_object (context, "output",
+                                          g_object_ref (input));
+
+      return TRUE;
+    }
+
+  return GEGL_OPERATION_CLASS (gegl_op_parent_class)->process (operation,
+                                                               context,
+                                                               output_prop,
+                                                               result,
+                                                               level);
+}
