+void
+gegl_node_blit_level (GeglNode            *self,
+                      const GeglRectangle *roi,
+                      gint                 level,
+                      const Babl          *format,
+                      gpointer             destination_buf,
+                      gint                 rowstride)
+{
+  GeglRectangle  request;
+  GeglBuffer    *buffer;
+
+  GEGL_GRAPH_ACCESS ();  /* ChopGimp */
+
+  g_return_if_fail (GEGL_IS_NODE (self));
+  g_return_if_fail (roi != NULL);
+  g_return_if_fail (level >= 0 && level < GEGL_CACHE_VALID_MIPMAPS);
+
+  if (level == 0)
+    {
+      gegl_node_blit (self, 1.0, roi, format, destination_buf, rowstride,
+                      GEGL_BLIT_DEFAULT);
+      return;
+    }
+
+  if (rowstride == GEGL_AUTO_ROWSTRIDE && format)
+    rowstride = babl_format_get_bytes_per_pixel (format) * roi->width;
+
+  /*  the graph is processed in level-0 coordinates  */
+  request.x      = roi->x      * (1 << level);
+  request.y      = roi->y      * (1 << level);
+  request.width  = roi->width  * (1 << level);
+  request.height = roi->height * (1 << level);
+
+  buffer = gegl_node_apply_roi (self, &request, level);
+
+  if (buffer && destination_buf)
+    {
+      /*  an exact power of two: the level is read as is  */
+      gegl_buffer_get (buffer, roi, 1.0 / (1 << level), format,
+                       destination_buf, rowstride,
+                       GEGL_ABYSS_NONE | GEGL_BUFFER_FILTER_NEAREST);
+    }
+
+  g_clear_object (&buffer);
+}
