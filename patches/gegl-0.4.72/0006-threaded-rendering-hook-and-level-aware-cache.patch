+
+/**
+ * gegl_set_graph_access_func: (skip) (attributes skip-reason=chopgimp_private)
+ * @func: (allow-none): a function, or NULL
+ * @user_data: data passed to @func
+ *
+ * ChopGimp: @func is called, in the calling thread, on entry of the
+ * functions which change a graph (setting properties, connecting,
+ * adding or removing children...) or evaluate it (blitting, processing,
+ * computing bounding boxes).  An application rendering a graph in a
+ * thread of its own uses it to keep its other threads away from the
+ * graph meanwhile.
+ */
+void          gegl_set_graph_access_func (GeglGraphAccessFunc  func,
+                                          gpointer             user_data);
