+
+/* Glow map: the layer-style options of Photoshop's glows and shadows,
+ * applied to the alpha of a glow (gegl:dropshadow, gegl:inner-glow):
+ *
+ *  - range: the part of the glow's falloff the contour is applied to
+ *    (1.0: all of it);
+ *  - contour: a curve remapping the falloff (linear, cone, ring...);
+ *  - noise: random dimming of the glow, per pixel;
+ *  - gradient: colors the glow with a gradient along its falloff
+ *    (position 0 where the glow is the strongest).
+ *
+ * The gradient is a list of stops "pos r g b a;pos r g b a;..." with
+ * linear RGBA float colors, sorted by position.
+ */
+
+#include "config.h"
+#include <glib/gi18n-lib.h>
+#include <math.h>
+#include <stdlib.h>
+
+#ifdef GEGL_PROPERTIES
+
+enum_start (gegl_glow_map_contour)
+  enum_value (GEGL_GLOW_MAP_CONTOUR_LINEAR,        "linear",        N_("Linear"))
+  enum_value (GEGL_GLOW_MAP_CONTOUR_CONE,          "cone",          N_("Cone"))
+  enum_value (GEGL_GLOW_MAP_CONTOUR_CONE_INVERTED, "cone-inverted", N_("Cone - Inverted"))
+  enum_value (GEGL_GLOW_MAP_CONTOUR_GAUSSIAN,      "gaussian",      N_("Gaussian"))
+  enum_value (GEGL_GLOW_MAP_CONTOUR_HALF_ROUND,    "half-round",    N_("Half Round"))
+  enum_value (GEGL_GLOW_MAP_CONTOUR_RING,          "ring",          N_("Ring"))
+  enum_value (GEGL_GLOW_MAP_CONTOUR_RING_DOUBLE,   "ring-double",   N_("Ring - Double"))
+enum_end (GeglGlowMapContour)
+
+property_enum   (contour, _("Contour"),
+                 GeglGlowMapContour, gegl_glow_map_contour,
+                 GEGL_GLOW_MAP_CONTOUR_LINEAR)
+  description   (_("Curve remapping the glow's falloff"))
+
+property_double (range, _("Range"), 1.0)
+  description   (_("Part of the glow's falloff the contour applies to"))
+  value_range   (0.01, 1.0)
+
+property_double (noise, _("Noise"), 0.0)
+  description   (_("Random dimming of the glow"))
+  value_range   (0.0, 1.0)
+
+property_boolean (use_gradient, _("Use gradient"), FALSE)
+  description   (_("Color the glow with the gradient"))
+
+property_string (gradient, _("Gradient"), "")
+  description   (_("Gradient stops: \"pos r g b a;...\", linear RGBA"))
+
+property_double (opacity, _("Opacity"), 1.0)
+  value_range   (0.0, 1.0)
+
+#else
+
+#define GEGL_OP_POINT_FILTER
+#define GEGL_OP_NAME     glow_map
+#define GEGL_OP_C_SOURCE glow-map.c
+
+#include "gegl-op.h"
+
+#define GRADIENT_LUT_SIZE 256
+
+typedef struct
+{
+  gchar    *gradient;
+  gboolean  has_lut;
+  gfloat    lut[GRADIENT_LUT_SIZE * 4];
+} Priv;
+
+typedef struct
+{
+  gdouble pos;
+  gfloat  color[4];
+} Stop;
+
+static void
+update_lut (Priv        *priv,
+            const gchar *gradient)
+{
+  GArray  *stops;
+  gchar  **parts;
+  gint     i;
+
+  if (! g_strcmp0 (priv->gradient, gradient))
+    return;
+
+  g_free (priv->gradient);
+  priv->gradient = g_strdup (gradient);
+  priv->has_lut  = FALSE;
+
+  if (! gradient || ! *gradient)
+    return;
+
+  stops = g_array_new (FALSE, FALSE, sizeof (Stop));
+  parts = g_strsplit (gradient, ";", -1);
+
+  for (i = 0; parts[i]; i++)
+    {
+      Stop   stop;
+      gchar *p = parts[i];
+      gchar *end;
+      gint   c;
+
+      stop.pos = g_ascii_strtod (p, &end);
+
+      if (end == p)
+        continue;
+
+      for (c = 0; c < 4; c++)
+        {
+          p = end;
+          stop.color[c] = g_ascii_strtod (p, &end);
+
+          if (end == p)
+            break;
+        }
+
+      if (c == 4)
+        {
+          stop.pos = CLAMP (stop.pos, 0.0, 1.0);
+          g_array_append_val (stops, stop);
+        }
+    }
+
+  g_strfreev (parts);
+
+  if (stops->len > 0)
+    {
+      const Stop *s = (const Stop *) stops->data;
+      guint       k = 0;
+
+      for (i = 0; i < GRADIENT_LUT_SIZE; i++)
+        {
+          gdouble pos = (gdouble) i / (GRADIENT_LUT_SIZE - 1);
+          gfloat *out = priv->lut + 4 * i;
+          gint    c;
+
+          while (k + 1 < stops->len && s[k + 1].pos < pos)
+            k++;
+
+          if (pos <= s[0].pos || stops->len == 1)
+            {
+              for (c = 0; c < 4; c++)
+                out[c] = s[0].color[c];
+            }
+          else if (k + 1 >= stops->len)
+            {
+              for (c = 0; c < 4; c++)
+                out[c] = s[stops->len - 1].color[c];
+            }
+          else
+            {
+              gdouble span = s[k + 1].pos - s[k].pos;
+              gfloat  t    = span > 1e-9 ? (pos - s[k].pos) / span : 0.0;
+
+              for (c = 0; c < 4; c++)
+                out[c] = s[k].color[c] * (1.0f - t) + s[k + 1].color[c] * t;
+            }
+        }
+
+      priv->has_lut = TRUE;
+    }
+
+  g_array_free (stops, TRUE);
+}
+
+static void
+prepare (GeglOperation *operation)
+{
+  GeglProperties *o      = GEGL_PROPERTIES (operation);
+  const Babl     *space  = gegl_operation_get_source_space (operation, "input");
+  const Babl     *format = babl_format_with_space ("RGBA float", space);
+  Priv           *priv   = o->user_data;
+
+  if (! priv)
+    priv = o->user_data = g_new0 (Priv, 1);
+
+  update_lut (priv, o->use_gradient ? o->gradient : NULL);
+
+  gegl_operation_set_format (operation, "input",  format);
+  gegl_operation_set_format (operation, "output", format);
+}
+
+static inline gfloat
+apply_contour (GeglGlowMapContour contour,
+               gfloat             t)
+{
+  switch (contour)
+    {
+    case GEGL_GLOW_MAP_CONTOUR_LINEAR:
+      return t;
+
+    case GEGL_GLOW_MAP_CONTOUR_CONE:
+      return 1.0f - fabsf (2.0f * t - 1.0f);
+
+    case GEGL_GLOW_MAP_CONTOUR_CONE_INVERTED:
+      return fabsf (2.0f * t - 1.0f);
+
+    case GEGL_GLOW_MAP_CONTOUR_GAUSSIAN:
+      return 0.5f - 0.5f * cosf (G_PI * t);
+
+    case GEGL_GLOW_MAP_CONTOUR_HALF_ROUND:
+      return sqrtf (MAX (0.0f, 1.0f - (1.0f - t) * (1.0f - t)));
+
+    case GEGL_GLOW_MAP_CONTOUR_RING:
+      return 0.5f - 0.5f * cosf (2.0f * G_PI * t);
+
+    case GEGL_GLOW_MAP_CONTOUR_RING_DOUBLE:
+      return 0.5f - 0.5f * cosf (4.0f * G_PI * t);
+    }
+
+  return t;
+}
+
+/* a stable random value in [0, 1) for a pixel, the same whatever the
+ * region being processed
+ */
+static inline gfloat
+pixel_noise (gint x,
+             gint y)
+{
+  guint32 h = (guint32) x * 0x9E3779B1u ^ ((guint32) y * 0x85EBCA77u);
+
+  h ^= h >> 16;
+  h *= 0x7FEB352Du;
+  h ^= h >> 15;
+  h *= 0x846CA68Bu;
+  h ^= h >> 16;
+
+  return (h >> 8) * (1.0f / 16777216.0f);
+}
+
+static gboolean
+process (GeglOperation       *operation,
+         void                *in_buf,
+         void                *out_buf,
+         glong                n_pixels,
+         const GeglRectangle *roi,
+         gint                 level)
+{
+  GeglProperties *o       = GEGL_PROPERTIES (operation);
+  Priv           *priv    = o->user_data;
+  const gfloat   *in      = in_buf;
+  gfloat         *out     = out_buf;
+  gfloat          range   = MAX (o->range, 0.01);
+  gfloat          noise   = o->noise;
+  gfloat          opacity = o->opacity;
+  gboolean        lut     = o->use_gradient && priv && priv->has_lut;
+  gint            x       = roi->x;
+  gint            y       = roi->y;
+
+  while (n_pixels--)
+    {
+      gfloat t = MIN (in[3] / range, 1.0f);
+      gfloat f;
+
+      t = MAX (t, 0.0f);
+      f = apply_contour (o->contour, t);
+
+      if (noise > 0.0f)
+        f *= 1.0f - noise * pixel_noise (x, y);
+
+      if (lut)
+        {
+          const gfloat *c = priv->lut +
+                            4 * (gint) ((1.0f - f) * (GRADIENT_LUT_SIZE - 1) + 0.5f);
+
+          out[0] = c[0];
+          out[1] = c[1];
+          out[2] = c[2];
+          f     *= CLAMP (c[3], 0.0f, 1.0f);
+        }
+      else
+        {
+          out[0] = in[0];
+          out[1] = in[1];
+          out[2] = in[2];
+        }
+
+      out[3] = CLAMP (f * opacity, 0.0f, 1.0f);
+
+      in  += 4;
+      out += 4;
+
+      if (++x >= roi->x + roi->width)
+        {
+          x = roi->x;
+          y++;
+        }
+    }
+
+  return TRUE;
+}
+
+static void
+finalize (GObject *object)
+{
+  GeglProperties *o    = GEGL_PROPERTIES (object);
+  Priv           *priv = o->user_data;
+
+  if (priv)
+    {
+      g_free (priv->gradient);
+      g_clear_pointer (&o->user_data, g_free);
+    }
+
+  G_OBJECT_CLASS (gegl_op_parent_class)->finalize (object);
+}
+
+static void
+gegl_op_class_init (GeglOpClass *klass)
+{
+  GObjectClass                  *object_class    = G_OBJECT_CLASS (klass);
+  GeglOperationClass            *operation_class = GEGL_OPERATION_CLASS (klass);
+  GeglOperationPointFilterClass *point_class     = GEGL_OPERATION_POINT_FILTER_CLASS (klass);
+
+  object_class->finalize = finalize;
+  operation_class->prepare = prepare;
+  point_class->process     = process;
+
+  gegl_operation_class_set_keys (operation_class,
+    "name",        "gegl:glow-map",
+    "title",       _("Glow Map"),
+    "categories",  "hidden",
+    "description",
+    _("Contour, range, noise and gradient of a glow's alpha "
+      "(layer styles)"),
+    NULL);
+}
+
+#endif
