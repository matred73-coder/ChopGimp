+/*  ChopGimp: fused filters  */
+
+void
+gimp_filter_stack_set_fuse_func (GimpFilterStack         *stack,
+                                 GimpFilterStackFuseFunc  func,
+                                 gpointer                 user_data)
+{
+  g_return_if_fail (GIMP_IS_FILTER_STACK (stack));
+  g_return_if_fail (stack->graph == NULL);
+
+  stack->fuse_func = func;
+  stack->fuse_data = user_data;
+}
+
+/*  links the active filters (or the nodes the fuse function returns for
+ *  them) from the input to the output of the graph, touching only the
+ *  links which change: relinking invalidates everything downstream
+ */
+void
+gimp_filter_stack_relink (GimpFilterStack *stack)
+{
+  g_return_if_fail (GIMP_IS_FILTER_STACK (stack));
+
+  gimp_filter_stack_relink_excluding (stack, NULL);
+}
+
+static void
+gimp_filter_stack_relink_excluding (GimpFilterStack *stack,
+                                    GimpFilter      *exclude)
+{
+  GList    *filters = NULL;
+  GList    *nodes   = NULL;
+  GList    *list;
+  GeglNode *previous;
+  GeglNode *output;
+
+  if (! stack->graph)
+    return;
+
+  /*  the active filters, from the bottom up  */
+  for (list = GIMP_LIST (stack)->queue->head;
+       list;
+       list = g_list_next (list))
+    {
+      GimpFilter *filter = list->data;
+
+      if (filter != exclude && gimp_filter_get_active (filter))
+        filters = g_list_prepend (filters, filter);
+    }
+
+  if (stack->fuse_func)
+    nodes = stack->fuse_func (stack, filters, stack->fuse_data);
+  else
+    for (list = g_list_last (filters); list; list = g_list_previous (list))
+      nodes = g_list_prepend (nodes, gimp_filter_get_node (list->data));
+
+  /*  the fused nodes join the graph  */
+  for (list = nodes; list; list = g_list_next (list))
+    {
+      GeglNode *node = list->data;
+
+      if (gegl_node_get_parent (node) != stack->graph)
+        gegl_node_add_child (stack->graph, node);
+
+      if (! g_list_find (stack->fused_nodes, node))
+        {
+          GList *iter;
+          gboolean is_filter = FALSE;
+
+          for (iter = filters; iter; iter = g_list_next (iter))
+            if (gimp_filter_get_node (iter->data) == node)
+              {
+                is_filter = TRUE;
+                break;
+              }
+
+          if (! is_filter)
+            stack->fused_nodes = g_list_prepend (stack->fused_nodes,
+                                                 g_object_ref (node));
+        }
+    }
+
+  /*  the chain  */
+  previous = gegl_node_get_input_proxy (stack->graph, "input");
+
+  for (list = nodes; list; list = g_list_next (list))
+    {
+      GeglNode *node = list->data;
+
+      if (gegl_node_get_producer (node, "input", NULL) != previous)
+        gegl_node_link (previous, node);
+
+      previous = node;
+    }
+
+  output = gegl_node_get_output_proxy (stack->graph, "output");
+
+  if (gegl_node_get_producer (output, "input", NULL) != previous)
+    gegl_node_link (previous, output);
+
+  /*  the filters standing for themselves no more  */
+  for (list = filters; list; list = g_list_next (list))
+    {
+      GeglNode *node = gimp_filter_get_node (list->data);
+
+      if (! g_list_find (nodes, node) &&
+          gegl_node_get_producer (node, "input", NULL))
+        {
+          gegl_node_disconnect (node, "input");
+        }
+    }
+
+  /*  the fused nodes no longer used  */
+  list = stack->fused_nodes;
+
+  while (list)
+    {
+      GList    *next = g_list_next (list);
+      GeglNode *node = list->data;
+
+      if (! g_list_find (nodes, node))
+        {
+          gegl_node_disconnect (node, "input");
+
+          if (gegl_node_get_parent (node) == stack->graph)
+            gegl_node_remove_child (stack->graph, node);
+
+          stack->fused_nodes = g_list_delete_link (stack->fused_nodes, list);
+          g_object_unref (node);
+        }
+
+      list = next;
+    }
+
+  g_list_free (nodes);
+  g_list_free (filters);
+}
