+static void
+gimp_operation_layer_style_fused_class_init (GimpOperationLayerStyleFusedClass *klass)
+{
+  GObjectClass             *object_class    = G_OBJECT_CLASS (klass);
+  GeglOperationClass       *operation_class = GEGL_OPERATION_CLASS (klass);
+  GeglOperationFilterClass *filter_class    = GEGL_OPERATION_FILTER_CLASS (klass);
+
+  object_class->finalize     = gimp_operation_layer_style_fused_finalize;
+  object_class->set_property = gimp_operation_layer_style_fused_set_property;
+  object_class->get_property = gimp_operation_layer_style_fused_get_property;
+
+  gegl_operation_class_set_keys (operation_class,
+                                 "name",        "chopgimp:layer-style-fused",
+                                 "categories",  "hidden",
+                                 "description", "Layer style filters "
+                                                "rendered together",
+                                 NULL);
+
+  operation_class->prepare                   = gimp_operation_layer_style_fused_prepare;
+  operation_class->get_bounding_box          = gimp_operation_layer_style_fused_get_bounding_box;
+  operation_class->get_required_for_output   = gimp_operation_layer_style_fused_get_required_for_output;
+  operation_class->get_invalidated_by_change = gimp_operation_layer_style_fused_get_invalidated_by_change;
+  operation_class->get_cached_region         = gimp_operation_layer_style_fused_get_cached_region;
+  /*  the operation distributes its own work between threads, each step
+   *  on the whole region (splitting the region would compute the margins
+   *  of the blurs once per thread)
