diff --git a/app/chopgimp-crash.c b/app/chopgimp-crash.c
index cc30824..93e9c7b 100644
--- a/app/chopgimp-crash.c
+++ b/app/chopgimp-crash.c
@@ -69,6 +69,7 @@ static gchar   exe_path[512] = "";
 
 static gint    log_fd    = -1;
 static gint    orig_err  = -1;
+static GMutex  log_mutex;      /*  one line at a time in the session log  */
 static pid_t   main_tid  = 0;
 
 static gchar   ctx_plugin[256];
@@ -271,6 +272,11 @@ write_report (gint sig, siginfo_t *info)
     {
       Dl_info dl;
 
+      /*  dladdr() is not async-signal-safe (it may take the loader
+       *  lock).  Accepted risk: it is preloaded at startup, and a
+       *  deadlock here only loses the symbol names of a report written
+       *  while the process is dying anyway.
+       */
       w_str (fd, "  #");
       w_num (fd, i, 10, 2);
       w_str (fd, " ");
@@ -374,7 +380,9 @@ tee_thread (gpointer data)
         {
           gchar *nl = memchr (p, '\n', end - p);
           gchar *stop = nl ? nl + 1 : end;
+          gssize r;
 
+          g_mutex_lock (&log_mutex);
           if (bol)
             {
               GDateTime *now = g_date_time_new_now_local ();
@@ -384,7 +392,9 @@ tee_thread (gpointer data)
               g_free (ts);
               g_date_time_unref (now);
             }
-          if (write (log_fd, p, stop - p) < 0)
+          r = write (log_fd, p, stop - p);
+          g_mutex_unlock (&log_mutex);
+          if (r < 0)
             break;
           bol = nl != NULL;
           p = stop;
@@ -589,8 +599,8 @@ chopgimp_crash_note_plugin (const gchar *procedure,
     g_snprintf (buf, sizeof (buf), "aucun en cours (dernier terminé : %s)", last[0] ? last : "aucun");
   g_strlcpy (ctx_plugin, buf, sizeof (ctx_plugin));
 
-  if (log_fd >= 0)
-    g_printerr ("[plug-in] %s %s\n", procedure, running ? "lancé" : "terminé");
+  chopgimp_crash_log_line ("[plug-in] %s %s\n",
+                           procedure, running ? "lancé" : "terminé");
 #endif
 }
 
@@ -602,8 +612,43 @@ chopgimp_crash_note_action (const gchar *action)
 
   g_strlcpy (ctx_actions[i], action, ACTION_LEN);
   ctx_action_next = (i + 1) % N_ACTIONS;
-  if (log_fd >= 0)
-    g_printerr ("[action] %s\n", action);
+  chopgimp_crash_log_line ("[action] %s\n", action);
+#endif
+}
+
+/*  a line for the session log only (not the terminal); not for signal
+ *  context.  @format includes the trailing newline, like g_printerr().
+ */
+void
+chopgimp_crash_log_line (const gchar *format,
+                         ...)
+{
+#ifndef G_OS_WIN32
+  va_list    args;
+  GDateTime *now;
+  gchar     *ts;
+  gchar     *msg;
+  gchar     *line;
+
+  if (log_fd < 0)
+    return;
+
+  va_start (args, format);
+  msg = g_strdup_vprintf (format, args);
+  va_end (args);
+
+  now  = g_date_time_new_now_local ();
+  ts   = g_date_time_format (now, "%H:%M:%S ");
+  line = g_strconcat (ts, msg, NULL);
+
+  g_mutex_lock (&log_mutex);
+  w_str (log_fd, line);
+  g_mutex_unlock (&log_mutex);
+
+  g_free (line);
+  g_free (ts);
+  g_free (msg);
+  g_date_time_unref (now);
 #endif
 }
 
