-    m.coeff[0][0] = value / 100.0;
-  else if (which == 1)     /* vertical scale, % */
-    m.coeff[1][1] = value / 100.0;
-  else                     /* faux italic: shear */
-    m.coeff[0][1] = (ABS (m.coeff[0][1]) > 0.01) ? 0.0 : -0.21;
+  if (! matrix_decompose (&m, &a, &b, &d) || fabs (d) < 1e-9)
+    return;
+
+  if (which == 0)          /* horizontal scale, %: M · diag (r, 1) */
+    {
+      gdouble r = (value / 100.0) / a;
+
+      for (row = 0; row < 2; row++)
+        m.coeff[row][0] *= r;
+    }
+  else if (which == 1)     /* vertical scale, %: M · diag (1, r) */
+    {
+      gdouble r = (value / 100.0) / fabs (d);
+
