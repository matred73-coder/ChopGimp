--- a/app/actions/edit-commands.c
+++ b/app/actions/edit-commands.c
@@ -121,6 +121,7 @@ edit_macro_play_cmd_callback (GimpAction *action,
                               gpointer    data)
 {
   Gimp          *gimp;
+  GimpImage     *image;
   GimpUIManager *manager;
   gchar        **names;
   gint           i, played = 0;
@@ -132,7 +133,31 @@ edit_macro_play_cmd_callback (GimpAction *action,
   names   = chopgimp_rc_get_strings ("macro", "actions");
   manager = menus_get_image_manager_singleton (gimp);
 
-  for (i = 0; names && names[i]; i++)
+  if (! names || ! names[0])
+    {
+      gimp_message_literal (gimp, NULL, GIMP_MESSAGE_INFO,
+                            _("Aucune action enregistrée (Édition > Actions > Enregistrer une action)."));
+      g_strfreev (names);
+      return;
+    }
+
+  /*  the whole replay is one undo step (none when nothing can run)  */
+  for (i = 0; names[i]; i++)
+    {
+      GimpAction *a = gimp_ui_manager_find_action (manager, NULL, names[i]);
+
+      if (a && gimp_action_is_sensitive (a, NULL))
+        break;
+    }
+  image = names[i] ? action_data_get_image (data) : NULL;
+  if (image)
+    {
+      g_object_ref (image);
+      gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC,
+                                   _("Rejouer l'action"));
+    }
+
+  for (i = 0; names[i]; i++)
     {
       GimpAction *a = gimp_ui_manager_find_action (manager, NULL, names[i]);
 
@@ -143,9 +168,16 @@ edit_macro_play_cmd_callback (GimpAction *action,
         }
     }
 
-  if (! names || ! names[0])
+  if (image)
+    {
+      gimp_image_undo_group_end (image);
+      gimp_image_flush (image);
+      g_object_unref (image);
+    }
+
+  if (played == 0)
     gimp_message_literal (gimp, NULL, GIMP_MESSAGE_INFO,
-                          _("Aucune action enregistrée (Édition > Actions > Enregistrer une action)."));
+                          _("Aucune commande de l'action enregistrée n'est disponible ici."));
   g_strfreev (names);
 }
 
