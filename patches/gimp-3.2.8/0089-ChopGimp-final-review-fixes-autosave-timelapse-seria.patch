-/*  horizontal / vertical scale and faux italic: the text matrix  */
+/*  the text matrix M as R·U: a rotation R, and U = [[a, b], [0, d]] in
+ *  text space; a: horizontal scale, d: vertical scale, b / d: slant
+ */
+static gboolean
+matrix_decompose (const GimpMatrix2 *m,
+                  gdouble           *a,
+                  gdouble           *b,
+                  gdouble           *d)
+{
+  gdouble ux, uy;
+
+  *a = hypot (m->coeff[0][0], m->coeff[1][0]);
+
+  if (*a < 1e-9)
+    {
+      *b = 0.0;
+      *d = 0.0;
+      return FALSE;
+    }
+
+  ux = m->coeff[0][0] / *a;
+  uy = m->coeff[1][0] / *a;
+
+  *b = ux * m->coeff[0][1] + uy * m->coeff[1][1];
+  *d = ux * m->coeff[1][1] - uy * m->coeff[0][1];
+
+  return TRUE;
+}
