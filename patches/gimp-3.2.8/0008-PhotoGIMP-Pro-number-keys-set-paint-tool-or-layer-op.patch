+    NC_("tools-action", "Set the opacity of the paint tool, or of the selected layers, to 30%%"),
+    tools_ps_opacity_cmd_callback,
+    NULL },
+
+  { "tools-opacity-ps-40", NULL,
+    NC_("tools-action", "Opacity 40%%"), NULL, { NULL },
+    NC_("tools-action", "Set the opacity of the paint tool, or of the selected layers, to 40%%"),
+    tools_ps_opacity_cmd_callback,
+    NULL },
+
+  { "tools-opacity-ps-50", NULL,
+    NC_("tools-action", "Opacity 50%%"), NULL, { NULL },
+    NC_("tools-action", "Set the opacity of the paint tool, or of the selected layers, to 50%%"),
+    tools_ps_opacity_cmd_callback,
+    NULL },
+
+  { "tools-opacity-ps-60", NULL,
+    NC_("tools-action", "Opacity 60%%"), NULL, { NULL },
+    NC_("tools-action", "Set the opacity of the paint tool, or of the selected layers, to 60%%"),
+    tools_ps_opacity_cmd_callback,
+    NULL },
+
+  { "tools-opacity-ps-70", NULL,
+    NC_("tools-action", "Opacity 70%%"), NULL, { NULL },
+    NC_("tools-action", "Set the opacity of the paint tool, or of the selected layers, to 70%%"),
+    tools_ps_opacity_cmd_callback,
+    NULL },
+
+  { "tools-opacity-ps-80", NULL,
+    NC_("tools-action", "Opacity 80%%"), NULL, { NULL },
+    NC_("tools-action", "Set the opacity of the paint tool, or of the selected layers, to 80%%"),
+    tools_ps_opacity_cmd_callback,
+    NULL },
+
+  { "tools-opacity-ps-90", NULL,
+    NC_("tools-action", "Opacity 90%%"), NULL, { NULL },
+    NC_("tools-action", "Set the opacity of the paint tool, or of the selected layers, to 90%%"),
+    tools_ps_opacity_cmd_callback,
