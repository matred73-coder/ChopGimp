 static const GimpStringActionEntry tools_alternative_actions[] =
 {
   { "tools-by-color-select-short", GIMP_ICON_TOOL_BY_COLOR_SELECT,
@@ -666,6 +732,10 @@ tools_actions_setup (GimpActionGroup *group)
                                  tools_actions,
