diff --git a/app/actions/tools-commands.c b/app/actions/tools-commands.c
index 7a4d19d..7bacf2d 100644
--- a/app/actions/tools-commands.c
+++ b/app/actions/tools-commands.c
@@ -29,6 +29,9 @@
 #include "core/gimp.h"
 #include "core/gimpcontainer.h"
 #include "core/gimpcontext.h"
+#include "core/gimpimage.h"
+#include "core/gimpimage-undo.h"
+#include "core/gimplayer.h"
 #include "core/gimptoolinfo.h"
 
 #include "paint/gimpinkoptions.h"
@@ -46,6 +49,7 @@
 #include "tools/gimpforegroundselectoptions.h"
 #include "tools/gimppaintselectoptions.h"
 #include "tools/gimprectangleoptions.h"
+#include "tools/gimppainttool.h"
 #include "tools/gimptool.h"
 #include "tools/gimptoolcontrol.h"
 #include "tools/gimptransformoptions.h"
@@ -56,6 +60,8 @@
 #include "actions.h"
 #include "tools-commands.h"
 
+#include "gimp-intl.h"
+
 
 /*  local function prototypes  */
 
@@ -941,3 +947,58 @@ tools_activate_enum_action (const gchar *action_desc,
         }
     }
 }
+
+
+/*  PhotoGIMP Pro (Photoshop): number keys set the opacity  */
+void
+tools_ps_opacity_cmd_callback (GimpAction *action,
+                               GVariant   *value,
+                               gpointer    data)
+{
+  GimpContext *context;
+  GimpTool    *tool;
+  const gchar *name;
+  const gchar *dash;
+  gdouble      opacity;
+  return_if_no_context (context, data);
+
+  name = gimp_action_get_name (action);
+  dash = strrchr (name, '-');
+
+  if (! dash)
+    return;
+
+  opacity = CLAMP (g_ascii_strtod (dash + 1, NULL) / 100.0, 0.0, 1.0);
+
+  tool = tool_manager_get_active (context->gimp);
+
+  if (tool && GIMP_IS_PAINT_TOOL (tool))
+    {
+      g_object_set (tool->tool_info->tool_options,
+                    "opacity", opacity,
+                    NULL);
+    }
+  else
+    {
+      GimpImage *image = gimp_context_get_image (context);
+      GList     *layers;
+      GList     *iter;
+
+      if (! image)
+        return;
+
+      layers = gimp_image_get_selected_layers (image);
+
+      if (! layers)
+        return;
+
+      gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_ITEM_PROPERTIES,
+                                   _("Set Layer Opacity"));
+
+      for (iter = layers; iter; iter = iter->next)
+        gimp_layer_set_opacity (iter->data, opacity, TRUE);
+
+      gimp_image_undo_group_end (image);
+      gimp_image_flush (image);
+    }
+}
diff --git a/app/actions/tools-commands.h b/app/actions/tools-commands.h
index c9ffc13..2e0eb68 100644
--- a/app/actions/tools-commands.h
+++ b/app/actions/tools-commands.h
