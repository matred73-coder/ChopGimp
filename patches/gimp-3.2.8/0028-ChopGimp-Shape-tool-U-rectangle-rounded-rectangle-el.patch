+static GType
+chopgimp_shape_type_get_type (void)
+{
+  static GType type = 0;
+
+  if (G_UNLIKELY (! type))
+    {
+      static const GEnumValue values[] =
+      {
+        { CHOPGIMP_SHAPE_RECTANGLE,         "CHOPGIMP_SHAPE_RECTANGLE",         "rectangle" },
+        { CHOPGIMP_SHAPE_ROUNDED_RECTANGLE, "CHOPGIMP_SHAPE_ROUNDED_RECTANGLE", "rounded-rectangle" },
+        { CHOPGIMP_SHAPE_ELLIPSE,           "CHOPGIMP_SHAPE_ELLIPSE",           "ellipse" },
+        { CHOPGIMP_SHAPE_POLYGON,           "CHOPGIMP_SHAPE_POLYGON",           "polygon" },
+        { CHOPGIMP_SHAPE_STAR,              "CHOPGIMP_SHAPE_STAR",              "star" },
+        { CHOPGIMP_SHAPE_LINE,              "CHOPGIMP_SHAPE_LINE",              "line" },
+        { 0, NULL, NULL }
+      };
+      static const GimpEnumDesc descs[] =
+      {
+        { CHOPGIMP_SHAPE_RECTANGLE,         "Rectangle",           NULL },
+        { CHOPGIMP_SHAPE_ROUNDED_RECTANGLE, "Rectangle arrondi",   NULL },
+        { CHOPGIMP_SHAPE_ELLIPSE,           "Ellipse",             NULL },
+        { CHOPGIMP_SHAPE_POLYGON,           "Polygone",            NULL },
+        { CHOPGIMP_SHAPE_STAR,              "Étoile",              NULL },
+        { CHOPGIMP_SHAPE_LINE,              "Ligne",               NULL },
+        { 0, NULL, NULL }
+      };
+
+      type = g_enum_register_static ("ChopGimpShapeType", values);
+      gimp_enum_set_value_descriptions (type, descs);
+    }
+
+  return type;
+}
+
+G_DEFINE_TYPE (GimpShapeOptions, gimp_shape_options, GIMP_TYPE_PATH_OPTIONS)
+
+static void
+gimp_shape_options_set_property (GObject      *object,
+                                 guint         property_id,
+                                 const GValue *value,
+                                 GParamSpec   *pspec)
+{
+  GimpShapeOptions *options = GIMP_SHAPE_OPTIONS (object);
+
+  switch (property_id)
+    {
+    case PROP_SHAPE_TYPE:    options->shape_type    = g_value_get_enum   (value); break;
+    case PROP_CORNER_RADIUS: options->corner_radius = g_value_get_double (value); break;
+    case PROP_SIDES:         options->sides         = g_value_get_int    (value); break;
+    case PROP_STAR_RATIO:    options->star_ratio    = g_value_get_double (value); break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_shape_options_get_property (GObject    *object,
+                                 guint       property_id,
+                                 GValue     *value,
+                                 GParamSpec *pspec)
+{
+  GimpShapeOptions *options = GIMP_SHAPE_OPTIONS (object);
+
+  switch (property_id)
+    {
+    case PROP_SHAPE_TYPE:    g_value_set_enum   (value, options->shape_type);    break;
+    case PROP_CORNER_RADIUS: g_value_set_double (value, options->corner_radius); break;
+    case PROP_SIDES:         g_value_set_int    (value, options->sides);         break;
+    case PROP_STAR_RATIO:    g_value_set_double (value, options->star_ratio);    break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_shape_options_class_init (GimpShapeOptionsClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->set_property = gimp_shape_options_set_property;
+  object_class->get_property = gimp_shape_options_get_property;
+
+  GIMP_CONFIG_PROP_ENUM (object_class, PROP_SHAPE_TYPE,
+                         "shape-type", "Forme", NULL,
+                         chopgimp_shape_type_get_type (),
+                         CHOPGIMP_SHAPE_RECTANGLE,
+                         GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_DOUBLE (object_class, PROP_CORNER_RADIUS,
+                           "corner-radius", "Rayon des angles", NULL,
+                           0.0, 2000.0, 20.0,
+                           GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_INT (object_class, PROP_SIDES,
+                        "sides", "Côtés", NULL,
+                        3, 64, 6,
+                        GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_DOUBLE (object_class, PROP_STAR_RATIO,
+                           "star-ratio", "Creux de l'étoile", NULL,
+                           0.05, 0.95, 0.5,
+                           GIMP_PARAM_STATIC_STRINGS);
+}
+
+static void
+gimp_shape_options_init (GimpShapeOptions *options)
+{
+}
