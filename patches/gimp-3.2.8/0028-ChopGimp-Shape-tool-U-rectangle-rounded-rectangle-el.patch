+
+/*  ── tool ────────────────────────────────────────────────────────── */
+
+G_DEFINE_TYPE (GimpShapeTool, gimp_shape_tool, GIMP_TYPE_DRAW_TOOL)
+
+#define parent_class gimp_shape_tool_parent_class
+
+void
+gimp_shape_tool_register (GimpToolRegisterCallback  callback,
+                          gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_SHAPE_TOOL,
+                GIMP_TYPE_SHAPE_OPTIONS,
+                gimp_tool_options_empty_gui,
+                0,
+                "gimp-shape-tool",
+                _("Forme"),
+                _("Forme : dessiner un rectangle, une ellipse, un polygone, une étoile ou "
+                  "une ligne en calque vectoriel (Maj : proportions, Alt : depuis le centre)"),
+                N_("_Forme"), "U",
+                NULL, NULL,
+                "chopgimp-tool-shape",
+                data);
+}
+
+/*  bounding box of the shape being drawn, in image coordinates  */
+static void
+shape_bounds (GimpShapeTool *shape,
+              gdouble       *x,
+              gdouble       *y,
+              gdouble       *w,
+              gdouble       *h)
+{
+  gdouble dx = shape->cur_x - shape->start_x;
+  gdouble dy = shape->cur_y - shape->start_y;
+
+  if (shape->constrain)
+    {
+      gdouble m = MAX (fabs (dx), fabs (dy));
+
+      dx = (dx < 0) ? -m : m;
+      dy = (dy < 0) ? -m : m;
+    }
+
+  if (shape->from_center)
+    {
+      *x = shape->start_x - fabs (dx);
+      *y = shape->start_y - fabs (dy);
+      *w = 2 * fabs (dx);
+      *h = 2 * fabs (dy);
+    }
+  else
+    {
+      *x = MIN (shape->start_x, shape->start_x + dx);
+      *y = MIN (shape->start_y, shape->start_y + dy);
+      *w = fabs (dx);
+      *h = fabs (dy);
+    }
+}
+
+/*  end point of a line, with 45° constraint  */
+static void
+shape_line_end (GimpShapeTool *shape,
+                gdouble       *x,
+                gdouble       *y)
+{
+  gdouble dx = shape->cur_x - shape->start_x;
+  gdouble dy = shape->cur_y - shape->start_y;
+
+  if (shape->constrain)
+    {
+      gdouble len   = sqrt (dx * dx + dy * dy);
+      gdouble angle = RINT (atan2 (dy, dx) / (G_PI / 4)) * (G_PI / 4);
+
+      dx = len * cos (angle);
+      dy = len * sin (angle);
+    }
+
+  *x = shape->start_x + dx;
+  *y = shape->start_y + dy;
+}
+
+/*  polygon / star vertices inscribed in the box  */
+static gint
+shape_vertices (GimpShapeOptions *options,
+                gdouble x, gdouble y, gdouble w, gdouble h,
+                GimpVector2 *pts)
+{
+  gboolean star = options->shape_type == CHOPGIMP_SHAPE_STAR;
+  gint     n    = star ? options->sides * 2 : options->sides;
+  gdouble  cx   = x + w / 2, cy = y + h / 2;
+  gint     i;
+
+  for (i = 0; i < n; i++)
+    {
+      gdouble a = -G_PI / 2 + 2 * G_PI * i / n;
+      gdouble r = (star && (i % 2)) ? options->star_ratio : 1.0;
+
+      pts[i].x = cx + r * (w / 2) * cos (a);
+      pts[i].y = cy + r * (h / 2) * sin (a);
+    }
+
+  return n;
+}
+
+static GimpCoords
+xy (gdouble x, gdouble y)
+{
+  GimpCoords c = GIMP_COORDS_DEFAULT_VALUES;
+
+  c.x = x;
+  c.y = y;
+  return c;
+}
+
+static GimpStroke *
+shape_build_stroke (GimpShapeTool    *shape,
+                    GimpShapeOptions *options)
+{
+  GimpStroke  *stroke = NULL;
+  GimpCoords   c, c1, c2;
+  gdouble      x, y, w, h;
+  GimpVector2  pts[130];
+  gint         n, i;
+
+  shape_bounds (shape, &x, &y, &w, &h);
+
+  switch (options->shape_type)
+    {
+    case CHOPGIMP_SHAPE_LINE:
+      {
+        gdouble ex, ey;
+
+        shape_line_end (shape, &ex, &ey);
+        c      = xy (shape->start_x, shape->start_y);
+        stroke = gimp_bezier_stroke_new_moveto (&c);
+        c      = xy (ex, ey);
+        gimp_bezier_stroke_lineto (stroke, &c);
+      }
+      return stroke;
+
+    case CHOPGIMP_SHAPE_ELLIPSE:
+      c = xy (x + w / 2, y + h / 2);
+      return gimp_bezier_stroke_new_ellipse (&c, w / 2, h / 2, 0.0);
+
+    case CHOPGIMP_SHAPE_ROUNDED_RECTANGLE:
+      {
+        gdouble r = MIN (options->corner_radius, MIN (w, h) / 2);
+        gdouble k = r * 0.5523;   /* cubic approximation of a quarter circle */
+
+        if (r > 0.5)
+          {
+            c = xy (x + r, y);           stroke = gimp_bezier_stroke_new_moveto (&c);
+            c = xy (x + w - r, y);       gimp_bezier_stroke_lineto (stroke, &c);
+            c1 = xy (x + w - r + k, y);  c2 = xy (x + w, y + r - k);  c = xy (x + w, y + r);
+            gimp_bezier_stroke_cubicto (stroke, &c1, &c2, &c);
+            c = xy (x + w, y + h - r);   gimp_bezier_stroke_lineto (stroke, &c);
+            c1 = xy (x + w, y + h - r + k);  c2 = xy (x + w - r + k, y + h);  c = xy (x + w - r, y + h);
+            gimp_bezier_stroke_cubicto (stroke, &c1, &c2, &c);
+            c = xy (x + r, y + h);       gimp_bezier_stroke_lineto (stroke, &c);
+            c1 = xy (x + r - k, y + h);  c2 = xy (x, y + h - r + k);  c = xy (x, y + h - r);
+            gimp_bezier_stroke_cubicto (stroke, &c1, &c2, &c);
+            c = xy (x, y + r);           gimp_bezier_stroke_lineto (stroke, &c);
+            c1 = xy (x, y + r - k);      c2 = xy (x + r - k, y);  c = xy (x + r, y);
+            gimp_bezier_stroke_cubicto (stroke, &c1, &c2, &c);
+            gimp_stroke_close (stroke);
+            return stroke;
+          }
+      }
+      /* fall through: radius 0 = plain rectangle */
+
+    case CHOPGIMP_SHAPE_RECTANGLE:
+      pts[0].x = x;     pts[0].y = y;
+      pts[1].x = x + w; pts[1].y = y;
+      pts[2].x = x + w; pts[2].y = y + h;
+      pts[3].x = x;     pts[3].y = y + h;
+      n = 4;
+      break;
+
+    case CHOPGIMP_SHAPE_POLYGON:
+    case CHOPGIMP_SHAPE_STAR:
+      n = shape_vertices (options, x, y, w, h, pts);
+      break;
+
+    default:
+      return NULL;
+    }
+
+  c      = xy (pts[0].x, pts[0].y);
+  stroke = gimp_bezier_stroke_new_moveto (&c);
+
+  for (i = 1; i < n; i++)
+    {
+      c = xy (pts[i].x, pts[i].y);
+      gimp_bezier_stroke_lineto (stroke, &c);
+    }
+
+  gimp_stroke_close (stroke);
+
+  return stroke;
+}
+
+static void
+shape_create_layer (GimpShapeTool *shape,
+                    GimpDisplay   *display)
+{
+  GimpShapeOptions *options = GIMP_SHAPE_OPTIONS (gimp_tool_get_options (GIMP_TOOL (shape)));
+  GimpPathOptions  *popts   = GIMP_PATH_OPTIONS (options);
+  GimpImage        *image   = gimp_display_get_image (display);
+  GimpStroke       *stroke  = shape_build_stroke (shape, options);
+  GimpPath         *path;
+  GimpVectorLayer  *layer;
+  gboolean          is_line = options->shape_type == CHOPGIMP_SHAPE_LINE;
+  GEnumValue       *ev;
+  GEnumClass       *ec;
+  const gchar      *name;
+
+  if (! stroke)
+    return;
+
+  ec   = g_type_class_ref (chopgimp_shape_type_get_type ());
+  ev   = g_enum_get_value (ec, options->shape_type);
+  name = gimp_enum_value_get_desc (ec, ev);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_DRAWABLE, name);
+
+  path = gimp_path_new (image, name);
+  gimp_path_stroke_add (path, stroke);
+  g_object_unref (stroke);
+  gimp_image_add_path (image, path, GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+
+  layer = gimp_vector_layer_new (image, path, gimp_get_user_context (image->gimp));
+
+  g_object_set (layer->options,
+                "enable-fill",   is_line ? FALSE : popts->enable_fill,
+                "enable-stroke", is_line ? TRUE  : popts->enable_stroke,
+                NULL);
+  gimp_config_sync (G_OBJECT (popts->fill_options),
+                    G_OBJECT (layer->options->fill_options), 0);
+  gimp_config_sync (G_OBJECT (popts->stroke_options),
+                    G_OBJECT (layer->options->stroke_options), 0);
+
+  gimp_image_add_layer (image, GIMP_LAYER (layer), GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+  gimp_vector_layer_refresh (layer);
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+
+  g_type_class_unref (ec);
+}
+
+static void
+gimp_shape_tool_button_press (GimpTool            *tool,
+                              const GimpCoords    *coords,
+                              guint32              time,
+                              GdkModifierType      state,
+                              GimpButtonPressType  press_type,
+                              GimpDisplay         *display)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (tool);
+
+  if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+  tool->display = display;
+
+  shape->start_x = shape->cur_x = coords->x;
+  shape->start_y = shape->cur_y = coords->y;
+  shape->constrain   = (state & gimp_get_extend_selection_mask ()) != 0;
+  shape->from_center = (state & GDK_MOD1_MASK) != 0;
+
+  gimp_tool_control_activate (tool->control);
+  gimp_draw_tool_start (GIMP_DRAW_TOOL (tool), display);
+}
+
+static void
+gimp_shape_tool_motion (GimpTool         *tool,
+                        const GimpCoords *coords,
+                        guint32           time,
+                        GdkModifierType   state,
+                        GimpDisplay      *display)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (tool);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  shape->cur_x       = coords->x;
+  shape->cur_y       = coords->y;
+  shape->constrain   = (state & gimp_get_extend_selection_mask ()) != 0;
+  shape->from_center = (state & GDK_MOD1_MASK) != 0;
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_shape_tool_active_modifier_key (GimpTool        *tool,
+                                     GdkModifierType  key,
+                                     gboolean         press,
+                                     GdkModifierType  state,
+                                     GimpDisplay     *display)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (tool);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+  shape->constrain   = (state & gimp_get_extend_selection_mask ()) != 0;
+  shape->from_center = (state & GDK_MOD1_MASK) != 0;
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_shape_tool_button_release (GimpTool              *tool,
+                                const GimpCoords      *coords,
+                                guint32                time,
+                                GdkModifierType        state,
+                                GimpButtonReleaseType  release_type,
+                                GimpDisplay           *display)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (tool);
+  gdouble        x, y, w, h;
+
+  gimp_tool_control_halt (tool->control);
+  gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+  if (release_type == GIMP_BUTTON_RELEASE_CANCEL)
+    return;
+
+  shape_bounds (shape, &x, &y, &w, &h);
+
+  if (GIMP_SHAPE_OPTIONS (gimp_tool_get_options (tool))->shape_type == CHOPGIMP_SHAPE_LINE)
+    {
+      if (fabs (shape->cur_x - shape->start_x) + fabs (shape->cur_y - shape->start_y) < 2)
+        return;
+    }
+  else if (w < 2 || h < 2)
+    {
+      return;
+    }
+
+  shape_create_layer (shape, display);
+}
+
+static void
+gimp_shape_tool_draw (GimpDrawTool *draw_tool)
+{
+  GimpShapeTool    *shape   = GIMP_SHAPE_TOOL (draw_tool);
+  GimpShapeOptions *options = GIMP_SHAPE_OPTIONS (gimp_tool_get_options (GIMP_TOOL (draw_tool)));
+  gdouble           x, y, w, h;
+  GimpVector2       pts[130];
+  gint              n;
+
+  shape_bounds (shape, &x, &y, &w, &h);
+
+  switch (options->shape_type)
+    {
+    case CHOPGIMP_SHAPE_LINE:
+      {
+        gdouble ex, ey;
+
+        shape_line_end (shape, &ex, &ey);
+        gimp_draw_tool_add_line (draw_tool, shape->start_x, shape->start_y, ex, ey);
+      }
+      break;
+
+    case CHOPGIMP_SHAPE_ELLIPSE:
+      gimp_draw_tool_add_arc (draw_tool, FALSE, x, y, w, h, 0.0, 2 * G_PI);
+      break;
+
+    case CHOPGIMP_SHAPE_POLYGON:
+    case CHOPGIMP_SHAPE_STAR:
+      n = shape_vertices (options, x, y, w, h, pts);
+      gimp_draw_tool_add_lines (draw_tool, pts, n, NULL, FALSE);
+      gimp_draw_tool_add_line (draw_tool, pts[n - 1].x, pts[n - 1].y, pts[0].x, pts[0].y);
+      break;
+
+    default:
+      gimp_draw_tool_add_rectangle (draw_tool, FALSE, x, y, w, h);
+      break;
+    }
+}
+
+static void
+gimp_shape_tool_class_init (GimpShapeToolClass *klass)
+{
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  tool_class->button_press        = gimp_shape_tool_button_press;
+  tool_class->button_release      = gimp_shape_tool_button_release;
+  tool_class->motion              = gimp_shape_tool_motion;
+  tool_class->active_modifier_key = gimp_shape_tool_active_modifier_key;
+
+  draw_tool_class->draw = gimp_shape_tool_draw;
+}
+
+static void
+gimp_shape_tool_init (GimpShapeTool *shape)
+{
+  GimpTool *tool = GIMP_TOOL (shape);
+
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_RECT_SELECT);
+  gimp_tool_control_set_precision   (tool->control, GIMP_CURSOR_PRECISION_SUBPIXEL);
+}
