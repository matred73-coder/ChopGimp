+    {
+      const gchar *s = GIMP_VALUES_GET_STRING (retvals, 1);
+
+      if (s && *s)
+        xml = g_strdup (s);
+    }
+
+  gimp_value_array_unref (retvals);
+
+  return xml;
+}
