+{
+  GimpProcedure  *procedure;
+  GimpValueArray *retvals;
+  gchar          *xml = NULL;
+
+  procedure = gimp_pdb_lookup_procedure (gimp_get_pdb (), "chopgimp-vobjects-get-xml");
