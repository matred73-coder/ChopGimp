diff --git a/app/path/chopgimp-vobject.c b/app/path/chopgimp-vobject.c
index 6df33d9..3a7e408 100644
--- a/app/path/chopgimp-vobject.c
+++ b/app/path/chopgimp-vobject.c
@@ -5176,3 +5176,80 @@ chopgimp_vlayer_xcf_load (GimpVectorLayer *layer)
   if (layer_usable (layer))
     vlayer_render_region (layer, NULL);
 }
+
+/*  ─── the object tree as XML, for scripts and plug-ins (3.27.2, lot V4) ─ */
+
+gchar *
+chopgimp_vlayer_get_xml (GimpVectorLayer *layer)
+{
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), NULL);
+
+  if (! chopgimp_vlayer_get_root (layer))
+    return NULL;
+
+  return vlayer_serialize (layer, FALSE);
+}
+
+gboolean
+chopgimp_vlayer_set_xml (GimpVectorLayer *layer,
+                         const gchar     *xml,
+                         gboolean         push_undo)
+{
+  ChopGimpVLayer  *nvl;
+  ChopGimpVLayer  *vl;
+  ChopGimpVObject *root;
+
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), FALSE);
+  g_return_val_if_fail (xml != NULL, FALSE);
+
+  if (! layer_usable (layer))
+    return FALSE;
+
+  /*  whatever the version, the parser of the parasite reads it  */
+  nvl = vlayer_parse (gimp_item_get_image (GIMP_ITEM (layer)), xml,
+                      strlen (xml), NULL);
+  if (! nvl)
+    return FALSE;
+
+  if (! vlayer_begin (layer, "Remplacer les objets", push_undo))
+    {
+      chopgimp_vlayer_free (nvl);
+      return FALSE;
+    }
+
+  vl   = layer->vobjects;
+  root = vl->root;
+
+  while (root->children->len > 0)
+    chopgimp_vobject_unref (detach_child (g_ptr_array_index (root->children,
+                                                             root->children->len - 1)));
+
+  vlayer_reindex (vl);   /*  the root only: the ids of @xml are kept  */
+
+  root->transform = nvl->root->transform;
+  root->opacity   = nvl->root->opacity;
+  root->mode      = nvl->root->mode;
+  root->visible   = nvl->root->visible;
+  root->clip      = nvl->root->clip;
+
+  while (nvl->root->children->len > 0)
+    {
+      ChopGimpVObject *o = detach_child (g_ptr_array_index (nvl->root->children, 0));
+
+      insert_child (root, o, -1);
+      assign_ids (vl, o);
+      vobj_invalidate (o);
+    }
+
+  vl->next_id = MAX (vl->next_id, nvl->next_id);
+  g_array_set_size (vl->selection, 0);
+  vl->entered = 0;
+
+  chopgimp_vlayer_free (nvl);
+
+  vobj_invalidate (root);
+  vlayer_commit (layer, CHANGE_ALL, NULL);
+  g_signal_emit_by_name (layer, "object-selection-changed");
+
+  return TRUE;
+}
diff --git a/app/path/chopgimp-vobject.h b/app/path/chopgimp-vobject.h
index 69c2676..60b6a97 100644
--- a/app/path/chopgimp-vobject.h
+++ b/app/path/chopgimp-vobject.h
@@ -432,6 +432,36 @@ gint              chopgimp_vlayer_decompose        (GimpVectorLayer  *layer,
 gint              chopgimp_vlayer_split_new        (GimpVectorLayer  *layer);
 
 
+/*  ─── XML (3.27.2, lot V4: PDB chopgimp-vobjects-get-xml / -set-xml) ─── */
+
+/*  the object tree in the format of the « chopgimp-vobjects » parasite
+ *  (empty objects dropped, no selection); NULL when objects are disabled
+ *  or the layer is rasterized (g_free)
+ */
+gchar           * chopgimp_vlayer_get_xml          (GimpVectorLayer  *layer);
+/*  the objects of @layer are replaced by the tree of @xml (same format;
+ *  its ids are kept when free), one undo step, re-rendered; FALSE when
+ *  @xml cannot be read (nothing changed)
+ */
+gboolean          chopgimp_vlayer_set_xml          (GimpVectorLayer  *layer,
+                                                    const gchar      *xml,
+                                                    gboolean          push_undo);
+
+
+/*  ─── global colors (3.27.2, see chopgimp-vcolors.h) ───────────────── */
+
+/*  the paints of @layer following the global color @id (NULL: all the
+ *  global colors) take the color of the image's registry; the changed
+ *  objects are re-rendered (no undo step: the registry has its own).
+ *  Returns TRUE when something changed.
+ */
+gboolean          chopgimp_vlayer_update_global_color (GimpVectorLayer *layer,
+                                                       const gchar     *id);
+/*  the number of path objects of @layer with a paint following @id  */
+gint              chopgimp_vlayer_count_global_users  (GimpVectorLayer *layer,
+                                                       const gchar     *id);
+
+
 /*  ─── internal: gimpvectorlayer.c, xcf ──────────────────────────────── */
 
 void              chopgimp_vlayer_free             (ChopGimpVLayer   *vlayer);
diff --git a/app/pdb/chopgimp-cmds.c b/app/pdb/chopgimp-cmds.c
index f5b5e55..6b9e010 100644
--- a/app/pdb/chopgimp-cmds.c
+++ b/app/pdb/chopgimp-cmds.c
@@ -193,6 +193,54 @@ vobjects_command_invoker (GimpProcedure         *procedure,
   return return_vals;
 }
 
+/*  3.27.2 (lot V4): the object tree of a vector layer as XML (the format
+ *  of the « chopgimp-vobjects » parasite), for the import and export
+ *  plug-ins (chopgimp_pdf.py, file-svg.c)
+ */
+static GimpValueArray *
+vobjects_get_xml_invoker (GimpProcedure         *procedure,
+                          Gimp                  *gimp,
+                          GimpContext           *context,
+                          GimpProgress          *progress,
+                          const GimpValueArray  *args,
+                          GError               **error)
+{
+  GimpVectorLayer *layer = ARG_OBJECT (0);
+  gchar           *xml   = NULL;
+  GimpValueArray  *return_vals;
+
+  if (layer && chopgimp_vobjects_enabled ())
+    xml = chopgimp_vlayer_get_xml (layer);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_take_string (gimp_value_array_index (return_vals, 1),
+                       xml ? xml : g_strdup (""));
+
+  return return_vals;
+}
+
+static GimpValueArray *
+vobjects_set_xml_invoker (GimpProcedure         *procedure,
+                          Gimp                  *gimp,
+                          GimpContext           *context,
+                          GimpProgress          *progress,
+                          const GimpValueArray  *args,
+                          GError               **error)
+{
+  GimpVectorLayer *layer = ARG_OBJECT (0);
+  const gchar     *xml   = g_value_get_string (gimp_value_array_index (args, 1));
+  gboolean         done  = FALSE;
+  GimpValueArray  *return_vals;
+
+  if (layer && xml && *xml && chopgimp_vobjects_enabled ())
+    done = chopgimp_vlayer_set_xml (layer, xml, TRUE);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), done);
+
+  return return_vals;
+}
+
 static GimpValueArray *
 boolean_invoker (GimpProcedure         *procedure,
                  Gimp                  *gimp,
@@ -550,6 +598,37 @@ register_chopgimp_procs (GimpPDB *pdb)
   gimp_pdb_register_procedure (pdb, p);
   g_object_unref (p);
 
+  p = chopgimp_procedure (pdb, vobjects_get_xml_invoker, "chopgimp-vobjects-get-xml",
+                          "The objects of a vector layer as XML (the format of the "
+                          "« chopgimp-vobjects » parasite, see app/path/chopgimp-vobject.c). "
+                          "Empty when objects are disabled (CHOPGIMP_NO_VOBJECTS) or the "
+                          "layer is rasterized; a layer never edited as objects gives its "
+                          "single « legacy » object.");
+  gimp_procedure_add_argument (p, gimp_param_spec_vector_layer ("layer", "layer",
+                                                                "The vector layer",
+                                                                FALSE, GIMP_PARAM_READWRITE));
+  gimp_procedure_add_return_value (p, gimp_param_spec_string ("xml", "xml", "Objects",
+                                                              FALSE, TRUE, FALSE, NULL,
+                                                              GIMP_PARAM_READWRITE));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, vobjects_set_xml_invoker, "chopgimp-vobjects-set-xml",
+                          "Replace the objects of a vector layer with the tree of @xml (the "
+                          "format of chopgimp-vobjects-get-xml); one undo step, re-rendered. "
+                          "Returns FALSE when the XML cannot be read or objects are disabled "
+                          "(nothing changed).");
+  gimp_procedure_add_argument (p, gimp_param_spec_vector_layer ("layer", "layer",
+                                                                "The vector layer",
+                                                                FALSE, GIMP_PARAM_READWRITE));
+  gimp_procedure_add_argument (p, gimp_param_spec_string ("xml", "xml", "Objects",
+                                                          FALSE, FALSE, FALSE, NULL,
+                                                          GIMP_PARAM_READWRITE));
+  gimp_procedure_add_return_value (p, g_param_spec_boolean ("done", "done", "Replaced",
+                                                            FALSE, GIMP_PARAM_READWRITE));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
   p = chopgimp_procedure (pdb, divide_invoker, "chopgimp-path-divide",
                           "Pathfinder « Divide »: every region of the arrangement of the paths. "
                           "The pieces are added at the top of the paths of the image.");
diff --git a/plug-ins/common/file-svg-vobjects.h b/plug-ins/common/file-svg-vobjects.h
new file mode 100644
index 0000000..2b8b2a2
--- /dev/null
+++ b/plug-ins/common/file-svg-vobjects.h
@@ -0,0 +1,1050 @@
+/* GIMP - The GNU Image Manipulation Program
+ *
+ * file-svg-vobjects.h — ChopGimp 3.27.2 (lot V4): SVG export of the
+ * objects of a vector layer. Included by file-svg.c only (GLib only, so
+ * that tools/dev/test_svg_vobjects.py can compile it alone).
+ *
+ * The objects come from the PDB procedure chopgimp-vobjects-get-xml, in
+ * the format of the « chopgimp-vobjects » parasite (app/path/
+ * chopgimp-vobject.c):
+ *
+ *   <chopgimp-vobjects version="…">
+ *     <group id="0" …>                       the root
+ *       <path id name transform="a b c d e f" opacity mode visible locked
+ *             fill-rule d="M… C… Z">
+ *         <fill type="none|color|linear|radial|pattern" color="r g b a"
+ *               x1 y1 x2 y2 r [opacity mode visible]> <stop offset color/>…
+ *         </fill>
+ *         <stroke type=… width align cap join miter dash dash-offset
+ *                 [opacity mode visible]/>
+ *         (version 2: several <fill> / <stroke>, the « Aspect » stack,
+ *          bottom → top)
+ *       </path>
+ *       <group … clip="1"> … </group>
+ *
+ * Unknown elements (and everything inside them) are skipped, so newer
+ * versions of the format still export.
+ *
+ * The layer becomes an Inkscape layer (<g inkscape:groupmode="layer">),
+ * every object a <path> with its fill and stroke, every group a <g>
+ * (inkscape:label = name), gradients <linearGradient> / <radialGradient>
+ * (objectBoundingBox, the model's own units) in a <defs> of the layer,
+ * clipping groups a <clipPath> made of their top child, opacity and
+ * mix-blend-mode where CSS has the mode. An « Aspect » stack that one
+ * SVG element cannot hold (two fills, a stroke under the fill, a blend
+ * mode of its own) becomes a <g> of one <path> per fill / stroke.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <math.h>
+#include <string.h>
+
+#include <glib.h>
+
+
+typedef struct
+{
+  gdouble offset;
+  gdouble rgba[4];
+} SvgVStop;
+
+typedef struct
+{
+  gchar   *type;            /* none, color, linear, radial, pattern… */
+  gdouble  rgba[4];
+  gdouble  x1, y1, x2, y2, r;
+  GArray  *stops;           /* SvgVStop */
+} SvgVPaint;
+
+typedef struct
+{
+  gboolean   stroke;
+  SvgVPaint  paint;
+  gdouble    opacity;
+  gchar     *mode;
+  gboolean   visible;
+  gdouble    width;
+  gchar     *align;
+  gchar     *cap;
+  gchar     *join;
+  gdouble    miter;
+  gchar     *dash;
+  gdouble    dash_offset;
+} SvgVEntry;
+
+typedef struct _SvgVNode SvgVNode;
+
+struct _SvgVNode
+{
+  gboolean   group;
+  guint      id;
+  gchar     *name;
+  gboolean   has_transform;
+  gdouble    m[6];          /* a b c d e f */
+  gdouble    opacity;
+  gchar     *mode;
+  gboolean   visible;
+  gboolean   locked;
+  gboolean   clip;
+  gchar     *d;
+  gboolean   nonzero;
+  GPtrArray *entries;       /* SvgVEntry *, bottom → top (path) */
+  GPtrArray *children;      /* SvgVNode * (group) */
+};
+
+typedef struct
+{
+  SvgVNode  *root;
+  GPtrArray *stack;         /* SvgVNode * of the open group / path */
+  GPtrArray *elements;      /* names of the open elements */
+  gint       skip;          /* depth inside an unknown element */
+  SvgVPaint *paint;         /* the open <fill> / <stroke> */
+} SvgVParse;
+
+typedef struct
+{
+  GString     *defs;
+  GString     *body;
+  const gchar *prefix;
+  gint         n_gradients;
+  gint         n_clips;
+} SvgVWrite;
+
+
+static void
+svg_vpaint_clear (SvgVPaint *p)
+{
+  g_clear_pointer (&p->type, g_free);
+  if (p->stops)
+    g_array_free (p->stops, TRUE);
+  p->stops = NULL;
+}
+
+static void
+svg_ventry_free (SvgVEntry *e)
+{
+  svg_vpaint_clear (&e->paint);
+  g_free (e->mode);
+  g_free (e->align);
+  g_free (e->cap);
+  g_free (e->join);
+  g_free (e->dash);
+  g_free (e);
+}
+
+static void
+svg_vnode_free (SvgVNode *n)
+{
+  if (! n)
+    return;
+
+  g_free (n->name);
+  g_free (n->mode);
+  g_free (n->d);
+  if (n->entries)
+    g_ptr_array_free (n->entries, TRUE);
+  if (n->children)
+    g_ptr_array_free (n->children, TRUE);
+  g_free (n);
+}
+
+static const gchar *
+svg_vattr (const gchar **names,
+           const gchar **values,
+           const gchar  *name)
+{
+  for (gint i = 0; names[i]; i++)
+    if (! strcmp (names[i], name))
+      return values[i];
+
+  return NULL;
+}
+
+static gdouble
+svg_vnum (const gchar **names,
+          const gchar **values,
+          const gchar  *name,
+          gdouble       def)
+{
+  const gchar *v = svg_vattr (names, values, name);
+
+  return v ? g_ascii_strtod (v, NULL) : def;
+}
+
+static gint
+svg_vnums (const gchar *s,
+           gdouble     *out,
+           gint         max)
+{
+  gint n = 0;
+
+  while (s && *s && n < max)
+    {
+      gchar *end;
+
+      while (*s == ' ' || *s == ',' || *s == '\t' || *s == '\n')
+        s++;
+      if (! *s)
+        break;
+
+      out[n] = g_ascii_strtod (s, &end);
+      if (end == s)
+        break;
+
+      n++;
+      s = end;
+    }
+
+  return n;
+}
+
+static void
+svg_vparse_paint (SvgVPaint    *p,
+                  const gchar **names,
+                  const gchar **values)
+{
+  svg_vpaint_clear (p);
+
+  p->type    = g_strdup (svg_vattr (names, values, "type") ?
+                         svg_vattr (names, values, "type") : "none");
+  p->rgba[0] = p->rgba[1] = p->rgba[2] = 0.0;
+  p->rgba[3] = 1.0;
+  svg_vnums (svg_vattr (names, values, "color"), p->rgba, 4);
+  p->x1      = svg_vnum (names, values, "x1", 0.0);
+  p->y1      = svg_vnum (names, values, "y1", 0.0);
+  p->x2      = svg_vnum (names, values, "x2", 1.0);
+  p->y2      = svg_vnum (names, values, "y2", 0.0);
+  p->r       = svg_vnum (names, values, "r",  0.5);
+}
+
+static void
+svg_vparse_start (GMarkupParseContext  *context,
+                  const gchar          *element,
+                  const gchar         **names,
+                  const gchar         **values,
+                  gpointer              user_data,
+                  GError              **error)
+{
+  SvgVParse   *ps     = user_data;
+  const gchar *parent = ps->elements->len ?
+                        g_ptr_array_index (ps->elements, ps->elements->len - 1) : NULL;
+
+  if (ps->skip)
+    {
+      ps->skip++;
+      return;
+    }
+
+  if (! strcmp (element, "chopgimp-vobjects") && ! parent)
+    {
+      g_ptr_array_add (ps->elements, (gpointer) "chopgimp-vobjects");
+    }
+  else if ((! strcmp (element, "group") || ! strcmp (element, "path")) &&
+           (! g_strcmp0 (parent, "group") || ! g_strcmp0 (parent, "chopgimp-vobjects")))
+    {
+      SvgVNode    *n = g_new0 (SvgVNode, 1);
+      const gchar *v;
+
+      n->group   = ! strcmp (element, "group");
+      n->id      = (guint) svg_vnum (names, values, "id", 0);
+      n->name    = g_strdup (svg_vattr (names, values, "name") ?
+                             svg_vattr (names, values, "name") : "");
+      n->opacity = CLAMP (svg_vnum (names, values, "opacity", 1.0), 0.0, 1.0);
+      n->mode    = g_strdup (svg_vattr (names, values, "mode") ?
+                             svg_vattr (names, values, "mode") : "normal");
+      n->visible = svg_vnum (names, values, "visible", 1) != 0;
+      n->locked  = svg_vnum (names, values, "locked", 0) != 0;
+      n->clip    = n->group && svg_vnum (names, values, "clip", 0) != 0;
+      n->nonzero = ! g_strcmp0 (svg_vattr (names, values, "fill-rule"), "nonzero");
+      n->d       = g_strdup (svg_vattr (names, values, "d"));
+      n->entries = g_ptr_array_new_with_free_func ((GDestroyNotify) svg_ventry_free);
+
+      if ((v = svg_vattr (names, values, "transform")))
+        {
+          gdouble m[6] = { 1, 0, 0, 1, 0, 0 };
+
+          svg_vnums (v, m, 6);
+          memcpy (n->m, m, sizeof (m));
+          n->has_transform = ! (m[0] == 1 && m[1] == 0 && m[2] == 0 &&
+                                m[3] == 1 && m[4] == 0 && m[5] == 0);
+        }
+      else
+        {
+          n->m[0] = n->m[3] = 1.0;
+        }
+
+      if (n->group)
+        n->children = g_ptr_array_new_with_free_func ((GDestroyNotify) svg_vnode_free);
+
+      if (ps->stack->len == 0)
+        {
+          if (ps->root)
+            svg_vnode_free (ps->root);
+          ps->root = n;          /* the root group (or a lone object) */
+        }
+      else
+        {
+          SvgVNode *p = g_ptr_array_index (ps->stack, ps->stack->len - 1);
+
+          g_ptr_array_add (p->children, n);
+        }
+
+      g_ptr_array_add (ps->stack, n);
+      g_ptr_array_add (ps->elements, (gpointer) (n->group ? "group" : "path"));
+    }
+  else if ((! strcmp (element, "fill") || ! strcmp (element, "stroke")) &&
+           ! g_strcmp0 (parent, "path"))
+    {
+      SvgVNode    *n = g_ptr_array_index (ps->stack, ps->stack->len - 1);
+      SvgVEntry   *e = g_new0 (SvgVEntry, 1);
+      const gchar *v;
+
+      e->stroke      = ! strcmp (element, "stroke");
+      e->opacity     = CLAMP (svg_vnum (names, values, "opacity", 1.0), 0.0, 1.0);
+      e->mode        = g_strdup ((v = svg_vattr (names, values, "mode")) ? v : "normal");
+      e->visible     = svg_vnum (names, values, "visible", 1) != 0;
+      e->width       = svg_vnum (names, values, "width", 1.0);
+      e->miter       = svg_vnum (names, values, "miter", 10.0);
+      e->dash_offset = svg_vnum (names, values, "dash-offset", 0.0);
+      e->align       = g_strdup ((v = svg_vattr (names, values, "align")) ? v : "center");
+      e->cap         = g_strdup ((v = svg_vattr (names, values, "cap"))   ? v : "butt");
+      e->join        = g_strdup ((v = svg_vattr (names, values, "join"))  ? v : "miter");
+      e->dash        = g_strdup (svg_vattr (names, values, "dash"));
+      svg_vparse_paint (&e->paint, names, values);
+      g_ptr_array_add (n->entries, e);
+
+      ps->paint = &e->paint;
+      g_ptr_array_add (ps->elements, (gpointer) (e->stroke ? "stroke" : "fill"));
+    }
+  else if (! strcmp (element, "stop") && ps->paint &&
+           (! g_strcmp0 (parent, "fill") || ! g_strcmp0 (parent, "stroke")))
+    {
+      SvgVStop st = { 0, { 0, 0, 0, 1 } };
+
+      st.offset = CLAMP (svg_vnum (names, values, "offset", 0.0), 0.0, 1.0);
+      svg_vnums (svg_vattr (names, values, "color"), st.rgba, 4);
+
+      if (! ps->paint->stops)
+        ps->paint->stops = g_array_new (FALSE, FALSE, sizeof (SvgVStop));
+      g_array_append_val (ps->paint->stops, st);
+
+      g_ptr_array_add (ps->elements, (gpointer) "stop");
+    }
+  else
+    {
+      ps->skip = 1;
+    }
+}
+
+static void
+svg_vparse_end (GMarkupParseContext  *context,
+                const gchar          *element,
+                gpointer              user_data,
+                GError              **error)
+{
+  SvgVParse   *ps = user_data;
+  const gchar *top;
+
+  if (ps->skip)
+    {
+      ps->skip--;
+      return;
+    }
+
+  if (! ps->elements->len)
+    return;
+
+  top = g_ptr_array_index (ps->elements, ps->elements->len - 1);
+  g_ptr_array_remove_index (ps->elements, ps->elements->len - 1);
+
+  if (! strcmp (top, "group") || ! strcmp (top, "path"))
+    g_ptr_array_remove_index (ps->stack, ps->stack->len - 1);
+  else if (! strcmp (top, "fill") || ! strcmp (top, "stroke"))
+    ps->paint = NULL;
+}
+
+/*  the root group of the XML, NULL on error  */
+static SvgVNode *
+svg_vobjects_parse (const gchar *xml)
+{
+  static const GMarkupParser parser = { svg_vparse_start, svg_vparse_end, NULL, NULL, NULL };
+  GMarkupParseContext       *context;
+  SvgVParse                  ps    = { 0, };
+  GError                    *error = NULL;
+
+  if (! xml || ! *xml)
+    return NULL;
+
+  ps.stack    = g_ptr_array_new ();
+  ps.elements = g_ptr_array_new ();
+
+  context = g_markup_parse_context_new (&parser, 0, &ps, NULL);
+
+  if (! g_markup_parse_context_parse (context, xml, -1, &error) ||
+      ! g_markup_parse_context_end_parse (context, &error))
+    {
+      g_printerr ("file-svg: invalid vector objects: %s\n",
+                  error ? error->message : "?");
+      g_clear_error (&error);
+      g_clear_pointer (&ps.root, svg_vnode_free);
+    }
+
+  g_markup_parse_context_free (context);
+  g_ptr_array_free (ps.stack, TRUE);
+  g_ptr_array_free (ps.elements, TRUE);
+
+  if (ps.root && ! ps.root->group)
+    {
+      SvgVNode *root = g_new0 (SvgVNode, 1);
+
+      root->group    = TRUE;
+      root->name     = g_strdup ("");
+      root->mode     = g_strdup ("normal");
+      root->visible  = TRUE;
+      root->opacity  = 1.0;
+      root->m[0]     = root->m[3] = 1.0;
+      root->children = g_ptr_array_new_with_free_func ((GDestroyNotify) svg_vnode_free);
+      g_ptr_array_add (root->children, ps.root);
+      ps.root = root;
+    }
+
+  return ps.root;
+}
+
+
+/*  ─── writing ────────────────────────────────────────────────────────── */
+
+static void
+svg_vput_num (GString *s,
+              gdouble  v)
+{
+  gchar buf[G_ASCII_DTOSTR_BUF_SIZE];
+  gint  len;
+
+  if (fabs (v) < 5e-7)
+    v = 0.0;
+
+  g_ascii_formatd (buf, sizeof (buf), "%.6f", v);
+
+  len = strlen (buf);
+  if (strchr (buf, '.'))
+    {
+      while (len > 0 && buf[len - 1] == '0')
+        buf[--len] = '\0';
+      if (len > 0 && buf[len - 1] == '.')
+        buf[--len] = '\0';
+    }
+
+  g_string_append (s, buf);
+}
+
+static void
+svg_vput_color (GString       *s,
+                const gdouble  rgba[4])
+{
+  g_string_append_printf (s, "#%02x%02x%02x",
+                          (gint) (CLAMP (rgba[0], 0.0, 1.0) * 255.0 + 0.5),
+                          (gint) (CLAMP (rgba[1], 0.0, 1.0) * 255.0 + 0.5),
+                          (gint) (CLAMP (rgba[2], 0.0, 1.0) * 255.0 + 0.5));
+}
+
+static void
+svg_vput_escaped (GString     *s,
+                  const gchar *text)
+{
+  gchar *e = g_markup_escape_text (text ? text : "", -1);
+
+  g_string_append (s, e);
+  g_free (e);
+}
+
+static void
+svg_vput_matrix (GString       *s,
+                 const gdouble  m[6])
+{
+  g_string_append (s, " transform=\"matrix(");
+  for (gint i = 0; i < 6; i++)
+    {
+      if (i)
+        g_string_append_c (s, ',');
+      svg_vput_num (s, m[i]);
+    }
+  g_string_append (s, ")\"");
+}
+
+/*  outer ∘ inner  */
+static void
+svg_vmatrix_mul (const gdouble outer[6],
+                 const gdouble inner[6],
+                 gdouble       out[6])
+{
+  gdouble r[6];
+
+  r[0] = outer[0] * inner[0] + outer[2] * inner[1];
+  r[1] = outer[1] * inner[0] + outer[3] * inner[1];
+  r[2] = outer[0] * inner[2] + outer[2] * inner[3];
+  r[3] = outer[1] * inner[2] + outer[3] * inner[3];
+  r[4] = outer[0] * inner[4] + outer[2] * inner[5] + outer[4];
+  r[5] = outer[1] * inner[4] + outer[3] * inner[5] + outer[5];
+
+  memcpy (out, r, sizeof (r));
+}
+
+static const gchar *
+svg_vblend (const gchar *mode)
+{
+  static const gchar *const map[][2] =
+  {
+    { "multiply",      "multiply"    },
+    { "screen",        "screen"      },
+    { "overlay",       "overlay"     },
+    { "darken-only",   "darken"      },
+    { "lighten-only",  "lighten"     },
+    { "dodge",         "color-dodge" },
+    { "burn",          "color-burn"  },
+    { "hardlight",     "hard-light"  },
+    { "softlight",     "soft-light"  },
+    { "difference",    "difference"  },
+    { "exclusion",     "exclusion"   },
+    { "lch-hue",       "hue"         },
+    { "hsv-hue",       "hue"         },
+    { "lch-chroma",    "saturation"  },
+    { "hsv-saturation","saturation"  },
+    { "hsl-color",     "color"       },
+    { "lch-color",     "color"       },
+    { "lch-lightness", "luminosity"  },
+    { "luminance",     "luminosity"  },
+    { "addition",      "plus-lighter" },
+  };
+
+  for (guint i = 0; i < G_N_ELEMENTS (map); i++)
+    if (! g_strcmp0 (mode, map[i][0]))
+      return map[i][1];
+
+  return NULL;
+}
+
+static gboolean
+svg_vpaint_is_gradient (const SvgVPaint *p)
+{
+  return ((! g_strcmp0 (p->type, "linear") || ! g_strcmp0 (p->type, "radial")) &&
+          p->stops && p->stops->len > 0);
+}
+
+/*  « fill:…;fill-opacity:… » (or stroke); gradients go to the defs  */
+static void
+svg_vput_paint (SvgVWrite       *w,
+                GString         *style,
+                const gchar     *prop,
+                const SvgVPaint *p,
+                gdouble          alpha)
+{
+  if (svg_vpaint_is_gradient (p))
+    {
+      gboolean linear = ! strcmp (p->type, "linear");
+      gint     n      = ++w->n_gradients;
+
+      g_string_append_printf (w->defs, "<%s id=\"%s-g%d\" gradientUnits=\"objectBoundingBox\"",
+                              linear ? "linearGradient" : "radialGradient",
+                              w->prefix, n);
+      if (linear)
+        {
+          g_string_append (w->defs, " x1=\"");
+          svg_vput_num (w->defs, p->x1);
+          g_string_append (w->defs, "\" y1=\"");
+          svg_vput_num (w->defs, p->y1);
+          g_string_append (w->defs, "\" x2=\"");
+          svg_vput_num (w->defs, p->x2);
+          g_string_append (w->defs, "\" y2=\"");
+          svg_vput_num (w->defs, p->y2);
+        }
+      else
+        {
+          g_string_append (w->defs, " cx=\"");
+          svg_vput_num (w->defs, p->x1);
+          g_string_append (w->defs, "\" cy=\"");
+          svg_vput_num (w->defs, p->y1);
+          g_string_append (w->defs, "\" r=\"");
+          svg_vput_num (w->defs, p->r);
+          g_string_append (w->defs, "\" fx=\"");
+          svg_vput_num (w->defs, p->x2);
+          g_string_append (w->defs, "\" fy=\"");
+          svg_vput_num (w->defs, p->y2);
+        }
+      g_string_append (w->defs, "\">\n");
+
+      for (guint i = 0; i < p->stops->len; i++)
+        {
+          SvgVStop *st = &g_array_index (p->stops, SvgVStop, i);
+
+          g_string_append (w->defs, "<stop offset=\"");
+          svg_vput_num (w->defs, st->offset);
+          g_string_append (w->defs, "\" style=\"stop-color:");
+          svg_vput_color (w->defs, st->rgba);
+          g_string_append (w->defs, ";stop-opacity:");
+          svg_vput_num (w->defs, CLAMP (st->rgba[3] * alpha, 0.0, 1.0));
+          g_string_append (w->defs, "\"/>\n");
+        }
+
+      g_string_append_printf (w->defs, "</%s>\n",
+                              linear ? "linearGradient" : "radialGradient");
+
+      g_string_append_printf (style, "%s:url(#%s-g%d);", prop, w->prefix, n);
+    }
+  else if (! g_strcmp0 (p->type, "color"))
+    {
+      g_string_append_printf (style, "%s:", prop);
+      svg_vput_color (style, p->rgba);
+      if (p->rgba[3] * alpha < 1.0)
+        {
+          g_string_append_printf (style, ";%s-opacity:", prop);
+          svg_vput_num (style, CLAMP (p->rgba[3] * alpha, 0.0, 1.0));
+        }
+      g_string_append_c (style, ';');
+    }
+  else if (! g_strcmp0 (p->type, "pattern"))
+    {
+      /*  GIMP patterns are not exported: a neutral grey  */
+      g_string_append_printf (style, "%s:#808080;", prop);
+    }
+  else if (! g_strcmp0 (p->type, "linear") || ! g_strcmp0 (p->type, "radial"))
+    {
+      g_string_append_printf (style, "%s:#000000;", prop);
+    }
+  else
+    {
+      g_string_append_printf (style, "%s:none;", prop);
+    }
+}
+
+/*  opacity, blend mode, visibility (path and group)  */
+static void
+svg_vput_props (GString        *style,
+                const SvgVNode *n)
+{
+  const gchar *blend = svg_vblend (n->mode);
+
+  if (n->opacity < 1.0)
+    {
+      g_string_append (style, "opacity:");
+      svg_vput_num (style, n->opacity);
+      g_string_append_c (style, ';');
+    }
+  if (blend)
+    g_string_append_printf (style, "mix-blend-mode:%s;", blend);
+  if (! n->visible)
+    g_string_append (style, "display:none;");
+}
+
+static void
+svg_vput_head (SvgVWrite      *w,
+               const gchar    *tag,
+               const SvgVNode *n,
+               const gchar    *spacing)
+{
+  g_string_append_printf (w->body, "%s<%s id=\"%s-o%u\"", spacing, tag, w->prefix, n->id);
+
+  if (n->name && *n->name)
+    {
+      g_string_append (w->body, " inkscape:label=\"");
+      svg_vput_escaped (w->body, n->name);
+      g_string_append_c (w->body, '"');
+    }
+
+  if (n->has_transform)
+    svg_vput_matrix (w->body, n->m);
+
+  if (n->locked)
+    g_string_append (w->body, " sodipodi:insensitive=\"true\"");
+}
+
+/*  the leaves of @n as <path> of a <clipPath>, in the space of its group  */
+static void
+svg_vput_clip_shape (SvgVWrite      *w,
+                     const SvgVNode *n,
+                     const gdouble   parent[6])
+{
+  gdouble m[6];
+
+  if (n->has_transform)
+    svg_vmatrix_mul (parent, n->m, m);
+  else
+    memcpy (m, parent, sizeof (m));
+
+  if (n->group)
+    {
+      for (guint i = 0; i < n->children->len; i++)
+        svg_vput_clip_shape (w, g_ptr_array_index (n->children, i), m);
+      return;
+    }
+
+  if (! n->d || ! *n->d)
+    return;
+
+  g_string_append (w->defs, "<path");
+  if (n->name && *n->name)
+    {
+      g_string_append (w->defs, " inkscape:label=\"");
+      svg_vput_escaped (w->defs, n->name);
+      g_string_append_c (w->defs, '"');
+    }
+  if (! (m[0] == 1 && m[1] == 0 && m[2] == 0 && m[3] == 1 && m[4] == 0 && m[5] == 0))
+    svg_vput_matrix (w->defs, m);
+  g_string_append_printf (w->defs, " clip-rule=\"%s\" d=\"",
+                          n->nonzero ? "nonzero" : "evenodd");
+  svg_vput_escaped (w->defs, n->d);
+  g_string_append (w->defs, "\"/>\n");
+}
+
+/*  the visible, painted entries (SvgVEntry *, not owned)  */
+static GPtrArray *
+svg_vpainted (const SvgVNode *n)
+{
+  GPtrArray *a = g_ptr_array_new ();
+
+  if (n->entries)
+    for (guint i = 0; i < n->entries->len; i++)
+      {
+        SvgVEntry *e = g_ptr_array_index (n->entries, i);
+
+        if (e->visible && e->paint.type && strcmp (e->paint.type, "none"))
+          g_ptr_array_add (a, e);
+      }
+
+  return a;
+}
+
+/*  one SVG element can hold them: at most one fill under at most one
+ *  stroke, no blend mode of their own (opacities go to fill-opacity /
+ *  stroke-opacity)
+ */
+static gboolean
+svg_ventries_simple (GPtrArray *painted)
+{
+  gint n_fill = 0, n_stroke = 0;
+
+  for (guint i = 0; i < painted->len; i++)
+    {
+      const SvgVEntry *e = g_ptr_array_index (painted, i);
+
+      if (g_strcmp0 (e->mode, "normal"))
+        return FALSE;
+
+      if (e->stroke)
+        n_stroke++;
+      else if (n_stroke > 0)
+        return FALSE;            /* a fill above the stroke */
+      else
+        n_fill++;
+    }
+
+  return n_fill <= 1 && n_stroke <= 1;
+}
+
+/*  fill and stroke of a <path> (NULL: none)  */
+static void
+svg_vput_style (SvgVWrite       *w,
+                GString         *style,
+                const SvgVNode  *n,
+                const SvgVEntry *fill,
+                const SvgVEntry *stroke)
+{
+  static const SvgVPaint none = { (gchar *) "none", };
+
+  svg_vput_paint (w, style, "fill", fill ? &fill->paint : &none, fill ? fill->opacity : 1.0);
+  g_string_append_printf (style, "fill-rule:%s;", n->nonzero ? "nonzero" : "evenodd");
+
+  svg_vput_paint (w, style, "stroke", stroke ? &stroke->paint : &none,
+                  stroke ? stroke->opacity : 1.0);
+
+  if (! stroke)
+    return;
+
+  g_string_append (style, "stroke-width:");
+  svg_vput_num (style, stroke->width);
+  g_string_append_printf (style, ";stroke-linecap:%s;stroke-linejoin:%s;stroke-miterlimit:",
+                          ! g_strcmp0 (stroke->cap, "round")  ? "round"  :
+                          ! g_strcmp0 (stroke->cap, "square") ? "square" : "butt",
+                          ! g_strcmp0 (stroke->join, "round") ? "round"  :
+                          ! g_strcmp0 (stroke->join, "bevel") ? "bevel"  : "miter");
+  svg_vput_num (style, stroke->miter);
+  g_string_append_c (style, ';');
+
+  if (stroke->dash && *stroke->dash)
+    {
+      gdouble dash[64];
+      gint    n_dash = svg_vnums (stroke->dash, dash, G_N_ELEMENTS (dash));
+
+      if (n_dash > 0)
+        {
+          /*  the model counts dashes in stroke widths  */
+          g_string_append (style, "stroke-dasharray:");
+          for (gint i = 0; i < n_dash; i++)
+            {
+              if (i)
+                g_string_append_c (style, ',');
+              svg_vput_num (style, dash[i] * stroke->width);
+            }
+          g_string_append (style, ";stroke-dashoffset:");
+          svg_vput_num (style, stroke->dash_offset);
+          g_string_append_c (style, ';');
+        }
+    }
+}
+
+/*  style="…", stroke alignment and d of a <path>  */
+static void
+svg_vput_path_end (SvgVWrite       *w,
+                   GString         *style,
+                   const SvgVNode  *n,
+                   const SvgVEntry *stroke)
+{
+  if (style->len && style->str[style->len - 1] == ';')
+    g_string_truncate (style, style->len - 1);
+
+  g_string_append_printf (w->body, " style=\"%s\"", style->str);
+
+  if (stroke && stroke->align &&
+      (! strcmp (stroke->align, "inside") || ! strcmp (stroke->align, "outside")))
+    g_string_append_printf (w->body, " chopgimp:stroke-align=\"%s\"", stroke->align);
+
+  g_string_append (w->body, " d=\"");
+  svg_vput_escaped (w->body, n->d);
+  g_string_append (w->body, "\"/>\n");
+}
+
+static void
+svg_vput_node (SvgVWrite      *w,
+               const SvgVNode *n,
+               const gchar    *spacing)
+{
+  GString *style = g_string_new (NULL);
+
+  if (n->group)
+    {
+      guint  n_children = n->children->len;
+      gchar *inner      = g_strdup_printf ("%s  ", spacing);
+
+      if (n_children == 0)
+        {
+          g_string_free (style, TRUE);
+          g_free (inner);
+          return;
+        }
+
+      svg_vput_head (w, "g", n, spacing);
+
+      if (n->clip && n_children > 0)
+        {
+          static const gdouble identity[6] = { 1, 0, 0, 1, 0, 0 };
+          gint                 c           = ++w->n_clips;
+
+          g_string_append_printf (w->defs,
+                                  "<clipPath id=\"%s-c%d\" clipPathUnits=\"userSpaceOnUse\">\n",
+                                  w->prefix, c);
+          svg_vput_clip_shape (w, g_ptr_array_index (n->children, n_children - 1), identity);
+          g_string_append (w->defs, "</clipPath>\n");
+
+          g_string_append_printf (w->body, " clip-path=\"url(#%s-c%d)\"", w->prefix, c);
+          n_children--;
+        }
+
+      svg_vput_props (style, n);
+      if (style->len)
+        g_string_append_printf (w->body, " style=\"%s\"", style->str);
+      g_string_append (w->body, ">\n");
+
+      for (guint i = 0; i < n_children; i++)
+        svg_vput_node (w, g_ptr_array_index (n->children, i), inner);
+
+      g_string_append_printf (w->body, "%s</g>\n", spacing);
+      g_free (inner);
+    }
+  else if (n->d && *n->d)
+    {
+      GPtrArray *painted = svg_vpainted (n);
+
+      if (svg_ventries_simple (painted))
+        {
+          const SvgVEntry *fill   = NULL;
+          const SvgVEntry *stroke = NULL;
+
+          for (guint i = 0; i < painted->len; i++)
+            {
+              const SvgVEntry *e = g_ptr_array_index (painted, i);
+
+              if (e->stroke)
+                stroke = e;
+              else
+                fill = e;
+            }
+
+          svg_vput_head (w, "path", n, spacing);
+          svg_vput_style (w, style, n, fill, stroke);
+          svg_vput_props (style, n);
+          svg_vput_path_end (w, style, n, stroke);
+        }
+      else
+        {
+          /*  an « Aspect » stack: one <path> per fill / stroke  */
+          gchar *inner = g_strdup_printf ("%s  ", spacing);
+
+          svg_vput_head (w, "g", n, spacing);
+          svg_vput_props (style, n);
+          if (style->len)
+            g_string_append_printf (w->body, " style=\"%s\"", style->str);
+          g_string_append (w->body, ">\n");
+
+          for (guint i = 0; i < painted->len; i++)
+            {
+              const SvgVEntry *e     = g_ptr_array_index (painted, i);
+              const gchar     *blend = svg_vblend (e->mode);
+
+              g_string_truncate (style, 0);
+              g_string_append_printf (w->body, "%s<path id=\"%s-o%u-%u\" inkscape:label=\"%s\"",
+                                      inner, w->prefix, n->id, i + 1,
+                                      e->stroke ? "Contour" : "Fond");
+              svg_vput_style (w, style, n, e->stroke ? NULL : e, e->stroke ? e : NULL);
+              if (blend)
+                g_string_append_printf (style, "mix-blend-mode:%s;", blend);
+              svg_vput_path_end (w, style, n, e->stroke ? e : NULL);
+            }
+
+          g_string_append_printf (w->body, "%s</g>\n", spacing);
+          g_free (inner);
+        }
+
+      g_ptr_array_free (painted, TRUE);
+    }
+
+  g_string_free (style, TRUE);
+}
+
+static gint
+svg_vcount (const SvgVNode *n)
+{
+  gint count = 0;
+
+  if (n->children)
+    for (guint i = 0; i < n->children->len; i++)
+      count += 1 + svg_vcount (g_ptr_array_index (n->children, i));
+
+  return count;
+}
+
+/*  TRUE when the objects say more than GIMP's own vector layer export
+ *  (one <path> with the layer's fill and stroke): several objects, a
+ *  group, a gradient, an object of its own (name, transformation,
+ *  opacity, mode, visibility, stroke alignment)
+ */
+static gboolean
+svg_vobjects_is_rich (const SvgVNode *root,
+                      const gchar    *layer_name)
+{
+  const SvgVNode *o;
+
+  if (! root || ! root->children || root->children->len == 0)
+    return FALSE;
+
+  if (svg_vcount (root) > 1)
+    return TRUE;
+
+  o = g_ptr_array_index (root->children, 0);
+
+  if (o->group || o->has_transform || o->opacity < 1.0 || ! o->visible ||
+      g_strcmp0 (o->mode, "normal") || g_strcmp0 (o->name, layer_name))
+    return TRUE;
+
+  {
+    GPtrArray *painted = svg_vpainted (o);
+    gboolean   rich    = ! svg_ventries_simple (painted);
+
+    for (guint i = 0; i < painted->len && ! rich; i++)
+      {
+        const SvgVEntry *e = g_ptr_array_index (painted, i);
+
+        rich = (svg_vpaint_is_gradient (&e->paint) || e->opacity < 1.0 ||
+                (e->stroke && g_strcmp0 (e->align, "center")));
+      }
+
+    g_ptr_array_free (painted, TRUE);
+
+    return rich;
+  }
+}
+
+/*  the objects of @xml as an Inkscape layer; FALSE (nothing written) when
+ *  @xml cannot be read or, unless @force, is not « rich »
+ */
+static gboolean
+svg_vobjects_write (const gchar *xml,
+                    const gchar *layer_name,
+                    gint         layer_id,
+                    gdouble      opacity,
+                    gboolean     hidden,
+                    gboolean     force,
+                    GString     *str,
+                    const gchar *spacing)
+{
+  SvgVNode  *root = svg_vobjects_parse (xml);
+  SvgVWrite  w    = { 0, };
+  gchar     *prefix;
+  gchar     *inner;
+
+  if (! root || (! force && ! svg_vobjects_is_rich (root, layer_name)))
+    {
+      svg_vnode_free (root);
+      return FALSE;
+    }
+
+  prefix   = g_strdup_printf ("vl%d", layer_id);
+  inner    = g_strdup_printf ("%s  ", spacing);
+  w.defs   = g_string_new (NULL);
+  w.body   = g_string_new (NULL);
+  w.prefix = prefix;
+
+  /*  the root's own transformation, opacity and mode (normally none)
+   *  are those of a group around the objects
+   */
+  if (root->has_transform || root->opacity < 1.0 || root->clip ||
+      g_strcmp0 (root->mode, "normal"))
+    {
+      g_free (root->name);
+      root->name = g_strdup ("");
+      svg_vput_node (&w, root, inner);
+    }
+  else
+    {
+      for (guint i = 0; i < root->children->len; i++)
+        svg_vput_node (&w, g_ptr_array_index (root->children, i), inner);
+    }
+
+  g_string_append_printf (str, "%s<g id=\"%s\" inkscape:groupmode=\"layer\"", spacing, prefix);
+  if (opacity < 1.0)
+    {
+      g_string_append (str, " opacity=\"");
+      svg_vput_num (str, opacity);
+      g_string_append_c (str, '"');
+    }
+  if (hidden)
+    g_string_append (str, " style=\"display:none\"");
+  g_string_append (str, ">\n");
+
+  if (w.defs->len)
+    g_string_append_printf (str, "%s<defs>\n%s%s</defs>\n", inner, w.defs->str, inner);
+
+  g_string_append (str, w.body->str);
+  g_string_append_printf (str, "%s</g>\n", spacing);
+
+  g_string_free (w.defs, TRUE);
+  g_string_free (w.body, TRUE);
+  g_free (prefix);
+  g_free (inner);
+  svg_vnode_free (root);
+
+  return TRUE;
+}
