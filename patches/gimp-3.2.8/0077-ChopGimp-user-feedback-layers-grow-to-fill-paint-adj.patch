--- a/app/chopgimp-crash.c
+++ b/app/chopgimp-crash.c
@@ -559,8 +559,21 @@ chopgimp_crash_note_plugin (const gchar *procedure,
       g_free (ts);
       g_date_time_unref (now);
     }
-  else if (depth > 0)
+  else
     {
+      /*  remove the most recent run of this procedure (runs may end in
+       *  any order: plug-ins launched from menus run asynchronously)
+       */
+      gint n = MIN (depth, (gint) G_N_ELEMENTS (stack));
+      gsize len = strlen (procedure);
+
+      for (i = n - 1; i >= 0; i--)
+        if (! strncmp (stack[i], procedure, len) && stack[i][len] == ' ')
+          break;
+      if (i < 0)
+        return;
+      for (; i < n - 1; i++)
+        memcpy (stack[i], stack[i + 1], sizeof (stack[0]));
       depth--;
       g_strlcpy (last, procedure, sizeof (last));
     }
