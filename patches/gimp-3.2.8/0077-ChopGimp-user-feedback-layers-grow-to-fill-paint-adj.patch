diff --git a/app/core/chopgimp-layer-grow.c b/app/core/chopgimp-layer-grow.c
new file mode 100644
index 0000000..24edbb6
--- /dev/null
+++ b/app/core/chopgimp-layer-grow.c
@@ -0,0 +1,140 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-layer-grow.c — ChopGimp: layers without edges for filling
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+
+#include "core-types.h"
+
+#include "gimpchannel.h"
+#include "gimpcontainer.h"
+#include "gimpdrawable.h"
+#include "gimpdrawable-filters.h"
+#include "gimpimage.h"
+#include "gimpitem.h"
+#include "gimplayer.h"
+#include "gimplayer-floating-selection.h"
+#include "gimplinklayer.h"
+
+#include "path/gimpvectorlayer.h"
+#include "text/gimptextlayer.h"
+
+#include "chopgimp-layer-grow.h"
+
+
+gboolean
+chopgimp_layer_grow_for_fill (GimpDrawable *drawable,
+                              GimpContext  *context)
+{
+  GimpItem  *item;
+  GimpImage *image;
+  gint       x, y, w, h;          /*  area to fill, image coordinates  */
+  gint       lx, ly, lw, lh;      /*  layer  */
+  gint       nx1, ny1, nx2, ny2;  /*  new layer  */
+
+  if (! GIMP_IS_LAYER (drawable)                         ||
+      gimp_viewable_get_children (GIMP_VIEWABLE (drawable)) ||
+      gimp_layer_is_floating_sel (GIMP_LAYER (drawable)) ||
+      gimp_item_is_text_layer (GIMP_ITEM (drawable))     ||
+      gimp_item_is_vector_layer (GIMP_ITEM (drawable))   ||
+      gimp_item_is_link_layer (GIMP_ITEM (drawable))     ||
+      gimp_item_is_content_locked (GIMP_ITEM (drawable), NULL))
+    return FALSE;
+
+  item  = GIMP_ITEM (drawable);
+  image = gimp_item_get_image (item);
+
+  if (! gimp_item_bounds (GIMP_ITEM (gimp_image_get_mask (image)), &x, &y, &w, &h) ||
+      gimp_channel_is_empty (gimp_image_get_mask (image)))
+    {
+      x = 0;
+      y = 0;
+      w = gimp_image_get_width (image);
+      h = gimp_image_get_height (image);
+    }
+
+  /*  only what can be seen: clip to the image  */
+  if (! gimp_rectangle_intersect (x, y, w, h,
+                                  0, 0,
+                                  gimp_image_get_width (image),
+                                  gimp_image_get_height (image),
+                                  &x, &y, &w, &h))
+    return FALSE;
+
+  gimp_item_get_offset (item, &lx, &ly);
+  lw = gimp_item_get_width  (item);
+  lh = gimp_item_get_height (item);
+
+  nx1 = MIN (lx, x);
+  ny1 = MIN (ly, y);
+  nx2 = MAX (lx + lw, x + w);
+  ny2 = MAX (ly + lh, y + h);
+
+  if (nx1 == lx && ny1 == ly && nx2 == lx + lw && ny2 == ly + lh)
+    return FALSE;
+
+  gimp_item_resize (item, context, GIMP_FILL_TRANSPARENT,
+                    nx2 - nx1, ny2 - ny1, lx - nx1, ly - ny1);
+
+  return TRUE;
+}
+
+#define WARN_HIDDEN  (1 << 0)
+#define WARN_OPACITY (1 << 1)
+#define WARN_FILTERS (1 << 2)
+
+gchar *
+chopgimp_layer_paint_warning (GimpDrawable *drawable)
+{
+  guint   warned;
+  guint   reason = 0;
+  gchar  *msg    = NULL;
+
+  if (! GIMP_IS_LAYER (drawable))
+    return NULL;
+
+  warned = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (drawable),
+                                                "chopgimp-paint-warned"));
+
+  if (! gimp_item_is_visible (GIMP_ITEM (drawable)))
+    {
+      reason = WARN_HIDDEN;
+      msg = g_strdup_printf ("Le calque « %s » est masqué : ce que vous peignez ne se voit pas.",
+                             gimp_object_get_name (drawable));
+    }
+  else if (gimp_layer_get_opacity (GIMP_LAYER (drawable)) < 0.5)
+    {
+      reason = WARN_OPACITY;
+      msg = g_strdup_printf ("Le calque « %s » est à %d %% d'opacité : les couleurs paraissent pâles.",
+                             gimp_object_get_name (drawable),
+                             (gint) (gimp_layer_get_opacity (GIMP_LAYER (drawable)) * 100.0 + 0.5));
+    }
+  else if (gimp_drawable_has_visible_filters (drawable))
+    {
+      reason = WARN_FILTERS;
+      msg = g_strdup_printf ("Le calque « %s » a des filtres actifs (icône fx) : la couleur "
+                             "affichée est filtrée. Fusionnez-les pour peindre en vraies couleurs.",
+                             gimp_object_get_name (drawable));
+    }
+
+  if (! reason || (warned & reason))
+    {
+      g_free (msg);
+      return NULL;
+    }
+
+  g_object_set_data (G_OBJECT (drawable), "chopgimp-paint-warned",
+                     GUINT_TO_POINTER (warned | reason));
+  return msg;
+}
diff --git a/app/core/chopgimp-layer-grow.h b/app/core/chopgimp-layer-grow.h
new file mode 100644
index 0000000..5ee0e7c
--- /dev/null
+++ b/app/core/chopgimp-layer-grow.h
@@ -0,0 +1,28 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-layer-grow.h — ChopGimp: layers without edges for filling
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+/*  Grow (never shrink) a pixel layer so that it covers the area about to
+ *  be filled: the selection's bounds, or the whole image without a
+ *  selection, clipped to the image. Photoshop layers have no edges; in
+ *  GIMP a selection outside the layer would silently not be filled.
+ *  Does nothing for groups, text, vector, link and floating layers, and
+ *  for channels and masks. Pushes its own undo step (call it inside the
+ *  fill's undo group). Returns TRUE if the layer was resized.
+ */
+gboolean   chopgimp_layer_grow_for_fill   (GimpDrawable *drawable,
+                                           GimpContext  *context);
+
+/*  Status-bar hint when painting or filling would not show as expected:
+ *  hidden layer, low opacity, or live filters on the layer. Returns a
+ *  newly allocated message, or NULL; each reason is reported once per
+ *  layer and session.
+ */
+gchar    * chopgimp_layer_paint_warning   (GimpDrawable *drawable);
