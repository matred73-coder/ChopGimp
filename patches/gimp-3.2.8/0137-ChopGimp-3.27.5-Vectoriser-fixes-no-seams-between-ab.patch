+/*  3.27.5: the signature of the objects in traced coordinates (mapped
+ *  back through @matrix): "<sha1 of the XML without the path data>
+ *  <number of coordinates> <4 weighted sums of the points> <root of the
+ *  sum of their squares>" (for the tolerance: the XCF keeps the path
+ *  points as 32-bit floats, a relative error of 6e-8 per coordinate).
+ *  Moving, scaling… the layer keeps it; any other change of the objects
+ *  (a node, a style, an object added or removed) changes it.
+ */
+static gchar *
+objects_signature (GimpVectorLayer *layer,
+                   const gdouble    matrix[6])
+{
+  gchar          *xml   = chopgimp_vlayer_get_xml (layer);
+  GString        *style = g_string_new (NULL);
+  cairo_matrix_t  inv;
+  const gchar    *p;
+  gdouble         s[4] = { 0, 0, 0, 0 };
+  gdouble         mag  = 0.0;
+  guint64         n    = 0;
+  gchar          *sum;
+  gchar          *sig;
+  gchar           buf[7][G_ASCII_DTOSTR_BUF_SIZE];
+
+  cairo_matrix_init (&inv, matrix[0], matrix[1], matrix[2], matrix[3],
+                     matrix[4], matrix[5]);
+  if (cairo_matrix_invert (&inv) != CAIRO_STATUS_SUCCESS)
+    cairo_matrix_init_identity (&inv);
+
+  /*  « options-style » (the layer's own fill / stroke, kept to notice
+   *  their changes) is not an object, and its colors are stored as
+   *  floats by the XCF: out of the digest
+   */
+  if (xml)
+    {
+      gchar *os = strstr (xml, " options-style=\"");
+
+      if (os)
+        {
+          gchar *end = strchr (os + 16, '"');
+
+          if (end)
+            memmove (os, end + 1, strlen (end + 1) + 1);
+        }
+    }
+
+  for (p = xml ? xml : ""; *p; )
+    {
+      const gchar *d = strstr (p, " d=\"");
+      gdouble      v[2];
+      gint         k = 0;
+
+      if (! d)
+        {
+          g_string_append (style, p);
+          break;
+        }
+
+      g_string_append_len (style, p, d - p);
+      p = d + 4;
+
+      while (*p && *p != '"')
+        {
+          gchar *end;
+
+          if (g_ascii_isalpha (*p) && *p != 'e' && *p != 'E')
+            {
+              g_string_append_c (style, *p);
+              p++;
+              continue;
+            }
+          if (*p == ' ' || *p == ',')
+            {
+              p++;
+              continue;
+            }
+
+          v[k] = g_ascii_strtod (p, &end);
+          if (end == p)
+            {
+              p++;
+              continue;
+            }
+          p = end;
+
+          if (++k == 2)
+            {
+              gdouble x = v[0], y = v[1];
+              guint32 i = (guint32) (n / 2);
+              gdouble w1 = 1.0 + (((i * 2654435761u) >> 16) & 0xffff) / 65536.0;
+              gdouble w2 = 1.0 + ((((i ^ 0x5bd1e995u) * 2246822519u) >> 16) & 0xffff) / 65536.0;
+
+              cairo_matrix_transform_point (&inv, &x, &y);
+              s[0] += w1 * x; s[1] += w1 * y;
+              s[2] += w2 * x; s[3] += w2 * y;
+              mag  += (w1 * w1 + w2 * w2) * (x * x + y * y);
+              k = 0;
+            }
+          n++;
+        }
+      if (*p == '"')
+        p++;
+    }
+
+  sum = g_compute_checksum_for_string (G_CHECKSUM_SHA1, style->str, style->len);
+  sig = g_strdup_printf ("%s %" G_GUINT64_FORMAT " %s %s %s %s %s", sum, n,
+                         g_ascii_formatd (buf[0], sizeof (buf[0]), "%.17g", s[0]),
+                         g_ascii_formatd (buf[1], sizeof (buf[1]), "%.17g", s[1]),
+                         g_ascii_formatd (buf[2], sizeof (buf[2]), "%.17g", s[2]),
+                         g_ascii_formatd (buf[3], sizeof (buf[3]), "%.17g", s[3]),
+                         g_ascii_formatd (buf[4], sizeof (buf[4]), "%.17g", sqrt (mag)));
+  g_free (sum);
+  g_string_free (style, TRUE);
+  g_free (xml);
+
+  return sig;
+}
+
+static gboolean
+signatures_match (const gchar *a,
+                  const gchar *b)
+{
+  gchar  **ta, **tb;
+  gboolean same = FALSE;
+
+  if (! a || ! b)
+    return FALSE;
+
+  ta = g_strsplit (a, " ", -1);
+  tb = g_strsplit (b, " ", -1);
+
+  if (g_strv_length (ta) == 7 && g_strv_length (tb) == 7 &&
+      ! strcmp (ta[0], tb[0]) && ! strcmp (ta[1], tb[1]))
+    {
+      /*  float rounding: independent errors, 6 standard deviations  */
+      gdouble rms = MAX (g_ascii_strtod (ta[6], NULL), g_ascii_strtod (tb[6], NULL));
+      gdouble tol = 1e-3 + 4e-7 * rms;
+
+      same = TRUE;
+      for (gint i = 2; i < 6; i++)
+        if (fabs (g_ascii_strtod (ta[i], NULL) - g_ascii_strtod (tb[i], NULL)) > tol)
+          same = FALSE;
+    }
+
+  g_strfreev (ta);
+  g_strfreev (tb);
+
+  return same;
+}
