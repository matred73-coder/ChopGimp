+void
+chopgimp_trace_path_transformed (GimpPath          *path,
+                                 const GimpMatrix3 *matrix,
+                                 gboolean           push_undo)
+{
+  GimpImage *image = gimp_item_get_image (GIMP_ITEM (path));
+  GList     *layers;
+  gdouble    m[6] = { matrix->coeff[0][0], matrix->coeff[1][0],
+                      matrix->coeff[0][1], matrix->coeff[1][1],
+                      matrix->coeff[0][2], matrix->coeff[1][2] };
+
+  if (! image)
+    return;
+
+  layers = gimp_image_get_layer_list (image);
+
+  for (GList *l = layers; l; l = l->next)
+    {
+      GimpVectorLayer *vl;
+
+      if (! GIMP_IS_VECTOR_LAYER (l->data))
+        continue;
+
+      vl = GIMP_VECTOR_LAYER (l->data);
+
+      if (vl->options && vl->options->path == path &&
+          chopgimp_trace_layer_is_live (GIMP_ITEM (vl)))
+        chopgimp_trace_layer_transformed (vl, m,
+                                          push_undo &&
+                                          gimp_item_is_attached (GIMP_ITEM (vl)));
+    }
+
+  g_list_free (layers);
+}
