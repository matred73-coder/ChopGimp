+/*  the path data of @g through @m (cairo order: xx yx xy yy x0 y0)  */
+static std::string
+geometry_to_d (const Geometry &g, const gdouble *m)
+{
+  std::string d;
+  gsize       k = 0;
+
+  auto pt = [&] (float x, float y)
+    {
+      append_pt (d, m[0] * x + m[2] * y + m[4], m[1] * x + m[3] * y + m[5]);
+    };
+
+  for (guint8 op : g.ops)
+    {
+      if (! d.empty ())
+        d += ' ';
+      switch (op)
+        {
+        case OP_MOVE:  d += 'M'; pt (g.pts[k], g.pts[k + 1]); k += 2; break;
+        case OP_LINE:  d += 'L'; pt (g.pts[k], g.pts[k + 1]); k += 2; break;
+        case OP_CURVE:
+          d += 'C';
+          pt (g.pts[k], g.pts[k + 1]);     d += ' ';
+          pt (g.pts[k + 2], g.pts[k + 3]); d += ' ';
+          pt (g.pts[k + 4], g.pts[k + 5]);
+          k += 6;
+          break;
+        case OP_CLOSE: d += 'Z'; break;
+        }
+    }
+  return d;
+}
