+/*  the traced area in image coordinates (through the live trace matrix)  */
+static void
+traced_bounds (Dialog  *d,
+               gdouble *x1,
+               gdouble *y1,
+               gdouble *x2,
+               gdouble *y2)
+{
+  const GeglRectangle *r = &d->source->rect;
+  const gdouble       *m = d->source->matrix;
+
+  *x1 = *y1 = G_MAXDOUBLE;
+  *x2 = *y2 = -G_MAXDOUBLE;
+
+  for (gint i = 0; i < 4; i++)
+    {
+      gdouble ax = r->x + ((i & 1) ? r->width  : 0);
+      gdouble ay = r->y + ((i & 2) ? r->height : 0);
+      gdouble ix = m[0] * ax + m[2] * ay + m[4];
+      gdouble iy = m[1] * ax + m[3] * ay + m[5];
+
+      *x1 = MIN (*x1, ix); *y1 = MIN (*y1, iy);
+      *x2 = MAX (*x2, ix); *y2 = MAX (*y2, iy);
+    }
+}
+
+/*  the view shows the traced area left of the on-canvas dialog (zooming
+ *  out only if needed); restored when the dialog goes, unless the user
+ *  changed the view meanwhile
+ */
+static gboolean
+make_room (Dialog *d)
+{
+  GimpDisplayShell *shell = dialog_shell (d);
+  GtkAllocation     a;
+  gdouble           x1, y1, x2, y2;
+  gdouble           zoom, ratio;
+  gint              free_w, disp_h;
+  gint              ox, oy;
+
+  d->room_id = 0;
+
+  if (d->closed || ! shell || ! d->in_panel || shell->rotate_transform)
+    return G_SOURCE_REMOVE;
+
+  gtk_widget_get_allocation (d->dialog, &a);
+  free_w = shell->disp_width;
+  disp_h = shell->disp_height;
+
+  if (a.width <= 1 || free_w < 160 || disp_h < 160)
+    return G_SOURCE_REMOVE;
+
+  traced_bounds (d, &x1, &y1, &x2, &y2);
+
+  /*  already in view  */
+  if (x1 * shell->scale_x - shell->offset_x >= 0                     &&
+      x2 * shell->scale_x - shell->offset_x <= free_w                &&
+      y1 * shell->scale_y - shell->offset_y >= 0                     &&
+      y2 * shell->scale_y - shell->offset_y <= disp_h)
+    return G_SOURCE_REMOVE;
+
+  zoom  = gimp_zoom_model_get_factor (shell->zoom);
+  ratio = MIN (1.0, MIN ((free_w - 16) / MAX (1.0, (x2 - x1) * shell->scale_x),
+                         (disp_h - 16) / MAX (1.0, (y2 - y1) * shell->scale_y)));
+
+  ox = (gint) floor ((x1 + x2) / 2.0 * shell->scale_x * ratio - free_w / 2.0 + 0.5);
+  oy = (gint) floor ((y1 + y2) / 2.0 * shell->scale_y * ratio - disp_h / 2.0 + 0.5);
+
+  d->old_zoom = zoom;
+  d->old_offx = shell->offset_x;
+  d->old_offy = shell->offset_y;
+
+  gimp_display_shell_scale_by_values (shell, zoom * ratio, ox, oy, FALSE);
+
+  d->view_moved = TRUE;
+  d->set_zoom   = gimp_zoom_model_get_factor (shell->zoom);
+  d->set_offx   = shell->offset_x;
+  d->set_offy   = shell->offset_y;
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+restore_view (Dialog *d)
+{
+  GimpDisplayShell *shell = dialog_shell (d);
+
+  if (d->room_id)
+    g_source_remove (d->room_id);
+  d->room_id = 0;
+
+  if (d->view_moved && shell &&
+      ! gtk_widget_in_destruction (GTK_WIDGET (shell)) &&
+      gimp_zoom_model_get_factor (shell->zoom) == d->set_zoom &&
+      shell->offset_x == d->set_offx && shell->offset_y == d->set_offy)
+    gimp_display_shell_scale_by_values (shell, d->old_zoom,
+                                        d->old_offx, d->old_offy, FALSE);
+
+  d->view_moved = FALSE;
+}
+
+static void
+panel_allocated (GtkWidget     *widget,
+                   GtkAllocation *allocation,
+                   Dialog        *d)
+{
+  if (! d->view_moved && ! d->room_id && allocation->width > 1)
+    d->room_id = g_idle_add ((GSourceFunc) make_room, d);
+}
+
+/*  « Détacher »: the same options, in a window (from an idle: not while
+ *  the panel's button emits « clicked »)
+ */
+static void
+panel_detach (Dialog *d)
+{
+  GtkWidget        *old   = d->dialog;
+  GimpDisplayShell *shell = dialog_shell (d);
+
+  prefer_window = TRUE;
+
+  restore_view (d);
+
+  g_object_ref (d->content);
+  gtk_container_remove (GTK_CONTAINER (old), d->content);
+
+  g_signal_handlers_disconnect_by_data (old, d);
+  g_object_steal_data (G_OBJECT (old), "chopgimp-trace");
+
+  dialog_container_new (d, shell ? GTK_WIDGET (shell) : NULL, FALSE);
+  g_object_unref (d->content);
+
+  gtk_widget_destroy (old);
+
+  /*  a run belongs to its container: start it again in the new one  */
+  if (d->running)
+    start_trace (d);
+}
+
+static void
+panel_button_clicked (GtkWidget *button,
+                      Dialog    *d)
+{
+  dialog_response (d->dialog,
+                   GPOINTER_TO_INT (g_object_get_data (G_OBJECT (button), "response")),
+                   d);
+}
+
+static gboolean
+detach_idle (GtkWidget *dialog)
+{
+  Dialog *d = g_object_get_data (G_OBJECT (dialog), "chopgimp-trace");
+
+  if (d && ! d->closed && d->dialog == dialog)
+    panel_detach (d);
+
+  g_object_unref (dialog);
+
+  return G_SOURCE_REMOVE;
+}
