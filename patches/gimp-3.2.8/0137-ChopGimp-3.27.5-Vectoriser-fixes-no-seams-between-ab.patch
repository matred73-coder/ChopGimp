+int
+pixel_block_size (const std::vector<guint8> &px, int w, int h, int &x0, int &y0)
+{
+  auto same = [&] (gsize a, gsize b)
+    {
+      return ! memcmp (&px[a * 4], &px[b * 4], 4);
+    };
+  auto gcd = [] (long a, long b)
+    {
+      a = labs (a); b = labs (b);
+      while (b) { long t = a % b; a = b; b = t; }
+      return a;
+    };
+
+  long gx = 0, gy = 0, rx = -1, ry = -1;
+
+  for (int y = 0; y < h; y++)
+    for (int x = 1; x < w; x++)
+      if (! same ((gsize) y * w + x, (gsize) y * w + x - 1))
+        {
+          if (rx < 0)
+            rx = x;
+          else
+            gx = gcd (gx, x - rx);
+          if (gx == 1)
+            return 1;
+        }
+
+  for (int x = 0; x < w; x++)
+    for (int y = 1; y < h; y++)
+      if (! same ((gsize) y * w + x, (gsize) (y - 1) * w + x))
+        {
+          if (ry < 0)
+            ry = y;
+          else
+            gy = gcd (gy, y - ry);
+          if (gy == 1)
+            return 1;
+        }
