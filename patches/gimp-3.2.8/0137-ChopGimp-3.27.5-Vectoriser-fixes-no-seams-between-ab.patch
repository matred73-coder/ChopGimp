+void
+chopgimp_trace_layer_get_matrix (GimpVectorLayer *layer,
+                                 gdouble          matrix[6])
+{
+  const GimpParasite *parasite;
+  guint32             size = 0;
+  const gchar        *data;
+
+  matrix[0] = 1.0; matrix[1] = 0.0; matrix[2] = 0.0;
+  matrix[3] = 1.0; matrix[4] = 0.0; matrix[5] = 0.0;
+
+  parasite = gimp_item_parasite_find (GIMP_ITEM (layer), CHOPGIMP_TRACE_MATRIX_PARASITE);
+  data     = parasite ? gimp_parasite_get_data (parasite, &size) : NULL;
+
+  if (data && size > 0 && size < 1024)
+    {
+      gchar   *text = g_strndup (data, size);
+      gchar  **v    = g_strsplit_set (g_strstrip (text), " \t\n", -1);
+      gdouble  m[6];
+      gint     n    = 0;
+
+      for (gint i = 0; v[i] && n < 6; i++)
+        if (*v[i])
+          m[n++] = g_ascii_strtod (v[i], NULL);
+
+      if (n == 6 && fabs (m[0] * m[3] - m[1] * m[2]) > 1e-12)
+        memcpy (matrix, m, sizeof (m));
+
+      g_strfreev (v);
+      g_free (text);
+    }
+}
+
+void
+chopgimp_trace_layer_transformed (GimpVectorLayer *layer,
+                                  const gdouble    matrix[6],
+                                  gboolean         push_undo)
+{
+  cairo_matrix_t old, t, res;
+  gdouble        m[6];
+
+  if (! chopgimp_trace_layer_is_live (GIMP_ITEM (layer)))
+    return;
+
+  chopgimp_trace_layer_get_matrix (layer, m);
+  cairo_matrix_init (&old, m[0], m[1], m[2], m[3], m[4], m[5]);
+  cairo_matrix_init (&t, matrix[0], matrix[1], matrix[2], matrix[3],
+                     matrix[4], matrix[5]);
+  /*  the old one first, then @matrix  */
+  cairo_matrix_multiply (&res, &old, &t);
+
+  if (fabs (res.xx - 1.0) < 1e-12 && fabs (res.yx) < 1e-12 &&
+      fabs (res.xy) < 1e-12 && fabs (res.yy - 1.0) < 1e-12 &&
+      fabs (res.x0) < 1e-9 && fabs (res.y0) < 1e-9)
+    {
+      if (gimp_item_parasite_find (GIMP_ITEM (layer), CHOPGIMP_TRACE_MATRIX_PARASITE))
+        gimp_item_parasite_detach (GIMP_ITEM (layer), CHOPGIMP_TRACE_MATRIX_PARASITE,
+                                   push_undo);
+    }
+  else
+    {
+      gchar         b[6][G_ASCII_DTOSTR_BUF_SIZE];
+      gchar        *text;
+      GimpParasite *parasite;
+
+      text = g_strdup_printf ("%s %s %s %s %s %s",
+                              g_ascii_formatd (b[0], sizeof (b[0]), "%.17g", res.xx),
+                              g_ascii_formatd (b[1], sizeof (b[1]), "%.17g", res.yx),
+                              g_ascii_formatd (b[2], sizeof (b[2]), "%.17g", res.xy),
+                              g_ascii_formatd (b[3], sizeof (b[3]), "%.17g", res.yy),
+                              g_ascii_formatd (b[4], sizeof (b[4]), "%.17g", res.x0),
+                              g_ascii_formatd (b[5], sizeof (b[5]), "%.17g", res.y0));
+      parasite = gimp_parasite_new (CHOPGIMP_TRACE_MATRIX_PARASITE,
+                                    GIMP_PARASITE_PERSISTENT | GIMP_PARASITE_UNDOABLE,
+                                    strlen (text) + 1, text);
+      gimp_item_parasite_attach (GIMP_ITEM (layer), parasite, push_undo);
+      gimp_parasite_free (parasite);
+      g_free (text);
+    }
+}
