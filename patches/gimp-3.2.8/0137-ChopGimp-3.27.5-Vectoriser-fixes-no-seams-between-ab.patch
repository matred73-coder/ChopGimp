+  if (k < 2 || k > MIN (w, h) / 2)
+    return 1;
+
+  x0 = rx >= 0 ? (int) (rx % k) : 0;
+  y0 = ry >= 0 ? (int) (ry % k) : 0;
+
+  return (int) k;
