@@ -0,0 +1,71 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-cmyk.h — ChopGimp 4.2.0: CMYK the Photoshop way
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+
+/*  the image is in « CMJN » mode: a persistent parasite; its CMYK profile
+ *  is the simulation profile, the display soft-proofs it and the exports
+ *  that can write CMYK (TIFF, JPEG, PSD) do it by default
+ */
+#define CHOPGIMP_CMYK_PARASITE "chopgimp-cmyk-mode"
+
+/*  the CMYK profiles shipped (FOGRA39, ECI) or downloaded (PSO v3, ECI)  */
+#define CHOPGIMP_CMYK_ISO_COATED_V2  "ISOcoated_v2_eci.icc"
+#define CHOPGIMP_CMYK_PSO_COATED_V3  "PSOcoated_v3.icc"
+#define CHOPGIMP_CMYK_PSO_UNCOATED_V3 "PSOuncoated_v3_FOGRA52.icc"
+
+
+void               chopgimp_cmyk_init                (Gimp              *gimp);
+
+/*  every CMYK profile file ChopGimp knows: the user's downloaded ones,
+ *  then the shipped ones (GFile *, g_list_free_full g_object_unref)
+ */
+GList            * chopgimp_cmyk_list_profiles       (Gimp              *gimp);
+gboolean           chopgimp_cmyk_have_pso            (Gimp              *gimp);
+
+/*  @profile when it is a CMYK profile lcms can convert to and from (ref),
+ *  else NULL and @error says why: never use a profile that would crash
+ */
+GimpColorProfile * chopgimp_cmyk_check_profile       (GimpColorProfile  *profile,
+                                                      GError           **error);
+/*  the working CMYK profile: the preference, else PSO Coated v3 when
+ *  downloaded, else ISO Coated v2 (shipped); an unusable preference is
+ *  replaced and @warning (may be NULL, g_free) says it.  NULL only when
+ *  no CMYK profile at all can be used.
+ */
+GimpColorProfile * chopgimp_cmyk_get_preferred       (Gimp              *gimp,
+                                                      gchar            **warning);
+/*  makes @file the preferred CMYK profile (checked first)  */
+gboolean           chopgimp_cmyk_set_preferred       (Gimp              *gimp,
+                                                      GFile             *file,
+                                                      GError           **error);
+
+gboolean           chopgimp_image_is_cmyk            (GimpImage         *image);
+/*  Image > Mode > CMJN (@cmyk) or back to RVB: one undo step. @profile
+ *  NULL: the image's simulation profile when it is a usable CMYK one,
+ *  else the working CMYK profile.
+ */
+gboolean           chopgimp_image_set_cmyk           (GimpImage         *image,
+                                                      gboolean           cmyk,
+                                                      GimpColorProfile  *profile,
+                                                      GError           **error);
+/*  « Convertir en profil » CMYK → CMYK: the pixels of the raster layers
+ *  change so that their CMYK values under @dest are the ones of the
+ *  current CMYK profile converted with @intent and @bpc (gamut of both
+ *  profiles); @dest becomes the simulation profile. One undo step.
+ */
+gboolean           chopgimp_image_convert_cmyk_profile (GimpImage       *image,
+                                                      GimpColorProfile  *dest,
+                                                      GimpColorRenderingIntent intent,
+                                                      gboolean           bpc,
+                                                      GimpProgress      *progress,
+                                                      GError           **error);
