+
+/*  GIMP keeps its pixels in RGB. ChopGimp's « CMJN » mode reuses what
+ *  GIMP 3 already has: the image's simulation profile is its CMYK profile,
+ *  the display soft-proofs it, the color selectors work in it and the
+ *  exports write CMYK through it. Here: which CMYK profile (the shipped
+ *  ISO Coated v2, the downloaded PSO v3, the preference), the mode itself
+ *  and the CMYK → CMYK conversion. A profile lcms cannot convert with is
+ *  never used (a message, and the next usable one): see babl patch 0003.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <cairo.h>
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include <lcms2.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpcolor/gimpcolor.h"
+#include "libgimpconfig/gimpconfig.h"
+
+#include "core-types.h"
+
+#include "config/gimpcoreconfig.h"
+
+#include "gimp.h"
+#include "gimpdrawable.h"
+#include "gimpimage.h"
+#include "gimpimage-color-profile.h"
+#include "gimpimage-undo.h"
+#include "gimplayer.h"
+#include "gimpprogress.h"
+
+#include "path/gimpvectorlayer.h"
+#include "text/gimptextlayer.h"
+
+#include "chopgimp-cmyk.h"
+
+#include "gimp-intl.h"
+
+
+static GFile *
+bundled_file (const gchar *name)
+{
+  return gimp_data_directory_file ("color", name, NULL);
+}
+
+static GFile *
+user_file (const gchar *name)
+{
+  return gimp_directory_file ("profiles", name, NULL);
+}
+
+static gboolean
+file_exists (GFile *file)
+{
+  return file && g_file_query_exists (file, NULL);
+}
+
+static GFile *
+config_file (Gimp *gimp)
+{
+  GimpColorConfig *config = gimp->config->color_management;
+  gchar           *path   = NULL;
+  GFile           *file   = NULL;
+
+  g_object_get (config, "cmyk-profile", &path, NULL);
+
+  if (path && *path)
+    file = gimp_file_new_for_config_path (path, NULL);
+
+  g_free (path);
+
+  return file;
+}
+
+gboolean
+chopgimp_cmyk_have_pso (Gimp *gimp)
+{
+  GFile    *file = user_file (CHOPGIMP_CMYK_PSO_COATED_V3);
+  gboolean  have = file_exists (file);
+
+  g_object_unref (file);
+
+  return have;
+}
+
+/*  at startup: no CMYK preference yet (or still the shipped FOGRA39 while
+ *  PSO Coated v3 was downloaded since) → the best profile available, so
+ *  that GIMP's own CMYK code (selectors, exports) uses it too
+ */
+void
+chopgimp_cmyk_init (Gimp *gimp)
+{
+  GFile *current = config_file (gimp);
+  GFile *iso     = bundled_file (CHOPGIMP_CMYK_ISO_COATED_V2);
+  GFile *pso     = user_file (CHOPGIMP_CMYK_PSO_COATED_V3);
+  GFile *best    = file_exists (pso) ? pso : (file_exists (iso) ? iso : NULL);
+
+  if (best && (! current || ! file_exists (current) ||
+               (best == pso && g_file_equal (current, iso))))
+    chopgimp_cmyk_set_preferred (gimp, best, NULL);
+
+  g_clear_object (&current);
+  g_object_unref (iso);
+  g_object_unref (pso);
+}
+
+GList *
+chopgimp_cmyk_list_profiles (Gimp *gimp)
+{
+  static const gchar *const user_names[] = { CHOPGIMP_CMYK_PSO_COATED_V3,
+                                             CHOPGIMP_CMYK_PSO_UNCOATED_V3 };
+  GList *list = NULL;
+  GFile *file;
+
+  for (guint i = 0; i < G_N_ELEMENTS (user_names); i++)
+    {
+      file = user_file (user_names[i]);
+
+      if (file_exists (file))
+        list = g_list_append (list, file);
+      else
+        g_object_unref (file);
+    }
+
+  file = bundled_file (CHOPGIMP_CMYK_ISO_COATED_V2);
+
+  if (file_exists (file))
+    list = g_list_append (list, file);
+  else
+    g_object_unref (file);
+
+  return list;
+}
+
+GimpColorProfile *
+chopgimp_cmyk_check_profile (GimpColorProfile  *profile,
+                             GError           **error)
+{
+  cmsHPROFILE   srgb;
+  cmsHPROFILE   cmyk;
+  cmsHTRANSFORM to_cmyk   = NULL;
+  cmsHTRANSFORM from_cmyk = NULL;
+  gboolean      ok;
+
+  if (! profile)
+    {
+      g_set_error_literal (error, GIMP_CONFIG_ERROR, GIMP_CONFIG_ERROR_PARSE,
+                           _("Aucun profil CMJN."));
+      return NULL;
+    }
+
+  if (! gimp_color_profile_is_cmyk (profile))
+    {
+      g_set_error (error, GIMP_CONFIG_ERROR, GIMP_CONFIG_ERROR_PARSE,
+                   _("« %s » n'est pas un profil CMJN."),
+                   gimp_color_profile_get_label (profile));
+      return NULL;
+    }
+
+  /*  a profile lcms opens but cannot build transforms with (no B2A tag,
+   *  like the scanner profile of « Matslogo copier.psd ») is refused
+   */
+  srgb = cmsCreate_sRGBProfile ();
+  cmyk = gimp_color_profile_get_lcms_profile (profile);
+
+  if (cmyk)
+    {
+      to_cmyk   = cmsCreateTransform (srgb, TYPE_RGB_FLT, cmyk, TYPE_CMYK_FLT,
+                                      INTENT_RELATIVE_COLORIMETRIC, 0);
+      from_cmyk = cmsCreateTransform (cmyk, TYPE_CMYK_FLT, srgb, TYPE_RGB_FLT,
+                                      INTENT_RELATIVE_COLORIMETRIC, 0);
+    }
+
+  ok = (to_cmyk && from_cmyk);
+
+  if (to_cmyk)
+    cmsDeleteTransform (to_cmyk);
+  if (from_cmyk)
+    cmsDeleteTransform (from_cmyk);
+  cmsCloseProfile (srgb);
+
+  if (! ok)
+    {
+      g_set_error (error, GIMP_CONFIG_ERROR, GIMP_CONFIG_ERROR_PARSE,
+                   _("Le profil CMJN « %s » ne permet pas de convertir les couleurs "
+                     "(table de conversion absente ou illisible)."),
+                   gimp_color_profile_get_label (profile));
+      return NULL;
+    }
+
+  return g_object_ref (profile);
+}
+
+static GimpColorProfile *
+profile_from_file (GFile   *file,
+                   GError **error)
+{
+  GimpColorProfile *profile;
+  GimpColorProfile *checked;
+
+  if (! file_exists (file))
+    {
+      g_set_error (error, GIMP_CONFIG_ERROR, GIMP_CONFIG_ERROR_OPEN,
+                   _("Profil introuvable : %s"), gimp_file_get_utf8_name (file));
+      return NULL;
+    }
+
+  profile = gimp_color_profile_new_from_file (file, error);
+
+  if (! profile)
+    return NULL;
+
+  checked = chopgimp_cmyk_check_profile (profile, error);
+  g_object_unref (profile);
+
+  return checked;
+}
+
+GimpColorProfile *
+chopgimp_cmyk_get_preferred (Gimp   *gimp,
+                             gchar **warning)
+{
+  GFile            *candidates[3];
+  GimpColorProfile *profile = NULL;
+  GError           *first   = NULL;
+
+  g_return_val_if_fail (GIMP_IS_GIMP (gimp), NULL);
+
+  candidates[0] = config_file (gimp);
+  candidates[1] = user_file (CHOPGIMP_CMYK_PSO_COATED_V3);
+  candidates[2] = bundled_file (CHOPGIMP_CMYK_ISO_COATED_V2);
+
+  for (gint i = 0; i < 3 && ! profile; i++)
+    {
+      GError *error = NULL;
+
+      if (! candidates[i])
+        continue;
+
+      profile = profile_from_file (candidates[i], &error);
+
+      if (! profile && i == 0)
+        first = error;
+      else
+        g_clear_error (&error);
+    }
+
+  if (first && warning)
+    *warning = g_strdup_printf (_("%s\nProfil CMJN utilisé à la place : %s"),
+                                first->message,
+                                profile ? gimp_color_profile_get_label (profile)
+                                        : _("aucun"));
+  g_clear_error (&first);
+
+  for (gint i = 0; i < 3; i++)
+    g_clear_object (&candidates[i]);
+
+  return profile;
+}
+
+gboolean
+chopgimp_cmyk_set_preferred (Gimp    *gimp,
+                             GFile   *file,
+                             GError **error)
+{
+  GimpColorProfile *profile = profile_from_file (file, error);
+  gchar            *path;
+
+  if (! profile)
+    return FALSE;
+
+  g_object_unref (profile);
+
+  path = gimp_file_get_config_path (file, NULL);
+  g_object_set (gimp->config->color_management, "cmyk-profile", path, NULL);
+  g_free (path);
+
+  return TRUE;
+}
+
+
+/*  ─── the « CMJN » mode ────────────────────────────────────────────── */
+
+gboolean
+chopgimp_image_is_cmyk (GimpImage *image)
+{
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), FALSE);
+
+  return gimp_image_parasite_find (image, CHOPGIMP_CMYK_PARASITE) != NULL;
+}
+
+gboolean
+chopgimp_image_set_cmyk (GimpImage         *image,
+                         gboolean           cmyk,
+                         GimpColorProfile  *profile,
+                         GError           **error)
+{
+  GimpColorProfile *use = NULL;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), FALSE);
+
+  if (cmyk)
+    {
+      if (profile)
+        use = chopgimp_cmyk_check_profile (profile, error);
+      else if (gimp_image_get_simulation_profile (image))
+        use = chopgimp_cmyk_check_profile (gimp_image_get_simulation_profile (image), NULL);
+
+      if (profile && ! use)
+        return FALSE;
+
+      if (! use)
+        {
+          gchar *warning = NULL;
+
+          use = chopgimp_cmyk_get_preferred (image->gimp, &warning);
+
+          if (warning)
+            {
+              gimp_message_literal (image->gimp, NULL, GIMP_MESSAGE_WARNING, warning);
+              g_free (warning);
+            }
+        }
+
+      if (! use)
+        {
+          g_set_error_literal (error, GIMP_CONFIG_ERROR, GIMP_CONFIG_ERROR_OPEN,
+                               _("Aucun profil CMJN utilisable : l'image reste en RVB."));
+          return FALSE;
+        }
+    }
+
+  if (cmyk == chopgimp_image_is_cmyk (image) &&
+      (! use || use == gimp_image_get_simulation_profile (image) ||
+       (gimp_image_get_simulation_profile (image) &&
+        gimp_color_profile_is_equal (use, gimp_image_get_simulation_profile (image)))))
+    {
+      g_clear_object (&use);
+      return TRUE;
+    }
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_IMAGE_CONVERT,
+                               cmyk ? _("Mode CMJN") : _("Mode RVB"));
+
+  if (cmyk)
+    {
+      GimpParasite *parasite = gimp_parasite_new (CHOPGIMP_CMYK_PARASITE,
+                                                  GIMP_PARASITE_PERSISTENT |
+                                                  GIMP_PARASITE_UNDOABLE,
+                                                  2, "1");
+
+      if (! gimp_image_get_simulation_profile (image) ||
+          ! gimp_color_profile_is_equal (use, gimp_image_get_simulation_profile (image)))
+        gimp_image_set_simulation_profile (image, use);
+
+      gimp_image_parasite_attach (image, parasite, TRUE);
+      gimp_parasite_free (parasite);
+    }
+  else
+    {
+      gimp_image_parasite_detach (image, CHOPGIMP_CMYK_PARASITE, TRUE);
+    }
+
+  gimp_image_undo_group_end (image);
+
+  g_clear_object (&use);
+
+  return TRUE;
+}
+
+
+/*  ─── Convertir en profil (CMYK → CMYK) ───────────────────────────── */
+
+gboolean
+chopgimp_image_convert_cmyk_profile (GimpImage                *image,
+                                     GimpColorProfile         *dest,
+                                     GimpColorRenderingIntent  intent,
+                                     gboolean                  bpc,
+                                     GimpProgress             *progress,
+                                     GError                  **error)
+{
+  GimpColorProfile *rgb;
+  GimpColorProfile *src     = NULL;
+  GimpColorProfile *dst     = NULL;
+  const Babl       *format;
+  cmsHPROFILE       chain[6];
+  cmsBool           bpcs[6];
+  cmsUInt32Number   intents[6];
+  cmsFloat64Number  adapt[6];
+  cmsHTRANSFORM     transform;
+  GList            *layers;
+  GList            *iter;
+  gint              n, i;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), FALSE);
+
+  if (! (dst = chopgimp_cmyk_check_profile (dest, error)))
+    return FALSE;
+
+  if (gimp_image_get_simulation_profile (image))
+    src = chopgimp_cmyk_check_profile (gimp_image_get_simulation_profile (image), NULL);
+
+  if (! src)
+    {
+      /*  no usable CMYK profile yet: nothing to convert from, @dest is
+       *  simply assigned
+       */
+      gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_IMAGE_CONVERT,
+                                   _("Convertir en profil"));
+      gimp_image_set_simulation_profile (image, dst);
+      gimp_image_set_simulation_intent (image, intent);
+      gimp_image_set_simulation_bpc (image, bpc);
+      gimp_image_undo_group_end (image);
+      g_object_unref (dst);
+      return TRUE;
+    }
+
+  rgb    = gimp_color_managed_get_color_profile (GIMP_COLOR_MANAGED (image));
+  format = gimp_color_profile_get_format (rgb, babl_format ("R'G'B'A float"),
+                                          GIMP_COLOR_RENDERING_INTENT_RELATIVE_COLORIMETRIC,
+                                          NULL);
+
+  /*  image RGB → source CMYK (its values) → destination CMYK (the user's
+   *  intent and black point compensation) → image RGB again: under @dest,
+   *  the new RGB gives the converted CMYK values
+   */
+  chain[0] = gimp_color_profile_get_lcms_profile (rgb);
+  chain[1] = chain[2] = gimp_color_profile_get_lcms_profile (src);
+  chain[3] = chain[4] = gimp_color_profile_get_lcms_profile (dst);
+  chain[5] = chain[0];
+
+  for (i = 0; i < 6; i++)
+    {
+      intents[i] = INTENT_RELATIVE_COLORIMETRIC;
+      bpcs[i]    = FALSE;
+      adapt[i]   = 1.0;
+    }
+
+  intents[2] = intents[3] = (cmsUInt32Number) intent;
+  bpcs[2]    = bpcs[3]    = bpc;
+
+  transform = cmsCreateExtendedTransform (NULL, 6, chain, bpcs, intents, adapt,
+                                          NULL, 0, TYPE_RGBA_FLT, TYPE_RGBA_FLT,
+                                          cmsFLAGS_COPY_ALPHA |
+                                          (bpc ? cmsFLAGS_BLACKPOINTCOMPENSATION : 0));
+
+  if (! transform || ! format)
+    {
+      if (transform)
+        cmsDeleteTransform (transform);
+
+      g_set_error (error, GIMP_CONFIG_ERROR, GIMP_CONFIG_ERROR_PARSE,
+                   _("Conversion impossible de « %s » vers « %s »."),
+                   gimp_color_profile_get_label (src),
+                   gimp_color_profile_get_label (dst));
+      g_object_unref (src);
+      g_object_unref (dst);
+      return FALSE;
+    }
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_IMAGE_CONVERT,
+                               _("Convertir en profil"));
+
+  layers = gimp_image_get_layer_list (image);
+  n      = g_list_length (layers);
+
+  for (iter = layers, i = 0; iter; iter = iter->next, i++)
+    {
+      GimpDrawable       *drawable = iter->data;
+      GeglBuffer         *buffer;
+      GeglBufferIterator *it;
+
+      /*  groups follow their children; text and vector layers keep their
+       *  own colors (they would be rendered again)
+       */
+      if (gimp_viewable_get_children (GIMP_VIEWABLE (drawable)) ||
+          gimp_item_is_text_layer (GIMP_ITEM (drawable))         ||
+          GIMP_IS_VECTOR_LAYER (drawable))
+        continue;
+
+      buffer = gimp_drawable_get_buffer (drawable);
+
+      gimp_drawable_push_undo (drawable, _("Convertir en profil"), NULL,
+                               0, 0,
+                               gimp_item_get_width (GIMP_ITEM (drawable)),
+                               gimp_item_get_height (GIMP_ITEM (drawable)));
+
+      it = gegl_buffer_iterator_new (buffer, NULL, 0, format,
+                                     GEGL_ACCESS_READWRITE, GEGL_ABYSS_NONE, 1);
+
+      while (gegl_buffer_iterator_next (it))
+        cmsDoTransform (transform, it->items[0].data, it->items[0].data, it->length);
+
+      gimp_drawable_update (drawable, 0, 0, -1, -1);
+
+      if (progress)
+        gimp_progress_set_value (progress, (gdouble) (i + 1) / MAX (n, 1));
+    }
+
+  g_list_free (layers);
+  cmsDeleteTransform (transform);
+
+  gimp_image_set_simulation_profile (image, dst);
+  gimp_image_set_simulation_intent (image, intent);
+  gimp_image_set_simulation_bpc (image, bpc);
+
+  gimp_image_undo_group_end (image);
+
+  g_object_unref (src);
+  g_object_unref (dst);
+
+  return TRUE;
+}
