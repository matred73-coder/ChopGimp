diff --git a/app/core/gimpimage-color-profile.c b/app/core/gimpimage-color-profile.c
index a2755e7..86c7bfa 100644
--- a/app/core/gimpimage-color-profile.c
+++ b/app/core/gimpimage-color-profile.c
@@ -43,6 +43,7 @@
 #include "gimplayer.h"
 #include "gimpimage.h"
