+/*  ─── ChopGimp 4.2.0: CMYK ─────────────────────────────────────────── */
+
+/*  PSO Coated v3 cannot be shipped (ECI license): offered once, a click
+ *  downloads it from eci.org (plug-in chopgimp_print)
+ */
+static void
+chopgimp_cmyk_offer_download (GimpImage   *image,
+                              GimpContext *context,
+                              GtkWidget   *parent)
+{
+  GtkWidget *dialog;
+  gint       response;
+
+  if (chopgimp_cmyk_have_pso (image->gimp) ||
+      chopgimp_rc_get_boolean ("color", "pso-offered", FALSE) ||
+      ! gimp_pdb_lookup_procedure (image->gimp->pdb, "plug-in-chopgimp-cmyk-download"))
+    return;
+
+  chopgimp_rc_set_boolean ("color", "pso-offered", TRUE);
+
+  dialog = gtk_message_dialog_new (parent ? GTK_WINDOW (gtk_widget_get_toplevel (parent)) : NULL,
+                                   GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
+                                   GTK_MESSAGE_QUESTION, GTK_BUTTONS_NONE,
+                                   "%s", _("Télécharger les profils CMJN PSO v3 de l'ECI ?"));
+  gtk_message_dialog_format_secondary_text (GTK_MESSAGE_DIALOG (dialog), "%s",
+    _("PSO Coated v3 (FOGRA51) et PSO Uncoated v3 (FOGRA52) sont les profils "
+      "d'impression offset actuels de l'European Color Initiative. Leur licence "
+      "interdit de les distribuer avec ChopGimp : ils sont téléchargés depuis "
+      "eci.org (3,5 Mo), puis PSO Coated v3 devient le profil CMJN de travail.\n\n"
+      "Sans eux, ChopGimp utilise ISO Coated v2 (FOGRA39), fourni. "
+      "Vous pourrez les télécharger plus tard : Image > Gestion des couleurs."));
+  gtk_dialog_add_buttons (GTK_DIALOG (dialog),
+                          _("Utiliser ISO Coated v2"), GTK_RESPONSE_CANCEL,
+                          _("_Télécharger"),           GTK_RESPONSE_OK,
+                          NULL);
+  gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_OK);
+
+  response = gtk_dialog_run (GTK_DIALOG (dialog));
+  gtk_widget_destroy (dialog);
+
+  if (response == GTK_RESPONSE_OK)
+    {
+      GError         *error = NULL;
+      GimpValueArray *rv;
+
+      rv = gimp_pdb_execute_procedure_by_name (image->gimp->pdb, context, NULL, &error,
+                                               "plug-in-chopgimp-cmyk-download",
+                                               GIMP_TYPE_RUN_MODE, GIMP_RUN_INTERACTIVE,
+                                               G_TYPE_NONE);
+      if (error)
+        {
+          gimp_message_literal (image->gimp, G_OBJECT (parent), GIMP_MESSAGE_WARNING,
+                                error->message);
+          g_clear_error (&error);
+        }
+      if (rv)
+        gimp_value_array_unref (rv);
+    }
+}
+
+void
+image_convert_cmyk_cmd_callback (GimpAction *action,
+                                 GVariant   *value,
+                                 gpointer    data)
+{
+  GimpImage *image;
+  GtkWidget *widget;
+  gboolean   active;
+  GError    *error = NULL;
+  return_if_no_image (image, data);
+  return_if_no_widget (widget, data);
+
+  active = g_variant_get_boolean (value);
+
+  if (active == chopgimp_image_is_cmyk (image))
+    return;
+
+  if (active && ! gimp_image_get_simulation_profile (image))
+    chopgimp_cmyk_offer_download (image, action_data_get_context (data), widget);
+
+  if (! chopgimp_image_set_cmyk (image, active, NULL, &error))
+    {
+      gimp_message_literal (image->gimp, G_OBJECT (widget), GIMP_MESSAGE_WARNING,
+                            error->message);
+      g_clear_error (&error);
+    }
+
+  gimp_image_flush (image);
+}
+
+static void
+chopgimp_cmyk_convert_callback (GtkWidget                *dialog,
+                                GimpImage                *image,
+                                GimpColorProfile         *new_profile,
+                                GFile                    *new_file,
+                                GimpColorRenderingIntent  intent,
+                                gboolean                  bpc,
+                                gpointer                  user_data)
+{
+  GError *error = NULL;
+
+  if (! new_profile ||
+      ! chopgimp_image_convert_cmyk_profile (image, new_profile, intent, bpc,
+                                             NULL, &error))
+    {
+      gimp_message (image->gimp, G_OBJECT (dialog), GIMP_MESSAGE_ERROR,
+                    "%s", error ? error->message : _("Aucun profil choisi."));
+      g_clear_error (&error);
+      return;
+    }
+
+  gimp_image_flush (image);
+  gtk_widget_destroy (dialog);
+}
+
+void
+image_cmyk_convert_profile_cmd_callback (GimpAction *action,
+                                         GVariant   *value,
+                                         gpointer    data)
+{
+  GimpImage        *image;
+  GtkWidget        *widget;
+  GtkWidget        *dialog;
+  GimpColorProfile *current;
+  return_if_no_image (image, data);
+  return_if_no_widget (widget, data);
+
+#define CMYK_CONVERT_DIALOG_KEY "chopgimp-cmyk-convert-dialog"
+
+  dialog = dialogs_get_dialog (G_OBJECT (image), CMYK_CONVERT_DIALOG_KEY);
+
+  if (! dialog)
+    {
+      current = gimp_image_get_simulation_profile (image);
+
+      dialog = color_profile_dialog_new (COLOR_PROFILE_DIALOG_CONVERT_CMYK,
+                                         image,
+                                         action_data_get_context (data),
+                                         widget,
+                                         current,
+                                         NULL,
+                                         GIMP_COLOR_RENDERING_INTENT_RELATIVE_COLORIMETRIC,
+                                         TRUE,
+                                         chopgimp_cmyk_convert_callback,
+                                         NULL);
+
+      dialogs_attach_dialog (G_OBJECT (image), CMYK_CONVERT_DIALOG_KEY, dialog);
+    }
+
+  gtk_window_present (GTK_WINDOW (dialog));
+}
