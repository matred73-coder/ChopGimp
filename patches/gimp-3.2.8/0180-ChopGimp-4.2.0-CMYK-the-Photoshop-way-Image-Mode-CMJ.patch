 #include "gimpimage-private.h"
 #include "gimpimage-undo.h"
@@ -73,6 +74,10 @@ static void   gimp_image_fix_layer_format_spaces  (GimpImage                *ima
                                                    GimpProgress             *progress);
 
 static void   gimp_image_create_color_transforms  (GimpImage                *image);
+static void   chopgimp_image_import_cmyk_profile  (GimpImage                *image,
+                                                   GimpContext              *context,
+                                                   GimpProgress             *progress,
+                                                   gboolean                  interactive);
 
 
 /*  public functions  */
@@ -797,9 +802,85 @@ gimp_image_import_color_profile (GimpImage    *image,
 
           g_object_unref (dest_profile);
         }
+      else if (g_object_get_data (G_OBJECT (image), "chopgimp-profile-ignore"))
+        {
+          /*  ChopGimp 4.2.0 « Ignorer » (Photoshop: discard the embedded
+           *  profile): the pixels are read in the working space
+           */
+          gimp_image_set_color_profile (image, pref_profile, NULL);
+        }
 
+      g_object_set_data (G_OBJECT (image), "chopgimp-profile-ignore", NULL);
       g_clear_object (&pref_profile);
     }
+
+  chopgimp_image_import_cmyk_profile (image, context, progress, interactive);
+}
+
+/*  ChopGimp 4.2.0: a CMYK file (its CMYK profile is now the simulation
+ *  profile) opens in « CMJN » mode. When its profile is not the working
+ *  CMYK profile: keep it, convert to the working one, or ignore it (the
+ *  working one is assigned), asked like Photoshop. An unusable CMYK
+ *  profile is replaced by the working one, with a message.
+ */
+static void
+chopgimp_image_import_cmyk_profile (GimpImage    *image,
+                                    GimpContext  *context,
+                                    GimpProgress *progress,
+                                    gboolean      interactive)
+{
+  GimpColorProfile *sim = gimp_image_get_simulation_profile (image);
+  GimpColorProfile *checked;
+  GimpColorProfile *pref;
+  GError           *error = NULL;
+
+  if (! sim || ! gimp_color_profile_is_cmyk (sim) ||
+      gimp_image_get_base_type (image) != GIMP_RGB)
+    return;
+
+  checked = chopgimp_cmyk_check_profile (sim, &error);
+  pref    = chopgimp_cmyk_get_preferred (image->gimp, NULL);
+
+  if (! checked)
+    {
+      gimp_message (image->gimp, NULL, GIMP_MESSAGE_WARNING,
+                    _("%s\nProfil CMJN de travail utilisé à la place : %s"),
+                    error->message,
+                    pref ? gimp_color_profile_get_label (pref) : _("aucun"));
+      g_clear_error (&error);
+      gimp_image_set_simulation_profile (image, pref);
+    }
+  else if (pref && ! gimp_color_profile_is_equal (pref, checked) && interactive)
+    {
+      GimpColorProfilePolicy   policy;
+      GimpColorProfile        *dest   = NULL;
+      GimpColorRenderingIntent intent = GIMP_COLOR_RENDERING_INTENT_RELATIVE_COLORIMETRIC;
+      gboolean                 bpc    = TRUE;
+      gboolean                 dont_ask = FALSE;
+
+      g_object_set_data (G_OBJECT (image), "chopgimp-cmyk-import", checked);
+      policy = gimp_query_profile_policy (image->gimp, image, context,
+                                          &dest, &intent, &bpc, &dont_ask);
+      g_object_set_data (G_OBJECT (image), "chopgimp-cmyk-import", NULL);
+
+      if (g_object_get_data (G_OBJECT (image), "chopgimp-profile-ignore"))
+        gimp_image_set_simulation_profile (image, pref);
+      else if (policy == GIMP_COLOR_PROFILE_POLICY_CONVERT_PREFERRED ||
+               policy == GIMP_COLOR_PROFILE_POLICY_CONVERT_BUILTIN)
+        chopgimp_image_convert_cmyk_profile (image, pref, intent, bpc, progress, NULL);
+
+      g_object_set_data (G_OBJECT (image), "chopgimp-profile-ignore", NULL);
+
+      /*  the dialog returns a reference only for a conversion  */
+      if (policy == GIMP_COLOR_PROFILE_POLICY_CONVERT_PREFERRED ||
+          policy == GIMP_COLOR_PROFILE_POLICY_CONVERT_BUILTIN)
+        g_clear_object (&dest);
+    }
+
+  chopgimp_image_set_cmyk (image, TRUE, NULL, NULL);
+
+  g_clear_object (&checked);
+  g_clear_object (&pref);
 }
 
 GimpColorTransform *
