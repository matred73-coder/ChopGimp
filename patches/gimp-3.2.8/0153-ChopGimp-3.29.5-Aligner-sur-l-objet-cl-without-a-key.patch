---
 app/path/chopgimp-vobject-ops.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/app/path/chopgimp-vobject-ops.c b/app/path/chopgimp-vobject-ops.c
index 8d5ca38..5ecc89a 100644
--- a/app/path/chopgimp-vobject-ops.c
+++ b/app/path/chopgimp-vobject-ops.c
@@ -883,6 +883,19 @@ chopgimp_vobjects_align (GimpVectorLayer *layer,
    */
   key = chopgimp_vtransform_get_key (layer);
 
+  /*  3.29.5: « Aligner sur : l'objet clé » without a key object: the
+   *  frontmost selected object becomes the key (as Illustrator does),
+   *  shown with its key outline, instead of aligning on the selection
+   *  (CHOPGIMP_NO_AUTO_KEY=1: the old behaviour)
+   */
+  if (! key && ! dist && boxes->len > 1 &&
+      chopgimp_vtransform_get_align_to () == CHOPGIMP_ALIGN_TO_KEY &&
+      ! g_getenv ("CHOPGIMP_NO_AUTO_KEY"))
+    {
+      key = g_array_index (boxes, Box, boxes->len - 1).id;   /* sorted bottom → top */
+      chopgimp_vtransform_set_key (layer, key);
+    }
+
   if (key && boxes->len > 1 && ! dist)
     {
       for (guint i = 0; i < boxes->len; i++)
