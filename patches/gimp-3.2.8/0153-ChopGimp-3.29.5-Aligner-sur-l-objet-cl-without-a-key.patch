 =?UTF-8?q?=20sur=20:=20l'objet=20cl=C3=A9=20=C2=BB=20without=20a=20key=20?=
 =?UTF-8?q?object=20makes=20the=20frontmost=20selected=20object=20the=20ke?=
 =?UTF-8?q?y=20(as=20Illustrator)=20instead=20of=20aligning=20on=20the=20s?=
 =?UTF-8?q?election=20(CHOPGIMP=5FNO=5FAUTO=5FKEY)?=
