From 9668607012bfdab476c6746c9851183b7d542a2f Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Wed, 18 Nov 2026 09:56:36 +0100
Subject: [PATCH] ChopGimp: drafts only during user input on the canvas
 (zoomed-out drafts at rest doubled the work at open)

---
 app/core/gimpprojection.c | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/app/core/gimpprojection.c b/app/core/gimpprojection.c
index d8eef14..bc22474 100644
--- a/app/core/gimpprojection.c
+++ b/app/core/gimpprojection.c
@@ -1427,11 +1427,16 @@ gimp_projection_chunk_render_iteration (GimpProjection *proj)
 
   /*  ChopGimp: background rendering and drafts  */
   threaded = gimp_projection_want_thread (proj);
-  drafting = gimp_projection_want_draft (proj);
+  /*  drafts only while the user acts: a zoomed-out draft at rest is
+   *  refined right away, so it only doubles the work (measured: +80 %
+   *  CPU when opening a poster with effects)
+   */
+  drafting = (proj->priv->fast_preview &&
+              g_get_monotonic_time () - proj->priv->last_activity_time <
+              CHOPGIMP_PROJECTION_ACTIVITY_TIME                        &&
+              gimp_projection_want_draft (proj));
 
-  if (threaded ||
-      (drafting && (gimp_projection_is_acting (proj) ||
-                    proj->priv->display_level > 0)))
+  if (threaded || drafting)
     {
       return gimp_projection_job_iteration (proj, threaded, drafting);
     }
-- 
