+       *  application draws the icon of an inactive toggle faintly:
+       *    1: on the hovered or selected row only (lock: shows where to
+       *       click),
+       *    2: always, struck through (eye of a hidden layer).
+       */
+      gint mode = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (cell),
+                                                      "chopgimp-inactive-mode"));
+      gboolean hot = (state & (GTK_STATE_FLAG_PRELIGHT |
+                               GTK_STATE_FLAG_SELECTED)) != 0;
+
+      if (mode == 2 || (mode == 1 && hot))
+        {
+          GtkBorder border;
+          GdkRGBA   color;
+          gdouble   x, y, w, h;
+
+          gtk_style_context_get_border (context, 0, &border);
+          x = toggle_rect.x + border.left;
+          y = toggle_rect.y + border.top;
+          w = toggle_rect.width  - border.left - border.right;
+          h = toggle_rect.height - border.top  - border.bottom;
+
+          gimp_cell_renderer_toggle_create_pixbuf (toggle, widget);
+
+          if (toggle->pixbuf)
+            {
+              cairo_save (cr);
+              cairo_scale (cr,
+                           (gdouble) 1.0 / scale_factor,
+                           (gdouble) 1.0 / scale_factor);
+              gdk_cairo_set_source_pixbuf (cr, toggle->pixbuf,
+                                           x * scale_factor,
+                                           y * scale_factor);
+              cairo_paint_with_alpha (cr, mode == 2 ? (hot ? 0.75 : 0.5) : 0.35);
+              cairo_restore (cr);
+            }
+
+          if (mode == 2 && w > 4 && h > 4)
+            {
+              gtk_style_context_get_color (context, state, &color);
+              color.alpha *= hot ? 0.9 : 0.65;
+
+              cairo_save (cr);
+              gdk_cairo_set_source_rgba (cr, &color);
+              cairo_set_line_width (cr, 1.5);
+              cairo_set_line_cap (cr, CAIRO_LINE_CAP_ROUND);
+              cairo_move_to (cr, x + 2.0,     y + h - 2.0);
+              cairo_line_to (cr, x + w - 2.0, y + 2.0);
+              cairo_stroke (cr);
+              cairo_restore (cr);
+            }
+        }
+    }
 
   gtk_style_context_restore (context);
 }
