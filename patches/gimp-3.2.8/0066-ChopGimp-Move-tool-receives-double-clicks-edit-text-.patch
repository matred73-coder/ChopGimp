From 5b671ac747055f8cc5659c435cc4bb6f4f10a7a8 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Fri, 13 Nov 2026 11:52:51 +0100
Subject: [PATCH] ChopGimp: Move tool receives double-clicks (edit text); text
 panel sizes in pixels, kerning/baseline start at 0

---
 app/dialogs/chopgimp-textpanels.c | 14 +++++++++++---
 app/tools/gimpmovetool.c          |  2 ++
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/app/dialogs/chopgimp-textpanels.c b/app/dialogs/chopgimp-textpanels.c
index 6284c8f..bb35b3f 100644
--- a/app/dialogs/chopgimp-textpanels.c
+++ b/app/dialogs/chopgimp-textpanels.c
@@ -237,8 +237,15 @@ size_changed (GtkSpinButton *spin, Panel *panel)
   if (panel->updating || ! target_begin (panel, &t))
     return;
 
-  gimp_text_buffer_set_size (t.buffer, &t.start, &t.end,
-                             PANGO_SCALE * gtk_spin_button_get_value (spin));
+  {
+    /*  the panel shows pixels, the size tags are in points  */
+    gdouble xres, yres;
+
+    gimp_image_get_resolution (gimp_item_get_image (GIMP_ITEM (t.layer)), &xres, &yres);
+    gimp_text_buffer_set_size (t.buffer, &t.start, &t.end,
+                               PANGO_SCALE * gimp_units_to_points (gtk_spin_button_get_value (spin),
+                                                                   gimp_unit_pixel (), yres));
+  }
   target_end (&t, _("Taille du texte"));
 }
 
@@ -579,6 +586,7 @@ spin_new (Panel       *panel,
   GtkWidget *spin = gtk_spin_button_new_with_range (lo, hi, step);
 
   gtk_spin_button_set_digits (GTK_SPIN_BUTTON (spin), digits);
+  gtk_spin_button_set_value (GTK_SPIN_BUTTON (spin), CLAMP (0, lo, hi));
   gtk_widget_set_hexpand (spin, TRUE);
   g_signal_connect (spin, "value-changed", callback, panel);
 
@@ -692,7 +700,7 @@ panel_new (Gimp *gimp, gboolean paragraph)
                                             GIMP_COLOR_AREA_FLAT);
       g_signal_connect (panel->color, "color-changed", G_CALLBACK (color_changed), panel);
 
-      grid_row (grid, 1, 0, "<b>T</b><small>T</small>", _("Taille (points)"), panel->size);
+      grid_row (grid, 1, 0, "<b>T</b><small>T</small>", _("Taille (px)"), panel->size);
       grid_row (grid, 1, 2, "<small>A</small><b>A</b>", _("Interlignage (px en plus)"), panel->leading);
       grid_row (grid, 2, 0, "VA", _("Crénage de la sélection"), panel->kerning);
       grid_row (grid, 2, 2, "<u>VA</u>", _("Approche (espacement des lettres)"), panel->tracking);
diff --git a/app/tools/gimpmovetool.c b/app/tools/gimpmovetool.c
index a590f7a..994341e 100644
--- a/app/tools/gimpmovetool.c
+++ b/app/tools/gimpmovetool.c
@@ -163,6 +163,8 @@ gimp_move_tool_init (GimpMoveTool *move_tool)
 
   gimp_tool_control_set_snap_to            (tool->control, FALSE);
   gimp_tool_control_set_handle_empty_image (tool->control, TRUE);
+  /*  ChopGimp: double-click on a text edits it  */
+  gimp_tool_control_set_wants_double_click (tool->control, TRUE);
   gimp_tool_control_set_tool_cursor        (tool->control,
                                             GIMP_TOOL_CURSOR_MOVE);
 
-- 
