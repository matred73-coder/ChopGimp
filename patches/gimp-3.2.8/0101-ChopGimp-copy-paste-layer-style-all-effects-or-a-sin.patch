From 51c95aa2011f98f0c6fb9000ad768c45898d96a7 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Tue, 17 Nov 2026 09:24:48 +0100
Subject: [PATCH] ChopGimp: copy/paste layer style (all effects or a single
 one), paste replacing or adding

---
 app/actions/layers-actions.c               |  43 +-
 app/actions/layers-commands.c              |  48 +++
 app/actions/layers-commands.h              |  10 +
 app/core/chopgimp-style-clipboard.c        | 443 +++++++++++++++++++++
 app/core/chopgimp-style-clipboard.h        |  62 +++
 app/core/gimp.c                            |   4 +
 app/core/meson.build                       |   1 +
 app/widgets/gimpdrawabletreeview-filters.c |  46 +++
 8 files changed, 656 insertions(+), 1 deletion(-)
 create mode 100644 app/core/chopgimp-style-clipboard.c
 create mode 100644 app/core/chopgimp-style-clipboard.h

diff --git a/app/actions/layers-actions.c b/app/actions/layers-actions.c
index 4113c8f..d1bc567 100644
--- a/app/actions/layers-actions.c
+++ b/app/actions/layers-actions.c
@@ -26,6 +26,7 @@
 
 #include "operations/layer-modes/gimp-layer-modes.h"
 
+#include "core/chopgimp-style-clipboard.h"
 #include "core/gimpchannel.h"
 #include "core/gimpimage.h"
 #include "core/gimplayer.h"
@@ -270,7 +271,28 @@ static const GimpActionEntry layers_actions[] =
     NC_("layers-action", "_Remove Alpha Channel"), NULL, { NULL },
     NC_("layers-action", "Remove transparency information from the layer"),
     layers_alpha_remove_cmd_callback,
-    GIMP_HELP_LAYER_ALPHA_REMOVE }
+    GIMP_HELP_LAYER_ALPHA_REMOVE },
+
+  /*  ChopGimp: copy / paste layer style (Photoshop), see
+   *  core/chopgimp-style-clipboard.c
+   */
+  { "layers-style-copy", GIMP_ICON_EDIT_COPY,
+    "Copier le style de calque", NULL, { NULL },
+    "Copier les effets (filtres non destructifs) du calque actif",
+    layers_style_copy_cmd_callback,
+    GIMP_HELP_LAYER_EFFECTS },
+
+  { "layers-style-paste", GIMP_ICON_EDIT_PASTE,
+    "Coller le style de calque", NULL, { NULL },
+    "Remplacer les effets des calques sélectionnés par le style copié",
+    layers_style_paste_cmd_callback,
+    GIMP_HELP_LAYER_EFFECTS },
+
+  { "layers-style-paste-add", GIMP_ICON_EDIT_PASTE,
+    "Coller le style de calque (en ajoutant)", NULL, { NULL },
+    "Ajouter le style copié aux effets des calques sélectionnés",
+    layers_style_paste_add_cmd_callback,
+    GIMP_HELP_LAYER_EFFECTS }
 };
 
 static const GimpToggleActionEntry layers_toggle_actions[] =
@@ -1144,6 +1166,25 @@ layers_actions_update (GimpActionGroup *group,
                      image && !indexed && !fs && layer);
   }
   SET_SENSITIVE ("layers-duplicate",        n_selected_layers > 0 && !fs && !ac);
+
+  /*  ChopGimp: copy / paste layer style  */
+  {
+    gboolean can_paste_style = FALSE;
+
+    if (image && !fs && !ac && chopgimp_style_clipboard_get_n_filters () > 0)
+      for (iter = layers; iter; iter = iter->next)
+        if (chopgimp_style_drawable_can_paste (iter->data))
+          {
+            can_paste_style = TRUE;
+            break;
+          }
+
+    SET_SENSITIVE ("layers-style-copy",
+                   layer && !fs && !ac &&
+                   chopgimp_style_drawable_n_filters (GIMP_DRAWABLE (layer)) > 0);
+    SET_SENSITIVE ("layers-style-paste",     can_paste_style);
+    SET_SENSITIVE ("layers-style-paste-add", can_paste_style);
+  }
   SET_SENSITIVE ("layers-delete",           n_selected_layers > 0 && !ac);
 
   SET_SENSITIVE ("layers-mode-first",       n_selected_layers > 0 && !ac && first_mode);
diff --git a/app/actions/layers-commands.c b/app/actions/layers-commands.c
index 4f6c8fe..402daa7 100644
--- a/app/actions/layers-commands.c
+++ b/app/actions/layers-commands.c
@@ -33,6 +33,7 @@
 
 #include "operations/layer-modes/gimp-layer-modes.h"
 
+#include "core/chopgimp-style-clipboard.h"
 #include "core/gimp.h"
 #include "core/gimpchannel.h"
 #include "core/gimpchannel-combine.h"
@@ -2470,6 +2471,53 @@ layers_color_tag_cmd_callback (GimpAction *action,
   items_color_tag_cmd_callback (action, image, layers, color_tag);
 }
 
+/*  ChopGimp: copy / paste layer style (Photoshop)  */
+
+void
+layers_style_copy_cmd_callback (GimpAction *action,
+                                GVariant   *value,
+                                gpointer    data)
+{
+  GimpImage *image;
+  GList     *layers;
+  return_if_no_layers (image, layers, data);
+
+  if (g_list_length (layers) != 1)
+    return;
+
+  if (chopgimp_style_clipboard_copy_drawable (layers->data) > 0)
+    /*  no undo step: only lets the actions update (paste sensitivity)  */
+    gimp_image_flush (image);
+}
+
+static void
+layers_style_paste (gpointer data,
+                    gboolean replace)
+{
+  GimpImage *image;
+  GList     *layers;
+  return_if_no_layers (image, layers, data);
+
+  if (chopgimp_style_clipboard_paste (image, layers, replace) > 0)
+    gimp_image_flush (image);
+}
+
+void
+layers_style_paste_cmd_callback (GimpAction *action,
+                                 GVariant   *value,
+                                 gpointer    data)
+{
+  layers_style_paste (data, TRUE);
+}
+
+void
+layers_style_paste_add_cmd_callback (GimpAction *action,
+                                     GVariant   *value,
+                                     gpointer    data)
+{
+  layers_style_paste (data, FALSE);
+}
+
 
 /*  private functions  */
 
