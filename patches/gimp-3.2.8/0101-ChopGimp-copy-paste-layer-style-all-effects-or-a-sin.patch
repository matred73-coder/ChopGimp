diff --git a/app/core/chopgimp-style-clipboard.c b/app/core/chopgimp-style-clipboard.c
new file mode 100644
index 0000000..4b36266
--- /dev/null
+++ b/app/core/chopgimp-style-clipboard.c
@@ -0,0 +1,443 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-style-clipboard.c — ChopGimp: copy / paste layer style
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpconfig/gimpconfig.h"
+
+#include "core-types.h"
+
+#include "gegl/gimp-gegl-utils.h"
+
+#include "gimpchannel.h"
+#include "gimpcontainer.h"
+#include "gimpdrawable.h"
+#include "gimpdrawable-filters.h"
+#include "gimpdrawablefilter.h"
+#include "gimpfilter.h"
+#include "gimpimage.h"
+#include "gimpimage-undo.h"
+#include "gimpimage-undo-push.h"
+#include "gimpitem.h"
+#include "gimplayer.h"
+#include "gimplayer-floating-selection.h"
+#include "gimplist.h"
+#include "gimpviewable.h"
+
+#include "chopgimp-style-clipboard.h"
+
+
+#define STYLE_PASTE_DESC "Coller le style de calque"
+
+
+/*  One filter of the clipboard: everything gimp_drawable_filter_duplicate()
+ *  takes from the prior filter, without any reference to its drawable.
+ */
+typedef struct
+{
+  gchar                  *name;
+  gchar                  *icon_name;
+  gchar                  *operation;   /*  GEGL operation name           */
+  GeglNode               *node;        /*  standalone node, settings     */
+  gdouble                 opacity;
+  GimpLayerMode           paint_mode;
+  GimpLayerColorSpace     blend_space;
+  GimpLayerColorSpace     composite_space;
+  GimpLayerCompositeMode  composite_mode;
+  GimpFilterRegion        region;
+  gboolean                clip;
+  gboolean                add_alpha;
+  gboolean                active;
+  GeglBuffer             *mask;        /*  image-sized effect mask, or NULL */
+} StyleFilter;
+
+
+/*  bottom-most filter first (order in which they are added)  */
+static GList *style_clipboard = NULL;
+
+
+/*  local function prototypes  */
+
+static void          style_filter_free       (StyleFilter        *sf);
+static void          style_copy_settings     (GeglNode           *src,
+                                              GeglNode           *dest,
+                                              const gchar        *operation);
+static StyleFilter * style_filter_new        (GimpDrawableFilter *filter);
+static void          style_filter_paste      (StyleFilter        *sf,
+                                              GimpImage          *image,
+                                              GimpDrawable       *drawable);
+
+
+/*  public functions  */
+
+gboolean
+chopgimp_style_filter_is_copyable (GimpFilter *filter)
+{
+  GimpDrawableFilter *df;
+  GeglNode           *op;
+
+  if (! GIMP_IS_DRAWABLE_FILTER (filter))
+    return FALSE;   /*  e.g. the floating selection filter  */
+
+  df = GIMP_DRAWABLE_FILTER (filter);
+
+  /*  same rules as gimp_drawable_filter_duplicate()  */
+  if (gimp_drawable_filter_get_temporary (df) ||
+      gimp_drawable_filter_get_mask (df) == NULL)
+    return FALSE;
+
+  op = gimp_drawable_filter_get_operation (df);
+
+  if (! op                                   ||
+      ! gegl_node_get_operation (op)         ||
+      ! strcmp (gegl_node_get_operation (op), "GraphNode"))
+    return FALSE;
+
+  return TRUE;
+}
+
+gint
+chopgimp_style_drawable_n_filters (GimpDrawable *drawable)
+{
+  GimpContainer *filters;
+  GList         *list;
+  gint           n = 0;
+
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), 0);
+
+  filters = gimp_drawable_get_filters (drawable);
+
+  for (list = GIMP_LIST (filters)->queue->head; list; list = g_list_next (list))
+    if (chopgimp_style_filter_is_copyable (list->data))
+      n++;
+
+  return n;
+}
+
+gboolean
+chopgimp_style_drawable_can_paste (GimpDrawable *drawable)
+{
+  if (! GIMP_IS_LAYER (drawable))
+    return FALSE;
+
+  if (gimp_layer_is_floating_sel (GIMP_LAYER (drawable)))
+    return FALSE;
+
+  if (gimp_item_is_content_locked (GIMP_ITEM (drawable), NULL))
+    return FALSE;
+
+  return TRUE;
+}
+
+gint
+chopgimp_style_clipboard_copy_drawable (GimpDrawable *drawable)
+{
+  GimpContainer *filters;
+  GList         *list;
+  GList         *snapshot = NULL;
+
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), 0);
+
+  filters = gimp_drawable_get_filters (drawable);
+
+  /*  tail first, like gimp_drawable_duplicate(): each added filter goes
+   *  on top of the stack, so this keeps the order
+   */
+  for (list = GIMP_LIST (filters)->queue->tail;
+       list;
+       list = g_list_previous (list))
+    {
+      if (chopgimp_style_filter_is_copyable (list->data))
+        {
+          StyleFilter *sf = style_filter_new (list->data);
+
+          if (sf)
+            snapshot = g_list_append (snapshot, sf);
+        }
+    }
+
+  chopgimp_style_clipboard_clear ();
+  style_clipboard = snapshot;
+
+  return g_list_length (style_clipboard);
+}
+
+gboolean
+chopgimp_style_clipboard_copy_filter (GimpDrawableFilter *filter)
+{
+  StyleFilter *sf;
+
+  g_return_val_if_fail (GIMP_IS_DRAWABLE_FILTER (filter), FALSE);
+
+  if (! chopgimp_style_filter_is_copyable (GIMP_FILTER (filter)))
+    return FALSE;
+
+  sf = style_filter_new (filter);
+  if (! sf)
+    return FALSE;
+
+  chopgimp_style_clipboard_clear ();
+  style_clipboard = g_list_append (NULL, sf);
+
+  return TRUE;
+}
+
+gint
+chopgimp_style_clipboard_get_n_filters (void)
+{
+  return g_list_length (style_clipboard);
+}
+
+gint
+chopgimp_style_clipboard_paste (GimpImage *image,
+                                GList     *drawables,
+                                gboolean   replace)
+{
+  GList *iter;
+  gint   n_done = 0;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), 0);
+
+  if (! style_clipboard)
+    return 0;
+
+  for (iter = drawables; iter; iter = iter->next)
+    {
+      GimpDrawable *drawable = iter->data;
+      GList        *list;
+
+      if (! chopgimp_style_drawable_can_paste (drawable) ||
+          gimp_item_get_image (GIMP_ITEM (drawable)) != image)
+        continue;
+
+      if (n_done == 0)
+        gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_DRAWABLE_MOD,
+                                     STYLE_PASTE_DESC);
+
+      if (replace)
+        {
+          GimpContainer *filters = gimp_drawable_get_filters (drawable);
+          GList         *old     = NULL;
+
+          /*  don't remove while walking the stack  */
+          for (list = GIMP_LIST (filters)->queue->head;
+               list;
+               list = g_list_next (list))
+            {
+              if (chopgimp_style_filter_is_copyable (list->data))
+                old = g_list_prepend (old, g_object_ref (list->data));
+            }
+
+          /*  as the layers dock "remove filter" button does  */
+          for (list = old; list; list = g_list_next (list))
+            {
+              GimpDrawableFilter *filter = list->data;
+
+              gimp_image_undo_push_filter_remove (image, STYLE_PASTE_DESC,
+                                                  drawable, filter);
+              gimp_drawable_filter_abort (filter);
+            }
+
+          g_list_free_full (old, g_object_unref);
+        }
+
+      for (list = style_clipboard; list; list = g_list_next (list))
+        style_filter_paste (list->data, image, drawable);
+
+      n_done++;
+    }
+
+  if (n_done > 0)
+    gimp_image_undo_group_end (image);
+
+  return n_done;
+}
+
+void
+chopgimp_style_clipboard_clear (void)
+{
+  g_list_free_full (style_clipboard, (GDestroyNotify) style_filter_free);
+  style_clipboard = NULL;
+}
+
+
+/*  private functions  */
+
+static void
+style_filter_free (StyleFilter *sf)
+{
+  g_free (sf->name);
+  g_free (sf->icon_name);
+  g_free (sf->operation);
+  g_clear_object (&sf->node);
+  g_clear_object (&sf->mask);
+  g_free (sf);
+}
+
+/*  Copy the operation settings like gimp_drawable_filter_duplicate(),
+ *  but duplicate object settings (colors, GimpConfig objects such as the
+ *  curves or levels config) so that the copies never share them.
+ */
+static void
+style_copy_settings (GeglNode    *src,
+                     GeglNode    *dest,
+                     const gchar *operation)
+{
+  GParamSpec **pspecs;
+  guint        n_pspecs;
+  guint        i;
+
+  pspecs = gegl_operation_list_properties (operation, &n_pspecs);
+
+  for (i = 0; i < n_pspecs; i++)
+    {
+      GParamSpec *pspec = pspecs[i];
+      GValue      value = G_VALUE_INIT;
+
+      g_value_init (&value, pspec->value_type);
+      gegl_node_get_property (src, pspec->name, &value);
+
+      if (G_VALUE_HOLDS_OBJECT (&value) && g_value_get_object (&value))
+        {
+          GObject *object = g_value_get_object (&value);
+          GObject *copy   = NULL;
+
+          if (GEGL_IS_COLOR (object))
+            copy = G_OBJECT (gegl_color_duplicate (GEGL_COLOR (object)));
+          else if (GIMP_IS_CONFIG (object))
+            copy = G_OBJECT (gimp_config_duplicate (GIMP_CONFIG (object)));
+
+          if (copy)
+            g_value_take_object (&value, copy);
+        }
+
+      gegl_node_set_property (dest, pspec->name, &value);
+      g_value_unset (&value);
+    }
+
+  g_free (pspecs);
+}
+
+static StyleFilter *
+style_filter_new (GimpDrawableFilter *filter)
+{
+  StyleFilter            *sf;
+  GeglNode               *op;
+  GimpDrawableFilterMask *mask;
+  gchar                  *operation = NULL;
+
+  op = gimp_drawable_filter_get_operation (filter);
+
+  gegl_node_get (op,
+                 "operation", &operation,
+                 NULL);
+
+  if (! operation)
+    return NULL;
+
+  sf = g_new0 (StyleFilter, 1);
+
+  sf->name      = g_strdup (gimp_object_get_name (filter));
+  sf->icon_name = g_strdup (gimp_viewable_get_icon_name (GIMP_VIEWABLE (filter)));
+  sf->operation = operation;
+
+  sf->node = gegl_node_new ();
+  gegl_node_set (sf->node,
+                 "operation", operation,
+                 NULL);
+  style_copy_settings (op, sf->node, operation);
+
+  sf->opacity         = gimp_drawable_filter_get_opacity (filter);
+  sf->paint_mode      = gimp_drawable_filter_get_paint_mode (filter);
+  sf->blend_space     = gimp_drawable_filter_get_blend_space (filter);
+  sf->composite_space = gimp_drawable_filter_get_composite_space (filter);
+  sf->composite_mode  = gimp_drawable_filter_get_composite_mode (filter);
+  sf->region          = gimp_drawable_filter_get_region (filter);
+  sf->clip            = gimp_drawable_filter_get_clip (filter);
+  sf->add_alpha       = gimp_drawable_filter_get_add_alpha (filter);
+  sf->active          = gimp_filter_get_active (GIMP_FILTER (filter));
+
+  mask = gimp_drawable_filter_get_mask (filter);
+  if (mask)
+    sf->mask = gimp_gegl_buffer_dup (gimp_drawable_get_buffer (GIMP_DRAWABLE (mask)));
+
+  return sf;
+}
+
+/*  Create the filter on the drawable as XCF loading and layer duplication
+ *  do (new → settings → mask → apply → commit non-destructive → freeze),
+ *  then push GIMP's "add filter" undo step once it is in the stack.
+ */
+static void
+style_filter_paste (StyleFilter  *sf,
+                    GimpImage    *image,
+                    GimpDrawable *drawable)
+{
+  GimpDrawableFilter *filter;
+  GimpChannel        *mask;
+  GeglNode           *node;
+  gint                width  = gimp_image_get_width  (image);
+  gint                height = gimp_image_get_height (image);
+
+  node = gegl_node_new ();
+  gegl_node_set (node,
+                 "operation", sf->operation,
+                 NULL);
+  style_copy_settings (sf->node, node, sf->operation);
+
+  filter = gimp_drawable_filter_new (drawable, sf->name, node,
+                                     sf->icon_name ? sf->icon_name : "gimp-gegl");
+  g_object_unref (node);
+
+  gimp_drawable_filter_set_opacity (filter, sf->opacity);
+  gimp_drawable_filter_set_mode (filter,
+                                 sf->paint_mode,
+                                 sf->blend_space,
+                                 sf->composite_space,
+                                 sf->composite_mode);
+  gimp_drawable_filter_set_clip (filter, sf->clip);
+  gimp_drawable_filter_set_region (filter, sf->region);
+  gimp_drawable_filter_set_add_alpha (filter, sf->add_alpha);
+
+  /*  Effect mask: the copied one if it fits this image (same image or
+   *  same size), else an empty mask = the whole layer, like Photoshop.
+   *  Never the current selection of the target image.
+   */
+  if (sf->mask                                  &&
+      gegl_buffer_get_width  (sf->mask) == width &&
+      gegl_buffer_get_height (sf->mask) == height)
+    mask = gimp_channel_new_from_buffer (image, sf->mask, "Masque d'effet", NULL);
+  else
+    mask = gimp_channel_new (image, width, height, "Masque d'effet", NULL);
+
+  g_object_ref_sink (mask);
+
+  g_object_set (filter,
+                "mask", mask,
+                NULL);
+
+  gimp_drawable_filter_apply (filter, NULL);
+  gimp_drawable_filter_commit (filter, TRUE, NULL, FALSE);
+  gimp_drawable_filter_layer_mask_freeze (filter);
+
+  gimp_filter_set_active (GIMP_FILTER (filter), sf->active);
+
+  if (gimp_drawable_has_filter (drawable, GIMP_FILTER (filter)))
+    gimp_image_undo_push_filter_add (image, STYLE_PASTE_DESC,
+                                     drawable, filter);
+
+  g_object_unref (mask);
+  g_object_unref (filter);
+}
diff --git a/app/core/chopgimp-style-clipboard.h b/app/core/chopgimp-style-clipboard.h
new file mode 100644
index 0000000..991718e
--- /dev/null
+++ b/app/core/chopgimp-style-clipboard.h
@@ -0,0 +1,62 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-style-clipboard.h — ChopGimp: copy / paste layer style
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+/*  Photoshop-like « Copier / Coller le style de calque ».
+ *
+ *  The style of a layer is its stack of non-destructive filters
+ *  (GimpDrawableFilter). Copying takes a snapshot of each filter that
+ *  layer duplication would duplicate (see gimp_drawable_filter_duplicate):
+ *  operation and its settings (object settings duplicated), name, icon,
+ *  opacity, mode, color spaces, region, clip, visibility and mask. The
+ *  snapshot does not reference the source layer or image, so it can be
+ *  pasted in another image and survives the source being deleted.
+ *
+ *  Pasting recreates the filters the same way XCF loading does, with
+ *  GIMP's own filter add / remove undo steps, in one undo group.
+ */
+
+/*  TRUE for a real, committed non-destructive filter: not the floating
+ *  selection filter, not a temporary filter (filter tool being used),
+ *  not a tool-based (GraphNode) filter.
+ */
+gboolean   chopgimp_style_filter_is_copyable      (GimpFilter         *filter);
+
+/*  Number of copyable filters on the drawable.  */
+gint       chopgimp_style_drawable_n_filters      (GimpDrawable       *drawable);
+
+/*  TRUE if a style can be pasted on the drawable (layer, not floating,
+ *  pixels not locked).
+ */
