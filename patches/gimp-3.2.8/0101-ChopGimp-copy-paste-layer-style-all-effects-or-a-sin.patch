+/*  ChopGimp: put only this filter in the layer style clipboard; the
+ *  « Coller le style de calque » actions then apply just this one.
+ */
+static void
+gimp_drawable_filters_editor_copy_clicked (GtkWidget            *widget,
+                                           GimpDrawableTreeView *view)
+{
+  GimpDrawableTreeViewFiltersEditor *editor = view->editor;
+  GimpImage                         *image;
+
+  if (! GIMP_IS_DRAWABLE_FILTER (editor->filter))
+    return;
+
+  if (chopgimp_style_clipboard_copy_filter (editor->filter))
+    {
+      image = gimp_item_tree_view_get_image (GIMP_ITEM_TREE_VIEW (view));
+
+      /*  no undo step: only lets the actions update (paste sensitivity)  */
+      if (image)
+        gimp_image_flush (image);
+    }
+}
