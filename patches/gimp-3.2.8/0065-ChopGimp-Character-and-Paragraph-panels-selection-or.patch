+/*  ChopGimp: generic attribute tags  */
+
+static const gchar *const chopgimp_attrs[] =
+{
+  "font_features", "text_transform", "baseline_shift", "font_scale",
+  "allow_breaks", "insert_hyphens", "variant", "weight", "stretch",
+  NULL
+};
+
+gboolean
+gimp_text_buffer_is_chopgimp_attr (const gchar *attribute)
+{
+  for (gint i = 0; attribute && chopgimp_attrs[i]; i++)
+    if (! strcmp (attribute, chopgimp_attrs[i]))
+      return TRUE;
+
+  return FALSE;
+}
+
+GtkTextTag *
+gimp_text_buffer_get_attr_tag (GimpTextBuffer *buffer,
+                               const gchar    *attribute,
+                               const gchar    *value)
+{
+  GList      *list;
+  GtkTextTag *tag;
+
+  g_return_val_if_fail (GIMP_IS_TEXT_BUFFER (buffer), NULL);
+
+  for (list = buffer->chopgimp_attr_tags; list; list = list->next)
+    {
+      tag = list->data;
+
+      if (! g_strcmp0 (g_object_get_data (G_OBJECT (tag), "chopgimp-attr"), attribute) &&
+          ! g_strcmp0 (g_object_get_data (G_OBJECT (tag), "chopgimp-value"), value))
+        return tag;
+    }
+
+  tag = gtk_text_buffer_create_tag (GTK_TEXT_BUFFER (buffer), NULL, NULL);
+  g_object_set_data_full (G_OBJECT (tag), "chopgimp-attr",  g_strdup (attribute), g_free);
+  g_object_set_data_full (G_OBJECT (tag), "chopgimp-value", g_strdup (value),     g_free);
+  buffer->chopgimp_attr_tags = g_list_prepend (buffer->chopgimp_attr_tags, tag);
+
+  return tag;
+}
+
+void
+gimp_text_buffer_set_attr (GimpTextBuffer    *buffer,
+                           const GtkTextIter *start,
+                           const GtkTextIter *end,
+                           const gchar       *attribute,
+                           const gchar       *value)
+{
+  GList *list;
+
+  g_return_if_fail (GIMP_IS_TEXT_BUFFER (buffer));
+
+  if (gtk_text_iter_equal (start, end))
+    return;
+
+  gtk_text_buffer_begin_user_action (GTK_TEXT_BUFFER (buffer));
+
+  for (list = buffer->chopgimp_attr_tags; list; list = list->next)
+    if (! g_strcmp0 (g_object_get_data (list->data, "chopgimp-attr"), attribute))
+      gtk_text_buffer_remove_tag (GTK_TEXT_BUFFER (buffer), list->data, start, end);
+
+  if (value && *value)
+    gtk_text_buffer_apply_tag (GTK_TEXT_BUFFER (buffer),
+                               gimp_text_buffer_get_attr_tag (buffer, attribute, value),
+                               start, end);
+
+  gtk_text_buffer_end_user_action (GTK_TEXT_BUFFER (buffer));
+}
+
+const gchar *
+gimp_text_buffer_get_iter_attr (GimpTextBuffer    *buffer,
+                                const GtkTextIter *iter,
+                                const gchar       *attribute)
+{
+  GList *list;
+
+  g_return_val_if_fail (GIMP_IS_TEXT_BUFFER (buffer), NULL);
+
+  for (list = buffer->chopgimp_attr_tags; list; list = list->next)
+    if (! g_strcmp0 (g_object_get_data (list->data, "chopgimp-attr"), attribute) &&
+        gtk_text_iter_has_tag (iter, list->data))
+      return g_object_get_data (list->data, "chopgimp-value");
+
+  return NULL;
+}
