---
 app/display/gimpoptionsbar.c | 61 +++++++++++++++++++++++++++++++++++-
 1 file changed, 60 insertions(+), 1 deletion(-)

diff --git a/app/display/gimpoptionsbar.c b/app/display/gimpoptionsbar.c
index e83bf68..0859fe2 100644
--- a/app/display/gimpoptionsbar.c
+++ b/app/display/gimpoptionsbar.c
@@ -41,9 +41,12 @@
 #include "core/gimpcontainer.h"
 #include "core/gimpdatafactory.h"
 #include "core/gimpdynamics.h"
+#include "core/gimpstrokeoptions.h"
 #include "core/gimptoolinfo.h"
 #include "core/gimpviewable.h"
 
+#include "tools/gimppathoptions.h"
+
 #include "widgets/gimplayermodebox.h"
 #include "widgets/gimppropwidgets.h"
 #include "widgets/gimpuimanager.h"
@@ -119,8 +122,9 @@ static const BarSpec bar_specs[] =
   { "gimp-color-picker-tool",      { "sample-average", "average-radius", "pick-target", "sample-merged", NULL } },
   { "gimp-zoom-tool",              { "zoom-type", "auto-resize", NULL } },
   { "gimp-path-tool",              { "path-edit-mode", "path-polygonal",
-                                     "enable-fill", "fill-foreground",
+                                     "enable-fill", "fill-foreground", "@fill-opacity",
                                      "enable-stroke", "stroke-foreground", "stroke-width",
+                                     "@stroke-opacity", "@stroke-dash",
                                      "@vector-layer", NULL } },
 };
 
@@ -193,6 +197,34 @@ gimp_options_bar_vector_layer_clicked (GtkWidget *button,
   gimp_ui_manager_activate_action (manager, "paths", "paths-to-vector-layer");
 }
 
+static void
+gimp_options_bar_dash_changed (GtkComboBox       *combo,
+                               GimpStrokeOptions *stroke)
+{
+  static const GimpDashPreset presets[] = { GIMP_DASH_LINE, GIMP_DASH_MEDIUM_DASH,
+                                            GIMP_DASH_NORMAL_DOTS, GIMP_DASH_DASH_DOT };
+  gint i = gtk_combo_box_get_active (combo);
+
+  if (i >= 0 && i < G_N_ELEMENTS (presets))
+    gimp_stroke_options_take_dash_pattern (stroke, presets[i], NULL);
+}
+
+/*  Opacity slider bound to the fill or stroke options of the path tool
+ *  (each one has its own opacity, applied when rendering vector layers).
+ */
+static GtkWidget *
+gimp_options_bar_sub_opacity (GObject     *sub,
+                              const gchar *label,
+                              GtkWidget   *box)
+{
+  GtkWidget *w = gimp_prop_spin_scale_new (sub, "opacity", 1.0, 10.0, 0);
+
+  gimp_prop_widget_set_factor (w, 100.0, 1.0, 10.0, 0);
+  gtk_widget_set_size_request (w, 110, -1);
+  gimp_options_bar_pack_labeled (box, label, w);
+  return w;
+}
+
 /*  Build one compact widget for @prop of @options, or NULL  */
 static GtkWidget *
 gimp_options_bar_widget (GObject     *options,
@@ -221,6 +253,33 @@ gimp_options_bar_widget (GObject     *options,
                                        "gimp-gradient-editor",
                                        _("Edit this gradient"));
 
+  if (GIMP_IS_PATH_OPTIONS (options) && ! strcmp (prop, "@fill-opacity"))
+    {
+      *packed = TRUE;
+      return gimp_options_bar_sub_opacity (G_OBJECT (GIMP_PATH_OPTIONS (options)->fill_options),
+                                           _("Opacité"), box);
+    }
+
+  if (GIMP_IS_PATH_OPTIONS (options) && ! strcmp (prop, "@stroke-opacity"))
+    {
+      *packed = TRUE;
+      return gimp_options_bar_sub_opacity (G_OBJECT (GIMP_PATH_OPTIONS (options)->stroke_options),
+                                           _("Opacité"), box);
+    }
+
+  if (GIMP_IS_PATH_OPTIONS (options) && ! strcmp (prop, "@stroke-dash"))
+    {
+      w = gtk_combo_box_text_new ();
+      gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (w), _("Trait plein"));
+      gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (w), _("Tirets"));
+      gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (w), _("Pointillés"));
+      gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (w), _("Tiret-point"));
+      gtk_combo_box_set_active (GTK_COMBO_BOX (w), 0);
+      g_signal_connect (w, "changed", G_CALLBACK (gimp_options_bar_dash_changed),
+                        GIMP_PATH_OPTIONS (options)->stroke_options);
+      return w;
+    }
+
   if (! strcmp (prop, "@vector-layer"))
     {
       w = gtk_button_new_with_label (_("Créer un calque vectoriel"));
-- 
