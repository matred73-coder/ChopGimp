+static SpinScaleTarget
+gimp_spin_scale_get_slider_target (GtkWidget *widget,
+                                   gdouble    x,
+                                   gdouble    y,
+                                   GdkEvent  *event)
+{
+  SliderZone zone;
+  gboolean   inside;
+
+  zone = gimp_spin_scale_get_zone (GIMP_SPIN_SCALE (widget), x, y, &inside);
+
+  if (! inside)
+    return TARGET_NONE;
+
+  if (event && event->type != GDK_MOTION_NOTIFY)
+    {
+      GdkEventButton *event_button = (GdkEventButton *) event;
+
+      switch (event_button->button)
+        {
+        case 1:
+          if (zone == ZONE_FIELD)
+            return TARGET_NUMBER;
+          else if (event_button->state & GDK_SHIFT_MASK)
+            return TARGET_RELATIVE;
+          else if (zone == ZONE_TRACK)
+            return TARGET_GRABBING;
+          else
+            return TARGET_SCRUB;
+
+        case 3:
+          return (zone == ZONE_FIELD) ? TARGET_NUMBER : TARGET_RELATIVE;
+
+        case 2:
+          return (zone == ZONE_FIELD) ? TARGET_NUMBER : TARGET_NONE;
+
+        default:
+          return TARGET_NONE;
+        }
+    }
+
+  if (zone == ZONE_FIELD)
+    return TARGET_NUMBER;
+
+  if (event && (((GdkEventMotion *) event)->state & GDK_SHIFT_MASK))
+    return TARGET_RELATIVE;
+
+  return (zone == ZONE_TRACK) ? TARGET_GRAB : TARGET_SCRUB;
+}
