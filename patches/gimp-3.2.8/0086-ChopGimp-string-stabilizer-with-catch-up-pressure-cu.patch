index 54867cc..1a16695 100644
--- a/app/display/gimpdisplayshell-tool-events.c
+++ b/app/display/gimpdisplayshell-tool-events.c
@@ -37,6 +37,9 @@
 #include "core/gimpimage.h"
 #include "core/gimpimage-pick-item.h"
 #include "core/gimpitem.h"
+#include "core/gimptoolinfo.h"
+
+#include "paint/gimppaintoptions.h"
 
 #include "menus/menus.h"
 
@@ -789,6 +792,8 @@ gimp_display_shell_canvas_tool_events (GtkWidget        *canvas,
                   gimp_display_shell_stop_scrolling (shell, event);
                 break;
               case GIMP_MODIFIER_ACTION_BRUSH_PIXEL_SIZE:
+                gimp_statusbar_pop (gimp_display_shell_get_statusbar (shell), "chopgimp-hud");
+                /* fall through */
               case GIMP_MODIFIER_ACTION_BRUSH_RADIUS_PIXEL_SIZE:
               case GIMP_MODIFIER_ACTION_TOOL_OPACITY:
                 gimp_display_shell_stop_scrolling (shell, event);
@@ -1947,6 +1952,32 @@ gimp_display_shell_handle_scrolling (GimpDisplayShell *shell,
           size = (gint) (sqrt (pow ((x - shell->scroll_start_x) / shell->scale_x, 2) +
                                pow ((y - shell->scroll_start_y) / shell->scale_y, 2)));
 
+          /*  ChopGimp (Photoshop HUD): horizontal = size, vertical = hardness  */
+          if (shell->mod_action == GIMP_MODIFIER_ACTION_BRUSH_PIXEL_SIZE &&
+              active_tool && GIMP_IS_PAINT_OPTIONS (active_tool->tool_info->tool_options))
+            {
+              static gdouble start_hardness = -1.0;
+              static gdouble last_sx = G_MAXDOUBLE, last_sy = G_MAXDOUBLE;
+              GObject       *po = G_OBJECT (active_tool->tool_info->tool_options);
+              gdouble        hardness;
+
+              if (last_sx != shell->scroll_start_x || last_sy != shell->scroll_start_y)
+                {
+                  g_object_get (po, "brush-hardness", &start_hardness, NULL);
+                  last_sx = shell->scroll_start_x;
+                  last_sy = shell->scroll_start_y;
+                }
+
+              size     = MAX (1, (gint) (2.0 * fabs (x - shell->scroll_start_x) / shell->scale_x));
+              hardness = CLAMP (start_hardness + (shell->scroll_start_y - y) / 200.0, 0.0, 1.0);
+              g_object_set (po, "brush-hardness", hardness, NULL);
+
+              gimp_statusbar_replace (gimp_display_shell_get_statusbar (shell), "chopgimp-hud",
+                                      NULL, _("Taille %d px — Dureté %d %%  (horizontal : "
+                                              "taille, vertical : dureté)"),
+                                      size, (gint) (hardness * 100.0 + 0.5));
+            }
+
           /* TODO: different logics with "lock brush to view". */
           /* TODO 2: scale aware? */
           action = gimp_tool_control_get_action_pixel_size (active_tool->control);
