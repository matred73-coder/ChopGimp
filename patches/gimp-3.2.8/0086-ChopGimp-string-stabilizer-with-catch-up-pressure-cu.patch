+/*  ChopGimp: quick pressure curve of the current input device  */
+static void
+gimp_options_bar_pressure_changed (GtkComboBox *combo,
+                                   Gimp        *gimp)
+{
+  static const gdouble presets[][3][2] =
+  {
+    { { 0.0, 0.0 }, { 0.50, 0.50 }, { 1.0, 1.0 } },   /*  linéaire  */
+    { { 0.0, 0.0 }, { 0.25, 0.50 }, { 1.0, 1.0 } },   /*  douce     */
+    { { 0.0, 0.0 }, { 0.60, 0.30 }, { 1.0, 1.0 } },   /*  ferme     */
+    { { 0.0, 0.15 }, { 0.40, 0.70 }, { 1.0, 1.0 } },  /*  légère    */
+  };
+  GimpDeviceInfo *info;
+  GimpCurve      *curve;
+  gint            i = gtk_combo_box_get_active (combo);
+  gint            k;
+
+  if (i < 0 || i >= (gint) G_N_ELEMENTS (presets))
+    return;
+
+  info = gimp_device_manager_get_current_device (gimp_devices_get_manager (gimp));
+  if (! info || ! (curve = gimp_device_info_get_curve (info, GDK_AXIS_PRESSURE)))
+    return;
+
+  gimp_data_freeze (GIMP_DATA (curve));
+  gimp_curve_set_curve_type (curve, GIMP_CURVE_SMOOTH);
+  gimp_curve_clear_points (curve);
+  for (k = 0; k < 3; k++)
+    gimp_curve_add_point (curve, presets[i][k][0], presets[i][k][1]);
+  gimp_data_thaw (GIMP_DATA (curve));
+}
+
+static GtkWidget *
+gimp_options_bar_pressure_combo (Gimp *gimp)
+{
+  GtkWidget *combo = gtk_combo_box_text_new ();
+
+  gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (combo), _("Pression : linéaire"));
+  gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (combo), _("Pression : douce"));
+  gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (combo), _("Pression : ferme"));
+  gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (combo), _("Pression : légère"));
+  gtk_combo_box_set_active (GTK_COMBO_BOX (combo), 0);
+  gimp_help_set_help_data (combo, _("Courbe de pression du stylet actif (réglage fin : "
+                                    "Édition > Périphériques d'entrée)"), NULL);
+  g_signal_connect (combo, "changed", G_CALLBACK (gimp_options_bar_pressure_changed), gimp);
+  gtk_widget_show (combo);
+  return combo;
+}
+
 static void   gimp_options_bar_tool_changed (GimpContext  *context,
                                              GimpToolInfo *tool_info,
                                              GtkWidget    *bar);
