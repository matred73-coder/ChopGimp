diff --git a/app/display/chopgimp-popup-palette.c b/app/display/chopgimp-popup-palette.c
new file mode 100644
index 0000000..7d8f807
--- /dev/null
+++ b/app/display/chopgimp-popup-palette.c
@@ -0,0 +1,208 @@
+/* ChopGimp — palette contextuelle (façon Krita)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * Maj + clic droit sur le canevas (modificateur personnalisable) : une
+ * bulle sous le curseur avec les 10 derniers pinceaux, les couleurs
+ * récentes, un sélecteur de couleur et la taille du pinceau.
+ */
+
+#include "config.h"
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpcolor/gimpcolor.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "display-types.h"
+
+#include "core/gimp.h"
+#include "core/gimp-palettes.h"
+#include "core/gimpbrush.h"
+#include "core/gimpcontext.h"
+#include "core/gimppalette.h"
+#include "core/gimptoolinfo.h"
+
+#include "paint/gimppaintoptions.h"
+
+#include "widgets/gimpview.h"
+#include "widgets/gimppropwidgets.h"
+
+#include "gimpdisplay.h"
+#include "gimpdisplayshell.h"
+
+#include "chopgimp-popup-palette.h"
+
+#include "gimp-intl.h"
+
+
+#define N_BRUSHES 10
+#define N_COLORS  12
+
+static GList *recent_brushes = NULL;      /*  GimpBrush, most recent first  */
+
+static void
+brush_changed (GimpContext *context,
+               GimpBrush   *brush,
+               gpointer     data)
+{
+  if (! brush)
+    return;
+  recent_brushes = g_list_remove (recent_brushes, brush);
+  recent_brushes = g_list_prepend (recent_brushes, brush);
+  if (g_list_length (recent_brushes) > N_BRUSHES)
+    recent_brushes = g_list_delete_link (recent_brushes, g_list_last (recent_brushes));
+}
+
+void
+chopgimp_popup_palette_track (Gimp *gimp)
+{
+  static gboolean connected = FALSE;
+  GimpContext    *context   = gimp_get_user_context (gimp);
+
+  if (connected)
+    return;
+  connected = TRUE;
+  g_signal_connect (context, "brush-changed", G_CALLBACK (brush_changed), NULL);
+  brush_changed (context, gimp_context_get_brush (context), NULL);
+}
+
+static void
+brush_clicked (GtkButton *button,
+               GimpBrush *brush)
+{
+  GimpContext *context = g_object_get_data (G_OBJECT (button), "context");
+
+  gimp_context_set_brush (context, brush);
+  gtk_widget_hide (gtk_widget_get_ancestor (GTK_WIDGET (button), GTK_TYPE_POPOVER));
+}
+
+static void
+color_clicked (GtkButton *button,
+               GeglColor *color)
+{
+  GimpContext *context = g_object_get_data (G_OBJECT (button), "context");
+
+  gimp_context_set_foreground (context, color);
+}
+
+static void
+chooser_changed (GtkColorChooser *chooser,
+                 GParamSpec      *pspec,
+                 GimpContext     *context)
+{
+  GdkRGBA    rgba;
+  GeglColor *color = gegl_color_new (NULL);
+
+  gtk_color_chooser_get_rgba (chooser, &rgba);
+  gegl_color_set_pixel (color, babl_format ("R'G'B'A double"), (gdouble[]) { rgba.red, rgba.green, rgba.blue, 1.0 });
+  gimp_context_set_foreground (context, color);
+  g_object_unref (color);
+}
+
+static void
+popover_closed (GtkPopover *popover)
+{
+  gtk_widget_destroy (GTK_WIDGET (popover));
+}
+
+void
+chopgimp_popup_palette_show (GimpDisplayShell *shell)
+{
+  Gimp        *gimp    = gimp_display_get_gimp (shell->display);
+  GimpContext *context = gimp_get_user_context (gimp);
+  GimpToolInfo *tool_info = gimp_context_get_tool (context);
+  GtkWidget   *popover, *box, *grid, *chooser, *label;
+  GimpPalette *history;
+  GdkRectangle rect = { 0, 0, 1, 1 };
+  GdkWindow   *window = gtk_widget_get_window (shell->canvas);
+  GdkSeat     *seat;
+  GList       *list;
+  gint         i;
+  gdouble      rgb[4];
+  GdkRGBA      rgba;
+
+  chopgimp_popup_palette_track (gimp);
+
+  if (window && (seat = gdk_display_get_default_seat (gdk_window_get_display (window))))
+    gdk_window_get_device_position (window, gdk_seat_get_pointer (seat), &rect.x, &rect.y, NULL);
+
+  popover = gtk_popover_new (shell->canvas);
+  gtk_popover_set_pointing_to (GTK_POPOVER (popover), &rect);
+  g_signal_connect (popover, "closed", G_CALLBACK (popover_closed), NULL);
+
+  box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_container_set_border_width (GTK_CONTAINER (box), 8);
+  gtk_container_add (GTK_CONTAINER (popover), box);
+
+  /*  recent brushes  */
+  label = gtk_label_new (_("Pinceaux récents"));
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+  grid = gtk_grid_new ();
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 2);
+  gtk_grid_set_row_spacing (GTK_GRID (grid), 2);
+  gtk_box_pack_start (GTK_BOX (box), grid, FALSE, FALSE, 0);
+  for (list = recent_brushes, i = 0; list; list = list->next, i++)
+    {
+      GtkWidget *button = gtk_button_new ();
+      GtkWidget *view   = gimp_view_new (context, GIMP_VIEWABLE (list->data), 36, 0, FALSE);
+
+      gtk_container_add (GTK_CONTAINER (button), view);
+      gtk_button_set_relief (GTK_BUTTON (button), GTK_RELIEF_NONE);
+      gimp_help_set_help_data (button, gimp_object_get_name (list->data), NULL);
+      g_object_set_data (G_OBJECT (button), "context", context);
+      g_signal_connect (button, "clicked", G_CALLBACK (brush_clicked), list->data);
+      gtk_grid_attach (GTK_GRID (grid), button, i % 5, i / 5, 1, 1);
+    }
+
+  /*  brush size of the current paint tool  */
+  if (tool_info && GIMP_IS_PAINT_OPTIONS (tool_info->tool_options))
+    {
+      GtkWidget *scale = gimp_prop_spin_scale_new (G_OBJECT (tool_info->tool_options),
+                                                   "brush-size", 1.0, 10.0, 0);
+
+      gimp_spin_scale_set_scale_limits (GIMP_SPIN_SCALE (scale), 1.0, 1000.0);
+      gimp_spin_scale_set_gamma (GIMP_SPIN_SCALE (scale), 1.7);
+      gtk_box_pack_start (GTK_BOX (box), scale, FALSE, FALSE, 0);
+    }
+
+  /*  recent colors  */
+  label = gtk_label_new (_("Couleurs récentes"));
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+  grid = gtk_grid_new ();
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 2);
+  gtk_box_pack_start (GTK_BOX (box), grid, FALSE, FALSE, 0);
+  history = gimp_palettes_get_color_history (gimp);
+  for (i = 0; history && i < MIN (N_COLORS, gimp_palette_get_n_colors (history)); i++)
+    {
+      GimpPaletteEntry *entry  = gimp_palette_get_entry (history, i);
+      GtkWidget        *button = gtk_button_new ();
+      GtkWidget        *area   = gimp_color_area_new (entry->color, GIMP_COLOR_AREA_FLAT, 0);
+
+      gtk_widget_set_size_request (area, 22, 22);
+      gtk_container_add (GTK_CONTAINER (button), area);
+      gtk_button_set_relief (GTK_BUTTON (button), GTK_RELIEF_NONE);
+      g_object_set_data (G_OBJECT (button), "context", context);
+      g_signal_connect (button, "clicked", G_CALLBACK (color_clicked), entry->color);
+      gtk_grid_attach (GTK_GRID (grid), button, i, 0, 1, 1);
+    }
+
+  /*  color picker (hue / saturation / value)  */
+  chooser = gtk_color_chooser_widget_new ();
+  g_object_set (chooser, "show-editor", TRUE, NULL);
+  gtk_color_chooser_set_use_alpha (GTK_COLOR_CHOOSER (chooser), FALSE);
+  gegl_color_get_pixel (gimp_context_get_foreground (context), babl_format ("R'G'B'A double"), rgb);
+  rgba.red = rgb[0]; rgba.green = rgb[1]; rgba.blue = rgb[2]; rgba.alpha = 1.0;
+  gtk_color_chooser_set_rgba (GTK_COLOR_CHOOSER (chooser), &rgba);
+  g_signal_connect (chooser, "notify::rgba", G_CALLBACK (chooser_changed), context);
+  gtk_box_pack_start (GTK_BOX (box), chooser, FALSE, FALSE, 0);
+
+  gtk_widget_show_all (box);
+  gtk_popover_popup (GTK_POPOVER (popover));
+}
