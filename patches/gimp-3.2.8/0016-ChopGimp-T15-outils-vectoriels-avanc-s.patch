+
+#pragma once
+
+
+void   gimp_vblend_tool_register (GimpToolRegisterCallback  callback,
+                                  gpointer                  data);
+void   gimp_vmesh_tool_register  (GimpToolRegisterCallback  callback,
+                                  gpointer                  data);
+
+
+/*  ChopGimp 3.29.5: the points of a « dégradé libre » edited from another
+ *  tool (the Gradient tool, Illustrator's way): a click on an object of
+ *  the active vector layer gives its fill a freeform gradient if needed
+ *  and adds a point (foreground color), drag moves a point, Maj+clic
+ *  colors it, Alt+clic removes it. Mode Lignes: the new point is joined
+ *  to the selected one. CHOPGIMP_NO_GRADIENT_FREEFORM=1 turns it off.
+ */
+typedef struct
+{
+  struct _GimpVectorLayer *layer;
+  guint                    target;    /* the edited object                  */
+  guint                    hover;     /* the object under the pointer       */
+  gint                     node;      /* the dragged point, -1: none        */
+  gint                     sel;       /* the selected point, -1: none       */
+  gboolean                 dragging;
+  gboolean                 pressed;   /* the press was used                 */
+} ChopGimpFreeformEdit;
+
+gboolean chopgimp_freeform_edit_wanted  (GimpImage            *image);
+void     chopgimp_freeform_edit_reset   (ChopGimpFreeformEdit *fe);
+gboolean chopgimp_freeform_edit_hover   (ChopGimpFreeformEdit *fe,
+                                         GimpDisplay          *display,
+                                         const GimpCoords     *coords);
+gboolean chopgimp_freeform_edit_press   (ChopGimpFreeformEdit *fe,
+                                         GimpDisplay          *display,
+                                         const GimpCoords     *coords,
+                                         GdkModifierType       state,
+                                         gboolean              lines);
+void     chopgimp_freeform_edit_motion  (ChopGimpFreeformEdit *fe,
+                                         GimpDisplay          *display,
+                                         const GimpCoords     *coords);
+void     chopgimp_freeform_edit_release (ChopGimpFreeformEdit *fe);
+void     chopgimp_freeform_edit_draw    (ChopGimpFreeformEdit *fe,
+                                         GimpDrawTool         *draw_tool);
diff --git a/app/tools/chopgimp-vpentools.c b/app/tools/chopgimp-vpentools.c
new file mode 100644
index 0000000..358b2ef
--- /dev/null
+++ b/app/tools/chopgimp-vpentools.c
@@ -0,0 +1,1234 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-vpentools.c — ChopGimp 3.29.0 (vectoriel « complet », bloc 1):
+ * the drawing and editing tools of Illustrator on vector objects
+ *
+ *  - Courbure (Maj+`): each click adds a point, the curve goes smoothly
+ *    through all of them; Alt+click: a corner point; double-click on a
+ *    point: smooth ↔ corner; drag a point to move it; a click on the
+ *    first point closes; Entrée / Échap end, Retour arrière removes the
+ *    last point;
+ *  - Crayon vectoriel (N): a freehand line fitted into Béziers
+ *    (« Fidélité »); starting near the end of the selected open path
+ *    extends it; ending near the start closes it;
+ *  - Lissage: rubbing the selected objects smooths them locally;
+ *  - Ciseaux: a click cuts a path there (closed: opened; open: two
+ *    objects);
+ *  - Cutter: a freehand drag slices the shapes crossed into pieces;
+ *  - Jonction: scrubbing over two open ends joins them.
+ *
+ * New objects go to the active vector layer (« Ajouter au calque
+ * vectoriel actif ») or a new vector layer, like the Forme tool; the
+ * editing tools work on the objects of the active vector layer
+ * (app/path/chopgimp-vtransform.c).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+#include <gdk/gdkkeysyms.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpconfig/gimpconfig.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "tools-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpcontext.h"
+#include "core/gimpfilloptions.h"
+#include "core/gimpimage.h"
+#include "core/gimpimage-undo.h"
+#include "core/gimpstrokeoptions.h"
+#include "core/gimptoolinfo.h"
+
+#include "path/gimpbezierstroke.h"
+#include "path/gimppath.h"
+#include "path/gimpvectorlayer.h"
+#include "path/gimpvectorlayeroptions.h"
+#include "path/chopgimp-geom.h"
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vutil.h"
+#include "path/chopgimp-vobject-ops.h"
+#include "path/chopgimp-vtransform.h"
+
+#include "widgets/gimphelp-ids.h"
+#include "widgets/gimpwidgets-utils.h"
+
+#include "display/gimpcanvasitem.h"
+#include "display/gimpcanvaspath.h"
+#include "display/gimpdisplay.h"
+#include "display/gimpdisplayshell.h"
+
+#include "gimpdrawtool.h"
+#include "gimppathoptions.h"
+#include "gimptoolcontrol.h"
+#include "gimptooloptions-gui.h"
+#include "chopgimp-tools.h"
+#include "chopgimp-vpentools.h"
+
+#include "gimp-intl.h"
+
+
+#define HIT_PX        8.0     /* screen px                               */
+#define CLOSE_PX     10.0
+#define MAX_POINTS 20000
+
+
+/*  ─── options (shared by the six tools) ─────────────────────────────── */
+
+enum
+{
+  PROP_0,
+  PROP_FIDELITY,
+  PROP_KEEP_SELECTED,
+  PROP_SMOOTH_STRENGTH,
+  PROP_BRUSH_RADIUS
+};
+
+typedef struct
+{
+  GimpPathOptions parent_instance;
+
+  gdouble         fidelity;          /* 0 accurate … 100 smooth          */
+  gboolean        keep_selected;
+  gdouble         smooth_strength;   /* 0..100                           */
+  gdouble         brush_radius;      /* screen px                        */
+} GimpVPenOptions;
+
+typedef GimpToolOptionsClass GimpVPenOptionsClass;
+
+static GType gimp_vpen_options_get_type (void) G_GNUC_CONST;
+
+G_DEFINE_TYPE (GimpVPenOptions, gimp_vpen_options, GIMP_TYPE_PATH_OPTIONS)
+
+#define GIMP_TYPE_VPEN_OPTIONS (gimp_vpen_options_get_type ())
+#define VPEN_OPTIONS(tool)     ((GimpVPenOptions *) gimp_tool_get_options (GIMP_TOOL (tool)))
+
+static void
+gimp_vpen_options_set_property (GObject      *object,
+                                guint         property_id,
+                                const GValue *value,
+                                GParamSpec   *pspec)
+{
+  GimpVPenOptions *o = (GimpVPenOptions *) object;
+
+  switch (property_id)
+    {
+    case PROP_FIDELITY:        o->fidelity        = g_value_get_double  (value); break;
+    case PROP_KEEP_SELECTED:   o->keep_selected   = g_value_get_boolean (value); break;
+    case PROP_SMOOTH_STRENGTH: o->smooth_strength = g_value_get_double  (value); break;
+    case PROP_BRUSH_RADIUS:    o->brush_radius    = g_value_get_double  (value); break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_vpen_options_get_property (GObject    *object,
+                                guint       property_id,
+                                GValue     *value,
+                                GParamSpec *pspec)
+{
+  GimpVPenOptions *o = (GimpVPenOptions *) object;
+
+  switch (property_id)
+    {
+    case PROP_FIDELITY:        g_value_set_double  (value, o->fidelity);        break;
+    case PROP_KEEP_SELECTED:   g_value_set_boolean (value, o->keep_selected);   break;
+    case PROP_SMOOTH_STRENGTH: g_value_set_double  (value, o->smooth_strength); break;
+    case PROP_BRUSH_RADIUS:    g_value_set_double  (value, o->brush_radius);    break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_vpen_options_class_init (GimpVPenOptionsClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->set_property = gimp_vpen_options_set_property;
+  object_class->get_property = gimp_vpen_options_get_property;
+
+  GIMP_CONFIG_PROP_DOUBLE (object_class, PROP_FIDELITY,
+                           "fidelity", "Fidélité",
+                           "0 : précis (suit le tracé) — 100 : lisse",
+                           0.0, 100.0, 50.0,
+                           GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, PROP_KEEP_SELECTED,
+                            "keep-selected", "Garder la sélection",
+                            "Le tracé dessiné reste sélectionné : repartir de sa "
+                            "fin le prolonge",
+                            TRUE,
+                            GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_DOUBLE (object_class, PROP_SMOOTH_STRENGTH,
+                           "smooth-strength", "Force",
+                           "Force du lissage",
+                           0.0, 100.0, 50.0,
+                           GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_DOUBLE (object_class, PROP_BRUSH_RADIUS,
+                           "brush-radius", "Rayon",
+                           "Rayon du lissage (pixels à l'écran)",
+                           4.0, 200.0, 20.0,
+                           GIMP_PARAM_STATIC_STRINGS);
+}
+
+static void
+gimp_vpen_options_init (GimpVPenOptions *options)
+{
+}
+
+
+/*  ─── the tool ──────────────────────────────────────────────────────── */
+
+typedef enum
+{
+  VPEN_CURVATURE,
+  VPEN_PENCIL,
+  VPEN_SMOOTH,
+  VPEN_SCISSORS,
+  VPEN_KNIFE,
+  VPEN_JOIN
+} VPenKind;
+
+typedef struct
+{
+  gdouble  x, y;
+  gboolean corner;
+} CPoint;
+
+typedef struct
+{
+  GimpDrawTool     parent_instance;
+
+  GArray          *pts;         /* CURVATURE: CPoint; others: GimpVector2 */
+  gint             drag;        /* CURVATURE: point being moved, -1       */
+  gboolean         moved;
+  gdouble          hover_x, hover_y;
+  gboolean         hovering;
+
+  /*  PENCIL: extending an object  */
+  guint            extend_id;
+  gint             extend_sub, extend_end;
+
+  /*  SMOOTH  */
+  GimpVectorLayer *layer;       /* weak                                  */
+  gboolean         pushed;
+  gdouble          last_x, last_y;
+} GimpVPenTool;
+
+typedef struct
+{
+  GimpDrawToolClass parent_class;
+
+  VPenKind          kind;
+} GimpVPenToolClass;
+
+static GType gimp_vpen_tool_get_type (void) G_GNUC_CONST;
+
+G_DEFINE_TYPE (GimpVPenTool, gimp_vpen_tool, GIMP_TYPE_DRAW_TOOL)
+
+#define KIND(t) (((GimpVPenToolClass *) G_OBJECT_GET_CLASS (t))->kind)
+
+
+static gdouble
+screen_px (GimpDisplay *display,
+           gdouble      px)
+{
+  return px / MAX (gimp_display_get_shell (display)->scale_x, 1e-6);
+}
+
+static void
+vpen_set_layer (GimpVPenTool    *vt,
+                GimpVectorLayer *layer)
+{
+  if (vt->layer == layer)
+    return;
+
+  if (vt->layer)
+    g_object_remove_weak_pointer (G_OBJECT (vt->layer), (gpointer *) &vt->layer);
+
+  vt->layer = layer;
+
+  if (layer)
+    g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &vt->layer);
+}
+
+static void
+vpen_clear (GimpVPenTool *vt)
+{
+  g_array_set_size (vt->pts, 0);
+  vt->drag      = -1;
+  vt->moved     = FALSE;
+  vt->pushed    = FALSE;
+  vt->extend_id = 0;
+}
+
+
+/*  ─── new objects (like the Forme tool) ─────────────────────────────── */
+
+/*  @path: image coordinates, one or more strokes; open paths are stroked
+ *  only
+ */
+static void
+vpen_add_object (GimpVPenTool *vt,
+                 GimpDisplay  *display,
+                 GimpPath     *path,
+                 const gchar  *name,
+                 gboolean      open)
+{
+  GimpPathOptions *popts = GIMP_PATH_OPTIONS (gimp_tool_get_options (GIMP_TOOL (vt)));
+  GimpImage       *image = gimp_display_get_image (display);
+  GimpVectorLayer *layer;
+
+  gimp_path_options_ensure_fill_stroke (popts);
+
+  if (popts->add_to_vector_layer &&
+      (layer = chopgimp_vobjects_get_target_layer (image)))
+    {
+      ChopGimpVStyle style;
+
+      chopgimp_vobjects_style_from_tool (&style, image,
+                                         open ? FALSE : popts->enable_fill,
+                                         popts->fill_options,
+                                         open ? TRUE  : popts->enable_stroke,
+                                         popts->stroke_options);
+      chopgimp_vobjects_add_path (layer, path, name, &style);
+      chopgimp_vstyle_clear (&style);
+    }
+  else
+    {
+      GimpPath *copy = GIMP_PATH (gimp_item_duplicate (GIMP_ITEM (path), GIMP_TYPE_PATH));
+
+      gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_DRAWABLE, name);
+
+      gimp_object_set_name (GIMP_OBJECT (copy), name);
+      gimp_image_add_path (image, copy, GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+
+      layer = gimp_vector_layer_new (image, copy, gimp_get_user_context (image->gimp));
+
+      g_object_set (layer->options,
+                    "enable-fill",   open ? FALSE : popts->enable_fill,
+                    "enable-stroke", open ? TRUE  : popts->enable_stroke,
+                    NULL);
+      gimp_config_sync (G_OBJECT (popts->fill_options),
+                        G_OBJECT (layer->options->fill_options), 0);
+      gimp_config_sync (G_OBJECT (popts->stroke_options),
+                        G_OBJECT (layer->options->stroke_options), 0);
+
+      gimp_image_add_layer (image, GIMP_LAYER (layer), GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+      gimp_vector_layer_refresh (layer);
+
+      gimp_image_undo_group_end (image);
+    }
+
+  gimp_image_flush (image);
+}
+
+
+/*  ─── Courbure ──────────────────────────────────────────────────────── */
+
+/*  the curve through the points: smooth points get Catmull-Rom handles
+ *  (1/6 of the chord between their neighbours), corner points none
+ */
+static GimpStroke *
+curvature_stroke (const CPoint *p,
+                  gint          n,
+                  gboolean      closed)
+{
+  GimpStroke *st;
+  GimpCoords  c, c1, c2;
+
+  if (n < 2)
+    return NULL;
+
+  c  = chopgimp_coords (p[0].x, p[0].y);
+  st = gimp_bezier_stroke_new_moveto (&c);
+
+  for (gint i = 0; i < n - 1 + (closed ? 1 : 0); i++)
+    {
+      gint    a  = i, b = (i + 1) % n;
+      gint    a0 = (a - 1 + n) % n, b1 = (b + 1) % n;
+      gdouble ox = 0, oy = 0, ix = 0, iy = 0;
+
+      if (! p[a].corner && (closed || a > 0))
+        {
+          ox = (p[b].x - p[a0].x) / 6.0;
+          oy = (p[b].y - p[a0].y) / 6.0;
+        }
+      if (! p[b].corner && (closed || b < n - 1))
+        {
+          ix = (p[b1].x - p[a].x) / 6.0;
+          iy = (p[b1].y - p[a].y) / 6.0;
+        }
+
+      c1 = chopgimp_coords (p[a].x + ox, p[a].y + oy);
+      c2 = chopgimp_coords (p[b].x - ix, p[b].y - iy);
+      c  = chopgimp_coords (p[b].x, p[b].y);
+      gimp_bezier_stroke_cubicto (st, &c1, &c2, &c);
+    }
+
+  if (closed)
+    gimp_stroke_close (st);
+
+  return st;
+}
+
+static void
+curvature_commit (GimpVPenTool *vt,
+                  GimpDisplay  *display,
+                  gboolean      closed)
+{
+  GimpImage  *image = gimp_display_get_image (display);
+  GimpStroke *st;
+  GimpPath   *path;
+
+  if (vt->pts->len < 2)
+    {
+      vpen_clear (vt);
+      return;
+    }
+
+  st = curvature_stroke ((CPoint *) vt->pts->data, vt->pts->len, closed);
+
+  path = gimp_path_new (image, _("Courbure"));
+  g_object_ref_sink (path);
+  gimp_path_stroke_add (path, st);
+  g_object_unref (st);
+
+  vpen_add_object (vt, display, path, _("Courbure"), ! closed);
+
+  g_object_unref (path);
+  vpen_clear (vt);
+}
+
+static gint
+curvature_point_at (GimpVPenTool     *vt,
+                    GimpDisplay      *display,
+                    const GimpCoords *coords)
+{
+  gdouble tol = screen_px (display, HIT_PX);
+
+  for (gint i = vt->pts->len - 1; i >= 0; i--)
+    {
+      CPoint *p = &g_array_index (vt->pts, CPoint, i);
+
+      if (hypot (p->x - coords->x, p->y - coords->y) <= tol)
+        return i;
+    }
+
+  return -1;
+}
+
+
+/*  ─── events ────────────────────────────────────────────────────────── */
+
+static void
+gimp_vpen_tool_button_press (GimpTool            *tool,
+                             const GimpCoords    *coords,
+                             guint32              time,
+                             GdkModifierType      state,
+                             GimpButtonPressType  press_type,
+                             GimpDisplay         *display)
+{
+  GimpVPenTool    *vt    = (GimpVPenTool *) tool;
+  GimpImage       *image = gimp_display_get_image (display);
+  GimpVectorLayer *layer = image ? chopgimp_vobjects_get_target_layer (image) : NULL;
+  VPenKind         kind  = KIND (tool);
+
+  if (! image)
+    return;
+
+  if (tool->display && tool->display != display)
+    {
+      vpen_clear (vt);
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+    }
+
+  tool->display = display;
+  vpen_set_layer (vt, layer);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (vt));
+
+  switch (kind)
+    {
+    case VPEN_CURVATURE:
+      {
+        gint k = curvature_point_at (vt, display, coords);
+
+        if (k >= 0 && press_type == GIMP_BUTTON_PRESS_DOUBLE)
+          {
+            CPoint *p = &g_array_index (vt->pts, CPoint, k);
+
+            p->corner = ! p->corner;
+          }
+        else if (k == 0 && vt->pts->len >= 2 && press_type == GIMP_BUTTON_PRESS_NORMAL)
+          {
+            gimp_draw_tool_resume (GIMP_DRAW_TOOL (vt));
+            curvature_commit (vt, display, TRUE);
+            chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (vt), display);
+            return;
+          }
+        else if (k >= 0)
+          {
+            vt->drag  = k;
+            vt->moved = FALSE;
+          }
+        else if (press_type == GIMP_BUTTON_PRESS_NORMAL)
+          {
+            CPoint p;
+
+            p.x      = coords->x;
+            p.y      = coords->y;
+            p.corner = (state & GDK_MOD1_MASK) != 0;
+            g_array_append_val (vt->pts, p);
+            vt->drag  = vt->pts->len - 1;
+            vt->moved = FALSE;
+          }
+      }
+      break;
+
+    case VPEN_PENCIL:
+      {
+        GimpVPenOptions *o = VPEN_OPTIONS (vt);
+        GimpVector2      v = { coords->x, coords->y };
+
+        vpen_clear (vt);
+        g_array_append_val (vt->pts, v);
+
+        /*  starting at the end of the selected open path: extend it  */
+        if (o->keep_selected && layer && chopgimp_vobjects_n_selected (layer) == 1)
+          {
+            const guint     *ids;
+            gint             n  = 0;
+            ChopGimpVObject *ob;
+
+            ids = chopgimp_vlayer_get_selection (layer, &n);
+            ob  = chopgimp_vlayer_get_object (layer, ids[0]);
+
+            if (ob && ob->kind == CHOPGIMP_VOBJECT_PATH)
+              {
+                GimpPath *world = chopgimp_vobject_get_world_path (layer, ob, FALSE);
+                gdouble  *e;
+                gint      n_open = 0;
+
+                if (world)
+                  {
+                    g_object_ref_sink (world);
+                    e = chopgimp_geom_endpoints (world, &n_open);
+
+                    for (gint i = 0; i < n_open && ! vt->extend_id; i++)
+                      for (gint j = 0; j < 2; j++)
+                        if (hypot (e[4 * i + 2 * j] - coords->x,
+                                   e[4 * i + 2 * j + 1] - coords->y) <=
+                            screen_px (display, CLOSE_PX))
+                          {
+                            vt->extend_id  = ob->id;
+                            vt->extend_sub = i;
+                            vt->extend_end = j;
+                            break;
+                          }
+
+                    g_free (e);
+                    g_object_unref (world);
+                  }
+              }
+          }
+      }
+      break;
+
+    case VPEN_SMOOTH:
+      vpen_clear (vt);
+      vt->last_x = vt->last_y = -G_MAXDOUBLE;
+      break;
+
+    case VPEN_SCISSORS:
+      if (layer && chopgimp_vtransform_cut (layer, coords->x, coords->y,
+                                            screen_px (display, HIT_PX)))
+        gimp_image_flush (image);
+      else
+        gimp_tool_message_literal (tool, display,
+                                   _("Cliquez sur le tracé d'un objet du calque vectoriel "
+                                     "actif pour le couper à cet endroit."));
+      break;
+
+    case VPEN_KNIFE:
+    case VPEN_JOIN:
+      {
+        GimpVector2 v = { coords->x, coords->y };
+
+        vpen_clear (vt);
+        g_array_append_val (vt->pts, v);
+      }
+      break;
+    }
+
+  gimp_tool_control_activate (tool->control);
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (vt));
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (vt), display);
+}
+
+static void
+vpen_smooth_at (GimpVPenTool     *vt,
+                GimpDisplay      *display,
+                const GimpCoords *coords)
+{
+  GimpVPenOptions *o      = VPEN_OPTIONS (vt);
+  gdouble          radius = screen_px (display, o->brush_radius);
+  GList           *sel, *leaves = NULL;
+  gint             k = 0;
+
+  if (! vt->layer || hypot (coords->x - vt->last_x, coords->y - vt->last_y) < radius / 3)
+    return;
+
+  vt->last_x = coords->x;
+  vt->last_y = coords->y;
+
+  sel = chopgimp_vlayer_get_selected_objects (vt->layer);
+  for (GList *l = sel; l; l = l->next)
+    leaves = g_list_concat (leaves, chopgimp_vobjects_leaves_of (l->data));
+  g_list_free (sel);
+
+  chopgimp_vlayer_freeze (vt->layer);
+
+  for (GList *l = leaves; l && k < 50; l = l->next, k++)
+    {
+      ChopGimpVObject *ob = l->data;
+      GimpPath        *world, *smooth, *local;
+
+      if (chopgimp_vobject_is_locked (ob) ||
+          ! (world = chopgimp_vobject_get_world_path (vt->layer, ob, FALSE)))
+        continue;
+
+      g_object_ref_sink (world);
+      smooth = chopgimp_geom_smooth_local (world, coords->x, coords->y, radius,
+                                           o->smooth_strength / 100.0);
+
+      if (smooth)
+        {
+          g_object_ref_sink (smooth);
+
+          if (! vt->pushed)
+            {
+              chopgimp_vlayer_push_undo (vt->layer, _("Lissage"));
+              vt->pushed = TRUE;
+            }
+
+          local = chopgimp_vobjects_path_to_local (ob, smooth);
+          if (local)
+            {
+              chopgimp_vlayer_set_path (vt->layer, ob->id, local, FALSE);
+              g_object_unref (local);
+            }
+
+          g_object_unref (smooth);
+        }
+
+      g_object_unref (world);
+    }
+
+  chopgimp_vlayer_thaw (vt->layer);
+  g_list_free (leaves);
+
+  gimp_image_flush (gimp_display_get_image (display));
+}
+
+static void
+gimp_vpen_tool_motion (GimpTool         *tool,
+                       const GimpCoords *coords,
+                       guint32           time,
+                       GdkModifierType   state,
+                       GimpDisplay      *display)
+{
+  GimpVPenTool *vt = (GimpVPenTool *) tool;
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (vt));
+
+  vt->hover_x  = coords->x;
+  vt->hover_y  = coords->y;
+  vt->hovering = TRUE;
+
+  switch (KIND (tool))
+    {
+    case VPEN_CURVATURE:
+      if (vt->drag >= 0 && vt->drag < (gint) vt->pts->len)
+        {
+          CPoint *p = &g_array_index (vt->pts, CPoint, vt->drag);
+
+          p->x      = coords->x;
+          p->y      = coords->y;
+          vt->moved = TRUE;
+        }
+      break;
+
+    case VPEN_PENCIL:
+    case VPEN_KNIFE:
+    case VPEN_JOIN:
+      if (vt->pts->len < MAX_POINTS)
+        {
+          GimpVector2 v = { coords->x, coords->y };
+
+          g_array_append_val (vt->pts, v);
+        }
+      break;
+
+    case VPEN_SMOOTH:
+      vpen_smooth_at (vt, display, coords);
+      break;
+
+    default:
+      break;
+    }
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (vt));
+}
+
+static void
+pencil_commit (GimpVPenTool *vt,
+               GimpDisplay  *display)
+{
+  GimpVPenOptions *o     = VPEN_OPTIONS (vt);
+  GimpImage       *image = gimp_display_get_image (display);
+  GimpVector2     *v     = (GimpVector2 *) vt->pts->data;
+  gint             n     = vt->pts->len;
+  gdouble          tol   = screen_px (display, 0.5 + o->fidelity * 0.1);
+  gboolean         closed;
+  GimpPath        *like, *fit;
+  gdouble         *xy;
+
+  if (n < 3)
+    return;
+
+  closed = ! vt->extend_id && n > 10 &&
+           hypot (v[0].x - v[n - 1].x, v[0].y - v[n - 1].y) <= screen_px (display, CLOSE_PX);
+
+  xy = g_new (gdouble, 2 * n);
+  for (gint i = 0; i < n; i++)
+    {
+      xy[2 * i]     = v[i].x;
+      xy[2 * i + 1] = v[i].y;
+    }
+
+  like = gimp_path_new (image, _("Crayon"));
+  g_object_ref_sink (like);
+
+  fit = chopgimp_geom_fit_points (like, xy, n, tol, closed);
+  g_free (xy);
+
+  if (fit)
+    {
+      g_object_ref_sink (fit);
+
+      if (vt->extend_id && vt->layer)
+        {
+          ChopGimpVObject *ob    = chopgimp_vlayer_get_object (vt->layer, vt->extend_id);
+          GimpPath        *world = ob ? chopgimp_vobject_get_world_path (vt->layer, ob, FALSE)
+                                      : NULL;
+          GimpPath        *joined = NULL;
+
+          if (world)
+            {
+              g_object_ref_sink (world);
+              joined = chopgimp_geom_join (world, vt->extend_sub, vt->extend_end,
+                                           fit, 0, 0);
+            }
+
+          if (joined)
+            {
+              GimpPath *local;
+
+              g_object_ref_sink (joined);
+              local = chopgimp_vobjects_path_to_local (ob, joined);
+
+              if (local)
+                {
+                  chopgimp_vlayer_push_undo (vt->layer, _("Prolonger le tracé"));
+                  chopgimp_vlayer_set_path (vt->layer, ob->id, local, FALSE);
+                  g_object_unref (local);
+                  gimp_image_flush (image);
+                }
+
+              g_object_unref (joined);
+            }
+
+          g_clear_object (&world);
+        }
+      else
+        {
+          vpen_add_object (vt, display, fit, _("Crayon"), ! closed);
+        }
+
+      g_object_unref (fit);
+    }
+
+  g_object_unref (like);
+}
+
+static void
+gimp_vpen_tool_button_release (GimpTool              *tool,
+                               const GimpCoords      *coords,
+                               guint32                time,
+                               GdkModifierType        state,
+                               GimpButtonReleaseType  release_type,
+                               GimpDisplay           *display)
+{
+  GimpVPenTool *vt     = (GimpVPenTool *) tool;
+  GimpImage    *image  = gimp_display_get_image (display);
+  gboolean      cancel = (release_type == GIMP_BUTTON_RELEASE_CANCEL);
+
+  gimp_tool_control_halt (tool->control);
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (vt));
+
+  switch (KIND (tool))
+    {
+    case VPEN_CURVATURE:
+      vt->drag = -1;
+      break;
+
+    case VPEN_PENCIL:
+      if (! cancel)
+        pencil_commit (vt, display);
+      vpen_clear (vt);
+      break;
+
+    case VPEN_SMOOTH:
+      if (cancel && vt->pushed)
+        gimp_image_undo (image);
+      vpen_clear (vt);
+      break;
+
+    case VPEN_KNIFE:
+      if (! cancel && vt->layer && vt->pts->len >= 2)
+        {
+          gdouble *xy = g_new (gdouble, 2 * vt->pts->len);
+
+          for (guint i = 0; i < vt->pts->len; i++)
+            {
+              GimpVector2 *v = &g_array_index (vt->pts, GimpVector2, i);
+
+              xy[2 * i]     = v->x;
+              xy[2 * i + 1] = v->y;
+            }
+
+          if (chopgimp_vtransform_knife (vt->layer, xy, vt->pts->len))
+            gimp_image_flush (image);
+
+          g_free (xy);
+        }
+      vpen_clear (vt);
+      break;
+
+    case VPEN_JOIN:
+      if (! cancel && vt->layer && vt->pts->len >= 1)
+        {
+          gdouble x1 = G_MAXDOUBLE, y1 = G_MAXDOUBLE, x2 = -G_MAXDOUBLE, y2 = -G_MAXDOUBLE;
+          gdouble r;
+
+          for (guint i = 0; i < vt->pts->len; i++)
+            {
+              GimpVector2 *v = &g_array_index (vt->pts, GimpVector2, i);
+
+              x1 = MIN (x1, v->x); y1 = MIN (y1, v->y);
+              x2 = MAX (x2, v->x); y2 = MAX (y2, v->y);
+            }
+
+          r = MAX (screen_px (display, 12.0),
+                   hypot (x2 - x1, y2 - y1) / 2.0 + screen_px (display, 6.0));
+
+          if (chopgimp_vtransform_join (vt->layer, (x1 + x2) / 2, (y1 + y2) / 2, r))
+            gimp_image_flush (image);
+          else
+            gimp_tool_message_literal (tool, display,
+                                       _("Frottez par-dessus deux extrémités ouvertes "
+                                         "proches pour les relier."));
+        }
+      vpen_clear (vt);
+      break;
+
+    default:
+      break;
+    }
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (vt));
+}
+
+static gboolean
+gimp_vpen_tool_key_press (GimpTool    *tool,
+                          GdkEventKey *kevent,
+                          GimpDisplay *display)
+{
+  GimpVPenTool *vt = (GimpVPenTool *) tool;
+
+  if (KIND (tool) != VPEN_CURVATURE || display != tool->display || vt->pts->len == 0)
+    return FALSE;
+
+  switch (kevent->keyval)
+    {
+    case GDK_KEY_Return:
+    case GDK_KEY_KP_Enter:
+    case GDK_KEY_ISO_Enter:
+    case GDK_KEY_Escape:
+      gimp_draw_tool_pause (GIMP_DRAW_TOOL (vt));
+      curvature_commit (vt, display, FALSE);
+      gimp_draw_tool_resume (GIMP_DRAW_TOOL (vt));
+      return TRUE;
+
+    case GDK_KEY_BackSpace:
+    case GDK_KEY_Delete:
+      gimp_draw_tool_pause (GIMP_DRAW_TOOL (vt));
+      g_array_set_size (vt->pts, vt->pts->len - 1);
+      gimp_draw_tool_resume (GIMP_DRAW_TOOL (vt));
+      return TRUE;
+
+    default:
+      return FALSE;
+    }
+}
+
+static void
+gimp_vpen_tool_oper_update (GimpTool         *tool,
+                            const GimpCoords *coords,
+                            GdkModifierType   state,
+                            gboolean          proximity,
+                            GimpDisplay      *display)
+{
+  GimpVPenTool *vt = (GimpVPenTool *) tool;
+  const gchar  *msg = NULL;
+
+  vt->hover_x  = coords->x;
+  vt->hover_y  = coords->y;
+  vt->hovering = proximity;
+
+  switch (KIND (tool))
+    {
+    case VPEN_CURVATURE:
+      msg = vt->pts->len == 0
+            ? _("Cliquez pour poser les points : la courbe passe par tous (Alt : angle)")
+            : _("Clic : point suivant — double-clic sur un point : lisse ↔ angle — "
+                "clic sur le premier : fermer — Entrée : terminer — Retour arrière : "
+                "retirer le dernier");
+      break;
+    case VPEN_PENCIL:
+      msg = _("Dessinez à main levée — partir de la fin du tracé sélectionné le "
+              "prolonge, finir sur le départ le ferme");
+      break;
+    case VPEN_SMOOTH:
+      msg = _("Frottez les objets sélectionnés pour lisser leur tracé");
+      break;
+    case VPEN_SCISSORS:
+      msg = _("Clic sur un tracé : le couper à cet endroit");
+      break;
+    case VPEN_KNIFE:
+      msg = _("Glissez à travers les formes pour les trancher en morceaux");
+      break;
+    case VPEN_JOIN:
+      msg = _("Frottez par-dessus deux extrémités ouvertes pour les relier");
+      break;
+    }
+
+  if (proximity && msg)
+    gimp_tool_replace_status (tool, display, "%s", msg);
+
+  if (KIND (tool) == VPEN_CURVATURE || KIND (tool) == VPEN_SMOOTH)
+    chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (vt), display);
+}
+
+static void
+gimp_vpen_tool_draw (GimpDrawTool *dt)
+{
+  GimpVPenTool *vt   = (GimpVPenTool *) dt;
+  VPenKind      kind = KIND (dt);
+
+  if (! dt->display)
+    return;
+
+  switch (kind)
+    {
+    case VPEN_CURVATURE:
+      if (vt->pts->len > 0)
+        {
+          GimpImage *image = gimp_display_get_image (dt->display);
+          GArray    *tmp   = g_array_copy (vt->pts);
+          GimpStroke *st;
+
+          /*  the next point follows the pointer  */
+          if (vt->hovering && vt->drag < 0)
+            {
+              CPoint p = { vt->hover_x, vt->hover_y, FALSE };
+
+              g_array_append_val (tmp, p);
+            }
+
+          st = curvature_stroke ((CPoint *) tmp->data, tmp->len, FALSE);
+
+          if (st && image)
+            {
+              GimpPath *path = gimp_path_new (image, "preview");
+
+              g_object_ref_sink (path);
+              gimp_path_stroke_add (path, st);
+
+              if (gimp_path_get_bezier (path))
+                {
+                  GimpCanvasItem *item =
+                    gimp_canvas_path_new (gimp_display_get_shell (dt->display),
+                                          gimp_path_get_bezier (path), 0, 0, FALSE,
+                                          GIMP_PATH_STYLE_DEFAULT);
+
+                  gimp_draw_tool_add_item (dt, item);
+                  g_object_unref (item);
+                }
+
+              g_object_unref (path);
+            }
+
+          g_clear_object (&st);
+
+          for (guint i = 0; i < vt->pts->len; i++)
+            {
+              CPoint *p = &g_array_index (vt->pts, CPoint, i);
+
+              gimp_draw_tool_add_handle (dt,
+                                         p->corner ? GIMP_HANDLE_SQUARE : GIMP_HANDLE_CIRCLE,
+                                         p->x, p->y, 9, 9, GIMP_HANDLE_ANCHOR_CENTER);
+            }
+
+          g_array_unref (tmp);
+        }
+      break;
+
+    case VPEN_PENCIL:
+    case VPEN_KNIFE:
+    case VPEN_JOIN:
+      if (vt->pts->len > 1)
+        gimp_draw_tool_add_lines (dt, (GimpVector2 *) vt->pts->data, vt->pts->len,
+                                  NULL, FALSE);
+      break;
+
+    case VPEN_SMOOTH:
+      if (vt->hovering)
+        {
+          gdouble r = screen_px (dt->display, VPEN_OPTIONS (vt)->brush_radius);
+
+          gimp_draw_tool_add_arc (dt, FALSE, vt->hover_x - r, vt->hover_y - r,
+                                  2 * r, 2 * r, 0.0, 2 * G_PI);
+        }
+      break;
+
+    default:
+      break;
+    }
+}
+
+static void
+gimp_vpen_tool_control (GimpTool       *tool,
+                        GimpToolAction  action,
+                        GimpDisplay    *display)
+{
+  GimpVPenTool *vt = (GimpVPenTool *) tool;
+
+  if (action == GIMP_TOOL_ACTION_HALT || action == GIMP_TOOL_ACTION_COMMIT)
+    {
+      /*  Courbure: switching tools keeps the curve drawn so far  */
+      if (KIND (tool) == VPEN_CURVATURE && action == GIMP_TOOL_ACTION_COMMIT &&
+          tool->display && vt->pts->len >= 2)
+        curvature_commit (vt, tool->display, FALSE);
+
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+      vpen_clear (vt);
+      vpen_set_layer (vt, NULL);
+    }
+
+  GIMP_TOOL_CLASS (gimp_vpen_tool_parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_vpen_tool_finalize (GObject *object)
+{
+  GimpVPenTool *vt = (GimpVPenTool *) object;
+
+  vpen_set_layer (vt, NULL);
+  g_array_unref (vt->pts);
+
+  G_OBJECT_CLASS (gimp_vpen_tool_parent_class)->finalize (object);
+}
+
+static void
+gimp_vpen_tool_class_init (GimpVPenToolClass *klass)
+{
+  GObjectClass      *object_class    = G_OBJECT_CLASS (klass);
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  object_class->finalize     = gimp_vpen_tool_finalize;
+
+  tool_class->is_destructive = FALSE;
+  tool_class->control        = gimp_vpen_tool_control;
+  tool_class->button_press   = gimp_vpen_tool_button_press;
+  tool_class->motion         = gimp_vpen_tool_motion;
+  tool_class->button_release = gimp_vpen_tool_button_release;
+  tool_class->key_press      = gimp_vpen_tool_key_press;
+  tool_class->oper_update    = gimp_vpen_tool_oper_update;
+
+  draw_tool_class->draw      = gimp_vpen_tool_draw;
+}
+
+static void
+gimp_vpen_tool_init (GimpVPenTool *vt)
+{
+  GimpTool *tool = GIMP_TOOL (vt);
+
+  vt->drag = -1;
+
+  gimp_tool_control_set_motion_mode (tool->control, GIMP_MOTION_MODE_EXACT);
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_PATHS);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_MOUSE);
+}
+
+/*  @pts depends on the kind, which is only known once the instance is
+ *  of its final class: made in the subclass init
+ */
+#define VPEN_SUBCLASS(TypeName, type_name, KIND_VALUE, ELEM)                    \
+  typedef GimpVPenTool      TypeName;                                           \
+  typedef GimpVPenToolClass TypeName##Class;                                    \
+  static GType type_name##_get_type (void) G_GNUC_CONST;                        \
+  G_DEFINE_TYPE (TypeName, type_name, gimp_vpen_tool_get_type ())               \
+  static void type_name##_class_init (TypeName##Class *klass)                   \
+  {                                                                             \
+    klass->kind = KIND_VALUE;                                                   \
+  }                                                                             \
+  static void type_name##_init (TypeName *vt)                                   \
+  {                                                                             \
+    vt->pts = g_array_new (FALSE, TRUE, sizeof (ELEM));                         \
+  }
+
+VPEN_SUBCLASS (GimpCurvatureTool, gimp_curvature_tool, VPEN_CURVATURE, CPoint)
+VPEN_SUBCLASS (GimpVPencilTool,   gimp_vpencil_tool,   VPEN_PENCIL,    GimpVector2)
+VPEN_SUBCLASS (GimpVSmoothTool,   gimp_vsmooth_tool,   VPEN_SMOOTH,    GimpVector2)
+VPEN_SUBCLASS (GimpVScissorsTool, gimp_vscissors_tool, VPEN_SCISSORS,  GimpVector2)
+VPEN_SUBCLASS (GimpVKnifeTool,    gimp_vknife_tool,    VPEN_KNIFE,     GimpVector2)
+VPEN_SUBCLASS (GimpVJoinTool,     gimp_vjoin_tool,     VPEN_JOIN,      GimpVector2)
+
+
+/*  ─── registration ──────────────────────────────────────────────────── */
+
+void
+gimp_curvature_tool_register (GimpToolRegisterCallback  callback,
+                              gpointer                  data)
+{
+  (* callback) (gimp_curvature_tool_get_type (),
+                GIMP_TYPE_VPEN_OPTIONS,
