+                0,
+                "gimp-vpencil-tool",
+                _("Crayon vectoriel"),
+                _("Crayon vectoriel : un tracé à main levée devient des courbes "
+                  "(Fidélité), qu'on peut prolonger"),
+                N_("Crayon _vectoriel"), NULL,
+                NULL, GIMP_HELP_TOOL_PATH,
+                "chopgimp-tool-vpencil",
+                data);
+}
+
+void
+gimp_vsmooth_tool_register (GimpToolRegisterCallback  callback,
+                            gpointer                  data)
+{
+  (* callback) (gimp_vsmooth_tool_get_type (),
+                GIMP_TYPE_VPEN_OPTIONS,
+                gimp_tool_options_empty_gui,
+                0,
+                "gimp-vsmooth-tool",
+                _("Lissage"),
+                _("Lissage : frotter les objets sélectionnés lisse leur tracé"),
+                N_("_Lissage"), NULL,
+                NULL, GIMP_HELP_TOOL_PATH,
+                "chopgimp-tool-vsmooth",
+                data);
+}
+
+void
+gimp_vscissors_tool_register (GimpToolRegisterCallback  callback,
+                              gpointer                  data)
+{
+  (* callback) (gimp_vscissors_tool_get_type (),
+                GIMP_TYPE_VPEN_OPTIONS,
