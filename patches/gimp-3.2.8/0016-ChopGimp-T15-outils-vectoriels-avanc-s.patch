+                _("Courbure"),
+                _("Courbure : posez des points, la courbe passe par tous en douceur "
+                  "(Alt : angle, double-clic : lisse ↔ angle)"),
+                N_("_Courbure"), NULL,
+                NULL, GIMP_HELP_TOOL_PATH,
+                "chopgimp-tool-curvature",
+                data);
+}
+
+void
+gimp_vpencil_tool_register (GimpToolRegisterCallback  callback,
