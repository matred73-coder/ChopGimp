+
+#pragma once
+
+typedef enum
+{
+  CHOPGIMP_DISTORT_DIALOG_WARP,
+  CHOPGIMP_DISTORT_DIALOG_MESH
+} ChopGimpDistortDialogKind;
+
+/*  modal; TRUE when the distortion was applied (one undo step)  */
+gboolean   chopgimp_distort_dialog_show (GimpImage                 *image,
