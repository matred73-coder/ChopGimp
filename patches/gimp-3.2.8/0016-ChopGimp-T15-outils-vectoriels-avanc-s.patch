+
+/*  ─── picking ───────────────────────────────────────────────────────── */
+
+static ChopGimpVObject *
+lp_pick (GimpLivePaintTool *lp,
+         GimpDisplay       *display,
+         const GimpCoords  *coords,
+         gboolean           edge_first,
+         gboolean          *is_edge)
+{
+  GimpImage        *image = gimp_display_get_image (display);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           tol   = TOL_PX / MAX (1e-6, shell->scale_x);
+  ChopGimpVObject  *o     = NULL;
+
+  lp->layer = image ? chopgimp_vobjects_get_target_layer (image) : NULL;
+
+  if (! lp->layer)
+    return NULL;
+
+  *is_edge = FALSE;
+
+  if (edge_first)
+    {
+      o = chopgimp_vlivepaint_pick (lp->layer, coords->x, coords->y, TRUE, tol);
+      *is_edge = (o != NULL);
+    }
+
+  if (! o)
+    o = chopgimp_vlivepaint_pick (lp->layer, coords->x, coords->y, FALSE, tol);
+
+  return o;
+}
+
+static void
+gimp_live_paint_tool_oper_update (GimpTool         *tool,
+                                  const GimpCoords *coords,
+                                  GdkModifierType   state,
+                                  gboolean          proximity,
+                                  GimpDisplay      *display)
+{
+  GimpLivePaintTool *lp   = (GimpLivePaintTool *) tool;
+  gboolean           edge = FALSE;
+  ChopGimpVObject   *o    = NULL;
+
+  if (proximity)
+    o = lp_pick (lp, display, coords,
+                 lp->select || (state & gimp_get_extend_selection_mask ()), &edge);
+
+  lp->hover      = o ? o->id : 0;
+  lp->hover_edge = edge;
+
+  if (! lp->layer)
+    gimp_tool_replace_status (tool, display,
+                              _("Sélectionnez un calque vectoriel avec un groupe de "
+                                "peinture dynamique (Vecteur > Peinture dynamique > Créer)"));
+  else if (! o)
+    gimp_tool_replace_status (tool, display,
+                              chopgimp_vlivepaint_can_make (lp->layer)
+                              ? _("Pas de peinture dynamique ici : Vecteur > Peinture "
+                                  "dynamique > Créer (Ctrl+Maj+Alt+X) sur les objets "
+                                  "sélectionnés")
+                              : _("Survolez une zone d'un groupe de peinture dynamique"));
+  else if (lp->select)
+    gimp_tool_replace_status (tool, display,
+                              edge ? _("Clic : sélectionner ce segment, Maj+clic : ajouter, "
+                                       "double-clic : les segments voisins de même couleur")
+                                   : _("Clic : sélectionner cette zone, Maj+clic : ajouter, "
+                                       "double-clic : les zones voisines de même couleur"));
+  else
+    gimp_tool_replace_status (tool, display,
+                              edge ? _("Clic : peindre ce segment (couleur de premier plan)")
+                                   : _("Clic : remplir cette zone — Maj : segment, "
+                                       "Alt : prendre sa couleur"));
+
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (lp), display);
+}
+
+/*  3.28.2: double-click of the Live Paint Selection: the regions (or
+ *  segments) of the same color connected to @start, as Illustrator
+ */
+static gboolean
+lp_same_color (ChopGimpVObject *a,
+               ChopGimpVObject *b,
+               gboolean         edge)
+{
+  ChopGimpVEntry *ea = edge ? chopgimp_vstyle_get_stroke (&a->style) : chopgimp_vstyle_get_fill (&a->style);
+  ChopGimpVEntry *eb = edge ? chopgimp_vstyle_get_stroke (&b->style) : chopgimp_vstyle_get_fill (&b->style);
+  GeglColor      *ca = ea ? chopgimp_vpaint_get_main_color (&ea->paint) : NULL;
+  GeglColor      *cb = eb ? chopgimp_vpaint_get_main_color (&eb->paint) : NULL;
+  gdouble         x[4], y[4];
+
+  if (! ca || ! cb)
+    return ca == cb;   /* both unpainted */
+
+  gegl_color_get_rgba (ca, &x[0], &x[1], &x[2], &x[3]);
+  gegl_color_get_rgba (cb, &y[0], &y[1], &y[2], &y[3]);
+
+  for (gint i = 0; i < 4; i++)
+    if (fabs (x[i] - y[i]) > 1.0 / 255.0)
+      return FALSE;
+
+  return TRUE;
+}
+
+/*  some point of @a lies on the outline of @b (within 1.5 px)  */
+static gboolean
+lp_touch (GimpPath *a,
+          GimpPath *b)
+{
+  const GimpBezierDesc *db = gimp_path_get_bezier (b);
+  cairo_surface_t      *sf;
+  cairo_t              *cr;
+  gboolean              hit = FALSE;
+
+  if (! db)
+    return FALSE;
+
+  sf = cairo_image_surface_create (CAIRO_FORMAT_A8, 1, 1);
+  cr = cairo_create (sf);
+  cairo_append_path (cr, (const cairo_path_t *) db);
+  cairo_set_line_width (cr, 3.0);
+
+  for (GimpStroke *s = gimp_path_stroke_get_next (a, NULL); s && ! hit;
+       s = gimp_path_stroke_get_next (a, s))
+    {
+      gboolean closed;
+      GArray  *pts = gimp_stroke_interpolate (s, 1.0, &closed);
+
+      for (guint i = 0; pts && i < pts->len && ! hit; i++)
+        {
+          GimpCoords *c = &g_array_index (pts, GimpCoords, i);
+
+          hit = cairo_in_stroke (cr, c->x, c->y);
+        }
+
+      if (pts)
+        g_array_free (pts, TRUE);
+    }
+
+  cairo_destroy (cr);
+  cairo_surface_destroy (sf);
+
+  return hit;
+}
+
+static void
+lp_select_connected (GimpVectorLayer *layer,
+                     ChopGimpVObject *start)
+{
+  ChopGimpVObject      *group = chopgimp_vlivepaint_group_of (start);
+  ChopGimpLivePaintRole role  = chopgimp_vlivepaint_role (start);
+  gboolean              edge  = (role == CHOPGIMP_LIVEPAINT_EDGE);
+  GPtrArray            *cand, *paths;
+  GArray               *ids;
+  gboolean             *in;
+
+  if (! group || (role != CHOPGIMP_LIVEPAINT_FACE && role != CHOPGIMP_LIVEPAINT_EDGE))
+    return;
+
+  cand  = g_ptr_array_new ();
+  paths = g_ptr_array_new_with_free_func (g_object_unref);
+
+  for (guint i = 0; i < group->children->len; i++)
+    {
+      ChopGimpVObject *o = g_ptr_array_index (group->children, i);
+      GimpPath        *wp;
+
+      if (chopgimp_vlivepaint_role (o) != role || ! lp_same_color (o, start, edge))
+        continue;
+
+      wp = chopgimp_vobject_get_world_path (layer, o, FALSE);
+      if (! wp)
+        continue;
+
+      g_object_ref_sink (wp);
+      g_ptr_array_add (cand, o);
+      g_ptr_array_add (paths, wp);
+    }
+
+  in  = g_new0 (gboolean, cand->len);
+  ids = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  for (guint i = 0; i < cand->len; i++)
+    if (cand->pdata[i] == start)
+      {
+        in[i] = TRUE;
+        g_array_append_val (ids, start->id);
+      }
+
+  /*  breadth first: touching regions (a shared edge) / segments (a
+   *  shared end)
+   */
+  for (guint q = 0; q < ids->len; q++)
+    {
+      guint k;
+
+      for (k = 0; k < cand->len; k++)
+        if (((ChopGimpVObject *) cand->pdata[k])->id == g_array_index (ids, guint, q))
+          break;
+
+      for (guint j = 0; k < cand->len && j < cand->len; j++)
+        if (! in[j] && lp_touch (paths->pdata[j], paths->pdata[k]))
+          {
+            in[j] = TRUE;
+            g_array_append_val (ids, ((ChopGimpVObject *) cand->pdata[j])->id);
+          }
+    }
+
+  chopgimp_vlayer_set_selection (layer, (guint *) ids->data, ids->len);
+
+  g_array_free (ids, TRUE);
+  g_free (in);
+  g_ptr_array_free (paths, TRUE);
+  g_ptr_array_free (cand, TRUE);
+}
+
+static void
+gimp_live_paint_tool_button_press (GimpTool            *tool,
+                                   const GimpCoords    *coords,
+                                   guint32              time,
+                                   GdkModifierType      state,
+                                   GimpButtonPressType  press_type,
+                                   GimpDisplay         *display)
+{
+  GimpLivePaintTool *lp      = (GimpLivePaintTool *) tool;
+  GimpImage         *image   = gimp_display_get_image (display);
+  GimpContext       *context = gimp_get_user_context (image->gimp);
+  gboolean           shift   = (state & gimp_get_extend_selection_mask ()) != 0;
+  gboolean           alt     = (state & GDK_MOD1_MASK) != 0;
+  gboolean           edge    = FALSE;
+  ChopGimpVObject   *o;
+
+  if (! image)
+    return;
+
+  /*  3.28.2: double-click in Live Paint Selection  */
+  if (press_type == GIMP_BUTTON_PRESS_DOUBLE && lp->select && lp->layer)
+    {
+      o = lp_pick (lp, display, coords, TRUE, &edge);
+
+      if (o)
+        {
+          lp_select_connected (lp->layer, o);
+          gimp_image_flush (image);
+          chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (lp), display);
+        }
+      return;
+    }
+
+  if (press_type != GIMP_BUTTON_PRESS_NORMAL)
+    return;
+
+  o = lp_pick (lp, display, coords, lp->select || shift, &edge);
+
+  if (lp->select)
+    {
+      if (! lp->layer)
+        return;
+
+      if (o)
+        {
+          if (shift && chopgimp_vlayer_is_selected (lp->layer, o->id))
+            chopgimp_vlayer_deselect (lp->layer, o->id);
+          else
+            chopgimp_vlayer_select (lp->layer, o->id, shift);
+        }
+      else if (! shift)
+        {
+          chopgimp_vlayer_set_selection (lp->layer, NULL, 0);
+        }
+
+      gimp_image_flush (image);
+    }
+  else if (o)
+    {
+      if (alt)
+        {
+          ChopGimpVEntry *e = edge ? chopgimp_vstyle_get_stroke (&o->style)
+                                   : chopgimp_vstyle_get_fill (&o->style);
+          GeglColor      *c = e ? chopgimp_vpaint_get_main_color (&e->paint) : NULL;
+
+          if (c)
+            gimp_context_set_foreground (context, c);
+        }
+      else
+        {
+          chopgimp_vlivepaint_paint (lp->layer, o,
+                                     gimp_context_get_foreground (context), edge);
+          gimp_image_flush (image);
+        }
+    }
+
+  tool->display = display;
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (lp), display);
+}
+
+static void
+lp_add_outline (GimpDrawTool    *dt,
+                GimpVectorLayer *layer,
+                ChopGimpVObject *o,
+                gboolean         highlight)
+{
+  GimpDisplayShell *shell = gimp_display_get_shell (dt->display);
+  GimpPath         *wp    = chopgimp_vobject_get_world_path (layer, o, FALSE);
+  GimpCanvasItem   *item;
+
+  if (! wp)
+    return;
+
+  g_object_ref_sink (wp);
+
+  if (gimp_path_get_bezier (wp))
+    {
+      item = gimp_canvas_path_new (shell, gimp_path_get_bezier (wp), 0, 0,
+                                   FALSE, GIMP_PATH_STYLE_DEFAULT);
+      gimp_canvas_item_set_highlight (item, highlight);
+
+      /*  3.28.2: the hovered region / segment in red, as Illustrator  */
+      if (highlight)
+        {
+          static const gdouble red[3] = { 0.93, 0.11, 0.14 };
+
+          g_object_set_data (G_OBJECT (item), "chopgimp-rgb", (gpointer) red);
+        }
+
+      gimp_draw_tool_add_item (dt, item);
+      g_object_unref (item);
+    }
+
+  g_object_unref (wp);
+}
+
+static void
+gimp_live_paint_tool_draw (GimpDrawTool *dt)
+{
+  GimpLivePaintTool *lp = (GimpLivePaintTool *) dt;
+  ChopGimpVObject   *o;
+
+  if (! lp->layer || ! gimp_item_is_attached (GIMP_ITEM (lp->layer)))
+    return;
+
+  if (lp->select)
+    {
+      GList *sel = chopgimp_vlayer_get_selected_objects (lp->layer);
+
+      for (GList *l = sel; l; l = l->next)
+        {
+          ChopGimpLivePaintRole role = chopgimp_vlivepaint_role (l->data);
+
+          if (role == CHOPGIMP_LIVEPAINT_FACE || role == CHOPGIMP_LIVEPAINT_EDGE)
+            lp_add_outline (dt, lp->layer, l->data, FALSE);
+        }
+
+      g_list_free (sel);
+    }
+
+  if (lp->hover && (o = chopgimp_vlayer_get_object (lp->layer, lp->hover)))
+    lp_add_outline (dt, lp->layer, o, TRUE);
+}
+
+static void
+gimp_live_paint_tool_control (GimpTool       *tool,
+                              GimpToolAction  action,
+                              GimpDisplay    *display)
+{
+  GimpLivePaintTool *lp = (GimpLivePaintTool *) tool;
+
+  if (action == GIMP_TOOL_ACTION_HALT || action == GIMP_TOOL_ACTION_COMMIT)
+    {
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+      lp->layer = NULL;
+      lp->hover = 0;
+    }
+
+  GIMP_TOOL_CLASS (gimp_live_paint_tool_parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_live_paint_tool_class_init (GimpLivePaintToolClass *klass)
+{
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  tool_class->is_destructive = FALSE;
+
+  tool_class->control        = gimp_live_paint_tool_control;
+  tool_class->oper_update    = gimp_live_paint_tool_oper_update;
+  tool_class->button_press   = gimp_live_paint_tool_button_press;
+
+  draw_tool_class->draw      = gimp_live_paint_tool_draw;
+}
+
+static void
+gimp_live_paint_tool_init (GimpLivePaintTool *lp)
+{
+  GimpTool *tool = GIMP_TOOL (lp);
+
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_BUCKET_FILL);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_MOUSE);
+}
+
+static void
+gimp_live_paint_select_tool_class_init (GimpLivePaintSelectToolClass *klass)
+{
+}
