+/*  ChopGimp 3.28.2: a long-lived undo group (the « Style de calque »
+ *  window) is closed before an undo step made elsewhere (a menu command,
+ *  a panel…), so that step stays separate
+ */
+typedef struct
+{
+  ChopGimpUndoGuardFunc  interrupt;
+  gpointer               data;
+  gint                   busy;
+} ChopGimpUndoGuard;
+
+void
+chopgimp_image_undo_guard_set (GimpImage             *image,
+                               ChopGimpUndoGuardFunc  interrupt,
+                               gpointer               data)
+{
+  ChopGimpUndoGuard *g = NULL;
+
+  g_return_if_fail (GIMP_IS_IMAGE (image));
+
+  if (interrupt)
+    {
+      g = g_new0 (ChopGimpUndoGuard, 1);
+      g->interrupt = interrupt;
+      g->data      = data;
+    }
+
+  g_object_set_data_full (G_OBJECT (image), "chopgimp-undo-guard", g, g_free);
+}
+
+void
+chopgimp_image_undo_guard_busy (GimpImage *image,
+                                gboolean   busy)
+{
+  ChopGimpUndoGuard *g;
+
+  if (! GIMP_IS_IMAGE (image))
+    return;
+
+  g = g_object_get_data (G_OBJECT (image), "chopgimp-undo-guard");
+
+  if (g)
+    g->busy = MAX (0, g->busy + (busy ? 1 : -1));
+}
+
+static void
+chopgimp_image_undo_guard_check (GimpImage *image)
+{
+  ChopGimpUndoGuard *g = g_object_get_data (G_OBJECT (image), "chopgimp-undo-guard");
+
+  if (g && g->busy == 0 && GIMP_IMAGE_GET_PRIVATE (image)->group_count == 1)
+    {
+      ChopGimpUndoGuardFunc f = g->interrupt;
+      gpointer              d = g->data;
+
+      g_object_set_data (G_OBJECT (image), "chopgimp-undo-guard", NULL);
+      f (image, d);
+    }
+}
+
 gboolean
 gimp_image_undo_group_start (GimpImage    *image,
                              GimpUndoType  undo_type,
@@ -285,6 +345,8 @@ gimp_image_undo_group_start (GimpImage    *image,
 
   private = GIMP_IMAGE_GET_PRIVATE (image);
 
+  chopgimp_image_undo_guard_check (image);   /* ChopGimp 3.28.2 */
+
   if (! name)
     name = gimp_undo_type_to_name (undo_type);
 
@@ -372,6 +434,8 @@ gimp_image_undo_push (GimpImage     *image,
 
