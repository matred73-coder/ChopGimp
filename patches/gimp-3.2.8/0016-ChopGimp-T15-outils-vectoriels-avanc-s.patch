@@ -0,0 +1,976 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vdistort.c — ChopGimp 3.27.6: « Objet > Distorsion »
+ * (see chopgimp-vdistort.h)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <cairo.h>
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+
+#include "path-types.h"
+
+#include "core/gimpbezierdesc.h"
+#include "core/gimpimage.h"
+
+#include "gimppath.h"
+#include "gimpvectorlayer.h"
+#include "chopgimp-geom.h"
+#include "chopgimp-vobject.h"
+#include "chopgimp-vobject-ops.h"
+#include "chopgimp-vdistort.h"
+
+#include "gimp-intl.h"
+
+
+static const struct
+{
+  const gchar *name;
+  const gchar *label;
+}
+warp_styles[] =
+{
+  { "arc",         N_("Arc")                 },
+  { "arc-lower",   N_("Arc inférieur")       },
+  { "arc-upper",   N_("Arc supérieur")       },
+  { "arch",        N_("Arche")               },
+  { "bulge",       N_("Renflement")          },
+  { "shell-lower", N_("Coquillage inférieur") },
+  { "shell-upper", N_("Coquillage supérieur") },
+  { "flag",        N_("Drapeau")             },
+  { "wave",        N_("Onde")                },
+  { "fish",        N_("Poisson")             },
+  { "rise",        N_("Montée")              },
+  { "fisheye",     N_("Œil de poisson")      },
+  { "inflate",     N_("Gonflement")          },
+  { "squeeze",     N_("Compression")         },
+  { "twist",       N_("Torsion")             }
+};
+
+const gchar * const *
+chopgimp_vdistort_get_styles (void)
+{
+  static const gchar *names[G_N_ELEMENTS (warp_styles) + 1] = { NULL, };
+
+  if (! names[0])
+    for (guint i = 0; i < G_N_ELEMENTS (warp_styles); i++)
+      names[i] = warp_styles[i].name;
+
+  return names;
+}
+
+const gchar *
+chopgimp_vdistort_get_style_label (const gchar *style)
+{
+  for (guint i = 0; i < G_N_ELEMENTS (warp_styles); i++)
+    if (! g_strcmp0 (style, warp_styles[i].name))
+      return _(warp_styles[i].label);
+
+  return _(warp_styles[0].label);
+}
+
+void
+chopgimp_vdistort_init (ChopGimpDistort *d)
+{
+  memset (d, 0, sizeof (*d));
+  d->mode  = CHOPGIMP_DISTORT_NONE;
+  d->style = g_strdup ("arc");
+  d->bend  = 50.0;
+  d->rows  = 1;
+  d->cols  = 1;
+}
+
+void
+chopgimp_vdistort_clear (ChopGimpDistort *d)
+{
+  g_clear_pointer (&d->style, g_free);
+  g_clear_pointer (&d->mesh, g_free);
+}
+
+static gint
+mesh_n (const ChopGimpDistort *d)
+{
+  return (d->rows + 1) * (d->cols + 1) * 2;
+}
+
+void
+chopgimp_vdistort_copy (ChopGimpDistort       *dest,
+                        const ChopGimpDistort *src)
+{
+  chopgimp_vdistort_clear (dest);
+
+  *dest       = *src;
+  dest->style = g_strdup (src->style);
+  dest->mesh  = src->mesh ? g_memdup2 (src->mesh, sizeof (gdouble) * mesh_n (src)) : NULL;
+}
+
+static void
+put (GString *s,
+     gdouble  v)
+{
+  gchar buf[G_ASCII_DTOSTR_BUF_SIZE];
+
+  g_string_append (s, g_ascii_formatd (buf, sizeof (buf), "%.6g", v));
+}
+
+/*  the key file of an lpe spec, and the group holding the distortion  */
+static GKeyFile *
+spec_load (const gchar  *spec,
+           gchar       **distort_group,
+           gint         *max_group)
+{
+  GKeyFile *kf = g_key_file_new ();
+  gchar   **groups;
+
+  if (distort_group)
+    *distort_group = NULL;
+  if (max_group)
+    *max_group = -1;
+
+  if (! spec || ! *spec ||
+      ! g_key_file_load_from_data (kf, spec, -1, G_KEY_FILE_NONE, NULL))
+    return kf;
+
+  groups = g_key_file_get_groups (kf, NULL);
+
+  for (gchar **g = groups; g && *g; g++)
+    {
+      gchar *type = g_key_file_get_string (kf, *g, "type", NULL);
+
+      if (max_group)
+        *max_group = MAX (*max_group, atoi (*g));
+
+      if (distort_group && ! g_strcmp0 (type, "distort") && ! *distort_group)
+        *distort_group = g_strdup (*g);
+
+      g_free (type);
+    }
+
+  g_strfreev (groups);
+
+  return kf;
+}
+
+static gdouble
+key_num (GKeyFile    *kf,
+         const gchar *group,
+         const gchar *key,
+         gdouble      fallback)
+{
+  gchar  *v = g_key_file_get_value (kf, group, key, NULL);
+  gdouble d = v ? g_ascii_strtod (v, NULL) : fallback;
+
+  g_free (v);
+
+  return d;
+}
+
+gboolean
+chopgimp_vdistort_get (ChopGimpVObject *object,
+                       ChopGimpDistort *d)
+{
+  GKeyFile *kf;
+  gchar    *g = NULL;
+  gchar    *mode;
+  gchar    *v;
+
+  if (! object || object->kind != CHOPGIMP_VOBJECT_PATH || ! object->lpe)
+    return FALSE;
+
+  kf = spec_load (object->lpe, &g, NULL);
+
+  if (! g)
+    {
+      g_key_file_free (kf);
+      return FALSE;
+    }
+
+  mode = g_key_file_get_string (kf, g, "mode", NULL);
+
+  if (! g_strcmp0 (mode, "mesh"))
+    d->mode = CHOPGIMP_DISTORT_MESH;
+  else if (! g_strcmp0 (mode, "free"))
+    d->mode = CHOPGIMP_DISTORT_FREE;
+  else
+    d->mode = CHOPGIMP_DISTORT_WARP;
+
+  g_free (mode);
+
+  if ((v = g_key_file_get_string (kf, g, "style", NULL)))
+    {
+      g_free (d->style);
+      d->style = v;
+    }
+
+  d->bend     = key_num (kf, g, "bend", 50);
+  d->hdist    = key_num (kf, g, "hdist", 0);
+  d->vdist    = key_num (kf, g, "vdist", 0);
+  d->vertical = key_num (kf, g, "vertical", 0) > 0.5;
+  d->rows     = d->mode == CHOPGIMP_DISTORT_MESH ? CLAMP ((gint) key_num (kf, g, "rows", 1), 1, 20) : 1;
+  d->cols     = d->mode == CHOPGIMP_DISTORT_MESH ? CLAMP ((gint) key_num (kf, g, "cols", 1), 1, 20) : 1;
+
+  g_clear_pointer (&d->mesh, g_free);
+  d->mesh = g_new0 (gdouble, mesh_n (d));
+
+  if ((v = g_key_file_get_string (kf, g, "mesh", NULL)))
+    {
+      gchar **items = g_strsplit (v, ";", -1);
+
+      for (gint k = 0; items[k] && k < mesh_n (d) / 2; k++)
+        {
+          gchar *comma = strchr (items[k], ',');
+
+          d->mesh[2 * k]     = g_ascii_strtod (items[k], NULL);
+          d->mesh[2 * k + 1] = comma ? g_ascii_strtod (comma + 1, NULL) : 0.0;
+        }
+
+      g_strfreev (items);
+      g_free (v);
+    }
+
+  if ((v = g_key_file_get_string (kf, g, "box", NULL)))
+    {
+      gchar **b = g_strsplit (v, ",", -1);
+
+      if (g_strv_length (b) == 4)
+        for (gint i = 0; i < 4; i++)
+          d->box[i] = g_ascii_strtod (b[i], NULL);
+
+      g_strfreev (b);
+      g_free (v);
+    }
+  else
+    {
+      chopgimp_vdistort_local_box (object, d->box);
+    }
+
+  g_free (g);
+  g_key_file_free (kf);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vdistort_has (ChopGimpVObject *object)
+{
+  gchar    *g = NULL;
+  GKeyFile *kf;
+
+  if (! object || ! object->lpe || ! strstr (object->lpe, "distort"))
+    return FALSE;
+
+  kf = spec_load (object->lpe, &g, NULL);
+  g_key_file_free (kf);
+  g_free (g);
+
+  return g != NULL;
+}
+
+/*  @spec with its distortion replaced by @d (NULL: removed); g_free  */
+static gchar *
+spec_with (const gchar           *spec,
+           const ChopGimpDistort *d)
+{
+  gchar    *g = NULL;
+  gint      max;
+  GKeyFile *kf = spec_load (spec, &g, &max);
+  gchar    *out;
+
+  if (g)
+    g_key_file_remove_group (kf, g, NULL);
+
+  if (d && d->mode != CHOPGIMP_DISTORT_NONE)
+    {
+      gchar   *group = g_strdup_printf ("%d", max + 1);
+      GString *s     = g_string_new (NULL);
+
+      g_key_file_set_string (kf, group, "type", "distort");
+      g_key_file_set_string (kf, group, "mode",
+                             d->mode == CHOPGIMP_DISTORT_MESH ? "mesh" :
+                             d->mode == CHOPGIMP_DISTORT_FREE ? "free" : "warp");
+
+      if (d->mode == CHOPGIMP_DISTORT_WARP)
+        {
+          g_key_file_set_string (kf, group, "style", d->style ? d->style : "arc");
+          g_string_truncate (s, 0); put (s, d->bend);
+          g_key_file_set_value (kf, group, "bend", s->str);
+          g_string_truncate (s, 0); put (s, d->hdist);
+          g_key_file_set_value (kf, group, "hdist", s->str);
+          g_string_truncate (s, 0); put (s, d->vdist);
+          g_key_file_set_value (kf, group, "vdist", s->str);
+          g_key_file_set_value (kf, group, "vertical", d->vertical ? "1" : "0");
+        }
+      else
+        {
+          g_key_file_set_integer (kf, group, "rows", d->rows);
+          g_key_file_set_integer (kf, group, "cols", d->cols);
+
+          g_string_truncate (s, 0);
+          for (gint k = 0; d->mesh && k < mesh_n (d) / 2; k++)
+            {
+              if (k)
+                g_string_append_c (s, ';');
+              put (s, d->mesh[2 * k]);
+              g_string_append_c (s, ',');
+              put (s, d->mesh[2 * k + 1]);
+            }
+          g_key_file_set_value (kf, group, "mesh", s->str);
+        }
+
+      if (d->box[2] > 0 && d->box[3] > 0)
+        {
+          g_string_truncate (s, 0);
+          for (gint i = 0; i < 4; i++)
+            {
+              if (i)
+                g_string_append_c (s, ',');
+              put (s, d->box[i]);
+            }
+          g_key_file_set_value (kf, group, "box", s->str);
+        }
+
+      g_string_free (s, TRUE);
+      g_free (group);
+    }
+
+  out = g_key_file_to_data (kf, NULL, NULL);
+
+  g_key_file_free (kf);
+  g_free (g);
+
+  /*  nothing left  */
+  if (out && ! strchr (out, '['))
+    g_clear_pointer (&out, g_free);
+
+  return out;
+}
+
+void
+chopgimp_vdistort_set (GimpVectorLayer       *layer,
+                       guint                  id,
+                       const ChopGimpDistort *d,
+                       gboolean               push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+  gchar           *spec;
+
+  if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+    return;
+
+  spec = spec_with (o->lpe, d);
+  chopgimp_vlayer_set_lpe (layer, id, spec, push_undo);
+  g_free (spec);
+}
+
+gboolean
+chopgimp_vdistort_local_box (ChopGimpVObject *object,
+                             gdouble          box[4])
+{
+  const GimpBezierDesc *desc;
+  cairo_surface_t      *surface;
+  cairo_t              *cr;
+  gdouble               x1, y1, x2, y2;
+
+  if (! object || ! object->path)
+    return FALSE;
+
+  desc = gimp_path_get_bezier (object->path);
+
+  if (! desc || desc->num_data == 0)
+    return FALSE;
+
+  /*  the tight box of the curves (not of their control points)  */
+  surface = cairo_image_surface_create (CAIRO_FORMAT_A8, 1, 1);
+  cr      = cairo_create (surface);
+  cairo_append_path (cr, (const cairo_path_t *) desc);
+  cairo_path_extents (cr, &x1, &y1, &x2, &y2);
+  cairo_destroy (cr);
+  cairo_surface_destroy (surface);
+
+  if (x1 > x2 || y1 > y2)
+    return FALSE;
+
+  box[0] = x1;
+  box[1] = y1;
+  box[2] = MAX (x2 - x1, 1e-3);
+  box[3] = MAX (y2 - y1, 1e-3);
+
+  return TRUE;
+}
+
+
+/*  ─── on the selection ──────────────────────────────────────────────── */
+
+GList *
+chopgimp_vdistort_targets (GimpVectorLayer *layer)
+{
+  GList *objs   = chopgimp_vlayer_get_selected_objects (layer);
+  GList *leaves = NULL;
+
+  if (! objs)
+    return NULL;
+
+  for (GList *o = objs; o; o = o->next)
+    leaves = g_list_concat (leaves, chopgimp_vobjects_leaves_of (o->data));
+
+  g_list_free (objs);
+
+  for (GList *l = leaves; l; )
+    {
+      GList           *next = l->next;
+      ChopGimpVObject *o    = l->data;
+
+      if (chopgimp_vobject_is_locked (o) || ! o->path ||
+          gimp_path_get_n_strokes (o->path) == 0)
+        leaves = g_list_delete_link (leaves, l);
+
+      l = next;
+    }
+
+  return leaves;
+}
+
+gboolean
+chopgimp_vdistort_can_make (GimpVectorLayer *layer)
+{
+  GList   *t  = layer ? chopgimp_vdistort_targets (layer) : NULL;
+  gboolean ok = t != NULL;
+
+  g_list_free (t);
+
+  return ok;
+}
+
+gboolean
+chopgimp_vdistort_can_make_top (GimpVectorLayer *layer)
+{
+  GList   *t  = layer ? chopgimp_vdistort_targets (layer) : NULL;
+  gboolean ok = g_list_length (t) >= 2;
+
+  g_list_free (t);
+
+  return ok;
+}
+
+gboolean
+chopgimp_vdistort_any (GimpVectorLayer *layer)
+{
+  GList   *t  = layer ? chopgimp_vdistort_targets (layer) : NULL;
+  gboolean ok = FALSE;
+
+  for (GList *l = t; l && ! ok; l = l->next)
+    ok = chopgimp_vdistort_has (l->data);
+
+  g_list_free (t);
+
+  return ok;
+}
+
+/*  the world box of @objs (their paths, no stroke, no effect)  */
+static gboolean
+world_box (GList   *objs,
+           gdouble  box[4])
+{
+  gdouble x1 = G_MAXDOUBLE, y1 = G_MAXDOUBLE, x2 = -G_MAXDOUBLE, y2 = -G_MAXDOUBLE;
+
+  for (GList *l = objs; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      GimpMatrix3      m;
+      gdouble          b[4];
+
+      if (! chopgimp_vdistort_local_box (o, b))
+        continue;
+
+      chopgimp_vobject_get_world_matrix (o, &m);
+
+      for (gint c = 0; c < 4; c++)
+        {
+          gdouble x = b[0] + ((c & 1) ? b[2] : 0), y = b[1] + ((c & 2) ? b[3] : 0);
+          gdouble X, Y;
+
+          gimp_matrix3_transform_point (&m, x, y, &X, &Y);
+          x1 = MIN (x1, X); y1 = MIN (y1, Y);
+          x2 = MAX (x2, X); y2 = MAX (y2, Y);
+        }
+    }
+
+  if (x1 > x2)
+    return FALSE;
+
+  box[0] = x1; box[1] = y1;
+  box[2] = MAX (x2 - x1, 1e-3);
+  box[3] = MAX (y2 - y1, 1e-3);
+
+  return TRUE;
+}
+
+/*  @wbox (image) in the local space of @o (the box of its 4 corners)  */
+static void
+box_to_local (ChopGimpVObject *o,
+              const gdouble    wbox[4],
+              gdouble          lbox[4])
+{
+  GimpMatrix3 m;
+  gdouble     x1 = G_MAXDOUBLE, y1 = G_MAXDOUBLE, x2 = -G_MAXDOUBLE, y2 = -G_MAXDOUBLE;
+
+  chopgimp_vobject_get_world_matrix (o, &m);
+  gimp_matrix3_invert (&m);
+
+  for (gint c = 0; c < 4; c++)
+    {
+      gdouble X, Y;
+
+      gimp_matrix3_transform_point (&m,
+                                    wbox[0] + ((c & 1) ? wbox[2] : 0),
+                                    wbox[1] + ((c & 2) ? wbox[3] : 0), &X, &Y);
+      x1 = MIN (x1, X); y1 = MIN (y1, Y);
+      x2 = MAX (x2, X); y2 = MAX (y2, Y);
+    }
+
+  lbox[0] = x1; lbox[1] = y1;
+  lbox[2] = MAX (x2 - x1, 1e-3);
+  lbox[3] = MAX (y2 - y1, 1e-3);
+}
+
+gboolean
+chopgimp_vdistort_make (GimpVectorLayer       *layer,
+                        const ChopGimpDistort *d,
+                        const gchar           *desc)
+{
+  GList          *targets = chopgimp_vdistort_targets (layer);
+  gdouble         wbox[4];
+  ChopGimpDistort dd;
+  gboolean        pushed  = FALSE;
+
+  if (! targets)
+    return FALSE;
+
+  /*  3.28.2: several objects share one box in the image; a rotated or
+   *  sheared object would see it as a slanted box in its own space: its
+   *  transformation goes into its path first (same undo step; not for a
+   *  preview, whose state is restored from the effects only)
+   */
+  if (desc && targets->next)
+    for (GList *l = targets; l; l = l->next)
+      {
+        ChopGimpVObject *o = l->data;
+        GimpMatrix3      m, id;
+
+        chopgimp_vobject_get_world_matrix (o, &m);
+
+        if (o->kind == CHOPGIMP_VOBJECT_PATH &&
+            (fabs (m.coeff[0][1]) > 1e-9 || fabs (m.coeff[1][0]) > 1e-9))
+          {
+            if (! pushed)
+              chopgimp_vlayer_push_undo (layer, desc);
+            pushed = TRUE;
+
+            gimp_matrix3_identity (&id);
+            chopgimp_vlayer_transform (layer, &o->id, 1, &id, TRUE, FALSE);
+          }
+      }
+
+  if (! world_box (targets, wbox))
+    {
+      g_list_free (targets);
+      return pushed;
+    }
+
+  chopgimp_vdistort_init (&dd);
+  chopgimp_vdistort_copy (&dd, d);
+
+  if (dd.mode != CHOPGIMP_DISTORT_WARP && ! dd.mesh)
+    dd.mesh = g_new0 (gdouble, mesh_n (&dd));
+
+  /*  @desc NULL: a preview (no undo step)  */
+  if (desc && ! pushed)
+    chopgimp_vlayer_push_undo (layer, desc);
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = targets; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      /*  one object alone: its own box; several: the box of all  */
+      if (targets->next)
+        box_to_local (o, wbox, dd.box);
+      else
+        chopgimp_vdistort_local_box (o, dd.box);
+
+      chopgimp_vdistort_set (layer, o->id, &dd, FALSE);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  chopgimp_vdistort_clear (&dd);
+  g_list_free (targets);
+
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vdistort_make_top (GimpVectorLayer *layer,
+                            gint             rows,
+                            gint             cols)
+{
+  GList           *targets = chopgimp_vdistort_targets (layer);
+  GList           *leaves;
+  ChopGimpVObject *top     = NULL;
+  GimpPath        *shape;
+  gdouble          wbox[4], ebox[4];
+  gdouble         *gx, *gy;
+  gboolean         ok = FALSE;
+
+  if (g_list_length (targets) < 2)
+    {
+      g_list_free (targets);
+      return FALSE;
+    }
+
+  /*  the topmost of the targets: the last in the layer's order  */
+  leaves = chopgimp_vlayer_get_leaves (layer);
+  for (GList *l = leaves; l; l = l->next)
+    if (g_list_find (targets, l->data))
+      top = l->data;
+  g_list_free (leaves);
+
+  targets = g_list_remove (targets, top);
+
+  shape = chopgimp_vobject_get_world_path (layer, top, TRUE);
+  g_object_ref_sink (shape);
+
+  rows = CLAMP (rows, 1, 20);
+  cols = CLAMP (cols, 1, 20);
+
+  if (! world_box (targets, wbox) ||
+      ! chopgimp_vobject_get_bounds (layer, top, FALSE, &ebox[0], &ebox[1], &ebox[2], &ebox[3]))
+    {
+      g_object_unref (shape);
+      g_list_free (targets);
+      return FALSE;
+    }
+
+  /*  the envelope: for each column, the top and bottom of the shape  */
+  gx = g_new (gdouble, (rows + 1) * (cols + 1));
+  gy = g_new (gdouble, (rows + 1) * (cols + 1));
+
+  for (gint j = 0; j <= cols; j++)
+    {
+      gdouble x  = ebox[0] + (ebox[2] - ebox[0]) * j / cols;
+      gdouble xs = CLAMP (x, ebox[0] + 0.25, ebox[2] - 0.25);
+      gdouble t, b;
+
+      if (! chopgimp_geom_column_extent (shape, xs, &t, &b))
+        {
+          t = ebox[1];
+          b = ebox[3];
+        }
+
+      for (gint i = 0; i <= rows; i++)
+        {
+          gx[i * (cols + 1) + j] = x;
+          gy[i * (cols + 1) + j] = t + (b - t) * i / rows;
+        }
+    }
+
+  chopgimp_vlayer_push_undo (layer, _("Enveloppe d'après l'objet du dessus"));
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = targets; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      ChopGimpDistort  dd;
+      GimpMatrix3      inv;
+
+      chopgimp_vdistort_init (&dd);
+      dd.mode = CHOPGIMP_DISTORT_MESH;
+      dd.rows = rows;
+      dd.cols = cols;
+      dd.mesh = g_new0 (gdouble, mesh_n (&dd));
+
+      box_to_local (o, wbox, dd.box);
+
+      chopgimp_vobject_get_world_matrix (o, &inv);
+      gimp_matrix3_invert (&inv);
+
+      for (gint i = 0; i <= rows; i++)
+        for (gint j = 0; j <= cols; j++)
+          {
+            gint    k = i * (cols + 1) + j;
+            gdouble X, Y;
+
+            gimp_matrix3_transform_point (&inv, gx[k], gy[k], &X, &Y);
+
+            dd.mesh[2 * k]     = (X - dd.box[0]) / dd.box[2] - (gdouble) j / cols;
+            dd.mesh[2 * k + 1] = (Y - dd.box[1]) / dd.box[3] - (gdouble) i / rows;
+          }
+
+      chopgimp_vdistort_set (layer, o->id, &dd, FALSE);
+      chopgimp_vdistort_clear (&dd);
+      ok = TRUE;
+    }
+
+  /*  the envelope shape is used up, as in Illustrator  */
+  chopgimp_vlayer_remove (layer, top->id, FALSE);
+
+  {
+    GArray *ids = g_array_new (FALSE, FALSE, sizeof (guint));
+
+    for (GList *l = targets; l; l = l->next)
+      g_array_append_val (ids, ((ChopGimpVObject *) l->data)->id);
+
+    chopgimp_vlayer_set_selection (layer, (guint *) ids->data, ids->len);
+    g_array_free (ids, TRUE);
+  }
+
+  chopgimp_vlayer_thaw (layer);
+
+  g_free (gx);
+  g_free (gy);
+  g_object_unref (shape);
+  g_list_free (targets);
+
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+
+  return ok;
+}
+
+/*  3.28.2: the spec of the distortion alone (group « 0 »), or NULL  */
+static gchar *
+spec_distort_only (const gchar *spec)
+{
+  gchar    *g   = NULL;
+  GKeyFile *kf  = spec_load (spec, &g, NULL);
+  GKeyFile *out = NULL;
+  gchar   **keys;
+  gchar    *data = NULL;
+
+  if (g && (keys = g_key_file_get_keys (kf, g, NULL, NULL)))
+    {
+      out = g_key_file_new ();
+
+      for (gchar **k = keys; *k; k++)
+        {
+          gchar *v = g_key_file_get_value (kf, g, *k, NULL);
+
+          g_key_file_set_value (out, "0", *k, v);
+          g_free (v);
+        }
+
+      g_strfreev (keys);
+      data = g_key_file_to_data (out, NULL, NULL);
+      g_key_file_free (out);
+    }
+
+  g_key_file_free (kf);
+  g_free (g);
+
+  return data;
+}
+
+gboolean
+chopgimp_vdistort_expand (GimpVectorLayer *layer)
+{
+  GList   *targets = chopgimp_vdistort_targets (layer);
+  gboolean any     = FALSE;
+
+  for (GList *l = targets; l && ! any; l = l->next)
+    any = chopgimp_vdistort_has (l->data);
+
+  if (! any)
+    {
+      g_list_free (targets);
+      return FALSE;
+    }
+
+  chopgimp_vlayer_push_undo (layer, _("Décomposer la distorsion"));
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = targets; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      GimpPath        *flat;
+
+      if (! chopgimp_vdistort_has (o))
+        continue;
+
+      /*  3.28.2: only the distortion is frozen into the path; the other
+       *  live effects of the object stay live (applied after it now)
+       */
+      {
+        gchar *only = spec_distort_only (o->lpe);
+        gchar *rest = spec_with (o->lpe, NULL);
+
+        flat = chopgimp_geom_effects (o->path, only ? only : o->lpe);
+
+        if (flat)
+          {
+            g_object_ref_sink (flat);
+            chopgimp_vlayer_set_path (layer, o->id, flat, FALSE);
+            g_object_unref (flat);
+          }
+
+        chopgimp_vlayer_set_lpe (layer, o->id, rest, FALSE);
+        g_free (only);
+        g_free (rest);
+      }
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (targets);
+
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vdistort_release (GimpVectorLayer *layer)
+{
+  GList   *targets = chopgimp_vdistort_targets (layer);
+  gboolean done    = FALSE;
+
+  if (! chopgimp_vdistort_any (layer))
+    {
+      g_list_free (targets);
+      return FALSE;
+    }
+
+  chopgimp_vlayer_push_undo (layer, _("Annuler la distorsion"));
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = targets; l; l = l->next)
+    if (chopgimp_vdistort_has (l->data))
+      {
+        chopgimp_vdistort_set (layer, ((ChopGimpVObject *) l->data)->id, NULL, FALSE);
+        done = TRUE;
+      }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (targets);
+
+  if (done)
+    gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+
+  return done;
+}
+
+
+/*  3.28.2: « Convertir en maille » (Illustrator): a Déformation becomes an
+ *  envelope mesh of 4 × 4 cells through the same points, then editable
+ *  with the Envelope tool
+ */
+gboolean
+chopgimp_vdistort_any_warp (GimpVectorLayer *layer)
+{
+  GList   *targets = chopgimp_vdistort_targets (layer);
+  gboolean any     = FALSE;
+
+  for (GList *l = targets; l && ! any; l = l->next)
+    {
+      ChopGimpDistort d;
+
+      chopgimp_vdistort_init (&d);
+      any = chopgimp_vdistort_get (l->data, &d) && d.mode == CHOPGIMP_DISTORT_WARP;
+      chopgimp_vdistort_clear (&d);
+    }
+
+  g_list_free (targets);
+
+  return any;
+}
+
+gboolean
+chopgimp_vdistort_convert_to_mesh (GimpVectorLayer *layer)
+{
+  GList   *targets = chopgimp_vdistort_targets (layer);
+  gboolean done    = FALSE;
+
+  if (! chopgimp_vdistort_any_warp (layer))
+    {
+      g_list_free (targets);
+      return FALSE;
+    }
+
+  chopgimp_vlayer_push_undo (layer, _("Convertir en maille"));
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = targets; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      ChopGimpDistort  d;
+      const gint       R = 4, C = 4;
+      gdouble         *xy;
+
+      chopgimp_vdistort_init (&d);
+
+      if (! chopgimp_vdistort_get (o, &d) || d.mode != CHOPGIMP_DISTORT_WARP ||
+          d.box[2] <= 0 || d.box[3] <= 0)
+        {
+          chopgimp_vdistort_clear (&d);
+          continue;
+        }
+
+      xy = g_new (gdouble, (R + 1) * (C + 1) * 2);
+
+      for (gint i = 0; i <= R; i++)
+        for (gint j = 0; j <= C; j++)
+          {
+            gint k = i * (C + 1) + j;
+
+            xy[2 * k]     = d.box[0] + (gdouble) j / C * d.box[2];
+            xy[2 * k + 1] = d.box[1] + (gdouble) i / R * d.box[3];
+          }
+
+      if (chopgimp_geom_distort_map (o->lpe, xy, (R + 1) * (C + 1)))
+        {
+          ChopGimpDistort m;
+
+          chopgimp_vdistort_init (&m);
+          m.mode = CHOPGIMP_DISTORT_MESH;
+          m.rows = R;
+          m.cols = C;
+          m.mesh = g_new (gdouble, (R + 1) * (C + 1) * 2);
+          memcpy (m.box, d.box, sizeof (m.box));
+
+          for (gint i = 0; i <= R; i++)
+            for (gint j = 0; j <= C; j++)
+              {
+                gint k = i * (C + 1) + j;
+
+                m.mesh[2 * k]     = (xy[2 * k] - d.box[0]) / d.box[2] - (gdouble) j / C;
+                m.mesh[2 * k + 1] = (xy[2 * k + 1] - d.box[1]) / d.box[3] - (gdouble) i / R;
+              }
+
+          chopgimp_vdistort_set (layer, o->id, &m, FALSE);
+          chopgimp_vdistort_clear (&m);
+          done = TRUE;
+        }
+
+      g_free (xy);
+      chopgimp_vdistort_clear (&d);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (targets);
+
+  if (done)
+    gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+
+  return done;
+}
diff --git a/app/path/chopgimp-vdistort.h b/app/path/chopgimp-vdistort.h
new file mode 100644
index 0000000..f0ecc01
--- /dev/null
+++ b/app/path/chopgimp-vdistort.h
@@ -0,0 +1,119 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vdistort.h — ChopGimp 3.27.6: « Objet > Distorsion »
+ *
+ * Illustrator's envelope distortions on the objects of a vector layer,
+ * kept live (editable) until « Décomposer »:
+ *
+ *  - WARP  « Déformation »: 15 presets (Arc, Arc inférieur, Arc supérieur,
+ *          Arche, Renflement, Coquillage inférieur / supérieur, Drapeau,
+ *          Onde, Poisson, Montée, Œil de poisson, Gonflement,
+ *          Compression, Torsion) with a bend and horizontal / vertical
+ *          distortions, horizontal or vertical;
+ *  - MESH  « Enveloppe »: a grid of rows × columns points (dragged on the
+ *          canvas with the Enveloppe tool), or made « d'après l'objet du
+ *          dessus » (the shape of the topmost selected object);
+ *  - FREE  « Distorsion libre »: 4 corners, in perspective.
+ *
+ * A distortion is the « distort » live path effect (chopgimp-geom.h) of
+ * each path object, the last group of its « lpe » key file: it is saved
+ * with the objects (XML, XCF), undone in one step, drawn by the
+ * renderer, and exported flattened (the effective path). The content
+ * stays editable (Sélection directe, « Modifier le contenu »); the
+ * envelope keeps its box (« box »: the content's box when it was made).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "chopgimp-vobject.h"
+
+G_BEGIN_DECLS
+
+
+typedef enum
+{
+  CHOPGIMP_DISTORT_NONE,
+  CHOPGIMP_DISTORT_WARP,
+  CHOPGIMP_DISTORT_MESH,
+  CHOPGIMP_DISTORT_FREE
+} ChopGimpDistortMode;
+
+typedef struct
+{
+  ChopGimpDistortMode  mode;
+  /*  WARP  */
+  gchar               *style;     /* « arc »… (chopgimp_vdistort_get_styles) */
+  gdouble              bend;      /* -100..100 %                          */
+  gdouble              hdist;     /* -100..100 %                          */
+  gdouble              vdist;     /* -100..100 %                          */
+  gboolean             vertical;
+  /*  MESH / FREE (1 × 1)  */
+  gint                 rows, cols;
+  gdouble             *mesh;      /* (rows + 1) × (cols + 1) × 2 offsets,
+                                   * fractions of the box (owned)        */
+  /*  the box, in the object's local coordinates  */
+  gdouble              box[4];    /* x, y, width, height                  */
+} ChopGimpDistort;
+
+
+/*  NULL-terminated, static; labels translated  */
+const gchar * const * chopgimp_vdistort_get_styles     (void);
+const gchar         * chopgimp_vdistort_get_style_label (const gchar     *style);
+
+void                  chopgimp_vdistort_init           (ChopGimpDistort *d);
+void                  chopgimp_vdistort_clear          (ChopGimpDistort *d);
+void                  chopgimp_vdistort_copy           (ChopGimpDistort *dest,
+                                                        const ChopGimpDistort *src);
+
+/*  the distortion of a path object (@d initialized); FALSE: none  */
+gboolean              chopgimp_vdistort_get            (ChopGimpVObject *object,
+                                                        ChopGimpDistort *d);
+gboolean              chopgimp_vdistort_has            (ChopGimpVObject *object);
+
+/*  @d NULL or NONE: removes it; one undo step with @push_undo  */
+void                  chopgimp_vdistort_set            (GimpVectorLayer *layer,
+                                                        guint            id,
+                                                        const ChopGimpDistort *d,
+                                                        gboolean         push_undo);
+
+/*  the local box of an object's path (its control points)  */
+gboolean              chopgimp_vdistort_local_box      (ChopGimpVObject *object,
+                                                        gdouble          box[4]);
+
+/*  ─── on the selected objects of the layer (one undo step each) ─────── */
+
+/*  the selected path objects (the leaves of the selected groups), or all
+ *  of them when nothing is selected (g_list_free)
+ */
+GList               * chopgimp_vdistort_targets        (GimpVectorLayer *layer);
+gboolean              chopgimp_vdistort_can_make       (GimpVectorLayer *layer);
+gboolean              chopgimp_vdistort_can_make_top   (GimpVectorLayer *layer);
+gboolean              chopgimp_vdistort_any            (GimpVectorLayer *layer);
+
+/*  @d: the distortion for the first target, @d->box ignored: each target
+ *  gets the box of all of them (in its local coordinates); @desc: the undo step
+ *  (NULL: none, for a preview)
+ */
+gboolean              chopgimp_vdistort_make           (GimpVectorLayer *layer,
+                                                        const ChopGimpDistort *d,
+                                                        const gchar     *desc);
+/*  « Créer d'après l'objet du dessus »: the topmost selected object is
+ *  the envelope of the others (then deleted)
+ */
+gboolean              chopgimp_vdistort_make_top       (GimpVectorLayer *layer,
+                                                        gint             rows,
+                                                        gint             cols);
+/*  « Décomposer »: the distorted paths become the objects' paths  */
+gboolean              chopgimp_vdistort_expand         (GimpVectorLayer *layer);
+/*  « Annuler la distorsion »: back to the content  */
+gboolean              chopgimp_vdistort_release        (GimpVectorLayer *layer);
+/*  3.28.2: « Convertir en maille » (a Déformation → a 4 × 4 envelope)  */
+gboolean              chopgimp_vdistort_any_warp       (GimpVectorLayer *layer);
+gboolean              chopgimp_vdistort_convert_to_mesh (GimpVectorLayer *layer);
+
+
+G_END_DECLS
diff --git a/app/path/chopgimp-vlivepaint.c b/app/path/chopgimp-vlivepaint.c
new file mode 100644
index 0000000..3785a2c
--- /dev/null
+++ b/app/path/chopgimp-vlivepaint.c
@@ -0,0 +1,1233 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vlivepaint.c — ChopGimp 3.27.7 (lot V6 point 6): « Peinture
+ * dynamique » (see chopgimp-vlivepaint.h)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <cairo.h>
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+
+#include "path-types.h"
+
+#include "core/gimpimage.h"
+#include "core/gimpitem.h"
+
+#include "gimpanchor.h"
+#include "gimppath.h"
+#include "gimpstroke.h"
+#include "gimpvectorlayer.h"
+#include "chopgimp-geom.h"
+#include "chopgimp-vobject.h"
+#include "chopgimp-vutil.h"
+#include "chopgimp-vlivepaint.h"
+
+#include "gimp-intl.h"
+
+
+/*  ─── roles ─────────────────────────────────────────────────────────── */
+
+ChopGimpLivePaintRole
+chopgimp_vlivepaint_role (ChopGimpVObject *o)
+{
+  if (! o || ! o->livepaint)
+    return CHOPGIMP_LIVEPAINT_NONE;
+
+  if (o->kind == CHOPGIMP_VOBJECT_GROUP)
+    {
+      if (g_str_has_prefix (o->livepaint, "group"))
+        return CHOPGIMP_LIVEPAINT_GROUP;
+      if (! strcmp (o->livepaint, "sources"))
+        return CHOPGIMP_LIVEPAINT_SOURCES;
+    }
+  else
+    {
+      if (! strcmp (o->livepaint, "face"))
+        return CHOPGIMP_LIVEPAINT_FACE;
+      if (g_str_has_prefix (o->livepaint, "edge"))
+        return CHOPGIMP_LIVEPAINT_EDGE;
+    }
+
+  return CHOPGIMP_LIVEPAINT_NONE;
+}
+
+ChopGimpVObject *
+chopgimp_vlivepaint_group_of (ChopGimpVObject *o)
+{
+  for (; o; o = o->parent)
+    if (chopgimp_vlivepaint_role (o) == CHOPGIMP_LIVEPAINT_GROUP)
+      return o;
+
+  return NULL;
+}
+
+/*  « key=value » in a role string  */
+static gchar *
+lp_param (const gchar *spec,
+          const gchar *key)
+{
+  gchar **words;
+  gchar  *value = NULL;
+  gsize   len   = strlen (key);
+
+  if (! spec)
+    return NULL;
+
+  words = g_strsplit (spec, " ", -1);
+
+  for (gint i = 0; words[i] && ! value; i++)
+    if (! strncmp (words[i], key, len) && words[i][len] == '=')
+      value = g_strdup (words[i] + len + 1);
+
+  g_strfreev (words);
+
+  return value;
+}
+
+static gdouble
+lp_gap (ChopGimpVObject *g)
+{
+  gchar   *v   = lp_param (g->livepaint, "gap");
+  gdouble  gap = v ? g_ascii_strtod (v, NULL) : 0.0;
+
+  g_free (v);
+
+  return MAX (gap, 0.0);
+}
+
+static gint
+lp_src (ChopGimpVObject *edge)
+{
+  gchar *v   = lp_param (edge->livepaint, "src");
+  gint   src = v ? atoi (v) : -1;
+
+  g_free (v);
+
+  return src;
+}
+
+static void
+lp_set_group_spec (ChopGimpVObject *g,
+                   gdouble          gap,
+                   const gchar     *sig)
+{
+  gchar buf[G_ASCII_DTOSTR_BUF_SIZE];
+
+  g_free (g->livepaint);
+  g->livepaint = g_strdup_printf ("group gap=%s sig=%s",
+                                  g_ascii_formatd (buf, sizeof (buf), "%.3g", gap),
+                                  sig ? sig : "");
+}
+
+static ChopGimpVObject *
+lp_sources (ChopGimpVObject *g)
+{
+  for (guint i = 0; i < g->children->len; i++)
+    {
+      ChopGimpVObject *c = g_ptr_array_index (g->children, i);
+
+      if (chopgimp_vlivepaint_role (c) == CHOPGIMP_LIVEPAINT_SOURCES)
+        return c;
+    }
+
+  return NULL;
+}
+
+static void
+collect_leaves (ChopGimpVObject  *o,
+                GList           **list)
+{
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    *list = g_list_prepend (*list, o);
+  else
+    for (guint i = 0; i < o->children->len; i++)
+      collect_leaves (g_ptr_array_index (o->children, i), list);
+}
+
+static GList *
+leaves_of (ChopGimpVObject *o)
+{
+  GList *list = NULL;
+
+  collect_leaves (o, &list);
+
+  return g_list_reverse (list);
+}
+
+static void
+collect_groups (ChopGimpVObject  *o,
+                GList           **list)
+{
+  if (o->kind != CHOPGIMP_VOBJECT_GROUP)
+    return;
+
+  if (chopgimp_vlivepaint_role (o) == CHOPGIMP_LIVEPAINT_GROUP)
+    {
+      *list = g_list_prepend (*list, o);
+      return;
+    }
+
+  for (guint i = 0; i < o->children->len; i++)
+    collect_groups (g_ptr_array_index (o->children, i), list);
+}
+
+/*  the path of @o in the local space of @g (floating)  */
+static GimpPath *
+path_in_group (GimpVectorLayer *layer,
+               ChopGimpVObject *o,
+               ChopGimpVObject *g,
+               gboolean         with_effects)
+{
+  GimpPath    *wp = chopgimp_vobject_get_world_path (layer, o, with_effects);
+  GimpMatrix3  inv;
+
+  if (! wp)
+    return NULL;
+
+  chopgimp_vobject_get_world_matrix (g, &inv);
+  gimp_matrix3_invert (&inv);
+  chopgimp_vpath_transform (wp, &inv);
+
+  return wp;
+}
+
+
+/*  ─── computing the regions again ───────────────────────────────────── */
+
+typedef struct
+{
+  ChopGimpVObject *o;
+  GimpPath        *path;   /* group space (ref) */
+  gdouble          x, y;   /* key point          */
+  gdouble          area;
+  gint             src;
+  gboolean         ok;
+  gdouble          box[4];
+  gboolean         has_box;
+} OldPiece;
+
+static void
+old_pieces_free (GArray *a)
+{
+  for (guint i = 0; i < a->len; i++)
+    g_clear_object (&g_array_index (a, OldPiece, i).path);
+
+  g_array_free (a, TRUE);
+}
+
+/*  3.29.5: the anchors of @path rounded to 1/100 px: two pieces with the
+ *  same key have the same shape (recomputed regions found again at once)
+ */
+static gchar *
+piece_key (GimpPath *path)
+{
+  GString    *s      = g_string_new (NULL);
+  GimpStroke *stroke = NULL;
+
+  while ((stroke = gimp_path_stroke_get_next (path, stroke)))
+    {
+      GArray *anchors = gimp_stroke_control_points_get (stroke, NULL);
+
+      g_string_append_c (s, '|');
+
+      for (guint k = 0; anchors && k < anchors->len; k++)
+        {
+          GimpAnchor *a = &g_array_index (anchors, GimpAnchor, k);
+
+          g_string_append_printf (s, "%ld,%ld;",
+                                  (glong) floor (a->position.x * 100 + 0.5),
+                                  (glong) floor (a->position.y * 100 + 0.5));
+        }
+
+      if (anchors)
+        g_array_unref (anchors);
+    }
+
+  return g_string_free (s, FALSE);
+}
+
+static gboolean
+lp_incremental (void)
+{
+  return g_getenv ("CHOPGIMP_LP_NO_INCREMENTAL") == NULL;
+}
+
+static void
+style_unpainted_fill (ChopGimpVStyle *st)
+{
+  chopgimp_vstyle_init (st);
+
+  for (gint k = 0; k < chopgimp_vstyle_get_n_entries (st); k++)
+    chopgimp_vpaint_clear (&chopgimp_vstyle_get_entry (st, k)->paint);
+}
+
+/*  a segment of a path: its strokes, without fills or arrowheads  */
+static void
+style_for_edge (ChopGimpVStyle       *st,
+                const ChopGimpVStyle *src)
+{
+  chopgimp_vstyle_init (st);
+
+  if (src)
+    chopgimp_vstyle_copy (st, src);
+
+  for (gint k = chopgimp_vstyle_get_n_entries (st) - 1; k >= 0; k--)
+    {
+      ChopGimpVEntry *e = chopgimp_vstyle_get_entry (st, k);
+
+      if (e->kind == CHOPGIMP_VENTRY_FILL)
+        {
+          chopgimp_vstyle_remove_entry (st, k);
+          continue;
+        }
+
+      g_clear_pointer (&e->arrow_start, g_free);
+      g_clear_pointer (&e->arrow_end, g_free);
+      e->align       = CHOPGIMP_STROKE_ALIGN_CENTER;
+      e->follow_fill = FALSE;
+    }
+
+  chopgimp_vstyle_ensure_stroke (st);
+}
+
+static gboolean
+lp_regen (GimpVectorLayer *layer,
+          ChopGimpVObject *g)
+{
+  GimpImage        *image   = gimp_item_get_image (GIMP_ITEM (layer));
+  ChopGimpVObject  *sources = lp_sources (g);
+  GList            *leaves;
+  GPtrArray        *paths;
+  GString          *sigsrc;
+  gchar            *sig, *old_sig;
+  gdouble           gap     = lp_gap (g);
+  GimpPath        **faces   = NULL;
+  GimpPath        **edges   = NULL;
+  gint             *esrc    = NULL;
+  gint              n_faces = 0, n_edges = 0;
+  GArray           *old_faces, *old_edges;
+  GPtrArray        *made;
+  gboolean          fresh;
+  GList            *l;
+  gint              i;
+  GHashTable       *face_keys = NULL;   /* 3.29.5: shape → old index + 1 */
+  GHashTable       *edge_keys = NULL;
+
+  if (! sources)
+    return FALSE;
+
+  leaves = leaves_of (sources);
+  paths  = g_ptr_array_new_with_free_func (g_object_unref);
+  sigsrc = g_string_new (NULL);
+
+  g_string_append_printf (sigsrc, "gap=%.3f;", gap);
+
+  for (l = leaves, i = 0; l; l = l->next, i++)
+    {
+      GimpPath *p = path_in_group (layer, l->data, g, TRUE);
+      gchar    *d;
+
+      if (! p)
+        p = gimp_path_new (image, "");
+
+      g_object_ref_sink (p);
+      g_ptr_array_add (paths, p);
+
+      d = chopgimp_vpath_to_d (p);
+      g_string_append_printf (sigsrc, "%d:%s;", i, d);
+      g_free (d);
+    }
+
+  sig     = g_compute_checksum_for_string (G_CHECKSUM_MD5, sigsrc->str, -1);
+  old_sig = lp_param (g->livepaint, "sig");
+  g_string_free (sigsrc, TRUE);
+
+  if (! g_strcmp0 (sig, old_sig))
+    {
+      g_free (sig);
+      g_free (old_sig);
+      g_ptr_array_free (paths, TRUE);
+      g_list_free (leaves);
+      return FALSE;
+    }
+
+  g_free (old_sig);
+
+  if (paths->len > 0 &&
+      ! chopgimp_geom_planar ((GimpPath **) paths->pdata, paths->len, gap,
+                              &faces, &n_faces, &edges, &esrc, &n_edges))
+    {
+      n_faces = n_edges = 0;
+    }
+
+  for (i = 0; i < n_faces; i++)
+    g_object_ref_sink (faces[i]);
+  for (i = 0; i < n_edges; i++)
+    g_object_ref_sink (edges[i]);
+
+  /*  the old regions and segments, with their key points  */
+  old_faces = g_array_new (FALSE, TRUE, sizeof (OldPiece));
+  old_edges = g_array_new (FALSE, TRUE, sizeof (OldPiece));
+
+  for (guint k = 0; k < g->children->len; k++)
+    {
+      ChopGimpVObject       *c    = g_ptr_array_index (g->children, k);
+      ChopGimpLivePaintRole  role = chopgimp_vlivepaint_role (c);
+      OldPiece               op   = { c, NULL, 0, 0, 0, -1, FALSE, { 0, }, FALSE };
+
+      if (role != CHOPGIMP_LIVEPAINT_FACE && role != CHOPGIMP_LIVEPAINT_EDGE)
+        continue;
+
+      op.path = path_in_group (layer, c, g, FALSE);
+      if (! op.path)
+        continue;
+      g_object_ref_sink (op.path);
+      op.has_box = chopgimp_path_anchor_bbox (op.path, op.box);
+
+      if (role == CHOPGIMP_LIVEPAINT_FACE)
+        {
+          op.ok   = chopgimp_geom_interior_point (op.path, &op.x, &op.y);
+          op.area = fabs (chopgimp_geom_area (op.path));
+          g_array_append_val (old_faces, op);
+        }
+      else
+        {
+          op.ok  = chopgimp_geom_midpoint (op.path, &op.x, &op.y);
+          op.src = lp_src (c);
+          g_array_append_val (old_edges, op);
+        }
+    }
+
+  fresh = (old_faces->len == 0 && old_edges->len == 0);
+  made  = g_ptr_array_new ();
+
+  /*  3.29.5: incremental: the old pieces by shape (a region or a
+   *  segment that did not change takes its old style at once, without
+   *  sampling), and for the others only the old regions whose box meets
+   *  the new one are sampled (was: all of them for each grid point)
+   */
+  if (lp_incremental ())
+    {
+      face_keys = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+      edge_keys = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+
+      for (guint k = 0; k < old_faces->len; k++)
+        g_hash_table_insert (face_keys,
+                             piece_key (g_array_index (old_faces, OldPiece, k).path),
+                             GUINT_TO_POINTER (k + 1));
+
+      for (guint k = 0; k < old_edges->len; k++)
+        {
+          OldPiece *op  = &g_array_index (old_edges, OldPiece, k);
+          gchar    *key = piece_key (op->path);
+          gchar    *ks  = g_strdup_printf ("%d%s", op->src, key);
+
+          g_free (key);
+          g_hash_table_insert (edge_keys, ks, GUINT_TO_POINTER (k + 1));
+        }
+    }
+
+  /*  the regions  */
+  for (i = 0; i < n_faces; i++)
+    {
+      ChopGimpVStyle   st;
+      ChopGimpVObject *o;
+      OldPiece        *best = NULL;
+      gdouble          fx, fy;
+      gboolean         has_pt = chopgimp_geom_interior_point (faces[i], &fx, &fy);
+      gchar           *name;
+
+      /*  the old region that overlaps this one the most: a grid of points
+       *  of the new region, counted in each old one (booleans of shapes
+       *  sharing edges are not reliable)
+       */
+      if (face_keys)
+        {
+          gchar   *key = piece_key (faces[i]);
+          guint    k   = GPOINTER_TO_UINT (g_hash_table_lookup (face_keys, key));
+
+          if (k > 0)
+            best = &g_array_index (old_faces, OldPiece, k - 1);
+          g_free (key);
+        }
+
+      if (! best)
+      {
+        gdouble  nb[4];
+        gint     best_n = 0;
+
+        if (old_faces->len > 0 && chopgimp_path_anchor_bbox (faces[i], nb))
+          {
+            const gint  G    = 12;
+            gint       *hits = g_new0 (gint, old_faces->len);
+            GArray     *cand = g_array_new (FALSE, FALSE, sizeof (guint));
+
+            /*  3.29.5: the old regions whose box meets this one  */
+            for (guint k = 0; k < old_faces->len; k++)
+              {
+                OldPiece *op = &g_array_index (old_faces, OldPiece, k);
+
+                if (! face_keys ||
+                    (op->has_box && op->box[0] <= nb[2] && op->box[2] >= nb[0] &&
+                     op->box[1] <= nb[3] && op->box[3] >= nb[1]))
+                  g_array_append_val (cand, k);
+              }
+
+            for (gint gy = 0; gy < G; gy++)
+              for (gint gx = 0; gx < G; gx++)
+                {
+                  gdouble px = nb[0] + (gx + 0.5) * (nb[2] - nb[0]) / G;
+                  gdouble py = nb[1] + (gy + 0.5) * (nb[3] - nb[1]) / G;
+
+                  if (! chopgimp_geom_contains (faces[i], px, py))
+                    continue;
+
+                  for (guint c = 0; c < cand->len; c++)
+                    {
+                      guint     k  = g_array_index (cand, guint, c);
+                      OldPiece *op = &g_array_index (old_faces, OldPiece, k);
+
+                      if (op->has_box &&
+                          px >= op->box[0] && px <= op->box[2] &&
+                          py >= op->box[1] && py <= op->box[3] &&
+                          chopgimp_geom_contains (op->path, px, py))
+                        hits[k]++;
+                    }
+                }
+
+            for (guint k = 0; k < old_faces->len; k++)
+              if (hits[k] > best_n)
+                {
+                  best   = &g_array_index (old_faces, OldPiece, k);
+                  best_n = hits[k];
+                }
+
+            g_free (hits);
+            g_array_free (cand, TRUE);
+          }
+
+        /*  a thin region the grid missed: the old one around its centre  */
+        if (! best && has_pt)
+          for (guint k = 0; k < old_faces->len; k++)
+            {
+              OldPiece *op = &g_array_index (old_faces, OldPiece, k);
+
+              if (chopgimp_geom_contains (op->path, fx, fy) &&
+                  (! best || op->area < best->area))
+                best = op;
+            }
+      }
+
+      style_unpainted_fill (&st);
+
+      if (best)
+        {
+          chopgimp_vstyle_copy (&st, &best->o->style);
+        }
+      else if (fresh && has_pt)
+        {
+          /*  a new group: the fill of the topmost path around it  */
+          gint li = (gint) paths->len - 1;
+
+          for (l = g_list_last (leaves); l; l = l->prev, li--)
+            {
+              ChopGimpVObject *src  = l->data;
+              ChopGimpVEntry  *fill = chopgimp_vstyle_get_fill (&src->style);
+
+              if (fill && chopgimp_ventry_is_painted (fill) &&
+                  chopgimp_geom_contains (g_ptr_array_index (paths, li), fx, fy))
+                {
+                  ChopGimpVEntry *f = chopgimp_vstyle_ensure_fill (&st);
+
+                  chopgimp_vpaint_copy (&f->paint, &fill->paint);
+                  f->opacity = fill->opacity;
+                  f->visible = TRUE;
+                  break;
+                }
+            }
+        }
+
+      name = g_strdup_printf (_("Zone %d"), i + 1);
+      o    = chopgimp_vobject_new_path (image, faces[i], name, &st);
+      o->livepaint = g_strdup ("face");
+      o->style.fill_nonzero = FALSE;
+      g_ptr_array_add (made, o);
+
+      g_free (name);
+      chopgimp_vstyle_clear (&st);
+    }
+
+  /*  the segments  */
+  for (i = 0; i < n_edges; i++)
+    {
+      ChopGimpVStyle   st;
+      ChopGimpVObject *o;
+      OldPiece        *best   = NULL;
+      gdouble          best_d = G_MAXDOUBLE;
+      gdouble          mx = 0, my = 0;
+      gchar           *name;
+
+      chopgimp_geom_midpoint (edges[i], &mx, &my);
+
+      if (edge_keys)
+        {
+          gchar *key = piece_key (edges[i]);
+          gchar *ks  = g_strdup_printf ("%d%s", esrc[i], key);
+          guint  k   = GPOINTER_TO_UINT (g_hash_table_lookup (edge_keys, ks));
+
+          if (k > 0)
+            best = &g_array_index (old_edges, OldPiece, k - 1);
+          g_free (key);
+          g_free (ks);
+        }
+
+      for (guint k = 0; old_edges->len > 0 && k < (best ? 0 : old_edges->len); k++)
+        {
+          OldPiece *op = &g_array_index (old_edges, OldPiece, k);
+          gdouble   d;
+
+          if (! op->ok || op->src != esrc[i])
+            continue;
+
+          if (chopgimp_geom_distance (edges[i], op->x, op->y) > 2.0 &&
+              chopgimp_geom_distance (op->path, mx, my) > 2.0)
+            continue;
+
+          d = hypot (op->x - mx, op->y - my);
+
+          if (d < best_d)
+            {
+              best   = op;
+              best_d = d;
+            }
+        }
+
+      if (best)
+        {
+          chopgimp_vstyle_init (&st);
+          chopgimp_vstyle_copy (&st, &best->o->style);
+        }
+      else
+        {
+          ChopGimpVObject *src = g_list_nth_data (leaves, esrc[i]);
+
+          style_for_edge (&st, src ? &src->style : NULL);
+        }
+
+      name = g_strdup_printf (_("Segment %d"), i + 1);
+      o    = chopgimp_vobject_new_path (image, edges[i], name, &st);
+      o->livepaint = g_strdup_printf ("edge src=%d", esrc[i]);
+      g_ptr_array_add (made, o);
+
+      g_free (name);
+      chopgimp_vstyle_clear (&st);
+    }
+
+  /*  in place: regions, segments, then the paths (hidden)  */
+  chopgimp_vobject_ref (sources);
+  g_ptr_array_set_size (g->children, 0);
+
+  for (guint k = 0; k < made->len; k++)
+    {
+      ChopGimpVObject *o = g_ptr_array_index (made, k);
+
+      o->parent = g;
+      g_ptr_array_add (g->children, o);
+    }
+
+  sources->parent = g;
+  g_ptr_array_add (g->children, sources);
+
+  lp_set_group_spec (g, gap, sig);
+
+  for (i = 0; i < n_faces; i++)
+    g_object_unref (faces[i]);
+  for (i = 0; i < n_edges; i++)
+    g_object_unref (edges[i]);
+  g_free (faces);
+  g_free (edges);
+  g_free (esrc);
+
+  if (face_keys)
+    g_hash_table_destroy (face_keys);
+  if (edge_keys)
+    g_hash_table_destroy (edge_keys);
+
+  g_ptr_array_free (made, TRUE);
+  old_pieces_free (old_faces);
+  old_pieces_free (old_edges);
+  g_ptr_array_free (paths, TRUE);
+  g_list_free (leaves);
+  g_free (sig);
+
+  return TRUE;
+}
+
+/*  3.28.2: while a path of a big live paint group is dragged, the regions
+ *  are recomputed at most every 2 × their cost (and once more at the end):
+ *  the drag stays fluid, the regions catch up
+ */
+static gboolean lp_forced = FALSE;
+
+static gboolean
+lp_deferred_refresh (gpointer data)
+{
+  GimpVectorLayer *layer = data;
+
+  g_object_set_data (G_OBJECT (layer), "chopgimp-lp-timer", NULL);
+
+  if (gimp_item_is_attached (GIMP_ITEM (layer)) && chopgimp_vlayer_get_root (layer))
+    {
+      lp_forced = TRUE;
+      chopgimp_vlayer_subtree_changed (layer, NULL, NULL);
+      lp_forced = FALSE;
+      gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+    }
+
+  g_object_unref (layer);
+
+  return G_SOURCE_REMOVE;
+}
+
+gboolean
+chopgimp_vlivepaint_refresh (GimpVectorLayer *layer)
+{
+  ChopGimpVObject *root = chopgimp_vlayer_get_root (layer);
+  GList           *groups = NULL;
+  gboolean         any    = FALSE;
+  gint64           now, cost, last;
+
+  if (! root)
+    return FALSE;
+
+  collect_groups (root, &groups);
+
+  if (! groups)
+    return FALSE;
+
+  now  = g_get_monotonic_time ();
+  cost = GPOINTER_TO_SIZE (g_object_get_data (G_OBJECT (layer), "chopgimp-lp-cost"));
+  last = (gint64) GPOINTER_TO_SIZE (g_object_get_data (G_OBJECT (layer), "chopgimp-lp-last"));
+
+  if (! lp_forced && cost > 60000 && now - last < 2 * cost)
+    {
+      if (! g_object_get_data (G_OBJECT (layer), "chopgimp-lp-timer"))
+        g_object_set_data (G_OBJECT (layer), "chopgimp-lp-timer",
+                           GUINT_TO_POINTER (g_timeout_add ((guint) (2 * cost / 1000),
+                                                            lp_deferred_refresh,
+                                                            g_object_ref (layer))));
+      g_list_free (groups);
+      return FALSE;
+    }
+
+  for (GList *l = groups; l; l = l->next)
+    any |= lp_regen (layer, l->data);
+
+  g_list_free (groups);
+
+  if (any)
+    {
+      gint64 t = g_get_monotonic_time ();
+
+      g_object_set_data (G_OBJECT (layer), "chopgimp-lp-cost", GSIZE_TO_POINTER ((gsize) (t - now)));
+      g_object_set_data (G_OBJECT (layer), "chopgimp-lp-last", GSIZE_TO_POINTER ((gsize) t));
+    }
+
+  return any;
+}
+
+
+/*  ─── commands ──────────────────────────────────────────────────────── */
+
+/*  the selected objects that may be painted: same parent, outside any
+ *  live paint group (g_list_free)
+ */
+static GList *
+makeable_ex (GimpVectorLayer *layer,
+             gboolean         same_parent)
+{
+  GList           *sel    = chopgimp_vlayer_get_selected_objects (layer);
+  GList           *ok     = NULL;
+  ChopGimpVObject *parent = NULL;
+
+  for (GList *l = sel; l; l = l->next)
+    {
+      ChopGimpVObject *o    = l->data;
+      gboolean         skip = FALSE;
+
+      if (chopgimp_vlivepaint_group_of (o) ||
+          chopgimp_vlivepaint_role (o) != CHOPGIMP_LIVEPAINT_NONE)
+        continue;
+
+      /*  3.28.2 (Ajouter): any level; an object inside another selected
+       *  one goes with it
+       */
+      if (! same_parent)
+        {
+          for (GList *k = sel; k; k = k->next)
+            if (k->data != o && chopgimp_vobject_is_ancestor (k->data, o))
+              skip = TRUE;
+
+          if (! skip)
+            ok = g_list_append (ok, o);
+          continue;
+        }
+
+      if (ok && o->parent != parent)
+        {
+          g_list_free (ok);
+          g_list_free (sel);
+          return NULL;
+        }
+
+      parent = o->parent;
+      ok     = g_list_append (ok, o);
+    }
+
+  g_list_free (sel);
+
+  return ok;
+}
+
+static GList *
+makeable (GimpVectorLayer *layer)
+{
+  return makeable_ex (layer, TRUE);
+}
+
+gboolean
+chopgimp_vlivepaint_can_make (GimpVectorLayer *layer)
+{
+  GList    *ok;
+  gboolean  can;
+
+  if (! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  ok  = makeable (layer);
+  can = ok != NULL;
+  g_list_free (ok);
+
+  return can;
+}
+
+ChopGimpVObject *
+chopgimp_vlivepaint_make (GimpVectorLayer *layer)
+{
+  GList           *ok = makeable (layer);
+  GArray          *ids;
+  ChopGimpVObject *g, *sources;
+
+  if (! ok)
+    return NULL;
+
+  ids = g_array_new (FALSE, FALSE, sizeof (guint));
+  for (GList *l = ok; l; l = l->next)
+    g_array_append_val (ids, ((ChopGimpVObject *) l->data)->id);
+  g_list_free (ok);
+
+  g = chopgimp_vlayer_group (layer, (guint *) ids->data, ids->len,
+                             _("Peinture dynamique"), TRUE);
+  g_array_free (ids, TRUE);
+
+  if (! g)
+    return NULL;
+
+  /*  the grouped objects become the hidden paths  */
+  sources = chopgimp_vobject_new_group (_("Tracés"));
+  sources->visible   = FALSE;
+  sources->livepaint = g_strdup ("sources");
+
+  for (guint i = 0; i < g->children->len; i++)
+    {
+      ChopGimpVObject *c = g_ptr_array_index (g->children, i);
+
+      c->parent = sources;
+      g_ptr_array_add (sources->children, chopgimp_vobject_ref (c));
+    }
+
+  g_ptr_array_set_size (g->children, 0);
+  sources->parent = g;
+  g_ptr_array_add (g->children, sources);
+  lp_set_group_spec (g, 0.0, NULL);
+
+  chopgimp_vlayer_subtree_changed (layer, g, NULL);
+  chopgimp_vlayer_set_selection (layer, &g->id, 1);
+
+  return g;
+}
+
+/*  the live paint groups of the selection (selected, or containing a
+ *  selected object; g_list_free)
+ */
+static GList *
+selected_groups (GimpVectorLayer *layer)
+{
+  GList *sel = chopgimp_vlayer_get_selected_objects (layer);
+  GList *gs  = NULL;
+
+  for (GList *l = sel; l; l = l->next)
+    {
+      ChopGimpVObject *g = chopgimp_vlivepaint_group_of (l->data);
+
+      if (g && ! g_list_find (gs, g))
+        gs = g_list_append (gs, g);
+    }
+
+  g_list_free (sel);
+
+  return gs;
+}
+
+gboolean
+chopgimp_vlivepaint_any (GimpVectorLayer *layer)
+{
+  GList    *gs;
+  gboolean  any;
+
+  if (! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  gs  = selected_groups (layer);
+  any = gs != NULL;
+  g_list_free (gs);
+
+  return any;
+}
+
+gboolean
+chopgimp_vlivepaint_can_add (GimpVectorLayer *layer)
+{
+  GList    *gs, *ok;
+  gboolean  can;
+
+  if (! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  gs  = selected_groups (layer);
+  ok  = makeable_ex (layer, FALSE);
+  can = (gs && ! gs->next && ok);
+
+  g_list_free (gs);
+  g_list_free (ok);
+
+  return can;
+}
+
+/*  moves @o into @dest (on top), keeping where it is drawn  */
+static void
+move_into (ChopGimpVObject *o,
+           ChopGimpVObject *dest,
+           gint             position)
+{
+  GimpMatrix3 w, dinv;
+
+  chopgimp_vobject_get_world_matrix (o, &w);
+  chopgimp_vobject_get_world_matrix (dest, &dinv);
+  gimp_matrix3_invert (&dinv);
+  gimp_matrix3_mult (&dinv, &w);   /* w = dinv · w */
+
+  chopgimp_vobject_ref (o);
+
+  if (o->parent)
+    g_ptr_array_remove (o->parent->children, o);
+
+  o->transform = w;
+  o->parent    = dest;
+
+  if (position < 0 || position > (gint) dest->children->len)
+    g_ptr_array_add (dest->children, o);
+  else
+    g_ptr_array_insert (dest->children, position, o);
+}
+
+gboolean
+chopgimp_vlivepaint_add (GimpVectorLayer *layer)
+{
+  GList           *gs, *ok;
+  ChopGimpVObject *g, *sources;
+
+  if (! chopgimp_vlivepaint_can_add (layer))
+    return FALSE;
+
+  gs      = selected_groups (layer);
+  ok      = makeable_ex (layer, FALSE);
+  g       = gs->data;
+  sources = lp_sources (g);
+
+  if (! sources)
+    {
+      g_list_free (gs);
+      g_list_free (ok);
+      return FALSE;
+    }
+
+  chopgimp_vlayer_push_undo (layer, _("Ajouter à la peinture dynamique"));
+
+  for (GList *l = ok; l; l = l->next)
+    move_into (l->data, sources, -1);
+
+  chopgimp_vlayer_subtree_changed (layer, NULL, NULL);
+  chopgimp_vlayer_set_selection (layer, &g->id, 1);
+
+  g_list_free (gs);
+  g_list_free (ok);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vlivepaint_expand (GimpVectorLayer *layer)
+{
+  GList *gs = chopgimp_vlayer_get_root (layer) ? selected_groups (layer) : NULL;
+
+  if (! gs)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Décomposer la peinture dynamique"));
+
+  for (GList *l = gs; l; l = l->next)
+    {
+      ChopGimpVObject *g = l->data;
+
+      for (gint k = (gint) g->children->len - 1; k >= 0; k--)
+        {
+          ChopGimpVObject       *c    = g_ptr_array_index (g->children, k);
+          ChopGimpLivePaintRole  role = chopgimp_vlivepaint_role (c);
+          gboolean               keep = TRUE;
+
+          if (role == CHOPGIMP_LIVEPAINT_SOURCES)
+            keep = FALSE;
+          else if (role == CHOPGIMP_LIVEPAINT_FACE)
+            keep = chopgimp_vstyle_has_fill (&c->style) ||
+                   chopgimp_vstyle_has_stroke (&c->style);
+          else if (role == CHOPGIMP_LIVEPAINT_EDGE)
+            keep = chopgimp_vstyle_has_stroke (&c->style) ||
+                   chopgimp_vstyle_has_fill (&c->style);
+
+          if (! keep)
+            {
+              g_ptr_array_remove_index (g->children, k);
+              continue;
+            }
+
+          g_clear_pointer (&c->livepaint, g_free);
+        }
+
+      g_clear_pointer (&g->livepaint, g_free);
+    }
+
+  chopgimp_vlayer_subtree_changed (layer, NULL, NULL);
+  g_list_free (gs);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vlivepaint_release (GimpVectorLayer *layer)
+{
+  GList *gs = chopgimp_vlayer_get_root (layer) ? selected_groups (layer) : NULL;
+  GArray *ids;
+
+  if (! gs)
+    return FALSE;
+
+  ids = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  chopgimp_vlayer_push_undo (layer, _("Libérer la peinture dynamique"));
+
+  for (GList *l = gs; l; l = l->next)
+    {
+      ChopGimpVObject *g       = l->data;
+      ChopGimpVObject *parent  = g->parent;
+      ChopGimpVObject *sources = lp_sources (g);
+      gint             pos     = chopgimp_vobject_get_index (g);
+
+      if (! parent)
+        continue;
+
+      if (sources)
+        {
+          GPtrArray *kids = g_ptr_array_copy (sources->children,
+                                              (GCopyFunc) chopgimp_vobject_ref, NULL);
+
+          for (guint k = 0; k < kids->len; k++)
+            {
+              ChopGimpVObject *c = g_ptr_array_index (kids, k);
+
+              move_into (c, parent, pos++);
+              g_array_append_val (ids, c->id);
+              chopgimp_vobject_unref (c);
+            }
+
+          g_ptr_array_free (kids, TRUE);
+        }
+
+      g_ptr_array_remove (parent->children, g);
+    }
+
+  chopgimp_vlayer_subtree_changed (layer, NULL, NULL);
+  chopgimp_vlayer_set_selection (layer, (guint *) ids->data, ids->len);
+
+  g_array_free (ids, TRUE);
+  g_list_free (gs);
+
+  return TRUE;
+}
+
+gdouble
+chopgimp_vlivepaint_get_gap (GimpVectorLayer *layer)
+{
+  GList   *gs  = chopgimp_vlayer_get_root (layer) ? selected_groups (layer) : NULL;
+  gdouble  gap = gs ? lp_gap (gs->data) : -1.0;
+
+  g_list_free (gs);
+
+  return gap;
+}
+
+gboolean
+chopgimp_vlivepaint_set_gap (GimpVectorLayer *layer,
+                             gdouble          gap)
+{
+  GList *gs = chopgimp_vlayer_get_root (layer) ? selected_groups (layer) : NULL;
+
+  if (! gs)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Écarts de la peinture dynamique"));
+
+  for (GList *l = gs; l; l = l->next)
+    {
+      ChopGimpVObject *g   = l->data;
+      gchar           *sig = lp_param (g->livepaint, "sig");
+
+      lp_set_group_spec (g, MAX (gap, 0.0), sig);
+      g_free (sig);
+    }
+
+  chopgimp_vlayer_subtree_changed (layer, NULL, NULL);
+  g_list_free (gs);
+
+  return TRUE;
+}
+
+
+/*  ─── tools ─────────────────────────────────────────────────────────── */
+
+ChopGimpVObject *
+chopgimp_vlivepaint_pick (GimpVectorLayer *layer,
+                          gdouble          x,
+                          gdouble          y,
+                          gboolean         edge,
+                          gdouble          tolerance)
+{
+  ChopGimpVObject *root   = chopgimp_vlayer_get_root (layer);
+  ChopGimpVObject *best   = NULL;
+  gdouble          best_v = G_MAXDOUBLE;
+  GList           *groups = NULL;
+
+  if (! root)
+    return NULL;
+
+  collect_groups (root, &groups);
+
+  for (GList *l = groups; l; l = l->next)
+    {
+      ChopGimpVObject *g = l->data;
+
+      if (! chopgimp_vobject_is_visible (g) || chopgimp_vobject_is_locked (g))
+        continue;
+
+      for (guint k = 0; k < g->children->len; k++)
+        {
+          ChopGimpVObject       *c    = g_ptr_array_index (g->children, k);
+          ChopGimpLivePaintRole  role = chopgimp_vlivepaint_role (c);
+          GimpMatrix3            inv;
+          gdouble                lx, ly;
+
+          if (role != (edge ? CHOPGIMP_LIVEPAINT_EDGE : CHOPGIMP_LIVEPAINT_FACE) ||
+              ! c->visible || c->locked)
+            continue;
+
+          chopgimp_vobject_get_world_matrix (c, &inv);
+          gimp_matrix3_invert (&inv);
+          gimp_matrix3_transform_point (&inv, x, y, &lx, &ly);
+
+          if (edge)
+            {
+              gdouble d = chopgimp_geom_distance (c->path, lx, ly);
+
+              if (d <= tolerance && d < best_v)
+                {
+                  best   = c;
+                  best_v = d;
+                }
+            }
+          else if (chopgimp_geom_contains (c->path, lx, ly))
+            {
+              gdouble a = fabs (chopgimp_geom_area (c->path));
+
+              if (a < best_v)
+                {
+                  best   = c;
+                  best_v = a;
+                }
+            }
+        }
+    }
+
+  g_list_free (groups);
+
+  return best;
+}
+
+void
+chopgimp_vlivepaint_paint (GimpVectorLayer *layer,
+                           ChopGimpVObject *target,
+                           GeglColor       *color,
+                           gboolean         edge)
+{
+  ChopGimpVEntry *e;
+
+  if (! target || ! chopgimp_vlayer_get_root (layer))
+    return;
+
+  chopgimp_vlayer_push_undo (layer, edge ? _("Peindre le segment")
+                                         : _("Peindre la zone"));
+
+  e = edge ? chopgimp_vstyle_ensure_stroke (&target->style)
+           : chopgimp_vstyle_ensure_fill (&target->style);
+
+  if (color)
+    {
+      chopgimp_vpaint_set_color (&e->paint, color);
+      g_clear_pointer (&e->paint.global_id, g_free);
+      e->visible = TRUE;
+
+      if (e->opacity <= 0.0)
+        e->opacity = 1.0;
+
+      if (edge && e->width <= 0.0)
+        e->width = 1.0;
+    }
+  else
+    {
+      chopgimp_vpaint_clear (&e->paint);
+    }
+
+  chopgimp_vlayer_object_changed (layer, target);
+}
diff --git a/app/path/chopgimp-vlivepaint.h b/app/path/chopgimp-vlivepaint.h
new file mode 100644
index 0000000..784f125
--- /dev/null
+++ b/app/path/chopgimp-vlivepaint.h
@@ -0,0 +1,102 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vlivepaint.h — ChopGimp 3.27.7 (lot V6 point 6): « Peinture
+ * dynamique », Illustrator's Live Paint
+ *
+ * A live paint group is a group object of a vector layer whose paths
+ * (kept in its hidden child group « Tracés », livepaint="sources") cut
+ * the plane into regions and segments that are colored separately,
+ * without boolean operations:
+ *
+ *    group  livepaint="group gap=G sig=S"
+ *      path livepaint="face"        a region (fill), bottom → top
+ *      path livepaint="edge src=N"  a piece of path N between two
+ *                                   crossings (stroke)
+ *      group livepaint="sources"    the paths (hidden), last
+ *
+ * Faces and edges are ordinary path objects: they are drawn, selected
+ * (outil Sélection de peinture dynamique), restyled (barre d'options,
+ * Aspect), saved and exported like any object, and an older ChopGimp
+ * sees a plain group. When a path changes (Sélection directe, mode
+ * objets, scripts, undo…), the regions and segments are computed again
+ * (chopgimp_geom_planar) on the next commit of the layer; each keeps the
+ * style of the old region containing its centre (or the old segment of
+ * the same path at the same place). « sig » is the signature of the
+ * paths the regions were computed for (no work when nothing moved).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "chopgimp-vobject.h"
+
+G_BEGIN_DECLS
+
+
+typedef enum
+{
+  CHOPGIMP_LIVEPAINT_NONE,
+  CHOPGIMP_LIVEPAINT_GROUP,
+  CHOPGIMP_LIVEPAINT_SOURCES,
+  CHOPGIMP_LIVEPAINT_FACE,
+  CHOPGIMP_LIVEPAINT_EDGE
+} ChopGimpLivePaintRole;
+
+ChopGimpLivePaintRole chopgimp_vlivepaint_role        (ChopGimpVObject *object);
+/*  the live paint group of @object (itself, or an ancestor), or NULL  */
+ChopGimpVObject     * chopgimp_vlivepaint_group_of    (ChopGimpVObject *object);
+
+/*  called by the layer after each change (chopgimp-vobject.c): computes
+ *  the regions again where the paths changed; TRUE when objects were
+ *  replaced (new ones have id 0)
+ */
+gboolean              chopgimp_vlivepaint_refresh     (GimpVectorLayer *layer);
+
+/*  ─── commands (one undo step each) ─────────────────────────────────── */
+
+/*  « Créer » (Ctrl+Maj+Alt+X): the selected objects (same parent) become
+ *  a live paint group (selected); NULL when not possible
+ */
+gboolean              chopgimp_vlivepaint_can_make    (GimpVectorLayer *layer);
+ChopGimpVObject     * chopgimp_vlivepaint_make        (GimpVectorLayer *layer);
+/*  « Ajouter au groupe »: the other selected objects join the paths of
+ *  the selected live paint group
+ */
+gboolean              chopgimp_vlivepaint_can_add     (GimpVectorLayer *layer);
+gboolean              chopgimp_vlivepaint_add         (GimpVectorLayer *layer);
+/*  a selected object is (in) a live paint group  */
+gboolean              chopgimp_vlivepaint_any         (GimpVectorLayer *layer);
+/*  « Décomposer »: plain groups of the painted regions and segments  */
+gboolean              chopgimp_vlivepaint_expand      (GimpVectorLayer *layer);
+/*  « Libérer »: the paths come back as they were, the colors are lost  */
+gboolean              chopgimp_vlivepaint_release     (GimpVectorLayer *layer);
+/*  « Écarts »: openings narrower than @gap px are closed (0: none);
+ *  the first selected group's gap, -1 when none is selected
+ */
+gdouble               chopgimp_vlivepaint_get_gap     (GimpVectorLayer *layer);
+gboolean              chopgimp_vlivepaint_set_gap     (GimpVectorLayer *layer,
+                                                       gdouble          gap);
+
+/*  ─── tools ─────────────────────────────────────────────────────────── */
+
+/*  the region (smallest one under the point) or, when @edge, the segment
+ *  within @tolerance px of (x, y), image coordinates; NULL if none
+ */
+ChopGimpVObject     * chopgimp_vlivepaint_pick        (GimpVectorLayer *layer,
+                                                       gdouble          x,
+                                                       gdouble          y,
+                                                       gboolean         edge,
+                                                       gdouble          tolerance);
+/*  fills the region / strokes the segment with @color (NULL: removes the
+ *  paint, « aucune »); one undo step
+ */
+void                  chopgimp_vlivepaint_paint       (GimpVectorLayer *layer,
+                                                       ChopGimpVObject *target,
+                                                       GeglColor       *color,
+                                                       gboolean         edge);
+
+
+G_END_DECLS
diff --git a/app/path/chopgimp-vmaterial.c b/app/path/chopgimp-vmaterial.c
new file mode 100644
index 0000000..70aba23
--- /dev/null
+++ b/app/path/chopgimp-vmaterial.c
@@ -0,0 +1,3747 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vmaterial.c — ChopGimp 3.29.1: « couleur et matière » of the
+ * vector objects (see chopgimp-vmaterial.h)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <cairo.h>
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpcolor/gimpcolor.h"
+
+#include "path-types.h"
+
+#include "core/gimpimage.h"
+#include "core/gimpimage-undo.h"
+#include "core/gimpitem.h"
+
+#include "gimpanchor.h"
+#include "gimpbezierstroke.h"
+#include "gimppath.h"
+#include "gimpstroke.h"
+#include "gimpvectorlayer.h"
+
+#include "chopgimp-geom.h"
+#include "chopgimp-vobject.h"
+#include "chopgimp-vutil.h"
+#include "chopgimp-vmaterial.h"
+
+#include "gimp-intl.h"
+
+
+#define VPATTERNS_PARASITE  "chopgimp-vpatterns"
+#define MESH_MAX            32       /* rows / columns                    */
+#define FREEFORM_GRID       20       /* patches per side of the freeform  */
+
+
+/*  ─── colors ────────────────────────────────────────────────────────── */
+
+static void
+hex_to_rgba (const gchar *s,
+             gdouble      rgba[4])
+{
+  guint v[4] = { 0, 0, 0, 255 };
+  gint  n    = 0;
+
+  rgba[0] = rgba[1] = rgba[2] = 0.0;
+  rgba[3] = 1.0;
+
+  if (! s)
+    return;
+
+  while (*s == ' ' || *s == '#')
+    s++;
+
+  for (n = 0; n < 4; n++)
+    {
+      gint hi, lo;
+
+      if (! g_ascii_isxdigit (s[0]) || ! g_ascii_isxdigit (s[1]))
+        break;
+
+      hi = g_ascii_xdigit_value (s[0]);
+      lo = g_ascii_xdigit_value (s[1]);
+      v[n] = (guint) (hi * 16 + lo);
+      s += 2;
+    }
+
+  if (n < 3)
+    return;
+
+  for (gint i = 0; i < 4; i++)
+    rgba[i] = v[i] / 255.0;
+}
+
+static void
+put_hex (GString       *s,
+         const gdouble  rgba[4])
+{
+  g_string_append_printf (s, "#%02x%02x%02x%02x",
+                          (guint) CLAMP (floor (rgba[0] * 255.0 + 0.5), 0, 255),
+                          (guint) CLAMP (floor (rgba[1] * 255.0 + 0.5), 0, 255),
+                          (guint) CLAMP (floor (rgba[2] * 255.0 + 0.5), 0, 255),
+                          (guint) CLAMP (floor (rgba[3] * 255.0 + 0.5), 0, 255));
+}
+
+static void
+put_dbl (GString *s,
+         gdouble  v)
+{
+  gchar buf[G_ASCII_DTOSTR_BUF_SIZE];
+
+  g_string_append (s, g_ascii_formatd (buf, sizeof (buf), "%.5g", v));
+}
+
+/*  sRGB → the image's space (the render works in @space, like the other
+ *  paints of the objects)
+ */
+static void
+to_space (const gdouble  srgb[4],
+          const Babl    *space,
+          gdouble        out[4])
+{
+  const Babl *fish;
+
+  if (! space)
+    {
+      memcpy (out, srgb, sizeof (gdouble) * 4);
+      return;
+    }
+
+  fish = babl_fish (babl_format ("R'G'B'A double"),
+                    babl_format_with_space ("R'G'B'A double", space));
+  babl_process (fish, srgb, out, 1);
+}
+
+static void
+mix (const gdouble a[4],
+     const gdouble b[4],
+     gdouble       t,
+     gdouble       out[4])
+{
+  for (gint i = 0; i < 4; i++)
+    out[i] = a[i] + (b[i] - a[i]) * t;
+}
+
+
+/*  ─── « Filet de dégradé » ──────────────────────────────────────────── */
+
+void
+chopgimp_vmesh_clear (ChopGimpMesh *mesh)
+{
+  g_clear_pointer (&mesh->nodes, g_free);
+  mesh->rows = mesh->cols = 0;
+}
+
+void
+chopgimp_vmesh_edge (const ChopGimpMesh *mesh,
+                     gint                a,
+                     gint                b,
+                     gdouble             c1[2],
+                     gdouble             c2[2])
+{
+  const ChopGimpMeshNode *na  = &mesh->nodes[a];
+  const ChopGimpMeshNode *nb  = &mesh->nodes[b];
+  gboolean                row = ABS (a - b) == 1;
+  gdouble                 sg  = b > a ? 1.0 : -1.0;
+  const gdouble          *ta  = row ? na->th : na->tv;
+  const gdouble          *tb  = row ? nb->th : nb->tv;
+  gdouble                 dx  = nb->x - na->x, dy = nb->y - na->y;
+
+  c1[0] = na->x + dx / 3.0 + sg * ta[0];
+  c1[1] = na->y + dy / 3.0 + sg * ta[1];
+  c2[0] = nb->x - dx / 3.0 - sg * tb[0];
+  c2[1] = nb->y - dy / 3.0 - sg * tb[1];
+}
+
+gboolean
+chopgimp_vmesh_parse (const gchar  *spec,
+                      ChopGimpMesh *mesh)
+{
+  gchar **parts;
+  gint    rows = 0, cols = 0, n;
+  gint    k    = 0;
+
+  memset (mesh, 0, sizeof (ChopGimpMesh));
+
+  if (! spec)
+    return FALSE;
+
+  parts = g_strsplit (spec, ";", -1);
+
+  if (! parts[0] || sscanf (parts[0], "%d %d", &rows, &cols) != 2 ||
+      rows < 1 || cols < 1 || rows > MESH_MAX || cols > MESH_MAX)
+    {
+      g_strfreev (parts);
+      return FALSE;
+    }
+
+  n           = (rows + 1) * (cols + 1);
+  mesh->rows  = rows;
+  mesh->cols  = cols;
+  mesh->nodes = g_new0 (ChopGimpMeshNode, n);
+
+  for (gint i = 1; parts[i] && k < n; i++)
+    {
+      gchar **f = g_strsplit (parts[i], ",", 7);
+
+      if (f[0] && f[1] && f[2])
+        {
+          mesh->nodes[k].x = g_ascii_strtod (f[0], NULL);
+          mesh->nodes[k].y = g_ascii_strtod (f[1], NULL);
+          hex_to_rgba (f[2], mesh->nodes[k].rgba);
+
+          /*  3.29.3: optional tangents « ,thx,thy,tvx,tvy »  */
+          if (f[3] && f[4] && f[5] && f[6])
+            {
+              mesh->nodes[k].th[0] = g_ascii_strtod (f[3], NULL);
+              mesh->nodes[k].th[1] = g_ascii_strtod (f[4], NULL);
+              mesh->nodes[k].tv[0] = g_ascii_strtod (f[5], NULL);
+              mesh->nodes[k].tv[1] = g_ascii_strtod (f[6], NULL);
+            }
+          k++;
+        }
+
+      g_strfreev (f);
+    }
+
+  g_strfreev (parts);
+
+  if (k < n)
+    {
+      chopgimp_vmesh_clear (mesh);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+gchar *
+chopgimp_vmesh_to_spec (const ChopGimpMesh *mesh)
+{
+  GString *s = g_string_new (NULL);
+  gint     n = (mesh->rows + 1) * (mesh->cols + 1);
+
+  g_string_append_printf (s, "%d %d", mesh->rows, mesh->cols);
+
+  for (gint i = 0; i < n; i++)
+    {
+      g_string_append_c (s, ';');
+      put_dbl (s, mesh->nodes[i].x);
+      g_string_append_c (s, ',');
+      put_dbl (s, mesh->nodes[i].y);
+      g_string_append_c (s, ',');
+      put_hex (s, mesh->nodes[i].rgba);
+
+      /*  3.29.3: tangents only when there are some (same spec as before
+       *  for straight meshes)
+       */
+      if (mesh->nodes[i].th[0] != 0.0 || mesh->nodes[i].th[1] != 0.0 ||
+          mesh->nodes[i].tv[0] != 0.0 || mesh->nodes[i].tv[1] != 0.0)
+        {
+          for (gint j = 0; j < 4; j++)
+            {
+              g_string_append_c (s, ',');
+              put_dbl (s, j < 2 ? mesh->nodes[i].th[j] : mesh->nodes[i].tv[j - 2]);
+            }
+        }
+    }
+
+  return g_string_free (s, FALSE);
+}
+
+gchar *
+chopgimp_vmesh_new_spec (gint              rows,
+                         gint              cols,
+                         GeglColor        *color,
+                         ChopGimpMeshLook  look,
+                         gdouble           highlight)
+{
+  ChopGimpMesh  mesh;
+  gdouble       base[4];
+  const gdouble white[4] = { 1, 1, 1, 1 };
+  gchar        *spec;
+
+  rows = CLAMP (rows, 1, MESH_MAX);
+  cols = CLAMP (cols, 1, MESH_MAX);
+  highlight = CLAMP (highlight, 0.0, 1.0);
+
+  chopgimp_color_to_srgb (color, base);
+
+  mesh.rows  = rows;
+  mesh.cols  = cols;
+  mesh.nodes = g_new0 (ChopGimpMeshNode, (rows + 1) * (cols + 1));
+
+  for (gint r = 0; r <= rows; r++)
+    for (gint c = 0; c <= cols; c++)
+      {
+        ChopGimpMeshNode *nd = &mesh.nodes[r * (cols + 1) + c];
+        gdouble           dx, dy, d, t = 0.0;
+
+        nd->x = (gdouble) c / cols;
+        nd->y = (gdouble) r / rows;
+
+        /*  0 at the centre, 1 on the edge  */
+        dx = fabs (nd->x - 0.5) * 2.0;
+        dy = fabs (nd->y - 0.5) * 2.0;
+        d  = MAX (dx, dy);
+
+        if (look == CHOPGIMP_MESH_CENTER)
+          t = (1.0 - d) * highlight;
+        else if (look == CHOPGIMP_MESH_EDGE)
+          t = d * highlight;
+
+        mix (base, white, t, nd->rgba);
+        nd->rgba[3] = base[3];
+      }
+
+  spec = chopgimp_vmesh_to_spec (&mesh);
+  chopgimp_vmesh_clear (&mesh);
+
+  return spec;
+}
+
+gboolean
+chopgimp_vmesh_insert (ChopGimpMesh  *mesh,
+                       gdouble        x,
+                       gdouble        y,
+                       const gdouble *rgba)
+{
+  gint              R = mesh->rows, C = mesh->cols;
+  gint              col = -1, row = -1;
+  gdouble           tc = 0.0, tr = 0.0;
+  ChopGimpMeshNode *nodes;
+
+  if (R >= MESH_MAX || C >= MESH_MAX)
+    return FALSE;
+
+  /*  the column / row whose span contains the point, along the first
+   *  row / column (the mesh lines are close to straight in box units)
+   */
+  for (gint c = 0; c < C; c++)
+    {
+      gdouble x0 = mesh->nodes[c].x, x1 = mesh->nodes[c + 1].x;
+
+      if (x >= MIN (x0, x1) && x <= MAX (x0, x1) && fabs (x1 - x0) > 1e-9)
+        {
+          col = c;
+          tc  = (x - x0) / (x1 - x0);
+          break;
+        }
+    }
+
+  for (gint r = 0; r < R; r++)
+    {
+      gdouble y0 = mesh->nodes[r * (C + 1)].y, y1 = mesh->nodes[(r + 1) * (C + 1)].y;
+
+      if (y >= MIN (y0, y1) && y <= MAX (y0, y1) && fabs (y1 - y0) > 1e-9)
+        {
+          row = r;
+          tr  = (y - y0) / (y1 - y0);
+          break;
+        }
+    }
+
+  if (col < 0 || row < 0)
+    return FALSE;
+
+  nodes = g_new0 (ChopGimpMeshNode, (R + 2) * (C + 2));
+
+  for (gint r = 0; r <= R + 1; r++)
+    for (gint c = 0; c <= C + 1; c++)
+      {
+        ChopGimpMeshNode *nd = &nodes[r * (C + 2) + c];
+        gdouble           fr, fc;
+        gint              r0, c0;
+        ChopGimpMeshNode  a, b, cc, d;
+
+        /*  the position in the old grid  */
+        if (r <= row)            { r0 = r;     fr = 0.0; }
+        else if (r == row + 1)   { r0 = row;   fr = tr;  }
+        else                     { r0 = r - 1; fr = 0.0; }
+
+        if (c <= col)            { c0 = c;     fc = 0.0; }
+        else if (c == col + 1)   { c0 = col;   fc = tc;  }
+        else                     { c0 = c - 1; fc = 0.0; }
+
+        a  = mesh->nodes[r0 * (C + 1) + c0];
+        b  = mesh->nodes[r0 * (C + 1) + MIN (c0 + 1, C)];
+        cc = mesh->nodes[MIN (r0 + 1, R) * (C + 1) + c0];
+        d  = mesh->nodes[MIN (r0 + 1, R) * (C + 1) + MIN (c0 + 1, C)];
+
+        nd->x = (a.x * (1 - fc) + b.x * fc) * (1 - fr) + (cc.x * (1 - fc) + d.x * fc) * fr;
+        nd->y = (a.y * (1 - fc) + b.y * fc) * (1 - fr) + (cc.y * (1 - fc) + d.y * fc) * fr;
+
+        for (gint i = 0; i < 4; i++)
+          nd->rgba[i] = (a.rgba[i] * (1 - fc) + b.rgba[i] * fc) * (1 - fr) +
+                        (cc.rgba[i] * (1 - fc) + d.rgba[i] * fc) * fr;
+
+        /*  3.29.3: an old node keeps its tangents  */
+        if (fr == 0.0 && fc == 0.0)
+          {
+            memcpy (nd->th, a.th, sizeof (nd->th));
+            memcpy (nd->tv, a.tv, sizeof (nd->tv));
+          }
+
+        /*  the clicked node takes the color  */
+        if (rgba && r == row + 1 && c == col + 1)
+          memcpy (nd->rgba, rgba, sizeof (gdouble) * 4);
+      }
+
+  g_free (mesh->nodes);
+  mesh->nodes = nodes;
+  mesh->rows  = R + 1;
+  mesh->cols  = C + 1;
+
+  return TRUE;
+}
+
+/*  adds one Coons patch: corners @p, the control points of side i
+ *  (from corner i to corner i + 1) @ctl[i] (3.29.3: tangents), corner
+ *  colors @col
+ */
+static void
+mesh_patch (cairo_pattern_t *pat,
+            const gdouble    p[4][2],
+            const gdouble    ctl[4][4],
+            const gdouble    col[4][4])
+{
+  cairo_mesh_pattern_begin_patch (pat);
+  cairo_mesh_pattern_move_to (pat, p[0][0], p[0][1]);
+
+  for (gint i = 1; i <= 4; i++)
+    {
+      const gdouble *b = p[i % 4];
+      const gdouble *c = ctl[i - 1];
+
+      cairo_mesh_pattern_curve_to (pat, c[0], c[1], c[2], c[3], b[0], b[1]);
+    }
+
+  for (gint i = 0; i < 4; i++)
+    cairo_mesh_pattern_set_corner_color_rgba (pat, i, col[i][0], col[i][1],
+                                              col[i][2], col[i][3]);
+
+  cairo_mesh_pattern_end_patch (pat);
+}
+
+static cairo_pattern_t *
+mesh_source (const gchar   *spec,
+             const Babl    *space,
+             const gdouble  box[4])
+{
+  ChopGimpMesh     m;
+  cairo_pattern_t *pat;
+
+  if (! chopgimp_vmesh_parse (spec, &m))
+    return NULL;
+
+  pat = cairo_pattern_create_mesh ();
+
+  for (gint r = 0; r < m.rows; r++)
+    for (gint c = 0; c < m.cols; c++)
+      {
+        const ChopGimpMeshNode *n[4];
+        gint                    k[4];
+        gdouble                 p[4][2], ctl[4][4], col[4][4];
+        gdouble                 w = box[2] - box[0], h = box[3] - box[1];
+
+        k[0] = r * (m.cols + 1) + c;
+        k[1] = r * (m.cols + 1) + c + 1;
+        k[2] = (r + 1) * (m.cols + 1) + c + 1;
+        k[3] = (r + 1) * (m.cols + 1) + c;
+
+        for (gint i = 0; i < 4; i++)
+          {
+            gdouble c1[2], c2[2];
+
+            n[i]    = &m.nodes[k[i]];
+            p[i][0] = box[0] + n[i]->x * w;
+            p[i][1] = box[1] + n[i]->y * h;
+            to_space (n[i]->rgba, space, col[i]);
+
+            chopgimp_vmesh_edge (&m, k[i], k[(i + 1) % 4], c1, c2);
+            ctl[i][0] = box[0] + c1[0] * w;
+            ctl[i][1] = box[1] + c1[1] * h;
+            ctl[i][2] = box[0] + c2[0] * w;
+            ctl[i][3] = box[1] + c2[1] * h;
+          }
+
+        mesh_patch (pat, p, ctl, col);
+      }
+
+  chopgimp_vmesh_clear (&m);
+
+  return pat;
+}
+
+
+/*  ─── « Dégradé libre » ─────────────────────────────────────────────── */
+
+GArray *
+chopgimp_vfreeform_parse (const gchar *spec)
+{
+  GArray  *pts;
+  gchar  **parts;
+
+  if (! spec)
+    return NULL;
+
+  pts   = g_array_new (FALSE, TRUE, sizeof (ChopGimpMeshNode));
+  parts = g_strsplit (spec, ";", -1);
+
+  for (gint i = 0; parts[i]; i++)
+    {
+      gchar          **f = g_strsplit (parts[i], ",", 4);
+      ChopGimpMeshNode nd = { 0, };
+
+      if (f[0] && f[1] && f[2])
+        {
+          nd.x    = g_ascii_strtod (f[0], NULL);
+          nd.y    = g_ascii_strtod (f[1], NULL);
+          hex_to_rgba (f[2], nd.rgba);
+          /*  3.29.5: « x,y,#rrggbbaa,l »: joined to the previous point  */
+          nd.link = (f[3] && f[3][0] == 'l' && pts->len > 0);
+          g_array_append_val (pts, nd);
+        }
+
+      g_strfreev (f);
+    }
+
+  g_strfreev (parts);
+
+  if (pts->len == 0)
+    {
+      g_array_free (pts, TRUE);
+      return NULL;
+    }
+
+  return pts;
+}
+
+gchar *
+chopgimp_vfreeform_to_spec (GArray *points)
+{
+  GString *s = g_string_new ("points");
+
+  for (guint i = 0; points && i < points->len; i++)
+    {
+      ChopGimpMeshNode *nd = &g_array_index (points, ChopGimpMeshNode, i);
+
+      g_string_append_c (s, ';');
+      put_dbl (s, nd->x);
+      g_string_append_c (s, ',');
+      put_dbl (s, nd->y);
+      g_string_append_c (s, ',');
+      put_hex (s, nd->rgba);
+
+      if (nd->link && i > 0)
+        g_string_append (s, ",l");
+    }
+
+  return g_string_free (s, FALSE);
+}
+
+gchar *
+chopgimp_vfreeform_new_spec (GeglColor *color,
+                             GeglColor *other)
+{
+  GArray          *pts = g_array_new (FALSE, TRUE, sizeof (ChopGimpMeshNode));
+  gdouble          a[4], b[4];
+  const gdouble    xy[4][2] = { { 0.2, 0.2 }, { 0.8, 0.25 }, { 0.75, 0.8 }, { 0.25, 0.75 } };
+  gchar           *spec;
+
+  chopgimp_color_to_srgb (color, a);
+
+  if (other)
+    chopgimp_color_to_srgb (other, b);
+  else
+    {
+      const gdouble white[4] = { 1, 1, 1, 1 };
+
+      mix (a, white, 0.6, b);
+    }
+
+  for (gint i = 0; i < 4; i++)
+    {
+      ChopGimpMeshNode nd = { 0, };
+
+      nd.x = xy[i][0];
+      nd.y = xy[i][1];
+      mix (a, b, (i % 2) ? 1.0 : 0.0, nd.rgba);
+      g_array_append_val (pts, nd);
+    }
+
+  spec = chopgimp_vfreeform_to_spec (pts);
+  g_array_free (pts, TRUE);
+
+  return spec;
+}
+
+/*  inverse distance weighting (power 2) of the points at (x, y)  */
+static void
+freeform_color (GArray  *pts,
+                gdouble  x,
+                gdouble  y,
+                gdouble  rgba[4])
+{
+  gdouble sum = 0.0;
+  gdouble acc[4] = { 0, 0, 0, 0 };
+
+  /*  3.29.5: mode Lignes: each line is a source whose color is the one
+   *  of its nearest point (between the colors of its two ends); the
+   *  points of a line are not counted again on their own
+   */
+  for (guint i = 1; i < pts->len; i++)
+    {
+      ChopGimpMeshNode *a = &g_array_index (pts, ChopGimpMeshNode, i - 1);
+      ChopGimpMeshNode *b = &g_array_index (pts, ChopGimpMeshNode, i);
+      gdouble           ex, ey, l2, u, qx, qy, d2, w;
+
+      if (! b->link)
+        continue;
+
+      ex = b->x - a->x;
+      ey = b->y - a->y;
+      l2 = ex * ex + ey * ey;
+      u  = l2 > 1e-12 ? CLAMP (((x - a->x) * ex + (y - a->y) * ey) / l2, 0.0, 1.0) : 0.0;
+      qx = a->x + u * ex;
+      qy = a->y + u * ey;
+      d2 = (qx - x) * (qx - x) + (qy - y) * (qy - y);
+
+      if (d2 < 1e-10)
+        {
+          for (gint k = 0; k < 4; k++)
+            rgba[k] = a->rgba[k] + (b->rgba[k] - a->rgba[k]) * u;
+          return;
+        }
+
+      w    = 1.0 / d2;
+      sum += w;
+
+      for (gint k = 0; k < 4; k++)
+        acc[k] += (a->rgba[k] + (b->rgba[k] - a->rgba[k]) * u) * w;
+    }
+
+  for (guint i = 0; i < pts->len; i++)
+    {
+      ChopGimpMeshNode *nd = &g_array_index (pts, ChopGimpMeshNode, i);
+      gdouble           d2 = (nd->x - x) * (nd->x - x) + (nd->y - y) * (nd->y - y);
+      gdouble           w;
+
+      if (nd->link ||
+          (i + 1 < pts->len && g_array_index (pts, ChopGimpMeshNode, i + 1).link))
+        continue;
+
+      if (d2 < 1e-10)
+        {
+          memcpy (rgba, nd->rgba, sizeof (gdouble) * 4);
+          return;
+        }
+
+      w    = 1.0 / d2;
+      sum += w;
+
+      for (gint k = 0; k < 4; k++)
+        acc[k] += nd->rgba[k] * w;
+    }
+
+  for (gint k = 0; k < 4; k++)
+    rgba[k] = sum > 0 ? acc[k] / sum : 0.0;
+}
+
+static cairo_pattern_t *
+freeform_source (const gchar   *spec,
+                 const Babl    *space,
+                 const gdouble  box[4])
+{
+  GArray          *pts;
+  cairo_pattern_t *pat;
+  const gint       G = FREEFORM_GRID;
+  gdouble         *grid;
+
+  /*  « points;… »  */
+  if (! spec || strncmp (spec, "points", 6))
+    return NULL;
+
+  pts = chopgimp_vfreeform_parse (spec + 6);
+
+  if (! pts)
+    return NULL;
+
+  grid = g_new (gdouble, (G + 1) * (G + 1) * 4);
+
+  /*  a slightly larger area than the box: the fill may go past it  */
+  for (gint r = 0; r <= G; r++)
+    for (gint c = 0; c <= G; c++)
+      {
+        gdouble srgb[4];
+        gdouble u = -0.1 + 1.2 * c / G, v = -0.1 + 1.2 * r / G;
+
+        freeform_color (pts, u, v, srgb);
+        to_space (srgb, space, &grid[(r * (G + 1) + c) * 4]);
+      }
+
+  pat = cairo_pattern_create_mesh ();
+
+  for (gint r = 0; r < G; r++)
+    for (gint c = 0; c < G; c++)
+      {
+        gdouble p[4][2], col[4][4];
+        gint    idx[4][2] = { { r, c }, { r, c + 1 }, { r + 1, c + 1 }, { r + 1, c } };
+
+        for (gint i = 0; i < 4; i++)
+          {
+            gdouble u = -0.1 + 1.2 * idx[i][1] / G, v = -0.1 + 1.2 * idx[i][0] / G;
+
+            p[i][0] = box[0] + u * (box[2] - box[0]);
+            p[i][1] = box[1] + v * (box[3] - box[1]);
+            memcpy (col[i], &grid[(idx[i][0] * (G + 1) + idx[i][1]) * 4],
+                    sizeof (gdouble) * 4);
+          }
+
+        {
+          gdouble ctl[4][4];
+
+          for (gint i = 0; i < 4; i++)
+            {
+              const gdouble *a = p[i], *b = p[(i + 1) % 4];
+
+              ctl[i][0] = a[0] + (b[0] - a[0]) / 3.0;
+              ctl[i][1] = a[1] + (b[1] - a[1]) / 3.0;
+              ctl[i][2] = a[0] + (b[0] - a[0]) * 2.0 / 3.0;
+              ctl[i][3] = a[1] + (b[1] - a[1]) * 2.0 / 3.0;
+            }
+
+          mesh_patch (pat, p, ctl, col);
+        }
+      }
+
+  g_free (grid);
+  g_array_free (pts, TRUE);
+
+  return pat;
+}
+
+
+/*  ─── vector patterns ───────────────────────────────────────────────── */
+
+void
+chopgimp_vpattern_clear (ChopGimpVPattern *pattern)
+{
+  g_clear_pointer (&pattern->name, g_free);
+  g_clear_pointer (&pattern->xml, g_free);
+}
+
+gboolean
+chopgimp_vpattern_parse (const gchar      *spec,
+                         ChopGimpVPattern *pattern)
+{
+  const gchar  *bar;
+  gchar        *head;
+  gchar       **words;
+
+  memset (pattern, 0, sizeof (ChopGimpVPattern));
+  pattern->w = pattern->h = 20.0;
+
+  if (! spec || ! (bar = strchr (spec, '|')))
+    return FALSE;
+
+  head  = g_strndup (spec, bar - spec);
+  words = g_strsplit (head, " ", -1);
+
+  for (gint i = 0; words[i]; i++)
+    {
+      gchar *eq = strchr (words[i], '=');
+
+      if (! eq)
+        continue;
+
+      *eq = '\0';
+
+      if (! strcmp (words[i], "type"))
+        pattern->type = (! strcmp (eq + 1, "brick-row")    ? CHOPGIMP_VPATTERN_BRICK_ROW    :
+                         ! strcmp (eq + 1, "brick-column") ? CHOPGIMP_VPATTERN_BRICK_COLUMN :
+                         ! strcmp (eq + 1, "hex")          ? CHOPGIMP_VPATTERN_HEX          :
+                                                             CHOPGIMP_VPATTERN_GRID);
+      else if (! strcmp (words[i], "w"))
+        pattern->w = MAX (1.0, g_ascii_strtod (eq + 1, NULL));
+      else if (! strcmp (words[i], "h"))
+        pattern->h = MAX (1.0, g_ascii_strtod (eq + 1, NULL));
+      else if (! strcmp (words[i], "hs"))
+        pattern->hspace = g_ascii_strtod (eq + 1, NULL);
+      else if (! strcmp (words[i], "vs"))
+        pattern->vspace = g_ascii_strtod (eq + 1, NULL);
+      else if (! strcmp (words[i], "dim"))
+        pattern->dim = CLAMP (g_ascii_strtod (eq + 1, NULL), 0.0, 1.0);
+      else if (! strcmp (words[i], "name"))
+        pattern->name = g_uri_unescape_string (eq + 1, NULL);
+    }
+
+  g_strfreev (words);
+  g_free (head);
+
+  pattern->xml = g_strdup (bar + 1);
+
+  return pattern->xml && *pattern->xml;
+}
+
+gchar *
+chopgimp_vpattern_to_spec (const ChopGimpVPattern *p)
+{
+  static const gchar *types[] = { "grid", "brick-row", "brick-column", "hex" };
+  GString            *s       = g_string_new (NULL);
+  gchar              *name    = g_uri_escape_string (p->name ? p->name : "", NULL, FALSE);
+
+  g_string_append_printf (s, "type=%s w=", types[CLAMP (p->type, 0, 3)]);
+  put_dbl (s, p->w);
+  g_string_append (s, " h=");
+  put_dbl (s, p->h);
+  g_string_append (s, " hs=");
+  put_dbl (s, p->hspace);
+  g_string_append (s, " vs=");
+  put_dbl (s, p->vspace);
+  g_string_append (s, " dim=");
+  put_dbl (s, p->dim);
+  g_string_append_printf (s, " name=%s|%s", name, p->xml ? p->xml : "");
+  g_free (name);
+
+  return g_string_free (s, FALSE);
+}
+
+/*  the cell of the repetition and the offsets of the copies in it  */
+static void
+pattern_cell (const ChopGimpVPattern *p,
+              gdouble                *cw,
+              gdouble                *ch,
+              gdouble                 offs[3][2],
+              gint                   *n_offs)
+{
+  gdouble sx = MAX (1.0, p->w + p->hspace);
+  gdouble sy = MAX (1.0, p->h + p->vspace);
+
+  offs[0][0] = offs[0][1] = 0.0;
+  *n_offs = 1;
+
+  switch (p->type)
+    {
+    case CHOPGIMP_VPATTERN_BRICK_ROW:
+      *cw = sx;
+      *ch = 2 * sy;
+      offs[1][0] = sx / 2;   offs[1][1] = sy;
+      offs[2][0] = -sx / 2;  offs[2][1] = sy;
+      *n_offs = 3;
+      break;
+
+    case CHOPGIMP_VPATTERN_BRICK_COLUMN:
+      *cw = 2 * sx;
+      *ch = sy;
+      offs[1][0] = sx;  offs[1][1] = sy / 2;
+      offs[2][0] = sx;  offs[2][1] = -sy / 2;
+      *n_offs = 3;
+      break;
+
+    case CHOPGIMP_VPATTERN_HEX:
+      /*  hexagons by column: columns 3/4 apart, every other one half a
+       *  tile lower
+       */
+      *cw = 1.5 * sx;
+      *ch = sy;
+      offs[1][0] = 0.75 * sx;  offs[1][1] = sy / 2;
+      offs[2][0] = 0.75 * sx;  offs[2][1] = -sy / 2;
+      *n_offs = 3;
+      break;
+
+    default:
+      *cw = sx;
+      *ch = sy;
+      break;
+    }
+}
+
+/*  the rendering of a pattern's cell (a cache by spec: a pattern is drawn
+ *  every time an object using it is)
+ */
+static GHashTable *pattern_cache = NULL;
+static gint        pattern_depth = 0;
+/*  3.29.6: the cache is read from the threads of the parallel
+ *  rasterization (the cells are made beforehand, on the main thread, and
+ *  kept while pinned)
+ */
+static GMutex      pattern_lock;
+static gint        pattern_pinned = 0;
+
+static cairo_surface_t *
+pattern_cell_surface (const gchar *spec,
+                      GimpImage   *image,
+                      gdouble     *cw,
+                      gdouble     *ch)
+{
+  ChopGimpVPattern  p;
+  cairo_surface_t  *surf;
+  ChopGimpVObject  *root;
+  gdouble           offs[3][2];
+  gint              n_offs, iw, ih;
+  gchar            *key;
+  cairo_t          *cr;
+
+  if (! chopgimp_vpattern_parse (spec, &p))
+    return NULL;
+
+  pattern_cell (&p, cw, ch, offs, &n_offs);
+
+  key = g_compute_checksum_for_string (G_CHECKSUM_MD5, spec, -1);
+
+  g_mutex_lock (&pattern_lock);
+
+  if (! pattern_cache)
+    pattern_cache = g_hash_table_new_full (g_str_hash, g_str_equal, g_free,
+                                           (GDestroyNotify) cairo_surface_destroy);
+
+  surf = g_hash_table_lookup (pattern_cache, key);
+  if (surf)
+    surf = cairo_surface_reference (surf);
+
+  g_mutex_unlock (&pattern_lock);
+
+  if (surf)
+    {
+      g_free (key);
+      chopgimp_vpattern_clear (&p);
+      return surf;
+    }
+
+  /*  no pattern inside its own pattern  */
+  if (pattern_depth > 2 || ! image)
+    {
+      g_free (key);
+      chopgimp_vpattern_clear (&p);
+      return NULL;
+    }
+
+  pattern_depth++;
+  root = chopgimp_vobjects_from_xml (image, p.xml);
+  pattern_depth--;
+
+  iw = MAX (1, (gint) ceil (*cw));
+  ih = MAX (1, (gint) ceil (*ch));
+
+  surf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32, iw, ih);
+  cr   = cairo_create (surf);
+
+  /*  each copy, and its neighbours (a tile larger than its cell)  */
+  pattern_depth++;
+  for (gint k = 0; root && k < n_offs; k++)
+    for (gint dy = -1; dy <= 1; dy++)
+      for (gint dx = -1; dx <= 1; dx++)
+        {
+          cairo_save (cr);
+          cairo_translate (cr, offs[k][0] + dx * *cw, offs[k][1] + dy * *ch);
+          chopgimp_vobject_draw_preview (root, cr);
+          cairo_restore (cr);
+        }
+  pattern_depth--;
+
+  cairo_destroy (cr);
+
+  if (root)
+    chopgimp_vobject_unref (root);
+
+  g_mutex_lock (&pattern_lock);
+
+  if (! pattern_pinned && g_hash_table_size (pattern_cache) > 64)
+    g_hash_table_remove_all (pattern_cache);
+
+  g_hash_table_insert (pattern_cache, key, cairo_surface_reference (surf));
+
+  g_mutex_unlock (&pattern_lock);
+
+  chopgimp_vpattern_clear (&p);
+
+  return surf;
+}
+
+gboolean
+chopgimp_vmaterial_prepare_pattern (const ChopGimpPaint *paint,
+                                    GimpPath            *local)
+{
+  cairo_surface_t *surf;
+  gdouble          cw, ch;
+
+  if (! paint || paint->type != CHOPGIMP_PAINT_VPATTERN || ! paint->material)
+    return TRUE;
+
+  surf = pattern_cell_surface (paint->material,
+                               local ? gimp_item_get_image (GIMP_ITEM (local)) : NULL,
+                               &cw, &ch);
+  if (! surf)
+    return FALSE;
+
+  cairo_surface_destroy (surf);
+
+  return TRUE;
+}
+
+void
+chopgimp_vmaterial_pin_patterns (gboolean pin)
+{
+  g_mutex_lock (&pattern_lock);
+  pattern_pinned = MAX (0, pattern_pinned + (pin ? 1 : -1));
+  g_mutex_unlock (&pattern_lock);
+}
+
+static cairo_pattern_t *
+vpattern_source (const gchar          *spec,
+                 GimpImage            *image,
+                 const cairo_matrix_t *world)
+{
+  cairo_surface_t *surf;
+  cairo_pattern_t *pat;
+  gdouble          cw, ch;
+  cairo_matrix_t   m;
+
+  surf = pattern_cell_surface (spec, image, &cw, &ch);
+
+  if (! surf)
+    return NULL;
+
+  pat = cairo_pattern_create_for_surface (surf);
+  cairo_surface_destroy (surf);
+
+  cairo_pattern_set_extend (pat, CAIRO_EXTEND_REPEAT);
+
+  /*  tiled in image space (like the bitmap patterns): the pattern matrix
+   *  maps user (local) space to pattern space = image space
+   */
+  if (world)
+    {
+      m = *world;
+      cairo_pattern_set_matrix (pat, &m);
+    }
+
+  return pat;
+}
+
+void
+chopgimp_vpattern_draw (const ChopGimpVPattern *pattern,
+                        GimpImage              *image,
+                        cairo_t                *cr,
+                        gdouble                 width,
+                        gdouble                 height)
+{
+  gchar           *spec = chopgimp_vpattern_to_spec (pattern);
+  cairo_pattern_t *pat  = vpattern_source (spec, image, NULL);
+
+  g_free (spec);
+
+  if (! pat)
+    return;
+
+  cairo_save (cr);
+  cairo_rectangle (cr, 0, 0, width, height);
+  cairo_set_source (cr, pat);
+  cairo_fill (cr);
+
+  /*  « copies estompées »: the copies around the first tile are dimmed,
+   *  as in Illustrator's pattern editing mode
+   */
+  if (pattern->dim > 0.0)
+    {
+      cairo_set_source_rgba (cr, 1, 1, 1, pattern->dim);
+      cairo_rectangle (cr, 0, 0, width, height);
+      cairo_rectangle (cr, 0, 0, pattern->w, pattern->h);
+      cairo_set_fill_rule (cr, CAIRO_FILL_RULE_EVEN_ODD);
+      cairo_fill (cr);
+    }
+
+  cairo_restore (cr);
+  cairo_pattern_destroy (pat);
+}
+
+
+/*  ─── rendering ─────────────────────────────────────────────────────── */
+
+cairo_pattern_t *
+chopgimp_vmaterial_make_source (const ChopGimpPaint  *paint,
+                                const Babl           *space,
+                                GimpPath             *local,
+                                const gdouble         box[4],
+                                const cairo_matrix_t *world)
+{
+  if (! paint || ! paint->material)
+    return NULL;
+
+  switch (paint->type)
+    {
+    case CHOPGIMP_PAINT_MESH:
+      return mesh_source (paint->material, space, box);
+
+    case CHOPGIMP_PAINT_FREEFORM:
+      return freeform_source (paint->material, space, box);
+
+    case CHOPGIMP_PAINT_VPATTERN:
+      return vpattern_source (paint->material,
+                              local ? gimp_item_get_image (GIMP_ITEM (local)) : NULL,
+                              world);
+
+    default:
+      return NULL;
+    }
+}
+
+/*  the color of a gradient paint at @t (0..1), in @space  */
+static void
+gradient_at (const ChopGimpPaint *p,
+             gdouble              t,
+             const Babl          *space,
+             gdouble              out[4])
+{
+  ChopGimpGradientStop *a = NULL, *b = NULL;
+  gdouble               ca[4], cb[4], srgb[4];
+
+  t = CLAMP (t, 0.0, 1.0);
+
+  for (guint i = 0; i < p->stops->len; i++)
+    {
+      ChopGimpGradientStop *st = &g_array_index (p->stops, ChopGimpGradientStop, i);
+
+      if (st->offset <= t)
+        a = st;
+      if (st->offset >= t && ! b)
+        b = st;
+    }
+
+  if (! a)
+    a = b;
+  if (! b)
+    b = a;
+
+  chopgimp_color_to_srgb (a->color, ca);
+  chopgimp_color_to_srgb (b->color, cb);
+
+  if (b->offset - a->offset > 1e-9)
+    mix (ca, cb, (t - a->offset) / (b->offset - a->offset), srgb);
+  else
+    memcpy (srgb, ca, sizeof (srgb));
+
+  to_space (srgb, space, out);
+}
+
+/*  3.29.5: a width profile « t:w » / « t:l/r » as sorted triples (t, l, r)  */
+static GArray *
+profile_parse (const gchar *profile)
+{
+  GArray  *a;
+  gchar  **items;
+
+  if (! profile || ! *profile || ! strcmp (profile, "uniform"))
+    return NULL;
+
+  a     = g_array_new (FALSE, FALSE, sizeof (gdouble) * 3);
+  items = g_strsplit (profile, ",", -1);
+
+  for (gint i = 0; items[i]; i++)
+    {
+      gchar   *colon = strchr (items[i], ':');
+      gchar   *slash;
+      gdouble  v[3];
+
+      if (! colon)
+        continue;
+
+      v[0]  = CLAMP (g_ascii_strtod (items[i], NULL), 0.0, 1.0);
+      v[1]  = MAX (0.0, g_ascii_strtod (colon + 1, NULL));
+      slash = strchr (colon + 1, '/');
+      v[2]  = slash ? MAX (0.0, g_ascii_strtod (slash + 1, NULL)) : v[1];
+
+      /*  sorted insertion  */
+      {
+        guint k = 0;
+
+        while (k < a->len && ((gdouble *) a->data)[k * 3] <= v[0])
+          k++;
+        g_array_insert_vals (a, k, v, 1);
+      }
+    }
+
+  g_strfreev (items);
+
+  if (a->len == 0)
+    {
+      g_array_free (a, TRUE);
+      return NULL;
+    }
+
+  return a;
+}
+
+/*  the left / right width factors at @t, smooth (cosine) between the
+ *  points like the profile outline (chopgimp-geom.cc width_profile_side)
+ */
+static void
+profile_at (GArray  *a,
+            gdouble  t,
+            gdouble *l,
+            gdouble *r)
+{
+  gdouble *v = (gdouble *) a->data;
+  guint    n = a->len;
+
+  if (t <= v[0])
+    {
+      *l = v[1]; *r = v[2];
+      return;
+    }
+
+  if (t >= v[(n - 1) * 3])
+    {
+      *l = v[(n - 1) * 3 + 1]; *r = v[(n - 1) * 3 + 2];
+      return;
+    }
+
+  for (guint i = 1; i < n; i++)
+    if (t <= v[i * 3])
+      {
+        gdouble u = (t - v[(i - 1) * 3]) / MAX (1e-9, v[i * 3] - v[(i - 1) * 3]);
+
+        u  = (1 - cos (u * G_PI)) / 2;
+        *l = v[(i - 1) * 3 + 1] + u * (v[i * 3 + 1] - v[(i - 1) * 3 + 1]);
+        *r = v[(i - 1) * 3 + 2] + u * (v[i * 3 + 2] - v[(i - 1) * 3 + 2]);
+        return;
+      }
+
+  *l = v[(n - 1) * 3 + 1];
+  *r = v[(n - 1) * 3 + 2];
+}
+
+void
+chopgimp_vmaterial_stroke_gradient (cairo_t             *cr,
+                                    cairo_path_t        *flat,
+                                    const ChopGimpPaint *paint,
+                                    gint                 mode,
+                                    gdouble              width,
+                                    const Babl          *space)
+{
+  chopgimp_vmaterial_stroke_gradient_profile (cr, flat, paint, mode, width, NULL, space);
+}
+
+void
+chopgimp_vmaterial_stroke_gradient_profile (cairo_t             *cr,
+                                            cairo_path_t        *flat,
+                                            const ChopGimpPaint *paint,
+                                            gint                 mode,
+                                            gdouble              width,
+                                            const gchar         *profile,
+                                            const Babl          *space)
+{
+  gint    i = 0;
+  GArray *prof;
+
+  if (! flat || ! paint || ! paint->stops || paint->stops->len == 0)
+    return;
+
+  prof = (mode == 2 && ! g_getenv ("CHOPGIMP_NO_LOCAL_ACROSS")) ? profile_parse (profile) : NULL;
+
+  /*  sub-path by sub-path: its length, then its segments  */
+  while (i < flat->num_data)
+    {
+      GArray  *pts = g_array_new (FALSE, FALSE, sizeof (gdouble) * 2);
+      gdouble  total = 0.0, run = 0.0;
+      gboolean closed = FALSE;
+      gint     j = i;
+
+      for (; j < flat->num_data; j += flat->data[j].header.length)
+        {
+          cairo_path_data_t *d = &flat->data[j];
+          gdouble            pt[2];
+
+          if (d->header.type == CAIRO_PATH_MOVE_TO && pts->len > 0)
+            break;
+
+          if (d->header.type == CAIRO_PATH_CLOSE_PATH)
+            {
+              closed = TRUE;
+              continue;
+            }
+
+          pt[0] = d[1].point.x;
+          pt[1] = d[1].point.y;
+          g_array_append_vals (pts, pt, 1);
+        }
+
+      if (closed && pts->len > 1)
+        {
+          gdouble pt[2];
+
+          memcpy (pt, &g_array_index (pts, gdouble, 0), sizeof (pt));
+          g_array_append_vals (pts, pt, 1);
+        }
+
+      for (guint k = 1; k < pts->len; k++)
+        {
+          gdouble *a = &((gdouble *) pts->data)[(k - 1) * 2];
+          gdouble *b = &((gdouble *) pts->data)[k * 2];
+
+          total += hypot (b[0] - a[0], b[1] - a[1]);
+        }
+
+      for (guint k = 1; total > 0 && k < pts->len; k++)
+        {
+          gdouble *a   = &((gdouble *) pts->data)[(k - 1) * 2];
+          gdouble *b   = &((gdouble *) pts->data)[k * 2];
+          gdouble  len = hypot (b[0] - a[0], b[1] - a[1]);
+          gdouble  rgba[4];
+
+          if (len < 1e-9)
+            continue;
+
+          if (mode == 1)
+            {
+              /*  along: the color of the middle of the segment, with a
+               *  round join over the previous one (no seams)
+               */
+              /*  3.29.1 finition: a long straight segment in pieces of
+               *  2 px at most (one color per piece, butt ends between
+               *  pieces of the same segment)
+               */
+              gint             np  = MAX (1, (gint) ceil (len / 2.0));
+              cairo_line_cap_t cap = cairo_get_line_cap (cr);
+
+              for (gint j = 0; j < np; j++)
+                {
+                  gdouble u0 = (gdouble) j / np;
+                  gdouble u1 = (gdouble) (j + 1) / np;
+
+                  gradient_at (paint, (run + len * (u0 + u1) / 2) / total, space, rgba);
+                  cairo_set_source_rgba (cr, rgba[0], rgba[1], rgba[2], rgba[3]);
+                  /*  the first and last pieces of an open path keep its
+                   *  own cap (a round end stays round)
+                   */
+                  cairo_set_line_cap (cr,
+                                      (! closed && k + 1 == pts->len && j == np - 1) ? cap :
+                                      j > 0 ? CAIRO_LINE_CAP_BUTT :
+                                      (k == 1 && ! closed) ? cap :
+                                      CAIRO_LINE_CAP_ROUND);
+                  cairo_move_to (cr, a[0] + (b[0] - a[0]) * u0, a[1] + (b[1] - a[1]) * u0);
+                  cairo_line_to (cr, a[0] + (b[0] - a[0]) * u1, a[1] + (b[1] - a[1]) * u1);
+                  cairo_stroke (cr);
+                }
+
+              cairo_set_line_cap (cr, cap);
+            }
+          else
+            {
+              /*  across: a linear gradient perpendicular to the segment  */
+              gdouble          ux = -(b[1] - a[1]) / len;
+              gdouble          uy =  (b[0] - a[0]) / len;
+              gdouble          wl = width / 2, wr = width / 2;
+              cairo_pattern_t *g;
+
+              /*  3.29.5: the local width of a profiled stroke, from its
+               *  left edge to its right edge (the middle of the segment)
+               */
+              if (prof)
+                {
+                  gdouble fl, fr;
+
+                  profile_at (prof, (run + len / 2) / total, &fl, &fr);
+                  wl = MAX (0.25, width * fl / 2);
+                  wr = MAX (0.25, width * fr / 2);
+                  cairo_set_line_width (cr, 2 * MAX (wl, wr) + 2);
+                }
+
+              g = cairo_pattern_create_linear (a[0] + ux * wl, a[1] + uy * wl,
+                                               a[0] - ux * wr, a[1] - uy * wr);
+
+              for (guint s = 0; s < paint->stops->len; s++)
+                {
+                  ChopGimpGradientStop *st = &g_array_index (paint->stops,
+                                                             ChopGimpGradientStop, s);
+                  gdouble               srgb[4];
+
+                  chopgimp_color_to_srgb (st->color, srgb);
+                  to_space (srgb, space, rgba);
+                  cairo_pattern_add_color_stop_rgba (g, st->offset, rgba[0], rgba[1],
+                                                     rgba[2], rgba[3]);
+                }
+
+              cairo_set_source (cr, g);
+              cairo_set_line_cap (cr, CAIRO_LINE_CAP_ROUND);
+              cairo_move_to (cr, a[0], a[1]);
+              cairo_line_to (cr, b[0], b[1]);
+              cairo_stroke (cr);
+              cairo_pattern_destroy (g);
+            }
+
+          run += len;
+        }
+
+      g_array_free (pts, TRUE);
+      i = MAX (j, i + 1);
+    }
+
+  if (prof)
+    g_array_free (prof, TRUE);
+}
+
+cairo_surface_t *
+chopgimp_vmaterial_luminance_mask (cairo_surface_t *argb,
+                                   gint             flags)
+{
+  gint             w, h, sstride, dstride;
+  guchar          *src, *dst;
+  cairo_surface_t *a8;
+
+  if (! argb || cairo_surface_status (argb) != CAIRO_STATUS_SUCCESS)
+    return NULL;
+
+  cairo_surface_flush (argb);
+
+  w       = cairo_image_surface_get_width  (argb);
+  h       = cairo_image_surface_get_height (argb);
+  sstride = cairo_image_surface_get_stride (argb);
+  src     = cairo_image_surface_get_data   (argb);
+
+  a8      = cairo_image_surface_create (CAIRO_FORMAT_A8, w, h);
+  dstride = cairo_image_surface_get_stride (a8);
+  dst     = cairo_image_surface_get_data   (a8);
+
+  cairo_surface_flush (a8);
+
+  for (gint y = 0; y < h; y++)
+    {
+      const guint32 *s = (const guint32 *) (src + y * sstride);
+      guchar        *d = dst + y * dstride;
+
+      for (gint x = 0; x < w; x++)
+        {
+          guint32 px = s[x];
+          gdouble a  = ((px >> 24) & 0xff) / 255.0;
+          gdouble r, g, b, lum, v;
+
+          /*  premultiplied: un-premultiply for the luminance  */
+          if (a > 0.0)
+            {
+              r = ((px >> 16) & 0xff) / 255.0 / a;
+              g = ((px >> 8)  & 0xff) / 255.0 / a;
+              b = ( px        & 0xff) / 255.0 / a;
+            }
+          else
+            r = g = b = 0.0;
+
+          lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
+
+          if (flags & CHOPGIMP_OPMASK_INVERT)
+            lum = 1.0 - lum;
+
+          /*  Illustrator: with « Découpe » the outside of the mask is
+           *  black (hidden), without it white (shown)
+           */
+          if (flags & CHOPGIMP_OPMASK_CLIP)
+            v = lum * a;
+          else
+            v = lum * a + (1.0 - a) * ((flags & CHOPGIMP_OPMASK_INVERT) ? 0.0 : 1.0);
+
+          d[x] = (guchar) CLAMP (floor (v * 255.0 + 0.5), 0, 255);
+        }
+    }
+
+  cairo_surface_mark_dirty (a8);
+
+  return a8;
+}
+
+
+/*  ─── selection helpers ─────────────────────────────────────────────── */
+
+/*  the selected path objects (g_list_free)  */
+static GList *
+selected_leaves (GimpVectorLayer *layer)
+{
+  GList *sel  = chopgimp_vlayer_get_selected_objects (layer);
+  GList *list = NULL;
+
+  for (GList *l = sel; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      if (o->kind == CHOPGIMP_VOBJECT_PATH)
+        list = g_list_append (list, o);
+      else
+        {
+          GList *leaves = chopgimp_vlayer_get_leaves (layer);
+
+          for (GList *k = leaves; k; k = k->next)
+            if (chopgimp_vobject_is_ancestor (o, k->data) &&
+                ! g_list_find (list, k->data))
+              list = g_list_append (list, k->data);
+
+          g_list_free (leaves);
+        }
+    }
+
+  g_list_free (sel);
+
+  return list;
+}
+
+/*  the selected objects with a common parent, bottom → top (g_list_free);
+ *  NULL unless there are at least @min
+ */
+static GList *
+selected_siblings (GimpVectorLayer *layer,
+                   gint             min)
+{
+  GList           *sel    = chopgimp_vlayer_get_selected_objects (layer);
+  ChopGimpVObject *parent = NULL;
+  GList           *list   = NULL;
+
+  for (GList *l = sel; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      if (! parent)
+        parent = o->parent;
+
+      if (o->parent != parent)
+        {
+          g_list_free (sel);
+          g_list_free (list);
+          return NULL;
+        }
+
+      list = g_list_append (list, o);
+    }
+
+  g_list_free (sel);
+
+  if ((gint) g_list_length (list) < min)
+    {
+      g_list_free (list);
+      return NULL;
+    }
+
+  /*  bottom → top, by index in the parent  */
+  {
+    GList *sorted = NULL;
+
+    for (guint i = 0; parent && i < parent->children->len; i++)
+      if (g_list_find (list, g_ptr_array_index (parent->children, i)))
+        sorted = g_list_append (sorted, g_ptr_array_index (parent->children, i));
+
+    g_list_free (list);
+    list = sorted;
+  }
+
+  return list;
+}
+
+static ChopGimpVObject *
+group_of_selection (GimpVectorLayer *layer,
+                    gboolean (*test) (ChopGimpVObject *))
+{
+  GList           *sel = chopgimp_vlayer_get_selected_objects (layer);
+  ChopGimpVObject *g   = NULL;
+
+  for (GList *l = sel; l && ! g; l = l->next)
+    for (ChopGimpVObject *o = l->data; o && ! g; o = o->parent)
+      if (test (o))
+        g = o;
+
+  g_list_free (sel);
+
+  return g;
+}
+
+
+/*  ─── commands: mesh, freeform, stroke gradient ─────────────────────── */
+
+GeglColor *
+chopgimp_vmaterial_main_color (ChopGimpPaintType  type,
+                               const gchar       *spec)
+{
+  gdouble rgba[4];
+
+  if (type == CHOPGIMP_PAINT_MESH)
+    {
+      ChopGimpMesh m;
+
+      if (! chopgimp_vmesh_parse (spec, &m))
+        return NULL;
+
+      memcpy (rgba, m.nodes[0].rgba, sizeof (rgba));
+      chopgimp_vmesh_clear (&m);
+
+      return chopgimp_srgb_to_color (rgba);
+    }
+  else if (type == CHOPGIMP_PAINT_FREEFORM && spec && ! strncmp (spec, "points", 6))
+    {
+      GArray *pts = chopgimp_vfreeform_parse (spec + 6);
+
+      if (! pts)
+        return NULL;
+
+      memcpy (rgba, g_array_index (pts, ChopGimpMeshNode, 0).rgba, sizeof (rgba));
+      g_array_free (pts, TRUE);
+
+      return chopgimp_srgb_to_color (rgba);
+    }
+
+  return NULL;
+}
+
+/*  @fn sets the primary fill of a copy of each selected leaf's style  */
+static gboolean
+restyle_selection (GimpVectorLayer *layer,
+                   const gchar     *undo_desc,
+                   void (*fn) (ChopGimpVStyle *, gpointer),
+                   gpointer         data)
+{
+  GList *leaves = selected_leaves (layer);
+
+  if (! leaves)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, undo_desc);
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      ChopGimpVStyle   st;
+
+      chopgimp_vstyle_init (&st);
+      chopgimp_vstyle_copy (&st, &o->style);
+      fn (&st, data);
+      chopgimp_vlayer_set_style (layer, o->id, &st, FALSE);
+      chopgimp_vstyle_clear (&st);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (leaves);
+
+  return TRUE;
+}
+
+typedef struct
+{
+  gint             rows, cols;
+  ChopGimpMeshLook look;
+  gdouble          highlight;
+  GeglColor       *fg, *bg;
+  gint             mode;
+  const gchar     *spec;
+} RestyleData;
+
+static void
+set_mesh (ChopGimpVStyle *st,
+          gpointer        data)
+{
+  RestyleData    *d    = data;
+  ChopGimpVEntry *fill = chopgimp_vstyle_ensure_fill (st);
+  GeglColor      *base = chopgimp_vpaint_get_main_color (&fill->paint);
+  GeglColor      *grey = NULL;
+  gchar          *spec;
+
+  if (! base)
+    base = grey = gegl_color_new ("gray");
+
+  spec = chopgimp_vmesh_new_spec (d->rows, d->cols, base, d->look, d->highlight);
+  chopgimp_vpaint_set_material (&fill->paint, CHOPGIMP_PAINT_MESH, spec, base);
+  fill->visible = TRUE;
+
+  g_free (spec);
+  g_clear_object (&grey);
+}
+
+gboolean
+chopgimp_vmaterial_make_mesh (GimpVectorLayer  *layer,
+                              gint              rows,
+                              gint              cols,
+                              ChopGimpMeshLook  look,
+                              gdouble           highlight)
+{
+  RestyleData d = { rows, cols, look, highlight, NULL, NULL, 0, NULL };
+
+  return restyle_selection (layer, _("Créer un filet de dégradé"), set_mesh, &d);
+}
+
+static void
+set_freeform (ChopGimpVStyle *st,
+              gpointer        data)
+{
+  RestyleData    *d    = data;
+  ChopGimpVEntry *fill = chopgimp_vstyle_ensure_fill (st);
+  GeglColor      *base = chopgimp_vpaint_get_main_color (&fill->paint);
+  gchar          *pts  = chopgimp_vfreeform_new_spec (base ? base : d->fg, d->bg);
+
+  chopgimp_vpaint_set_material (&fill->paint, CHOPGIMP_PAINT_FREEFORM, pts,
+                                base ? base : d->fg);
+  fill->visible = TRUE;
+  g_free (pts);
+}
+
+gboolean
+chopgimp_vmaterial_make_freeform (GimpVectorLayer *layer,
+                                  GeglColor       *fg,
+                                  GeglColor       *bg)
+{
+  RestyleData d = { 0, 0, CHOPGIMP_MESH_FLAT, 0, fg, bg, 0, NULL };
+
+  return restyle_selection (layer, _("Dégradé libre"), set_freeform, &d);
+}
+
+static void
+set_stroke_gradient (ChopGimpVStyle *st,
+                     gpointer        data)
+{
+  RestyleData    *d  = data;
+  ChopGimpVEntry *e  = chopgimp_vstyle_get_stroke (st);
+
+  if (e)
+    e->stroke_gradient = CLAMP (d->mode, 0, 2);
+}
+
+gboolean
+chopgimp_vmaterial_set_stroke_gradient (GimpVectorLayer *layer,
+                                        gint             mode)
+{
+  RestyleData d = { 0, 0, CHOPGIMP_MESH_FLAT, 0, NULL, NULL, mode, NULL };
+
+  return restyle_selection (layer, _("Dégradé du contour"), set_stroke_gradient, &d);
+}
