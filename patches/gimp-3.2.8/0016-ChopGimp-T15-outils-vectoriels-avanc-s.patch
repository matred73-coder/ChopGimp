diff --git a/app/widgets/chopgimp-transform-editor.c b/app/widgets/chopgimp-transform-editor.c
new file mode 100644
index 0000000..59c9628
--- /dev/null
+++ b/app/widgets/chopgimp-transform-editor.c
@@ -0,0 +1,464 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-transform-editor.c — ChopGimp 3.29.0 (vectoriel « complet »,
+ * bloc 2): the « Transformation » dockable, like Illustrator's
+ *
+ *    ▫ ▫ ▫   X [   ]   L [   ] ⛓
+ *    ▫ ■ ▫   Y [   ]   H [   ]
+ *    ▫ ▫ ▫   ∠ [   ]   ⫽ [   ]
+ *    [✓] Contours à l'échelle      [⇆] [⇅]
+ *
+ * X and Y are the coordinates of the reference point (one of 9) of the
+ * selected objects' box; changing L or H keeps that point in place. The
+ * angle and the shear are those of a single selected object (0 for
+ * several): typing a value rotates / shears by the difference. Every
+ * change is one undo step.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "widgets-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpcontext.h"
+#include "core/gimpimage.h"
+
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vobject-ops.h"
+#include "path/chopgimp-vtransform.h"
+
+#include "gimpdialogfactory.h"
+#include "gimpeditor.h"
+#include "gimphelp-ids.h"
+
+#include "chopgimp-transform-editor.h"
+
+#include "gimp-intl.h"
+
+
+typedef struct
+{
+  Gimp            *gimp;
+  GimpContext     *context;
+  GtkWidget       *editor;
+  GtkWidget       *hint;
+  GtkWidget       *content;
+
+  GtkWidget       *ref[9];
+  GtkWidget       *x, *y, *w, *h, *angle, *shear;
+  GtkWidget       *chain;
+  GtkWidget       *scale_strokes;
+  GtkWidget       *flip_h, *flip_v;
+
+  GimpImage       *image;      /* weak */
+  GimpVectorLayer *layer;      /* weak */
+  gint             ref_point;
+  gdouble          bx, by, bw, bh, cur_angle, cur_shear;
+  gboolean         valid;
+  gboolean         loading;
+  guint            idle_id;
+} Panel;
+
+
+static void panel_queue_refresh (Panel *p);
+
+
+/*  ─── values ────────────────────────────────────────────────────────── */
+
+static gdouble
+spin_get (GtkWidget *spin)
+{
+  return gtk_spin_button_get_value (GTK_SPIN_BUTTON (spin));
+}
+
+static void
+spin_set (GtkWidget *spin,
+          gdouble    value)
+{
+  gtk_spin_button_set_value (GTK_SPIN_BUTTON (spin), value);
+}
+
+static void
+panel_refresh (Panel *p)
+{
+  gdouble rx, ry;
+
+  p->valid = p->layer &&
+             chopgimp_vtransform_get_box (p->layer, &p->bx, &p->by, &p->bw, &p->bh);
+
+  gtk_widget_set_visible (p->hint, ! p->valid);
+  gtk_widget_set_sensitive (p->content, p->valid);
+
+  if (! p->valid)
+    return;
+
+  chopgimp_vtransform_get_angles (p->layer, &p->cur_angle, &p->cur_shear);
+  chopgimp_vtransform_ref_point (p->ref_point, p->bx, p->by,
+                                 p->bx + p->bw, p->by + p->bh, &rx, &ry);
+
+  p->loading = TRUE;
+
+  spin_set (p->x, rx);
+  spin_set (p->y, ry);
+  spin_set (p->w, p->bw);
+  spin_set (p->h, p->bh);
+  spin_set (p->angle, p->cur_angle);
+  spin_set (p->shear, p->cur_shear);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (p->scale_strokes),
+                                chopgimp_vobjects_get_scale_strokes ());
+
+  p->loading = FALSE;
+}
+
+static gboolean
+panel_refresh_idle (gpointer data)
+{
+  Panel *p = data;
+
+  p->idle_id = 0;
+  panel_refresh (p);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+panel_queue_refresh (Panel *p)
+{
+  if (! p->idle_id && gtk_widget_get_mapped (p->editor))
+    p->idle_id = g_idle_add (panel_refresh_idle, p);
+}
+
+
+/*  ─── edits ─────────────────────────────────────────────────────────── */
+
+static void
+panel_apply (Panel     *p,
+             GtkWidget *changed)
+{
+  gdouble col, row, nx, ny, nw, nh;
+
+  if (p->loading || ! p->valid || ! p->layer)
+    return;
+
+  nw = MAX (spin_get (p->w), 0.0);
+  nh = MAX (spin_get (p->h), 0.0);
+
+  /*  proportions linked: the other side follows  */
+  if (gimp_chain_button_get_active (GIMP_CHAIN_BUTTON (p->chain)))
+    {
+      if (changed == p->w && p->bw > 1e-6)
+        nh = p->bh * nw / p->bw;
+      else if (changed == p->h && p->bh > 1e-6)
+        nw = p->bw * nh / p->bh;
+    }
+
+  col = (p->ref_point % 3) / 2.0;
+  row = (p->ref_point / 3) / 2.0;
+  nx  = spin_get (p->x) - col * nw;
+  ny  = spin_get (p->y) - row * nh;
+
+  if (chopgimp_vtransform_set_box (p->layer, p->ref_point, nx, ny, nw, nh,
+                                   spin_get (p->angle) - p->cur_angle,
+                                   spin_get (p->shear) - p->cur_shear))
+    gimp_image_flush (p->image);
+
+  panel_refresh (p);
+}
+
+static void
+spin_changed (GtkWidget *spin,
+              Panel     *p)
+{
+  panel_apply (p, spin);
+}
+
+static void
+ref_toggled (GtkWidget *button,
+             Panel     *p)
+{
+  if (! gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (button)))
+    return;
+
+  for (gint i = 0; i < 9; i++)
+    if (p->ref[i] == button)
+      p->ref_point = i;
+
+  panel_refresh (p);
+}
+
+static void
+scale_strokes_toggled (GtkWidget *button,
+                       Panel     *p)
+{
+  if (! p->loading)
+    chopgimp_vobjects_set_scale_strokes (gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (button)));
+}
+
+static void
+flip_clicked (GtkWidget *button,
+              Panel     *p)
+{
+  if (p->layer &&
+      chopgimp_vtransform_flip (p->layer, p->ref_point, button == p->flip_h))
+    gimp_image_flush (p->image);
+
+  panel_refresh (p);
+}
+
+
+/*  ─── following the image ───────────────────────────────────────────── */
+
+static void
+panel_set_layer (Panel           *p,
+                 GimpVectorLayer *layer)
+{
+  if (layer == p->layer)
+    return;
+
+  if (p->layer)
+    {
+      g_signal_handlers_disconnect_by_data (p->layer, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->layer), (gpointer *) &p->layer);
+    }
+
+  p->layer = layer;
+
+  if (layer)
+    {
+      g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &p->layer);
+      g_signal_connect_swapped (layer, "object-selection-changed",
+                                G_CALLBACK (panel_queue_refresh), p);
+      g_signal_connect_swapped (layer, "objects-changed",
+                                G_CALLBACK (panel_queue_refresh), p);
+    }
+
+  panel_queue_refresh (p);
+}
+
+static void
+panel_layers_changed (Panel *p)
+{
+  panel_set_layer (p, p->image ? chopgimp_vobjects_get_target_layer (p->image) : NULL);
+}
+
+static void
+panel_set_image (Panel     *p,
+                 GimpImage *image)
+{
+  if (image == p->image)
+    return;
+
+  panel_set_layer (p, NULL);
+
+  if (p->image)
+    {
+      g_signal_handlers_disconnect_by_data (p->image, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->image), (gpointer *) &p->image);
+    }
+
+  p->image = image;
+
+  if (image)
+    {
+      g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &p->image);
+      g_signal_connect_swapped (image, "selected-layers-changed",
+                                G_CALLBACK (panel_layers_changed), p);
+
+      panel_set_layer (p, chopgimp_vobjects_get_target_layer (image));
+    }
+
+  panel_queue_refresh (p);
+}
+
+static void
+panel_image_changed (GimpContext *context,
+                     GimpImage   *image,
+                     Panel       *p)
+{
+  panel_set_image (p, image);
+}
+
+
+/*  ─── construction ──────────────────────────────────────────────────── */
+
+static void
+panel_free (Panel *p)
+{
+  panel_set_image (p, NULL);
+
+  if (p->idle_id)
+    g_source_remove (p->idle_id);
+  p->idle_id = 0;
+
+  g_signal_handlers_disconnect_by_data (p->context, p);
+
+  g_free (p);
+}
+
+static GtkWidget *
+add_spin (Panel       *p,
+          GtkWidget   *grid,
+          const gchar *label,
+          const gchar *tooltip,
+          gint         col,
+          gint         row,
+          gdouble      lower,
+          gdouble      upper)
+{
+  GtkWidget *l    = gtk_label_new (label);
+  GtkWidget *spin = gtk_spin_button_new_with_range (lower, upper, 1.0);
+
+  gtk_spin_button_set_digits (GTK_SPIN_BUTTON (spin), 2);
+  gtk_entry_set_width_chars (GTK_ENTRY (spin), 7);
+  gtk_widget_set_tooltip_text (spin, tooltip);
+  gtk_label_set_xalign (GTK_LABEL (l), 1.0);
+
+  gtk_grid_attach (GTK_GRID (grid), l,    col,     row, 1, 1);
+  gtk_grid_attach (GTK_GRID (grid), spin, col + 1, row, 1, 1);
+
+  g_signal_connect (spin, "value-changed", G_CALLBACK (spin_changed), p);
+
+  return spin;
+}
+
+GtkWidget *
+chopgimp_transform_editor_new (GimpDialogFactory *factory,
+                               GimpContext       *context,
+                               GimpUIManager     *ui_manager,
+                               gint               view_size)
+{
+  Panel     *p      = g_new0 (Panel, 1);
+  GtkWidget *editor = g_object_new (GIMP_TYPE_EDITOR, NULL);
+  GtkWidget *box    = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  GtkWidget *hbox, *refgrid, *grid, *label;
+  GSList    *group  = NULL;
+
+  p->gimp      = context->gimp;
+  p->editor    = editor;
+  p->context   = gimp_get_user_context (context->gimp);
+  p->ref_point = 4;
+
+  gtk_container_set_border_width (GTK_CONTAINER (box), 6);
+  gtk_box_pack_start (GTK_BOX (editor), box, TRUE, TRUE, 0);
+  gtk_widget_set_visible (box, TRUE);
+
+  g_object_set_data_full (G_OBJECT (editor), "chopgimp-panel", p,
+                          (GDestroyNotify) panel_free);
+
+  if (! chopgimp_vobjects_enabled ())
+    {
+      label = gtk_label_new (_("Les objets vectoriels sont désactivés "
+                               "(CHOPGIMP_NO_VOBJECTS=1)."));
+      gtk_label_set_line_wrap (GTK_LABEL (label), TRUE);
+      gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+      gtk_widget_set_visible (label, TRUE);
+
+      return editor;
+    }
+
+  p->hint = gtk_label_new (_("Sélectionnez des objets d'un calque vectoriel "
+                             "(outil Déplacement, V) : leur position, leur taille, "
+                             "leur angle et leur inclinaison se règlent ici."));
+  gtk_label_set_line_wrap (GTK_LABEL (p->hint), TRUE);
+  gtk_label_set_xalign (GTK_LABEL (p->hint), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (p->hint), "dim-label");
+  gtk_box_pack_start (GTK_BOX (box), p->hint, FALSE, FALSE, 0);
+  gtk_widget_set_no_show_all (p->hint, TRUE);
+
+  p->content = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_box_pack_start (GTK_BOX (box), p->content, FALSE, FALSE, 0);
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+  gtk_box_pack_start (GTK_BOX (p->content), hbox, FALSE, FALSE, 0);
+
+  /*  the reference point  */
+  refgrid = gtk_grid_new ();
+  gtk_widget_set_valign (refgrid, GTK_ALIGN_CENTER);
+  gtk_widget_set_tooltip_text (refgrid, _("Point de référence : il reste en place "
+                                          "quand la taille change, X et Y sont ses "
+                                          "coordonnées"));
+  gtk_box_pack_start (GTK_BOX (hbox), refgrid, FALSE, FALSE, 0);
+
+  for (gint i = 0; i < 9; i++)
+    {
+      p->ref[i] = gtk_radio_button_new (group);
+      group     = gtk_radio_button_get_group (GTK_RADIO_BUTTON (p->ref[i]));
+      gtk_grid_attach (GTK_GRID (refgrid), p->ref[i], i % 3, i / 3, 1, 1);
+    }
+
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (p->ref[4]), TRUE);
+
+  for (gint i = 0; i < 9; i++)
+    g_signal_connect (p->ref[i], "toggled", G_CALLBACK (ref_toggled), p);
+
+  /*  the values  */
+  grid = gtk_grid_new ();
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 4);
+  gtk_grid_set_row_spacing (GTK_GRID (grid), 4);
+  gtk_box_pack_start (GTK_BOX (hbox), grid, TRUE, TRUE, 0);
+
+  p->x     = add_spin (p, grid, "X", _("Position horizontale du point de référence (px)"),
+                       0, 0, -100000, 100000);
+  p->y     = add_spin (p, grid, "Y", _("Position verticale du point de référence (px)"),
+                       0, 1, -100000, 100000);
+  p->w     = add_spin (p, grid, _("L"), _("Largeur (px)"), 2, 0, 0, 100000);
+  p->h     = add_spin (p, grid, _("H"), _("Hauteur (px)"), 2, 1, 0, 100000);
+  p->angle = add_spin (p, grid, "∠", _("Angle de rotation (°, sens inverse des aiguilles "
+                                      "d'une montre)"), 0, 2, -360, 360);
+  p->shear = add_spin (p, grid, "⫽", _("Inclinaison (°)"), 2, 2, -89, 89);
+
+  p->chain = gimp_chain_button_new (GIMP_CHAIN_RIGHT);
+  gimp_chain_button_set_active (GIMP_CHAIN_BUTTON (p->chain), TRUE);
+  gimp_help_set_help_data (p->chain, _("Conserver les proportions"), NULL);
+  gtk_grid_attach (GTK_GRID (grid), p->chain, 4, 0, 1, 2);
+
+  /*  options  */
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  gtk_box_pack_start (GTK_BOX (p->content), hbox, FALSE, FALSE, 0);
+
+  p->scale_strokes = gtk_check_button_new_with_mnemonic (_("_Contours à l'échelle"));
+  gtk_widget_set_tooltip_text (p->scale_strokes,
+                               _("Mettre à l'échelle les contours et effets avec les objets"));
+  gtk_box_pack_start (GTK_BOX (hbox), p->scale_strokes, FALSE, FALSE, 0);
+  g_signal_connect (p->scale_strokes, "toggled", G_CALLBACK (scale_strokes_toggled), p);
+
+  p->flip_v = gtk_button_new_from_icon_name (GIMP_ICON_OBJECT_FLIP_VERTICAL,
+                                             GTK_ICON_SIZE_BUTTON);
+  gtk_widget_set_tooltip_text (p->flip_v, _("Retourner verticalement"));
+  gtk_box_pack_end (GTK_BOX (hbox), p->flip_v, FALSE, FALSE, 0);
+  g_signal_connect (p->flip_v, "clicked", G_CALLBACK (flip_clicked), p);
+
+  p->flip_h = gtk_button_new_from_icon_name (GIMP_ICON_OBJECT_FLIP_HORIZONTAL,
+                                             GTK_ICON_SIZE_BUTTON);
+  gtk_widget_set_tooltip_text (p->flip_h, _("Retourner horizontalement"));
+  gtk_box_pack_end (GTK_BOX (hbox), p->flip_h, FALSE, FALSE, 0);
+  g_signal_connect (p->flip_h, "clicked", G_CALLBACK (flip_clicked), p);
+
+  gtk_widget_show_all (p->content);
+
+  g_signal_connect (p->context, "image-changed",
+                    G_CALLBACK (panel_image_changed), p);
+  g_signal_connect_data (editor, "map", G_CALLBACK (panel_queue_refresh), p, NULL,
+                         G_CONNECT_SWAPPED | G_CONNECT_AFTER);
+
+  panel_set_image (p, gimp_context_get_image (p->context));
+
+  return editor;
+}
