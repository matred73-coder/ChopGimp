+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-width-profile-box.h — ChopGimp 3.27.6 (outil Largeur):
+ * the width profiles of the selected objects' strokes, in the tool
+ * options and the options bar: choose a profile (presets, the user's
+ * saved ones), « Enregistrer… » the profile of the selected object,
+ * « Uniforme ».
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+GtkWidget * chopgimp_width_profile_box_new     (Gimp *gimp);
+
+/*  every box shows the profile of the selected object again  */
+void        chopgimp_width_profile_boxes_update (void);
