+/*  ─── tool options: color buttons for the selection ─────────────────── */
+
+static GimpVectorLayer *
+lp_layer_of (Gimp *gimp)
+{
+  GimpContext *context = gimp_get_user_context (gimp);
+  GimpImage   *image   = context ? gimp_context_get_image (context) : NULL;
+
+  return image ? chopgimp_vobjects_get_target_layer (image) : NULL;
+}
+
+static void
+lp_apply_clicked (GtkWidget       *button,
+                  GimpToolOptions *options)
+{
+  Gimp            *gimp  = GIMP_CONTEXT (options)->gimp;
+  GimpVectorLayer *layer = lp_layer_of (gimp);
+  gint             which = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (button), "which"));
+  GeglColor       *fg;
+  GList           *sel;
+  gboolean         pushed = FALSE;
+
+  if (! layer)
+    return;
+
+  fg  = gimp_context_get_foreground (gimp_get_user_context (gimp));
+  sel = chopgimp_vlayer_get_selected_objects (layer);
+
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = sel; l; l = l->next)
+    {
+      ChopGimpVObject *o    = l->data;
+      gboolean         edge = (which == 1);
+
+      if (o->kind != CHOPGIMP_VOBJECT_PATH)
+        continue;
+
+      if (! pushed)
+        {
+          chopgimp_vlayer_push_undo (layer, _("Peinture dynamique"));
+          pushed = TRUE;
+        }
+
+      if (which == 2)
+        {
+          ChopGimpVEntry *e = chopgimp_vstyle_get_fill (&o->style);
+
+          if (e)
+            chopgimp_vpaint_clear (&e->paint);
+          chopgimp_vlayer_object_changed (layer, o);
+        }
+      else
+        {
+          ChopGimpVEntry *e = edge ? chopgimp_vstyle_ensure_stroke (&o->style)
+                                   : chopgimp_vstyle_ensure_fill (&o->style);
+
+          chopgimp_vpaint_set_color (&e->paint, fg);
+          g_clear_pointer (&e->paint.global_id, g_free);
+          e->visible = TRUE;
+          if (e->opacity <= 0.0)
+            e->opacity = 1.0;
+          if (edge && e->width <= 0.0)
+            e->width = 1.0;
+          chopgimp_vlayer_object_changed (layer, o);
+        }
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (sel);
+
+  if (pushed)
+    gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+}
+
+static GtkWidget *
+lp_options_gui_common (GimpToolOptions *options,
+                       gboolean         select)
+{
+  GtkWidget *vbox  = gimp_tool_options_gui (options);
+  GtkWidget *label = gtk_label_new (select
+                                    ? _("Clic : sélectionner une zone (ou un segment près "
+                                        "du pointeur), Maj+clic : ajouter. Le panneau "
+                                        "Aspect et les boutons ci-dessous changent leur "
+                                        "fond ou leur contour.")
+                                    : _("Clic : remplir la zone avec la couleur de premier "
+                                        "plan. Maj+clic : peindre le segment de tracé. "
+                                        "Alt+clic : prendre la couleur de la zone. "
+                                        "Créer le groupe : Vecteur > Peinture dynamique > "
+                                        "Créer (Ctrl+Maj+Alt+X)."));
+
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (label), TRUE);
+  gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 0);
+  gtk_widget_show (label);
+
+  if (select)
+    {
+      const gchar *labels[] = { N_("Fond ← premier plan"),
+                                N_("Contour ← premier plan"),
+                                N_("Aucun fond") };
+
+      for (gint i = 0; i < 3; i++)
+        {
+          GtkWidget *b = gtk_button_new_with_label (_(labels[i]));
+
+          g_object_set_data (G_OBJECT (b), "which", GINT_TO_POINTER (i));
+          g_signal_connect (b, "clicked", G_CALLBACK (lp_apply_clicked), options);
+          gtk_box_pack_start (GTK_BOX (vbox), b, FALSE, FALSE, 0);
+          gtk_widget_show (b);
+        }
+    }
+
+  return vbox;
+}
