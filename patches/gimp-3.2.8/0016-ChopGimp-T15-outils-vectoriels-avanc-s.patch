diff --git a/app/dialogs/chopgimp-distort-dialog.c b/app/dialogs/chopgimp-distort-dialog.c
new file mode 100644
index 0000000..fd0ec82
--- /dev/null
+++ b/app/dialogs/chopgimp-distort-dialog.c
@@ -0,0 +1,307 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-distort-dialog.c — ChopGimp 3.27.6 (see the header)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "dialogs-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpimage.h"
+
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vdistort.h"
+
+#include "widgets/gimphelp-ids.h"
+
+#include "chopgimp-distort-dialog.h"
+
+#include "gimp-intl.h"
+
+
+#define RESPONSE_RESET 1
+
+typedef struct
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GHashTable      *saved;    /* id → the lpe before the dialog (or NULL)  */
+  ChopGimpDistort  d;
+  GtkWidget       *style;
+  GtkWidget       *vertical;
+  GtkAdjustment   *bend, *hdist, *vdist;
+  GtkAdjustment   *rows, *cols;
+  GtkWidget       *preview;
+  gboolean         loading;
+} Dialog;
+
+
+static void
+dialog_restore (Dialog *d)
+{
+  GHashTableIter iter;
+  gpointer       key, value;
+
+  chopgimp_vlayer_freeze (d->layer);
+
+  g_hash_table_iter_init (&iter, d->saved);
+  while (g_hash_table_iter_next (&iter, &key, &value))
+    chopgimp_vlayer_set_lpe (d->layer, GPOINTER_TO_UINT (key), value, FALSE);
+
+  chopgimp_vlayer_thaw (d->layer);
+}
+
+static void
+dialog_read (Dialog *d)
+{
+  gint i = gtk_combo_box_get_active (GTK_COMBO_BOX (d->style));
+
+  g_free (d->d.style);
+  d->d.style    = g_strdup (chopgimp_vdistort_get_styles ()[MAX (i, 0)]);
+  d->d.vertical = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->vertical));
+  d->d.bend     = gtk_adjustment_get_value (d->bend);
+  d->d.hdist    = gtk_adjustment_get_value (d->hdist);
+  d->d.vdist    = gtk_adjustment_get_value (d->vdist);
+}
+
+static void
+dialog_preview (Dialog *d)
+{
+  if (d->loading || ! d->style)
+    return;
+
+  dialog_read (d);
+
+  if (gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->preview)))
+    chopgimp_vdistort_make (d->layer, &d->d, NULL);
+  else
+    dialog_restore (d);
+
+  gimp_image_flush (d->image);
+}
+
+static void
+dialog_changed (GtkWidget *widget,
+                Dialog    *d)
+{
+  dialog_preview (d);
+}
+
+static void
+dialog_load (Dialog *d)
+{
+  const gchar * const *styles = chopgimp_vdistort_get_styles ();
+
+  d->loading = TRUE;
+
+  for (gint i = 0; styles[i]; i++)
+    if (! g_strcmp0 (styles[i], d->d.style))
+      gtk_combo_box_set_active (GTK_COMBO_BOX (d->style), i);
+
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->vertical), d->d.vertical);
+  gtk_adjustment_set_value (d->bend,  d->d.bend);
+  gtk_adjustment_set_value (d->hdist, d->d.hdist);
+  gtk_adjustment_set_value (d->vdist, d->d.vdist);
+
+  d->loading = FALSE;
+}
+
+static GtkAdjustment *
+add_scale (GtkWidget   *box,
+           const gchar *label,
+           gdouble      value,
+           gdouble      lower,
+           gdouble      upper,
+           Dialog      *d)
+{
+  GtkAdjustment *adj   = gtk_adjustment_new (value, lower, upper, 1, 10, 0);
+  GtkWidget     *scale = gimp_spin_scale_new (adj, label, 0);
+
+  gtk_box_pack_start (GTK_BOX (box), scale, FALSE, FALSE, 0);
+  if (d)
+    g_signal_connect (adj, "value-changed", G_CALLBACK (dialog_changed), d);
+
+  return adj;
+}
+
+gboolean
+chopgimp_distort_dialog_show (GimpImage                 *image,
+                              GimpVectorLayer           *layer,
+                              ChopGimpDistortDialogKind  kind,
+                              GtkWidget                 *parent)
+{
+  Dialog     d    = { 0, };
+  GtkWidget *dialog;
+  GtkWidget *vbox;
+  GList     *targets;
+  gboolean   done = FALSE;
+  gint       response;
+
+  targets = chopgimp_vdistort_targets (layer);
+  if (! targets)
+    return FALSE;
+
+  d.image = image;
+  d.layer = layer;
+  d.saved = g_hash_table_new_full (g_direct_hash, g_direct_equal, NULL, g_free);
+  chopgimp_vdistort_init (&d.d);
+  d.d.mode = CHOPGIMP_DISTORT_WARP;
+
+  for (GList *l = targets; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      g_hash_table_insert (d.saved, GUINT_TO_POINTER (o->id), g_strdup (o->lpe));
+    }
+
+  /*  the warp of the first object, to change it  */
+  if (kind == CHOPGIMP_DISTORT_DIALOG_WARP)
+    {
+      ChopGimpDistort cur;
+
+      chopgimp_vdistort_init (&cur);
+      if (chopgimp_vdistort_get (targets->data, &cur) && cur.mode == CHOPGIMP_DISTORT_WARP)
+        chopgimp_vdistort_copy (&d.d, &cur);
+      chopgimp_vdistort_clear (&cur);
+    }
+
+  dialog = g_object_new (GIMP_TYPE_DIALOG,
+                         "title",          kind == CHOPGIMP_DISTORT_DIALOG_WARP
+                                           ? _("Options de déformation")
+                                           : _("Enveloppe : créer d'après une maille"),
+                         "role",           "chopgimp-distort",
+                         "modal",          TRUE,
+                         "help-func",      gimp_standard_help_func,
+                         "help-id",        GIMP_HELP_PATH_DIALOG,
+                         "parent",         parent ? gtk_widget_get_toplevel (parent) : NULL,
+                         "use-header-bar", FALSE,
+                         NULL);
+
+  if (kind == CHOPGIMP_DISTORT_DIALOG_WARP)
+    gimp_dialog_add_buttons (GIMP_DIALOG (dialog),
+                             _("_Réinitialiser"), RESPONSE_RESET,
+                             _("_Annuler"),       GTK_RESPONSE_CANCEL,
+                             _("_Valider"),       GTK_RESPONSE_OK,
+                             NULL);
+  else
+    gimp_dialog_add_buttons (GIMP_DIALOG (dialog),
+                             _("_Annuler"),       GTK_RESPONSE_CANCEL,
+                             _("_Valider"),       GTK_RESPONSE_OK,
+                             NULL);
+
+  gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_OK);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 8);
+  gtk_container_set_border_width (GTK_CONTAINER (vbox), 12);
+  gtk_box_pack_start (GTK_BOX (gtk_dialog_get_content_area (GTK_DIALOG (dialog))),
+                      vbox, TRUE, TRUE, 0);
+
+  if (kind == CHOPGIMP_DISTORT_DIALOG_WARP)
+    {
+      GtkWidget *hbox  = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+      GtkWidget *label = gtk_label_new_with_mnemonic (_("_Style :"));
+      GtkWidget *horizontal;
+
+      d.style = gtk_combo_box_text_new ();
+      for (const gchar * const *s = chopgimp_vdistort_get_styles (); *s; s++)
+        gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (d.style),
+                                        chopgimp_vdistort_get_style_label (*s));
+      gtk_label_set_mnemonic_widget (GTK_LABEL (label), d.style);
+      gtk_box_pack_start (GTK_BOX (hbox), label, FALSE, FALSE, 0);
+      gtk_box_pack_start (GTK_BOX (hbox), d.style, TRUE, TRUE, 0);
+      gtk_box_pack_start (GTK_BOX (vbox), hbox, FALSE, FALSE, 0);
+      g_signal_connect (d.style, "changed", G_CALLBACK (dialog_changed), &d);
+
+      hbox       = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+      horizontal = gtk_radio_button_new_with_mnemonic (NULL, _("_Horizontal"));
+      d.vertical = gtk_radio_button_new_with_mnemonic_from_widget (GTK_RADIO_BUTTON (horizontal),
+                                                                   _("_Vertical"));
+      gtk_box_pack_start (GTK_BOX (hbox), horizontal, FALSE, FALSE, 0);
+      gtk_box_pack_start (GTK_BOX (hbox), d.vertical, FALSE, FALSE, 0);
+      gtk_box_pack_start (GTK_BOX (vbox), hbox, FALSE, FALSE, 0);
+      g_signal_connect (d.vertical, "toggled", G_CALLBACK (dialog_changed), &d);
+
+      d.bend  = add_scale (vbox, _("Courbure (%)"), 50, -100, 100, &d);
+
+      label = gtk_label_new (_("Distorsion"));
+      gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+      gimp_label_set_attributes (GTK_LABEL (label), PANGO_ATTR_WEIGHT, PANGO_WEIGHT_BOLD, -1);
+      gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 4);
+
+      d.hdist = add_scale (vbox, _("Horizontale (%)"), 0, -100, 100, &d);
+      d.vdist = add_scale (vbox, _("Verticale (%)"),   0, -100, 100, &d);
+
+      d.preview = gtk_check_button_new_with_mnemonic (_("_Aperçu"));
+      gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d.preview), TRUE);
+      gtk_box_pack_start (GTK_BOX (vbox), d.preview, FALSE, FALSE, 0);
+      g_signal_connect (d.preview, "toggled", G_CALLBACK (dialog_changed), &d);
+
+      dialog_load (&d);
+      gtk_widget_show_all (vbox);
+      dialog_preview (&d);
+    }
+  else
+    {
+      d.rows = add_scale (vbox, _("Lignes"),   4, 1, 20, NULL);
+      d.cols = add_scale (vbox, _("Colonnes"), 4, 1, 20, NULL);
+      gtk_widget_show_all (vbox);
+    }
+
+  while ((response = gimp_dialog_run (GIMP_DIALOG (dialog))) == RESPONSE_RESET)
+    {
+      g_free (d.d.style);
+      d.d.style    = g_strdup ("arc");
+      d.d.bend     = 50;
+      d.d.hdist    = 0;
+      d.d.vdist    = 0;
+      d.d.vertical = FALSE;
+      dialog_load (&d);
+      dialog_preview (&d);
+    }
+
+  if (kind == CHOPGIMP_DISTORT_DIALOG_WARP)
+    {
+      /*  back to the state before, then one undo step for the result  */
+      dialog_restore (&d);
+
+      if (response == GTK_RESPONSE_OK)
+        {
+          dialog_read (&d);
+          done = chopgimp_vdistort_make (layer, &d.d, _("Déformation"));
+        }
+      else
+        {
+          gimp_image_flush (image);
+        }
+    }
+  else if (response == GTK_RESPONSE_OK)
+    {
+      d.d.mode = CHOPGIMP_DISTORT_MESH;
+      d.d.rows = (gint) gtk_adjustment_get_value (d.rows);
+      d.d.cols = (gint) gtk_adjustment_get_value (d.cols);
+      done = chopgimp_vdistort_make (layer, &d.d, _("Enveloppe (maille)"));
+    }
+
+  d.style = NULL;
+  gtk_widget_destroy (dialog);
+
+  chopgimp_vdistort_clear (&d.d);
+  g_hash_table_unref (d.saved);
+  g_list_free (targets);
+
+  return done;
+}
diff --git a/app/dialogs/chopgimp-distort-dialog.h b/app/dialogs/chopgimp-distort-dialog.h
