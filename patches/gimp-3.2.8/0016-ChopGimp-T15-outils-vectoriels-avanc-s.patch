diff --git a/app/dialogs/chopgimp-material-dialogs.c b/app/dialogs/chopgimp-material-dialogs.c
new file mode 100644
index 0000000..7f69b91
--- /dev/null
+++ b/app/dialogs/chopgimp-material-dialogs.c
@@ -0,0 +1,683 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-material-dialogs.c — ChopGimp 3.29.1: the windows of
+ * « couleur et matière » (see chopgimp-material-dialogs.h)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "dialogs-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpimage.h"
+
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vobject-ops.h"
+#include "path/chopgimp-vmaterial.h"
+#include "path/chopgimp-vrepeat.h"
+#include "path/chopgimp-vbrush.h"
+
+#include "widgets/gimphelp-ids.h"
+
+#include "chopgimp-material-dialogs.h"
+
+#include "gimp-intl.h"
+
+
+static GtkWidget *
+new_dialog (const gchar *title,
+            const gchar *role,
+            GtkWidget   *parent)
+{
+  GtkWidget *dialog;
+
+  dialog = g_object_new (GIMP_TYPE_DIALOG,
+                         "title",          title,
+                         "role",           role,
+                         "modal",          TRUE,
+                         "help-func",      gimp_standard_help_func,
+                         "help-id",        GIMP_HELP_PATH_DIALOG,
+                         "parent",         parent ? gtk_widget_get_toplevel (parent) : NULL,
+                         "use-header-bar", FALSE,
+                         NULL);
+
+  gimp_dialog_add_buttons (GIMP_DIALOG (dialog),
+                           _("_Annuler"), GTK_RESPONSE_CANCEL,
+                           _("_Valider"), GTK_RESPONSE_OK,
+                           NULL);
+  gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_OK);
+
+  return dialog;
+}
+
+static GtkWidget *
+content_box (GtkWidget *dialog)
+{
+  GtkWidget *vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 8);
+
+  gtk_container_set_border_width (GTK_CONTAINER (vbox), 12);
+  gtk_box_pack_start (GTK_BOX (gtk_dialog_get_content_area (GTK_DIALOG (dialog))),
+                      vbox, TRUE, TRUE, 0);
+
+  return vbox;
+}
+
+static GtkAdjustment *
+add_scale (GtkWidget   *box,
+           const gchar *label,
+           gdouble      value,
+           gdouble      lower,
+           gdouble      upper,
+           gint         digits)
+{
+  GtkAdjustment *adj   = gtk_adjustment_new (value, lower, upper, 1, 10, 0);
+  GtkWidget     *scale = gimp_spin_scale_new (adj, label, digits);
+
+  gtk_box_pack_start (GTK_BOX (box), scale, FALSE, FALSE, 0);
+
+  return adj;
+}
+
+static GtkWidget *
+add_combo (GtkWidget    *box,
+           const gchar  *label,
+           const gchar **items,
+           gint          active)
+{
+  GtkWidget *hbox  = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  GtkWidget *combo = gtk_combo_box_text_new ();
+
+  gtk_box_pack_start (GTK_BOX (hbox), gtk_label_new (label), FALSE, FALSE, 0);
+
+  for (gint i = 0; items[i]; i++)
+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (combo), items[i]);
+
+  gtk_combo_box_set_active (GTK_COMBO_BOX (combo), active);
+  gtk_box_pack_start (GTK_BOX (hbox), combo, TRUE, TRUE, 0);
+  gtk_box_pack_start (GTK_BOX (box), hbox, FALSE, FALSE, 0);
+
+  return combo;
+}
+
+
+/*  ─── Options de transition ─────────────────────────────────────────── */
+
+gboolean
+chopgimp_blend_options_dialog_show (GimpImage       *image,
+                                    GimpVectorLayer *layer,
+                                    GtkWidget       *parent)
+{
+  const gchar          *spacings[] = { N_("Couleur lissée"), N_("Nombre d'étapes"),
+                                       N_("Distance spécifiée"), NULL };
+  const gchar          *orients[]  = { N_("Aligner sur la page"),
+                                       N_("Aligner sur le tracé"), NULL };
+  const gchar          *labels[4];
+  const gchar          *olabels[3];
+  ChopGimpBlendSpacing  spacing = CHOPGIMP_BLEND_SMOOTH;
+  gdouble               value   = 10;
+  gboolean              orient  = FALSE;
+  gboolean              exists;
+  GtkWidget            *dialog, *vbox, *combo, *ocombo;
+  GtkAdjustment        *steps, *dist;
+  gboolean              done = FALSE;
+
+  exists = chopgimp_vblend_get_options (layer, &spacing, &value, &orient);
+
+  /*  no blend yet: the options are for the one made from the selection  */
+  if (! exists && ! chopgimp_vblend_can_make (layer))
+    return FALSE;
+
+  for (gint i = 0; i < 3; i++)
+    labels[i] = _(spacings[i]);
+  labels[3] = NULL;
+  for (gint i = 0; i < 2; i++)
+    olabels[i] = _(orients[i]);
+  olabels[2] = NULL;
+
+  dialog = new_dialog (_("Options de transition"), "chopgimp-blend-options", parent);
+  vbox   = content_box (dialog);
+
+  combo = add_combo (vbox, _("Espacement :"), labels, spacing);
+  steps = add_scale (vbox, _("Étapes"), spacing == CHOPGIMP_BLEND_STEPS ? value : 10,
+                     1, 1000, 0);
+  dist  = add_scale (vbox, _("Distance (px)"),
+                     spacing == CHOPGIMP_BLEND_DISTANCE ? value : 10, 0.1, 1000, 1);
+  ocombo = add_combo (vbox, _("Orientation :"), olabels, orient ? 1 : 0);
+  gtk_widget_set_tooltip_text (ocombo,
+                               _("L'orientation le long du tracé suit la forme d'un "
+                                 "tracé de base ; sans tracé de base (transition "
+                                 "droite), les deux réglages donnent le même résultat"));
+
+  gtk_widget_show_all (vbox);
+
+  if (gimp_dialog_run (GIMP_DIALOG (dialog)) == GTK_RESPONSE_OK)
+    {
+      ChopGimpBlendSpacing sp = gtk_combo_box_get_active (GTK_COMBO_BOX (combo));
+      gdouble              v  = (sp == CHOPGIMP_BLEND_STEPS)    ? gtk_adjustment_get_value (steps) :
+                                (sp == CHOPGIMP_BLEND_DISTANCE) ? gtk_adjustment_get_value (dist)  :
+                                                                   0.0;
+      gboolean             op = gtk_combo_box_get_active (GTK_COMBO_BOX (ocombo)) == 1;
+
+      if (! exists)
+        exists = chopgimp_vblend_make (layer) != NULL;
+
+      if (exists)
+        done = chopgimp_vblend_set_options (layer, sp, v, op);
+    }
+
+  gtk_widget_destroy (dialog);
+
+  if (done)
+    gimp_image_flush (image);
+
+  return done;
+}
+
+
+/*  ─── Créer un filet de dégradé ─────────────────────────────────────── */
+
+gboolean
+chopgimp_mesh_dialog_show (GimpImage       *image,
+                           GimpVectorLayer *layer,
+                           GtkWidget       *parent)
+{
+  const gchar   *looks[] = { N_("Plat"), N_("Vers le centre"), N_("Vers le bord"), NULL };
+  const gchar   *labels[4];
+  GtkWidget     *dialog, *vbox, *combo;
+  GtkAdjustment *rows, *cols, *hl;
+  gboolean       done = FALSE;
+
+  if (! layer || chopgimp_vobjects_n_selected (layer) == 0)
+    return FALSE;
+
+  for (gint i = 0; i < 3; i++)
+    labels[i] = _(looks[i]);
+  labels[3] = NULL;
+
+  dialog = new_dialog (_("Créer un filet de dégradé"), "chopgimp-mesh", parent);
+  vbox   = content_box (dialog);
+
+  rows  = add_scale (vbox, _("Rangées"),  4, 1, 32, 0);
+  cols  = add_scale (vbox, _("Colonnes"), 4, 1, 32, 0);
+  combo = add_combo (vbox, _("Aspect :"), labels, 0);
+  hl    = add_scale (vbox, _("Lumière (%)"), 100, 0, 100, 0);
+
+  gtk_widget_show_all (vbox);
+
+  if (gimp_dialog_run (GIMP_DIALOG (dialog)) == GTK_RESPONSE_OK)
+    done = chopgimp_vmaterial_make_mesh (layer,
+                                         (gint) gtk_adjustment_get_value (rows),
+                                         (gint) gtk_adjustment_get_value (cols),
+                                         gtk_combo_box_get_active (GTK_COMBO_BOX (combo)),
+                                         gtk_adjustment_get_value (hl) / 100.0);
+
+  gtk_widget_destroy (dialog);
+
+  if (done)
+    gimp_image_flush (image);
+
+  return done;
+}
+
+
+/*  ─── Options de motif ──────────────────────────────────────────────── */
+
+typedef struct
+{
+  GimpImage        *image;
+  ChopGimpVPattern  p;
+  GtkWidget        *area, *name, *type;
+  GtkAdjustment    *w, *h, *hs, *vs, *dim;
+} PatternDialog;
+
+static void
+pattern_read (PatternDialog *d)
+{
+  d->p.type   = gtk_combo_box_get_active (GTK_COMBO_BOX (d->type));
+  d->p.w      = gtk_adjustment_get_value (d->w);
+  d->p.h      = gtk_adjustment_get_value (d->h);
+  d->p.hspace = gtk_adjustment_get_value (d->hs);
+  d->p.vspace = gtk_adjustment_get_value (d->vs);
+  d->p.dim    = gtk_adjustment_get_value (d->dim) / 100.0;
+}
+
+static gboolean
+pattern_draw (GtkWidget     *area,
+              cairo_t       *cr,
+              PatternDialog *d)
+{
+  gint    w = gtk_widget_get_allocated_width  (area);
+  gint    h = gtk_widget_get_allocated_height (area);
+  gdouble scale;
+
+  pattern_read (d);
+
+  /*  white page, about 5 × 4 tiles  */
+  cairo_set_source_rgb (cr, 1, 1, 1);
+  cairo_paint (cr);
+
+  scale = MIN (w / (5.0 * MAX (d->p.w + d->p.hspace, 1.0)),
+               h / (4.0 * MAX (d->p.h + d->p.vspace, 1.0)));
+  scale = CLAMP (scale, 0.05, 8.0);
+
+  cairo_scale (cr, scale, scale);
+  chopgimp_vpattern_draw (&d->p, d->image, cr, w / scale, h / scale);
+
+  return TRUE;
+}
+
+static void
+pattern_changed (gpointer       widget,
+                 PatternDialog *d)
+{
+  gtk_widget_queue_draw (d->area);
+}
+
+/*  the pattern of the fill of a selected object  */
+static gchar *
+selected_spec (GimpVectorLayer *layer)
+{
+  GList *sel  = chopgimp_vlayer_get_selected_objects (layer);
+  gchar *spec = NULL;
+
+  for (GList *l = sel; l && ! spec; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      if (o->kind != CHOPGIMP_VOBJECT_PATH)
+        continue;
+
+      for (gint k = 0; k < chopgimp_vstyle_get_n_entries (&o->style) && ! spec; k++)
+        {
+          ChopGimpVEntry *e = chopgimp_vstyle_get_entry (&o->style, k);
+
+          if (e->paint.type == CHOPGIMP_PAINT_VPATTERN)
+            spec = g_strdup (e->paint.material);
+        }
+    }
+
+  g_list_free (sel);
+
+  return spec;
+}
+
+gboolean
+chopgimp_pattern_options_dialog_show (GimpImage       *image,
+                                      GimpVectorLayer *layer,
+                                      const gchar     *spec,
+                                      GtkWidget       *parent)
+{
+  const gchar   *types[] = { N_("Grille"), N_("Brique par ligne"),
+                             N_("Brique par colonne"), N_("Hexagonal"), NULL };
+  const gchar   *labels[5];
+  PatternDialog  d = { 0, };
+  GtkWidget     *dialog, *hbox, *vbox, *nbox;
+  gchar         *own = NULL;
+  gboolean       done = FALSE;
+  gboolean       new_pattern = (spec != NULL);
+
+  if (! spec)
+    spec = own = selected_spec (layer);
+
+  if (! spec || ! chopgimp_vpattern_parse (spec, &d.p))
+    {
+      g_free (own);
+      return FALSE;
+    }
+
+  d.image = image;
+
+  for (gint i = 0; i < 4; i++)
+    labels[i] = _(types[i]);
+  labels[4] = NULL;
+
+  dialog = new_dialog (_("Options de motif"), "chopgimp-pattern-options", parent);
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+  gtk_container_set_border_width (GTK_CONTAINER (hbox), 12);
+  gtk_box_pack_start (GTK_BOX (gtk_dialog_get_content_area (GTK_DIALOG (dialog))),
+                      hbox, TRUE, TRUE, 0);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 8);
+  gtk_box_pack_start (GTK_BOX (hbox), vbox, FALSE, FALSE, 0);
+
+  nbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  gtk_box_pack_start (GTK_BOX (nbox), gtk_label_new (_("Nom :")), FALSE, FALSE, 0);
+  d.name = gtk_entry_new ();
+  gtk_entry_set_text (GTK_ENTRY (d.name), d.p.name ? d.p.name : "");
+  gtk_box_pack_start (GTK_BOX (nbox), d.name, TRUE, TRUE, 0);
+  gtk_box_pack_start (GTK_BOX (vbox), nbox, FALSE, FALSE, 0);
+
+  d.type = add_combo (vbox, _("Type de pavage :"), labels, d.p.type);
+  d.w    = add_scale (vbox, _("Largeur (px)"),  d.p.w, 1, 10000, 1);
+  d.h    = add_scale (vbox, _("Hauteur (px)"),  d.p.h, 1, 10000, 1);
+  d.hs   = add_scale (vbox, _("Espacement horizontal (px)"), d.p.hspace, -5000, 5000, 1);
+  d.vs   = add_scale (vbox, _("Espacement vertical (px)"),   d.p.vspace, -5000, 5000, 1);
+  gtk_widget_set_tooltip_text (gtk_widget_get_parent (GTK_WIDGET (vbox)),
+                               _("Un espacement négatif fait chevaucher les copies"));
+  d.dim  = add_scale (vbox, _("Copies estompées (%)"), d.p.dim * 100, 0, 100, 0);
+
+  d.area = gtk_drawing_area_new ();
+  gtk_widget_set_size_request (d.area, 320, 260);
+  gtk_box_pack_start (GTK_BOX (hbox), d.area, TRUE, TRUE, 0);
+  g_signal_connect (d.area, "draw", G_CALLBACK (pattern_draw), &d);
+
+  g_signal_connect (d.type, "changed", G_CALLBACK (pattern_changed), &d);
+  g_signal_connect (d.w,   "value-changed", G_CALLBACK (pattern_changed), &d);
+  g_signal_connect (d.h,   "value-changed", G_CALLBACK (pattern_changed), &d);
+  g_signal_connect (d.hs,  "value-changed", G_CALLBACK (pattern_changed), &d);
+  g_signal_connect (d.vs,  "value-changed", G_CALLBACK (pattern_changed), &d);
+  g_signal_connect (d.dim, "value-changed", G_CALLBACK (pattern_changed), &d);
+
+  gtk_widget_show_all (hbox);
+
+  if (gimp_dialog_run (GIMP_DIALOG (dialog)) == GTK_RESPONSE_OK)
+    {
+      gchar *nspec;
+
+      pattern_read (&d);
+      d.p.dim = 0.0;   /* the editor's dimming is not part of the fill */
+      g_free (d.p.name);
+      d.p.name = g_strdup (gtk_entry_get_text (GTK_ENTRY (d.name)));
+
+      nspec = chopgimp_vpattern_to_spec (&d.p);
+      chopgimp_vpatterns_store (image, nspec);
+
+      /*  a new pattern fills the objects it was made from? No: like
+       *  Illustrator, it goes to the list; the selected objects that use
+       *  it (or, for the options of a pattern in use, the selection) take
+       *  the new settings
+       */
+      if (! new_pattern)
+        done = chopgimp_vmaterial_apply_pattern (layer, nspec);
+      else
+        done = TRUE;
+
+      g_free (nspec);
+    }
+
+  gtk_widget_destroy (dialog);
+  chopgimp_vpattern_clear (&d.p);
+  g_free (own);
+
+  if (done)
+    gimp_image_flush (image);
+
+  return done;
+}
+
+
+/*  ─── Appliquer un motif ────────────────────────────────────────────── */
+
+gboolean
+chopgimp_pattern_apply_dialog_show (GimpImage       *image,
+                                    GimpVectorLayer *layer,
+                                    GtkWidget       *parent)
+{
+  gchar     **specs = chopgimp_vpatterns_list (image);
+  GtkWidget  *dialog, *vbox, *combo;
+  gboolean    done = FALSE;
+  gint        n    = 0;
+
+  if (! layer || chopgimp_vobjects_n_selected (layer) == 0 || ! specs[0])
+    {
+      g_strfreev (specs);
+      return FALSE;
+    }
+
+  dialog = new_dialog (_("Appliquer un motif"), "chopgimp-pattern-apply", parent);
+  vbox   = content_box (dialog);
+  combo  = gtk_combo_box_text_new ();
+
+  for (gint i = 0; specs[i]; i++, n++)
+    {
+      ChopGimpVPattern p;
+
+      if (chopgimp_vpattern_parse (specs[i], &p))
+        {
+          gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (combo),
+                                          p.name && *p.name ? p.name : _("(sans nom)"));
+          chopgimp_vpattern_clear (&p);
+        }
+      else
+        gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (combo), "?");
+    }
+
+  gtk_combo_box_set_active (GTK_COMBO_BOX (combo), n - 1);
+  gtk_box_pack_start (GTK_BOX (vbox), gtk_label_new (_("Motif de l'image :")),
+                      FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (vbox), combo, FALSE, FALSE, 0);
+  gtk_widget_show_all (vbox);
+
+  if (gimp_dialog_run (GIMP_DIALOG (dialog)) == GTK_RESPONSE_OK)
+    {
+      gint i = gtk_combo_box_get_active (GTK_COMBO_BOX (combo));
+
+      if (i >= 0 && i < n)
+        done = chopgimp_vmaterial_apply_pattern (layer, specs[i]);
+    }
+
+  gtk_widget_destroy (dialog);
+  g_strfreev (specs);
+
+  if (done)
+    gimp_image_flush (image);
+
+  return done;
+}
+
+
+/*  ─── 3.30.0: Options de répétition ─────────────────────────────────── */
+
+gboolean
+chopgimp_repeat_options_dialog_show (GimpImage       *image,
+                                     GimpVectorLayer *layer,
+                                     gint             type,
+                                     GtkWidget       *parent)
+{
+  const gchar          *types[]  = { N_("Radiale"), N_("Grille"), N_("Miroir"), NULL };
+  const gchar          *flips[]  = { N_("Aucun"), N_("Horizontal"), N_("Vertical"), NULL };
+  const gchar          *tlabels[4], *flabels[4];
+  ChopGimpRepeatOptions o;
+  gboolean              exists, done = FALSE;
+  GtkWidget            *dialog, *vbox, *combo, *frow, *fcol;
+  GtkAdjustment        *count, *radius, *angle, *cols, *rows, *hgap, *vgap, *offset;
+
+  exists = chopgimp_vrepeat_get_options (layer, &o);
+
+  if (! exists)
+    {
+      if (! chopgimp_vrepeat_can_make (layer))
+        return FALSE;
+
+      chopgimp_vrepeat_default_options (CLAMP (type, 0, 2), 100, 100, &o);
+    }
+
+  for (gint i = 0; i < 3; i++)
+    {
+      tlabels[i] = _(types[i]);
+      flabels[i] = _(flips[i]);
+    }
+  tlabels[3] = flabels[3] = NULL;
+
+  dialog = new_dialog (_("Options de répétition"), "chopgimp-repeat-options", parent);
+  vbox   = content_box (dialog);
+
+  combo  = add_combo (vbox, _("Type :"), tlabels, o.type);
+
+  count  = add_scale (vbox, _("Radiale : nombre d'instances"), o.count, 2, 360, 0);
+  radius = add_scale (vbox, _("Radiale : rayon (px)"), o.radius, 0, 10000, 1);
+  angle  = add_scale (vbox, _("Angle (°) : radiale, axe du miroir"), o.angle, -360, 360, 1);
+  cols   = add_scale (vbox, _("Grille : colonnes"), o.cols, 1, 200, 0);
+  rows   = add_scale (vbox, _("Grille : rangées"), o.rows, 1, 200, 0);
+  hgap   = add_scale (vbox, _("Grille : espacement horizontal (px)"), o.hgap, -1000, 10000, 1);
+  vgap   = add_scale (vbox, _("Grille : espacement vertical (px)"), o.vgap, -1000, 10000, 1);
+  frow   = add_combo (vbox, _("Grille : retourner une rangée sur deux :"), flabels, o.flip_row);
+  fcol   = add_combo (vbox, _("Grille : retourner une colonne sur deux :"), flabels, o.flip_col);
+  offset = add_scale (vbox, _("Miroir : distance de l'axe (px)"), o.offset, -10000, 10000, 1);
+
+  gtk_widget_show_all (vbox);
+
+  if (gimp_dialog_run (GIMP_DIALOG (dialog)) == GTK_RESPONSE_OK)
+    {
+      o.type     = gtk_combo_box_get_active (GTK_COMBO_BOX (combo));
+      o.count    = (gint) gtk_adjustment_get_value (count);
+      o.radius   = gtk_adjustment_get_value (radius);
+      o.angle    = gtk_adjustment_get_value (angle);
+      o.cols     = (gint) gtk_adjustment_get_value (cols);
+      o.rows     = (gint) gtk_adjustment_get_value (rows);
+      o.hgap     = gtk_adjustment_get_value (hgap);
+      o.vgap     = gtk_adjustment_get_value (vgap);
+      o.flip_row = gtk_combo_box_get_active (GTK_COMBO_BOX (frow));
+      o.flip_col = gtk_combo_box_get_active (GTK_COMBO_BOX (fcol));
+      o.offset   = gtk_adjustment_get_value (offset);
+
+      if (exists)
+        done = chopgimp_vrepeat_set_options (layer, &o);
+      else
+        done = chopgimp_vrepeat_make (layer, o.type, &o) != NULL;
+    }
+
+  gtk_widget_destroy (dialog);
+
+  if (done)
+    gimp_image_flush (image);
+
+  return done;
+}
+
+
+/*  ─── 3.30.0: Options de la forme de pinceau ────────────────────────── */
+
+gboolean
+chopgimp_brush_options_edit (GtkWidget             *parent,
+                             const gchar           *title,
+                             ChopGimpVBrushOptions *o,
+                             gboolean               offer_defined)
+{
+  const gchar   *types[] = { N_("Calligraphique"), N_("Art"), N_("Motif"),
+                             N_("Dispersion"), NULL };
+  const gchar   *modes[] = { N_("Fixe"), N_("Aléatoire"), N_("Pression"), NULL };
+  const gchar   *tlabels[5], *mlabels[4];
+  gboolean       ok = FALSE;
+  GtkWidget     *dialog, *vbox, *combo, *follow, *flip, *tint, *defined = NULL;
+  GtkWidget     *amode, *rmode, *dmode;
+  GtkAdjustment *angle, *roundness, *size, *spacing, *scatter, *rotation, *sizevar, *seed;
+  GtkAdjustment *avar, *rvar, *dvar;
+
+  for (gint i = 0; i < 4; i++)
+    tlabels[i] = _(types[i]);
+  tlabels[4] = NULL;
+  for (gint i = 0; i < 3; i++)
+    mlabels[i] = _(modes[i]);
+  mlabels[3] = NULL;
+
+  dialog = new_dialog (title, "chopgimp-brush-options", parent);
+  vbox   = content_box (dialog);
+
+  combo     = add_combo (vbox, _("Forme :"), tlabels, o->type);
+  angle     = add_scale (vbox, _("Calligraphique : angle (°)"), o->angle, -180, 180, 0);
+  amode     = add_combo (vbox, _("  angle :"), mlabels, o->angle_mode);
+  avar      = add_scale (vbox, _("  variation de l'angle (°)"), o->angle_var, 0, 180, 0);
+  roundness = add_scale (vbox, _("Calligraphique : arrondi (%)"), o->roundness, 1, 100, 0);
+  rmode     = add_combo (vbox, _("  arrondi :"), mlabels, o->round_mode);
+  rvar      = add_scale (vbox, _("  variation de l'arrondi (%)"), o->round_var, 0, 100, 0);
+  size      = add_scale (vbox, _("Taille (calligraphique : diamètre en px, 0 = épaisseur "
+                                 "du contour ; autres : %)"), o->size, 0, 2000, 1);
+  dmode     = add_combo (vbox, _("  diamètre :"), mlabels, o->diam_mode);
+  dvar      = add_scale (vbox, _("  variation du diamètre (px)"), o->diam_var, 0, 1000, 1);
+  spacing   = add_scale (vbox, _("Espacement (motif : px ; dispersion : %)"),
+                         o->spacing, -100, 1000, 1);
+  scatter   = add_scale (vbox, _("Dispersion : écart (%)"), o->scatter, 0, 1000, 0);
+  rotation  = add_scale (vbox, _("Dispersion : rotation aléatoire (°)"), o->rotation, 0, 180, 0);
+  sizevar   = add_scale (vbox, _("Dispersion : variation de taille (%)"), o->size_var, 0, 100, 0);
+  seed      = add_scale (vbox, _("Tirage aléatoire"), o->seed, 0, 9999, 0);
+
+  follow = gtk_check_button_new_with_label (_("Dispersion : tourner le long du tracé"));
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (follow), o->follow);
+  gtk_box_pack_start (GTK_BOX (vbox), follow, FALSE, FALSE, 0);
+
+  flip = gtk_check_button_new_with_label (_("Art et motif : retourner en travers du tracé"));
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (flip), o->flip);
+  gtk_box_pack_start (GTK_BOX (vbox), flip, FALSE, FALSE, 0);
+
+  tint = gtk_check_button_new_with_label (_("Teintes : l'illustration prend la couleur du contour"));
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (tint), o->colorize);
+  gtk_box_pack_start (GTK_BOX (vbox), tint, FALSE, FALSE, 0);
+
+  if (offer_defined)
+    {
+      defined = gtk_check_button_new_with_label (_("Utiliser l'illustration définie "
+                                                   "(Définir l'illustration)"));
+      gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (defined), FALSE);
+      gtk_widget_set_sensitive (defined, chopgimp_vbrush_has_defined ());
+      gtk_box_pack_start (GTK_BOX (vbox), defined, FALSE, FALSE, 0);
+    }
+
+  gtk_widget_show_all (vbox);
+
+  if (gimp_dialog_run (GIMP_DIALOG (dialog)) == GTK_RESPONSE_OK)
+    {
+      o->type        = gtk_combo_box_get_active (GTK_COMBO_BOX (combo));
+      o->angle       = gtk_adjustment_get_value (angle);
+      o->roundness   = gtk_adjustment_get_value (roundness);
+      o->size        = gtk_adjustment_get_value (size);
+      o->spacing     = gtk_adjustment_get_value (spacing);
+      o->scatter     = gtk_adjustment_get_value (scatter);
+      o->rotation    = gtk_adjustment_get_value (rotation);
+      o->size_var    = gtk_adjustment_get_value (sizevar);
+      o->seed        = (gint) gtk_adjustment_get_value (seed);
+      o->angle_mode  = gtk_combo_box_get_active (GTK_COMBO_BOX (amode));
+      o->round_mode  = gtk_combo_box_get_active (GTK_COMBO_BOX (rmode));
+      o->diam_mode   = gtk_combo_box_get_active (GTK_COMBO_BOX (dmode));
+      o->angle_var   = gtk_adjustment_get_value (avar);
+      o->round_var   = gtk_adjustment_get_value (rvar);
+      o->diam_var    = gtk_adjustment_get_value (dvar);
+      o->follow      = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (follow));
+      o->flip        = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (flip));
+      o->colorize    = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (tint));
+      o->use_defined = defined && gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (defined));
+      ok = TRUE;
+    }
+
+  gtk_widget_destroy (dialog);
+
+  return ok;
+}
+
+gboolean
+chopgimp_brush_options_dialog_show (GimpImage       *image,
+                                    GimpVectorLayer *layer,
+                                    GtkWidget       *parent)
+{
+  ChopGimpVBrushOptions o;
+  gboolean              done = FALSE;
+
+  if (! chopgimp_vbrush_can_apply (layer))
+    return FALSE;
+
+  if (! chopgimp_vbrush_get_options (layer, &o))
+    chopgimp_vbrush_default_options (CHOPGIMP_VBRUSH_CALLIGRAPHIC, &o);
+
+  if (chopgimp_brush_options_edit (parent, _("Options de la forme de pinceau"), &o, TRUE))
+    done = chopgimp_vbrush_apply (layer, &o);
+
+  if (done)
+    gimp_image_flush (image);
+
+  return done;
+}
