+/*  ChopGimp 3.29.3 (Illustrator): with objects selected in the active
+ *  vector layer, a click of the Color Picker on another object copies its
+ *  fill and stroke to them (« Pipette de style »), like Illustrator's
+ *  eyedropper; anywhere else, or with a modifier, it picks a color.
+ */
+static void
+gimp_color_picker_tool_button_press (GimpTool            *tool,
+                                     const GimpCoords    *coords,
+                                     guint32              time,
+                                     GdkModifierType      state,
+                                     GimpButtonPressType  press_type,
+                                     GimpDisplay         *display)
+{
+  GimpImage       *image = gimp_display_get_image (display);
+  GimpVectorLayer *layer = NULL;
+
+  if (image && chopgimp_vobjects_enabled ())
+    layer = chopgimp_vobjects_get_active_layer (image);
+
+  if (layer && press_type == GIMP_BUTTON_PRESS_NORMAL &&
+      ! (state & gimp_get_all_modifiers_mask ()) &&
+      chopgimp_vobjects_n_selected (layer) > 0)
+    {
+      GimpDisplayShell *shell = gimp_display_get_shell (display);
+      ChopGimpVObject  *hit;
+
+      hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y,
+                                      3.0 / MAX (shell->scale_x, 1e-6),
+                                      CHOPGIMP_HIT_LEAF);
+
+      if (hit && ! chopgimp_vlayer_is_selected (layer, hit->id))
+        {
+          if (chopgimp_vobjects_copy_style (layer, hit))
+            gimp_image_flush (image);
+
+          return;
+        }
+    }
+
+  GIMP_TOOL_CLASS (parent_class)->button_press (tool, coords, time, state,
+                                                press_type, display);
