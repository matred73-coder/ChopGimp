diff --git a/app/display/gimpdisplayshell-dnd.c b/app/display/gimpdisplayshell-dnd.c
index 88388f3..edc10ed 100644
--- a/app/display/gimpdisplayshell-dnd.c
+++ b/app/display/gimpdisplayshell-dnd.c
@@ -59,6 +59,12 @@
 
 #include "widgets/gimpdnd.h"
 
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vobject-ops.h"
+#include "path/chopgimp-vcolors.h"
+#include "path/chopgimp-vrecolor.h"
+#include "path/chopgimp-vsymbols.h"
+
 #include "gimpdisplay.h"
 #include "gimpdisplayshell.h"
 #include "gimpdisplayshell-dnd.h"
@@ -495,11 +501,74 @@ gimp_display_shell_drop_pattern (GtkWidget    *widget,
                                  gpointer      data)
 {
   GimpDisplayShell *shell   = GIMP_DISPLAY_SHELL (data);
-  GimpFillOptions  *options = gimp_fill_options_new (shell->display->gimp,
-                                                     NULL, FALSE);
+  GimpFillOptions  *options;
 
   GIMP_LOG (DND, NULL);
 
+  /*  ChopGimp 3.28.2: a symbol dragged from the « Symboles » panel: an
+   *  occurrence where it is dropped
+   */
+  if (chopgimp_vsymbols_get_dragged () && shell->display)
+    {
+      GimpImage *image = gimp_display_get_image (shell->display);
+      gchar     *id    = g_strdup (chopgimp_vsymbols_get_dragged ());
+      gdouble    ix, iy;
+
+      gimp_display_shell_untransform_xy_f (shell, x, y, &ix, &iy);
+
+      if (image &&
+          chopgimp_vsymbols_place_at (image, chopgimp_vobjects_get_target_layer (image), id,
+                                      gimp_get_user_context (shell->display->gimp),
+                                      TRUE, ix, iy))
+        gimp_image_flush (image);
+
+      g_free (id);
+      return;
+    }
+
+  /*  ChopGimp 3.28.2: a global color dragged from its panel onto an
+   *  object of the vector layer: the object's fill follows it (Shift:
+   *  its stroke)
+   */
+  if (chopgimp_vcolors_get_dragged () && shell->display)
+    {
+      GimpImage       *image = gimp_display_get_image (shell->display);
+      GimpVectorLayer *layer = image ? chopgimp_vobjects_get_target_layer (image) : NULL;
+      ChopGimpVObject *hit   = NULL;
+      gdouble          ix, iy;
+
+      gimp_display_shell_untransform_xy_f (shell, x, y, &ix, &iy);
+
+      if (layer)
+        hit = chopgimp_vlayer_hit_test (layer, ix, iy,
+                                        4.0 / MAX (shell->scale_x, 1e-6),
+                                        CHOPGIMP_HIT_LEAF);
+      if (hit)
+        {
+          GdkModifierType mods  = 0;
+          gchar          *id    = g_strdup (chopgimp_vcolors_get_dragged ());
+          GdkSeat        *seat  = gdk_display_get_default_seat (gtk_widget_get_display (widget));
+
+          gdk_window_get_device_position (gtk_widget_get_window (widget),
+                                          gdk_seat_get_pointer (seat),
+                                          NULL, NULL, &mods);
+
+          gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC,
+                                       _("Appliquer la couleur globale"));
+          chopgimp_vlayer_set_selection (layer, &hit->id, 1);
+          chopgimp_vobjects_link_global (layer,
+                                         (mods & GDK_SHIFT_MASK) ? CHOPGIMP_VLINK_STROKE
+                                                                 : CHOPGIMP_VLINK_FILL,
+                                         id, TRUE);
+          gimp_image_undo_group_end (image);
+          gimp_image_flush (image);
+          g_free (id);
+          return;
+        }
+    }
+
+  options = gimp_fill_options_new (shell->display->gimp, NULL, FALSE);
+
   gimp_fill_options_set_style (options, GIMP_FILL_STYLE_PATTERN);
   gimp_context_set_pattern (GIMP_CONTEXT (options), GIMP_PATTERN (viewable));
 
diff --git a/app/path/chopgimp-vdistort.c b/app/path/chopgimp-vdistort.c
