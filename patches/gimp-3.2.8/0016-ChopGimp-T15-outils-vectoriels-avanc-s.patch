+  ChopGimpFreeformEdit *fe            = FREEFORM (draw_tool);
+
+  GIMP_DRAW_TOOL_CLASS (parent_class)->draw (draw_tool);
+
+  if (fe && fe->layer && ! gradient_tool->widget)
+    chopgimp_freeform_edit_draw (fe, draw_tool);
+}
