+
+#include "gimpdialogfactory.h"
+#include "gimpdnd.h"
+#include "gimpeditor.h"
+#include "gimphelp-ids.h"
+
+#include "chopgimp-symbols-editor.h"
+
+#include "gimp-intl.h"
+
+
+/*  3.28.2: drag a symbol onto the canvas  */
+static void sym_drag_color (GtkWidget      *widget,
+                            GeglColor     **color,
+                            gpointer        data);
+static void sym_drag_begin (GtkWidget      *widget,
+                            GdkDragContext *context,
+                            gpointer        data);
+static void sym_drag_end   (GtkWidget      *widget,
+                            GdkDragContext *context,
+                            gpointer        data);
+
+
+#define THUMB 56
+
+typedef struct
+{
+  Gimp            *gimp;
+  GimpContext     *context;
+  GtkWidget       *editor;
+  GtkWidget       *hint;
+  GtkWidget       *content;
+  GtkWidget       *empty;
+  GtkWidget       *flow;
+
+  GtkWidget       *new_button;
+  GtkWidget       *place_button;
+  GtkWidget       *edit_button;
+  GtkWidget       *break_button;
+  GtkWidget       *rename_button;
+  GtkWidget       *delete_button;
+
+  GimpImage       *image;      /* weak */
+  GimpVectorLayer *layer;      /* weak */
+  gchar           *selected;   /* symbol id */
+  gboolean         loading;
+  guint            idle_id;
+} Panel;
+
+static void panel_queue_refresh (Panel *p);
+
+
+/*  ─── thumbnails ────────────────────────────────────────────────────── */
+
+static gboolean
+thumb_draw (GtkWidget *widget,
+            cairo_t   *cr,
+            gpointer   data)
+{
+  ChopGimpVObject *root = g_object_get_data (G_OBJECT (widget), "chopgimp-root");
+  gint             w    = gtk_widget_get_allocated_width (widget);
+  gint             h    = gtk_widget_get_allocated_height (widget);
+  gdouble          b[4], s;
+
+  /*  a checkerboard, so that white objects show  */
+  for (gint y = 0; y < h; y += 8)
+    for (gint x = 0; x < w; x += 8)
+      {
+        gdouble v = (((x + y) / 8) % 2) ? 0.62 : 0.78;
+
+        cairo_set_source_rgb (cr, v, v, v);
+        cairo_rectangle (cr, x, y, 8, 8);
+        cairo_fill (cr);
+      }
+
+  if (! root || ! chopgimp_vobject_preview_bounds (root, b))
+    return FALSE;
+
+  s = MIN ((w - 8) / MAX (b[2] - b[0], 1.0), (h - 8) / MAX (b[3] - b[1], 1.0));
+
+  cairo_save (cr);
+  cairo_translate (cr, w / 2.0, h / 2.0);
+  cairo_scale (cr, s, s);
+  cairo_translate (cr, -(b[0] + b[2]) / 2.0, -(b[1] + b[3]) / 2.0);
+  chopgimp_vobject_draw_preview (root, cr);
+  cairo_restore (cr);
+
+  return FALSE;
+}
+
+static GtkWidget *
+thumb_new (GimpImage             *image,
+           const ChopGimpVSymbol *sym)
+{
+  GtkWidget       *area = gtk_drawing_area_new ();
+  ChopGimpVObject *root = chopgimp_vsymbol_get_objects (image, sym);
+  gint             n    = chopgimp_vsymbols_count_uses (image, sym->id);
+  gchar           *tip;
+
+  gtk_widget_set_size_request (area, THUMB, THUMB);
+
+  if (root)
+    g_object_set_data_full (G_OBJECT (area), "chopgimp-root", root,
+                            (GDestroyNotify) chopgimp_vobject_unref);
+
+  g_signal_connect (area, "draw", G_CALLBACK (thumb_draw), NULL);
+
+  tip = g_strdup_printf (n == 1 ? _("%s — %d occurrence") : _("%s — %d occurrences"),
+                         sym->name, n);
+  gtk_widget_set_tooltip_text (area, tip);
+  g_free (tip);
+
+  return area;
+}
+
+
+/*  ─── refresh ───────────────────────────────────────────────────────── */
+
+static void
+panel_update_sensitivity (Panel *p)
+{
+  gboolean sel = p->selected != NULL;
+
+  gtk_widget_set_sensitive (p->new_button,
+                            p->layer && chopgimp_vsymbols_can_make (p->layer));
+  gtk_widget_set_sensitive (p->place_button,  p->image && sel);
+  gtk_widget_set_sensitive (p->edit_button,
+                            p->layer && (chopgimp_vsymbols_any_selected (p->layer) || sel));
+  gtk_widget_set_sensitive (p->break_button,
+                            p->layer && chopgimp_vsymbols_any_selected (p->layer));
+  gtk_widget_set_sensitive (p->rename_button, sel);
+  gtk_widget_set_sensitive (p->delete_button, sel);
+}
+
+static void
+flow_selection_changed (GtkFlowBox *flow,
+                        Panel      *p)
+{
+  GList *sel;
+
+  if (p->loading)
+    return;
+
+  sel = gtk_flow_box_get_selected_children (flow);
+
+  g_free (p->selected);
+  p->selected = sel ? g_strdup (g_object_get_data (sel->data, "chopgimp-id")) : NULL;
+  g_list_free (sel);
+
+  panel_update_sensitivity (p);
+}
+
+static void
+panel_refresh (Panel *p)
+{
+  GList    *symbols, *children;
+  gboolean  found = FALSE;
+
+  if (! chopgimp_vobjects_enabled ())
+    return;
+
+  gtk_widget_set_visible (p->hint,    p->image == NULL);
+  gtk_widget_set_visible (p->content, p->image != NULL);
+
+  p->loading = TRUE;
+
+  children = gtk_container_get_children (GTK_CONTAINER (p->flow));
+  for (GList *l = children; l; l = l->next)
+    gtk_widget_destroy (l->data);
+  g_list_free (children);
+
+  symbols = p->image ? chopgimp_vsymbols_list (p->image) : NULL;
+
+  for (GList *l = symbols; l; l = l->next)
+    {
+      ChopGimpVSymbol *sym   = l->data;
+      GtkWidget       *child = gtk_flow_box_child_new ();
+      GtkWidget       *box   = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+      GtkWidget       *label = gtk_label_new (sym->name);
+
+      gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_END);
+      gtk_label_set_max_width_chars (GTK_LABEL (label), 9);
+      gtk_style_context_add_class (gtk_widget_get_style_context (label), "dim-label");
+
+      gtk_box_pack_start (GTK_BOX (box), thumb_new (p->image, sym), FALSE, FALSE, 0);
+      gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+
+      /*  3.28.2: drag source (an event box: the child has no window)  */
+      {
+        GtkWidget *ebox = gtk_event_box_new ();
+
+        gtk_event_box_set_visible_window (GTK_EVENT_BOX (ebox), FALSE);
+        g_object_set_data_full (G_OBJECT (ebox), "chopgimp-id", g_strdup (sym->id), g_free);
+        gtk_container_add (GTK_CONTAINER (ebox), box);
+        gtk_container_add (GTK_CONTAINER (child), ebox);
+        gimp_dnd_color_source_add (ebox, sym_drag_color, p);
+        g_signal_connect_after (ebox, "drag-begin", G_CALLBACK (sym_drag_begin), p);
+        g_signal_connect (ebox, "drag-end", G_CALLBACK (sym_drag_end), p);
+        gimp_help_set_help_data (ebox, _("Glisser sur l'image pour placer une occurrence"), NULL);
+      }
+
+      g_object_set_data_full (G_OBJECT (child), "chopgimp-id", g_strdup (sym->id), g_free);
+      gtk_container_add (GTK_CONTAINER (p->flow), child);
+      gtk_widget_show_all (child);
+
+      if (! g_strcmp0 (sym->id, p->selected))
+        {
+          gtk_flow_box_select_child (GTK_FLOW_BOX (p->flow), GTK_FLOW_BOX_CHILD (child));
+          found = TRUE;
+        }
+    }
+
+  gtk_widget_set_visible (p->empty, p->image && ! symbols);
+
+  if (! found)
+    g_clear_pointer (&p->selected, g_free);
+
+  chopgimp_vsymbols_list_free (symbols);
+  p->loading = FALSE;
+
+  panel_update_sensitivity (p);
+}
+
+static gboolean
+panel_refresh_idle (gpointer data)
+{
+  Panel *p = data;
+
+  p->idle_id = 0;
+  panel_refresh (p);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+panel_queue_refresh (Panel *p)
+{
+  if (! p->idle_id && gtk_widget_get_mapped (p->editor))
+    p->idle_id = g_idle_add (panel_refresh_idle, p);
+}
+
+static void
+panel_queue_sensitivity (Panel *p)
+{
+  panel_update_sensitivity (p);
+}
+
+
+/*  ─── following the image ───────────────────────────────────────────── */
+
+static void
+panel_set_layer (Panel           *p,
+                 GimpVectorLayer *layer)
+{
+  if (layer == p->layer)
+    return;
+
+  if (p->layer)
+    {
+      g_signal_handlers_disconnect_by_data (p->layer, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->layer), (gpointer *) &p->layer);
+    }
+
+  p->layer = layer;
+
+  if (layer)
+    {
+      g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &p->layer);
+      g_signal_connect_swapped (layer, "object-selection-changed",
+                                G_CALLBACK (panel_queue_sensitivity), p);
+      g_signal_connect_swapped (layer, "objects-changed",
+                                G_CALLBACK (panel_queue_sensitivity), p);
+    }
+
+  panel_update_sensitivity (p);
+}
+
+static void
+panel_layers_changed (Panel *p)
+{
+  panel_set_layer (p, p->image ? chopgimp_vobjects_get_target_layer (p->image) : NULL);
+}
+
+static void
+panel_parasite_changed (Panel       *p,
+                        const gchar *name)
+{
+  if (! name || ! strcmp (name, "chopgimp-symbols"))
+    panel_queue_refresh (p);
+}
+
+static void
+panel_set_image (Panel     *p,
+                 GimpImage *image)
+{
+  if (image == p->image)
+    return;
+
+  panel_set_layer (p, NULL);
+
+  if (p->image)
+    {
+      g_signal_handlers_disconnect_by_data (p->image, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->image), (gpointer *) &p->image);
+    }
+
+  p->image = image;
+  g_clear_pointer (&p->selected, g_free);
+
+  if (image)
+    {
+      g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &p->image);
+      g_signal_connect_swapped (image, "selected-layers-changed",
+                                G_CALLBACK (panel_layers_changed), p);
+      g_signal_connect_swapped (image, "parasite-attached",
+                                G_CALLBACK (panel_parasite_changed), p);
+      g_signal_connect_swapped (image, "parasite-detached",
+                                G_CALLBACK (panel_parasite_changed), p);
+
+      panel_set_layer (p, chopgimp_vobjects_get_target_layer (image));
+    }
+
+  panel_queue_refresh (p);
+}
+
+static void
+panel_image_changed (GimpContext *context,
+                     GimpImage   *image,
+                     Panel       *p)
+{
+  panel_set_image (p, image);
+}
+
+
+/*  ─── actions ───────────────────────────────────────────────────────── */
+
+static void
+new_clicked (GtkWidget *button,
+             Panel     *p)
+{
+  gchar *id;
+
+  if (! p->layer)
+    return;
+
+  id = chopgimp_vsymbols_make (p->layer, NULL);
+
+  if (id)
+    {
+      g_free (p->selected);
+      p->selected = id;
+      gimp_image_flush (p->image);
+      panel_queue_refresh (p);
+    }
+}
+
+/*  3.28.2: drag a symbol onto the canvas (an occurrence where it is
+ *  dropped, see gimpdisplayshell-dnd.c); the drag carries a color for
+ *  GIMP's canvas drop, the symbol id is kept aside
+ */
+static void
+sym_drag_color (GtkWidget  *widget,
+                GeglColor **color,
+                gpointer    data)
+{
+  Panel *p = data;
+
+  *color = gegl_color_duplicate (gimp_context_get_foreground (p->context));
+}
+
+static void
+sym_drag_begin (GtkWidget      *widget,
+                GdkDragContext *context,
+                gpointer        data)
+{
+  chopgimp_vsymbols_set_dragged (g_object_get_data (G_OBJECT (widget), "chopgimp-id"));
+  gtk_drag_set_icon_name (context, "chopgimp-symbols", 8, 8);
+}
+
+static gboolean
+sym_drag_clear_idle (gpointer data)
+{
+  chopgimp_vsymbols_set_dragged (NULL);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+sym_drag_end (GtkWidget      *widget,
+              GdkDragContext *context,
+              gpointer        data)
+{
+  g_idle_add (sym_drag_clear_idle, NULL);
+}
+
+static void
+place_clicked (GtkWidget *button,
+               Panel     *p)
+{
+  if (p->image && p->selected &&
+      chopgimp_vsymbols_place (p->image, chopgimp_vobjects_get_target_layer (p->image),
+                               p->selected, p->context))
+    {
+      gimp_image_flush (p->image);
+      panel_queue_refresh (p);
+    }
+}
+
+static void
+flow_child_activated (GtkFlowBox      *flow,
+                      GtkFlowBoxChild *child,
+                      Panel           *p)
+{
+  place_clicked (NULL, p);
+}
+
+static void
+edit_clicked (GtkWidget *button,
+              Panel     *p)
+{
+  if (p->layer && chopgimp_vsymbols_edit (p->layer, p->selected))
+    gimp_image_flush (p->image);
+  else if (p->image)
+    gimp_message_literal (p->gimp, G_OBJECT (p->editor), GIMP_MESSAGE_INFO,
+                          _("Aucune occurrence de ce symbole dans le calque vectoriel "
+                            "actif : placez-en une, puis « Modifier le symbole »."));
+}
+
+static void
+break_clicked (GtkWidget *button,
+               Panel     *p)
+{
+  if (p->layer && chopgimp_vsymbols_break_link (p->layer))
+    {
+      gimp_image_flush (p->image);
+      panel_queue_refresh (p);
+    }
+}
+
+static void
+rename_callback (GtkWidget   *query_box,
+                 const gchar *string,
+                 gpointer     data)
+{
+  GimpImage *image = data;
+  gchar     *id    = g_object_get_data (G_OBJECT (query_box), "chopgimp-id");
+
+  if (id && string && *string && chopgimp_vsymbols_rename (image, id, string))
+    gimp_image_flush (image);
+}
+
+static void
+rename_clicked (GtkWidget *button,
+                Panel     *p)
+{
+  ChopGimpVSymbol *sym;
+  GtkWidget       *box;
+
+  if (! p->image || ! p->selected ||
+      ! (sym = chopgimp_vsymbols_lookup (p->image, p->selected)))
+    return;
+
+  box = gimp_query_string_box (_("Renommer le symbole"),
+                               p->editor,
+                               gimp_standard_help_func, GIMP_HELP_PATH_DIALOG,
+                               _("Nom du symbole :"),
+                               sym->name,
+                               G_OBJECT (p->image), "disconnect",
+                               rename_callback, p->image, NULL);
+  g_object_set_data_full (G_OBJECT (box), "chopgimp-id", g_strdup (sym->id), g_free);
+  gtk_widget_show (box);
+
+  chopgimp_vsymbol_free (sym);
+}
+
+static void
+delete_clicked (GtkWidget *button,
+                Panel     *p)
+{
+  if (p->image && p->selected && chopgimp_vsymbols_remove (p->image, p->selected))
+    gimp_image_flush (p->image);
+}
+
+
+/*  ─── construction ──────────────────────────────────────────────────── */
+
+static void
+panel_free (Panel *p)
+{
+  panel_set_image (p, NULL);
+
+  if (p->idle_id)
+    g_source_remove (p->idle_id);
+  p->idle_id = 0;
+
+  g_signal_handlers_disconnect_by_data (p->context, p);
+
+  g_free (p->selected);
+  g_free (p);
+}
+
+static GtkWidget *
+add_button (Panel       *p,
+            const gchar *icon,
+            const gchar *tip,
+            GCallback    callback)
+{
+  GtkWidget *b = gimp_editor_add_button (GIMP_EDITOR (p->editor), icon, tip, NULL,
+                                         NULL, NULL, NULL);
+
+  g_signal_connect (b, "clicked", callback, p);
+
+  return b;
+}
+
+GtkWidget *
+chopgimp_symbols_editor_new (GimpDialogFactory *factory,
+                             GimpContext       *context,
+                             GimpUIManager     *ui_manager,
+                             gint               view_size)
+{
+  Panel     *p      = g_new0 (Panel, 1);
+  GtkWidget *editor = g_object_new (GIMP_TYPE_EDITOR, NULL);
+  GtkWidget *box    = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  GtkWidget *label;
+  GtkWidget *scrolled;
+
+  p->gimp    = context->gimp;
+  p->editor  = editor;
+  p->context = gimp_get_user_context (context->gimp);
+
+  gtk_container_set_border_width (GTK_CONTAINER (box), 6);
+  gtk_box_pack_start (GTK_BOX (editor), box, TRUE, TRUE, 0);
+  gtk_widget_set_visible (box, TRUE);
+
+  g_object_set_data_full (G_OBJECT (editor), "chopgimp-panel", p,
+                          (GDestroyNotify) panel_free);
+
+  if (! chopgimp_vobjects_enabled ())
+    {
+      label = gtk_label_new (_("Les objets vectoriels sont désactivés "
+                               "(CHOPGIMP_NO_VOBJECTS=1)."));
+      gtk_label_set_line_wrap (GTK_LABEL (label), TRUE);
+      gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+      gtk_widget_set_visible (label, TRUE);
+
+      return editor;
+    }
+
+  p->hint = gtk_label_new (_("Ouvrez une image : ses symboles s'affichent ici."));
+  gtk_label_set_line_wrap (GTK_LABEL (p->hint), TRUE);
+  gtk_label_set_xalign (GTK_LABEL (p->hint), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (p->hint), "dim-label");
+  gtk_box_pack_start (GTK_BOX (box), p->hint, FALSE, FALSE, 0);
+  gtk_widget_set_no_show_all (p->hint, TRUE);
+
+  p->content = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_box_pack_start (GTK_BOX (box), p->content, TRUE, TRUE, 0);
+
+  p->empty = gtk_label_new (_("Aucun symbole. Sélectionnez des objets d'un calque "
+                              "vectoriel puis « Nouveau symbole » : chaque occurrence "
+                              "placée suit les modifications du symbole."));
+  gtk_label_set_line_wrap (GTK_LABEL (p->empty), TRUE);
+  gtk_label_set_xalign (GTK_LABEL (p->empty), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (p->empty), "dim-label");
+  gtk_box_pack_start (GTK_BOX (p->content), p->empty, FALSE, FALSE, 0);
+  gtk_widget_set_no_show_all (p->empty, TRUE);
+
+  scrolled = gtk_scrolled_window_new (NULL, NULL);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled),
+                                  GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_box_pack_start (GTK_BOX (p->content), scrolled, TRUE, TRUE, 0);
+
+  p->flow = gtk_flow_box_new ();
+  gtk_flow_box_set_selection_mode (GTK_FLOW_BOX (p->flow), GTK_SELECTION_SINGLE);
+  gtk_flow_box_set_activate_on_single_click (GTK_FLOW_BOX (p->flow), FALSE);
+  gtk_flow_box_set_homogeneous (GTK_FLOW_BOX (p->flow), TRUE);
+  gtk_widget_set_valign (p->flow, GTK_ALIGN_START);
+  g_signal_connect (p->flow, "selected-children-changed",
+                    G_CALLBACK (flow_selection_changed), p);
+  g_signal_connect (p->flow, "child-activated",
+                    G_CALLBACK (flow_child_activated), p);
+  gtk_container_add (GTK_CONTAINER (scrolled), p->flow);
+
+  gtk_widget_show_all (p->content);
+  gtk_widget_set_no_show_all (p->content, TRUE);
+
+  p->new_button    = add_button (p, GIMP_ICON_DOCUMENT_NEW,
+                                 _("Nouveau symbole : les objets sélectionnés deviennent "
+                                   "un symbole et sa première occurrence"),
+                                 G_CALLBACK (new_clicked));
+  p->place_button  = add_button (p, GIMP_ICON_GO_DOWN,
+                                 _("Placer une occurrence au centre de l'image "
+                                   "(double-clic)"),
+                                 G_CALLBACK (place_clicked));
+  p->edit_button   = add_button (p, GIMP_ICON_EDIT,
+                                 _("Modifier le symbole : ouvrir l'occurrence, ce qu'on y "
+                                   "change s'applique à toutes"),
+                                 G_CALLBACK (edit_clicked));
+  p->break_button  = add_button (p, GIMP_ICON_CHAIN_HORIZONTAL_BROKEN,
+                                 _("Rompre le lien : les occurrences sélectionnées "
+                                   "deviennent des groupes ordinaires"),
+                                 G_CALLBACK (break_clicked));
+  p->rename_button = add_button (p, GIMP_ICON_FORMAT_TEXT_BOLD,
+                                 _("Renommer le symbole"),
+                                 G_CALLBACK (rename_clicked));
+  p->delete_button = add_button (p, GIMP_ICON_EDIT_DELETE,
+                                 _("Supprimer le symbole (ses occurrences restent, comme "
+                                   "groupes)"),
+                                 G_CALLBACK (delete_clicked));
+
+  g_signal_connect (p->context, "image-changed",
+                    G_CALLBACK (panel_image_changed), p);
+  g_signal_connect_data (editor, "map", G_CALLBACK (panel_queue_refresh), p, NULL,
+                         G_CONNECT_SWAPPED | G_CONNECT_AFTER);
+
+  panel_set_image (p, gimp_context_get_image (p->context));
+  panel_refresh (p);
+
+  return editor;
+}
