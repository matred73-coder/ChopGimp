+
+/*  ─── geometry: box units ↔ image ───────────────────────────────────── */
+
+/*  the local box of @o's path (as the paint uses it)  */
+static gboolean
+object_box (ChopGimpVObject *o,
+            gdouble          box[4])
+{
+  const GimpBezierDesc *b;
+  cairo_surface_t      *s;
+  cairo_t              *cr;
+
+  if (! o || o->kind != CHOPGIMP_VOBJECT_PATH || ! o->path ||
+      gimp_path_get_n_strokes (o->path) == 0)
+    return FALSE;
+
+  b = gimp_path_get_bezier (o->path);
+
+  if (! b || b->num_data == 0)
+    return FALSE;
+
+  s  = cairo_image_surface_create (CAIRO_FORMAT_A8, 1, 1);
+  cr = cairo_create (s);
+  cairo_append_path (cr, (cairo_path_t *) b);
+  cairo_path_extents (cr, &box[0], &box[1], &box[2], &box[3]);
+  cairo_destroy (cr);
+  cairo_surface_destroy (s);
+
+  if (box[2] - box[0] < 1e-6) box[2] = box[0] + 1;
+  if (box[3] - box[1] < 1e-6) box[3] = box[1] + 1;
+
+  return TRUE;
+}
+
+static void
+box_to_image (ChopGimpVObject *o,
+              const gdouble    box[4],
+              gdouble          u,
+              gdouble          v,
+              gdouble         *x,
+              gdouble         *y)
+{
+  GimpMatrix3 m;
+  gdouble     lx = box[0] + u * (box[2] - box[0]);
+  gdouble     ly = box[1] + v * (box[3] - box[1]);
+
+  chopgimp_vobject_get_world_matrix (o, &m);
+  gimp_matrix3_transform_point (&m, lx, ly, x, y);
+}
+
+static void
+image_to_box (ChopGimpVObject *o,
+              const gdouble    box[4],
+              gdouble          x,
+              gdouble          y,
+              gdouble         *u,
+              gdouble         *v)
+{
+  GimpMatrix3 m;
+  gdouble     lx, ly;
+
+  chopgimp_vobject_get_world_matrix (o, &m);
+  gimp_matrix3_invert (&m);
+  gimp_matrix3_transform_point (&m, x, y, &lx, &ly);
+
+  *u = (lx - box[0]) / (box[2] - box[0]);
+  *v = (ly - box[1]) / (box[3] - box[1]);
+}
+
+static ChopGimpVEntry *
+material_fill (ChopGimpVObject *o)
+{
+  ChopGimpVEntry *e = (o && o->kind == CHOPGIMP_VOBJECT_PATH)
+                      ? chopgimp_vstyle_get_fill (&o->style) : NULL;
+
+  return e;
+}
+
+/*  the nodes (mesh) or points (freeform) of @o's fill as image points
+ *  (g_free), or NULL
+ */
+static gdouble *
+material_points (ChopGimpVObject *o,
+                 gint            *n,
+                 gboolean        *freeform)
+{
+  ChopGimpVEntry *e = material_fill (o);
+  gdouble         box[4];
+  gdouble        *pts = NULL;
+
+  *n        = 0;
+  *freeform = FALSE;
+
+  if (! e || ! e->paint.material || ! object_box (o, box))
+    return NULL;
+
+  if (e->paint.type == CHOPGIMP_PAINT_MESH)
+    {
+      ChopGimpMesh m;
+
+      if (! chopgimp_vmesh_parse (e->paint.material, &m))
+        return NULL;
+
+      *n  = (m.rows + 1) * (m.cols + 1);
+      pts = g_new (gdouble, *n * 2);
+
+      for (gint i = 0; i < *n; i++)
+        box_to_image (o, box, m.nodes[i].x, m.nodes[i].y, &pts[2 * i], &pts[2 * i + 1]);
+
+      chopgimp_vmesh_clear (&m);
+    }
+  else if (e->paint.type == CHOPGIMP_PAINT_FREEFORM &&
+           g_str_has_prefix (e->paint.material, "points"))
+    {
+      GArray *a = chopgimp_vfreeform_parse (e->paint.material + 6);
+
+      if (! a)
+        return NULL;
+
+      *freeform = TRUE;
+      *n        = a->len;
+      pts       = g_new (gdouble, *n * 2);
+
+      for (gint i = 0; i < *n; i++)
+        {
+          ChopGimpMeshNode *nd = &g_array_index (a, ChopGimpMeshNode, i);
+
+          box_to_image (o, box, nd->x, nd->y, &pts[2 * i], &pts[2 * i + 1]);
+        }
+
+      g_array_free (a, TRUE);
+    }
+
+  return pts;
+}
+
+/*  a new style for @o with its fill's material replaced by @spec  */
+static void
+set_fill_material (GimpVectorLayer   *layer,
+                   ChopGimpVObject   *o,
+                   ChopGimpPaintType  type,
+                   const gchar       *spec)
+{
+  ChopGimpVStyle  st;
+  ChopGimpVEntry *e;
+  GeglColor      *main;
+
+  chopgimp_vstyle_init (&st);
+  chopgimp_vstyle_copy (&st, &o->style);
+
+  e    = chopgimp_vstyle_ensure_fill (&st);
+  main = chopgimp_vmaterial_main_color (type, spec);
+  chopgimp_vpaint_set_material (&e->paint, type, spec, main);
+  e->visible = TRUE;
+  g_clear_object (&main);
+
+  chopgimp_vlayer_set_style (layer, o->id, &st, FALSE);
+  chopgimp_vstyle_clear (&st);
+}
+
+static gint
+nearest_point (const gdouble *pts,
+               gint           n,
+               gdouble        x,
+               gdouble        y,
+               gdouble        tol)
+{
+  gint    best = -1;
+  gdouble bd   = tol;
+
+  for (gint i = 0; i < n; i++)
+    {
+      gdouble d = hypot (pts[2 * i] - x, pts[2 * i + 1] - y);
+
+      if (d <= bd)
+        {
+          bd   = d;
+          best = i;
+        }
+    }
+
+  return best;
+}
+
+
+/*  3.29.3: the tangent handles of node @sel of a mesh: for each
+ *  neighbour (left, right, up, down), the first control point of the
+ *  edge towards it, in image coordinates; returns their number
+ */
+static gint
+mesh_handles (ChopGimpVObject    *o,
+              const gdouble       box[4],
+              const ChopGimpMesh *m,
+              gint                sel,
+              gdouble            *hx,
+              gdouble            *hy,
+              gint               *nb)
+{
+  gint C = m->cols + 1;
+  gint r, c, n = 0;
+  gint cand[4][2] = { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } };
+
+  if (sel < 0 || sel >= (m->rows + 1) * C)
+    return 0;
+
+  r = sel / C;
+  c = sel % C;
+
+  for (gint i = 0; i < 4; i++)
+    {
+      gint rr = r + cand[i][0], cc = c + cand[i][1];
+      gdouble c1[2], c2[2];
+
+      if (rr < 0 || rr > m->rows || cc < 0 || cc > m->cols)
+        continue;
+
+      nb[n] = rr * C + cc;
+      chopgimp_vmesh_edge (m, sel, nb[n], c1, c2);
+      box_to_image (o, box, c1[0], c1[1], &hx[n], &hy[n]);
+      n++;
+    }
+
+  return n;
+}
+
+/*  3.29.5: a press on the points of the freeform fill of @o (shared by
+ *  the Filet tool and the Gradient tool): @idx the point under the
+ *  pointer (-1: none), (@u, @v) in box units; returns the point to drag
+ *  (-1: none). Mode @lines: a new point is joined to the selected one
+ *  (*@sel), which it then becomes.
+ */
+static gint
+freeform_press_points (GimpVectorLayer *layer,
+                       ChopGimpVObject *o,
+                       ChopGimpVEntry  *e,
+                       gint             idx,
+                       gdouble          u,
+                       gdouble          v,
+                       const gdouble    fg[4],
+                       gboolean         shift,
+                       gboolean         alt,
+                       gboolean         lines,
+                       gint            *sel)
+{
+  GArray *a = chopgimp_vfreeform_parse (e->paint.material + 6);
+  gint    drag = -1;
+  gchar  *spec;
+
+  if (! a)
+    return -1;
+
+  if (idx >= (gint) a->len)
+    idx = -1;
+
+  if (idx >= 0 && alt && a->len > 1)
+    {
+      /*  the next point stays on the line only if the removed one was  */
+      if (idx + 1 < (gint) a->len &&
+          ! g_array_index (a, ChopGimpMeshNode, idx).link)
+        g_array_index (a, ChopGimpMeshNode, idx + 1).link = FALSE;
+
+      g_array_remove_index (a, idx);
+      g_array_index (a, ChopGimpMeshNode, 0).link = FALSE;
+      *sel = -1;
+    }
+  else if (idx >= 0 && shift)
+    {
+      memcpy (g_array_index (a, ChopGimpMeshNode, idx).rgba, fg, sizeof (gdouble) * 4);
+    }
+  else if (idx >= 0)
+    {
+      drag = idx;
+      *sel = idx;
+    }
+  else
+    {
+      ChopGimpMeshNode nd = { 0, };
+      gint             at = a->len;
+
+      nd.x = u;
+      nd.y = v;
+      memcpy (nd.rgba, fg, sizeof (gdouble) * 4);
+
+      if (lines && *sel >= 0 && *sel < (gint) a->len)
+        {
+          nd.link = TRUE;
+          at      = *sel + 1;
+        }
+
+      g_array_insert_val (a, at, nd);
+
+      drag = at;
+      *sel = lines ? at : -1;
+    }
+
+  spec = chopgimp_vfreeform_to_spec (a);
+  set_fill_material (layer, o, CHOPGIMP_PAINT_FREEFORM, spec);
+  g_free (spec);
+  g_array_free (a, TRUE);
+
+  return drag;
+}
+
+/*  3.29.5: point @node of the freeform fill of @o moved to (@u, @v)  */
+static void
+freeform_move_point (GimpVectorLayer *layer,
+                     ChopGimpVObject *o,
+                     ChopGimpVEntry  *e,
+                     gint             node,
+                     gdouble          u,
+                     gdouble          v)
+{
+  GArray *a = chopgimp_vfreeform_parse (e->paint.material + 6);
+  gchar  *spec;
+
+  if (! a || node < 0 || node >= (gint) a->len)
+    {
+      if (a)
+        g_array_free (a, TRUE);
+      return;
+    }
+
+  g_array_index (a, ChopGimpMeshNode, node).x = u;
+  g_array_index (a, ChopGimpMeshNode, node).y = v;
+  spec = chopgimp_vfreeform_to_spec (a);
+  set_fill_material (layer, o, CHOPGIMP_PAINT_FREEFORM, spec);
+  g_free (spec);
+  g_array_free (a, TRUE);
+}
+
+/*  3.29.5: the lines of a freeform fill (mode Lignes), image points  */
+static void
+freeform_draw_lines (GimpDrawTool    *dt,
+                     ChopGimpVObject *o,
+                     const gdouble   *pts,
+                     gint             n)
+{
+  ChopGimpVEntry *e = material_fill (o);
+  GArray         *a;
+
+  if (! e || e->paint.type != CHOPGIMP_PAINT_FREEFORM || ! e->paint.material ||
+      ! g_str_has_prefix (e->paint.material, "points") ||
+      ! (a = chopgimp_vfreeform_parse (e->paint.material + 6)))
+    return;
+
+  for (gint i = 1; i < n && i < (gint) a->len; i++)
+    if (g_array_index (a, ChopGimpMeshNode, i).link)
+      gimp_draw_tool_add_line (dt, pts[2 * (i - 1)], pts[2 * (i - 1) + 1],
+                               pts[2 * i], pts[2 * i + 1]);
+
+  g_array_free (a, TRUE);
+}
+
+/*  ─── events ────────────────────────────────────────────────────────── */
+
+static ChopGimpVObject *
+pick (GimpVMaterialTool *mt,
+      GimpDisplay       *display,
+      const GimpCoords  *coords,
+      ChopGimpHitMode    mode)
+{
+  GimpImage        *image = gimp_display_get_image (display);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           tol   = PICK_PX / MAX (1e-6, shell->scale_x);
+
+  mt->layer = image ? chopgimp_vobjects_get_target_layer (image) : NULL;
+
+  if (! mt->layer)
+    return NULL;
+
+  return chopgimp_vlayer_hit_test (mt->layer, coords->x, coords->y, tol, mode);
+}
+
+static void
+gimp_vmaterial_tool_oper_update (GimpTool         *tool,
+                                 const GimpCoords *coords,
+                                 GdkModifierType   state,
+                                 gboolean          proximity,
+                                 GimpDisplay      *display)
+{
+  GimpVMaterialTool *mt = (GimpVMaterialTool *) tool;
+  ChopGimpVObject   *o  = NULL;
+
+  if (proximity)
+    o = pick (mt, display, coords,
+              mt->mesh ? CHOPGIMP_HIT_LEAF : CHOPGIMP_HIT_SELECTABLE);
+
+  mt->hover = o ? o->id : 0;
+
+  if (! mt->layer)
+    gimp_tool_replace_status (tool, display,
+                              _("Sélectionnez un calque vectoriel"));
+  else if (mt->mesh)
+    gimp_tool_replace_status (tool, display,
+                              o ? _("Clic : ajouter un point du filet (couleur de premier "
+                                    "plan) — glisser un point : le déplacer — Maj+clic : "
+                                    "le colorer — Alt+clic : retirer un point libre — poignées d'un "
+                                    "nœud : courber les lignes du filet")
+                                : _("Survolez un objet du calque vectoriel"));
+  else
+    gimp_tool_replace_status (tool, display,
+                              mt->first ? _("Clic sur le second objet de la transition "
+                                            "(Échap : recommencer)")
+                                        : _("Clic sur le premier objet de la transition"));
+
+  tool->display = display;
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (mt), display);
+}
+
+static void
+blend_press (GimpVMaterialTool *mt,
+             GimpDisplay       *display,
+             const GimpCoords  *coords)
+{
+  GimpImage       *image = gimp_display_get_image (display);
+  ChopGimpVObject *o     = pick (mt, display, coords, CHOPGIMP_HIT_SELECTABLE);
+
+  if (! o || ! mt->layer)
+    return;
+
+  if (! mt->first || mt->first == o->id)
+    {
+      mt->first = o->id;
+      chopgimp_vlayer_set_selection (mt->layer, &o->id, 1);
+      gimp_image_flush (image);
+      return;
+    }
+
+  if (chopgimp_vblend_make_between (mt->layer, mt->first, o->id))
+    gimp_image_flush (image);
+  else
+    gimp_message_literal (image->gimp, G_OBJECT (display), GIMP_MESSAGE_WARNING,
+                          _("Les deux objets doivent être dans le même groupe, hors "
+                            "d'une autre transition."));
+
+  mt->first = 0;
+}
+
+static void
+mesh_press (GimpVMaterialTool *mt,
+            GimpDisplay       *display,
+            const GimpCoords  *coords,
+            GdkModifierType    state)
+{
+  GimpImage        *image   = gimp_display_get_image (display);
+  GimpDisplayShell *shell   = gimp_display_get_shell (display);
+  GimpContext      *context = gimp_get_user_context (image->gimp);
+  gdouble           tol     = PICK_PX / MAX (1e-6, shell->scale_x);
+  gboolean          shift   = (state & gimp_get_extend_selection_mask ()) != 0;
+  gboolean          alt     = (state & GDK_MOD1_MASK) != 0;
+  ChopGimpVObject  *o;
+  ChopGimpVEntry   *e;
+  gdouble          *pts;
+  gint              n, idx;
+  gboolean          freeform;
+  gdouble           fg[4] = { 0, 0, 0, 1 };
+  gdouble           box[4], u, v;
+
+  /*  the object being edited first (its nodes may be outside the shape)  */
+  o = mt->target ? chopgimp_vlayer_get_object (mt->layer, mt->target) : NULL;
+
+  if (! o || ! mt->layer)
+    o = pick (mt, display, coords, CHOPGIMP_HIT_LEAF);
+
+  if (! o || ! mt->layer || ! object_box (o, box))
+    return;
+
+  if (context && gimp_context_get_foreground (context))
+    gegl_color_get_pixel (gimp_context_get_foreground (context),
+                          babl_format ("R'G'B'A double"), fg);
+
+  pts = material_points (o, &n, &freeform);
+  idx = pts ? nearest_point (pts, n, coords->x, coords->y, tol) : -1;
+  e   = material_fill (o);
+
+  image_to_box (o, box, coords->x, coords->y, &u, &v);
+
+  if (mt->target != o->id)
+    mt->sel = -1;
+
+  /*  3.29.3: a tangent handle of the selected node  */
+  mt->handle_nb = -1;
+  if (! freeform && mt->target == o->id && mt->sel >= 0 &&
+      e && e->paint.type == CHOPGIMP_PAINT_MESH)
+    {
+      ChopGimpMesh m;
+
+      if (chopgimp_vmesh_parse (e->paint.material, &m))
+        {
+          gdouble hx[4], hy[4];
+          gint    nb[4];
+          gint    nh = mesh_handles (o, box, &m, mt->sel, hx, hy, nb);
+          gdouble bd = tol;
+
+          for (gint i = 0; i < nh; i++)
+            if (hypot (hx[i] - coords->x, hy[i] - coords->y) <= bd)
+              {
+                bd            = hypot (hx[i] - coords->x, hy[i] - coords->y);
+                mt->handle_nb = nb[i];
+              }
+
+          chopgimp_vmesh_clear (&m);
+        }
+
+      if (mt->handle_nb >= 0)
+        {
+          chopgimp_vlayer_push_undo (mt->layer, _("Filet"));
+          mt->node     = mt->sel;
+          mt->dragging = TRUE;
+          g_free (pts);
+          return;
+        }
+    }
+
+  chopgimp_vlayer_push_undo (mt->layer, _("Filet"));
+
+  mt->target   = o->id;
+  mt->node     = -1;
+  mt->dragging = FALSE;
+
+  if (freeform)
+    {
+      gint dummy = -1;
+
+      mt->node     = freeform_press_points (mt->layer, o, e, idx, u, v, fg,
+                                            shift, alt, FALSE, &dummy);
+      mt->dragging = (mt->node >= 0);
+    }
+  else
+    {
+      ChopGimpMesh m;
+      gchar       *spec;
+
+      if (! (e && e->paint.type == CHOPGIMP_PAINT_MESH &&
+             chopgimp_vmesh_parse (e->paint.material, &m)))
+        {
+          /*  a plain fill becomes a 1 × 1 mesh of its color  */
+          GeglColor *base = e ? chopgimp_vpaint_get_main_color (&e->paint) : NULL;
+          gchar     *s0   = chopgimp_vmesh_new_spec (1, 1, base, CHOPGIMP_MESH_FLAT, 0.0);
+
+          chopgimp_vmesh_parse (s0, &m);
+          g_free (s0);
+          idx = -1;
+        }
+
+      if (idx >= 0 && shift)
+        memcpy (m.nodes[idx].rgba, fg, sizeof (fg));
+      else if (idx >= 0)
+        {
+          mt->node     = idx;
+          mt->sel      = idx;
+          mt->dragging = TRUE;
+        }
+      else if (u >= 0 && u <= 1 && v >= 0 && v <= 1)
+        chopgimp_vmesh_insert (&m, u, v, fg);
+
+      spec = chopgimp_vmesh_to_spec (&m);
+      set_fill_material (mt->layer, o, CHOPGIMP_PAINT_MESH, spec);
+      g_free (spec);
+      chopgimp_vmesh_clear (&m);
+    }
+
+  g_free (pts);
+  gimp_image_flush (image);
+}
+
+static void
+gimp_vmaterial_tool_button_press (GimpTool            *tool,
+                                  const GimpCoords    *coords,
+                                  guint32              time,
+                                  GdkModifierType      state,
+                                  GimpButtonPressType  press_type,
+                                  GimpDisplay         *display)
+{
+  GimpVMaterialTool *mt = (GimpVMaterialTool *) tool;
+
+  if (press_type != GIMP_BUTTON_PRESS_NORMAL)
+    return;
+
+  tool->display = display;
+
+  if (mt->mesh)
+    mesh_press (mt, display, coords, state);
+  else
+    blend_press (mt, display, coords);
+
+  if (mt->dragging)
+    gimp_tool_control_activate (tool->control);
+
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (mt), display);
+}
+
+static void
+gimp_vmaterial_tool_motion (GimpTool         *tool,
+                            const GimpCoords *coords,
+                            guint32           time,
+                            GdkModifierType   state,
+                            GimpDisplay      *display)
+{
+  GimpVMaterialTool *mt = (GimpVMaterialTool *) tool;
+  ChopGimpVObject   *o;
+  ChopGimpVEntry    *e;
+  gdouble            box[4], u, v;
+
+  if (! mt->dragging || mt->node < 0 || ! mt->layer ||
+      ! (o = chopgimp_vlayer_get_object (mt->layer, mt->target)) ||
+      ! object_box (o, box) || ! (e = material_fill (o)) || ! e->paint.material)
+    return;
+
+  image_to_box (o, box, coords->x, coords->y, &u, &v);
+
+  if (e->paint.type == CHOPGIMP_PAINT_MESH)
+    {
+      ChopGimpMesh m;
+      gchar       *spec;
+
+      if (! chopgimp_vmesh_parse (e->paint.material, &m) ||
+          mt->node >= (m.rows + 1) * (m.cols + 1))
+        return;
+
+      if (mt->handle_nb >= 0 && mt->handle_nb < (m.rows + 1) * (m.cols + 1))
+        {
+          /*  3.29.3: the handle is the first control point of the edge
+           *  towards handle_nb: c = node + (nb - node) / 3 + s × t
+           */
+          ChopGimpMeshNode *nd  = &m.nodes[mt->node];
+          ChopGimpMeshNode *nbn = &m.nodes[mt->handle_nb];
+          gdouble           sg  = mt->handle_nb > mt->node ? 1.0 : -1.0;
+          gdouble          *t   = ABS (mt->handle_nb - mt->node) == 1 ? nd->th : nd->tv;
+
+          t[0] = sg * (u - nd->x - (nbn->x - nd->x) / 3.0);
+          t[1] = sg * (v - nd->y - (nbn->y - nd->y) / 3.0);
+        }
+      else
+        {
+          m.nodes[mt->node].x = u;
+          m.nodes[mt->node].y = v;
+        }
+      spec = chopgimp_vmesh_to_spec (&m);
+      set_fill_material (mt->layer, o, CHOPGIMP_PAINT_MESH, spec);
+      g_free (spec);
+      chopgimp_vmesh_clear (&m);
+    }
+  else if (e->paint.type == CHOPGIMP_PAINT_FREEFORM &&
+           g_str_has_prefix (e->paint.material, "points"))
+    {
+      freeform_move_point (mt->layer, o, e, mt->node, u, v);
+    }
+
+  gimp_image_flush (gimp_display_get_image (display));
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (mt), display);
+}
+
+static void
+gimp_vmaterial_tool_button_release (GimpTool              *tool,
+                                    const GimpCoords      *coords,
+                                    guint32                time,
+                                    GdkModifierType        state,
+                                    GimpButtonReleaseType  release_type,
+                                    GimpDisplay           *display)
+{
+  GimpVMaterialTool *mt = (GimpVMaterialTool *) tool;
+
+  if (gimp_tool_control_is_active (tool->control))
+    gimp_tool_control_halt (tool->control);
+
+  mt->dragging  = FALSE;
+  mt->node      = -1;
+  mt->handle_nb = -1;
+
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (mt), display);
+}
+
+static gboolean
+gimp_vmaterial_tool_key_press (GimpTool    *tool,
+                               GdkEventKey *kevent,
+                               GimpDisplay *display)
+{
+  GimpVMaterialTool *mt = (GimpVMaterialTool *) tool;
+
+  if (kevent->keyval == GDK_KEY_Escape)
+    {
+      mt->first  = 0;
+      mt->target = 0;
+      mt->sel    = -1;
+      chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (mt), display);
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+static void
+add_outline (GimpDrawTool    *dt,
+             GimpVectorLayer *layer,
+             ChopGimpVObject *o,
+             gboolean         highlight)
+{
+  GimpDisplayShell *shell = gimp_display_get_shell (dt->display);
+  GimpPath         *wp    = chopgimp_vobject_get_world_path (layer, o, FALSE);
+  GimpCanvasItem   *item;
+
+  if (! wp)
+    return;
+
+  g_object_ref_sink (wp);
+
+  if (gimp_path_get_bezier (wp))
+    {
+      item = gimp_canvas_path_new (shell, gimp_path_get_bezier (wp), 0, 0,
+                                   FALSE, GIMP_PATH_STYLE_DEFAULT);
+      gimp_canvas_item_set_highlight (item, highlight);
+      gimp_draw_tool_add_item (dt, item);
+      g_object_unref (item);
+    }
+
+  g_object_unref (wp);
+}
+
+static void
+gimp_vmaterial_tool_draw (GimpDrawTool *dt)
+{
+  GimpVMaterialTool *mt = (GimpVMaterialTool *) dt;
+  ChopGimpVObject   *o;
+
+  if (! mt->layer || ! gimp_item_is_attached (GIMP_ITEM (mt->layer)))
+    return;
+
+  if (mt->hover && (o = chopgimp_vlayer_get_object (mt->layer, mt->hover)))
+    add_outline (dt, mt->layer, o, TRUE);
+
+  if (! mt->mesh)
+    {
+      if (mt->first && (o = chopgimp_vlayer_get_object (mt->layer, mt->first)))
+        add_outline (dt, mt->layer, o, FALSE);
+      return;
+    }
+
+  /*  the nodes of the edited (or hovered) object  */
+  o = mt->target ? chopgimp_vlayer_get_object (mt->layer, mt->target) : NULL;
+  if (! o && mt->hover)
+    o = chopgimp_vlayer_get_object (mt->layer, mt->hover);
+
+  if (o)
+    {
+      gboolean  freeform;
+      gint      n;
+      gdouble  *pts = material_points (o, &n, &freeform);
+
+      if (pts && ! freeform)
+        {
+          ChopGimpVEntry *e = material_fill (o);
+          ChopGimpMesh    m;
+
+          /*  the mesh lines (3.29.3: curved by the tangents)  */
+          if (e && chopgimp_vmesh_parse (e->paint.material, &m))
+            {
+              gdouble box[4];
+
+              if (object_box (o, box))
+                for (gint r = 0; r <= m.rows; r++)
+                  for (gint c = 0; c <= m.cols; c++)
+                    for (gint dir = 0; dir < 2; dir++)
+                      {
+                        gint        i = r * (m.cols + 1) + c;
+                        gint        j = dir ? i + m.cols + 1 : i + 1;
+                        gdouble     c1[2], c2[2];
+                        GimpVector2 seg[13];
+
+                        if ((dir == 0 && c >= m.cols) || (dir == 1 && r >= m.rows))
+                          continue;
+
+                        chopgimp_vmesh_edge (&m, i, j, c1, c2);
+
+                        for (gint k = 0; k <= 12; k++)
+                          {
+                            gdouble tt = k / 12.0, mt1 = 1.0 - tt;
+                            gdouble bx = mt1 * mt1 * mt1 * m.nodes[i].x + 3 * mt1 * mt1 * tt * c1[0] +
+                                         3 * mt1 * tt * tt * c2[0] + tt * tt * tt * m.nodes[j].x;
+                            gdouble by = mt1 * mt1 * mt1 * m.nodes[i].y + 3 * mt1 * mt1 * tt * c1[1] +
+                                         3 * mt1 * tt * tt * c2[1] + tt * tt * tt * m.nodes[j].y;
+
+                            box_to_image (o, box, bx, by, &seg[k].x, &seg[k].y);
+                          }
+
+                        gimp_draw_tool_add_lines (dt, seg, 13, NULL, FALSE);
+                      }
+
+              /*  3.29.3: the tangent handles of the selected node  */
+              if (mt->sel >= 0 && o->id == mt->target && object_box (o, box))
+                {
+                  gdouble hx[4], hy[4];
+                  gint    nb[4];
+                  gint    nh = mesh_handles (o, box, &m, mt->sel, hx, hy, nb);
+
+                  for (gint k = 0; k < nh; k++)
+                    {
+                      gimp_draw_tool_add_line (dt, pts[2 * mt->sel], pts[2 * mt->sel + 1],
+                                               hx[k], hy[k]);
+                      gimp_draw_tool_add_handle (dt, GIMP_HANDLE_CIRCLE, hx[k], hy[k],
+                                                 HANDLE_PX, HANDLE_PX,
+                                                 GIMP_HANDLE_ANCHOR_CENTER);
+                    }
+                }
+
+              chopgimp_vmesh_clear (&m);
+            }
+        }
+
+      if (pts && freeform)
+        freeform_draw_lines (dt, o, pts, n);
+
+      for (gint i = 0; pts && i < n; i++)
+        gimp_draw_tool_add_handle (dt,
+                                   freeform ? GIMP_HANDLE_FILLED_CIRCLE
+                                            : GIMP_HANDLE_FILLED_SQUARE,
+                                   pts[2 * i], pts[2 * i + 1],
+                                   HANDLE_PX, HANDLE_PX,
+                                   GIMP_HANDLE_ANCHOR_CENTER);
+
+      g_free (pts);
+    }
+}
+
+static void
+gimp_vmaterial_tool_control (GimpTool       *tool,
+                             GimpToolAction  action,
+                             GimpDisplay    *display)
+{
+  GimpVMaterialTool *mt = (GimpVMaterialTool *) tool;
+
+  if (action == GIMP_TOOL_ACTION_HALT || action == GIMP_TOOL_ACTION_COMMIT)
+    {
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+      mt->layer    = NULL;
+      mt->hover    = 0;
+      mt->first    = 0;
+      mt->target   = 0;
+      mt->node     = -1;
+      mt->dragging = FALSE;
+    }
+
+  GIMP_TOOL_CLASS (gimp_vblend_tool_parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_vblend_tool_class_init (GimpVMaterialToolClass *klass)
+{
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  tool_class->is_destructive = FALSE;
+
+  tool_class->control        = gimp_vmaterial_tool_control;
+  tool_class->oper_update    = gimp_vmaterial_tool_oper_update;
+  tool_class->button_press   = gimp_vmaterial_tool_button_press;
+  tool_class->motion         = gimp_vmaterial_tool_motion;
+  tool_class->button_release = gimp_vmaterial_tool_button_release;
+  tool_class->key_press      = gimp_vmaterial_tool_key_press;
+
+  draw_tool_class->draw      = gimp_vmaterial_tool_draw;
+}
+
+static void
+gimp_vblend_tool_init (GimpVMaterialTool *mt)
+{
+  GimpTool *tool = GIMP_TOOL (mt);
+
+  mt->node      = -1;
+  mt->sel       = -1;
+  mt->handle_nb = -1;
+
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_MOVE);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_MOUSE);
+}
