+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vtransform.h — ChopGimp 3.29.0: precise transformations and
+ * path editing of the objects of vector layers, like Illustrator:
+ *
+ *  - « objet clé »: the object Aligner / Répartir align to;
+ *  - « Aligner sur »: la sélection, l'objet clé, le plan de travail;
+ *  - « Répéter la transformation » (Ctrl+D in object mode): the last
+ *    move / scale / rotation of objects (Alt+drag copies included);
+ *  - « Transformer chaque »: scale, move, rotate, reflect each object
+ *    around its own reference point, with a random part;
+ *  - the « Transformation » panel: X, Y, W, H, angle, shear around one of
+ *    9 reference points;
+ *  - « Angles dynamiques »: the « corners » live effect of an object;
+ *  - Ciseaux, Cutter, Jonction (the editing tools of app/tools/
+ *    chopgimp-vpentools.c).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+G_BEGIN_DECLS
+
+
+typedef enum
+{
+  CHOPGIMP_ALIGN_TO_SELECTION,
+  CHOPGIMP_ALIGN_TO_KEY,
+  CHOPGIMP_ALIGN_TO_ARTBOARD
+} ChopGimpAlignTo;
+
+/*  the 9 reference points, row by row: 0 top left … 4 center … 8 bottom
+ *  right
+ */
+void              chopgimp_vtransform_ref_point     (gint             ref,
+                                                     gdouble          x1,
+                                                     gdouble          y1,
+                                                     gdouble          x2,
+                                                     gdouble          y2,
+                                                     gdouble         *x,
+                                                     gdouble         *y);
+
+
+/*  ─── objet clé, Aligner sur ────────────────────────────────────────── */
+
+/*  0 when none (or not selected any more)  */
+guint             chopgimp_vtransform_get_key       (GimpVectorLayer *layer);
+/*  @id 0: none; a redraw of the layer's tools is requested  */
+void              chopgimp_vtransform_set_key       (GimpVectorLayer *layer,
+                                                     guint            id);
+
+ChopGimpAlignTo   chopgimp_vtransform_get_align_to  (void);
+void              chopgimp_vtransform_set_align_to  (ChopGimpAlignTo  to);
+
+
+/*  ─── Répéter la transformation ─────────────────────────────────────── */
+
+/*  remembered by the Selection tool after a move / scale / rotation of
+ *  objects (@matrix in image space; @copy: Alt+drag)
+ */
+void              chopgimp_vtransform_record        (const GimpMatrix3 *matrix,
+                                                     gboolean          copy);
+gboolean          chopgimp_vtransform_can_repeat    (GimpVectorLayer *layer);
+/*  one undo step  */
+gboolean          chopgimp_vtransform_repeat        (GimpVectorLayer *layer);
+
+
+/*  ─── Transformer chaque ────────────────────────────────────────────── */
+
+typedef struct
+{
+  gdouble   scale_x, scale_y;    /* %                                     */
+  gdouble   move_x, move_y;      /* px                                    */
+  gdouble   angle;               /* degrees, counter-clockwise            */
+  gboolean  reflect_x;           /* mirror across the vertical axis       */
+  gboolean  reflect_y;           /* mirror across the horizontal axis     */
+  gint      ref;                 /* 0..8                                  */
+  gboolean  random;              /* each value between 0 (100 %) and it   */
+  gboolean  copy;
+  guint32   seed;
+} ChopGimpTransformEach;
+
+void              chopgimp_vtransform_each_init     (ChopGimpTransformEach       *te);
+/*  @push_undo FALSE for a preview the caller restores  */
+gboolean          chopgimp_vtransform_each          (GimpVectorLayer             *layer,
+                                                     const ChopGimpTransformEach *te,
+                                                     gboolean                     push_undo);
+
+
+/*  ─── panneau Transformation ────────────────────────────────────────── */
+
+/*  the geometric box of the selected objects; FALSE: none selected  */
+gboolean          chopgimp_vtransform_get_box       (GimpVectorLayer *layer,
+                                                     gdouble         *x,
+                                                     gdouble         *y,
+                                                     gdouble         *width,
+                                                     gdouble         *height);
+/*  the rotation and shear of the only selected object (degrees), else 0  */
+void              chopgimp_vtransform_get_angles    (GimpVectorLayer *layer,
+                                                     gdouble         *angle,
+                                                     gdouble         *shear);
+/*  maps the box of the selection to (@x, @y, @width, @height), the
+ *  reference point @ref staying in place when only the size changes;
+ *  then rotates by @rotate and shears by @shear degrees around it; one
+ *  undo step
+ */
+gboolean          chopgimp_vtransform_set_box       (GimpVectorLayer *layer,
+                                                     gint             ref,
+                                                     gdouble          x,
+                                                     gdouble          y,
+                                                     gdouble          width,
+                                                     gdouble          height,
+                                                     gdouble          rotate,
+                                                     gdouble          shear);
+gboolean          chopgimp_vtransform_flip          (GimpVectorLayer *layer,
+                                                     gint             ref,
+                                                     gboolean         horizontally);
+
+
+/*  ─── Angles dynamiques ─────────────────────────────────────────────── */
+
+typedef enum
+{
+  CHOPGIMP_CORNERS_ROUND,
+  CHOPGIMP_CORNERS_INVERTED,
+  CHOPGIMP_CORNERS_CHAMFER
+} ChopGimpCornersMode;
+
+/*  the corners of the path object @id in image coordinates (x, y, bx, by
+ *  quadruples, see chopgimp_geom_corner_points), from its path before the
+ *  live effects; g_free
+ */
+gdouble         * chopgimp_vtransform_corners       (GimpVectorLayer *layer,
+                                                     guint            id,
+                                                     gint            *n_corners);
+/*  the radius of corner @k (the common radius when no own one)  */
+gdouble           chopgimp_vtransform_get_corner    (GimpVectorLayer *layer,
+                                                     guint            id,
+                                                     gint             k,
+                                                     ChopGimpCornersMode *mode);
+/*  @k -1: all the corners (the own radii are forgotten); @mode -1: kept  */
+void              chopgimp_vtransform_set_corner    (GimpVectorLayer *layer,
+                                                     guint            id,
+                                                     gint             k,
+                                                     gdouble          radius,
+                                                     gint             mode,
+                                                     gboolean         push_undo);
+
+
+/*  ─── Ciseaux, Cutter, Jonction ─────────────────────────────────────── */
+
+/*  cuts the path object under (x, y) there (closed: opened; open: two
+ *  objects)  */
+gboolean          chopgimp_vtransform_cut           (GimpVectorLayer *layer,
+                                                     gdouble          x,
+                                                     gdouble          y,
+                                                     gdouble          tolerance);
+/*  slices the closed shapes crossed by the polyline @xy (@n points) into
+ *  pieces (the selected objects, or all when none is selected)
+ */
+gboolean          chopgimp_vtransform_knife         (GimpVectorLayer *layer,
+                                                     const gdouble   *xy,
+                                                     gint             n);
+/*  joins the two nearest open ends within @radius of (x, y)  */
+gboolean          chopgimp_vtransform_join          (GimpVectorLayer *layer,
+                                                     gdouble          x,
+                                                     gdouble          y,
+                                                     gdouble          radius);
+
+
+/*  ─── PDB (chopgimp-vobjects-command) ───────────────────────────────── */
+
+/*  « transform-again », « transform-each:sx:sy:dx:dy:angle:rx:ry:ref:copy »,
+ *  « key:<index of the selected object> », « key-none »,
+ *  « align-to:selection|key|artboard », « box:ref:x:y:w:h:rotate:shear »,
+ *  « flip-h:ref », « flip-v:ref », « corners:radius[:mode[:k]] »,
+ *  « cut-at:x:y », « knife:x1:y1:x2:y2… », « join-at:x:y:radius »;
+ *  TRUE when the command is one of these (*@done: something changed)
+ */
+gboolean          chopgimp_vtransform_command       (GimpVectorLayer *layer,
+                                                     const gchar     *cmd,
+                                                     gboolean        *done);
+
+
+G_END_DECLS
diff --git a/app/tools/chopgimp-envelopetool.c b/app/tools/chopgimp-envelopetool.c
new file mode 100644
index 0000000..0ddc18f
--- /dev/null
+++ b/app/tools/chopgimp-envelopetool.c
@@ -0,0 +1,490 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-envelopetool.c — ChopGimp 3.27.6 (lot V6 point 8): the
+ * Envelope tool (« Objet > Distorsion > Modifier l'enveloppe »).
+ *
+ * Shows the mesh of the selected objects' envelope (« Enveloppe »: rows
+ * × columns, « Distorsion libre »: 4 corners) and drags its points; the
+ * objects follow live (chopgimp-vdistort.h). A click on another object
+ * selects it. « Déformation » envelopes are changed in their dialog.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "tools-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpimage.h"
+#include "core/gimpimage-undo.h"
+#include "core/gimptooloptions.h"
+
+#include "path/gimppath.h"
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vobject-ops.h"
+#include "path/chopgimp-vdistort.h"
+
+#include "widgets/gimphelp-ids.h"
+
+#include "display/gimpdisplay.h"
+#include "display/gimpdisplayshell.h"
+
+#include "gimpdrawtool.h"
+#include "gimptoolcontrol.h"
+#include "gimptooloptions-gui.h"
+#include "chopgimp-tools.h"
+#include "chopgimp-envelopetool.h"
+
+#include "gimp-intl.h"
+
+
+#define HANDLE 11
+#define TOL_PX 8.0
+
+typedef struct
+{
+  GimpDrawTool     parent_instance;
+
+  GimpVectorLayer *layer;
+  guint            id;         /* the object whose mesh is shown          */
+  ChopGimpDistort  d;
+  gboolean         valid;
+
+  gint             drag;       /* mesh point index, -1                    */
+  gboolean         pushed;
+  gint             hover;
+} GimpEnvelopeTool;
+
+typedef struct
+{
+  GimpDrawToolClass parent_class;
+} GimpEnvelopeToolClass;
+
+G_DEFINE_TYPE (GimpEnvelopeTool, gimp_envelope_tool, GIMP_TYPE_DRAW_TOOL)
+
+
+static GtkWidget *
+envelope_options_gui (GimpToolOptions *options)
+{
+  GtkWidget *vbox  = gimp_tool_options_gui (options);
+  GtkWidget *label = gtk_label_new (_("Tirez les points de l'enveloppe des objets "
+                                      "sélectionnés. Objet > Distorsion : créer une "
+                                      "enveloppe (maille, objet du dessus, distorsion "
+                                      "libre, déformation), modifier le contenu, "
+                                      "décomposer."));
+
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (label), TRUE);
+  gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 0);
+  gtk_widget_show (label);
+
+  return vbox;
+}
+
+void
+gimp_envelope_tool_register (GimpToolRegisterCallback  callback,
+                             gpointer                  data)
+{
+  (* callback) (gimp_envelope_tool_get_type (),
+                GIMP_TYPE_TOOL_OPTIONS,
+                envelope_options_gui,
+                0,
+                "gimp-envelope-tool",
+                _("Enveloppe"),
+                _("Outil Enveloppe : tirer les points de l'enveloppe des objets "
+                  "(Objet > Distorsion)"),
+                N_("_Enveloppe"), NULL,
+                NULL, GIMP_HELP_TOOL_PATH,
+                "chopgimp-tool-envelope",
+                data);
+}
+
+
+static ChopGimpVObject *
+et_object (GimpEnvelopeTool *et)
+{
+  ChopGimpVObject *o;
+
+  if (! et->layer || ! et->id || ! gimp_item_is_attached (GIMP_ITEM (et->layer)))
+    return NULL;
+
+  o = chopgimp_vlayer_get_object (et->layer, et->id);
+
+  return (o && o->kind == CHOPGIMP_VOBJECT_PATH) ? o : NULL;
+}
+
+/*  the first selected object with a mesh or free distortion  */
+static void
+et_update (GimpEnvelopeTool *et,
+           GimpImage        *image)
+{
+  GimpVectorLayer *layer = image ? chopgimp_vobjects_get_target_layer (image) : NULL;
+  GList           *targets;
+
+  et->valid = FALSE;
+  et->layer = layer;
+  et->id    = 0;
+
+  if (! layer)
+    return;
+
+  targets = chopgimp_vdistort_targets (layer);
+
+  for (GList *l = targets; l && ! et->valid; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      chopgimp_vdistort_clear (&et->d);
+      chopgimp_vdistort_init (&et->d);
+
+      if (chopgimp_vdistort_get (o, &et->d) && et->d.mode != CHOPGIMP_DISTORT_WARP)
+        {
+          et->id    = o->id;
+          et->valid = TRUE;
+        }
+    }
+
+  g_list_free (targets);
+}
+
+/*  mesh point @k in the image  */
+static void
+et_point (GimpEnvelopeTool *et,
+          ChopGimpVObject  *o,
+          gint              k,
+          gdouble          *x,
+          gdouble          *y)
+{
+  gint        i = k / (et->d.cols + 1), j = k % (et->d.cols + 1);
+  GimpMatrix3 m;
+  gdouble     lx, ly;
+
+  lx = et->d.box[0] + ((gdouble) j / et->d.cols + et->d.mesh[2 * k])     * et->d.box[2];
+  ly = et->d.box[1] + ((gdouble) i / et->d.rows + et->d.mesh[2 * k + 1]) * et->d.box[3];
+
+  chopgimp_vobject_get_world_matrix (o, &m);
+  gimp_matrix3_transform_point (&m, lx, ly, x, y);
+}
+
+static gint
+et_point_at (GimpEnvelopeTool *et,
+             GimpDisplay      *display,
+             gdouble           x,
+             gdouble           y)
+{
+  ChopGimpVObject  *o     = et_object (et);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           best  = TOL_PX / MAX (1e-6, shell->scale_x);
+  gint              found = -1;
+  gint              n;
+
+  if (! o || ! et->valid)
+    return -1;
+
+  n = (et->d.rows + 1) * (et->d.cols + 1);
+
+  for (gint k = 0; k < n; k++)
+    {
+      gdouble px, py, d;
+
+      et_point (et, o, k, &px, &py);
+      d = hypot (px - x, py - y);
+
+      if (d <= best)
+        {
+          best  = d;
+          found = k;
+        }
+    }
+
+  return found;
+}
+
+static void
+gimp_envelope_tool_oper_update (GimpTool         *tool,
+                                const GimpCoords *coords,
+                                GdkModifierType   state,
+                                gboolean          proximity,
+                                GimpDisplay      *display)
+{
+  GimpEnvelopeTool *et    = (GimpEnvelopeTool *) tool;
+  GimpImage        *image = gimp_display_get_image (display);
+  gint              hover;
+
+  if (et->drag < 0)
+    et_update (et, image);
+
+  hover = proximity ? et_point_at (et, display, coords->x, coords->y) : -1;
+
+  if (! et->layer)
+    gimp_tool_replace_status (tool, display,
+                              _("Sélectionnez un calque vectoriel et ses objets"));
+  else if (! et->valid)
+    gimp_tool_replace_status (tool, display,
+                              _("Aucune enveloppe : Objet > Distorsion > Créer d'après une "
+                                "maille, d'après l'objet du dessus ou Distorsion libre "
+                                "(une Déformation se règle dans sa fenêtre)"));
+  else if (hover >= 0)
+    gimp_tool_replace_status (tool, display, _("Glisser : déplacer ce point de l'enveloppe"));
+  else
+    gimp_tool_replace_status (tool, display,
+                              _("Tirez les points de l'enveloppe — clic sur un objet : "
+                                "le sélectionner"));
+
+  et->hover = hover;
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (et), display);
+}
+
+static void
+gimp_envelope_tool_button_press (GimpTool            *tool,
+                                 const GimpCoords    *coords,
+                                 guint32              time,
+                                 GdkModifierType      state,
+                                 GimpButtonPressType  press_type,
+                                 GimpDisplay         *display)
+{
+  GimpEnvelopeTool *et    = (GimpEnvelopeTool *) tool;
+  GimpImage        *image = gimp_display_get_image (display);
+  gint              k;
+
+  if (press_type != GIMP_BUTTON_PRESS_NORMAL || ! image)
+    return;
+
+  et_update (et, image);
+
+  k = et_point_at (et, display, coords->x, coords->y);
+
+  if (k < 0)
+    {
+      /*  select the object clicked  */
+      GimpVectorLayer *layer = chopgimp_vobjects_get_target_layer (image);
+      ChopGimpVObject *o     = layer ? chopgimp_vlayer_hit_test (layer, coords->x, coords->y,
+                                                                 2.0, CHOPGIMP_HIT_SELECTABLE)
+                                     : NULL;
+
+      if (o)
+        {
+          chopgimp_vlayer_set_selection (layer, &o->id, 1);
+          gimp_image_flush (image);
+          et_update (et, image);
+          chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (et), display);
+        }
+
+      return;
+    }
+
+  et->drag      = k;
+  et->pushed    = FALSE;
+  tool->display = display;
+  gimp_tool_control_activate (tool->control);
+}
+
+static void
+gimp_envelope_tool_motion (GimpTool         *tool,
+                           const GimpCoords *coords,
+                           guint32           time,
+                           GdkModifierType   state,
+                           GimpDisplay      *display)
+{
+  GimpEnvelopeTool *et = (GimpEnvelopeTool *) tool;
+  ChopGimpVObject  *o  = et_object (et);
+  GList            *targets;
+  GimpMatrix3       inv;
+  gdouble           lx, ly, dx, dy;
+  gint              k = et->drag, i, j;
+
+  if (! o || k < 0 || ! et->valid)
+    return;
+
+  i = k / (et->d.cols + 1);
+  j = k % (et->d.cols + 1);
+
+  chopgimp_vobject_get_world_matrix (o, &inv);
+  gimp_matrix3_invert (&inv);
+  gimp_matrix3_transform_point (&inv, coords->x, coords->y, &lx, &ly);
+
+  dx = (lx - et->d.box[0]) / et->d.box[2] - (gdouble) j / et->d.cols;
+  dy = (ly - et->d.box[1]) / et->d.box[3] - (gdouble) i / et->d.rows;
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (et));
+
+  if (! et->pushed)
+    {
+      chopgimp_vlayer_push_undo (et->layer, _("Modifier l'enveloppe"));
+      et->pushed = TRUE;
+    }
+
+  et->d.mesh[2 * k]     = dx;
+  et->d.mesh[2 * k + 1] = dy;
+
+  /*  every selected object sharing this envelope follows  */
+  chopgimp_vlayer_freeze (et->layer);
+
+  targets = chopgimp_vdistort_targets (et->layer);
+  for (GList *l = targets; l; l = l->next)
+    {
+      ChopGimpVObject *t = l->data;
+      ChopGimpDistort  td;
+
+      chopgimp_vdistort_init (&td);
+
+      if (chopgimp_vdistort_get (t, &td) && td.mode == et->d.mode &&
+          td.rows == et->d.rows && td.cols == et->d.cols)
+        {
+          td.mesh[2 * k]     = dx;
+          td.mesh[2 * k + 1] = dy;
+          chopgimp_vdistort_set (et->layer, t->id, &td, FALSE);
+        }
+
+      chopgimp_vdistort_clear (&td);
+    }
+  g_list_free (targets);
+
+  chopgimp_vlayer_thaw (et->layer);
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (et->layer)));
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (et));
+}
+
+static void
+gimp_envelope_tool_button_release (GimpTool              *tool,
+                                   const GimpCoords      *coords,
+                                   guint32                time,
+                                   GdkModifierType        state,
+                                   GimpButtonReleaseType  release_type,
+                                   GimpDisplay           *display)
+{
+  GimpEnvelopeTool *et = (GimpEnvelopeTool *) tool;
+
+  gimp_tool_control_halt (tool->control);
+
+  if (release_type == GIMP_BUTTON_RELEASE_CANCEL && et->pushed)
+    gimp_image_undo (gimp_item_get_image (GIMP_ITEM (et->layer)));
+
+  et->drag   = -1;
+  et->pushed = FALSE;
+
+  et_update (et, gimp_display_get_image (display));
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (et), display);
+}
+
+static void
+gimp_envelope_tool_draw (GimpDrawTool *dt)
+{
+  GimpEnvelopeTool *et = (GimpEnvelopeTool *) dt;
+  ChopGimpVObject  *o  = et_object (et);
+  gint              rows, cols;
+
+  if (! o || ! et->valid)
+    return;
+
+  rows = et->d.rows;
+  cols = et->d.cols;
+
+  for (gint i = 0; i <= rows; i++)
+    for (gint j = 0; j <= cols; j++)
+      {
+        gint    k = i * (cols + 1) + j;
+        gdouble x, y, x2, y2;
+
+        et_point (et, o, k, &x, &y);
+
+        if (j < cols)
+          {
+            et_point (et, o, k + 1, &x2, &y2);
+            gimp_draw_tool_add_line (dt, x, y, x2, y2);
+          }
+        if (i < rows)
+          {
+            et_point (et, o, k + cols + 1, &x2, &y2);
+            gimp_draw_tool_add_line (dt, x, y, x2, y2);
+          }
+
+        gimp_draw_tool_add_handle (dt,
+                                   (k == et->hover || k == et->drag) ? GIMP_HANDLE_FILLED_SQUARE
+                                                                     : GIMP_HANDLE_SQUARE,
+                                   x, y, HANDLE - 2, HANDLE - 2,
+                                   GIMP_HANDLE_ANCHOR_CENTER);
+      }
+}
+
+static void
+gimp_envelope_tool_control (GimpTool       *tool,
+                            GimpToolAction  action,
+                            GimpDisplay    *display)
+{
+  GimpEnvelopeTool *et = (GimpEnvelopeTool *) tool;
+
+  if (action == GIMP_TOOL_ACTION_HALT || action == GIMP_TOOL_ACTION_COMMIT)
+    {
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+      et->layer = NULL;
+      et->id    = 0;
+      et->valid = FALSE;
+      et->drag  = -1;
+    }
+
+  GIMP_TOOL_CLASS (gimp_envelope_tool_parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_envelope_tool_finalize (GObject *object)
+{
+  GimpEnvelopeTool *et = (GimpEnvelopeTool *) object;
+
+  chopgimp_vdistort_clear (&et->d);
+
+  G_OBJECT_CLASS (gimp_envelope_tool_parent_class)->finalize (object);
+}
+
+static void
+gimp_envelope_tool_class_init (GimpEnvelopeToolClass *klass)
+{
+  GObjectClass      *object_class    = G_OBJECT_CLASS (klass);
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  object_class->finalize     = gimp_envelope_tool_finalize;
+
+  tool_class->is_destructive = FALSE;
+
+  tool_class->control        = gimp_envelope_tool_control;
+  tool_class->oper_update    = gimp_envelope_tool_oper_update;
+  tool_class->button_press   = gimp_envelope_tool_button_press;
+  tool_class->motion         = gimp_envelope_tool_motion;
+  tool_class->button_release = gimp_envelope_tool_button_release;
+
+  draw_tool_class->draw      = gimp_envelope_tool_draw;
+}
+
+static void
+gimp_envelope_tool_init (GimpEnvelopeTool *et)
+{
+  GimpTool *tool = GIMP_TOOL (et);
+
+  chopgimp_vdistort_init (&et->d);
+  et->drag  = -1;
+  et->hover = -1;
+
+  gimp_tool_control_set_motion_mode (tool->control, GIMP_MOTION_MODE_EXACT);
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_PATHS);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_MOUSE);
+}
