+++ b/app/dialogs/chopgimp-transform-each-dialog.c
@@ -0,0 +1,299 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-transform-each-dialog.c — ChopGimp 3.29.0 (vectoriel
+ * « complet », bloc 2): « Transformer chaque » like Illustrator: each
+ * selected object is scaled, moved, rotated and reflected around its own
+ * reference point (9 points), optionally with a random part, or copied.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "dialogs-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpimage.h"
+
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vobject-ops.h"
+#include "path/chopgimp-vtransform.h"
+
+#include "widgets/gimphelp-ids.h"
+
+#include "chopgimp-transform-each-dialog.h"
+
+#include "gimp-intl.h"
+
+
+#define RESPONSE_RESET 1
+
+typedef struct
+{
+  GimpImage             *image;
+  GimpVectorLayer       *layer;
+  gchar                 *saved_xml;
+  guint                 *saved_ids;
+  gint                   n_saved;
+  ChopGimpTransformEach  te;
+  gboolean               previewed;
+  gboolean               loading;
+
+  GtkAdjustment         *sx, *sy, *dx, *dy, *angle;
+  GtkWidget             *rx, *ry, *random, *copy, *preview;
+  GtkWidget             *ref[9];
+} Dialog;
+
+
+static void
+dialog_restore (Dialog *d)
+{
+  if (! d->previewed)
+    return;
+
+  chopgimp_vlayer_set_xml (d->layer, d->saved_xml, FALSE);
+  chopgimp_vlayer_set_selection (d->layer, d->saved_ids, d->n_saved);
+  d->previewed = FALSE;
+}
+
+static void
+dialog_read (Dialog *d)
+{
+  d->te.scale_x   = gtk_adjustment_get_value (d->sx);
+  d->te.scale_y   = gtk_adjustment_get_value (d->sy);
+  d->te.move_x    = gtk_adjustment_get_value (d->dx);
+  d->te.move_y    = gtk_adjustment_get_value (d->dy);
+  d->te.angle     = gtk_adjustment_get_value (d->angle);
+  d->te.reflect_x = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->rx));
+  d->te.reflect_y = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->ry));
+  d->te.random    = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->random));
+  d->te.copy      = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->copy));
+
+  for (gint i = 0; i < 9; i++)
+    if (gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->ref[i])))
+      d->te.ref = i;
+}
+
+static void
+dialog_preview (Dialog *d)
+{
+  dialog_restore (d);
+
+  if (gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->preview)))
+    {
+      dialog_read (d);
+      d->previewed = chopgimp_vtransform_each (d->layer, &d->te, FALSE);
+    }
+
+  gimp_image_flush (d->image);
+}
+
+static void
+dialog_changed (GtkWidget *widget,
+                Dialog    *d)
+{
+  if (! d->loading)
+    dialog_preview (d);
+}
+
+static GtkAdjustment *
+add_scale (GtkWidget   *box,
+           const gchar *label,
+           gdouble      value,
+           gdouble      lower,
+           gdouble      upper,
+           Dialog      *d)
+{
+  GtkAdjustment *adj   = gtk_adjustment_new (value, lower, upper, 1, 10, 0);
+  GtkWidget     *scale = gimp_spin_scale_new (adj, label, 1);
+
+  gtk_box_pack_start (GTK_BOX (box), scale, FALSE, FALSE, 0);
+  g_signal_connect (adj, "value-changed", G_CALLBACK (dialog_changed), d);
+
+  return adj;
+}
+
+static GtkWidget *
+add_heading (GtkWidget   *box,
+             const gchar *text)
+{
+  GtkWidget *label = gtk_label_new (text);
+
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gimp_label_set_attributes (GTK_LABEL (label), PANGO_ATTR_WEIGHT, PANGO_WEIGHT_BOLD, -1);
+  gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 4);
+
+  return label;
+}
+
+static GtkWidget *
+add_check (GtkWidget   *box,
+           const gchar *label,
+           Dialog      *d)
+{
+  GtkWidget *check = gtk_check_button_new_with_mnemonic (label);
+
+  gtk_box_pack_start (GTK_BOX (box), check, FALSE, FALSE, 0);
+  g_signal_connect (check, "toggled", G_CALLBACK (dialog_changed), d);
+
+  return check;
+}
+
+static void
+dialog_load_defaults (Dialog *d)
+{
+  d->loading = TRUE;
+
+  gtk_adjustment_set_value (d->sx, 100);
+  gtk_adjustment_set_value (d->sy, 100);
+  gtk_adjustment_set_value (d->dx, 0);
+  gtk_adjustment_set_value (d->dy, 0);
+  gtk_adjustment_set_value (d->angle, 0);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->rx), FALSE);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->ry), FALSE);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->random), FALSE);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->copy), FALSE);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->ref[4]), TRUE);
+
+  d->loading = FALSE;
+}
+
+gboolean
+chopgimp_transform_each_dialog_show (GimpImage       *image,
+                                     GimpVectorLayer *layer,
+                                     GtkWidget       *parent)
+{
+  Dialog       d = { 0, };
+  GtkWidget   *dialog;
+  GtkWidget   *vbox, *hbox, *grid, *col;
+  GSList      *group = NULL;
+  const guint *ids;
+  gboolean     done = FALSE;
+  gint         response;
+
+  if (! layer || chopgimp_vobjects_n_selected (layer) == 0)
+    return FALSE;
+
+  d.image     = image;
+  d.layer     = layer;
+  d.saved_xml = chopgimp_vlayer_get_xml (layer);
+  ids         = chopgimp_vlayer_get_selection (layer, &d.n_saved);
+  d.saved_ids = g_memdup2 (ids, MAX (d.n_saved, 1) * sizeof (guint));
+
+  if (! d.saved_xml)
+    {
+      g_free (d.saved_ids);
+      return FALSE;
+    }
+
+  chopgimp_vtransform_each_init (&d.te);
+
+  dialog = g_object_new (GIMP_TYPE_DIALOG,
+                         "title",          _("Transformer chaque"),
+                         "role",           "chopgimp-transform-each",
+                         "modal",          TRUE,
+                         "help-func",      gimp_standard_help_func,
+                         "help-id",        GIMP_HELP_PATH_DIALOG,
+                         "parent",         parent ? gtk_widget_get_toplevel (parent) : NULL,
+                         "use-header-bar", FALSE,
+                         NULL);
+
+  gimp_dialog_add_buttons (GIMP_DIALOG (dialog),
+                           _("_Réinitialiser"), RESPONSE_RESET,
+                           _("_Annuler"),       GTK_RESPONSE_CANCEL,
+                           _("_Valider"),       GTK_RESPONSE_OK,
+                           NULL);
+  gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_OK);
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 18);
+  gtk_container_set_border_width (GTK_CONTAINER (hbox), 12);
+  gtk_box_pack_start (GTK_BOX (gtk_dialog_get_content_area (GTK_DIALOG (dialog))),
+                      hbox, TRUE, TRUE, 0);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_box_pack_start (GTK_BOX (hbox), vbox, TRUE, TRUE, 0);
+
+  add_heading (vbox, _("Mise à l'échelle"));
+  d.sx = add_scale (vbox, _("Horizontale (%)"), 100, 1, 1000, &d);
+  d.sy = add_scale (vbox, _("Verticale (%)"),   100, 1, 1000, &d);
+
+  add_heading (vbox, _("Déplacement"));
+  d.dx = add_scale (vbox, _("Horizontal (px)"), 0, -10000, 10000, &d);
+  d.dy = add_scale (vbox, _("Vertical (px)"),   0, -10000, 10000, &d);
+
+  add_heading (vbox, _("Rotation"));
+  d.angle = add_scale (vbox, _("Angle (°)"), 0, -360, 360, &d);
+
+  /*  options and the reference point  */
+  col = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_box_pack_start (GTK_BOX (hbox), col, FALSE, FALSE, 0);
+
+  add_heading (col, _("Options"));
+  d.rx     = add_check (col, _("Symétrie _X"), &d);
+  d.ry     = add_check (col, _("Symétrie _Y"), &d);
+  d.random = add_check (col, _("_Aléatoire"), &d);
+  gtk_widget_set_tooltip_text (d.random,
+                               _("Chaque objet reçoit une valeur au hasard entre aucun "
+                                 "changement et les valeurs choisies"));
+  d.copy   = add_check (col, _("_Copier"), &d);
+  gtk_widget_set_tooltip_text (d.copy, _("Les objets d'origine restent, les copies "
+                                         "sont transformées"));
+
+  add_heading (col, _("Point de référence"));
+  grid = gtk_grid_new ();
+  gtk_box_pack_start (GTK_BOX (col), grid, FALSE, FALSE, 0);
+
+  for (gint i = 0; i < 9; i++)
+    {
+      d.ref[i] = gtk_radio_button_new (group);
+      group    = gtk_radio_button_get_group (GTK_RADIO_BUTTON (d.ref[i]));
+      gtk_grid_attach (GTK_GRID (grid), d.ref[i], i % 3, i / 3, 1, 1);
+      g_signal_connect (d.ref[i], "toggled", G_CALLBACK (dialog_changed), &d);
+    }
+
+  d.preview = gtk_check_button_new_with_mnemonic (_("_Aperçu"));
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d.preview), TRUE);
+  gtk_box_pack_end (GTK_BOX (col), d.preview, FALSE, FALSE, 0);
+  g_signal_connect (d.preview, "toggled", G_CALLBACK (dialog_changed), &d);
+
+  dialog_load_defaults (&d);
+  gtk_widget_show_all (hbox);
+  dialog_preview (&d);
+
+  while ((response = gimp_dialog_run (GIMP_DIALOG (dialog))) == RESPONSE_RESET)
+    {
+      dialog_load_defaults (&d);
+      dialog_preview (&d);
+    }
+
+  /*  back to the state before, then one undo step for the result  */
+  dialog_restore (&d);
+
+  if (response == GTK_RESPONSE_OK)
+    {
+      dialog_read (&d);
+      done = chopgimp_vtransform_each (layer, &d.te, TRUE);
+    }
+
+  gimp_image_flush (image);
+  gtk_widget_destroy (dialog);
+
+  g_free (d.saved_xml);
+  g_free (d.saved_ids);
+
+  return done;
+}
