diff --git a/app/tools/chopgimp-widthtool.c b/app/tools/chopgimp-widthtool.c
new file mode 100644
index 0000000..bfb3b19
--- /dev/null
+++ b/app/tools/chopgimp-widthtool.c
@@ -0,0 +1,914 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-widthtool.c — ChopGimp 3.27.6 (lot V6 point 5): the Width tool
+ * (Illustrator's « Outil Largeur », Maj+W).
+ *
+ * On the stroke of an object of a vector layer:
+ *  - click on the stroke: a width point there, drag to widen / narrow
+ *    the stroke (both sides; Alt: one side only);
+ *  - drag the handles of a point: its width; drag its centre (◇): move
+ *    it along the path;
+ *  - Suppr: deletes the selected point; double-click: its widths.
+ *
+ * The widths are the width profile of the object's (primary) stroke
+ * (chopgimp-vobject.h, « t:w » or « t:left/right », fractions of the
+ * stroke width), drawn by the « powerstroke » path effect of
+ * chopgimp-geom.cc. The profile can be saved and reused from the tool
+ * options, the options bar and the Contour panel.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+#include <gdk/gdkkeysyms.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "tools-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpcontext.h"
+#include "core/gimpimage.h"
+#include "core/gimpimage-undo.h"
+#include "core/gimptooloptions.h"
+
+#include "path/gimppath.h"
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-geom.h"
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vobject-ops.h"
+
+#include "widgets/gimphelp-ids.h"
+#include "widgets/chopgimp-width-profile-box.h"
+
+#include "display/gimpdisplay.h"
+#include "display/gimpdisplayshell.h"
+
+#include "gimpdrawtool.h"
+#include "gimptoolcontrol.h"
+#include "gimptooloptions-gui.h"
+#include "chopgimp-tools.h"
+#include "chopgimp-widthtool.h"
+
+#include "gimp-intl.h"
+
+
+#define HANDLE   11
+#define TOL_PX   7.0
+
+typedef struct
+{
+  gdouble t;
+  gdouble l, r;      /* fractions of the stroke width, each side  */
+} WPoint;
+
+typedef enum
+{
+  DRAG_NONE,
+  DRAG_LEFT,
+  DRAG_RIGHT,
+  DRAG_MOVE
+} DragKind;
+
+typedef struct
+{
+  GimpDrawTool     parent_instance;
+
+  GimpVectorLayer *layer;
+  guint            id;
+  gint             stroke;     /* the sub-path the handles are shown on   */
+  GArray          *points;     /* WPoint, sorted by t                     */
+  gint             selected;   /* index in points, -1                     */
+
+  DragKind         drag;
+  gint             drag_index;
+  gboolean         one_side;
+  gboolean         pushed;
+  gboolean         created;    /* the press added a point                 */
+
+  gboolean         hover_on;
+  gdouble          hover_x, hover_y;
+} GimpWidthTool;
+
+typedef struct
+{
+  GimpDrawToolClass parent_class;
+} GimpWidthToolClass;
+
+G_DEFINE_TYPE (GimpWidthTool, gimp_width_tool, GIMP_TYPE_DRAW_TOOL)
+
+
+static GtkWidget *
+width_options_gui (GimpToolOptions *options)
+{
+  GtkWidget *vbox  = gimp_tool_options_gui (options);
+  GtkWidget *label;
+
+  label = gtk_label_new (_("Profil de largeur des objets sélectionnés :"));
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (label), TRUE);
+  gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 0);
+  gtk_widget_show (label);
+
+  gtk_box_pack_start (GTK_BOX (vbox),
+                      chopgimp_width_profile_box_new (GIMP_CONTEXT (options)->gimp),
+                      FALSE, FALSE, 0);
+
+  label = gtk_label_new (_("Cliquez sur le contour d'un objet et tirez pour "
+                           "l'élargir ou l'affiner (Alt : un seul côté). "
+                           "Tirez le losange d'un point pour le déplacer le long "
+                           "du tracé, Suppr pour le supprimer, double-clic pour "
+                           "saisir ses largeurs."));
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (label), TRUE);
+  gimp_label_set_attributes (GTK_LABEL (label), PANGO_ATTR_SCALE, PANGO_SCALE_SMALL, -1);
+  gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 0);
+  gtk_widget_show (label);
+
+  return vbox;
+}
+
+void
+gimp_width_tool_register (GimpToolRegisterCallback  callback,
+                          gpointer                  data)
+{
+  (* callback) (gimp_width_tool_get_type (),
+                GIMP_TYPE_TOOL_OPTIONS,
+                width_options_gui,
+                0,
+                "gimp-width-tool",
+                _("Largeur"),
+                _("Outil Largeur : tirez sur le contour d'un objet vectoriel pour "
+                  "faire varier son épaisseur (Alt : un seul côté)"),
+                N_("_Largeur"), NULL,
+                NULL, GIMP_HELP_TOOL_PATH,
+                "chopgimp-tool-width",
+                data);
+}
+
+
+/*  ─── the object and its profile ────────────────────────────────────── */
+
+static ChopGimpVObject *
+wt_object (GimpWidthTool *wt)
+{
+  ChopGimpVObject *o;
+
+  if (! wt->layer || ! wt->id ||
+      ! gimp_item_is_attached (GIMP_ITEM (wt->layer)))
+    return NULL;
+
+  o = chopgimp_vlayer_get_object (wt->layer, wt->id);
+
+  if (! o || o->kind != CHOPGIMP_VOBJECT_PATH || ! o->path)
+    return NULL;
+
+  return o;
+}
+
+static ChopGimpVEntry *
+wt_entry (ChopGimpVObject *o)
+{
+  ChopGimpVEntry *e = o ? chopgimp_vstyle_get_stroke (&o->style) : NULL;
+
+  return (e && e->width > 0.0) ? e : NULL;
+}
+
+static gint
+wpoint_cmp (gconstpointer a,
+            gconstpointer b)
+{
+  gdouble d = ((const WPoint *) a)->t - ((const WPoint *) b)->t;
+
+  return d < 0 ? -1 : d > 0 ? 1 : 0;
+}
+
+static void
+wt_load (GimpWidthTool *wt)
+{
+  ChopGimpVEntry *e = wt_entry (wt_object (wt));
+  gchar         **items;
+
+  g_array_set_size (wt->points, 0);
+
+  if (! e)
+    return;
+
+  items = g_strsplit (chopgimp_vstyle_get_profile_points (e->profile), ",", -1);
+
+  for (gchar **it = items; *it; it++)
+    {
+      gchar *colon = strchr (*it, ':');
+      WPoint p;
+
+      if (! colon)
+        continue;
+
+      p.t = CLAMP (g_ascii_strtod (*it, NULL), 0.0, 1.0);
+      p.l = MAX (0.0, g_ascii_strtod (colon + 1, NULL));
+      p.r = strchr (colon + 1, '/') ? MAX (0.0, g_ascii_strtod (strchr (colon + 1, '/') + 1, NULL))
+                                    : p.l;
+      g_array_append_val (wt->points, p);
+    }
+
+  g_strfreev (items);
+  g_array_sort (wt->points, wpoint_cmp);
+
+  if (wt->points->len < 2)
+    {
+      WPoint a = { 0.0, 1.0, 1.0 }, b = { 1.0, 1.0, 1.0 };
+
+      g_array_set_size (wt->points, 0);
+      g_array_append_val (wt->points, a);
+      g_array_append_val (wt->points, b);
+    }
+
+  if (wt->selected >= (gint) wt->points->len)
+    wt->selected = -1;
+}
+
+/*  the profile string of the points  */
+static gchar *
+wt_profile (GimpWidthTool *wt)
+{
+  GString *s = g_string_new (NULL);
+  gchar    buf[G_ASCII_DTOSTR_BUF_SIZE];
+
+  for (guint i = 0; i < wt->points->len; i++)
+    {
+      WPoint *p = &g_array_index (wt->points, WPoint, i);
+
+      if (i)
+        g_string_append_c (s, ',');
+      g_string_append (s, g_ascii_formatd (buf, sizeof (buf), "%.4f", p->t));
+      g_string_append_c (s, ':');
+      g_string_append (s, g_ascii_formatd (buf, sizeof (buf), "%.4f", p->l));
+
+      if (fabs (p->l - p->r) > 1e-4)
+        {
+          g_string_append_c (s, '/');
+          g_string_append (s, g_ascii_formatd (buf, sizeof (buf), "%.4f", p->r));
+        }
+    }
+
+  return g_string_free (s, FALSE);
+}
+
+static void
+wt_store (GimpWidthTool *wt)
+{
+  ChopGimpVObject *o = wt_object (wt);
+  ChopGimpVEntry  *e = wt_entry (o);
+
+  if (! e)
+    return;
+
+  if (! wt->pushed)
+    {
+      chopgimp_vlayer_push_undo (wt->layer, _("Largeur du contour"));
+      wt->pushed = TRUE;
+    }
+
+  g_free (e->profile);
+  e->profile = wt_profile (wt);
+
+  chopgimp_vlayer_object_changed (wt->layer, o);
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (wt->layer)));
+}
+
+/*  the width (fraction) of one side at @t: the same smooth (cosine)
+ *  interpolation as the powerstroke
+ */
+static gdouble
+wt_width_at (GimpWidthTool *wt,
+             gdouble        t,
+             gboolean       right)
+{
+  GArray *pts = wt->points;
+
+  if (pts->len == 0)
+    return 1.0;
+
+  for (guint i = 0; i < pts->len; i++)
+    {
+      WPoint *p = &g_array_index (pts, WPoint, i);
+
+      if (t <= p->t)
+        {
+          WPoint *q;
+          gdouble u;
+
+          if (i == 0)
+            return right ? p->r : p->l;
+
+          q = &g_array_index (pts, WPoint, i - 1);
+          u = (t - q->t) / MAX (1e-9, p->t - q->t);
+          u = (1 - cos (u * G_PI)) / 2;
+
+          return right ? q->r + u * (p->r - q->r) : q->l + u * (p->l - q->l);
+        }
+    }
+
+  return right ? g_array_index (pts, WPoint, pts->len - 1).r
+               : g_array_index (pts, WPoint, pts->len - 1).l;
+}
+
+
+/*  ─── geometry: local ⇄ image ───────────────────────────────────────── */
+
+typedef struct
+{
+  GimpMatrix3 m, inv;
+  gdouble     scale;     /* image px per local px  */
+} Space;
+
+static void
+wt_space (ChopGimpVObject *o,
+          Space           *sp)
+{
+  chopgimp_vobject_get_world_matrix (o, &sp->m);
+  sp->inv = sp->m;
+  gimp_matrix3_invert (&sp->inv);
+  sp->scale = sqrt (fabs (sp->m.coeff[0][0] * sp->m.coeff[1][1] -
+                          sp->m.coeff[0][1] * sp->m.coeff[1][0]));
+  if (sp->scale < 1e-9)
+    sp->scale = 1.0;
+}
+
+/*  the centre and both handles of point @p, in the image  */
+static gboolean
+wt_point_geom (GimpWidthTool  *wt,
+               ChopGimpVObject *o,
+               ChopGimpVEntry  *e,
+               const Space     *sp,
+               const WPoint    *p,
+               gdouble          c[2],
+               gdouble          l[2],
+               gdouble          r[2])
+{
+  gdouble x, y, nx, ny;
+
+  if (! chopgimp_geom_point_at (o->path, wt->stroke, p->t, &x, &y, &nx, &ny))
+    return FALSE;
+
+  gimp_matrix3_transform_point (&sp->m, x, y, &c[0], &c[1]);
+  gimp_matrix3_transform_point (&sp->m, x + nx * p->l * e->width / 2,
+                                y + ny * p->l * e->width / 2, &l[0], &l[1]);
+  gimp_matrix3_transform_point (&sp->m, x - nx * p->r * e->width / 2,
+                                y - ny * p->r * e->width / 2, &r[0], &r[1]);
+
+  return TRUE;
+}
+
+static gdouble
+wt_tolerance (GimpDisplay *display)
+{
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+
+  return TOL_PX / MAX (1e-6, shell->scale_x);
+}
+
+/*  the handle under (x, y): its index and kind  */
+static gboolean
+wt_handle_at (GimpWidthTool *wt,
+              GimpDisplay   *display,
+              gdouble        x,
+              gdouble        y,
+              gint          *index,
+              DragKind      *kind)
+{
+  ChopGimpVObject *o   = wt_object (wt);
+  ChopGimpVEntry  *e   = wt_entry (o);
+  gdouble          tol = wt_tolerance (display);
+  gdouble          best = tol;
+  Space            sp;
+  gboolean         found = FALSE;
+
+  if (! e)
+    return FALSE;
+
+  wt_space (o, &sp);
+
+  for (guint i = 0; i < wt->points->len; i++)
+    {
+      gdouble c[2], l[2], r[2], d;
+
+      if (! wt_point_geom (wt, o, e, &sp, &g_array_index (wt->points, WPoint, i), c, l, r))
+        continue;
+
+      if ((d = hypot (x - l[0], y - l[1])) <= best)
+        { best = d; *index = i; *kind = DRAG_LEFT;  found = TRUE; }
+      if ((d = hypot (x - r[0], y - r[1])) <= best)
+        { best = d; *index = i; *kind = DRAG_RIGHT; found = TRUE; }
+      if ((d = hypot (x - c[0], y - c[1])) <= best)
+        { best = d; *index = i; *kind = DRAG_MOVE;  found = TRUE; }
+    }
+
+  return found;
+}
+
+/*  on the stroke of the current object: sub-path and t  */
+static gboolean
+wt_on_stroke (GimpWidthTool *wt,
+              GimpDisplay   *display,
+              gdouble        x,
+              gdouble        y,
+              gint          *stroke,
+              gdouble       *t)
+{
+  ChopGimpVObject *o = wt_object (wt);
+  ChopGimpVEntry  *e = wt_entry (o);
+  Space            sp;
+  gdouble          lx, ly, dist, half;
+
+  if (! e)
+    return FALSE;
+
+  wt_space (o, &sp);
+  gimp_matrix3_transform_point (&sp.inv, x, y, &lx, &ly);
+
+  if (! chopgimp_geom_locate (o->path, lx, ly, stroke, t, &dist))
+    return FALSE;
+
+  half = e->width / 2 * MAX (wt_width_at (wt, *t, FALSE), wt_width_at (wt, *t, TRUE));
+
+  return dist <= MAX (half, wt_tolerance (display) / sp.scale);
+}
+
+/*  picks the object under the pointer (with a stroke)  */
+static gboolean
+wt_pick (GimpWidthTool *wt,
+         GimpDisplay   *display,
+         gdouble        x,
+         gdouble        y)
+{
+  GimpImage       *image = gimp_display_get_image (display);
+  GimpVectorLayer *layer = image ? chopgimp_vobjects_get_target_layer (image) : NULL;
+  ChopGimpVObject *o;
+
+  if (! layer)
+    return FALSE;
+
+  o = chopgimp_vlayer_hit_test (layer, x, y, wt_tolerance (display), CHOPGIMP_HIT_LEAF);
+
+  if (! o || ! wt_entry (o))
+    return FALSE;
+
+  if (layer != wt->layer || o->id != wt->id)
+    {
+      wt->layer    = layer;
+      wt->id       = o->id;
+      wt->stroke   = 0;
+      wt->selected = -1;
+    }
+
+  wt_load (wt);
+
+  return TRUE;
+}
+
+
+/*  ─── events ────────────────────────────────────────────────────────── */
+
+static void
+gimp_width_tool_oper_update (GimpTool         *tool,
+                             const GimpCoords *coords,
+                             GdkModifierType   state,
+                             gboolean          proximity,
+                             GimpDisplay      *display)
+{
+  GimpWidthTool *wt = (GimpWidthTool *) tool;
+  gint           index, stroke;
+  DragKind       kind;
+  gdouble        t;
+  gboolean       was = wt->hover_on;
+
+  wt->hover_on = FALSE;
+
+  if (proximity)
+    {
+      if (! wt_object (wt) || ! wt_on_stroke (wt, display, coords->x, coords->y, &stroke, &t))
+        wt_pick (wt, display, coords->x, coords->y);
+      else
+        wt_load (wt);
+
+      if (wt_handle_at (wt, display, coords->x, coords->y, &index, &kind))
+        {
+          gimp_tool_replace_status (tool, display,
+                                    kind == DRAG_MOVE
+                                    ? _("Glisser : déplacer le point le long du tracé — "
+                                        "Suppr : le supprimer — double-clic : ses largeurs")
+                                    : _("Glisser : largeur du contour (Alt : ce côté seulement)"));
+        }
+      else if (wt_on_stroke (wt, display, coords->x, coords->y, &stroke, &t))
+        {
+          ChopGimpVObject *o = wt_object (wt);
+          gdouble          x, y, nx, ny;
+          Space            sp;
+
+          wt->stroke = stroke;
+          wt_space (o, &sp);
+
+          if (chopgimp_geom_point_at (o->path, stroke, t, &x, &y, &nx, &ny))
+            {
+              gimp_matrix3_transform_point (&sp.m, x, y, &wt->hover_x, &wt->hover_y);
+              wt->hover_on = TRUE;
+            }
+
+          gimp_tool_replace_status (tool, display,
+                                    _("Glisser : ajouter un point de largeur et élargir "
+                                      "ou affiner le contour (Alt : un seul côté)"));
+        }
+      else
+        {
+          gimp_tool_replace_status (tool, display,
+                                    _("Outil Largeur : placez-vous sur le contour d'un objet "
+                                      "d'un calque vectoriel"));
+        }
+    }
+
+  if (was || wt->hover_on || wt_object (wt))
+    chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (wt), display);
+}
+
+static void
+wt_edit_dialog (GimpWidthTool *wt,
+                GimpDisplay   *display)
+{
+  ChopGimpVEntry *e = wt_entry (wt_object (wt));
+  WPoint         *p;
+  GtkWidget      *dialog, *grid, *s1, *s2;
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+
+  if (! e || wt->selected < 0)
+    return;
+
+  p = &g_array_index (wt->points, WPoint, wt->selected);
+
+  dialog = gtk_dialog_new_with_buttons (_("Point de largeur"),
+                                        GTK_WINDOW (gtk_widget_get_toplevel (GTK_WIDGET (shell))),
+                                        GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
+                                        _("_Annuler"), GTK_RESPONSE_CANCEL,
+                                        _("_Valider"), GTK_RESPONSE_OK,
+                                        NULL);
+  gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_OK);
+
+  grid = gtk_grid_new ();
+  gtk_container_set_border_width (GTK_CONTAINER (grid), 12);
+  gtk_grid_set_row_spacing (GTK_GRID (grid), 6);
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 8);
+
+  s1 = gtk_spin_button_new_with_range (0.0, 10000.0, 0.5);
+  s2 = gtk_spin_button_new_with_range (0.0, 10000.0, 0.5);
+  gtk_spin_button_set_digits (GTK_SPIN_BUTTON (s1), 1);
+  gtk_spin_button_set_digits (GTK_SPIN_BUTTON (s2), 1);
+  gtk_spin_button_set_value (GTK_SPIN_BUTTON (s1), p->l * e->width / 2);
+  gtk_spin_button_set_value (GTK_SPIN_BUTTON (s2), p->r * e->width / 2);
+  gtk_entry_set_activates_default (GTK_ENTRY (s1), TRUE);
+  gtk_entry_set_activates_default (GTK_ENTRY (s2), TRUE);
+
+  gtk_grid_attach (GTK_GRID (grid), gtk_label_new (_("Côté 1 (px) :")), 0, 0, 1, 1);
+  gtk_grid_attach (GTK_GRID (grid), s1, 1, 0, 1, 1);
+  gtk_grid_attach (GTK_GRID (grid), gtk_label_new (_("Côté 2 (px) :")), 0, 1, 1, 1);
+  gtk_grid_attach (GTK_GRID (grid), s2, 1, 1, 1, 1);
+  gtk_box_pack_start (GTK_BOX (gtk_dialog_get_content_area (GTK_DIALOG (dialog))),
+                      grid, TRUE, TRUE, 0);
+  gtk_widget_show_all (grid);
+
+  if (gtk_dialog_run (GTK_DIALOG (dialog)) == GTK_RESPONSE_OK)
+    {
+      p->l = gtk_spin_button_get_value (GTK_SPIN_BUTTON (s1)) * 2 / e->width;
+      p->r = gtk_spin_button_get_value (GTK_SPIN_BUTTON (s2)) * 2 / e->width;
+      wt->pushed = FALSE;
+      wt_store (wt);
+      chopgimp_width_profile_boxes_update ();
+    }
+
+  gtk_widget_destroy (dialog);
+}
+
+static void
+gimp_width_tool_button_press (GimpTool            *tool,
+                              const GimpCoords    *coords,
+                              guint32              time,
+                              GdkModifierType      state,
+                              GimpButtonPressType  press_type,
+                              GimpDisplay         *display)
+{
+  GimpWidthTool *wt = (GimpWidthTool *) tool;
+  gint           index, stroke;
+  DragKind       kind;
+  gdouble        t;
+
+  wt->drag    = DRAG_NONE;
+  wt->pushed  = FALSE;
+  wt->created = FALSE;
+
+  if (! wt_object (wt))
+    wt_pick (wt, display, coords->x, coords->y);
+
+  if (wt_object (wt))
+    wt_load (wt);
+
+  if (wt_handle_at (wt, display, coords->x, coords->y, &index, &kind))
+    {
+      wt->selected = index;
+
+      if (press_type == GIMP_BUTTON_PRESS_DOUBLE)
+        {
+          wt_edit_dialog (wt, display);
+          return;
+        }
+
+      wt->drag       = kind;
+      wt->drag_index = index;
+    }
+  else if (press_type == GIMP_BUTTON_PRESS_NORMAL &&
+           (wt_on_stroke (wt, display, coords->x, coords->y, &stroke, &t) ||
+            (wt_pick (wt, display, coords->x, coords->y) &&
+             wt_on_stroke (wt, display, coords->x, coords->y, &stroke, &t))))
+    {
+      WPoint p;
+      guint  i;
+
+      p.t = t;
+      p.l = wt_width_at (wt, t, FALSE);
+      p.r = wt_width_at (wt, t, TRUE);
+
+      for (i = 0; i < wt->points->len && g_array_index (wt->points, WPoint, i).t < t; i++);
+      g_array_insert_val (wt->points, i, p);
+
+      wt->stroke     = stroke;
+      wt->selected   = i;
+      wt->drag       = DRAG_LEFT;
+      wt->drag_index = i;
+      wt->created    = TRUE;
+    }
+  else
+    {
+      return;
+    }
+
+  /*  the object being widened is the selected one (for the profiles)  */
+  chopgimp_vlayer_set_selection (wt->layer, &wt->id, 1);
+
+  wt->one_side = (state & GDK_MOD1_MASK) != 0;
+  tool->display = display;
+  gimp_tool_control_activate (tool->control);
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (wt), display);
+}
+
+static void
+gimp_width_tool_motion (GimpTool         *tool,
+                        const GimpCoords *coords,
+                        guint32           time,
+                        GdkModifierType   state,
+                        GimpDisplay      *display)
+{
+  GimpWidthTool   *wt = (GimpWidthTool *) tool;
+  ChopGimpVObject *o  = wt_object (wt);
+  ChopGimpVEntry  *e  = wt_entry (o);
+  WPoint          *p;
+  Space            sp;
+  gdouble          lx, ly, x, y, nx, ny;
+
+  if (! e || wt->drag == DRAG_NONE || wt->drag_index >= (gint) wt->points->len)
+    return;
+
+  p = &g_array_index (wt->points, WPoint, wt->drag_index);
+  wt_space (o, &sp);
+  gimp_matrix3_transform_point (&sp.inv, coords->x, coords->y, &lx, &ly);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (wt));
+
+  if (wt->drag == DRAG_MOVE)
+    {
+      gint    s;
+      gdouble t, dist;
+      gdouble lo = 0.0, hi = 1.0;
+
+      /*  the end points stay at the ends  */
+      if (p->t > 0.0 && p->t < 1.0 &&
+          chopgimp_geom_locate (o->path, lx, ly, &s, &t, &dist) && s == wt->stroke)
+        {
+          if (wt->drag_index > 0)
+            lo = g_array_index (wt->points, WPoint, wt->drag_index - 1).t + 0.002;
+          if (wt->drag_index < (gint) wt->points->len - 1)
+            hi = g_array_index (wt->points, WPoint, wt->drag_index + 1).t - 0.002;
+
+          p->t = CLAMP (t, lo, hi);
+        }
+    }
+  else if (chopgimp_geom_point_at (o->path, wt->stroke, p->t, &x, &y, &nx, &ny))
+    {
+      /*  the distance from the path along the normal  */
+      gdouble d = (lx - x) * nx + (ly - y) * ny;
+      gdouble w = MAX (0.0, fabs (d)) * 2 / e->width;
+
+      if (wt->one_side)
+        {
+          /*  the side the pointer is on  */
+          if (d >= 0)
+            p->l = w;
+          else
+            p->r = w;
+        }
+      else
+        {
+          p->l = p->r = w;
+        }
+    }
+
+  wt_store (wt);
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (wt));
+}
+
+static void
+gimp_width_tool_button_release (GimpTool              *tool,
+                                const GimpCoords      *coords,
+                                guint32                time,
+                                GdkModifierType        state,
+                                GimpButtonReleaseType  release_type,
+                                GimpDisplay           *display)
+{
+  GimpWidthTool *wt = (GimpWidthTool *) tool;
+
+  gimp_tool_control_halt (tool->control);
+
+  /*  a click without a drag on a new point: it stays, its width too  */
+  if (wt->created && ! wt->pushed && release_type != GIMP_BUTTON_RELEASE_CANCEL)
+    wt_store (wt);
+
+  if (release_type == GIMP_BUTTON_RELEASE_CANCEL && wt->pushed)
+    {
+      GimpImage *image = gimp_item_get_image (GIMP_ITEM (wt->layer));
+
+      gimp_image_undo (image);
+      wt_load (wt);
+    }
+
+  wt->drag   = DRAG_NONE;
+  wt->pushed = FALSE;
+
+  chopgimp_width_profile_boxes_update ();
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (wt), display);
+}
+
+static gboolean
+gimp_width_tool_key_press (GimpTool    *tool,
+                           GdkEventKey *kevent,
+                           GimpDisplay *display)
+{
+  GimpWidthTool *wt = (GimpWidthTool *) tool;
+
+  if ((kevent->keyval == GDK_KEY_Delete || kevent->keyval == GDK_KEY_BackSpace) &&
+      wt_object (wt) && wt->selected >= 0 && wt->points->len > 2)
+    {
+      gimp_draw_tool_pause (GIMP_DRAW_TOOL (wt));
+
+      g_array_remove_index (wt->points, wt->selected);
+      wt->selected = -1;
+      wt->pushed   = FALSE;
+      wt_store (wt);
+      wt->pushed   = FALSE;
+
+      gimp_draw_tool_resume (GIMP_DRAW_TOOL (wt));
+      chopgimp_width_profile_boxes_update ();
+
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+gboolean
+chopgimp_width_tool_delete_point (GimpTool *tool)
+{
+  GdkEventKey kevent = { 0, };
+
+  if (! tool || G_TYPE_FROM_INSTANCE (tool) != gimp_width_tool_get_type ())
+    return FALSE;
+
+  kevent.keyval = GDK_KEY_Delete;
+
+  return gimp_width_tool_key_press (tool, &kevent, tool->display);
+}
+
+static void
+gimp_width_tool_draw (GimpDrawTool *dt)
+{
+  GimpWidthTool   *wt = (GimpWidthTool *) dt;
+  ChopGimpVObject *o  = wt_object (wt);
+  ChopGimpVEntry  *e  = wt_entry (o);
+  Space            sp;
+
+  if (e)
+    {
+      wt_space (o, &sp);
+
+      for (guint i = 0; i < wt->points->len; i++)
+        {
+          gdouble  c[2], l[2], r[2];
+          gboolean sel = ((gint) i == wt->selected);
+
+          if (! wt_point_geom (wt, o, e, &sp, &g_array_index (wt->points, WPoint, i), c, l, r))
+            continue;
+
+          gimp_draw_tool_add_line (dt, l[0], l[1], r[0], r[1]);
+          gimp_draw_tool_add_handle (dt, sel ? GIMP_HANDLE_FILLED_CIRCLE : GIMP_HANDLE_CIRCLE,
+                                     l[0], l[1], HANDLE - 2, HANDLE - 2,
+                                     GIMP_HANDLE_ANCHOR_CENTER);
+          gimp_draw_tool_add_handle (dt, sel ? GIMP_HANDLE_FILLED_CIRCLE : GIMP_HANDLE_CIRCLE,
+                                     r[0], r[1], HANDLE - 2, HANDLE - 2,
+                                     GIMP_HANDLE_ANCHOR_CENTER);
+          gimp_draw_tool_add_handle (dt, sel ? GIMP_HANDLE_FILLED_DIAMOND : GIMP_HANDLE_DIAMOND,
+                                     c[0], c[1], HANDLE, HANDLE,
+                                     GIMP_HANDLE_ANCHOR_CENTER);
+        }
+    }
+
+  if (wt->hover_on && wt->drag == DRAG_NONE)
+    gimp_draw_tool_add_handle (dt, GIMP_HANDLE_CROSS, wt->hover_x, wt->hover_y,
+                               HANDLE, HANDLE, GIMP_HANDLE_ANCHOR_CENTER);
+}
+
+static void
+gimp_width_tool_control (GimpTool       *tool,
+                         GimpToolAction  action,
+                         GimpDisplay    *display)
+{
+  GimpWidthTool *wt = (GimpWidthTool *) tool;
+
+  if (action == GIMP_TOOL_ACTION_HALT || action == GIMP_TOOL_ACTION_COMMIT)
+    {
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+      wt->layer    = NULL;
+      wt->id       = 0;
+      wt->selected = -1;
+      wt->drag     = DRAG_NONE;
+      g_array_set_size (wt->points, 0);
+    }
+
+  GIMP_TOOL_CLASS (gimp_width_tool_parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_width_tool_finalize (GObject *object)
+{
+  GimpWidthTool *wt = (GimpWidthTool *) object;
+
+  g_array_unref (wt->points);
+
+  G_OBJECT_CLASS (gimp_width_tool_parent_class)->finalize (object);
+}
+
+static void
+gimp_width_tool_class_init (GimpWidthToolClass *klass)
+{
+  GObjectClass      *object_class    = G_OBJECT_CLASS (klass);
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  object_class->finalize     = gimp_width_tool_finalize;
+
+  /*  it edits the objects, it does not paint: vector layers are fine  */
+  tool_class->is_destructive = FALSE;
+
+  tool_class->control        = gimp_width_tool_control;
+  tool_class->oper_update    = gimp_width_tool_oper_update;
+  tool_class->button_press   = gimp_width_tool_button_press;
+  tool_class->motion         = gimp_width_tool_motion;
+  tool_class->button_release = gimp_width_tool_button_release;
+  tool_class->key_press      = gimp_width_tool_key_press;
+
+  draw_tool_class->draw      = gimp_width_tool_draw;
+}
+
+static void
+gimp_width_tool_init (GimpWidthTool *wt)
+{
+  GimpTool *tool = GIMP_TOOL (wt);
+
+  wt->points   = g_array_new (FALSE, FALSE, sizeof (WPoint));
+  wt->selected = -1;
+
+  gimp_tool_control_set_motion_mode (tool->control, GIMP_MOTION_MODE_EXACT);
+  gimp_tool_control_set_wants_double_click (tool->control, TRUE);   /* 3.28.2: double-click = the widths */
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_PATHS);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_MOUSE);
+}
