From b41a7d7653537058449e81991360ef896d8601f5 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Fri, 13 Nov 2026 22:12:04 +0100
Subject: [PATCH] ChopGimp: crash report keeps the stack of running plug-ins;
 readable transform constraint labels in the options bar

---
 app/chopgimp-crash.c         | 30 ++++++++++++++++++++++++++----
 app/display/gimpoptionsbar.c |  4 ++++
 app/gui/gui.c                |  5 ++++-
 3 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/app/chopgimp-crash.c b/app/chopgimp-crash.c
index afc461a..2ece4f0 100644
--- a/app/chopgimp-crash.c
+++ b/app/chopgimp-crash.c
@@ -243,7 +243,7 @@ write_report (gint sig, siginfo_t *info)
   w_num (fd, (guint64) tid, 10, 1);
   w_str (fd, tid == main_tid ? " (fil principal)\n" : " (fil de calcul)\n");
 
-  w_str (fd, "\n== Plug-in ==\n  ");
+  w_str (fd, "\n== Plug-in(s) en cours ==\n  ");
   w_str (fd, ctx_plugin[0] ? ctx_plugin : "aucun");
 
   w_str (fd, "\n\n== Dernières actions (la plus récente en bas) ==\n");
@@ -541,19 +541,41 @@ chopgimp_crash_note_plugin (const gchar *procedure,
                             gboolean     running)
 {
 #ifndef G_OS_WIN32
+  /*  pile des plug-ins en cours (un plug-in peut en appeler un autre)  */
+  static gchar  stack[8][96];
+  static gint   depth = 0;
+  static gchar  last[96];
+  gchar         buf[sizeof (ctx_plugin)];
+  gint          i;
+
   if (running)
     {
       GDateTime *now = g_date_time_new_now_local ();
       gchar     *ts  = g_date_time_format (now, "%H:%M:%S");
 
-      g_snprintf (ctx_plugin, sizeof (ctx_plugin), "%s (en cours depuis %s)", procedure, ts);
+      if (depth < (gint) G_N_ELEMENTS (stack))
+        g_snprintf (stack[depth], sizeof (stack[0]), "%s (depuis %s)", procedure, ts);
+      depth++;
       g_free (ts);
       g_date_time_unref (now);
     }
-  else
+  else if (depth > 0)
+    {
+      depth--;
+      g_strlcpy (last, procedure, sizeof (last));
+    }
+
+  buf[0] = '\0';
+  for (i = 0; i < MIN (depth, (gint) G_N_ELEMENTS (stack)); i++)
     {
-      g_snprintf (ctx_plugin, sizeof (ctx_plugin), "aucun (dernier : %s, terminé)", procedure);
+      if (i)
+        g_strlcat (buf, " → ", sizeof (buf));
+      g_strlcat (buf, stack[i], sizeof (buf));
     }
+  if (! buf[0])
+    g_snprintf (buf, sizeof (buf), "aucun en cours (dernier terminé : %s)", last[0] ? last : "aucun");
+  g_strlcpy (ctx_plugin, buf, sizeof (ctx_plugin));
+
   if (log_fd >= 0)
     g_printerr ("[plug-in] %s %s\n", procedure, running ? "lancé" : "terminé");
 #endif
diff --git a/app/display/gimpoptionsbar.c b/app/display/gimpoptionsbar.c
index 3b14fcf..4964af6 100644
--- a/app/display/gimpoptionsbar.c
+++ b/app/display/gimpoptionsbar.c
@@ -388,6 +388,10 @@ gimp_options_bar_label (const gchar *prop)
   if (! strcmp (prop, "line-spacing"))   return _("Interlignage");
   if (! strcmp (prop, "font-size"))      return _("Taille");
   if (! strcmp (prop, "box-mode"))       return _("Cadre");
+  if (! strcmp (prop, "constrain-scale"))  return _("Conserver les proportions");
+  if (! strcmp (prop, "constrain-rotate")) return _("Rotation par 15°");
+  if (! strcmp (prop, "constrain-shear"))  return _("Inclinaison contrainte");
+  if (! strcmp (prop, "constrain-move"))   return _("Déplacement contraint");
   return NULL;
 }
 
diff --git a/app/gui/gui.c b/app/gui/gui.c
index 49e5947..3bef0b7 100644
--- a/app/gui/gui.c
+++ b/app/gui/gui.c
@@ -771,7 +771,10 @@ chopgimp_crash_previous (gpointer data)
     for (i = 0; lines[i]; i++)
       if (g_str_has_prefix (lines[i], "Signal") || g_str_has_prefix (lines[i], "Fil") ||
           (i > 0 && g_str_has_prefix (lines[i - 1], "== Plug-in")))
-        g_string_append_printf (s, "%s\n", g_strstrip (lines[i]));
+        g_string_append_printf (s, "%s%s\n",
+                                (i > 0 && g_str_has_prefix (lines[i - 1], "== Plug-in")) ?
+                                "Plug-in : " : "",
+                                g_strstrip (lines[i]));
     g_strfreev (lines);
     details = g_string_free (s, FALSE);
   }
-- 
