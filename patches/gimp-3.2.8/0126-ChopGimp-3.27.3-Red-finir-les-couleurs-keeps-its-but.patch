Subject: [PATCH 126/131] =?UTF-8?q?ChopGimp=203.27.3:=20=C2=AB=20Red=C3=A9?=
 =?UTF-8?q?finir=20les=20couleurs=20=C2=BB=20keeps=20its=20buttons=20at=20?=
 =?UTF-8?q?the=20bottom=20(no=20header=20bar=20even=20when=20the=20desktop?=
 =?UTF-8?q?=20asks=20for=20one);=20=C2=AB=20Aspect=20=C2=BB=20list=20at=20?=
 =?UTF-8?q?least=20150=20px=20high=20so=20the=20dock=20slot=20grows=20inst?=
 =?UTF-8?q?ead=20of=20squeezing=20it?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 app/dialogs/chopgimp-recolor-dialog.c    | 33 ++++++++++++++++--------
 app/widgets/chopgimp-appearance-editor.c |  5 ++++
 2 files changed, 27 insertions(+), 11 deletions(-)

diff --git a/app/dialogs/chopgimp-recolor-dialog.c b/app/dialogs/chopgimp-recolor-dialog.c
index 35bc0a9..a198e1b 100644
--- a/app/dialogs/chopgimp-recolor-dialog.c
+++ b/app/dialogs/chopgimp-recolor-dialog.c
@@ -629,17 +629,28 @@ chopgimp_recolor_dialog_show (GimpImage   *image,
   d->rc      = rc;
   d->rows    = g_ptr_array_new ();
 
-  d->dialog = gimp_dialog_new (_("Redéfinir les couleurs"),
-                               "chopgimp-recolor",
-                               parent ? gtk_widget_get_toplevel (parent) : NULL,
-                               GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
-                               gimp_standard_help_func, GIMP_HELP_PATH_DIALOG,
-
-                               _("_Réinitialiser"), RESPONSE_RESET,
-                               _("_Annuler"),       GTK_RESPONSE_CANCEL,
-                               _("_Valider"),       GTK_RESPONSE_OK,
-
-                               NULL);
+  /*  Boutons en bas, comme les fenêtres de filtres : pas de barre d'en-tête
+   *  même si le bureau la demande (gtk-dialogs-use-header).
+   */
+  d->dialog = g_object_new (GIMP_TYPE_DIALOG,
+                            "title",          _("Redéfinir les couleurs"),
+                            "role",           "chopgimp-recolor",
+                            "modal",          TRUE,
+                            "help-func",      gimp_standard_help_func,
+                            "help-id",        GIMP_HELP_PATH_DIALOG,
+                            "parent",         parent ? gtk_widget_get_toplevel (parent) : NULL,
+                            "use-header-bar", FALSE,
+                            NULL);
+  if (parent)
+    g_signal_connect_object (gtk_widget_get_toplevel (parent), "destroy",
+                             G_CALLBACK (gtk_widget_destroy),
+                             d->dialog, G_CONNECT_SWAPPED);
+
+  gimp_dialog_add_buttons (GIMP_DIALOG (d->dialog),
+                           _("_Réinitialiser"), RESPONSE_RESET,
+                           _("_Annuler"),       GTK_RESPONSE_CANCEL,
+                           _("_Valider"),       GTK_RESPONSE_OK,
+                           NULL);
 
   gimp_dialog_set_alternative_button_order (GTK_DIALOG (d->dialog),
                                             RESPONSE_RESET,
diff --git a/app/widgets/chopgimp-appearance-editor.c b/app/widgets/chopgimp-appearance-editor.c
index 7203a0c..32af4ac 100644
--- a/app/widgets/chopgimp-appearance-editor.c
+++ b/app/widgets/chopgimp-appearance-editor.c
@@ -1991,6 +1991,11 @@ panel_new (GimpContext *context,
       gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled),
                                       GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
       gtk_box_pack_start (GTK_BOX (p->content), scrolled, TRUE, TRUE, 0);
+      /*  3.27.3 : au moins deux lignes (fond + contour) visibles, même dans
+       *  un emplacement de dock bas — le dock s'agrandit au lieu de tasser.
+       */
+      gtk_scrolled_window_set_min_content_height (GTK_SCROLLED_WINDOW (scrolled), 150);
+      gtk_scrolled_window_set_propagate_natural_height (GTK_SCROLLED_WINDOW (scrolled), TRUE);
 
       p->list = gtk_list_box_new ();
       gtk_list_box_set_selection_mode (GTK_LIST_BOX (p->list), GTK_SELECTION_SINGLE);
-- 
