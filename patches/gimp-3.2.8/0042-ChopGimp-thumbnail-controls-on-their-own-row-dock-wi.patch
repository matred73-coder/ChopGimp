+/*  content bounds of a layer in its own coordinates; for a group, the
+ *  union of its visible children (its projection may not be rendered yet)
+ */
+static gboolean
+chopgimp_content_bounds (GimpLayer *layer,
+                         gint      *x,
+                         gint      *y,
+                         gint      *w,
+                         gint      *h)
+{
+  GimpItem      *item     = GIMP_ITEM (layer);
+  GimpContainer *children = gimp_viewable_get_children (GIMP_VIEWABLE (layer));
+
+  if (children)
+    {
+      GList    *list;
+      gboolean  any = FALSE;
+      gint      ox, oy, x1 = 0, y1 = 0, x2 = 0, y2 = 0;
+
+      gimp_item_get_offset (item, &ox, &oy);
+
+      for (list = GIMP_LIST (children)->queue->head; list; list = list->next)
+        {
+          GimpItem *child = list->data;
+          gint      cx, cy, cw, ch, chx, chy;
+
+          if (! gimp_item_get_visible (child) ||
+              ! chopgimp_content_bounds (GIMP_LAYER (child), &cx, &cy, &cw, &ch))
+            continue;
+
+          gimp_item_get_offset (child, &chx, &chy);
+          cx += chx - ox;
+          cy += chy - oy;
+
+          if (! any)
+            {
+              x1 = cx; y1 = cy; x2 = cx + cw; y2 = cy + ch;
+              any = TRUE;
+            }
+          else
+            {
+              x1 = MIN (x1, cx);      y1 = MIN (y1, cy);
+              x2 = MAX (x2, cx + cw); y2 = MAX (y2, cy + ch);
+            }
+        }
+
+      x1 = MAX (x1, 0);
+      y1 = MAX (y1, 0);
+      x2 = MIN (x2, gimp_item_get_width  (item));
+      y2 = MIN (y2, gimp_item_get_height (item));
+
+      if (! any || x2 <= x1 || y2 <= y1)
+        return FALSE;
+
+      *x = x1; *y = y1; *w = x2 - x1; *h = y2 - y1;
+      return TRUE;
+    }
+
+  if ((gint64) gimp_item_get_width (item) * gimp_item_get_height (item) > 40000000)
+    return FALSE;
+
+  switch (gimp_pickable_auto_shrink (GIMP_PICKABLE (layer), 0, 0,
+                                     gimp_item_get_width (item),
+                                     gimp_item_get_height (item),
+                                     x, y, w, h))
+    {
+    case GIMP_AUTO_SHRINK_SHRINK:
+      return TRUE;
+
+    case GIMP_AUTO_SHRINK_UNSHRINKABLE:
+      *x = 0; *y = 0;
+      *w = gimp_item_get_width  (item);
+      *h = gimp_item_get_height (item);
+      return TRUE;
+
+    default:
+      return FALSE;
+    }
+}
+
 static void
 gimp_view_renderer_drawable_render (GimpViewRenderer *renderer,
                                     GtkWidget        *widget)
@@ -300,15 +380,12 @@ gimp_view_renderer_drawable_render (GimpViewRenderer *renderer,
