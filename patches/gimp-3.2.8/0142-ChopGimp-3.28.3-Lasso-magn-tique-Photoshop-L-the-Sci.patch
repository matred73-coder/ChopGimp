@@ -239,6 +240,18 @@ static void          icurve_delete_segment     (ICurve            *curve,
 
 static void          icurve_close              (ICurve            *curve);
 
+/*  ChopGimp 3.28.3: Lasso magnétique  */
+static void          magnetic_clear_live       (GimpIscissorsTool *iscissors);
+static void          magnetic_update_live      (GimpIscissorsTool *iscissors,
+                                                const GimpCoords  *coords,
+                                                GdkModifierType    state,
+                                                GimpDisplay       *display);
+static void          isegment_make_straight    (ISegment          *segment);
+static gboolean      isegment_point_from_start (ISegment          *segment,
+                                                gint               n,
+                                                gint              *x,
+                                                gint              *y);
+
 static GimpScanConvert *
                     icurve_create_scan_convert (ICurve            *curve);
 
@@ -298,6 +311,53 @@ gimp_iscissors_tool_register (GimpToolRegisterCallback  callback,
                 data);
 }
 
+/*  ChopGimp 3.28.3: « Lasso magnétique » (Photoshop L), the Scissors
+ *  Select tool in its magnetic mode: after the first click the edge is
+ *  followed while the mouse moves, points are placed by themselves
+ *  (Fréquence), Retour arrière removes the last one, a double-click,
+ *  Entrée or a click on the start point closes and selects, Alt draws
+ *  straight segments.
+ */
+G_DEFINE_TYPE (GimpMagneticLassoTool, gimp_magnetic_lasso_tool,
+               GIMP_TYPE_ISCISSORS_TOOL)
+
+void
+gimp_magnetic_lasso_tool_register (GimpToolRegisterCallback  callback,
+                                   gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_MAGNETIC_LASSO_TOOL,
+                GIMP_TYPE_ISCISSORS_OPTIONS,
+                gimp_iscissors_options_gui,
+                0,
+                "gimp-magnetic-lasso-tool",
+                "Lasso magnétique",
+                "Lasso magnétique : le tracé suit les bords de l'image "
+                "pendant qu'on déplace la souris",
+                "Lasso _magnétique",
+                NULL,
+                NULL, GIMP_HELP_TOOL_ISCISSORS,
+                "chopgimp-tool-magnetic-lasso",
+                data);
+}
+
+static void
+gimp_magnetic_lasso_tool_class_init (GimpMagneticLassoToolClass *klass)
+{
+}
+
+static void
+gimp_magnetic_lasso_tool_init (GimpMagneticLassoTool *tool)
+{
+  GimpIscissorsTool *iscissors = GIMP_ISCISSORS_TOOL (tool);
+
+  iscissors->magnetic = TRUE;
+
+  gimp_tool_control_set_tool_cursor (GIMP_TOOL (tool)->control,
+                                     GIMP_TOOL_CURSOR_FREE_SELECT);
+  /*  a double-click closes and selects (button_press below)  */
+  gimp_tool_control_set_wants_double_click (GIMP_TOOL (tool)->control, TRUE);
+}
+
 static void
 gimp_iscissors_tool_class_init (GimpIscissorsToolClass *klass)
 {
@@ -377,6 +437,8 @@ gimp_iscissors_tool_finalize (GObject *object)
   icurve_free (iscissors->curve);
   iscissors->curve = NULL;
 
+  magnetic_clear_live (iscissors);
+
   G_OBJECT_CLASS (parent_class)->finalize (object);
 }
 
@@ -425,9 +487,27 @@ gimp_iscissors_tool_button_press (GimpTool            *tool,
   if (display != tool->display)
     gimp_tool_control (tool, GIMP_TOOL_ACTION_HALT, display);
 
+  /*  ChopGimp: Lasso magnétique, a double-click closes and selects  */
+  if (iscissors->magnetic                        &&
+      press_type == GIMP_BUTTON_PRESS_DOUBLE     &&
+      display == tool->display                   &&
+      (iscissors->curve->closed ||
+       g_queue_get_length (iscissors->curve->segments) > 1))
+    {
+      gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+      magnetic_clear_live (iscissors);
+      gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+
+      gimp_tool_control (tool, GIMP_TOOL_ACTION_COMMIT, display);
+      return;
+    }
+
   gimp_tool_control_activate (tool->control);
   tool->display = display;
 
+  if (iscissors->magnetic)
+    magnetic_clear_live (iscissors);
+
   gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
 
   switch (iscissors->state)
@@ -677,6 +757,19 @@ gimp_iscissors_tool_button_release (GimpTool              *tool,
         }
     }
 
+  /*  ChopGimp: Lasso magnétique, Alt + click places a straight segment  */
+  if (iscissors->magnetic                       &&
+      release_type != GIMP_BUTTON_RELEASE_CANCEL &&
+      iscissors->state == SEED_PLACEMENT        &&
+      (state & GDK_MOD1_MASK)                   &&
+      ! iscissors->curve->first_point)
+    {
+      ISegment *tail = g_queue_peek_tail (iscissors->curve->segments);
+
+      if (tail && (tail->x1 != tail->x2 || tail->y1 != tail->y2))
+        isegment_make_straight (tail);
+    }
+
   if (iscissors->curve->first_point)
     iscissors->state = NO_ACTION;
   else
@@ -686,7 +779,15 @@ gimp_iscissors_tool_button_release (GimpTool              *tool,
 
   /*  convert the curves into a region  */
   if (iscissors->curve->closed)
-    iscissors_convert (iscissors, display);
+    {
+      iscissors_convert (iscissors, display);
+
+      /*  ChopGimp: the Lasso magnétique selects as soon as it is closed
+       *  (click on the start point), like Photoshop's
+       */
+      if (iscissors->magnetic && release_type != GIMP_BUTTON_RELEASE_CANCEL)
+        gimp_tool_control (tool, GIMP_TOOL_ACTION_COMMIT, display);
+    }
 }
 
 static void
@@ -803,6 +904,23 @@ gimp_iscissors_tool_draw (GimpDrawTool *draw_tool)
         }
     }
 
+  /*  ChopGimp: Lasso magnétique, the segment that follows the pointer  */
+  if (iscissors->magnetic && iscissors->live &&
+      iscissors->state == WAITING && ! iscissors->curve->closed)
+    {
+      if (iscissors->live->points && iscissors->live->points->len > 1)
+        item = iscissors_draw_segment (draw_tool, iscissors->live);
+      else
+        item = gimp_draw_tool_add_line (draw_tool,
+                                        iscissors->live->x1,
+                                        iscissors->live->y1,
+                                        iscissors->live->x2,
+                                        iscissors->live->y2);
+
+      if (item)
+        gimp_canvas_item_set_highlight (item, TRUE);
+    }
+
   /*  Then, render the handles on top of the segments  */
   for (list = g_queue_peek_head_link (iscissors->curve->segments);
        list;
@@ -993,6 +1111,37 @@ gimp_iscissors_tool_oper_update (GimpTool         *tool,
           break;
         }
     }
+
+  /*  ChopGimp: Lasso magnétique, follow the edge while the mouse moves  */
+  if (iscissors->magnetic && proximity)
+    {
+      if (iscissors->state == WAITING && display == tool->display &&
+          ! iscissors->curve->closed  && ! iscissors->curve->first_point &&
+          iscissors->op != ISCISSORS_OP_MOVE_POINT &&
+          iscissors->op != ISCISSORS_OP_REMOVE_POINT)
+        {
+          magnetic_update_live (iscissors, coords, state, display);
+
+          if (iscissors->op == ISCISSORS_OP_ADD_POINT)
+            gimp_tool_replace_status (tool, display,
+                                      "Suivez le bord ; clic : poser un point, "
+                                      "Retour arrière : retirer le dernier, "
+                                      "double-clic ou Entrée : fermer, "
+                                      "Alt : segment droit");
+        }
+      else if (iscissors->state == NO_ACTION)
+        {
+          gimp_tool_replace_status (tool, display,
+                                    "Cliquez sur un bord pour commencer "
+                                    "le lasso magnétique");
+        }
+    }
+  else if (iscissors->magnetic && iscissors->live)
+    {
+      gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+      magnetic_clear_live (iscissors);
+      gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+    }
 }
 
 static void
@@ -1048,7 +1197,7 @@ gimp_iscissors_tool_cursor_update (GimpTool         *tool,
     {
       gimp_tool_set_cursor (tool, display,
                             GIMP_CURSOR_MOUSE,
-                            GIMP_TOOL_CURSOR_ISCISSORS,
+                            gimp_tool_control_get_tool_cursor (tool->control),
                             modifier);
     }
   else
@@ -1068,6 +1217,18 @@ gimp_iscissors_tool_key_press (GimpTool    *tool,
   if (display != tool->display)
     return FALSE;
 
+  /*  ChopGimp: Lasso magnétique, the live segment is recomputed from
+   *  the new last point at the next motion
+   */
+  if (iscissors->magnetic && iscissors->live &&
+      (kevent->keyval == GDK_KEY_BackSpace ||
+       kevent->keyval == GDK_KEY_Escape))
+    {
+      gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+      magnetic_clear_live (iscissors);
+      gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+    }
+
   switch (kevent->keyval)
