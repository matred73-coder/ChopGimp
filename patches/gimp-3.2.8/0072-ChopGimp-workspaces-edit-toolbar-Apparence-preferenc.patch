+  { N_("Couleur d'accent :"), "accent-name", "windows-accent",
+    { "variante", "bleu", "cyan", "violet", "vert", "orange", "rouge", "rose", "jaune", NULL },
+    { N_("Celle de la variante"), N_("Bleu"), N_("Cyan"), N_("Violet"), N_("Vert"),
+      N_("Orange"), N_("Rouge"), N_("Rose"), N_("Jaune"), NULL } },
+  { N_("Densité :"), "density", "windows-density",
+    { "compact", "normal", "comfortable", NULL },
+    { N_("Compacte"), N_("Normale"), N_("Aérée"), NULL } },
+  { N_("Police de l'interface :"), "font", "windows-ui-font",
+    { "inter", "source", "system", NULL },
+    { N_("Inter"), N_("Source Sans 3"), N_("Police du système"), NULL } },
+  { N_("Taille de l'interface :"), "size", "windows-ui-size",
+    { "90", "100", "115", "130", NULL },
+    { N_("90 %"), N_("100 %"), N_("115 %"), N_("130 %"), NULL } },
+};
+
+static void
+chopgimp_prefs_appearance_changed (GtkComboBox *combo,
+                                   Gimp        *gimp)
+{
+  const ChopGimpAppearanceRow *row = g_object_get_data (G_OBJECT (combo), "chopgimp-row");
+  gint                          i   = gtk_combo_box_get_active (combo);
+  gchar                        *name;
+
+  if (i < 0)
+    return;
+
+  name = g_strdup_printf ("%s-%s", row->action_prefix, row->keys[i]);
+  g_action_group_activate_action (G_ACTION_GROUP (gimp->app), name,
+                                  g_variant_new_int32 (i));
+  g_free (name);
+}
+
+static void
+chopgimp_prefs_appearance (Gimp    *gimp,
+                           GtkGrid *grid)
+{
+  guint r;
+
+  for (r = 0; r < G_N_ELEMENTS (chopgimp_appearance_rows); r++)
+    {
+      const ChopGimpAppearanceRow *row   = &chopgimp_appearance_rows[r];
+      GtkWidget                   *combo = gtk_combo_box_text_new ();
+      gchar                       *value = chopgimp_rc_get_string ("appearance", row->rc_key, NULL);
+      gint                         i, active = (r == 2 || r == 4) ? 1 : 0;
+
+      for (i = 0; row->keys[i]; i++)
+        {
+          gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (combo), _(row->names[i]));
+          if (value && ! strcmp (value, row->keys[i]))
+            active = i;
+        }
+
+      gtk_combo_box_set_active (GTK_COMBO_BOX (combo), active);
+      g_object_set_data (G_OBJECT (combo), "chopgimp-row", (gpointer) row);
+      g_signal_connect (combo, "changed",
+                        G_CALLBACK (chopgimp_prefs_appearance_changed), gimp);
+
+      prefs_widget_add_aligned (combo, _(row->label), grid, r, FALSE, NULL);
+      g_free (value);
+    }
+}
