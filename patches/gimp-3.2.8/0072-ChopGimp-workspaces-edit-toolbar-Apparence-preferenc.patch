+
+/*  ChopGimp: open the preferences on a given page  */
+static gboolean
+prefs_box_select_help_id (GtkTreeModel *model,
+                          GtkTreePath  *path,
+                          GtkTreeIter  *iter,
+                          gpointer      data)
+{
+  GimpPrefsBox *box     = data;
+  gchar        *help_id = NULL;
+  gboolean      found;
+
+  gtk_tree_model_get (model, iter, COLUMN_PAGE_HELP_ID, &help_id, -1);
+
+  found = ! g_strcmp0 (help_id, g_object_get_data (G_OBJECT (box), "chopgimp-wanted"));
+
+  if (found)
+    {
+      GtkTreeView *view = GTK_TREE_VIEW (GET_PRIVATE (box)->tree_view);
+
+      gtk_tree_view_expand_to_path (view, path);
+      gtk_tree_selection_select_iter (gtk_tree_view_get_selection (view), iter);
+    }
+
+  g_free (help_id);
+
+  return found;
+}
+
+void
+gimp_prefs_box_set_current_help_id (GimpPrefsBox *box,
+                                    const gchar  *help_id)
+{
+  g_return_if_fail (GIMP_IS_PREFS_BOX (box));
+
+  g_object_set_data (G_OBJECT (box), "chopgimp-wanted", (gpointer) help_id);
+  gtk_tree_model_foreach (GTK_TREE_MODEL (GET_PRIVATE (box)->store),
+                          prefs_box_select_help_id, box);
+  g_object_set_data (G_OBJECT (box), "chopgimp-wanted", NULL);
+}
