+/*  ChopGimp: the column of panels shown again before a new arrangement  */
+static void
+chopgimp_show_all_panels (Gimp *gimp)
+{
+  GimpAction *hide;
+
+  hide = gimp_ui_manager_find_action (menus_get_image_manager_singleton (gimp),
+                                      "windows", "windows-hide-right-docks");
+  if (hide)
+    gimp_toggle_action_set_active (GIMP_TOGGLE_ACTION (hide), FALSE);
+
+  if (GIMP_GUI_CONFIG (gimp->config)->hide_docks)
+    g_object_set (gimp->config, "hide-docks", FALSE, NULL);
+}
+
+static GFile *
+chopgimp_personal_workspace_file (void)
+{
+  return gimp_directory_file ("chopgimp-workspace.sessionrc", NULL);
+}
+
+/*  ChopGimp: Fenêtres > Espace de travail  */
+void
+windows_workspace_cmd_callback (GimpAction *action,
+                                GVariant   *value,
+                                gpointer    data)
+{
+  static const gchar *names[] = { "essentiel", "photographie", "peinture",
+                                  "typographie", "illustration" };
+  Gimp  *gimp;
+  GList *windows;
+  GFile *file;
+  gint   w;
+  return_if_no_gimp (gimp, data);
+
+  w = g_variant_get_int32 (value);
+
+  if (w >= 0 && w < (gint) G_N_ELEMENTS (names))
+    {
+      gchar *name = g_strdup_printf ("%s.sessionrc", names[w]);
+
+      file = gimp_sysconf_directory_file ("workspaces", name, NULL);
+      g_free (name);
+    }
+  else
+    {
+      file = chopgimp_personal_workspace_file ();
+    }
+
+  if (! g_file_query_exists (file, NULL))
+    {
+      gimp_message_literal (gimp, NULL, GIMP_MESSAGE_WARNING,
+                            w < (gint) G_N_ELEMENTS (names) ?
+                            _("Espace de travail introuvable.") :
+                            _("Aucun espace de travail enregistré : utilisez d'abord "
+                              "« Enregistrer l'espace de travail »."));
+      g_object_unref (file);
+      return;
+    }
+
+  chopgimp_show_all_panels (gimp);
+
+  windows = gimp_get_image_windows (gimp);
+  if (windows)
+    gimp_image_window_restore_panels (windows->data, file);
+  g_list_free (windows);
+
+  g_object_unref (file);
+}
+
+void
+windows_workspace_save_cmd_callback (GimpAction *action,
+                                     GVariant   *value,
+                                     gpointer    data)
+{
+  Gimp             *gimp;
+  GFile            *file;
+  GimpConfigWriter *writer;
+  GError           *error = NULL;
+  return_if_no_gimp (gimp, data);
+
+  file   = chopgimp_personal_workspace_file ();
+  writer = gimp_config_writer_new_from_file (file, TRUE,
+                                             "ChopGimp — mon espace de travail",
+                                             &error);
+  if (writer)
+    {
+      gimp_dialog_factory_save (gimp_dialog_factory_get_singleton (), writer);
+      gimp_config_writer_finish (writer, "end of workspace", &error);
+    }
+
+  if (error)
+    {
+      gimp_message_literal (gimp, NULL, GIMP_MESSAGE_ERROR, error->message);
+      g_clear_error (&error);
+    }
+  else
+    {
+      gimp_message_literal (gimp, NULL, GIMP_MESSAGE_INFO,
+                            _("Espace de travail enregistré : Fenêtres > Espace de travail > "
+                              "Mon espace de travail."));
+    }
+
+  g_object_unref (file);
+}
+
+/*  ChopGimp: Photoshop « Edit Toolbar » = the Toolbox page of the
+ *  preferences (visible tools and their groups)
+ */
+void
+windows_edit_toolbar_cmd_callback (GimpAction *action,
+                                   GVariant   *value,
+                                   gpointer    data)
+{
+  Gimp      *gimp;
+  GtkWidget *dialog;
+  GtkWidget *prefs_box;
+  return_if_no_gimp (gimp, data);
+
+  dialog = gimp_dialog_factory_dialog_raise (gimp_dialog_factory_get_singleton (),
+                                             gdk_display_get_monitor (gdk_display_get_default (), 0),
+                                             NULL,
+                                             "gimp-preferences-dialog", -1);
+  if (! dialog)
+    return;
+
+  prefs_box = g_object_get_data (G_OBJECT (dialog), "prefs-box");
+  if (GIMP_IS_PREFS_BOX (prefs_box))
+    gimp_prefs_box_set_current_help_id (GIMP_PREFS_BOX (prefs_box),
+                                        GIMP_HELP_PREFS_TOOLBOX);
+}
