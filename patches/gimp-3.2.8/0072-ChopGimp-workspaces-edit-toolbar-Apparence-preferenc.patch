+/*  ChopGimp: tiles creating a document from a template in one click  */
+static const struct { const gchar *template; const gchar *label; const gchar *size; } chopgimp_presets[] =
+{
+  { "Défaut — Document par défaut 1920×1080",              N_("Par défaut"),  "1920 × 1080" },
+  { "Impression — A4 portrait",                              N_("A4"),          "300 ppp" },
+  { "Réseaux sociaux — Instagram publication 1080×1080",     N_("Instagram"),   "1080 × 1080" },
+  { "Réseaux sociaux — Instagram / TikTok story 1080×1920",  N_("Story"),       "1080 × 1920" },
+  { "Web — Bannière 1200×628",                               N_("Bannière"),    "1200 × 628" },
+  { "Vidéo — UHD 4K 3840×2160",                              N_("4K"),          "3840 × 2160" },
+  { "Illustration — Toile 4000×4000",                        N_("Toile"),       "4000 × 4000" },
+};
+
+static void
+chopgimp_welcome_preset_clicked (GtkButton *button,
+                                 GtkWidget *welcome_dialog)
+{
+  Gimp         *gimp     = g_object_get_data (G_OBJECT (button), "gimp");
+  GimpTemplate *template = g_object_get_data (G_OBJECT (button), "template");
+  GimpContext  *context  = gimp_get_user_context (gimp);
+  GimpImage    *image;
+
+  image = gimp_image_new_from_template (gimp, template, context);
+  gimp_create_display (gimp, image, gimp_template_get_unit (template), 1.0,
+                       G_OBJECT (gimp_widget_get_monitor (GTK_WIDGET (button))));
+  g_object_unref (image);
+
+  gtk_widget_destroy (welcome_dialog);
+}
+
+static void
+chopgimp_welcome_presets (Gimp      *gimp,
+                          GtkWidget *welcome_dialog,
+                          GtkWidget *main_vbox)
+{
+  GtkWidget *vbox = prefs_frame_new (_("Nouveau document"), GTK_CONTAINER (main_vbox), FALSE);
+  GtkWidget *flow = gtk_flow_box_new ();
+  guint      i;
+
+  gtk_flow_box_set_selection_mode (GTK_FLOW_BOX (flow), GTK_SELECTION_NONE);
+  gtk_flow_box_set_max_children_per_line (GTK_FLOW_BOX (flow), 7);
+  gtk_flow_box_set_homogeneous (GTK_FLOW_BOX (flow), TRUE);
+  gtk_box_pack_start (GTK_BOX (vbox), flow, FALSE, FALSE, 0);
+
+  for (i = 0; i < G_N_ELEMENTS (chopgimp_presets); i++)
+    {
+      GimpTemplate *template;
+      GtkWidget    *button, *box, *label;
+      gchar        *markup;
+
+      template = (GimpTemplate *)
+        gimp_container_get_child_by_name (gimp->templates, chopgimp_presets[i].template);
+      if (! template)
+        continue;
+
+      button = gtk_button_new ();
+      box    = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+      gtk_box_pack_start (GTK_BOX (box),
+                          gtk_image_new_from_icon_name ("document-new", GTK_ICON_SIZE_DND),
+                          FALSE, FALSE, 0);
+      label  = gtk_label_new (NULL);
+      markup = g_markup_printf_escaped ("<b>%s</b>\n<small>%s</small>",
+                                        _(chopgimp_presets[i].label),
+                                        chopgimp_presets[i].size);
+      gtk_label_set_markup (GTK_LABEL (label), markup);
+      gtk_label_set_justify (GTK_LABEL (label), GTK_JUSTIFY_CENTER);
+      g_free (markup);
+      gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+      gtk_container_add (GTK_CONTAINER (button), box);
+      gtk_widget_set_tooltip_text (button, chopgimp_presets[i].template);
+
+      g_object_set_data (G_OBJECT (button), "gimp", gimp);
+      g_object_set_data (G_OBJECT (button), "template", template);
+      g_signal_connect (button, "clicked",
+                        G_CALLBACK (chopgimp_welcome_preset_clicked), welcome_dialog);
+
+      gtk_container_add (GTK_CONTAINER (flow), button);
+    }
+
+  gtk_widget_show_all (flow);
+}
