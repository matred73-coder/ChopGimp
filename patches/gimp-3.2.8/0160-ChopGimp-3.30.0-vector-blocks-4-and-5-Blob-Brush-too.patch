+/*  ─── 3.30.0: Options de répétition ─────────────────────────────────── */
+
+gboolean
+chopgimp_repeat_options_dialog_show (GimpImage       *image,
+                                     GimpVectorLayer *layer,
+                                     gint             type,
+                                     GtkWidget       *parent)
+{
+  const gchar          *types[]  = { N_("Radiale"), N_("Grille"), N_("Miroir"), NULL };
+  const gchar          *flips[]  = { N_("Aucun"), N_("Horizontal"), N_("Vertical"), NULL };
+  const gchar          *tlabels[4], *flabels[4];
+  ChopGimpRepeatOptions o;
+  gboolean              exists, done = FALSE;
+  GtkWidget            *dialog, *vbox, *combo, *frow, *fcol;
+  GtkAdjustment        *count, *radius, *angle, *cols, *rows, *hgap, *vgap, *offset;
+
+  exists = chopgimp_vrepeat_get_options (layer, &o);
+
+  if (! exists)
+    {
+      if (! chopgimp_vrepeat_can_make (layer))
+        return FALSE;
+
+      chopgimp_vrepeat_default_options (CLAMP (type, 0, 2), 100, 100, &o);
+    }
+
+  for (gint i = 0; i < 3; i++)
+    {
+      tlabels[i] = _(types[i]);
+      flabels[i] = _(flips[i]);
+    }
+  tlabels[3] = flabels[3] = NULL;
+
+  dialog = new_dialog (_("Options de répétition"), "chopgimp-repeat-options", parent);
+  vbox   = content_box (dialog);
+
+  combo  = add_combo (vbox, _("Type :"), tlabels, o.type);
+
+  count  = add_scale (vbox, _("Radiale : nombre d'instances"), o.count, 2, 360, 0);
+  radius = add_scale (vbox, _("Radiale : rayon (px)"), o.radius, 0, 10000, 1);
+  angle  = add_scale (vbox, _("Angle (°) : radiale, axe du miroir"), o.angle, -360, 360, 1);
+  cols   = add_scale (vbox, _("Grille : colonnes"), o.cols, 1, 200, 0);
+  rows   = add_scale (vbox, _("Grille : rangées"), o.rows, 1, 200, 0);
+  hgap   = add_scale (vbox, _("Grille : espacement horizontal (px)"), o.hgap, -1000, 10000, 1);
+  vgap   = add_scale (vbox, _("Grille : espacement vertical (px)"), o.vgap, -1000, 10000, 1);
+  frow   = add_combo (vbox, _("Grille : retourner une rangée sur deux :"), flabels, o.flip_row);
+  fcol   = add_combo (vbox, _("Grille : retourner une colonne sur deux :"), flabels, o.flip_col);
+  offset = add_scale (vbox, _("Miroir : distance de l'axe (px)"), o.offset, -10000, 10000, 1);
+
+  gtk_widget_show_all (vbox);
+
+  if (gimp_dialog_run (GIMP_DIALOG (dialog)) == GTK_RESPONSE_OK)
+    {
+      o.type     = gtk_combo_box_get_active (GTK_COMBO_BOX (combo));
+      o.count    = (gint) gtk_adjustment_get_value (count);
+      o.radius   = gtk_adjustment_get_value (radius);
+      o.angle    = gtk_adjustment_get_value (angle);
+      o.cols     = (gint) gtk_adjustment_get_value (cols);
+      o.rows     = (gint) gtk_adjustment_get_value (rows);
+      o.hgap     = gtk_adjustment_get_value (hgap);
+      o.vgap     = gtk_adjustment_get_value (vgap);
+      o.flip_row = gtk_combo_box_get_active (GTK_COMBO_BOX (frow));
+      o.flip_col = gtk_combo_box_get_active (GTK_COMBO_BOX (fcol));
+      o.offset   = gtk_adjustment_get_value (offset);
+
+      if (exists)
+        done = chopgimp_vrepeat_set_options (layer, &o);
+      else
+        done = chopgimp_vrepeat_make (layer, o.type, &o) != NULL;
+    }
+
+  gtk_widget_destroy (dialog);
+
+  if (done)
+    gimp_image_flush (image);
+
+  return done;
+}
+
+
+/*  ─── 3.30.0: Options de la forme de pinceau ────────────────────────── */
+
+gboolean
+chopgimp_brush_options_dialog_show (GimpImage       *image,
+                                    GimpVectorLayer *layer,
+                                    GtkWidget       *parent)
+{
+  const gchar          *types[] = { N_("Calligraphique"), N_("Art"), N_("Motif"),
+                                    N_("Dispersion"), NULL };
+  const gchar          *tlabels[5];
+  ChopGimpVBrushOptions o;
+  gboolean              done = FALSE;
+  GtkWidget            *dialog, *vbox, *combo, *follow, *flip, *tint, *defined;
+  GtkAdjustment        *angle, *roundness, *size, *spacing, *scatter, *rotation, *sizevar, *seed;
+
+  if (! chopgimp_vbrush_can_apply (layer))
+    return FALSE;
+
+  if (! chopgimp_vbrush_get_options (layer, &o))
+    chopgimp_vbrush_default_options (CHOPGIMP_VBRUSH_CALLIGRAPHIC, &o);
+
+  for (gint i = 0; i < 4; i++)
+    tlabels[i] = _(types[i]);
+  tlabels[4] = NULL;
+
+  dialog = new_dialog (_("Options de la forme de pinceau"), "chopgimp-brush-options", parent);
+  vbox   = content_box (dialog);
+
+  combo    = add_combo (vbox, _("Forme :"), tlabels, o.type);
+  angle    = add_scale (vbox, _("Calligraphique : angle (°)"), o.angle, -180, 180, 0);
+  roundness = add_scale (vbox, _("Calligraphique : arrondi (%)"), o.roundness, 1, 100, 0);
+  size     = add_scale (vbox, _("Taille (calligraphique : px, 0 = épaisseur du contour ; "
+                                "autres : %)"), o.size, 0, 2000, 1);
+  spacing  = add_scale (vbox, _("Espacement (motif : px ; dispersion : %)"),
+                        o.spacing, -100, 1000, 1);
+  scatter  = add_scale (vbox, _("Dispersion : écart (%)"), o.scatter, 0, 1000, 0);
+  rotation = add_scale (vbox, _("Dispersion : rotation aléatoire (°)"), o.rotation, 0, 180, 0);
+  sizevar  = add_scale (vbox, _("Dispersion : variation de taille (%)"), o.size_var, 0, 100, 0);
+  seed     = add_scale (vbox, _("Dispersion : tirage"), o.seed, 0, 9999, 0);
+
+  follow = gtk_check_button_new_with_label (_("Dispersion : tourner le long du tracé"));
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (follow), o.follow);
+  gtk_box_pack_start (GTK_BOX (vbox), follow, FALSE, FALSE, 0);
+
+  flip = gtk_check_button_new_with_label (_("Art et motif : retourner en travers du tracé"));
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (flip), o.flip);
+  gtk_box_pack_start (GTK_BOX (vbox), flip, FALSE, FALSE, 0);
+
+  tint = gtk_check_button_new_with_label (_("Teintes : l'illustration prend la couleur du contour"));
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (tint), o.colorize);
+  gtk_box_pack_start (GTK_BOX (vbox), tint, FALSE, FALSE, 0);
+
+  defined = gtk_check_button_new_with_label (_("Utiliser l'illustration définie "
+                                               "(Définir l'illustration)"));
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (defined), FALSE);
+  gtk_widget_set_sensitive (defined, chopgimp_vbrush_has_defined ());
+  gtk_box_pack_start (GTK_BOX (vbox), defined, FALSE, FALSE, 0);
+
+  gtk_widget_show_all (vbox);
+
+  if (gimp_dialog_run (GIMP_DIALOG (dialog)) == GTK_RESPONSE_OK)
+    {
+      o.type        = gtk_combo_box_get_active (GTK_COMBO_BOX (combo));
+      o.angle       = gtk_adjustment_get_value (angle);
+      o.roundness   = gtk_adjustment_get_value (roundness);
+      o.size        = gtk_adjustment_get_value (size);
+      o.spacing     = gtk_adjustment_get_value (spacing);
+      o.scatter     = gtk_adjustment_get_value (scatter);
+      o.rotation    = gtk_adjustment_get_value (rotation);
+      o.size_var    = gtk_adjustment_get_value (sizevar);
+      o.seed        = (gint) gtk_adjustment_get_value (seed);
+      o.follow      = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (follow));
+      o.flip        = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (flip));
+      o.colorize    = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (tint));
+      o.use_defined = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (defined));
+
+      done = chopgimp_vbrush_apply (layer, &o);
+    }
+
+  gtk_widget_destroy (dialog);
+
+  if (done)
+    gimp_image_flush (image);
+
+  return done;
+}
