diff --git a/app/path/chopgimp-vrepeat.c b/app/path/chopgimp-vrepeat.c
new file mode 100644
index 0000000..58f87a1
--- /dev/null
+++ b/app/path/chopgimp-vrepeat.c
@@ -0,0 +1,814 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vrepeat.c — ChopGimp 3.30.0: « Répétition » (radial, grid,
+ * mirror), see chopgimp-vrepeat.h. Built like the Transition of
+ * chopgimp-vmaterial.c: a group with a spec, generated children made
+ * again from the change hook when their signature changes.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <gegl.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+
+#include "path-types.h"
+
+#include "core/gimpimage.h"
+#include "core/gimpitem.h"
+
+#include "gimppath.h"
+#include "gimpstroke.h"
+#include "gimpvectorlayer.h"
+#include "chopgimp-vobject.h"
+#include "chopgimp-vrepeat.h"
+
+#include "gimp-intl.h"
+
+
+#define INSTANCE "rinst"
+
+
+gboolean
+chopgimp_vrepeat_enabled (void)
+{
+  static gint enabled = -1;
+
+  if (enabled < 0)
+    enabled = (g_getenv ("CHOPGIMP_NO_REPEAT") == NULL);
+
+  return enabled;
+}
+
+
+/*  ─── helpers ───────────────────────────────────────────────────────── */
+
+static void
+put_dbl (GString     *s,
+         const gchar *key,
+         gdouble      v)
+{
+  gchar buf[G_ASCII_DTOSTR_BUF_SIZE];
+
+  g_string_append_printf (s, " %s=%s", key,
+                          g_ascii_formatd (buf, sizeof (buf), "%.6g", v));
+}
+
+static gchar *
+spec_word (const gchar *spec,
+           const gchar *key)
+{
+  gchar **words = g_strsplit (spec ? spec : "", " ", -1);
+  gchar  *value = NULL;
+  gsize   len   = strlen (key);
+
+  for (gint i = 0; words[i] && ! value; i++)
+    if (! strncmp (words[i], key, len) && words[i][len] == '=')
+      value = g_strdup (words[i] + len + 1);
+
+  g_strfreev (words);
+
+  return value;
+}
+
+static gdouble
+spec_dbl (const gchar *spec,
+          const gchar *key,
+          gdouble      def)
+{
+  gchar   *v = spec_word (spec, key);
+  gdouble  d = v ? g_ascii_strtod (v, NULL) : def;
+
+  g_free (v);
+
+  return isfinite (d) ? d : def;
+}
+
+/*  the spec without its signature (what the signature covers)  */
+static gchar *
+spec_body (const gchar *spec)
+{
+  gchar  **words = g_strsplit (spec ? spec : "", " ", -1);
+  GString *s     = g_string_new (NULL);
+
+  for (gint i = 0; words[i]; i++)
+    if (strncmp (words[i], "sig=", 4))
+      {
+        if (s->len)
+          g_string_append_c (s, ' ');
+        g_string_append (s, words[i]);
+      }
+
+  g_strfreev (words);
+
+  return g_string_free (s, FALSE);
+}
+
+static gboolean
+is_repeat_group (ChopGimpVObject *o)
+{
+  return o->kind == CHOPGIMP_VOBJECT_GROUP && o->blend &&
+         g_str_has_prefix (o->blend, "repeat");
+}
+
+static gboolean
+is_instance (ChopGimpVObject *o)
+{
+  return o->blend && ! strcmp (o->blend, INSTANCE);
+}
+
+ChopGimpVObject *
+chopgimp_vrepeat_group_of (ChopGimpVObject *object)
+{
+  for (ChopGimpVObject *o = object; o; o = o->parent)
+    if (is_repeat_group (o))
+      return o;
+
+  return NULL;
+}
+
+static ChopGimpVObject *
+group_of_selection (GimpVectorLayer *layer)
+{
+  GList           *sel = chopgimp_vlayer_get_selected_objects (layer);
+  ChopGimpVObject *g   = NULL;
+
+  for (GList *l = sel; l && ! g; l = l->next)
+    g = chopgimp_vrepeat_group_of (l->data);
+
+  g_list_free (sel);
+
+  return g;
+}
+
+/*  the selected objects with a common parent, bottom → top (g_list_free)  */
+static GList *
+selected_siblings (GimpVectorLayer *layer)
+{
+  GList           *sel    = chopgimp_vlayer_get_selected_objects (layer);
+  ChopGimpVObject *parent = NULL;
+  GList           *list   = NULL;
+
+  for (GList *l = sel; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      if (! list)
+        parent = o->parent;
+      else if (o->parent != parent)
+        {
+          g_list_free (sel);
+          g_list_free (list);
+          return NULL;
+        }
+
+      list = g_list_append (list, o);
+    }
+
+  g_list_free (sel);
+
+  if (list && parent)
+    {
+      GList *sorted = NULL;
+
+      for (guint i = 0; i < parent->children->len; i++)
+        if (g_list_find (list, g_ptr_array_index (parent->children, i)))
+          sorted = g_list_append (sorted, g_ptr_array_index (parent->children, i));
+
+      g_list_free (list);
+      list = sorted;
+    }
+
+  return list;
+}
+
+/*  the path of @o in the local space of the group @g (floating)  */
+static GimpPath *
+path_in (GimpVectorLayer *layer,
+         ChopGimpVObject *o,
+         ChopGimpVObject *g)
+{
+  GimpPath    *wp = chopgimp_vobject_get_world_path (layer, o, TRUE);
+  GimpMatrix3  inv;
+
+  if (! wp)
+    return NULL;
+
+  chopgimp_vobject_get_world_matrix (g, &inv);
+  gimp_matrix3_invert (&inv);
+  chopgimp_vpath_transform (wp, &inv);
+
+  return wp;
+}
+
+/*  the box of the curves of @path (interpolated); FALSE when empty  */
+static gboolean
+path_box (GimpPath *path,
+          gdouble   b[4])
+{
+  GimpStroke *stroke = NULL;
+  gboolean    any    = FALSE;
+
+  while ((stroke = gimp_path_stroke_get_next (path, stroke)))
+    {
+      gboolean  closed;
+      GArray   *pts = gimp_stroke_interpolate (stroke, 0.5, &closed);
+
+      for (guint i = 0; pts && i < pts->len; i++)
+        {
+          GimpCoords *c = &g_array_index (pts, GimpCoords, i);
+
+          if (! any)
+            {
+              b[0] = b[2] = c->x;
+              b[1] = b[3] = c->y;
+              any = TRUE;
+            }
+          else
+            {
+              b[0] = MIN (b[0], c->x);
+              b[1] = MIN (b[1], c->y);
+              b[2] = MAX (b[2], c->x);
+              b[3] = MAX (b[3], c->y);
+            }
+        }
+
+      if (pts)
+        g_array_unref (pts);
+    }
+
+  return any;
+}
+
+static gboolean
+source_box (GimpVectorLayer *layer,
+            ChopGimpVObject *src,
+            ChopGimpVObject *g,
+            gdouble          b[4])
+{
+  GimpPath *p = path_in (layer, src, g);
+  gboolean  ok;
+
+  if (! p)
+    return FALSE;
+
+  g_object_ref_sink (p);
+  ok = path_box (p, b);
+  g_object_unref (p);
+
+  return ok;
+}
+
+/*  a copy is a snapshot: the dynamic specs of the groups inside it are
+ *  dropped (their generated parts stay, locked)
+ */
+static void
+strip_specs (ChopGimpVObject *o)
+{
+  if (o->kind == CHOPGIMP_VOBJECT_GROUP && o->blend &&
+      (g_str_has_prefix (o->blend, "blend") || g_str_has_prefix (o->blend, "repeat") ||
+       g_str_has_prefix (o->blend, "brush")))
+    g_clear_pointer (&o->blend, g_free);
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      strip_specs (g_ptr_array_index (o->children, i));
+}
+
+
+/*  ─── options ⇄ spec ────────────────────────────────────────────────── */
+
+void
+chopgimp_vrepeat_default_options (ChopGimpRepeatType     type,
+                                  gdouble                width,
+                                  gdouble                height,
+                                  ChopGimpRepeatOptions *o)
+{
+  gdouble size = MAX (MAX (width, height), 1.0);
+
+  memset (o, 0, sizeof (*o));
+
+  o->type     = type;
+  o->count    = 8;
+  o->radius   = size * 1.5;
+  o->angle    = (type == CHOPGIMP_REPEAT_MIRROR) ? 90.0 : -90.0;
+  o->cols     = 3;
+  o->rows     = 3;
+  o->hgap     = MAX (width, 1.0) * 0.25;
+  o->vgap     = MAX (height, 1.0) * 0.25;
+  o->flip_row = 0;
+  o->flip_col = 0;
+  o->offset   = MAX (width, 1.0) / 2.0 + MAX (10.0, width * 0.1);
+}
+
+static void
+options_sanitize (ChopGimpRepeatOptions *o)
+{
+  o->type     = CLAMP (o->type, CHOPGIMP_REPEAT_RADIAL, CHOPGIMP_REPEAT_MIRROR);
+  o->count    = CLAMP (o->count, 2, 360);
+  o->radius   = CLAMP (o->radius, 0.0, 100000.0);
+  o->cols     = CLAMP (o->cols, 1, 200);
+  o->rows     = CLAMP (o->rows, 1, 200);
+  o->hgap     = CLAMP (o->hgap, -10000.0, 100000.0);
+  o->vgap     = CLAMP (o->vgap, -10000.0, 100000.0);
+  o->flip_row = CLAMP (o->flip_row, 0, 2);
+  o->flip_col = CLAMP (o->flip_col, 0, 2);
+}
+
+static void
+spec_get (const gchar           *spec,
+          ChopGimpRepeatOptions *o)
+{
+  gchar *type = spec_word (spec, "type");
+
+  chopgimp_vrepeat_default_options (CHOPGIMP_REPEAT_RADIAL, 100, 100, o);
+
+  if (! g_strcmp0 (type, "grid"))
+    o->type = CHOPGIMP_REPEAT_GRID;
+  else if (! g_strcmp0 (type, "mirror"))
+    o->type = CHOPGIMP_REPEAT_MIRROR;
+
+  g_free (type);
+
+  o->count    = (gint) spec_dbl (spec, "n", o->count);
+  o->radius   = spec_dbl (spec, "r", o->radius);
+  o->angle    = spec_dbl (spec, "a", o->type == CHOPGIMP_REPEAT_MIRROR ? 90.0 : -90.0);
+  o->cols     = (gint) spec_dbl (spec, "cols", o->cols);
+  o->rows     = (gint) spec_dbl (spec, "rows", o->rows);
+  o->hgap     = spec_dbl (spec, "hgap", o->hgap);
+  o->vgap     = spec_dbl (spec, "vgap", o->vgap);
+  o->flip_row = (gint) spec_dbl (spec, "frow", 0);
+  o->flip_col = (gint) spec_dbl (spec, "fcol", 0);
+  o->offset   = spec_dbl (spec, "off", o->offset);
+
+  options_sanitize (o);
+}
+
+static void
+spec_set (ChopGimpVObject             *g,
+          const ChopGimpRepeatOptions *opts,
+          const gchar                 *sig)
+{
+  ChopGimpRepeatOptions o = *opts;
+  GString              *s = g_string_new ("repeat");
+
+  options_sanitize (&o);
+
+  switch (o.type)
+    {
+    case CHOPGIMP_REPEAT_RADIAL:
+      g_string_append (s, " type=radial");
+      g_string_append_printf (s, " n=%d", o.count);
+      put_dbl (s, "r", o.radius);
+      put_dbl (s, "a", o.angle);
+      break;
+
+    case CHOPGIMP_REPEAT_GRID:
+      g_string_append (s, " type=grid");
+      g_string_append_printf (s, " cols=%d rows=%d", o.cols, o.rows);
+      put_dbl (s, "hgap", o.hgap);
+      put_dbl (s, "vgap", o.vgap);
+      g_string_append_printf (s, " frow=%d fcol=%d", o.flip_row, o.flip_col);
+      break;
+
+    case CHOPGIMP_REPEAT_MIRROR:
+      g_string_append (s, " type=mirror");
+      put_dbl (s, "a", o.angle);
+      put_dbl (s, "off", o.offset);
+      break;
+    }
+
+  if (sig)
+    g_string_append_printf (s, " sig=%s", sig);
+
+  g_free (g->blend);
+  g->blend = g_string_free (s, FALSE);
+}
+
+
+/*  ─── the instances ─────────────────────────────────────────────────── */
+
+/*  M = T(c) · F · T(-c), F: a flip (1: horizontal, 2: vertical)  */
+static void
+flip_about (GimpMatrix3 *m,
+            gint         flip,
+            gdouble      cx,
+            gdouble      cy)
+{
+  if (! flip)
+    return;
+
+  gimp_matrix3_translate (m, -cx, -cy);
+  gimp_matrix3_scale (m, flip == 1 ? -1.0 : 1.0, flip == 2 ? -1.0 : 1.0);
+  gimp_matrix3_translate (m, cx, cy);
+}
+
+/*  the transformations (group space) of the instances, source excluded  */
+static GArray *
+instance_matrices (const ChopGimpRepeatOptions *o,
+                   const gdouble                b[4])
+{
+  GArray  *a  = g_array_new (FALSE, FALSE, sizeof (GimpMatrix3));
+  gdouble  cx = (b[0] + b[2]) / 2.0;
+  gdouble  cy = (b[1] + b[3]) / 2.0;
+  gdouble  w  = b[2] - b[0];
+  gdouble  h  = b[3] - b[1];
+
+  switch (o->type)
+    {
+    case CHOPGIMP_REPEAT_RADIAL:
+      {
+        gdouble ar = o->angle * G_PI / 180.0;
+        gdouble ox = cx - o->radius * cos (ar);
+        gdouble oy = cy - o->radius * sin (ar);
+
+        for (gint k = 1; k < o->count; k++)
+          {
+            GimpMatrix3 m;
+
+            gimp_matrix3_identity (&m);
+            gimp_matrix3_translate (&m, -ox, -oy);
+            gimp_matrix3_rotate (&m, 2.0 * G_PI * k / o->count);
+            gimp_matrix3_translate (&m, ox, oy);
+            g_array_append_val (a, m);
+          }
+      }
+      break;
+
+    case CHOPGIMP_REPEAT_GRID:
+      for (gint j = 0; j < o->rows; j++)
+        for (gint i = 0; i < o->cols; i++)
+          {
+            GimpMatrix3 m;
+
+            if (i == 0 && j == 0)
+              continue;
+
+            gimp_matrix3_identity (&m);
+            if (j % 2)
+              flip_about (&m, o->flip_row, cx, cy);
+            if (i % 2)
+              flip_about (&m, o->flip_col, cx, cy);
+            gimp_matrix3_translate (&m, i * (w + o->hgap), j * (h + o->vgap));
+            g_array_append_val (a, m);
+          }
+      break;
+
+    case CHOPGIMP_REPEAT_MIRROR:
+      {
+        gdouble     ar = o->angle * G_PI / 180.0;
+        gdouble     ax = cx + o->offset * cos (ar - G_PI / 2.0);
+        gdouble     ay = cy + o->offset * sin (ar - G_PI / 2.0);
+        GimpMatrix3 m;
+
+        gimp_matrix3_identity (&m);
+        gimp_matrix3_translate (&m, -ax, -ay);
+        gimp_matrix3_rotate (&m, -ar);
+        gimp_matrix3_scale (&m, 1.0, -1.0);
+        gimp_matrix3_rotate (&m, ar);
+        gimp_matrix3_translate (&m, ax, ay);
+        g_array_append_val (a, m);
+      }
+      break;
+    }
+
+  return a;
+}
+
+static gchar *
+signature (ChopGimpVObject *g,
+           ChopGimpVObject *src)
+{
+  GList   *one  = g_list_prepend (NULL, src);
+  gchar   *xml  = chopgimp_vobjects_to_xml (one);
+  gchar   *body = spec_body (g->blend);
+  gchar   *all  = g_strconcat (body, "\n", xml, NULL);
+  gchar   *sig  = g_compute_checksum_for_string (G_CHECKSUM_MD5, all, -1);
+
+  g_free (all);
+  g_free (body);
+  g_free (xml);
+  g_list_free (one);
+
+  return sig;
+}
+
+static gboolean
+repeat_regen (GimpVectorLayer *layer,
+              ChopGimpVObject *g,
+              gboolean         force)
+{
+  GimpImage            *image = gimp_item_get_image (GIMP_ITEM (layer));
+  ChopGimpVObject      *src   = NULL;
+  ChopGimpRepeatOptions opts;
+  GPtrArray            *made;
+  gchar                *sig, *old;
+  gdouble               b[4];
+
+  for (guint i = 0; i < g->children->len && ! src; i++)
+    if (! is_instance (g_ptr_array_index (g->children, i)))
+      src = g_ptr_array_index (g->children, i);
+
+  if (! src)
+    return FALSE;
+
+  spec_get (g->blend, &opts);
+
+  sig = signature (g, src);
+  old = spec_word (g->blend, "sig");
+
+  if (! force && ! g_strcmp0 (sig, old))
+    {
+      g_free (sig);
+      g_free (old);
+      return FALSE;
+    }
+
+  g_free (old);
+
+  made = g_ptr_array_new ();
+  g_ptr_array_add (made, chopgimp_vobject_ref (src));
+
+  if (source_box (layer, src, g, b))
+    {
+      GArray *ms = instance_matrices (&opts, b);
+
+      for (guint k = 0; k < ms->len; k++)
+        {
+          ChopGimpVObject *c    = chopgimp_vobject_copy (src, image);
+          gchar           *name = g_strdup_printf (_("Instance %d"), k + 2);
+
+          strip_specs (c);
+          g_free (c->blend);
+          c->blend  = g_strdup (INSTANCE);
+          c->locked = TRUE;
+          g_free (c->name);
+          c->name   = name;
+          gimp_matrix3_mult (&g_array_index (ms, GimpMatrix3, k), &c->transform);
+
+          g_ptr_array_add (made, c);
+        }
+
+      g_array_free (ms, TRUE);
+    }
+
+  for (guint i = 0; i < g->children->len; i++)
+    ((ChopGimpVObject *) g_ptr_array_index (g->children, i))->parent = NULL;
+
+  g_ptr_array_set_size (g->children, 0);
+
+  for (guint i = 0; i < made->len; i++)
+    {
+      ChopGimpVObject *o = g_ptr_array_index (made, i);
+
+      o->parent = g;
+      g_ptr_array_add (g->children, o);
+    }
+
+  g_ptr_array_free (made, TRUE);
+
+  /*  the signature of what was just made (the spec without it is the same)  */
+  spec_set (g, &opts, sig);
+  g_free (sig);
+
+  return TRUE;
+}
+
+static void
+collect_repeats (ChopGimpVObject  *o,
+                 GList           **list)
+{
+  if (o->kind != CHOPGIMP_VOBJECT_GROUP)
+    return;
+
+  if (is_repeat_group (o))
+    *list = g_list_prepend (*list, o);
+
+  for (guint i = 0; i < o->children->len; i++)
+    collect_repeats (g_ptr_array_index (o->children, i), list);
+}
+
+gboolean
+chopgimp_vrepeat_refresh (GimpVectorLayer *layer)
+{
+  ChopGimpVObject *root;
+  GList           *groups = NULL;
+  gboolean         any    = FALSE;
+
+  if (! chopgimp_vrepeat_enabled () || ! (root = chopgimp_vlayer_get_root (layer)))
+    return FALSE;
+
+  /*  innermost first (prepended in depth-first order): a repeat inside
+   *  the source of another one is made before it is copied
+   */
+  collect_repeats (root, &groups);
+
+  for (GList *l = groups; l; l = l->next)
+    any |= repeat_regen (layer, l->data, FALSE);
+
+  g_list_free (groups);
+
+  return any;
+}
+
+
+/*  ─── commands ──────────────────────────────────────────────────────── */
+
+gboolean
+chopgimp_vrepeat_can_make (GimpVectorLayer *layer)
+{
+  GList   *list;
+  gboolean ok;
+
+  if (! chopgimp_vrepeat_enabled () || ! layer || ! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  list = selected_siblings (layer);
+  ok   = list != NULL;
+
+  for (GList *l = list; l; l = l->next)
+    if (chopgimp_vrepeat_group_of (l->data) || chopgimp_vobject_is_locked (l->data))
+      ok = FALSE;
+
+  g_list_free (list);
+
+  return ok;
+}
+
+ChopGimpVObject *
+chopgimp_vrepeat_make (GimpVectorLayer             *layer,
+                       ChopGimpRepeatType           type,
+                       const ChopGimpRepeatOptions *options)
+{
+  GList                *list;
+  GArray               *ids;
+  ChopGimpVObject      *src, *g = NULL;
+  ChopGimpRepeatOptions opts;
+  static const gchar   *names[] = { N_("Répétition radiale"), N_("Répétition en grille"),
+                                    N_("Répétition miroir") };
+
+  if (! chopgimp_vrepeat_can_make (layer))
+    return NULL;
+
+  list = selected_siblings (layer);
+  ids  = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  for (GList *l = list; l; l = l->next)
+    g_array_append_val (ids, ((ChopGimpVObject *) l->data)->id);
+
+  g_list_free (list);
+
+  chopgimp_vlayer_push_undo (layer, _("Créer une répétition"));
+  chopgimp_vlayer_freeze (layer);
+
+  src = (ids->len == 1) ? chopgimp_vlayer_get_object (layer, g_array_index (ids, guint, 0))
+                        : chopgimp_vlayer_group (layer, (guint *) ids->data, ids->len,
+                                                 _("Source"), FALSE);
+
+  if (src)
+    g = chopgimp_vlayer_group (layer, &src->id, 1,
+                               _(names[CLAMP (type, 0, 2)]), FALSE);
+
+  if (g)
+    {
+      gdouble b[4] = { 0, 0, 100, 100 };
+
+      if (options)
+        {
+          opts = *options;
+        }
+      else
+        {
+          source_box (layer, src, g, b);
+          chopgimp_vrepeat_default_options (type, b[2] - b[0], b[3] - b[1], &opts);
+        }
+
+      opts.type = type;
+      spec_set (g, &opts, NULL);
+      repeat_regen (layer, g, TRUE);
+      chopgimp_vlayer_subtree_changed (layer, g, NULL);
+      chopgimp_vlayer_set_selection (layer, &g->id, 1);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_array_free (ids, TRUE);
+
+  return g;
+}
+
+gboolean
+chopgimp_vrepeat_any (GimpVectorLayer *layer)
+{
+  return layer && chopgimp_vrepeat_enabled () && chopgimp_vlayer_get_root (layer) &&
+         group_of_selection (layer) != NULL;
+}
+
+gboolean
+chopgimp_vrepeat_get_options (GimpVectorLayer       *layer,
+                              ChopGimpRepeatOptions *options)
+{
+  ChopGimpVObject *g = chopgimp_vrepeat_any (layer) ? group_of_selection (layer) : NULL;
+
+  if (! g)
+    return FALSE;
+
+  spec_get (g->blend, options);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vrepeat_set_options (GimpVectorLayer             *layer,
+                              const ChopGimpRepeatOptions *options)
+{
+  ChopGimpVObject *g = chopgimp_vrepeat_any (layer) ? group_of_selection (layer) : NULL;
+
+  if (! g)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Options de répétition"));
+  spec_set (g, options, NULL);
+  repeat_regen (layer, g, TRUE);
+  chopgimp_vlayer_subtree_changed (layer, g, NULL);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vrepeat_release (GimpVectorLayer *layer)
+{
+  ChopGimpVObject *g = chopgimp_vrepeat_any (layer) ? group_of_selection (layer) : NULL;
+  GPtrArray       *keep;
+  guint            gid;
+
+  if (! g)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Libérer la répétition"));
+  chopgimp_vlayer_freeze (layer);
+
+  keep = g_ptr_array_new ();
+
+  for (guint i = 0; i < g->children->len; i++)
+    {
+      ChopGimpVObject *c = g_ptr_array_index (g->children, i);
+
+      if (is_instance (c))
+        c->parent = NULL;
+      else
+        g_ptr_array_add (keep, chopgimp_vobject_ref (c));
+    }
+
+  g_ptr_array_set_size (g->children, 0);
+
+  for (guint i = 0; i < keep->len; i++)
+    g_ptr_array_add (g->children, g_ptr_array_index (keep, i));
+
+  g_ptr_array_free (keep, TRUE);
+  g_clear_pointer (&g->blend, g_free);
+  gid = g->id;
+
+  chopgimp_vlayer_subtree_changed (layer, g, NULL);
+  /*  the source takes the place of the repeat  */
+  chopgimp_vlayer_ungroup (layer, gid, FALSE);
+
+  chopgimp_vlayer_thaw (layer);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vrepeat_expand (GimpVectorLayer *layer)
+{
+  ChopGimpVObject *g = chopgimp_vrepeat_any (layer) ? group_of_selection (layer) : NULL;
+
+  if (! g)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Décomposer la répétition"));
+
+  for (guint i = 0; i < g->children->len; i++)
+    {
+      ChopGimpVObject *c = g_ptr_array_index (g->children, i);
+
+      if (is_instance (c))
+        {
+          g_clear_pointer (&c->blend, g_free);
+          c->locked = FALSE;
+        }
+    }
+
+  g_clear_pointer (&g->blend, g_free);
+  chopgimp_vlayer_subtree_changed (layer, g, NULL);
+
+  return TRUE;
+}
diff --git a/app/path/chopgimp-vrepeat.h b/app/path/chopgimp-vrepeat.h
new file mode 100644
index 0000000..e9777a6
--- /dev/null
+++ b/app/path/chopgimp-vrepeat.h
@@ -0,0 +1,99 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vrepeat.h — ChopGimp 3.30.0 (bloc vectoriel 5): « Répétition »
+ * (Illustrator's Object > Repeat: radial, grid, mirror)
+ *
+ * A repeat is a group object of a vector layer whose spec, kept in its
+ * « blend » field (the dynamic objects' field, like the Transition), is
+ * « repeat type=radial|grid|mirror … sig=S ». Its first child is the
+ * source (the repeated object, editable: enter the group), the others
+ * are its instances (blend « rinst », locked), copies of the source with
+ * their own transformation. When the source or the options change, the
+ * instances are made again (objects' change hook, as the Transition):
+ * the repeat stays modifiable. Saved in the XCF and exported to SVG as
+ * plain groups (the spec in chopgimp:dynamic).
+ *
+ *  - radial: @count instances turned around a centre at @radius px from
+ *    the source's centre, in the direction @angle + 180° (the source is
+ *    at @angle, -90 = above the centre);
+ *  - grid: @cols × @rows cells, @hgap / @vgap px between the boxes; every
+ *    other row / column can be flipped (1 horizontally, 2 vertically);
+ *  - mirror: one instance, the source flipped across an axis at @angle
+ *    degrees (90: vertical) and @offset px from the source's centre.
+ *
+ * CHOPGIMP_NO_REPEAT=1: no new repeats, the existing ones stay as they
+ * are (plain groups).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "chopgimp-vobject.h"
+
+G_BEGIN_DECLS
+
+
+typedef enum
+{
+  CHOPGIMP_REPEAT_RADIAL,
+  CHOPGIMP_REPEAT_GRID,
+  CHOPGIMP_REPEAT_MIRROR
+} ChopGimpRepeatType;
+
+typedef struct
+{
+  ChopGimpRepeatType type;
+  gint               count;      /* RADIAL: instances, source included (2..360) */
+  gdouble            radius;     /* RADIAL: px                                  */
+  gdouble            angle;      /* RADIAL: source direction; MIRROR: axis (deg) */
+  gint               cols, rows; /* GRID (1..200)                               */
+  gdouble            hgap, vgap; /* GRID: px between the boxes                  */
+  gint               flip_row;   /* GRID: every other row: 0, 1 (H), 2 (V)      */
+  gint               flip_col;   /* GRID: every other column                    */
+  gdouble            offset;     /* MIRROR: px from the source's centre         */
+} ChopGimpRepeatOptions;
+
+
+gboolean          chopgimp_vrepeat_enabled         (void);
+/*  the instances of the repeats whose source or options changed; TRUE
+ *  when some were made again (called by the objects' change hook)
+ */
+gboolean          chopgimp_vrepeat_refresh         (GimpVectorLayer       *layer);
+/*  the repeat group of @object (itself, its group, an instance), or NULL  */
+ChopGimpVObject * chopgimp_vrepeat_group_of        (ChopGimpVObject       *object);
+/*  the default options of @type for a source of @width × @height px  */
+void              chopgimp_vrepeat_default_options (ChopGimpRepeatType     type,
+                                                    gdouble                width,
+                                                    gdouble                height,
+                                                    ChopGimpRepeatOptions *options);
+
+/*  ─── commands (one undo step each; the caller flushes) ─────────────── */
+
+/*  the selected objects (same parent, not inside a repeat) */
+gboolean          chopgimp_vrepeat_can_make        (GimpVectorLayer       *layer);
+/*  they become the source of a new repeat (several: grouped first), with
+ *  the default options of @type (or @options when not NULL); it is
+ *  selected and returned
+ */
+ChopGimpVObject * chopgimp_vrepeat_make            (GimpVectorLayer       *layer,
+                                                    ChopGimpRepeatType     type,
+                                                    const ChopGimpRepeatOptions *options);
+/*  a repeat is selected (or contains the selection)  */
+gboolean          chopgimp_vrepeat_any             (GimpVectorLayer       *layer);
+gboolean          chopgimp_vrepeat_get_options     (GimpVectorLayer       *layer,
+                                                    ChopGimpRepeatOptions *options);
+/*  the type may change (radial → grid…)  */
+gboolean          chopgimp_vrepeat_set_options     (GimpVectorLayer       *layer,
+                                                    const ChopGimpRepeatOptions *options);
+/*  « Libérer »: the instances are removed, the source takes the place of
+ *  the repeat
+ */
+gboolean          chopgimp_vrepeat_release         (GimpVectorLayer       *layer);
+/*  « Décomposer »: the instances become ordinary objects of a group  */
+gboolean          chopgimp_vrepeat_expand          (GimpVectorLayer       *layer);
+
+
+G_END_DECLS
