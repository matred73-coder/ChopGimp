+
+  /*  3.30.0: the spec of a repeat / brush / transition (its generated
+   *  objects are exported as they are)
+   */
+  if (n->dynamic && *n->dynamic)
+    {
+      g_string_append (w->body, " chopgimp:dynamic=\"");
+      svg_vput_escaped (w->body, n->dynamic);
+      g_string_append_c (w->body, '"');
+    }
 }
 
