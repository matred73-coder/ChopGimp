+
+#define MAX_POINTS     20000
+#define PREVIEW_POINTS  3000   /* filled preview up to this many points */
+
+
+/*  ─── options ───────────────────────────────────────────────────────── */
+
+enum
+{
+  PROP_0,
+  PROP_SIZE,
+  PROP_FIDELITY,
+  PROP_MERGE_SELECTION_ONLY,
+  PROP_KEEP_SELECTED
+};
+
+typedef struct
+{
+  GimpPathOptions parent_instance;
+
+  gdouble         size;                  /* px (image)                    */
+  gdouble         fidelity;              /* 0 accurate … 100 smooth       */
+  gboolean        merge_selection_only;
+  gboolean        keep_selected;
+} GimpVBlobOptions;
+
+typedef GimpToolOptionsClass GimpVBlobOptionsClass;
+
+static GType gimp_vblob_options_get_type (void) G_GNUC_CONST;
+
+G_DEFINE_TYPE (GimpVBlobOptions, gimp_vblob_options, GIMP_TYPE_PATH_OPTIONS)
+
+#define GIMP_TYPE_VBLOB_OPTIONS (gimp_vblob_options_get_type ())
+#define VBLOB_OPTIONS(tool)     ((GimpVBlobOptions *) gimp_tool_get_options (GIMP_TOOL (tool)))
+
+static void
+gimp_vblob_options_set_property (GObject      *object,
+                                 guint         property_id,
+                                 const GValue *value,
+                                 GParamSpec   *pspec)
+{
+  GimpVBlobOptions *o = (GimpVBlobOptions *) object;
+
+  switch (property_id)
+    {
+    case PROP_SIZE:                 o->size                 = g_value_get_double  (value); break;
+    case PROP_FIDELITY:             o->fidelity             = g_value_get_double  (value); break;
+    case PROP_MERGE_SELECTION_ONLY: o->merge_selection_only = g_value_get_boolean (value); break;
+    case PROP_KEEP_SELECTED:        o->keep_selected        = g_value_get_boolean (value); break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_vblob_options_get_property (GObject    *object,
+                                 guint       property_id,
+                                 GValue     *value,
+                                 GParamSpec *pspec)
+{
+  GimpVBlobOptions *o = (GimpVBlobOptions *) object;
+
+  switch (property_id)
+    {
+    case PROP_SIZE:                 g_value_set_double  (value, o->size);                 break;
+    case PROP_FIDELITY:             g_value_set_double  (value, o->fidelity);             break;
+    case PROP_MERGE_SELECTION_ONLY: g_value_set_boolean (value, o->merge_selection_only); break;
+    case PROP_KEEP_SELECTED:        g_value_set_boolean (value, o->keep_selected);        break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_vblob_options_class_init (GimpVBlobOptionsClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->set_property = gimp_vblob_options_set_property;
+  object_class->get_property = gimp_vblob_options_get_property;
+
+  GIMP_CONFIG_PROP_DOUBLE (object_class, PROP_SIZE,
+                           "blob-size", "Taille",
+                           "Diamètre du pinceau goutte (pixels de l'image)",
+                           1.0, 2000.0, 20.0,
+                           GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_DOUBLE (object_class, PROP_FIDELITY,
+                           "blob-fidelity", "Fidélité",
+                           "0 : précis (suit le geste) — 100 : lisse",
+                           0.0, 100.0, 50.0,
+                           GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, PROP_MERGE_SELECTION_ONLY,
+                            "blob-merge-selection-only", "Fusionner avec la sélection",
+                            "Ne fusionner qu'avec les objets sélectionnés",
+                            FALSE,
+                            GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, PROP_KEEP_SELECTED,
+                            "blob-keep-selected", "Garder la sélection",
+                            "La forme peinte reste sélectionnée",
+                            FALSE,
+                            GIMP_PARAM_STATIC_STRINGS);
+}
+
+static void
+gimp_vblob_options_init (GimpVBlobOptions *options)
+{
+}
+
+static GtkWidget *
+vblob_options_gui (GimpToolOptions *tool_options)
+{
+  GObject   *config = G_OBJECT (tool_options);
+  GtkWidget *vbox   = gimp_tool_options_gui (tool_options);
+  GtkWidget *w;
+
+  w = gimp_prop_spin_scale_new (config, "blob-size", 1.0, 10.0, 1);
+  gimp_spin_scale_set_scale_limits (GIMP_SPIN_SCALE (w), 1.0, 200.0);
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+
+  w = gimp_prop_spin_scale_new (config, "blob-fidelity", 1.0, 10.0, 0);
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+
+  w = gimp_prop_check_button_new (config, "blob-merge-selection-only", NULL);
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+
+  w = gimp_prop_check_button_new (config, "blob-keep-selected", NULL);
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+
+  w = gtk_label_new (_("Peignez : chaque coup devient une forme remplie de la couleur "
+                       "de fond, fusionnée avec les formes de même couleur (sans "
+                       "contour) qu'il touche."));
+  gtk_label_set_xalign (GTK_LABEL (w), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (w), TRUE);
+  gimp_label_set_attributes (GTK_LABEL (w), PANGO_ATTR_SCALE, PANGO_SCALE_SMALL, -1);
