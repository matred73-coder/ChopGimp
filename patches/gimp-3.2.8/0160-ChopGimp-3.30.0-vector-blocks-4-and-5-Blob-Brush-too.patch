+/*  ─── 3.30.0: Répétition, Formes de pinceau ─────────────────────────── */
+
+TARGET_COMMAND (repeat_release, chopgimp_vrepeat_release)
+TARGET_COMMAND (repeat_expand,  chopgimp_vrepeat_expand)
+TARGET_COMMAND (brush_define,   chopgimp_vbrush_define)
+TARGET_COMMAND (brush_release,  chopgimp_vbrush_release)
+TARGET_COMMAND (brush_expand,   chopgimp_vbrush_expand)
+
+static void
+repeat_make (gpointer           data,
+             ChopGimpRepeatType type)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_target (image, layer, data);
+
+  if (chopgimp_vrepeat_make (layer, type, NULL))
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_repeat_radial_cmd_callback (GimpAction *action,
+                                           GVariant   *value,
+                                           gpointer    data)
+{
+  repeat_make (data, CHOPGIMP_REPEAT_RADIAL);
+}
+
+void
+vector_objects_repeat_grid_cmd_callback (GimpAction *action,
+                                         GVariant   *value,
+                                         gpointer    data)
+{
+  repeat_make (data, CHOPGIMP_REPEAT_GRID);
+}
+
+void
+vector_objects_repeat_mirror_cmd_callback (GimpAction *action,
+                                           GVariant   *value,
+                                           gpointer    data)
+{
+  repeat_make (data, CHOPGIMP_REPEAT_MIRROR);
+}
+
+void
+vector_objects_repeat_options_cmd_callback (GimpAction *action,
+                                            GVariant   *value,
+                                            gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  return_if_no_target (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  chopgimp_repeat_options_dialog_show (image, layer, CHOPGIMP_REPEAT_RADIAL, widget);
+}
+
+static void
+brush_apply (gpointer           data,
+             ChopGimpVBrushType type)
+{
+  GimpImage            *image;
+  GimpVectorLayer      *layer;
+  ChopGimpVBrushOptions o;
+  return_if_no_target (image, layer, data);
+
+  chopgimp_vbrush_default_options (type, &o);
+  o.use_defined = (type != CHOPGIMP_VBRUSH_CALLIGRAPHIC) && chopgimp_vbrush_has_defined ();
+
+  if (chopgimp_vbrush_apply (layer, &o))
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_brush_calligraphic_cmd_callback (GimpAction *action,
+                                                GVariant   *value,
+                                                gpointer    data)
+{
+  brush_apply (data, CHOPGIMP_VBRUSH_CALLIGRAPHIC);
+}
+
+void
+vector_objects_brush_art_cmd_callback (GimpAction *action,
+                                       GVariant   *value,
+                                       gpointer    data)
+{
+  brush_apply (data, CHOPGIMP_VBRUSH_ART);
+}
+
+void
+vector_objects_brush_pattern_cmd_callback (GimpAction *action,
+                                           GVariant   *value,
+                                           gpointer    data)
+{
+  brush_apply (data, CHOPGIMP_VBRUSH_PATTERN);
+}
+
+void
+vector_objects_brush_scatter_cmd_callback (GimpAction *action,
+                                           GVariant   *value,
+                                           gpointer    data)
+{
+  brush_apply (data, CHOPGIMP_VBRUSH_SCATTER);
+}
+
+void
+vector_objects_brush_options_cmd_callback (GimpAction *action,
+                                           GVariant   *value,
+                                           gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  return_if_no_target (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  chopgimp_brush_options_dialog_show (image, layer, widget);
+}
