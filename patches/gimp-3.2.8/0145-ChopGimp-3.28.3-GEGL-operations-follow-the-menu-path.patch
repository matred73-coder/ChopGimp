---
 app/menus/filters-menu.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/app/menus/filters-menu.c b/app/menus/filters-menu.c
index 6b3b00e..2d5e2ec 100644
--- a/app/menus/filters-menu.c
+++ b/app/menus/filters-menu.c
@@ -28,6 +28,8 @@
 #include "core/gimp.h"
 #include "core/gimp-filter-history.h"
 
+#include "plug-in/plug-in-menu-path.h"
+
 #include "widgets/gimpactiongroup.h"
 #include "widgets/gimpstringaction.h"
 #include "widgets/gimpuimanager.h"
@@ -79,7 +81,11 @@ filters_menu_setup (GimpUIManager *manager,
       if (path == NULL)
         continue;
 
-      path = g_strdup (path);
+      /*  ChopGimp: GEGL operations follow the same menu path mappings as
+       *  the plug-ins (e.g. gegl:local-threshold « <Image>/Colors » goes
+       *  to Image > Réglages instead of re-creating a « Colors » menu)
+       */
+      path = plug_in_menu_path_map (path, NULL);
       root = strstr (path, "/");
 
       if (root == NULL || root == path)
