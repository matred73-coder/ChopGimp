 =?UTF-8?q?=20the=20menu=20path=20mappings=20of=20the=20plug-ins=20(gegl:l?=
 =?UTF-8?q?ocal-threshold=20=C2=AB=20<Image>/Colors=20=C2=BB=20goes=20to?=
 =?UTF-8?q?=20Image=20>=20R=C3=A9glages=20instead=20of=20re-creating=20an?=
 =?UTF-8?q?=20English=20=C2=AB=20Colors=20=C2=BB=20menu)?=
