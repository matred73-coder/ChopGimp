+/*  ─── 3.32.0: patterns of the « Incrustation de motif » (Patt) ─────────
+ *
+ *  The overlay stores its pattern as base64 of a zlib-compressed GIMP
+ *  .pat file (app/propgui/gimppropgui-layer-style.c); Photoshop finds the
+ *  pattern of a patternFill effect by its identifier among the patterns
+ *  of the document: the « Patt » block after the layers (Adobe « Photoshop
+ *  File Formats »: pattern, version 1, RGB, then a virtual memory array
+ *  list of 24 channels + user mask (the alpha) + sheet mask, raw 8 bits).
+ */
+
+static guint32
+be32 (const guchar *p)
+{
+  return ((guint32) p[0] << 24) | ((guint32) p[1] << 16) | ((guint32) p[2] << 8) | p[3];
+}
+
+/*  → RGBA 8 bits (width × height × 4), NULL if unreadable  */
+static guchar *
+pat_decode (const gchar *data,
+            gint        *width,
+            gint        *height,
+            gchar      **name)
+{
+  guchar        *z;
+  gsize          nz;
+  GInputStream  *mem;
+  GInputStream  *in;
+  GConverter    *dec;
+  GByteArray    *raw = g_byte_array_new ();
+  guchar         buf[16384];
+  gssize         r;
+  guchar        *rgba = NULL;
+  guint32        hsize, version, w, h, bpp;
+
+  z = g_base64_decode (data, &nz);
+  if (! z || nz == 0)
+    {
+      g_free (z);
+      g_byte_array_free (raw, TRUE);
+      return NULL;
+    }
+
+  mem = g_memory_input_stream_new_from_data (z, nz, g_free);
+  dec = G_CONVERTER (g_zlib_decompressor_new (G_ZLIB_COMPRESSOR_FORMAT_ZLIB));
+  in  = g_converter_input_stream_new (mem, dec);
+
+  while ((r = g_input_stream_read (in, buf, sizeof (buf), NULL, NULL)) > 0 &&
+         raw->len < (256u << 20))
+    g_byte_array_append (raw, buf, r);
+
+  g_object_unref (in);
+  g_object_unref (dec);
+  g_object_unref (mem);
+
+  if (raw->len < 24 || memcmp (raw->data + 20, "GPAT", 4))
+    goto out;
+
+  hsize   = be32 (raw->data);
+  version = be32 (raw->data + 4);
+  w       = be32 (raw->data + 8);
+  h       = be32 (raw->data + 12);
+  bpp     = be32 (raw->data + 16);
+
+  if (version != 1 || bpp < 1 || bpp > 4 || w == 0 || h == 0 ||
+      w > 30000 || h > 30000 || hsize < 24 || hsize > raw->len ||
+      (guint64) hsize + (guint64) w * h * bpp > raw->len)
+    goto out;
+
+  if (name)
+    *name = (hsize > 24) ? g_strndup ((const gchar *) raw->data + 24, hsize - 24) : NULL;
+
+  rgba = g_malloc ((gsize) w * h * 4);
+
+  for (gsize i = 0; i < (gsize) w * h; i++)
+    {
+      const guchar *p = raw->data + hsize + i * bpp;
+      guchar       *o = rgba + i * 4;
+
+      switch (bpp)
+        {
+        case 1: o[0] = o[1] = o[2] = p[0]; o[3] = 255;  break;
+        case 2: o[0] = o[1] = o[2] = p[0]; o[3] = p[1]; break;
+        case 3: o[0] = p[0]; o[1] = p[1]; o[2] = p[2]; o[3] = 255;  break;
+        default: o[0] = p[0]; o[1] = p[1]; o[2] = p[2]; o[3] = p[3]; break;
+        }
+    }
+
+  *width  = w;
+  *height = h;
+
+ out:
+  g_byte_array_free (raw, TRUE);
+
+  return rgba;
+}
+
+/*  one channel of a pattern: a written virtual memory array, raw 8 bits  */
+static void
+patt_channel (GByteArray   *b,
+              const guchar *rgba,
+              gint          w,
+              gint          h,
+              gint          c)
+{
+  put32 (b, 1);                         /* written            */
+  put32 (b, 23 + (guint32) w * h);      /* length of the rest */
+  put32 (b, 8);                         /* depth              */
+  put32 (b, 0); put32 (b, 0); put32 (b, h); put32 (b, w);
+  put16 (b, 8);                         /* pixel depth        */
+  g_byte_array_append (b, (const guint8 *) "\0", 1);   /* raw  */
+
+  for (gsize i = 0; i < (gsize) w * h; i++)
+    g_byte_array_append (b, rgba + i * 4 + c, 1);
+}
+
+/*  the identifier of the pattern (added to ctx->patt once), NULL if the
+ *  data can't be read; @name: the pattern's name (to free)
+ */
+static const gchar *
+patt_add (ChopPsd     *ctx,
+          const gchar *data,
+          gchar      **name)
+{
+  gchar       *md5 = g_compute_checksum_for_string (G_CHECKSUM_MD5, data, -1);
+  const gchar *id;
+  GByteArray  *p, *vm;
+  guchar      *rgba;
+  gchar       *pname = NULL;
+  gchar       *uuid;
+  gint         w = 0, h = 0;
+  gboolean     alpha = FALSE;
+
+  if (! ctx->patt_ids)
+    ctx->patt_ids = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+  if (! ctx->patt)
+    ctx->patt = g_byte_array_new ();
+
+  id = g_hash_table_lookup (ctx->patt_ids, md5);
+  if (id)
+    {
+      g_free (md5);
+      *name = NULL;
+      return id;
+    }
+
+  rgba = pat_decode (data, &w, &h, &pname);
+  if (! rgba)
+    {
+      g_free (md5);
+      return NULL;
+    }
+
+  /*  an identifier like Photoshop's (a UUID), stable for the same data  */
+  uuid = g_strdup_printf ("%.8s-%.4s-%.4s-%.4s-%.12s",
+                          md5, md5 + 8, md5 + 12, md5 + 16, md5 + 20);
+
+  for (gsize i = 0; i < (gsize) w * h && ! alpha; i++)
+    alpha = rgba[i * 4 + 3] != 255;
+
+  p = g_byte_array_new ();
+  put32 (p, 1);                         /* version  */
+  put32 (p, 3);                         /* RGB      */
+  put16 (p, h);
+  put16 (p, w);
+  put_ustr (p, pname ? pname : "ChopGimp");
+  {
+    guint8 n = (guint8) strlen (uuid);
+
+    g_byte_array_append (p, &n, 1);
+    put_raw (p, uuid);
+  }
+
+  vm = g_byte_array_new ();
+  put32 (vm, 0); put32 (vm, 0); put32 (vm, h); put32 (vm, w);
+  put32 (vm, 24);                       /* channels (+ user and sheet masks) */
+  for (gint c = 0; c < 24; c++)
+    {
+      if (c < 3)
+        patt_channel (vm, rgba, w, h, c);
+      else
+        put32 (vm, 0);
+    }
+  if (alpha)
+    patt_channel (vm, rgba, w, h, 3);   /* user mask: the alpha */
+  else
+    put32 (vm, 0);
+  put32 (vm, 0);                        /* sheet mask */
+
+  put32 (p, 3);                         /* list version */
+  put32 (p, vm->len);
+  g_byte_array_append (p, vm->data, vm->len);
+  g_byte_array_free (vm, TRUE);
+
+  put32 (ctx->patt, p->len);
+  g_byte_array_append (ctx->patt, p->data, p->len);
+  while (ctx->patt->len & 3)
+    g_byte_array_append (ctx->patt, (const guint8 *) "\0", 1);
+  g_byte_array_free (p, TRUE);
+
+  g_hash_table_insert (ctx->patt_ids, md5, uuid);
+  g_free (rgba);
+
+  *name = pname;
+
+  return uuid;
+}
+
+/*  after the layers: the global layer mask info (none) and the « Patt »
+ *  block of the overlays' patterns, if any
+ */
+gboolean
+chopgimp_psd_write_patterns (GOutputStream *output,
+                             ChopPsd       *ctx,
+                             GError       **error)
+{
+  GByteArray *head;
+  gboolean    ok;
+
+  if (! ctx || ! ctx->patt || ctx->patt->len == 0)
+    return TRUE;
+
+  head = g_byte_array_new ();
+  put32 (head, 0);                      /* global layer mask info: none */
+  put_raw (head, "8BIM");
+  put_raw (head, "Patt");
+  put32 (head, ctx->patt->len);         /* a multiple of 4 */
+
+  ok = g_output_stream_write_all (output, head->data, head->len, NULL, NULL, error) &&
+       g_output_stream_write_all (output, ctx->patt->data, ctx->patt->len,
+                                  NULL, NULL, error);
+
+  g_byte_array_free (head, TRUE);
+
+  return ok;
+}
+
