+/*  ChopGimp 3.32.0 (lot F): Photoshop's document tabs — a small view,
+ *  « nom.xcf @ 66,7 % (Calque, RVB/8)* », the full path as tooltip, the
+ *  close button on every tab; CHOPGIMP_CLASSIC_TABS=1 for GIMP's tabs
+ *  (a large view, the close button on the active one)
+ */
+static gboolean
+chopgimp_classic_tabs (void)
+{
+  return g_getenv ("CHOPGIMP_CLASSIC_TABS") != NULL;
+}
+
+static void
+chopgimp_tab_title_update (GimpDisplayShell *shell,
+                           const GParamSpec *pspec,
+                           GtkWidget        *label)
+{
+  GimpImage   *image = shell->display ? gimp_display_get_image (shell->display) : NULL;
+  GString     *text;
+  GList       *layers;
+  const gchar *base  = "RVB";
+  gdouble      zoom;
+  gchar       *z;
+  gint         bits  = 8;
+
+  if (! image)
+    {
+      gtk_label_set_text (GTK_LABEL (label), "");
+      return;
+    }
+
+  switch (gimp_image_get_base_type (image))
+    {
+    case GIMP_GRAY:    base = "Niveaux de gris"; break;
+    case GIMP_INDEXED: base = "Indexé";          break;
+    default:           base = "RVB";             break;
+    }
+
+  switch (gimp_image_get_component_type (image))
+    {
+    case GIMP_COMPONENT_TYPE_U16:
+    case GIMP_COMPONENT_TYPE_HALF:   bits = 16; break;
+    case GIMP_COMPONENT_TYPE_U32:
+    case GIMP_COMPONENT_TYPE_FLOAT:  bits = 32; break;
+    case GIMP_COMPONENT_TYPE_DOUBLE: bits = 64; break;
+    default:                         bits = 8;  break;
+    }
+
+  zoom = 100.0 * gimp_zoom_model_get_factor (shell->zoom);
+
+  if (fabs (zoom - RINT (zoom)) < 0.05)
+    z = g_strdup_printf ("%d", (gint) RINT (zoom));
+  else
+    z = g_strdup_printf ("%.1f", zoom);
+
+  /*  French decimal separator  */
+  g_strdelimit (z, ".", ',');
+
+  text = g_string_new (gimp_image_get_display_name (image));
+  g_string_append_printf (text, " @ %s %% (", z);
+
+  layers = gimp_image_get_selected_layers (image);
+  if (g_list_length (layers) == 1)
+    g_string_append_printf (text, "%s, ",
+                            gimp_object_get_name (GIMP_OBJECT (layers->data)));
+
+  g_string_append_printf (text, "%s/%d)", base, bits);
+
+  if (gimp_image_is_dirty (image))
+    g_string_append_c (text, '*');
+
+  gtk_label_set_text (GTK_LABEL (label), text->str);
+  gimp_help_set_help_data (gtk_widget_get_parent (label),
+                           gimp_image_get_display_path (image), NULL);
+
+  g_string_free (text, TRUE);
+  g_free (z);
+}
