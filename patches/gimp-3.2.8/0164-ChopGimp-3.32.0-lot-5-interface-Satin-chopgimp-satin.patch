+/*  ChopGimp 3.32.0: the tool shown by its group in the toolbox when the
+ *  tool's own key (a plain letter, as in Photoshop: L, M, W…) selected
+ *  @tool_info; a tool of the group with a key of its own (another plain
+ *  letter) keeps it. Not for the menus (no key press, or not the action's
+ *  key); CHOPGIMP_NO_GROUP_KEY=1 for GIMP's behavior.
+ */
+static GimpToolInfo *
+tools_select_group_shown (Gimp         *gimp,
+                          GimpAction   *action,
+                          GimpToolInfo *tool_info)
+{
+  GdkEvent      *event;
+  GimpViewable  *parent;
+  GimpToolInfo  *shown;
+  const gchar  **accels;
+  gchar         *pressed = NULL;
+  gchar         *name;
+  GimpAction    *shown_action;
+  gboolean       is_key = FALSE;
+  gint           i;
+
+  if (g_getenv ("CHOPGIMP_NO_GROUP_KEY") || ! tool_info)
+    return tool_info;
+
+  parent = gimp_viewable_get_parent (GIMP_VIEWABLE (tool_info));
+
+  if (! GIMP_IS_TOOL_GROUP (parent))
+    return tool_info;
+
+  shown = gimp_tool_group_get_active_tool_info (GIMP_TOOL_GROUP (parent));
+
+  if (! shown || shown == tool_info ||
+      ! gimp_tool_item_get_visible (GIMP_TOOL_ITEM (shown)))
+    return tool_info;
+
+  event = gtk_get_current_event ();
+
+  if (event)
+    {
+      if (event->type == GDK_KEY_PRESS &&
+          ! (event->key.state & gtk_accelerator_get_default_mod_mask ()))
+        {
+          guint keyval = gdk_keyval_to_lower (event->key.keyval);
+
+          pressed = gtk_accelerator_name (keyval, 0);
+        }
+
+      gdk_event_free (event);
+    }
+
+  if (! pressed)
+    return tool_info;
+
+  /*  the key is the action's own shortcut  */
+  accels = gimp_action_get_accels (action);
+
+  for (i = 0; accels && accels[i]; i++)
+    if (! g_ascii_strcasecmp (accels[i], pressed))
+      is_key = TRUE;
+
+  if (! is_key)
+    {
+      g_free (pressed);
+      return tool_info;
+    }
+
+  /*  the shown tool has a plain key of its own: it keeps it  */
+  name         = gimp_tool_info_get_action_name (shown);
+  shown_action = GIMP_ACTION (g_action_map_lookup_action (G_ACTION_MAP (gimp->app),
+                                                          name));
+  g_free (name);
+
+  accels = shown_action ? gimp_action_get_accels (shown_action) : NULL;
+
+  for (i = 0; accels && accels[i]; i++)
+    {
+      guint           key  = 0;
+      GdkModifierType mods = 0;
+
+      gtk_accelerator_parse (accels[i], &key, &mods);
+
+      if (key && ! (mods & gtk_accelerator_get_default_mod_mask ()) &&
+          g_ascii_strcasecmp (accels[i], pressed))
+        {
+          g_free (pressed);
+          return tool_info;
+        }
+    }
+
+  g_free (pressed);
+
+  return shown;
+}
+
