+#include "config.h"
+
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpcolor/gimpcolor.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "display-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpcontext.h"
+#include "core/gimpdrawable.h"
+#include "core/gimpimage.h"
+#include "core/gimplayer.h"
+#include "core/gimplayermask.h"
+#include "core/gimptoolinfo.h"
+
+#include "widgets/chopgimp-rc.h"
+
+#include "chopgimp-statusbar-info.h"
+
+
+#define INFO_KEY  "chopgimp-statusbar-info"
+#define RC_GROUP  "statusbar"
+#define RC_KEY    "info"
+
+
+typedef struct
+{
+  Gimp      *gimp;
+  GimpImage *image;      /*  weak  */
+  GtkWidget *button;
+  GtkWidget *label;
+  guint      idle_id;
+} StatusInfo;
+
+static const struct
+{
+  const gchar *key;
+  const gchar *label;
+} info_modes[] =
+{
+  { "document",   "Taille du document"    },
+  { "dimensions", "Dimensions du document" },
+  { "profile",    "Profil du document"    },
+  { "resolution", "Résolution"            },
+  { "layers",     "Calques"               },
+  { "tool",       "Outil actif"           }
+};
+
+
+static gchar *
+status_info_mode (void)
+{
+  gchar *mode = chopgimp_rc_get_string (RC_GROUP, RC_KEY, "document");
+  gint   i;
+
+  for (i = 0; i < G_N_ELEMENTS (info_modes); i++)
+    if (! strcmp (mode, info_modes[i].key))
+      return mode;
+
+  g_free (mode);
+
+  return g_strdup ("document");
+}
+
+/*  bytes of a drawable's pixels  */
+static guint64
+status_info_drawable_bytes (GimpDrawable *drawable)
+{
+  const Babl *format = gimp_drawable_get_format (drawable);
+
+  return (guint64) gimp_item_get_width  (GIMP_ITEM (drawable)) *
+         (guint64) gimp_item_get_height (GIMP_ITEM (drawable)) *
+         (guint64) babl_format_get_bytes_per_pixel (format);
+}
+
+static gchar *
+status_info_text (StatusInfo *si,
+                  const gchar *mode)
+{
+  GimpImage *image = si->image;
+
+  if (! strcmp (mode, "tool"))
+    {
+      GimpToolInfo *tool = gimp_context_get_tool (gimp_get_user_context (si->gimp));
+
+      return tool ? gimp_strip_uline (tool->label) : g_strdup ("");
+    }
+
+  if (! image)
+    return g_strdup ("");
+
+  if (! strcmp (mode, "dimensions"))
+    {
+      gdouble xres, yres;
+
+      gimp_image_get_resolution (image, &xres, &yres);
+
+      return g_strdup_printf ("%d × %d px (%.0f ppp)",
+                              gimp_image_get_width (image),
+                              gimp_image_get_height (image), xres);
+    }
+
+  if (! strcmp (mode, "resolution"))
+    {
+      gdouble xres, yres;
+
+      gimp_image_get_resolution (image, &xres, &yres);
+
+      return g_strdup_printf ("%.0f ppp", xres);
+    }
+
+  if (! strcmp (mode, "profile"))
+    {
+      GimpColorProfile *profile =
+        gimp_color_managed_get_color_profile (GIMP_COLOR_MANAGED (image));
+
+      return g_strdup (profile ? gimp_color_profile_get_label (profile) :
+                                 "Sans profil");
+    }
+
+  if (! strcmp (mode, "layers"))
+    {
+      GList *layers = gimp_image_get_layer_list (image);
+      gint   n      = g_list_length (layers);
+
+      g_list_free (layers);
+
+      return g_strdup_printf (n > 1 ? "%d calques" : "%d calque", n);
+    }
+
+  /*  « Doc » : the flattened image (no alpha) / the layers, masks and
+   *  channels, as Photoshop's « Document Sizes »
+   */
+  {
+    const Babl *flat   = gimp_image_get_layer_format (image, FALSE);
+    guint64     merged = (guint64) gimp_image_get_width (image) *
+                         (guint64) gimp_image_get_height (image) *
+                         (guint64) babl_format_get_bytes_per_pixel (flat);
+    guint64     total  = 0;
+    GList      *list;
+    GList      *iter;
+    gchar      *a, *b, *text;
+
+    list = gimp_image_get_layer_list (image);
+    for (iter = list; iter; iter = g_list_next (iter))
+      {
+        GimpLayer *layer = iter->data;
+
+        if (gimp_viewable_get_children (GIMP_VIEWABLE (layer)))
+          continue;
+
+        total += status_info_drawable_bytes (GIMP_DRAWABLE (layer));
+
+        if (gimp_layer_get_mask (layer))
+          total += status_info_drawable_bytes (GIMP_DRAWABLE (gimp_layer_get_mask (layer)));
+      }
+    g_list_free (list);
+
+    list = gimp_image_get_channel_list (image);
+    for (iter = list; iter; iter = g_list_next (iter))
+      total += status_info_drawable_bytes (GIMP_DRAWABLE (iter->data));
+    g_list_free (list);
+
+    a    = g_format_size (merged);
+    b    = g_format_size (MAX (total, merged));
+    text = g_strdup_printf ("Doc : %s / %s", a, b);
+
+    g_free (a);
+    g_free (b);
+
+    return text;
+  }
+}
+
+static gboolean
+status_info_update_idle (gpointer data)
+{
+  StatusInfo *si   = data;
+  gchar      *mode = status_info_mode ();
+  gchar      *text = status_info_text (si, mode);
+  gint        i;
+
+  si->idle_id = 0;
+
+  gtk_label_set_text (GTK_LABEL (si->label), text);
+
+  for (i = 0; i < G_N_ELEMENTS (info_modes); i++)
+    if (! strcmp (mode, info_modes[i].key))
+      gimp_help_set_help_data (si->button, info_modes[i].label, NULL);
+
+  g_free (text);
+  g_free (mode);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+status_info_queue_update (StatusInfo *si)
+{
+  if (! si->idle_id)
+    si->idle_id = g_idle_add_full (G_PRIORITY_LOW, status_info_update_idle,
+                                   si, NULL);
+}
+
+static void
+status_info_mode_activate (GtkMenuItem *item,
+                           StatusInfo  *si)
+{
+  if (! gtk_check_menu_item_get_active (GTK_CHECK_MENU_ITEM (item)))
+    return;
+
+  chopgimp_rc_set_string (RC_GROUP, RC_KEY,
+                          g_object_get_data (G_OBJECT (item), "mode"));
+  status_info_queue_update (si);
+}
+
+static void
+status_info_clicked (GtkButton  *button,
+                     StatusInfo *si)
+{
+  GtkWidget *menu  = gtk_menu_new ();
+  GSList    *group = NULL;
+  gchar     *mode  = status_info_mode ();
+  gint       i;
+
+  for (i = 0; i < G_N_ELEMENTS (info_modes); i++)
+    {
+      GtkWidget *item = gtk_radio_menu_item_new_with_label (group,
+                                                            info_modes[i].label);
+
+      group = gtk_radio_menu_item_get_group (GTK_RADIO_MENU_ITEM (item));
+      g_object_set_data (G_OBJECT (item), "mode", (gpointer) info_modes[i].key);
+      gtk_check_menu_item_set_active (GTK_CHECK_MENU_ITEM (item),
+                                      ! strcmp (mode, info_modes[i].key));
+      g_signal_connect (item, "toggled",
+                        G_CALLBACK (status_info_mode_activate), si);
+      gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+      gtk_widget_set_visible (item, TRUE);
+    }
+
+  g_free (mode);
+
+  gtk_menu_attach_to_widget (GTK_MENU (menu), GTK_WIDGET (button), NULL);
+  g_signal_connect (menu, "deactivate",
+                    G_CALLBACK (gtk_widget_destroy), NULL);
+  gtk_menu_popup_at_widget (GTK_MENU (menu), GTK_WIDGET (button),
+                            GDK_GRAVITY_NORTH_WEST, GDK_GRAVITY_SOUTH_WEST,
+                            NULL);
+}
+
+static void
+status_info_free (StatusInfo *si)
+{
+  if (si->idle_id)
+    g_source_remove (si->idle_id);
+
+  if (si->image)
+    {
+      g_signal_handlers_disconnect_by_data (si->image, si);
+      g_clear_weak_pointer (&si->image);
+    }
+
+  g_slice_free (StatusInfo, si);
+}
+
+
+/*  public functions  */
+
+GtkWidget *
+chopgimp_statusbar_info_new (Gimp *gimp)
+{
+  StatusInfo *si;
+  GtkWidget  *hbox;
+  GtkWidget  *arrow;
+
+  g_return_val_if_fail (GIMP_IS_GIMP (gimp), NULL);
+
+  si = g_slice_new0 (StatusInfo);
+  si->gimp = gimp;
+
+  si->button = gtk_button_new ();
+  gtk_button_set_relief (GTK_BUTTON (si->button), GTK_RELIEF_NONE);
+  gtk_widget_set_can_focus (si->button, FALSE);
+  gtk_widget_set_name (si->button, "chopgimp-statusbar-info");
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 2);
+  gtk_container_add (GTK_CONTAINER (si->button), hbox);
+  gtk_widget_set_visible (hbox, TRUE);
+
+  si->label = gtk_label_new (NULL);
+  gtk_label_set_ellipsize (GTK_LABEL (si->label), PANGO_ELLIPSIZE_END);
+  gtk_label_set_max_width_chars (GTK_LABEL (si->label), 32);
+  gtk_box_pack_start (GTK_BOX (hbox), si->label, FALSE, FALSE, 0);
+  gtk_widget_set_visible (si->label, TRUE);
+
+  arrow = gtk_image_new_from_icon_name ("pan-end-symbolic", GTK_ICON_SIZE_MENU);
+  gtk_box_pack_start (GTK_BOX (hbox), arrow, FALSE, FALSE, 0);
+  gtk_widget_set_visible (arrow, TRUE);
+
+  g_object_set_data_full (G_OBJECT (si->button), INFO_KEY, si,
+                          (GDestroyNotify) status_info_free);
+
+  g_signal_connect (si->button, "clicked",
+                    G_CALLBACK (status_info_clicked), si);
+
+  /*  « Outil actif »; disconnected with the button  */
+  g_signal_connect_object (gimp_get_user_context (gimp), "tool-changed",
+                           G_CALLBACK (chopgimp_statusbar_info_update),
+                           si->button, G_CONNECT_SWAPPED);
+
+  status_info_queue_update (si);
+
+  return si->button;
+}
+
+void
+chopgimp_statusbar_info_set_image (GtkWidget *info,
+                                   GimpImage *image)
+{
+  static const gchar * const signals[] =
+  {
+    "size-changed", "mode-changed", "precision-changed", "resolution-changed",
+    "profile-changed", "dirty", "clean"
+  };
+  StatusInfo *si;
+  gint        i;
+
+  g_return_if_fail (GTK_IS_WIDGET (info));
+  g_return_if_fail (image == NULL || GIMP_IS_IMAGE (image));
+
+  si = g_object_get_data (G_OBJECT (info), INFO_KEY);
+
+  if (! si || si->image == image)
+    return;
+
+  if (si->image)
+    g_signal_handlers_disconnect_by_data (si->image, si);
+
+  g_set_weak_pointer (&si->image, image);
+
+  if (image)
+    for (i = 0; i < G_N_ELEMENTS (signals); i++)
+      g_signal_connect_swapped (image, signals[i],
+                                G_CALLBACK (status_info_queue_update), si);
+
+  status_info_queue_update (si);
+}
+
+void
+chopgimp_statusbar_info_update (GtkWidget *info)
+{
+  StatusInfo *si;
+
+  g_return_if_fail (GTK_IS_WIDGET (info));
+
+  si = g_object_get_data (G_OBJECT (info), INFO_KEY);
+
+  if (si)
+    status_info_queue_update (si);
+}
