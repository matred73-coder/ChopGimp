+/*  ChopGimp: buttons at the bottom of the tool dialogs as Photoshop's:
+ *  « Réinitialiser » on the left, the default button (Valider) styled as
+ *  the suggested action on the right
+ */
+static void
+gimp_tool_gui_style_buttons (GimpToolGui *gui)
+{
+  GimpToolGuiPrivate *private = GET_PRIVATE (gui);
+  GList              *list;
+
+  if (private->overlay || ! private->dialog)
+    return;
+
+  for (list = private->response_entries; list; list = g_list_next (list))
+    {
+      ResponseEntry   *entry = list->data;
+      GtkWidget       *button;
+      GtkWidget       *parent;
+      GtkStyleContext *style;
+
+      button = gtk_dialog_get_widget_for_response (GTK_DIALOG (private->dialog),
+                                                   entry->response_id);
+      if (! button)
+        continue;
+
+      style  = gtk_widget_get_style_context (button);
+      parent = gtk_widget_get_parent (button);
+
+      if (entry->response_id == private->default_response)
+        gtk_style_context_add_class (style, "suggested-action");
+      else
+        gtk_style_context_remove_class (style, "suggested-action");
+
+      if (entry->button_text                           &&
+          ! g_strcmp0 (entry->button_text, _("_Reset")) &&
+          GTK_IS_BUTTON_BOX (parent))
+        {
+          gtk_button_box_set_child_secondary (GTK_BUTTON_BOX (parent),
+                                              button, TRUE);
+          gtk_style_context_add_class (style, "chopgimp-reset-button");
+        }
+    }
+}
