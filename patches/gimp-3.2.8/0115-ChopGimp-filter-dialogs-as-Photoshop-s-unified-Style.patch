+/*  the effects column  */
+
+#define ROW_FILTER_KEY  "chopgimp-layer-style-filter"
+#define ROW_CURRENT_KEY "chopgimp-layer-style-current"
+
+static void
+layer_style_row_activated (GtkListBox        *list,
+                           GtkListBoxRow     *row,
+                           LayerStyleSession *session)
+{
+  const ChopGimpLayerStyle *style;
+  GimpDrawableFilter       *filter;
+
+  if (g_object_get_data (G_OBJECT (row), ROW_CURRENT_KEY))
+    return;
+
+  style  = g_object_get_data (G_OBJECT (row), STYLE_KEY);
+  filter = g_object_get_data (G_OBJECT (row), ROW_FILTER_KEY);
+
+  layer_style_switch_later (session, filter, style);
+}
