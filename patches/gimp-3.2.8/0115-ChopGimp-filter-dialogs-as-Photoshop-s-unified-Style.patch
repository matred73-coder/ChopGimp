+/*  rank of a style in Photoshop's « Style de calque » window (Biseautage,
+ *  Contour, Ombre interne, Lueur interne, Incrustation couleur, Lueur
+ *  externe, Ombre portée), -1 if unknown
+ */
+static inline gint
+chopgimp_layer_style_rank (const ChopGimpLayerStyle *style)
+{
+  static const gchar * const order[] =
+  {
+    "Biseautage", "Contour", "Ombre interne", "Lueur interne",
+    "Incrustation couleur", "Lueur externe", "Ombre portée"
+  };
+  gint i;
+
+  if (! style)
+    return -1;
+
+  for (i = 0; i < G_N_ELEMENTS (order); i++)
+    if (! strcmp (order[i], style->label))
+      return i;
+
+  return -1;
+}
