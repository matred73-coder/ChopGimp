+/*  ChopGimp: the « Aide » button becomes a small « ? » button in the
+ *  dialog's header (icon, name and layer), the button of the action area
+ *  is hidden but still answers the help response
+ */
+static void
+gimp_tool_dialog_help_clicked (GtkWidget *button,
+                               GtkWidget *help_button)
+{
+  gtk_button_clicked (GTK_BUTTON (help_button));
+}
+
+static void
+gimp_tool_dialog_help_header (GimpToolDialog *dialog)
+{
+  GimpViewableDialog *viewable_dialog = GIMP_VIEWABLE_DIALOG (dialog);
+  GtkWidget          *help_button;
+  GtkWidget          *header;
+  GtkWidget          *button;
+  GtkWidget          *image;
+
+  help_button = gtk_dialog_get_widget_for_response (GTK_DIALOG (dialog),
+                                                    GTK_RESPONSE_HELP);
+
+  if (! GTK_IS_BUTTON (help_button) || ! viewable_dialog->icon)
+    return;
+
+  header = gtk_widget_get_parent (viewable_dialog->icon);
+
+  if (! GTK_IS_BOX (header))
+    return;
+
+  gtk_widget_set_no_show_all (help_button, TRUE);
+  gtk_widget_set_visible (help_button, FALSE);
+
+  button = gtk_button_new ();
+  gtk_button_set_relief (GTK_BUTTON (button), GTK_RELIEF_NONE);
+  gtk_widget_set_focus_on_click (button, FALSE);
+  gtk_widget_set_valign (button, GTK_ALIGN_CENTER);
+  gtk_style_context_add_class (gtk_widget_get_style_context (button),
+                               "chopgimp-help-button");
+  gtk_box_pack_end (GTK_BOX (header), button, FALSE, FALSE, 0);
+  gtk_widget_set_visible (button, TRUE);
+
+  image = gtk_image_new_from_icon_name (GIMP_ICON_HELP, GTK_ICON_SIZE_MENU);
+  gtk_container_add (GTK_CONTAINER (button), image);
+  gtk_widget_set_visible (image, TRUE);
+
+  gimp_help_set_help_data (button, "Aide", NULL);
+
+  g_signal_connect_object (button, "clicked",
+                           G_CALLBACK (gimp_tool_dialog_help_clicked),
+                           help_button, 0);
+}
