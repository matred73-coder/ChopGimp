+/*  the style of the n-th position of Photoshop's window, or NULL  */
+static inline const ChopGimpLayerStyle *
+chopgimp_layer_style_nth (gint n)
+{
+  gint i;
+
+  for (i = 0; i < G_N_ELEMENTS (chopgimp_layer_styles); i++)
