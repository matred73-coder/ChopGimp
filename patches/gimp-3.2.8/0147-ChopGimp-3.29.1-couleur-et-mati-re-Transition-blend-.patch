+
+
+/*  ─── 3.29.1: « couleur et matière » ─────────────────────────────────── */
+
+TARGET_COMMAND (blend_release,  chopgimp_vblend_release)
+TARGET_COMMAND (blend_expand,   chopgimp_vblend_expand)
+TARGET_COMMAND (blend_reverse,  chopgimp_vblend_reverse)
+TARGET_COMMAND (blend_spine,    chopgimp_vblend_replace_spine)
+TARGET_COMMAND (opmask_release, chopgimp_vmaterial_opmask_release)
+TARGET_COMMAND (pattern_edit,   chopgimp_vmaterial_pattern_edit)
+TARGET_COMMAND (pattern_finish, chopgimp_vmaterial_pattern_finish)
+
+void
+vector_objects_blend_make_cmd_callback (GimpAction *action,
+                                        GVariant   *value,
+                                        gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_target (image, layer, data);
+
+  if (chopgimp_vblend_make (layer))
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_blend_options_cmd_callback (GimpAction *action,
+                                           GVariant   *value,
+                                           gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  return_if_no_target (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  chopgimp_blend_options_dialog_show (image, layer, widget);
+}
+
+void
+vector_objects_mesh_make_cmd_callback (GimpAction *action,
+                                       GVariant   *value,
+                                       gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  return_if_no_target (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  chopgimp_mesh_dialog_show (image, layer, widget);
+}
+
+void
+vector_objects_freeform_make_cmd_callback (GimpAction *action,
+                                           GVariant   *value,
+                                           gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GimpContext     *context;
+  return_if_no_target (image, layer, data);
+
+  context = action_data_get_context (data);
+
+  if (chopgimp_vmaterial_make_freeform (layer,
+                                        context ? gimp_context_get_foreground (context) : NULL,
+                                        context ? gimp_context_get_background (context) : NULL))
+    gimp_image_flush (image);
+}
+
+#define STROKE_GRADIENT_COMMAND(name, mode)                \
+void                                                       \
+vector_objects_##name##_cmd_callback (GimpAction *action,  \
+                                      GVariant   *value,   \
+                                      gpointer    data)    \
+{                                                          \
+  GimpImage       *image;                                  \
+  GimpVectorLayer *layer;                                  \
+  return_if_no_target (image, layer, data);                \
+                                                           \
+  if (chopgimp_vmaterial_set_stroke_gradient (layer, mode)) \
+    gimp_image_flush (image);                              \
+}
+
+STROKE_GRADIENT_COMMAND (stroke_gradient_within, 0)
+STROKE_GRADIENT_COMMAND (stroke_gradient_along,  1)
+STROKE_GRADIENT_COMMAND (stroke_gradient_across, 2)
+
+void
+vector_objects_opmask_make_cmd_callback (GimpAction *action,
+                                         GVariant   *value,
+                                         gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_target (image, layer, data);
+
+  /*  Illustrator's default: « Découpe » on  */
+  if (chopgimp_vmaterial_opmask_make (layer, CHOPGIMP_OPMASK_CLIP))
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_opmask_clip_cmd_callback (GimpAction *action,
+                                         GVariant   *value,
+                                         gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_target (image, layer, data);
+
+  if (chopgimp_vmaterial_opmask_toggle (layer, CHOPGIMP_OPMASK_CLIP))
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_opmask_invert_cmd_callback (GimpAction *action,
+                                           GVariant   *value,
+                                           gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_target (image, layer, data);
+
+  if (chopgimp_vmaterial_opmask_toggle (layer, CHOPGIMP_OPMASK_INVERT))
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_pattern_make_cmd_callback (GimpAction *action,
+                                          GVariant   *value,
+                                          gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  gchar           *spec;
+  return_if_no_target (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  /*  the objects become a pattern (in the image's list), then its options
+   *  open, like Illustrator's pattern editing mode
+   */
+  spec = chopgimp_vmaterial_pattern_from_selection (layer, NULL);
+
+  if (spec)
+    {
+      gimp_image_flush (image);
+      chopgimp_pattern_options_dialog_show (image, layer, spec, widget);
+      g_free (spec);
+    }
+}
+
+void
+vector_objects_pattern_options_cmd_callback (GimpAction *action,
+                                             GVariant   *value,
+                                             gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  return_if_no_target (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  chopgimp_pattern_options_dialog_show (image, layer, NULL, widget);
+}
+
+void
+vector_objects_pattern_apply_cmd_callback (GimpAction *action,
+                                           GVariant   *value,
+                                           gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  return_if_no_target (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  chopgimp_pattern_apply_dialog_show (image, layer, widget);
+}
