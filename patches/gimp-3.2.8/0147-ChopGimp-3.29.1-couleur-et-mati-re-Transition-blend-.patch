+static gboolean
+is_blend_group (ChopGimpVObject *o)
+{
+  return o->kind == CHOPGIMP_VOBJECT_GROUP && o->blend &&
+         g_str_has_prefix (o->blend, "blend");
+}
+
+static gboolean
+is_step (ChopGimpVObject *o)
+{
+  return o->blend && ! strcmp (o->blend, "step");
+}
+
+ChopGimpVObject *
+chopgimp_vblend_group_of (ChopGimpVObject *object)
+{
+  for (ChopGimpVObject *o = object; o; o = o->parent)
+    if (is_blend_group (o))
