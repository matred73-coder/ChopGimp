+/*  ─── geometry: box units ↔ image ───────────────────────────────────── */
+
+/*  the local box of @o's path (as the paint uses it)  */
+static gboolean
+object_box (ChopGimpVObject *o,
+            gdouble          box[4])
+{
+  const GimpBezierDesc *b;
+  cairo_surface_t      *s;
+  cairo_t              *cr;
+
+  if (! o || o->kind != CHOPGIMP_VOBJECT_PATH || ! o->path ||
+      gimp_path_get_n_strokes (o->path) == 0)
+    return FALSE;
+
+  b = gimp_path_get_bezier (o->path);
+
+  if (! b || b->num_data == 0)
+    return FALSE;
+
+  s  = cairo_image_surface_create (CAIRO_FORMAT_A8, 1, 1);
+  cr = cairo_create (s);
+  cairo_append_path (cr, (cairo_path_t *) b);
+  cairo_path_extents (cr, &box[0], &box[1], &box[2], &box[3]);
+  cairo_destroy (cr);
+  cairo_surface_destroy (s);
+
+  if (box[2] - box[0] < 1e-6) box[2] = box[0] + 1;
+  if (box[3] - box[1] < 1e-6) box[3] = box[1] + 1;
+
+  return TRUE;
+}
+
+static void
+box_to_image (ChopGimpVObject *o,
+              const gdouble    box[4],
+              gdouble          u,
+              gdouble          v,
+              gdouble         *x,
+              gdouble         *y)
+{
+  GimpMatrix3 m;
+  gdouble     lx = box[0] + u * (box[2] - box[0]);
+  gdouble     ly = box[1] + v * (box[3] - box[1]);
+
+  chopgimp_vobject_get_world_matrix (o, &m);
+  gimp_matrix3_transform_point (&m, lx, ly, x, y);
+}
+
+static void
+image_to_box (ChopGimpVObject *o,
+              const gdouble    box[4],
+              gdouble          x,
+              gdouble          y,
+              gdouble         *u,
+              gdouble         *v)
+{
+  GimpMatrix3 m;
+  gdouble     lx, ly;
+
+  chopgimp_vobject_get_world_matrix (o, &m);
+  gimp_matrix3_invert (&m);
+  gimp_matrix3_transform_point (&m, x, y, &lx, &ly);
+
+  *u = (lx - box[0]) / (box[2] - box[0]);
+  *v = (ly - box[1]) / (box[3] - box[1]);
+}
+
+static ChopGimpVEntry *
+material_fill (ChopGimpVObject *o)
+{
+  ChopGimpVEntry *e = (o && o->kind == CHOPGIMP_VOBJECT_PATH)
+                      ? chopgimp_vstyle_get_fill (&o->style) : NULL;
+
+  return e;
+}
+
+/*  the nodes (mesh) or points (freeform) of @o's fill as image points
+ *  (g_free), or NULL
+ */
+static gdouble *
+material_points (ChopGimpVObject *o,
+                 gint            *n,
+                 gboolean        *freeform)
+{
+  ChopGimpVEntry *e = material_fill (o);
+  gdouble         box[4];
+  gdouble        *pts = NULL;
+
+  *n        = 0;
+  *freeform = FALSE;
+
+  if (! e || ! e->paint.material || ! object_box (o, box))
+    return NULL;
+
+  if (e->paint.type == CHOPGIMP_PAINT_MESH)
+    {
+      ChopGimpMesh m;
+
+      if (! chopgimp_vmesh_parse (e->paint.material, &m))
+        return NULL;
+
+      *n  = (m.rows + 1) * (m.cols + 1);
+      pts = g_new (gdouble, *n * 2);
+
+      for (gint i = 0; i < *n; i++)
+        box_to_image (o, box, m.nodes[i].x, m.nodes[i].y, &pts[2 * i], &pts[2 * i + 1]);
+
+      chopgimp_vmesh_clear (&m);
+    }
+  else if (e->paint.type == CHOPGIMP_PAINT_FREEFORM &&
+           g_str_has_prefix (e->paint.material, "points"))
+    {
+      GArray *a = chopgimp_vfreeform_parse (e->paint.material + 6);
+
+      if (! a)
+        return NULL;
+
+      *freeform = TRUE;
+      *n        = a->len;
+      pts       = g_new (gdouble, *n * 2);
+
+      for (gint i = 0; i < *n; i++)
+        {
+          ChopGimpMeshNode *nd = &g_array_index (a, ChopGimpMeshNode, i);
+
+          box_to_image (o, box, nd->x, nd->y, &pts[2 * i], &pts[2 * i + 1]);
+        }
+
+      g_array_free (a, TRUE);
+    }
+
+  return pts;
+}
+
+/*  a new style for @o with its fill's material replaced by @spec  */
+static void
+set_fill_material (GimpVectorLayer   *layer,
+                   ChopGimpVObject   *o,
+                   ChopGimpPaintType  type,
+                   const gchar       *spec)
+{
+  ChopGimpVStyle  st;
+  ChopGimpVEntry *e;
+  GeglColor      *main;
+
+  chopgimp_vstyle_init (&st);
+  chopgimp_vstyle_copy (&st, &o->style);
+
+  e    = chopgimp_vstyle_ensure_fill (&st);
+  main = chopgimp_vmaterial_main_color (type, spec);
+  chopgimp_vpaint_set_material (&e->paint, type, spec, main);
+  e->visible = TRUE;
+  g_clear_object (&main);
+
+  chopgimp_vlayer_set_style (layer, o->id, &st, FALSE);
+  chopgimp_vstyle_clear (&st);
+}
+
+static gint
+nearest_point (const gdouble *pts,
+               gint           n,
+               gdouble        x,
+               gdouble        y,
+               gdouble        tol)
+{
+  gint    best = -1;
+  gdouble bd   = tol;
+
+  for (gint i = 0; i < n; i++)
+    {
+      gdouble d = hypot (pts[2 * i] - x, pts[2 * i + 1] - y);
+
+      if (d <= bd)
+        {
+          bd   = d;
+          best = i;
+        }
+    }
+
+  return best;
+}
