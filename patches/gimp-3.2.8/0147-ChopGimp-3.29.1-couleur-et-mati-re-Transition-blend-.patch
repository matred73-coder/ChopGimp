+
+static void
+blend_spec_get (ChopGimpVObject      *g,
+                ChopGimpBlendSpacing *spacing,
+                gdouble              *value,
+                gboolean             *orient_path)
+{
+  gchar *v;
+
+  *spacing     = CHOPGIMP_BLEND_SMOOTH;
+  *value       = 0.0;
+  *orient_path = FALSE;
+
+  if ((v = spec_word (g->blend, "steps")))
+    {
+      *spacing = CHOPGIMP_BLEND_STEPS;
+      *value   = g_ascii_strtod (v, NULL);
+      g_free (v);
+    }
+  else if ((v = spec_word (g->blend, "distance")))
+    {
+      *spacing = CHOPGIMP_BLEND_DISTANCE;
+      *value   = g_ascii_strtod (v, NULL);
+      g_free (v);
+    }
+
+  if ((v = spec_word (g->blend, "orient")))
+    {
+      *orient_path = ! strcmp (v, "path");
+      g_free (v);
+    }
+}
+
+static void
+blend_spec_set (ChopGimpVObject      *g,
+                ChopGimpBlendSpacing  spacing,
+                gdouble               value,
+                gboolean              orient_path,
+                const gchar          *sig)
+{
+  GString *s = g_string_new ("blend");
+
+  if (spacing == CHOPGIMP_BLEND_STEPS)
+    {
+      g_string_append (s, " steps=");
+      put_dbl (s, CLAMP (value, 1, 1000));
+    }
+  else if (spacing == CHOPGIMP_BLEND_DISTANCE)
+    {
+      g_string_append (s, " distance=");
+      put_dbl (s, MAX (value, 0.1));
+    }
+  else
+    g_string_append (s, " smooth=1");
+
+  g_string_append_printf (s, " orient=%s sig=%s", orient_path ? "path" : "page",
+                          sig ? sig : "");
+
+  /*  3.29.1: the replaced spine (« Remplacer le tracé de base ») stays  */
+  {
+    gchar *spine = spec_word (g->blend, "spine");
+
+    if (spine)
+      g_string_append_printf (s, " spine=%s", spine);
+    g_free (spine);
+  }
+
+  g_free (g->blend);
+  g->blend = g_string_free (s, FALSE);
+}
+
+/*  the path of @o in the local space of the group @g (floating)  */
+static GimpPath *
+path_in (GimpVectorLayer *layer,
+         ChopGimpVObject *o,
+         ChopGimpVObject *g)
+{
+  GimpPath    *wp = chopgimp_vobject_get_world_path (layer, o, TRUE);
+  GimpMatrix3  inv;
+
+  if (! wp)
+    return NULL;
+
+  chopgimp_vobject_get_world_matrix (g, &inv);
+  gimp_matrix3_invert (&inv);
+  chopgimp_vpath_transform (wp, &inv);
+
+  return wp;
+}
+
+/*  @n points evenly spaced along @stroke (GimpCoords)  */
+static GArray *
+resample (GimpStroke *stroke,
+          gint        n,
+          gboolean   *closed)
+{
+  GArray *poly = gimp_stroke_interpolate (stroke, 0.2, closed);
+  GArray *out;
+  gdouble total = 0.0;
+  gint    seg   = 0;
+  gdouble run   = 0.0;
+
+  out = g_array_new (FALSE, TRUE, sizeof (GimpCoords));
+
+  if (! poly || poly->len == 0)
+    {
+      if (poly)
+        g_array_free (poly, TRUE);
+      return out;
+    }
+
+  if (*closed)
+    {
+      GimpCoords first = g_array_index (poly, GimpCoords, 0);
+
+      g_array_append_val (poly, first);
+    }
+
+  for (guint i = 1; i < poly->len; i++)
+    {
+      GimpCoords *a = &g_array_index (poly, GimpCoords, i - 1);
+      GimpCoords *b = &g_array_index (poly, GimpCoords, i);
+
+      total += hypot (b->x - a->x, b->y - a->y);
+    }
+
+  for (gint k = 0; k < n; k++)
+    {
+      gdouble    target = (*closed ? total * k / n : total * k / MAX (1, n - 1));
+      GimpCoords c      = g_array_index (poly, GimpCoords, 0);
+
+      while (seg + 1 < (gint) poly->len)
+        {
+          GimpCoords *a   = &g_array_index (poly, GimpCoords, seg);
+          GimpCoords *b   = &g_array_index (poly, GimpCoords, seg + 1);
+          gdouble     len = hypot (b->x - a->x, b->y - a->y);
+
+          if (run + len >= target || seg + 2 == (gint) poly->len)
+            {
+              gdouble t = len > 1e-9 ? CLAMP ((target - run) / len, 0.0, 1.0) : 0.0;
+
+              c   = *a;
+              c.x = a->x + (b->x - a->x) * t;
+              c.y = a->y + (b->y - a->y) * t;
+              break;
+            }
+
+          run += len;
+          seg++;
+        }
+
+      g_array_append_val (out, c);
+    }
+
+  g_array_free (poly, TRUE);
+
+  return out;
+}
+
+/*  bezier coords (control, anchor, control …) of a polyline  */
+static GArray *
+polyline_coords (GArray *pts)
+{
+  GArray *coords = g_array_new (FALSE, TRUE, sizeof (GimpCoords));
+
+  for (guint i = 0; i < pts->len; i++)
+    {
+      GimpCoords c = g_array_index (pts, GimpCoords, i);
+
+      g_array_append_val (coords, c);
+      g_array_append_val (coords, c);
+      g_array_append_val (coords, c);
+    }
+
+  return coords;
+}
+
+/*  the control points of a stroke as GimpCoords  */
+static GArray *
+stroke_coords (GimpStroke *stroke,
+               gboolean   *closed)
+{
+  GArray *anchors = gimp_stroke_control_points_get (stroke, closed);
+  GArray *coords  = g_array_new (FALSE, TRUE, sizeof (GimpCoords));
+
+  for (guint i = 0; anchors && i < anchors->len; i++)
+    g_array_append_val (coords, g_array_index (anchors, GimpAnchor, i).position);
+
+  if (anchors)
+    g_array_free (anchors, TRUE);
+
+  return coords;
+}
+
+/*  the path at @t between @a and @b (floating)  */
+static GimpPath *
+lerp_path (GimpImage *image,
+           GimpPath  *a,
+           GimpPath  *b,
+           gdouble    t)
+{
+  GimpPath   *out = gimp_path_new (image, "");
+  GimpStroke *sa  = NULL, *sb = NULL;
+
+  for (;;)
+    {
+      GArray    *ca, *cb, *res;
+      gboolean   closed_a = FALSE, closed_b = FALSE;
+      GimpStroke *s;
+
+      sa = gimp_path_stroke_get_next (a, sa);
+      sb = gimp_path_stroke_get_next (b, sb);
+
+      if (! sa || ! sb)
+        break;
+
+      ca = stroke_coords (sa, &closed_a);
+      cb = stroke_coords (sb, &closed_b);
+
+      /*  the same structure: the control points; else 64 points each  */
+      if (ca->len != cb->len || closed_a != closed_b)
+        {
+          GArray *pa, *pb;
+          const gint N = 64;
+
+          g_array_free (ca, TRUE);
+          g_array_free (cb, TRUE);
+
+          pa = resample (sa, N, &closed_a);
+          pb = resample (sb, N, &closed_b);
+
+          /*  closed: start B at its point nearest to A's start  */
+          if (closed_a && closed_b && pa->len > 0 && pb->len == pa->len)
+            {
+              GimpCoords *p0   = &g_array_index (pa, GimpCoords, 0);
+              gint        best = 0;
+              gdouble     bd   = G_MAXDOUBLE;
+              GArray     *rot  = g_array_new (FALSE, TRUE, sizeof (GimpCoords));
+
+              for (guint k = 0; k < pb->len; k++)
+                {
+                  GimpCoords *q = &g_array_index (pb, GimpCoords, k);
+                  gdouble     d = hypot (q->x - p0->x, q->y - p0->y);
+
+                  if (d < bd)
+                    {
+                      bd   = d;
+                      best = k;
+                    }
+                }
+
+              for (guint k = 0; k < pb->len; k++)
+                g_array_append_val (rot, g_array_index (pb, GimpCoords,
+                                                        (best + k) % pb->len));
+
+              g_array_free (pb, TRUE);
+              pb = rot;
+            }
+
+          ca = polyline_coords (pa);
+          cb = polyline_coords (pb);
+          g_array_free (pa, TRUE);
+          g_array_free (pb, TRUE);
+        }
+
+      /*  3.29.1 finition: two closed shapes of the same structure (a
+       *  circle and a square, 4 nodes each): B's nodes shifted (by whole
+       *  nodes: 3 control points) and possibly reversed so that they sit
+       *  nearest to A's, else the steps twist into stars
+       */
+      if (closed_a && closed_b && ca->len == cb->len && ca->len >= 6 && ca->len % 3 == 0)
+        {
+          guint    n     = ca->len;
+          guint    best  = 0;
+          gboolean brev  = FALSE;
+          gdouble  bd    = G_MAXDOUBLE;
+
+          for (gint rev = 0; rev < 2; rev++)
+            for (guint sh = 0; sh < n; sh += 3)
+              {
+                gdouble d = 0.0;
+
+                for (guint k = 0; k < n; k++)
+                  {
+                    guint       j = rev ? (n - 1 - ((k + sh) % n)) : ((k + sh) % n);
+                    GimpCoords *p = &g_array_index (ca, GimpCoords, k);
+                    GimpCoords *q = &g_array_index (cb, GimpCoords, j);
+
+                    d += (q->x - p->x) * (q->x - p->x) + (q->y - p->y) * (q->y - p->y);
+                  }
+
+                if (d < bd - 1e-9)
+                  {
+                    bd   = d;
+                    best = sh;
+                    brev = rev;
+                  }
+              }
+
+          if (best != 0 || brev)
+            {
+              GArray *rot = g_array_new (FALSE, TRUE, sizeof (GimpCoords));
+
+              for (guint k = 0; k < n; k++)
+                {
+                  guint j = brev ? (n - 1 - ((k + best) % n)) : ((k + best) % n);
+
+                  g_array_append_val (rot, g_array_index (cb, GimpCoords, j));
+                }
+
+              g_array_free (cb, TRUE);
+              cb = rot;
+            }
+        }
+
+      res = g_array_new (FALSE, TRUE, sizeof (GimpCoords));
+
+      for (guint k = 0; k < MIN (ca->len, cb->len); k++)
+        {
+          GimpCoords c = g_array_index (ca, GimpCoords, k);
+          GimpCoords d = g_array_index (cb, GimpCoords, k);
+
+          c.x += (d.x - c.x) * t;
+          c.y += (d.y - c.y) * t;
+          g_array_append_val (res, c);
+        }
+
+      if (res->len >= 3)
+        {
+          s = gimp_bezier_stroke_new_from_coords ((GimpCoords *) res->data,
+                                                  res->len, closed_a);
+          gimp_path_stroke_add (out, s);
+          g_object_unref (s);
+        }
+
+      g_array_free (ca, TRUE);
+      g_array_free (cb, TRUE);
+      g_array_free (res, TRUE);
+    }
+
+  return out;
+}
+
+/*  the style at @t: @a's, with the colors, widths and opacities mixed
+ *  with @b's entries of the same kind and position
+ */
+static gboolean
+paint_is_gradient (const ChopGimpPaint *p)
+{
+  return ((p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+           p->type == CHOPGIMP_PAINT_RADIAL_GRADIENT) &&
+          p->stops && p->stops->len > 0);
+}
+
+/*  the sRGB color of a color or gradient paint at @t (0..1)  */
+static void
+paint_sample_srgb (const ChopGimpPaint *p,
+                   gdouble              t,
+                   gdouble              out[4])
+{
+  ChopGimpGradientStop *a = NULL, *b = NULL;
+  gdouble               ca[4], cb[4];
+
+  if (! paint_is_gradient (p))
+    {
+      if (p->color)
+        color_to_srgb (p->color, out);
+      else
+        out[0] = out[1] = out[2] = 0.0, out[3] = 1.0;
+      return;
+    }
+
+  t = CLAMP (t, 0.0, 1.0);
+
+  for (guint i = 0; i < p->stops->len; i++)
+    {
+      ChopGimpGradientStop *st = &g_array_index (p->stops, ChopGimpGradientStop, i);
+
+      if (st->offset <= t)
+        a = st;
+      if (st->offset >= t && ! b)
+        b = st;
+    }
+
+  if (! a)
+    a = b;
+  if (! b)
+    b = a;
+
+  color_to_srgb (a->color, ca);
+  color_to_srgb (b->color, cb);
+
+  if (b->offset - a->offset > 1e-9)
+    mix (ca, cb, (t - a->offset) / (b->offset - a->offset), out);
+  else
+    memcpy (out, ca, sizeof (ca));
+}
+
+/*  3.29.1 finition: a step between a gradient and a gradient (or a
+ *  color): the stops of the gradient with the most stops, the colors of
+ *  both sampled there and mixed; geometry mixed when both are gradients
+ *  of the same type
+ */
+static void
+lerp_gradient (ChopGimpPaint       *out,
+               const ChopGimpPaint *a,
+               const ChopGimpPaint *b,
+               gdouble              t)
+{
+  const ChopGimpPaint *ref;
+  ChopGimpPaint        res = { 0, };
+  gboolean             both;
+
+  both = paint_is_gradient (a) && paint_is_gradient (b) && a->type == b->type;
+
+  if (paint_is_gradient (a) && paint_is_gradient (b))
+    ref = (b->stops->len > a->stops->len) ? b : a;
+  else
+    ref = paint_is_gradient (a) ? a : b;
+
+  res.type = (paint_is_gradient (a) && paint_is_gradient (b) && a->type != b->type) ?
+             (t < 0.5 ? a->type : b->type) : ref->type;
+  res.x1   = ref->x1;
+  res.y1   = ref->y1;
+  res.x2   = ref->x2;
+  res.y2   = ref->y2;
+  res.r    = ref->r;
+
+  if (both)
+    {
+      res.x1 = a->x1 + (b->x1 - a->x1) * t;
+      res.y1 = a->y1 + (b->y1 - a->y1) * t;
+      res.x2 = a->x2 + (b->x2 - a->x2) * t;
+      res.y2 = a->y2 + (b->y2 - a->y2) * t;
+      res.r  = a->r  + (b->r  - a->r)  * t;
+    }
+
+  for (guint i = 0; i < ref->stops->len; i++)
+    {
+      gdouble    off = g_array_index (ref->stops, ChopGimpGradientStop, i).offset;
+      gdouble    ca[4], cb[4], cm[4];
+      GeglColor *c;
+
+      /*  the same number of stops: offsets mixed too  */
+      if (both && a->stops->len == b->stops->len)
+        off = g_array_index (a->stops, ChopGimpGradientStop, i).offset +
+              (g_array_index (b->stops, ChopGimpGradientStop, i).offset -
+               g_array_index (a->stops, ChopGimpGradientStop, i).offset) * t;
+
+      if (both && a->stops->len == b->stops->len)
+        {
+          color_to_srgb (g_array_index (a->stops, ChopGimpGradientStop, i).color, ca);
+          color_to_srgb (g_array_index (b->stops, ChopGimpGradientStop, i).color, cb);
+        }
+      else
+        {
+          paint_sample_srgb (a, off, ca);
+          paint_sample_srgb (b, off, cb);
+        }
+
+      mix (ca, cb, t, cm);
+      c = srgb_to_color (cm);
+      chopgimp_vpaint_add_stop (&res, off, c);
+      g_object_unref (c);
+    }
+
+  chopgimp_vpaint_copy (out, &res);
+  chopgimp_vpaint_clear (&res);
+  if (res.stops)
+    g_array_free (res.stops, TRUE);
+}
+
+static void
+lerp_style (ChopGimpVStyle       *out,
+            const ChopGimpVStyle *a,
+            const ChopGimpVStyle *b,
+            gdouble               t)
+{
+  gint na, nb;
+
+  chopgimp_vstyle_copy (out, a);
+
+  na = chopgimp_vstyle_get_n_entries (out);
+  nb = chopgimp_vstyle_get_n_entries (b);
+
+  for (gint k = 0; k < na && k < nb; k++)
+    {
+      ChopGimpVEntry *e = chopgimp_vstyle_get_entry (out, k);
+      ChopGimpVEntry *f = chopgimp_vstyle_get_entry (b, k);
+
+      if (e->kind != f->kind)
+        continue;
+
+      e->opacity += (f->opacity - e->opacity) * t;
+
+      if (e->kind == CHOPGIMP_VENTRY_STROKE)
+        e->width += (f->width - e->width) * t;
+
+      if (e->paint.type == CHOPGIMP_PAINT_COLOR && f->paint.type == CHOPGIMP_PAINT_COLOR)
+        {
+          gdouble    ca[4], cb[4], cm[4];
+          GeglColor *c;
+
+          color_to_srgb (e->paint.color, ca);
+          color_to_srgb (f->paint.color, cb);
+          mix (ca, cb, t, cm);
+          c = srgb_to_color (cm);
+          chopgimp_vpaint_set_color (&e->paint, c);
+          g_object_unref (c);
+        }
+      else if ((paint_is_gradient (&e->paint) || paint_is_gradient (&f->paint)) &&
+               (paint_is_gradient (&e->paint) || e->paint.type == CHOPGIMP_PAINT_COLOR) &&
+               (paint_is_gradient (&f->paint) || f->paint.type == CHOPGIMP_PAINT_COLOR))
+        {
+          ChopGimpPaint tmp = { 0, };
+
+          lerp_gradient (&tmp, &e->paint, &f->paint, t);
+          chopgimp_vpaint_copy (&e->paint, &tmp);
+          chopgimp_vpaint_clear (&tmp);
+          if (tmp.stops)
+            g_array_free (tmp.stops, TRUE);
+        }
+      else if (e->paint.type == CHOPGIMP_PAINT_NONE &&
+               f->paint.type == CHOPGIMP_PAINT_COLOR)
+        {
+          /*  none → color: the color, fading in  */
+          chopgimp_vpaint_set_color (&e->paint, f->paint.color);
+          e->opacity = f->opacity * t;
+        }
+    }
+}
+
+/*  how many steps between two keys  */
+static gint
+blend_n_steps (GimpVectorLayer      *layer,
+               ChopGimpVObject      *a,
+               ChopGimpVObject      *b,
+               ChopGimpBlendSpacing  spacing,
+               gdouble               value)
+{
+  gdouble ax1, ay1, ax2, ay2, bx1, by1, bx2, by2;
+  gdouble dist = 0.0;
+
+  if (spacing == CHOPGIMP_BLEND_STEPS)
+    return CLAMP ((gint) (value + 0.5), 1, 1000);
+
+  if (chopgimp_vobject_get_bounds (layer, a, FALSE, &ax1, &ay1, &ax2, &ay2) &&
+      chopgimp_vobject_get_bounds (layer, b, FALSE, &bx1, &by1, &bx2, &by2))
+    dist = hypot ((ax1 + ax2 - bx1 - bx2) / 2, (ay1 + ay2 - by1 - by2) / 2);
+
+  if (spacing == CHOPGIMP_BLEND_DISTANCE)
+    return CLAMP ((gint) (dist / MAX (value, 0.1)), 1, 1000);
+
+  /*  « Couleur lissée »: enough steps for the color difference to look
+   *  continuous (one per 1/128 of the largest difference), at least one
+   *  per 4 px of distance when the colors are the same
+   */
+  {
+    ChopGimpVEntry *fa = (a->kind == CHOPGIMP_VOBJECT_PATH) ? chopgimp_vstyle_get_fill (&a->style) : NULL;
+    ChopGimpVEntry *fb = (b->kind == CHOPGIMP_VOBJECT_PATH) ? chopgimp_vstyle_get_fill (&b->style) : NULL;
+    gdouble         diff = 0.0;
+
+    if (fa && fb && fa->paint.color && fb->paint.color)
+      {
+        gdouble ca[4], cb[4];
+
+        color_to_srgb (fa->paint.color, ca);
+        color_to_srgb (fb->paint.color, cb);
+
+        for (gint i = 0; i < 3; i++)
+          diff = MAX (diff, fabs (ca[i] - cb[i]));
+      }
+
+    if (diff > 0.01)
+      return CLAMP ((gint) (diff * 128), 2, 256);
+
+    return CLAMP ((gint) (dist / 4.0), 2, 256);
+  }
+}
+
+/*  the signature of a blend group's keys and settings  */
+static gchar *
+blend_signature (GimpVectorLayer *layer,
+                 ChopGimpVObject *g,
+                 GPtrArray       *keys)
+{
+  GString *s = g_string_new (NULL);
+  gchar   *sig;
+
+  {
+    gchar *steps = spec_word (g->blend, "steps");
+    gchar *dist  = spec_word (g->blend, "distance");
+    gchar *or    = spec_word (g->blend, "orient");
+
+    g_string_append_printf (s, "%s|%s|%s;", steps ? steps : "", dist ? dist : "",
+                            or ? or : "");
+    g_free (steps);
+    g_free (dist);
+    g_free (or);
+  }
+
+  for (guint i = 0; i < keys->len; i++)
+    {
+      GList *one = g_list_prepend (NULL, g_ptr_array_index (keys, i));
+      gchar *xml = chopgimp_vobjects_to_xml (one);
+      GimpPath *p = path_in (layer, g_ptr_array_index (keys, i), g);
+
+      g_string_append (s, xml);
+
+      if (p)
+        {
+          gchar *d = chopgimp_vpath_to_d (p);
+
+          g_object_ref_sink (p);
+          g_string_append (s, d);
+          g_free (d);
+          g_object_unref (p);
+        }
+
+      g_free (xml);
+      g_list_free (one);
+    }
+
+  sig = g_compute_checksum_for_string (G_CHECKSUM_MD5, s->str, -1);
+  g_string_free (s, TRUE);
+
+  return sig;
+}
+
+/*  3.29.1 « Remplacer le tracé de base »: the spine, a polyline in the
+ *  group's space (« x,y;x,y;… » in the blend spec) → its points and
+ *  cumulated lengths; NULL when none
+ */
+static GArray *
+spine_parse (const gchar *spec,
+             gdouble     *length)
+{
+  gchar  *v = spec_word (spec, "spine");
+  gchar **pts;
+  GArray *a;
+
+  *length = 0.0;
+
+  if (! v)
+    return NULL;
+
+  a   = g_array_new (FALSE, FALSE, sizeof (gdouble) * 3);
+  pts = g_strsplit (v, ";", -1);
+
+  for (gint i = 0; pts[i]; i++)
+    {
+      gdouble p[3];
+      gchar  *comma = strchr (pts[i], ',');
+
+      if (! comma)
+        continue;
+
+      p[0] = g_ascii_strtod (pts[i], NULL);
+      p[1] = g_ascii_strtod (comma + 1, NULL);
+      p[2] = 0.0;
+
+      if (a->len > 0)
+        {
+          gdouble *q = &((gdouble *) a->data)[(a->len - 1) * 3];
+
+          p[2] = q[2] + hypot (p[0] - q[0], p[1] - q[1]);
+        }
+
+      g_array_append_vals (a, p, 1);
+    }
+
+  g_strfreev (pts);
+  g_free (v);
+
+  if (a->len < 2)
+    {
+      g_array_free (a, TRUE);
+      return NULL;
+    }
+
+  *length = ((gdouble *) a->data)[(a->len - 1) * 3 + 2];
+
+  if (*length <= 1e-6)
+    {
+      g_array_free (a, TRUE);
+      return NULL;
+    }
+
+  return a;
+}
+
+/*  the point of the spine at @t (0..1 of its length)  */
+static void
+spine_at (GArray  *spine,
+          gdouble  length,
+          gdouble  t,
+          gdouble *x,
+          gdouble *y)
+{
+  gdouble  d = CLAMP (t, 0.0, 1.0) * length;
+  gdouble *v = (gdouble *) spine->data;
+
+  for (guint i = 1; i < spine->len; i++)
+    {
+      gdouble *a = &v[(i - 1) * 3];
+      gdouble *b = &v[i * 3];
+
+      if (d <= b[2] || i + 1 == spine->len)
+        {
+          gdouble u = (b[2] - a[2] > 1e-9) ? (d - a[2]) / (b[2] - a[2]) : 0.0;
+
+          u  = CLAMP (u, 0.0, 1.0);
+          *x = a[0] + (b[0] - a[0]) * u;
+          *y = a[1] + (b[1] - a[1]) * u;
+          return;
+        }
+    }
+
+  *x = v[0];
+  *y = v[1];
+}
+
+/*  moves a step by the spine's departure from its chord at @t: the keys
+ *  stay where they are, the steps between them follow the spine's curve
+ */
+static void
+spine_offset_path (GimpPath *p,
+                   GArray   *spine,
+                   gdouble   length,
+                   gdouble   t)
+{
+  gdouble     x0, y0, x1, y1, xt, yt, dx, dy;
+  GimpStroke *st = NULL;
+
+  spine_at (spine, length, 0.0, &x0, &y0);
+  spine_at (spine, length, 1.0, &x1, &y1);
+  spine_at (spine, length, t,   &xt, &yt);
+
+  dx = xt - (x0 + (x1 - x0) * t);
+  dy = yt - (y0 + (y1 - y0) * t);
+
+  if (fabs (dx) < 1e-9 && fabs (dy) < 1e-9)
+    return;
+
+  while ((st = gimp_path_stroke_get_next (p, st)))
+    gimp_stroke_translate (st, dx, dy);
+}
+
+static gboolean
+blend_regen (GimpVectorLayer *layer,
+             ChopGimpVObject *g,
+             gboolean         force)
+{
+  GimpImage            *image = gimp_item_get_image (GIMP_ITEM (layer));
+  GPtrArray            *keys  = g_ptr_array_new ();
+  GPtrArray            *made;
+  ChopGimpBlendSpacing  spacing;
+  gdouble               value;
+  gboolean              orient;
+  gchar                *sig, *old;
+  GArray               *spine     = NULL;
+  gdouble               spine_len = 0.0;
+
+  for (guint i = 0; i < g->children->len; i++)
+    {
+      ChopGimpVObject *c = g_ptr_array_index (g->children, i);
+
+      if (! is_step (c))
+        g_ptr_array_add (keys, c);
+    }
+
+  if (keys->len < 2)
+    {
+      g_ptr_array_free (keys, TRUE);
+      return FALSE;
+    }
+
+  blend_spec_get (g, &spacing, &value, &orient);
+
+  sig = blend_signature (layer, g, keys);
+  old = spec_word (g->blend, "sig");
+
+  if (! force && ! g_strcmp0 (sig, old))
+    {
+      g_free (sig);
+      g_free (old);
+      g_ptr_array_free (keys, TRUE);
+      return FALSE;
+    }
+
+  g_free (old);
+
+  made = g_ptr_array_new ();
+
+  spine = spine_parse (g->blend, &spine_len);
+
+  for (guint i = 0; i < keys->len; i++)
+    {
+      ChopGimpVObject *a = g_ptr_array_index (keys, i);
+
+      g_ptr_array_add (made, chopgimp_vobject_ref (a));
+
+      if (i + 1 < keys->len)
+        {
+          ChopGimpVObject *b  = g_ptr_array_index (keys, i + 1);
+          GimpPath        *pa, *pb;
+          gint             n;
+
+          /*  groups as keys: their first leaf's look (shape of all)  */
+          if (a->kind != CHOPGIMP_VOBJECT_PATH || b->kind != CHOPGIMP_VOBJECT_PATH)
+            continue;
+
+          pa = path_in (layer, a, g);
+          pb = path_in (layer, b, g);
+
+          if (! pa || ! pb)
+            {
+              if (pa)
+                {
+                  g_object_ref_sink (pa);
+                  g_object_unref (pa);
+                }
+              if (pb)
+                {
+                  g_object_ref_sink (pb);
+                  g_object_unref (pb);
+                }
+              continue;
+            }
+
+          g_object_ref_sink (pa);
+          g_object_ref_sink (pb);
+
+          n = blend_n_steps (layer, a, b, spacing, value);
+
+          for (gint k = 1; k <= n; k++)
+            {
+              gdouble          t = (gdouble) k / (n + 1);
+              GimpPath        *p = lerp_path (image, pa, pb, t);
+              ChopGimpVStyle   st;
+              ChopGimpVObject *o;
+              gchar           *name = g_strdup_printf (_("Étape %d"), k);
+
+              if (spine)
+                spine_offset_path (p, spine, spine_len,
+                                   (i + t) / (gdouble) (keys->len - 1));
+
+              chopgimp_vstyle_init (&st);
+              lerp_style (&st, &a->style, &b->style, t);
+
+              o = chopgimp_vobject_new_path (image, p, name, &st);
+              o->blend   = g_strdup ("step");
+              o->locked  = TRUE;
+              o->opacity = a->opacity + (b->opacity - a->opacity) * t;
+              g_ptr_array_add (made, o);
+
+              chopgimp_vstyle_clear (&st);
+              g_free (name);
+            }
+
+          g_object_unref (pa);
+          g_object_unref (pb);
+        }
+    }
+
+  /*  in place: key, its steps, the next key …  */
+  for (guint i = 0; i < g->children->len; i++)
+    ((ChopGimpVObject *) g_ptr_array_index (g->children, i))->parent = NULL;
+
+  g_ptr_array_set_size (g->children, 0);
+
+  for (guint i = 0; i < made->len; i++)
+    {
+      ChopGimpVObject *o = g_ptr_array_index (made, i);
+
+      o->parent = g;
+      g_ptr_array_add (g->children, o);
+    }
+
+  g_ptr_array_free (made, TRUE);
+  g_ptr_array_free (keys, TRUE);
+
+  if (spine)
+    g_array_free (spine, TRUE);
+
+  blend_spec_set (g, spacing, value, orient, sig);
+  g_free (sig);
+
+  return TRUE;
+}
+
+static void
+collect_blends (ChopGimpVObject  *o,
+                GList           **list)
+{
+  if (o->kind != CHOPGIMP_VOBJECT_GROUP)
+    return;
+
+  if (is_blend_group (o))
+    *list = g_list_prepend (*list, o);
+
+  for (guint i = 0; i < o->children->len; i++)
+    collect_blends (g_ptr_array_index (o->children, i), list);
+}
+
+gboolean
+chopgimp_vblend_refresh (GimpVectorLayer *layer)
+{
+  ChopGimpVObject *root = chopgimp_vlayer_get_root (layer);
+  GList           *groups = NULL;
+  gboolean         any    = FALSE;
+
+  if (! root)
+    return FALSE;
+
+  collect_blends (root, &groups);
+
+  for (GList *l = groups; l; l = l->next)
+    any |= blend_regen (layer, l->data, FALSE);
+
+  g_list_free (groups);
+
+  return any;
+}
+
+gboolean
+chopgimp_vblend_can_make (GimpVectorLayer *layer)
+{
+  GList   *list = selected_siblings (layer, 2);
+  gboolean ok   = list != NULL;
+
+  for (GList *l = list; l; l = l->next)
+    if (chopgimp_vblend_group_of (l->data))
+      ok = FALSE;
+
+  g_list_free (list);
+
+  return ok;
+}
+
+static ChopGimpVObject *
+blend_make_ids (GimpVectorLayer *layer,
+                const guint     *ids,
+                gint             n)
+{
+  ChopGimpVObject *g;
+
+  chopgimp_vlayer_push_undo (layer, _("Créer une transition"));
+  chopgimp_vlayer_freeze (layer);
+
+  g = chopgimp_vlayer_group (layer, ids, n, _("Transition"), FALSE);
+
+  if (g)
+    {
+      blend_spec_set (g, CHOPGIMP_BLEND_SMOOTH, 0.0, FALSE, NULL);
+      blend_regen (layer, g, TRUE);
+      chopgimp_vlayer_subtree_changed (layer, g, NULL);
+      chopgimp_vlayer_set_selection (layer, &g->id, 1);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+
+  return g;
+}
+
+ChopGimpVObject *
+chopgimp_vblend_make (GimpVectorLayer *layer)
+{
+  GList           *list = selected_siblings (layer, 2);
+  GArray          *ids;
+  ChopGimpVObject *g;
+
+  if (! list || ! chopgimp_vblend_can_make (layer))
+    {
+      g_list_free (list);
+      return NULL;
+    }
+
+  ids = g_array_new (FALSE, FALSE, sizeof (guint));
+  for (GList *l = list; l; l = l->next)
+    g_array_append_val (ids, ((ChopGimpVObject *) l->data)->id);
+  g_list_free (list);
+
+  g = blend_make_ids (layer, (guint *) ids->data, ids->len);
+  g_array_free (ids, TRUE);
+
+  return g;
+}
+
+ChopGimpVObject *
+chopgimp_vblend_make_between (GimpVectorLayer *layer,
+                              guint            first,
+                              guint            second)
+{
+  ChopGimpVObject *a = chopgimp_vlayer_get_object (layer, first);
+  ChopGimpVObject *b = chopgimp_vlayer_get_object (layer, second);
+  guint            ids[2];
+
+  if (! a || ! b || a == b || a->parent != b->parent ||
+      chopgimp_vblend_group_of (a) || chopgimp_vblend_group_of (b))
+    return NULL;
+
+  /*  bottom → top (the group keeps the stacking order): the first clicked
+   *  is the start of the blend all the same, the order of the keys is
+   *  their stacking order
+   */
+  if (chopgimp_vobject_get_index (a) <= chopgimp_vobject_get_index (b))
+    {
+      ids[0] = first;
+      ids[1] = second;
+    }
+  else
+    {
+      ids[0] = second;
+      ids[1] = first;
+    }
+
+  return blend_make_ids (layer, ids, 2);
+}
+
+gboolean
+chopgimp_vblend_any (GimpVectorLayer *layer)
+{
+  return group_of_selection (layer, is_blend_group) != NULL;
+}
+
+gboolean
+chopgimp_vblend_get_options (GimpVectorLayer      *layer,
+                             ChopGimpBlendSpacing *spacing,
+                             gdouble              *value,
+                             gboolean             *orient_path)
+{
+  ChopGimpVObject *g = group_of_selection (layer, is_blend_group);
+
+  if (! g)
+    return FALSE;
+
+  blend_spec_get (g, spacing, value, orient_path);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vblend_set_options (GimpVectorLayer      *layer,
+                             ChopGimpBlendSpacing  spacing,
+                             gdouble               value,
+                             gboolean              orient_path)
+{
+  ChopGimpVObject *g = group_of_selection (layer, is_blend_group);
+
+  if (! g)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Options de transition"));
+  blend_spec_set (g, spacing, value, orient_path, NULL);
+  blend_regen (layer, g, TRUE);
+  chopgimp_vlayer_subtree_changed (layer, g, NULL);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vblend_release (GimpVectorLayer *layer)
+{
+  ChopGimpVObject *g = group_of_selection (layer, is_blend_group);
+  GPtrArray       *keep;
+
+  if (! g)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Libérer la transition"));
+
+  keep = g_ptr_array_new ();
+
+  for (guint i = 0; i < g->children->len; i++)
+    {
+      ChopGimpVObject *c = g_ptr_array_index (g->children, i);
+
+      if (is_step (c))
+        c->parent = NULL;
+      else
+        g_ptr_array_add (keep, chopgimp_vobject_ref (c));
+    }
+
+  g_ptr_array_set_size (g->children, 0);
+
+  for (guint i = 0; i < keep->len; i++)
+    g_ptr_array_add (g->children, g_ptr_array_index (keep, i));
+
+  g_ptr_array_free (keep, TRUE);
+  g_clear_pointer (&g->blend, g_free);
+
+  chopgimp_vlayer_subtree_changed (layer, g, NULL);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vblend_expand (GimpVectorLayer *layer)
+{
+  ChopGimpVObject *g = group_of_selection (layer, is_blend_group);
+
+  if (! g)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Décomposer la transition"));
+
+  for (guint i = 0; i < g->children->len; i++)
+    {
+      ChopGimpVObject *c = g_ptr_array_index (g->children, i);
+
+      if (is_step (c))
+        {
+          g_clear_pointer (&c->blend, g_free);
+          c->locked = FALSE;
+        }
+    }
+
+  g_clear_pointer (&g->blend, g_free);
+  chopgimp_vlayer_subtree_changed (layer, g, NULL);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vblend_replace_spine (GimpVectorLayer *layer)
+{
+  ChopGimpVObject *g     = group_of_selection (layer, is_blend_group);
+  ChopGimpVObject *spine = NULL;
+  GList           *sel;
+  GimpPath        *local;
+  GimpStroke      *st;
+  GString         *s;
+  gchar           *rest;
+
+  if (! g)
+    return FALSE;
+
+  /*  the selected path object outside the blend group  */
+  sel = chopgimp_vlayer_get_selected_objects (layer);
+
+  for (GList *l = sel; l && ! spine; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      ChopGimpVObject *p;
+
+      for (p = o; p && p != g; p = p->parent)
+        ;
+
+      if (! p && o->kind == CHOPGIMP_VOBJECT_PATH)
+        spine = o;
+    }
+
+  g_list_free (sel);
+
+  if (! spine || ! (local = path_in (layer, spine, g)))
+    return FALSE;
+
+  g_object_ref_sink (local);
+
+  s = g_string_new (NULL);
+
+  if ((st = gimp_path_stroke_get_next (local, NULL)))
+    {
+      gboolean closed = FALSE;
+      GArray  *pts    = gimp_stroke_interpolate (st, 0.5, &closed);
+
+      for (guint i = 0; pts && i < pts->len; i++)
+        {
+          GimpCoords *c = &g_array_index (pts, GimpCoords, i);
+
+          if (s->len)
+            g_string_append_c (s, ';');
+          put_dbl (s, c->x);
+          g_string_append_c (s, ',');
+          put_dbl (s, c->y);
+        }
+
+      if (pts)
+        g_array_free (pts, TRUE);
+    }
+
+  g_object_unref (local);
+
+  if (! s->len)
+    {
+      g_string_free (s, TRUE);
+      return FALSE;
+    }
+
+  chopgimp_vlayer_push_undo (layer, _("Remplacer le tracé de base"));
+
+  /*  the spine word replaced, the object used as spine removed  */
+  {
+    gchar  **words = g_strsplit (g->blend ? g->blend : "blend", " ", -1);
+    GString *b     = g_string_new (NULL);
+
+    for (gint i = 0; words[i]; i++)
+      if (strncmp (words[i], "spine=", 6) && *words[i])
+        g_string_append_printf (b, "%s%s", b->len ? " " : "", words[i]);
+
+    g_string_append_printf (b, " spine=%s", s->str);
+    rest = g_string_free (b, FALSE);
+    g_strfreev (words);
+  }
+
+  g_free (g->blend);
+  g->blend = rest;
+  g_string_free (s, TRUE);
+
+  chopgimp_vlayer_remove (layer, spine->id, FALSE);
+
+  blend_regen (layer, g, TRUE);
+  chopgimp_vlayer_subtree_changed (layer, g, NULL);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vblend_reverse (GimpVectorLayer *layer)
+{
+  ChopGimpVObject *g = group_of_selection (layer, is_blend_group);
+  guint            n;
+
+  if (! g)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Inverser la transition"));
+
+  n = g->children->len;
+
+  for (guint i = 0; i < n / 2; i++)
+    {
+      gpointer tmp = g->children->pdata[i];
+
+      g->children->pdata[i]         = g->children->pdata[n - 1 - i];
+      g->children->pdata[n - 1 - i] = tmp;
+    }
+
+  blend_regen (layer, g, TRUE);
+  chopgimp_vlayer_subtree_changed (layer, g, NULL);
+
+  return TRUE;
+}
