+                                              GVariant   *value,
+                                              gpointer    data);
+void   vector_objects_pattern_edit_cmd_callback (GimpAction *action,
+                                              GVariant   *value,
+                                              gpointer    data);
+void   vector_objects_pattern_finish_cmd_callback (GimpAction *action,
+                                              GVariant   *value,
+                                              gpointer    data);
+void   vector_objects_pattern_options_cmd_callback (GimpAction *action,
+                                              GVariant   *value,
+                                              gpointer    data);
+void   vector_objects_pattern_apply_cmd_callback (GimpAction *action,
+                                              GVariant   *value,
+                                              gpointer    data);
+
diff --git a/app/dialogs/chopgimp-material-dialogs.c b/app/dialogs/chopgimp-material-dialogs.c
