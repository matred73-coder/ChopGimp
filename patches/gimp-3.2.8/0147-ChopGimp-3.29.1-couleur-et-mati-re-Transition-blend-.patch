+ *  specs (g_strfreev); add / replace by name
+ */
+gchar          ** chopgimp_vpatterns_list           (GimpImage            *image);
+void              chopgimp_vpatterns_store          (GimpImage            *image,
+                                                     const gchar          *spec);
+/*  « Modifier le motif »: the tile's objects are placed in the layer in a
+ *  group « pattern-edit » (isolated); « Terminer » puts them back in the
+ *  pattern (and the paints using it). FALSE when nothing to do.
+ */
+gboolean          chopgimp_vmaterial_pattern_edit   (GimpVectorLayer      *layer);
+gboolean          chopgimp_vmaterial_pattern_finish (GimpVectorLayer      *layer);
+gboolean          chopgimp_vmaterial_pattern_editing (GimpVectorLayer     *layer);
+
+/*  ─── « Transition » (blend) ────────────────────────────────────────── */
+
+typedef enum
+{
+  CHOPGIMP_BLEND_SMOOTH,      /* « Couleur lissée »: steps from the colors  */
+  CHOPGIMP_BLEND_STEPS,       /* « Nombre d'étapes »                       */
+  CHOPGIMP_BLEND_DISTANCE     /* « Distance spécifiée »                    */
+} ChopGimpBlendSpacing;
+
+/*  the steps of the blend groups whose keys changed; TRUE when some were
+ *  generated again (called by the objects' change hook)
+ */
+gboolean          chopgimp_vblend_refresh           (GimpVectorLayer      *layer);
+/*  the blend group of @object (itself, its group or a step), or NULL  */
+ChopGimpVObject * chopgimp_vblend_group_of          (ChopGimpVObject      *object);
+gboolean          chopgimp_vblend_can_make          (GimpVectorLayer      *layer);
+/*  the selected objects (≥ 2, same parent, bottom → top order) become the
+ *  keys of a blend group
+ */
+ChopGimpVObject * chopgimp_vblend_make              (GimpVectorLayer      *layer);
+/*  @ids of 2 objects of the layer (outil Transition: first, second click)  */
+ChopGimpVObject * chopgimp_vblend_make_between      (GimpVectorLayer      *layer,
+                                                     guint                 first,
+                                                     guint                 second);
+gboolean          chopgimp_vblend_any               (GimpVectorLayer      *layer);
+gboolean          chopgimp_vblend_get_options       (GimpVectorLayer      *layer,
+                                                     ChopGimpBlendSpacing *spacing,
+                                                     gdouble              *value,
+                                                     gboolean             *orient_path);
+gboolean          chopgimp_vblend_set_options       (GimpVectorLayer      *layer,
+                                                     ChopGimpBlendSpacing  spacing,
+                                                     gdouble               value,
+                                                     gboolean              orient_path);
+/*  « Libérer »: the steps are removed, the keys stay grouped  */
+gboolean          chopgimp_vblend_release           (GimpVectorLayer      *layer);
+/*  « Décomposer »: the steps become ordinary objects  */
+gboolean          chopgimp_vblend_expand            (GimpVectorLayer      *layer);
+/*  « Remplacer le tracé de base »: the selected path outside the blend
+ *  group becomes its spine (the steps follow its curve; the path object
+ *  is removed)
+ */
+gboolean          chopgimp_vblend_replace_spine     (GimpVectorLayer      *layer);
+/*  « Inverser l'ordre »: the keys in reverse order (front ↔ back)  */
+gboolean          chopgimp_vblend_reverse           (GimpVectorLayer      *layer);
+
+
+G_END_DECLS
