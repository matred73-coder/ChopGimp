@@ -0,0 +1,241 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vmaterial.h — ChopGimp 3.29.1: « couleur et matière » of the
+ * vector objects (Illustrator):
+ *
+ *  - « Filet de dégradé » (MESH paint): a grid of colored nodes in the
+ *    object's box, drawn as Coons patches (cairo mesh pattern).
+ *    material = « R C;x,y,#rrggbbaa;… » ((R + 1) × (C + 1) nodes, row
+ *    by row, x / y in box units 0..1).
+ *  - « Dégradé libre » (FREEFORM paint): colored points posed freely,
+ *    blended by inverse distance weighting (drawn as a fine mesh).
+ *    material = « points;x,y,#rrggbbaa;… » (box units).
+ *  - vector patterns (VPATTERN paint): objects tiled in a grid, bricks or
+ *    hexagons, image space. material = « type=grid w=W h=H hs=S vs=S
+ *    dim=0 name=N|<chopgimp-vobjects …> » (the objects' XML after « | »,
+ *    so a copied paint keeps its pattern).
+ *  - gradient along / across a stroke;
+ *  - « Masque d'opacité »: luminance → alpha;
+ *  - « Transition » (blend): steps between the key objects of a group,
+ *    recomputed when a key changes (like the live paint groups).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include <cairo.h>
+
+G_BEGIN_DECLS
+
+
+/*  ─── rendering (called by chopgimp-vobject.c) ───────────────────────── */
+
+/*  @box: the object's box (local units: x1 y1 x2 y2); @world: local →
+ *  image (VPATTERN tiles in image space). NULL when nothing to draw.
+ */
+cairo_pattern_t * chopgimp_vmaterial_make_source    (const ChopGimpPaint  *paint,
+                                                     const Babl           *space,
+                                                     GimpPath             *local,
+                                                     const gdouble         box[4],
+                                                     const cairo_matrix_t *world);
+/*  strokes @flat (cairo_copy_path_flat()) with the gradient of @paint
+ *  along (@mode 1) or across (2) it; the line settings of @cr apply
+ */
+void              chopgimp_vmaterial_stroke_gradient (cairo_t             *cr,
+                                                      cairo_path_t        *flat,
+                                                      const ChopGimpPaint *paint,
+                                                      gint                 mode,
+                                                      gdouble              width,
+                                                      const Babl          *space);
+/*  an A8 surface of the luminance × alpha of @argb (CHOPGIMP_OPMASK_*
+ *  flags: CLIP keeps the outside of the mask hidden, else shown; INVERT)
+ */
+cairo_surface_t * chopgimp_vmaterial_luminance_mask (cairo_surface_t      *argb,
+                                                     gint                  flags);
+
+
+/*  ─── « Filet de dégradé » ──────────────────────────────────────────── */
+
+typedef enum
+{
+  CHOPGIMP_MESH_FLAT,         /* « Plat »                                  */
+  CHOPGIMP_MESH_CENTER,       /* « Vers le centre »: white highlight inside */
+  CHOPGIMP_MESH_EDGE          /* « Vers le bord »: white highlight outside  */
+} ChopGimpMeshLook;
+
+typedef struct
+{
+  gdouble x, y;               /* box units                                  */
+  gdouble rgba[4];            /* sRGB, 0..1                                 */
+} ChopGimpMeshNode;
+
+typedef struct
+{
+  gint              rows, cols;     /* patches                              */
+  ChopGimpMeshNode *nodes;          /* (rows + 1) × (cols + 1), row by row  */
+} ChopGimpMesh;
+
+gchar           * chopgimp_vmesh_new_spec           (gint                  rows,
+                                                     gint                  cols,
+                                                     GeglColor            *color,
+                                                     ChopGimpMeshLook      look,
+                                                     gdouble               highlight);
+gboolean          chopgimp_vmesh_parse              (const gchar          *spec,
+                                                     ChopGimpMesh         *mesh);
+gchar           * chopgimp_vmesh_to_spec            (const ChopGimpMesh   *mesh);
+void              chopgimp_vmesh_clear              (ChopGimpMesh         *mesh);
+/*  adds a row and a column through (@x, @y) (box units), the new nodes
+ *  colored with @rgba (NULL: interpolated); FALSE outside the grid
+ */
+gboolean          chopgimp_vmesh_insert             (ChopGimpMesh         *mesh,
+                                                     gdouble               x,
+                                                     gdouble               y,
+                                                     const gdouble        *rgba);
+
+/*  ─── « Dégradé libre » ─────────────────────────────────────────────── */
+
+/*  points: GArray of ChopGimpMeshNode (box units)  */
+GArray          * chopgimp_vfreeform_parse          (const gchar          *spec);
+gchar           * chopgimp_vfreeform_to_spec        (GArray               *points);
+/*  four points: the corners colors of @color lighter / darker  */
+gchar           * chopgimp_vfreeform_new_spec       (GeglColor            *color,
+                                                     GeglColor            *other);
+
+/*  the main color of a spec (first node / point), new GeglColor or NULL  */
+GeglColor       * chopgimp_vmaterial_main_color     (ChopGimpPaintType     type,
+                                                     const gchar          *spec);
+
+/*  ─── commands (one undo step each; FALSE: nothing done) ────────────── */
+
+/*  the primary fill of the selected path objects becomes a mesh of
+ *  @rows × @cols from its color
+ */
+gboolean          chopgimp_vmaterial_make_mesh      (GimpVectorLayer      *layer,
+                                                     gint                  rows,
+                                                     gint                  cols,
+                                                     ChopGimpMeshLook      look,
+                                                     gdouble               highlight);
+gboolean          chopgimp_vmaterial_make_freeform  (GimpVectorLayer      *layer,
+                                                     GeglColor            *fg,
+                                                     GeglColor            *bg);
+/*  the stroke gradient mode of the primary stroke of the selection  */
+gboolean          chopgimp_vmaterial_set_stroke_gradient (GimpVectorLayer *layer,
+                                                          gint             mode);
+
+/*  « Masque d'opacité »: the selected objects (≥ 2, same parent; the top
+ *  one is the mask) are grouped with the mask; @flags CHOPGIMP_OPMASK_*
+ */
+gboolean          chopgimp_vmaterial_opmask_make    (GimpVectorLayer      *layer,
+                                                     gint                  flags);
+gboolean          chopgimp_vmaterial_opmask_release (GimpVectorLayer      *layer);
+/*  toggles CLIP or INVERT on the masked group of the selection  */
+gboolean          chopgimp_vmaterial_opmask_toggle  (GimpVectorLayer      *layer,
+                                                     gint                  flag);
+gboolean          chopgimp_vmaterial_opmask_any     (GimpVectorLayer      *layer);
+
+/*  ─── vector patterns ───────────────────────────────────────────────── */
+
+typedef enum
+{
+  CHOPGIMP_VPATTERN_GRID,
+  CHOPGIMP_VPATTERN_BRICK_ROW,     /* « Brique par ligne »                  */
+  CHOPGIMP_VPATTERN_BRICK_COLUMN,  /* « Brique par colonne »                */
+  CHOPGIMP_VPATTERN_HEX            /* « Hexagonal »                         */
+} ChopGimpVPatternType;
+
+typedef struct
+{
+  ChopGimpVPatternType type;
+  gdouble              w, h;       /* tile (image px)                      */
+  gdouble              hspace;     /* horizontal / vertical spacing; < 0:  */
+  gdouble              vspace;     /* overlap                              */
