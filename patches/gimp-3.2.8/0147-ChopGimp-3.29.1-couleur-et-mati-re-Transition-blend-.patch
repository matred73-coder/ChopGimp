+/*  ─── 3.29.1: dynamic corner widgets in Direct Selection ────────────── */
+
+#define PATH_CORNER_OFFSET 14.0   /* screen px from the corner, inside */
+#define PATH_CORNER_HIT     6.0
+#define PATH_MAX_CORNERS   64
+
+static gint
+gimp_path_tool_corner_at (GimpPathTool     *path_tool,
+                          GimpDisplay      *display,
+                          const GimpCoords *coords,
+                          gdouble          *bx,
+                          gdouble          *by)
+{
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           scale = MAX (shell->scale_x, 1e-6);
+  gdouble          *v;
+  gint              n = 0, found = -1;
+
+  if (! path_tool->vobj_layer || ! path_tool->vobj_id ||
+      ! (v = chopgimp_vtransform_corners (path_tool->vobj_layer, path_tool->vobj_id, &n)))
+    return -1;
+
+  for (gint i = 0; i < MIN (n, PATH_MAX_CORNERS) && found < 0; i++)
+    {
+      gdouble off = PATH_CORNER_OFFSET / scale +
+                    MAX (0.0, chopgimp_vtransform_get_corner (path_tool->vobj_layer,
+                                                              path_tool->vobj_id, i, NULL)) *
+                    (G_SQRT2 - 1.0);
+      gdouble wx  = v[4 * i]     + v[4 * i + 2] * off;
+      gdouble wy  = v[4 * i + 1] + v[4 * i + 3] * off;
+
+      if (hypot (coords->x - wx, coords->y - wy) * scale <= PATH_CORNER_HIT)
+        {
+          found = i;
+          *bx   = v[4 * i + 2];
+          *by   = v[4 * i + 3];
+        }
+    }
+
+  g_free (v);
+
+  return found;
+}
+
+static void
+gimp_path_tool_draw (GimpDrawTool *draw_tool)
+{
+  GimpPathTool *path_tool = GIMP_PATH_TOOL (draw_tool);
+  gdouble      *v;
+  gint          n = 0;
+
+  GIMP_DRAW_TOOL_CLASS (parent_class)->draw (draw_tool);
+
+  if (! gimp_path_tool_is_direct (path_tool) || ! path_tool->vobj_layer ||
+      ! path_tool->vobj_id || path_tool->vobj_multi || ! draw_tool->display)
+    return;
+
+  if ((v = chopgimp_vtransform_corners (path_tool->vobj_layer, path_tool->vobj_id, &n)))
+    {
+      gdouble scale = MAX (gimp_display_get_shell (draw_tool->display)->scale_x, 1e-6);
+
+      for (gint i = 0; i < MIN (n, PATH_MAX_CORNERS); i++)
+        {
+          gdouble off = PATH_CORNER_OFFSET / scale +
+                        MAX (0.0, chopgimp_vtransform_get_corner (path_tool->vobj_layer,
+                                                                  path_tool->vobj_id, i, NULL)) *
+                        (G_SQRT2 - 1.0);
+
+          gimp_draw_tool_add_handle (draw_tool, GIMP_HANDLE_CIRCLE,
+                                     v[4 * i]     + v[4 * i + 2] * off,
+                                     v[4 * i + 1] + v[4 * i + 3] * off,
+                                     9, 9, GIMP_HANDLE_ANCHOR_CENTER);
+        }
+      g_free (v);
+    }
+}
