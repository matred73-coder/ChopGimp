+++ b/app/actions/vector-objects-commands.c
@@ -45,6 +45,8 @@
 #include "path/chopgimp-vlivepaint.h"
 #include "path/chopgimp-vsymbols.h"
 #include "path/chopgimp-vtransform.h"
+#include "path/chopgimp-vmaterial.h"
