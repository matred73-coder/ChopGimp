+static void svg_vput_node (SvgVWrite      *w,
+                           const SvgVNode *n,
+                           const gchar    *spacing);
+
+/*  3.29.1: a vector pattern (« type=… w=… h=… hs=… vs=… |<objects>») →
+ *  <pattern> in the defs, tiled as chopgimp-vmaterial.c pattern_cell()
+ *  does (grid, bricks by row / column, hexagons by column); → its id
+ *  number, 0 when the spec cannot be read
+ */
+static gint
+svg_vput_vpattern (SvgVWrite   *w,
+                   const gchar *spec)
+{
+  const gchar *bar = strchr (spec, '|');
+  gchar       *head;
+  gchar      **words;
+  const gchar *type = "grid";
+  gdouble      tw = 20.0, th = 20.0, hs = 0.0, vs = 0.0;
+  gdouble      sx, sy, cw, ch;
+  gdouble      offs[3][2] = { { 0, 0 }, };
+  gint         n_offs = 1;
+  SvgVNode    *root;
+  GString     *body;
+  GString     *cell;
+  gint         n;
+
+  if (! bar)
+    return 0;
+
+  root = svg_vobjects_parse (bar + 1);
+  if (! root)
+    return 0;
+
+  head  = g_strndup (spec, bar - spec);
+  words = g_strsplit (head, " ", -1);
+
+  for (gint i = 0; words[i]; i++)
+    {
+      gchar *eq = strchr (words[i], '=');
+
+      if (! eq)
+        continue;
+      *eq = '\0';
+      if (! strcmp (words[i], "type"))
+        type = (! strcmp (eq + 1, "brick-row")    ? "brick-row"    :
+                ! strcmp (eq + 1, "brick-column") ? "brick-column" :
+                ! strcmp (eq + 1, "hex")          ? "hex"          : "grid");
+      else if (! strcmp (words[i], "w"))
+        tw = MAX (1.0, g_ascii_strtod (eq + 1, NULL));
+      else if (! strcmp (words[i], "h"))
+        th = MAX (1.0, g_ascii_strtod (eq + 1, NULL));
+      else if (! strcmp (words[i], "hs"))
+        hs = g_ascii_strtod (eq + 1, NULL);
+      else if (! strcmp (words[i], "vs"))
+        vs = g_ascii_strtod (eq + 1, NULL);
+    }
+
+  sx = MAX (1.0, tw + hs);
+  sy = MAX (1.0, th + vs);
+  cw = sx;
+  ch = sy;
+
+  if (! strcmp (type, "brick-row"))
+    {
+      ch = 2 * sy;
+      offs[1][0] = sx / 2;  offs[1][1] = sy;
+      offs[2][0] = -sx / 2; offs[2][1] = sy;
+      n_offs = 3;
+    }
+  else if (! strcmp (type, "brick-column"))
+    {
+      cw = 2 * sx;
+      offs[1][0] = sx; offs[1][1] = sy / 2;
+      offs[2][0] = sx; offs[2][1] = -sy / 2;
+      n_offs = 3;
+    }
+  else if (! strcmp (type, "hex"))
+    {
+      cw = 1.5 * sx;
+      offs[1][0] = 0.75 * sx; offs[1][1] = sy / 2;
+      offs[2][0] = 0.75 * sx; offs[2][1] = -sy / 2;
+      n_offs = 3;
+    }
+
+  /*  the objects once, then <use> of them at each copy and its
+   *  neighbours (a tile larger than its cell overflows into them)
+   */
+  body    = w->body;
+  w->body = g_string_new (NULL);
+  for (guint i = 0; root->children && i < root->children->len; i++)
+    svg_vput_node (w, g_ptr_array_index (root->children, i), "  ");
+  cell    = w->body;
+  w->body = body;
+
+  n = ++w->n_gradients;
+
+  g_string_append_printf (w->defs,
+                          "<pattern id=\"%s-p%d\" patternUnits=\"userSpaceOnUse\""
+                          " chopgimp:pattern=\"%s\" width=\"", w->prefix, n, type);
+  svg_vput_num (w->defs, cw);
+  g_string_append (w->defs, "\" height=\"");
+  svg_vput_num (w->defs, ch);
+  g_string_append (w->defs, "\" style=\"overflow:hidden\">\n");
+  g_string_append_printf (w->defs, "<g id=\"%s-p%d-tile\">\n", w->prefix, n);
+  g_string_append (w->defs, cell->str);
+  g_string_append (w->defs, "</g>\n");
+
+  for (gint k = 0; k < n_offs; k++)
+    for (gint dy = -1; dy <= 1; dy++)
+      for (gint dx = -1; dx <= 1; dx++)
+        {
+          gdouble x = offs[k][0] + dx * cw;
+          gdouble y = offs[k][1] + dy * ch;
+
+          if (k == 0 && dx == 0 && dy == 0)
+            continue;
+          g_string_append_printf (w->defs, "<use xlink:href=\"#%s-p%d-tile\" x=\"", w->prefix, n);
+          svg_vput_num (w->defs, x);
+          g_string_append (w->defs, "\" y=\"");
+          svg_vput_num (w->defs, y);
+          g_string_append (w->defs, "\"/>\n");
+        }
+
+  g_string_append (w->defs, "</pattern>\n");
+
+  g_string_free (cell, TRUE);
+  g_strfreev (words);
+  g_free (head);
+  svg_vnode_free (root);
+
+  return n;
+}
