+
+/*  ─── ChopGimp 3.27 lot V2: objects of vector layers ──────────────── */
+
+static gboolean
+gimp_path_tool_is_direct (GimpPathTool *path_tool)
+{
+  return g_object_get_data (G_OBJECT (path_tool), "chopgimp-direct-select") != NULL;
+}
+
+static void
+gimp_path_tool_vobj_detach (GimpPathTool *path_tool)
+{
+  if (path_tool->vobj_layer)
+    {
+      g_signal_handlers_disconnect_by_data (path_tool->vobj_layer, path_tool);
+      g_object_remove_weak_pointer (G_OBJECT (path_tool->vobj_layer),
+                                    (gpointer *) &path_tool->vobj_layer);
+      path_tool->vobj_layer = NULL;
+    }
+
+  if (path_tool->vobj_path)
+    {
+      g_signal_handlers_disconnect_by_data (path_tool->vobj_path, path_tool);
+      path_tool->vobj_path = NULL;   /* the reference is path_tool->path's */
+    }
+
+  path_tool->vobj_id = 0;
+
+  if (path_tool->vobj_multi)
+    {
+      g_array_free (path_tool->vobj_multi, TRUE);
+      path_tool->vobj_multi = NULL;
+    }
+}
+
+/*  ChopGimp 3.28.3: Direct Selection on several objects at once (a
+ *  rectangle from the void, Illustrator): the edited path holds the
+ *  strokes of all the objects, each one marked with its object's id,
+ *  and goes back into each object when it changes
+ */
+#define CHOPGIMP_VOBJ_ID_KEY "chopgimp-vobj-id"
+
+static void
+gimp_path_tool_vobj_fill_multi (GimpPathTool *path_tool,
+                                GimpPath     *combined)
+{
+  guint i;
+
+  for (i = 0; i < path_tool->vobj_multi->len; i++)
+    {
+      guint            id = g_array_index (path_tool->vobj_multi, guint, i);
+      ChopGimpVObject *o  = chopgimp_vlayer_get_object (path_tool->vobj_layer, id);
+      GimpPath        *world;
+      GimpStroke      *s = NULL;
+
+      if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+        continue;
+
+      world = chopgimp_vobject_get_world_path (path_tool->vobj_layer, o, FALSE);
+      g_object_ref_sink (world);
+
+      while ((s = gimp_path_stroke_get_next (world, s)))
+        {
+          GimpStroke *copy = gimp_stroke_duplicate (s);
+
+          g_object_set_data (G_OBJECT (copy), CHOPGIMP_VOBJ_ID_KEY,
+                             GUINT_TO_POINTER (id));
+          gimp_path_stroke_add (combined, copy);
+          g_object_unref (copy);
+        }
+
+      g_object_unref (world);
+    }
+}
+
+static void
+gimp_path_tool_vobj_thaw_multi (GimpPath     *path,
+                                GimpPathTool *path_tool)
+{
+  GimpImage *image = gimp_item_get_image (GIMP_ITEM (path_tool->vobj_layer));
+  guint      i;
+
+  path_tool->vobj_writing = TRUE;
+
+  /*  3.29.5: a new sub-path drawn while several objects are edited has no
+   *  object: it becomes a new object (style of the last edited object),
+   *  its strokes are marked and it joins the edited objects
+   *  (CHOPGIMP_NO_MULTI_NEW_PATH=1: dropped, as before)
+   */
+  if (! g_getenv ("CHOPGIMP_NO_MULTI_NEW_PATH"))
+    {
+      GimpPath   *extra = NULL;
+      GList      *fresh = NULL;
+      GimpStroke *s     = NULL;
+
+      while ((s = gimp_path_stroke_get_next (path, s)))
+        {
+          if (! g_object_get_data (G_OBJECT (s), CHOPGIMP_VOBJ_ID_KEY))
+            {
+              GimpStroke *copy = gimp_stroke_duplicate (s);
+
+              if (! extra)
+                {
+                  extra = gimp_path_new (image, _("Tracé"));
+                  g_object_ref_sink (extra);
+                }
+
+              gimp_path_stroke_add (extra, copy);
+              g_object_unref (copy);
+              fresh = g_list_prepend (fresh, s);
+            }
+        }
+
+      if (extra)
+        {
+          ChopGimpVObject *like = NULL;
+          ChopGimpVObject *made;
+          ChopGimpVStyle   style;
+
+          for (i = path_tool->vobj_multi->len; i > 0 && ! like; i--)
+            {
+              like = chopgimp_vlayer_get_object (path_tool->vobj_layer,
+                                                 g_array_index (path_tool->vobj_multi,
+                                                                guint, i - 1));
+              if (like && like->kind != CHOPGIMP_VOBJECT_PATH)
+                like = NULL;
+            }
+
+          chopgimp_vstyle_init (&style);
+          if (like)
+            chopgimp_vstyle_copy (&style, &like->style);
+
+          made = chopgimp_vobjects_add_path (path_tool->vobj_layer, extra,
+                                             _("Tracé"), &style);
+          chopgimp_vstyle_clear (&style);
+
+          if (made)
+            {
+              for (GList *l = fresh; l; l = l->next)
+                g_object_set_data (G_OBJECT (l->data), CHOPGIMP_VOBJ_ID_KEY,
+                                   GUINT_TO_POINTER (made->id));
+
+              g_array_append_val (path_tool->vobj_multi, made->id);
+            }
+
+          g_object_unref (extra);
+        }
+
+      g_list_free (fresh);
+    }
+
+  chopgimp_vlayer_freeze (path_tool->vobj_layer);
+
+  for (i = 0; i < path_tool->vobj_multi->len; i++)
+    {
+      guint            id = g_array_index (path_tool->vobj_multi, guint, i);
+      ChopGimpVObject *o  = chopgimp_vlayer_get_object (path_tool->vobj_layer, id);
+      GimpPath        *part;
+      GimpPath        *local;
+      GimpStroke      *s = NULL;
+
+      if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+        continue;
+
+      part = gimp_path_new (image, o->name);
+      g_object_ref_sink (part);
+
+      while ((s = gimp_path_stroke_get_next (path, s)))
+        {
+          if (GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (s),
+                                                   CHOPGIMP_VOBJ_ID_KEY)) == id)
+            {
+              GimpStroke *copy = gimp_stroke_duplicate (s);
+
+              gimp_path_stroke_add (part, copy);
+              g_object_unref (copy);
+            }
+        }
+
+      local = chopgimp_vobjects_path_to_local (o, part);
+      chopgimp_vlayer_set_path (path_tool->vobj_layer, id, local, FALSE);
+
+      g_object_unref (local);
+      g_object_unref (part);
+    }
+
+  chopgimp_vlayer_thaw (path_tool->vobj_layer);
+  path_tool->vobj_writing = FALSE;
+
+  gimp_image_flush (image);
+}
+
+/*  the edited copy changed (a node moved…): into the object  */
+static void
+gimp_path_tool_vobj_thaw (GimpPath     *path,
+                          GimpPathTool *path_tool)
+{
+  ChopGimpVObject *o;
+  GimpPath        *local;
+
+  if (path_tool->vobj_writing || ! path_tool->vobj_layer)
+    return;
+
+  if (path_tool->vobj_multi)
+    {
+      gimp_path_tool_vobj_thaw_multi (path, path_tool);
+      return;
+    }
+
+  o = chopgimp_vlayer_get_object (path_tool->vobj_layer, path_tool->vobj_id);
+  if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+    return;
+
+  local = chopgimp_vobjects_path_to_local (o, path);
+
+  path_tool->vobj_writing = TRUE;
+  chopgimp_vlayer_set_path (path_tool->vobj_layer, o->id, local, FALSE);
+  path_tool->vobj_writing = FALSE;
+
+  g_object_unref (local);
+
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (path_tool->vobj_layer)));
+}
+
+/*  the object changed elsewhere (undo…): the edited copy follows  */
+static void
+gimp_path_tool_vobj_changed (GimpVectorLayer *layer,
+                             gpointer         dirty,
+                             GimpPathTool    *path_tool)
+{
+  ChopGimpVObject *o;
+  GimpPath        *world;
+  GimpStroke      *s;
+
+  if (path_tool->vobj_writing || ! path_tool->vobj_path)
+    return;
+
+  /*  ChopGimp 3.28.3: several objects: rebuild the edited strokes  */
+  if (path_tool->vobj_multi)
+    {
+      /*  4.1.1: the selected nodes stay selected (a style change rebuilds
+       *  the same strokes)
+       */
+      GArray *picked = g_array_new (FALSE, FALSE, sizeof (gint));
+      gint    k      = 0;
+
+      s = NULL;
+      while ((s = gimp_path_stroke_get_next (path_tool->vobj_path, s)))
+        for (GList *l = s->anchors->head; l; l = l->next, k++)
+          if (((GimpAnchor *) l->data)->selected)
+            g_array_append_val (picked, k);
+
+      path_tool->vobj_writing = TRUE;
+      gimp_path_freeze (path_tool->vobj_path);
+
+      while ((s = gimp_path_stroke_get_next (path_tool->vobj_path, NULL)))
+        gimp_path_stroke_remove (path_tool->vobj_path, s);
+
+      gimp_path_tool_vobj_fill_multi (path_tool, path_tool->vobj_path);
+
+      if (picked->len > 0)
+        {
+          guint j = 0;
+
+          k = 0;
+          s = NULL;
+          while ((s = gimp_path_stroke_get_next (path_tool->vobj_path, s)))
+            for (GList *l = s->anchors->head; l; l = l->next, k++)
+              if (j < picked->len && g_array_index (picked, gint, j) == k)
+                {
+                  ((GimpAnchor *) l->data)->selected = TRUE;
+                  j++;
+                }
+        }
+
+      g_array_free (picked, TRUE);
+
+      gimp_path_thaw (path_tool->vobj_path);
+      path_tool->vobj_writing = FALSE;
+      return;
+    }
+
+  o = chopgimp_vlayer_get_object (layer, path_tool->vobj_id);
+
+  if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+    {
+      gimp_path_tool_set_path (path_tool, NULL, NULL);
+      return;
+    }
+
+  world = chopgimp_vobject_get_world_path (layer, o, FALSE);
+  g_object_ref_sink (world);
+
+  path_tool->vobj_writing = TRUE;
+  gimp_path_freeze (path_tool->vobj_path);
+
+  while ((s = gimp_path_stroke_get_next (path_tool->vobj_path, NULL)))
+    gimp_path_stroke_remove (path_tool->vobj_path, s);
+
+  gimp_path_copy_strokes (world, path_tool->vobj_path);
+  gimp_path_thaw (path_tool->vobj_path);
+  path_tool->vobj_writing = FALSE;
+
+  g_object_unref (world);
+
+  /*  3.29.5: the dynamic corner widgets of the object drawn again (undo,
+   *  radius changed in the options bar…)
+   */
+  if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (path_tool)))
+    {
+      gimp_draw_tool_pause (GIMP_DRAW_TOOL (path_tool));
+      gimp_draw_tool_resume (GIMP_DRAW_TOOL (path_tool));
+    }
+}
+
+/*  Direct Selection (A) on an object: its nodes only  */
+static void
+gimp_path_tool_vobj_edit (GimpPathTool    *path_tool,
+                          GimpVectorLayer *layer,
+                          ChopGimpVObject *object)
+{
+  GimpPath *world = chopgimp_vobject_get_world_path (layer, object, FALSE);
+
+  g_object_ref_sink (world);
+  gimp_object_set_name (GIMP_OBJECT (world), object->name);
+
+  gimp_path_tool_set_layer (path_tool, NULL);
+  gimp_path_tool_set_path (path_tool, NULL, NULL);
+
+  gimp_path_tool_set_path (path_tool, NULL, world);
+  g_object_unref (world);
+
+  if (path_tool->path != world)
+    return;
+
+  path_tool->vobj_path  = world;
+  path_tool->vobj_layer = layer;
+  path_tool->vobj_id    = object->id;
+  g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &path_tool->vobj_layer);
+
+  g_signal_connect_after (world, "thaw",
+                          G_CALLBACK (gimp_path_tool_vobj_thaw), path_tool);
+  g_signal_connect (layer, "objects-changed",
+                    G_CALLBACK (gimp_path_tool_vobj_changed), path_tool);
+
+  chopgimp_vlayer_set_selection (layer, &object->id, 1);
+
+  /*  3.29.3: the dynamic corner widgets need vobj_id, set after the draw
+   *  tool was restarted by set_path(): draw again
+   */
