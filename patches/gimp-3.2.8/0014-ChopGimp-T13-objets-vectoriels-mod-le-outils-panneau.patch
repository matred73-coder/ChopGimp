+gboolean          chopgimp_vobject_preview_bounds  (ChopGimpVObject  *root,
+                                                    gdouble           bounds[4]);
+void              chopgimp_vobject_draw_preview    (ChopGimpVObject  *root,
+                                                    gpointer          cr);
+
+
+/*  ─── internal: gimpvectorlayer.c, xcf ──────────────────────────────── */
+
+void              chopgimp_vlayer_free             (ChopGimpVLayer   *vlayer);
+gint64            chopgimp_vlayer_get_memsize      (GimpVectorLayer  *layer);
+/*  FALSE in legacy mode: the caller renders with GIMP's renderer  */
+gboolean          chopgimp_vlayer_render           (GimpVectorLayer  *layer,
