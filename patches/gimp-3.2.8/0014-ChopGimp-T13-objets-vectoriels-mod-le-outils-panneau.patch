+        g_object_set_data (G_OBJECT (b), "chopgimp-action", (gpointer) btns[i].action);
+        gimp_help_set_help_data (b, _(btns[i].tip), NULL);
+        g_signal_connect (b, "clicked", G_CALLBACK (props_action_clicked), p);
