+gboolean          chopgimp_vlayer_update_global_color (GimpVectorLayer *layer,
+                                                       const gchar     *id);
+/*  the number of path objects of @layer with a paint following @id  */
+gint              chopgimp_vlayer_count_global_users  (GimpVectorLayer *layer,
+                                                       const gchar     *id);
+
+
+
+/*  ─── 3.27.7: helpers for chopgimp-vlivepaint.c / chopgimp-vsymbols.c ── */
+
+/*  applies @matrix to the anchors of @path  */
+void              chopgimp_vpath_transform         (GimpPath         *path,
+                                                    const GimpMatrix3 *matrix);
+/*  the SVG path data of @path (g_free)  */
+gchar           * chopgimp_vpath_to_d              (GimpPath         *path);
+/*  @objects (ChopGimpVObject *) in the XML format of the layers, as the
