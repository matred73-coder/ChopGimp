+/*  3.29.3: the group of @leaf to select on a double-click: its ancestor
+ *  that is a child of the entered group (or of the root)
+ */
+static ChopGimpVObject *
+vsel_top_group_of (GimpVectorLayer *layer,
+                   ChopGimpVObject *leaf)
+{
+  guint            entered = chopgimp_vlayer_get_entered_group (layer);
+  ChopGimpVObject *context = entered ? chopgimp_vlayer_get_object (layer, entered) : NULL;
+  ChopGimpVObject *o       = leaf;
+
+  if (! context)
+    context = chopgimp_vlayer_get_root (layer);
+
+  while (o && o->parent && o->parent != context)
+    o = o->parent;
+
+  return (o && o != leaf) ? o : NULL;
+}
+
+static gboolean
+vsel_is_double (ChopGimpVSel        *vsel,
+                GimpDisplay         *display,
+                const GimpCoords    *coords,
+                guint32              time,
+                GimpButtonPressType  press_type)
+{
+  gint     dbl_time = 400;
+  gint     dbl_dist = 5;
+  gdouble  sx, sy;
+  gboolean dbl;
+
+  g_object_get (gtk_settings_get_default (),
+                "gtk-double-click-time",     &dbl_time,
+                "gtk-double-click-distance", &dbl_dist,
+                NULL);
+
+  gimp_display_shell_transform_xy_f (gimp_display_get_shell (display),
+                                     coords->x, coords->y, &sx, &sy);
+
+  dbl = (press_type == GIMP_BUTTON_PRESS_DOUBLE ||
+         (vsel->last_time &&
+          time - vsel->last_time < (guint32) dbl_time &&
+          fabs (sx - vsel->last_sx) <= MAX (dbl_dist, 6) &&
+          fabs (sy - vsel->last_sy) <= MAX (dbl_dist, 6)));
+
+  vsel->last_time = dbl ? 0 : time;
+  vsel->last_sx   = sx;
+  vsel->last_sy   = sy;
+
+  return dbl;
+}
+
+static void
+vsel_ensure_drawing (ChopGimpVSel *vsel,
+                     GimpDisplay  *display)
+{
+  GimpDrawTool *dt = vsel->tool;
+
+  if (gimp_draw_tool_is_active (dt) && dt->display != display)
+    gimp_draw_tool_stop (dt);
+
+  if (! gimp_draw_tool_is_active (dt))
+    gimp_draw_tool_start (dt, display);
+  else
+    vsel_redraw (vsel);
+}
+
+static void
+vsel_end_drag (ChopGimpVSel *vsel)
+{
+  /*  3.29.2: exact rendering, legacy path and signals of the gesture  */
+  if (vsel->interactive)
+    {
+      vsel->interactive = FALSE;
+
+      if (vsel->layer)
+        chopgimp_vlayer_end_interactive (vsel->layer);
+    }
+
+  vsel->drag = DRAG_NONE;
+  g_clear_pointer (&vsel->ids, g_free);
+  vsel->n_ids = 0;
+  g_clear_pointer (&vsel->snap, chopgimp_vsnap_free);
+}
+
+
+/*  3.29.0 « Angles dynamiques »: the only selected object when it is a
+ *  path object (its corner widgets are shown)
+ */
+static ChopGimpVObject *
+vsel_corner_object (ChopGimpVSel *vsel)
+{
+  const guint     *ids;
+  gint             n = 0;
+  ChopGimpVObject *o;
+
+  if (! vsel->layer)
+    return NULL;
+
+  ids = chopgimp_vlayer_get_selection (vsel->layer, &n);
+
+  if (n != 1 || ! (o = chopgimp_vlayer_get_object (vsel->layer, ids[0])) ||
+      o->kind != CHOPGIMP_VOBJECT_PATH || chopgimp_vobject_is_locked (o))
+    return NULL;
+
+  return o;
+}
+
+/*  3.29.1: the distance of corner @k's widget from its vertex, along the
+ *  bisector: the fixed offset, plus the inset of the rounded corner (for
+ *  a right angle, the arc's middle is r (√2 − 1) inside the vertex), so
+ *  that the widget follows the radius while it is dragged
+ */
+static gdouble
+vsel_corner_offset (ChopGimpVSel *vsel,
+                    guint         id,
+                    gint          k,
+                    gdouble       scale)
+{
+  gdouble r = chopgimp_vtransform_get_corner (vsel->layer, id, k, NULL);
+
+  return CORNER_OFFSET / scale + MAX (0.0, r) * (G_SQRT2 - 1.0);
+}
+
+/*  the corner widget at @coords: its index, -1 if none  */
+static gint
+vsel_corner_at (ChopGimpVSel     *vsel,
+                GimpDisplay      *display,
+                const GimpCoords *coords,
+                gdouble          *bx,
+                gdouble          *by)
+{
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           scale = MAX (shell->scale_x, 1e-6);
+  ChopGimpVObject  *o     = vsel_corner_object (vsel);
+  gdouble          *v;
+  gint              n = 0, found = -1;
+
+  if (! o || ! (v = chopgimp_vtransform_corners (vsel->layer, o->id, &n)))
+    return -1;
+
+  for (gint i = 0; i < MIN (n, MAX_CORNERS) && found < 0; i++)
+    {
+      gdouble off = vsel_corner_offset (vsel, o->id, i, scale);
+      gdouble wx  = v[4 * i]     + v[4 * i + 2] * off;
+      gdouble wy  = v[4 * i + 1] + v[4 * i + 3] * off;
+
+      if (hypot (coords->x - wx, coords->y - wy) * scale <= CORNER_HIT)
+        {
+          found = i;
+          *bx   = v[4 * i + 2];
+          *by   = v[4 * i + 3];
+        }
+    }
+
+  g_free (v);
+
+  return found;
+}
+
+
+/*  ─── API ───────────────────────────────────────────────────────────── */
+
+/*  3.29.3 (Illustrator « Fond / Contour »): the foreground color is the
+ *  fill of the selected objects and the background color their stroke.
+ *  4.1.1: done for every vector tool by the one selection watcher
+ *  (chopgimp-tools.c); the tool only keeps the user context.
+ */
+static void
+vsel_ensure_context (ChopGimpVSel *vsel,
+                     GimpDisplay  *display)
+{
+  GimpImage *image;
+
+  if (vsel->context || ! display)
+    return;
+
+  image = gimp_display_get_image (display);
+  if (image)
+    vsel->context = gimp_get_user_context (image->gimp);
+}
+
+ChopGimpVSel *
+chopgimp_vsel_new (GimpDrawTool *tool)
+{
+  ChopGimpVSel *vsel = g_new0 (ChopGimpVSel, 1);
+
+  vsel->tool = tool;
+  gimp_matrix3_identity (&vsel->applied);
+
+  return vsel;
+}
+
+void
+chopgimp_vsel_free (ChopGimpVSel *vsel)
+{
+  if (! vsel)
+    return;
+
+  vsel_end_drag (vsel);
+  vsel_watch (vsel, NULL);
+  vsel_set_tip (vsel, NULL, 0, NULL);
+
+
+  g_free (vsel);
+}
+
+gboolean
+chopgimp_vsel_is_active (ChopGimpVSel *vsel,
+                         GimpImage    *image)
+{
+  return vsel && image && chopgimp_vobjects_get_target_layer (image) != NULL;
+}
+
+void
+chopgimp_vsel_arm_style_picker (Gimp *gimp)
+{
+  GimpToolInfo *info = gimp_get_tool_info (gimp, "gimp-move-tool");
+
+  style_picker_armed = TRUE;
+
+  if (info)
+    gimp_context_set_tool (gimp_get_user_context (gimp), info);
+}
+
+gboolean
+chopgimp_vsel_button_press (ChopGimpVSel        *vsel,
+                            const GimpCoords    *coords,
+                            guint32              time,
+                            GdkModifierType      state,
+                            GimpButtonPressType  press_type,
+                            GimpDisplay         *display,
+                            gboolean             auto_select)
+{
+  GimpTool         *tool  = GIMP_TOOL (vsel->tool);
+  GimpImage        *image = gimp_display_get_image (display);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           tol   = HIT_TOLERANCE / MAX (shell->scale_x, 1e-6);
+  GimpVectorLayer  *layer;
+  ChopGimpVObject  *hit;
+  gboolean          shift = (state & gimp_get_extend_selection_mask ()) != 0;
+  gboolean          rotate;
+  gboolean          dbl;
+  gint              handle;
+
+  vsel_ensure_context (vsel, display);
+
+  if (! chopgimp_vobjects_enabled () || ! image)
+    return FALSE;
+
+  /*  « Pipette de style »: the clicked object gives its style  */
+  if (style_picker_armed)
+    {
+      style_picker_armed = FALSE;
+      layer = chopgimp_vobjects_get_target_layer (image);
+
+      if (layer &&
+          (hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y, tol,
+                                           CHOPGIMP_HIT_LEAF)) &&
+          chopgimp_vobjects_copy_style (layer, hit))
+        gimp_image_flush (image);
+
+      return TRUE;
+    }
+
+  /*  3.28.2: Ctrl+Maj+drag moves the whole layer (GIMP's Move tool takes
+   *  the press: Ctrl gives the active layer, see gimpmovetool.c), the
+   *  objects inside stay where they are relative to each other
+   */
+  if ((state & GDK_CONTROL_MASK) && shift)
+    return FALSE;
+
+  layer = vsel_target (vsel, image, coords, tol, auto_select);
+
+  if (! layer)
+    return FALSE;
+
+  vsel_watch (vsel, layer);
+  vsel_end_drag (vsel);
+
+  tool->display     = display;
+  vsel->px          = coords->x;
+  vsel->py          = coords->y;
+  vsel->pushed      = FALSE;
+  vsel->duplicate   = FALSE;
+  vsel->dx_applied  = vsel->dy_applied = 0.0;
+  vsel->from_center = (state & GDK_MOD1_MASK) != 0;
+  gimp_matrix3_identity (&vsel->applied);
+
+  vsel_box (layer, &vsel->bx1, &vsel->by1, &vsel->bx2, &vsel->by2);
+  vsel->key_candidate = 0;
+
+  /*  3.30.0: a widget of the only selected repeat (Illustrator)  */
+  if (! shift)
+    {
+      ChopGimpRepeatWidgets rw;
+      gdouble               sc = MAX (gimp_display_get_shell (display)->scale_x, 1e-6);
+
+      if (chopgimp_vrepeat_get_widgets (layer, &rw))
+        for (gint i = 0; i < rw.n; i++)
+          if (hypot (coords->x - rw.x[i], coords->y - rw.y[i]) * sc <= HANDLE_HIT)
+            {
+              vsel->drag          = DRAG_REPEAT;
+              vsel->repeat_handle = rw.handle[i];
+
+              vsel_take_ids (vsel);
+              gimp_tool_control_activate (tool->control);
+              vsel_ensure_drawing (vsel, display);
+
+              return TRUE;
+            }
+    }
+
+  /*  3.29.0: a corner widget of the only selected object  */
+  {
+    gdouble bx, by;
+    gint    k = shift ? -1 : vsel_corner_at (vsel, display, coords, &bx, &by);
+
+    if (k >= 0)
+      {
+        ChopGimpVObject *o = vsel_corner_object (vsel);
+
+        vsel->drag      = DRAG_CORNER;
+        vsel->corner_id = o->id;
+        vsel->corner_k  = (state & GDK_MOD1_MASK) ? k : -1;
+        vsel->corner_r0 = chopgimp_vtransform_get_corner (layer, o->id, k, NULL);
+        vsel->corner_bx = bx;
+        vsel->corner_by = by;
+
+        vsel_take_ids (vsel);
+        gimp_tool_control_activate (tool->control);
+        vsel_ensure_drawing (vsel, display);
+
+        return TRUE;
+      }
+  }
+
+  /*  the handles of the box  */
+  handle = vsel_handle_at (vsel, display, coords, &rotate);
+
+  if (handle >= 0)
+    {
+      vsel->drag   = rotate ? DRAG_ROTATE : DRAG_SCALE;
+      vsel->handle = handle;
+    }
+  else
+    {
+      guint entered;
+
+      /*  3.29.3: Ctrl+Alt+click cycles through the objects under the
+       *  pointer (the next one behind), Illustrator
+       */
+      if ((state & gimp_get_constrain_behavior_mask ()) && (state & GDK_MOD1_MASK) &&
+          chopgimp_vobjects_select_next_under (layer, coords->x, coords->y, tol))
+        {
+          gimp_image_flush (image);
+          vsel_ensure_drawing (vsel, display);
+
+          return TRUE;
+        }
+
+      dbl = vsel_is_double (vsel, display, coords, time, press_type);
+      /*  3.29.3: the shape under the pointer, even inside a group  */
+      hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y, tol,
+                                      vsel_click_group ? CHOPGIMP_HIT_SELECTABLE
+                                                       : CHOPGIMP_HIT_LEAF);
+
+      /*  3.29.3: double-click on a shape of a group: select the group  */
+      if (dbl && ! vsel_click_group && hit && hit->kind != CHOPGIMP_VOBJECT_GROUP)
+        {
+          ChopGimpVObject *group = vsel_top_group_of (layer, hit);
+
+          if (group)
+            {
+              chopgimp_vlayer_set_selection (layer, &group->id, 1);
+              gimp_image_flush (image);
+              vsel_ensure_drawing (vsel, display);
+
+              return TRUE;
+            }
+        }
+
+      /*  a click outside of the entered group leaves it  */
+      entered = chopgimp_vlayer_get_entered_group (layer);
+      if (entered)
+        {
+          ChopGimpVObject *group = chopgimp_vlayer_get_object (layer, entered);
+
+          if (! hit || ! group || ! chopgimp_vobject_is_ancestor (group, hit))
+            {
+              chopgimp_vlayer_enter_group (layer, 0);
+              hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y, tol,
+                                              CHOPGIMP_HIT_SELECTABLE);
+            }
+        }
+
+      /*  double-click on a group: enter it  */
+      if (dbl && hit && hit->kind == CHOPGIMP_VOBJECT_GROUP)
+        {
+          chopgimp_vlayer_enter_group (layer, hit->id);
+          hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y, tol,
+                                          CHOPGIMP_HIT_SELECTABLE);
+          if (hit)
+            chopgimp_vlayer_set_selection (layer, &hit->id, 1);
+          else
+            chopgimp_vlayer_set_selection (layer, NULL, 0);
+
+          gimp_image_flush (image);
+          vsel_ensure_drawing (vsel, display);
+
+          return TRUE;
+        }
+
+      if (hit)
+        {
+          gboolean selected = chopgimp_vlayer_is_selected (layer, hit->id);
+
+          if (shift && selected)
+            {
+              chopgimp_vlayer_deselect (layer, hit->id);
+              gimp_image_flush (image);
+              vsel_ensure_drawing (vsel, display);
+
+              return TRUE;
+            }
+
+          if (shift)
+            chopgimp_vlayer_select (layer, hit->id, TRUE);
+          else if (! selected)
+            chopgimp_vlayer_set_selection (layer, &hit->id, 1);
+          else if (chopgimp_vobjects_n_selected (layer) > 1)
+            vsel->key_candidate = hit->id;   /* 3.29.0: objet clé on release */
+
+          vsel->drag      = DRAG_MOVE;
+          vsel->duplicate = (state & GDK_MOD1_MASK) != 0;
+
+          vsel_box (layer, &vsel->bx1, &vsel->by1, &vsel->bx2, &vsel->by2);
+        }
+      else
+        {
+          vsel->drag = DRAG_RUBBER;
+          vsel->rx   = coords->x;
+          vsel->ry   = coords->y;
+        }
+    }
+
+  vsel_take_ids (vsel);
+
+  gimp_tool_control_activate (tool->control);
+  vsel_ensure_drawing (vsel, display);
+
+  return TRUE;
+}
+
+static void
+vsel_start_change (ChopGimpVSel *vsel,
+                   const gchar  *desc)
+{
+  GimpImage *image = gimp_item_get_image (GIMP_ITEM (vsel->layer));
+
+  if (vsel->pushed)
+    return;
+
+  chopgimp_vlayer_push_undo (vsel->layer, desc);
+  vsel->pushed = TRUE;
+
+  chopgimp_vlayer_begin_interactive (vsel->layer);
+  vsel->interactive = TRUE;
+
+  /*  Alt+drag: the copies move, the originals stay  */
+  if (vsel->duplicate && chopgimp_vobjects_duplicate_selection (vsel->layer, FALSE))
+    vsel_take_ids (vsel);
+
+  vsel->snap = chopgimp_vsnap_new (image, vsel->layer, vsel->ids, vsel->n_ids);
+}
+
+gboolean
+chopgimp_vsel_motion (ChopGimpVSel     *vsel,
+                      const GimpCoords *coords,
+                      GdkModifierType   state,
+                      GimpDisplay      *display)
+{
+  GimpDisplayShell *shell;
+  gdouble           scale;
+  gdouble           tol;
+  gboolean          shift, ctrl;
+
+  if (vsel->drag == DRAG_NONE)
+    return FALSE;
+
+  if (! vsel->layer)
+    {
+      vsel_end_drag (vsel);
+      return TRUE;
+    }
+
+  shell = gimp_display_get_shell (display);
+  scale = MAX (shell->scale_x, 1e-6);
+  tol   = SNAP_TOLERANCE / scale;
+  shift = (state & gimp_get_extend_selection_mask ()) != 0;
+  ctrl  = (state & gimp_get_toggle_behavior_mask ()) != 0;
+
+  gimp_draw_tool_pause (vsel->tool);
+
+  switch (vsel->drag)
+    {
+    case DRAG_RUBBER:
+      vsel->rx = coords->x;
+      vsel->ry = coords->y;
+      break;
+
+    case DRAG_REPEAT:
+      if (! vsel->pushed)
+        {
+          chopgimp_vlayer_push_undo (vsel->layer, _("Répétition"));
+          vsel->pushed = TRUE;
+        }
+
+      chopgimp_vrepeat_drag_handle (vsel->layer, vsel->repeat_handle, coords->x, coords->y);
+      gimp_image_flush (gimp_item_get_image (GIMP_ITEM (vsel->layer)));
+      break;
+
+    case DRAG_CORNER:
+      {
+        /*  towards the inside of the corner: a larger radius  */
+        gdouble r = vsel->corner_r0 +
+                    (coords->x - vsel->px) * vsel->corner_bx +
+                    (coords->y - vsel->py) * vsel->corner_by;
+
+        if (! vsel->pushed)
+          {
+            chopgimp_vlayer_push_undo (vsel->layer, _("Angles dynamiques"));
+            vsel->pushed = TRUE;
+          }
+
+        chopgimp_vtransform_set_corner (vsel->layer, vsel->corner_id, vsel->corner_k,
+                                        MAX (r, 0.0), -1, FALSE);
+        gimp_image_flush (gimp_item_get_image (GIMP_ITEM (vsel->layer)));
+      }
+      break;
+
+    case DRAG_MOVE:
+      {
+        gdouble dx = coords->x - vsel->px;
+        gdouble dy = coords->y - vsel->py;
+
+        if (! vsel->pushed && hypot (dx, dy) * scale < DRAG_THRESHOLD)
+          break;
+
+        if (shift)
+          {
+            if (fabs (dx) > 2.0 * fabs (dy))
+              dy = 0.0;
+            else if (fabs (dy) > 2.0 * fabs (dx))
+              dx = 0.0;
+            else
+              {
+                gdouble d = (fabs (dx) + fabs (dy)) / 2.0;
+
+                dx = dx < 0 ? -d : d;
+                dy = dy < 0 ? -d : d;
+              }
+          }
+
+        vsel_start_change (vsel, _("Déplacer les objets"));
+
+        if (vsel->snap)
+          {
+            gdouble cx = 0.0, cy = 0.0;
+
+            if (! ctrl &&
+                chopgimp_vsnap_bounds (vsel->snap,
+                                       vsel->bx1 + dx, vsel->by1 + dy,
+                                       vsel->bx2 + dx, vsel->by2 + dy,
+                                       tol, &cx, &cy))
+              {
+                dx += cx;
+                dy += cy;
+              }
+            else if (ctrl)
+              {
+                chopgimp_vsnap_reset (vsel->snap);
+              }
+          }
+
+        if (dx != vsel->dx_applied || dy != vsel->dy_applied)
+          {
+            chopgimp_vlayer_translate (vsel->layer, vsel->ids, vsel->n_ids,
+                                       dx - vsel->dx_applied,
+                                       dy - vsel->dy_applied, FALSE);
+            vsel->dx_applied = dx;
+            vsel->dy_applied = dy;
+          }
+      }
+      break;
+
+    case DRAG_SCALE:
+    case DRAG_ROTATE:
+      {
+        GimpMatrix3 m, inc;
+        gdouble     cx = (vsel->bx1 + vsel->bx2) / 2.0;
+        gdouble     cy = (vsel->by1 + vsel->by2) / 2.0;
+
+        gimp_matrix3_identity (&m);
+
+        if (vsel->drag == DRAG_ROTATE)
+          {
+            gdouble a = atan2 (coords->y - cy, coords->x - cx) -
+                        atan2 (vsel->py - cy, vsel->px - cx);
+
+            if (shift)
+              a = RINT (a / (G_PI / 12.0)) * (G_PI / 12.0);
+
+            gimp_matrix3_translate (&m, -cx, -cy);
+            gimp_matrix3_rotate    (&m, a);
+            gimp_matrix3_translate (&m, cx, cy);
+
+            vsel_start_change (vsel, _("Faire pivoter les objets"));
+          }
+        else
+          {
+            gint    h  = vsel->handle;
+            gint    o  = (h + 4) % 8;
+            gdouble hx, hy, ax, ay;
+            gdouble x  = coords->x, y = coords->y;
+            gdouble sx = 1.0, sy = 1.0;
+            gboolean corner = (h % 2 == 0);
+            gboolean horiz  = (h == 3 || h == 7);
+            gboolean vert   = (h == 1 || h == 5);
+
+            handle_point (h, vsel->bx1, vsel->by1, vsel->bx2, vsel->by2, &hx, &hy);
+
+            if (vsel->from_center || (state & GDK_MOD1_MASK))
+              {
+                ax = cx;
+                ay = cy;
+              }
+            else
+              {
+                handle_point (o, vsel->bx1, vsel->by1, vsel->bx2, vsel->by2, &ax, &ay);
+              }
+
+            vsel_start_change (vsel, _("Redimensionner les objets"));
+
+            if (vsel->snap && ! ctrl)
+              chopgimp_vsnap_point (vsel->snap, x, y, tol, &x, &y);
+            else if (vsel->snap)
+              chopgimp_vsnap_reset (vsel->snap);
+
+            if ((corner || horiz) && fabs (hx - ax) > 1e-6)
+              sx = (x - ax) / (hx - ax);
+            if ((corner || vert) && fabs (hy - ay) > 1e-6)
+              sy = (y - ay) / (hy - ay);
+
+            if (shift)
+              {
+                if (corner)
+                  {
+                    gdouble s = fabs (sx) > fabs (sy) ? fabs (sx) : fabs (sy);
+
+                    sx = sx < 0 ? -s : s;
+                    sy = sy < 0 ? -s : s;
+                  }
+                else if (horiz)
+                  sy = fabs (sx);
+                else
+                  sx = fabs (sy);
+              }
+
+            if (fabs (sx) < 1e-3) sx = sx < 0 ? -1e-3 : 1e-3;
+            if (fabs (sy) < 1e-3) sy = sy < 0 ? -1e-3 : 1e-3;
+
+            gimp_matrix3_translate (&m, -ax, -ay);
+            gimp_matrix3_scale     (&m, sx, sy);
+            gimp_matrix3_translate (&m, ax, ay);
+          }
+
+        /*  inc = m · applied⁻¹  */
+        inc = vsel->applied;
+        gimp_matrix3_invert (&inc);
+        gimp_matrix3_mult (&m, &inc);
+
+        chopgimp_vlayer_transform (vsel->layer, vsel->ids, vsel->n_ids,
+                                   &inc, FALSE, FALSE);
+        vsel->applied = m;
+      }
+      break;
+    }
+
+  gimp_draw_tool_resume (vsel->tool);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vsel_button_release (ChopGimpVSel          *vsel,
+                              const GimpCoords      *coords,
+                              GdkModifierType        state,
+                              GimpButtonReleaseType  release_type,
+                              GimpDisplay           *display)
+{
+  GimpTool  *tool  = GIMP_TOOL (vsel->tool);
+  GimpImage *image = gimp_display_get_image (display);
+  gint       drag  = vsel->drag;
+
+  if (drag == DRAG_NONE)
+    return FALSE;
+
+  gimp_tool_control_halt (tool->control);
+  gimp_draw_tool_pause (vsel->tool);
+
+  if (! vsel->layer)
+    {
+      vsel_end_drag (vsel);
+      gimp_draw_tool_resume (vsel->tool);
+      return TRUE;
+    }
+
+  if (release_type == GIMP_BUTTON_RELEASE_CANCEL)
+    {
+      if (vsel->pushed)
+        gimp_image_undo (image);
+    }
+  else if (drag == DRAG_RUBBER)
+    {
+      GimpDisplayShell *shell = gimp_display_get_shell (display);
+      gboolean          shift = (state & gimp_get_extend_selection_mask ()) != 0;
+      gdouble           x     = MIN (vsel->px, vsel->rx);
+      gdouble           y     = MIN (vsel->py, vsel->ry);
+      gdouble           w     = fabs (vsel->rx - vsel->px);
+      gdouble           h     = fabs (vsel->ry - vsel->py);
+
+      if (MAX (w, h) * shell->scale_x < DRAG_THRESHOLD)
+        {
+          if (! shift)
+            chopgimp_vlayer_set_selection (vsel->layer, NULL, 0);
+        }
+      else
+        {
+          GList *list = chopgimp_vlayer_objects_in_rect (vsel->layer, x, y, w, h, TRUE);
+
+          if (! shift)
+            chopgimp_vlayer_set_selection (vsel->layer, NULL, 0);
+
+          for (GList *l = list; l; l = l->next)
+            chopgimp_vlayer_select (vsel->layer,
+                                    ((ChopGimpVObject *) l->data)->id, TRUE);
+
+          g_list_free (list);
+        }
+    }
+  else if (drag == DRAG_MOVE && vsel->pushed)
+    {
+      /*  3.29.0 « Répéter la transformation » (Ctrl+D)  */
+      GimpMatrix3 m;
+
+      gimp_matrix3_identity  (&m);
+      gimp_matrix3_translate (&m, vsel->dx_applied, vsel->dy_applied);
+      chopgimp_vtransform_record (&m, vsel->duplicate);
+    }
+  else if ((drag == DRAG_SCALE || drag == DRAG_ROTATE) && vsel->pushed)
+    {
+      chopgimp_vtransform_record (&vsel->applied, FALSE);
+    }
+  else if (drag == DRAG_MOVE && ! vsel->pushed && vsel->key_candidate)
+    {
+      /*  3.29.0: a click on an object of the selection makes it the key
+       *  object (Aligner / Répartir align to it); again: no key object
+       */
+      if (chopgimp_vtransform_get_key (vsel->layer) == vsel->key_candidate)
+        chopgimp_vtransform_set_key (vsel->layer, 0);
+      else
+        chopgimp_vtransform_set_key (vsel->layer, vsel->key_candidate);
+    }
+
+  vsel->key_candidate = 0;
+  vsel_end_drag (vsel);
+  gimp_image_flush (image);
+
+  gimp_draw_tool_resume (vsel->tool);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vsel_key_press (ChopGimpVSel *vsel,
+                         GdkEventKey  *kevent,
+                         GimpDisplay  *display)
+{
+  GimpImage       *image = gimp_display_get_image (display);
+  GimpVectorLayer *layer = chopgimp_vobjects_get_target_layer (image);
+  gint             n     = chopgimp_vobjects_n_selected (layer);
+  gdouble          step  = (kevent->state & gimp_get_extend_selection_mask ()) ? 10.0 : 1.0;
+  gdouble          dx    = 0.0, dy = 0.0;
+
+  vsel_ensure_context (vsel, display);
+
+  if (! layer)
+    {
+      if (kevent->keyval == GDK_KEY_Escape && style_picker_armed)
+        {
+          style_picker_armed = FALSE;
+          return TRUE;
+        }
+
+      return FALSE;
+    }
+
+  switch (kevent->keyval)
+    {
+    case GDK_KEY_Left:  case GDK_KEY_KP_Left:  dx = -step; break;
+    case GDK_KEY_Right: case GDK_KEY_KP_Right: dx =  step; break;
+    case GDK_KEY_Up:    case GDK_KEY_KP_Up:    dy = -step; break;
+    case GDK_KEY_Down:  case GDK_KEY_KP_Down:  dy =  step; break;
+
+    case GDK_KEY_Escape:
+      if (style_picker_armed)
+        {
+          style_picker_armed = FALSE;
+          return TRUE;
+        }
+      else if (chopgimp_vlayer_get_entered_group (layer))
+        {
+          guint group = chopgimp_vlayer_get_entered_group (layer);
+
+          chopgimp_vlayer_enter_group (layer, 0);
+          chopgimp_vlayer_set_selection (layer, &group, 1);
+        }
+      else if (n > 0)
+        {
+          chopgimp_vlayer_set_selection (layer, NULL, 0);
+        }
+      else
+        {
+          return FALSE;
+        }
+
+      gimp_image_flush (image);
+      return TRUE;
+
+    case GDK_KEY_Delete:
+    case GDK_KEY_KP_Delete:
+    case GDK_KEY_BackSpace:
+      if (n == 0)
+        return FALSE;
+
+      chopgimp_vobjects_delete_selection (layer);
+      gimp_image_flush (image);
+      return TRUE;
+
+    default:
+      return FALSE;
+    }
+
+  if (n == 0)
+    return FALSE;
+
+  {
+    const guint *ids = chopgimp_vlayer_get_selection (layer, &n);
+    guint       *copy = g_memdup2 (ids, sizeof (guint) * n);
+
+    chopgimp_vlayer_translate (layer, copy, n, dx, dy, TRUE);
+    g_free (copy);
+  }
+
+  gimp_image_flush (image);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vsel_oper_update (ChopGimpVSel     *vsel,
+                           const GimpCoords *coords,
+                           GdkModifierType   state,
+                           gboolean          proximity,
+                           GimpDisplay      *display)
+{
+  GimpImage        *image = gimp_display_get_image (display);
+  GimpVectorLayer  *layer = chopgimp_vobjects_get_target_layer (image);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  ChopGimpVObject  *hit   = NULL;
+  guint             hover;
+
+  vsel_ensure_context (vsel, display);
+
+  vsel_watch (vsel, layer);
+
+  if (! layer)
+    return FALSE;
+
+  vsel->hx = coords->x;
+  vsel->hy = coords->y;
+
+  if (proximity)
+    hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y,
+                                    HIT_TOLERANCE / MAX (shell->scale_x, 1e-6),
+                                    vsel_click_group ? CHOPGIMP_HIT_SELECTABLE
+                                                     : CHOPGIMP_HIT_LEAF);
+
+  hover = hit ? hit->id : 0;
+
+  if (! gimp_draw_tool_is_active (vsel->tool) ||
+      vsel->tool->display != display)
+    {
+      vsel->hover_id = hover;
+      vsel_ensure_drawing (vsel, display);
+    }
+  else if (hover != vsel->hover_id)
+    {
+      vsel->hover_id = hover;
+      vsel_redraw (vsel);
+    }
+
+  if (! hit)
+    vsel_set_tip (vsel, shell->canvas, 0, NULL);
+
+  if (style_picker_armed)
+    gimp_tool_replace_status (GIMP_TOOL (vsel->tool), display,
+                              _("Pipette de style : cliquez sur l'objet dont copier "
+                                "le fond et le contour (Échap : annuler)"));
+  else if (hit)
+    {
+      /*  3.29.3: what a click will take (name, fill color, group)  */
+      ChopGimpVEntry *fill  = hit->kind == CHOPGIMP_VOBJECT_PATH ?
+                              chopgimp_vstyle_get_fill (&hit->style) : NULL;
+      gchar          *color = NULL;
+
+      if (fill && fill->visible && fill->paint.type == CHOPGIMP_PAINT_COLOR && fill->paint.color)
+        {
+          guint8 px[4];
+
+          gegl_color_get_pixel (fill->paint.color, babl_format ("R'G'B'A u8"), px);
+          color = g_strdup_printf ("#%02x%02x%02x", px[0], px[1], px[2]);
+        }
+
+      if (vsel->drag == DRAG_NONE)
+        {
+          gchar *tip = g_strdup_printf ("%s%s%s%s%s",
+                                        hit->name ? hit->name : _("Objet"),
+                                        color ? "\n" : "", color ? color : "",
+                                        (hit->parent && hit->parent->parent) ?
+                                          _("\nGroupe : ") : "",
+                                        (hit->parent && hit->parent->parent) ?
+                                          (hit->parent->name ? hit->parent->name : _("sans nom")) : "");
+
+          vsel_set_tip (vsel, shell->canvas, hit->id, tip);
+          g_free (tip);
+        }
+
+      gimp_tool_replace_status (GIMP_TOOL (vsel->tool), display,
+                                "%s%s%s%s%s — %s",
+                                hit->name ? hit->name : _("Objet"),
+                                color ? "  " : "", color ? color : "",
+                                (hit->parent && hit->parent->parent) ? _("  · groupe ") : "",
+                                (hit->parent && hit->parent->parent && hit->parent->name) ?
+                                  hit->parent->name : "",
+                                _("clic : sélectionner, double-clic : son groupe, "
+                                  "Ctrl+Alt+clic : l'objet derrière"));
+      g_free (color);
+    }
+  else
+    gimp_tool_replace_status (GIMP_TOOL (vsel->tool), display,
+                              _("Objets : clic pour sélectionner, Maj+clic pour ajouter, "
+                                "glisser dans le vide pour encadrer, Alt+glisser pour "
+                                "dupliquer, Ctrl+Alt+clic pour l'objet derrière"));
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vsel_cursor_update (ChopGimpVSel     *vsel,
+                             const GimpCoords *coords,
+                             GdkModifierType   state,
+                             GimpDisplay      *display)
+{
+  static const GimpCursorType handle_cursors[8] =
+  {
+    GIMP_CURSOR_CORNER_TOP_LEFT,     GIMP_CURSOR_SIDE_TOP,
+    GIMP_CURSOR_CORNER_TOP_RIGHT,    GIMP_CURSOR_SIDE_RIGHT,
+    GIMP_CURSOR_CORNER_BOTTOM_RIGHT, GIMP_CURSOR_SIDE_BOTTOM,
+    GIMP_CURSOR_CORNER_BOTTOM_LEFT,  GIMP_CURSOR_SIDE_LEFT
+  };
+  GimpTool           *tool  = GIMP_TOOL (vsel->tool);
+  GimpImage          *image = gimp_display_get_image (display);
+  GimpVectorLayer    *layer = chopgimp_vobjects_get_target_layer (image);
+  GimpCursorType      cursor      = GIMP_CURSOR_MOUSE;
+  GimpToolCursorType  tool_cursor = GIMP_TOOL_CURSOR_MOVE;
+  GimpCursorModifier  modifier    = GIMP_CURSOR_MODIFIER_NONE;
+  gboolean            rotate;
+  gint                handle;
+
+  if (! layer)
+    return FALSE;
+
+  vsel_watch (vsel, layer);
+
+  if (style_picker_armed)
+    {
+      tool_cursor = GIMP_TOOL_CURSOR_COLOR_PICKER;
+    }
+  else if ((handle = vsel_handle_at (vsel, display, coords, &rotate)) >= 0)
+    {
+      if (rotate)
+        tool_cursor = GIMP_TOOL_CURSOR_ROTATE;
+      else
+        {
+          cursor      = handle_cursors[handle];
+          tool_cursor = GIMP_TOOL_CURSOR_NONE;
+        }
+    }
+  else if (vsel->hover_id)
+    {
+      modifier = GIMP_CURSOR_MODIFIER_MOVE;
+    }
+
+  gimp_tool_control_set_cursor          (tool->control, cursor);
+  gimp_tool_control_set_tool_cursor     (tool->control, tool_cursor);
+  gimp_tool_control_set_cursor_modifier (tool->control, modifier);
+
+  return TRUE;
+}
+
+static void
+vsel_draw_outline (ChopGimpVSel    *vsel,
+                   ChopGimpVObject *o,
+                   gboolean         highlight)
+{
+  GimpDrawTool   *dt = vsel->tool;
+  GimpPath       *wp = chopgimp_vobject_get_world_path (vsel->layer, o, FALSE);
+  GimpCanvasItem *item;
+
+  if (! wp)
+    return;
+
+  g_object_ref_sink (wp);
+
+  if (gimp_path_get_n_strokes (wp) > 0 && gimp_path_get_bezier (wp))
+    {
+      item = gimp_canvas_path_new (gimp_display_get_shell (dt->display),
+                                   gimp_path_get_bezier (wp), 0, 0, FALSE,
+                                   GIMP_PATH_STYLE_DEFAULT);
+      gimp_canvas_item_set_highlight (item, highlight);
+      gimp_draw_tool_add_item (dt, item);
+      g_object_unref (item);
+    }
+
+  g_object_unref (wp);
+}
+
+gboolean
+chopgimp_vsel_draw (ChopGimpVSel *vsel)
+{
+  GimpDrawTool *dt = vsel->tool;
+  GimpImage    *image;
+  gdouble       x1, y1, x2, y2;
+
+  if (! dt->display)
+    return FALSE;
+
+  image = gimp_display_get_image (dt->display);
+
+  if (! vsel->layer || ! image ||
+      gimp_item_get_image (GIMP_ITEM (vsel->layer)) != image ||
+      chopgimp_vobjects_get_target_layer (image) != vsel->layer)
+    return FALSE;
+
+  /*  3.29.3: isolation mode (a group entered by a double-click): the rest
+   *  of the image is dimmed around the group (Échap leaves it)
+   */
+  {
+    guint entered = chopgimp_vlayer_get_entered_group (vsel->layer);
+    ChopGimpVObject *group = entered ? chopgimp_vlayer_get_object (vsel->layer, entered) : NULL;
+    gdouble gx1, gy1, gx2, gy2;
+
+    if (group &&
+        chopgimp_vobject_get_bounds (vsel->layer, group, TRUE, &gx1, &gy1, &gx2, &gy2))
+      {
+        GimpCanvasItem *pp;
+
+        pp = gimp_canvas_passe_partout_new (gimp_display_get_shell (dt->display),
+                                            gx1 - 4, gy1 - 4,
+                                            gx2 - gx1 + 8, gy2 - gy1 + 8);
+        gimp_draw_tool_add_item (dt, pp);
+        g_object_unref (pp);
+      }
+  }
+
+  /*  outlines of the selected objects, and of the one under the pointer  */
+  {
+    GList *objs = chopgimp_vlayer_get_selected_objects (vsel->layer);
+    gint   k    = 0;
+
+    for (GList *l = objs; l && k < MAX_OUTLINES; l = l->next, k++)
+      vsel_draw_outline (vsel, l->data, FALSE);
+
+    g_list_free (objs);
+
+    if (vsel->hover_id && vsel->drag == DRAG_NONE &&
+        ! chopgimp_vlayer_is_selected (vsel->layer, vsel->hover_id))
+      {
+        ChopGimpVObject *o = chopgimp_vlayer_get_object (vsel->layer, vsel->hover_id);
+
+        if (o)
+          vsel_draw_outline (vsel, o, TRUE);
+      }
+  }
+
+  /*  3.29.0: the key object (thick: highlighted outline and box)  */
+  {
+    guint            key = chopgimp_vtransform_get_key (vsel->layer);
+    ChopGimpVObject *o   = key ? chopgimp_vlayer_get_object (vsel->layer, key) : NULL;
+
+    if (o && chopgimp_vobject_get_bounds (vsel->layer, o, FALSE, &x1, &y1, &x2, &y2))
+      {
+        GimpCanvasItem *item;
+
+        vsel_draw_outline (vsel, o, TRUE);
+        item = gimp_draw_tool_add_rectangle (dt, FALSE, x1 - 1, y1 - 1,
+                                             x2 - x1 + 2, y2 - y1 + 2);
+        gimp_canvas_item_set_highlight (item, TRUE);
+      }
+  }
+
+  /*  3.29.0: the corner widgets of the only selected path object  */
+  if (vsel->drag == DRAG_NONE || vsel->drag == DRAG_CORNER)
+    {
+      ChopGimpVObject *o = vsel_corner_object (vsel);
+      gdouble         *v;
+      gint             n = 0;
+
+      if (o && (v = chopgimp_vtransform_corners (vsel->layer, o->id, &n)))
+        {
+          gdouble scale = MAX (gimp_display_get_shell (dt->display)->scale_x, 1e-6);
+
+          for (gint i = 0; i < MIN (n, MAX_CORNERS); i++)
+            {
+              gdouble off = vsel_corner_offset (vsel, o->id, i, scale);
+
+              gimp_draw_tool_add_handle (dt, GIMP_HANDLE_CIRCLE,
+                                         v[4 * i]     + v[4 * i + 2] * off,
+                                         v[4 * i + 1] + v[4 * i + 3] * off,
+                                         9, 9, GIMP_HANDLE_ANCHOR_CENTER);
+            }
+          g_free (v);
+        }
+    }
+
+  /*  3.30.0: the widgets of the only selected repeat  */
+  if (vsel->drag == DRAG_NONE || vsel->drag == DRAG_REPEAT)
+    {
+      ChopGimpRepeatWidgets rw;
+
+      if (chopgimp_vrepeat_get_widgets (vsel->layer, &rw))
+        {
+          if (rw.circle)
+            gimp_draw_tool_add_arc (dt, FALSE, rw.cx - rw.r, rw.cy - rw.r,
+                                    2 * rw.r, 2 * rw.r, 0.0, 2 * G_PI);
+          if (rw.line)
+            gimp_draw_tool_add_line (dt, rw.x1, rw.y1, rw.x2, rw.y2);
+
+          for (gint i = 0; i < rw.n; i++)
+            gimp_draw_tool_add_handle (dt,
+                                       rw.handle[i] == CHOPGIMP_REPEAT_HANDLE_CENTER ||
+                                       rw.handle[i] == CHOPGIMP_REPEAT_HANDLE_AXIS
+                                       ? GIMP_HANDLE_FILLED_CIRCLE : GIMP_HANDLE_FILLED_DIAMOND,
+                                       rw.x[i], rw.y[i], 11, 11, GIMP_HANDLE_ANCHOR_CENTER);
+        }
+    }
+
+  /*  the box and its handles  */
+  if (vsel->drag != DRAG_RUBBER && vsel->drag != DRAG_CORNER &&
+      vsel->drag != DRAG_REPEAT &&
+      vsel_box (vsel->layer, &x1, &y1, &x2, &y2))
+    {
+      gimp_draw_tool_add_rectangle (dt, FALSE, x1, y1, x2 - x1, y2 - y1);
+
+      if (vsel->drag == DRAG_NONE)
+        for (gint i = 0; i < 8; i++)
+          {
+            gdouble hx, hy;
+
+            handle_point (i, x1, y1, x2, y2, &hx, &hy);
+            gimp_draw_tool_add_handle (dt, GIMP_HANDLE_SQUARE, hx, hy,
+                                       HANDLE_SIZE, HANDLE_SIZE,
+                                       GIMP_HANDLE_ANCHOR_CENTER);
+          }
+    }
+
+  /*  the entered group  */
+  {
+    guint entered = chopgimp_vlayer_get_entered_group (vsel->layer);
+    ChopGimpVObject *group = entered ? chopgimp_vlayer_get_object (vsel->layer, entered)
+                                     : NULL;
+
+    if (group && chopgimp_vobject_get_bounds (vsel->layer, group, TRUE,
+                                              &x1, &y1, &x2, &y2))
+      {
+        GimpCanvasItem *item = gimp_draw_tool_add_rectangle (dt, FALSE, x1, y1,
+                                                             x2 - x1, y2 - y1);
+
+        gimp_canvas_item_set_highlight (item, TRUE);
+      }
+  }
+
+  if (vsel->drag == DRAG_RUBBER)
+    gimp_draw_tool_add_rectangle (dt, FALSE,
+                                  MIN (vsel->px, vsel->rx), MIN (vsel->py, vsel->ry),
+                                  fabs (vsel->rx - vsel->px), fabs (vsel->ry - vsel->py));
+
+  if (vsel->snap && vsel->drag != DRAG_NONE)
+    chopgimp_vsnap_draw (vsel->snap, dt);
+
+  return TRUE;
+}
+
+
+GimpUIManager *
+chopgimp_vsel_get_popup (ChopGimpVSel     *vsel,
+                         const GimpCoords *coords,
+                         GimpDisplay      *display,
+                         const gchar     **ui_path)
+{
+  GimpImage        *image = gimp_display_get_image (display);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  GimpVectorLayer  *layer;
+  ChopGimpVObject  *hit;
+
+  if (! vsel || ! image || ! chopgimp_vobjects_enabled ())
+    return NULL;
+
+  layer = chopgimp_vobjects_get_target_layer (image);
+  if (! layer)
+    return NULL;
+
+  hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y,
+                                  HIT_TOLERANCE / MAX (shell->scale_x, 1e-6),
+                                  vsel_click_group ? CHOPGIMP_HIT_SELECTABLE
+                                                   : CHOPGIMP_HIT_LEAF);
+  if (! hit)
+    return NULL;
+
+  if (! chopgimp_vlayer_is_selected (layer, hit->id))
+    {
+      chopgimp_vlayer_set_selection (layer, &hit->id, 1);
+      gimp_image_flush (image);
+    }
+
+  /*  the « Vecteur » menu of the menu bar (tools/build_menus.py)  */
+  *ui_path = "/image-menubar/Vecteur";
+
+  return shell->popup_manager;
+}
