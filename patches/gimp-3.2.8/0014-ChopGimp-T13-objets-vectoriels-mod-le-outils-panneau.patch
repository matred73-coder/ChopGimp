+      g_signal_handlers_disconnect_by_data (vsel->layer, vsel);
+      g_object_remove_weak_pointer (G_OBJECT (vsel->layer),
+                                    (gpointer *) &vsel->layer);
+    }
+
+  vsel->layer    = layer;
+  vsel->hover_id = 0;
+
+  if (layer)
+    {
+      g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &vsel->layer);
+      g_signal_connect (layer, "objects-changed",
+                        G_CALLBACK (vsel_layer_changed), vsel);
+      g_signal_connect (layer, "object-selection-changed",
