+/*  TRUE when the press was used  */
+static gboolean
+gimp_path_tool_vobj_press (GimpPathTool     *path_tool,
+                           const GimpCoords *coords,
+                           GdkModifierType   state,
+                           GimpDisplay      *display)
+{
+  GimpTool         *tool  = GIMP_TOOL (path_tool);
+  GimpImage        *image = gimp_display_get_image (display);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  GimpVectorLayer  *layer = chopgimp_vobjects_get_active_layer (image);
+  ChopGimpVObject  *leaf;
+
+  if (! layer)
+    return FALSE;
+
+  /*  4.1.1: the selection is computed again at the release  */
+  {
+    const guint *sel;
+    gint         n = 0;
+
+    sel = chopgimp_vlayer_get_selection (layer, &n);
+
+    if (! path_tool->vobj_prev_sel)
+      path_tool->vobj_prev_sel = g_array_new (FALSE, FALSE, sizeof (guint));
+
+    g_array_set_size (path_tool->vobj_prev_sel, 0);
+    if (n > 0)
+      g_array_append_vals (path_tool->vobj_prev_sel, sel, n);
+
+    path_tool->vobj_track       = TRUE;
+    path_tool->vobj_press_leaf  = 0;
+    path_tool->vobj_press_shift = (state & gimp_get_extend_selection_mask ()) != 0;
+  }
+
+  /*  ChopGimp 4.2.0 « Lasso direct » (Illustrator): always an outline over
+   *  the nodes of ALL the objects of the layer; the objects of the nodes
+   *  caught become the selection at the release
