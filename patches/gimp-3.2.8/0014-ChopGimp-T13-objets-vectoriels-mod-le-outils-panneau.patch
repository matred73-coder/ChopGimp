+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vobject-ops.h — ChopGimp 3.27 (lot V2): commands on the
+ * selected objects of a vector layer (Objet menu, options bar, Move,
+ * Shape Builder and Pathfinder), built on the API of chopgimp-vobject.h
+ *
+ * Every command is one undo step and returns TRUE when it changed
+ * something; the caller flushes the image.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "chopgimp-vobject.h"
+
+G_BEGIN_DECLS
+
+
+typedef enum
+{
+  CHOPGIMP_VARRANGE_FRONT,      /* Premier plan   */
+  CHOPGIMP_VARRANGE_FORWARD,    /* Avancer        */
+  CHOPGIMP_VARRANGE_BACKWARD,   /* Reculer        */
+  CHOPGIMP_VARRANGE_BACK        /* Arrière-plan   */
+} ChopGimpVArrange;
+
+typedef enum
+{
+  CHOPGIMP_VALIGN_LEFT,
+  CHOPGIMP_VALIGN_HCENTER,
+  CHOPGIMP_VALIGN_RIGHT,
+  CHOPGIMP_VALIGN_TOP,
+  CHOPGIMP_VALIGN_VCENTER,
+  CHOPGIMP_VALIGN_BOTTOM,
+  CHOPGIMP_VALIGN_DISTRIBUTE_H,
+  CHOPGIMP_VALIGN_DISTRIBUTE_V
+} ChopGimpVAlign;
+
+typedef enum
+{
+  CHOPGIMP_VPATHFINDER_UNION,
+  CHOPGIMP_VPATHFINDER_MINUS,       /* the bottom one minus the others */
+  CHOPGIMP_VPATHFINDER_INTERSECT,
+  CHOPGIMP_VPATHFINDER_EXCLUDE,
+  CHOPGIMP_VPATHFINDER_DIVIDE
+} ChopGimpVPathfinder;
+
+
+/*  a vector layer worked on as objects: not rasterized, objects enabled,
+ *  and several objects, already edited as objects, or with selected
+ *  objects (3.27.1)
+ */
+gboolean          chopgimp_vobjects_layer_is_multi   (GimpVectorLayer *layer);
+/*  3.27.1: any vector layer the Move tool works on as objects (one legacy
+ *  object or more): attached, not rasterized, objects enabled
+ */
+gboolean          chopgimp_vobjects_layer_is_target  (GimpVectorLayer *layer);
+/*  the only selected layer of @image when it is such a layer, else NULL
+ *  (always NULL with CHOPGIMP_NO_VOBJECTS=1)
+ */
+GimpVectorLayer * chopgimp_vobjects_get_active_layer (GimpImage       *image);
+gint              chopgimp_vobjects_n_selected       (GimpVectorLayer *layer);
+/*  the vector layer a new shape is added to (« Ajouter au calque
+ *  vectoriel actif »): the only selected layer when it is a vector layer
+ *  (one object or more), else NULL
+ */
+GimpVectorLayer * chopgimp_vobjects_get_target_layer (GimpImage       *image);
+/*  adds a new path object (@path in image coordinates) to @layer, in the
+ *  entered group or on top, and selects it; one undo step
+ */
+ChopGimpVObject * chopgimp_vobjects_add_path         (GimpVectorLayer *layer,
+                                                      GimpPath        *path,
+                                                      const gchar     *name,
+                                                      const ChopGimpVStyle *style);
+
+/*  the path objects of @object (itself for a path), bottom → top
+ *  (g_list_free only)
+ */
+GList           * chopgimp_vobjects_leaves_of        (ChopGimpVObject *object);
+/*  the first leaf of @object (its style), or NULL  */
+ChopGimpVObject * chopgimp_vobjects_first_leaf       (ChopGimpVObject *object);
+/*  @world (image coordinates) in the local space of @object: a new
+ *  unattached path (g_object_unref)
+ */
+GimpPath        * chopgimp_vobjects_path_to_local    (ChopGimpVObject *object,
+                                                      GimpPath        *world);
+/*  inserts @object whose path is in image coordinates into @parent
+ *  (NULL: root) at @position, corrected for the transformation of the
+ *  parent; no undo step (the caller pushed one)
+ */
+void              chopgimp_vobjects_insert_world     (GimpVectorLayer *layer,
+                                                      ChopGimpVObject *object,
+                                                      ChopGimpVObject *parent,
+                                                      gint             position);
+/*  the style of a new object made with the fill / stroke of a tool
+ *  (GimpPathOptions: enable-fill, fill-options, enable-stroke,
+ *  stroke-options), to clear with chopgimp_vstyle_clear()
+ */
+void              chopgimp_vobjects_style_from_tool  (ChopGimpVStyle  *style,
+                                                      GimpImage       *image,
+                                                      gboolean         enable_fill,
+                                                      GimpFillOptions *fill_options,
+                                                      gboolean         enable_stroke,
+                                                      GimpStrokeOptions *stroke_options);
+
+/*  ─── sensitivity ───────────────────────────────────────────────────── */
+
+gboolean          chopgimp_vobjects_can_group        (GimpVectorLayer *layer);
+gboolean          chopgimp_vobjects_can_ungroup      (GimpVectorLayer *layer);
+gboolean          chopgimp_vobjects_can_clip_make    (GimpVectorLayer *layer);
+gboolean          chopgimp_vobjects_can_clip_release (GimpVectorLayer *layer);
+gboolean          chopgimp_vobjects_can_pathfinder   (GimpVectorLayer *layer);
+
+/*  ─── commands ──────────────────────────────────────────────────────── */
+
+gboolean          chopgimp_vobjects_select_all       (GimpVectorLayer *layer);
+
+/*  3.29.3 (Illustrator « Sélection > Identique »): from the first selected
+ *  object, select every visible, unlocked leaf of the layer with the same
+ *  plain fill color / stroke color / either of them
+ */
+typedef enum
+{
+  CHOPGIMP_VSAME_FILL,
+  CHOPGIMP_VSAME_STROKE,
+  CHOPGIMP_VSAME_COLOR
+} ChopGimpVSame;
+
+gboolean          chopgimp_vobjects_select_same      (GimpVectorLayer *layer,
+                                                      ChopGimpVSame    what);
+gboolean          chopgimp_vobjects_select_inverse   (GimpVectorLayer *layer);
+/*  leaves whose bounds are smaller than @area px²: their count  */
+gint              chopgimp_vobjects_select_smaller   (GimpVectorLayer *layer,
+                                                      gdouble          area);
+gint              chopgimp_vobjects_delete_smaller   (GimpVectorLayer *layer,
+                                                      gdouble          area);
+/*  the leaves of each plain fill color become one object (union), one
+ *  undo step; the number of objects removed
+ */
+gint              chopgimp_vobjects_merge_same_color (GimpVectorLayer *layer);
+/*  4.1.1: the one object selection. What every style change edits: the
+ *  visible, unlocked path leaves of the selected objects (free the list)
+ */
+GList           * chopgimp_vobjects_style_targets    (GimpVectorLayer *layer);
+/*  one undo step per modification (a burst of the same change is one
+ *  step); TRUE when a step was pushed
+ */
+gboolean          chopgimp_vobjects_style_undo       (GimpVectorLayer *layer,
+                                                      const gchar     *desc);
+/*  a tool's fill (@fill) or stroke options → all the targets  */
+gboolean          chopgimp_vobjects_apply_tool_style (GimpVectorLayer   *layer,
+                                                      gboolean           enable_fill,
+                                                      GimpFillOptions   *fill_options,
+                                                      gboolean           enable_stroke,
+                                                      GimpStrokeOptions *stroke_options,
+                                                      gboolean           fill);
+/*  the first target → a tool's options; FALSE when nothing is selected  */
+gboolean          chopgimp_vobjects_load_tool_style  (GimpVectorLayer   *layer,
+                                                      gboolean          *enable_fill,
+                                                      GimpFillOptions   *fill_options,
+                                                      gboolean          *enable_stroke,
+                                                      GimpStrokeOptions *stroke_options);
+/*  the plain fill / stroke colors of the first target (not owned)  */
+gboolean          chopgimp_vobjects_selection_colors (GimpVectorLayer  *layer,
+                                                      GeglColor       **fill,
+                                                      GeglColor       **stroke);
+/*  recolor the selected objects (the targets): their fill (@stroke FALSE)
+ *  or stroke; @color NULL: none. One undo step per burst unless
+ *  @push_undo is FALSE; no step when they already have this color.
+ */
+gboolean          chopgimp_vobjects_apply_color      (GimpVectorLayer *layer,
+                                                      GeglColor       *color,
+                                                      gboolean         stroke,
+                                                      gboolean         push_undo);
+gboolean          chopgimp_vobjects_swap_fill_stroke (GimpVectorLayer *layer);
+/*  the next selectable object under (@x, @y) below the selected one
+ *  (Tab, Illustrator), wrapping; FALSE if none
+ */
+gboolean          chopgimp_vobjects_select_next_under (GimpVectorLayer *layer,
+                                                       gdouble          x,
+                                                       gdouble          y,
+                                                       gdouble          tolerance);
+/*  the next object below / above the selected one in the stacking order
+ *  (Ctrl+Alt+[ / Ctrl+Alt+], Illustrator), wrapping
+ */
+gboolean          chopgimp_vobjects_select_adjacent  (GimpVectorLayer *layer,
+                                                      gboolean         above);
+/*  lock / hide everything but the selection (Ctrl+Alt+2 / Ctrl+Alt+3)  */
+/*  « Simplifier »: the selected leaves (all when none) with fewer nodes
+ *  (@tolerance px); « Remplir les petits trous »: their holes (sub-paths
+ *  that are not the largest one) smaller than @area px² are removed.
+ *  One undo step unless @push_undo is FALSE (live preview).
+ */
+gint              chopgimp_vobjects_simplify         (GimpVectorLayer *layer,
+                                                      gdouble          tolerance,
+                                                      gboolean         push_undo);
+gint              chopgimp_vobjects_fill_holes       (GimpVectorLayer *layer,
+                                                      gdouble          area);
+/*  3.29.3: « Simplifier » with a live preview: the original paths are
+ *  kept; preview() simplifies them with no undo step and returns the
+ *  number of nodes before / after; end() puts them back and, when
+ *  @commit, applies @tolerance as one undo step
+ */
+typedef struct _ChopGimpVSimplify ChopGimpVSimplify;
+
+ChopGimpVSimplify * chopgimp_vsimplify_begin       (GimpVectorLayer   *layer);
+gboolean          chopgimp_vsimplify_preview       (ChopGimpVSimplify *s,
+                                                    gdouble            tolerance,
+                                                    gint              *n_before,
+                                                    gint              *n_after);
+void              chopgimp_vsimplify_end           (ChopGimpVSimplify *s,
+                                                    gboolean           commit,
+                                                    gdouble            tolerance);
+/*  3.29.3: « Couleurs du dessin »: the plain fill / stroke colors of the
+ *  free leaves (R'G'B'A u8 as 0xRRGGBBAA) with their number of uses, the
+ *  most used first (GArray of ChopGimpVColorUse)
+ */
+typedef struct
+{
+  guint32 key;
+  gint    count;
+} ChopGimpVColorUse;
+
+GArray          * chopgimp_vobjects_drawing_colors   (GimpVectorLayer *layer);
+/*  selects the free leaves whose fill or stroke is @key  */
+gboolean          chopgimp_vobjects_select_color_key (GimpVectorLayer *layer,
+                                                      guint32          key);
+/*  every fill / stroke of color @key becomes @color (one undo step);
+ *  returns the number of objects changed
+ */
+gint              chopgimp_vobjects_replace_color_key (GimpVectorLayer *layer,
+                                                       guint32          key,
+                                                       GeglColor       *color);
+gboolean          chopgimp_vobjects_lock_others      (GimpVectorLayer *layer);
+gboolean          chopgimp_vobjects_hide_others      (GimpVectorLayer *layer);
+gboolean          chopgimp_vobjects_delete_selection (GimpVectorLayer *layer);
+/*  the copies go right above their originals and become the selection  */
+gboolean          chopgimp_vobjects_duplicate_selection (GimpVectorLayer *layer,
+                                                      gboolean         push_undo);
+gboolean          chopgimp_vobjects_group_selection  (GimpVectorLayer *layer);
+gboolean          chopgimp_vobjects_ungroup_selection (GimpVectorLayer *layer);
