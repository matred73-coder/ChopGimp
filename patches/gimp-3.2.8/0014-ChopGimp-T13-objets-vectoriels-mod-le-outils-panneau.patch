+   */
+  gchar             *material;
+} ChopGimpPaint;
+
+/*  3.27.2 « Aspect »: the appearance of a path object is an ordered stack
+ *  of fills and strokes (Illustrator's Appearance panel), drawn bottom →
+ *  top; by default one fill under one stroke.
+ */
+typedef enum
+{
+  CHOPGIMP_VENTRY_FILL,
+  CHOPGIMP_VENTRY_STROKE
+} ChopGimpVEntryKind;
+
+typedef struct
+{
+  ChopGimpVEntryKind   kind;
+  ChopGimpPaint        paint;
+  gdouble              opacity;       /* 0..1, of this fill / stroke only    */
+  GimpLayerMode        mode;          /* blend mode on what is under it, in
+                                       * the object (rendered as the object
+                                       * modes, see ChopGimpVObject.mode)    */
+  gboolean             visible;
+
+  /*  STROKE only  */
+  gdouble              width;         /* pixels (scaled by the transformation) */
+  ChopGimpStrokeAlign  align;
+  GimpCapStyle         cap;
+  GimpJoinStyle        join;
+  gdouble              miter_limit;
+  GArray              *dashes;        /* gdouble, in multiples of the width
+                                       * (GIMP's convention); NULL = solid   */
+  gdouble              dash_offset;   /* pixels                              */
+  /*  width profile: NULL = uniform, a preset name (see
+   *  chopgimp_vstyle_get_profile_presets()) or « t:w,t:w… » (t: 0..1 along
+   *  each sub-path, w: fraction of @width, 0..1). Drawn centred, solid.
+   */
+  gchar               *profile;
+  /*  3.27.6: the stroke takes the paint of the primary fill (the
+   *  hairline that hides the seams of a pixel art trace): changing the
+   *  fill changes it too (XML « follow-fill »)
+   */
+  gboolean             follow_fill;
+  /*  arrowheads at the ends of open sub-paths: NULL or « triangle »,
+   *  « arrow », « circle », « square », « bar »; size = 4 × width × scale
+   */
+  gchar               *arrow_start;
+  gchar               *arrow_end;
+  gdouble              arrow_scale;
+  /*  3.29.1: a gradient on a stroke (Illustrator): 0 within the stroke
+   *  (the object's box), 1 along the path, 2 across the stroke
+   */
+  gint                 stroke_gradient;
+} ChopGimpVEntry;
+
+typedef struct
+{
+  GPtrArray           *entries;       /* ChopGimpVEntry *, bottom → top (owned) */
+  gboolean             fill_nonzero;  /* FALSE: even-odd, like GIMP          */
+  gboolean             antialias;
+} ChopGimpVStyle;
+
+struct _ChopGimpVObject
+{
+  /*  read-only: change them with the functions below  */
+  guint                id;            /* unique in the layer; the root is 0  */
+  ChopGimpVObjectKind  kind;
+  gchar               *name;
+  GimpPath            *path;          /* PATH: an unattached GimpPath of the
+                                       * layer's image, local coordinates    */
+  GimpMatrix3          transform;     /* local → parent (affine part used)   */
+  ChopGimpVStyle       style;         /* PATH only                           */
+  gdouble              opacity;       /* 0..1                                */
+  GimpLayerMode        mode;          /* normal, multiply, screen, overlay,
+                                       * darken, lighten, dodge, burn, hard
+                                       * and soft light, difference,
+                                       * exclusion, addition, HSL color and
+                                       * LCh hue/chroma/lightness are
+                                       * rendered; others render as normal  */
+  gboolean             visible;
+  gboolean             locked;
+  gchar               *lpe;           /* live path effects (key file of
+                                       * chopgimp_geom_effects) or NULL: then
+                                       * the layer's « chopgimp-lpe » parasite
+                                       * applies                             */
+  GPtrArray           *children;      /* GROUP: ChopGimpVObject *, bottom → top */
+  ChopGimpVObject     *parent;        /* the group; NULL for the root        */
+  gboolean             clip;          /* GROUP (3.27 lot V2): « masque
+                                       * d'écrêtage », the top child clips
+                                       * the others and is not drawn        */
+  /*  3.27.7 « Peinture dynamique » (chopgimp-vlivepaint.h): NULL, or on
+   *  the group « group gap=G sig=S », on its children « sources » (the
+   *  hidden group of the paths), « face » or « edge src=N »
+   */
+  gchar               *livepaint;
+  /*  3.27.7 « Symboles » (chopgimp-vsymbols.h): on a group, the id of the
+   *  symbol it is an occurrence of (its children are a copy of the
+   *  symbol's objects), else NULL
+   */
+  gchar               *symbol;
+  /*  3.29.1 « Masque d'opacité » (GROUP): 0, or CHOPGIMP_OPMASK_* flags:
+   *  the top child, by its luminance, makes the others transparent (it
+   *  is not drawn itself)
+   */
+  gint                 opmask;
+  /*  3.29.1 « Transition » (chopgimp-vmaterial.h): on a group, its spec
+   *  « blend steps=N … sig=S »; on the generated steps « step ».
+   *  3.30.0: the field of every dynamic group: « repeat … » (instances
+   *  « rinst », chopgimp-vrepeat.h), « brush … » (part « bpart »,
+   *  chopgimp-vbrush.h)
+   */
+  gchar               *blend;
+
+  /*< private >*/
+  gint                 ref_count;
+  gpointer             cache;         /* cairo_surface_t * of the rendering  */
+  gint                 cache_x, cache_y;
+  gdouble              cache_fx, cache_fy; /* 3.29.2: sub-pixel shift of the
+                                            * cache while dragging           */
+  gboolean             bounds_valid[2];
+  gdouble              bounds[2][4];
+  GimpPath            *effective;     /* path after the live effects         */
+  gboolean             effective_valid;
+  guint64              rev;           /* 3.29.6: changed at every change of
+                                       * the rendering (cache dropped or
+                                       * shifted); copies keep it            */  gboolean             cache_a8;      /* 4.0.0: the cache is the coverage
+                                       * only (A8) of a single solid color,
+                                       * cache_rgb, painted through it       */
+  gdouble              cache_rgb[3];
+};
