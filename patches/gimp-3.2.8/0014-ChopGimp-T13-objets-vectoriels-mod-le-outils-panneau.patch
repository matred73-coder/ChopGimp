+static void
+vsel_watch (ChopGimpVSel    *vsel,
+            GimpVectorLayer *layer)
+{
+  if (vsel->layer == layer)
+    return;
+
+  if (vsel->layer)
+    {
+      if (vsel->interactive)
+        {
