+/*  ChopGimp 4.2.1: the newest file of @dir newer than its « .vu » stamp
+ *  (the stamp is then touched), NULL when none
+ */
+static gchar *
+chopgimp_crash_newest_report (const gchar *dir)
+{
+  GDir        *d;
+  const gchar *name;
+  gchar       *seen_path;
+  gchar       *best      = NULL;
+  gint64       best_time = 0;
+  gint64       seen      = 0;
+  GStatBuf     st;
+
+  if (! dir || ! (d = g_dir_open (dir, 0, NULL)))
+    return NULL;
+
+  seen_path = g_build_filename (dir, ".vu", NULL);
+  if (g_stat (seen_path, &st) == 0)
+    seen = st.st_mtime;
+
+  while ((name = g_dir_read_name (d)))
+    {
+      gchar *p;
+
+      if (! g_str_has_prefix (name, "chopgimp-crash-"))
+        continue;
+      p = g_build_filename (dir, name, NULL);
+      if (g_stat (p, &st) == 0 && st.st_mtime >= seen && st.st_mtime > best_time)
+        {
+          g_free (best);
+          best      = p;
+          best_time = st.st_mtime;
+        }
+      else
+        {
+          g_free (p);
+        }
+    }
+  g_dir_close (d);
+
+  if (best)
+    g_file_set_contents (seen_path, "", 0, NULL);
+  g_free (seen_path);
+
+  return best;
+}
