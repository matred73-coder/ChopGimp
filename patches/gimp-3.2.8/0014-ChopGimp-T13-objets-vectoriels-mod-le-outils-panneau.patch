+/*  3.27.2 (lot V6 point 2): « Couleurs globales » in the swatch popover
+ *  and ◆ next to the swatch of a paint following a global color
+ */
+static GimpImage *
+row_hook_image (GObject *options)
+{
+  Row *r = CHOPGIMP_PAINT_PROXY (options)->data;
+
+  return r ? r->panel->image : NULL;
+}
+
+static const gchar *
+row_hook_get_global (GObject     *options,
+                     const gchar *prop)
+{
+  Row             *r = CHOPGIMP_PAINT_PROXY (options)->data;
+  ChopGimpVObject *leaf;
+  GList           *targets;
+  ChopGimpVEntry  *e;
+
+  if (! r)
+    return NULL;
+
+  targets = panel_reference (r->panel, &leaf);
+  e       = leaf ? ref_entry (&leaf->style, r->ref) : NULL;
+  g_list_free (targets);
+
+  return e ? e->paint.global_id : NULL;
+}
+
+static void
+row_hook_set_global (GObject     *options,
+                     const gchar *prop,
+                     const gchar *id)
+{
+  Row         *r  = CHOPGIMP_PAINT_PROXY (options)->data;
+  FieldChange  fc = { { 0, }, F_PAINT_GLOBAL };
+
+  if (! r || ! r->panel->image)
+    return;
+
+  fc.ref   = r->ref;
+  fc.str   = id;
+  fc.image = r->panel->image;
+  panel_change (r->panel, &fc, 0, id ? _("Aspect : couleur globale")
+                                     : _("Aspect : délier la couleur globale"));
+}
+
+static const ChopGimpGlobalColorHooks row_global_hooks =
+{
+  row_hook_image,
+  row_hook_get_global,
+  row_hook_set_global
+};
