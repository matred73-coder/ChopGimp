+static gboolean
+d_number (const gchar **p,
+          gdouble      *v)
+{
+  const gchar *s = *p;
+  gchar       *end;
+
+  while (*s == ' ' || *s == ',' || *s == '\t' || *s == '\n' || *s == '\r')
+    s++;
+
+  if (! (*s == '-' || *s == '+' || *s == '.' || g_ascii_isdigit (*s)))
+    return FALSE;
+
+  *v = g_ascii_strtod (s, &end);
+
+  if (end == s)
+    return FALSE;
+
+  *p = end;
+
+  return TRUE;
+}
+
+/*  M L H V C Z (absolute and relative); other commands end the parse  */
+static void
+path_from_d (GimpPath    *path,
+             const gchar *d)
+{
+  DStroke      ds   = { g_array_new (FALSE, FALSE, sizeof (GimpCoords)), FALSE };
+  gdouble      cx   = 0, cy = 0, sx = 0, sy = 0;
+  gchar        cmd  = 0;
+  const gchar *p    = d;
+
+  if (! d)
+    {
+      g_array_free (ds.coords, TRUE);
+      return;
+    }
+
+  gimp_path_freeze (path);
+
+  while (*p)
+    {
+      gdouble v[6];
+      gboolean rel;
+
+      while (*p == ' ' || *p == ',' || *p == '\t' || *p == '\n' || *p == '\r')
+        p++;
+
+      if (! *p)
+        break;
+
+      if (g_ascii_isalpha (*p))
+        cmd = *p++;
+      else if (! cmd)
+        break;
+
+      rel = g_ascii_islower (cmd);
+
+      switch (g_ascii_toupper (cmd))
+        {
+        case 'Z':
+          if (ds.open)
+            d_flush (path, &ds, TRUE);
+          cx = sx; cy = sy;
+          cmd = 0;
+          break;
+
+        case 'M':
+          if (! d_number (&p, &v[0]) || ! d_number (&p, &v[1]))
+            goto done;
+          if (ds.open)
+            d_flush (path, &ds, FALSE);
+          cx = rel ? cx + v[0] : v[0];
+          cy = rel ? cy + v[1] : v[1];
+          sx = cx; sy = cy;
+          {
+            GimpCoords c = chopgimp_coords (cx, cy);
+
+            g_array_append_val (ds.coords, c);
+            g_array_append_val (ds.coords, c);
+            g_array_append_val (ds.coords, c);
+          }
+          ds.open = TRUE;
+          cmd = rel ? 'l' : 'L';
+          break;
+
+        case 'L':
+        case 'H':
+        case 'V':
+          {
+            gchar      up = g_ascii_toupper (cmd);
+            gdouble    x  = cx, y = cy;
+            GimpCoords c;
+
+            if (up == 'L')
+              {
+                if (! d_number (&p, &v[0]) || ! d_number (&p, &v[1]))
+                  goto done;
+                x = rel ? cx + v[0] : v[0];
+                y = rel ? cy + v[1] : v[1];
+              }
+            else
+              {
+                if (! d_number (&p, &v[0]))
+                  goto done;
+                if (up == 'H')
+                  x = rel ? cx + v[0] : v[0];
+                else
+                  y = rel ? cy + v[0] : v[0];
+              }
+
+            if (! ds.open)
+              {
+                c = chopgimp_coords (cx, cy);
+                g_array_append_val (ds.coords, c);
+                g_array_append_val (ds.coords, c);
+                g_array_append_val (ds.coords, c);
+                ds.open = TRUE;
+              }
+
+            c = chopgimp_coords (x, y);
+            g_array_append_val (ds.coords, c);
+            g_array_append_val (ds.coords, c);
+            g_array_append_val (ds.coords, c);
+            cx = x; cy = y;
+          }
+          break;
+
+        case 'C':
+          {
+            GimpCoords c;
+            guint      n;
+
+            for (gint i = 0; i < 6; i++)
+              if (! d_number (&p, &v[i]))
+                goto done;
+
+            if (rel)
+              for (gint i = 0; i < 6; i += 2)
+                {
+                  v[i]     += cx;
+                  v[i + 1] += cy;
+                }
+
+            if (! ds.open)
+              {
+                c = chopgimp_coords (cx, cy);
+                g_array_append_val (ds.coords, c);
+                g_array_append_val (ds.coords, c);
+                g_array_append_val (ds.coords, c);
+                ds.open = TRUE;
+              }
+
+            n = ds.coords->len;
+            g_array_index (ds.coords, GimpCoords, n - 1) = chopgimp_coords (v[0], v[1]);
+
+            c = chopgimp_coords (v[2], v[3]);
+            g_array_append_val (ds.coords, c);
+            c = chopgimp_coords (v[4], v[5]);
+            g_array_append_val (ds.coords, c);
+            g_array_append_val (ds.coords, c);
+            cx = v[4]; cy = v[5];
+          }
+          break;
+
+        default:
+          g_printerr ("ChopGimp: unsupported path command « %c »\n", cmd);
+          goto done;
+        }
+    }
+
+ done:
+  if (ds.open)
+    d_flush (path, &ds, FALSE);
+
+  g_array_free (ds.coords, TRUE);
+
+  gimp_path_thaw (path);
+}
+
+
+/*  ─── paints and styles ─────────────────────────────────────────────── */
+
+static void
+paint_clear (ChopGimpPaint *p)
+{
+  g_clear_object (&p->color);
+  g_clear_object (&p->pattern);
+  g_clear_pointer (&p->global_id, g_free);
+  g_clear_pointer (&p->material, g_free);
+
+  if (p->stops)
+    {
+      for (guint i = 0; i < p->stops->len; i++)
+        g_clear_object (&g_array_index (p->stops, ChopGimpGradientStop, i).color);
+
+      g_array_free (p->stops, TRUE);
+      p->stops = NULL;
+    }
+
+  p->type = CHOPGIMP_PAINT_NONE;
+}
+
+static void
+paint_copy (ChopGimpPaint       *dest,
+            const ChopGimpPaint *src)
+{
+  if (dest == src)
+    return;
+
+  paint_clear (dest);
+
+  *dest = *src;
+  dest->color     = src->color   ? gegl_color_duplicate (src->color) : NULL;
+  dest->pattern   = src->pattern ? g_object_ref (src->pattern)       : NULL;
+  dest->global_id = g_strdup (src->global_id);
+  dest->material  = g_strdup (src->material);
+  dest->stops     = NULL;
+
+  if (src->stops)
+    for (guint i = 0; i < src->stops->len; i++)
+      {
+        ChopGimpGradientStop *st = &g_array_index (src->stops, ChopGimpGradientStop, i);
+
+        chopgimp_vpaint_add_stop (dest, st->offset, st->color);
+      }
+}
+
+void
+chopgimp_vpaint_copy (ChopGimpPaint       *dest,
+                      const ChopGimpPaint *src)
+{
+  paint_copy (dest, src);
+}
+
+void
+chopgimp_vpaint_set_color (ChopGimpPaint *paint,
+                           GeglColor     *color)
+{
+  paint_clear (paint);
+
+  paint->type  = CHOPGIMP_PAINT_COLOR;
+  paint->color = color ? gegl_color_duplicate (color) : gegl_color_new ("black");
+}
+
+void
+chopgimp_vpaint_clear (ChopGimpPaint *paint)
+{
+  paint_clear (paint);
+}
+
+void
+chopgimp_vpaint_set_pattern (ChopGimpPaint *paint,
+                             GimpPattern   *pattern)
+{
+  paint_clear (paint);
+
+  if (pattern)
+    {
+      paint->type    = CHOPGIMP_PAINT_PATTERN;
+      paint->pattern = g_object_ref (pattern);
+    }
+}
+
+void
+chopgimp_vpaint_set_material (ChopGimpPaint     *paint,
+                              ChopGimpPaintType  type,
+                              const gchar       *material,
+                              GeglColor         *main)
+{
+  GeglColor *keep;
+  gchar     *text;
+
+  g_return_if_fail (paint != NULL);
+
+  /*  @main / @material may belong to @paint itself  */
+  keep = main ? gegl_color_duplicate (main) : NULL;
+  text = g_strdup (material);
+
+  paint_clear (paint);
+
+  paint->type     = type;
+  paint->material = text;
+  paint->color    = keep;
+}
+
+void
+chopgimp_vpaint_add_stop (ChopGimpPaint *paint,
+                          gdouble        offset,
+                          GeglColor     *color)
+{
+  ChopGimpGradientStop st;
+  guint                i;
+
+  if (! paint->stops)
+    paint->stops = g_array_new (FALSE, TRUE, sizeof (ChopGimpGradientStop));
+
+  st.offset = CLAMP (offset, 0.0, 1.0);
+  st.color  = color ? gegl_color_duplicate (color) : gegl_color_new ("black");
+
+  for (i = 0; i < paint->stops->len; i++)
+    if (g_array_index (paint->stops, ChopGimpGradientStop, i).offset > st.offset)
+      break;
+
+  g_array_insert_val (paint->stops, i, st);
+}
+
+void
+chopgimp_vpaint_set_global (ChopGimpPaint *paint,
+                            GimpImage     *image,
+                            const gchar   *id)
+{
+  GeglColor *color;
+
+  if (! id)
+    {
+      g_clear_pointer (&paint->global_id, g_free);
+      return;
+    }
+
+  color = image ? chopgimp_vcolors_get_color (image, id) : NULL;
+
+  if (color || paint->type != CHOPGIMP_PAINT_COLOR)
+    chopgimp_vpaint_set_color (paint, color ? color : chopgimp_vpaint_get_main_color (paint));
+
+  g_free (paint->global_id);
+  paint->global_id = g_strdup (id);
+}
+
+GeglColor *
+chopgimp_vpaint_get_main_color (const ChopGimpPaint *p)
+{
+  if (p->type == CHOPGIMP_PAINT_COLOR)
+    return p->color;
+
+  /*  3.29.1: the main color of a mesh, freeform or vector pattern  */
+  if ((p->type == CHOPGIMP_PAINT_MESH || p->type == CHOPGIMP_PAINT_FREEFORM ||
+       p->type == CHOPGIMP_PAINT_VPATTERN) && p->color)
+    return p->color;
+
+  if ((p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+       p->type == CHOPGIMP_PAINT_RADIAL_GRADIENT) && p->stops && p->stops->len)
+    return g_array_index (p->stops, ChopGimpGradientStop, 0).color;
+
+  return NULL;
+}
+
+/*  the paint takes the color of its global swatch; TRUE when it changed  */
+static gboolean
+paint_resolve_global (ChopGimpPaint *p,
+                      GimpImage     *image,
+                      const gchar   *id)
+{
+  GeglColor *color;
+  gdouble    a[4], b[4];
+
+  if (! p->global_id || (id && strcmp (p->global_id, id)) || ! image)
+    return FALSE;
+
+  color = chopgimp_vcolors_get_color (image, p->global_id);
+
+  if (! color)
+    return FALSE;   /* a removed swatch: the paint keeps its color */
+
+  if (p->type == CHOPGIMP_PAINT_COLOR && p->color)
+    {
+      gegl_color_get_pixel (p->color, babl_format ("R'G'B'A double"), a);
+      gegl_color_get_pixel (color,    babl_format ("R'G'B'A double"), b);
+
+      if (fabs (a[0] - b[0]) < 1e-9 && fabs (a[1] - b[1]) < 1e-9 &&
+          fabs (a[2] - b[2]) < 1e-9 && fabs (a[3] - b[3]) < 1e-9)
+        return FALSE;
+
+      g_object_unref (p->color);
+      p->color = gegl_color_duplicate (color);
+    }
+  else
+    {
+      gchar *gid = g_strdup (p->global_id);
+
+      chopgimp_vpaint_set_color (p, color);
+      p->global_id = gid;
+    }
+
+  return TRUE;
+}
+
+
+/*  ─── the appearance stack ──────────────────────────────────────────── */
+
+ChopGimpVEntry *
+chopgimp_ventry_new (ChopGimpVEntryKind kind)
+{
+  ChopGimpVEntry *e = g_new0 (ChopGimpVEntry, 1);
+
+  e->kind        = kind;
+  e->opacity     = 1.0;
+  e->mode        = GIMP_LAYER_MODE_NORMAL;
+  e->visible     = TRUE;
+  e->width       = 1.0;
+  e->align       = CHOPGIMP_STROKE_ALIGN_CENTER;
+  e->cap         = GIMP_CAP_BUTT;
+  e->join        = GIMP_JOIN_MITER;
+  e->miter_limit = 10.0;
+  e->arrow_scale = 1.0;
+
+  chopgimp_vpaint_set_color (&e->paint, NULL);
+
+  return e;
+}
+
+void
+chopgimp_ventry_free (ChopGimpVEntry *e)
+{
+  if (! e)
+    return;
+
+  paint_clear (&e->paint);
+
+  if (e->dashes)
+    g_array_free (e->dashes, TRUE);
+
+  g_free (e->profile);
+  g_free (e->arrow_start);
+  g_free (e->arrow_end);
+  g_free (e);
+}
+
+ChopGimpVEntry *
+chopgimp_ventry_copy (const ChopGimpVEntry *src)
+{
+  ChopGimpVEntry *e = g_new0 (ChopGimpVEntry, 1);
+
+  *e = *src;
+  memset (&e->paint, 0, sizeof (ChopGimpPaint));
+  paint_copy (&e->paint, &src->paint);
+
+  e->dashes      = (src->dashes && src->dashes->len > 0) ?
+                   gimp_dash_pattern_copy (src->dashes) : NULL;
+  e->profile     = g_strdup (src->profile);
+  e->arrow_start = g_strdup (src->arrow_start);
+  e->arrow_end   = g_strdup (src->arrow_end);
+
+  return e;
+}
+
+gboolean
+chopgimp_ventry_is_painted (const ChopGimpVEntry *e)
+{
+  return (e && e->visible && e->opacity > 0.0 &&
+          e->paint.type != CHOPGIMP_PAINT_NONE &&
+          (e->kind == CHOPGIMP_VENTRY_FILL || e->width > 0.0));
+}
+
+static gboolean
+profile_is_uniform (const gchar *profile)
+{
+  return ! profile || ! *profile || ! strcmp (profile, "uniform");
+}
+
+/*  the width profile presets (Illustrator's « Profil de largeur »)  */
+static const struct
+{
+  const gchar *name;
+  const gchar *label;
+  const gchar *points;
+}
+profile_presets[] =
+{
+  { "uniform",     N_("Uniforme"),              "0:1,1:1"                         },
+  { "lens",        N_("Fuseau (fin - épais - fin)"), "0:0,0.5:1,1:0"              },
+  { "taper-end",   N_("Effilé à la fin"),       "0:1,1:0"                         },
+  { "taper-start", N_("Effilé au début"),       "0:0,1:1"                         },
+  { "taper-both",  N_("Effilé aux deux bouts"), "0:0,0.15:1,0.85:1,1:0"           },
+  { "pinch",       N_("Pincé au milieu"),       "0:1,0.5:0.25,1:1"                },
+  { "bulge-start", N_("Goutte (épais au début)"), "0:0.4,0.2:1,1:0"               },
+  { "wave",        N_("Ondulé"),                "0:0.4,0.25:1,0.5:0.4,0.75:1,1:0.4" }
+};
+
+/*  3.27.6: the profiles saved by the user (outil Largeur): name → points  */
+static GPtrArray *user_profile_names  = NULL;
+static GPtrArray *user_profile_points = NULL;
+static GPtrArray *all_profile_names   = NULL;
+
+static gchar *
+user_profiles_file (void)
+{
+  return g_build_filename (gimp_directory (), "chopgimp-width-profiles", NULL);
+}
+
+static void
+user_profiles_load (void)
+{
+  GKeyFile *kf;
+  gchar    *file;
+  gchar   **keys;
+
+  if (user_profile_names)
+    return;
+
+  user_profile_names  = g_ptr_array_new_with_free_func (g_free);
+  user_profile_points = g_ptr_array_new_with_free_func (g_free);
+
+  kf   = g_key_file_new ();
+  file = user_profiles_file ();
+
+  if (g_key_file_load_from_file (kf, file, G_KEY_FILE_NONE, NULL) &&
+      (keys = g_key_file_get_keys (kf, "profiles", NULL, NULL)))
+    {
+      for (gchar **k = keys; *k; k++)
+        {
+          gchar *v = g_key_file_get_string (kf, "profiles", *k, NULL);
+
+          if (v && strchr (v, ':'))
+            {
+              g_ptr_array_add (user_profile_names, g_strdup (*k));
+              g_ptr_array_add (user_profile_points, v);
+            }
+          else
+            g_free (v);
+        }
+
+      g_strfreev (keys);
+    }
+
+  g_key_file_free (kf);
+  g_free (file);
+}
+
+void
+chopgimp_vstyle_save_profile (const gchar *name,
+                              const gchar *points)
+{
+  GKeyFile *kf;
+  gchar    *file;
+
+  g_return_if_fail (name && *name && points && strchr (points, ':'));
+
+  user_profiles_load ();
+
+  kf   = g_key_file_new ();
+  file = user_profiles_file ();
+
+  g_key_file_load_from_file (kf, file, G_KEY_FILE_KEEP_COMMENTS, NULL);
+  g_key_file_set_string (kf, "profiles", name, points);
+  g_key_file_save_to_file (kf, file, NULL);
+  g_key_file_free (kf);
+  g_free (file);
+
+  /*  reloaded on the next call  */
+  g_clear_pointer (&user_profile_names, g_ptr_array_unref);
+  g_clear_pointer (&user_profile_points, g_ptr_array_unref);
+  g_clear_pointer (&all_profile_names, g_ptr_array_unref);
+}
+
+const gchar * const *
+chopgimp_vstyle_get_profile_presets (void)
+{
+  user_profiles_load ();
+
+  if (! all_profile_names)
+    {
+      all_profile_names = g_ptr_array_new ();
+
+      for (guint i = 0; i < G_N_ELEMENTS (profile_presets); i++)
+        g_ptr_array_add (all_profile_names, (gpointer) profile_presets[i].name);
+
+      for (guint i = 0; i < user_profile_points->len; i++)
+        g_ptr_array_add (all_profile_names, user_profile_points->pdata[i]);
+
+      g_ptr_array_add (all_profile_names, NULL);
+    }
+
+  return (const gchar * const *) all_profile_names->pdata;
+}
+
+const gchar *
+chopgimp_vstyle_get_profile_label (const gchar *profile)
+{
+  if (profile_is_uniform (profile))
+    return _(profile_presets[0].label);
+
+  for (guint i = 0; i < G_N_ELEMENTS (profile_presets); i++)
+    if (! strcmp (profile, profile_presets[i].name))
+      return _(profile_presets[i].label);
+
+  user_profiles_load ();
+
+  for (guint i = 0; i < user_profile_points->len; i++)
+    if (! strcmp (profile, user_profile_points->pdata[i]))
+      return user_profile_names->pdata[i];
+
+  return _("Personnalisé");
+}
+
+gint
+chopgimp_vstyle_find_profile (const gchar *profile)
+{
+  const gchar * const *names = chopgimp_vstyle_get_profile_presets ();
+
+  if (profile_is_uniform (profile))
+    return 0;
+
+  for (gint i = 0; names[i]; i++)
+    if (! strcmp (names[i], profile))
+      return i;
+
+  return -1;
+}
+
+/*  « t:w,… » with w in fractions of the width  */
+static const gchar *
+profile_points (const gchar *profile)
+{
+  for (guint i = 0; i < G_N_ELEMENTS (profile_presets); i++)
+    if (! strcmp (profile, profile_presets[i].name))
+      return profile_presets[i].points;
+
+  return profile;
+}
+
+/*  the largest width of a profile, in fractions of the stroke width
+ *  (both sides of « t:left/right »)
+ */
+static gdouble
+profile_max_factor (const gchar *profile)
+{
+  gchar  **items = g_strsplit (profile_points (profile), ",", -1);
+  gdouble  m     = 1.0;
+
+  for (gchar **it = items; *it; it++)
+    {
+      gchar *colon = strchr (*it, ':');
+      gchar *slash;
+
+      if (! colon)
+        continue;
+
+      m = MAX (m, g_ascii_strtod (colon + 1, NULL));
+      if ((slash = strchr (colon + 1, '/')))
+        m = MAX (m, g_ascii_strtod (slash + 1, NULL));
+    }
+
+  g_strfreev (items);
+
+  return m;
+}
+
+const gchar *
+chopgimp_vstyle_get_profile_points (const gchar *profile)
+{
+  return profile_is_uniform (profile) ? profile_presets[0].points
+                                      : profile_points (profile);
+}
+
+gint
+chopgimp_vstyle_get_n_entries (const ChopGimpVStyle *style)
+{
+  return style->entries ? style->entries->len : 0;
+}
+
+ChopGimpVEntry *
+chopgimp_vstyle_get_entry (const ChopGimpVStyle *style,
+                           gint                  index)
+{
+  if (! style->entries || index < 0 || index >= (gint) style->entries->len)
+    return NULL;
+
+  return g_ptr_array_index (style->entries, index);
+}
+
+gint
+chopgimp_vstyle_get_entry_index (const ChopGimpVStyle *style,
+                                 const ChopGimpVEntry *entry)
+{
+  guint i;
+
+  if (style->entries && g_ptr_array_find (style->entries, entry, &i))
+    return i;
+
+  return -1;
+}
+
+static void
+style_ensure_array (ChopGimpVStyle *style)
+{
+  if (! style->entries)
+    style->entries = g_ptr_array_new_with_free_func ((GDestroyNotify) chopgimp_ventry_free);
+}
+
+void
+chopgimp_vstyle_insert_entry (ChopGimpVStyle *style,
+                              ChopGimpVEntry *entry,
+                              gint            position)
+{
+  g_return_if_fail (entry != NULL);
+
+  style_ensure_array (style);
+
+  if (position < 0 || position > (gint) style->entries->len)
+    position = style->entries->len;
+
+  g_ptr_array_insert (style->entries, position, entry);
+}
+
+void
+chopgimp_vstyle_remove_entry (ChopGimpVStyle *style,
+                              gint            index)
+{
+  if (style->entries && index >= 0 && index < (gint) style->entries->len)
+    g_ptr_array_remove_index (style->entries, index);
+}
+
+void
+chopgimp_vstyle_move_entry (ChopGimpVStyle *style,
+                            gint            from,
+                            gint            to)
+{
+  gpointer e;
+
+  if (! style->entries || from < 0 || from >= (gint) style->entries->len)
+    return;
+
+  to = CLAMP (to, 0, (gint) style->entries->len - 1);
+
+  if (to == from)
+    return;
+
+  e = g_ptr_array_steal_index (style->entries, from);
+  g_ptr_array_insert (style->entries, to, e);
+}
+
+static ChopGimpVEntry *
+style_top_of_kind (const ChopGimpVStyle *style,
+                   ChopGimpVEntryKind    kind)
+{
+  if (style->entries)
+    for (gint i = style->entries->len - 1; i >= 0; i--)
+      {
+        ChopGimpVEntry *e = g_ptr_array_index (style->entries, i);
+
+        if (e->kind == kind)
+          return e;
+      }
+
+  return NULL;
+}
+
+ChopGimpVEntry *
+chopgimp_vstyle_get_fill (const ChopGimpVStyle *style)
+{
+  return style_top_of_kind (style, CHOPGIMP_VENTRY_FILL);
+}
+
+ChopGimpVEntry *
+chopgimp_vstyle_get_stroke (const ChopGimpVStyle *style)
+{
+  return style_top_of_kind (style, CHOPGIMP_VENTRY_STROKE);
+}
+
+ChopGimpVEntry *
+chopgimp_vstyle_ensure_fill (ChopGimpVStyle *style)
+{
+  ChopGimpVEntry *e = chopgimp_vstyle_get_fill (style);
+  gint            pos;
+
+  if (e)
+    return e;
+
+  e = chopgimp_ventry_new (CHOPGIMP_VENTRY_FILL);
+  paint_clear (&e->paint);
+
+  /*  under the lowest stroke  */
+  style_ensure_array (style);
+
+  for (pos = 0; pos < (gint) style->entries->len; pos++)
+    if (((ChopGimpVEntry *) g_ptr_array_index (style->entries, pos))->kind ==
+        CHOPGIMP_VENTRY_STROKE)
+      break;
+
+  chopgimp_vstyle_insert_entry (style, e, pos);
+
+  return e;
+}
+
+ChopGimpVEntry *
+chopgimp_vstyle_ensure_stroke (ChopGimpVStyle *style)
+{
+  ChopGimpVEntry *e = chopgimp_vstyle_get_stroke (style);
+
+  if (e)
+    return e;
+
+  e = chopgimp_ventry_new (CHOPGIMP_VENTRY_STROKE);
+  paint_clear (&e->paint);
+  chopgimp_vstyle_insert_entry (style, e, -1);
+
+  return e;
+}
+
+gboolean
+chopgimp_vstyle_has_fill (const ChopGimpVStyle *style)
+{
+  for (gint i = 0; i < chopgimp_vstyle_get_n_entries (style); i++)
+    {
+      ChopGimpVEntry *e = g_ptr_array_index (style->entries, i);
+
+      if (e->kind == CHOPGIMP_VENTRY_FILL && chopgimp_ventry_is_painted (e))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+gboolean
+chopgimp_vstyle_has_stroke (const ChopGimpVStyle *style)
+{
+  for (gint i = 0; i < chopgimp_vstyle_get_n_entries (style); i++)
+    {
+      ChopGimpVEntry *e = g_ptr_array_index (style->entries, i);
+
+      if (e->kind == CHOPGIMP_VENTRY_STROKE && chopgimp_ventry_is_painted (e))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+void
+chopgimp_vstyle_copy_primary_fill (ChopGimpVStyle       *dest,
+                                   const ChopGimpVStyle *src)
+{
+  ChopGimpVEntry *s = chopgimp_vstyle_get_fill (src);
+  ChopGimpVEntry *d = chopgimp_vstyle_ensure_fill (dest);
+
+  if (s)
+    paint_copy (&d->paint, &s->paint);
+  else
+    paint_clear (&d->paint);
+}
+
+void
+chopgimp_vstyle_copy_primary_stroke (ChopGimpVStyle       *dest,
+                                     const ChopGimpVStyle *src)
+{
+  ChopGimpVEntry *s = chopgimp_vstyle_get_stroke (src);
+  ChopGimpVEntry *d = chopgimp_vstyle_ensure_stroke (dest);
+
+  if (! s)
+    {
+      paint_clear (&d->paint);
+      return;
+    }
+
+  paint_copy (&d->paint, &s->paint);
+
+  d->width       = s->width;
+  d->cap         = s->cap;
+  d->join        = s->join;
+  d->miter_limit = s->miter_limit;
+  d->dash_offset = s->dash_offset;
+
+  if (d->dashes)
+    g_array_free (d->dashes, TRUE);
+  d->dashes = (s->dashes && s->dashes->len > 0) ? gimp_dash_pattern_copy (s->dashes) : NULL;
+}
+
+gboolean
+chopgimp_vstyle_uses_global (const ChopGimpVStyle *style,
+                             const gchar          *id)
+{
+  for (gint i = 0; i < chopgimp_vstyle_get_n_entries (style); i++)
+    {
+      ChopGimpVEntry *e = g_ptr_array_index (style->entries, i);
+
+      if (e->paint.global_id && (! id || ! strcmp (e->paint.global_id, id)))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+void
+chopgimp_vstyle_init (ChopGimpVStyle *style)
+{
+  ChopGimpVEntry *stroke;
+
+  memset (style, 0, sizeof (ChopGimpVStyle));
+
+  style->antialias = TRUE;
+
+  chopgimp_vstyle_insert_entry (style, chopgimp_ventry_new (CHOPGIMP_VENTRY_FILL), -1);
+
+  stroke = chopgimp_ventry_new (CHOPGIMP_VENTRY_STROKE);
+  paint_clear (&stroke->paint);
+  chopgimp_vstyle_insert_entry (style, stroke, -1);
+}
+
+void
+chopgimp_vstyle_clear (ChopGimpVStyle *style)
+{
+  if (style->entries)
+    {
+      g_ptr_array_free (style->entries, TRUE);
+      style->entries = NULL;
+    }
+}
+
+void
+chopgimp_vstyle_copy (ChopGimpVStyle       *dest,
+                      const ChopGimpVStyle *src)
+{
+  GPtrArray *entries = NULL;
+
+  if (dest == src)
+    return;
+
+  if (src->entries)
+    {
+      entries = g_ptr_array_new_full (src->entries->len,
+                                      (GDestroyNotify) chopgimp_ventry_free);
+
+      for (guint i = 0; i < src->entries->len; i++)
+        g_ptr_array_add (entries, chopgimp_ventry_copy (g_ptr_array_index (src->entries, i)));
+    }
+
+  chopgimp_vstyle_clear (dest);
+
+  *dest = *src;
+  dest->entries = entries;
+}
+
+/*  drops every entry (a group's style)  */
+static void
+style_make_empty (ChopGimpVStyle *style)
+{
+  if (style->entries)
+    g_ptr_array_set_size (style->entries, 0);
+}
+
+static gdouble
+options_stroke_width (GimpVectorLayerOptions *options)
+{
+  GimpStrokeOptions *so    = options->stroke_options;
+  gdouble            width = gimp_stroke_options_get_width (so);
+  GimpUnit          *unit  = gimp_stroke_options_get_unit (so);
+
+  if (unit && unit != gimp_unit_pixel () && options->path)
+    {
+      GimpImage *image = gimp_item_get_image (GIMP_ITEM (options->path));
+      gdouble    xres, yres;
+
+      gimp_image_get_resolution (image, &xres, &yres);
+      width = gimp_units_to_pixels (width, unit, yres);
+    }
+
+  return width;
+}
+
+static void
+paint_from_fill_options (ChopGimpPaint   *paint,
+                         GimpFillOptions *fo,
+                         gboolean         enabled)
+{
+  /*  3.27.2: the options only hold a solid color or a pattern: a paint
+   *  they already describe (a gradient or a global color with that main
+   *  color, the same pattern) is kept as it is
+   */
+  if (enabled)
+    {
+      GimpCustomStyle cs = gimp_fill_options_get_custom_style (fo);
+
+      if (paint->type == CHOPGIMP_PAINT_PATTERN)
+        {
+          if (cs == GIMP_CUSTOM_STYLE_PATTERN &&
+              gimp_context_get_pattern (GIMP_CONTEXT (fo)) == paint->pattern)
+            return;
+        }
+      else if (cs != GIMP_CUSTOM_STYLE_PATTERN &&
+               chopgimp_vpaint_get_main_color (paint))
+        {
+          gdouble a[4], b[4];
+
+          gegl_color_get_pixel (chopgimp_vpaint_get_main_color (paint),
+                                babl_format ("R'G'B'A double"), a);
+          gegl_color_get_pixel (gimp_context_get_foreground (GIMP_CONTEXT (fo)),
+                                babl_format ("R'G'B'A double"), b);
+
+          if (fabs (a[0] - b[0]) < 1e-4 && fabs (a[1] - b[1]) < 1e-4 &&
+              fabs (a[2] - b[2]) < 1e-4 && fabs (a[3] - b[3]) < 1e-4)
+            return;
+        }
+    }
+
+  paint_clear (paint);
+
+  if (! enabled)
+    return;
+
+  if (gimp_fill_options_get_custom_style (fo) == GIMP_CUSTOM_STYLE_PATTERN &&
+      gimp_context_get_pattern (GIMP_CONTEXT (fo)))
+    {
+      paint->type    = CHOPGIMP_PAINT_PATTERN;
+      paint->pattern = g_object_ref (gimp_context_get_pattern (GIMP_CONTEXT (fo)));
+    }
+  else
+    {
+      chopgimp_vpaint_set_color (paint,
+                                 gimp_context_get_foreground (GIMP_CONTEXT (fo)));
+    }
+}
+
+/*  the primary fill / stroke from the options; the other fills and
+ *  strokes and the stroke alignment, profile, arrowheads are kept
+ */
+static void
+style_merge_options (ChopGimpVStyle         *style,
+                     GimpVectorLayerOptions *options)
+{
+  GimpStrokeOptions *so     = options->stroke_options;
+  ChopGimpVEntry    *fill   = chopgimp_vstyle_ensure_fill (style);
+  ChopGimpVEntry    *stroke = chopgimp_vstyle_ensure_stroke (style);
+  GArray            *dash;
+
+  paint_from_fill_options (&fill->paint, options->fill_options,
+                           options->enable_fill);
+  paint_from_fill_options (&stroke->paint, GIMP_FILL_OPTIONS (so),
+                           options->enable_stroke);
+
+  /*  shown again: the options say it is on  */
+  if (options->enable_fill)
+    fill->visible = TRUE;
+  if (options->enable_stroke)
+    stroke->visible = TRUE;
+
+  stroke->width       = options_stroke_width (options);
+  stroke->cap         = gimp_stroke_options_get_cap_style (so);
+  stroke->join        = gimp_stroke_options_get_join_style (so);
+  stroke->miter_limit = gimp_stroke_options_get_miter_limit (so);
+  stroke->dash_offset = gimp_stroke_options_get_dash_offset (so);
+  style->antialias    = gimp_fill_options_get_antialias (options->fill_options);
+
+  if (stroke->dashes)
+    g_array_free (stroke->dashes, TRUE);
+  stroke->dashes = NULL;
+
+  dash = gimp_stroke_options_get_dash_info (so);
+  if (dash && dash->len > 0)
+    stroke->dashes = gimp_dash_pattern_copy (dash);
+}
+
+void
+chopgimp_vstyle_from_options (ChopGimpVStyle         *style,
+                              GimpVectorLayerOptions *options)
+{
+  chopgimp_vstyle_clear (style);
+  chopgimp_vstyle_init (style);
+
+  style->fill_nonzero = FALSE;
+  style_merge_options (style, options);
+}
+
+void
+chopgimp_vstyle_merge_options (ChopGimpVStyle         *style,
+                               GimpVectorLayerOptions *options)
+{
+  style_merge_options (style, options);
+}
+
+static void
+paint_to_fill_options (const ChopGimpPaint *paint,
+                       GimpFillOptions     *fo)
+{
+  GeglColor *color = chopgimp_vpaint_get_main_color (paint);
+
+  if (paint->type == CHOPGIMP_PAINT_PATTERN && paint->pattern)
+    {
+      gimp_fill_options_set_custom_style (fo, GIMP_CUSTOM_STYLE_PATTERN);
+      gimp_context_set_pattern (GIMP_CONTEXT (fo), paint->pattern);
+    }
+  else if (color)
+    {
+      gimp_fill_options_set_custom_style (fo, GIMP_CUSTOM_STYLE_SOLID_COLOR);
+      gimp_context_set_foreground (GIMP_CONTEXT (fo), color);
+    }
+}
+
+void
+chopgimp_vstyle_to_options (const ChopGimpVStyle   *style,
+                            GimpVectorLayerOptions *options)
+{
+  GimpStrokeOptions *so     = options->stroke_options;
+  ChopGimpVEntry    *fill   = chopgimp_vstyle_get_fill (style);
+  ChopGimpVEntry    *stroke = chopgimp_vstyle_get_stroke (style);
+
+  g_object_set (options,
+                "enable-fill",   (fill && fill->visible &&
+                                  fill->paint.type != CHOPGIMP_PAINT_NONE),
+                "enable-stroke", (stroke && stroke->visible &&
+                                  stroke->paint.type != CHOPGIMP_PAINT_NONE &&
+                                  stroke->width > 0),
+                NULL);
+
+  if (fill)
+    paint_to_fill_options (&fill->paint, options->fill_options);
+
+  if (stroke)
+    {
+      paint_to_fill_options (&stroke->paint, GIMP_FILL_OPTIONS (so));
+
+      g_object_set (so,
+                    "width",       stroke->width,
+                    "unit",        gimp_unit_pixel (),
+                    "cap-style",   stroke->cap,
+                    "join-style",  stroke->join,
+                    "miter-limit", stroke->miter_limit,
+                    "dash-offset", stroke->dash_offset,
+                    NULL);
+
+      if (stroke->dashes && stroke->dashes->len > 0)
+        gimp_stroke_options_take_dash_pattern (so, GIMP_DASH_CUSTOM,
+                                               gimp_dash_pattern_copy (stroke->dashes));
+      else
+        gimp_stroke_options_take_dash_pattern (so, GIMP_DASH_LINE,
+                                               gimp_dash_pattern_new_from_preset (GIMP_DASH_LINE));
+    }
+
+  gimp_fill_options_set_antialias (options->fill_options, style->antialias);
+  gimp_fill_options_set_antialias (GIMP_FILL_OPTIONS (so), style->antialias);
+}
+
+
+/*  ─── objects ───────────────────────────────────────────────────────── */
+
+/*  3.29.6: the revisions of the objects (main thread only)  */
+static guint64 vobj_rev_counter = 0;
+
+static ChopGimpVObject *
+vobj_alloc (ChopGimpVObjectKind kind,
+            const gchar        *name)
+{
+  ChopGimpVObject *o = g_new0 (ChopGimpVObject, 1);
+
+  o->rev       = ++vobj_rev_counter;
+  o->ref_count = 1;
+  o->kind      = kind;
+  o->name      = g_strdup (name ? name : "");
+  o->opacity   = 1.0;
+  o->mode      = GIMP_LAYER_MODE_NORMAL;
+  o->visible   = TRUE;
+  gimp_matrix3_identity (&o->transform);
+  chopgimp_vstyle_init (&o->style);
+
+  if (kind == CHOPGIMP_VOBJECT_GROUP)
+    {
+      o->children = g_ptr_array_new_with_free_func ((GDestroyNotify) chopgimp_vobject_unref);
+      style_make_empty (&o->style);
+    }
+
+  return o;
+}
+
+static void
+vobj_drop_cache (ChopGimpVObject *o)
+{
+  if (o->cache)
+    {
+      cairo_surface_destroy (o->cache);
+      o->cache = NULL;
+    }
+
+  o->cache_fx = o->cache_fy = 0.0;
+  o->bounds_valid[0] = o->bounds_valid[1] = FALSE;
+  o->rev = ++vobj_rev_counter;
+}
+
+/*  geometry or style changed: forget the renderings (whole subtree)  */
+static void
+vobj_invalidate (ChopGimpVObject *o)
+{
+  vobj_drop_cache (o);
+  g_clear_object (&o->effective);
+  o->effective_valid = FALSE;
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      vobj_invalidate (g_ptr_array_index (o->children, i));
+}
+
+/*  3.29.2: a translation of the world (interactive drag): the bounds and
+ *  the cached renderings move with it, nothing is rasterized again (the
+ *  effective path is in the object's coordinates and stays valid)
+ */
+static void
+vobj_shift (ChopGimpVObject *o,
+            gdouble          dx,
+            gdouble          dy)
+{
+  o->rev = ++vobj_rev_counter;
+
+  for (gint k = 0; k < 2; k++)
+    if (o->bounds_valid[k])
+      {
+        o->bounds[k][0] += dx;
+        o->bounds[k][1] += dy;
+        o->bounds[k][2] += dx;
+        o->bounds[k][3] += dy;
+      }
+
+  if (o->cache)
+    {
+      gdouble ix, iy;
+
+      o->cache_fx += dx;
+      o->cache_fy += dy;
+      ix = floor (o->cache_fx);
+      iy = floor (o->cache_fy);
+      o->cache_x  += (gint) ix;
+      o->cache_y  += (gint) iy;
+      o->cache_fx -= ix;
+      o->cache_fy -= iy;
+    }
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      vobj_shift (g_ptr_array_index (o->children, i), dx, dy);
+}
+
+/*  3.29.2: after a drag, only the renderings moved by a fraction of a
+ *  pixel are made again (a whole-pixel move keeps them exact)
+ */
+static void
+vobj_settle (ChopGimpVObject *o)
+{
+  if (o->cache && (o->cache_fx != 0.0 || o->cache_fy != 0.0))
+    vobj_drop_cache (o);
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      vobj_settle (g_ptr_array_index (o->children, i));
+}
+
+static gboolean
+matrix_is_translation (const GimpMatrix3 *m)
+{
+  return (fabs (m->coeff[0][0] - 1.0) < 1e-12 && fabs (m->coeff[1][1] - 1.0) < 1e-12 &&
+          fabs (m->coeff[0][1]) < 1e-12 && fabs (m->coeff[1][0]) < 1e-12 &&
+          fabs (m->coeff[2][0]) < 1e-12 && fabs (m->coeff[2][1]) < 1e-12 &&
+          fabs (m->coeff[2][2] - 1.0) < 1e-12);
+}
+
+ChopGimpVObject *
+chopgimp_vobject_new_path (GimpImage            *image,
+                           GimpPath             *path,
+                           const gchar          *name,
+                           const ChopGimpVStyle *style)
+{
+  ChopGimpVObject *o;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  o       = vobj_alloc (CHOPGIMP_VOBJECT_PATH, name);
+  o->path = g_object_ref_sink (gimp_path_new (image, o->name));
+
+  if (path)
+    gimp_path_copy_strokes (path, o->path);
+
+  if (style)
+    chopgimp_vstyle_copy (&o->style, style);
+
+  return o;
+}
+
+ChopGimpVObject *
+chopgimp_vobject_new_group (const gchar *name)
+{
+  return vobj_alloc (CHOPGIMP_VOBJECT_GROUP, name ? name : "Groupe");
+}
+
+ChopGimpVObject *
+chopgimp_vobject_ref (ChopGimpVObject *object)
+{
+  g_return_val_if_fail (object != NULL, NULL);
+
+  object->ref_count++;
+
+  return object;
+}
+
+void
+chopgimp_vobject_unref (ChopGimpVObject *object)
+{
+  if (! object || --object->ref_count > 0)
+    return;
+
+  vobj_drop_cache (object);
+  g_clear_object (&object->effective);
+  g_clear_object (&object->path);
+  chopgimp_vstyle_clear (&object->style);
+  g_free (object->name);
+  g_free (object->lpe);
+  g_free (object->livepaint);
+  g_free (object->symbol);
+  g_free (object->blend);
+
+  if (object->children)
+    {
+      for (guint i = 0; i < object->children->len; i++)
+        ((ChopGimpVObject *) g_ptr_array_index (object->children, i))->parent = NULL;
+
+      g_ptr_array_free (object->children, TRUE);
+    }
+
+  g_free (object);
+}
+
+/*  all but the id, the path, the children and the renderings  */
+static void
+vobj_copy_attrs (ChopGimpVObject       *c,
+                 const ChopGimpVObject *object)
+{
+  c->transform = object->transform;
+  c->opacity   = object->opacity;
+  c->mode      = object->mode;
+  c->visible   = object->visible;
+  c->locked    = object->locked;
+  c->lpe       = g_strdup (object->lpe);
+  c->clip      = object->clip;
+  c->livepaint = g_strdup (object->livepaint);
+  c->symbol    = g_strdup (object->symbol);
+  c->opmask    = object->opmask;
+  c->blend     = g_strdup (object->blend);
+  chopgimp_vstyle_copy (&c->style, &object->style);
+}
+
+ChopGimpVObject *
+chopgimp_vobject_copy (ChopGimpVObject *object,
+                       GimpImage       *dest_image)
+{
+  ChopGimpVObject *c;
+
+  g_return_val_if_fail (object != NULL, NULL);
+
+  c = vobj_alloc (object->kind, object->name);
+
+  vobj_copy_attrs (c, object);
+
+  if (object->path)
+    {
+      c->path = g_object_ref_sink (gimp_path_new (dest_image, c->name));
+      gimp_path_copy_strokes (object->path, c->path);
+    }
+
+  if (object->children)
+    for (guint i = 0; i < object->children->len; i++)
+      {
+        ChopGimpVObject *child = chopgimp_vobject_copy (g_ptr_array_index (object->children, i),
+                                                        dest_image);
+
+        child->parent = c;
+        g_ptr_array_add (c->children, child);
+      }
+
+  return c;
+}
+
+gint
+chopgimp_vobject_get_index (ChopGimpVObject *object)
+{
+  guint i;
+
+  if (! object->parent)
+    return -1;
+
+  if (g_ptr_array_find (object->parent->children, object, &i))
+    return i;
+
+  return -1;
+}
+
+gboolean
+chopgimp_vobject_is_ancestor (ChopGimpVObject *ancestor,
+                              ChopGimpVObject *object)
+{
+  for (object = object ? object->parent : NULL; object; object = object->parent)
+    if (object == ancestor)
+      return TRUE;
+
+  return FALSE;
+}
+
+gboolean
+chopgimp_vobject_is_visible (ChopGimpVObject *object)
+{
+  for (; object; object = object->parent)
+    if (! object->visible)
+      return FALSE;
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobject_is_locked (ChopGimpVObject *object)
+{
+  for (; object; object = object->parent)
+    if (object->locked)
+      return TRUE;
+
+  return FALSE;
+}
+
+void
+chopgimp_vobject_get_world_matrix (ChopGimpVObject *object,
+                                   GimpMatrix3     *matrix)
+{
+  ChopGimpVObject *p;
+
+  *matrix = object->transform;
+
+  for (p = object->parent; p; p = p->parent)
+    gimp_matrix3_mult (&p->transform, matrix);
+}
+
+
+/*  ─── per-layer state ───────────────────────────────────────────────── */
+
+static void
+index_rec (ChopGimpVLayer  *vl,
+           ChopGimpVObject *o)
+{
+  g_hash_table_insert (vl->by_id, GUINT_TO_POINTER (o->id), o);
+
+  if (o->id >= vl->next_id)
+    vl->next_id = o->id + 1;
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      {
+        ChopGimpVObject *c = g_ptr_array_index (o->children, i);
+
+        c->parent = o;
+        index_rec (vl, c);
+      }
+}
+
+static void
+vlayer_reindex (ChopGimpVLayer *vl)
+{
+  g_hash_table_remove_all (vl->by_id);
+  index_rec (vl, vl->root);
+}
+
+static ChopGimpVLayer *
+vlayer_new (void)
+{
+  ChopGimpVLayer *vl = g_new0 (ChopGimpVLayer, 1);
+
+  vl->root       = vobj_alloc (CHOPGIMP_VOBJECT_GROUP, "");
+  vl->by_id      = g_hash_table_new (NULL, NULL);
+  vl->next_id    = 1;
+  vl->selection  = g_array_new (FALSE, FALSE, sizeof (guint));
+  vl->stroke_map = g_hash_table_new (NULL, NULL);
+  vl->layouts    = g_ptr_array_new_with_free_func ((GDestroyNotify) g_array_unref);
+
+  vlayer_reindex (vl);
+
+  return vl;
+}
+
+static void
+vlayer_drop_prev (ChopGimpVLayer *vl)
+{
+  g_clear_pointer (&vl->snap_ids, g_hash_table_unref);
+
+  if (vl->snap_prev)
+    {
+      chopgimp_vobject_unref (vl->snap_prev);
+      vl->snap_prev = NULL;
+    }
+}
+
+void
+chopgimp_vlayer_free (ChopGimpVLayer *vl)
+{
+  if (! vl)
+    return;
+
+  chopgimp_vobject_unref (vl->root);
+  g_hash_table_unref (vl->by_id);
+  g_array_free (vl->selection, TRUE);
+  g_hash_table_unref (vl->stroke_map);
+  g_ptr_array_unref (vl->layouts);
+  g_free (vl->opt_sig);
+  g_free (vl->layer_lpe);
+  if (vl->moved)
+    g_hash_table_unref (vl->moved);
+  sprite_free (vl);
+  vlayer_drop_prev (vl);
+  g_free (vl);
+}
+
+/*  new ids for the objects without one or with a taken one  */
+static void
+assign_ids (ChopGimpVLayer  *vl,
+            ChopGimpVObject *o)
+{
+  if (o->id == 0 || g_hash_table_contains (vl->by_id, GUINT_TO_POINTER (o->id)))
+    o->id = vl->next_id++;
+
+  g_hash_table_insert (vl->by_id, GUINT_TO_POINTER (o->id), o);
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      {
+        ChopGimpVObject *c = g_ptr_array_index (o->children, i);
+
+        c->parent = o;
+        assign_ids (vl, c);
+      }
+}
+
+/*  3.27.7: ids for the objects added in place (id 0), then the index  */
+static void
+assign_missing_rec (ChopGimpVLayer  *vl,
+                    ChopGimpVObject *o)
+{
+  if (o != vl->root && o->id == 0)
+    o->id = vl->next_id++;
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      {
+        ChopGimpVObject *c = g_ptr_array_index (o->children, i);
+
+        c->parent = o;
+        assign_missing_rec (vl, c);
+      }
+}
+
+static void
+vlayer_assign_missing_ids (ChopGimpVLayer  *vl,
+                           ChopGimpVObject *o)
+{
+  assign_missing_rec (vl, o);
+  vlayer_reindex (vl);
+}
+
+static void
+vlayer_push_layout (ChopGimpVLayer *vl,
+                    GArray         *layout)
+{
+  g_ptr_array_add (vl->layouts, layout);
+
+  while (vl->layouts->len > LAYOUT_HISTORY)
+    g_ptr_array_remove_index (vl->layouts, 0);
+}
+
+/*  the layout of the legacy path when it is written from @leaves in order  */
+static GArray *
+layout_of_leaves (GList *leaves)
+{
+  GArray *layout = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      gint             n = gimp_path_get_n_strokes (o->path);
+
+      for (gint i = 0; i < n; i++)
+        g_array_append_val (layout, o->id);
+    }
+
+  return layout;
+}
+
+static gchar *
+options_sig (GimpVectorLayerOptions *options);
+static void
+vlayer_style_from_options (GimpVectorLayer *layer);
+
+/*  the layer's state, creating the legacy object #1 when needed  */
+static ChopGimpVLayer *
+vlayer_ensure (GimpVectorLayer *layer)
+{
+  GimpVectorLayerOptions *options = layer->options;
+  ChopGimpVLayer         *vl;
+  ChopGimpVObject        *o;
+  GimpStroke             *s;
+  GimpImage              *image;
+
+  if (layer->vobjects)
+    return layer->vobjects;
+
+  if (! chopgimp_vobjects_enabled () || ! options || ! options->path)
+    return NULL;
+
+  image = gimp_item_get_image (GIMP_ITEM (layer));
+  vl    = vlayer_new ();
+  o     = chopgimp_vobject_new_path (image, options->path,
+                                     gimp_object_get_name (layer), NULL);
+  chopgimp_vstyle_from_options (&o->style, options);
+
+  o->parent = vl->root;
+  g_ptr_array_add (vl->root->children, o);
+  assign_ids (vl, o);
+
+  vl->legacy = TRUE;
+
+  for (s = gimp_path_stroke_get_next (options->path, NULL); s;
+       s = gimp_path_stroke_get_next (options->path, s))
+    {
+      g_hash_table_insert (vl->stroke_map, GINT_TO_POINTER (gimp_stroke_get_id (s)),
+                           GUINT_TO_POINTER (o->id));
+      vl->mapped++;
+    }
+
+  {
+    GList *leaves = g_list_prepend (NULL, o);
+
+    vlayer_push_layout (vl, layout_of_leaves (leaves));
+    g_list_free (leaves);
+  }
+
+  vl->opt_sig = options_sig (options);
+
+  layer->vobjects = vl;
+
+  return vl;
+}
+
+static gboolean
+layer_usable (GimpVectorLayer *layer)
+{
+  return (GIMP_IS_VECTOR_LAYER (layer) &&
+          gimp_item_is_vector_layer (GIMP_ITEM (layer)));
+}
+
+ChopGimpVObject *
+chopgimp_vlayer_get_root (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl;
+
+  if (! layer_usable (layer))
+    return NULL;
+
+  vl = vlayer_ensure (layer);
+
+  return vl ? vl->root : NULL;
+}
+
+gboolean
+chopgimp_vlayer_has_objects (GimpVectorLayer *layer)
+{
+  return (GIMP_IS_VECTOR_LAYER (layer) && layer->vobjects &&
+          ! layer->vobjects->legacy);
+}
+
+gboolean
+chopgimp_vlayer_is_legacy (GimpVectorLayer *layer)
+{
+  return ! layer->vobjects || layer->vobjects->legacy;
+}
+
+ChopGimpVObject *
+chopgimp_vlayer_get_object (GimpVectorLayer *layer,
+                            guint            id)
+{
+  ChopGimpVLayer *vl;
+
+  if (! layer_usable (layer) || ! (vl = vlayer_ensure (layer)))
+    return NULL;
+
+  return g_hash_table_lookup (vl->by_id, GUINT_TO_POINTER (id));
+}
+
+GList *
+chopgimp_vlayer_get_leaves (GimpVectorLayer *layer)
+{
+  return chopgimp_vobjects_leaves_of (chopgimp_vlayer_get_root (layer));
+}
+
+gint
+chopgimp_vlayer_count_leaves (GimpVectorLayer *layer)
+{
+  GList *leaves = chopgimp_vlayer_get_leaves (layer);
+  gint   n      = g_list_length (leaves);
+
+  g_list_free (leaves);
+
+  return n;
+}
+
+static ChopGimpVObject *
+first_leaf (ChopGimpVObject *root)
+{
+  GList           *leaves = chopgimp_vobjects_leaves_of (root);
+  ChopGimpVObject *first  = leaves ? leaves->data : NULL;
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      if (gimp_path_get_n_strokes (o->path) > 0)
+        {
+          first = o;
+          break;
+        }
+    }
+
+  g_list_free (leaves);
+
+  return first;
+}
+
+ChopGimpVObject *
+chopgimp_vlayer_get_first_leaf (GimpVectorLayer *layer)
+{
+  return first_leaf (chopgimp_vlayer_get_root (layer));
+}
+
+
+/*  ─── serialization ─────────────────────────────────────────────────── */
+
+static void
+put_attr_str (GString     *s,
+              const gchar *key,
+              const gchar *value)
+{
+  gchar *v = g_markup_escape_text (value, -1);
+
+  g_string_append_printf (s, " %s=\"%s\"", key, v);
+  g_free (v);
+}
+
+/*  one fill or stroke of the stack. The attributes of version 1 come
+ *  first, in the same order (options_sig() compares texts); those of
+ *  version 2 are written only when they are not the defaults.
+ */
+static void
+write_entry (GString              *s,
+             const ChopGimpVEntry *e,
+             const ChopGimpVStyle *st)
+{
+  static const gchar  *types[] = { "none", "color", "linear", "radial", "pattern",
+                                   "mesh", "freeform", "vpattern" };
+  const ChopGimpVEntry *fill   = (e->follow_fill && st) ? chopgimp_vstyle_get_fill (st) : NULL;
+  const ChopGimpPaint *p       = fill ? &fill->paint : &e->paint;
+  const gchar         *element = (e->kind == CHOPGIMP_VENTRY_STROKE) ? "stroke" : "fill";
+  gboolean             stops   = (p->stops && p->stops->len > 0 &&
+                                  (p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+                                   p->type == CHOPGIMP_PAINT_RADIAL_GRADIENT));
+
+  g_string_append_printf (s, "<%s type=\"%s\"", element, types[p->type]);
+
+  if (p->type == CHOPGIMP_PAINT_COLOR)
+    {
+      g_string_append (s, " color=\"");
+      put_color (s, p->color);
+      g_string_append_c (s, '"');
+    }
+  else if (p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+           p->type == CHOPGIMP_PAINT_RADIAL_GRADIENT)
+    {
+      const gchar *keys[]   = { "x1", "y1", "x2", "y2", "r" };
+      gdouble      values[] = { p->x1, p->y1, p->x2, p->y2, p->r };
+
+      for (gint i = 0; i < 5; i++)
+        {
+          g_string_append_printf (s, " %s=\"", keys[i]);
+          chopgimp_put_num (s, values[i]);
+          g_string_append_c (s, '"');
+        }
+    }
+  else if (p->type == CHOPGIMP_PAINT_PATTERN && p->pattern)
+    {
+      put_attr_str (s, "pattern", gimp_object_get_name (p->pattern));
+    }
+  else if ((p->type == CHOPGIMP_PAINT_MESH     ||
+            p->type == CHOPGIMP_PAINT_FREEFORM ||
+            p->type == CHOPGIMP_PAINT_VPATTERN) && p->material)
+    {
+      /*  3.29.1: the main color first (an older ChopGimp reads it as a
+       *  plain color would be lost: it shows nothing), then the text
+       */
+      if (p->color)
+        {
+          g_string_append (s, " color=\"");
+          put_color (s, p->color);
+          g_string_append_c (s, '"');
+        }
+      put_attr_str (s, "material", p->material);
+    }
+
+  if (e->kind == CHOPGIMP_VENTRY_STROKE)
+    {
+      g_string_append (s, " width=\"");
+      chopgimp_put_num (s, e->width);
+      g_string_append_printf (s, "\" align=\"%s\" cap=\"%s\" join=\"%s\" miter=\"",
+                              e->align == CHOPGIMP_STROKE_ALIGN_INSIDE  ? "inside"  :
+                              e->align == CHOPGIMP_STROKE_ALIGN_OUTSIDE ? "outside" :
+                                                                          "center",
+                              enum_to_nick (GIMP_TYPE_CAP_STYLE,  e->cap),
+                              enum_to_nick (GIMP_TYPE_JOIN_STYLE, e->join));
+      chopgimp_put_num (s, e->miter_limit);
+      g_string_append_c (s, '"');
+
+      if (e->dashes && e->dashes->len > 0)
+        {
+          g_string_append (s, " dash=\"");
+          for (guint i = 0; i < e->dashes->len; i++)
+            {
+              if (i)
+                g_string_append_c (s, ' ');
+              chopgimp_put_num (s, g_array_index (e->dashes, gdouble, i));
+            }
+          g_string_append (s, "\" dash-offset=\"");
+          chopgimp_put_num (s, e->dash_offset);
+          g_string_append_c (s, '"');
+        }
+    }
+
+  /*  version 2  */
+  if (e->opacity < 1.0)
+    {
+      g_string_append (s, " opacity=\"");
+      chopgimp_put_num (s, e->opacity);
+      g_string_append_c (s, '"');
+    }
+
+  if (! is_normal_mode (e->mode))
+    g_string_append_printf (s, " mode=\"%s\"",
+                            enum_to_nick (GIMP_TYPE_LAYER_MODE, e->mode));
+
+  if (! e->visible)
+    g_string_append (s, " visible=\"0\"");
+
+  if (p->global_id)
+    put_attr_str (s, "global", p->global_id);
+
+  if (e->kind == CHOPGIMP_VENTRY_STROKE)
+    {
+      if (e->follow_fill)
+        g_string_append (s, " follow-fill=\"1\"");
+
+      if (! profile_is_uniform (e->profile))
+        put_attr_str (s, "profile", e->profile);
+
+      if (e->arrow_start)
+        put_attr_str (s, "arrow-start", e->arrow_start);
+
+      if (e->arrow_end)
+        put_attr_str (s, "arrow-end", e->arrow_end);
+
+      if (e->stroke_gradient > 0)
+        g_string_append_printf (s, " stroke-gradient=\"%d\"", e->stroke_gradient);
+
+      if ((e->arrow_start || e->arrow_end) && e->arrow_scale != 1.0)
+        {
+          g_string_append (s, " arrow-scale=\"");
+          chopgimp_put_num (s, e->arrow_scale);
+          g_string_append_c (s, '"');
+        }
+    }
+
+  if (! stops)
+    {
+      g_string_append (s, "/>\n");
+      return;
+    }
+
+  g_string_append (s, ">\n");
+
+  for (guint i = 0; i < p->stops->len; i++)
+    {
+      ChopGimpGradientStop *st = &g_array_index (p->stops, ChopGimpGradientStop, i);
+
+      g_string_append (s, "<stop offset=\"");
+      chopgimp_put_num (s, st->offset);
+      g_string_append (s, "\" color=\"");
+      put_color (s, st->color);
+      g_string_append (s, "\"/>\n");
+    }
+
+  g_string_append_printf (s, "</%s>\n", element);
+}
+
+static void
+write_object (GString         *s,
+              ChopGimpVObject *o,
+              gboolean         drop_empty)
+{
+  gchar *name;
+  gint   i;
+
+  if (drop_empty && o->kind == CHOPGIMP_VOBJECT_PATH &&
+      gimp_path_get_n_strokes (o->path) == 0)
+    return;
+
+  name = g_markup_escape_text (o->name ? o->name : "", -1);
+
+  g_string_append_printf (s, "<%s id=\"%u\" name=\"%s\"",
+                          o->kind == CHOPGIMP_VOBJECT_GROUP ? "group" : "path",
+                          o->id, name);
+  g_free (name);
+
+  if (! gimp_matrix3_is_identity (&o->transform))
+    {
+      gdouble m[6] = { o->transform.coeff[0][0], o->transform.coeff[1][0],
+                       o->transform.coeff[0][1], o->transform.coeff[1][1],
+                       o->transform.coeff[0][2], o->transform.coeff[1][2] };
+
+      g_string_append (s, " transform=\"");
+      for (i = 0; i < 6; i++)
+        {
+          if (i)
+            g_string_append_c (s, ' ');
+          chopgimp_put_num (s, m[i]);
+        }
+      g_string_append_c (s, '"');
+    }
+
+  g_string_append (s, " opacity=\"");
+  chopgimp_put_num (s, o->opacity);
+  g_string_append_printf (s, "\" mode=\"%s\" visible=\"%d\" locked=\"%d\"",
+                          enum_to_nick (GIMP_TYPE_LAYER_MODE, o->mode),
+                          o->visible ? 1 : 0, o->locked ? 1 : 0);
+
+  /*  3.27.7: live paint role, symbol occurrence  */
+  if (o->livepaint)
+    put_attr_str (s, "livepaint", o->livepaint);
+  if (o->symbol)
+    put_attr_str (s, "symbol", o->symbol);
+  /*  3.29.1: opacity mask, blend  */
+  if (o->opmask)
+    g_string_append_printf (s, " opmask=\"%d\"", o->opmask);
+  if (o->blend)
+    put_attr_str (s, "blend", o->blend);
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    {
+      gchar *d = path_to_d (o->path);
+
+      g_string_append_printf (s, " fill-rule=\"%s\" antialias=\"%d\" d=\"%s\"",
+                              o->style.fill_nonzero ? "nonzero" : "evenodd",
+                              o->style.antialias ? 1 : 0, d);
+      g_free (d);
+
+      /*  3.27.6: in files and for the plug-ins (not the undo states), the
+       *  path with its own live effects (distortions…): the SVG export
+       *  writes it flattened
+       */
+      if (drop_empty && o->lpe && o->path && gimp_path_get_n_strokes (o->path) > 0)
+        {
+          GimpPath *eff;
+
+          if (o->effective_valid && o->effective)
+            eff = g_object_ref (o->effective);
+          else if ((eff = chopgimp_geom_effects (o->path, o->lpe)))
+            g_object_ref_sink (eff);
+
+          if (eff)
+            {
+              gchar *de = path_to_d (eff);
+
+              g_string_append_printf (s, " d-effective=\"%s\"", de);
+              g_free (de);
+              g_object_unref (eff);
+            }
+        }
+
+      g_string_append (s, ">\n");
+
+      /*  the stack, bottom → top  */
+      for (gint k = 0; k < chopgimp_vstyle_get_n_entries (&o->style); k++)
+        write_entry (s, chopgimp_vstyle_get_entry (&o->style, k), &o->style);
+    }
+  else
+    {
+      g_string_append (s, o->clip ? " clip=\"1\">\n" : ">\n");
+    }
+
+  if (o->lpe)
+    {
+      gchar *lpe = g_markup_escape_text (o->lpe, -1);
+
+      g_string_append_printf (s, "<lpe>%s</lpe>\n", lpe);
+      g_free (lpe);
+    }
+
+  if (o->children)
+    for (guint k = 0; k < o->children->len; k++)
+      write_object (s, g_ptr_array_index (o->children, k), drop_empty);
+
+  g_string_append_printf (s, "</%s>\n",
+                          o->kind == CHOPGIMP_VOBJECT_GROUP ? "group" : "path");
+}
+
+/*  @state: also the selection, the entered group and the legacy flag
+ *  (undo); otherwise empty objects are dropped (file)
+ */
+static gchar *
+vlayer_serialize (GimpVectorLayer *layer,
+                  gboolean         state)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+  GString        *s  = g_string_new (NULL);
+
+  /*  version 2 (3.27.2): several <fill> / <stroke> per path, in the
+   *  order of the stack, with opacity, mode, visible, global, profile,
+   *  arrow-start / -end / -scale; version 1 files are read the same
+   */
+  g_string_append_printf (s, "<chopgimp-vobjects version=\"2\" next-id=\"%u\"",
+                          vl->next_id);
+
+  if (vl->opt_sig)
+    {
+      gchar *sig = g_markup_escape_text (vl->opt_sig, -1);
+
+      g_string_append_printf (s, " options-style=\"%s\"", sig);
+      g_free (sig);
+    }
+
+  if (state)
+    {
+      g_string_append_printf (s, " legacy=\"%d\" entered=\"%u\" selection=\"",
+                              vl->legacy ? 1 : 0, vl->entered);
+
+      for (guint i = 0; i < vl->selection->len; i++)
+        g_string_append_printf (s, i ? " %u" : "%u",
+                                g_array_index (vl->selection, guint, i));
+
+      g_string_append_c (s, '"');
+    }
+
+  g_string_append (s, ">\n");
+
+  write_object (s, vl->root, ! state);
+
+  g_string_append (s, "</chopgimp-vobjects>\n");
+
+  return g_string_free (s, FALSE);
+}
+
+/*  the legacy fill / stroke as text, to notice changes made to them  */
+static gchar *
+options_sig (GimpVectorLayerOptions *options)
+{
+  ChopGimpVStyle style;
+  GString       *s = g_string_new (NULL);
+
+  chopgimp_vstyle_init (&style);
+  chopgimp_vstyle_from_options (&style, options);
+
+  write_entry (s, chopgimp_vstyle_ensure_fill (&style), NULL);
+  write_entry (s, chopgimp_vstyle_ensure_stroke (&style), NULL);
+  g_string_append_printf (s, "aa=%d", style.antialias);
+
+  chopgimp_vstyle_clear (&style);
+
+  return g_string_free (s, FALSE);
+}
+
+typedef struct
+{
+  GimpImage        *image;
+  ChopGimpVLayer   *vl;
+  GPtrArray        *stack;
+  ChopGimpVObject  *object;     /* the current one */
+  ChopGimpPaint    *paint;
+  gboolean          in_lpe;
+  GString          *text;
+  gboolean          has_legacy;
+} ParseData;
+
+static void
+parse_paint (ParseData       *pd,
+             ChopGimpPaint   *p,
+             const gchar    **names,
+             const gchar    **values)
+{
+  const gchar *type = attr (names, values, "type");
+
+  paint_clear (p);
+
+  if (! g_strcmp0 (type, "color"))
+    {
+      p->type  = CHOPGIMP_PAINT_COLOR;
+      p->color = color_parse (attr (names, values, "color"));
+    }
+  else if (! g_strcmp0 (type, "linear") || ! g_strcmp0 (type, "radial"))
+    {
+      p->type = (! strcmp (type, "linear") ? CHOPGIMP_PAINT_LINEAR_GRADIENT
+                                           : CHOPGIMP_PAINT_RADIAL_GRADIENT);
+      p->x1   = attr_num (names, values, "x1", 0.0);
+      p->y1   = attr_num (names, values, "y1", 0.0);
+      p->x2   = attr_num (names, values, "x2", 1.0);
+      p->y2   = attr_num (names, values, "y2", 0.0);
+      p->r    = attr_num (names, values, "r",  0.5);
+    }
+  else if (! g_strcmp0 (type, "mesh") || ! g_strcmp0 (type, "freeform") ||
+           ! g_strcmp0 (type, "vpattern"))
+    {
+      const gchar *c = attr (names, values, "color");
+
+      p->type     = (! strcmp (type, "mesh")     ? CHOPGIMP_PAINT_MESH     :
+                     ! strcmp (type, "freeform") ? CHOPGIMP_PAINT_FREEFORM :
+                                                   CHOPGIMP_PAINT_VPATTERN);
+      p->material = g_strdup (attr (names, values, "material"));
+      p->color    = c ? color_parse (c) : NULL;
+    }
+  else if (! g_strcmp0 (type, "pattern"))
+    {
+      const gchar   *name      = attr (names, values, "pattern");
+      GimpContainer *container = gimp_data_factory_get_container (pd->image->gimp->pattern_factory);
+      GimpObject    *pattern   = name ? gimp_container_get_child_by_name (container, name) : NULL;
+
+      if (pattern)
+        {
+          p->type    = CHOPGIMP_PAINT_PATTERN;
+          p->pattern = g_object_ref (GIMP_PATTERN (pattern));
+        }
+      else
+        {
+          /*  a missing pattern: grey, like GIMP's fallback  */
+          GeglColor *grey = gegl_color_new ("gray");
+
+          chopgimp_vpaint_set_color (p, grey);
+          g_object_unref (grey);
+        }
+    }
+}
+
+static void
+parse_start (GMarkupParseContext  *context,
+             const gchar          *element,
+             const gchar         **names,
+             const gchar         **values,
+             gpointer              user_data,
+             GError              **error)
+{
+  ParseData *pd = user_data;
+
+  if (! strcmp (element, "chopgimp-vobjects"))
+    {
+      const gchar *v;
+
+      pd->vl->next_id = (guint) attr_num (names, values, "next-id", 1);
+
+      if ((v = attr (names, values, "options-style")))
+        pd->vl->opt_sig = g_strdup (v);
+
+      if ((v = attr (names, values, "legacy")))
+        {
+          pd->has_legacy = TRUE;
+          pd->vl->legacy = atoi (v) != 0;
+        }
+
+      pd->vl->entered = (guint) attr_num (names, values, "entered", 0);
+
+      if ((v = attr (names, values, "selection")))
+        {
+          gchar **ids = g_strsplit (v, " ", -1);
+
+          for (gint i = 0; ids[i]; i++)
+            if (*ids[i])
+              {
+                guint id = (guint) g_ascii_strtoull (ids[i], NULL, 10);
+
+                g_array_append_val (pd->vl->selection, id);
+              }
+
+          g_strfreev (ids);
+        }
+    }
+  else if (! strcmp (element, "group") || ! strcmp (element, "path"))
+    {
+      gboolean         group = ! strcmp (element, "group");
+      ChopGimpVObject *o;
+      ChopGimpVObject *parent = pd->stack->len ? g_ptr_array_index (pd->stack,
+                                                                    pd->stack->len - 1)
+                                               : NULL;
+      const gchar     *v;
+
+      if (! parent && group)
+        {
+          o = pd->vl->root;   /* the root group */
+        }
+      else
+        {
+          if (! parent)
+            parent = pd->vl->root;
+
+          if (parent->kind != CHOPGIMP_VOBJECT_GROUP)
+            {
+              g_set_error (error, G_MARKUP_ERROR, G_MARKUP_ERROR_INVALID_CONTENT,
+                           "object inside a path");
+              return;
+            }
+
+          o = group ? vobj_alloc (CHOPGIMP_VOBJECT_GROUP, attr (names, values, "name"))
+                    : chopgimp_vobject_new_path (pd->image, NULL,
+                                                 attr (names, values, "name"), NULL);
+          o->id     = (guint) attr_num (names, values, "id", 0);
+          o->parent = parent;
+          g_ptr_array_add (parent->children, o);
+        }
+
+      if ((v = attr (names, values, "transform")))
+        {
+          gdouble m[6] = { 1, 0, 0, 1, 0, 0 };
+          gchar  *end;
+
+          for (gint i = 0; i < 6 && *v; i++)
+            {
+              m[i] = g_ascii_strtod (v, &end);
+              if (end == v)
+                break;
+              v = end;
+            }
+
+          gimp_matrix3_identity (&o->transform);
+          o->transform.coeff[0][0] = m[0];
+          o->transform.coeff[1][0] = m[1];
+          o->transform.coeff[0][1] = m[2];
+          o->transform.coeff[1][1] = m[3];
+          o->transform.coeff[0][2] = m[4];
+          o->transform.coeff[1][2] = m[5];
+        }
+
+      o->opacity = CLAMP (attr_num (names, values, "opacity", 1.0), 0.0, 1.0);
+      o->mode    = enum_from_nick (GIMP_TYPE_LAYER_MODE,
+                                   attr (names, values, "mode"),
+                                   GIMP_LAYER_MODE_NORMAL);
+      o->visible = attr_num (names, values, "visible", 1) != 0;
+      o->locked  = attr_num (names, values, "locked", 0) != 0;
+
+      g_free (o->livepaint);
+      g_free (o->symbol);
+      o->livepaint = g_strdup (attr (names, values, "livepaint"));
+      o->symbol    = g_strdup (attr (names, values, "symbol"));
+      g_free (o->blend);
+      o->blend     = g_strdup (attr (names, values, "blend"));
+      o->opmask    = group ? (gint) attr_num (names, values, "opmask", 0) : 0;
+
+      if (group)
+        o->clip = attr_num (names, values, "clip", 0) != 0;
+
+      if (! group)
+        {
+          o->style.fill_nonzero = ! g_strcmp0 (attr (names, values, "fill-rule"),
+                                               "nonzero");
+          o->style.antialias    = attr_num (names, values, "antialias", 1) != 0;
+          /*  the stack is what the file says (version 1: one <fill>,
+           *  one <stroke>)
+           */
+          style_make_empty (&o->style);
+          path_from_d (o->path, attr (names, values, "d"));
+        }
+
+      g_ptr_array_add (pd->stack, o);
+      pd->object = o;
+    }
+  else if (pd->object && pd->object->kind == CHOPGIMP_VOBJECT_PATH &&
+           (! strcmp (element, "fill") || ! strcmp (element, "stroke")))
+    {
+      gboolean        stroke = ! strcmp (element, "stroke");
+      ChopGimpVEntry *e      = chopgimp_ventry_new (stroke ? CHOPGIMP_VENTRY_STROKE
+                                                           : CHOPGIMP_VENTRY_FILL);
+      const gchar    *v;
+
+      chopgimp_vstyle_insert_entry (&pd->object->style, e, -1);
+
+      pd->paint = &e->paint;
+      parse_paint (pd, pd->paint, names, values);
+
+      e->opacity = CLAMP (attr_num (names, values, "opacity", 1.0), 0.0, 1.0);
+      e->mode    = enum_from_nick (GIMP_TYPE_LAYER_MODE, attr (names, values, "mode"),
+                                   GIMP_LAYER_MODE_NORMAL);
+      e->visible = attr_num (names, values, "visible", 1) != 0;
+
+      if ((v = attr (names, values, "global")) && *v)
+        e->paint.global_id = g_strdup (v);
+
+      if (stroke)
+        {
+          const gchar *align = attr (names, values, "align");
+          const gchar *dash  = attr (names, values, "dash");
+
+          e->width       = attr_num (names, values, "width", 1.0);
+          e->align       = (! g_strcmp0 (align, "inside")  ? CHOPGIMP_STROKE_ALIGN_INSIDE  :
+                            ! g_strcmp0 (align, "outside") ? CHOPGIMP_STROKE_ALIGN_OUTSIDE :
+                                                             CHOPGIMP_STROKE_ALIGN_CENTER);
+          e->cap         = enum_from_nick (GIMP_TYPE_CAP_STYLE,
+                                           attr (names, values, "cap"), GIMP_CAP_BUTT);
+          e->join        = enum_from_nick (GIMP_TYPE_JOIN_STYLE,
+                                           attr (names, values, "join"), GIMP_JOIN_MITER);
+          e->miter_limit = attr_num (names, values, "miter", 10.0);
+          e->dash_offset = attr_num (names, values, "dash-offset", 0.0);
+          e->arrow_scale = attr_num (names, values, "arrow-scale", 1.0);
+          e->follow_fill = attr_num (names, values, "follow-fill", 0) != 0;
+          e->stroke_gradient = CLAMP ((gint) attr_num (names, values, "stroke-gradient", 0), 0, 2);
+
+          if ((v = attr (names, values, "profile")) && ! profile_is_uniform (v))
+            e->profile = g_strdup (v);
+          if ((v = attr (names, values, "arrow-start")) && *v)
+            e->arrow_start = g_strdup (v);
+          if ((v = attr (names, values, "arrow-end")) && *v)
+            e->arrow_end = g_strdup (v);
+
+          if (dash)
+            {
+              gchar *end;
+
+              e->dashes = g_array_new (FALSE, FALSE, sizeof (gdouble));
+
+              while (*dash)
+                {
+                  gdouble d = g_ascii_strtod (dash, &end);
+
+                  if (end == dash)
+                    break;
+
+                  g_array_append_val (e->dashes, d);
+                  dash = end;
+                }
+
+              if (e->dashes->len == 0)
+                {
+                  g_array_free (e->dashes, TRUE);
+                  e->dashes = NULL;
+                }
+            }
+        }
+    }
+  else if (pd->paint && ! strcmp (element, "stop"))
+    {
+      GeglColor *color = color_parse (attr (names, values, "color"));
+
+      chopgimp_vpaint_add_stop (pd->paint, attr_num (names, values, "offset", 0.0),
+                                color);
+      g_object_unref (color);
+    }
+  else if (pd->object && ! strcmp (element, "lpe"))
+    {
+      pd->in_lpe = TRUE;
+      g_string_truncate (pd->text, 0);
+    }
+}
+
+static void
+parse_end (GMarkupParseContext  *context,
+           const gchar          *element,
+           gpointer              user_data,
+           GError              **error)
+{
+  ParseData *pd = user_data;
+
+  if (! strcmp (element, "group") || ! strcmp (element, "path"))
+    {
+      if (pd->stack->len)
+        g_ptr_array_remove_index (pd->stack, pd->stack->len - 1);
+
+      pd->object = pd->stack->len ? g_ptr_array_index (pd->stack, pd->stack->len - 1)
+                                  : NULL;
+    }
+  else if (! strcmp (element, "fill") || ! strcmp (element, "stroke"))
+    {
+      pd->paint = NULL;
+    }
+  else if (! strcmp (element, "lpe") && pd->in_lpe)
+    {
+      pd->in_lpe = FALSE;
+
+      if (pd->object)
+        {
+          g_free (pd->object->lpe);
+          pd->object->lpe = pd->text->len ? g_strdup (pd->text->str) : NULL;
+        }
+    }
+}
+
+static void
+parse_text (GMarkupParseContext  *context,
+            const gchar          *text,
+            gsize                 len,
+            gpointer              user_data,
+            GError              **error)
+{
+  ParseData *pd = user_data;
+
+  if (pd->in_lpe)
+    g_string_append_len (pd->text, text, len);
+}
+
+/*  the paints of @o and its children following @id (NULL: any global)
+ *  take the colors of the registry; the changed leaves are invalidated
+ *  and added to @changed (when not NULL). Returns the number of changed
+ *  leaves.
+ */
+static gint
+vobj_resolve_globals (ChopGimpVObject *o,
+                      GimpImage       *image,
+                      const gchar     *id,
+                      GList          **changed)
+{
+  gint n = 0;
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    {
+      gboolean any = FALSE;
+
+      for (gint k = 0; k < chopgimp_vstyle_get_n_entries (&o->style); k++)
+        if (paint_resolve_global (&chopgimp_vstyle_get_entry (&o->style, k)->paint,
+                                  image, id))
+          any = TRUE;
+
+      if (any)
+        {
+          vobj_invalidate (o);
+          if (changed)
+            *changed = g_list_prepend (*changed, o);
+          n++;
+        }
+    }
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      n += vobj_resolve_globals (g_ptr_array_index (o->children, i), image, id, changed);
+
+  return n;
+}
+
+static gint
+vobj_count_global_users (ChopGimpVObject *o,
+                         const gchar     *id)
+{
+  gint n = 0;
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH && chopgimp_vstyle_uses_global (&o->style, id))
+    n++;
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      n += vobj_count_global_users (g_ptr_array_index (o->children, i), id);
+
+  return n;
+}
+
+/*  a new state from the text; NULL on error  */
+static ChopGimpVLayer *
+vlayer_parse (GimpImage   *image,
+              const gchar *xml,
+              gsize        len,
+              gboolean    *has_legacy)
+{
+  static const GMarkupParser parser = { parse_start, parse_end, parse_text, NULL, NULL };
+  GMarkupParseContext       *context;
+  ParseData                  pd     = { 0, };
+  GError                    *error  = NULL;
+  guint                      next_id;
+
+  pd.image = image;
+  pd.vl    = vlayer_new ();
+  pd.stack = g_ptr_array_new ();
+  pd.text  = g_string_new (NULL);
+
+  context = g_markup_parse_context_new (&parser, 0, &pd, NULL);
+
+  if (! g_markup_parse_context_parse (context, xml, len, &error) ||
+      ! g_markup_parse_context_end_parse (context, &error))
+    {
+      g_printerr ("ChopGimp: invalid vector objects: %s\n",
+                  error ? error->message : "?");
+      g_clear_error (&error);
+      chopgimp_vlayer_free (pd.vl);
+      pd.vl = NULL;
+    }
+
+  g_markup_parse_context_free (context);
+  g_ptr_array_free (pd.stack, TRUE);
+  g_string_free (pd.text, TRUE);
+
+  if (pd.vl)
+    {
+      GHashTable *seen = g_hash_table_new (NULL, NULL);
+      GList      *all  = NULL;
+      GList      *l;
+
+      /*  ids: unique, non-zero (except the root)  */
+      next_id = pd.vl->next_id;
+      pd.vl->root->id = 0;
+      g_hash_table_add (seen, GUINT_TO_POINTER (0));
+
+      {
+        GPtrArray *queue = g_ptr_array_new ();
+
+        g_ptr_array_add (queue, pd.vl->root);
+
+        for (guint i = 0; i < queue->len; i++)
+          {
+            ChopGimpVObject *o = g_ptr_array_index (queue, i);
+
+            if (o->children)
+              for (guint k = 0; k < o->children->len; k++)
+                g_ptr_array_add (queue, g_ptr_array_index (o->children, k));
+
+            if (o != pd.vl->root)
+              all = g_list_prepend (all, o);
+          }
+
+        g_ptr_array_free (queue, TRUE);
+      }
+
+      for (l = all; l; l = l->next)
+        {
+          ChopGimpVObject *o = l->data;
+
+          if (o->id >= next_id)
+            next_id = o->id + 1;
+        }
+
+      all = g_list_reverse (all);
+
+      for (l = all; l; l = l->next)
+        {
+          ChopGimpVObject *o = l->data;
+
+          if (o->id == 0 || g_hash_table_contains (seen, GUINT_TO_POINTER (o->id)))
+            o->id = next_id++;
+
+          g_hash_table_add (seen, GUINT_TO_POINTER (o->id));
+        }
+
+      g_list_free (all);
+      g_hash_table_unref (seen);
+
+      vlayer_reindex (pd.vl);
+      pd.vl->next_id = MAX (pd.vl->next_id, next_id);
+
+      /*  3.27.2: the global colors may have changed since this text was
+       *  written (undo, a copy from another image…)
+       */
+      vobj_resolve_globals (pd.vl->root, image, NULL, NULL);
+    }
+
+  if (has_legacy)
+    *has_legacy = pd.has_legacy;
+
+  return pd.vl;
+}
+
+
+/*  ─── live effects, bounds ──────────────────────────────────────────── */
+
+static gchar *
+layer_lpe_spec (GimpVectorLayer *layer)
+{
+  const GimpParasite *parasite;
+  const gchar        *data;
+  guint32             size = 0;
+
+  parasite = gimp_item_parasite_find (GIMP_ITEM (layer), "chopgimp-lpe");
+  if (! parasite)
+    return NULL;
+
+  data = gimp_parasite_get_data (parasite, &size);
+  if (! data || size == 0)
+    return NULL;
+
+  return g_strndup (data, size);
+}
+
+/*  the layer's own live effects changed: the objects without effects of
+ *  their own are drawn again
+ */
+static void
+vlayer_check_layer_lpe (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl   = layer->vobjects;
+  gchar          *spec = layer_lpe_spec (layer);
+
+  if (g_strcmp0 (spec, vl->layer_lpe))
+    {
+      GList *leaves = chopgimp_vobjects_leaves_of (vl->root);
+
+      for (GList *l = leaves; l; l = l->next)
+        {
+          ChopGimpVObject *o = l->data;
+
+          if (! o->lpe || strstr (o->lpe, "type=corners"))
+            vobj_invalidate (o);
+        }
+
+      g_list_free (leaves);
+
+      g_free (vl->layer_lpe);
+      vl->layer_lpe = spec;
+    }
+  else
+    {
+      g_free (spec);
+    }
+}
+
+static GimpPath *
+vobj_effective (GimpVectorLayer *layer,
+                ChopGimpVObject *o)
+{
+  if (! o->path)
+    return NULL;
+
+  if (! o->effective_valid)
+    {
+      const gchar *spec     = o->lpe;
+      gchar       *combined = NULL;
+
+      if (! spec && layer->vobjects)
+        spec = layer->vobjects->layer_lpe;
+
+      /*  3.29.1: an object whose own effects are only its dynamic corners
+       *  (group « -1 », chopgimp-vtransform.c) still follows the effects
+       *  of the layer, after its corners
+       */
+      if (o->lpe && layer->vobjects && layer->vobjects->layer_lpe &&
+          *layer->vobjects->layer_lpe &&
+          strstr (o->lpe, "[-1]") && strstr (o->lpe, "type=corners"))
+        {
+          gint n_groups = 0;
+
+          for (const gchar *c = o->lpe; *c; c++)
+            if (*c == '[' && (c == o->lpe || c[-1] == '\n'))
+              n_groups++;
+
+          if (n_groups == 1)
+            spec = combined = g_strconcat (o->lpe, "\n",
+                                           layer->vobjects->layer_lpe, NULL);
+        }
+
+      g_clear_object (&o->effective);
+
+      if (spec && *spec && gimp_path_get_n_strokes (o->path) > 0)
+        o->effective = chopgimp_geom_effects (o->path, spec);
+
+      g_free (combined);
+
+      o->effective_valid = TRUE;
+    }
+
+  return o->effective ? o->effective : o->path;
+}
+
+static void
+setup_stroke (cairo_t              *cr,
+              const ChopGimpVEntry *st,
+              gdouble               width)
+{
+  cairo_set_line_width (cr, width);
+
+  switch (st->cap)
+    {
+    case GIMP_CAP_ROUND:  cairo_set_line_cap (cr, CAIRO_LINE_CAP_ROUND);  break;
+    case GIMP_CAP_SQUARE: cairo_set_line_cap (cr, CAIRO_LINE_CAP_SQUARE); break;
+    default:              cairo_set_line_cap (cr, CAIRO_LINE_CAP_BUTT);   break;
+    }
+
+  switch (st->join)
+    {
+    case GIMP_JOIN_ROUND: cairo_set_line_join (cr, CAIRO_LINE_JOIN_ROUND); break;
+    case GIMP_JOIN_BEVEL: cairo_set_line_join (cr, CAIRO_LINE_JOIN_BEVEL); break;
+    default:              cairo_set_line_join (cr, CAIRO_LINE_JOIN_MITER); break;
+    }
+
+  cairo_set_miter_limit (cr, MAX (st->miter_limit, 1.0));
+
+  if (st->dashes && st->dashes->len > 0)
+    {
+      gdouble *d     = g_new (gdouble, st->dashes->len);
+      gdouble  total = 0.0;
+
+      for (guint i = 0; i < st->dashes->len; i++)
+        {
+          d[i]   = MAX (0.0, g_array_index (st->dashes, gdouble, i)) * st->width;
+          total += d[i];
+        }
+
+      if (total > 0.0)
+        cairo_set_dash (cr, d, st->dashes->len, st->dash_offset);
+      else
+        cairo_set_dash (cr, NULL, 0, 0);
+
+      g_free (d);
+    }
+  else
+    {
+      cairo_set_dash (cr, NULL, 0, 0);
+    }
+}
+
+static gboolean
+entry_has_arrows (const ChopGimpVEntry *e)
+{
+  return e->arrow_start || e->arrow_end;
+}
+
+/*  the length of an arrowhead (local units)  */
+static gdouble
+arrow_size (const ChopGimpVEntry *e)
+{
+  return 4.0 * MAX (e->width, 0.5) * CLAMP (e->arrow_scale, 0.1, 20.0);
+}
+
+/*  image-space bounds of a leaf (FALSE: empty)  */
+static gboolean
+leaf_bounds (GimpVectorLayer *layer,
+             ChopGimpVObject *o,
+             gboolean         with_stroke,
+             gdouble         *b)
+{
+  gint idx = with_stroke ? 1 : 0;
+
+  if (! o->bounds_valid[idx])
+    {
+      GimpPath       *path = vobj_effective (layer, o);
+      GimpMatrix3     wm;
+      cairo_matrix_t  cm;
+      cairo_t        *cr   = measure_cr ();
+      gdouble         x1, y1, x2, y2;
+
+      chopgimp_vobject_get_world_matrix (o, &wm);
+      matrix_to_cairo (&wm, &cm);
+      cairo_set_matrix (cr, &cm);
+
+      o->bounds[idx][0] = o->bounds[idx][1] =  G_MAXDOUBLE;
+      o->bounds[idx][2] = o->bounds[idx][3] = -G_MAXDOUBLE;
+
+      if (append_path (cr, path))
+        {
+          gdouble px[4], py[4];
+
+          cairo_path_extents (cr, &x1, &y1, &x2, &y2);
+
+          /*  every painted stroke of the stack (arrowheads: a margin)  */
+          for (gint k = 0; with_stroke && k < chopgimp_vstyle_get_n_entries (&o->style); k++)
+            {
+              ChopGimpVEntry *e = chopgimp_vstyle_get_entry (&o->style, k);
+              gdouble         sx1, sy1, sx2, sy2;
+              gdouble         w;
+              gboolean        closed;
+
+              if (e->kind != CHOPGIMP_VENTRY_STROKE || ! chopgimp_ventry_is_painted (e))
+                continue;
+
+              w      = e->width;
+              closed = path_all_closed (path);
+
+              if (profile_is_uniform (e->profile))
+                {
+                  if (e->align == CHOPGIMP_STROKE_ALIGN_OUTSIDE && closed)
+                    w *= 2.0;
+                  else if (e->align == CHOPGIMP_STROKE_ALIGN_INSIDE && closed)
+                    w = 0.0;
+                }
+              else
+                {
+                  /*  3.27.6: the widest point of the profile (the outil
+                   *  Largeur goes beyond the width of the stroke)
+                   */
+                  w *= profile_max_factor (e->profile);
+                }
+
+              if (w > 0.0)
+                {
+                  setup_stroke (cr, e, w);
+                  cairo_set_dash (cr, NULL, 0, 0);
+                  cairo_stroke_extents (cr, &sx1, &sy1, &sx2, &sy2);
+
+                  if (entry_has_arrows (e) && ! closed)
+                    {
+                      gdouble m = arrow_size (e);
+
+                      sx1 -= m; sy1 -= m; sx2 += m; sy2 += m;
+                    }
+
+                  x1 = MIN (x1, sx1);
+                  y1 = MIN (y1, sy1);
+                  x2 = MAX (x2, sx2);
+                  y2 = MAX (y2, sy2);
+                }
+            }
+
+          px[0] = x1; py[0] = y1;
+          px[1] = x2; py[1] = y1;
+          px[2] = x1; py[2] = y2;
+          px[3] = x2; py[3] = y2;
+
+          for (gint i = 0; i < 4; i++)
+            {
+              cairo_user_to_device (cr, &px[i], &py[i]);
+
+              o->bounds[idx][0] = MIN (o->bounds[idx][0], px[i]);
+              o->bounds[idx][1] = MIN (o->bounds[idx][1], py[i]);
+              o->bounds[idx][2] = MAX (o->bounds[idx][2], px[i]);
+              o->bounds[idx][3] = MAX (o->bounds[idx][3], py[i]);
+            }
+        }
+
+      cairo_destroy (cr);
+      o->bounds_valid[idx] = TRUE;
+    }
+
+  if (o->bounds[idx][0] > o->bounds[idx][2])
+    return FALSE;
+
+  memcpy (b, o->bounds[idx], 4 * sizeof (gdouble));
+
+  return TRUE;
+}
+
+static gboolean
+object_bounds (GimpVectorLayer *layer,
+               ChopGimpVObject *o,
+               gboolean         with_stroke,
+               gboolean         visible_only,
+               gdouble         *b)
+{
+  gboolean any = FALSE;
+
+  if (visible_only && ! o->visible)
+    return FALSE;
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    return leaf_bounds (layer, o, with_stroke, b);
+
+  b[0] = b[1] =  G_MAXDOUBLE;
+  b[2] = b[3] = -G_MAXDOUBLE;
+
+  for (guint i = 0; i < o->children->len; i++)
+    {
+      gdouble cb[4];
+
+      if (object_bounds (layer, g_ptr_array_index (o->children, i),
+                         with_stroke, visible_only, cb))
+        {
+          b[0] = MIN (b[0], cb[0]);
+          b[1] = MIN (b[1], cb[1]);
+          b[2] = MAX (b[2], cb[2]);
+          b[3] = MAX (b[3], cb[3]);
+          any  = TRUE;
+        }
+    }
+
+  return any;
+}
+
+gboolean
+chopgimp_vobject_get_bounds (GimpVectorLayer *layer,
+                             ChopGimpVObject *object,
+                             gboolean         with_stroke,
+                             gdouble         *x1,
+                             gdouble         *y1,
+                             gdouble         *x2,
+                             gdouble         *y2)
+{
+  gdouble b[4];
+
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), FALSE);
+  g_return_val_if_fail (object != NULL, FALSE);
+
+  if (layer->vobjects)
+    vlayer_check_layer_lpe (layer);
+
+  if (! object_bounds (layer, object, with_stroke, FALSE, b))
+    return FALSE;
+
+  if (x1) *x1 = b[0];
+  if (y1) *y1 = b[1];
+  if (x2) *x2 = b[2];
+  if (y2) *y2 = b[3];
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vlayer_get_bounds (GimpVectorLayer *layer,
+                            const guint     *ids,
+                            gint             n_ids,
+                            gboolean         with_stroke,
+                            gdouble         *x1,
+                            gdouble         *y1,
+                            gdouble         *x2,
+                            gdouble         *y2)
+{
+  gdouble  b[4] = { G_MAXDOUBLE, G_MAXDOUBLE, -G_MAXDOUBLE, -G_MAXDOUBLE };
+  gboolean any  = FALSE;
+
+  for (gint i = 0; i < n_ids; i++)
+    {
+      ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, ids[i]);
+      gdouble          ob[4];
+
+      if (o && chopgimp_vobject_get_bounds (layer, o, with_stroke,
+                                            &ob[0], &ob[1], &ob[2], &ob[3]))
+        {
+          b[0] = MIN (b[0], ob[0]);
+          b[1] = MIN (b[1], ob[1]);
+          b[2] = MAX (b[2], ob[2]);
+          b[3] = MAX (b[3], ob[3]);
+          any  = TRUE;
+        }
+    }
+
+  if (any)
+    {
+      if (x1) *x1 = b[0];
+      if (y1) *y1 = b[1];
+      if (x2) *x2 = b[2];
+      if (y2) *y2 = b[3];
+    }
+
+  return any;
+}
+
+/*  integer rendering bounds of a leaf, one pixel of margin  */
+static gboolean
+leaf_ibounds (GimpVectorLayer *layer,
+              ChopGimpVObject *o,
+              GeglRectangle   *r)
+{
+  gdouble b[4];
+
+  if (! leaf_bounds (layer, o, TRUE, b))
+    return FALSE;
+
+  r->x      = (gint) floor (b[0]) - 1;
+  r->y      = (gint) floor (b[1]) - 1;
+  r->width  = (gint) ceil (b[2]) + 1 - r->x;
+  r->height = (gint) ceil (b[3]) + 1 - r->y;
+
+  return r->width > 0 && r->height > 0;
+}
+
+
+/*  ─── rendering ─────────────────────────────────────────────────────── */
+
+static cairo_pattern_t *
+make_source (const ChopGimpPaint *p,
+             const Babl          *space,
+             GimpPath            *local,
+             const cairo_matrix_t *world)
+{
+  cairo_pattern_t *pat = NULL;
+
+  switch (p->type)
+    {
+    case CHOPGIMP_PAINT_COLOR:
+      {
+        gdouble rgba[4];
+
+        color_rgba (p->color, space, rgba);
+        pat = cairo_pattern_create_rgba (rgba[0], rgba[1], rgba[2], rgba[3]);
+      }
+      break;
+
+    case CHOPGIMP_PAINT_LINEAR_GRADIENT:
+    case CHOPGIMP_PAINT_RADIAL_GRADIENT:
+      {
+        cairo_t        *cr = measure_cr ();
+        gdouble         x1 = 0, y1 = 0, x2 = 1, y2 = 1;
+        cairo_matrix_t  m;
+
+        if (append_path (cr, local))
+          cairo_path_extents (cr, &x1, &y1, &x2, &y2);
+        cairo_destroy (cr);
+
+        if (x2 - x1 < 1e-6) x2 = x1 + 1;
+        if (y2 - y1 < 1e-6) y2 = y1 + 1;
+
+        if (p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT)
+          pat = cairo_pattern_create_linear (p->x1, p->y1, p->x2, p->y2);
+        else
+          pat = cairo_pattern_create_radial (p->x2, p->y2, 0.0,
+                                             p->x1, p->y1, MAX (p->r, 1e-6));
+
+        /*  user (local) → bounding box units  */
+        cairo_matrix_init_scale (&m, 1.0 / (x2 - x1), 1.0 / (y2 - y1));
+        cairo_matrix_translate (&m, -x1, -y1);
+        cairo_pattern_set_matrix (pat, &m);
+        cairo_pattern_set_extend (pat, CAIRO_EXTEND_PAD);
+
+        if (p->stops)
+          for (guint i = 0; i < p->stops->len; i++)
+            {
+              ChopGimpGradientStop *st = &g_array_index (p->stops, ChopGimpGradientStop, i);
+              gdouble               rgba[4];
+
+              color_rgba (st->color, space, rgba);
+              cairo_pattern_add_color_stop_rgba (pat, st->offset,
+                                                 rgba[0], rgba[1], rgba[2], rgba[3]);
+            }
+      }
+      break;
+
+    case CHOPGIMP_PAINT_MESH:
+    case CHOPGIMP_PAINT_FREEFORM:
+    case CHOPGIMP_PAINT_VPATTERN:
+      {
+        cairo_t *cr = measure_cr ();
+        gdouble  box[4] = { 0, 0, 1, 1 };
+
+        if (append_path (cr, local))
+          cairo_path_extents (cr, &box[0], &box[1], &box[2], &box[3]);
+        cairo_destroy (cr);
+
+        if (box[2] - box[0] < 1e-6) box[2] = box[0] + 1;
+        if (box[3] - box[1] < 1e-6) box[3] = box[1] + 1;
+
+        pat = chopgimp_vmaterial_make_source (p, space, local, box, world);
+      }
+      break;
+
+    case CHOPGIMP_PAINT_PATTERN:
+      if (p->pattern)
+        {
+          GimpTempBuf     *mask = gimp_pattern_get_mask (p->pattern);
+          GeglBuffer      *buf  = gimp_temp_buf_create_buffer (mask);
+          gint             w    = gimp_temp_buf_get_width  (mask);
+          gint             h    = gimp_temp_buf_get_height (mask);
+          cairo_surface_t *surf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32, w, h);
+
+          cairo_surface_flush (surf);
+          gegl_buffer_get (buf, GEGL_RECTANGLE (0, 0, w, h), 1.0,
+                           babl_format_with_space ("cairo-ARGB32", space),
+                           cairo_image_surface_get_data (surf),
+                           cairo_image_surface_get_stride (surf),
+                           GEGL_ABYSS_NONE);
+          cairo_surface_mark_dirty (surf);
+          g_object_unref (buf);
+
+          pat = cairo_pattern_create_for_surface (surf);
+          cairo_surface_destroy (surf);
+
+          cairo_pattern_set_extend (pat, CAIRO_EXTEND_REPEAT);
+          /*  tiled in image space, like GIMP's pattern fills  */
+          cairo_pattern_set_matrix (pat, world);
+        }
+      break;
+
+    default:
+      break;
+    }
+
+  return pat;
+}
+
+/*  the outline of a stroke with a width profile (local coordinates), or
+ *  NULL
+ */
+static GimpPath *
+profile_outline (GimpPath             *path,
+                 const ChopGimpVEntry *e)
+{
+  GString     *spec   = g_string_new ("[0]\ntype=powerstroke\nwidth=");
+  gchar      **points = g_strsplit (profile_points (e->profile), ",", -1);
+  GimpPath    *outline;
+  gboolean     first  = TRUE;
+
+  chopgimp_put_num (spec, e->width);
+  g_string_append (spec, "\nwidths=");
+
+  for (gchar **pt = points; *pt; pt++)
+    {
+      gchar  *colon = strchr (*pt, ':');
+      gdouble t, w;
+
+      if (! colon)
+        continue;
+
+      t = g_ascii_strtod (*pt, NULL);
+      w = g_ascii_strtod (colon + 1, NULL);
+
+      if (! first)
+        g_string_append_c (spec, ',');
+      first = FALSE;
+
+      chopgimp_put_num (spec, CLAMP (t, 0.0, 1.0));
+      g_string_append_c (spec, ':');
+      chopgimp_put_num (spec, MAX (0.0, w) * e->width);
+
+      /*  3.27.6: « t:left/right »  */
+      if (strchr (colon + 1, '/'))
+        {
+          g_string_append_c (spec, '/');
+          chopgimp_put_num (spec, MAX (0.0, g_ascii_strtod (strchr (colon + 1, '/') + 1, NULL)) *
+                         e->width);
+        }
+    }
+
+  g_string_append_c (spec, '\n');
+  g_strfreev (points);
+
+  outline = chopgimp_geom_effects (path, spec->str);
+  g_string_free (spec, TRUE);
+
+  return outline;
+}
+
+/*  one arrowhead, tip at (x, y), pointing along (dx, dy) (unit)  */
+static void
+draw_arrow (cairo_t              *cr,
+            const ChopGimpVEntry *e,
+            gdouble               x,
+            gdouble               y,
+            gdouble               dx,
+            gdouble               dy,
+            const gchar          *shape)
+{
+  gdouble L  = arrow_size (e);
+  gdouble W  = L * 0.5;
+  gdouble nx = -dy, ny = dx;
+  gdouble bx = x - dx * L, by = y - dy * L;
+
+  cairo_new_path (cr);
+
+  if (! strcmp (shape, "arrow"))
+    {
+      cairo_save (cr);
+      cairo_set_dash (cr, NULL, 0, 0);
+      cairo_set_line_join (cr, CAIRO_LINE_JOIN_MITER);
+      cairo_move_to (cr, bx + nx * W, by + ny * W);
+      cairo_line_to (cr, x, y);
+      cairo_line_to (cr, bx - nx * W, by - ny * W);
+      cairo_stroke (cr);
+      cairo_restore (cr);
+      return;
+    }
+  else if (! strcmp (shape, "circle"))
+    {
+      cairo_arc (cr, x - dx * W, y - dy * W, W, 0, 2 * G_PI);
+    }
+  else if (! strcmp (shape, "square"))
+    {
+      cairo_move_to (cr, x + nx * W, y + ny * W);
+      cairo_line_to (cr, x - nx * W, y - ny * W);
+      cairo_line_to (cr, x - nx * W - dx * L, y - ny * W - dy * L);
+      cairo_line_to (cr, x + nx * W - dx * L, y + ny * W - dy * L);
+      cairo_close_path (cr);
+    }
+  else if (! strcmp (shape, "bar"))
+    {
+      gdouble t = MAX (e->width, 0.5);
+
+      cairo_move_to (cr, x + nx * W, y + ny * W);
+      cairo_line_to (cr, x - nx * W, y - ny * W);
+      cairo_line_to (cr, x - nx * W - dx * t, y - ny * W - dy * t);
+      cairo_line_to (cr, x + nx * W - dx * t, y + ny * W - dy * t);
+      cairo_close_path (cr);
+    }
+  else   /* triangle */
+    {
+      cairo_move_to (cr, x, y);
+      cairo_line_to (cr, bx + nx * W, by + ny * W);
+      cairo_line_to (cr, bx - nx * W, by - ny * W);
+      cairo_close_path (cr);
+    }
+
+  cairo_set_fill_rule (cr, CAIRO_FILL_RULE_WINDING);
+  cairo_fill (cr);
+}
+
+/*  the direction at an end of a polyline, away from the path  */
+static gboolean
+end_direction (GArray  *pts,
+               gboolean at_end,
+               gdouble *x,
+               gdouble *y,
+               gdouble *dx,
+               gdouble *dy)
+{
+  gint        n = pts->len;
+  GimpCoords *p0;
+
+  if (n < 2)
+    return FALSE;
+
+  p0 = &g_array_index (pts, GimpCoords, at_end ? n - 1 : 0);
+
+  for (gint k = 1; k < n; k++)
+    {
+      GimpCoords *q = &g_array_index (pts, GimpCoords, at_end ? n - 1 - k : k);
+      gdouble     ex = p0->x - q->x;
+      gdouble     ey = p0->y - q->y;
+      gdouble     l  = sqrt (ex * ex + ey * ey);
+
+      if (l > 1e-3)
+        {
+          *x  = p0->x;
+          *y  = p0->y;
+          *dx = ex / l;
+          *dy = ey / l;
+          return TRUE;
+        }
+    }
+
+  return FALSE;
+}
+
+static void
+draw_arrows (cairo_t              *cr,
+             GimpPath             *path,
+             const ChopGimpVEntry *e)
+{
+  GimpStroke *stroke;
+
+  for (stroke = gimp_path_stroke_get_next (path, NULL); stroke;
+       stroke = gimp_path_stroke_get_next (path, stroke))
+    {
+      gboolean closed = FALSE;
+      GArray  *pts    = gimp_stroke_interpolate (stroke, 0.2, &closed);
+      gdouble  x, y, dx, dy;
+
+      if (pts && ! closed)
+        {
+          if (e->arrow_start && end_direction (pts, FALSE, &x, &y, &dx, &dy))
+            draw_arrow (cr, e, x, y, dx, dy, e->arrow_start);
+          if (e->arrow_end && end_direction (pts, TRUE, &x, &y, &dx, &dy))
+            draw_arrow (cr, e, x, y, dx, dy, e->arrow_end);
+        }
+
+      if (pts)
+        g_array_free (pts, TRUE);
+    }
+}
+
+/*  the precomputed outlines of the profiled strokes (entry → GimpPath),
+ *  only while cache_leaves_parallel() runs; read-only for the threads
+ */
+static GHashTable *par_outlines = NULL;
+
+/*  one fill or stroke of the stack, at full opacity  */
+
+static void
+draw_entry (cairo_t              *cr,
+            const ChopGimpVStyle *st,
+            const ChopGimpVEntry *e,
+            GimpPath             *path,
+            const Babl           *space,
+            const cairo_matrix_t *world)
+{
+  cairo_fill_rule_t  rule = st->fill_nonzero ? CAIRO_FILL_RULE_WINDING
+                                             : CAIRO_FILL_RULE_EVEN_ODD;
+  const ChopGimpVEntry *fill = e->follow_fill ? chopgimp_vstyle_get_fill (st) : NULL;
+  cairo_pattern_t   *pat  = make_source (fill ? &fill->paint : &e->paint,
+                                         space, path, world);
+  gboolean           grouped = FALSE;
+
+  if (! pat)
+    return;
+
+  /*  3.29.1 finition: a gradient along / across a stroke that has a
+   *  width profile, dashes or an inside / outside alignment: the gradient
+   *  is painted into a group (wide enough to cover the stroke), which
+   *  becomes the source of the usual stroke drawing below, so that the
+   *  stroke keeps its own shape
+   */
+  if (e->kind == CHOPGIMP_VENTRY_STROKE && e->stroke_gradient > 0 &&
+      (e->paint.type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+       e->paint.type == CHOPGIMP_PAINT_RADIAL_GRADIENT) &&
+      e->paint.stops && e->paint.stops->len > 0 &&
+      (! profile_is_uniform (e->profile) ||
+       (e->dashes && e->dashes->len > 0) ||
+       (e->align != CHOPGIMP_STROKE_ALIGN_CENTER && path_all_closed (path))))
+    {
+      cairo_path_t *flat;
+      gdouble       gw;
+
+      gw = (e->stroke_gradient == 1) ? e->width * 6.0 + 4.0 :
+           e->width * ((e->align != CHOPGIMP_STROKE_ALIGN_CENTER &&
+                        path_all_closed (path)) ? 2.0 : 1.0);
+
+      cairo_new_path (cr);
+      append_path (cr, path);
+      flat = cairo_copy_path_flat (cr);
+      cairo_new_path (cr);
+
+      cairo_push_group (cr);
+      cairo_save (cr);
+      setup_stroke (cr, e, gw);
+      cairo_set_dash (cr, NULL, 0, 0.0);
+      /*  3.29.5: across a profiled stroke, the local width  */
+      chopgimp_vmaterial_stroke_gradient_profile (cr, flat, &e->paint, e->stroke_gradient,
+                                                  gw,
+                                                  profile_is_uniform (e->profile)
+                                                    ? NULL : profile_points (e->profile),
+                                                  space);
+      cairo_restore (cr);
+      cairo_pattern_destroy (pat);
+      pat = cairo_pop_group (cr);
+
+      cairo_path_destroy (flat);
+      grouped = TRUE;
+    }
+
+  cairo_set_source (cr, pat);
+  cairo_new_path (cr);
+
+  if (e->kind == CHOPGIMP_VENTRY_FILL)
+    {
+      append_path (cr, path);
+      cairo_set_fill_rule (cr, rule);
+      cairo_fill (cr);
+    }
+  else if (! grouped && e->stroke_gradient > 0 &&
+           (e->paint.type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+            e->paint.type == CHOPGIMP_PAINT_RADIAL_GRADIENT) &&
+           e->paint.stops && e->paint.stops->len > 0)
+    {
+      /*  3.29.1: gradient along / across the stroke (centred, solid)  */
+      cairo_path_t *flat;
+
+      append_path (cr, path);
+      flat = cairo_copy_path_flat (cr);
+      cairo_new_path (cr);
+
+      cairo_save (cr);
+      setup_stroke (cr, e, e->width);
+      chopgimp_vmaterial_stroke_gradient (cr, flat, &e->paint, e->stroke_gradient,
+                                          e->width, space);
+      cairo_restore (cr);
+
+      cairo_path_destroy (flat);
+
+      if (entry_has_arrows (e))
+        {
+          cairo_set_source (cr, pat);
+          setup_stroke (cr, e, e->width);
+          draw_arrows (cr, path, e);
+        }
+    }
+  else if (! profile_is_uniform (e->profile))
+    {
+      /*  3.28.2: the alignment (inside / outside: the profile at twice the
+       *  width, clipped by the shape) and the dashes (a dashed stroke of
+       *  the centerline as a mask) apply to profiled strokes too
+       */
+      ChopGimpStrokeAlign  align  = path_all_closed (path) ? e->align
+                                                           : CHOPGIMP_STROKE_ALIGN_CENTER;
+      ChopGimpVEntry       e2     = *e;
+      gboolean             dashed = e->dashes && e->dashes->len > 0;
+      GimpPath            *outline;
+
+      if (align != CHOPGIMP_STROKE_ALIGN_CENTER)
+        e2.width = e->width * 2.0;
+
+      /*  3.29.6: made beforehand for the parallel rasterization  */
+      if (par_outlines && g_hash_table_contains (par_outlines, e))
+        {
+          outline = g_hash_table_lookup (par_outlines, e);
+          if (outline)
+            g_object_ref (outline);
+        }
+      else
+        outline = profile_outline (path, &e2);
+
+      cairo_save (cr);
+
+      if (align == CHOPGIMP_STROKE_ALIGN_INSIDE)
+        {
+          append_path (cr, path);
+          cairo_set_fill_rule (cr, rule);
+          cairo_clip (cr);
+        }
+      else if (align == CHOPGIMP_STROKE_ALIGN_OUTSIDE)
+        {
+          cairo_rectangle (cr, -1e7, -1e7, 2e7, 2e7);
+          append_path (cr, path);
+          cairo_set_fill_rule (cr, CAIRO_FILL_RULE_EVEN_ODD);
+          cairo_clip (cr);
+        }
+
+      if (outline)
+        {
+          if (dashed)
+            cairo_push_group (cr);
+
+          cairo_new_path (cr);
+          append_path (cr, outline);
+          cairo_set_fill_rule (cr, CAIRO_FILL_RULE_WINDING);
+          cairo_fill (cr);
+
+          if (dashed)
+            {
+              ChopGimpVEntry mask = *e;
+
+              mask.cap = GIMP_CAP_BUTT;
+              cairo_set_operator (cr, CAIRO_OPERATOR_DEST_IN);
+              cairo_set_source_rgba (cr, 0, 0, 0, 1);
+              setup_stroke (cr, &mask, e->width);
+              /*  as wide as the widest profile point, the dashes of @e  */
+              cairo_set_line_width (cr, MAX (e2.width, 1.0) * 24.0);
+              cairo_new_path (cr);
+              append_path (cr, path);
+              cairo_stroke (cr);
+              cairo_pop_group_to_source (cr);
+              cairo_set_operator (cr, CAIRO_OPERATOR_OVER);
+              cairo_paint (cr);
+              cairo_set_source (cr, pat);
+            }
+
+          g_object_unref (outline);
+        }
+
+      cairo_restore (cr);
+
+      if (entry_has_arrows (e))
+        {
+          setup_stroke (cr, e, e->width);
+          draw_arrows (cr, path, e);
+        }
+    }
+  else
+    {
+      ChopGimpStrokeAlign align = e->align;
+
+      if (! path_all_closed (path))
+        align = CHOPGIMP_STROKE_ALIGN_CENTER;
+
+      switch (align)
+        {
+        case CHOPGIMP_STROKE_ALIGN_INSIDE:
+          cairo_save (cr);
+          setup_stroke (cr, e, e->width * 2.0);
+          append_path (cr, path);
+          cairo_set_fill_rule (cr, rule);
+          cairo_clip_preserve (cr);
+          cairo_stroke (cr);
+          cairo_restore (cr);
+          break;
+
+        case CHOPGIMP_STROKE_ALIGN_OUTSIDE:
+          cairo_save (cr);
+          setup_stroke (cr, e, e->width * 2.0);
+          cairo_rectangle (cr, -1e7, -1e7, 2e7, 2e7);
+          append_path (cr, path);
+          cairo_set_fill_rule (cr, CAIRO_FILL_RULE_EVEN_ODD);
+          cairo_clip (cr);
+          append_path (cr, path);
+          cairo_stroke (cr);
+          cairo_restore (cr);
+          break;
+
+        default:
+          setup_stroke (cr, e, e->width);
+          append_path (cr, path);
+          cairo_stroke (cr);
+
+          if (entry_has_arrows (e))
+            draw_arrows (cr, path, e);
+          break;
+        }
+    }
+
+  cairo_pattern_destroy (pat);
+}
+
+/*  draws a leaf at full opacity (cr: image coordinates): its appearance
+ *  stack, bottom → top, each fill / stroke with its opacity and mode
+ */
+static void
+draw_leaf (cairo_t         *cr,
+           GimpVectorLayer *layer,
+           ChopGimpVObject *o,
+           const Babl      *space)
+{
+  const ChopGimpVStyle *st   = &o->style;
+  GimpPath             *path = vobj_effective (layer, o);
+  GimpMatrix3           wm;
+  cairo_matrix_t        world;
+
+  if (! path || gimp_path_get_n_strokes (path) == 0)
+    return;
+
+  chopgimp_vobject_get_world_matrix (o, &wm);
+  matrix_to_cairo (&wm, &world);
+
+  cairo_save (cr);
+  cairo_set_operator (cr, CAIRO_OPERATOR_OVER);
+  cairo_transform (cr, &world);
+  cairo_set_antialias (cr, st->antialias ? CAIRO_ANTIALIAS_DEFAULT
+                                         : CAIRO_ANTIALIAS_NONE);
+
+  for (gint k = 0; k < chopgimp_vstyle_get_n_entries (st); k++)
+    {
+      ChopGimpVEntry   *e  = chopgimp_vstyle_get_entry (st, k);
+      cairo_operator_t  op;
+
+      if (! chopgimp_ventry_is_painted (e))
+        continue;
+
+      op = mode_operator (e->mode);
+
+      if (e->opacity >= 1.0 && op == CAIRO_OPERATOR_OVER)
+        {
+          draw_entry (cr, st, e, path, space, &world);
+        }
+      else
+        {
+          cairo_push_group (cr);
+          draw_entry (cr, st, e, path, space, &world);
+          cairo_pop_group_to_source (cr);
+          cairo_save (cr);
+          cairo_identity_matrix (cr);
+          cairo_set_operator (cr, op);
+          cairo_paint_with_alpha (cr, e->opacity);
+          cairo_restore (cr);
+        }
+    }
+
+  cairo_restore (cr);
+}
+
+/*  4.0.0: a leaf painted in a single solid color (every painted entry a
+ *  flat color, the same one, in Normal mode: the case of every traced
+ *  shape) is cached as its coverage only, A8 instead of ARGB32 (a quarter
+ *  of the memory), and painted through it in its color.  The color's
+ *  alpha and the entries' opacities stay in the coverage.
+ *  CHOPGIMP_NO_A8_CACHE=1: ARGB32 caches as before.
+ */
+static gboolean
+leaf_mono (ChopGimpVObject *o,
+           const Babl      *space,
+           gdouble          rgb[3])
+{
+  static gint           enabled = -1;
+  const ChopGimpVStyle *st      = &o->style;
+  gboolean              any     = FALSE;
+
+  if (enabled < 0)
+    enabled = (g_getenv ("CHOPGIMP_NO_A8_CACHE") == NULL);
+
+  if (! enabled)
+    return FALSE;
+
+  for (gint k = 0; k < chopgimp_vstyle_get_n_entries (st); k++)
+    {
+      ChopGimpVEntry       *e = chopgimp_vstyle_get_entry (st, k);
+      const ChopGimpVEntry *fill;
+      const ChopGimpPaint  *p;
+      gdouble               rgba[4];
+
+      if (! chopgimp_ventry_is_painted (e))
+        continue;
+
+      fill = e->follow_fill ? chopgimp_vstyle_get_fill (st) : NULL;
+      p    = fill ? &fill->paint : &e->paint;
+
+      if (p->type != CHOPGIMP_PAINT_COLOR || ! p->color ||
+          mode_operator (e->mode) != CAIRO_OPERATOR_OVER)
+        return FALSE;
+
+      color_rgba (p->color, space, rgba);
+
+      if (! any)
+        {
+          rgb[0] = rgba[0]; rgb[1] = rgba[1]; rgb[2] = rgba[2];
+          any = TRUE;
+        }
+      else if (rgb[0] != rgba[0] || rgb[1] != rgba[1] || rgb[2] != rgba[2])
+        {
+          return FALSE;
+        }
+    }
+
+  return any;
+}
+
+static cairo_surface_t *
+leaf_cache (GimpVectorLayer     *layer,
+            ChopGimpVObject     *o,
+            const Babl          *space,
+            const GeglRectangle *ib)
+{
+  if (o->cache)
+    return o->cache;
+
+  if ((gint64) ib->width * ib->height > CACHE_MAX_PIXELS)
+    return NULL;
+
+  {
+    cairo_surface_t *surf;
+    cairo_t         *cr;
+
+    o->cache_a8 = leaf_mono (o, space, o->cache_rgb);
+    surf = cairo_image_surface_create (o->cache_a8 ? CAIRO_FORMAT_A8
+                                                   : CAIRO_FORMAT_ARGB32,
+                                       ib->width, ib->height);
+    cr   = cairo_create (surf);
+
+    cairo_translate (cr, -ib->x, -ib->y);
+    draw_leaf (cr, layer, o, space);
+    cairo_destroy (cr);
+    cairo_surface_flush (surf);
+
+    o->cache    = surf;
+    o->cache_x  = ib->x;
+    o->cache_y  = ib->y;
+    o->cache_fx = o->cache_fy = 0.0;
+  }
+
+  return o->cache;
+}
+
+
+/*  3.29.4: the leaves that composite() is about to draw for the first time
+ *  (no cache yet) are rasterized beforehand, in parallel, into their
+ *  caches.  Same surfaces, same drawing: the result is the same.  Only the
+ *  leaves whose drawing reads nothing shared but the object itself are
+ *  taken (flat colors and linear / radial gradients, fills and strokes of
+ *  uniform width without arrows nor gradient along the stroke); their
+ *  effective path and its Bézier description are made first, here, since
+ *  both are made on demand.
+ */
+
+/*  3.29.2: objects left out of composite() (the « rest » of a drag)  */
+static GHashTable *composite_skip = NULL;
+
+static gboolean
+paint_par_safe (const ChopGimpPaint *p)
+{
+  return (p->type == CHOPGIMP_PAINT_COLOR ||
+          p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+          p->type == CHOPGIMP_PAINT_RADIAL_GRADIENT);
+}
+
+/*  3.29.6: all the paints and strokes are drawn in parallel: meshes, free
+ *  gradients, bitmap and vector patterns (cells made beforehand), arrows,
+ *  gradients along / across strokes and width profiles (outlines made
+ *  beforehand, see par_prepare_leaf()).  CHOPGIMP_NO_PAR_RENDER_EXT=1:
+ *  the 3.29.4 set only.
+ */
+static gint env_no_par_render_ext = -1;
+
+static gboolean
+par_ext_enabled (void)
+{
+  return ! chopgimp_env_flag ("CHOPGIMP_NO_PAR_RENDER_EXT", &env_no_par_render_ext);
+}
+
+
+static void
+par_outline_free (gpointer outline)
+{
+  if (outline)
+    g_object_unref (outline);
+}
+
+static gboolean
+leaf_par_safe (const ChopGimpVObject *o,
+               gboolean               ext)
+{
+  const ChopGimpVStyle *st = &o->style;
+
+  if (ext)
+    return TRUE;
+
+  for (gint k = 0; k < chopgimp_vstyle_get_n_entries (st); k++)
+    {
+      const ChopGimpVEntry *e = chopgimp_vstyle_get_entry (st, k);
+      const ChopGimpVEntry *f;
+
+      if (! chopgimp_ventry_is_painted (e))
+        continue;
+
+      f = e->follow_fill ? chopgimp_vstyle_get_fill (st) : NULL;
+
+      if (! paint_par_safe (&e->paint) || (f && ! paint_par_safe (&f->paint)))
+        return FALSE;
+
+      if (e->kind == CHOPGIMP_VENTRY_STROKE &&
+          (e->stroke_gradient > 0 || ! profile_is_uniform (e->profile) ||
+           entry_has_arrows (e)))
+        return FALSE;
+    }
+
+  return TRUE;
+}
+
+typedef struct
+{
+  GimpVectorLayer *layer;
+  const Babl      *space;
+  GPtrArray       *leaves;
+  GArray          *rects;
+  cairo_surface_t **surfs;
+  gint             next;
+  gboolean         ext;
+} ParJob;
+
+/*  3.29.6: what the drawing of @o would make on demand from shared state
+ *  (GimpPath items of the image, cells of the vector patterns) is made
+ *  here, on the main thread; FALSE: @o is drawn one by one
+ */
+static gboolean
+par_prepare_leaf (ChopGimpVObject *o,
+                  GimpPath        *path)
+{
+  const ChopGimpVStyle *st = &o->style;
+
+  for (gint k = 0; k < chopgimp_vstyle_get_n_entries (st); k++)
+    {
+      ChopGimpVEntry       *e = chopgimp_vstyle_get_entry (st, k);
+      const ChopGimpVEntry *f;
+
+      if (! chopgimp_ventry_is_painted (e))
+        continue;
+
+      f = e->follow_fill ? chopgimp_vstyle_get_fill (st) : NULL;
+
+      if (! chopgimp_vmaterial_prepare_pattern (f ? &f->paint : &e->paint, path))
+        return FALSE;
+
+      /*  the same outline as draw_entry()'s profiled branch  */
+      if (e->kind == CHOPGIMP_VENTRY_STROKE && ! profile_is_uniform (e->profile) &&
+          ! g_hash_table_contains (par_outlines, e))
+        {
+          ChopGimpVEntry  e2 = *e;
+          GimpPath       *outline;
+
+          if (path_all_closed (path) && e->align != CHOPGIMP_STROKE_ALIGN_CENTER)
+            e2.width = e->width * 2.0;
+
+          outline = profile_outline (path, &e2);
+
+          if (outline)
+            gimp_path_get_bezier (outline);   /* made on demand */
+
+          /*  NULL kept too: nothing to draw, nothing to make  */
+          g_hash_table_insert (par_outlines, e, outline);
+        }
+    }
+
+  return TRUE;
+}
+
+static void
+par_collect (ParJob              *job,
+             ChopGimpVObject     *o,
+             const GeglRectangle *region)
+{
+  if (! o->visible || o->opacity <= 0.0)
+    return;
+
+  if (composite_skip && g_hash_table_contains (composite_skip, o))
+    return;
+
+  if (o->kind == CHOPGIMP_VOBJECT_GROUP)
+    {
+      for (guint i = 0; i < o->children->len; i++)
+        par_collect (job, g_ptr_array_index (o->children, i), region);
+    }
+  else
+    {
+      GeglRectangle ib;
+      GimpPath     *path;
+
+      if (o->cache || ! leaf_ibounds (job->layer, o, &ib) ||
+          ! gegl_rectangle_intersect (NULL, &ib, region) ||
+          (gint64) ib.width * ib.height > CACHE_MAX_PIXELS ||
+          ! leaf_par_safe (o, job->ext))
+        return;
+
+      path = vobj_effective (job->layer, o);
+      if (! path || gimp_path_get_n_strokes (path) == 0)
+        return;
+      gimp_path_get_bezier (path);   /* made on demand */
+
+      if (job->ext && ! par_prepare_leaf (o, path))
+        return;
+
+      o->cache_a8 = leaf_mono (o, job->space, o->cache_rgb);
+
+      g_ptr_array_add (job->leaves, o);
+      g_array_append_val (job->rects, ib);
+    }
+}
+
+static void
+par_draw (gint     i,
+          gint     n,
+          gpointer user_data)
+{
+  ParJob *job = user_data;
+  gint    k;
+
+  while ((k = g_atomic_int_add (&job->next, 1)) < (gint) job->leaves->len)
+    {
+      const GeglRectangle *ib   = &g_array_index (job->rects, GeglRectangle, k);
+      ChopGimpVObject     *o    = g_ptr_array_index (job->leaves, k);
+      cairo_surface_t     *surf = cairo_image_surface_create (o->cache_a8 ? CAIRO_FORMAT_A8
+                                                                          : CAIRO_FORMAT_ARGB32,
+                                                              ib->width, ib->height);
+      cairo_t             *cr   = cairo_create (surf);
+
+      cairo_translate (cr, -ib->x, -ib->y);
+      draw_leaf (cr, job->layer, g_ptr_array_index (job->leaves, k), job->space);
+      cairo_destroy (cr);
+      cairo_surface_flush (surf);
+
+      job->surfs[k] = surf;
+    }
+}
+
+static void
+cache_leaves_parallel (GimpVectorLayer     *layer,
+                       ChopGimpVObject     *root,
+                       const GeglRectangle *region,
+                       const Babl          *space)
+{
+  ParJob job = { layer, space, NULL, NULL, NULL, 0, FALSE };
+
+  if (! root || g_get_num_processors () < 2)
+    return;
+
+  job.ext    = par_ext_enabled ();
+  job.leaves = g_ptr_array_new ();
+  job.rects  = g_array_new (FALSE, FALSE, sizeof (GeglRectangle));
+
+  if (job.ext)
+    {
+      /*  a render inside a render (a pattern's cell) stays one by one  */
+      if (par_outlines)
+        job.ext = FALSE;
+      else
+        {
+          par_outlines = g_hash_table_new_full (NULL, NULL, NULL,
+                                                par_outline_free);
+          chopgimp_vmaterial_pin_patterns (TRUE);
+        }
+    }
+
+  par_collect (&job, root, region);
+
+  if (job.leaves->len >= 8)
+    {
+      job.surfs = g_new0 (cairo_surface_t *, job.leaves->len);
+
+      gegl_parallel_distribute (-1, par_draw, &job);
+
+      for (guint k = 0; k < job.leaves->len; k++)
+        {
+          ChopGimpVObject     *o  = g_ptr_array_index (job.leaves, k);
+          const GeglRectangle *ib = &g_array_index (job.rects, GeglRectangle, k);
+
+          o->cache    = job.surfs[k];
+          o->cache_x  = ib->x;
+          o->cache_y  = ib->y;
+          o->cache_fx = o->cache_fy = 0.0;
+        }
+
+      g_free (job.surfs);
+    }
+
+  if (job.ext)
+    {
+      chopgimp_vmaterial_pin_patterns (FALSE);
+      g_clear_pointer (&par_outlines, g_hash_table_unref);
+    }
+
+  g_ptr_array_free (job.leaves, TRUE);
+  g_array_free (job.rects, TRUE);
+}
+
+static void
+composite (cairo_t             *cr,
+           GimpVectorLayer     *layer,
+           ChopGimpVObject     *o,
+           const GeglRectangle *band,
+           const Babl          *space)
+{
+  cairo_operator_t op = mode_operator (o->mode);
+  gboolean         simple;
+
+  if (! o->visible || o->opacity <= 0.0)
+    return;
+
+  if (composite_skip && g_hash_table_contains (composite_skip, o))
+    return;
+
+  simple = (o->opacity >= 1.0 && op == CAIRO_OPERATOR_OVER);
+
+  if (o->kind == CHOPGIMP_VOBJECT_GROUP)
+    {
+      if (o->children->len == 0)
+        return;
+
+      if (! simple)
+        cairo_push_group (cr);
+
+      /*  3.29.1 « masque d'opacité »: the luminance of the top child
+       *  (drawn in a band-sized surface) masks the others
+       */
+      if ((o->opmask & CHOPGIMP_OPMASK_ON) && o->children->len > 1 &&
+          band && band->width > 0 && band->height > 0)
+        {
+          ChopGimpVObject *mobj = g_ptr_array_index (o->children,
+                                                     o->children->len - 1);
+          cairo_surface_t *msurf, *alpha;
+          cairo_t         *mcr;
+
+          msurf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+                                              band->width, band->height);
+          mcr   = cairo_create (msurf);
+          cairo_translate (mcr, -band->x, -band->y);
+          composite (mcr, layer, mobj, band, space);
+          cairo_destroy (mcr);
+
+          alpha = chopgimp_vmaterial_luminance_mask (msurf, o->opmask);
+          cairo_surface_destroy (msurf);
+
+          cairo_push_group (cr);
+          for (guint i = 0; i + 1 < o->children->len; i++)
+            composite (cr, layer, g_ptr_array_index (o->children, i), band, space);
+          cairo_pop_group_to_source (cr);
+
+          if (alpha)
+            {
+              cairo_mask_surface (cr, alpha, band->x, band->y);
+              cairo_surface_destroy (alpha);
+            }
+        }
+      /*  « masque d'écrêtage »: the top child clips the others  */
+      else if (o->clip && o->children->len > 1)
+        {
+          ChopGimpVObject *mask = g_ptr_array_index (o->children,
+                                                     o->children->len - 1);
+          GimpPath        *wp   = chopgimp_vobject_get_world_path (layer, mask, TRUE);
+
+          cairo_save (cr);
+          cairo_new_path (cr);
+
+          if (wp && append_path (cr, wp))
+            {
+              cairo_set_fill_rule (cr, CAIRO_FILL_RULE_EVEN_ODD);
+              cairo_clip (cr);
+
+              for (guint i = 0; i + 1 < o->children->len; i++)
+                composite (cr, layer, g_ptr_array_index (o->children, i), band, space);
+            }
+
+          cairo_restore (cr);
+          g_clear_object (&wp);
+        }
+      else
+        for (guint i = 0; i < o->children->len; i++)
+          composite (cr, layer, g_ptr_array_index (o->children, i), band, space);
+
+      if (! simple)
+        {
+          cairo_pop_group_to_source (cr);
+          cairo_set_operator (cr, op);
+          cairo_paint_with_alpha (cr, o->opacity);
+          cairo_set_operator (cr, CAIRO_OPERATOR_OVER);
+        }
+    }
+  else
+    {
+      GeglRectangle    ib, isect;
+      cairo_surface_t *surf;
+
+      if (! leaf_ibounds (layer, o, &ib) ||
+          ! gegl_rectangle_intersect (&isect, &ib, band))
+        return;
+
+      surf = leaf_cache (layer, o, space, &ib);
+
+      cairo_save (cr);
+      cairo_rectangle (cr, isect.x, isect.y, isect.width, isect.height);
+      cairo_clip (cr);
+
+      if (surf)
+        {
+          cairo_set_operator (cr, op);
+
+          if (o->cache_a8)
+            {
+              cairo_set_source_rgba (cr, o->cache_rgb[0], o->cache_rgb[1],
+                                     o->cache_rgb[2], o->opacity);
+              cairo_mask_surface (cr, surf,
+                                  o->cache_x + o->cache_fx,
+                                  o->cache_y + o->cache_fy);
+            }
+          else
+            {
+              cairo_set_source_surface (cr, surf,
+                                        o->cache_x + o->cache_fx,
+                                        o->cache_y + o->cache_fy);
+              cairo_paint_with_alpha (cr, o->opacity);
+            }
+        }
+      else if (! simple)
+        {
+          cairo_push_group (cr);
+          draw_leaf (cr, layer, o, space);
+          cairo_pop_group_to_source (cr);
+          cairo_set_operator (cr, op);
+          cairo_paint_with_alpha (cr, o->opacity);
+        }
+      else
+        {
+          draw_leaf (cr, layer, o, space);
+        }
+
+      cairo_restore (cr);
+    }
+}
+
+static gboolean
+union_ibounds (GimpVectorLayer *layer,
+               ChopGimpVObject *o,
+               GeglRectangle   *r)
+{
+  gboolean any = FALSE;
+
+  if (! o->visible || o->opacity <= 0.0)
+    return FALSE;
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    return leaf_ibounds (layer, o, r);
+
+  for (guint i = 0; i < o->children->len; i++)
+    {
+      GeglRectangle cr;
+
+      if (union_ibounds (layer, g_ptr_array_index (o->children, i), &cr))
+        {
+          if (any)
+            gegl_rectangle_bounding_box (r, r, &cr);
+          else
+            *r = cr;
+
+          any = TRUE;
+        }
+    }
+
+  return any;
+}
+
+/*  3.29.4: cairo-ARGB32 → layer.  babl has no conversion within the
+ *  error tolerance from cairo-ARGB32 to the layer format and falls back to
+ *  its slow reference conversion (~300 ms per drag frame on a large
+ *  vectorization).  The pixels are unpremultiplied here instead, in place
+ *  and in parallel, to R'G'B'A u8 of the layer's space (same TRC: no color
+ *  conversion), which is copied as is into an 8-bit perceptual layer and
+ *  converted by babl's fast paths otherwise (8-bit layers only: 16- and
+ *  32-bit layers keep babl's conversion).  Result: round (c × 255 / a),
+ *  what the reference conversion gives (± 1 at exact halves).
+ */
+
+static guint8 unpremul_lut[256][256];   /* [alpha][premultiplied value] */
+
+static void
+unpremul_lut_init (void)
+{
+  static gsize done = 0;
+
+  if (g_once_init_enter (&done))
+    {
+      for (gint a = 0; a < 256; a++)
+        for (gint c = 0; c < 256; c++)
+          {
+            gint v = a ? (c * 255 + a / 2) / a : 0;
+
+            unpremul_lut[a][c] = MIN (v, 255);
+          }
+
+      g_once_init_leave (&done, 1);
+    }
+}
+
+typedef struct
+{
+  guchar *data;
+  gint    stride;
+  gint    width;
+} UnpremulJob;
+
+static void
+unpremul_rows (gsize    offset,
+               gsize    size,
+               gpointer user_data)
+{
+  UnpremulJob *job = user_data;
+
+  for (gsize y = offset; y < offset + size; y++)
+    {
+      guint32 *px = (guint32 *) (job->data + y * job->stride);
+
+      for (gint x = 0; x < job->width; x++)
+        {
+          guint32 p = px[x];               /* native-endian ARGB */
+          guint   a = p >> 24;
+          guint   r = (p >> 16) & 0xff;
+          guint   g = (p >>  8) & 0xff;
+          guint   b =  p        & 0xff;
+          guint8 *o = (guint8 *) (px + x);
+
+          if (a != 255)
+            {
+              const guint8 *lut = unpremul_lut[a];
+
+              r = lut[r];
+              g = lut[g];
+              b = lut[b];
+            }
+
+          o[0] = r;
+          o[1] = g;
+          o[2] = b;
+          o[3] = a;
+        }
+    }
+}
+
+/*  3.29.6: 16- and 32-bit layers.  The premultiplied ARGB32 pixels are
+ *  unpremultiplied to R'G'B'A float (c / a exactly, in parallel), which
+ *  babl converts by its fast paths to any layer format; no quantization
+ *  to 8 bits of the unpremultiplied values (the semi-transparent edges keep
+ *  what the reference conversion gives).  CHOPGIMP_NO_FAST_FLOAT=1:
+ *  babl's reference conversion as before.
+ */
+typedef struct
+{
+  const guchar *data;
+  gint          stride;
+  gint          width;
+  gfloat       *out;
+} FloatJob;
+
+static void
+unpremul_float_rows (gsize    offset,
+                     gsize    size,
+                     gpointer user_data)
+{
+  FloatJob *job = user_data;
+
+  for (gsize y = offset; y < offset + size; y++)
+    {
+      const guint32 *px = (const guint32 *) (job->data + y * job->stride);
+      gfloat        *o  = job->out + y * (gsize) job->width * 4;
+
+      for (gint x = 0; x < job->width; x++, o += 4)
+        {
+          guint32 p = px[x];               /* native-endian ARGB */
+          guint   a = p >> 24;
+
+          if (a == 0)
+            {
+              o[0] = o[1] = o[2] = o[3] = 0.0f;
+            }
+          else
+            {
+              gfloat k = 1.0f / (gfloat) a;
+
+              o[0] = MIN (1.0f, ((p >> 16) & 0xff) * k);
+              o[1] = MIN (1.0f, ((p >>  8) & 0xff) * k);
+              o[2] = MIN (1.0f, ( p        & 0xff) * k);
+              o[3] = a / 255.0f;
+            }
+        }
+    }
+}
+
+static gboolean
+put_argb32_float (GeglBuffer          *buffer,
+                  const GeglRectangle *rect,
+                  const Babl          *space,
+                  const guchar        *data,
+                  gint                 stride)
+{
+  static gint env_no_fast_float = -1;
+  FloatJob    job = { data, stride, rect->width, NULL };
+
+  if (chopgimp_env_flag ("CHOPGIMP_NO_FAST_FLOAT", &env_no_fast_float))
+    return FALSE;
+
+  job.out = g_try_malloc ((gsize) rect->width * rect->height * 4 * sizeof (gfloat));
+  if (! job.out)
+    return FALSE;
+
+  gegl_parallel_distribute_range (rect->height,
+                                  MAX (1, 32768 / MAX (1, rect->width)),
+                                  unpremul_float_rows, &job);
+
+  gegl_buffer_set (buffer, rect, 0,
+                   babl_format_with_space ("R'G'B'A float", space),
+                   job.out, GEGL_AUTO_ROWSTRIDE);
+
+  g_free (job.out);
+
+  return TRUE;
+}
+
+/*  writes a cairo ARGB32 image (@data, @stride, @rect's size) into @rect
+ *  of @buffer; @data is modified (unpremultiplied in place)
+ */
+static void
+put_argb32 (GeglBuffer          *buffer,
+            const GeglRectangle *rect,
+            const Babl          *space,
+            guchar              *data,
+            gint                 stride)
+{
+  UnpremulJob job = { data, stride, rect->width };
+
+  if (rect->width <= 0 || rect->height <= 0)
+    return;
+
+  /*  only 8-bit layers: unpremultiplying to u8 would quantize a 16- or
+   *  32-bit layer's semi-transparent edges to 8 bits; those keep babl's
+   *  conversion from the premultiplied data
+   */
+  if (babl_format_get_type (gegl_buffer_get_format (buffer), 0) !=
+      babl_type ("u8"))
+    {
+      /*  3.29.6: 16 / 32 bits through float  */
+      if (put_argb32_float (buffer, rect, space, data, stride))
+        return;
+
+      gegl_buffer_set (buffer, rect, 0,
+                       babl_format_with_space ("cairo-ARGB32", space),
+                       data, stride);
+      return;
+    }
+
+  unpremul_lut_init ();
+
+  gegl_parallel_distribute_range (rect->height,
+                                  MAX (1, 65536 / MAX (1, rect->width)),
+                                  unpremul_rows, &job);
+
+  gegl_buffer_set (buffer, rect, 0,
+                   babl_format_with_space ("R'G'B'A u8", space),
+                   data, stride);
+}
+
+/*  draws the objects of @rect (image coordinates) into @buffer, whose
+ *  origin is (@u->x, @u->y)
+ */
+static void
+render_rect (GimpVectorLayer     *layer,
+             GeglBuffer          *buffer,
+             const GeglRectangle *u,
+             const GeglRectangle *rect,
+             const Babl          *space)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+  gint            band_h;
+
+  if (rect->width <= 0 || rect->height <= 0)
+    return;
+
+  band_h = MAX (1, MIN (rect->height, BAND_MAX_PIXELS / MAX (1, rect->width)));
+
+  cache_leaves_parallel (layer, vl->root, rect, space);
+
+  for (gint y = rect->y; y < rect->y + rect->height; y += band_h)
+    {
+      GeglRectangle    band = { rect->x, y, rect->width,
+                                MIN (band_h, rect->y + rect->height - y) };
+      cairo_surface_t *surf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+                                                          band.width, band.height);
+      cairo_t         *cr   = cairo_create (surf);
+
+      cairo_translate (cr, -band.x, -band.y);
+      composite (cr, layer, vl->root, &band, space);
+      cairo_destroy (cr);
+      cairo_surface_flush (surf);
+
+      put_argb32 (buffer,
+                  GEGL_RECTANGLE (band.x - u->x, band.y - u->y,
+                                  band.width, band.height),
+                  space,
+                  cairo_image_surface_get_data (surf),
+                  cairo_image_surface_get_stride (surf));
+
+      cairo_surface_destroy (surf);
+    }
+}
+
+/*  draws the objects into the layer; @dirty (image coordinates) NULL:
+ *  everything. The layer follows the bounds of its objects; 3.29.2: when
+ *  only @dirty changed and the bounds moved, the pixels that stay are
+ *  copied from the old buffer instead of being drawn again.
+ */
+static void
+vlayer_render_region (GimpVectorLayer     *layer,
+                      const GeglRectangle *dirty)
+{
+  GimpDrawable  *drawable = GIMP_DRAWABLE (layer);
+  GimpItem      *item     = GIMP_ITEM (layer);
+  ChopGimpVLayer *vl      = layer->vobjects;
+  const Babl    *space;
+  GeglBuffer    *buffer;
+  GeglRectangle  u, cur, region;
+  gboolean       full;
+  gboolean       grown = FALSE;
+
+  if (! gimp_item_is_attached (item) ||
+      gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)))
+    return;
+
+  vlayer_check_layer_lpe (layer);
+
+  space = babl_format_get_space (gimp_drawable_get_format (drawable));
+
+  gimp_item_get_offset (item, &cur.x, &cur.y);
+  cur.width  = gimp_item_get_width  (item);
+  cur.height = gimp_item_get_height (item);
+
+  if (! union_ibounds (layer, vl->root, &u))
+    {
+      if (cur.width > 0 && cur.height > 0)
+        u = cur;
+      else
+        u = *GEGL_RECTANGLE (0, 0, 1, 1);
+    }
+
+  full = (! dirty || ! gegl_rectangle_equal (&u, &cur));
+
+  if (full)
+    {
+      GeglBuffer    *old = NULL;
+      GeglRectangle  keep;
+
+      /*  3.29.2: only the dirty part changed: keep the other pixels  */
+      if (dirty && cur.width > 1 && cur.height > 1 &&
+          gegl_rectangle_intersect (&keep, &cur, &u))
+        {
+          old   = g_object_ref (gimp_drawable_get_buffer (drawable));
+          grown = TRUE;
+        }
+
+      g_object_freeze_notify (G_OBJECT (drawable));
+
+      buffer = gegl_buffer_new (GEGL_RECTANGLE (0, 0, u.width, u.height),
+                                gimp_drawable_get_format (drawable));
+
+      if (old)
+        {
+          gegl_buffer_copy (old,
+                            GEGL_RECTANGLE (keep.x - cur.x, keep.y - cur.y,
+                                            keep.width, keep.height),
+                            GEGL_ABYSS_NONE, buffer,
+                            GEGL_RECTANGLE (keep.x - u.x, keep.y - u.y,
+                                            keep.width, keep.height));
+          g_object_unref (old);
+        }
+
+      gimp_drawable_set_buffer (drawable, FALSE, NULL, buffer);
+      g_object_unref (buffer);
+
+      gimp_item_set_offset (item, u.x, u.y);
+      region = u;
+    }
+  else if (! gegl_rectangle_intersect (&region, dirty, &u))
+    {
+      return;
+    }
+
+  buffer = gimp_drawable_get_buffer (drawable);
+
+  if (grown)
+    {
+      GeglRectangle d;
+
+      /*  the dirty part, and the new strips outside the old bounds  */
+      if (gegl_rectangle_intersect (&d, dirty, &u))
+        render_rect (layer, buffer, &u, &d, space);
+
+      if (cur.y > u.y)
+        render_rect (layer, buffer, &u,
+                     GEGL_RECTANGLE (u.x, u.y, u.width, cur.y - u.y), space);
+      if (cur.y + cur.height < u.y + u.height)
+        render_rect (layer, buffer, &u,
+                     GEGL_RECTANGLE (u.x, cur.y + cur.height, u.width,
+                                     u.y + u.height - cur.y - cur.height), space);
+      {
+        gint y1 = MAX (u.y, cur.y);
+        gint y2 = MIN (u.y + u.height, cur.y + cur.height);
+
+        if (y2 > y1 && cur.x > u.x)
+          render_rect (layer, buffer, &u,
+                       GEGL_RECTANGLE (u.x, y1, cur.x - u.x, y2 - y1), space);
+        if (y2 > y1 && cur.x + cur.width < u.x + u.width)
+          render_rect (layer, buffer, &u,
+                       GEGL_RECTANGLE (cur.x + cur.width, y1,
+                                       u.x + u.width - cur.x - cur.width, y2 - y1),
+                       space);
+      }
+    }
+  else
+    {
+      render_rect (layer, buffer, &u, &region, space);
+    }
+
+  if (full)
+    {
+      g_object_thaw_notify (G_OBJECT (drawable));
+      gimp_drawable_update (drawable, 0, 0, -1, -1);
+    }
+  else
+    {
+      gimp_drawable_update (drawable, region.x - u.x, region.y - u.y,
+                            region.width, region.height);
+    }
+
+  gimp_viewable_invalidate_preview (GIMP_VIEWABLE (layer));
+}
+
+gboolean
+chopgimp_vlayer_render (GimpVectorLayer *layer,
+                        gboolean         invalidate_all)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+
+  if (! chopgimp_vobjects_enabled () || ! vl)
+    return FALSE;
+
+  /*  a refresh after the legacy fill / stroke were changed in place
+   *  (PDB gimp-vector-layer-set-fill-color…): object #1 takes them
+   */
+  if (invalidate_all && layer->options && ! vl->syncing)
+    vlayer_style_from_options (layer);
+
+  if (vl->legacy)
+    return FALSE;
+
+  if (invalidate_all)
+    vobj_invalidate (vl->root);
+
+  vlayer_render_region (layer, NULL);
+
+  return TRUE;
+}
+
+
+/*  ─── the legacy path and style ─────────────────────────────────────── */
+
+/*  objects → legacy path (all the sub-paths) and fill / stroke (object #1)  */
+static void
+vlayer_write_legacy (GimpVectorLayer *layer,
+                     gboolean         geometry,
+                     gboolean         style)
+{
+  GimpVectorLayerOptions *options = layer->options;
+  ChopGimpVLayer         *vl      = layer->vobjects;
+
+  if (! options || ! vl)
+    return;
+
+  vl->syncing++;
+
+  if (geometry && options->path)
+    {
+      GimpPath *u      = options->path;
+      GList    *leaves = chopgimp_vobjects_leaves_of (vl->root);
+      GArray   *layout = g_array_new (FALSE, FALSE, sizeof (guint));
+
+      gimp_path_freeze (u);
+      path_clear (u);
+      g_hash_table_remove_all (vl->stroke_map);
+
+      for (GList *l = leaves; l; l = l->next)
+        {
+          ChopGimpVObject *o = l->data;
+          GimpMatrix3      wm;
+          GimpStroke      *s;
+          gboolean         identity;
+
+          chopgimp_vobject_get_world_matrix (o, &wm);
+          identity = gimp_matrix3_is_identity (&wm);
+
+          for (s = gimp_path_stroke_get_next (o->path, NULL); s;
+               s = gimp_path_stroke_get_next (o->path, s))
+            {
+              GimpStroke *d = gimp_stroke_duplicate (s);
+
+              if (! identity)
+                gimp_stroke_transform (d, &wm, NULL);
+
+              gimp_path_stroke_add (u, d);
+              g_hash_table_insert (vl->stroke_map,
+                                   GINT_TO_POINTER (gimp_stroke_get_id (d)),
+                                   GUINT_TO_POINTER (o->id));
+              g_array_append_val (layout, o->id);
+              g_object_unref (d);
+            }
+        }
+
+      vl->mapped = layout->len;
+      vlayer_push_layout (vl, layout);
+      g_list_free (leaves);
+
+      gimp_path_thaw (u);
+    }
+
+  if (style)
+    {
+      ChopGimpVObject *first = first_leaf (vl->root);
+
+      if (first)
+        {
+          gchar *sig;
+
+          chopgimp_vstyle_to_options (&first->style, options);
+
+          sig = options_sig (options);
+          g_free (vl->opt_sig);
+          vl->opt_sig = sig;
+        }
+    }
+
+  vl->syncing--;
+}
+
+/*  legacy path → objects: each sub-path goes back to its object  */
+static void vlayer_flush_legacy (GimpVectorLayer *layer);
+
+static void
+vlayer_pull_legacy_path (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer   *vl = layer->vobjects;
+  GimpPath         *u  = layer->options ? layer->options->path : NULL;
+  GList            *leaves;
+  GPtrArray        *strokes;
+  ChopGimpVObject **owners;
+  GimpStroke       *s;
+  gboolean          by_id;
+  GArray           *layout;
+  guint             n;
+
+  if (! u)
+    return;
+
+  /*  3.29.6: a rewrite left for later (after an undo) is made first, so
+   *  that the map of the sub-paths is the objects' one
+   */
+  vlayer_flush_legacy (layer);
+
+  leaves  = chopgimp_vobjects_leaves_of (vl->root);
+  strokes = g_ptr_array_new ();
+
+  for (s = gimp_path_stroke_get_next (u, NULL); s;
+       s = gimp_path_stroke_get_next (u, s))
+    g_ptr_array_add (strokes, s);
+
+  n      = strokes->len;
+  owners = g_new0 (ChopGimpVObject *, MAX (n, 1));
+
+  /*  1. same sub-paths (moved, edited in place): by id  */
+  by_id = (n == (guint) vl->mapped && n > 0);
+
+  for (guint i = 0; by_id && i < n; i++)
+    {
+      gpointer id;
+
+      if (! g_hash_table_lookup_extended (vl->stroke_map,
+                                          GINT_TO_POINTER (gimp_stroke_get_id (strokes->pdata[i])),
+                                          NULL, &id) ||
+          ! (owners[i] = g_hash_table_lookup (vl->by_id, id)) ||
+          owners[i]->kind != CHOPGIMP_VOBJECT_PATH)
+        by_id = FALSE;
+    }
+
+  if (! by_id)
+    {
+      gboolean found      = FALSE;
+      gboolean only_added = FALSE;
+
+      memset (owners, 0, sizeof (ChopGimpVObject *) * MAX (n, 1));
+
+      /*  ChopGimp lot V2: sub-paths only added (Pen tool drawing a new
+       *  object): all the known ones are still there, the old layouts do
+       *  not apply
+       */
+
+      if (n > (guint) vl->mapped && vl->mapped > 0)
+        {
+          guint known = 0;
+
+          for (guint i = 0; i < n; i++)
+            if (g_hash_table_contains (vl->stroke_map,
+                                       GINT_TO_POINTER (gimp_stroke_get_id (strokes->pdata[i]))))
+              known++;
+
+          only_added = (known == (guint) vl->mapped);
+        }
+
+      /*  2. a known layout of the same length (undo, transformation)  */
+      for (gint k = (gint) vl->layouts->len - 1;
+           k >= 0 && ! found && n > 0 && ! only_added; k--)
+        {
+          GArray *lay = g_ptr_array_index (vl->layouts, k);
+
+          if (lay->len != n)
+            continue;
+
+          found = TRUE;
+
+          for (guint i = 0; i < n && found; i++)
+            {
+              ChopGimpVObject *o = g_hash_table_lookup (vl->by_id,
+                                                        GUINT_TO_POINTER (g_array_index (lay, guint, i)));
+
+              if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+                found = FALSE;
+              else
+                owners[i] = o;
+            }
+        }
+
+      /*  3. by id where known, else the object of the previous sub-path  */
+      if (! found)
+        {
+          ChopGimpVObject *prev = leaves ? leaves->data : NULL;
+
+          for (guint i = 0; i < n; i++)
+            {
+              gpointer         id;
+              ChopGimpVObject *o = NULL;
+
+              if (g_hash_table_lookup_extended (vl->stroke_map,
+                                                GINT_TO_POINTER (gimp_stroke_get_id (strokes->pdata[i])),
+                                                NULL, &id))
+                o = g_hash_table_lookup (vl->by_id, id);
+
+              if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+                {
+                  /*  a new sub-path: into the empty object that follows the
+                   *  previous one (lot V2: « Ajouter au calque vectoriel
+                   *  actif » of the Pen tool), else into the previous one
+                   */
+                  GList *after = prev ? g_list_find (leaves, prev) : NULL;
+
+                  o = prev;
+
+                  for (GList *l = after ? after->next : leaves; l; l = l->next)
+                    {
+                      ChopGimpVObject *e     = l->data;
+                      gboolean         taken = FALSE;
+
+                      if (gimp_path_get_n_strokes (e->path) > 0)
+                        continue;
+
+                      for (guint k = 0; k < i && ! taken; k++)
+                        if (owners[k] == e)
+                          taken = TRUE;
+
+                      if (! taken)
+                        {
+                          o = e;
+                          break;
+                        }
+                    }
+                }
+
+              if (! o)
+                {
+                  /*  no object left: a new one, with the legacy style  */
+                  GimpImage *image = gimp_item_get_image (GIMP_ITEM (layer));
+
+                  o = chopgimp_vobject_new_path (image, NULL,
+                                                 gimp_object_get_name (layer), NULL);
+                  chopgimp_vstyle_from_options (&o->style, layer->options);
+                  o->parent = vl->root;
+                  g_ptr_array_add (vl->root->children, o);
+                  assign_ids (vl, o);
+                  leaves = g_list_append (leaves, o);
+                }
+
+              owners[i] = o;
+              prev      = o;
+            }
+        }
+    }
+
+  /*  rebuild the objects whose sub-paths changed  */
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      GimpMatrix3      wm, inv;
+      gboolean         identity;
+      gboolean         same = TRUE;
+      GimpStroke      *t    = gimp_path_stroke_get_next (o->path, NULL);
+
+      chopgimp_vobject_get_world_matrix (o, &wm);
+      identity = gimp_matrix3_is_identity (&wm);
+
+      for (guint i = 0; i < n && same; i++)
+        if (owners[i] == o)
+          {
+            if (! t || ! stroke_equal (strokes->pdata[i], t, identity ? NULL : &wm))
+              same = FALSE;
+            else
+              t = gimp_path_stroke_get_next (o->path, t);
+          }
+
+      if (same && ! t)
+        continue;
+
+      inv = wm;
+      gimp_matrix3_invert (&inv);
+
+      gimp_path_freeze (o->path);
+      path_clear (o->path);
+
+      for (guint i = 0; i < n; i++)
+        if (owners[i] == o)
+          {
+            GimpStroke *d = gimp_stroke_duplicate (strokes->pdata[i]);
+
+            if (! identity)
+              gimp_stroke_transform (d, &inv, NULL);
+
+            gimp_path_stroke_add (o->path, d);
+            g_object_unref (d);
+          }
+
+      gimp_path_thaw (o->path);
+      vobj_invalidate (o);
+    }
+
+  /*  the new map  */
+  g_hash_table_remove_all (vl->stroke_map);
+  layout = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  for (guint i = 0; i < n; i++)
+    {
+      g_hash_table_insert (vl->stroke_map,
+                           GINT_TO_POINTER (gimp_stroke_get_id (strokes->pdata[i])),
+                           GUINT_TO_POINTER (owners[i]->id));
+      g_array_append_val (layout, owners[i]->id);
+    }
+
+  vl->mapped = n;
+  vlayer_push_layout (vl, layout);
+
+  g_free (owners);
+  g_ptr_array_free (strokes, TRUE);
+  g_list_free (leaves);
+}
+
+static void
+vlayer_style_from_options (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer  *vl    = layer->vobjects;
+  gchar           *sig   = options_sig (layer->options);
+  ChopGimpVObject *first = first_leaf (vl->root);
+
+  if (g_strcmp0 (sig, vl->opt_sig) && first)
+    {
+      chopgimp_vstyle_merge_options (&first->style, layer->options);
+      vobj_invalidate (first);
+    }
+
+  g_free (vl->opt_sig);
+  vl->opt_sig = sig;
+}
+
+gboolean
+chopgimp_vlayer_options_notify (GimpVectorLayer *layer,
+                                const gchar     *property)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+
+  if (! vl || ! layer->options)
+    return FALSE;
+
+  if (vl->syncing)
+    return TRUE;
+
+  if (! strcmp (property, "path") || ! strcmp (property, "path-tattoo"))
+    {
+      vlayer_pull_legacy_path (layer);
+    }
+  else if (! strcmp (property, "enable-fill")    ||
+           ! strcmp (property, "enable-stroke")  ||
+           ! strcmp (property, "fill-options")   ||
+           ! strcmp (property, "stroke-options") ||
+           ! strcmp (property, "fill-style")     ||
+           ! strcmp (property, "fill-color")     ||
+           ! strcmp (property, "fill-pattern"))
+    {
+      vlayer_style_from_options (layer);
+    }
+  else
+    {
+      return FALSE;
+    }
+
+  g_signal_emit_by_name (layer, "objects-changed", NULL);
+
+  return FALSE;
+}
+
+
+/*  ─── changes ───────────────────────────────────────────────────────── */
+
+static void
+vlayer_prune_selection (ChopGimpVLayer *vl,
+                        gboolean       *changed)
+{
+  for (guint i = 0; i < vl->selection->len; )
+    {
+      guint id = g_array_index (vl->selection, guint, i);
+
+      if (! g_hash_table_contains (vl->by_id, GUINT_TO_POINTER (id)) || id == 0)
+        {
+          g_array_remove_index (vl->selection, i);
+          *changed = TRUE;
+        }
+      else
+        {
+          i++;
+        }
+    }
+
+  if (vl->entered)
+    {
+      ChopGimpVObject *o = g_hash_table_lookup (vl->by_id, GUINT_TO_POINTER (vl->entered));
+
+      if (! o || o->kind != CHOPGIMP_VOBJECT_GROUP)
+        {
+          vl->entered = 0;
+          *changed    = TRUE;
+        }
+    }
+}
+
+/*  after a change of the objects: legacy view, rendering, signals  */
+static void
+vlayer_commit (GimpVectorLayer     *layer,
+               guint                what,
+               const GeglRectangle *dirty)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+  gboolean        sel_changed = FALSE;
+  gboolean        fast;
+
+  if (! vl)
+    return;
+
+  if (vl->freeze > 0)
+    {
+      if (! dirty || vl->pending_all)
+        vl->pending_all = TRUE;
+      else if (vl->pending)
+        gegl_rectangle_bounding_box (&vl->pending_rect, &vl->pending_rect, dirty);
+      else
+        vl->pending_rect = *dirty;
+
+      vl->pending |= what;
+      return;
+    }
+
+  /*  3.27.7: live paint regions follow their paths; an occurrence whose
+   *  objects were changed changes its symbol (and the other occurrences)
+   */
+  /*  3.29.2: during an interactive gesture, a change of geometry only
+   *  (the structure is the same): no reindex, no legacy path, the
+   *  signal once at the end (chopgimp_vlayer_end_interactive())
+   */
+  fast = (vl->interactive > 0 && ! (what & CHANGE_STRUCTURE));
+
+  if (! vl->hooking)
+    {
+      gboolean regen;
+
+      vl->hooking++;
+      if (! fast)
+        {
+          vlayer_reindex (vl);
+          vlayer_assign_missing_ids (vl, vl->root);
+        }
+      regen = chopgimp_vlivepaint_refresh (layer);
+      regen |= chopgimp_vsymbols_layer_changed (layer);
+      regen |= chopgimp_vblend_refresh (layer);
+      /*  3.30.0: brushes (their key may be the source of a repeat:
+       *  made first), then repeats
+       */
+      regen |= chopgimp_vbrush_refresh (layer);
+      regen |= chopgimp_vrepeat_refresh (layer);
+      vl->hooking--;
+
+      if (regen)
+        {
+          vlayer_reindex (vl);
+          vlayer_assign_missing_ids (vl, vl->root);
+          what |= CHANGE_STRUCTURE | CHANGE_GEOMETRY;
+          dirty = NULL;
+          fast  = FALSE;
+        }
+    }
+
+  if (what & CHANGE_STRUCTURE)
+    {
+      vlayer_reindex (vl);
+      vlayer_prune_selection (vl, &sel_changed);
+    }
+
+  if (fast)
+    vl->legacy_dirty = TRUE;
+  else
+    vlayer_write_legacy (layer,
+                         (what & (CHANGE_GEOMETRY | CHANGE_STRUCTURE)) != 0 ||
+                         vl->legacy_dirty,
+                         TRUE);
+
+  if (! fast)
+    vl->legacy_dirty = FALSE;
+
+  if (layer_usable (layer) && ! (fast && vl->rest))
+    {
+      if (vl->legacy)
+        gimp_vector_layer_refresh (layer);
+      else
+        vlayer_render_region (layer, dirty);
+    }
+
+  if (fast)
+    {
+      if (! dirty || vl->sig_all)
+        vl->sig_all = TRUE;
+      else if (vl->sig_pending)
+        gegl_rectangle_bounding_box (&vl->sig_rect, &vl->sig_rect, dirty);
+      else
+        vl->sig_rect = *dirty;
+
+      vl->sig_pending = TRUE;
+    }
+  else
+    {
+      g_signal_emit_by_name (layer, "objects-changed", dirty);
+    }
+
+  if (sel_changed)
+    g_signal_emit_by_name (layer, "object-selection-changed");
+}
+
+/*  starts a change: TRUE when @layer can be changed  */
+static gboolean
+vlayer_begin (GimpVectorLayer *layer,
+              const gchar     *undo_desc,
+              gboolean         push_undo)
+{
+  ChopGimpVLayer *vl;
+
+  if (! layer_usable (layer) || ! (vl = vlayer_ensure (layer)))
+    return FALSE;
+
+  if (push_undo)
+    chopgimp_vlayer_push_undo (layer, undo_desc);
+
+  vl->legacy = FALSE;
+
+  return TRUE;
+}
+
+static void
+dirty_of (GimpVectorLayer *layer,
+          ChopGimpVObject *o,
+          GeglRectangle   *r,
+          gboolean        *any)
+{
+  GList *leaves = (o->kind == CHOPGIMP_VOBJECT_PATH) ? g_list_prepend (NULL, o)
+                                                      : chopgimp_vobjects_leaves_of (o);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      GeglRectangle ib;
+
+      if (leaf_ibounds (layer, l->data, &ib))
+        {
+          if (*any)
+            gegl_rectangle_bounding_box (r, r, &ib);
+          else
+            *r = ib;
+
+          *any = TRUE;
+        }
+    }
+
+  g_list_free (leaves);
+}
+
+void
+chopgimp_vlayer_freeze (GimpVectorLayer *layer)
+{
+  if (layer_usable (layer) && vlayer_ensure (layer))
+    layer->vobjects->freeze++;
+}
+
+void
+chopgimp_vlayer_thaw (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+
+  if (! vl || vl->freeze == 0)
+    return;
+
+  if (--vl->freeze == 0 && vl->pending)
+    {
+      guint         what = vl->pending;
+      GeglRectangle r    = vl->pending_rect;
+      gboolean      all  = vl->pending_all;
+
+      vl->pending     = 0;
+      vl->pending_all = FALSE;
+
+      vlayer_commit (layer, what, all ? NULL : &r);
+    }
+}
+
+void
+chopgimp_vlayer_begin_interactive (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl;
+
+  if (! layer_usable (layer) || ! (vl = vlayer_ensure (layer)))
+    return;
+
+  if (! vl->moved)
+    vl->moved = g_hash_table_new (NULL, NULL);
+
+  vl->interactive++;
+}
+
+void
+chopgimp_vlayer_end_interactive (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl = layer ? layer->vobjects : NULL;
+  GHashTableIter  iter;
+  gpointer        key;
+  GeglRectangle   r;
+  gboolean        any = FALSE;
+
+  /*  an undo during the gesture replaced the state: nothing to end  */
+  if (! vl || vl->interactive == 0)
+    return;
+
+  if (--vl->interactive > 0)
+    return;
+
+  /*  the sprite showed the moved objects on top: their old place and
+   *  the layer bounds are drawn exactly below
+   */
+  if (vl->rest)
+    {
+      r   = vl->sprite_r;
+      any = TRUE;
+      sprite_free (vl);
+    }
+  vl->sprite_off = FALSE;
+
+  /*  the exact rendering of what was moved with its cached rendering  */
+  g_hash_table_iter_init (&iter, vl->moved);
+  while (g_hash_table_iter_next (&iter, &key, NULL))
+    {
+      ChopGimpVObject *o = g_hash_table_lookup (vl->by_id, key);
+
+      if (o)
+        {
+          dirty_of (layer, o, &r, &any);
+          vobj_settle (o);
+          dirty_of (layer, o, &r, &any);
+        }
+    }
+  g_hash_table_remove_all (vl->moved);
+
+  if (vl->legacy_dirty)
+    {
+      vlayer_write_legacy (layer, TRUE, TRUE);
+      vl->legacy_dirty = FALSE;
+    }
+
+  if (any && layer_usable (layer) && ! vl->legacy)
+    vlayer_render_region (layer, &r);
+
+  if (vl->sig_pending || any)
+    {
+      gboolean all = vl->sig_all;
+
+      if (any && vl->sig_pending && ! all)
+        gegl_rectangle_bounding_box (&r, &r, &vl->sig_rect);
+      else if (! any)
+        r = vl->sig_rect;
+
+      vl->sig_pending = FALSE;
+      vl->sig_all     = FALSE;
+
+      g_signal_emit_by_name (layer, "objects-changed", all ? NULL : &r);
+    }
+}
+
+void
+chopgimp_vlayer_object_changed (GimpVectorLayer *layer,
+                                ChopGimpVObject *object)
+{
+  ChopGimpVLayer *vl;
+
+  if (! layer_usable (layer) || ! (vl = vlayer_ensure (layer)))
+    return;
+
+  vl->legacy = FALSE;
+  vobj_invalidate (object ? object : vl->root);
+
+  vlayer_commit (layer, CHANGE_ALL, NULL);
+}
+
+
+/*  ─── undo ──────────────────────────────────────────────────────────── */
+
+#define CHOPGIMP_TYPE_VOBJECTS_UNDO (chopgimp_vobjects_undo_get_type ())
+#define CHOPGIMP_VOBJECTS_UNDO(obj) (G_TYPE_CHECK_INSTANCE_CAST ((obj), CHOPGIMP_TYPE_VOBJECTS_UNDO, ChopGimpVObjectsUndo))
+
+typedef struct
+{
+  GimpItemUndo            parent_instance;
+
+  gchar                  *state;
+  ChopGimpVLayer         *snap;     /* 3.29.2: the state as objects       */
+  GimpVectorLayerOptions *options;
+} ChopGimpVObjectsUndo;
+
+typedef struct
+{
+  GimpItemUndoClass  parent_class;
+} ChopGimpVObjectsUndoClass;
+
+GType chopgimp_vobjects_undo_get_type (void);
+
+G_DEFINE_TYPE (ChopGimpVObjectsUndo, chopgimp_vobjects_undo, GIMP_TYPE_ITEM_UNDO)
+
+/*  3.29.2: undo keeps a copy of the object tree (same ids, sharing the
+ *  cached renderings, which are never changed once made) instead of its
+ *  XML: no writing, no parsing, the restored layer is composited from the
+ *  caches.
+ */
+
+static void
+snapshot_fix_one (ChopGimpVObject *src,
+                  ChopGimpVObject *dst)
+{
+  dst->id  = src->id;
+  dst->rev = src->rev;
+
+  if (src->cache)
+    {
+      dst->cache    = cairo_surface_reference (src->cache);
+      dst->cache_x  = src->cache_x;
+      dst->cache_y  = src->cache_y;
+      dst->cache_fx = src->cache_fx;
+      dst->cache_fy = src->cache_fy;
+      dst->cache_a8 = src->cache_a8;
+      memcpy (dst->cache_rgb, src->cache_rgb, sizeof (src->cache_rgb));
+    }
+
+  memcpy (dst->bounds_valid, src->bounds_valid, sizeof (src->bounds_valid));
+  memcpy (dst->bounds, src->bounds, sizeof (src->bounds));
+}
+
+static void
+snapshot_fix (ChopGimpVObject *src,
+              ChopGimpVObject *dst)
+{
+  snapshot_fix_one (src, dst);
+
+  if (src->children && dst->children)
+    for (guint i = 0; i < src->children->len && i < dst->children->len; i++)
+      snapshot_fix (g_ptr_array_index (src->children, i),
+                    g_ptr_array_index (dst->children, i));
+}
+
+/*  3.29.6 « annulation partielle »: a snapshot keeps only the leaves that
+ *  changed since the previous one (copies), and shares the others with
+ *  it (same objects, never changed while in snapshots: a leaf is copied
+ *  or swapped when its snapshot becomes the layer's objects again).  A
+ *  leaf is unchanged when it has the same revision (every change of the
+ *  rendering makes a new one), the same attributes and the same place in
+ *  the image (world matrix: its cached rendering stays right).  Undo and
+ *  redo swap the unchanged leaves of both states instead of copying them.
+ *  CHOPGIMP_NO_PARTIAL_UNDO=1: the whole tree is copied (3.29.2).
+ */
+static gboolean
+partial_undo_enabled (void)
+{
+  /*  read once: a snapshot made with it must be installed with it  */
+  static gint enabled = -1;
+
+  if (enabled < 0)
+    enabled = (g_getenv ("CHOPGIMP_NO_PARTIAL_UNDO") == NULL);
+
+  return enabled;
+}
+
+typedef struct
+{
+  ChopGimpVObject *node;
+  GimpMatrix3      world;
+} SnapRef;
+
+typedef struct
+{
+  GPtrArray   *array;      /* the children of its group */
+  guint        index;
+  GimpMatrix3  world;
+} SnapSlot;
+
+static void
+world_of_child (const GimpMatrix3     *parent_world,
+                const ChopGimpVObject *o,
+                GimpMatrix3           *world)
+{
+  *world = o->transform;
+
+  if (parent_world)
+    gimp_matrix3_mult (parent_world, world);
+}
+
+static gboolean
+leaf_same (const ChopGimpVObject *a,
+           const GimpMatrix3     *wa,
+           const ChopGimpVObject *b,
+           const GimpMatrix3     *wb)
+{
+  return (a->kind == CHOPGIMP_VOBJECT_PATH && b->kind == CHOPGIMP_VOBJECT_PATH &&
+          a->id == b->id && a->rev == b->rev &&
+          a->visible == b->visible && a->locked == b->locked &&
+          a->opacity == b->opacity && a->mode == b->mode &&
+          a->clip == b->clip && a->opmask == b->opmask &&
+          ! memcmp (&a->transform, &b->transform, sizeof (GimpMatrix3)) &&
+          ! memcmp (wa, wb, sizeof (GimpMatrix3)) &&
+          ! g_strcmp0 (a->name, b->name) && ! g_strcmp0 (a->lpe, b->lpe) &&
+          ! g_strcmp0 (a->livepaint, b->livepaint) &&
+          ! g_strcmp0 (a->symbol, b->symbol) && ! g_strcmp0 (a->blend, b->blend) &&
+          (a->path == NULL) == (b->path == NULL) &&
+          (! a->path ||
+           gimp_path_get_n_strokes (a->path) == gimp_path_get_n_strokes (b->path)) &&
+          chopgimp_vstyle_get_n_entries (&a->style) ==
+          chopgimp_vstyle_get_n_entries (&b->style));
+}
+
+/*  the leaves of a snapshot by id, with their world matrix  */
+static void
+snap_index (ChopGimpVObject   *o,
+            const GimpMatrix3 *parent_world,
+            GHashTable        *ids)
+{
+  GimpMatrix3 w;
+
+  world_of_child (parent_world, o, &w);
+
+  if (o->kind != CHOPGIMP_VOBJECT_GROUP)
+    {
+      SnapRef *r = g_new (SnapRef, 1);
+
+      r->node  = o;
+      r->world = w;
+      g_hash_table_insert (ids, GUINT_TO_POINTER (o->id), r);
+    }
+  else if (o->children)
+    {
+      for (guint i = 0; i < o->children->len; i++)
+        snap_index (g_ptr_array_index (o->children, i), &w, ids);
+    }
+}
+
+/*  a snapshot of the live @o: the leaves of @prev that are unchanged are
+ *  shared, the others copied; the groups are always copied (their
+ *  parents are set by vlayer_reindex())
+ */
+static ChopGimpVObject *
+snap_copy (ChopGimpVObject   *o,
+           const GimpMatrix3 *parent_world,
+           GHashTable        *prev,
+           GimpImage         *image)
+{
+  ChopGimpVObject *c;
+  GimpMatrix3      w;
+
+  world_of_child (parent_world, o, &w);
+
+  if (o->kind != CHOPGIMP_VOBJECT_GROUP)
+    {
+      SnapRef *r = prev ? g_hash_table_lookup (prev, GUINT_TO_POINTER (o->id)) : NULL;
+
+      if (r && r->node != o && leaf_same (o, &w, r->node, &r->world))
+        return chopgimp_vobject_ref (r->node);
+
+      c = chopgimp_vobject_copy (o, image);
+      snapshot_fix (o, c);
+
+      return c;
+    }
+
+  c = vobj_alloc (CHOPGIMP_VOBJECT_GROUP, o->name);
+  vobj_copy_attrs (c, o);
+  snapshot_fix_one (o, c);
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      g_ptr_array_add (c->children,
+                       snap_copy (g_ptr_array_index (o->children, i), &w, prev, image));
+
+  return c;
+}
+
+static void
+slots_collect (ChopGimpVObject   *g,
+               const GimpMatrix3 *gw,
+               GHashTable        *slots)
+{
+  for (guint i = 0; g->children && i < g->children->len; i++)
+    {
+      ChopGimpVObject *o = g_ptr_array_index (g->children, i);
+      GimpMatrix3      w;
+
+      world_of_child (gw, o, &w);
+
+      if (o->kind == CHOPGIMP_VOBJECT_GROUP)
+        {
+          slots_collect (o, &w, slots);
+        }
+      else
+        {
+          SnapSlot *slot = g_new (SnapSlot, 1);
+
+          slot->array = g->children;
+          slot->index = i;
+          slot->world = w;
+          g_hash_table_insert (slots, GUINT_TO_POINTER (o->id), slot);
+        }
+    }
+}
+
+static void
+adopt_rec (ChopGimpVObject   *g,
+           const GimpMatrix3 *gw,
+           GHashTable        *slots,
+           GimpImage         *image)
+{
+  for (guint i = 0; g->children && i < g->children->len; i++)
+    {
+      ChopGimpVObject *s = g_ptr_array_index (g->children, i);
+      GimpMatrix3      w;
+      SnapSlot        *slot;
+      ChopGimpVObject *l;
+
+      world_of_child (gw, s, &w);
+
+      if (s->kind == CHOPGIMP_VOBJECT_GROUP)
+        {
+          adopt_rec (s, &w, slots, image);
+          continue;
+        }
+
+      slot = g_hash_table_lookup (slots, GUINT_TO_POINTER (s->id));
+      l    = slot ? g_ptr_array_index (slot->array, slot->index) : NULL;
+
+      if (l && l != s && leaf_same (l, &slot->world, s, &w))
+        {
+          /*  the live leaf stays live, the snapshot's goes to the other
+           *  state (same content, same place)
+           */
+          g->children->pdata[i]               = l;
+          slot->array->pdata[slot->index]     = s;
+          g_hash_table_remove (slots, GUINT_TO_POINTER (s->id));
+        }
+      else if (s->ref_count > 1)
+        {
+          /*  shared with other snapshots: a copy becomes live  */
+          ChopGimpVObject *c = chopgimp_vobject_copy (s, image);
+
+          snapshot_fix (s, c);
+          g->children->pdata[i] = c;
+          chopgimp_vobject_unref (s);
+        }
+    }
+}
+
+/*  @vl (a snapshot) becomes the objects of the layer instead of @old
+ *  (which becomes a snapshot): no leaf of @vl stays shared
+ */
+static void
+snap_adopt (ChopGimpVLayer *vl,
+            ChopGimpVLayer *old,
+            GimpImage      *image)
+{
+  GHashTable  *slots = g_hash_table_new_full (NULL, NULL, NULL, g_free);
+  GimpMatrix3  ow, nw;
+
+  world_of_child (NULL, old->root, &ow);
+  world_of_child (NULL, vl->root, &nw);
+
+  slots_collect (old->root, &ow, slots);
+  adopt_rec (vl->root, &nw, slots, image);
+  g_hash_table_unref (slots);
+
+  vlayer_reindex (vl);
+  vlayer_reindex (old);
+
+  /*  the effective paths follow the layer's effects  */
+  if (g_strcmp0 (vl->layer_lpe, old->layer_lpe))
+    vobj_invalidate (vl->root);
+
+  /*  the next snapshot shares with the state left  */
+  vl->snap_prev = chopgimp_vobject_ref (old->root);
+  vl->snap_ids  = g_hash_table_new_full (NULL, NULL, NULL, g_free);
+  snap_index (old->root, NULL, vl->snap_ids);
+}
+
+static ChopGimpVLayer *
+vlayer_snapshot (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+  ChopGimpVLayer *c  = vlayer_new ();
+
+  chopgimp_vobject_unref (c->root);
+
+  if (partial_undo_enabled ())
+    {
+      /*  3.29.6: only the changed leaves are copied  */
+      c->root = snap_copy (vl->root, NULL, vl->snap_ids,
+                           gimp_item_get_image (GIMP_ITEM (layer)));
+
+      vlayer_drop_prev (vl);
+      vl->snap_prev = chopgimp_vobject_ref (c->root);
+      vl->snap_ids  = g_hash_table_new_full (NULL, NULL, NULL, g_free);
+      snap_index (c->root, NULL, vl->snap_ids);
+    }
+  else
+    {
+      c->root = chopgimp_vobject_copy (vl->root, gimp_item_get_image (GIMP_ITEM (layer)));
+      snapshot_fix (vl->root, c->root);
+    }
+
+  c->next_id = vl->next_id;
+  c->legacy  = vl->legacy;
+  c->entered = vl->entered;
+  g_array_append_vals (c->selection, vl->selection->data, vl->selection->len);
+  c->opt_sig   = g_strdup (vl->opt_sig);
+  c->layer_lpe = g_strdup (vl->layer_lpe);
+
+  vlayer_reindex (c);
+
+  return c;
+}
+
+static gint64
+vobj_memsize (ChopGimpVObject *o)
+{
+  gint64 size = sizeof (ChopGimpVObject);
+
+  if (o->path)
+    size += gimp_object_get_memsize (GIMP_OBJECT (o->path), NULL);
+
+  /*  3.29.6: a leaf shared by several snapshots, counted once among them  */
+  if (! o->children && o->ref_count > 1)
+    size /= o->ref_count;
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      size += vobj_memsize (g_ptr_array_index (o->children, i));
+
+  return size;
+}
+
+/*  @vl replaces the objects of @layer; returns the old state (not freed)  */
+static ChopGimpVLayer *
+vlayer_install (GimpVectorLayer *layer,
+                ChopGimpVLayer  *vl)
+{
+  ChopGimpVLayer *old = layer->vobjects;
+
+  if (vl && old)
+    {
+      vl->freeze = old->freeze;
+
+      g_ptr_array_extend_and_steal (vl->layouts, old->layouts);
+      old->layouts = g_ptr_array_new_with_free_func ((GDestroyNotify) g_array_unref);
+    }
+
+  if (old)
+    vlayer_drop_prev (old);
+  if (vl)
+    vlayer_drop_prev (vl);
+
+  /*  3.29.6: no leaf of the new state stays shared with a snapshot  */
+  if (vl && old && partial_undo_enabled ())
+    snap_adopt (vl, old, gimp_item_get_image (GIMP_ITEM (layer)));
+
+  if (old)
+    {
+      old->freeze       = 0;
+      old->interactive  = 0;
+      old->legacy_dirty = FALSE;
+      old->sig_pending  = FALSE;
+      sprite_free (old);
+      old->sprite_off   = FALSE;
+      if (old->moved)
+        g_hash_table_remove_all (old->moved);
+    }
+
+  layer->vobjects = vl;
+
+  if (vl)
+    vobj_resolve_globals (vl->root, gimp_item_get_image (GIMP_ITEM (layer)), NULL, NULL);
+
+  return old;
+}
+
+static void
+chopgimp_vobjects_undo_constructed (GObject *object)
+{
+  ChopGimpVObjectsUndo *undo = CHOPGIMP_VOBJECTS_UNDO (object);
+  GimpVectorLayer      *layer;
+
+  G_OBJECT_CLASS (chopgimp_vobjects_undo_parent_class)->constructed (object);
+
+  layer = GIMP_VECTOR_LAYER (GIMP_ITEM_UNDO (undo)->item);
+
+  if (layer->vobjects)
+    undo->snap = vlayer_snapshot (layer);
+
+  if (layer->options)
+    undo->options = gimp_config_duplicate (GIMP_CONFIG (layer->options));
+}
+
+/*  the state @xml replaces the objects of @layer  */
+static void
+vlayer_restore (GimpVectorLayer *layer,
+                const gchar     *xml)
+{
+  ChopGimpVLayer *old = layer->vobjects;
+  ChopGimpVLayer *vl;
+  gboolean        has_legacy;
+
+  vl = xml ? vlayer_parse (gimp_item_get_image (GIMP_ITEM (layer)), xml,
+                           strlen (xml), &has_legacy)
+           : NULL;
+
+  if (xml && ! vl)
+    return;
+
+  if (vl && old)
+    {
+      vl->freeze = old->freeze;
+
+      /*  the legacy path keeps its map: it is rewritten below anyway  */
+      g_ptr_array_extend_and_steal (vl->layouts, old->layouts);
+      old->layouts = g_ptr_array_new_with_free_func ((GDestroyNotify) g_array_unref);
+    }
+
+  layer->vobjects = vl;
+  chopgimp_vlayer_free (old);
+}
+
+/*  3.29.6: after an undo / redo, the legacy path is rewritten from the
+ *  objects later (once for several undo steps in a row), before the next
+ *  events; anything that reads it first (a new change, the XCF, a
+ *  replaced legacy path) writes it at once.  CHOPGIMP_NO_LAZY_LEGACY=1:
+ *  rewritten at every step as before.
+ */
+#define LEGACY_IDLE_KEY "chopgimp-legacy-idle"
+
+static void
+vlayer_flush_legacy (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+
+  if (vl && vl->legacy_dirty && vl->interactive == 0)
+    {
+      vlayer_write_legacy (layer, TRUE, FALSE);
+      vl->legacy_dirty = FALSE;
+    }
+}
+
+static gboolean
+legacy_idle (gpointer data)
+{
+  GimpVectorLayer *layer = data;
+
+  g_object_set_data (G_OBJECT (layer), LEGACY_IDLE_KEY, NULL);
+  vlayer_flush_legacy (layer);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+vlayer_write_legacy_later (GimpVectorLayer *layer)
+{
+  static gint     env_no_lazy_legacy = -1;
+  ChopGimpVLayer *vl                 = layer->vobjects;
+
+  if (chopgimp_env_flag ("CHOPGIMP_NO_LAZY_LEGACY", &env_no_lazy_legacy) || vl->legacy)
+    {
+      vlayer_write_legacy (layer, TRUE, FALSE);
+      return;
+    }
+
+  vl->legacy_dirty = TRUE;
+
+  if (! g_object_get_data (G_OBJECT (layer), LEGACY_IDLE_KEY))
+    {
+      g_object_set_data (G_OBJECT (layer), LEGACY_IDLE_KEY, GINT_TO_POINTER (1));
+      g_idle_add_full (G_PRIORITY_HIGH, legacy_idle,
+                       g_object_ref (layer), g_object_unref);
+    }
+}
+
+static void
+chopgimp_vobjects_undo_pop (GimpUndo            *undo,
+                            GimpUndoMode         undo_mode,
+                            GimpUndoAccumulator *accum)
+{
+  ChopGimpVObjectsUndo   *vundo = CHOPGIMP_VOBJECTS_UNDO (undo);
+  GimpVectorLayer        *layer = GIMP_VECTOR_LAYER (GIMP_ITEM_UNDO (undo)->item);
+  gchar                  *state;
+  GimpVectorLayerOptions *options = NULL;
+
+  GIMP_UNDO_CLASS (chopgimp_vobjects_undo_parent_class)->pop (undo, undo_mode, accum);
+
+  if (layer->options)
+    options = gimp_config_duplicate (GIMP_CONFIG (layer->options));
+
+  if (vundo->snap)
+    {
+      /*  3.29.2: swap the states  */
+      vundo->snap = vlayer_install (layer, vundo->snap);
+      state       = NULL;
+    }
+  else
+    {
+      state = layer->vobjects ? vlayer_serialize (layer, TRUE) : NULL;
+
+      vlayer_restore (layer, vundo->state);
+    }
+
+  /*  the legacy fill / stroke as they were (exactly, for the legacy
+   *  renderer); the legacy path is rewritten from the objects
+   */
+  if (layer->options && vundo->options)
+    {
+      if (layer->vobjects)
+        layer->vobjects->syncing++;
+
+      gimp_config_sync (G_OBJECT (vundo->options), G_OBJECT (layer->options), 0);
+
+      if (layer->vobjects)
+        layer->vobjects->syncing--;
+    }
+
+  if (! vundo->snap || state)
+    {
+      g_free (vundo->state);
+      vundo->state = state;
+    }
+  g_clear_object (&vundo->options);
+  vundo->options = options;
+
+  if (layer->vobjects)
+    {
+      ChopGimpVLayer *vl = layer->vobjects;
+
+      /*  3.29.6: later  */
+      vlayer_write_legacy_later (layer);
+
+      g_free (vl->opt_sig);
+      vl->opt_sig = layer->options ? options_sig (layer->options) : NULL;
+
+      if (layer_usable (layer))
+        {
+          if (vl->legacy)
+            gimp_vector_layer_refresh (layer);
+          else
+            vlayer_render_region (layer, NULL);
+        }
+    }
+  else if (layer_usable (layer))
+    {
+      gimp_vector_layer_refresh (layer);
+    }
+
+  g_signal_emit_by_name (layer, "objects-changed", NULL);
+  g_signal_emit_by_name (layer, "object-selection-changed");
+}
+
+static void
+chopgimp_vobjects_undo_free (GimpUndo     *undo,
+                             GimpUndoMode  undo_mode)
+{
+  ChopGimpVObjectsUndo *vundo = CHOPGIMP_VOBJECTS_UNDO (undo);
+
+  g_clear_pointer (&vundo->state, g_free);
+  g_clear_pointer (&vundo->snap, chopgimp_vlayer_free);
+  g_clear_object (&vundo->options);
+
+  GIMP_UNDO_CLASS (chopgimp_vobjects_undo_parent_class)->free (undo, undo_mode);
+}
+
+static gint64
+chopgimp_vobjects_undo_get_memsize (GimpObject *object,
+                                    gint64     *gui_size)
+{
+  ChopGimpVObjectsUndo *vundo = CHOPGIMP_VOBJECTS_UNDO (object);
+  gint64                size  = vundo->state ? strlen (vundo->state) + 1 : 0;
+
+  if (vundo->snap && vundo->snap->root)
+    size += vobj_memsize (vundo->snap->root);
+
+  size += gimp_object_get_memsize (GIMP_OBJECT (vundo->options), NULL);
+
+  return size + GIMP_OBJECT_CLASS (chopgimp_vobjects_undo_parent_class)->get_memsize (object,
+                                                                                    gui_size);
+}
+
+static void
+chopgimp_vobjects_undo_class_init (ChopGimpVObjectsUndoClass *klass)
+{
+  GObjectClass    *object_class      = G_OBJECT_CLASS (klass);
+  GimpObjectClass *gimp_object_class = GIMP_OBJECT_CLASS (klass);
+  GimpUndoClass   *undo_class        = GIMP_UNDO_CLASS (klass);
+
+  object_class->constructed      = chopgimp_vobjects_undo_constructed;
+  gimp_object_class->get_memsize = chopgimp_vobjects_undo_get_memsize;
+  undo_class->pop                = chopgimp_vobjects_undo_pop;
+  undo_class->free               = chopgimp_vobjects_undo_free;
+}
+
+static void
+chopgimp_vobjects_undo_init (ChopGimpVObjectsUndo *undo)
+{
+}
+
+void
+chopgimp_vlayer_push_undo (GimpVectorLayer *layer,
+                           const gchar     *undo_desc)
+{
+  GimpImage *image;
+
+  g_return_if_fail (GIMP_IS_VECTOR_LAYER (layer));
+
+  if (! gimp_item_is_attached (GIMP_ITEM (layer)) ||
+      ! layer_usable (layer) || ! vlayer_ensure (layer))
+    return;
+
+  vlayer_flush_legacy (layer);   /* 3.29.6 */
+
+  image = gimp_item_get_image (GIMP_ITEM (layer));
+
+  gimp_image_undo_push (image, CHOPGIMP_TYPE_VOBJECTS_UNDO,
+                        GIMP_UNDO_CHOPGIMP_VOBJECTS,
+                        undo_desc ? undo_desc : "Modifier les objets",
+                        GIMP_DIRTY_ITEM | GIMP_DIRTY_DRAWABLE,
+                        "item", layer,
+                        NULL);
+}
+
+
+/*  ─── structure ─────────────────────────────────────────────────────── */
+
+static ChopGimpVObject *
+group_or_root (ChopGimpVLayer  *vl,
+               ChopGimpVObject *parent)
+{
+  if (! parent || parent->kind != CHOPGIMP_VOBJECT_GROUP)
+    return vl->root;
+
+  return parent;
+}
+
+static void
+insert_child (ChopGimpVObject *parent,
+              ChopGimpVObject *o,
+              gint             position)
+{
+  if (position < 0 || position > (gint) parent->children->len)
+    position = parent->children->len;
+
+  o->parent = parent;
+  g_ptr_array_insert (parent->children, position, o);
+}
+
+/*  detaches @o from its parent and returns the reference it held  */
+static ChopGimpVObject *
+detach_child (ChopGimpVObject *o)
+{
+  ChopGimpVObject *parent = o->parent;
+  guint            i;
+
+  if (parent && g_ptr_array_find (parent->children, o, &i))
+    {
+      ChopGimpVObject *self = g_ptr_array_steal_index (parent->children, i);
+
+      self->parent = NULL;
+      return self;
+    }
+
+  return chopgimp_vobject_ref (o);
+}
+
+void
+chopgimp_vlayer_insert (GimpVectorLayer *layer,
+                        ChopGimpVObject *object,
+                        ChopGimpVObject *parent,
+                        gint             position,
+                        gboolean         push_undo)
+{
+  ChopGimpVLayer *vl;
+
+  g_return_if_fail (object != NULL && object->parent == NULL);
+
+  if (! vlayer_begin (layer, "Ajouter un objet", push_undo))
+    return;
+
+  vl = layer->vobjects;
+
+  insert_child (group_or_root (vl, parent), chopgimp_vobject_ref (object), position);
+  assign_ids (vl, object);
+  vobj_invalidate (object);
+
+  vlayer_commit (layer, CHANGE_STRUCTURE, NULL);
+}
+
+void
+chopgimp_vlayer_remove (GimpVectorLayer *layer,
+                        guint            id,
+                        gboolean         push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+
+  if (! o || id == 0)
+    return;
+
+  if (! vlayer_begin (layer, "Supprimer un objet", push_undo))
+    return;
+
+  chopgimp_vobject_unref (detach_child (o));
+
+  vlayer_commit (layer, CHANGE_STRUCTURE, NULL);
+}
+
+void
+chopgimp_vlayer_reorder (GimpVectorLayer *layer,
+                         guint            id,
+                         ChopGimpVObject *new_parent,
+                         gint             position,
+                         gboolean         push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+  ChopGimpVObject *parent;
+  GimpMatrix3      old_world, parent_world;
+
+  if (! o || id == 0)
+    return;
+
+  parent = group_or_root (layer->vobjects, new_parent);
+
+  if (parent == o || chopgimp_vobject_is_ancestor (o, parent))
+    return;
+
+  if (! vlayer_begin (layer, "Réorganiser les objets", push_undo))
+    return;
+
+  /*  the object keeps its place in the image  */
+  chopgimp_vobject_get_world_matrix (o, &old_world);
+  chopgimp_vobject_get_world_matrix (parent, &parent_world);
+
+  o = detach_child (o);
+  insert_child (parent, o, position);
+
+  gimp_matrix3_invert (&parent_world);
+  gimp_matrix3_mult (&parent_world, &old_world);
+  o->transform = old_world;
+
+  vobj_invalidate (o);
+  vlayer_commit (layer, CHANGE_STRUCTURE, NULL);
+}
+
+static gint
+compare_index (gconstpointer a,
+               gconstpointer b)
+{
+  return (chopgimp_vobject_get_index (*(ChopGimpVObject **) a) -
+          chopgimp_vobject_get_index (*(ChopGimpVObject **) b));
+}
+
+ChopGimpVObject *
+chopgimp_vlayer_group (GimpVectorLayer *layer,
+                       const guint     *ids,
+                       gint             n_ids,
+                       const gchar     *name,
+                       gboolean         push_undo)
+{
+  ChopGimpVObject *parent = NULL;
+  ChopGimpVObject *group;
+  GPtrArray       *objs;
+  gint             top = -1;
+
+  if (n_ids < 1 || ! chopgimp_vlayer_get_root (layer))
+    return NULL;
+
+  objs = g_ptr_array_new ();
+
+  for (gint i = 0; i < n_ids; i++)
+    {
+      ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, ids[i]);
+
+      if (! o || ids[i] == 0 || g_ptr_array_find (objs, o, NULL))
+        continue;
+
+      if (parent && o->parent != parent)
+        {
+          g_ptr_array_free (objs, TRUE);
+          return NULL;
+        }
+
+      parent = o->parent;
+      g_ptr_array_add (objs, o);
+    }
+
+  if (objs->len == 0 || ! vlayer_begin (layer, "Grouper", push_undo))
+    {
+      g_ptr_array_free (objs, TRUE);
+      return NULL;
+    }
+
+  g_ptr_array_sort (objs, compare_index);
+  top = chopgimp_vobject_get_index (objs->pdata[objs->len - 1]) - (gint) objs->len + 1;
+
+  group = chopgimp_vobject_new_group (name);
+
+  for (guint i = 0; i < objs->len; i++)
+    insert_child (group, detach_child (objs->pdata[i]), -1);
+
+  insert_child (parent, group, top);
+  assign_ids (layer->vobjects, group);
+
+  g_ptr_array_free (objs, TRUE);
+
+  vobj_invalidate (group);
+  vlayer_commit (layer, CHANGE_STRUCTURE, NULL);
+
+  return group;
+}
+
+void
+chopgimp_vlayer_ungroup (GimpVectorLayer *layer,
+                         guint            group_id,
+                         gboolean         push_undo)
+{
+  ChopGimpVObject *group = chopgimp_vlayer_get_object (layer, group_id);
+  ChopGimpVObject *parent;
+  gint             index;
+
+  if (! group || group_id == 0 || group->kind != CHOPGIMP_VOBJECT_GROUP)
+    return;
+
+  if (! vlayer_begin (layer, "Dissocier le groupe", push_undo))
+    return;
+
+  parent = group->parent;
+  index  = chopgimp_vobject_get_index (group);
+  group  = detach_child (group);
+
+  while (group->children->len > 0)
+    {
+      ChopGimpVObject *c = g_ptr_array_steal_index (group->children, 0);
+      GimpMatrix3      t = c->transform;
+
+      gimp_matrix3_mult (&group->transform, &t);
+      c->transform = t;
+      c->opacity  *= group->opacity;
+      c->visible   = c->visible && group->visible;
+      c->locked    = c->locked || group->locked;
+
+      if (is_normal_mode (c->mode))
+        c->mode = group->mode;
+
+      c->parent = NULL;
+      insert_child (parent, c, index++);
+      vobj_invalidate (c);
+    }
+
+  chopgimp_vobject_unref (group);
+
+  vlayer_commit (layer, CHANGE_STRUCTURE, NULL);
+}
+
+
+/*  ─── geometry ──────────────────────────────────────────────────────── */
+
+static void
+add_world_strokes (GimpVectorLayer *layer,
+                   ChopGimpVObject *o,
+                   GimpPath        *dest,
+                   gboolean         with_effects)
+{
+  GList *leaves = (o->kind == CHOPGIMP_VOBJECT_PATH) ? g_list_prepend (NULL, o)
+                                                      : chopgimp_vobjects_leaves_of (o);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *leaf = l->data;
+      GimpPath        *src  = with_effects ? vobj_effective (layer, leaf) : leaf->path;
+      GimpMatrix3      wm;
+      GimpStroke      *s;
+
+      chopgimp_vobject_get_world_matrix (leaf, &wm);
+
+      for (s = gimp_path_stroke_get_next (src, NULL); s;
+           s = gimp_path_stroke_get_next (src, s))
+        {
+          GimpStroke *d = gimp_stroke_duplicate (s);
+
+          if (! gimp_matrix3_is_identity (&wm))
+            gimp_stroke_transform (d, &wm, NULL);
+
+          gimp_path_stroke_add (dest, d);
+          g_object_unref (d);
+        }
+    }
+
+  g_list_free (leaves);
+}
+
+GimpPath *
+chopgimp_vobject_get_world_path (GimpVectorLayer *layer,
+                                 ChopGimpVObject *object,
+                                 gboolean         with_effects)
+{
+  GimpPath *path;
+
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), NULL);
+  g_return_val_if_fail (object != NULL, NULL);
+
+  if (layer->vobjects)
+    vlayer_check_layer_lpe (layer);
+
+  path = gimp_path_new (gimp_item_get_image (GIMP_ITEM (layer)), object->name);
+
+  gimp_path_freeze (path);
+  add_world_strokes (layer, object, path, with_effects);
+  gimp_path_thaw (path);
+
+  return path;
+}
+
+static gboolean
+leaf_hit (GimpVectorLayer *layer,
+          ChopGimpVObject *o,
+          gdouble          x,
+          gdouble          y,
+          gdouble          tolerance)
+{
+  GimpPath       *path = vobj_effective (layer, o);
+  GimpMatrix3     wm;
+  cairo_matrix_t  cm;
+  cairo_t        *cr;
+  gboolean        hit  = FALSE;
+  gdouble         b[4];
+  gdouble         ux = x, uy = y;
+  gdouble         scale;
+
+  if (! leaf_bounds (layer, o, TRUE, b) ||
+      x < b[0] - tolerance || x > b[2] + tolerance ||
+      y < b[1] - tolerance || y > b[3] + tolerance)
+    return FALSE;
+
+  chopgimp_vobject_get_world_matrix (o, &wm);
+  matrix_to_cairo (&wm, &cm);
+  scale = MAX (matrix_scale (&wm), 1e-6);
+
+  cr = measure_cr ();
+  cairo_set_matrix (cr, &cm);
+  append_path (cr, path);
+  cairo_device_to_user (cr, &ux, &uy);
+
+  {
+    ChopGimpVEntry *fill = NULL;
+
+    /*  a visible fill, even transparent, can be clicked  */
+    for (gint k = 0; k < chopgimp_vstyle_get_n_entries (&o->style); k++)
+      {
+        ChopGimpVEntry *e = chopgimp_vstyle_get_entry (&o->style, k);
+
+        if (e->kind == CHOPGIMP_VENTRY_FILL && e->visible &&
+            e->paint.type != CHOPGIMP_PAINT_NONE)
+          fill = e;
+      }
+
+    if (fill)
+      {
+        cairo_set_fill_rule (cr, o->style.fill_nonzero ? CAIRO_FILL_RULE_WINDING
+                                                       : CAIRO_FILL_RULE_EVEN_ODD);
+        hit = cairo_in_fill (cr, ux, uy);
+      }
+  }
+
+  if (! hit)
+    {
+      ChopGimpVEntry  nostroke = { 0, };
+      ChopGimpVEntry *widest   = NULL;
+      gdouble         w        = 0.0;
+
+      for (gint k = 0; k < chopgimp_vstyle_get_n_entries (&o->style); k++)
+        {
+          ChopGimpVEntry *e = chopgimp_vstyle_get_entry (&o->style, k);
+          gdouble         ew;
+
+          if (e->kind != CHOPGIMP_VENTRY_STROKE || ! chopgimp_ventry_is_painted (e))
+            continue;
+
+          ew = e->width;
+          if (e->align != CHOPGIMP_STROKE_ALIGN_CENTER)
+            ew *= 2.0;
+
+          if (! widest || ew > w)
+            {
+              widest = e;
+              w      = ew;
+            }
+        }
+
+      if (! widest)
+        {
+          nostroke.cap         = GIMP_CAP_BUTT;
+          nostroke.join        = GIMP_JOIN_MITER;
+          nostroke.miter_limit = 10.0;
+          widest = &nostroke;
+        }
+
+      setup_stroke (cr, widest, MAX (w, 0.0) + 2.0 * tolerance / scale);
+      cairo_set_dash (cr, NULL, 0, 0);
+      hit = cairo_in_stroke (cr, ux, uy);
+    }
+
+  cairo_destroy (cr);
+
+  return hit;
+}
+
+static gint env_no_part_hit = -1;
+
+static ChopGimpVObject *
+hit_rec (GimpVectorLayer *layer,
+         ChopGimpVObject *o,
+         gdouble          x,
+         gdouble          y,
+         gdouble          tolerance)
+{
+  /*  3.30.0: the generated parts of a brush (« bpart ») and the
+   *  instances of a repeat (« rinst ») are locked but hit: a click on
+   *  them selects their brush / repeat (CHOPGIMP_NO_PART_HIT=1: not)
+   */
+  if (! o->visible ||
+      (o->locked && ! (o->blend && (! strcmp (o->blend, "bpart") ||
+                                    ! strcmp (o->blend, "rinst")) &&
+                       ! chopgimp_env_flag ("CHOPGIMP_NO_PART_HIT", &env_no_part_hit))))
+    return NULL;
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    return leaf_hit (layer, o, x, y, tolerance) ? o : NULL;
+
+  for (gint i = (gint) o->children->len - 1; i >= 0; i--)
+    {
+      ChopGimpVObject *hit = hit_rec (layer, g_ptr_array_index (o->children, i),
+                                      x, y, tolerance);
+
+      if (hit)
+        return hit;
+    }
+
+  return NULL;
+}
+
+/*  the selectable object containing @o: the child of the entered group,
+ *  or the top-level one
+ */
+static ChopGimpVObject *
+selectable_of (ChopGimpVLayer  *vl,
+               ChopGimpVObject *o)
+{
+  ChopGimpVObject *entered = vl->entered ? g_hash_table_lookup (vl->by_id,
+                                                                GUINT_TO_POINTER (vl->entered))
+                                         : NULL;
+  ChopGimpVObject *context = (entered && chopgimp_vobject_is_ancestor (entered, o))
+                             ? entered : vl->root;
+
+  while (o->parent && o->parent != context)
+    o = o->parent;
+
+  return o;
+}
+
+ChopGimpVObject *
+chopgimp_vlayer_hit_test (GimpVectorLayer *layer,
+                          gdouble          x,
+                          gdouble          y,
+                          gdouble          tolerance,
+                          ChopGimpHitMode  mode)
+{
+  ChopGimpVObject *root = chopgimp_vlayer_get_root (layer);
+  ChopGimpVObject *hit;
+
+  if (! root)
+    return NULL;
+
+  vlayer_check_layer_lpe (layer);
+
+  hit = hit_rec (layer, root, x, y, MAX (tolerance, 0.0));
+
+  /*  3.27.7: in a live paint group, Sélection directe edits the paths
+   *  (hidden « sources » group) rather than the regions
+   */
+  if (hit && mode == CHOPGIMP_HIT_LEAF && hit->livepaint && hit->parent &&
+      hit->parent->livepaint)
+    {
+      ChopGimpVObject *g = hit->parent;
+
+      for (guint i = 0; i < g->children->len; i++)
+        {
+          ChopGimpVObject *src = g_ptr_array_index (g->children, i);
+
+          if (src->kind == CHOPGIMP_VOBJECT_GROUP && ! g_strcmp0 (src->livepaint, "sources"))
+            {
+              GList *leaves = chopgimp_vobjects_leaves_of (src);
+
+              for (GList *l = g_list_last (leaves); l; l = l->prev)
+                if (leaf_hit (layer, l->data, x, y, MAX (tolerance, 0.0) + 3.0))
+                  {
+                    hit = l->data;
+                    break;
+                  }
+
+              g_list_free (leaves);
+            }
+        }
+    }
+
+  /*  3.30.0: a click on a brush edits its path (the key); on an
+   *  instance of a repeat, it takes the whole repeat (Illustrator: the
+   *  source is edited by entering the repeat)
+   */
+  if (hit && mode == CHOPGIMP_HIT_LEAF)
+    for (ChopGimpVObject *p = hit; p; p = p->parent)
+      {
+      if (p->blend && ! strcmp (p->blend, "rinst"))
+        {
+          hit = p->parent;
+          break;
+        }
+      else if (p->blend && ! strcmp (p->blend, "bpart") && p->parent)
+        {
+          ChopGimpVObject *g = p->parent;
+
+          hit = NULL;
+          for (guint i = 0; i < g->children->len && ! hit; i++)
+            {
+              ChopGimpVObject *k = g_ptr_array_index (g->children, i);
+
+              if (k->kind == CHOPGIMP_VOBJECT_PATH && g_strcmp0 (k->blend, "bpart"))
+                hit = k;
+            }
+          break;
+        }
+      }
+
+  if (hit && mode == CHOPGIMP_HIT_SELECTABLE)
+    hit = selectable_of (layer->vobjects, hit);
+
+  return hit;
+}
+
+GList *
+chopgimp_vlayer_objects_in_rect (GimpVectorLayer *layer,
+                                 gdouble          x,
+                                 gdouble          y,
+                                 gdouble          width,
+                                 gdouble          height,
+                                 gboolean         touch)
+{
+  ChopGimpVObject *root = chopgimp_vlayer_get_root (layer);
+  ChopGimpVObject *context;
+  GList           *list = NULL;
+
+  if (! root)
+    return NULL;
+
+  vlayer_check_layer_lpe (layer);
+
+  context = layer->vobjects->entered
+            ? g_hash_table_lookup (layer->vobjects->by_id,
+                                   GUINT_TO_POINTER (layer->vobjects->entered))
+            : NULL;
+
+  if (! context)
+    context = root;
+
+  for (guint i = 0; i < context->children->len; i++)
+    {
+      ChopGimpVObject *o = g_ptr_array_index (context->children, i);
+      gdouble          b[4];
+
+      if (! chopgimp_vobject_is_visible (o) || chopgimp_vobject_is_locked (o) ||
+          ! object_bounds (layer, o, TRUE, TRUE, b))
+        continue;
+
+      if (touch ? (b[2] >= x && b[0] <= x + width && b[3] >= y && b[1] <= y + height)
+                : (b[0] >= x && b[2] <= x + width && b[1] >= y && b[3] <= y + height))
+        list = g_list_prepend (list, o);
+    }
+
+  return g_list_reverse (list);
+}
+
+void
+chopgimp_vlayer_set_path (GimpVectorLayer *layer,
+                          guint            id,
+                          GimpPath        *path,
+                          gboolean         push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+  GeglRectangle    r;
+  gboolean         any = FALSE;
+
+  if (! o || o->kind != CHOPGIMP_VOBJECT_PATH || ! GIMP_IS_PATH (path))
+    return;
+
+  if (! vlayer_begin (layer, "Modifier le tracé de l'objet", push_undo))
+    return;
+
+  dirty_of (layer, o, &r, &any);
+  gimp_path_copy_strokes (path, o->path);
+  vobj_invalidate (o);
+  dirty_of (layer, o, &r, &any);
+
+  vlayer_commit (layer, CHANGE_GEOMETRY, any ? &r : NULL);
+}
+
+/*  bakes the world transformation of a leaf into its path  */
+static void
+bake_leaf (ChopGimpVObject   *o,
+           const GimpMatrix3 *local)
+{
+  gdouble scale = matrix_scale (local);
+
+  path_transform (o->path, local);
+
+  if (scale > 0.0)
+    for (gint k = 0; k < chopgimp_vstyle_get_n_entries (&o->style); k++)
+      {
+        ChopGimpVEntry *e = chopgimp_vstyle_get_entry (&o->style, k);
+
+        e->width       *= scale;
+        e->dash_offset *= scale;
+      }
+
+  gimp_matrix3_identity (&o->transform);
+}
+
+/*  3.28.2: Illustrator's « Mettre à l'échelle les contours et effets »
+ *  (TRUE: strokes follow a scaling, as before; FALSE: their width stays)
+ */
+static gboolean vobjects_scale_strokes = TRUE;
+
+void
+chopgimp_vobjects_set_scale_strokes (gboolean scale)
+{
+  vobjects_scale_strokes = scale ? TRUE : FALSE;
+}
+
+gboolean
+chopgimp_vobjects_get_scale_strokes (void)
+{
+  return vobjects_scale_strokes;
+}
+
+static void
+keep_stroke_widths_rec (ChopGimpVObject *o,
+                        gdouble          s)
+{
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    {
+      for (gint k = 0; k < chopgimp_vstyle_get_n_entries (&o->style); k++)
+        {
+          ChopGimpVEntry *e = chopgimp_vstyle_get_entry (&o->style, k);
+
+          e->width       /= s;
+          e->dash_offset /= s;
+        }
+      return;
+    }
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      keep_stroke_widths_rec (g_ptr_array_index (o->children, i), s);
+}
+
+/*  ─── 3.29.2: the « sprite » of a drag ─────────────────────────────── */
+
+static gboolean
+sprite_unsupported (ChopGimpVObject *o)
+{
+  /*  what makes the rendering of an object depend on others  */
+  if (o->clip || o->opmask || o->livepaint || o->symbol || o->blend ||
+      o->mode != GIMP_LAYER_MODE_NORMAL)
+    return TRUE;
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      if (sprite_unsupported (g_ptr_array_index (o->children, i)))
+        return TRUE;
+
+  return FALSE;
+}
+
+static void
+sprite_free (ChopGimpVLayer *vl)
+{
+  g_clear_pointer (&vl->rest, cairo_surface_destroy);
+  g_clear_pointer (&vl->sprite, cairo_surface_destroy);
+  vl->sdx = vl->sdy = 0.0;
+}
+
+static void
+sprite_collect (ChopGimpVObject *o,
+                GHashTable      *set,
+                GList          **order)
+{
+  if (g_hash_table_contains (set, o))
+    {
+      *order = g_list_prepend (*order, o);
+      return;
+    }
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      sprite_collect (g_ptr_array_index (o->children, i), set, order);
+}
+
+/*  made before the first translation of the gesture: TRUE when usable  */
+static gboolean
+sprite_begin (GimpVectorLayer *layer,
+              GPtrArray       *objs)
+{
+  ChopGimpVLayer *vl    = layer->vobjects;
+  GimpItem       *item  = GIMP_ITEM (layer);
+  const Babl     *space = babl_format_get_space (gimp_drawable_get_format (GIMP_DRAWABLE (layer)));
+  GHashTable     *set;
+  GList          *order = NULL;
+  GeglRectangle   r;
+  gboolean        any   = FALSE;
+  cairo_t        *cr;
+
+  if (vl->sprite_off || vl->rest)
+    return vl->rest != NULL;
+
+  vl->sprite_off = TRUE;   /* until made */
+
+  if (vl->legacy || sprite_unsupported (vl->root) ||
+      gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)))
+    return FALSE;
+
+  set = g_hash_table_new (NULL, NULL);
+  for (guint i = 0; i < objs->len; i++)
+    {
+      g_hash_table_add (set, objs->pdata[i]);
+      dirty_of (layer, objs->pdata[i], &r, &any);
+    }
+
+  if (! any)
+    {
+      g_hash_table_unref (set);
+      return FALSE;
+    }
+
+  gimp_item_get_offset (item, &vl->rest_r.x, &vl->rest_r.y);
+  vl->rest_r.width  = gimp_item_get_width  (item);
+  vl->rest_r.height = gimp_item_get_height (item);
+
+  if ((gint64) vl->rest_r.width * vl->rest_r.height > 64 * 1024 * 1024 ||
+      (gint64) r.width * r.height > 64 * 1024 * 1024)
+    {
+      g_hash_table_unref (set);
+      return FALSE;
+    }
+
+  /*  the rest: everything but the moved objects  */
+  vl->rest = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+                                         vl->rest_r.width, vl->rest_r.height);
+  cr = cairo_create (vl->rest);
+  cairo_translate (cr, -vl->rest_r.x, -vl->rest_r.y);
+  composite_skip = set;
+  cache_leaves_parallel (layer, vl->root, &vl->rest_r, space);
+  composite (cr, layer, vl->root, &vl->rest_r, space);
+  composite_skip = NULL;
+  cairo_destroy (cr);
+  cairo_surface_flush (vl->rest);
+
+  /*  the sprite: the moved objects, in their order  */
+  vl->sprite_r = r;
+  vl->shown_r  = r;
+  vl->sprite   = cairo_image_surface_create (CAIRO_FORMAT_ARGB32, r.width, r.height);
+  cr = cairo_create (vl->sprite);
+  cairo_translate (cr, -r.x, -r.y);
+  sprite_collect (vl->root, set, &order);
+  order = g_list_reverse (order);
+  for (GList *l = order; l; l = l->next)
+    composite (cr, layer, l->data, &r, space);
+  cairo_destroy (cr);
+  cairo_surface_flush (vl->sprite);
+
+  g_list_free (order);
+  g_hash_table_unref (set);
+
+  vl->sdx = vl->sdy = 0.0;
+  vl->sprite_off = FALSE;
+
+  return TRUE;
+}
+
+/*  shows the sprite moved by (sdx, sdy), rounded to whole pixels  */
+static void
+sprite_show (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl       = layer->vobjects;
+  GimpDrawable   *drawable = GIMP_DRAWABLE (layer);
+  GimpItem       *item     = GIMP_ITEM (layer);
+  const Babl     *space    = babl_format_get_space (gimp_drawable_get_format (drawable));
+  GeglRectangle   cur, now, d;
+  cairo_surface_t *surf;
+  cairo_t        *cr;
+
+  now        = vl->sprite_r;
+  now.x     += (gint) floor (vl->sdx + 0.5);
+  now.y     += (gint) floor (vl->sdy + 0.5);
+
+  gimp_item_get_offset (item, &cur.x, &cur.y);
+  cur.width  = gimp_item_get_width  (item);
+  cur.height = gimp_item_get_height (item);
+
+  /*  the layer grows (never shrinks during the gesture)  */
+  {
+    GeglRectangle u;
+
+    gegl_rectangle_bounding_box (&u, &cur, &now);
+
+    if (! gegl_rectangle_equal (&u, &cur))
+      {
+        /*  with a margin: not a new buffer at each step of the drag (the
+         *  exact bounds are set at the end of the gesture)
+         */
+        gint        m = MAX (256, MAX (vl->sprite_r.width, vl->sprite_r.height) / 2);
+        GeglBuffer *old;
+        GeglBuffer *nb;
+
+        if (now.x < cur.x)                             u.x -= m, u.width += m;
+        if (now.y < cur.y)                             u.y -= m, u.height += m;
+        if (now.x + now.width > cur.x + cur.width)     u.width += m;
+        if (now.y + now.height > cur.y + cur.height)   u.height += m;
+
+        old = g_object_ref (gimp_drawable_get_buffer (drawable));
+        nb  = gegl_buffer_new (GEGL_RECTANGLE (0, 0, u.width, u.height),
+                               gimp_drawable_get_format (drawable));
+
+        gegl_buffer_copy (old, GEGL_RECTANGLE (0, 0, cur.width, cur.height),
+                          GEGL_ABYSS_NONE, nb,
+                          GEGL_RECTANGLE (cur.x - u.x, cur.y - u.y,
+                                          cur.width, cur.height));
+        g_object_unref (old);
+
+        g_object_freeze_notify (G_OBJECT (drawable));
+        gimp_drawable_set_buffer (drawable, FALSE, NULL, nb);
+        g_object_unref (nb);
+        gimp_item_set_offset (item, u.x, u.y);
+        g_object_thaw_notify (G_OBJECT (drawable));
+
+        cur = u;
+      }
+  }
+
+  gegl_rectangle_bounding_box (&d, &vl->shown_r, &now);
+  if (! gegl_rectangle_intersect (&d, &d, &cur))
+    return;
+
+  surf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32, d.width, d.height);
+  cr   = cairo_create (surf);
+  cairo_translate (cr, -d.x, -d.y);
+  cairo_set_source_surface (cr, vl->rest, vl->rest_r.x, vl->rest_r.y);
+  cairo_paint (cr);
+  cairo_set_source_surface (cr, vl->sprite, now.x, now.y);
+  cairo_paint (cr);
+  cairo_destroy (cr);
+  cairo_surface_flush (surf);
+
+  put_argb32 (gimp_drawable_get_buffer (drawable),
+              GEGL_RECTANGLE (d.x - cur.x, d.y - cur.y, d.width, d.height),
+              space, cairo_image_surface_get_data (surf),
+              cairo_image_surface_get_stride (surf));
+  cairo_surface_destroy (surf);
+
+  gimp_drawable_update (drawable, d.x - cur.x, d.y - cur.y, d.width, d.height);
+
+  vl->shown_r = now;
+}
+
+void
+chopgimp_vlayer_transform (GimpVectorLayer   *layer,
+                           const guint       *ids,
+                           gint               n_ids,
+                           const GimpMatrix3 *matrix,
+                           gboolean           bake,
+                           gboolean           push_undo)
+{
+  GPtrArray     *objs;
+  GeglRectangle  r;
+  gboolean       any = FALSE;
+  gboolean       shift;
+  gboolean       sprite = FALSE;
+
+  if (! matrix || ! chopgimp_vlayer_get_root (layer))
+    return;
+
+  objs = g_ptr_array_new ();
+
+  for (gint i = 0; i < n_ids; i++)
+    {
+      ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, ids[i]);
+      gboolean         skip = FALSE;
+
+      if (! o || ids[i] == 0)
+        continue;
+
+      /*  an object inside another transformed one moves with it  */
+      for (gint k = 0; k < n_ids; k++)
+        {
+          ChopGimpVObject *other = chopgimp_vlayer_get_object (layer, ids[k]);
+
+          if (other && other != o && chopgimp_vobject_is_ancestor (other, o))
+            skip = TRUE;
+        }
+
+      if (! skip && ! g_ptr_array_find (objs, o, NULL))
+        g_ptr_array_add (objs, o);
+    }
+
+  if (objs->len == 0 || ! vlayer_begin (layer, "Transformer les objets", push_undo))
+    {
+      g_ptr_array_free (objs, TRUE);
+      return;
+    }
+
+  shift = (! bake && layer->vobjects->interactive > 0 &&
+           matrix_is_translation (matrix));
+
+  /*  3.29.2: the sprite is made from the objects before they move  */
+  sprite = shift && layer_usable (layer) && sprite_begin (layer, objs);
+
+  for (guint i = 0; i < objs->len; i++)
+    {
+      ChopGimpVObject *o = objs->pdata[i];
+      GimpMatrix3      pw, pwi, t;
+
+      dirty_of (layer, o, &r, &any);
+
+      /*  T' = PW⁻¹ · M · PW · T  */
+      if (o->parent)
+        chopgimp_vobject_get_world_matrix (o->parent, &pw);
+      else
+        gimp_matrix3_identity (&pw);
+
+      pwi = pw;
+      gimp_matrix3_invert (&pwi);
+
+      t = o->transform;
+      gimp_matrix3_mult (&pw, &t);
+      gimp_matrix3_mult (matrix, &t);
+      gimp_matrix3_mult (&pwi, &t);
+
+      if (bake && o->kind == CHOPGIMP_VOBJECT_PATH)
+        bake_leaf (o, &t);
+      else
+        o->transform = t;
+
+      /*  3.28.2: the stroke keeps its width when the option is off (an
+       *  interactive transformation only, never a bake)
+       */
+      if (! bake && ! vobjects_scale_strokes)
+        {
+          gdouble s = matrix_scale (matrix);
+
+          if (s > 1e-9 && fabs (s - 1.0) > 1e-9)
+            keep_stroke_widths_rec (o, s);
+        }
+
+      if (shift)
+        {
+          /*  3.29.2: the renderings move, exact rendering at the end  */
+          vobj_shift (o, matrix->coeff[0][2], matrix->coeff[1][2]);
+          g_hash_table_add (layer->vobjects->moved, GUINT_TO_POINTER (o->id));
+        }
+      else
+        {
+          vobj_invalidate (o);
+        }
+
+      dirty_of (layer, o, &r, &any);
+    }
+
+  g_ptr_array_free (objs, TRUE);
+
+  if (sprite)
+    {
+      layer->vobjects->sdx += matrix->coeff[0][2];
+      layer->vobjects->sdy += matrix->coeff[1][2];
+      sprite_show (layer);
+      layer->vobjects->hooking++;   /* no live paint / symbols: see sprite_unsupported() */
+      vlayer_commit (layer, CHANGE_GEOMETRY, NULL);
+      layer->vobjects->hooking--;
+      return;
+    }
+
+  vlayer_commit (layer, CHANGE_GEOMETRY, any ? &r : NULL);
+}
+
+void
+chopgimp_vlayer_translate (GimpVectorLayer *layer,
+                           const guint     *ids,
+                           gint             n_ids,
+                           gdouble          dx,
+                           gdouble          dy,
+                           gboolean         push_undo)
+{
+  GimpMatrix3 m;
+
+  gimp_matrix3_identity (&m);
+  gimp_matrix3_translate (&m, dx, dy);
+
+  chopgimp_vlayer_transform (layer, ids, n_ids, &m, FALSE, push_undo);
+}
+
+
+/*  ─── style and properties ──────────────────────────────────────────── */
+
+void
+chopgimp_vlayer_set_style (GimpVectorLayer      *layer,
+                           guint                 id,
+                           const ChopGimpVStyle *style,
+                           gboolean              push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+  GList           *leaves;
+  GeglRectangle    r;
+  gboolean         any = FALSE;
+
+  if (! o || ! style)
+    return;
+
+  if (! vlayer_begin (layer, "Modifier le style de l'objet", push_undo))
+    return;
+
+  leaves = (o->kind == CHOPGIMP_VOBJECT_PATH) ? g_list_prepend (NULL, o)
+                                               : chopgimp_vobjects_leaves_of (o);
+
+  dirty_of (layer, o, &r, &any);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *leaf = l->data;
+
+      chopgimp_vstyle_copy (&leaf->style, style);
+      vobj_invalidate (leaf);
+    }
+
+  dirty_of (layer, o, &r, &any);
+  g_list_free (leaves);
+
+  vlayer_commit (layer, CHANGE_STYLE, any ? &r : NULL);
+}
+
+void
+chopgimp_vlayer_set_props (GimpVectorLayer *layer,
+                           guint            id,
+                           const gchar     *name,
+                           gdouble          opacity,
+                           gint             mode,
+                           gint             visible,
+                           gint             locked,
+                           gboolean         push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+  GeglRectangle    r;
+  gboolean         any = FALSE;
+  guint            what = CHANGE_STYLE;
+
+  if (! o || id == 0)
+    return;
+
+  if (! vlayer_begin (layer, "Modifier l'objet", push_undo))
+    return;
+
+  dirty_of (layer, o, &r, &any);
+
+  if (name)
+    {
+      g_free (o->name);
+      o->name = g_strdup (name);
+    }
+
+  if (opacity >= 0.0)
+    o->opacity = CLAMP (opacity, 0.0, 1.0);
+
+  if (mode >= 0)
+    o->mode = mode;
+
+  if (visible >= 0 && (visible != 0) != o->visible)
+    {
+      o->visible = visible != 0;
+      what      |= CHANGE_GEOMETRY;   /* the layer bounds may change */
+    }
+
+  if (locked >= 0)
+    o->locked = locked != 0;
+
+  vlayer_commit (layer, what, any ? &r : NULL);
+}
+
+void
+chopgimp_vlayer_set_clip (GimpVectorLayer *layer,
+                          guint            group_id,
+                          gboolean         clip,
+                          gboolean         push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, group_id);
+
+  if (! o || group_id == 0 || o->kind != CHOPGIMP_VOBJECT_GROUP ||
+      (o->clip != FALSE) == (clip != FALSE))
+    return;
+
+  if (! vlayer_begin (layer, clip ? "Créer un masque d'écrêtage"
+                                  : "Libérer le masque d'écrêtage", push_undo))
+    return;
+
+  o->clip = clip != FALSE;
+  vobj_invalidate (o);
+
+  vlayer_commit (layer, CHANGE_STYLE | CHANGE_GEOMETRY, NULL);
+}
+
+void
+chopgimp_vlayer_set_opmask (GimpVectorLayer *layer,
+                            guint            group_id,
+                            gint             flags,
+                            gboolean         push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, group_id);
+
+  if (! o || group_id == 0 || o->kind != CHOPGIMP_VOBJECT_GROUP ||
+      o->opmask == flags)
+    return;
+
+  if (! vlayer_begin (layer, flags ? "Masque d'opacité"
+                                   : "Libérer le masque d'opacité", push_undo))
+    return;
+
+  o->opmask = flags;
+  if (flags)
+    o->clip = FALSE;
+  vobj_invalidate (o);
+
+  vlayer_commit (layer, CHANGE_STYLE | CHANGE_GEOMETRY, NULL);
+}
+
+void
+chopgimp_vlayer_set_lpe (GimpVectorLayer *layer,
+                         guint            id,
+                         const gchar     *spec,
+                         gboolean         push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+
+  if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+    return;
+
+  if (! vlayer_begin (layer, "Effets de tracé de l'objet", push_undo))
+    return;
+
+  g_free (o->lpe);
+  o->lpe = (spec && *spec) ? g_strdup (spec) : NULL;
+  vobj_invalidate (o);
+
+  vlayer_commit (layer, CHANGE_STYLE, NULL);
+}
