+/*  au démarrage : un message discret (barre d'état) quand la session
+ *  précédente a laissé un rapport de plantage (4.2.1 : plus de fenêtre ;
+ *  le rapport complet est dans <gimpdir>/crash-reports/, celui du
+ *  traceur dans CrashLog/)
+ */
+static gboolean
+chopgimp_crash_previous (gpointer data)
+{
+  Gimp        *gimp    = data;
+  gchar       *dir     = g_build_filename (gimp_directory (), "crash-reports", NULL);
+  gchar       *report  = chopgimp_crash_newest_report (dir);
+  gchar       *tracer  = chopgimp_crash_take_previous ();
+  GimpDisplay *display = gimp_context_get_display (gimp_get_user_context (gimp));
+  gchar       *path    = NULL;
+
+  chopgimp_crash_previous_id = 0;
+
+  /*  1re ligne du rapport du traceur : son chemin  */
+  if (tracer)
+    {
+      gchar *nl = strchr (tracer, '\n');
+
+      path = nl ? g_strndup (tracer, nl - tracer) : g_strdup (tracer);
+    }
+
+  if (report || path)
+    {
+      gchar *text = g_strdup_printf (_("La dernière session s'est arrêtée brutalement : "
+                                       "rapport de plantage enregistré (%s)"),
+                                     report ? report : path);
+
+      if (! display && gimp_get_display_iter (gimp))
+        display = gimp_get_display_iter (gimp)->data;
+
+      if (display)
+        gimp_statusbar_push_temp (gimp_display_shell_get_statusbar (gimp_display_get_shell (display)),
+                                  GIMP_MESSAGE_INFO, "dialog-information", "%s", text);
+      g_printerr ("ChopGimp: %s\n", text);
+      g_free (text);
+    }
+
+  g_free (path);
+  g_free (tracer);
+  g_free (report);
+  g_free (dir);
+
+  return G_SOURCE_REMOVE;
+}
