+void              chopgimp_vlayer_set_opmask       (GimpVectorLayer  *layer,
+                                                    guint             group_id,
+                                                    gint              flags,
+                                                    gboolean          push_undo);
+/*  @spec NULL: removes the object's own effects  */
+void              chopgimp_vlayer_set_lpe          (GimpVectorLayer  *layer,
+                                                    guint             id,
+                                                    const gchar      *spec,
+                                                    gboolean          push_undo);
+
+
+/*  ─── selection of objects (not undoable, not saved) ────────────────── */
+
+/*  the ids of the selected objects (owned by the layer)  */
+const guint     * chopgimp_vlayer_get_selection    (GimpVectorLayer  *layer,
+                                                    gint             *n_ids);
+GList           * chopgimp_vlayer_get_selected_objects (GimpVectorLayer *layer);
+void              chopgimp_vlayer_set_selection    (GimpVectorLayer  *layer,
