+/*  ─── the registry object ───────────────────────────────────────────── */
+
+#define CHOPGIMP_TYPE_VCOLORS (chopgimp_vcolors_get_type ())
+#define CHOPGIMP_VCOLORS(obj) (G_TYPE_CHECK_INSTANCE_CAST ((obj), CHOPGIMP_TYPE_VCOLORS, ChopGimpVColors))
+
+typedef struct
+{
+  GObject    parent_instance;
+
+  GimpImage *image;     /* the owner (not referenced)     */
+  GPtrArray *colors;    /* ChopGimpVColor *               */
+} ChopGimpVColors;
+
+typedef GObjectClass ChopGimpVColorsClass;
+
+enum
+{
+  GLOBAL_COLOR_CHANGED,
+  GLOBAL_COLORS_CHANGED,
+  LAST_SIGNAL
+};
+
+static guint vcolors_signals[LAST_SIGNAL] = { 0 };
+
+GType chopgimp_vcolors_get_type (void);
+
+G_DEFINE_TYPE (ChopGimpVColors, chopgimp_vcolors, G_TYPE_OBJECT)
+
+
+static void
+vcolor_free (ChopGimpVColor *c)
+{
+  g_free (c->id);
+  g_free (c->name);
+  g_clear_object (&c->color);
+  g_free (c);
+}
+
+static void
+chopgimp_vcolors_finalize (GObject *object)
+{
+  ChopGimpVColors *reg = CHOPGIMP_VCOLORS (object);
+
+  g_ptr_array_free (reg->colors, TRUE);
+
+  G_OBJECT_CLASS (chopgimp_vcolors_parent_class)->finalize (object);
+}
+
+static void
+chopgimp_vcolors_class_init (ChopGimpVColorsClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->finalize = chopgimp_vcolors_finalize;
+
+  vcolors_signals[GLOBAL_COLOR_CHANGED] =
+    g_signal_new ("global-color-changed",
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0, NULL, NULL, NULL,
+                  G_TYPE_NONE, 1,
+                  G_TYPE_STRING);
+
+  vcolors_signals[GLOBAL_COLORS_CHANGED] =
+    g_signal_new ("global-colors-changed",
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0, NULL, NULL, NULL,
+                  G_TYPE_NONE, 0);
+}
+
+static void
+chopgimp_vcolors_init (ChopGimpVColors *reg)
+{
+  reg->colors = g_ptr_array_new_with_free_func ((GDestroyNotify) vcolor_free);
+}
+
+
+/*  ─── text ──────────────────────────────────────────────────────────── */
+
+static gchar *
+registry_serialize (GPtrArray *colors)
+{
+  GString *s = g_string_new ("<chopgimp-global-colors version=\"1\">\n");
+
+  for (guint i = 0; i < colors->len; i++)
+    {
+      ChopGimpVColor *c    = g_ptr_array_index (colors, i);
+      gchar          *id   = g_markup_escape_text (c->id, -1);
+      gchar          *name = g_markup_escape_text (c->name ? c->name : "", -1);
+      gdouble         rgba[4];
+
+      gegl_color_get_pixel (c->color, babl_format ("R'G'B'A double"), rgba);
+
+      g_string_append_printf (s, "<color id=\"%s\" name=\"%s\" color=\"", id, name);
+      for (gint k = 0; k < 4; k++)
+        {
+          if (k)
+            g_string_append_c (s, ' ');
+          chopgimp_put_num (s, rgba[k]);
+        }
+      g_string_append (s, "\"/>\n");
+
+      g_free (id);
+      g_free (name);
+    }
+
+  g_string_append (s, "</chopgimp-global-colors>\n");
+
+  return g_string_free (s, FALSE);
+}
+
+static void
+parse_start (GMarkupParseContext  *context,
+             const gchar          *element,
+             const gchar         **names,
+             const gchar         **values,
+             gpointer              user_data,
+             GError              **error)
+{
+  GPtrArray      *colors = user_data;
+  const gchar    *id = NULL, *name = NULL, *color = NULL;
+  ChopGimpVColor *c;
+  gdouble         rgba[4] = { 0, 0, 0, 1 };
+
+  if (strcmp (element, "color"))
+    return;
+
+  for (gint i = 0; names[i]; i++)
+    {
+      if (! strcmp (names[i], "id"))
+        id = values[i];
+      else if (! strcmp (names[i], "name"))
+        name = values[i];
+      else if (! strcmp (names[i], "color"))
+        color = values[i];
+    }
+
+  if (! id || ! *id)
+    return;
+
+  for (guint i = 0; i < colors->len; i++)
+    if (! strcmp (((ChopGimpVColor *) g_ptr_array_index (colors, i))->id, id))
+      return;   /* a duplicate */
+
+  if (color)
+    {
+      const gchar *p = color;
+      gchar       *end;
+
+      for (gint k = 0; k < 4 && *p; k++)
+        {
+          rgba[k] = g_ascii_strtod (p, &end);
+          if (end == p)
+            break;
+          p = end;
+        }
+    }
+
+  c        = g_new0 (ChopGimpVColor, 1);
+  c->id    = g_strdup (id);
+  c->name  = g_strdup (name ? name : "");
+  c->color = gegl_color_new (NULL);
+  gegl_color_set_pixel (c->color, babl_format ("R'G'B'A double"), rgba);
+
+  g_ptr_array_add (colors, c);
+}
+
+static GPtrArray *
+registry_parse (GimpImage *image)
+{
+  static const GMarkupParser parser   = { parse_start, NULL, NULL, NULL, NULL };
+  GPtrArray                 *colors   = g_ptr_array_new_with_free_func ((GDestroyNotify) vcolor_free);
+  const GimpParasite        *parasite = gimp_image_parasite_find (image, CHOPGIMP_VCOLORS_PARASITE);
+  const gchar               *data;
+  guint32                    len      = 0;
+
+  if (! parasite)
+    return colors;
+
+  data = gimp_parasite_get_data (parasite, &len);
+
+  if (data && len > 0)
+    {
+      GMarkupParseContext *context = g_markup_parse_context_new (&parser, 0, colors, NULL);
+      GError              *error   = NULL;
+
+      if (! g_markup_parse_context_parse (context, data, len, &error) ||
+          ! g_markup_parse_context_end_parse (context, &error))
+        {
+          g_printerr ("ChopGimp: invalid global colors: %s\n",
+                      error ? error->message : "?");
+          g_clear_error (&error);
+        }
+
+      g_markup_parse_context_free (context);
+    }
+
+  return colors;
+}
+
+
+/*  ─── propagation ───────────────────────────────────────────────────── */
+
+static gboolean
+same_color (GeglColor *a,
+            GeglColor *b)
+{
+  gdouble x[4], y[4];
+
+  gegl_color_get_pixel (a, babl_format ("R'G'B'A double"), x);
+  gegl_color_get_pixel (b, babl_format ("R'G'B'A double"), y);
+
+  return (fabs (x[0] - y[0]) < 1e-9 && fabs (x[1] - y[1]) < 1e-9 &&
+          fabs (x[2] - y[2]) < 1e-9 && fabs (x[3] - y[3]) < 1e-9);
+}
+
+static void
+update_layers (GimpImage   *image,
+               const gchar *id)
+{
+  GList *layers = gimp_image_get_layer_list (image);
+
+  for (GList *l = layers; l; l = l->next)
+    if (GIMP_IS_VECTOR_LAYER (l->data))
+      chopgimp_vlayer_update_global_color (l->data, id);
+
+  g_list_free (layers);
+}
+
+/*  the parasite changed (our change, an undo, a script…): read it again,
+ *  update the objects of the changed colors, tell the views
+ */
+static void
+registry_reload (ChopGimpVColors *reg)
+{
+  GPtrArray *old = reg->colors;
+  GPtrArray *new = registry_parse (reg->image);
+  GPtrArray *changed = g_ptr_array_new_with_free_func (g_free);
+  gboolean   list_changed = (old->len != new->len);
+
+  for (guint i = 0; i < new->len; i++)
+    {
+      ChopGimpVColor *n     = g_ptr_array_index (new, i);
+      ChopGimpVColor *o     = NULL;
+
+      for (guint k = 0; k < old->len; k++)
+        if (! strcmp (((ChopGimpVColor *) g_ptr_array_index (old, k))->id, n->id))
+          {
+            o = g_ptr_array_index (old, k);
+
+            if (k != i)
+              list_changed = TRUE;
+            break;
+          }
+
+      if (! o)
+        {
+          /*  a new one (or one back by an undo): its objects follow it  */
+          list_changed = TRUE;
+          g_ptr_array_add (changed, g_strdup (n->id));
+        }
+      else
+        {
+          if (g_strcmp0 (o->name, n->name))
+            list_changed = TRUE;
+
+          if (! same_color (o->color, n->color))
+            g_ptr_array_add (changed, g_strdup (n->id));
+        }
+    }
+
+  reg->colors = new;
+  g_ptr_array_free (old, TRUE);
+
+  for (guint i = 0; i < changed->len; i++)
+    update_layers (reg->image, g_ptr_array_index (changed, i));
+
+  g_object_ref (reg);
+
+  for (guint i = 0; i < changed->len; i++)
+    g_signal_emit (reg, vcolors_signals[GLOBAL_COLOR_CHANGED], 0,
+                   g_ptr_array_index (changed, i));
+
+  if (list_changed || changed->len > 0)
+    g_signal_emit (reg, vcolors_signals[GLOBAL_COLORS_CHANGED], 0);
+
+  g_object_unref (reg);
+
+  g_ptr_array_free (changed, TRUE);
+}
+
+static void
+registry_parasite_changed (GimpImage       *image,
+                           const gchar     *name,
+                           ChopGimpVColors *reg)
+{
+  if (name && ! strcmp (name, CHOPGIMP_VCOLORS_PARASITE))
+    registry_reload (reg);
+}
+
+static ChopGimpVColors *
+registry_get (GimpImage *image)
+{
+  ChopGimpVColors *reg;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  reg = g_object_get_data (G_OBJECT (image), REGISTRY_KEY);
+
+  if (! reg)
+    {
+      reg         = g_object_new (CHOPGIMP_TYPE_VCOLORS, NULL);
+      reg->image  = image;
+      g_ptr_array_free (reg->colors, TRUE);
+      reg->colors = registry_parse (image);
+
+      g_object_set_data_full (G_OBJECT (image), REGISTRY_KEY, reg, g_object_unref);
+
+      g_signal_connect_object (image, "parasite-attached",
+                               G_CALLBACK (registry_parasite_changed), reg, 0);
+      g_signal_connect_object (image, "parasite-detached",
+                               G_CALLBACK (registry_parasite_changed), reg, 0);
+    }
+
+  return reg;
+}
+
+/*  writes @colors (taken) as the image's parasite; the « parasite-attached »
+ *  handler then updates everything
+ */
+static void
+registry_store (ChopGimpVColors *reg,
+                GPtrArray       *colors,
+                const gchar     *undo_desc,
+                gboolean         push_undo)
+{
+  gchar        *xml = registry_serialize (colors);
+  GimpParasite *parasite;
+
+  g_ptr_array_free (colors, TRUE);
+
+  parasite = gimp_parasite_new (CHOPGIMP_VCOLORS_PARASITE,
+                                GIMP_PARASITE_PERSISTENT | GIMP_PARASITE_UNDOABLE,
+                                strlen (xml) + 1, xml);
+  g_free (xml);
+
+  if (push_undo)
+    gimp_image_undo_group_start (reg->image, GIMP_UNDO_GROUP_PARASITE_ATTACH,
+                                 undo_desc);
+
+  gimp_image_parasite_attach (reg->image, parasite, push_undo);
+
+  if (push_undo)
+    gimp_image_undo_group_end (reg->image);
+
+  gimp_parasite_free (parasite);
+}
+
+/*  a copy of the current list, to change then store  */
+static GPtrArray *
+registry_copy (ChopGimpVColors *reg)
+{
+  GPtrArray *copy = g_ptr_array_new_with_free_func ((GDestroyNotify) vcolor_free);
+
+  for (guint i = 0; i < reg->colors->len; i++)
+    {
+      ChopGimpVColor *c = g_ptr_array_index (reg->colors, i);
+      ChopGimpVColor *d = g_new0 (ChopGimpVColor, 1);
+
+      d->id    = g_strdup (c->id);
+      d->name  = g_strdup (c->name);
+      d->color = gegl_color_duplicate (c->color);
+      g_ptr_array_add (copy, d);
+    }
+
+  return copy;
+}
+
+static gint
+find_index (GPtrArray   *colors,
+            const gchar *id)
+{
+  if (id)
+    for (guint i = 0; i < colors->len; i++)
+      if (! strcmp (((ChopGimpVColor *) g_ptr_array_index (colors, i))->id, id))
+        return i;
+
+  return -1;
+}
+
+
+/*  ─── public functions ──────────────────────────────────────────────── */
+
+GObject *
+chopgimp_vcolors_get_registry (GimpImage *image)
+{
+  return G_OBJECT (registry_get (image));
+}
+
+GList *
+chopgimp_vcolors_list (GimpImage *image)
+{
+  ChopGimpVColors *reg  = registry_get (image);
+  GList           *list = NULL;
+
+  if (reg)
+    for (gint i = reg->colors->len - 1; i >= 0; i--)
+      list = g_list_prepend (list, g_ptr_array_index (reg->colors, i));
+
+  return list;
+}
+
+const ChopGimpVColor *
+chopgimp_vcolors_lookup (GimpImage   *image,
+                         const gchar *id)
+{
+  ChopGimpVColors *reg = registry_get (image);
+  gint             i;
+
+  if (! reg || (i = find_index (reg->colors, id)) < 0)
+    return NULL;
+
+  return g_ptr_array_index (reg->colors, i);
+}
+
+GeglColor *
+chopgimp_vcolors_get_color (GimpImage   *image,
+                            const gchar *id)
+{
+  const ChopGimpVColor *c = chopgimp_vcolors_lookup (image, id);
+
+  return c ? c->color : NULL;
+}
+
+gchar *
+chopgimp_vcolors_add (GimpImage   *image,
+                      const gchar *name,
+                      GeglColor   *color,
+                      const gchar *id,
+                      gboolean     push_undo)
+{
+  ChopGimpVColors *reg = registry_get (image);
+  GPtrArray       *colors;
+  ChopGimpVColor  *c;
+  gchar           *new_id;
+
+  g_return_val_if_fail (GEGL_IS_COLOR (color), NULL);
+
+  if (! reg)
+    return NULL;
+
+  if (id)
+    {
+      if (! *id || find_index (reg->colors, id) >= 0)
+        return NULL;
+
+      new_id = g_strdup (id);
+    }
+  else
+    {
+      gchar *uuid = g_uuid_string_random ();
+
+      new_id = g_strdup_printf ("g-%s", uuid);
+      g_free (uuid);
+    }
+
+  colors   = registry_copy (reg);
+  c        = g_new0 (ChopGimpVColor, 1);
+  c->id    = g_strdup (new_id);
+  c->name  = g_strdup (name && *name ? name : _("Couleur globale"));
+  c->color = gegl_color_duplicate (color);
+  g_ptr_array_add (colors, c);
+
+  registry_store (reg, colors, _("Ajouter une couleur globale"), push_undo);
+
+  return new_id;
+}
+
+gboolean
+chopgimp_vcolors_set_color (GimpImage   *image,
+                            const gchar *id,
+                            GeglColor   *color,
+                            gboolean     push_undo)
+{
+  ChopGimpVColors *reg = registry_get (image);
+  GPtrArray       *colors;
+  ChopGimpVColor  *c;
+  gint             i;
+
+  g_return_val_if_fail (GEGL_IS_COLOR (color), FALSE);
+
+  if (! reg || (i = find_index (reg->colors, id)) < 0)
+    return FALSE;
+
+  if (same_color (((ChopGimpVColor *) g_ptr_array_index (reg->colors, i))->color, color))
+    return TRUE;
+
+  colors = registry_copy (reg);
+  c      = g_ptr_array_index (colors, i);
+  g_object_unref (c->color);
+  c->color = gegl_color_duplicate (color);
+
+  registry_store (reg, colors, _("Modifier une couleur globale"), push_undo);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vcolors_rename (GimpImage   *image,
+                         const gchar *id,
+                         const gchar *name,
+                         gboolean     push_undo)
+{
+  ChopGimpVColors *reg = registry_get (image);
+  GPtrArray       *colors;
+  ChopGimpVColor  *c;
+  gint             i;
+
+  if (! reg || ! name || (i = find_index (reg->colors, id)) < 0)
+    return FALSE;
+
+  colors = registry_copy (reg);
+  c      = g_ptr_array_index (colors, i);
+  g_free (c->name);
+  c->name = g_strdup (name);
+
+  registry_store (reg, colors, _("Renommer une couleur globale"), push_undo);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vcolors_remove (GimpImage   *image,
+                         const gchar *id,
+                         gboolean     push_undo)
+{
+  ChopGimpVColors *reg = registry_get (image);
+  GPtrArray       *colors;
+  gint             i;
+
+  if (! reg || (i = find_index (reg->colors, id)) < 0)
+    return FALSE;
+
+  colors = registry_copy (reg);
+  g_ptr_array_remove_index (colors, i);
+
+  registry_store (reg, colors, _("Supprimer une couleur globale"), push_undo);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vcolors_reorder (GimpImage   *image,
+                          const gchar *id,
+                          gint         position,
+                          gboolean     push_undo)
+{
+  ChopGimpVColors *reg = registry_get (image);
+  GPtrArray       *colors;
+  gpointer         c;
+  gint             i;
+
+  if (! reg || (i = find_index (reg->colors, id)) < 0)
+    return FALSE;
+
+  colors = registry_copy (reg);
+  c      = g_ptr_array_steal_index (colors, i);
+
+  if (position < 0 || position > (gint) colors->len)
+    position = colors->len;
+
+  g_ptr_array_insert (colors, position, c);
+
+  registry_store (reg, colors, _("Réorganiser les couleurs globales"), push_undo);
+
+  return TRUE;
+}
+
+gint
+chopgimp_vcolors_count_users (GimpImage   *image,
+                              const gchar *id)
+{
+  GList *layers;
+  gint   n = 0;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), 0);
+
+  layers = gimp_image_get_layer_list (image);
+
+  for (GList *l = layers; l; l = l->next)
+    if (GIMP_IS_VECTOR_LAYER (l->data))
+      n += chopgimp_vlayer_count_global_users (l->data, id);
+
+  g_list_free (layers);
+
+  return n;
+}
+
+
+/*  ─── 3.28.2: drag and drop ─────────────────────────────────────────── */
+
+static gchar *vcolors_dragged = NULL;
+
+void
+chopgimp_vcolors_set_dragged (const gchar *id)
+{
+  g_free (vcolors_dragged);
+  vcolors_dragged = g_strdup (id);
+}
+
+const gchar *
+chopgimp_vcolors_get_dragged (void)
+{
+  return vcolors_dragged;
+}
diff --git a/app/path/chopgimp-vcolors.h b/app/path/chopgimp-vcolors.h
new file mode 100644
index 0000000..9303be5
--- /dev/null
+++ b/app/path/chopgimp-vcolors.h
@@ -0,0 +1,101 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vcolors.h — ChopGimp 3.27.2: global colors of the vector
+ * objects (Illustrator's « nuances globales »)
+ *
+ * Each image has a registry of global colors (id, name, color), kept in
+ * the persistent, undoable image parasite « chopgimp-global-colors »,
+ * so that files are self-contained:
+ *
+ *   <chopgimp-global-colors version="1">
+ *     <color id="g-…" name="Bleu marque" color="r g b a"/>   sRGB R'G'B'A
+ *   </chopgimp-global-colors>
+ *
+ * A paint of an object (ChopGimpPaint.global_id) follows a global color:
+ * changing the color in the registry (one undo step) changes every
+ * object using it in every vector layer of the image, re-rendered. The
+ * parasite is the truth: an undo, a script attaching the parasite, or a
+ * file load update the objects the same way.
+ *
+ * Signals of the registry object (chopgimp_vcolors_get_registry()):
+ *   "global-color-changed"   (GObject *registry, const gchar *id)
+ *       the color of @id changed (the objects are already updated)
+ *   "global-colors-changed"  (GObject *registry)
+ *       the list changed (added, removed, renamed, reordered, reloaded)
+ *
+ * Removing a global color leaves its objects with the last color (their
+ * link is kept, inactive, and comes back on undo).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+G_BEGIN_DECLS
+
+
+#define CHOPGIMP_VCOLORS_PARASITE "chopgimp-global-colors"
+
+typedef struct
+{
+  gchar     *id;
+  gchar     *name;
+  GeglColor *color;
+} ChopGimpVColor;
+
+
+/*  3.28.2: the global color being dragged from the « Couleurs globales »
+ *  panel (NULL: none): a drop on the canvas links the object under the
+ *  pointer instead of filling the layer
+ */
+void                   chopgimp_vcolors_set_dragged  (const gchar *id);
+const gchar          * chopgimp_vcolors_get_dragged  (void);
+
+/*  the registry of @image (created on first use; owned by the image)  */
+GObject              * chopgimp_vcolors_get_registry (GimpImage   *image);
+
+/*  the global colors in their order (const ChopGimpVColor *, owned by
+ *  the registry: g_list_free only)
+ */
+GList                * chopgimp_vcolors_list         (GimpImage   *image);
+const ChopGimpVColor * chopgimp_vcolors_lookup       (GimpImage   *image,
+                                                      const gchar *id);
+/*  borrowed, NULL when @id is not (or no longer) a global color  */
+GeglColor            * chopgimp_vcolors_get_color    (GimpImage   *image,
+                                                      const gchar *id);
+
+/*  a new global color; @id NULL: a new unique id. Returns the id
+ *  (g_free), NULL if @id is already used.
+ */
+gchar                * chopgimp_vcolors_add          (GimpImage   *image,
+                                                      const gchar *name,
+                                                      GeglColor   *color,
+                                                      const gchar *id,
+                                                      gboolean     push_undo);
+gboolean               chopgimp_vcolors_set_color    (GimpImage   *image,
+                                                      const gchar *id,
+                                                      GeglColor   *color,
+                                                      gboolean     push_undo);
+gboolean               chopgimp_vcolors_rename       (GimpImage   *image,
+                                                      const gchar *id,
+                                                      const gchar *name,
+                                                      gboolean     push_undo);
+gboolean               chopgimp_vcolors_remove       (GimpImage   *image,
+                                                      const gchar *id,
+                                                      gboolean     push_undo);
+/*  moves @id to @position in the list (-1: the end)  */
+gboolean               chopgimp_vcolors_reorder      (GimpImage   *image,
+                                                      const gchar *id,
+                                                      gint         position,
+                                                      gboolean     push_undo);
+
+/*  the number of path objects, in all the vector layers of @image,
+ *  with a paint following @id (NULL: any global color)
+ */
+gint                   chopgimp_vcolors_count_users  (GimpImage   *image,
+                                                      const gchar *id);
+
+
+G_END_DECLS
diff --git a/app/path/chopgimp-vobject-ops.c b/app/path/chopgimp-vobject-ops.c
new file mode 100644
index 0000000..57af77f
--- /dev/null
+++ b/app/path/chopgimp-vobject-ops.c
@@ -0,0 +1,2701 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vobject-ops.c — ChopGimp 3.27 (lot V2): commands on the
+ * selected objects of a vector layer. See chopgimp-vobject-ops.h.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpconfig/gimpconfig.h"
+#include "libgimpmath/gimpmath.h"
+
+#include "path-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpchannel.h"
+#include "core/gimpfilloptions.h"
+#include "core/gimpimage.h"
+#include "core/gimpcontext.h"
+#include "core/gimpparamspecs.h"
+#include "pdb/gimppdb.h"
+#include "gimpbezierstroke.h"
+#include "core/gimpimage-undo.h"
+#include "core/gimpundostack.h"
+#include "core/gimpitem.h"
+#include "core/gimprasterizable.h"
+#include "core/gimpstrokeoptions.h"
+#include "core/chopgimp-artboards.h"
+
+#include "gimpanchor.h"
+#include "gimppath.h"
+#include "gimpstroke.h"
+#include "gimpvectorlayer.h"
+#include "gimpvectorlayeroptions.h"
+#include "chopgimp-geom.h"
+#include "chopgimp-vobject.h"
+#include "chopgimp-vobject-ops.h"
+#include "chopgimp-vtransform.h"
+
+#include "gimp-intl.h"
+
+
+/*  ─── helpers ───────────────────────────────────────────────────────── */
+
+gboolean
+chopgimp_vobjects_layer_is_multi (GimpVectorLayer *layer)
+{
+  if (! chopgimp_vobjects_enabled () || ! GIMP_IS_VECTOR_LAYER (layer) ||
+      ! gimp_item_is_attached (GIMP_ITEM (layer)) ||
+      ! gimp_item_is_vector_layer (GIMP_ITEM (layer)) ||
+      ! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  /*  3.27.1: also a layer whose (single, legacy) object was selected
+   *  with the Move tool: the selection is not an edit, the rendering
+   *  stays GIMP's until the first change
+   */
+  return (chopgimp_vlayer_count_leaves (layer) >= 2 ||
+          ! chopgimp_vlayer_is_legacy (layer)       ||
+          chopgimp_vobjects_n_selected (layer) > 0);
+}
+
+gboolean
+chopgimp_vobjects_layer_is_target (GimpVectorLayer *layer)
+{
+  return (chopgimp_vobjects_enabled () && GIMP_IS_VECTOR_LAYER (layer) &&
+          gimp_item_is_attached (GIMP_ITEM (layer)) &&
+          gimp_item_is_vector_layer (GIMP_ITEM (layer)) &&
+          chopgimp_vlayer_get_root (layer) != NULL);
+}
+
+GimpVectorLayer *
+chopgimp_vobjects_get_active_layer (GimpImage *image)
+{
+  GList *layers;
+
+  if (! chopgimp_vobjects_enabled () || ! GIMP_IS_IMAGE (image))
+    return NULL;
+
+  layers = gimp_image_get_selected_layers (image);
+
+  if (g_list_length (layers) != 1 || ! GIMP_IS_VECTOR_LAYER (layers->data) ||
+      ! chopgimp_vobjects_layer_is_multi (layers->data))
+    return NULL;
+
+  return layers->data;
+}
+
+GimpVectorLayer *
+chopgimp_vobjects_get_target_layer (GimpImage *image)
+{
+  GList *layers;
+
+  if (! chopgimp_vobjects_enabled () || ! GIMP_IS_IMAGE (image))
+    return NULL;
+
+  layers = gimp_image_get_selected_layers (image);
+
+  if (g_list_length (layers) != 1 || ! GIMP_IS_VECTOR_LAYER (layers->data) ||
+      ! gimp_item_is_vector_layer (GIMP_ITEM (layers->data)) ||
+      ! chopgimp_vlayer_get_root (layers->data))
+    return NULL;
+
+  return layers->data;
+}
+
+ChopGimpVObject *
+chopgimp_vobjects_add_path (GimpVectorLayer      *layer,
+                            GimpPath             *path,
+                            const gchar          *name,
+                            const ChopGimpVStyle *style)
+{
+  GimpImage       *image   = gimp_item_get_image (GIMP_ITEM (layer));
+  guint            entered = chopgimp_vlayer_get_entered_group (layer);
+  ChopGimpVObject *parent  = entered ? chopgimp_vlayer_get_object (layer, entered) : NULL;
+  ChopGimpVObject *object;
+
+  object = chopgimp_vobject_new_path (image, path, name, style);
+
+  chopgimp_vlayer_push_undo (layer, _("Ajouter un objet"));
+  chopgimp_vlayer_freeze (layer);
+  chopgimp_vobjects_insert_world (layer, object, parent, -1);
+  chopgimp_vlayer_thaw (layer);
+
+  chopgimp_vlayer_set_selection (layer, &object->id, 1);
+  chopgimp_vobject_unref (object);   /* the layer holds it */
+
+  return object;
+}
+
+gint
+chopgimp_vobjects_n_selected (GimpVectorLayer *layer)
+{
+  gint n = 0;
+
+  if (! layer || ! chopgimp_vlayer_get_root (layer))
+    return 0;
+
+  chopgimp_vlayer_get_selection (layer, &n);
+
+  return n;
+}
+
+static void
+leaves_rec (ChopGimpVObject  *o,
+            GList           **list)
+{
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    {
+      *list = g_list_prepend (*list, o);
+      return;
+    }
+
+  for (guint i = 0; i < o->children->len; i++)
+    leaves_rec (g_ptr_array_index (o->children, i), list);
+}
+
+GList *
+chopgimp_vobjects_leaves_of (ChopGimpVObject *object)
+{
+  GList *list = NULL;
+
+  if (object)
+    leaves_rec (object, &list);
+
+  return g_list_reverse (list);
+}
+
+ChopGimpVObject *
+chopgimp_vobjects_first_leaf (ChopGimpVObject *object)
+{
+  GList           *leaves = chopgimp_vobjects_leaves_of (object);
+  ChopGimpVObject *first  = NULL;
+
+  for (GList *l = leaves; l && ! first; l = l->next)
+    if (gimp_path_get_n_strokes (((ChopGimpVObject *) l->data)->path) > 0)
+      first = l->data;
+
+  if (! first && leaves)
+    first = leaves->data;
+
+  g_list_free (leaves);
+
+  return first;
+}
+
+GimpPath *
+chopgimp_vobjects_path_to_local (ChopGimpVObject *object,
+                                 GimpPath        *world)
+{
+  GimpMatrix3  wm;
+  GimpPath    *local;
+  GimpStroke  *s;
+
+  local = gimp_path_new (gimp_item_get_image (GIMP_ITEM (world)),
+                         gimp_object_get_name (world));
+  g_object_ref_sink (local);
+
+  chopgimp_vobject_get_world_matrix (object, &wm);
+
+  if (gimp_matrix3_is_identity (&wm))
+    {
+      gimp_path_copy_strokes (world, local);
+      return local;
+    }
+
+  gimp_matrix3_invert (&wm);
+
+  gimp_path_freeze (local);
+
+  for (s = gimp_path_stroke_get_next (world, NULL); s;
+       s = gimp_path_stroke_get_next (world, s))
+    {
+      GimpStroke *d = gimp_stroke_duplicate (s);
+
+      gimp_stroke_transform (d, &wm, NULL);
+      gimp_path_stroke_add (local, d);
+      g_object_unref (d);
+    }
+
+  gimp_path_thaw (local);
+
+  return local;
+}
+
+void
+chopgimp_vobjects_insert_world (GimpVectorLayer *layer,
+                                ChopGimpVObject *object,
+                                ChopGimpVObject *parent,
+                                gint             position)
+{
+  GimpMatrix3 pw;
+
+  chopgimp_vlayer_insert (layer, object, parent, position, FALSE);
+
+  if (parent && parent->parent)
+    {
+      chopgimp_vobject_get_world_matrix (parent, &pw);
+
+      if (! gimp_matrix3_is_identity (&pw))
+        {
+          gimp_matrix3_invert (&pw);
+          chopgimp_vlayer_transform (layer, &object->id, 1, &pw, TRUE, FALSE);
+        }
+    }
+}
+
+void
+chopgimp_vobjects_style_from_tool (ChopGimpVStyle    *style,
+                                   GimpImage         *image,
+                                   gboolean           enable_fill,
+                                   GimpFillOptions   *fill_options,
+                                   gboolean           enable_stroke,
+                                   GimpStrokeOptions *stroke_options)
+{
+  GimpVectorLayerOptions *options;
+
+  options = g_object_new (GIMP_TYPE_VECTOR_LAYER_OPTIONS,
+                          "gimp", image->gimp,
+                          NULL);
+
+  g_object_set (options,
+                "enable-fill",   enable_fill,
+                "enable-stroke", enable_stroke,
+                NULL);
+
+  if (fill_options)
+    gimp_config_sync (G_OBJECT (fill_options),
+                      G_OBJECT (options->fill_options), 0);
+  if (stroke_options)
+    gimp_config_sync (G_OBJECT (stroke_options),
+                      G_OBJECT (options->stroke_options), 0);
+
+  chopgimp_vstyle_init (style);
+  chopgimp_vstyle_from_options (style, options);
+
+  g_object_unref (options);
+}
+
+/*  the selected objects, sorted bottom → top in their parent  */
+static gint
+cmp_index (gconstpointer a,
+           gconstpointer b)
+{
+  ChopGimpVObject *oa = *(ChopGimpVObject **) a;
+  ChopGimpVObject *ob = *(ChopGimpVObject **) b;
+
+  if (oa->parent != ob->parent)
+    return (oa->parent < ob->parent) ? -1 : 1;
+
+  return chopgimp_vobject_get_index (oa) - chopgimp_vobject_get_index (ob);
+}
+
+static GPtrArray *
+selected_sorted (GimpVectorLayer *layer)
+{
+  GPtrArray   *objs = g_ptr_array_new ();
+  const guint *ids;
+  gint         n = 0;
+
+  if (! layer || ! chopgimp_vlayer_get_root (layer))
+    return objs;
+
+  ids = chopgimp_vlayer_get_selection (layer, &n);
+
+  for (gint i = 0; i < n; i++)
+    {
+      ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, ids[i]);
+
+      if (o && o->id != 0)
+        g_ptr_array_add (objs, o);
+    }
+
+  g_ptr_array_sort (objs, cmp_index);
+
+  return objs;
+}
+
+static gboolean
+same_parent (GPtrArray *objs)
+{
+  for (guint i = 1; i < objs->len; i++)
+    if (((ChopGimpVObject *) objs->pdata[i])->parent !=
+        ((ChopGimpVObject *) objs->pdata[0])->parent)
+      return FALSE;
+
+  return objs->len > 0;
+}
+
+static void
+begin (GimpVectorLayer *layer,
+       const gchar     *desc)
+{
+  chopgimp_vlayer_push_undo (layer, desc);
+  chopgimp_vlayer_freeze (layer);
+}
+
+static void
+end (GimpVectorLayer *layer)
+{
+  chopgimp_vlayer_thaw (layer);
+}
+
+static void
+select_objects (GimpVectorLayer *layer,
+                GPtrArray       *objs)
+{
+  guint *ids = g_new0 (guint, MAX (objs->len, 1));
+
+  for (guint i = 0; i < objs->len; i++)
+    ids[i] = ((ChopGimpVObject *) objs->pdata[i])->id;
+
+  chopgimp_vlayer_set_selection (layer, ids, objs->len);
+  g_free (ids);
+}
+
+
+/*  ─── sensitivity ───────────────────────────────────────────────────── */
+
+gboolean
+chopgimp_vobjects_can_group (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+  gboolean   ok   = same_parent (objs);
+
+  g_ptr_array_free (objs, TRUE);
+
+  return ok;
+}
+
+gboolean
+chopgimp_vobjects_can_ungroup (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+  gboolean   ok   = FALSE;
+
+  for (guint i = 0; i < objs->len && ! ok; i++)
+    if (((ChopGimpVObject *) objs->pdata[i])->kind == CHOPGIMP_VOBJECT_GROUP)
+      ok = TRUE;
+
+  g_ptr_array_free (objs, TRUE);
+
+  return ok;
+}
+
+gboolean
+chopgimp_vobjects_can_clip_make (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+  gboolean   ok   = objs->len >= 2 && same_parent (objs);
+
+  g_ptr_array_free (objs, TRUE);
+
+  return ok;
+}
+
+gboolean
+chopgimp_vobjects_can_clip_release (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+  gboolean   ok   = FALSE;
+
+  for (guint i = 0; i < objs->len && ! ok; i++)
+    if (((ChopGimpVObject *) objs->pdata[i])->clip)
+      ok = TRUE;
+
+  g_ptr_array_free (objs, TRUE);
+
+  return ok;
+}
+
+/*  the shapes of a Pathfinder operation, bottom first: the selected
+ *  objects, or the children of the only selected group
+ */
+static GPtrArray *
+pathfinder_inputs (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+
+  if (objs->len == 1 &&
+      ((ChopGimpVObject *) objs->pdata[0])->kind == CHOPGIMP_VOBJECT_GROUP)
+    {
+      ChopGimpVObject *group = objs->pdata[0];
+
+      g_ptr_array_set_size (objs, 0);
+
+      for (guint i = 0; i < group->children->len; i++)
+        g_ptr_array_add (objs, g_ptr_array_index (group->children, i));
+    }
+
+  if (objs->len < 2 || ! same_parent (objs))
+    g_ptr_array_set_size (objs, 0);
+
+  return objs;
+}
+
+gboolean
+chopgimp_vobjects_can_pathfinder (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = pathfinder_inputs (layer);
+  gboolean   ok   = objs->len >= 2;
+
+  g_ptr_array_free (objs, TRUE);
+
+  return ok;
+}
+
+
+/*  ─── commands ──────────────────────────────────────────────────────── */
+
+gboolean
+chopgimp_vobjects_select_all (GimpVectorLayer *layer)
+{
+  ChopGimpVObject *root = chopgimp_vlayer_get_root (layer);
+  ChopGimpVObject *context;
+  GPtrArray       *objs;
+  guint            entered;
+
+  if (! root)
+    return FALSE;
+
+  entered = chopgimp_vlayer_get_entered_group (layer);
+  context = entered ? chopgimp_vlayer_get_object (layer, entered) : NULL;
+
+  if (! context || context->kind != CHOPGIMP_VOBJECT_GROUP)
+    context = root;
+
+  objs = g_ptr_array_new ();
+
+  for (guint i = 0; i < context->children->len; i++)
+    {
+      ChopGimpVObject *o = g_ptr_array_index (context->children, i);
+
+      if (chopgimp_vobject_is_visible (o) && ! chopgimp_vobject_is_locked (o))
+        g_ptr_array_add (objs, o);
+    }
+
+  select_objects (layer, objs);
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_delete_selection (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+
+  if (objs->len == 0)
+    {
+      g_ptr_array_free (objs, TRUE);
+      return FALSE;
+    }
+
+  begin (layer, _("Supprimer les objets"));
+
+  for (guint i = 0; i < objs->len; i++)
+    chopgimp_vlayer_remove (layer, ((ChopGimpVObject *) objs->pdata[i])->id, FALSE);
+
+  end (layer);
+
+  chopgimp_vlayer_set_selection (layer, NULL, 0);
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_duplicate_selection (GimpVectorLayer *layer,
+                                       gboolean         push_undo)
+{
+  GPtrArray *objs   = selected_sorted (layer);
+  GPtrArray *copies = g_ptr_array_new ();
+  GimpImage *image  = gimp_item_get_image (GIMP_ITEM (layer));
+
+  if (objs->len == 0)
+    {
+      g_ptr_array_free (objs, TRUE);
+      g_ptr_array_free (copies, TRUE);
+      return FALSE;
+    }
+
+  if (push_undo)
+    chopgimp_vlayer_push_undo (layer, _("Dupliquer les objets"));
+
+  chopgimp_vlayer_freeze (layer);
+
+  /*  from the top: the indices of the objects below stay valid  */
+  for (gint i = (gint) objs->len - 1; i >= 0; i--)
+    {
+      ChopGimpVObject *o    = objs->pdata[i];
+      ChopGimpVObject *copy = chopgimp_vobject_copy (o, image);
+
+      chopgimp_vlayer_insert (layer, copy, o->parent,
+                              chopgimp_vobject_get_index (o) + 1, FALSE);
+      g_ptr_array_add (copies, copy);
+      chopgimp_vobject_unref (copy);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+
+  select_objects (layer, copies);
+
+  g_ptr_array_free (objs, TRUE);
+  g_ptr_array_free (copies, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_group_selection (GimpVectorLayer *layer)
+{
+  GPtrArray       *objs = selected_sorted (layer);
+  ChopGimpVObject *group;
+  guint           *ids;
+
+  if (! same_parent (objs))
+    {
+      g_ptr_array_free (objs, TRUE);
+      return FALSE;
+    }
+
+  ids = g_new0 (guint, objs->len);
+  for (guint i = 0; i < objs->len; i++)
+    ids[i] = ((ChopGimpVObject *) objs->pdata[i])->id;
+
+  group = chopgimp_vlayer_group (layer, ids, objs->len, _("Groupe"), TRUE);
+
+  g_free (ids);
+  g_ptr_array_free (objs, TRUE);
+
+  if (! group)
+    return FALSE;
+
+  chopgimp_vlayer_set_selection (layer, &group->id, 1);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_ungroup_selection (GimpVectorLayer *layer)
+{
+  GPtrArray *objs     = selected_sorted (layer);
+  GPtrArray *children = g_ptr_array_new ();
+  gboolean   any      = FALSE;
+
+  for (guint i = 0; i < objs->len; i++)
+    if (((ChopGimpVObject *) objs->pdata[i])->kind == CHOPGIMP_VOBJECT_GROUP)
+      any = TRUE;
+
+  if (! any)
+    {
+      g_ptr_array_free (objs, TRUE);
+      g_ptr_array_free (children, TRUE);
+      return FALSE;
+    }
+
+  begin (layer, _("Dissocier"));
+
+  for (guint i = 0; i < objs->len; i++)
+    {
+      ChopGimpVObject *o = objs->pdata[i];
+
+      if (o->kind == CHOPGIMP_VOBJECT_GROUP)
+        {
+          guint id = o->id;
+
+          for (guint k = 0; k < o->children->len; k++)
+            g_ptr_array_add (children,
+                             chopgimp_vobject_ref (g_ptr_array_index (o->children, k)));
+
+          chopgimp_vlayer_ungroup (layer, id, FALSE);
+        }
+      else
+        {
+          g_ptr_array_add (children, chopgimp_vobject_ref (o));
+        }
+    }
+
+  end (layer);
+
+  select_objects (layer, children);
+
+  for (guint i = 0; i < children->len; i++)
+    chopgimp_vobject_unref (children->pdata[i]);
+
+  g_ptr_array_free (children, TRUE);
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+static gboolean
+is_in (GPtrArray       *objs,
+       ChopGimpVObject *o)
+{
+  return g_ptr_array_find (objs, o, NULL);
+}
+
+gboolean
+chopgimp_vobjects_arrange (GimpVectorLayer  *layer,
+                           ChopGimpVArrange  how)
+{
+  GPtrArray *objs    = selected_sorted (layer);
+  gboolean   changed = FALSE;
+  gint       i;
+
+  if (objs->len == 0)
+    {
+      g_ptr_array_free (objs, TRUE);
+      return FALSE;
+    }
+
+  begin (layer, _("Disposition des objets"));
+
+  switch (how)
+    {
+    case CHOPGIMP_VARRANGE_FRONT:
+      for (i = 0; i < (gint) objs->len; i++)
+        {
+          ChopGimpVObject *o = objs->pdata[i];
+
+          if (chopgimp_vobject_get_index (o) != (gint) o->parent->children->len - 1)
+            changed = TRUE;
+          chopgimp_vlayer_reorder (layer, o->id, o->parent, -1, FALSE);
+        }
+      break;
+
+    case CHOPGIMP_VARRANGE_BACK:
+      for (i = (gint) objs->len - 1; i >= 0; i--)
+        {
+          ChopGimpVObject *o = objs->pdata[i];
+
+          if (chopgimp_vobject_get_index (o) != 0)
+            changed = TRUE;
+          chopgimp_vlayer_reorder (layer, o->id, o->parent, 0, FALSE);
+        }
+      break;
+
+    case CHOPGIMP_VARRANGE_FORWARD:
+      for (i = (gint) objs->len - 1; i >= 0; i--)
+        {
+          ChopGimpVObject *o   = objs->pdata[i];
+          gint             idx = chopgimp_vobject_get_index (o);
+
+          if (idx + 1 < (gint) o->parent->children->len &&
+              ! is_in (objs, g_ptr_array_index (o->parent->children, idx + 1)))
+            {
+              chopgimp_vlayer_reorder (layer, o->id, o->parent, idx + 1, FALSE);
+              changed = TRUE;
+            }
+        }
+      break;
+
+    case CHOPGIMP_VARRANGE_BACKWARD:
+      for (i = 0; i < (gint) objs->len; i++)
+        {
+          ChopGimpVObject *o   = objs->pdata[i];
+          gint             idx = chopgimp_vobject_get_index (o);
+
+          if (idx > 0 &&
+              ! is_in (objs, g_ptr_array_index (o->parent->children, idx - 1)))
+            {
+              chopgimp_vlayer_reorder (layer, o->id, o->parent, idx - 1, FALSE);
+              changed = TRUE;
+            }
+        }
+      break;
+    }
+
+  end (layer);
+  g_ptr_array_free (objs, TRUE);
+
+  return changed;
+}
+
+static gboolean
+set_flags_selection (GimpVectorLayer *layer,
+                     const gchar     *desc,
+                     gint             visible,
+                     gint             locked)
+{
+  GPtrArray *objs = selected_sorted (layer);
+
+  if (objs->len == 0)
+    {
+      g_ptr_array_free (objs, TRUE);
+      return FALSE;
+    }
+
+  begin (layer, desc);
+
+  for (guint i = 0; i < objs->len; i++)
+    chopgimp_vlayer_set_props (layer, ((ChopGimpVObject *) objs->pdata[i])->id,
+                               NULL, -1.0, -1, visible, locked, FALSE);
+
+  end (layer);
+
+  chopgimp_vlayer_set_selection (layer, NULL, 0);
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_lock_selection (GimpVectorLayer *layer)
+{
+  return set_flags_selection (layer, _("Verrouiller les objets"), -1, 1);
+}
+
+gboolean
+chopgimp_vobjects_hide_selection (GimpVectorLayer *layer)
+{
+  return set_flags_selection (layer, _("Masquer les objets"), 0, -1);
+}
+
+static void
+collect_flagged (ChopGimpVObject *o,
+                 gboolean         hidden,
+                 GPtrArray       *out)
+{
+  if (o->id != 0 && (hidden ? ! o->visible : o->locked))
+    g_ptr_array_add (out, o);
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      collect_flagged (g_ptr_array_index (o->children, i), hidden, out);
+}
+
+static gboolean
+clear_flag_all (GimpVectorLayer *layer,
+                gboolean         hidden,
+                const gchar     *desc)
+{
+  ChopGimpVObject *root = chopgimp_vlayer_get_root (layer);
+  GPtrArray       *objs;
+
+  if (! root)
+    return FALSE;
+
+  objs = g_ptr_array_new ();
+  collect_flagged (root, hidden, objs);
+
+  if (objs->len > 0)
+    {
+      begin (layer, desc);
+
+      for (guint i = 0; i < objs->len; i++)
+        chopgimp_vlayer_set_props (layer, ((ChopGimpVObject *) objs->pdata[i])->id,
+                                   NULL, -1.0, -1,
+                                   hidden ? 1 : -1, hidden ? -1 : 0, FALSE);
+
+      end (layer);
+    }
+
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_unlock_all (GimpVectorLayer *layer)
+{
+  return clear_flag_all (layer, FALSE, _("Tout déverrouiller"));
+}
+
+gboolean
+chopgimp_vobjects_show_all (GimpVectorLayer *layer)
+{
+  return clear_flag_all (layer, TRUE, _("Tout afficher"));
+}
+
+typedef struct
+{
+  guint   id;
+  gdouble x1, y1, x2, y2;
+} Box;
+
+static gint
+cmp_box_x (gconstpointer a, gconstpointer b)
+{
+  gdouble d = ((const Box *) a)->x1 - ((const Box *) b)->x1;
+
+  return d < 0 ? -1 : d > 0 ? 1 : 0;
+}
+
+static gint
+cmp_box_y (gconstpointer a, gconstpointer b)
+{
+  gdouble d = ((const Box *) a)->y1 - ((const Box *) b)->y1;
+
+  return d < 0 ? -1 : d > 0 ? 1 : 0;
+}
+
+gboolean
+chopgimp_vobjects_align (GimpVectorLayer *layer,
+                         ChopGimpVAlign   mode)
+{
+  GPtrArray *objs  = selected_sorted (layer);
+  GimpImage *image = gimp_item_get_image (GIMP_ITEM (layer));
+  GArray    *boxes = g_array_new (FALSE, FALSE, sizeof (Box));
+  gdouble    rx1, ry1, rx2, ry2;
+  gboolean   dist  = (mode == CHOPGIMP_VALIGN_DISTRIBUTE_H ||
+                      mode == CHOPGIMP_VALIGN_DISTRIBUTE_V);
+  gboolean   have_ref = FALSE;
+  guint      key;
+
+  for (guint i = 0; i < objs->len; i++)
+    {
+      ChopGimpVObject *o = objs->pdata[i];
+      Box              b;
+
+      if (chopgimp_vobject_is_locked (o))
+        continue;
+
+      b.id = o->id;
+      if (chopgimp_vobject_get_bounds (layer, o, TRUE, &b.x1, &b.y1, &b.x2, &b.y2))
+        g_array_append_val (boxes, b);
+    }
+
+  g_ptr_array_free (objs, TRUE);
+
+  if (boxes->len == 0 || (dist && boxes->len < 3))
+    {
+      g_array_free (boxes, TRUE);
+      return FALSE;
+    }
+
+  /*  3.29.0: the key object (it does not move) or « Aligner sur : plan
+   *  de travail »
+   */
+  key = chopgimp_vtransform_get_key (layer);
+
+  /*  3.29.5: « Aligner sur : l'objet clé » without a key object: the
+   *  frontmost selected object becomes the key (as Illustrator does),
+   *  shown with its key outline, instead of aligning on the selection
+   *  (CHOPGIMP_NO_AUTO_KEY=1: the old behaviour)
+   */
+  if (! key && ! dist && boxes->len > 1 &&
+      chopgimp_vtransform_get_align_to () == CHOPGIMP_ALIGN_TO_KEY &&
+      ! g_getenv ("CHOPGIMP_NO_AUTO_KEY"))
+    {
+      key = g_array_index (boxes, Box, boxes->len - 1).id;   /* sorted bottom → top */
+      chopgimp_vtransform_set_key (layer, key);
+    }
+
+  if (key && boxes->len > 1 && ! dist)
+    {
+      for (guint i = 0; i < boxes->len; i++)
+        {
+          Box *b = &g_array_index (boxes, Box, i);
+
+          if (b->id == key)
+            {
+              rx1 = b->x1; ry1 = b->y1; rx2 = b->x2; ry2 = b->y2;
+              g_array_remove_index (boxes, i);
+              have_ref = TRUE;
+              break;
+            }
+        }
+    }
+  else if (chopgimp_vtransform_get_align_to () == CHOPGIMP_ALIGN_TO_ARTBOARD && ! dist)
+    {
+      /*  3.31.0: the artboard of the objects (the one holding their
+       *  centre, else the active one), else the canvas
+       */
+      gdouble       bx1 = G_MAXDOUBLE, by1 = G_MAXDOUBLE;
+      gdouble       bx2 = -G_MAXDOUBLE, by2 = -G_MAXDOUBLE;
+      GeglRectangle ab;
+
+      for (guint i = 0; i < boxes->len; i++)
+        {
+          Box *b = &g_array_index (boxes, Box, i);
+
+          bx1 = MIN (bx1, b->x1); by1 = MIN (by1, b->y1);
+          bx2 = MAX (bx2, b->x2); by2 = MAX (by2, b->y2);
+        }
+
+      if (boxes->len && chopgimp_artboards_rect_for_box (image, bx1, by1, bx2, by2, &ab))
+        {
+          rx1 = ab.x;            ry1 = ab.y;
+          rx2 = ab.x + ab.width; ry2 = ab.y + ab.height;
+        }
+      else
+        {
+          rx1 = ry1 = 0;
+          rx2 = gimp_image_get_width  (image);
+          ry2 = gimp_image_get_height (image);
+        }
+      have_ref = TRUE;
+    }
+
+  /*  the reference rectangle  */
+  if (have_ref)
+    {
+    }
+  else if (boxes->len == 1)
+    {
+      GimpChannel *mask = gimp_image_get_mask (image);
+
+      if (! gimp_channel_is_empty (mask))
+        {
+          gint x, y, w, h;
+
+          gimp_item_bounds (GIMP_ITEM (mask), &x, &y, &w, &h);
+          rx1 = x; ry1 = y; rx2 = x + w; ry2 = y + h;
+        }
+      else
+        {
+          rx1 = ry1 = 0;
+          rx2 = gimp_image_get_width  (image);
+          ry2 = gimp_image_get_height (image);
+        }
+    }
+  else
+    {
+      rx1 = ry1 = G_MAXDOUBLE;
+      rx2 = ry2 = -G_MAXDOUBLE;
+
+      for (guint i = 0; i < boxes->len; i++)
+        {
+          Box *b = &g_array_index (boxes, Box, i);
+
+          rx1 = MIN (rx1, b->x1); ry1 = MIN (ry1, b->y1);
+          rx2 = MAX (rx2, b->x2); ry2 = MAX (ry2, b->y2);
+        }
+    }
+
+  begin (layer, dist ? _("Répartir les objets") : _("Aligner les objets"));
+
+  if (dist)
+    {
+      gboolean h     = (mode == CHOPGIMP_VALIGN_DISTRIBUTE_H);
+      gdouble  total = 0.0, gap, pos;
+
+      g_array_sort (boxes, h ? cmp_box_x : cmp_box_y);
+
+      for (guint i = 0; i < boxes->len; i++)
+        {
+          Box *b = &g_array_index (boxes, Box, i);
+
+          total += h ? b->x2 - b->x1 : b->y2 - b->y1;
+        }
+
+      gap = ((h ? rx2 - rx1 : ry2 - ry1) - total) / (boxes->len - 1);
+      pos = h ? rx1 : ry1;
+
+      for (guint i = 0; i < boxes->len; i++)
+        {
+          Box *b = &g_array_index (boxes, Box, i);
+
+          if (h)
+            chopgimp_vlayer_translate (layer, &b->id, 1, pos - b->x1, 0, FALSE);
+          else
+            chopgimp_vlayer_translate (layer, &b->id, 1, 0, pos - b->y1, FALSE);
+
+          pos += (h ? b->x2 - b->x1 : b->y2 - b->y1) + gap;
+        }
+    }
+  else
+    {
+      for (guint i = 0; i < boxes->len; i++)
+        {
+          Box     *b  = &g_array_index (boxes, Box, i);
+          gdouble  dx = 0.0, dy = 0.0;
+
+          switch (mode)
+            {
+            case CHOPGIMP_VALIGN_LEFT:    dx = rx1 - b->x1; break;
+            case CHOPGIMP_VALIGN_HCENTER: dx = (rx1 + rx2 - b->x1 - b->x2) / 2.0; break;
+            case CHOPGIMP_VALIGN_RIGHT:   dx = rx2 - b->x2; break;
+            case CHOPGIMP_VALIGN_TOP:     dy = ry1 - b->y1; break;
+            case CHOPGIMP_VALIGN_VCENTER: dy = (ry1 + ry2 - b->y1 - b->y2) / 2.0; break;
+            case CHOPGIMP_VALIGN_BOTTOM:  dy = ry2 - b->y2; break;
+            default: break;
+            }
+
+          if (dx != 0.0 || dy != 0.0)
+            chopgimp_vlayer_translate (layer, &b->id, 1, dx, dy, FALSE);
+        }
+    }
+
+  end (layer);
+  g_array_free (boxes, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_clip_make (GimpVectorLayer *layer)
+{
+  GPtrArray       *objs = selected_sorted (layer);
+  ChopGimpVObject *group;
+  guint           *ids;
+
+  if (objs->len < 2 || ! same_parent (objs))
+    {
+      g_ptr_array_free (objs, TRUE);
+      return FALSE;
+    }
+
+  ids = g_new0 (guint, objs->len);
+  for (guint i = 0; i < objs->len; i++)
+    ids[i] = ((ChopGimpVObject *) objs->pdata[i])->id;
+
+  begin (layer, _("Créer un masque d'écrêtage"));
+
+  group = chopgimp_vlayer_group (layer, ids, objs->len, _("Groupe de découpe"), FALSE);
+  if (group)
+    chopgimp_vlayer_set_clip (layer, group->id, TRUE, FALSE);
+
+  end (layer);
+
+  if (group)
+    chopgimp_vlayer_set_selection (layer, &group->id, 1);
+
+  g_free (ids);
+  g_ptr_array_free (objs, TRUE);
+
+  return group != NULL;
+}
+
+gboolean
+chopgimp_vobjects_clip_release (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+  gboolean   any  = FALSE;
+
+  for (guint i = 0; i < objs->len; i++)
+    if (((ChopGimpVObject *) objs->pdata[i])->clip)
+      any = TRUE;
+
+  if (any)
+    {
+      begin (layer, _("Libérer le masque d'écrêtage"));
+
+      for (guint i = 0; i < objs->len; i++)
+        if (((ChopGimpVObject *) objs->pdata[i])->clip)
+          chopgimp_vlayer_set_clip (layer, ((ChopGimpVObject *) objs->pdata[i])->id,
+                                    FALSE, FALSE);
+
+      end (layer);
+    }
+
+  g_ptr_array_free (objs, TRUE);
+
+  return any;
+}
+
+/*  the input that gives its style to a piece: the topmost one containing
+ *  a point of it
+ */
+static ChopGimpVObject *
+piece_owner (GPtrArray *inputs,
+             GPtrArray *worlds,
+             GimpPath  *piece)
+{
+  gdouble x, y;
+
+  if (chopgimp_geom_interior_point (piece, &x, &y))
+    for (gint i = (gint) inputs->len - 1; i >= 0; i--)
+      if (chopgimp_geom_contains (worlds->pdata[i], x, y))
+        return inputs->pdata[i];
+
+  return inputs->pdata[inputs->len - 1];
+}
+
+gboolean
+chopgimp_vobjects_pathfinder (GimpVectorLayer     *layer,
+                              ChopGimpVPathfinder  op)
+{
+  GimpImage       *image  = gimp_item_get_image (GIMP_ITEM (layer));
+  GPtrArray       *inputs = pathfinder_inputs (layer);
+  GPtrArray       *worlds;
+  GPtrArray       *result;
+  ChopGimpVObject *top, *parent;
+  gint             position;
+  static const gchar *const descs[] =
+  {
+    N_("Pathfinder : réunir"), N_("Pathfinder : soustraire"),
+    N_("Pathfinder : intersection"), N_("Pathfinder : exclure"),
+    N_("Pathfinder : diviser")
+  };
+
+  if (inputs->len < 2)
+    {
+      g_ptr_array_free (inputs, TRUE);
+      return FALSE;
+    }
+
+  worlds = g_ptr_array_new_with_free_func (g_object_unref);
+  for (guint i = 0; i < inputs->len; i++)
+    {
+      GimpPath *w = chopgimp_vobject_get_world_path (layer, inputs->pdata[i], FALSE);
+
+      g_object_ref_sink (w);
+      g_ptr_array_add (worlds, w);
+    }
+
+  top      = inputs->pdata[inputs->len - 1];
+  parent   = top->parent;
+  position = chopgimp_vobject_get_index (top) + 1;
+  result   = g_ptr_array_new ();
+
+  if (op == CHOPGIMP_VPATHFINDER_DIVIDE)
+    {
+      gint       n_pieces = 0;
+      GimpPath **pieces   = chopgimp_geom_divide ((GimpPath **) worlds->pdata,
+                                                  worlds->len, &n_pieces);
+
+      if (pieces && n_pieces > 0)
+        {
+          ChopGimpVObject *group;
+
+          begin (layer, _(descs[op]));
+
+          group = chopgimp_vobject_new_group (_("Division"));
+          chopgimp_vlayer_insert (layer, group, parent, position, FALSE);
+
+          for (gint i = 0; i < n_pieces; i++)
+            {
+              ChopGimpVObject *owner = chopgimp_vobjects_first_leaf (piece_owner (inputs, worlds,
+                                                                                  pieces[i]));
+              ChopGimpVObject *piece;
+
+              piece = chopgimp_vobject_new_path (image, pieces[i],
+                                                 owner ? owner->name : _("Morceau"),
+                                                 owner ? &owner->style : NULL);
+              chopgimp_vobjects_insert_world (layer, piece, group, -1);
+              chopgimp_vobject_unref (piece);
+              g_object_unref (pieces[i]);
+            }
+
+          g_ptr_array_add (result, group);
+          chopgimp_vobject_unref (group);
+        }
+
+      g_free (pieces);
+    }
+  else
+    {
+      static const ChopGimpBoolOp ops[] = { CHOPGIMP_BOOL_UNION, CHOPGIMP_BOOL_DIFFERENCE,
+                                            CHOPGIMP_BOOL_INTERSECTION,
+                                            CHOPGIMP_BOOL_EXCLUSION };
+      GimpPath *shape = chopgimp_geom_boolean ((GimpPath **) worlds->pdata, worlds->len,
+                                               ops[op]);
+
+      if (shape)
+        {
+          ChopGimpVObject *src   = (op == CHOPGIMP_VPATHFINDER_MINUS) ? inputs->pdata[0] : top;
+          ChopGimpVObject *style = chopgimp_vobjects_first_leaf (src);
+          ChopGimpVObject *obj;
+
+          begin (layer, _(descs[op]));
+
+          obj = chopgimp_vobject_new_path (image, shape, src->name,
+                                           style ? &style->style : NULL);
+
+          /*  a union fills everything inside it, even when lib2geom had
+           *  to give back the operands (shared edges)
+           */
+          if (op == CHOPGIMP_VPATHFINDER_UNION)
+            obj->style.fill_nonzero = TRUE;
+          chopgimp_vobjects_insert_world (layer, obj, parent, position);
+          g_ptr_array_add (result, obj);
+          chopgimp_vobject_unref (obj);
+          g_object_unref (shape);
+        }
+    }
+
+  if (result->len > 0)
+    {
+      for (guint i = 0; i < inputs->len; i++)
+        chopgimp_vlayer_remove (layer, ((ChopGimpVObject *) inputs->pdata[i])->id, FALSE);
+
+      end (layer);
+
+      select_objects (layer, result);
+    }
+
+  {
+    gboolean done = result->len > 0;
+
+    g_ptr_array_free (result, TRUE);
+    g_ptr_array_free (worlds, TRUE);
+    g_ptr_array_free (inputs, TRUE);
+
+    return done;
+  }
+}
+
+gboolean
+chopgimp_vobjects_copy_style (GimpVectorLayer *layer,
+                              ChopGimpVObject *from)
+{
+  GPtrArray       *objs = selected_sorted (layer);
+  ChopGimpVObject *leaf = chopgimp_vobjects_first_leaf (from);
+  ChopGimpVStyle   style;
+
+  if (! leaf || objs->len == 0)
+    {
+      g_ptr_array_free (objs, TRUE);
+      return FALSE;
+    }
+
+  /*  a copy: setting the style of @from itself would free it  */
+  chopgimp_vstyle_init (&style);
+  chopgimp_vstyle_copy (&style, &leaf->style);
+
+  begin (layer, _("Pipette de style"));
+
+  for (guint i = 0; i < objs->len; i++)
+    if (objs->pdata[i] != leaf)
+      chopgimp_vlayer_set_style (layer, ((ChopGimpVObject *) objs->pdata[i])->id,
+                                 &style, FALSE);
+
+  end (layer);
+
+  chopgimp_vstyle_clear (&style);
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+
+/*  ─── 3.29.3: selection by color / size, cleaning, colors ──────────── */
+
+/*  the plain color of a leaf's primary fill / stroke as R'G'B'A u8; FALSE
+ *  when it has none (no entry, hidden, not a plain color)
+ */
+static gboolean
+leaf_color_key (ChopGimpVObject *leaf,
+                gboolean         stroke,
+                guint32         *key)
+{
+  ChopGimpVEntry *e;
+  guint8          px[4];
+
+  if (! leaf || leaf->kind != CHOPGIMP_VOBJECT_PATH)
+    return FALSE;
+
+  e = stroke ? chopgimp_vstyle_get_stroke (&leaf->style)
+             : chopgimp_vstyle_get_fill (&leaf->style);
+
+  if (! e || ! e->visible || e->paint.type != CHOPGIMP_PAINT_COLOR ||
+      ! e->paint.color || (stroke && e->width <= 0.0))
+    return FALSE;
+
+  gegl_color_get_pixel (e->paint.color, babl_format ("R'G'B'A u8"), px);
+  *key = ((guint32) px[0] << 24) | ((guint32) px[1] << 16) |
+         ((guint32) px[2] << 8)  |  (guint32) px[3];
+
+  return TRUE;
+}
+
+static gboolean
+leaf_is_free (ChopGimpVObject *o)
+{
+  return o->kind == CHOPGIMP_VOBJECT_PATH &&
+         chopgimp_vobject_is_visible (o) && ! chopgimp_vobject_is_locked (o);
+}
+
+static ChopGimpVObject *
+first_selected_leaf (GimpVectorLayer *layer)
+{
+  GList           *objs = chopgimp_vlayer_get_selected_objects (layer);
+  ChopGimpVObject *leaf = NULL;
+
+  if (objs)
+    {
+      GList *leaves = chopgimp_vobjects_leaves_of (objs->data);
+
+      if (leaves)
+        leaf = leaves->data;
+
+      g_list_free (leaves);
+      g_list_free (objs);
+    }
+
+  return leaf;
+}
+
+gboolean
+chopgimp_vobjects_select_same (GimpVectorLayer *layer,
+                               ChopGimpVSame    what)
+{
+  ChopGimpVObject *ref = first_selected_leaf (layer);
+  guint32          kf  = 0, ks = 0;
+  gboolean         hf, hs;
+  GList           *leaves;
+  GPtrArray       *objs;
+
+  if (! ref)
+    return FALSE;
+
+  hf = leaf_color_key (ref, FALSE, &kf);
+  hs = leaf_color_key (ref, TRUE,  &ks);
+
+  if ((what == CHOPGIMP_VSAME_FILL && ! hf) ||
+      (what == CHOPGIMP_VSAME_STROKE && ! hs) ||
+      (! hf && ! hs))
+    return FALSE;
+
+  objs   = g_ptr_array_new ();
+  leaves = chopgimp_vlayer_get_leaves (layer);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      guint32          f, k;
+      gboolean         of, os, match = FALSE;
+
+      if (! leaf_is_free (o))
+        continue;
+
+      of = leaf_color_key (o, FALSE, &f);
+      os = leaf_color_key (o, TRUE,  &k);
+
+      switch (what)
+        {
+        case CHOPGIMP_VSAME_FILL:   match = of && f == kf; break;
+        case CHOPGIMP_VSAME_STROKE: match = os && k == ks; break;
+        case CHOPGIMP_VSAME_COLOR:
+          match = (hf && ((of && f == kf) || (os && k == kf))) ||
+                  (hs && ((of && f == ks) || (os && k == ks)));
+          break;
+        }
+
+      if (match)
+        g_ptr_array_add (objs, o);
+    }
+
+  g_list_free (leaves);
+
+  if (objs->len)
+    select_objects (layer, objs);
+
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_select_inverse (GimpVectorLayer *layer)
+{
+  GList     *leaves = chopgimp_vlayer_get_leaves (layer);
+  GPtrArray *objs   = g_ptr_array_new ();
+  GList     *sel    = chopgimp_vlayer_get_selected_objects (layer);
+  GHashTable *in    = g_hash_table_new (NULL, NULL);
+
+  /*  a selected group counts for all its leaves  */
+  for (GList *o = sel; o; o = o->next)
+    {
+      GList *ls = chopgimp_vobjects_leaves_of (o->data);
+
+      for (GList *l = ls; l; l = l->next)
+        g_hash_table_add (in, l->data);
+
+      g_list_free (ls);
+    }
+
+  for (GList *l = leaves; l; l = l->next)
+    if (leaf_is_free (l->data) && ! g_hash_table_contains (in, l->data))
+      g_ptr_array_add (objs, l->data);
+
+  select_objects (layer, objs);
+
+  g_hash_table_destroy (in);
+  g_list_free (sel);
+  g_list_free (leaves);
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gint
+chopgimp_vobjects_select_smaller (GimpVectorLayer *layer,
+                                  gdouble          area)
+{
+  GList     *leaves = chopgimp_vlayer_get_leaves (layer);
+  GPtrArray *objs   = g_ptr_array_new ();
+  gint       n;
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      gdouble          x1, y1, x2, y2;
+
+      if (leaf_is_free (o) &&
+          chopgimp_vobject_get_bounds (layer, o, TRUE, &x1, &y1, &x2, &y2) &&
+          (x2 - x1) * (y2 - y1) < area)
+        g_ptr_array_add (objs, o);
+    }
+
+  g_list_free (leaves);
+
+  n = objs->len;
+  select_objects (layer, objs);
+  g_ptr_array_free (objs, TRUE);
+
+  return n;
+}
+
+gint
+chopgimp_vobjects_delete_smaller (GimpVectorLayer *layer,
+                                  gdouble          area)
+{
+  gint n = chopgimp_vobjects_select_smaller (layer, area);
+
+  if (n > 0)
+    chopgimp_vobjects_delete_selection (layer);
+
+  return n;
+}
+
+gint
+chopgimp_vobjects_merge_same_color (GimpVectorLayer *layer)
+{
+  GimpImage  *image  = gimp_item_get_image (GIMP_ITEM (layer));
+  GHashTable *groups = g_hash_table_new_full (NULL, NULL, NULL,
+                                              (GDestroyNotify) g_ptr_array_unref);
+  GList      *leaves = chopgimp_vlayer_get_leaves (layer);
+  gint        before = g_list_length (leaves);
+  gint        after;
+  GHashTableIter iter;
+  gpointer    value;
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      guint32          k, ks;
+      GPtrArray       *arr;
+
+      /*  plain fill, no visible stroke: the union keeps the look  */
+      if (! leaf_is_free (o) || ! leaf_color_key (o, FALSE, &k) ||
+          leaf_color_key (o, TRUE, &ks))
+        continue;
+
+      arr = g_hash_table_lookup (groups, GUINT_TO_POINTER (k + 1));
+      if (! arr)
+        {
+          arr = g_ptr_array_new ();
+          g_hash_table_insert (groups, GUINT_TO_POINTER (k + 1), arr);
+        }
+      g_ptr_array_add (arr, GUINT_TO_POINTER (o->id));
+    }
+
+  g_list_free (leaves);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC,
+                               _("Fusionner les formes de même couleur"));
+
+  g_hash_table_iter_init (&iter, groups);
+  while (g_hash_table_iter_next (&iter, NULL, &value))
+    {
+      GPtrArray *arr = value;
+      guint     *ids;
+
+      if (arr->len < 2)
+        continue;
+
+      ids = g_new (guint, arr->len);
+      for (guint i = 0; i < arr->len; i++)
+        ids[i] = GPOINTER_TO_UINT (arr->pdata[i]);
+
+      chopgimp_vlayer_set_selection (layer, ids, arr->len);
+      g_free (ids);
+
+      chopgimp_vobjects_pathfinder (layer, CHOPGIMP_VPATHFINDER_UNION);
+    }
+
+  gimp_image_undo_group_end (image);
+  g_hash_table_destroy (groups);
+
+  after = chopgimp_vlayer_count_leaves (layer);
+
+  return MAX (0, before - after);
+}
+
+/*  ─── 4.1.1: the one object selection and what a style change edits ── */
+
+/*  the path objects a style change edits: the visible, unlocked leaves of
+ *  the selected objects (a group gives its leaves), each one once, bottom
+ *  first. Every style edit (bar, panels, colors, commands) goes through
+ *  this list: one source of truth.
+ */
+GList *
+chopgimp_vobjects_style_targets (GimpVectorLayer *layer)
+{
+  GList      *objs;
+  GList      *targets = NULL;
+  GHashTable *seen;
+
+  if (! layer || ! chopgimp_vlayer_get_root (layer))
+    return NULL;
+
+  objs = chopgimp_vlayer_get_selected_objects (layer);
+  seen = g_hash_table_new (NULL, NULL);
+
+  for (GList *o = objs; o; o = o->next)
+    {
+      GList *leaves = chopgimp_vobjects_leaves_of (o->data);
+
+      for (GList *l = leaves; l; l = l->next)
+        {
+          ChopGimpVObject *leaf = l->data;
+
+          if (leaf->kind != CHOPGIMP_VOBJECT_PATH        ||
+              ! chopgimp_vobject_is_visible (leaf)       ||
+              chopgimp_vobject_is_locked (leaf)          ||
+              g_hash_table_contains (seen, GUINT_TO_POINTER (leaf->id)))
+            continue;
+
+          g_hash_table_add (seen, GUINT_TO_POINTER (leaf->id));
+          targets = g_list_prepend (targets, leaf);
+        }
+
+      g_list_free (leaves);
+    }
+
+  g_hash_table_destroy (seen);
+  g_list_free (objs);
+
+  return g_list_reverse (targets);
+}
+
+/*  one undo step per modification: a burst of changes of the same kind
+ *  (a slider, the color dialog) on the same layer, with nothing else
+ *  pushed in between, is one step. TRUE when a step was pushed.
+ */
+gboolean
+chopgimp_vobjects_style_undo (GimpVectorLayer *layer,
+                              const gchar     *desc)
+{
+  static GimpVectorLayer *last_layer = NULL;
+  static GQuark           last_desc  = 0;
+  static gint64           last_time  = 0;
+  static gpointer         last_undo  = NULL;
+  GimpImage              *image      = gimp_item_get_image (GIMP_ITEM (layer));
+  GQuark                  q          = g_quark_from_string (desc ? desc : "");
+  gint64                  now        = g_get_monotonic_time ();
+  gpointer                top;
+
+  top = gimp_undo_stack_peek (gimp_image_get_undo_stack (image));
+
+  if (layer == last_layer && q == last_desc && top && top == last_undo &&
+      now - last_time < 700000)
+    {
+      last_time = now;
+      return FALSE;
+    }
+
+  chopgimp_vlayer_push_undo (layer, desc);
+
+  last_layer = layer;
+  last_desc  = q;
+  last_time  = now;
+  last_undo  = gimp_undo_stack_peek (gimp_image_get_undo_stack (image));
+
+  return TRUE;
+}
+
+static gboolean
+paint_has_color (const ChopGimpVEntry *e,
+                 GeglColor            *color)
+{
+  guint8 a[4], b[4];
+
+  if (! e || ! e->visible || e->paint.type != CHOPGIMP_PAINT_COLOR ||
+      ! e->paint.color || ! color)
+    return FALSE;
+
+  gegl_color_get_pixel (e->paint.color, babl_format ("R'G'B'A u8"), a);
+  gegl_color_get_pixel (color, babl_format ("R'G'B'A u8"), b);
+
+  return memcmp (a, b, 4) == 0;
+}
+
+gboolean
+chopgimp_vobjects_apply_color (GimpVectorLayer *layer,
+                               GeglColor       *color,
+                               gboolean         stroke,
+                               gboolean         push_undo)
+{
+  GList    *targets = chopgimp_vobjects_style_targets (layer);
+  gboolean  same    = targets != NULL;
+
+  if (! targets)
+    return FALSE;
+
+  /*  already this color everywhere (the foreground set from the
+   *  selection, a color picked twice): nothing to do, no undo step
+   */
+  for (GList *l = targets; l && same; l = l->next)
+    {
+      ChopGimpVObject *leaf = l->data;
+
+      same = paint_has_color (stroke ? chopgimp_vstyle_get_stroke (&leaf->style)
+                                     : chopgimp_vstyle_get_fill (&leaf->style),
+                              color);
+    }
+
+  if (same)
+    {
+      g_list_free (targets);
+      return TRUE;
+    }
+
+  if (push_undo)
+    chopgimp_vobjects_style_undo (layer, stroke ? _("Couleur du contour")
+                                                : _("Couleur du fond"));
+
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = targets; l; l = l->next)
+    {
+      ChopGimpVObject *leaf = l->data;
+      ChopGimpVStyle   st;
+      ChopGimpVEntry  *e;
+
+      chopgimp_vstyle_init (&st);
+      chopgimp_vstyle_copy (&st, &leaf->style);
+
+      e = stroke ? chopgimp_vstyle_ensure_stroke (&st)
+                 : chopgimp_vstyle_ensure_fill (&st);
+
+      if (color)
+        {
+          chopgimp_vpaint_set_color (&e->paint, color);
+          e->visible = TRUE;
+          if (stroke && e->width <= 0.0)
+            e->width = 1.0;
+        }
+      else
+        {
+          chopgimp_vpaint_clear (&e->paint);
+        }
+
+      chopgimp_vlayer_set_style (layer, leaf->id, &st, FALSE);
+      chopgimp_vstyle_clear (&st);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (targets);
+
+  return TRUE;
+}
+
+/*  the fill (@fill) or the stroke of a tool's options (shape, pen…) to
+ *  every target; one undo step per burst. FALSE when nothing is selected
+ *  (the options are then only those of the next object).
+ */
+gboolean
+chopgimp_vobjects_apply_tool_style (GimpVectorLayer   *layer,
+                                    gboolean           enable_fill,
+                                    GimpFillOptions   *fill_options,
+                                    gboolean           enable_stroke,
+                                    GimpStrokeOptions *stroke_options,
+                                    gboolean           fill)
+{
+  GList          *targets = chopgimp_vobjects_style_targets (layer);
+  ChopGimpVStyle  bar;
+
+  if (! targets)
+    return FALSE;
+
+  chopgimp_vobjects_style_from_tool (&bar, gimp_item_get_image (GIMP_ITEM (layer)),
+                                     enable_fill, fill_options,
+                                     enable_stroke, stroke_options);
+
+  chopgimp_vobjects_style_undo (layer, fill ? _("Fond des objets")
+                                            : _("Contour des objets"));
+
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = targets; l; l = l->next)
+    {
+      ChopGimpVObject *leaf = l->data;
+      ChopGimpVStyle   st, tmp;
+
+      /*  the fill (or the stroke) of the options, the rest of the object
+       *  (swapped: each style keeps owning its paints)
+       */
+      chopgimp_vstyle_init (&st);
+      chopgimp_vstyle_copy (&st, &leaf->style);
+      chopgimp_vstyle_init (&tmp);
+      chopgimp_vstyle_copy (&tmp, &bar);
+
+      if (fill)
+        chopgimp_vstyle_copy_primary_fill (&st, &tmp);
+      else
+        chopgimp_vstyle_copy_primary_stroke (&st, &tmp);
+
+      chopgimp_vstyle_clear (&tmp);
+
+      chopgimp_vlayer_set_style (layer, leaf->id, &st, FALSE);
+      chopgimp_vstyle_clear (&st);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+
+  chopgimp_vstyle_clear (&bar);
+  g_list_free (targets);
+
+  return TRUE;
+}
+
+/*  the style of the first target into a tool's options (the options bar
+ *  shows the selection); FALSE when nothing is selected
+ */
+gboolean
+chopgimp_vobjects_load_tool_style (GimpVectorLayer   *layer,
+                                   gboolean          *enable_fill,
+                                   GimpFillOptions   *fill_options,
+                                   gboolean          *enable_stroke,
+                                   GimpStrokeOptions *stroke_options)
+{
+  GList                  *targets = chopgimp_vobjects_style_targets (layer);
+  ChopGimpVObject        *leaf    = targets ? targets->data : NULL;
+  GimpVectorLayerOptions *tmp;
+
+  g_list_free (targets);
+
+  if (! leaf)
+    return FALSE;
+
+  tmp = g_object_new (GIMP_TYPE_VECTOR_LAYER_OPTIONS,
+                      "gimp", gimp_item_get_image (GIMP_ITEM (layer))->gimp,
+                      NULL);
+  chopgimp_vstyle_to_options (&leaf->style, tmp);
+
+  *enable_fill   = tmp->enable_fill;
+  *enable_stroke = tmp->enable_stroke;
+
+  if (fill_options)
+    gimp_config_sync (G_OBJECT (tmp->fill_options), G_OBJECT (fill_options), 0);
+  if (stroke_options)
+    gimp_config_sync (G_OBJECT (tmp->stroke_options), G_OBJECT (stroke_options), 0);
+
+  g_object_unref (tmp);
+
+  return TRUE;
+}
+
+/*  the colors of the first target: its plain fill and stroke colors
+ *  (owned by the object), NULL when not a plain color
+ */
+gboolean
+chopgimp_vobjects_selection_colors (GimpVectorLayer  *layer,
+                                    GeglColor       **fill,
+                                    GeglColor       **stroke)
+{
+  GList           *targets = chopgimp_vobjects_style_targets (layer);
+  ChopGimpVObject *leaf    = targets ? targets->data : NULL;
+  ChopGimpVEntry  *e;
+
+  g_list_free (targets);
+
+  *fill = *stroke = NULL;
+
+  if (! leaf)
+    return FALSE;
+
+  e = chopgimp_vstyle_get_fill (&leaf->style);
+  if (e && e->visible && e->paint.type == CHOPGIMP_PAINT_COLOR)
+    *fill = e->paint.color;
+
+  e = chopgimp_vstyle_get_stroke (&leaf->style);
+  if (e && e->visible && e->paint.type == CHOPGIMP_PAINT_COLOR && e->width > 0.0)
+    *stroke = e->paint.color;
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_swap_fill_stroke (GimpVectorLayer *layer)
+{
+  GList *objs = chopgimp_vlayer_get_selected_objects (layer);
+
+  if (! objs)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Permuter fond et contour"));
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *o = objs; o; o = o->next)
+    {
+      GList *leaves = chopgimp_vobjects_leaves_of (o->data);
+
+      for (GList *l = leaves; l; l = l->next)
+        {
+          ChopGimpVObject *leaf = l->data;
+          ChopGimpVStyle   st;
+          ChopGimpVEntry  *f, *k;
+          ChopGimpPaint    tmp;
+
+          if (leaf->kind != CHOPGIMP_VOBJECT_PATH || chopgimp_vobject_is_locked (leaf))
+            continue;
+
+          chopgimp_vstyle_init (&st);
+          chopgimp_vstyle_copy (&st, &leaf->style);
+
+          f = chopgimp_vstyle_ensure_fill (&st);
+          k = chopgimp_vstyle_ensure_stroke (&st);
+
+          tmp      = f->paint;
+          f->paint = k->paint;
+          k->paint = tmp;
+          f->visible = TRUE;
+          k->visible = TRUE;
+          if (k->paint.type != CHOPGIMP_PAINT_NONE && k->width <= 0.0)
+            k->width = 1.0;
+
+          chopgimp_vlayer_set_style (layer, leaf->id, &st, FALSE);
+          chopgimp_vstyle_clear (&st);
+        }
+
+      g_list_free (leaves);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (objs);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_select_next_under (GimpVectorLayer *layer,
+                                     gdouble          x,
+                                     gdouble          y,
+                                     gdouble          tolerance)
+{
+  ChopGimpVObject *cur = first_selected_leaf (layer);
+  GList           *leaves = chopgimp_vlayer_get_leaves (layer);   /* bottom → top */
+  GList           *under  = NULL;
+  GList           *l;
+  ChopGimpVObject *next   = NULL;
+
+  for (l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      gdouble          x1, y1, x2, y2;
+
+      if (leaf_is_free (o) &&
+          chopgimp_vobject_get_bounds (layer, o, TRUE, &x1, &y1, &x2, &y2) &&
+          x >= x1 - tolerance && x <= x2 + tolerance &&
+          y >= y1 - tolerance && y <= y2 + tolerance)
+        under = g_list_prepend (under, o);                       /* top → bottom */
+    }
+
+  g_list_free (leaves);
+
+  if (! under)
+    return FALSE;
+
+  l = cur ? g_list_find (under, cur) : NULL;
+  next = (l && l->next) ? l->next->data : under->data;
+
+  chopgimp_vlayer_set_selection (layer, &next->id, 1);
+  g_list_free (under);
+
+  return TRUE;
+}
+
+static gboolean
+others_set (GimpVectorLayer *layer,
+            gboolean         lock)
+{
+  GList      *leaves = chopgimp_vlayer_get_leaves (layer);
+  GList      *sel    = chopgimp_vlayer_get_selected_objects (layer);
+  GHashTable *in     = g_hash_table_new (NULL, NULL);
+
+  if (! sel)
+    {
+      g_list_free (leaves);
+      g_hash_table_destroy (in);
+      return FALSE;
+    }
+
+  for (GList *o = sel; o; o = o->next)
+    {
+      GList *ls = chopgimp_vobjects_leaves_of (o->data);
+
+      for (GList *l = ls; l; l = l->next)
+        g_hash_table_add (in, l->data);
+
+      g_list_free (ls);
+    }
+
+  chopgimp_vlayer_push_undo (layer, lock ? _("Verrouiller les autres objets")
+                                         : _("Masquer les autres objets"));
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      if (g_hash_table_contains (in, o))
+        continue;
+
+      chopgimp_vlayer_set_props (layer, o->id, NULL, -1.0, -1,
+                                 lock ? -1 : FALSE, lock ? TRUE : -1, FALSE);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+
+  g_hash_table_destroy (in);
+  g_list_free (sel);
+  g_list_free (leaves);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_lock_others (GimpVectorLayer *layer)
+{
+  return others_set (layer, TRUE);
+}
+
+gboolean
+chopgimp_vobjects_hide_others (GimpVectorLayer *layer)
+{
+  return others_set (layer, FALSE);
+}
+
+
+/*  the selected leaves, or all the free leaves when nothing is selected  */
+static GList *
+target_leaves (GimpVectorLayer *layer)
+{
+  GList *objs = chopgimp_vlayer_get_selected_objects (layer);
+  GList *out  = NULL;
+
+  if (! objs)
+    {
+      GList *all = chopgimp_vlayer_get_leaves (layer);
+
+      for (GList *l = all; l; l = l->next)
+        if (leaf_is_free (l->data))
+          out = g_list_prepend (out, l->data);
+
+      g_list_free (all);
+
+      return g_list_reverse (out);
+    }
+
+  for (GList *o = objs; o; o = o->next)
+    {
+      GList *ls = chopgimp_vobjects_leaves_of (o->data);
+
+      for (GList *l = ls; l; l = l->next)
+        if (leaf_is_free (l->data))
+          out = g_list_prepend (out, l->data);
+
+      g_list_free (ls);
+    }
+
+  g_list_free (objs);
+
+  return g_list_reverse (out);
+}
+
+gint
+chopgimp_vobjects_simplify (GimpVectorLayer *layer,
+                            gdouble          tolerance,
+                            gboolean         push_undo)
+{
+  GList *leaves = target_leaves (layer);
+  gint   n      = 0;
+
+  if (! leaves)
+    return 0;
+
+  if (push_undo)
+    chopgimp_vlayer_push_undo (layer, _("Simplifier"));
+
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      GimpPath        *simple;
+
+      if (! o->path)
+        continue;
+
+      simple = chopgimp_geom_simplify (o->path, MAX (tolerance, 0.01));
+
+      if (simple)
+        {
+          g_object_ref_sink (simple);
+          chopgimp_vlayer_set_path (layer, o->id, simple, FALSE);
+          g_object_unref (simple);
+          n++;
+        }
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (leaves);
+
+  return n;
+}
+
+/*  ─── 3.29.3: « Simplifier » with a live preview ───────────────────── */
+
+struct _ChopGimpVSimplify
+{
+  GimpVectorLayer *layer;    /* weak */
+  GArray          *ids;      /* guint */
+  GPtrArray       *orig;     /* GimpPath, local coordinates */
+  gint             n_nodes;
+  gboolean         changed;
+};
+
+static gint
+path_n_nodes (GimpPath *path)
+{
+  GimpStroke *stroke = NULL;
+  gint        n      = 0;
+
+  while ((stroke = gimp_path_stroke_get_next (path, stroke)))
+    for (GList *a = stroke->anchors->head; a; a = a->next)
+      if (((GimpAnchor *) a->data)->type == GIMP_ANCHOR_ANCHOR)
+        n++;
+
+  return n;
+}
+
+ChopGimpVSimplify *
+chopgimp_vsimplify_begin (GimpVectorLayer *layer)
+{
+  ChopGimpVSimplify *s;
+  GList             *leaves;
+
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), NULL);
+
+  leaves = target_leaves (layer);
+  if (! leaves)
+    return NULL;
+
+  s        = g_new0 (ChopGimpVSimplify, 1);
+  s->layer = layer;
+  s->ids   = g_array_new (FALSE, FALSE, sizeof (guint));
+  s->orig  = g_ptr_array_new_with_free_func (g_object_unref);
+  g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &s->layer);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      GimpPath        *copy;
+
+      if (! o->path)
+        continue;
+
+      copy = GIMP_PATH (gimp_item_duplicate (GIMP_ITEM (o->path),
+                                             G_TYPE_FROM_INSTANCE (o->path)));
+      g_object_ref_sink (copy);
+      g_array_append_val (s->ids, o->id);
+      g_ptr_array_add (s->orig, copy);
+      s->n_nodes += path_n_nodes (o->path);
+    }
+
+  g_list_free (leaves);
+
+  return s;
+}
+
+static void
+vsimplify_apply (ChopGimpVSimplify *s,
+                 gdouble            tolerance,
+                 gint              *n_after)
+{
+  chopgimp_vlayer_freeze (s->layer);
+
+  for (guint i = 0; i < s->ids->len; i++)
+    {
+      guint     id   = g_array_index (s->ids, guint, i);
+      GimpPath *orig = g_ptr_array_index (s->orig, i);
+      GimpPath *path = tolerance > 0.0 ? chopgimp_geom_simplify (orig, MAX (tolerance, 0.01))
+                                       : NULL;
+
+      if (path)
+        g_object_ref_sink (path);
+
+      if (n_after)
+        *n_after += path_n_nodes (path ? path : orig);
+
+      if (chopgimp_vlayer_get_object (s->layer, id))
+        chopgimp_vlayer_set_path (s->layer, id, path ? path : orig, FALSE);
+
+      if (path)
+        g_object_unref (path);
+    }
+
+  chopgimp_vlayer_thaw (s->layer);
+}
+
+gboolean
+chopgimp_vsimplify_preview (ChopGimpVSimplify *s,
+                            gdouble            tolerance,
+                            gint              *n_before,
+                            gint              *n_after)
+{
+  if (n_before) *n_before = s ? s->n_nodes : 0;
+  if (n_after)  *n_after  = 0;
+
+  if (! s || ! s->layer)
+    return FALSE;
+
+  vsimplify_apply (s, tolerance, n_after);
+  s->changed = TRUE;
+
+  return TRUE;
+}
+
+void
+chopgimp_vsimplify_end (ChopGimpVSimplify *s,
+                        gboolean           commit,
+                        gdouble            tolerance)
+{
+  if (! s)
+    return;
+
+  if (s->layer)
+    {
+      if (s->changed)
+        vsimplify_apply (s, 0.0, NULL);   /* the originals back */
+
+      if (commit)
+        {
+          chopgimp_vlayer_push_undo (s->layer, _("Simplifier"));
+          vsimplify_apply (s, tolerance, NULL);
+        }
+
+      g_object_remove_weak_pointer (G_OBJECT (s->layer), (gpointer *) &s->layer);
+    }
+
+  g_array_free (s->ids, TRUE);
+  g_ptr_array_free (s->orig, TRUE);
+  g_free (s);
+}
+
+
+/*  ─── 3.29.3: « Couleurs du dessin » ───────────────────────────────── */
+
+static gint
+color_use_cmp (gconstpointer a,
+               gconstpointer b)
+{
+  const ChopGimpVColorUse *x = a, *y = b;
+
+  if (x->count != y->count)
+    return y->count - x->count;
+
+  return x->key < y->key ? -1 : x->key > y->key;
+}
+
+GArray *
+chopgimp_vobjects_drawing_colors (GimpVectorLayer *layer)
+{
+  GHashTable *counts = g_hash_table_new (NULL, NULL);
+  GArray     *out    = g_array_new (FALSE, FALSE, sizeof (ChopGimpVColorUse));
+  GList      *leaves = chopgimp_vlayer_get_leaves (layer);
+  GHashTableIter iter;
+  gpointer    k, v;
+
+  for (GList *l = leaves; l; l = l->next)
+    for (gint stroke = 0; stroke < 2; stroke++)
+      {
+        guint32 key;
+
+        if (leaf_is_free (l->data) && leaf_color_key (l->data, stroke, &key))
+          {
+            gpointer kp = GUINT_TO_POINTER (key ^ 0x1);  /* never NULL */
+
+            g_hash_table_insert (counts, kp,
+                                 GINT_TO_POINTER (GPOINTER_TO_INT (g_hash_table_lookup (counts, kp)) + 1));
+          }
+      }
+
+  g_list_free (leaves);
+
+  g_hash_table_iter_init (&iter, counts);
+  while (g_hash_table_iter_next (&iter, &k, &v))
+    {
+      ChopGimpVColorUse use = { GPOINTER_TO_UINT (k) ^ 0x1, GPOINTER_TO_INT (v) };
+
+      g_array_append_val (out, use);
+    }
+
+  g_hash_table_destroy (counts);
+  g_array_sort (out, color_use_cmp);
+
+  return out;
+}
+
+gboolean
+chopgimp_vobjects_select_color_key (GimpVectorLayer *layer,
+                                    guint32          key)
+{
+  GPtrArray *objs   = g_ptr_array_new ();
+  GList     *leaves = chopgimp_vlayer_get_leaves (layer);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      guint32 f, k;
+
+      if (leaf_is_free (l->data) &&
+          ((leaf_color_key (l->data, FALSE, &f) && f == key) ||
+           (leaf_color_key (l->data, TRUE,  &k) && k == key)))
+        g_ptr_array_add (objs, l->data);
+    }
+
+  g_list_free (leaves);
+
+  if (objs->len)
+    select_objects (layer, objs);
+
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gint
+chopgimp_vobjects_replace_color_key (GimpVectorLayer *layer,
+                                     guint32          key,
+                                     GeglColor       *color)
+{
+  GList *leaves = chopgimp_vlayer_get_leaves (layer);
+  GList *hits   = NULL;
+  gint   n      = 0;
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      guint32 f, k;
+
+      if (leaf_is_free (l->data) &&
+          ((leaf_color_key (l->data, FALSE, &f) && f == key) ||
+           (leaf_color_key (l->data, TRUE,  &k) && k == key)))
+        hits = g_list_prepend (hits, l->data);
+    }
+
+  g_list_free (leaves);
+
+  if (! hits || ! color)
+    {
+      g_list_free (hits);
+      return 0;
+    }
+
+  chopgimp_vlayer_push_undo (layer, _("Couleurs du dessin"));
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = hits; l; l = l->next)
+    {
+      ChopGimpVObject *leaf = l->data;
+      ChopGimpVStyle   st;
+      guint32          kk;
+
+      chopgimp_vstyle_init (&st);
+      chopgimp_vstyle_copy (&st, &leaf->style);
+
+      for (gint stroke = 0; stroke < 2; stroke++)
+        if (leaf_color_key (leaf, stroke, &kk) && kk == key)
+          {
+            ChopGimpVEntry *e = stroke ? chopgimp_vstyle_get_stroke (&st)
+                                       : chopgimp_vstyle_get_fill (&st);
+
+            if (e)
+              chopgimp_vpaint_set_color (&e->paint, color);
+          }
+
+      chopgimp_vlayer_set_style (layer, leaf->id, &st, FALSE);
+      chopgimp_vstyle_clear (&st);
+      n++;
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (hits);
+
+  return n;
+}
+
+static gdouble
+stroke_box_area (GimpStroke *stroke)
+{
+  gdouble x1 = G_MAXDOUBLE, y1 = G_MAXDOUBLE, x2 = -G_MAXDOUBLE, y2 = -G_MAXDOUBLE;
+
+  for (GList *a = stroke->anchors->head; a; a = a->next)
+    {
+      GimpAnchor *anchor = a->data;
+
+      x1 = MIN (x1, anchor->position.x);  x2 = MAX (x2, anchor->position.x);
+      y1 = MIN (y1, anchor->position.y);  y2 = MAX (y2, anchor->position.y);
+    }
+
+  return (x2 > x1 && y2 > y1) ? (x2 - x1) * (y2 - y1) : 0.0;
+}
+
+gint
+chopgimp_vobjects_fill_holes (GimpVectorLayer *layer,
+                              gdouble          area)
+{
+  GimpImage *image  = gimp_item_get_image (GIMP_ITEM (layer));
+  GList     *leaves = target_leaves (layer);
+  gint       n      = 0;
+  gboolean   pushed = FALSE;
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o       = l->data;
+      GimpStroke      *stroke  = NULL;
+      GimpStroke      *largest = NULL;
+      gdouble          best    = -1.0;
+      gint             removed = 0;
+      GimpPath        *path;
+
+      if (! o->path)
+        continue;
+
+      while ((stroke = gimp_path_stroke_get_next (o->path, stroke)))
+        {
+          gdouble a = stroke_box_area (stroke);
+
+          if (a > best)
+            {
+              best    = a;
+              largest = stroke;
+            }
+        }
+
+      path = gimp_path_new (image, o->name ? o->name : "");
+      g_object_ref_sink (path);
+
+      while ((stroke = gimp_path_stroke_get_next (o->path, stroke)))
+        {
+          if (stroke != largest && stroke_box_area (stroke) < area)
+            {
+              removed++;
+              continue;
+            }
+
+          {
+            GimpStroke *copy = gimp_stroke_duplicate (stroke);
+
+            gimp_path_stroke_add (path, copy);
+            g_object_unref (copy);
+          }
+        }
+
+      if (removed > 0)
+        {
+          if (! pushed)
+            {
+              chopgimp_vlayer_push_undo (layer, _("Remplir les petits trous"));
+              chopgimp_vlayer_freeze (layer);
+              pushed = TRUE;
+            }
+
+          chopgimp_vlayer_set_path (layer, o->id, path, FALSE);
+          n += removed;
+        }
+
+      g_object_unref (path);
+    }
+
+  if (pushed)
+    chopgimp_vlayer_thaw (layer);
+
+  g_list_free (leaves);
+
+  return n;
+}
+
+
+gboolean
+chopgimp_vobjects_select_adjacent (GimpVectorLayer *layer,
+                                   gboolean         above)
+{
+  ChopGimpVObject *cur    = first_selected_leaf (layer);
+  GList           *leaves = chopgimp_vlayer_get_leaves (layer);   /* bottom → top */
+  GList           *free_  = NULL;
+  GList           *l;
+  ChopGimpVObject *next;
+
+  for (l = leaves; l; l = l->next)
+    if (leaf_is_free (l->data))
+      free_ = g_list_append (free_, l->data);
+
+  g_list_free (leaves);
+
+  if (! free_)
+    return FALSE;
+
+  l = cur ? g_list_find (free_, cur) : NULL;
+
+  if (above)
+    next = (l && l->next) ? l->next->data : free_->data;
+  else
+    next = (l && l->prev) ? l->prev->data : g_list_last (free_)->data;
+
+  chopgimp_vlayer_set_selection (layer, &next->id, 1);
+  g_list_free (free_);
+
+  return TRUE;
+}
+
+
+/*  ─── 4.2.0: copy / paste of objects ─────────────────────────────────── */
+
+static gchar   *vclip_xml   = NULL;
+static GObject *vclip_owner = NULL;    /* weak: the clipboard object */
+
+void
+chopgimp_vobjects_clipboard_copy (GimpVectorLayer *layer,
+                                  GObject         *clip)
+{
+  GList *objects;
+
+  g_clear_pointer (&vclip_xml, g_free);
+  if (vclip_owner)
+    g_object_remove_weak_pointer (vclip_owner, (gpointer *) &vclip_owner);
+  vclip_owner = NULL;
+
+  if (! layer || ! chopgimp_vobjects_enabled () || ! clip)
+    return;
+
+  objects = chopgimp_vlayer_get_selected_objects (layer);
+
+  if (objects)
+    {
+      vclip_xml   = chopgimp_vobjects_to_xml (objects);
+      vclip_owner = clip;
+      g_object_add_weak_pointer (vclip_owner, (gpointer *) &vclip_owner);
+    }
+
+  g_list_free (objects);
+}
+
+/*  the children of @root (taken) added to @layer as new objects, which
+ *  become the selection; their ids in @ids
+ */
+static gboolean
+vobjects_paste_root (GimpVectorLayer *layer,
+                     ChopGimpVObject *root,
+                     GArray          *ids)
+{
+  GimpImage *image = gimp_item_get_image (GIMP_ITEM (layer));
+
+  if (! root || ! root->children || root->children->len == 0)
+    {
+      if (root)
+        chopgimp_vobject_unref (root);
+      return FALSE;
+    }
+
+  chopgimp_vlayer_push_undo (layer, _("Coller les objets"));
+  chopgimp_vlayer_freeze (layer);
+
+  for (guint i = 0; i < root->children->len; i++)
+    {
+      ChopGimpVObject *copy = chopgimp_vobject_copy (g_ptr_array_index (root->children, i),
+                                                     image);
+
+      chopgimp_vlayer_insert (layer, copy, NULL, -1, FALSE);
+      g_array_append_val (ids, copy->id);
+      chopgimp_vobject_unref (copy);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  chopgimp_vobject_unref (root);
+
+  chopgimp_vlayer_set_selection (layer, (const guint *) ids->data, ids->len);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_clipboard_paste (GimpVectorLayer *layer,
+                                   GObject         *clip)
+{
+  GArray   *ids;
+  gboolean  done;
+
+  if (! layer || ! vclip_xml || ! vclip_owner || clip != vclip_owner ||
+      ! chopgimp_vobjects_enabled () || ! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  ids  = g_array_new (FALSE, FALSE, sizeof (guint));
+  done = vobjects_paste_root (layer,
+                              chopgimp_vobjects_from_xml (gimp_item_get_image (GIMP_ITEM (layer)),
+                                                          vclip_xml),
+                              ids);
+  g_array_free (ids, TRUE);
+
+  return done;
+}
+
+
+/*  ─── 4.2.1: SVG from Inkscape / Illustrator pasted as objects ───────── */
+
+gboolean
+chopgimp_vobjects_text_is_svg (const gchar *text)
+{
+  return text && strstr (text, "<svg") != NULL;
+}
+
+gboolean
+chopgimp_vobjects_paste_svg (GimpImage        *image,
+                             GimpContext      *context,
+                             const gchar      *svg,
+                             const gdouble    *center,
+                             GimpVectorLayer **pasted)
+{
+  GimpValueArray  *rv;
+  GimpVectorLayer *layer;
+  GError          *error = NULL;
+  gchar           *xml   = NULL;
+  GArray          *ids;
+  gboolean         done  = FALSE;
+
+  if (pasted)
+    *pasted = NULL;
+
+  if (! image || ! chopgimp_vobjects_enabled () ||
+      ! chopgimp_vobjects_text_is_svg (svg))
+    return FALSE;
+
+  /*  the SVG import of chopgimp_pdf.py: one object per shape. In a copy
+   *  of the context: a plug-in run changes the colors of the context it
+   *  is given, and a new foreground of the user context would recolor the
+   *  selected objects (vss_fg_changed)
+   */
+  {
+    GimpContext *tmp = gimp_context_new (image->gimp, "chopgimp-svg-paste", context);
+
+    rv = gimp_pdb_execute_procedure_by_name (image->gimp->pdb, tmp, NULL, &error,
+                                             "plug-in-chopgimp-svg-to-vobjects",
+                                             G_TYPE_STRING, svg,
+                                             G_TYPE_NONE);
+    g_object_unref (tmp);
+  }
+
+  if (g_value_get_enum (gimp_value_array_index (rv, 0)) == GIMP_PDB_SUCCESS &&
+      gimp_value_array_length (rv) > 1)
+    xml = g_value_dup_string (gimp_value_array_index (rv, 1));
+
+  gimp_value_array_unref (rv);
+  g_clear_error (&error);
+
+  if (! xml || ! *xml)
+    {
+      g_free (xml);
+      return FALSE;
+    }
+
+  ids   = g_array_new (FALSE, FALSE, sizeof (guint));
+  layer = chopgimp_vobjects_get_target_layer (image);
+
+  if (layer && ! chopgimp_vlayer_get_root (layer))
+    layer = NULL;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_LAYER_ADD, _("Coller le SVG"));
+
+  if (layer)
+    {
+      done = vobjects_paste_root (layer, chopgimp_vobjects_from_xml (image, xml), ids);
+    }
+  else
+    {
+      /*  no vector layer: a new one, above the selected layer  */
+      GimpPath   *path  = gimp_path_new (image, _("SVG collé"));
+      GimpCoords  c     = GIMP_COORDS_DEFAULT_VALUES;
+      GimpStroke *stroke;
+      GList      *sel   = gimp_image_get_selected_layers (image);
+      GimpLayer  *above = sel ? sel->data : NULL;
+
+      stroke = gimp_bezier_stroke_new_moveto (&c);
+      c.x = 1;
+      gimp_bezier_stroke_lineto (stroke, &c);
+      c.y = 1;
+      gimp_bezier_stroke_lineto (stroke, &c);
+      gimp_stroke_close (stroke);
+      gimp_path_stroke_add (path, stroke);
+      g_object_unref (stroke);
+
+      gimp_image_add_path (image, path, GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+
+      layer = gimp_vector_layer_new (image, path, context);
+      gimp_object_set_name (GIMP_OBJECT (layer), _("SVG collé"));
+      gimp_image_add_layer (image, GIMP_LAYER (layer),
+                            above ? gimp_layer_get_parent (above) : NULL,
+                            above ? gimp_item_get_index (GIMP_ITEM (above)) : 0,
+                            TRUE);
+
+      if (chopgimp_vlayer_set_xml (layer, xml, TRUE))
+        {
+          GList *list = g_list_prepend (NULL, layer);
+          gint   n    = 0;
+
+          gimp_image_set_selected_layers (image, list);
+          g_list_free (list);
+
+          chopgimp_vobjects_select_all (layer);
+          {
+            const guint *sel_ids = chopgimp_vlayer_get_selection (layer, &n);
+
+            g_array_append_vals (ids, sel_ids, n);
+          }
+          done = n > 0;
+        }
+      else
+        {
+          gimp_image_remove_layer (image, GIMP_LAYER (layer), TRUE, NULL);
+          gimp_image_remove_path (image, path, TRUE, NULL);
+          layer = NULL;
+        }
+    }
+
+  /*  Ctrl+V: centered (on the view, else on the image), as Illustrator;
+   *  « Coller sur place »: where they were in the SVG
+   */
+  if (done && center)
+    {
+      gdouble x1, y1, x2, y2;
+
+      if (chopgimp_vlayer_get_bounds (layer, (const guint *) ids->data, ids->len,
+                                      FALSE, &x1, &y1, &x2, &y2))
+        chopgimp_vlayer_translate (layer, (const guint *) ids->data, ids->len,
+                                   center[0] - (x1 + x2) / 2.0,
+                                   center[1] - (y1 + y2) / 2.0, FALSE);
+    }
+
+  gimp_image_undo_group_end (image);
+
+  g_array_free (ids, TRUE);
+  g_free (xml);
+
+  if (done && pasted)
+    *pasted = layer;
+
+  return done;
+}
