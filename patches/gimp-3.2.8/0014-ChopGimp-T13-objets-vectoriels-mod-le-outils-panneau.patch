+/*  ChopGimp 4.1.1: Tout sélectionner / Désélectionner act on the objects
+ *  of the active vector layer while a vector tool is active
+ */
+static gboolean
+select_objects_context (GimpImage *image)
+{
+  return (chopgimp_vobjects_get_target_layer (image) != NULL &&
+          chopgimp_tool_is_vector (gimp_context_get_tool (gimp_get_user_context (image->gimp))));
+}
+
+
 /*  public functions  */
 
 void
@@ -84,6 +104,16 @@ select_all_cmd_callback (GimpAction *action,
   GimpImage *image;
   return_if_no_image (image, data);
 
+  /*  ChopGimp 4.1.1 (Illustrator): with a vector tool on a vector layer,
+   *  Ctrl+A selects all its objects
+   */
+  if (select_objects_context (image))
+    {
+      chopgimp_vobjects_select_all (chopgimp_vobjects_get_target_layer (image));
+      gimp_image_flush (image);
+      return;
+    }
+
   gimp_channel_all (gimp_image_get_mask (image), TRUE);
   gimp_image_flush (image);
 }
@@ -96,6 +126,38 @@ select_none_cmd_callback (GimpAction *action,
   GimpImage *image;
   return_if_no_image (image, data);
 
+  /*  ChopGimp 3.29.0: Ctrl+D is « Désélectionner » (Photoshop); with no
+   *  pixel selection and objects selected in a vector layer after a move /
+   *  scale / rotation of objects, it is « Répéter la transformation »
+   *  (Illustrator)
+   */
+  if (gimp_channel_is_empty (gimp_image_get_mask (image)))
+    {
+      GimpVectorLayer *layer = chopgimp_vobjects_get_active_layer (image);
+
+      if (chopgimp_vtransform_can_repeat (layer) && chopgimp_vtransform_repeat (layer))
+        {
+          gimp_image_flush (image);
+          return;
+        }
+    }
+
+  /*  ChopGimp 4.1.1: with a vector tool, Ctrl+Maj+A / Ctrl+D deselect
+   *  the objects (no pixel selection)
+   */
+  if (gimp_channel_is_empty (gimp_image_get_mask (image)) &&
+      select_objects_context (image))
+    {
+      GimpVectorLayer *layer = chopgimp_vobjects_get_target_layer (image);
+
+      if (chopgimp_vobjects_n_selected (layer) > 0)
+        {
+          chopgimp_vlayer_set_selection (layer, NULL, 0);
+          gimp_image_flush (image);
+        }
+      return;
+    }
+
   gimp_channel_clear (gimp_image_get_mask (image), NULL, TRUE);
   gimp_image_flush (image);
 }
