+#pragma once
+
+
+typedef struct _ChopGimpVSel ChopGimpVSel;
+
+
+ChopGimpVSel * chopgimp_vsel_new            (GimpDrawTool      *tool);
+void           chopgimp_vsel_free           (ChopGimpVSel      *vsel);
+
+/*  TRUE: the Move tool works on objects in @image (its only selected
+ *  layer is a vector layer with several objects)
+ */
+gboolean       chopgimp_vsel_is_active      (ChopGimpVSel      *vsel,
+                                             GimpImage         *image);
+
+/*  TRUE when the event was used (the Move tool does nothing more)  */
+gboolean       chopgimp_vsel_button_press   (ChopGimpVSel      *vsel,
+                                             const GimpCoords  *coords,
+                                             guint32            time,
+                                             GdkModifierType    state,
+                                             GimpButtonPressType press_type,
+                                             GimpDisplay       *display,
+                                             gboolean           auto_select);
+gboolean       chopgimp_vsel_motion         (ChopGimpVSel      *vsel,
+                                             const GimpCoords  *coords,
+                                             GdkModifierType    state,
+                                             GimpDisplay       *display);
+gboolean       chopgimp_vsel_button_release (ChopGimpVSel      *vsel,
+                                             const GimpCoords  *coords,
+                                             GdkModifierType    state,
+                                             GimpButtonReleaseType release_type,
+                                             GimpDisplay       *display);
+gboolean       chopgimp_vsel_key_press      (ChopGimpVSel      *vsel,
+                                             GdkEventKey       *kevent,
+                                             GimpDisplay       *display);
+gboolean       chopgimp_vsel_oper_update    (ChopGimpVSel      *vsel,
+                                             const GimpCoords  *coords,
