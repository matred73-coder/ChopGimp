+    {
+      if (path_tool->vobj_layer != layer || ! path_tool->widget ||
+          ! path_tool->vobj_multi || tool->display != display)
+        {
+          if (! gimp_path_tool_vobj_edit_multi (path_tool, layer, NULL))
+            return TRUE;
+
+          gimp_image_flush (image);
+
+          if (! path_tool->widget)
+            return TRUE;
+        }
+
+      gimp_tool_widget_hover (path_tool->widget, coords, state, TRUE);
+
+      return FALSE;
+    }
+
+  /*  on the nodes of the edited object: the path widget  */
+  if (path_tool->vobj_layer == layer && path_tool->widget &&
+      tool->display == display &&
+      gimp_tool_widget_hit (path_tool->widget, coords, state, TRUE) != GIMP_HIT_NONE)
+    return FALSE;
+
+  leaf = chopgimp_vlayer_hit_test (layer, coords->x, coords->y,
+                                   3.0 / MAX (shell->scale_x, 1e-6),
+                                   CHOPGIMP_HIT_LEAF);
+
+  if (leaf)
+    path_tool->vobj_press_leaf = leaf->id;
+
+  /*  4.1.1 (Illustrator): Maj+clic on another object adds it: the nodes of
+   *  the selection and of this object are edited together
+   */
+  if (leaf && path_tool->vobj_press_shift && path_tool->vobj_prev_sel->len > 0 &&
+      ! chopgimp_vlayer_is_selected (layer, leaf->id))
+    {
+      GArray *only = g_array_copy (path_tool->vobj_prev_sel);
+
+      g_array_append_val (only, leaf->id);
+
+      if (gimp_path_tool_vobj_edit_multi (path_tool, layer, only))
+        {
+          chopgimp_vlayer_set_selection (layer, (const guint *) only->data, only->len);
+          gimp_image_flush (image);
+
+          if (path_tool->widget)
+            gimp_tool_widget_hover (path_tool->widget, coords, state, TRUE);
+        }
+
+      g_array_free (only, TRUE);
+
+      return FALSE;
+    }
+
+  if (leaf && (leaf->id != path_tool->vobj_id || path_tool->vobj_layer != layer ||
+               path_tool->vobj_multi))
+    {
+      gimp_path_tool_vobj_edit (path_tool, layer, leaf);
+      gimp_image_flush (image);
+
+      if (path_tool->widget)
+        gimp_tool_widget_hover (path_tool->widget, coords, state, TRUE);
+
+      return FALSE;   /* the press goes on to the nodes */
+    }
+
+  /*  in the void: a selection rectangle on the nodes of ALL the objects
+   *  of the layer (ChopGimp 3.28.3, Illustrator), never a new path
+   */
+  if (path_tool->vobj_layer != layer || ! path_tool->widget ||
+      ! path_tool->vobj_multi)
+    {
+      if (! gimp_path_tool_vobj_edit_multi (path_tool, layer, NULL))
+        return TRUE;
+
+      gimp_image_flush (image);
+
+      if (! path_tool->widget)
+        return TRUE;
+
+      gimp_tool_widget_hover (path_tool->widget, coords, state, TRUE);
+    }
+
+  return FALSE;
+}
