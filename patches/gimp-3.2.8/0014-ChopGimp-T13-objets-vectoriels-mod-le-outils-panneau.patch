+
+/*  ─── commands ──────────────────────────────────────────────────────── */
+
+static gboolean
+layer_mode_is_normal (GimpLayer *layer)
+{
+  return is_normal_mode (gimp_layer_get_mode (layer));
+}
+
+/*  removes a vector layer and its path (when no other layer uses it)  */
+static void
+remove_vector_layer (GimpImage       *image,
+                     GimpVectorLayer *layer)
+{
+  GimpPath *path = layer->options && layer->options->path
+                   ? g_object_ref (layer->options->path) : NULL;
+
+  gimp_image_remove_layer (image, GIMP_LAYER (layer), TRUE, NULL);
+
+  if (path)
+    {
+      if (gimp_item_is_attached (GIMP_ITEM (path)) &&
+          ! gimp_path_attached_to_vector_layer (path, image))
+        gimp_image_remove_path (image, path, TRUE, NULL);
+
+      g_object_unref (path);
+    }
+}
+
+GimpVectorLayer *
+chopgimp_vlayer_merge_layers (GimpImage   *image,
+                              GList       *layers,
+                              GimpContext *context)
+{
+  GList           *all;
+  GList           *order = NULL;
+  GList           *l;
+  GimpVectorLayer *target;
+  ChopGimpVObject *troot;
+  gint             pos   = 0;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  if (! chopgimp_vobjects_enabled ())
+    return NULL;
+
+  /*  the chosen vector layers, bottom → top  */
+  all = gimp_image_get_layer_list (image);
+
+  for (l = all; l; l = l->next)
+    if (g_list_find (layers, l->data) &&
+        GIMP_IS_VECTOR_LAYER (l->data) && layer_usable (l->data))
+      order = g_list_prepend (order, l->data);
+
+  g_list_free (all);
+
+  if (g_list_length (order) < 2)
+    {
+      g_list_free (order);
+      return NULL;
+    }
+
+  target = g_list_last (order)->data;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_IMAGE_LAYERS_MERGE,
+                               "Fusionner en un calque vectoriel");
+
+  troot = chopgimp_vlayer_get_root (target);
+
+  if (! troot)
+    {
+      gimp_image_undo_group_end (image);
+      g_list_free (order);
+      return NULL;
+    }
+
+  chopgimp_vlayer_push_undo (target, "Fusionner en un calque vectoriel");
+  target->vobjects->legacy = FALSE;
+  chopgimp_vlayer_freeze (target);
+
+  /*  the topmost layer's own opacity and mode go to its objects  */
+  if (gimp_layer_get_opacity (GIMP_LAYER (target)) < 1.0 ||
+      ! layer_mode_is_normal (GIMP_LAYER (target)))
+    {
+      ChopGimpVObject *g = chopgimp_vobject_new_group (gimp_object_get_name (target));
+
+      while (troot->children->len > 0)
+        insert_child (g, g_ptr_array_steal_index (troot->children, 0), -1);
+
+      g->opacity = gimp_layer_get_opacity (GIMP_LAYER (target));
+      g->mode    = gimp_layer_get_mode (GIMP_LAYER (target));
+      insert_child (troot, g, -1);
+      assign_ids (target->vobjects, g);
+
+      gimp_layer_set_opacity (GIMP_LAYER (target), 1.0, TRUE);
+      gimp_layer_set_mode (GIMP_LAYER (target), GIMP_LAYER_MODE_NORMAL, TRUE);
+    }
+
+  for (l = order; l && l->data != target; l = l->next)
+    {
+      GimpVectorLayer *src   = l->data;
+      ChopGimpVObject *sroot = chopgimp_vlayer_get_root (src);
+      ChopGimpVObject *obj;
+      gdouble          opacity = gimp_layer_get_opacity (GIMP_LAYER (src));
+      GimpLayerMode    mode    = gimp_layer_get_mode (GIMP_LAYER (src));
+      gboolean         visible = gimp_item_get_visible (GIMP_ITEM (src));
+
+      if (! sroot)
+        continue;
+
+      if (sroot->children->len == 1)
+        {
+          obj = chopgimp_vobject_copy (g_ptr_array_index (sroot->children, 0), image);
+
+          if (obj->kind == CHOPGIMP_VOBJECT_PATH)
+            {
+              g_free (obj->name);
+              obj->name = g_strdup (gimp_object_get_name (src));
+            }
+
+          obj->opacity *= opacity;
+
+          if (! is_normal_mode (mode) && is_normal_mode (obj->mode))
+            obj->mode = mode;
+        }
+      else
+        {
+          obj = chopgimp_vobject_copy (sroot, image);
+          g_free (obj->name);
+          obj->name    = g_strdup (gimp_object_get_name (src));
+          obj->opacity = opacity;
+          obj->mode    = mode;
+          obj->id      = 0;
+        }
+
+      obj->visible = obj->visible && visible;
+
+      insert_child (troot, obj, pos++);
+      assign_ids (target->vobjects, obj);
+    }
+
+  vobj_invalidate (troot);
+  vlayer_commit (target, CHANGE_STRUCTURE, NULL);
+  chopgimp_vlayer_thaw (target);
+
+  for (l = order; l && l->data != target; l = l->next)
+    remove_vector_layer (image, l->data);
+
+  {
+    GList *sel = g_list_prepend (NULL, target);
+
+    gimp_image_set_selected_layers (image, sel);
+    g_list_free (sel);
+  }
+
+  gimp_image_undo_group_end (image);
+
+  g_list_free (order);
+
+  return target;
+}
+
+static void
+split_items (ChopGimpVObject  *root,
+             GPtrArray        *items)
+{
+  if (root->children->len == 1)
+    {
+      ChopGimpVObject *only = g_ptr_array_index (root->children, 0);
+
+      if (only->kind == CHOPGIMP_VOBJECT_GROUP && only->children->len >= 2)
+        {
+          for (guint i = 0; i < only->children->len; i++)
+            g_ptr_array_add (items, g_ptr_array_index (only->children, i));
+          return;
+        }
+    }
+
+  for (guint i = 0; i < root->children->len; i++)
+    g_ptr_array_add (items, g_ptr_array_index (root->children, i));
+}
+
+gboolean
+chopgimp_vlayer_can_split (GimpVectorLayer *layer)
+{
+  GPtrArray *items;
+  gboolean   ok;
+
+  if (! chopgimp_vobjects_enabled () || ! layer_usable (layer) ||
+      ! layer->vobjects || layer->vobjects->legacy)
+    return FALSE;
+
+  items = g_ptr_array_new ();
+  split_items (layer->vobjects->root, items);
+  ok = items->len >= 2;
+  g_ptr_array_free (items, TRUE);
+
+  return ok;
+}
+
+GList *
+chopgimp_vlayer_split_to_layers (GimpVectorLayer *layer,
+                                 GimpContext     *context)
+{
+  GimpImage *image;
+  GimpLayer *parent;
+  GPtrArray *items;
+  GList     *result = NULL;
+  gint       position;
+
+  if (! chopgimp_vlayer_can_split (layer))
+    return NULL;
+
+  image    = gimp_item_get_image (GIMP_ITEM (layer));
+  parent   = gimp_layer_get_parent (GIMP_LAYER (layer));
+  position = gimp_item_get_index (GIMP_ITEM (layer));
+  items    = g_ptr_array_new ();
+
+  vlayer_check_layer_lpe (layer);
+  split_items (layer->vobjects->root, items);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_LAYER_ADD,
+                               "Dissocier en calques");
+
+  for (guint i = 0; i < items->len; i++)
+    {
+      ChopGimpVObject *item = items->pdata[i];
+      const gchar     *name = (item->name && *item->name) ? item->name
+                                                          : gimp_object_get_name (layer);
+      GimpPath        *wpath;
+      GimpVectorLayer *nl;
+      ChopGimpVObject *copy;
+      ChopGimpVLayer  *vl;
+      GimpMatrix3      wm;
+      gdouble          opacity = 1.0;
+      gboolean         visible = TRUE;
+      ChopGimpVObject *p;
+
+      wpath = chopgimp_vobject_get_world_path (layer, item, FALSE);
+      gimp_object_set_name (GIMP_OBJECT (wpath), name);
+      gimp_image_add_path (image, wpath, GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+
+      /*  the image owns @wpath now (it was floating)  */
+      nl = gimp_vector_layer_new (image, wpath, context);
+
+      gimp_object_set_name (GIMP_OBJECT (nl), name);
+
+      /*  the object in its new layer, where it was in the image  */
+      copy = chopgimp_vobject_copy (item, image);
+      chopgimp_vobject_get_world_matrix (item, &wm);
+      copy->transform = wm;
+
+      for (p = item->parent; p; p = p->parent)
+        {
+          opacity *= p->opacity;
+          visible  = visible && p->visible;
+        }
+
+      copy->opacity *= opacity;
+
+      vl = vlayer_new ();
+      insert_child (vl->root, copy, -1);
+      assign_ids (vl, copy);
+      vl->legacy  = FALSE;
+      nl->vobjects = vl;
+
+      vlayer_write_legacy (nl, TRUE, TRUE);
+
+      gimp_layer_set_opacity (GIMP_LAYER (nl),
+                              gimp_layer_get_opacity (GIMP_LAYER (layer)), FALSE);
+      gimp_layer_set_mode (GIMP_LAYER (nl),
+                           gimp_layer_get_mode (GIMP_LAYER (layer)), FALSE);
+      gimp_item_set_visible (GIMP_ITEM (nl),
+                             visible && gimp_item_get_visible (GIMP_ITEM (layer)),
+                             FALSE);
+
+      gimp_image_add_layer (image, GIMP_LAYER (nl), parent, position, TRUE);
+
+      result = g_list_prepend (result, nl);
+    }
+
+  g_ptr_array_free (items, TRUE);
+
+  remove_vector_layer (image, layer);
+
+  gimp_image_set_selected_layers (image, result);
+
+  gimp_image_undo_group_end (image);
+
+  return result;
+}
+
+static void
+decompose_targets (GimpVectorLayer *layer,
+                   GPtrArray       *targets)
+{
+  ChopGimpVLayer *vl   = layer->vobjects;
+  GList          *from = NULL;
+
+  for (guint i = 0; i < vl->selection->len; i++)
+    {
+      ChopGimpVObject *o = g_hash_table_lookup (vl->by_id,
+                                                GUINT_TO_POINTER (g_array_index (vl->selection,
+                                                                                 guint, i)));
+      if (o)
+        from = g_list_concat (from, chopgimp_vobjects_leaves_of (o));
+    }
+
+  if (! from)
+    from = chopgimp_vobjects_leaves_of (vl->root);
+
+  for (GList *l = from; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      if (! o->locked && gimp_path_get_n_strokes (o->path) >= 2 &&
+          ! g_ptr_array_find (targets, o, NULL))
+        g_ptr_array_add (targets, o);
+    }
+
+  g_list_free (from);
+}
+
+gboolean
+chopgimp_vlayer_can_decompose (GimpVectorLayer *layer)
+{
+  GPtrArray *targets;
+  gboolean   ok;
+
+  if (! chopgimp_vobjects_enabled () || ! layer_usable (layer) || ! layer->options ||
+      ! layer->options->path)
+    return FALSE;
+
+  if (! layer->vobjects)
+    return gimp_path_get_n_strokes (layer->options->path) >= 2;
+
+  targets = g_ptr_array_new ();
+  decompose_targets (layer, targets);
+  ok = targets->len > 0;
+  g_ptr_array_free (targets, TRUE);
+
+  return ok;
+}
+
+gint
+chopgimp_vlayer_decompose (GimpVectorLayer *layer,
+                           gboolean         push_undo)
+{
+  GimpImage *image;
+  GPtrArray *targets;
+  GArray    *new_ids;
+  gint       n_new = 0;
+
+  if (! chopgimp_vlayer_get_root (layer))
+    return 0;
+
+  image   = gimp_item_get_image (GIMP_ITEM (layer));
+  targets = g_ptr_array_new ();
+  new_ids = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  decompose_targets (layer, targets);
+
+  for (guint t = 0; t < targets->len; t++)
+    {
+      ChopGimpVObject  *o = targets->pdata[t];
+      gint              n = 0;
+      gint             *owner = chopgimp_geom_stroke_islands (o->path, &n);
+      GPtrArray        *strokes = g_ptr_array_new ();
+      GimpStroke       *s;
+      ChopGimpVObject  *parent;
+      gint              index;
+      gint              k = 0;
+      gint              n_islands = 0;
+
+      for (s = gimp_path_stroke_get_next (o->path, NULL); s;
+           s = gimp_path_stroke_get_next (o->path, s))
+        g_ptr_array_add (strokes, s);
+
+      for (gint i = 0; i < n; i++)
+        if (owner[i] == i)
+          n_islands++;
+
+      if (n_islands < 2 || (guint) n != strokes->len)
+        {
+          g_free (owner);
+          g_ptr_array_free (strokes, TRUE);
+          continue;
+        }
+
+      if (n_new == 0 &&
+          ! vlayer_begin (layer, "Décomposer les sous-tracés en objets", push_undo))
+        {
+          g_free (owner);
+          g_ptr_array_free (strokes, TRUE);
+          break;
+        }
+
+      parent = o->parent;
+      index  = chopgimp_vobject_get_index (o);
+
+      for (gint i = 0; i < n; i++)
+        {
+          ChopGimpVObject *piece;
+          gchar           *name;
+
+          if (owner[i] != i)
+            continue;
+
+          name  = g_strdup_printf ("%s %d", (o->name && *o->name) ? o->name : "Objet",
+                                   ++k);
+          piece = chopgimp_vobject_new_path (image, NULL, name, &o->style);
+          g_free (name);
+
+          piece->transform = o->transform;
+          piece->opacity   = o->opacity;
+          piece->mode      = o->mode;
+          piece->visible   = o->visible;
+          piece->lpe       = g_strdup (o->lpe);
+
+          gimp_path_freeze (piece->path);
+
+          for (gint j = 0; j < n; j++)
+            if (owner[j] == i)
+              {
+                GimpStroke *d = gimp_stroke_duplicate (strokes->pdata[j]);
+
+                gimp_path_stroke_add (piece->path, d);
+                g_object_unref (d);
+              }
+
+          gimp_path_thaw (piece->path);
+
+          insert_child (parent, piece, index + k - 1);
+          assign_ids (layer->vobjects, piece);
+          g_array_append_val (new_ids, piece->id);
+          n_new++;
+        }
+
+      chopgimp_vobject_unref (detach_child (o));
+
+      g_free (owner);
+      g_ptr_array_free (strokes, TRUE);
+    }
+
+  g_ptr_array_free (targets, TRUE);
+
+  if (n_new > 0)
+    {
+      ChopGimpVLayer *vl = layer->vobjects;
+
+      vlayer_commit (layer, CHANGE_STRUCTURE, NULL);
+
+      g_array_set_size (vl->selection, 0);
+      g_array_append_vals (vl->selection, new_ids->data, new_ids->len);
+      g_signal_emit_by_name (layer, "object-selection-changed");
+    }
+
+  g_array_free (new_ids, TRUE);
+
+  return n_new;
+}
+
+
+gint
+chopgimp_vlayer_split_new (GimpVectorLayer *layer)
+{
+  gint n;
+
+  if (! chopgimp_vobjects_enabled () || ! layer_usable (layer) ||
+      ! layer->options || ! layer->options->path ||
+      gimp_path_get_n_strokes (layer->options->path) < 2)
+    return 0;
+
+  /*  never edited as objects: object #1 is the layer itself  */
+  if (layer->vobjects && ! layer->vobjects->legacy)
+    return 0;
+
+  if (! vlayer_ensure (layer))
+    return 0;
+
+  /*  the fill / stroke set just after the creation  */
+  vlayer_style_from_options (layer);
+  g_array_set_size (layer->vobjects->selection, 0);
+
+  n = chopgimp_vlayer_decompose (layer, FALSE);
+
+  if (n > 0)
+    chopgimp_vlayer_set_selection (layer, NULL, 0);
+
+  return n;
+}
+
+
+/*  ─── gimpvectorlayer.c and XCF hooks ───────────────────────────────── */
+
+gint64
+chopgimp_vlayer_get_memsize (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl   = layer->vobjects;
+  gint64          size = 0;
+  GList          *leaves;
+
+  if (! vl)
+    return 0;
+
+  leaves = chopgimp_vobjects_leaves_of (vl->root);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      size += sizeof (ChopGimpVObject) +
+              gimp_object_get_memsize (GIMP_OBJECT (o->path), NULL);
+
+      if (o->cache)
+        size += (gint64) cairo_image_surface_get_stride (o->cache) *
+                cairo_image_surface_get_height (o->cache);
+    }
+
+  g_list_free (leaves);
+
+  return size;
+}
+
+/*  ─── global colors ─────────────────────────────────────────────────── */
+
+gboolean
+chopgimp_vlayer_update_global_color (GimpVectorLayer *layer,
+                                     const gchar     *id)
+{
+  ChopGimpVLayer *vl;
+  GList          *changed = NULL;
+  GeglRectangle   r;
+  gboolean        any = FALSE;
+
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), FALSE);
+
+  if (! chopgimp_vobjects_enabled () || ! (vl = layer->vobjects))
+    return FALSE;
+
+  /*  the old area of the changed leaves (their bounds do not change:
+   *  only colors), then the new one
+   */
+  if (vobj_resolve_globals (vl->root, gimp_item_get_image (GIMP_ITEM (layer)),
+                            id, &changed) == 0)
+    return FALSE;
+
+  for (GList *l = changed; l; l = l->next)
+    dirty_of (layer, l->data, &r, &any);
+
+  g_list_free (changed);
+
+  /*  a never edited layer has no global color: nothing to do for GIMP's
+   *  renderer; else the objects are drawn again (no undo step)
+   */
+  vlayer_commit (layer, CHANGE_STYLE, any ? &r : NULL);
+
+  return TRUE;
+}
+
+gint
+chopgimp_vlayer_count_global_users (GimpVectorLayer *layer,
+                                    const gchar     *id)
+{
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), 0);
+
+  if (! chopgimp_vobjects_enabled () || ! layer->vobjects)
+    return 0;
+
+  return vobj_count_global_users (layer->vobjects->root, id);
+}
+
+
+/*  the map of the legacy path after a load or a copy: by position  */
+static void
+vlayer_map_by_position (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl     = layer->vobjects;
+  GList          *leaves = chopgimp_vobjects_leaves_of (vl->root);
+
+  g_hash_table_remove_all (vl->stroke_map);
+  vl->mapped = 0;
+  vlayer_push_layout (vl, layout_of_leaves (leaves));
+  g_list_free (leaves);
+}
+
+void
+chopgimp_vlayer_duplicate (GimpVectorLayer *src,
+                           GimpVectorLayer *dest)
+{
+  gchar *xml;
+
+  if (! src->vobjects || ! dest->options)
+    return;
+
+  xml = vlayer_serialize (src, TRUE);
+
+  chopgimp_vlayer_free (dest->vobjects);
+  dest->vobjects = vlayer_parse (gimp_item_get_image (GIMP_ITEM (dest)), xml,
+                                 strlen (xml), NULL);
+  g_free (xml);
+
+  if (dest->vobjects)
+    {
+      ChopGimpVLayer *vl = dest->vobjects;
+
+      vl->legacy = src->vobjects->legacy;
+      g_array_set_size (vl->selection, 0);
+      vl->entered = 0;
+
+      /*  the copied options are those of the objects: the next rendering
+       *  must not take them for an outside change of object #1
+       */
+      g_free (vl->opt_sig);
+      vl->opt_sig = options_sig (dest->options);
+
+      vlayer_map_by_position (dest);
+    }
+}
+
+void
+chopgimp_vlayer_convert (GimpVectorLayer *layer,
+                         GimpImage       *dest_image)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+  ChopGimpVLayer *nvl;
+  gchar          *xml;
+
+  if (! vl)
+    return;
+
+  xml = vlayer_serialize (layer, TRUE);
+  nvl = vlayer_parse (dest_image, xml, strlen (xml), NULL);
+  g_free (xml);
+
+  if (nvl)
+    {
+      nvl->legacy = vl->legacy;
+
+      if (layer->options)
+        {
+          g_free (nvl->opt_sig);
+          nvl->opt_sig = options_sig (layer->options);
+        }
+
+      layer->vobjects = nvl;
+      chopgimp_vlayer_free (vl);
+      vlayer_map_by_position (layer);
+    }
+}
+
+void
+chopgimp_vlayer_xcf_save_prepare (GimpVectorLayer *layer)
+{
+  GimpParasiteList *parasites;
+  GimpParasite     *parasite;
+  gchar            *xml;
+
+  if (! chopgimp_vobjects_enabled ())
+    return;
+
+  vlayer_flush_legacy (layer);   /* 3.29.6 */
+
+  parasites = gimp_item_get_parasites (GIMP_ITEM (layer));
+
+  if (! layer->vobjects || layer->vobjects->legacy)
+    {
+      if (gimp_parasite_list_find (parasites, PARASITE_NAME))
+        gimp_parasite_list_remove (parasites, PARASITE_NAME);
+      return;
+    }
+
+  /*  the legacy fill / stroke as saved, to notice changes made elsewhere  */
+  if (layer->options)
+    {
+      g_free (layer->vobjects->opt_sig);
+      layer->vobjects->opt_sig = options_sig (layer->options);
+    }
+
+  /*  3.28.2: with the state, so the selected objects come back with
+   *  the file (« legacy » / « entered » are reset by the loader)
+   */
+  xml      = vlayer_serialize (layer, TRUE);
+  parasite = gimp_parasite_new (PARASITE_NAME, GIMP_PARASITE_PERSISTENT,
+                                strlen (xml) + 1, xml);
+  gimp_parasite_list_add (parasites, parasite);
+  gimp_parasite_free (parasite);
+  g_free (xml);
+}
+
+void
+chopgimp_vlayer_xcf_load (GimpVectorLayer *layer)
+{
+  const GimpParasite *parasite;
+  const gchar        *data;
+  guint32             size = 0;
+  ChopGimpVLayer     *vl;
+  gchar              *saved_sig;
+
+  if (! chopgimp_vobjects_enabled () || ! layer->options || ! layer->options->path)
+    return;
+
+  parasite = gimp_item_parasite_find (GIMP_ITEM (layer), PARASITE_NAME);
+  if (! parasite)
+    return;
+
+  data = gimp_parasite_get_data (parasite, &size);
+  if (! data || size == 0)
+    return;
+
+  if (data[size - 1] == '\0')
+    size--;
+
+  vl = vlayer_parse (gimp_item_get_image (GIMP_ITEM (layer)), data, size, NULL);
+  if (! vl)
+    return;
+
+  vl->legacy = FALSE;
+  vl->entered = 0;   /*  3.28.2: the selection is kept (checked below)  */
+
+  chopgimp_vlayer_free (layer->vobjects);
+  layer->vobjects = vl;
+
+  /*  the legacy path may have been edited by a GIMP without objects:
+   *  its sub-paths go back to the objects
+   */
+  vlayer_map_by_position (layer);
+  vlayer_pull_legacy_path (layer);
+
+  saved_sig   = vl->opt_sig;
+  vl->opt_sig = NULL;
+
+  if (saved_sig)
+    {
+      vl->opt_sig = saved_sig;
+      vlayer_style_from_options (layer);
+    }
+  else
+    {
+      vl->opt_sig = options_sig (layer->options);
+    }
+
+  /*  3.28.2: only ids of this file  */
+  for (gint i = (gint) vl->selection->len - 1; i >= 0; i--)
+    if (! g_hash_table_contains (vl->by_id,
+                                 GUINT_TO_POINTER (g_array_index (vl->selection, guint, i))))
+      g_array_remove_index (vl->selection, i);
+
+  if (layer_usable (layer))
+    vlayer_render_region (layer, NULL);
+}
+
+
+/*  ─── the object tree as XML, for scripts and plug-ins (3.27.2, lot V4) ─ */
+
+gchar *
+chopgimp_vlayer_get_xml (GimpVectorLayer *layer)
+{
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), NULL);
+
+  if (! chopgimp_vlayer_get_root (layer))
+    return NULL;
+
+  return vlayer_serialize (layer, FALSE);
+}
+
+gboolean
+chopgimp_vlayer_set_xml (GimpVectorLayer *layer,
+                         const gchar     *xml,
+                         gboolean         push_undo)
+{
+  ChopGimpVLayer  *nvl;
+  ChopGimpVLayer  *vl;
+  ChopGimpVObject *root;
+
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), FALSE);
+  g_return_val_if_fail (xml != NULL, FALSE);
+
+  if (! layer_usable (layer))
+    return FALSE;
+
+  /*  whatever the version, the parser of the parasite reads it  */
+  nvl = vlayer_parse (gimp_item_get_image (GIMP_ITEM (layer)), xml,
+                      strlen (xml), NULL);
+  if (! nvl)
+    return FALSE;
+
+  if (! vlayer_begin (layer, "Remplacer les objets", push_undo))
+    {
+      chopgimp_vlayer_free (nvl);
+      return FALSE;
+    }
+
+  vl   = layer->vobjects;
+  root = vl->root;
+
+  while (root->children->len > 0)
+    chopgimp_vobject_unref (detach_child (g_ptr_array_index (root->children,
+                                                             root->children->len - 1)));
+
+  vlayer_reindex (vl);   /*  the root only: the ids of @xml are kept  */
+
+  root->transform = nvl->root->transform;
+  root->opacity   = nvl->root->opacity;
+  root->mode      = nvl->root->mode;
+  root->visible   = nvl->root->visible;
+  root->clip      = nvl->root->clip;
+
+  while (nvl->root->children->len > 0)
+    {
+      ChopGimpVObject *o = detach_child (g_ptr_array_index (nvl->root->children, 0));
+
+      insert_child (root, o, -1);
+      assign_ids (vl, o);
+      vobj_invalidate (o);
+    }
+
+  vl->next_id = MAX (vl->next_id, nvl->next_id);
+  g_array_set_size (vl->selection, 0);
+  vl->entered = 0;
+
+  chopgimp_vlayer_free (nvl);
+
+  vobj_invalidate (root);
+  vlayer_commit (layer, CHANGE_ALL, NULL);
+  g_signal_emit_by_name (layer, "object-selection-changed");
+
+  return TRUE;
+}
+
+
+/*  ─── 3.27.7: helpers for live paint and symbols ────────────────────── */
+
+void
+chopgimp_vpath_transform (GimpPath          *path,
+                          const GimpMatrix3 *matrix)
+{
+  g_return_if_fail (GIMP_IS_PATH (path) && matrix != NULL);
+
+  path_transform (path, matrix);
+}
+
+gchar *
+chopgimp_vpath_to_d (GimpPath *path)
+{
+  g_return_val_if_fail (GIMP_IS_PATH (path), NULL);
+
+  return path_to_d (path);
+}
+
+gchar *
+chopgimp_vobjects_to_xml (GList *objects)
+{
+  GString *s = g_string_new ("<chopgimp-vobjects version=\"2\" next-id=\"1\">\n"
+                             "<group id=\"0\" name=\"\">\n");
+
+  for (GList *l = objects; l; l = l->next)
+    write_object (s, l->data, TRUE);
+
+  g_string_append (s, "</group>\n</chopgimp-vobjects>\n");
+
+  return g_string_free (s, FALSE);
+}
+
+ChopGimpVObject *
+chopgimp_vobjects_from_xml (GimpImage   *image,
+                            const gchar *xml)
+{
+  ChopGimpVLayer  *vl;
+  ChopGimpVObject *root;
+
+  if (! xml || ! GIMP_IS_IMAGE (image))
+    return NULL;
+
+  vl = vlayer_parse (image, xml, strlen (xml), NULL);
+
+  if (! vl)
+    return NULL;
+
+  root = chopgimp_vobject_ref (vl->root);
+  chopgimp_vlayer_free (vl);
+
+  return root;
+}
+
+void
+chopgimp_vlayer_subtree_changed (GimpVectorLayer *layer,
+                                 ChopGimpVObject *object,
+                                 const gchar     *undo_desc)
+{
+  ChopGimpVLayer *vl;
+
+  if (! layer_usable (layer) || ! (vl = vlayer_ensure (layer)))
+    return;
+
+  if (undo_desc)
+    chopgimp_vlayer_push_undo (layer, undo_desc);
+
+  vl->legacy = FALSE;
+  vlayer_reindex (vl);
+  vlayer_assign_missing_ids (vl, vl->root);
+  vobj_invalidate (object ? object : vl->root);
+
+  vlayer_commit (layer, CHANGE_ALL, NULL);
+}
+
+/*  the image-space box of the leaves of a tree that is not in a layer
+ *  (control points, strokes ignored); FALSE when empty
+ */
+static void
+preview_bounds_rec (ChopGimpVObject *o,
+                    gdouble          b[4],
+                    gboolean        *any)
+{
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    {
+      GimpMatrix3  m;
+      GimpStroke  *stroke = NULL;
+
+      if (! o->path)
+        return;
+
+      chopgimp_vobject_get_world_matrix (o, &m);
+
+      while ((stroke = gimp_path_stroke_get_next (o->path, stroke)))
+        {
+          GArray *anchors = gimp_stroke_control_points_get (stroke, NULL);
+
+          for (guint k = 0; anchors && k < anchors->len; k++)
+            {
+              GimpAnchor *a = &g_array_index (anchors, GimpAnchor, k);
+              gdouble     x, y;
+
+              gimp_matrix3_transform_point (&m, a->position.x, a->position.y, &x, &y);
+
+              if (! *any)
+                {
+                  b[0] = b[2] = x;
+                  b[1] = b[3] = y;
+                  *any = TRUE;
+                }
+              else
+                {
+                  b[0] = MIN (b[0], x);
+                  b[1] = MIN (b[1], y);
+                  b[2] = MAX (b[2], x);
+                  b[3] = MAX (b[3], y);
+                }
+            }
+
+          if (anchors)
+            g_array_unref (anchors);
+        }
+    }
+  else if (o->children)
+    {
+      for (guint i = 0; i < o->children->len; i++)
+        preview_bounds_rec (g_ptr_array_index (o->children, i), b, any);
+    }
+}
+
+gboolean
+chopgimp_vobject_preview_bounds (ChopGimpVObject *root,
+                                 gdouble          bounds[4])
+{
+  gboolean any = FALSE;
+
+  if (root)
+    preview_bounds_rec (root, bounds, &any);
+
+  return any;
+}
+
+void
+chopgimp_vobject_draw_preview (ChopGimpVObject *root,
+                               gpointer         data)
+{
+  cairo_t *cr = data;
+  GList   *leaves;
+
+  if (! root || ! cr)
+    return;
+
+  leaves = chopgimp_vobjects_leaves_of (root);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      GimpMatrix3      wm;
+      cairo_matrix_t   world;
+
+      if (! o->path || ! chopgimp_vobject_is_visible (o) ||
+          gimp_path_get_n_strokes (o->path) == 0)
+        continue;
+
+      chopgimp_vobject_get_world_matrix (o, &wm);
+      matrix_to_cairo (&wm, &world);
+
+      cairo_save (cr);
+      cairo_transform (cr, &world);
+
+      for (gint k = 0; k < chopgimp_vstyle_get_n_entries (&o->style); k++)
+        {
+          ChopGimpVEntry *e = chopgimp_vstyle_get_entry (&o->style, k);
+
+          if (chopgimp_ventry_is_painted (e))
+            draw_entry (cr, &o->style, e, o->path, NULL, &world);
+        }
+
+      cairo_restore (cr);
+    }
+
+  g_list_free (leaves);
+}
diff --git a/app/path/chopgimp-vobject.h b/app/path/chopgimp-vobject.h
new file mode 100644
index 0000000..d035488
--- /dev/null
+++ b/app/path/chopgimp-vobject.h
@@ -0,0 +1,717 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vobject.h — ChopGimp 3.27: vector layers with several objects
+ *
+ * A GimpVectorLayer holds an ordered tree of objects (paths and groups),
+ * each with its own name, geometry, transformation, fill, stroke,
+ * opacity, blend mode, visibility, lock and live path effects. GIMP's
+ * vector layer is improved rather than doubled: its own path and its
+ * fill / stroke options stay the « legacy view » of the objects:
+ *
+ *  - the legacy path (layer->options->path, in the Paths panel and in
+ *    the XCF) holds the sub-paths of ALL the objects, bottom to top, in
+ *    image coordinates (transformations applied, before live effects);
+ *  - the legacy fill / stroke are those of object #1 (the first leaf,
+ *    bottom-most);
+ *  - every edit of the legacy path (path tool, scripts, layer and image
+ *    transformations, undo of those) is spread back to the objects by
+ *    sub-path; a new sub-path joins the object of the sub-path before it;
+ *    an object whose sub-paths are all deleted stays, empty, until the
+ *    next save; every edit of the legacy fill / stroke goes to object #1.
+ *
+ *  A layer that was never edited as objects keeps GIMP's renderer
+ *  (pixel-identical to 3.26): it is « legacy » until the first object
+ *  edit. The objects are saved in the XCF parasite « chopgimp-vobjects »
+ *  (SVG-like XML, see chopgimp-vobject.c).
+ *
+ *  CHOPGIMP_NO_VOBJECTS=1 turns all of this off (3.26 behaviour).
+ *
+ * Coordinates: image pixels. obj->path is in the object's local space,
+ * obj->transform maps local → parent space (the parent group's local
+ * space; the root group has the identity). Gradient coordinates are
+ * relative to the object's bounding box (SVG objectBoundingBox: 0..1).
+ *
+ * Changing objects: always use the functions below (they push the undo
+ * step, re-render the dirty area, update the legacy path and emit
+ * « objects-changed »). A tool which edits obj->path in place during a
+ * drag calls chopgimp_vlayer_push_undo() once at the start, then
+ * chopgimp_vlayer_object_changed() after every change.
+ *
+ * Signals of GimpVectorLayer (registered in gimpvectorlayer.c):
+ *   "objects-changed"          (GimpVectorLayer *, gpointer dirty)
+ *       dirty: const GeglRectangle * in image coordinates, or NULL
+ *       when the whole layer changed (structure, undo, load…)
+ *   "object-selection-changed" (GimpVectorLayer *)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "libgimpmath/gimpmath.h"
+
