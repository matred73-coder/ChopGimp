+static void
+vsel_set_tip (ChopGimpVSel *vsel,
+              GtkWidget    *canvas,
+              guint         id,
+              const gchar  *text)
+{
+  if (vsel->tip_widget && vsel->tip_widget != canvas)
+    {
+      gtk_widget_set_tooltip_text (vsel->tip_widget, NULL);
+      g_object_remove_weak_pointer (G_OBJECT (vsel->tip_widget),
+                                    (gpointer *) &vsel->tip_widget);
+      vsel->tip_widget = NULL;
+      vsel->tip_id     = 0;
+    }
+
+  if (! canvas || (vsel->tip_widget == canvas && vsel->tip_id == id))
+    return;
+
+  if (! vsel->tip_widget)
+    {
+      vsel->tip_widget = canvas;
+      g_object_add_weak_pointer (G_OBJECT (canvas), (gpointer *) &vsel->tip_widget);
+    }
+
+  vsel->tip_id = id;
+  gtk_widget_set_tooltip_text (canvas, id ? text : NULL);
