+void              chopgimp_vlayer_begin_interactive (GimpVectorLayer *layer);
+void              chopgimp_vlayer_end_interactive   (GimpVectorLayer *layer);
+/*  @object (NULL: all) was changed in place (path, style fields…)  */
+void              chopgimp_vlayer_object_changed   (GimpVectorLayer  *layer,
+                                                    ChopGimpVObject  *object);
+
