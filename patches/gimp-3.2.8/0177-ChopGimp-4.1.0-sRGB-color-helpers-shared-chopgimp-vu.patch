From c5ddf21058534d20a1ecb3f9ed76153e89709596 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Fri, 27 Nov 2026 06:28:12 +0100
Subject: [PATCH 177/177] ChopGimp 4.1.0: sRGB color helpers shared
 (chopgimp-vutil.c) by vmaterial and vrecolor

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/path/chopgimp-vmaterial.c | 59 +++++++++++------------------------
 app/path/chopgimp-vrecolor.c  | 18 ++++-------
 app/path/chopgimp-vutil.c     | 21 +++++++++++++
 app/path/chopgimp-vutil.h     |  6 ++++
 4 files changed, 52 insertions(+), 52 deletions(-)

diff --git a/app/path/chopgimp-vmaterial.c b/app/path/chopgimp-vmaterial.c
index 6c4a015..70aba23 100644
--- a/app/path/chopgimp-vmaterial.c
+++ b/app/path/chopgimp-vmaterial.c
@@ -127,27 +127,6 @@ to_space (const gdouble  srgb[4],
   babl_process (fish, srgb, out, 1);
 }
 
-static void
-color_to_srgb (GeglColor *color,
-               gdouble    rgba[4])
-{
-  rgba[0] = rgba[1] = rgba[2] = 0.0;
-  rgba[3] = 1.0;
-
-  if (color)
-    gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), rgba);
-}
-
-static GeglColor *
-srgb_to_color (const gdouble rgba[4])
-{
-  GeglColor *c = gegl_color_new (NULL);
-
-  gegl_color_set_pixel (c, babl_format ("R'G'B'A double"), rgba);
-
-  return c;
-}
-
 static void
 mix (const gdouble a[4],
      const gdouble b[4],
@@ -301,7 +280,7 @@ chopgimp_vmesh_new_spec (gint              rows,
   cols = CLAMP (cols, 1, MESH_MAX);
   highlight = CLAMP (highlight, 0.0, 1.0);
 
-  color_to_srgb (color, base);
+  chopgimp_color_to_srgb (color, base);
 
   mesh.rows  = rows;
   mesh.cols  = cols;
@@ -585,10 +564,10 @@ chopgimp_vfreeform_new_spec (GeglColor *color,
   const gdouble    xy[4][2] = { { 0.2, 0.2 }, { 0.8, 0.25 }, { 0.75, 0.8 }, { 0.25, 0.75 } };
   gchar           *spec;
 
-  color_to_srgb (color, a);
+  chopgimp_color_to_srgb (color, a);
 
   if (other)
-    color_to_srgb (other, b);
+    chopgimp_color_to_srgb (other, b);
   else
     {
       const gdouble white[4] = { 1, 1, 1, 1 };
@@ -1150,8 +1129,8 @@ gradient_at (const ChopGimpPaint *p,
   if (! b)
     b = a;
 
-  color_to_srgb (a->color, ca);
-  color_to_srgb (b->color, cb);
+  chopgimp_color_to_srgb (a->color, ca);
+  chopgimp_color_to_srgb (b->color, cb);
 
   if (b->offset - a->offset > 1e-9)
     mix (ca, cb, (t - a->offset) / (b->offset - a->offset), srgb);
@@ -1393,7 +1372,7 @@ chopgimp_vmaterial_stroke_gradient_profile (cairo_t             *cr,
                                                              ChopGimpGradientStop, s);
                   gdouble               srgb[4];
 
-                  color_to_srgb (st->color, srgb);
+                  chopgimp_color_to_srgb (st->color, srgb);
                   to_space (srgb, space, rgba);
                   cairo_pattern_add_color_stop_rgba (g, st->offset, rgba[0], rgba[1],
                                                      rgba[2], rgba[3]);
@@ -1606,7 +1585,7 @@ chopgimp_vmaterial_main_color (ChopGimpPaintType  type,
       memcpy (rgba, m.nodes[0].rgba, sizeof (rgba));
       chopgimp_vmesh_clear (&m);
 
-      return srgb_to_color (rgba);
+      return chopgimp_srgb_to_color (rgba);
     }
   else if (type == CHOPGIMP_PAINT_FREEFORM && spec && ! strncmp (spec, "points", 6))
     {
@@ -1618,7 +1597,7 @@ chopgimp_vmaterial_main_color (ChopGimpPaintType  type,
       memcpy (rgba, g_array_index (pts, ChopGimpMeshNode, 0).rgba, sizeof (rgba));
       g_array_free (pts, TRUE);
 
-      return srgb_to_color (rgba);
+      return chopgimp_srgb_to_color (rgba);
     }
 
   return NULL;
@@ -2662,7 +2641,7 @@ paint_sample_srgb (const ChopGimpPaint *p,
   if (! paint_is_gradient (p))
     {
       if (p->color)
-        color_to_srgb (p->color, out);
+        chopgimp_color_to_srgb (p->color, out);
       else
         out[0] = out[1] = out[2] = 0.0, out[3] = 1.0;
       return;
@@ -2685,8 +2664,8 @@ paint_sample_srgb (const ChopGimpPaint *p,
   if (! b)
     b = a;
 
-  color_to_srgb (a->color, ca);
-  color_to_srgb (b->color, cb);
+  chopgimp_color_to_srgb (a->color, ca);
+  chopgimp_color_to_srgb (b->color, cb);
 
   if (b->offset - a->offset > 1e-9)
     mix (ca, cb, (t - a->offset) / (b->offset - a->offset), out);
@@ -2747,8 +2726,8 @@ lerp_gradient (ChopGimpPaint       *out,
 
       if (both && a->stops->len == b->stops->len)
         {
-          color_to_srgb (g_array_index (a->stops, ChopGimpGradientStop, i).color, ca);
-          color_to_srgb (g_array_index (b->stops, ChopGimpGradientStop, i).color, cb);
+          chopgimp_color_to_srgb (g_array_index (a->stops, ChopGimpGradientStop, i).color, ca);
+          chopgimp_color_to_srgb (g_array_index (b->stops, ChopGimpGradientStop, i).color, cb);
         }
       else
         {
@@ -2757,7 +2736,7 @@ lerp_gradient (ChopGimpPaint       *out,
         }
 
       mix (ca, cb, t, cm);
-      c = srgb_to_color (cm);
+      c = chopgimp_srgb_to_color (cm);
       chopgimp_vpaint_add_stop (&res, off, c);
       g_object_unref (c);
     }
@@ -2799,10 +2778,10 @@ lerp_style (ChopGimpVStyle       *out,
           gdouble    ca[4], cb[4], cm[4];
           GeglColor *c;
 
-          color_to_srgb (e->paint.color, ca);
-          color_to_srgb (f->paint.color, cb);
+          chopgimp_color_to_srgb (e->paint.color, ca);
+          chopgimp_color_to_srgb (f->paint.color, cb);
           mix (ca, cb, t, cm);
-          c = srgb_to_color (cm);
+          c = chopgimp_srgb_to_color (cm);
           chopgimp_vpaint_set_color (&e->paint, c);
           g_object_unref (c);
         }
@@ -2868,8 +2847,8 @@ blend_n_steps (GimpVectorLayer      *layer,
       {
         gdouble ca[4], cb[4];
 
-        color_to_srgb (fa->paint.color, ca);
-        color_to_srgb (fb->paint.color, cb);
+        chopgimp_color_to_srgb (fa->paint.color, ca);
+        chopgimp_color_to_srgb (fb->paint.color, cb);
 
         for (gint i = 0; i < 3; i++)
           diff = MAX (diff, fabs (ca[i] - cb[i]));
diff --git a/app/path/chopgimp-vrecolor.c b/app/path/chopgimp-vrecolor.c
index 61e9eb3..663a1e7 100644
--- a/app/path/chopgimp-vrecolor.c
+++ b/app/path/chopgimp-vrecolor.c
@@ -28,6 +28,7 @@
 
 #include "gimpvectorlayer.h"
 #include "chopgimp-vobject.h"
+#include "chopgimp-vutil.h"
 #include "chopgimp-vobject-ops.h"
 #include "chopgimp-vcolors.h"
 #include "chopgimp-vrecolor.h"
@@ -74,13 +75,6 @@ rgb_round (gdouble *rgb)
     rgb[i] = CLAMP (floor (rgb[i] * 255.0 + 0.5), 0, 255) / 255.0;
 }
 
-static void
-color_rgba (GeglColor *color,
-            gdouble   *rgba)
-{
-  gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), rgba);
-}
-
 static void
 rgb_to_hsv (const gdouble *rgb,
             gdouble       *hsv)
@@ -322,7 +316,7 @@ count_color (ChopGimpRecolor *rc,
   if (! color)
     return;
 
-  color_rgba (color, rgba);
+  chopgimp_color_to_srgb (color, rgba);
   key = rgb_key (rgba);
 
   c = g_hash_table_lookup (seen, GUINT_TO_POINTER (key));
@@ -604,7 +598,7 @@ global_rgb (ChopGimpRecolor *rc,
   if (! color)
     return FALSE;
 
-  color_rgba (color, rgba);
+  chopgimp_color_to_srgb (color, rgba);
   memcpy (rgb, rgba, sizeof (gdouble) * 3);
 
   return TRUE;
@@ -986,7 +980,7 @@ chopgimp_recolor_assign_globals (ChopGimpRecolor *rc)
       const ChopGimpVColor *g = l->data;
       gdouble               rgba[4];
 
-      color_rgba (g->color, rgba);
+      chopgimp_color_to_srgb (g->color, rgba);
       rgb_to_lab (rgba, lab + i * 3);
     }
 
@@ -1038,7 +1032,7 @@ remap_color (ChopGimpRecolor  *rc,
   if (! *color)
     return FALSE;
 
-  color_rgba (*color, rgba);
+  chopgimp_color_to_srgb (*color, rgba);
   i = chopgimp_recolor_find (rc, rgba);
 
   if (i < 0 || ! chopgimp_recolor_is_changed (rc, i))
@@ -1075,7 +1069,7 @@ remap_style (ChopGimpRecolor *rc,
           gint                  i;
           ChopGimpRecolorColor *c;
 
-          color_rgba (p->color, rgba);
+          chopgimp_color_to_srgb (p->color, rgba);
           i = chopgimp_recolor_find (rc, rgba);
           c = chopgimp_recolor_get_color (rc, i);
 
diff --git a/app/path/chopgimp-vutil.c b/app/path/chopgimp-vutil.c
index 01d26bc..6ad1b90 100644
--- a/app/path/chopgimp-vutil.c
+++ b/app/path/chopgimp-vutil.c
@@ -186,3 +186,24 @@ chopgimp_path_anchor_bbox (GimpPath *path,
 
   return any;
 }
+
+void
+chopgimp_color_to_srgb (GeglColor *color,
+                        gdouble    rgba[4])
+{
+  rgba[0] = rgba[1] = rgba[2] = 0.0;
+  rgba[3] = 1.0;
+
+  if (color)
+    gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), rgba);
+}
+
+GeglColor *
+chopgimp_srgb_to_color (const gdouble rgba[4])
+{
+  GeglColor *c = gegl_color_new (NULL);
+
+  gegl_color_set_pixel (c, babl_format ("R'G'B'A double"), rgba);
+
+  return c;
+}
diff --git a/app/path/chopgimp-vutil.h b/app/path/chopgimp-vutil.h
index dca5b7c..5fcd32f 100644
--- a/app/path/chopgimp-vutil.h
+++ b/app/path/chopgimp-vutil.h
@@ -51,3 +51,9 @@ GimpCoords chopgimp_coords          (gdouble          x,
  */
 gboolean   chopgimp_path_anchor_bbox (GimpPath       *path,
                                       gdouble         b[4]);
+
+/*  @color as R'G'B'A double in sRGB (opaque black when NULL)  */
+void        chopgimp_color_to_srgb  (GeglColor       *color,
+                                     gdouble          rgba[4]);
+/*  a new color from R'G'B'A double in sRGB  */
+GeglColor * chopgimp_srgb_to_color  (const gdouble    rgba[4]);
-- 
2.53.0

