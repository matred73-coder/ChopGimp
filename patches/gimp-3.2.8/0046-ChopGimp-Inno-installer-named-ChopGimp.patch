From aabc84661360e6e6c27efdf6bb6e52eb31beb660 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Thu, 12 Nov 2026 13:28:10 +0100
Subject: [PATCH 46/46] ChopGimp: Inno installer named ChopGimp

Product name, publisher, install folder, AppID, mutexes, registry keys
and file associations of its own, so that the ChopGimp installer never
touches an official GIMP (shortcuts, uninstall entry, settings).
Output file chopgimp-<version>-setup.exe; CHOPGIMP_VERSION defaults to
the ChopGimp version and can be overridden from the environment.
---
 build/windows/installer/3_dist-gimp-inno.ps1 | 11 ++-
 build/windows/installer/gimp-setup.iss       | 92 ++++++++++----------
 2 files changed, 55 insertions(+), 48 deletions(-)

diff --git a/build/windows/installer/3_dist-gimp-inno.ps1 b/build/windows/installer/3_dist-gimp-inno.ps1
index cc2f2c3..09c7d6c 100644
--- a/build/windows/installer/3_dist-gimp-inno.ps1
+++ b/build/windows/installer/3_dist-gimp-inno.ps1
@@ -182,9 +182,11 @@ function fix_msg ([array]$langsArray, [string]$AppVer)
         }
     }
 }
-fix_msg 'Default.isl' $CUSTOM_GIMP_VERSION
-fix_msg $langsArray_Official $CUSTOM_GIMP_VERSION
-fix_msg $langsArray_unofficial $CUSTOM_GIMP_VERSION
+#ChopGimp: the window titles show the ChopGimp version (same default as gimp-setup.iss)
+$CHOPGIMP_VERSION = if ($env:CHOPGIMP_VERSION) { $env:CHOPGIMP_VERSION } else { '3.11.1' }
+fix_msg 'Default.isl' $CHOPGIMP_VERSION
+fix_msg $langsArray_Official $CHOPGIMP_VERSION
+fix_msg $langsArray_unofficial $CHOPGIMP_VERSION
 Write-Output "$([char]27)[0Ksection_end:$(Get-Date -UFormat %s -Millisecond 0):installer_source$([char]13)$([char]27)[0K"
 
 
@@ -194,7 +196,8 @@ Write-Output "$([char]27)[0Ksection_end:$(Get-Date -UFormat %s -Millisecond 0):i
 
 
 # 5. COMPILE .EXE INSTALLER
-$INSTALLER="gimp-${CUSTOM_GIMP_VERSION}-setup.exe"
+#ChopGimp: must match OutputBaseFileName of gimp-setup.iss
+$INSTALLER="chopgimp-${CHOPGIMP_VERSION}-setup.exe"
 Write-Output "$([char]27)[0Ksection_start:$(Get-Date -UFormat %s -Millisecond 0):installer_making[collapsed=true]$([char]13)$([char]27)[0KConstructing $INSTALLER installer"
 iscc -DREVISION="$revision" -DBUILD_DIR="$BUILD_DIR" $supported_archs -DDEBUG_SYMBOLS -DPYTHON build\windows\installer\gimp-setup.iss | Out-Null; if ("$LASTEXITCODE" -gt '0') { exit 1 }
