+/* ─── Shape Builder ────────────────────────────────────────────────── */
+
+typedef struct
+{
+  GimpDrawTool  parent_instance;
+
+  GimpImage    *image;
+  gint64        stamp;      /* image state the regions were computed for */
+  GList        *layers;     /* input vector layers, top first            */
+  GPtrArray    *regions;    /* GimpPath *, unattached                    */
+  GArray       *picked;     /* gint: indices into regions                */
+  gint          hover;
+  gboolean      erase;
+} GimpShapeBuilderTool;
+
+typedef struct
+{
+  GimpDrawToolClass  parent_class;
+} GimpShapeBuilderToolClass;
+
+G_DEFINE_TYPE (GimpShapeBuilderTool, gimp_shape_builder_tool, GIMP_TYPE_DRAW_TOOL)
+
+#define MAX_SHAPES 12
+
+
+void
+gimp_shape_builder_tool_register (GimpToolRegisterCallback  callback,
+                                  gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_SHAPE_BUILDER_TOOL,
+                GIMP_TYPE_TOOL_OPTIONS,
+                gimp_tool_options_empty_gui,
+                0,
+                "gimp-shape-builder-tool",
+                _("Bâtisseur de formes"),
+                _("Bâtisseur de formes : glissez sur les zones des formes sélectionnées "
+                  "pour les fusionner, Alt pour les supprimer"),
+                N_("_Bâtisseur de formes"), NULL,
+                NULL, "gimp-tool-path",
+                "chopgimp-tool-shape-builder",
+                data);
+}
+
+static void
+shape_builder_clear (GimpShapeBuilderTool *sb)
+{
+  g_list_free_full (sb->layers, g_object_unref);
+  sb->layers = NULL;
+
+  if (sb->regions)
+    g_ptr_array_set_size (sb->regions, 0);
+
+  g_array_set_size (sb->picked, 0);
+  sb->hover = -1;
+  sb->image = NULL;
+  sb->stamp = 0;
+}
+
+static gint64
+shape_builder_stamp (GimpImage *image)
+{
+  GimpUndo *undo  = gimp_undo_stack_peek (gimp_image_get_undo_stack (image));
+  gint64    stamp = (gint64) (gintptr) undo * 31 + 7;
+  GList    *iter;
+
+  for (iter = gimp_image_get_selected_layers (image); iter; iter = iter->next)
+    stamp = stamp * 131 + (gint64) (gintptr) iter->data;
+
+  return stamp;
+}
+
+/*  the regions of the selected vector layers, computed again when the
+ *  image or the selection changed
+ */
+static void
+shape_builder_update_regions (GimpShapeBuilderTool *sb,
+                              GimpImage            *image)
+{
+  GList     *iter;
+  GimpPath **paths;
+  GimpPath **pieces;
+  gint       n = 0, n_pieces = 0;
+
+  if (sb->image == image && sb->stamp == shape_builder_stamp (image))
+    return;
+
+  shape_builder_clear (sb);
+  sb->image = image;
+  sb->stamp = shape_builder_stamp (image);
+
+  /*  selected layers come top first  */
+  for (iter = gimp_image_get_selected_layers (image); iter; iter = iter->next)
+    if (GIMP_IS_VECTOR_LAYER (iter->data) &&
+        g_list_length (sb->layers) < MAX_SHAPES)
+      sb->layers = g_list_append (sb->layers, g_object_ref (iter->data));
+
+  if (! sb->layers)
+    return;
+
+  paths = g_new0 (GimpPath *, g_list_length (sb->layers));
+  for (iter = sb->layers; iter; iter = iter->next)
+    paths[n++] = gimp_vector_layer_get_path (iter->data);
+
+  pieces = chopgimp_geom_divide (paths, n, &n_pieces);
+
+  for (gint i = 0; i < n_pieces; i++)
+    g_ptr_array_add (sb->regions, pieces[i]);
+
+  g_free (pieces);
+  g_free (paths);
+}
+
+static gint
+shape_builder_region_at (GimpShapeBuilderTool *sb,
+                         gdouble               x,
+                         gdouble               y)
+{
+  /*  the smallest region under the pointer  */
+  gint    best      = -1;
+  gdouble best_area = G_MAXDOUBLE;
+
+  for (guint i = 0; i < sb->regions->len; i++)
+    {
+      GimpPath *r = g_ptr_array_index (sb->regions, i);
+
+      if (chopgimp_geom_contains (r, x, y))
+        {
+          gdouble a = chopgimp_geom_area (r);
+
+          if (a < best_area)
+            {
+              best      = i;
+              best_area = a;
+            }
+        }
+    }
+
+  return best;
+}
+
+static gboolean
+shape_builder_picked (GimpShapeBuilderTool *sb,
+                      gint                  index)
+{
+  for (guint i = 0; i < sb->picked->len; i++)
+    if (g_array_index (sb->picked, gint, i) == index)
+      return TRUE;
+
+  return FALSE;
+}
+
+/*  the input layer that gives its style to a region: the topmost one
+ *  covering most of it
+ */
+static GimpVectorLayer *
+shape_builder_owner (GimpShapeBuilderTool *sb,
+                     GimpPath             *region)
+{
+  gdouble area = MAX (1.0, chopgimp_geom_area (region));
+  GList  *iter;
+
+  for (iter = sb->layers; iter; iter = iter->next)
+    {
+      GimpPath *both[2] = { region, gimp_vector_layer_get_path (iter->data) };
+      GimpPath *inter   = chopgimp_geom_boolean (both, 2, CHOPGIMP_BOOL_INTERSECTION);
+      gboolean  covers  = inter && chopgimp_geom_area (inter) > 0.5 * area;
+
+      g_clear_object (&inter);
+
+      if (covers)
+        return iter->data;
+    }
+
+  return sb->layers->data;
+}
+
+static GimpLayer *
+shape_builder_new_layer (GimpImage       *image,
+                         GimpPath        *path,
+                         GimpVectorLayer *style,
+                         GimpContext     *context,
+                         GimpLayer       *parent,
+                         gint             position)
+{
+  GimpVectorLayer        *layer;
+  GimpVectorLayerOptions *src = gimp_vector_layer_get_options (style);
+  GimpVectorLayerOptions *dst;
+
+  gimp_object_set_name (GIMP_OBJECT (path), gimp_object_get_name (style));
+  gimp_image_add_path (image, path, NULL, -1, TRUE);
+
+  layer = gimp_vector_layer_new (image, path, context);
+  dst   = gimp_vector_layer_get_options (layer);
+
+  g_object_set (dst,
+                "enable-fill",   src->enable_fill,
+                "enable-stroke", src->enable_stroke,
+                NULL);
+  gimp_config_sync (G_OBJECT (src->fill_options),   G_OBJECT (dst->fill_options),   0);
+  gimp_config_sync (G_OBJECT (src->stroke_options), G_OBJECT (dst->stroke_options), 0);
+
+  gimp_object_set_name (GIMP_OBJECT (layer), gimp_object_get_name (style));
+  gimp_layer_set_opacity (GIMP_LAYER (layer),
+                          gimp_layer_get_opacity (GIMP_LAYER (style)), FALSE);
+
+  gimp_image_add_layer (image, GIMP_LAYER (layer), parent, position, TRUE);
+  gimp_vector_layer_refresh (layer);
+
+  return GIMP_LAYER (layer);
+}
+
+static void
+shape_builder_apply (GimpShapeBuilderTool *sb,
+                     GimpDisplay          *display)
+{
+  GimpImage   *image   = sb->image;
+  GimpContext *context = gimp_get_user_context (image->gimp);
+  GimpLayer   *top     = sb->layers->data;
+  GimpLayer   *parent  = gimp_layer_get_parent (top);
+  gint         pos     = gimp_item_get_index (GIMP_ITEM (top));
+  GimpLayer   *merged  = NULL;
+  GList       *iter;
+
+  if (! sb->picked->len)
+    return;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC,
+                               _("Bâtisseur de formes"));
+
+  /*  the regions left alone keep the style of their shape  */
+  for (guint i = 0; i < sb->regions->len; i++)
+    {
+      GimpPath *r = g_ptr_array_index (sb->regions, i);
+
+      if (shape_builder_picked (sb, i))
+        continue;
+
+      shape_builder_new_layer (image,
+                               GIMP_PATH (gimp_item_duplicate (GIMP_ITEM (r), GIMP_TYPE_PATH)),
+                               shape_builder_owner (sb, r), context, parent, pos);
+    }
+
+  if (! sb->erase)
+    {
+      GimpPath **picked = g_new0 (GimpPath *, sb->picked->len);
+      GimpPath  *shape;
+
+      for (guint i = 0; i < sb->picked->len; i++)
+        picked[i] = g_ptr_array_index (sb->regions, g_array_index (sb->picked, gint, i));
+
+      shape = chopgimp_geom_boolean (picked, sb->picked->len, CHOPGIMP_BOOL_UNION);
+
+      if (shape)
+        merged = shape_builder_new_layer (image, shape,
+                                          shape_builder_owner (sb, picked[0]),
+                                          context, parent, pos);
+      g_free (picked);
+    }
+
+  for (iter = sb->layers; iter; iter = iter->next)
+    gimp_image_remove_layer (image, iter->data, TRUE, NULL);
+
+  if (merged)
+    {
+      GList *sel = g_list_prepend (NULL, merged);
+
+      gimp_image_set_selected_layers (image, sel);
+      g_list_free (sel);
+    }
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+
+  shape_builder_clear (sb);
+}
+
+static void
+shape_builder_redraw (GimpShapeBuilderTool *sb,
+                      GimpDisplay          *display)
+{
+  GimpDrawTool *draw_tool = GIMP_DRAW_TOOL (sb);
+
+  gimp_draw_tool_pause (draw_tool);
+
+  if (gimp_draw_tool_is_active (draw_tool) && draw_tool->display != display)
+    gimp_draw_tool_stop (draw_tool);
+
+  if (! gimp_draw_tool_is_active (draw_tool))
+    gimp_draw_tool_start (draw_tool, display);
+
+  gimp_draw_tool_resume (draw_tool);
+}
+
+static void
+gimp_shape_builder_tool_oper_update (GimpTool         *tool,
+                                     const GimpCoords *coords,
+                                     GdkModifierType   state,
+                                     gboolean          proximity,
+                                     GimpDisplay      *display)
+{
+  GimpShapeBuilderTool *sb    = (GimpShapeBuilderTool *) tool;
+  GimpImage            *image = gimp_display_get_image (display);
+  gint                  hover;
+
+  if (! image)
+    return;
+
+  shape_builder_update_regions (sb, image);
+
+  hover = proximity ? shape_builder_region_at (sb, coords->x, coords->y) : -1;
+
+  if (! sb->layers)
+    gimp_tool_replace_status (tool, display,
+                              _("Sélectionnez au moins une forme (calques vectoriels)"));
+  else
+    gimp_tool_replace_status (tool, display,
+                              _("Glisser : fusionner les zones — Alt+glisser : les supprimer"));
+
+  if (hover != sb->hover || ! gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    {
+      sb->hover = hover;
+      shape_builder_redraw (sb, display);
+    }
+}
+
+static void
+gimp_shape_builder_tool_button_press (GimpTool            *tool,
+                                      const GimpCoords    *coords,
+                                      guint32              time,
+                                      GdkModifierType      state,
+                                      GimpButtonPressType  press_type,
+                                      GimpDisplay         *display)
+{
+  GimpShapeBuilderTool *sb    = (GimpShapeBuilderTool *) tool;
+  GimpImage            *image = gimp_display_get_image (display);
+  gint                  r;
+
+  if (press_type != GIMP_BUTTON_PRESS_NORMAL || ! image)
+    return;
+
+  shape_builder_update_regions (sb, image);
+
+  if (! sb->layers)
+    {
+      gimp_tool_message_literal (tool, display,
+                                 _("Sélectionnez les formes à combiner "
+                                   "(calques vectoriels, Maj+clic dans le panneau Calques)."));
+      return;
+    }
+
+  tool->display = display;
+  sb->erase     = (state & GDK_MOD1_MASK) != 0;
+  g_array_set_size (sb->picked, 0);
+
+  r = shape_builder_region_at (sb, coords->x, coords->y);
+  if (r >= 0)
+    g_array_append_val (sb->picked, r);
+
+  gimp_tool_control_activate (tool->control);
+  shape_builder_redraw (sb, display);
+}
+
+static void
+gimp_shape_builder_tool_motion (GimpTool         *tool,
+                                const GimpCoords *coords,
+                                guint32           time,
+                                GdkModifierType   state,
+                                GimpDisplay      *display)
+{
+  GimpShapeBuilderTool *sb = (GimpShapeBuilderTool *) tool;
+  gint                  r  = shape_builder_region_at (sb, coords->x, coords->y);
+
+  sb->hover = r;
+
+  if (r >= 0 && ! shape_builder_picked (sb, r))
+    g_array_append_val (sb->picked, r);
+
+  shape_builder_redraw (sb, display);
+}
+
+static void
+gimp_shape_builder_tool_button_release (GimpTool              *tool,
+                                        const GimpCoords      *coords,
+                                        guint32                time,
+                                        GdkModifierType        state,
+                                        GimpButtonReleaseType  release_type,
+                                        GimpDisplay           *display)
+{
+  GimpShapeBuilderTool *sb = (GimpShapeBuilderTool *) tool;
+
+  gimp_tool_control_halt (tool->control);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (sb));
+
+  if (release_type != GIMP_BUTTON_RELEASE_CANCEL && sb->picked->len)
+    shape_builder_apply (sb, display);
+
+  g_array_set_size (sb->picked, 0);
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (sb));
+}
+
+static void
+gimp_shape_builder_tool_draw (GimpDrawTool *draw_tool)
+{
+  GimpShapeBuilderTool *sb    = (GimpShapeBuilderTool *) draw_tool;
+  GimpDisplayShell     *shell = gimp_display_get_shell (draw_tool->display);
+
+  if (! sb->regions)
+    return;
+
+  for (guint i = 0; i < sb->regions->len; i++)
+    {
+      GimpPath       *r      = g_ptr_array_index (sb->regions, i);
+      gboolean        picked = shape_builder_picked (sb, i);
+      gboolean        hover  = ((gint) i == sb->hover);
+      GimpCanvasItem *item;
+
+      /*  every region outlined, the hovered / picked ones filled  */
+      item = gimp_canvas_path_new (shell, gimp_path_get_bezier (r), 0, 0,
+                                   picked || hover, GIMP_PATH_STYLE_DEFAULT);
+      gimp_canvas_item_set_highlight (item, picked || hover);
+      gimp_draw_tool_add_item (draw_tool, item);
+      g_object_unref (item);
+    }
+}
+
+static void
+gimp_shape_builder_tool_control (GimpTool       *tool,
+                                 GimpToolAction  action,
+                                 GimpDisplay    *display)
+{
+  if (action == GIMP_TOOL_ACTION_HALT || action == GIMP_TOOL_ACTION_COMMIT)
+    {
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+      shape_builder_clear ((GimpShapeBuilderTool *) tool);
+    }
+
+  GIMP_TOOL_CLASS (gimp_shape_builder_tool_parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_shape_builder_tool_finalize (GObject *object)
+{
+  GimpShapeBuilderTool *sb = (GimpShapeBuilderTool *) object;
+
+  shape_builder_clear (sb);
+  g_ptr_array_unref (sb->regions);
+  g_array_unref (sb->picked);
+
+  G_OBJECT_CLASS (gimp_shape_builder_tool_parent_class)->finalize (object);
+}
+
+static void
+gimp_shape_builder_tool_class_init (GimpShapeBuilderToolClass *klass)
+{
+  GObjectClass      *object_class    = G_OBJECT_CLASS (klass);
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  object_class->finalize     = gimp_shape_builder_tool_finalize;
+
+  tool_class->control        = gimp_shape_builder_tool_control;
+  tool_class->oper_update    = gimp_shape_builder_tool_oper_update;
+  tool_class->button_press   = gimp_shape_builder_tool_button_press;
+  tool_class->motion         = gimp_shape_builder_tool_motion;
+  tool_class->button_release = gimp_shape_builder_tool_button_release;
+
+  draw_tool_class->draw      = gimp_shape_builder_tool_draw;
+}
+
+static void
+gimp_shape_builder_tool_init (GimpShapeBuilderTool *sb)
+{
+  GimpTool *tool = GIMP_TOOL (sb);
+
+  sb->regions = g_ptr_array_new_with_free_func (g_object_unref);
+  sb->picked  = g_array_new (FALSE, FALSE, sizeof (gint));
+  sb->hover   = -1;
+
+  gimp_tool_control_set_motion_mode (tool->control, GIMP_MOTION_MODE_EXACT);
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_PATHS);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_MOUSE);
+}
+
