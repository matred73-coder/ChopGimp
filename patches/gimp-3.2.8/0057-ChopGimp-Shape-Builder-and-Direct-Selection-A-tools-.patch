diff --git a/app/pdb/chopgimp-cmds.c b/app/pdb/chopgimp-cmds.c
index fbd2431..ebe0cc3 100644
--- a/app/pdb/chopgimp-cmds.c
+++ b/app/pdb/chopgimp-cmds.c
@@ -95,18 +95,24 @@ divide_invoker (GimpProcedure         *procedure,
   GimpPath      **pieces;
   gint            n_pieces = 0;
   GimpValueArray *return_vals;
+  GimpImage      *image;
 
   if (n < 1)
     return gimp_procedure_get_return_values (procedure, FALSE, NULL);
 
+  image  = gimp_item_get_image (GIMP_ITEM (paths[0]));
   pieces = chopgimp_geom_divide (paths, n, &n_pieces);
 
-  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
-  g_value_set_boxed (gimp_value_array_index (return_vals, 1), pieces);
-
-  /*  the array is copied, its paths are kept (inserted by the caller)  */
+  /*  the pieces are added on top of the paths of the image, the first
+   *  one at the top (core object arrays are not readable from Python)
+   */
+  for (gint i = n_pieces - 1; i >= 0; i--)
+    gimp_image_add_path (image, pieces[i], GIMP_IMAGE_ACTIVE_PARENT, 0, TRUE);
   g_free (pieces);
 
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_int (gimp_value_array_index (return_vals, 1), n_pieces);
+
   return return_vals;
 }
 
@@ -298,9 +304,10 @@ register_chopgimp_procs (GimpPDB *pdb)
   g_object_unref (p);
 
   p = chopgimp_procedure (pdb, divide_invoker, "chopgimp-path-divide",
-                          "Pathfinder « Divide »: every region of the arrangement of the paths.");
+                          "Pathfinder « Divide »: every region of the arrangement of the paths. "
+                          "The pieces are added at the top of the paths of the image.");
   gimp_procedure_add_argument (p, paths_arg ("paths"));
-  gimp_procedure_add_return_value (p, paths_arg ("pieces"));
+  gimp_procedure_add_return_value (p, int_arg ("n-pieces", 0, G_MAXINT, 0));
   gimp_pdb_register_procedure (pdb, p);
   g_object_unref (p);
 
