+
   gimp_tool_path_changed (widget);
 }
 
@@ -344,6 +364,9 @@ gimp_tool_path_set_property (GObject      *object,
     case PROP_POLYGONAL:
       private->polygonal = g_value_get_boolean (value);
       break;
+    case PROP_DIRECT_SELECT:
+      private->direct_select = g_value_get_boolean (value);
+      break;
 
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
@@ -371,6 +394,9 @@ gimp_tool_path_get_property (GObject    *object,
     case PROP_POLYGONAL:
       g_value_set_boolean (value, private->polygonal);
       break;
+    case PROP_DIRECT_SELECT:
+      g_value_set_boolean (value, private->direct_select);
+      break;
 
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
@@ -577,6 +603,19 @@ gimp_tool_path_button_press (GimpToolWidget      *widget,
   if (private->function == VECTORS_FINISHED)
     return 0;
 
+  /*  ChopGimp: start of a selection rectangle  */
+  if (private->function == VECTORS_RUBBER_BAND)
+    {
+      private->rb_x0 = private->rb_x1 = coords->x;
+      private->rb_y0 = private->rb_y1 = coords->y;
+      private->saved_state = state;
+
+      gimp_canvas_rectangle_set (private->rb_rect, coords->x, coords->y, 0, 0);
+      gimp_canvas_item_set_visible (private->rb_rect, TRUE);
+
+      return 1;
+    }
+
   g_return_val_if_fail (private->path  != NULL                   ||
                         private->function == VECTORS_SELECT_PATH ||
                         private->function == VECTORS_CREATE_PATH, 0);
@@ -945,6 +984,51 @@ gimp_tool_path_button_release (GimpToolWidget        *widget,
   GimpToolPath        *tool_path = GIMP_TOOL_PATH (widget);
   GimpToolPathPrivate *private   = tool_path->private;
 
+  if (private->function == VECTORS_RUBBER_BAND)
+    {
+      gimp_canvas_item_set_visible (private->rb_rect, FALSE);
+
+      if (private->path && release_type != GIMP_BUTTON_RELEASE_CANCEL)
+        {
+          gdouble     x1 = MIN (private->rb_x0, private->rb_x1);
+          gdouble     y1 = MIN (private->rb_y0, private->rb_y1);
+          gdouble     x2 = MAX (private->rb_x0, private->rb_x1);
+          gdouble     y2 = MAX (private->rb_y0, private->rb_y1);
+          gboolean    extend = (private->saved_state &
+                                gimp_get_extend_selection_mask ()) != 0;
+          GimpStroke *stroke = NULL;
+
+          gimp_path_freeze (private->path);
+
+          while ((stroke = gimp_path_stroke_get_next (private->path, stroke)))
+            {
+              GList *list;
+
+              for (list = stroke->anchors->head; list; list = list->next)
+                {
+                  GimpAnchor *a = list->data;
+                  gboolean    in;
+
+                  if (a->type != GIMP_ANCHOR_ANCHOR)
+                    continue;
+
+                  in = (a->position.x >= x1 && a->position.x <= x2 &&
+                        a->position.y >= y1 && a->position.y <= y2);
+
+                  if (in)
+                    a->selected = TRUE;
+                  else if (! extend)
+                    a->selected = FALSE;
+                }
+            }
+
+          gimp_path_thaw (private->path);
+        }
+
+      private->function = VECTORS_FINISHED;
+      return;
+    }
+
   private->function = VECTORS_FINISHED;
 
   if (private->have_undo)
@@ -975,6 +1059,19 @@ gimp_tool_path_motion (GimpToolWidget   *widget,
   if (private->function == VECTORS_FINISHED)
     return;
 
+  if (private->function == VECTORS_RUBBER_BAND)
+    {
+      private->rb_x1 = coords->x;
+      private->rb_y1 = coords->y;
+
+      gimp_canvas_rectangle_set (private->rb_rect,
+                                 MIN (private->rb_x0, private->rb_x1),
+                                 MIN (private->rb_y0, private->rb_y1),
+                                 fabs (private->rb_x1 - private->rb_x0),
+                                 fabs (private->rb_y1 - private->rb_y0));
+      return;
+    }
+
   position.x = coords->x;
   position.y = coords->y;
 
@@ -1094,6 +1191,9 @@ gimp_tool_path_hit (GimpToolWidget   *widget,
     case VECTORS_CONVERT_EDGE:
       return GIMP_HIT_DIRECT;
 
+    case VECTORS_RUBBER_BAND:
+      return GIMP_HIT_INDIRECT;
+
     case VECTORS_CREATE_PATH:
     case VECTORS_CREATE_STROKE:
     case VECTORS_ADD_ANCHOR:
@@ -1118,6 +1218,13 @@ gimp_tool_path_hover (GimpToolWidget   *widget,
 
   private->function = gimp_tool_path_get_function (tool_path, coords, state);
 
+  /*  ChopGimp « Direct Selection »: empty area → selection rectangle  */
+  if (private->direct_select && private->path &&
+      (private->function == VECTORS_CREATE_STROKE ||
+       private->function == VECTORS_ADD_ANCHOR    ||
+       private->function == VECTORS_SELECT_PATH))
+    private->function = VECTORS_RUBBER_BAND;
+
   gimp_tool_path_update_status (tool_path, state, proximity);
 }
 
@@ -1703,6 +1810,11 @@ gimp_tool_path_update_status (GimpToolPath    *tool_path,
       status = _("Click to make this node angular");
       break;
 
+    case VECTORS_RUBBER_BAND:
+      status = _("Glisser : sélectionner les nœuds dans un cadre (Maj : ajouter, "
+                 "flèches : déplacer)");
+      break;
+
     case VECTORS_FINISHED:
       status = _("Clicking here does nothing, try clicking on path elements.");
       break;
