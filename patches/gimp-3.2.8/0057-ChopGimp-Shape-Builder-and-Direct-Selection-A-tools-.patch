+/* ─── Direct Selection (A) ─────────────────────────────────────────── */
+
+typedef GimpPathTool      GimpDirectSelectTool;
+typedef GimpPathToolClass GimpDirectSelectToolClass;
+
+G_DEFINE_TYPE (GimpDirectSelectTool, gimp_direct_select_tool, GIMP_TYPE_PATH_TOOL)
+
+void
+gimp_direct_select_tool_register (GimpToolRegisterCallback  callback,
+                                  gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_DIRECT_SELECT_TOOL,
+                GIMP_TYPE_PATH_OPTIONS,
+                gimp_path_options_gui,
+                GIMP_PAINT_OPTIONS_CONTEXT_MASK |
+                GIMP_CONTEXT_PROP_MASK_PATTERN  |
+                GIMP_CONTEXT_PROP_MASK_GRADIENT,
+                "gimp-direct-select-tool",
+                _("Sélection directe"),
+                _("Sélection directe : modifier les nœuds d'une forme ou d'un chemin "
+                  "(glisser dans le vide : sélection au cadre)"),
+                N_("Sélection _directe"), "A",
+                NULL, GIMP_HELP_TOOL_PATH,
+                "chopgimp-tool-direct-select",
+                data);
+}
+
+static void
+gimp_direct_select_tool_class_init (GimpDirectSelectToolClass *klass)
+{
+}
+
+static void
+gimp_direct_select_tool_init (GimpDirectSelectTool *tool)
+{
+  /*  read by gimp_path_tool_start()  */
+  g_object_set_data (G_OBJECT (tool), "chopgimp-direct-select", GINT_TO_POINTER (TRUE));
+}
