@@ -82,6 +82,9 @@ GimpPath  * chopgimp_geom_round_corners (GimpPath        *path,
 GimpPath  * chopgimp_geom_reverse       (GimpPath        *path);
 
 gint        chopgimp_geom_count_nodes   (GimpPath        *path);
+gboolean    chopgimp_geom_contains      (GimpPath        *path,
