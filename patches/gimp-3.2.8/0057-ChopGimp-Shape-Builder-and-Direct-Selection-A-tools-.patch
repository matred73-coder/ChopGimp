+{
+  "chopgimp-pathfinder-union",     "chopgimp-pf-union",     N_("Pathfinder : réunir les formes sélectionnées"),
+  "chopgimp-pathfinder-minus",     "chopgimp-pf-minus",     N_("Pathfinder : soustraire les formes du dessus"),
+  "chopgimp-pathfinder-intersect", "chopgimp-pf-intersect", N_("Pathfinder : intersection"),
+  "chopgimp-pathfinder-exclude",   "chopgimp-pf-exclude",   N_("Pathfinder : exclure les chevauchements"),
+  "chopgimp-pathfinder-divide",    "chopgimp-pf-divide",    N_("Pathfinder : diviser en morceaux"),
+  NULL
+};
+
+static const gchar *const chopgimp_nodes_buttons[] =
+{
+  "chopgimp-nodes-corner",          "chopgimp-node-corner",    N_("Nœud angulaire"),
+  "chopgimp-nodes-smooth",          "chopgimp-node-smooth",    N_("Nœud doux"),
+  "chopgimp-nodes-symmetric",       "chopgimp-node-symmetric", N_("Nœud symétrique"),
+  "chopgimp-nodes-auto",            "chopgimp-node-auto",      N_("Nœud automatique"),
+  "chopgimp-nodes-line",            "chopgimp-node-line",      N_("Segments en lignes droites"),
+  "chopgimp-nodes-curve",           "chopgimp-node-curve",     N_("Segments en courbes"),
+  "chopgimp-nodes-align-left",      "chopgimp-node-align-left",    N_("Aligner les nœuds à gauche"),
+  "chopgimp-nodes-align-hcenter",   "chopgimp-node-align-hcenter", N_("Aligner les nœuds au centre (vertical)"),
+  "chopgimp-nodes-align-top",       "chopgimp-node-align-top",     N_("Aligner les nœuds en haut"),
+  "chopgimp-nodes-align-vcenter",   "chopgimp-node-align-vcenter", N_("Aligner les nœuds au centre (horizontal)"),
+  "chopgimp-nodes-distribute-h",    "chopgimp-node-distribute-h",  N_("Répartir les nœuds horizontalement"),
+  "chopgimp-nodes-join",            "chopgimp-node-join",      N_("Joindre deux extrémités"),
+  "chopgimp-nodes-break",           "chopgimp-node-break",     N_("Couper le chemin aux nœuds"),
+  "chopgimp-nodes-delete",          "chopgimp-node-delete",    N_("Supprimer les nœuds en gardant la forme"),
+  "chopgimp-nodes-round",           "chopgimp-node-round",     N_("Arrondir les coins sélectionnés…"),
+  NULL
+};
+
+static void
+gimp_options_bar_action_clicked (GtkWidget   *button,
+                                 const gchar *action_name)
+{
+  GApplication *app    = g_application_get_default ();
+  GAction      *action = NULL;
+
+  if (G_IS_ACTION_MAP (app))
+    action = g_action_map_lookup_action (G_ACTION_MAP (app), action_name);
+
+  if (action && g_action_get_enabled (action))
+    g_action_activate (action, NULL);
+  else
+    gdk_display_beep (gtk_widget_get_display (button));
+}
+
+static GtkWidget *
+gimp_options_bar_action_row (const gchar *const *buttons)
+{
+  GtkWidget *row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+
+  for (gint i = 0; buttons[i]; i += 3)
+    {
+      const gchar *names[] = { buttons[i + 1], "image-missing", NULL };
+      GIcon       *icon    = g_themed_icon_new_from_names ((gchar **) names, -1);
+      GtkWidget   *button  = gtk_button_new ();
+      GtkWidget   *image   = gtk_image_new_from_gicon (icon, GTK_ICON_SIZE_MENU);
+
+      g_object_unref (icon);
+      gtk_container_add (GTK_CONTAINER (button), image);
+      gtk_button_set_relief (GTK_BUTTON (button), GTK_RELIEF_NONE);
+      gtk_widget_set_can_focus (button, FALSE);
+      gimp_help_set_help_data (button, gettext (buttons[i + 2]), NULL);
+      g_signal_connect (button, "clicked",
+                        G_CALLBACK (gimp_options_bar_action_clicked),
+                        (gpointer) buttons[i]);
+      gtk_box_pack_start (GTK_BOX (row), button, FALSE, FALSE, 0);
+    }
+
+  gtk_widget_show_all (row);
+
+  return row;
+}
+
 
 static void   gimp_options_bar_tool_changed (GimpContext  *context,
                                              GimpToolInfo *tool_info,
@@ -602,6 +681,12 @@ gimp_options_bar_widget (GObject     *options,
       return w;
     }
 
+  if (! strcmp (prop, "@pathfinder"))
+    return gimp_options_bar_action_row (chopgimp_pathfinder_buttons);
+
+  if (! strcmp (prop, "@nodes"))
+    return gimp_options_bar_action_row (chopgimp_nodes_buttons);
+
   if (! strcmp (prop, "@vector-layer"))
     {
       w = gtk_button_new_with_label (_("Créer un calque vectoriel"));
diff --git a/app/display/gimptoolpath.c b/app/display/gimptoolpath.c
index f324069..2fb1ca7 100644
--- a/app/display/gimptoolpath.c
+++ b/app/display/gimptoolpath.c
@@ -50,6 +50,7 @@
 
 #include "gimpcanvashandle.h"
 #include "gimpcanvasitem-utils.h"
+#include "gimpcanvasrectangle.h"
 #include "gimpcanvasline.h"
 #include "gimpcanvaspath.h"
 #include "gimpdisplay.h"
@@ -82,6 +83,7 @@ typedef enum
   VECTORS_CONNECT_STROKES,
   VECTORS_DELETE_SEGMENT,
   VECTORS_CONVERT_EDGE,
+  VECTORS_RUBBER_BAND,      /* ChopGimp: select nodes in a rectangle */
   VECTORS_FINISHED
 } GimpPathFunction;
 
@@ -90,7 +92,8 @@ enum
   PROP_0,
   PROP_PATH,
   PROP_EDIT_MODE,
-  PROP_POLYGONAL
+  PROP_POLYGONAL,
+  PROP_DIRECT_SELECT
 };
 
 enum
@@ -132,6 +135,13 @@ struct _GimpToolPathPrivate
 
   GimpCanvasItem       *canvas_path;
   GList                *items;
+
+  /*  ChopGimp « Direct Selection »: a drag in an empty area selects
+   *  the nodes inside a rectangle instead of creating a new stroke
