+/*  ─── 3.29.5: « Dégradé libre » from the Gradient tool ─────────────── */
+
+gboolean
+chopgimp_freeform_edit_wanted (GimpImage *image)
+{
+  return image && chopgimp_vobjects_enabled () &&
+         ! g_getenv ("CHOPGIMP_NO_GRADIENT_FREEFORM") &&
+         chopgimp_vobjects_get_target_layer (image) != NULL;
+}
+
+void
+chopgimp_freeform_edit_reset (ChopGimpFreeformEdit *fe)
+{
+  fe->layer    = NULL;
+  fe->target   = 0;
+  fe->hover    = 0;
+  fe->node     = -1;
+  fe->sel      = -1;
+  fe->dragging = FALSE;
+  fe->pressed  = FALSE;
+}
+
+static ChopGimpVObject *
+freeform_pick (ChopGimpFreeformEdit *fe,
+               GimpDisplay          *display,
+               const GimpCoords     *coords)
+{
+  GimpImage        *image = gimp_display_get_image (display);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           tol   = PICK_PX / MAX (1e-6, shell->scale_x);
+
+  fe->layer = chopgimp_freeform_edit_wanted (image)
+              ? chopgimp_vobjects_get_target_layer (image) : NULL;
+
+  if (! fe->layer)
+    return NULL;
+
+  return chopgimp_vlayer_hit_test (fe->layer, coords->x, coords->y, tol,
+                                   CHOPGIMP_HIT_LEAF);
+}
+
+gboolean
+chopgimp_freeform_edit_hover (ChopGimpFreeformEdit *fe,
+                              GimpDisplay          *display,
+                              const GimpCoords     *coords)
+{
+  ChopGimpVObject *o = freeform_pick (fe, display, coords);
+
+  fe->hover = o ? o->id : 0;
+
+  return fe->layer != NULL;
+}
+
+gboolean
+chopgimp_freeform_edit_press (ChopGimpFreeformEdit *fe,
+                              GimpDisplay          *display,
+                              const GimpCoords     *coords,
+                              GdkModifierType       state,
+                              gboolean              lines)
+{
+  GimpImage        *image   = gimp_display_get_image (display);
+  GimpDisplayShell *shell   = gimp_display_get_shell (display);
+  GimpContext      *context = gimp_get_user_context (image->gimp);
+  gdouble           tol     = PICK_PX / MAX (1e-6, shell->scale_x);
+  gboolean          shift   = (state & gimp_get_extend_selection_mask ()) != 0;
+  gboolean          alt     = (state & GDK_MOD1_MASK) != 0;
+  gdouble           fg[4]   = { 0, 0, 0, 1 };
+  ChopGimpVObject  *o       = NULL;
+  ChopGimpVObject  *hit;
+  ChopGimpVEntry   *e;
+  gdouble          *pts     = NULL;
+  gint              n       = 0, idx = -1;
+  gboolean          freeform = FALSE;
+  gdouble           box[4], u, v;
+
+  fe->pressed  = FALSE;
+  fe->dragging = FALSE;
+  fe->node     = -1;
+
+  hit = freeform_pick (fe, display, coords);
+
+  if (! fe->layer)
+    return FALSE;
+
+  /*  on a vector layer, the press is always ours  */
+  fe->pressed = TRUE;
+
+  /*  the edited object first: its points may be outside its shape  */
+  if (fe->target)
+    o = chopgimp_vlayer_get_object (fe->layer, fe->target);
+
+  if (o)
+    {
+      pts = material_points (o, &n, &freeform);
+      idx = (pts && freeform) ? nearest_point (pts, n, coords->x, coords->y, tol) : -1;
+
+      if (idx < 0 && hit && hit != o)
+        {
+          g_clear_pointer (&pts, g_free);
+          o = NULL;
+        }
+    }
+
+  if (! o)
+    {
+      o       = hit;
+      fe->sel = -1;
+
+      if (o)
+        {
+          pts = material_points (o, &n, &freeform);
+          idx = (pts && freeform) ? nearest_point (pts, n, coords->x, coords->y, tol) : -1;
+        }
+    }
+
+  g_free (pts);
+
+  if (! o || ! object_box (o, box) || chopgimp_vobject_is_locked (o))
+    {
+      fe->target = 0;
+      fe->sel    = -1;
+      return TRUE;
+    }
+
+  if (context && gimp_context_get_foreground (context))
+    gegl_color_get_pixel (gimp_context_get_foreground (context),
+                          babl_format ("R'G'B'A double"), fg);
+
+  image_to_box (o, box, coords->x, coords->y, &u, &v);
+
+  chopgimp_vlayer_push_undo (fe->layer, _("Dégradé libre"));
+
+  /*  an object without a freeform fill gets one (its color and a
+   *  lighter one), the click then adds its point
+   */
+  e = material_fill (o);
+
+  if (! freeform || ! e || e->paint.type != CHOPGIMP_PAINT_FREEFORM ||
+      ! e->paint.material || ! g_str_has_prefix (e->paint.material, "points"))
+    {
+      GeglColor *base = e ? chopgimp_vpaint_get_main_color (&e->paint) : NULL;
+      gchar     *spec;
+
+      if (! base && context)
+        base = gimp_context_get_background (context);
+
+      spec = chopgimp_vfreeform_new_spec (base, NULL);
+      set_fill_material (fe->layer, o, CHOPGIMP_PAINT_FREEFORM, spec);
+      g_free (spec);
+
+      o       = chopgimp_vlayer_get_object (fe->layer, o->id);
+      e       = o ? material_fill (o) : NULL;
+      idx     = -1;
+      fe->sel = -1;
+
+      if (! e || ! e->paint.material)
+        return TRUE;
+    }
+
+  fe->target   = o->id;
+  fe->node     = freeform_press_points (fe->layer, o, e, idx, u, v, fg,
+                                        shift, alt, lines, &fe->sel);
+  fe->dragging = (fe->node >= 0);
+
+  gimp_image_flush (image);
+
+  return TRUE;
+}
+
+void
+chopgimp_freeform_edit_motion (ChopGimpFreeformEdit *fe,
+                               GimpDisplay          *display,
+                               const GimpCoords     *coords)
+{
+  ChopGimpVObject *o;
+  ChopGimpVEntry  *e;
+  gdouble          box[4], u, v;
+
+  if (! fe->dragging || fe->node < 0 || ! fe->layer ||
+      ! (o = chopgimp_vlayer_get_object (fe->layer, fe->target)) ||
+      ! object_box (o, box) || ! (e = material_fill (o)) ||
+      e->paint.type != CHOPGIMP_PAINT_FREEFORM || ! e->paint.material ||
+      ! g_str_has_prefix (e->paint.material, "points"))
+    return;
+
+  image_to_box (o, box, coords->x, coords->y, &u, &v);
+  freeform_move_point (fe->layer, o, e, fe->node, u, v);
+
+  gimp_image_flush (gimp_display_get_image (display));
+}
+
+void
+chopgimp_freeform_edit_release (ChopGimpFreeformEdit *fe)
+{
+  fe->dragging = FALSE;
+  fe->node     = -1;
+  fe->pressed  = FALSE;
+}
+
+void
+chopgimp_freeform_edit_draw (ChopGimpFreeformEdit *fe,
+                             GimpDrawTool         *dt)
+{
+  ChopGimpVObject *o;
+
+  if (! fe->layer || ! gimp_item_is_attached (GIMP_ITEM (fe->layer)) || ! dt->display)
+    return;
+
+  if (fe->hover && (o = chopgimp_vlayer_get_object (fe->layer, fe->hover)))
+    add_outline (dt, fe->layer, o, TRUE);
+
+  o = fe->target ? chopgimp_vlayer_get_object (fe->layer, fe->target) : NULL;
+  if (! o && fe->hover)
+    o = chopgimp_vlayer_get_object (fe->layer, fe->hover);
+
+  if (o)
+    {
+      gboolean  freeform;
+      gint      n;
+      gdouble  *pts = material_points (o, &n, &freeform);
+
+      if (pts && freeform)
+        {
+          freeform_draw_lines (dt, o, pts, n);
+
+          for (gint i = 0; i < n; i++)
+            gimp_draw_tool_add_handle (dt,
+                                       (o->id == fe->target && i == fe->sel)
+                                         ? GIMP_HANDLE_SQUARE : GIMP_HANDLE_FILLED_CIRCLE,
+                                       pts[2 * i], pts[2 * i + 1],
+                                       HANDLE_PX + 2 * (o->id == fe->target && i == fe->sel),
+                                       HANDLE_PX + 2 * (o->id == fe->target && i == fe->sel),
+                                       GIMP_HANDLE_ANCHOR_CENTER);
+        }
+
+      g_free (pts);
+    }
+}
