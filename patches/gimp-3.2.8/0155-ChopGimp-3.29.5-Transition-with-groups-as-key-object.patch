+/*  ChopGimp 3.29.5: the objects of a vector layer under the pointer  */
+static void
+gimp_gradient_tool_oper_update (GimpTool         *tool,
+                                const GimpCoords *coords,
+                                GdkModifierType   state,
+                                gboolean          proximity,
+                                GimpDisplay      *display)
+{
+  GimpGradientTool     *gradient_tool = GIMP_GRADIENT_TOOL (tool);
+  ChopGimpFreeformEdit *fe            = FREEFORM (tool);
+
+  GIMP_TOOL_CLASS (parent_class)->oper_update (tool, coords, state, proximity, display);
+
+  if (gradient_tool->widget || ! fe)
+    return;
+
+  if (proximity &&
+      chopgimp_freeform_edit_wanted (gimp_display_get_image (display)) &&
+      chopgimp_freeform_edit_hover (fe, display, coords))
+    {
+      gimp_tool_replace_status (tool, display,
+                                fe->hover
+                                ? _("Dégradé libre : clic = ajouter un point, glisser = "
+                                    "le déplacer, Maj+clic = le colorer, Alt+clic = le "
+                                    "retirer (option Lignes : points reliés)")
+                                : _("Survolez un objet du calque vectoriel"));
+      chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (tool), display);
+    }
+  else if (fe->layer)
+    {
+      chopgimp_freeform_edit_reset (fe);
+
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+    }
+}
+
+static void
+gimp_gradient_tool_draw (GimpDrawTool *draw_tool)
+{
+  GimpGradientTool     *gradient_tool = GIMP_GRADIENT_TOOL (draw_tool);
+  ChopGimpFreeformEdit *fe            = FREEFORM (draw_tool);
+
+  GIMP_DRAW_TOOL_CLASS (parent_class)->draw (draw_tool);
+
+  if (fe && fe->layer && ! gradient_tool->widget)
+    chopgimp_freeform_edit_draw (fe, draw_tool);
+}
