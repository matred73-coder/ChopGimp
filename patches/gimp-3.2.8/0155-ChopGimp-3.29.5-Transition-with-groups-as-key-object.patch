+/*  3.29.5: the box centre of the anchors of @paths  */
+static gboolean
+paths_center (GPtrArray *paths,
+              gdouble   *cx,
+              gdouble   *cy)
+{
+  gdouble  b[4] = { 0, };
+  gboolean any  = FALSE;
+
+  for (guint i = 0; i < paths->len; i++)
+    {
+      GimpStroke *st = NULL;
+
+      while ((st = gimp_path_stroke_get_next (paths->pdata[i], st)))
+        {
+          GArray *anchors = gimp_stroke_control_points_get (st, NULL);
+
+          for (guint k = 0; anchors && k < anchors->len; k++)
+            {
+              GimpAnchor *an = &g_array_index (anchors, GimpAnchor, k);
+
+              if (! any)
+                {
+                  b[0] = b[2] = an->position.x;
+                  b[1] = b[3] = an->position.y;
+                  any  = TRUE;
+                }
+              else
+                {
+                  b[0] = MIN (b[0], an->position.x);
+                  b[1] = MIN (b[1], an->position.y);
+                  b[2] = MAX (b[2], an->position.x);
+                  b[3] = MAX (b[3], an->position.y);
+                }
+            }
+
+          if (anchors)
+            g_array_unref (anchors);
+        }
+    }
+
+  *cx = (b[0] + b[2]) / 2;
+  *cy = (b[1] + b[3]) / 2;
+
+  return any;
+}
