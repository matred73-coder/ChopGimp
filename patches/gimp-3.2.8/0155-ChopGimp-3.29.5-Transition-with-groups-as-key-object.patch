+/*  3.29.5: the path leaves of a key, bottom → top (a group key: all of
+ *  its leaves; CHOPGIMP_NO_BLEND_GROUPS=1: groups are not interpolated)
+ */
+static void
+blend_leaves_rec (ChopGimpVObject *o,
+                  GPtrArray       *out)
+{
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    {
+      g_ptr_array_add (out, o);
+      return;
+    }
+
+  if (o->kind == CHOPGIMP_VOBJECT_GROUP && o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      blend_leaves_rec (g_ptr_array_index (o->children, i), out);
+}
