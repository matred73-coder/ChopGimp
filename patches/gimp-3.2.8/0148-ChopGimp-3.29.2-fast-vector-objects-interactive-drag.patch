+/*  draws the objects of @rect (image coordinates) into @buffer, whose
+ *  origin is (@u->x, @u->y)
+ */
+static void
+render_rect (GimpVectorLayer     *layer,
+             GeglBuffer          *buffer,
+             const GeglRectangle *u,
+             const GeglRectangle *rect,
+             const Babl          *space,
+             const Babl          *fmt)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+  gint            band_h;
+
+  if (rect->width <= 0 || rect->height <= 0)
+    return;
+
+  band_h = MAX (1, MIN (rect->height, BAND_MAX_PIXELS / MAX (1, rect->width)));
+
+  for (gint y = rect->y; y < rect->y + rect->height; y += band_h)
+    {
+      GeglRectangle    band = { rect->x, y, rect->width,
+                                MIN (band_h, rect->y + rect->height - y) };
+      cairo_surface_t *surf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+                                                          band.width, band.height);
+      cairo_t         *cr   = cairo_create (surf);
+
+      cairo_translate (cr, -band.x, -band.y);
+      composite (cr, layer, vl->root, &band, space);
+      cairo_destroy (cr);
+      cairo_surface_flush (surf);
+
+      gegl_buffer_set (buffer,
+                       GEGL_RECTANGLE (band.x - u->x, band.y - u->y,
+                                       band.width, band.height),
+                       0, fmt,
+                       cairo_image_surface_get_data (surf),
+                       cairo_image_surface_get_stride (surf));
+
+      cairo_surface_destroy (surf);
+    }
+}
