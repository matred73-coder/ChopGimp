   GimpItemUndo            parent_instance;
 
   gchar                  *state;
+  ChopGimpVLayer         *snap;     /* 3.29.2: the state as objects       */
   GimpVectorLayerOptions *options;
 } ChopGimpVObjectsUndo;
 
@@ -4889,6 +5196,118 @@ GType chopgimp_vobjects_undo_get_type (void);
 
 G_DEFINE_TYPE (ChopGimpVObjectsUndo, chopgimp_vobjects_undo, GIMP_TYPE_ITEM_UNDO)
 
+/*  3.29.2: undo keeps a copy of the object tree (same ids, sharing the
+ *  cached renderings, which are never changed once made) instead of its
+ *  XML: no writing, no parsing, the restored layer is composited from the
+ *  caches. CHOPGIMP_NO_FAST_UNDO=1: the XML as before.
+ */
+static gboolean
+fast_undo_enabled (void)
+{
+  static gint enabled = -1;
+
+  if (enabled < 0)
+    enabled = (g_getenv ("CHOPGIMP_NO_FAST_UNDO") == NULL);
+
+  return enabled;
+}
+
+static void
+snapshot_fix (ChopGimpVObject *src,
+              ChopGimpVObject *dst)
+{
+  dst->id = src->id;
+
+  if (src->cache)
+    {
+      dst->cache    = cairo_surface_reference (src->cache);
+      dst->cache_x  = src->cache_x;
+      dst->cache_y  = src->cache_y;
+      dst->cache_fx = src->cache_fx;
+      dst->cache_fy = src->cache_fy;
+    }
+
+  memcpy (dst->bounds_valid, src->bounds_valid, sizeof (src->bounds_valid));
+  memcpy (dst->bounds, src->bounds, sizeof (src->bounds));
+
+  if (src->children && dst->children)
+    for (guint i = 0; i < src->children->len && i < dst->children->len; i++)
+      snapshot_fix (g_ptr_array_index (src->children, i),
+                    g_ptr_array_index (dst->children, i));
+}
+
+static ChopGimpVLayer *
+vlayer_snapshot (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+  ChopGimpVLayer *c  = vlayer_new ();
+
+  chopgimp_vobject_unref (c->root);
+  c->root = chopgimp_vobject_copy (vl->root, gimp_item_get_image (GIMP_ITEM (layer)));
+  snapshot_fix (vl->root, c->root);
+
+  c->next_id = vl->next_id;
+  c->legacy  = vl->legacy;
+  c->entered = vl->entered;
+  g_array_append_vals (c->selection, vl->selection->data, vl->selection->len);
+  c->opt_sig   = g_strdup (vl->opt_sig);
+  c->layer_lpe = g_strdup (vl->layer_lpe);
+
+  vlayer_reindex (c);
+
+  return c;
+}
+
+static gint64
+vobj_memsize (ChopGimpVObject *o)
+{
+  gint64 size = sizeof (ChopGimpVObject);
+
+  if (o->path)
+    size += gimp_object_get_memsize (GIMP_OBJECT (o->path), NULL);
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      size += vobj_memsize (g_ptr_array_index (o->children, i));
+
+  return size;
+}
+
+/*  @vl replaces the objects of @layer; returns the old state (not freed)  */
+static ChopGimpVLayer *
+vlayer_install (GimpVectorLayer *layer,
+                ChopGimpVLayer  *vl)
+{
+  ChopGimpVLayer *old = layer->vobjects;
+
+  if (vl && old)
+    {
+      vl->freeze = old->freeze;
+
+      g_ptr_array_extend_and_steal (vl->layouts, old->layouts);
+      old->layouts = g_ptr_array_new_with_free_func ((GDestroyNotify) g_array_unref);
+    }
