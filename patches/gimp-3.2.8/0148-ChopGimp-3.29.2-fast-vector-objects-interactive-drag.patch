+/*  3.29.2: a translation of the world (interactive drag): the bounds and
+ *  the cached renderings move with it, nothing is rasterized again (the
+ *  effective path is in the object's coordinates and stays valid)
+ */
+static void
+vobj_shift (ChopGimpVObject *o,
+            gdouble          dx,
+            gdouble          dy)
+{
+  for (gint k = 0; k < 2; k++)
+    if (o->bounds_valid[k])
+      {
+        o->bounds[k][0] += dx;
+        o->bounds[k][1] += dy;
+        o->bounds[k][2] += dx;
+        o->bounds[k][3] += dy;
+      }
+
+  if (o->cache)
+    {
+      gdouble ix, iy;
+
+      o->cache_fx += dx;
+      o->cache_fy += dy;
+      ix = floor (o->cache_fx);
+      iy = floor (o->cache_fy);
+      o->cache_x  += (gint) ix;
+      o->cache_y  += (gint) iy;
+      o->cache_fx -= ix;
+      o->cache_fy -= iy;
+    }
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      vobj_shift (g_ptr_array_index (o->children, i), dx, dy);
+}
+
+/*  3.29.2: after a drag, only the renderings moved by a fraction of a
+ *  pixel are made again (a whole-pixel move keeps them exact)
+ */
+static void
+vobj_settle (ChopGimpVObject *o)
+{
+  if (o->cache && (o->cache_fx != 0.0 || o->cache_fy != 0.0))
+    vobj_drop_cache (o);
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      vobj_settle (g_ptr_array_index (o->children, i));
+}
+
+static gboolean
+fast_drag_enabled (void)
+{
+  static gint enabled = -1;
+
+  if (enabled < 0)
+    enabled = (g_getenv ("CHOPGIMP_NO_FAST_DRAG") == NULL);
+
+  return enabled;
+}
+
+static gboolean
+matrix_is_translation (const GimpMatrix3 *m)
+{
+  return (fabs (m->coeff[0][0] - 1.0) < 1e-12 && fabs (m->coeff[1][1] - 1.0) < 1e-12 &&
+          fabs (m->coeff[0][1]) < 1e-12 && fabs (m->coeff[1][0]) < 1e-12 &&
+          fabs (m->coeff[2][0]) < 1e-12 && fabs (m->coeff[2][1]) < 1e-12 &&
+          fabs (m->coeff[2][2] - 1.0) < 1e-12);
+}
