+      old->interactive  = 0;
+      old->legacy_dirty = FALSE;
+      old->sig_pending  = FALSE;
+      sprite_free (old);
+      old->sprite_off   = FALSE;
+      if (old->moved)
+        g_hash_table_remove_all (old->moved);
+    }
+
+  layer->vobjects = vl;
+
+  if (vl)
+    vobj_resolve_globals (vl->root, gimp_item_get_image (GIMP_ITEM (layer)), NULL, NULL);
+
+  return old;
