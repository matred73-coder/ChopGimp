+/*  ─── 3.29.2: the « sprite » of a drag ─────────────────────────────── */
+
+static gboolean
+sprite_unsupported (ChopGimpVObject *o)
+{
+  /*  what makes the rendering of an object depend on others  */
+  if (o->clip || o->opmask || o->livepaint || o->symbol || o->blend ||
+      o->mode != GIMP_LAYER_MODE_NORMAL)
+    return TRUE;
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      if (sprite_unsupported (g_ptr_array_index (o->children, i)))
+        return TRUE;
+
+  return FALSE;
+}
+
+static void
+sprite_free (ChopGimpVLayer *vl)
+{
+  g_clear_pointer (&vl->rest, cairo_surface_destroy);
+  g_clear_pointer (&vl->sprite, cairo_surface_destroy);
+  vl->sdx = vl->sdy = 0.0;
+}
+
+static void
+sprite_collect (ChopGimpVObject *o,
+                GHashTable      *set,
+                GList          **order)
+{
+  if (g_hash_table_contains (set, o))
+    {
+      *order = g_list_prepend (*order, o);
+      return;
+    }
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      sprite_collect (g_ptr_array_index (o->children, i), set, order);
+}
+
+/*  made before the first translation of the gesture: TRUE when usable  */
+static gboolean
+sprite_begin (GimpVectorLayer *layer,
+              GPtrArray       *objs)
+{
+  ChopGimpVLayer *vl    = layer->vobjects;
+  GimpItem       *item  = GIMP_ITEM (layer);
+  const Babl     *space = babl_format_get_space (gimp_drawable_get_format (GIMP_DRAWABLE (layer)));
+  GHashTable     *set;
+  GList          *order = NULL;
+  GeglRectangle   r;
+  gboolean        any   = FALSE;
+  cairo_t        *cr;
+
+  if (vl->sprite_off || vl->rest)
+    return vl->rest != NULL;
+
+  vl->sprite_off = TRUE;   /* until made */
+
+  if (g_getenv ("CHOPGIMP_NO_DRAG_SPRITE") || vl->legacy || sprite_unsupported (vl->root) ||
+      gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)))
+    return FALSE;
+
+  set = g_hash_table_new (NULL, NULL);
+  for (guint i = 0; i < objs->len; i++)
+    {
+      g_hash_table_add (set, objs->pdata[i]);
+      dirty_of (layer, objs->pdata[i], &r, &any);
+    }
+
+  if (! any)
+    {
+      g_hash_table_unref (set);
+      return FALSE;
+    }
+
+  gimp_item_get_offset (item, &vl->rest_r.x, &vl->rest_r.y);
+  vl->rest_r.width  = gimp_item_get_width  (item);
+  vl->rest_r.height = gimp_item_get_height (item);
+
+  if ((gint64) vl->rest_r.width * vl->rest_r.height > 64 * 1024 * 1024 ||
+      (gint64) r.width * r.height > 64 * 1024 * 1024)
+    {
+      g_hash_table_unref (set);
+      return FALSE;
+    }
+
+  /*  the rest: everything but the moved objects  */
+  vl->rest = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+                                         vl->rest_r.width, vl->rest_r.height);
+  cr = cairo_create (vl->rest);
+  cairo_translate (cr, -vl->rest_r.x, -vl->rest_r.y);
+  composite_skip = set;
+  composite (cr, layer, vl->root, &vl->rest_r, space);
+  composite_skip = NULL;
+  cairo_destroy (cr);
+  cairo_surface_flush (vl->rest);
+
+  /*  the sprite: the moved objects, in their order  */
+  vl->sprite_r = r;
+  vl->shown_r  = r;
+  vl->sprite   = cairo_image_surface_create (CAIRO_FORMAT_ARGB32, r.width, r.height);
+  cr = cairo_create (vl->sprite);
+  cairo_translate (cr, -r.x, -r.y);
+  sprite_collect (vl->root, set, &order);
+  order = g_list_reverse (order);
+  for (GList *l = order; l; l = l->next)
+    composite (cr, layer, l->data, &r, space);
+  cairo_destroy (cr);
+  cairo_surface_flush (vl->sprite);
+
+  g_list_free (order);
+  g_hash_table_unref (set);
+
+  vl->sdx = vl->sdy = 0.0;
+  vl->sprite_off = FALSE;
+
+  return TRUE;
+}
+
+/*  shows the sprite moved by (sdx, sdy), rounded to whole pixels  */
+static void
+sprite_show (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl       = layer->vobjects;
+  GimpDrawable   *drawable = GIMP_DRAWABLE (layer);
+  GimpItem       *item     = GIMP_ITEM (layer);
+  const Babl     *space    = babl_format_get_space (gimp_drawable_get_format (drawable));
+  const Babl     *fmt      = babl_format_with_space ("cairo-ARGB32", space);
+  GeglRectangle   cur, now, d;
+  cairo_surface_t *surf;
+  cairo_t        *cr;
+
+  now        = vl->sprite_r;
+  now.x     += (gint) floor (vl->sdx + 0.5);
+  now.y     += (gint) floor (vl->sdy + 0.5);
+
+  gimp_item_get_offset (item, &cur.x, &cur.y);
+  cur.width  = gimp_item_get_width  (item);
+  cur.height = gimp_item_get_height (item);
+
+  /*  the layer grows (never shrinks during the gesture)  */
+  {
+    GeglRectangle u;
+
+    gegl_rectangle_bounding_box (&u, &cur, &now);
+
+    if (! gegl_rectangle_equal (&u, &cur))
+      {
+        /*  with a margin: not a new buffer at each step of the drag (the
+         *  exact bounds are set at the end of the gesture)
+         */
+        gint m = MAX (256, MAX (vl->sprite_r.width, vl->sprite_r.height) / 2);
+
+        if (now.x < cur.x)                             u.x -= m, u.width += m;
+        if (now.y < cur.y)                             u.y -= m, u.height += m;
+        if (now.x + now.width > cur.x + cur.width)     u.width += m;
+        if (now.y + now.height > cur.y + cur.height)   u.height += m;
+
+        GeglBuffer *old = g_object_ref (gimp_drawable_get_buffer (drawable));
+        GeglBuffer *nb  = gegl_buffer_new (GEGL_RECTANGLE (0, 0, u.width, u.height),
+                                           gimp_drawable_get_format (drawable));
+
+        gegl_buffer_copy (old, GEGL_RECTANGLE (0, 0, cur.width, cur.height),
+                          GEGL_ABYSS_NONE, nb,
+                          GEGL_RECTANGLE (cur.x - u.x, cur.y - u.y,
+                                          cur.width, cur.height));
+        g_object_unref (old);
+
+        g_object_freeze_notify (G_OBJECT (drawable));
+        gimp_drawable_set_buffer (drawable, FALSE, NULL, nb);
+        g_object_unref (nb);
+        gimp_item_set_offset (item, u.x, u.y);
+        g_object_thaw_notify (G_OBJECT (drawable));
+
+        cur = u;
+      }
+  }
+
+  gegl_rectangle_bounding_box (&d, &vl->shown_r, &now);
+  if (! gegl_rectangle_intersect (&d, &d, &cur))
+    return;
+
+  surf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32, d.width, d.height);
+  cr   = cairo_create (surf);
+  cairo_translate (cr, -d.x, -d.y);
+  cairo_set_source_surface (cr, vl->rest, vl->rest_r.x, vl->rest_r.y);
+  cairo_paint (cr);
+  cairo_set_source_surface (cr, vl->sprite, now.x, now.y);
+  cairo_paint (cr);
+  cairo_destroy (cr);
+  cairo_surface_flush (surf);
+
+  gegl_buffer_set (gimp_drawable_get_buffer (drawable),
+                   GEGL_RECTANGLE (d.x - cur.x, d.y - cur.y, d.width, d.height),
+                   0, fmt, cairo_image_surface_get_data (surf),
+                   cairo_image_surface_get_stride (surf));
+  cairo_surface_destroy (surf);
+
+  gimp_drawable_update (drawable, d.x - cur.x, d.y - cur.y, d.width, d.height);
+
+  vl->shown_r = now;
+}
