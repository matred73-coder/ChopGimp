+void
+chopgimp_vlayer_begin_interactive (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl;
+
+  if (! layer_usable (layer) || ! (vl = vlayer_ensure (layer)))
+    return;
+
+  if (! vl->moved)
+    vl->moved = g_hash_table_new (NULL, NULL);
+
+  vl->interactive++;
+}
+
+void
+chopgimp_vlayer_end_interactive (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl = layer ? layer->vobjects : NULL;
+  GHashTableIter  iter;
+  gpointer        key;
+  GeglRectangle   r;
+  gboolean        any = FALSE;
+
+  /*  an undo during the gesture replaced the state: nothing to end  */
+  if (! vl || vl->interactive == 0)
+    return;
+
+  if (--vl->interactive > 0)
+    return;
+
+  /*  the sprite showed the moved objects on top: their old place and
+   *  the layer bounds are drawn exactly below
+   */
+  if (vl->rest)
+    {
+      r   = vl->sprite_r;
+      any = TRUE;
+      sprite_free (vl);
+    }
+  vl->sprite_off = FALSE;
+
+  /*  the exact rendering of what was moved with its cached rendering  */
+  g_hash_table_iter_init (&iter, vl->moved);
+  while (g_hash_table_iter_next (&iter, &key, NULL))
+    {
+      ChopGimpVObject *o = g_hash_table_lookup (vl->by_id, key);
+
+      if (o)
+        {
+          dirty_of (layer, o, &r, &any);
+          vobj_settle (o);
+          dirty_of (layer, o, &r, &any);
+        }
+    }
+  g_hash_table_remove_all (vl->moved);
+
+  if (vl->legacy_dirty)
+    {
+      vlayer_write_legacy (layer, TRUE, TRUE);
+      vl->legacy_dirty = FALSE;
+    }
+
+  if (any && layer_usable (layer) && ! vl->legacy)
+    vlayer_render_region (layer, &r);
+
+  if (vl->sig_pending || any)
+    {
+      gboolean all = vl->sig_all;
+
+      if (any && vl->sig_pending && ! all)
+        gegl_rectangle_bounding_box (&r, &r, &vl->sig_rect);
+      else if (! any)
+        r = vl->sig_rect;
+
+      vl->sig_pending = FALSE;
+      vl->sig_all     = FALSE;
+
+      g_signal_emit_by_name (layer, "objects-changed", all ? NULL : &r);
+    }
+}
+
+gboolean
+chopgimp_vlayer_is_interactive (GimpVectorLayer *layer)
+{
+  return layer && layer->vobjects && layer->vobjects->interactive > 0;
+}
+
 void
 chopgimp_vlayer_object_changed (GimpVectorLayer *layer,
                                 ChopGimpVObject *object)
