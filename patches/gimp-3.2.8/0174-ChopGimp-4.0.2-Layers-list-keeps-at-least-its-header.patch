 app/widgets/gimplayertreeview.c | 58 +++++++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/app/widgets/gimplayertreeview.c b/app/widgets/gimplayertreeview.c
index 5691d06..d51c1a0 100644
--- a/app/widgets/gimplayertreeview.c
+++ b/app/widgets/gimplayertreeview.c
@@ -116,6 +116,9 @@ static void       gimp_layer_tree_view_set_container              (GimpContainer
 static void       gimp_layer_tree_view_set_context                (GimpContainerView          *view,
                                                                    GimpContext                *context);
 static void       gimp_layer_tree_view_set_view_size              (GimpContainerView          *view);
+static void       gimp_layer_tree_view_update_min_height          (GimpLayerTreeView          *view);
+static void       gimp_layer_tree_view_style_updated              (GtkWidget                  *widget,
+                                                                   GimpLayerTreeView          *view);
 static gboolean   gimp_layer_tree_view_set_selected               (GimpContainerView          *view,
                                                                    GList                      *items);
 
@@ -673,6 +676,12 @@ gimp_layer_tree_view_constructed (GObject *object)
       gtk_box_pack_start (GTK_BOX (layer_view), layer_view->priv->objects_strip,
                           FALSE, FALSE, 0);
     }
+
+  /*  ChopGimp 4.0.2: the list never shrinks under its header  */
+  g_signal_connect (tree_view->view, "style-updated",
+                    G_CALLBACK (gimp_layer_tree_view_style_updated),
+                    layer_view);
+  gimp_layer_tree_view_update_min_height (layer_view);
 }
 
 static void
@@ -858,6 +867,55 @@ gimp_layer_tree_view_set_view_size (GimpContainerView *view)
     }
 
   parent_view_iface->set_view_size (view);
+
+  gimp_layer_tree_view_update_min_height (GIMP_LAYER_TREE_VIEW (view));
+}
+
+/*  ChopGimp 4.0.2: the list keeps at least its header and one row.  The
+ *  « fx » and « Objets » strips under it are packed at their natural
+ *  height; in a short Layers panel they took all the room and the list
+ *  shrank under its header: the active (vector) layer row was hidden.
+ */
+static void
+gimp_layer_tree_view_update_min_height (GimpLayerTreeView *view)
+{
+  GimpContainerTreeView *tree_view = GIMP_CONTAINER_TREE_VIEW (view);
+  GtkWidget             *scrolled  = GIMP_CONTAINER_BOX (view)->scrolled_win;
+  GtkWidget             *button;
+  gint                   header    = 0;
+  gint                   row       = 0;
+  gint                   sep       = 0;
+  gint                   border    = 0;
+  gint                   size;
+
+  if (chopgimp_panels_classic () || ! scrolled || ! tree_view->view)
+    return;
+
+  size = gimp_container_view_get_view_size (GIMP_CONTAINER_VIEW (view), &border);
+
+  button = gtk_tree_view_column_get_button (tree_view->main_column);
+  if (button && gtk_tree_view_get_headers_visible (tree_view->view))
+    gtk_widget_get_preferred_height (button, &header, NULL);
+
+  if (tree_view->renderer_cell)
+    gtk_cell_renderer_get_preferred_height (tree_view->renderer_cell,
+                                            GTK_WIDGET (tree_view->view),
+                                            &row, NULL);
+
+  gtk_widget_style_get (GTK_WIDGET (tree_view->view),
+                        "vertical-separator", &sep, NULL);
+
+  row = MAX (row, size + 2 * border) + sep;
+
+  gtk_scrolled_window_set_min_content_height (GTK_SCROLLED_WINDOW (scrolled),
+                                              header + MAX (row, 24));
+}
+
+static void
+gimp_layer_tree_view_style_updated (GtkWidget         *widget,
+                                    GimpLayerTreeView *view)
+{
+  gimp_layer_tree_view_update_min_height (view);
 }
 
 static gboolean
