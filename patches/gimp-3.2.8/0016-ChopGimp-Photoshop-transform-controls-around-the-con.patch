+
+
+gboolean chopgimp_transform_from_move = FALSE;
+
+
+static gboolean
+chopgimp_layer_is_croppable (GimpLayer *layer)
+{
+  GimpItem *item = GIMP_ITEM (layer);
+
+  return ! gimp_viewable_get_children (GIMP_VIEWABLE (layer)) &&
+         ! gimp_item_is_text_layer (item)                     &&
+         ! gimp_item_is_vector_layer (item)                   &&
+         ! gimp_layer_is_floating_sel (layer);
+}
+
+/*  Bounds (image coordinates) of the visible content of @layer, like the
+ *  box Photoshop draws with « Show Transform Controls ».
+ */
+gboolean
+chopgimp_layer_content_bounds (GimpLayer *layer,
+                               gint      *x,
+                               gint      *y,
+                               gint      *width,
+                               gint      *height)
+{
+  GimpItem *item = GIMP_ITEM (layer);
+  gint      ox, oy, w, h;
+  gint      sx = 0, sy = 0, sw, sh;
+
+  gimp_item_get_offset (item, &ox, &oy);
+  w = sw = gimp_item_get_width  (item);
+  h = sh = gimp_item_get_height (item);
+
+  if (chopgimp_layer_is_croppable (layer))
+    {
+      switch (gimp_pickable_auto_shrink (GIMP_PICKABLE (layer), 0, 0, w, h,
+                                         &sx, &sy, &sw, &sh))
+        {
+        case GIMP_AUTO_SHRINK_EMPTY:
+          return FALSE;
+
+        case GIMP_AUTO_SHRINK_UNSHRINKABLE:
+          sx = 0; sy = 0; sw = w; sh = h;
+          break;
+
+        case GIMP_AUTO_SHRINK_SHRINK:
+          break;
+        }
+    }
+
+  *x      = ox + sx;
+  *y      = oy + sy;
+  *width  = sw;
+  *height = sh;
+
+  return TRUE;
+}
+
+/*  Photoshop has no layer bounds: before transforming, fit the layer to its
+ *  content (no pixel is lost) so the handles surround the object.
+ */
+gboolean
+chopgimp_crop_layer_to_content (GimpImage   *image,
+                                GimpLayer   *layer,
+                                GimpContext *context)
+{
+  gint x, y, w, h;
+
+  if (! chopgimp_layer_is_croppable (layer))
+    return FALSE;
+
+  if (gimp_pickable_auto_shrink (GIMP_PICKABLE (layer), 0, 0,
+                                 gimp_item_get_width  (GIMP_ITEM (layer)),
+                                 gimp_item_get_height (GIMP_ITEM (layer)),
+                                 &x, &y, &w, &h) != GIMP_AUTO_SHRINK_SHRINK)
+    return FALSE;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_ITEM_RESIZE,
+                               _("Crop Layer to Content"));
+  gimp_item_resize (GIMP_ITEM (layer), context, GIMP_FILL_TRANSPARENT,
+                    w, h, -x, -y);
+  gimp_image_undo_group_end (image);
+
+  return TRUE;
+}
+
+
+typedef struct
+{
+  Gimp            *gimp;
+  GimpDisplay     *display;
+  gchar           *tool_name;
+  gboolean         press;
+  GimpCoords       coords;
+  guint32          time;
+  GdkModifierType  state;
+} SwitchData;
+
+static gboolean
+chopgimp_switch_tool_idle (SwitchData *s)
+{
+  GimpToolInfo *info = gimp_get_tool_info (s->gimp, s->tool_name);
+
+  if (info)
+    gimp_context_set_tool (gimp_get_user_context (s->gimp), info);
+
+  if (s->press && s->display && gimp_display_get_image (s->display))
+    {
+      if (tool_manager_initialize_active (s->gimp, s->display))
+        tool_manager_button_press_active (s->gimp, &s->coords, s->time,
+                                          s->state, GIMP_BUTTON_PRESS_NORMAL,
+                                          s->display);
+    }
+
+  g_clear_object (&s->display);
+  g_free (s->tool_name);
+  g_free (s);
+
+  return G_SOURCE_REMOVE;
+}
+
+/*  Switch to @tool_name once the current event is handled; if @press_coords
+ *  is given, the new tool receives the button press (so the user's drag on
+ *  a handle continues in the new tool).
+ */
+void
+chopgimp_switch_tool_later (Gimp             *gimp,
+                            GimpDisplay      *display,
+                            const gchar      *tool_name,
+                            const GimpCoords *press_coords,
+                            guint32           time,
+                            GdkModifierType   state)
+{
+  SwitchData *s = g_new0 (SwitchData, 1);
+
+  s->gimp      = gimp;
+  s->display   = display ? g_object_ref (display) : NULL;
+  s->tool_name = g_strdup (tool_name);
+  s->time      = time;
+  s->state     = state;
+
+  if (press_coords)
+    {
+      s->press  = TRUE;
+      s->coords = *press_coords;
+    }
+
+  g_idle_add ((GSourceFunc) chopgimp_switch_tool_idle, s);
+}
