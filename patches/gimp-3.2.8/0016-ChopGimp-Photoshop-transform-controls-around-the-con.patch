   objects = gimp_transform_tool_check_selected_objects (tr_tool, display, error);
 
   if (! objects)
@@ -1521,6 +1535,13 @@ gimp_transform_grid_tool_response (GimpToolGui           *gui,
     case GTK_RESPONSE_OK:
       g_return_if_fail (display != NULL);
       gimp_tool_control (tool, GIMP_TOOL_ACTION_COMMIT, display);
+      if (chopgimp_transform_from_move)
+        {
+          /*  ChopGimp: back to the move tool, like Photoshop  */
+          chopgimp_transform_from_move = FALSE;
+          chopgimp_switch_tool_later (display->gimp, NULL, "gimp-move-tool",
+                                      NULL, 0, 0);
+        }
       break;
 
     default:
@@ -1529,6 +1550,13 @@ gimp_transform_grid_tool_response (GimpToolGui           *gui,
       /*  update the undo actions / menu items  */
       if (display)
         gimp_image_flush (gimp_display_get_image (display));
+
+      if (chopgimp_transform_from_move && display)
+        {
+          chopgimp_transform_from_move = FALSE;
+          chopgimp_switch_tool_later (display->gimp, NULL, "gimp-move-tool",
+                                      NULL, 0, 0);
+        }
       break;
     }
 }
