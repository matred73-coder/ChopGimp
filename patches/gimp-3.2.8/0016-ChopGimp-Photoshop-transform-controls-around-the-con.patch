diff --git a/app/tools/gimpmovetool.c b/app/tools/gimpmovetool.c
index 38a77fb..e3780ff 100644
--- a/app/tools/gimpmovetool.c
+++ b/app/tools/gimpmovetool.c
@@ -52,6 +52,7 @@
 #include "display/gimpdisplayshell-selection.h"
 #include "display/gimpdisplayshell-transform.h"
 
+#include "chopgimp-tools.h"
 #include "gimpeditselectiontool.h"
 #include "gimpguidetool.h"
 #include "gimpmoveoptions.h"
@@ -192,6 +193,26 @@ gimp_move_tool_button_press (GimpTool            *tool,
   const gchar       *locked_message = NULL;
   GimpItem          *locked_item    = NULL;
 
+  /*  ChopGimp: dragging a handle of the transform controls resizes the
+   *  object directly (Photoshop): fit the layer to its content, then hand
+   *  the press over to the unified transform tool.
+   */
+  if (options->move_type == GIMP_TRANSFORM_TYPE_LAYER &&
+      ! gimp_image_get_floating_selection (image)     &&
+      chopgimp_move_on_handle (move, display, coords))
+    {
+      chopgimp_crop_layer_to_content (image, move->ctl_layer,
+                                      gimp_get_user_context (display->gimp));
+      gimp_image_flush (image);
+      move->ctl_stamp = -1;
+
+      chopgimp_transform_from_move = TRUE;
+      chopgimp_switch_tool_later (display->gimp, display,
+                                  "gimp-unified-transform-tool",
+                                  coords, time, state);
+      return;
+    }
+
   tool->display = display;
 
   move->floating_layer = NULL;
@@ -523,6 +544,69 @@ gimp_move_tool_modifier_key (GimpTool        *tool,
   (void) move;
 }
 
+
+#define CTL_HANDLE 9
+
+/*  ChopGimp: recompute the content box of the selected layer when the
+ *  layer or the image changed.
+ */
+static gboolean
+chopgimp_move_update_controls (GimpMoveTool *move,
+                               GimpImage    *image)
+{
+  GList     *layers = gimp_image_get_selected_layers (image);
+  GimpLayer *layer  = (g_list_length (layers) == 1) ? layers->data : NULL;
+  gint64     stamp  = gimp_image_get_dirty_time (image);
+  gboolean   valid;
+  gint       x = 0, y = 0, w = 0, h = 0;
+
+  if (layer == move->ctl_layer && stamp == move->ctl_stamp && layer)
+    return FALSE;
+
+  valid = layer && chopgimp_layer_content_bounds (layer, &x, &y, &w, &h);
+
+  move->ctl_layer = layer;
+  move->ctl_stamp = stamp;
+
+  if (valid != move->ctl_valid ||
+      x != move->ctl_x || y != move->ctl_y ||
+      w != move->ctl_w || h != move->ctl_h)
+    {
+      move->ctl_valid = valid;
+      move->ctl_x = x; move->ctl_y = y; move->ctl_w = w; move->ctl_h = h;
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+static gboolean
+chopgimp_move_on_handle (GimpMoveTool     *move,
+                         GimpDisplay      *display,
+                         const GimpCoords *coords)
+{
+  GimpDrawTool *draw_tool = GIMP_DRAW_TOOL (move);
+  gdouble       xs[3], ys[3];
+  gint          i, j;
+
+  if (! move->ctl_valid)
+    return FALSE;
+
+  xs[0] = move->ctl_x; xs[1] = move->ctl_x + move->ctl_w / 2.0; xs[2] = move->ctl_x + move->ctl_w;
+  ys[0] = move->ctl_y; ys[1] = move->ctl_y + move->ctl_h / 2.0; ys[2] = move->ctl_y + move->ctl_h;
+
+  for (i = 0; i < 3; i++)
+    for (j = 0; j < 3; j++)
+      if ((i != 1 || j != 1) &&
+          gimp_draw_tool_on_handle (draw_tool, display, coords->x, coords->y,
+                                    GIMP_HANDLE_SQUARE, xs[i], ys[j],
+                                    CTL_HANDLE + 4, CTL_HANDLE + 4,
+                                    GIMP_HANDLE_ANCHOR_CENTER))
+        return TRUE;
+
+  return FALSE;
+}
+
 static void
 gimp_move_tool_oper_update (GimpTool         *tool,
                             const GimpCoords *coords,
@@ -548,6 +632,27 @@ gimp_move_tool_oper_update (GimpTool         *tool,
                                        FUNSCALEY (shell, snap_distance));
     }
 
+  if (options->move_type == GIMP_TRANSFORM_TYPE_LAYER)
+    {
+      GimpDrawTool *draw_tool = GIMP_DRAW_TOOL (tool);
+      gboolean      changed   = chopgimp_move_update_controls (move, image);
+
+      if (changed || (move->ctl_valid && ! gimp_draw_tool_is_active (draw_tool)) ||
+          (gimp_draw_tool_is_active (draw_tool) && draw_tool->display != display))
+        {
+          gimp_draw_tool_pause (draw_tool);
+
+          if (gimp_draw_tool_is_active (draw_tool) &&
+              draw_tool->display != display)
+            gimp_draw_tool_stop (draw_tool);
+
+          if (! gimp_draw_tool_is_active (draw_tool))
+            gimp_draw_tool_start (draw_tool, display);
+
+          gimp_draw_tool_resume (draw_tool);
+        }
+    }
+
   if (gimp_g_list_compare (guides, move->guides))
     {
       GimpDrawTool *draw_tool = GIMP_DRAW_TOOL (tool);
@@ -693,8 +798,30 @@ gimp_move_tool_cursor_update (GimpTool         *tool,
 static void
 gimp_move_tool_draw (GimpDrawTool *draw_tool)
 {
-  GimpMoveTool *move = GIMP_MOVE_TOOL (draw_tool);
-  GList        *iter;
+  GimpMoveTool    *move    = GIMP_MOVE_TOOL (draw_tool);
+  GimpMoveOptions *options = GIMP_MOVE_TOOL_GET_OPTIONS (draw_tool);
+  GList           *iter;
+
+  /*  ChopGimp: Photoshop « Show Transform Controls »  */
+  if (move->ctl_valid && options->move_type == GIMP_TRANSFORM_TYPE_LAYER)
+    {
+      gdouble xs[3], ys[3];
+      gint    i, j;
+
+      gimp_draw_tool_add_rectangle (draw_tool, FALSE,
+                                    move->ctl_x, move->ctl_y,
+                                    move->ctl_w, move->ctl_h);
+
+      xs[0] = move->ctl_x; xs[1] = move->ctl_x + move->ctl_w / 2.0; xs[2] = move->ctl_x + move->ctl_w;
+      ys[0] = move->ctl_y; ys[1] = move->ctl_y + move->ctl_h / 2.0; ys[2] = move->ctl_y + move->ctl_h;
+
+      for (i = 0; i < 3; i++)
+        for (j = 0; j < 3; j++)
+          if (i != 1 || j != 1)
+            gimp_draw_tool_add_handle (draw_tool, GIMP_HANDLE_SQUARE,
+                                       xs[i], ys[j], CTL_HANDLE, CTL_HANDLE,
+                                       GIMP_HANDLE_ANCHOR_CENTER);
+    }
 
   for (iter = move->guides; iter; iter = g_list_next (iter))
     {
