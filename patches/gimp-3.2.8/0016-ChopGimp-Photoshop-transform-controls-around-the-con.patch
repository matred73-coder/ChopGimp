+/*  TRUE while a transform was started from the move tool's controls:
+ *  committing or cancelling it goes back to the move tool.
+ */
+extern gboolean chopgimp_transform_from_move;
+
+gboolean chopgimp_layer_content_bounds   (GimpLayer        *layer,
+                                          gint             *x,
+                                          gint             *y,
+                                          gint             *width,
+                                          gint             *height);
+gboolean chopgimp_crop_layer_to_content  (GimpImage        *image,
