+/*  3.27.6: the « distort-* » and width profile commands  */
+static gboolean
+chopgimp_vobjects_distort_command (GimpVectorLayer *layer,
+                                   const gchar     *cmd)
+{
+  gchar  **v = g_strsplit (cmd, ":", -1);
+  gint     n = g_strv_length (v);
+  gboolean done = FALSE;
+
+  if (! strcmp (v[0], "distort-warp"))
+    {
+      ChopGimpDistort d;
+
+      chopgimp_vdistort_init (&d);
+      d.mode = CHOPGIMP_DISTORT_WARP;
+      if (n > 1) { g_free (d.style); d.style = g_strdup (v[1]); }
+      if (n > 2) d.bend     = g_ascii_strtod (v[2], NULL);
+      if (n > 3) d.hdist    = g_ascii_strtod (v[3], NULL);
+      if (n > 4) d.vdist    = g_ascii_strtod (v[4], NULL);
+      if (n > 5) d.vertical = atoi (v[5]) != 0;
+      done = chopgimp_vdistort_make (layer, &d, "Déformation");
+      chopgimp_vdistort_clear (&d);
+    }
+  else if (! strcmp (v[0], "distort-mesh") || ! strcmp (v[0], "distort-free"))
+    {
+      ChopGimpDistort d;
+
+      chopgimp_vdistort_init (&d);
+      d.mode = strcmp (v[0], "distort-free") ? CHOPGIMP_DISTORT_MESH : CHOPGIMP_DISTORT_FREE;
+      if (d.mode == CHOPGIMP_DISTORT_MESH)
+        {
+          d.rows = n > 1 ? CLAMP (atoi (v[1]), 1, 20) : 4;
+          d.cols = n > 2 ? CLAMP (atoi (v[2]), 1, 20) : 4;
+        }
+      done = chopgimp_vdistort_make (layer, &d, "Enveloppe");
+      chopgimp_vdistort_clear (&d);
+    }
+  else if (! strcmp (v[0], "distort-mesh-point") && n == 4)
+    {
+      GList *t = chopgimp_vdistort_targets (layer);
+      gint   k = atoi (v[1]);
+
+      chopgimp_vlayer_push_undo (layer, "Modifier l'enveloppe");
+      for (GList *l = t; l; l = l->next)
+        {
+          ChopGimpDistort d;
+
+          chopgimp_vdistort_init (&d);
+          if (chopgimp_vdistort_get (l->data, &d) && d.mode != CHOPGIMP_DISTORT_WARP &&
+              k >= 0 && k < (d.rows + 1) * (d.cols + 1))
+            {
+              d.mesh[2 * k]     = g_ascii_strtod (v[2], NULL);
+              d.mesh[2 * k + 1] = g_ascii_strtod (v[3], NULL);
+              chopgimp_vdistort_set (layer, ((ChopGimpVObject *) l->data)->id, &d, FALSE);
+              done = TRUE;
+            }
+          chopgimp_vdistort_clear (&d);
+        }
+      g_list_free (t);
+    }
+  else if (! strcmp (v[0], "distort-top"))
+    done = chopgimp_vdistort_make_top (layer, n > 1 ? atoi (v[1]) : 4, n > 2 ? atoi (v[2]) : 8);
+  else if (! strcmp (v[0], "distort-expand"))
+    done = chopgimp_vdistort_expand (layer);
+  else if (! strcmp (v[0], "distort-release"))
+    done = chopgimp_vdistort_release (layer);
+  else if (! strcmp (v[0], "width-profile") || ! strcmp (v[0], "save-profile"))
+    {
+      const gchar *arg = strchr (cmd, ':') + 1;
+      GList       *t   = chopgimp_vdistort_targets (layer);
+
+      if (! strcmp (v[0], "save-profile"))
+        {
+          ChopGimpVEntry *e = t ? chopgimp_vstyle_get_stroke (&((ChopGimpVObject *) t->data)->style)
+                                : NULL;
+
+          if (e && *arg)
+            {
+              chopgimp_vstyle_save_profile (arg, chopgimp_vstyle_get_profile_points (e->profile));
+              done = TRUE;
+            }
+        }
+      else if (t)
+        {
+          chopgimp_vlayer_push_undo (layer, "Profil de largeur");
+          for (GList *l = t; l; l = l->next)
+            {
+              ChopGimpVObject *o = l->data;
+              ChopGimpVEntry  *e = chopgimp_vstyle_get_stroke (&o->style);
+
+              if (! e)
+                continue;
+
+              g_free (e->profile);
+              e->profile = strcmp (arg, "uniform") ? g_strdup (arg) : NULL;
+              chopgimp_vlayer_object_changed (layer, o);
+              done = TRUE;
+            }
+        }
+
+      g_list_free (t);
+    }
+
+  g_strfreev (v);
+
+  return done;
+}
