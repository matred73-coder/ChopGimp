+/*  ─── 3.27.6 (lot V6 point 8): « Objet > Distorsion » ──────────────── */
+
+static void
+distort_select_tool (GimpImage   *image,
+                     gpointer     data,
+                     const gchar *tool_name)
+{
+  GimpContext  *context = action_data_get_context (data);
+  GimpToolInfo *info    = gimp_get_tool_info (image->gimp, tool_name);
+
+  if (context && info)
+    gimp_context_set_tool (context, info);
+}
+
+void
+vector_objects_distort_warp_cmd_callback (GimpAction *action,
+                                          GVariant   *value,
+                                          gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  return_if_no_vlayer (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  chopgimp_distort_dialog_show (image, layer, CHOPGIMP_DISTORT_DIALOG_WARP, widget);
+}
+
+void
+vector_objects_distort_mesh_cmd_callback (GimpAction *action,
+                                          GVariant   *value,
+                                          gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  return_if_no_vlayer (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  if (chopgimp_distort_dialog_show (image, layer, CHOPGIMP_DISTORT_DIALOG_MESH, widget))
+    distort_select_tool (image, data, "gimp-envelope-tool");
+}
+
+void
+vector_objects_distort_top_cmd_callback (GimpAction *action,
+                                         GVariant   *value,
+                                         gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_vlayer (image, layer, data);
+
+  if (chopgimp_vdistort_make_top (layer, 4, 8))
+    distort_select_tool (image, data, "gimp-envelope-tool");
+}
+
+void
+vector_objects_distort_free_cmd_callback (GimpAction *action,
+                                          GVariant   *value,
+                                          gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  ChopGimpDistort  d;
+  return_if_no_vlayer (image, layer, data);
+
+  chopgimp_vdistort_init (&d);
+  d.mode = CHOPGIMP_DISTORT_FREE;
+
+  if (chopgimp_vdistort_make (layer, &d, _("Distorsion libre")))
+    distort_select_tool (image, data, "gimp-envelope-tool");
+
+  chopgimp_vdistort_clear (&d);
+}
+
+void
+vector_objects_distort_edit_envelope_cmd_callback (GimpAction *action,
+                                                   GVariant   *value,
+                                                   gpointer    data)
+{
+  GimpImage *image;
+  return_if_no_image (image, data);
+
+  distort_select_tool (image, data, "gimp-envelope-tool");
+}
+
+void
+vector_objects_distort_edit_contents_cmd_callback (GimpAction *action,
+                                                   GVariant   *value,
+                                                   gpointer    data)
+{
+  GimpImage *image;
+  return_if_no_image (image, data);
+
+  distort_select_tool (image, data, "gimp-direct-select-tool");
+}
