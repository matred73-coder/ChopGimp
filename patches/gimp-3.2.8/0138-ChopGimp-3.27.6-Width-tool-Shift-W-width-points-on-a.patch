@@ -501,6 +509,91 @@ chopgimp_trace_layer_get (GimpVectorLayer       *layer,
   return ok;
 }
 
+/*  3.27.6: the objects moved as a whole without the matrix following
+ *  (the Paths tool moves the strokes of the layer's path itself, and
+ *  undoing that does not undo the matrix): the translation is found from
+ *  the weighted sums of the signature and the matrix is set right.
+ *  Returns TRUE when it changed.
+ */
+gboolean
+chopgimp_trace_layer_sync_matrix (GimpVectorLayer *layer)
+{
+  const GimpParasite *parasite;
+  GHashTable         *keys;
+  const guchar       *png;
+  gsize               png_size;
+  const gchar        *stored;
+  gchar              *cur;
+  gchar             **ta, **tb;
+  gboolean            changed = FALSE;
+  gdouble             matrix[6];
+
+  if (! chopgimp_trace_layer_is_live (GIMP_ITEM (layer)))
+    return FALSE;
+
+  parasite = gimp_item_parasite_find (GIMP_ITEM (layer), CHOPGIMP_TRACE_PARASITE);
+  keys     = parse_header (parasite, &png, &png_size);
+  if (! keys)
+    return FALSE;
+
+  stored = g_hash_table_lookup (keys, "sig");
+  if (! stored)
+    {
+      g_hash_table_unref (keys);
+      return FALSE;
+    }
+
+  chopgimp_trace_layer_get_matrix (layer, matrix);
+  cur = objects_signature (layer, matrix);
+
+  ta = g_strsplit (stored, " ", -1);
+  tb = g_strsplit (cur, " ", -1);
+
+  if (g_strv_length (ta) == 9 && g_strv_length (tb) == 9 &&
+      ! strcmp (ta[0], tb[0]) && ! strcmp (ta[1], tb[1]) &&
+      ! signatures_match (stored, cur))
+    {
+      gdouble W1  = g_ascii_strtod (ta[7], NULL);
+      gdouble W2  = g_ascii_strtod (ta[8], NULL);
+      gdouble rms = MAX (g_ascii_strtod (ta[6], NULL), g_ascii_strtod (tb[6], NULL));
+      gdouble tol = 1e-3 + 4e-7 * rms;
+      gdouble d[4];
+
+      for (gint i = 0; i < 4; i++)
+        d[i] = g_ascii_strtod (tb[i + 2], NULL) - g_ascii_strtod (ta[i + 2], NULL);
+
+      if (W1 > 0 && W2 > 0)
+        {
+          gdouble ax = d[0] / W1, ay = d[1] / W1;
+          gdouble bx = d[2] / W2, by = d[3] / W2;
+          gdouble e  = 4 * tol / MIN (W1, W2);
+
+          /*  the same shift for both weightings: a translation  */
+          if (fabs (ax - bx) <= e + 1e-6 * fabs (ax) &&
+              fabs (ay - by) <= e + 1e-6 * fabs (ay))
+            {
+              gdouble tx = (ax + bx) / 2, ty = (ay + by) / 2;
+              gdouble m[6];
+
+              /*  shift in traced coordinates → in the image  */
+              m[0] = 1.0; m[1] = 0.0; m[2] = 0.0; m[3] = 1.0;
+              m[4] = matrix[0] * tx + matrix[2] * ty;
+              m[5] = matrix[1] * tx + matrix[3] * ty;
+
+              chopgimp_trace_layer_transformed (layer, m, FALSE);
+              changed = TRUE;
+            }
+        }
+    }
+
+  g_strfreev (ta);
+  g_strfreev (tb);
+  g_free (cur);
+  g_hash_table_unref (keys);
+
+  return changed;
+}
+
 gboolean
 chopgimp_trace_layer_is_edited (GimpVectorLayer *layer)
 {
@@ -523,6 +616,12 @@ chopgimp_trace_layer_is_edited (GimpVectorLayer *layer)
     {
       gdouble matrix[6];
 
+      if (chopgimp_trace_layer_sync_matrix (layer))
+        {
+          g_hash_table_unref (keys);
+          return chopgimp_trace_layer_is_edited (layer);
+        }
+
       chopgimp_trace_layer_get_matrix (layer, matrix);
       sum    = objects_signature (layer, matrix);
       edited = ! signatures_match (sum, g_hash_table_lookup (keys, "sig"));
@@ -748,6 +847,7 @@ chopgimp_trace_layer_update (GimpVectorLayer            *layer,
     return FALSE;
 
   /*  traced coordinates → where the layer is now  */
+  chopgimp_trace_layer_sync_matrix (layer);
   chopgimp_trace_layer_get_matrix (layer, matrix);
   xml = chopgimp_trace_result_to_xml (result, flat, matrix);
   if (! xml)
