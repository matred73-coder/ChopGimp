index 0000000..c93e186
--- /dev/null
+++ b/app/widgets/chopgimp-width-profile-box.c
@@ -0,0 +1,306 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-width-profile-box.c — ChopGimp 3.27.6 (see the header)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "widgets-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpcontext.h"
+#include "core/gimpimage.h"
+
+#include "path/gimppath.h"
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vobject-ops.h"
+#include "path/chopgimp-vdistort.h"
+
+#include "chopgimp-width-profile-box.h"
+
+#include "gimp-intl.h"
+
+
+typedef struct
+{
+  Gimp      *gimp;
+  GtkWidget *combo;
+  gint       n;          /* presets + 1 (« Personnalisé »)  */
+  gboolean   loading;
+} Box;
+
+static GList *boxes = NULL;
+
+
+static GimpVectorLayer *
+box_layer (Box *b)
+{
+  GimpImage *image = gimp_context_get_image (gimp_get_user_context (b->gimp));
+
+  return image ? chopgimp_vobjects_get_target_layer (image) : NULL;
+}
+
+/*  the primary strokes of the selected path objects  */
+static GList *
+box_targets (Box              *b,
+             GimpVectorLayer **layer)
+{
+  GList *leaves;
+  GList *out = NULL;
+
+  *layer = box_layer (b);
+  if (! *layer)
+    return NULL;
+
+  leaves = chopgimp_vdistort_targets (*layer);
+
+  for (GList *l = leaves; l; l = l->next)
+    if (chopgimp_vstyle_get_stroke (&((ChopGimpVObject *) l->data)->style))
+      out = g_list_append (out, l->data);
+
+  g_list_free (leaves);
+
+  return out;
+}
+
+static void
+box_fill (Box *b)
+{
+  const gchar * const *names = chopgimp_vstyle_get_profile_presets ();
+
+  b->loading = TRUE;
+  gtk_combo_box_text_remove_all (GTK_COMBO_BOX_TEXT (b->combo));
+
+  b->n = 0;
+  for (const gchar * const *n = names; *n; n++, b->n++)
+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (b->combo),
+                                    chopgimp_vstyle_get_profile_label (*n));
+
+  gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (b->combo), _("Personnalisé"));
+  b->n++;
+  b->loading = FALSE;
+}
+
+static void
+box_update (Box *b)
+{
+  GimpVectorLayer *layer;
+  GList           *t = box_targets (b, &layer);
+  gint             k = -1;
+
+  if (b->n != (gint) g_strv_length ((gchar **) chopgimp_vstyle_get_profile_presets ()) + 1)
+    box_fill (b);
+
+  if (t)
+    {
+      ChopGimpVEntry *e = chopgimp_vstyle_get_stroke (&((ChopGimpVObject *) t->data)->style);
+
+      k = chopgimp_vstyle_find_profile (e->profile);
+      if (k < 0)
+        k = b->n - 1;
+    }
+
+  b->loading = TRUE;
+  gtk_combo_box_set_active (GTK_COMBO_BOX (b->combo), k);
+  gtk_widget_set_sensitive (b->combo, t != NULL);
+  b->loading = FALSE;
+
+  g_list_free (t);
+}
+
+void
+chopgimp_width_profile_boxes_update (void)
+{
+  for (GList *l = boxes; l; l = l->next)
+    box_update (l->data);
+}
+
+static void
+box_apply (Box         *b,
+           const gchar *profile,
+           const gchar *undo_desc)
+{
+  GimpVectorLayer *layer;
+  GList           *t = box_targets (b, &layer);
+
+  if (! t)
+    return;
+
+  chopgimp_vlayer_push_undo (layer, undo_desc);
+
+  for (GList *l = t; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      ChopGimpVEntry  *e = chopgimp_vstyle_get_stroke (&o->style);
+
+      g_free (e->profile);
+      e->profile = (profile && strcmp (profile, "uniform")) ? g_strdup (profile) : NULL;
+      chopgimp_vlayer_object_changed (layer, o);
+    }
+
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+  g_list_free (t);
+
+  chopgimp_width_profile_boxes_update ();
+}
+
+static void
+box_changed (GtkComboBox *combo,
+             Box         *b)
+{
+  gint i = gtk_combo_box_get_active (combo);
+
+  if (b->loading || i < 0 || i >= b->n - 1)
+    return;
+
+  box_apply (b, chopgimp_vstyle_get_profile_presets ()[i], _("Profil de largeur"));
+}
+
+static void
+box_reset (GtkButton *button,
+           Box       *b)
+{
+  box_apply (b, NULL, _("Profil de largeur uniforme"));
+}
+
+static void
+box_save (GtkButton *button,
+          Box       *b)
+{
+  GimpVectorLayer *layer;
+  GList           *t = box_targets (b, &layer);
+  GtkWidget       *dialog, *entry, *content;
+  const gchar     *points;
+
+  if (! t)
+    return;
+
+  points = chopgimp_vstyle_get_profile_points (
+             chopgimp_vstyle_get_stroke (&((ChopGimpVObject *) t->data)->style)->profile);
+
+  dialog = gtk_dialog_new_with_buttons (_("Enregistrer le profil de largeur"),
+                                        GTK_WINDOW (gtk_widget_get_toplevel (GTK_WIDGET (button))),
+                                        GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
+                                        _("_Annuler"), GTK_RESPONSE_CANCEL,
+                                        _("_Enregistrer"), GTK_RESPONSE_OK,
+                                        NULL);
+  gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_OK);
+
+  content = gtk_dialog_get_content_area (GTK_DIALOG (dialog));
+  gtk_container_set_border_width (GTK_CONTAINER (content), 12);
+  gtk_box_set_spacing (GTK_BOX (content), 6);
+  gtk_box_pack_start (GTK_BOX (content),
+                      gtk_label_new (_("Nom du profil (réutilisable dans le panneau "
+                                       "Contour et l'outil Largeur) :")),
+                      FALSE, FALSE, 0);
+
+  entry = gtk_entry_new ();
+  gtk_entry_set_text (GTK_ENTRY (entry), _("Mon profil"));
+  gtk_entry_set_activates_default (GTK_ENTRY (entry), TRUE);
+  gtk_box_pack_start (GTK_BOX (content), entry, FALSE, FALSE, 0);
+  gtk_widget_show_all (content);
+
+  if (gtk_dialog_run (GTK_DIALOG (dialog)) == GTK_RESPONSE_OK)
+    {
+      gchar *name = g_strstrip (g_strdup (gtk_entry_get_text (GTK_ENTRY (entry))));
+
+      /*  a key of the key file: no « [ ] = » nor line breaks  */
+      g_strdelimit (name, "[]=\n\r", '_');
+
+      if (*name && points)
+        {
+          gchar *copy = g_strdup (points);
+
+          chopgimp_vstyle_save_profile (name, copy);
+          /*  the object follows the saved profile (same points)  */
+          box_apply (b, copy, _("Profil de largeur"));
+          g_free (copy);
+        }
+
+      g_free (name);
+    }
+
+  gtk_widget_destroy (dialog);
+  g_list_free (t);
+
+  chopgimp_width_profile_boxes_update ();
+}
+
+static void
+box_destroyed (gpointer  data,
+               GObject  *where)
+{
+  boxes = g_list_remove (boxes, data);
+  g_free (data);
+}
+
+static void
+box_map (GtkWidget *widget,
+         Box       *b)
+{
+  box_update (b);
+}
+
+static void
+box_popup (GObject    *combo,
+           GParamSpec *pspec,
+           Box        *b)
+{
+  gboolean shown;
+
+  g_object_get (combo, "popup-shown", &shown, NULL);
+  if (shown)
+    box_update (b);
+}
+
+GtkWidget *
+chopgimp_width_profile_box_new (Gimp *gimp)
+{
+  Box       *b    = g_new0 (Box, 1);
+  GtkWidget *hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  GtkWidget *button;
+
+  b->gimp  = gimp;
+  b->combo = gtk_combo_box_text_new ();
+  box_fill (b);
+
+  gimp_help_set_help_data (b->combo,
+                           _("Profil de largeur du contour des objets sélectionnés "
+                             "(l'outil Largeur crée un profil « Personnalisé »)"), NULL);
+  g_signal_connect (b->combo, "changed", G_CALLBACK (box_changed), b);
+  g_signal_connect (b->combo, "notify::popup-shown", G_CALLBACK (box_popup), b);
+  gtk_box_pack_start (GTK_BOX (hbox), b->combo, FALSE, FALSE, 0);
+
+  button = gtk_button_new_with_label (_("Enregistrer…"));
+  gimp_help_set_help_data (button,
+                           _("Enregistrer le profil de largeur de l'objet sélectionné "
+                             "pour le réutiliser"), NULL);
+  g_signal_connect (button, "clicked", G_CALLBACK (box_save), b);
+  gtk_box_pack_start (GTK_BOX (hbox), button, FALSE, FALSE, 0);
+
+  button = gtk_button_new_with_label (_("Uniforme"));
+  gimp_help_set_help_data (button, _("Retirer le profil : épaisseur constante"), NULL);
+  g_signal_connect (button, "clicked", G_CALLBACK (box_reset), b);
+  gtk_box_pack_start (GTK_BOX (hbox), button, FALSE, FALSE, 0);
+
+  g_signal_connect (hbox, "map", G_CALLBACK (box_map), b);
+  g_object_weak_ref (G_OBJECT (hbox), box_destroyed, b);
+  boxes = g_list_prepend (boxes, b);
+
+  gtk_widget_show_all (hbox);
+
+  return hbox;
+}
