 }
 
+static Point
+disp_at (const std::vector<Point> &grid, int cols, int i, int j,
+         const Geom::Rect &bb, int rows)
+{
+  i = CLAMP (i, 0, rows);
+  j = CLAMP (j, 0, cols);
+
+  return grid[i * (cols + 1) + j] -
+         Point (bb.left () + (double) j / cols * bb.width (),
+                bb.top ()  + (double) i / rows * bb.height ());
+}
+
+/*  3.27.6 « Enveloppe »: the (rows + 1) × (cols + 1) points of the mesh,
+ *  row by row, from @spec « dx,dy;dx,dy;… » (offsets from the regular
+ *  grid over @bb, in fractions of its size; missing points: no offset)
+ */
+static std::vector<Point>
+chopgimp_distort_mesh_points (const std::string &spec, int rows, int cols,
+                              const Geom::Rect &bb)
+{
+  std::vector<Point>  grid;
+  gchar             **items = g_strsplit (spec.c_str (), ";", -1);
+  int                 n     = items ? g_strv_length (items) : 0;
+
+  for (int i = 0; i <= rows; i++)
+    for (int j = 0; j <= cols; j++)
+      {
+        int    k  = i * (cols + 1) + j;
+        double dx = 0, dy = 0;
+
+        if (k < n && items[k] && *items[k])
+          {
+            gchar *comma = strchr (items[k], ',');
+
+            dx = g_ascii_strtod (items[k], NULL);
+            dy = comma ? g_ascii_strtod (comma + 1, NULL) : 0;
+          }
+
+        grid.push_back (Point (bb.left () + ((double) j / cols + dx) * bb.width (),
+                               bb.top ()  + ((double) i / rows + dy) * bb.height ()));
+      }
+
+  g_strfreev (items);
+
+  return grid;
