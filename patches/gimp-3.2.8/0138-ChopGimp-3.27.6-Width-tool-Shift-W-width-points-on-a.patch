+/*  3.27.6: a stroke of varying width, @left / @right: the full width
+ *  each side would have if it were symmetric (the side gets half of it)
+ */
 static Geom::Path
-width_shape (const std::vector<Point> &pts, bool closed,
-             std::function<double (double)> width)
+width_shape2 (const std::vector<Point> &pts, bool closed,
+              std::function<double (double)> left,
