+/*  ChopGimp: the image canvas, in the drawable's coordinates, for the
+ *  gradient or pattern of a stroke (chopgimp:stroke) not aligned with
+ *  the layer; nothing is rendered again for any other stroke
+ */
+static void
+gimp_drawable_filter_sync_canvas (GimpDrawableFilter *filter)
+{
+  GeglOperation *op;
+  GimpImage     *image;
+  GeglRectangle  canvas;
+  gint           off_x, off_y;
+
+  if (! filter->drawable || ! filter->operation)
+    return;
+
+  op = gegl_node_get_gegl_operation (filter->operation);
+
+  if (! GIMP_IS_OPERATION_CONTOUR (op))
+    return;
+
+  image = gimp_item_get_image (GIMP_ITEM (filter->drawable));
+
+  if (! image)
+    return;
+
+  gimp_item_get_offset (GIMP_ITEM (filter->drawable), &off_x, &off_y);
+
+  canvas.x      = -off_x;
+  canvas.y      = -off_y;
+  canvas.width  = gimp_image_get_width  (image);
+  canvas.height = gimp_image_get_height (image);
+
+  if (gimp_operation_contour_set_canvas (GIMP_OPERATION_CONTOUR (op), &canvas))
+    {
+      gegl_operation_invalidate (op, NULL, TRUE);
+
+      if (gimp_drawable_filter_is_added (filter))
+        {
+          /*  a fused style (gimpdrawable-fused-styles.c) takes the
+           *  stroke's snapshot again
+           */
+          gimp_drawable_filters_changed (filter->drawable);
+
+          if (gimp_drawable_filter_is_active (filter))
+            gimp_drawable_filter_update_drawable (filter, NULL);
+        }
+    }
+}
