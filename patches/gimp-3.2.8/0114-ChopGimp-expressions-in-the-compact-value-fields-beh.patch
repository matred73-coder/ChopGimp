diff --git a/app/core/chopgimp-behind-effects.c b/app/core/chopgimp-behind-effects.c
index 9987ac4..42abab9 100644
--- a/app/core/chopgimp-behind-effects.c
+++ b/app/core/chopgimp-behind-effects.c
@@ -102,12 +102,40 @@ typedef struct
   GeglNode     *node;       /*  the layer's node, once built     */
   GArray       *entries;    /*  Entry, bottom up                 */
   gint          suspended;
+
+  /*  previews: the behind effects under the filtered drawable  */
+  GeglNode     *preview;          /*  graph of gegl:over nodes          */
+  GPtrArray    *preview_inputs;   /*  knockouts bottom up, then source  */
+  GPtrArray    *preview_overs;    /*  gegl:over, bottom up              */
+  GPtrArray    *preview_links;    /*  producers (input, aux) per over   */
 } State;
 
 
+static void
+preview_clear (State *state)
+{
+  /*  a buffer still rendering a gegl:over node (a validate handler of
+   *  gimp_drawable_get_buffer_with_effects()) keeps it, linked
+   */
+  g_clear_object (&state->preview);
+
+  if (state->preview_inputs)
+    g_ptr_array_set_size (state->preview_inputs, 0);
+  if (state->preview_overs)
+    g_ptr_array_set_size (state->preview_overs, 0);
+  if (state->preview_links)
+    g_ptr_array_set_size (state->preview_links, 0);
+}
+
 static void
 state_free (State *state)
 {
+  preview_clear (state);
+
+  g_clear_pointer (&state->preview_inputs, g_ptr_array_unref);
+  g_clear_pointer (&state->preview_overs,  g_ptr_array_unref);
+  g_clear_pointer (&state->preview_links,  g_ptr_array_unref);
+
   g_array_free (state->entries, TRUE);
   g_slice_free (State, state);
 }
@@ -615,6 +643,128 @@ chopgimp_behind_effects_add_bounding_box (GimpDrawable  *drawable,
     }
 }
 
+/*  ChopGimp: previews and pickers (gimp_drawable_get_buffer_with_effects(),
+ *  the reduced copy of gimpdrawable-preview.c) read the filtered drawable,
+ *  where the behind effects are not: they are composited onto the layers
+ *  below, in the layer's node. As Photoshop's thumbnails, they are shown
+ *  composited NORMAL under the drawable:
+ *
+ *    knockout 1 -> over -> ... -> over -> output
+ *                  ^aux           ^aux
+ *               knockout 2       source
+ *
+ *  The gegl:over nodes are kept between calls (main thread), and built
+ *  again when the behind effects or the source change, or a producer
+ *  went away. Without behind effects, @source is returned.
+ */
+GeglNode *
+chopgimp_behind_effects_get_preview_source (GimpDrawable *drawable,
+                                            GeglNode     *source)
+{
+  State    *state;
+  GList    *behind;
+  GList    *list;
+  gboolean  same;
+  guint     n;
+  guint     i;
+
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), source);
+
+  state = get_state (drawable);
+
+  if (! state || ! source)
+    return source;
+
+  behind = NULL;
+
+  if (! state->suspended &&
+      ! gimp_drawable_get_filters_bypass (drawable))
+    behind = gimp_filter_stack_get_behind (GIMP_FILTER_STACK (gimp_drawable_get_filters (drawable)));
+
+  if (! behind)
+    {
+      if (state->preview)
+        preview_clear (state);
+
+      return source;
+    }
+
+  if (! state->preview_inputs)
+    {
+      state->preview_inputs = g_ptr_array_new ();
+      state->preview_overs  = g_ptr_array_new ();
+      state->preview_links  = g_ptr_array_new ();
+    }
+
+  n = g_list_length (behind) + 1;
+
+  /*  the same inputs, still linked?  */
+  same = (state->preview && state->preview_inputs->len == n);
+
+  for (list = behind, i = 0; same && list; list = g_list_next (list), i++)
+    {
+      GimpFilterStackBehind *b = list->data;
+
+      if (g_ptr_array_index (state->preview_inputs, i) != (gpointer) b->knockout)
+        same = FALSE;
+    }
+
+  if (same && g_ptr_array_index (state->preview_inputs, n - 1) != (gpointer) source)
+    same = FALSE;
+
+  for (i = 0; same && i < state->preview_overs->len; i++)
+    {
+      GeglNode *over = g_ptr_array_index (state->preview_overs, i);
+
+      if (gegl_node_get_producer (over, "input", NULL) !=
+          g_ptr_array_index (state->preview_links, 2 * i)    ||
+          gegl_node_get_producer (over, "aux", NULL) !=
+          g_ptr_array_index (state->preview_links, 2 * i + 1))
+        same = FALSE;
+    }
+
+  if (same)
+    return g_ptr_array_index (state->preview_overs,
+                              state->preview_overs->len - 1);
+
+  preview_clear (state);
+
+  state->preview = gegl_node_new ();
+
+  for (list = behind; list; list = g_list_next (list))
+    {
+      GimpFilterStackBehind *b = list->data;
+
+      g_ptr_array_add (state->preview_inputs, b->knockout);
+    }
+
+  g_ptr_array_add (state->preview_inputs, source);
+
+  for (i = 1; i < n; i++)
+    {
+      GeglNode *over = gegl_node_new_child (state->preview,
+                                            "operation", "gegl:over",
+                                            NULL);
+      GeglNode *below;
+
+      below = (i == 1) ? g_ptr_array_index (state->preview_inputs, 0) :
+                         g_ptr_array_index (state->preview_overs, i - 2);
+
+      gegl_node_connect (below, "output", over, "input");
+      gegl_node_connect (g_ptr_array_index (state->preview_inputs, i), "output",
+                         over, "aux");
+
+      g_ptr_array_add (state->preview_overs, over);
+      g_ptr_array_add (state->preview_links,
+                       gegl_node_get_producer (over, "input", NULL));
+      g_ptr_array_add (state->preview_links,
+                       gegl_node_get_producer (over, "aux", NULL));
+    }
+
+  return g_ptr_array_index (state->preview_overs,
+                            state->preview_overs->len - 1);
+}
