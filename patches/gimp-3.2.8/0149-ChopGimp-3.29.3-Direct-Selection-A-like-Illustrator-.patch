+/*  3.29.3: selection by color, cleaning, colors (Illustrator)  */
+static gboolean v_same_fill   (GimpVectorLayer *l) { return chopgimp_vobjects_select_same (l, CHOPGIMP_VSAME_FILL); }
+static gboolean v_same_stroke (GimpVectorLayer *l) { return chopgimp_vobjects_select_same (l, CHOPGIMP_VSAME_STROKE); }
+static gboolean v_same_color  (GimpVectorLayer *l) { return chopgimp_vobjects_select_same (l, CHOPGIMP_VSAME_COLOR); }
+static gboolean v_merge_same  (GimpVectorLayer *l) { return chopgimp_vobjects_merge_same_color (l) >= 0; }
+static gboolean v_fill_none   (GimpVectorLayer *l) { return chopgimp_vobjects_apply_color (l, NULL, FALSE, TRUE); }
+static gboolean v_stroke_none (GimpVectorLayer *l) { return chopgimp_vobjects_apply_color (l, NULL, TRUE, TRUE); }
+
+static gboolean v_next_below (GimpVectorLayer *l) { return chopgimp_vobjects_select_adjacent (l, FALSE); }
+static gboolean v_next_above (GimpVectorLayer *l) { return chopgimp_vobjects_select_adjacent (l, TRUE); }
+
+SIMPLE_COMMAND (select_next_below,  v_next_below)
+SIMPLE_COMMAND (select_next_above,  v_next_above)
+SIMPLE_COMMAND (select_same_fill,   v_same_fill)
+SIMPLE_COMMAND (select_same_stroke, v_same_stroke)
+SIMPLE_COMMAND (select_same_color,  v_same_color)
+SIMPLE_COMMAND (select_inverse,     chopgimp_vobjects_select_inverse)
+SIMPLE_COMMAND (merge_same_color,   v_merge_same)
+SIMPLE_COMMAND (swap_fill_stroke,   chopgimp_vobjects_swap_fill_stroke)
+SIMPLE_COMMAND (fill_none,          v_fill_none)
+SIMPLE_COMMAND (stroke_none,        v_stroke_none)
+SIMPLE_COMMAND (lock_others,        chopgimp_vobjects_lock_others)
+SIMPLE_COMMAND (hide_others,        chopgimp_vobjects_hide_others)
+
+/*  « Objets plus petits que… » / « Supprimer les petits objets… »: the
+ *  threshold is a side in pixels (area = side²), remembered
+ */
+static gint vobjects_small_side = 6;
+
+static void
+vobjects_small_callback (GtkWidget *query_box,
+                         gint       value,
+                         gpointer   data)
+{
+  GimpImage       *image  = g_object_get_data (G_OBJECT (query_box), "chopgimp-image");
+  GimpVectorLayer *layer  = image ? chopgimp_vobjects_get_active_layer (image) : NULL;
+  gboolean         delete = GPOINTER_TO_INT (data);
+
+  vobjects_small_side = value;
+
+  if (! layer)
+    return;
+
+  if (delete)
+    chopgimp_vobjects_delete_smaller (layer, (gdouble) value * value);
+  else
+    chopgimp_vobjects_select_smaller (layer, (gdouble) value * value);
+
+  gimp_image_flush (image);
+}
+
+static void
+vobjects_small_query (GimpAction *action,
+                      gpointer    data,
+                      gboolean    delete)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *box;
+  return_if_no_vlayer (image, layer, data);
+
+  box = gimp_query_int_box (delete ? _("Supprimer les petits objets")
+                                   : _("Objets plus petits que"),
+                            NULL, gimp_standard_help_func, NULL,
+                            delete ? _("Supprimer les objets dont la taille (largeur × hauteur) "
+                                       "est inférieure au carré de ce côté, en pixels :")
+                                   : _("Sélectionner les objets dont la taille (largeur × hauteur) "
+                                       "est inférieure au carré de ce côté, en pixels :"),
+                            vobjects_small_side, 1, 10000,
+                            G_OBJECT (image), "disconnect",
+                            vobjects_small_callback,
+                            GINT_TO_POINTER (delete), NULL);
+  g_object_set_data (G_OBJECT (box), "chopgimp-image", image);
+  gtk_widget_show (box);
+}
+
+void
+vector_objects_select_smaller_cmd_callback (GimpAction *action,
+                                            GVariant   *value,
+                                            gpointer    data)
+{
+  vobjects_small_query (action, data, FALSE);
+}
+
+void
+vector_objects_delete_smaller_cmd_callback (GimpAction *action,
+                                            GVariant   *value,
+                                            gpointer    data)
+{
+  vobjects_small_query (action, data, TRUE);
+}
+
 void
 vector_objects_arrange_cmd_callback (GimpAction *action,
                                      GVariant   *value,
@@ -778,3 +870,430 @@ vector_objects_pattern_apply_cmd_callback (GimpAction *action,
 
   chopgimp_pattern_apply_dialog_show (image, layer, widget);
 }
