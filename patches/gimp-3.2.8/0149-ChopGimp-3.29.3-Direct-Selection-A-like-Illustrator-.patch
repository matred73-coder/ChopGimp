+GimpUIManager *
+chopgimp_vsel_get_popup (ChopGimpVSel     *vsel,
+                         const GimpCoords *coords,
+                         GimpDisplay      *display,
+                         const gchar     **ui_path)
+{
+  GimpImage        *image = gimp_display_get_image (display);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  GimpVectorLayer  *layer;
+  ChopGimpVObject  *hit;
+
+  if (! vsel || ! image || ! chopgimp_vobjects_enabled ())
+    return NULL;
+
+  layer = chopgimp_vobjects_get_target_layer (image);
+  if (! layer)
+    return NULL;
+
+  hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y,
+                                  HIT_TOLERANCE / MAX (shell->scale_x, 1e-6),
+                                  vsel_click_group ? CHOPGIMP_HIT_SELECTABLE
+                                                   : CHOPGIMP_HIT_LEAF);
+  if (! hit)
+    return NULL;
+
+  if (! chopgimp_vlayer_is_selected (layer, hit->id))
+    {
+      chopgimp_vlayer_set_selection (layer, &hit->id, 1);
+      gimp_image_flush (image);
+    }
+
+  /*  the « Vecteur » menu of the menu bar (tools/build_menus.py)  */
+  *ui_path = "/image-menubar/Vecteur";
+
+  return shell->popup_manager;
+}
