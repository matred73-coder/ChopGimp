+/*  3.29.3: a « filet de dégradé » (spec « rows cols;x,y,#rrggbbaa[,thx,
+ *  thy,tvx,tvy];… », box units, chopgimp-vmaterial.c) → an SVG 2
+ *  <meshgradient> in object bounding box units (Inkscape reads it; the
+ *  browsers use the fallback color of the paint); → its id number, 0
+ *  when the spec cannot be read
+ */
+typedef struct
+{
+  gdouble x, y, rgba[4], th[2], tv[2];
+} SvgVMeshNode;
+
+static void
+svg_vmesh_edge (const SvgVMeshNode *nodes,
+                gint                a,
+                gint                b,
+                gdouble             c[6])
+{
+  const SvgVMeshNode *na  = &nodes[a], *nb = &nodes[b];
+  gboolean            row = ABS (a - b) == 1;
+  gdouble             sg  = b > a ? 1.0 : -1.0;
+  const gdouble      *ta  = row ? na->th : na->tv;
+  const gdouble      *tb  = row ? nb->th : nb->tv;
+  gdouble             dx  = nb->x - na->x, dy = nb->y - na->y;
+
+  /*  relative to the start of the edge (« c » of a path)  */
+  c[0] = dx / 3.0 + sg * ta[0];
+  c[1] = dy / 3.0 + sg * ta[1];
+  c[2] = dx - dx / 3.0 - sg * tb[0];
+  c[3] = dy - dy / 3.0 - sg * tb[1];
+  c[4] = dx;
+  c[5] = dy;
+}
+
+static gint
+svg_vput_mesh (SvgVWrite   *w,
+               const gchar *spec)
+{
+  gchar       **parts;
+  gint          rows = 0, cols = 0, n, k = 0, id;
+  SvgVMeshNode *nodes;
+
+  if (! spec)
+    return 0;
+
+  parts = g_strsplit (spec, ";", -1);
+
+  if (! parts[0] || sscanf (parts[0], "%d %d", &rows, &cols) != 2 ||
+      rows < 1 || cols < 1 || rows > 64 || cols > 64)
+    {
+      g_strfreev (parts);
+      return 0;
+    }
+
+  n     = (rows + 1) * (cols + 1);
+  nodes = g_new0 (SvgVMeshNode, n);
+
+  for (gint i = 1; parts[i] && k < n; i++)
+    {
+      gchar **f = g_strsplit (parts[i], ",", 7);
+
+      if (f[0] && f[1] && f[2])
+        {
+          const gchar *h = f[2];
+          guint        v[4] = { 0, 0, 0, 255 };
+
+          nodes[k].x = g_ascii_strtod (f[0], NULL);
+          nodes[k].y = g_ascii_strtod (f[1], NULL);
+
+          while (*h == '#' || *h == ' ')
+            h++;
+          for (gint j = 0; j < 4 && g_ascii_isxdigit (h[0]) && g_ascii_isxdigit (h[1]); j++, h += 2)
+            v[j] = g_ascii_xdigit_value (h[0]) * 16 + g_ascii_xdigit_value (h[1]);
+          for (gint j = 0; j < 4; j++)
+            nodes[k].rgba[j] = v[j] / 255.0;
+
+          if (f[3] && f[4] && f[5] && f[6])
+            {
+              nodes[k].th[0] = g_ascii_strtod (f[3], NULL);
+              nodes[k].th[1] = g_ascii_strtod (f[4], NULL);
+              nodes[k].tv[0] = g_ascii_strtod (f[5], NULL);
+              nodes[k].tv[1] = g_ascii_strtod (f[6], NULL);
+            }
+          k++;
+        }
+
+      g_strfreev (f);
+    }
+
+  g_strfreev (parts);
+
+  if (k < n)
+    {
+      g_free (nodes);
+      return 0;
+    }
+
+  id = ++w->n_gradients;
+
+  g_string_append_printf (w->defs,
+                          "<meshgradient id=\"%s-m%d\" gradientUnits=\"objectBoundingBox\""
+                          " x=\"", w->prefix, id);
+  svg_vput_num (w->defs, nodes[0].x);
+  g_string_append (w->defs, "\" y=\"");
+  svg_vput_num (w->defs, nodes[0].y);
+  g_string_append (w->defs, "\">\n");
+
+  for (gint r = 0; r < rows; r++)
+    {
+      g_string_append (w->defs, "<meshrow>\n");
+
+      for (gint c = 0; c < cols; c++)
+        {
+          gint corner[4] = { r * (cols + 1) + c, r * (cols + 1) + c + 1,
+                             (r + 1) * (cols + 1) + c + 1, (r + 1) * (cols + 1) + c };
+
+          g_string_append (w->defs, "<meshpatch>\n");
+
+          /*  side s goes from corner s to corner s + 1 (top, right,
+           *  bottom, left); the sides shared with the patch above / on
+           *  the left are not written, nor the colors already given
+           */
+          for (gint sd = 0; sd < 4; sd++)
+            {
+              gdouble cc[6];
+
+              if ((sd == 0 && r > 0) || (sd == 3 && c > 0))
+                continue;
+
+              svg_vmesh_edge (nodes, corner[sd], corner[(sd + 1) % 4], cc);
+
+              g_string_append (w->defs, "<stop path=\"c ");
+              for (gint j = 0; j < 6; j++)
+                {
+                  svg_vput_num (w->defs, cc[j]);
+                  g_string_append_c (w->defs, j == 5 ? '"' : (j % 2 ? ' ' : ','));
+                }
+
+              if ((sd == 0 && r == 0 && c == 0) || (sd == 1 && r == 0) ||
+                  sd == 2 || (sd == 3 && c == 0))
+                {
+                  g_string_append (w->defs, " style=\"stop-color:");
+                  svg_vput_color (w->defs, nodes[corner[sd]].rgba);
+                  g_string_append (w->defs, ";stop-opacity:");
+                  svg_vput_num (w->defs, CLAMP (nodes[corner[sd]].rgba[3], 0.0, 1.0));
+                  g_string_append_c (w->defs, '"');
+                }
+
+              g_string_append (w->defs, "/>\n");
+            }
+
+          g_string_append (w->defs, "</meshpatch>\n");
+        }
+
+      g_string_append (w->defs, "</meshrow>\n");
+    }
+
+  g_string_append (w->defs, "</meshgradient>\n");
+  g_free (nodes);
+
+  return id;
+}
