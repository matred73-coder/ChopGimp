+/*  3.29.3: « Simplifier… » (tolerance in px) and « Remplir les petits
+ *  trous… » (side in px): on the selected objects, else on all
+ */
+static gdouble vobjects_simplify_tol = 1.0;
+static gint    vobjects_holes_side   = 6;
+
+static void
+vobjects_holes_callback (GtkWidget *query_box,
+                         gint       value,
+                         gpointer   data)
+{
+  GimpImage       *image = g_object_get_data (G_OBJECT (query_box), "chopgimp-image");
+  GimpVectorLayer *layer = image ? chopgimp_vobjects_get_active_layer (image) : NULL;
+
+  vobjects_holes_side = value;
+
+  if (layer && chopgimp_vobjects_fill_holes (layer, (gdouble) value * value) > 0)
+    gimp_image_flush (image);
+}
+
+/*  3.29.3: « Simplifier… » with a live preview (the number of nodes
+ *  before / after); modal: the objects cannot change under the preview
+ */
+typedef struct
+{
+  GimpImage         *image;
+  ChopGimpVSimplify *s;
+  GtkAdjustment     *adj;
+  GtkWidget         *preview;
+  GtkWidget         *info;
+  guint              timeout;
+} SimplifyDialog;
+
+static gboolean
+simplify_dialog_update (gpointer data)
+{
+  SimplifyDialog *d = data;
+  gint            before = 0, after = 0;
+  gboolean        on     = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->preview));
+
+  d->timeout = 0;
+
+  if (chopgimp_vsimplify_preview (d->s, on ? gtk_adjustment_get_value (d->adj) : 0.0,
+                                  &before, &after))
+    {
+      gchar *text = on ? g_strdup_printf (_("%d points → %d points"), before, after)
+                       : g_strdup_printf (_("%d points"), before);
+
+      gtk_label_set_text (GTK_LABEL (d->info), text);
+      g_free (text);
+      gimp_image_flush (d->image);
+    }
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+simplify_dialog_changed (gpointer        unused,
+                         SimplifyDialog *d)
+{
+  if (d->timeout)
+    g_source_remove (d->timeout);
+
+  d->timeout = g_timeout_add (120, simplify_dialog_update, d);
+}
+
+static void
+simplify_dialog_response (GtkWidget      *dialog,
+                          gint            response,
+                          SimplifyDialog *d)
+{
+  if (d->timeout)
+    {
+      g_source_remove (d->timeout);
+      d->timeout = 0;
+    }
+
+  vobjects_simplify_tol = gtk_adjustment_get_value (d->adj);
+  chopgimp_vsimplify_end (d->s, response == GTK_RESPONSE_OK, vobjects_simplify_tol);
+  d->s = NULL;
+  gimp_image_flush (d->image);
+
+  gtk_widget_destroy (dialog);
+}
+
+static void
+simplify_dialog_free (SimplifyDialog *d)
+{
+  if (d->timeout)
+    g_source_remove (d->timeout);
+  if (d->s)
+    chopgimp_vsimplify_end (d->s, FALSE, 0.0);
+  g_object_unref (d->image);
+  g_free (d);
+}
+
+void
+vector_objects_simplify_cmd_callback (GimpAction *action,
+                                      GVariant   *value,
+                                      gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  GtkWidget       *dialog, *vbox, *scale;
+  SimplifyDialog  *d;
+  return_if_no_vlayer (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  d        = g_new0 (SimplifyDialog, 1);
+  d->image = g_object_ref (image);
+  d->s     = chopgimp_vsimplify_begin (layer);
+
+  if (! d->s)
+    {
+      simplify_dialog_free (d);
+      return;
+    }
+
+  dialog = gimp_dialog_new (_("Simplifier"), "chopgimp-simplify",
+                            gtk_widget_get_toplevel (widget), GTK_DIALOG_MODAL,
+                            gimp_standard_help_func, NULL,
+                            _("_Annuler"), GTK_RESPONSE_CANCEL,
+                            _("_Valider"), GTK_RESPONSE_OK,
+                            NULL);
+  gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_OK);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 8);
+  gtk_container_set_border_width (GTK_CONTAINER (vbox), 12);
+  gtk_box_pack_start (GTK_BOX (gtk_dialog_get_content_area (GTK_DIALOG (dialog))),
+                      vbox, TRUE, TRUE, 0);
+
+  gtk_box_pack_start (GTK_BOX (vbox),
+                      gimp_hint_box_new (_("Écart maximal entre le tracé simplifié et "
+                                           "l'original, en pixels : plus grand = moins "
+                                           "de points.")),
+                      FALSE, FALSE, 0);
+
+  d->adj = gtk_adjustment_new (vobjects_simplify_tol, 0.05, 50.0, 0.05, 1.0, 0.0);
+  scale  = gimp_spin_scale_new (d->adj, _("Écart (px)"), 2);
+  gimp_spin_scale_set_scale_limits (GIMP_SPIN_SCALE (scale), 0.05, 10.0);
+  gtk_widget_set_size_request (scale, 320, -1);
+  gtk_box_pack_start (GTK_BOX (vbox), scale, FALSE, FALSE, 0);
+
+  d->preview = gtk_check_button_new_with_mnemonic (_("A_perçu"));
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->preview), TRUE);
+  gtk_box_pack_start (GTK_BOX (vbox), d->preview, FALSE, FALSE, 0);
+
+  d->info = gtk_label_new (NULL);
+  gtk_label_set_xalign (GTK_LABEL (d->info), 0.0);
+  gtk_box_pack_start (GTK_BOX (vbox), d->info, FALSE, FALSE, 0);
+
+  g_signal_connect (d->adj, "value-changed",
+                    G_CALLBACK (simplify_dialog_changed), d);
+  g_signal_connect (d->preview, "toggled",
+                    G_CALLBACK (simplify_dialog_changed), d);
+  g_signal_connect (dialog, "response",
+                    G_CALLBACK (simplify_dialog_response), d);
+  g_object_set_data_full (G_OBJECT (dialog), "chopgimp-simplify", d,
+                          (GDestroyNotify) simplify_dialog_free);
+
+  gtk_widget_show_all (dialog);
+  simplify_dialog_update (d);
+}
+
+
+/*  3.29.3: « Couleurs du dessin… »: the plain colors of the vector layer
+ *  with their number of uses; a swatch recolors every use (one undo
+ *  step), « Sélectionner » selects the objects using it. Not modal: it
+ *  follows the objects and the selected layer.
+ */
+#define DRAWING_COLORS_MAX 64
+
+typedef struct
+{
+  GimpImage       *image;      /* weak */
+  GimpVectorLayer *layer;      /* weak, watched */
+  GtkWidget       *dialog;
+  GtkWidget       *title;
+  GtkWidget       *grid;
+  guint            idle;
+} DrawingColors;
+
+static void drawing_colors_queue (DrawingColors *dc);
+
+static void
+drawing_colors_watch (DrawingColors   *dc,
+                      GimpVectorLayer *layer)
+{
+  if (dc->layer == layer)
+    return;
+
+  if (dc->layer)
+    {
+      g_signal_handlers_disconnect_by_data (dc->layer, dc);
+      g_object_remove_weak_pointer (G_OBJECT (dc->layer), (gpointer *) &dc->layer);
+    }
+
+  dc->layer = layer;
+
+  if (layer)
+    {
+      g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &dc->layer);
+      g_signal_connect_swapped (layer, "objects-changed",
+                                G_CALLBACK (drawing_colors_queue), dc);
+    }
+}
+
+static void
+drawing_colors_select (GtkButton     *button,
+                       DrawingColors *dc)
+{
+  guint32 key = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (button), "key"));
+
+  if (dc->layer && dc->image &&
+      chopgimp_vobjects_select_color_key (dc->layer, key))
+    gimp_image_flush (dc->image);
+}
+
+static void
+drawing_colors_recolor (GimpColorButton *button,
+                        DrawingColors   *dc)
+{
+  guint32    key   = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (button), "key"));
+  GeglColor *color = gimp_color_button_get_color (button);
+
+  if (dc->layer && dc->image &&
+      chopgimp_vobjects_replace_color_key (dc->layer, key, color) > 0)
+    gimp_image_flush (dc->image);
+
+  g_object_unref (color);
+}
+
+static gboolean
+drawing_colors_rebuild (gpointer data)
+{
+  DrawingColors   *dc    = data;
+  GimpVectorLayer *layer = dc->image ? chopgimp_vobjects_get_target_layer (dc->image) : NULL;
+  GArray          *uses  = NULL;
+  gchar           *text;
+  gint             total = 0;
+
+  dc->idle = 0;
+  drawing_colors_watch (dc, layer);
+
+  gtk_container_foreach (GTK_CONTAINER (dc->grid), (GtkCallback) gtk_widget_destroy, NULL);
+
+  if (layer)
+    uses = chopgimp_vobjects_drawing_colors (layer);
+
+  for (guint i = 0; uses && i < uses->len; i++)
+    total += g_array_index (uses, ChopGimpVColorUse, i).count;
+
+  if (! layer)
+    text = g_strdup (_("Sélectionnez un calque vectoriel (outil Déplacement, mode objets)."));
+  else if (uses->len > DRAWING_COLORS_MAX)
+    text = g_strdup_printf (_("%u couleurs, %d usages — les %d plus employées :"),
+                            uses->len, total, DRAWING_COLORS_MAX);
+  else
+    text = g_strdup_printf (_("%u couleurs, %d usages (fonds et contours unis)"),
+                            uses ? uses->len : 0, total);
+
+  gtk_label_set_text (GTK_LABEL (dc->title), text);
+  g_free (text);
+
+  for (guint i = 0; uses && i < MIN (uses->len, DRAWING_COLORS_MAX); i++)
+    {
+      ChopGimpVColorUse *u = &g_array_index (uses, ChopGimpVColorUse, i);
+      GeglColor         *color = gegl_color_new (NULL);
+      guint8             px[4] = { u->key >> 24, (u->key >> 16) & 0xff,
+                                   (u->key >> 8) & 0xff, u->key & 0xff };
+      GtkWidget         *w;
+      gchar             *s;
+
+      gegl_color_set_pixel (color, babl_format ("R'G'B'A u8"), px);
+
+      w = gimp_color_button_new (_("Remplacer la couleur"), 48, 20, color,
+                                 GIMP_COLOR_AREA_SMALL_CHECKS);
+      g_object_set_data (G_OBJECT (w), "key", GUINT_TO_POINTER (u->key));
+      gimp_help_set_help_data (w, _("Remplacer cette couleur partout (une annulation)"), NULL);
+      g_signal_connect (w, "color-changed", G_CALLBACK (drawing_colors_recolor), dc);
+      gtk_grid_attach (GTK_GRID (dc->grid), w, 0, i, 1, 1);
+
+      s = g_strdup_printf ("#%02x%02x%02x", px[0], px[1], px[2]);
+      w = gtk_label_new (s);
+      gtk_label_set_xalign (GTK_LABEL (w), 0.0);
+      gtk_grid_attach (GTK_GRID (dc->grid), w, 1, i, 1, 1);
+      g_free (s);
+
+      s = g_strdup_printf ("×%d", u->count);
+      w = gtk_label_new (s);
+      gtk_label_set_xalign (GTK_LABEL (w), 1.0);
+      gtk_grid_attach (GTK_GRID (dc->grid), w, 2, i, 1, 1);
+      g_free (s);
+
+      w = gtk_button_new_with_label (_("Sélectionner"));
+      g_object_set_data (G_OBJECT (w), "key", GUINT_TO_POINTER (u->key));
+      g_signal_connect (w, "clicked", G_CALLBACK (drawing_colors_select), dc);
+      gtk_grid_attach (GTK_GRID (dc->grid), w, 3, i, 1, 1);
+
+      g_object_unref (color);
+    }
+
+  if (uses)
+    g_array_free (uses, TRUE);
+
+  gtk_widget_show_all (dc->grid);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+drawing_colors_queue (DrawingColors *dc)
+{
+  if (! dc->idle)
+    dc->idle = g_timeout_add (250, drawing_colors_rebuild, dc);
+}
+
+static void
+drawing_colors_free (DrawingColors *dc)
+{
+  if (dc->idle)
+    g_source_remove (dc->idle);
+
+  drawing_colors_watch (dc, NULL);
+
+  if (dc->image)
+    {
+      g_signal_handlers_disconnect_by_data (dc->image, dc);
+      g_object_set_data (G_OBJECT (dc->image), "chopgimp-drawing-colors", NULL);
+      g_object_remove_weak_pointer (G_OBJECT (dc->image), (gpointer *) &dc->image);
+    }
+
+  g_free (dc);
+}
+
+void
+vector_objects_drawing_colors_cmd_callback (GimpAction *action,
+                                            GVariant   *value,
+                                            gpointer    data)
+{
+  GimpImage     *image;
+  GtkWidget     *widget;
+  GtkWidget     *vbox, *sw;
+  DrawingColors *dc;
+  return_if_no_image (image, data);
+  return_if_no_widget (widget, data);
+
+  dc = g_object_get_data (G_OBJECT (image), "chopgimp-drawing-colors");
+  if (dc)
+    {
+      drawing_colors_queue (dc);
+      gtk_window_present (GTK_WINDOW (dc->dialog));
+      return;
+    }
+
+  dc        = g_new0 (DrawingColors, 1);
+  dc->image = image;
+  g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &dc->image);
+  g_object_set_data (G_OBJECT (image), "chopgimp-drawing-colors", dc);
+
+  dc->dialog = gimp_dialog_new (_("Couleurs du dessin"), "chopgimp-drawing-colors",
+                                gtk_widget_get_toplevel (widget), 0,
+                                gimp_standard_help_func, NULL,
+                                _("_Fermer"), GTK_RESPONSE_CLOSE,
+                                NULL);
+  g_signal_connect (dc->dialog, "response", G_CALLBACK (gtk_widget_destroy), NULL);
+  g_object_set_data_full (G_OBJECT (dc->dialog), "chopgimp-drawing-colors", dc,
+                          (GDestroyNotify) drawing_colors_free);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_container_set_border_width (GTK_CONTAINER (vbox), 12);
+  gtk_box_pack_start (GTK_BOX (gtk_dialog_get_content_area (GTK_DIALOG (dc->dialog))),
+                      vbox, TRUE, TRUE, 0);
+
+  dc->title = gtk_label_new (NULL);
+  gtk_label_set_xalign (GTK_LABEL (dc->title), 0.0);
+  gtk_box_pack_start (GTK_BOX (vbox), dc->title, FALSE, FALSE, 0);
+
+  sw = gtk_scrolled_window_new (NULL, NULL);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (sw),
+                                  GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_widget_set_size_request (sw, 340, 360);
+  gtk_box_pack_start (GTK_BOX (vbox), sw, TRUE, TRUE, 0);
+
+  dc->grid = gtk_grid_new ();
+  gtk_grid_set_row_spacing (GTK_GRID (dc->grid), 4);
+  gtk_grid_set_column_spacing (GTK_GRID (dc->grid), 10);
+  gtk_container_add (GTK_CONTAINER (sw), dc->grid);
+
+  g_signal_connect_swapped (image, "selected-layers-changed",
+                            G_CALLBACK (drawing_colors_queue), dc);
+
+  drawing_colors_rebuild (dc);
+  gtk_widget_show_all (dc->dialog);
+}
+
+void
+vector_objects_fill_holes_cmd_callback (GimpAction *action,
+                                        GVariant   *value,
+                                        gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *box;
+  return_if_no_vlayer (image, layer, data);
+
+  box = gimp_query_int_box (_("Remplir les petits trous"), NULL, gimp_standard_help_func, NULL,
+                            _("Boucher les trous dont la taille (largeur × hauteur) est "
+                              "inférieure au carré de ce côté, en pixels :"),
+                            vobjects_holes_side, 1, 10000,
+                            G_OBJECT (image), "disconnect",
+                            vobjects_holes_callback, NULL, NULL);
+  g_object_set_data (G_OBJECT (box), "chopgimp-image", image);
+  gtk_widget_show (box);
+}
