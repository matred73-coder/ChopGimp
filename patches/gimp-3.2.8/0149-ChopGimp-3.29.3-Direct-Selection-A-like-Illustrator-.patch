+/*  ─── 3.29.3: selection by color / size, cleaning, colors ──────────── */
+
+/*  the plain color of a leaf's primary fill / stroke as R'G'B'A u8; FALSE
+ *  when it has none (no entry, hidden, not a plain color)
+ */
+static gboolean
+leaf_color_key (ChopGimpVObject *leaf,
+                gboolean         stroke,
+                guint32         *key)
+{
+  ChopGimpVEntry *e;
+  guint8          px[4];
+
+  if (! leaf || leaf->kind != CHOPGIMP_VOBJECT_PATH)
+    return FALSE;
+
+  e = stroke ? chopgimp_vstyle_get_stroke (&leaf->style)
+             : chopgimp_vstyle_get_fill (&leaf->style);
+
+  if (! e || ! e->visible || e->paint.type != CHOPGIMP_PAINT_COLOR ||
+      ! e->paint.color || (stroke && e->width <= 0.0))
+    return FALSE;
+
+  gegl_color_get_pixel (e->paint.color, babl_format ("R'G'B'A u8"), px);
+  *key = ((guint32) px[0] << 24) | ((guint32) px[1] << 16) |
+         ((guint32) px[2] << 8)  |  (guint32) px[3];
+
+  return TRUE;
+}
+
+static gboolean
+leaf_is_free (ChopGimpVObject *o)
+{
+  return o->kind == CHOPGIMP_VOBJECT_PATH &&
+         chopgimp_vobject_is_visible (o) && ! chopgimp_vobject_is_locked (o);
+}
+
+static ChopGimpVObject *
+first_selected_leaf (GimpVectorLayer *layer)
+{
+  GList           *objs = chopgimp_vlayer_get_selected_objects (layer);
+  ChopGimpVObject *leaf = NULL;
+
+  if (objs)
+    {
+      GList *leaves = chopgimp_vobjects_leaves_of (objs->data);
+
+      if (leaves)
+        leaf = leaves->data;
+
+      g_list_free (leaves);
+      g_list_free (objs);
+    }
+
+  return leaf;
+}
+
+gboolean
+chopgimp_vobjects_select_same (GimpVectorLayer *layer,
+                               ChopGimpVSame    what)
+{
+  ChopGimpVObject *ref = first_selected_leaf (layer);
+  guint32          kf  = 0, ks = 0;
+  gboolean         hf, hs;
+  GList           *leaves;
+  GPtrArray       *objs;
+
+  if (! ref)
+    return FALSE;
+
+  hf = leaf_color_key (ref, FALSE, &kf);
+  hs = leaf_color_key (ref, TRUE,  &ks);
+
+  if ((what == CHOPGIMP_VSAME_FILL && ! hf) ||
+      (what == CHOPGIMP_VSAME_STROKE && ! hs) ||
+      (! hf && ! hs))
+    return FALSE;
+
+  objs   = g_ptr_array_new ();
+  leaves = chopgimp_vlayer_get_leaves (layer);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      guint32          f, k;
+      gboolean         of, os, match = FALSE;
+
+      if (! leaf_is_free (o))
+        continue;
+
+      of = leaf_color_key (o, FALSE, &f);
+      os = leaf_color_key (o, TRUE,  &k);
+
+      switch (what)
+        {
+        case CHOPGIMP_VSAME_FILL:   match = of && f == kf; break;
+        case CHOPGIMP_VSAME_STROKE: match = os && k == ks; break;
+        case CHOPGIMP_VSAME_COLOR:
+          match = (hf && ((of && f == kf) || (os && k == kf))) ||
+                  (hs && ((of && f == ks) || (os && k == ks)));
+          break;
+        }
+
+      if (match)
+        g_ptr_array_add (objs, o);
+    }
+
+  g_list_free (leaves);
+
+  if (objs->len)
+    select_objects (layer, objs);
+
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_select_inverse (GimpVectorLayer *layer)
+{
+  GList     *leaves = chopgimp_vlayer_get_leaves (layer);
+  GPtrArray *objs   = g_ptr_array_new ();
+  GList     *sel    = chopgimp_vlayer_get_selected_objects (layer);
+  GHashTable *in    = g_hash_table_new (NULL, NULL);
+
+  /*  a selected group counts for all its leaves  */
+  for (GList *o = sel; o; o = o->next)
+    {
+      GList *ls = chopgimp_vobjects_leaves_of (o->data);
+
+      for (GList *l = ls; l; l = l->next)
+        g_hash_table_add (in, l->data);
+
+      g_list_free (ls);
+    }
+
+  for (GList *l = leaves; l; l = l->next)
+    if (leaf_is_free (l->data) && ! g_hash_table_contains (in, l->data))
+      g_ptr_array_add (objs, l->data);
+
+  select_objects (layer, objs);
+
+  g_hash_table_destroy (in);
+  g_list_free (sel);
+  g_list_free (leaves);
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gint
+chopgimp_vobjects_select_smaller (GimpVectorLayer *layer,
+                                  gdouble          area)
+{
+  GList     *leaves = chopgimp_vlayer_get_leaves (layer);
+  GPtrArray *objs   = g_ptr_array_new ();
+  gint       n;
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      gdouble          x1, y1, x2, y2;
+
+      if (leaf_is_free (o) &&
+          chopgimp_vobject_get_bounds (layer, o, TRUE, &x1, &y1, &x2, &y2) &&
+          (x2 - x1) * (y2 - y1) < area)
+        g_ptr_array_add (objs, o);
+    }
+
+  g_list_free (leaves);
+
+  n = objs->len;
+  select_objects (layer, objs);
+  g_ptr_array_free (objs, TRUE);
+
+  return n;
+}
+
+gint
+chopgimp_vobjects_delete_smaller (GimpVectorLayer *layer,
+                                  gdouble          area)
+{
+  gint n = chopgimp_vobjects_select_smaller (layer, area);
+
+  if (n > 0)
+    chopgimp_vobjects_delete_selection (layer);
+
+  return n;
+}
+
+gint
+chopgimp_vobjects_merge_same_color (GimpVectorLayer *layer)
+{
+  GimpImage  *image  = gimp_item_get_image (GIMP_ITEM (layer));
+  GHashTable *groups = g_hash_table_new_full (NULL, NULL, NULL,
+                                              (GDestroyNotify) g_ptr_array_unref);
+  GList      *leaves = chopgimp_vlayer_get_leaves (layer);
+  gint        before = g_list_length (leaves);
+  gint        after;
+  GHashTableIter iter;
+  gpointer    value;
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      guint32          k, ks;
+      GPtrArray       *arr;
+
+      /*  plain fill, no visible stroke: the union keeps the look  */
+      if (! leaf_is_free (o) || ! leaf_color_key (o, FALSE, &k) ||
+          leaf_color_key (o, TRUE, &ks))
+        continue;
+
+      arr = g_hash_table_lookup (groups, GUINT_TO_POINTER (k + 1));
+      if (! arr)
+        {
+          arr = g_ptr_array_new ();
+          g_hash_table_insert (groups, GUINT_TO_POINTER (k + 1), arr);
+        }
+      g_ptr_array_add (arr, GUINT_TO_POINTER (o->id));
+    }
+
+  g_list_free (leaves);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC,
+                               _("Fusionner les formes de même couleur"));
+
+  g_hash_table_iter_init (&iter, groups);
+  while (g_hash_table_iter_next (&iter, NULL, &value))
+    {
+      GPtrArray *arr = value;
+      guint     *ids;
+
+      if (arr->len < 2)
+        continue;
+
+      ids = g_new (guint, arr->len);
+      for (guint i = 0; i < arr->len; i++)
+        ids[i] = GPOINTER_TO_UINT (arr->pdata[i]);
+
+      chopgimp_vlayer_set_selection (layer, ids, arr->len);
+      g_free (ids);
+
+      chopgimp_vobjects_pathfinder (layer, CHOPGIMP_VPATHFINDER_UNION);
+    }
+
+  gimp_image_undo_group_end (image);
+  g_hash_table_destroy (groups);
+
+  after = chopgimp_vlayer_count_leaves (layer);
+
+  return MAX (0, before - after);
+}
+
+gboolean
+chopgimp_vobjects_apply_color (GimpVectorLayer *layer,
+                               GeglColor       *color,
+                               gboolean         stroke,
+                               gboolean         push_undo)
+{
+  GList *objs = chopgimp_vlayer_get_selected_objects (layer);
+
+  if (! objs)
+    return FALSE;
+
+  if (push_undo)
+    chopgimp_vlayer_push_undo (layer, stroke ? _("Couleur du contour")
+                                             : _("Couleur du fond"));
+
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *o = objs; o; o = o->next)
+    {
+      GList *leaves = chopgimp_vobjects_leaves_of (o->data);
+
+      for (GList *l = leaves; l; l = l->next)
+        {
+          ChopGimpVObject *leaf = l->data;
+          ChopGimpVStyle   st;
+          ChopGimpVEntry  *e;
+
+          if (leaf->kind != CHOPGIMP_VOBJECT_PATH || chopgimp_vobject_is_locked (leaf))
+            continue;
+
+          chopgimp_vstyle_init (&st);
+          chopgimp_vstyle_copy (&st, &leaf->style);
+
+          e = stroke ? chopgimp_vstyle_ensure_stroke (&st)
+                     : chopgimp_vstyle_ensure_fill (&st);
+
+          if (color)
+            {
+              chopgimp_vpaint_set_color (&e->paint, color);
+              e->visible = TRUE;
+              if (stroke && e->width <= 0.0)
+                e->width = 1.0;
+            }
+          else
+            {
+              chopgimp_vpaint_clear (&e->paint);
+            }
+
+          chopgimp_vlayer_set_style (layer, leaf->id, &st, FALSE);
+          chopgimp_vstyle_clear (&st);
+        }
+
+      g_list_free (leaves);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (objs);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_swap_fill_stroke (GimpVectorLayer *layer)
+{
+  GList *objs = chopgimp_vlayer_get_selected_objects (layer);
+
+  if (! objs)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Permuter fond et contour"));
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *o = objs; o; o = o->next)
+    {
+      GList *leaves = chopgimp_vobjects_leaves_of (o->data);
+
+      for (GList *l = leaves; l; l = l->next)
+        {
+          ChopGimpVObject *leaf = l->data;
+          ChopGimpVStyle   st;
+          ChopGimpVEntry  *f, *k;
+          ChopGimpPaint    tmp;
+
+          if (leaf->kind != CHOPGIMP_VOBJECT_PATH || chopgimp_vobject_is_locked (leaf))
+            continue;
+
+          chopgimp_vstyle_init (&st);
+          chopgimp_vstyle_copy (&st, &leaf->style);
+
+          f = chopgimp_vstyle_ensure_fill (&st);
+          k = chopgimp_vstyle_ensure_stroke (&st);
+
+          tmp      = f->paint;
+          f->paint = k->paint;
+          k->paint = tmp;
+          f->visible = TRUE;
+          k->visible = TRUE;
+          if (k->paint.type != CHOPGIMP_PAINT_NONE && k->width <= 0.0)
+            k->width = 1.0;
+
+          chopgimp_vlayer_set_style (layer, leaf->id, &st, FALSE);
+          chopgimp_vstyle_clear (&st);
+        }
+
+      g_list_free (leaves);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (objs);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_select_next_under (GimpVectorLayer *layer,
+                                     gdouble          x,
+                                     gdouble          y,
+                                     gdouble          tolerance)
+{
+  ChopGimpVObject *cur = first_selected_leaf (layer);
+  GList           *leaves = chopgimp_vlayer_get_leaves (layer);   /* bottom → top */
+  GList           *under  = NULL;
+  GList           *l;
+  ChopGimpVObject *next   = NULL;
+
+  for (l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      gdouble          x1, y1, x2, y2;
+
+      if (leaf_is_free (o) &&
+          chopgimp_vobject_get_bounds (layer, o, TRUE, &x1, &y1, &x2, &y2) &&
+          x >= x1 - tolerance && x <= x2 + tolerance &&
+          y >= y1 - tolerance && y <= y2 + tolerance)
+        under = g_list_prepend (under, o);                       /* top → bottom */
+    }
+
+  g_list_free (leaves);
+
+  if (! under)
+    return FALSE;
+
+  l = cur ? g_list_find (under, cur) : NULL;
+  next = (l && l->next) ? l->next->data : under->data;
+
+  chopgimp_vlayer_set_selection (layer, &next->id, 1);
+  g_list_free (under);
+
+  return TRUE;
+}
+
+static gboolean
+others_set (GimpVectorLayer *layer,
+            gboolean         lock)
+{
+  GList      *leaves = chopgimp_vlayer_get_leaves (layer);
+  GList      *sel    = chopgimp_vlayer_get_selected_objects (layer);
+  GHashTable *in     = g_hash_table_new (NULL, NULL);
+
+  if (! sel)
+    {
+      g_list_free (leaves);
+      g_hash_table_destroy (in);
+      return FALSE;
+    }
+
+  for (GList *o = sel; o; o = o->next)
+    {
+      GList *ls = chopgimp_vobjects_leaves_of (o->data);
+
+      for (GList *l = ls; l; l = l->next)
+        g_hash_table_add (in, l->data);
+
+      g_list_free (ls);
+    }
+
+  chopgimp_vlayer_push_undo (layer, lock ? _("Verrouiller les autres objets")
+                                         : _("Masquer les autres objets"));
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      if (g_hash_table_contains (in, o))
+        continue;
+
+      chopgimp_vlayer_set_props (layer, o->id, NULL, -1.0, -1,
+                                 lock ? -1 : FALSE, lock ? TRUE : -1, FALSE);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+
+  g_hash_table_destroy (in);
+  g_list_free (sel);
+  g_list_free (leaves);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_lock_others (GimpVectorLayer *layer)
+{
+  return others_set (layer, TRUE);
+}
+
+gboolean
+chopgimp_vobjects_hide_others (GimpVectorLayer *layer)
+{
+  return others_set (layer, FALSE);
+}
+
+
+/*  the selected leaves, or all the free leaves when nothing is selected  */
+static GList *
+target_leaves (GimpVectorLayer *layer)
+{
+  GList *objs = chopgimp_vlayer_get_selected_objects (layer);
+  GList *out  = NULL;
+
+  if (! objs)
+    {
+      GList *all = chopgimp_vlayer_get_leaves (layer);
+
+      for (GList *l = all; l; l = l->next)
+        if (leaf_is_free (l->data))
+          out = g_list_prepend (out, l->data);
+
+      g_list_free (all);
+
+      return g_list_reverse (out);
+    }
+
+  for (GList *o = objs; o; o = o->next)
+    {
+      GList *ls = chopgimp_vobjects_leaves_of (o->data);
+
+      for (GList *l = ls; l; l = l->next)
+        if (leaf_is_free (l->data))
+          out = g_list_prepend (out, l->data);
+
+      g_list_free (ls);
+    }
+
+  g_list_free (objs);
+
+  return g_list_reverse (out);
+}
+
+gint
+chopgimp_vobjects_simplify (GimpVectorLayer *layer,
+                            gdouble          tolerance,
+                            gboolean         push_undo)
+{
+  GList *leaves = target_leaves (layer);
+  gint   n      = 0;
+
+  if (! leaves)
+    return 0;
+
+  if (push_undo)
+    chopgimp_vlayer_push_undo (layer, _("Simplifier"));
+
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      GimpPath        *simple;
+
+      if (! o->path)
+        continue;
+
+      simple = chopgimp_geom_simplify (o->path, MAX (tolerance, 0.01));
+
+      if (simple)
+        {
+          g_object_ref_sink (simple);
+          chopgimp_vlayer_set_path (layer, o->id, simple, FALSE);
+          g_object_unref (simple);
+          n++;
+        }
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (leaves);
+
+  return n;
+}
+
+/*  ─── 3.29.3: « Simplifier » with a live preview ───────────────────── */
+
+struct _ChopGimpVSimplify
+{
+  GimpVectorLayer *layer;    /* weak */
+  GArray          *ids;      /* guint */
+  GPtrArray       *orig;     /* GimpPath, local coordinates */
+  gint             n_nodes;
+  gboolean         changed;
+};
+
+static gint
+path_n_nodes (GimpPath *path)
+{
+  GimpStroke *stroke = NULL;
+  gint        n      = 0;
+
+  while ((stroke = gimp_path_stroke_get_next (path, stroke)))
+    for (GList *a = stroke->anchors->head; a; a = a->next)
+      if (((GimpAnchor *) a->data)->type == GIMP_ANCHOR_ANCHOR)
+        n++;
+
+  return n;
+}
+
+ChopGimpVSimplify *
+chopgimp_vsimplify_begin (GimpVectorLayer *layer)
+{
+  ChopGimpVSimplify *s;
+  GList             *leaves;
+
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), NULL);
+
+  leaves = target_leaves (layer);
+  if (! leaves)
+    return NULL;
+
+  s        = g_new0 (ChopGimpVSimplify, 1);
+  s->layer = layer;
+  s->ids   = g_array_new (FALSE, FALSE, sizeof (guint));
+  s->orig  = g_ptr_array_new_with_free_func (g_object_unref);
+  g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &s->layer);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      GimpPath        *copy;
+
+      if (! o->path)
+        continue;
+
+      copy = GIMP_PATH (gimp_item_duplicate (GIMP_ITEM (o->path),
+                                             G_TYPE_FROM_INSTANCE (o->path)));
+      g_object_ref_sink (copy);
+      g_array_append_val (s->ids, o->id);
+      g_ptr_array_add (s->orig, copy);
+      s->n_nodes += path_n_nodes (o->path);
+    }
+
+  g_list_free (leaves);
+
+  return s;
+}
+
+static void
+vsimplify_apply (ChopGimpVSimplify *s,
+                 gdouble            tolerance,
+                 gint              *n_after)
+{
+  chopgimp_vlayer_freeze (s->layer);
+
+  for (guint i = 0; i < s->ids->len; i++)
+    {
+      guint     id   = g_array_index (s->ids, guint, i);
+      GimpPath *orig = g_ptr_array_index (s->orig, i);
+      GimpPath *path = tolerance > 0.0 ? chopgimp_geom_simplify (orig, MAX (tolerance, 0.01))
+                                       : NULL;
+
+      if (path)
+        g_object_ref_sink (path);
+
+      if (n_after)
+        *n_after += path_n_nodes (path ? path : orig);
+
+      if (chopgimp_vlayer_get_object (s->layer, id))
+        chopgimp_vlayer_set_path (s->layer, id, path ? path : orig, FALSE);
+
+      if (path)
+        g_object_unref (path);
+    }
+
+  chopgimp_vlayer_thaw (s->layer);
+}
+
+gboolean
+chopgimp_vsimplify_preview (ChopGimpVSimplify *s,
+                            gdouble            tolerance,
+                            gint              *n_before,
+                            gint              *n_after)
+{
+  if (n_before) *n_before = s ? s->n_nodes : 0;
+  if (n_after)  *n_after  = 0;
+
+  if (! s || ! s->layer)
+    return FALSE;
+
+  vsimplify_apply (s, tolerance, n_after);
+  s->changed = TRUE;
+
+  return TRUE;
+}
+
+void
+chopgimp_vsimplify_end (ChopGimpVSimplify *s,
+                        gboolean           commit,
+                        gdouble            tolerance)
+{
+  if (! s)
+    return;
+
+  if (s->layer)
+    {
+      if (s->changed)
+        vsimplify_apply (s, 0.0, NULL);   /* the originals back */
+
+      if (commit)
+        {
+          chopgimp_vlayer_push_undo (s->layer, _("Simplifier"));
+          vsimplify_apply (s, tolerance, NULL);
+        }
+
+      g_object_remove_weak_pointer (G_OBJECT (s->layer), (gpointer *) &s->layer);
+    }
+
+  g_array_free (s->ids, TRUE);
+  g_ptr_array_free (s->orig, TRUE);
+  g_free (s);
+}
+
+
+/*  ─── 3.29.3: « Couleurs du dessin » ───────────────────────────────── */
+
+static gint
+color_use_cmp (gconstpointer a,
+               gconstpointer b)
+{
+  const ChopGimpVColorUse *x = a, *y = b;
+
+  if (x->count != y->count)
+    return y->count - x->count;
+
+  return x->key < y->key ? -1 : x->key > y->key;
+}
+
+GArray *
+chopgimp_vobjects_drawing_colors (GimpVectorLayer *layer)
+{
+  GHashTable *counts = g_hash_table_new (NULL, NULL);
+  GArray     *out    = g_array_new (FALSE, FALSE, sizeof (ChopGimpVColorUse));
+  GList      *leaves = chopgimp_vlayer_get_leaves (layer);
+  GHashTableIter iter;
+  gpointer    k, v;
+
+  for (GList *l = leaves; l; l = l->next)
+    for (gint stroke = 0; stroke < 2; stroke++)
+      {
+        guint32 key;
+
+        if (leaf_is_free (l->data) && leaf_color_key (l->data, stroke, &key))
+          {
+            gpointer kp = GUINT_TO_POINTER (key ^ 0x1);  /* never NULL */
+
+            g_hash_table_insert (counts, kp,
+                                 GINT_TO_POINTER (GPOINTER_TO_INT (g_hash_table_lookup (counts, kp)) + 1));
+          }
+      }
+
+  g_list_free (leaves);
+
+  g_hash_table_iter_init (&iter, counts);
+  while (g_hash_table_iter_next (&iter, &k, &v))
+    {
+      ChopGimpVColorUse use = { GPOINTER_TO_UINT (k) ^ 0x1, GPOINTER_TO_INT (v) };
+
+      g_array_append_val (out, use);
+    }
+
+  g_hash_table_destroy (counts);
+  g_array_sort (out, color_use_cmp);
+
+  return out;
+}
+
+gboolean
+chopgimp_vobjects_select_color_key (GimpVectorLayer *layer,
+                                    guint32          key)
+{
+  GPtrArray *objs   = g_ptr_array_new ();
+  GList     *leaves = chopgimp_vlayer_get_leaves (layer);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      guint32 f, k;
+
+      if (leaf_is_free (l->data) &&
+          ((leaf_color_key (l->data, FALSE, &f) && f == key) ||
+           (leaf_color_key (l->data, TRUE,  &k) && k == key)))
+        g_ptr_array_add (objs, l->data);
+    }
+
+  g_list_free (leaves);
+
+  if (objs->len)
+    select_objects (layer, objs);
+
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gint
+chopgimp_vobjects_replace_color_key (GimpVectorLayer *layer,
+                                     guint32          key,
+                                     GeglColor       *color)
+{
+  GList *leaves = chopgimp_vlayer_get_leaves (layer);
+  GList *hits   = NULL;
+  gint   n      = 0;
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      guint32 f, k;
+
+      if (leaf_is_free (l->data) &&
+          ((leaf_color_key (l->data, FALSE, &f) && f == key) ||
+           (leaf_color_key (l->data, TRUE,  &k) && k == key)))
+        hits = g_list_prepend (hits, l->data);
+    }
+
+  g_list_free (leaves);
+
+  if (! hits || ! color)
+    {
+      g_list_free (hits);
+      return 0;
+    }
+
+  chopgimp_vlayer_push_undo (layer, _("Couleurs du dessin"));
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = hits; l; l = l->next)
+    {
+      ChopGimpVObject *leaf = l->data;
+      ChopGimpVStyle   st;
+      guint32          kk;
+
+      chopgimp_vstyle_init (&st);
+      chopgimp_vstyle_copy (&st, &leaf->style);
+
+      for (gint stroke = 0; stroke < 2; stroke++)
+        if (leaf_color_key (leaf, stroke, &kk) && kk == key)
+          {
+            ChopGimpVEntry *e = stroke ? chopgimp_vstyle_get_stroke (&st)
+                                       : chopgimp_vstyle_get_fill (&st);
+
+            if (e)
+              chopgimp_vpaint_set_color (&e->paint, color);
+          }
+
+      chopgimp_vlayer_set_style (layer, leaf->id, &st, FALSE);
+      chopgimp_vstyle_clear (&st);
+      n++;
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (hits);
+
+  return n;
+}
+
+static gdouble
+stroke_box_area (GimpStroke *stroke)
+{
+  gdouble x1 = G_MAXDOUBLE, y1 = G_MAXDOUBLE, x2 = -G_MAXDOUBLE, y2 = -G_MAXDOUBLE;
+
+  for (GList *a = stroke->anchors->head; a; a = a->next)
+    {
+      GimpAnchor *anchor = a->data;
+
+      x1 = MIN (x1, anchor->position.x);  x2 = MAX (x2, anchor->position.x);
+      y1 = MIN (y1, anchor->position.y);  y2 = MAX (y2, anchor->position.y);
+    }
+
+  return (x2 > x1 && y2 > y1) ? (x2 - x1) * (y2 - y1) : 0.0;
+}
+
+gint
+chopgimp_vobjects_fill_holes (GimpVectorLayer *layer,
+                              gdouble          area)
+{
+  GimpImage *image  = gimp_item_get_image (GIMP_ITEM (layer));
+  GList     *leaves = target_leaves (layer);
+  gint       n      = 0;
+  gboolean   pushed = FALSE;
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o       = l->data;
+      GimpStroke      *stroke  = NULL;
+      GimpStroke      *largest = NULL;
+      gdouble          best    = -1.0;
+      gint             removed = 0;
+      GimpPath        *path;
+
+      if (! o->path)
+        continue;
+
+      while ((stroke = gimp_path_stroke_get_next (o->path, stroke)))
+        {
+          gdouble a = stroke_box_area (stroke);
+
+          if (a > best)
+            {
+              best    = a;
+              largest = stroke;
+            }
+        }
+
+      path = gimp_path_new (image, o->name ? o->name : "");
+      g_object_ref_sink (path);
+
+      while ((stroke = gimp_path_stroke_get_next (o->path, stroke)))
+        {
+          if (stroke != largest && stroke_box_area (stroke) < area)
+            {
+              removed++;
+              continue;
+            }
+
+          {
+            GimpStroke *copy = gimp_stroke_duplicate (stroke);
+
+            gimp_path_stroke_add (path, copy);
+            g_object_unref (copy);
+          }
+        }
+
+      if (removed > 0)
+        {
+          if (! pushed)
+            {
+              chopgimp_vlayer_push_undo (layer, _("Remplir les petits trous"));
+              chopgimp_vlayer_freeze (layer);
+              pushed = TRUE;
+            }
+
+          chopgimp_vlayer_set_path (layer, o->id, path, FALSE);
+          n += removed;
+        }
+
+      g_object_unref (path);
+    }
+
+  if (pushed)
+    chopgimp_vlayer_thaw (layer);
+
+  g_list_free (leaves);
+
+  return n;
+}
+
+
+gboolean
+chopgimp_vobjects_select_adjacent (GimpVectorLayer *layer,
+                                   gboolean         above)
+{
+  ChopGimpVObject *cur    = first_selected_leaf (layer);
+  GList           *leaves = chopgimp_vlayer_get_leaves (layer);   /* bottom → top */
+  GList           *free_  = NULL;
+  GList           *l;
+  ChopGimpVObject *next;
+
+  for (l = leaves; l; l = l->next)
+    if (leaf_is_free (l->data))
+      free_ = g_list_append (free_, l->data);
+
+  g_list_free (leaves);
+
+  if (! free_)
+    return FALSE;
+
+  l = cur ? g_list_find (free_, cur) : NULL;
+
+  if (above)
+    next = (l && l->next) ? l->next->data : free_->data;
+  else
+    next = (l && l->prev) ? l->prev->data : g_list_last (free_)->data;
+
+  chopgimp_vlayer_set_selection (layer, &next->id, 1);
+  g_list_free (free_);
+
+  return TRUE;
+}
