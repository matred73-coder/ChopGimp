 static GdkMonitor       *initial_monitor  = NULL;
 
 
+/*  ChopGimp: the interface fonts (Inter, Source Sans 3) shipped in
+ *  share/fonts/chopgimp.  On Linux (Flatpak) fontconfig finds them by
+ *  itself; on Windows the GTK interface draws with DirectWrite, which only
+ *  sees the fonts installed in the system or registered by the process.
+ */
+static void
+chopgimp_register_ui_fonts (void)
+{
+#ifdef G_OS_WIN32
+  gchar       *dir = g_build_filename (gimp_installation_directory (),
+                                       "share", "fonts", "chopgimp", NULL);
+  GDir        *gdir = g_dir_open (dir, 0, NULL);
+  const gchar *name;
+
+  if (gdir)
+    {
+      while ((name = g_dir_read_name (gdir)))
+        if (g_str_has_suffix (name, ".ttf"))
+          {
+            gchar    *path  = g_build_filename (dir, name, NULL);
+            gunichar2 *wpath = g_utf8_to_utf16 (path, -1, NULL, NULL, NULL);
+
+            if (wpath)
+              AddFontResourceExW ((LPCWSTR) wpath, FR_PRIVATE, 0);
+
+            g_free (wpath);
+            g_free (path);
+          }
+
+      g_dir_close (gdir);
+    }
+
+  g_free (dir);
+#endif
+}
+
 /*  public functions  */
 
 void
@@ -298,6 +338,7 @@ gui_init (Gimp         *gimp,
 
   gimp_dnd_init (gimp);
 
+  chopgimp_register_ui_fonts ();
   themes_init (gimp);
   gimp_canvas_styles_init ();
 
