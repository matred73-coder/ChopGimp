+/*  ChopGimp: appearance settings (chopgimprc [appearance]):
+ *    variant  palette (themes/ChopGimp/palette-<variant>.css)
+ *    accent   #RRGGBB, empty: the palette's own
+ *    density  compact | normal | comfortable
+ *    font     inter | source | system
+ */
+static void
+chopgimp_shade (const gchar *hex,
+                gdouble      factor,
+                gchar       *out)
+{
+  guint r = 0x37, g = 0x8E, b = 0xF0;
+
+  if (hex && strlen (hex) == 7)
+    sscanf (hex + 1, "%02x%02x%02x", &r, &g, &b);
+
+  if (factor > 1.0)   /* towards white */
+    {
+      r = r + (255 - r) * (factor - 1.0);
+      g = g + (255 - g) * (factor - 1.0);
+      b = b + (255 - b) * (factor - 1.0);
+    }
+  else
+    {
+      r *= factor;
+      g *= factor;
+      b *= factor;
+    }
+
+  g_snprintf (out, 8, "#%02X%02X%02X", MIN (r, 255), MIN (g, 255), MIN (b, 255));
+}
+
+static gchar *
+chopgimp_themes_appearance_css (void)
+{
+  GString *css     = g_string_new ("\n/* ChopGimp: apparence */\n");
+  gchar   *accent  = chopgimp_rc_get_string ("appearance", "accent", "");
+  gchar   *density = chopgimp_rc_get_string ("appearance", "density", "normal");
+
+  if (accent && strlen (accent) == 7 && accent[0] == '#')
+    {
+      gchar hover[8], pressed[8];
+
+      chopgimp_shade (accent, 1.15, hover);
+      chopgimp_shade (accent, 0.85, pressed);
+
+      g_string_append_printf (css,
+                              "@define-color ps-accent %s;\n"
+                              "@define-color ps-accent-hover %s;\n"
+                              "@define-color ps-accent-pressed %s;\n",
+                              accent, hover, pressed);
+    }
+
+  if (! g_strcmp0 (density, "compact"))
+    g_string_append (css,
+                     "button, entry, spinbutton, combobox button, notebook > header > tabs > tab "
+                     "{ min-height: 16px; padding-top: 0; padding-bottom: 0; }\n"
+                     "treeview.view { padding-top: 0; padding-bottom: 0; }\n"
+                     "menuitem { min-height: 18px; padding-top: 1px; padding-bottom: 1px; }\n");
+  else if (! g_strcmp0 (density, "comfortable"))
+    g_string_append (css,
+                     "button, entry, spinbutton, combobox button "
+                     "{ min-height: 28px; padding-top: 3px; padding-bottom: 3px; }\n"
+                     "notebook > header > tabs > tab { min-height: 26px; }\n"
+                     "treeview.view { padding-top: 3px; padding-bottom: 3px; }\n"
+                     "menuitem { min-height: 26px; padding-top: 4px; padding-bottom: 4px; }\n");
+
+  g_free (accent);
+  g_free (density);
+
+  return g_string_free (css, FALSE);
+}
+
+static void
+chopgimp_themes_set_font (void)
+{
+  static gchar *system_font = NULL;
+  GtkSettings  *settings    = gtk_settings_get_for_screen (gdk_screen_get_default ());
+  gchar        *font        = chopgimp_rc_get_string ("appearance", "font", "inter");
+  const gchar  *name;
+
+  /*  remember the desktop's font, for « Système »  */
+  if (! system_font)
+    g_object_get (settings, "gtk-font-name", &system_font, NULL);
+
+  if (! g_strcmp0 (font, "source"))
+    name = "Source Sans 3 10";
+  else if (! g_strcmp0 (font, "system"))
+    name = system_font;
+  else
+#ifdef G_OS_WIN32
+    name = "Inter, Segoe UI 9";
+#else
+    name = "Inter 9";
+#endif
+
+  if (name)
+    g_object_set (settings, "gtk-font-name", name, NULL);
+
+  g_free (font);
+}
