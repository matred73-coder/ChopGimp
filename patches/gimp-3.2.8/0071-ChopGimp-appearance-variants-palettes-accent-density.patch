+void
+chopgimp_rc_set_string (const gchar *group,
+                        const gchar *key,
+                        const gchar *value)
+{
+  gchar *path = chopgimp_rc_path ();
+
+  if (value)
+    g_key_file_set_string (chopgimp_rc_get (), group, key, value);
+  else
+    g_key_file_remove_key (chopgimp_rc_get (), group, key, NULL);
+
+  g_key_file_save_to_file (chopgimp_rc, path, NULL);
