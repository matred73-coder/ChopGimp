diff --git a/app/actions/windows-commands.c b/app/actions/windows-commands.c
index a7b11a4..37dab8b 100644
--- a/app/actions/windows-commands.c
+++ b/app/actions/windows-commands.c
@@ -27,6 +27,7 @@
 #include "actions-types.h"
 
