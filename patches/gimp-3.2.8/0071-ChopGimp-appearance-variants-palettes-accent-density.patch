   g_object_unref (info);
 }
+
+
+/*  ChopGimp: Affichage > Apparence — the settings are kept in chopgimprc
+ *  [appearance] and applied by app/gui/themes.c (re-read on « theme »)
+ */
+static void
+chopgimp_appearance_changed (Gimp *gimp)
+{
+  g_object_notify (G_OBJECT (gimp->config), "theme");
+}
+
+static gboolean
+chopgimp_appearance_store (const gchar *key,
+                           const gchar *value)
+{
+  gchar   *old     = chopgimp_rc_get_string ("appearance", key, NULL);
+  gboolean changed = g_strcmp0 (old, value) != 0;
+
+  if (changed)
+    chopgimp_rc_set_string ("appearance", key, value);
+
+  g_free (old);
+
+  return changed;
+}
+
+void
+windows_appearance_cmd_callback (GimpAction *action,
+                                 GVariant   *value,
+                                 gpointer    data)
+{
+  static const struct { const gchar *name; GimpThemeScheme scheme; } variants[] =
+  {
+    { "sombre",     GIMP_THEME_DARK  },
+    { "gris",       GIMP_THEME_GRAY  },
+    { "gris-clair", GIMP_THEME_LIGHT },
+    { "clair",      GIMP_THEME_LIGHT },
+    { "contraste",  GIMP_THEME_DARK  },
+    { "affinity",   GIMP_THEME_DARK  },
+    { "krita",      GIMP_THEME_DARK  },
+  };
+  Gimp *gimp;
+  gint  v;
+  return_if_no_gimp (gimp, data);
+
+  v = CLAMP (g_variant_get_int32 (value), 0, (gint) G_N_ELEMENTS (variants) - 1);
+
+  /*  (the menu also sets the radio item when it updates: no change)  */
+  if (! chopgimp_appearance_store ("variant", variants[v].name))
+    return;
+
+  /*  the scheme (light / gray / dark) gives the base styles, the variant
+   *  its palette; setting them notifies « theme » (re-applied)
+   */
+  g_object_set (gimp->config,
+                "theme",              "ChopGimp",
+                "theme-color-scheme", variants[v].scheme,
+                NULL);
+  chopgimp_appearance_changed (gimp);
+}
+
+void
+windows_accent_cmd_callback (GimpAction *action,
+                             GVariant   *value,
+                             gpointer    data)
+{
+  static const struct { const gchar *name; const gchar *color; } accents[] =
+  {
+    { "variante", ""        },
+    { "bleu",     "#378EF0" },
+    { "cyan",     "#00B4E6" },
+    { "violet",   "#8A63D2" },
+    { "vert",     "#2DA44E" },
+    { "orange",   "#F28C28" },
+    { "rouge",    "#E34850" },
+    { "rose",     "#E0529C" },
+    { "jaune",    "#E0B000" },
+  };
+  Gimp *gimp;
+  gint  a;
+  return_if_no_gimp (gimp, data);
+
+  a = CLAMP (g_variant_get_int32 (value), 0, (gint) G_N_ELEMENTS (accents) - 1);
+
+  if (chopgimp_appearance_store ("accent-name", accents[a].name))
+    {
+      chopgimp_rc_set_string ("appearance", "accent", accents[a].color);
+      chopgimp_appearance_changed (gimp);
+    }
+}
+
+void
+windows_density_cmd_callback (GimpAction *action,
+                              GVariant   *value,
+                              gpointer    data)
+{
+  static const gchar *names[] = { "compact", "normal", "comfortable" };
+  Gimp *gimp;
+  return_if_no_gimp (gimp, data);
+
+  if (chopgimp_appearance_store ("density",
+                                 names[CLAMP (g_variant_get_int32 (value), 0, 2)]))
+    chopgimp_appearance_changed (gimp);
+}
+
+void
+windows_ui_font_cmd_callback (GimpAction *action,
+                              GVariant   *value,
+                              gpointer    data)
+{
+  static const gchar *names[] = { "inter", "source", "system" };
+  Gimp *gimp;
+  return_if_no_gimp (gimp, data);
+
+  if (chopgimp_appearance_store ("font",
+                                 names[CLAMP (g_variant_get_int32 (value), 0, 2)]))
+    chopgimp_appearance_changed (gimp);
+}
+
+void
+windows_ui_size_cmd_callback (GimpAction *action,
+                              GVariant   *value,
+                              gpointer    data)
+{
+  static const struct { const gchar *name; gdouble font; gboolean override; GimpIconSize icons; } sizes[] =
+  {
+    { "90",  0.90, TRUE,  GIMP_ICON_SIZE_SMALL  },
+    { "100", 1.00, FALSE, GIMP_ICON_SIZE_SMALL  },
+    { "115", 1.15, TRUE,  GIMP_ICON_SIZE_MEDIUM },
+    { "130", 1.30, TRUE,  GIMP_ICON_SIZE_LARGE  },
+  };
+  Gimp *gimp;
+  gint  s;
+  return_if_no_gimp (gimp, data);
+
+  s = CLAMP (g_variant_get_int32 (value), 0, (gint) G_N_ELEMENTS (sizes) - 1);
+
+  if (! chopgimp_appearance_store ("size", sizes[s].name))
+    return;
+
+  /*  the Preferences' own settings: they re-apply the theme  */
+  g_object_set (gimp->config,
+                "font-relative-size",       sizes[s].font,
+                "override-theme-icon-size", sizes[s].override,
+                "custom-icon-size",         sizes[s].icons,
+                NULL);
+}
