From 1903046ed86204b939260677741e638a2ec3a2a2 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Thu, 26 Nov 2026 07:54:42 +0100
Subject: [PATCH 150/152] ChopGimp 3.29.4: fast cairo-ARGB32 to layer
 conversion for vector objects (babl fell back to its reference conversion:
 unpremultiplied in place, in parallel, with a lookup table, to R'G'B'A u8 of
 the layer's space; drag sprite and band rendering; CHOPGIMP_NO_FAST_BABL)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/path/chopgimp-vobject.c | 158 +++++++++++++++++++++++++++++++-----
 1 file changed, 137 insertions(+), 21 deletions(-)

diff --git a/app/path/chopgimp-vobject.c b/app/path/chopgimp-vobject.c
index cff8fa4..0fa79d9 100644
--- a/app/path/chopgimp-vobject.c
+++ b/app/path/chopgimp-vobject.c
@@ -4302,6 +4302,126 @@ union_ibounds (GimpVectorLayer *layer,
   return any;
 }
 
+/*  3.29.4: cairo-ARGB32 → layer.  babl has no conversion within the
+ *  error tolerance from cairo-ARGB32 to the layer format and falls back to
+ *  its slow reference conversion (~300 ms per drag frame on a large
+ *  vectorization).  The pixels are unpremultiplied here instead, in place
+ *  and in parallel, to R'G'B'A u8 of the layer's space (same TRC: no color
+ *  conversion), which is copied as is into an 8-bit perceptual layer and
+ *  converted by babl's fast paths otherwise.  Result: round (c × 255 / a),
+ *  what the reference conversion gives (± 1 at exact halves).
+ *  CHOPGIMP_NO_FAST_BABL=1: babl's conversion as before.
+ */
+static gboolean
+fast_babl_enabled (void)
+{
+  static gint enabled = -1;
+
+  if (enabled < 0)
+    enabled = (g_getenv ("CHOPGIMP_NO_FAST_BABL") == NULL);
+
+  return enabled;
+}
+
+static guint8 unpremul_lut[256][256];   /* [alpha][premultiplied value] */
+
+static void
+unpremul_lut_init (void)
+{
+  static gsize done = 0;
+
+  if (g_once_init_enter (&done))
+    {
+      for (gint a = 0; a < 256; a++)
+        for (gint c = 0; c < 256; c++)
+          {
+            gint v = a ? (c * 255 + a / 2) / a : 0;
+
+            unpremul_lut[a][c] = MIN (v, 255);
+          }
+
+      g_once_init_leave (&done, 1);
+    }
+}
+
+typedef struct
+{
+  guchar *data;
+  gint    stride;
+  gint    width;
+} UnpremulJob;
+
+static void
+unpremul_rows (gsize    offset,
+               gsize    size,
+               gpointer user_data)
+{
+  UnpremulJob *job = user_data;
+
+  for (gsize y = offset; y < offset + size; y++)
+    {
+      guint32 *px = (guint32 *) (job->data + y * job->stride);
+
+      for (gint x = 0; x < job->width; x++)
+        {
+          guint32 p = px[x];               /* native-endian ARGB */
+          guint   a = p >> 24;
+          guint   r = (p >> 16) & 0xff;
+          guint   g = (p >>  8) & 0xff;
+          guint   b =  p        & 0xff;
+          guint8 *o = (guint8 *) (px + x);
+
+          if (a != 255)
+            {
+              const guint8 *lut = unpremul_lut[a];
+
+              r = lut[r];
+              g = lut[g];
+              b = lut[b];
+            }
+
+          o[0] = r;
+          o[1] = g;
+          o[2] = b;
+          o[3] = a;
+        }
+    }
+}
+
+/*  writes a cairo ARGB32 image (@data, @stride, @rect's size) into @rect
+ *  of @buffer; @data is modified (unpremultiplied in place)
+ */
+static void
+put_argb32 (GeglBuffer          *buffer,
+            const GeglRectangle *rect,
+            const Babl          *space,
+            guchar              *data,
+            gint                 stride)
+{
+  UnpremulJob job = { data, stride, rect->width };
+
+  if (rect->width <= 0 || rect->height <= 0)
+    return;
+
+  if (! fast_babl_enabled ())
+    {
+      gegl_buffer_set (buffer, rect, 0,
+                       babl_format_with_space ("cairo-ARGB32", space),
+                       data, stride);
+      return;
+    }
+
+  unpremul_lut_init ();
+
+  gegl_parallel_distribute_range (rect->height,
+                                  MAX (1, 65536 / MAX (1, rect->width)),
+                                  unpremul_rows, &job);
+
+  gegl_buffer_set (buffer, rect, 0,
+                   babl_format_with_space ("R'G'B'A u8", space),
+                   data, stride);
+}
+
 /*  draws the objects of @rect (image coordinates) into @buffer, whose
  *  origin is (@u->x, @u->y)
  */
@@ -4310,8 +4430,7 @@ render_rect (GimpVectorLayer     *layer,
              GeglBuffer          *buffer,
              const GeglRectangle *u,
              const GeglRectangle *rect,
-             const Babl          *space,
-             const Babl          *fmt)
+             const Babl          *space)
 {
   ChopGimpVLayer *vl = layer->vobjects;
   gint            band_h;
@@ -4334,12 +4453,12 @@ render_rect (GimpVectorLayer     *layer,
       cairo_destroy (cr);
       cairo_surface_flush (surf);
 
-      gegl_buffer_set (buffer,
-                       GEGL_RECTANGLE (band.x - u->x, band.y - u->y,
-                                       band.width, band.height),
-                       0, fmt,
-                       cairo_image_surface_get_data (surf),
-                       cairo_image_surface_get_stride (surf));
+      put_argb32 (buffer,
+                  GEGL_RECTANGLE (band.x - u->x, band.y - u->y,
+                                  band.width, band.height),
+                  space,
+                  cairo_image_surface_get_data (surf),
+                  cairo_image_surface_get_stride (surf));
 
       cairo_surface_destroy (surf);
     }
@@ -4359,7 +4478,6 @@ vlayer_render_region (GimpVectorLayer     *layer,
   GimpItem      *item     = GIMP_ITEM (layer);
   ChopGimpVLayer *vl      = layer->vobjects;
   const Babl    *space;
-  const Babl    *fmt;
   GeglBuffer    *buffer;
   GeglRectangle  u, cur, region;
   gboolean       full;
@@ -4372,7 +4490,6 @@ vlayer_render_region (GimpVectorLayer     *layer,
   vlayer_check_layer_lpe (layer);
 
   space = babl_format_get_space (gimp_drawable_get_format (drawable));
-  fmt   = babl_format_with_space ("cairo-ARGB32", space);
 
   gimp_item_get_offset (item, &cur.x, &cur.y);
   cur.width  = gimp_item_get_width  (item);
@@ -4436,32 +4553,32 @@ vlayer_render_region (GimpVectorLayer     *layer,
 
       /*  the dirty part, and the new strips outside the old bounds  */
       if (gegl_rectangle_intersect (&d, dirty, &u))
-        render_rect (layer, buffer, &u, &d, space, fmt);
+        render_rect (layer, buffer, &u, &d, space);
 
       if (cur.y > u.y)
         render_rect (layer, buffer, &u,
-                     GEGL_RECTANGLE (u.x, u.y, u.width, cur.y - u.y), space, fmt);
+                     GEGL_RECTANGLE (u.x, u.y, u.width, cur.y - u.y), space);
       if (cur.y + cur.height < u.y + u.height)
         render_rect (layer, buffer, &u,
                      GEGL_RECTANGLE (u.x, cur.y + cur.height, u.width,
-                                     u.y + u.height - cur.y - cur.height), space, fmt);
+                                     u.y + u.height - cur.y - cur.height), space);
       {
         gint y1 = MAX (u.y, cur.y);
         gint y2 = MIN (u.y + u.height, cur.y + cur.height);
 
         if (y2 > y1 && cur.x > u.x)
           render_rect (layer, buffer, &u,
-                       GEGL_RECTANGLE (u.x, y1, cur.x - u.x, y2 - y1), space, fmt);
+                       GEGL_RECTANGLE (u.x, y1, cur.x - u.x, y2 - y1), space);
         if (y2 > y1 && cur.x + cur.width < u.x + u.width)
           render_rect (layer, buffer, &u,
                        GEGL_RECTANGLE (cur.x + cur.width, y1,
                                        u.x + u.width - cur.x - cur.width, y2 - y1),
-                       space, fmt);
+                       space);
       }
     }
   else
     {
-      render_rect (layer, buffer, &u, &region, space, fmt);
+      render_rect (layer, buffer, &u, &region, space);
     }
 
   if (full)
@@ -6238,7 +6355,6 @@ sprite_show (GimpVectorLayer *layer)
   GimpDrawable   *drawable = GIMP_DRAWABLE (layer);
   GimpItem       *item     = GIMP_ITEM (layer);
   const Babl     *space    = babl_format_get_space (gimp_drawable_get_format (drawable));
-  const Babl     *fmt      = babl_format_with_space ("cairo-ARGB32", space);
   GeglRectangle   cur, now, d;
   cairo_surface_t *surf;
   cairo_t        *cr;
@@ -6303,10 +6419,10 @@ sprite_show (GimpVectorLayer *layer)
   cairo_destroy (cr);
   cairo_surface_flush (surf);
 
-  gegl_buffer_set (gimp_drawable_get_buffer (drawable),
-                   GEGL_RECTANGLE (d.x - cur.x, d.y - cur.y, d.width, d.height),
-                   0, fmt, cairo_image_surface_get_data (surf),
-                   cairo_image_surface_get_stride (surf));
+  put_argb32 (gimp_drawable_get_buffer (drawable),
+              GEGL_RECTANGLE (d.x - cur.x, d.y - cur.y, d.width, d.height),
+              space, cairo_image_surface_get_data (surf),
+              cairo_image_surface_get_stride (surf));
   cairo_surface_destroy (surf);
 
   gimp_drawable_update (drawable, d.x - cur.x, d.y - cur.y, d.width, d.height);
-- 
2.53.0

