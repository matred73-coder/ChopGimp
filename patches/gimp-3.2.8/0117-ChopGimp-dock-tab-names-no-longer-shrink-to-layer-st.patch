From 2314b3e38c971f1826fe4f4dfef2bccca5f3a0af Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Mon, 23 Nov 2026 06:47:47 +0100
Subject: [PATCH] =?UTF-8?q?ChopGimp:=20dock=20tab=20names=20no=20longer=20?=
 =?UTF-8?q?shrink=20to=20=C2=AB=20=E2=80=A6=20=C2=BB;=20layer=20style=20op?=
 =?UTF-8?q?acities=20in=20%=20(slider=200=E2=80=93100=20%)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 app/propgui/gimppropgui-layer-style.c | 20 ++++++++++++++++++++
 app/widgets/gimpdockbook.c            |  7 +++++++
 2 files changed, 27 insertions(+)

diff --git a/app/propgui/gimppropgui-layer-style.c b/app/propgui/gimppropgui-layer-style.c
index 8a79b59..4d6c59f 100644
--- a/app/propgui/gimppropgui-layer-style.c
+++ b/app/propgui/gimppropgui-layer-style.c
@@ -141,6 +141,26 @@ layer_style_add_prop (GtkWidget            *vbox,
         }
     }
 
+  /*  opacities in percent, as in Photoshop (GEGL stores 0.0 – 1.0 or 2.0)  */
+  if (GIMP_IS_SPIN_SCALE (widget) && ! strcmp (property, "opacity"))
+    {
+      GParamSpec *pspec = g_object_class_find_property (G_OBJECT_GET_CLASS (config),
+                                                        property);
+
+      if (G_IS_PARAM_SPEC_DOUBLE (pspec) &&
+          G_PARAM_SPEC_DOUBLE (pspec)->maximum <= 2.0)
+        {
+          gimp_prop_widget_set_factor (widget, 100.0, 1.0, 10.0, 0);
+          /*  the slider spans 0 – 100 % (GEGL allows up to 200 %)  */
+          gimp_spin_scale_set_scale_limits (GIMP_SPIN_SCALE (widget),
+                                            0.0, 100.0);
+
+          if (g_object_class_find_property (G_OBJECT_GET_CLASS (widget),
+                                            "unit-suffix"))
+            g_object_set (widget, "unit-suffix", "%", NULL);
+        }
+    }
+
   if (label)
     {
       GtkWidget *hbox;
diff --git a/app/widgets/gimpdockbook.c b/app/widgets/gimpdockbook.c
index 4a6c7a3..708b38f 100644
--- a/app/widgets/gimpdockbook.c
+++ b/app/widgets/gimpdockbook.c
@@ -1224,6 +1224,13 @@ gimp_dockbook_create_tab_widget (GimpDockbook *dockbook,
                   gtk_label_set_ellipsize (GTK_LABEL (list->data),
                                            PANGO_ELLIPSIZE_END);
                   gtk_label_set_max_width_chars (GTK_LABEL (list->data), 18);
+                  /*  an ellipsized label asks for the width of « … » only,
+                   *  so the notebook shrank every name to « … »: ask for the
+                   *  name itself (capped); names that don't fit are hidden
+                   *  on the inactive tabs by gimp_dockbook_chop_labels_idle
+                   */
+                  gtk_label_set_width_chars (GTK_LABEL (list->data),
+                                             MIN (14, g_utf8_strlen (gtk_label_get_text (GTK_LABEL (list->data)), -1)));
                   g_object_set_data (G_OBJECT (tab_widget),
                                      "chopgimp-tab-label", list->data);
                 }
