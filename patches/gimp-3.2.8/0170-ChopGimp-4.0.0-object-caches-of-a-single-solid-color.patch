+
+              gegl_color_get_pixel (layer_color, babl_format ("R'G'B'A double"), rgba);
+              cairo_set_source_rgba (cr, rgba[0], rgba[1], rgba[2], rgba[3]);
               if (mask)
                 cairo_mask_surface (cr, mask_image, x, y);
               else
