+++ b/app/display/gimpcanvaspath.h
@@ -56,3 +56,6 @@ GimpCanvasItem * gimp_canvas_path_new      (GimpDisplayShell     *shell,
 
 void             gimp_canvas_path_set      (GimpCanvasItem       *path,
                                             const GimpBezierDesc *bezier);
+void             gimp_canvas_path_set_fill_color (GimpCanvasItem *path,
+                                                  GeglColor      *color,
+                                                  gdouble         opacity);
diff --git a/app/path/chopgimp-vobject.c b/app/path/chopgimp-vobject.c
index 8ab13b2..9629c40 100644
--- a/app/path/chopgimp-vobject.c
+++ b/app/path/chopgimp-vobject.c
@@ -4160,6 +4160,61 @@ draw_leaf (cairo_t         *cr,
   cairo_restore (cr);
 }
 
+/*  4.0.0: a leaf painted in a single solid color (every painted entry a
+ *  flat color, the same one, in Normal mode: the case of every traced
+ *  shape) is cached as its coverage only, A8 instead of ARGB32 (a quarter
+ *  of the memory), and painted through it in its color.  The color's
+ *  alpha and the entries' opacities stay in the coverage.
+ *  CHOPGIMP_NO_A8_CACHE=1: ARGB32 caches as before.
+ */
+static gboolean
+leaf_mono (ChopGimpVObject *o,
+           const Babl      *space,
+           gdouble          rgb[3])
+{
+  static gint           enabled = -1;
+  const ChopGimpVStyle *st      = &o->style;
+  gboolean              any     = FALSE;
+
+  if (enabled < 0)
+    enabled = (g_getenv ("CHOPGIMP_NO_A8_CACHE") == NULL);
+
+  if (! enabled)
+    return FALSE;
+
+  for (gint k = 0; k < chopgimp_vstyle_get_n_entries (st); k++)
+    {
+      ChopGimpVEntry       *e = chopgimp_vstyle_get_entry (st, k);
+      const ChopGimpVEntry *fill;
+      const ChopGimpPaint  *p;
+      gdouble               rgba[4];
+
+      if (! chopgimp_ventry_is_painted (e))
+        continue;
+
+      fill = e->follow_fill ? chopgimp_vstyle_get_fill (st) : NULL;
+      p    = fill ? &fill->paint : &e->paint;
+
+      if (p->type != CHOPGIMP_PAINT_COLOR || ! p->color ||
+          mode_operator (e->mode) != CAIRO_OPERATOR_OVER)
+        return FALSE;
+
+      color_rgba (p->color, space, rgba);
+
+      if (! any)
+        {
+          rgb[0] = rgba[0]; rgb[1] = rgba[1]; rgb[2] = rgba[2];
+          any = TRUE;
+        }
+      else if (rgb[0] != rgba[0] || rgb[1] != rgba[1] || rgb[2] != rgba[2])
+        {
+          return FALSE;
+        }
+    }
+
+  return any;
+}
+
 static cairo_surface_t *
 leaf_cache (GimpVectorLayer     *layer,
             ChopGimpVObject     *o,
@@ -4173,9 +4228,14 @@ leaf_cache (GimpVectorLayer     *layer,
     return NULL;
 
   {
-    cairo_surface_t *surf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
-                                                        ib->width, ib->height);
-    cairo_t         *cr   = cairo_create (surf);
+    cairo_surface_t *surf;
+    cairo_t         *cr;
+
+    o->cache_a8 = leaf_mono (o, space, o->cache_rgb);
+    surf = cairo_image_surface_create (o->cache_a8 ? CAIRO_FORMAT_A8
+                                                   : CAIRO_FORMAT_ARGB32,
+                                       ib->width, ib->height);
+    cr   = cairo_create (surf);
 
     cairo_translate (cr, -ib->x, -ib->y);
     draw_leaf (cr, layer, o, space);
@@ -4366,6 +4426,8 @@ par_collect (ParJob              *job,
       if (job->ext && ! par_prepare_leaf (o, path))
         return;
 
+      o->cache_a8 = leaf_mono (o, job->space, o->cache_rgb);
+
       g_ptr_array_add (job->leaves, o);
       g_array_append_val (job->rects, ib);
     }
@@ -4382,7 +4444,9 @@ par_draw (gint     i,
   while ((k = g_atomic_int_add (&job->next, 1)) < (gint) job->leaves->len)
     {
       const GeglRectangle *ib   = &g_array_index (job->rects, GeglRectangle, k);
-      cairo_surface_t     *surf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+      ChopGimpVObject     *o    = g_ptr_array_index (job->leaves, k);
+      cairo_surface_t     *surf = cairo_image_surface_create (o->cache_a8 ? CAIRO_FORMAT_A8
+                                                                          : CAIRO_FORMAT_ARGB32,
                                                               ib->width, ib->height);
       cairo_t             *cr   = cairo_create (surf);
 
@@ -4565,10 +4629,22 @@ composite (cairo_t             *cr,
       if (surf)
         {
           cairo_set_operator (cr, op);
-          cairo_set_source_surface (cr, surf,
-                                    o->cache_x + o->cache_fx,
-                                    o->cache_y + o->cache_fy);
-          cairo_paint_with_alpha (cr, o->opacity);
+
+          if (o->cache_a8)
+            {
+              cairo_set_source_rgba (cr, o->cache_rgb[0], o->cache_rgb[1],
+                                     o->cache_rgb[2], o->opacity);
+              cairo_mask_surface (cr, surf,
+                                  o->cache_x + o->cache_fx,
+                                  o->cache_y + o->cache_fy);
+            }
+          else
+            {
+              cairo_set_source_surface (cr, surf,
+                                        o->cache_x + o->cache_fx,
+                                        o->cache_y + o->cache_fy);
+              cairo_paint_with_alpha (cr, o->opacity);
+            }
         }
       else if (! simple)
         {
@@ -5763,6 +5839,8 @@ snapshot_fix_one (ChopGimpVObject *src,
       dst->cache_y  = src->cache_y;
       dst->cache_fx = src->cache_fx;
       dst->cache_fy = src->cache_fy;
+      dst->cache_a8 = src->cache_a8;
+      memcpy (dst->cache_rgb, src->cache_rgb, sizeof (src->cache_rgb));
     }
 
   memcpy (dst->bounds_valid, src->bounds_valid, sizeof (src->bounds_valid));
diff --git a/app/path/chopgimp-vobject.h b/app/path/chopgimp-vobject.h
index 7bda8eb..eeba96c 100644
--- a/app/path/chopgimp-vobject.h
+++ b/app/path/chopgimp-vobject.h
@@ -250,7 +250,10 @@ struct _ChopGimpVObject
   gboolean             effective_valid;
   guint64              rev;           /* 3.29.6: changed at every change of
                                        * the rendering (cache dropped or
-                                       * shifted); copies keep it            */
+                                       * shifted); copies keep it            */  gboolean             cache_a8;      /* 4.0.0: the cache is the coverage
+                                       * only (A8) of a single solid color,
+                                       * cache_rgb, painted through it       */
+  gdouble              cache_rgb[3];
 };
 
 
diff --git a/app/pdb/chopgimp-cmds.c b/app/pdb/chopgimp-cmds.c
index b5e1d42..462f307 100644
--- a/app/pdb/chopgimp-cmds.c
+++ b/app/pdb/chopgimp-cmds.c
@@ -840,6 +840,16 @@ vobjects_command_invoker (GimpProcedure         *procedure,
           chopgimp_vlayer_set_selection (layer, NULL, 0);
           done = TRUE;
         }
+      /*  4.0.0: clicking an object and the Pinceau goutte work on any
+       *  vector layer, as the tools do, including a layer whose single
+       *  object was never edited
+       */
+      else if ((g_str_has_prefix (cmd, "select-at:") ||
+                g_str_has_prefix (cmd, "select-add-at:") ||
+                g_str_has_prefix (cmd, "blob:")) &&
+               chopgimp_vobjects_layer_is_target (layer) &&
+               chopgimp_vmaterial_command (layer, context, cmd, &done))
+        ;
       else if (! chopgimp_vobjects_layer_is_multi (layer))
         done = FALSE;
       /*  3.29.3: selection by color / size, cleaning, colors  */
diff --git a/app/tools/chopgimp-blobtool.c b/app/tools/chopgimp-blobtool.c
index 0ff35e5..c36b7ec 100644
--- a/app/tools/chopgimp-blobtool.c
+++ b/app/tools/chopgimp-blobtool.c
@@ -490,6 +490,17 @@ gimp_vblob_tool_draw (GimpDrawTool *dt)
                 gimp_canvas_path_new (gimp_display_get_shell (dt->display),
                                       gimp_path_get_bezier (shape), 0, 0, TRUE,
                                       GIMP_PATH_STYLE_DEFAULT);
+              ChopGimpVStyle  style;
+              ChopGimpVEntry *fill;
+
+              /*  4.0.0: the preview in the color of the result  */
+              vblob_style (GIMP_PATH_OPTIONS (VBLOB_OPTIONS (bt)), image, &style);
+              fill = chopgimp_vstyle_get_fill (&style);
