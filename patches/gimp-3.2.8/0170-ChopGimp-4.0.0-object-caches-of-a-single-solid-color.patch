From 32ae19eebc718e58e6e3188c7bc11d502625d8b8 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Thu, 26 Nov 2026 21:26:55 +0100
Subject: [PATCH] ChopGimp 4.0.0: object caches of a single solid color kept as
 coverage (A8, a quarter of the memory); Blob brush preview in the color of
 its result; click selection and Blob brush by the PDB on a layer whose single
 object was never edited; an undoable parasite attached without undo no longer
 closes the caller's undo group; PDF export of a single-color layer without
 asking GTK for a monitor; unused d_free removed

---
 app/core/gimpitem.c               |  5 +-
 app/display/gimpcanvaspath.c      | 49 ++++++++++++++++
 app/display/gimpcanvaspath.h      |  3 +
 app/path/chopgimp-vobject.c       | 94 ++++++++++++++++++++++++++++---
 app/path/chopgimp-vobject.h       |  5 +-
 app/pdb/chopgimp-cmds.c           | 10 ++++
 app/tools/chopgimp-blobtool.c     | 11 ++++
 plug-ins/common/file-pdf-export.c |  9 ++-
 plug-ins/file-psd/psd-chopgimp.c  |  7 ---
 9 files changed, 175 insertions(+), 18 deletions(-)

diff --git a/app/core/gimpitem.c b/app/core/gimpitem.c
index eee56de..24a269b 100644
--- a/app/core/gimpitem.c
+++ b/app/core/gimpitem.c
@@ -2262,7 +2262,10 @@ gimp_item_parasite_attach (GimpItem           *item,
       gimp_parasite_attach (private->image->gimp, &copy);
     }
 
-  if (gimp_item_is_attached (item) &&
+  /*  ChopGimp 4.0.0: the group is closed only when it was opened (an
+   *  undoable parasite attached without undo closed the caller's group)
+   */
+  if (push_undo &&
       gimp_parasite_is_undoable (&copy))
     {
       gimp_image_undo_group_end (private->image);
diff --git a/app/display/gimpcanvaspath.c b/app/display/gimpcanvaspath.c
index 4da57ef..cdb3b86 100644
--- a/app/display/gimpcanvaspath.c
+++ b/app/display/gimpcanvaspath.c
@@ -56,6 +56,9 @@ struct _GimpCanvasPathPrivate
   gdouble       y;
   gboolean      filled;
   GimpPathStyle path_style;
+  gboolean      has_fill_rgba;  /* 4.0.0: filled in this color instead of
+                                 * the canvas style                     */
+  gdouble       fill_rgba[4];
 };
 
 #define GET_PRIVATE(path) \
@@ -77,6 +80,8 @@ static void             gimp_canvas_path_draw         (GimpCanvasItem *item,
 static cairo_region_t * gimp_canvas_path_get_extents  (GimpCanvasItem *item);
 static void             gimp_canvas_path_stroke       (GimpCanvasItem *item,
                                                        cairo_t        *cr);
+static void             gimp_canvas_path_fill         (GimpCanvasItem *item,
+                                                       cairo_t        *cr);
 
 
 G_DEFINE_TYPE_WITH_PRIVATE (GimpCanvasPath, gimp_canvas_path,
@@ -98,6 +103,7 @@ gimp_canvas_path_class_init (GimpCanvasPathClass *klass)
   item_class->draw           = gimp_canvas_path_draw;
   item_class->get_extents    = gimp_canvas_path_get_extents;
   item_class->stroke         = gimp_canvas_path_stroke;
+  item_class->fill           = gimp_canvas_path_fill;
 
   g_object_class_install_property (object_class, PROP_PATH,
                                    g_param_spec_boxed ("path", NULL, NULL,
@@ -319,6 +325,49 @@ gimp_canvas_path_stroke (GimpCanvasItem *item,
     }
 }
 
+static void
+gimp_canvas_path_fill (GimpCanvasItem *item,
+                       cairo_t        *cr)
+{
+  GimpCanvasPathPrivate *private = GET_PRIVATE (item);
+
+  if (private->has_fill_rgba)
+    {
+      cairo_set_source_rgba (cr, private->fill_rgba[0], private->fill_rgba[1],
+                             private->fill_rgba[2], private->fill_rgba[3]);
+      cairo_fill (cr);
+    }
+  else
+    {
+      GIMP_CANVAS_ITEM_CLASS (parent_class)->fill (item, cr);
+    }
+}
+
+/*  4.0.0: a filled path drawn in @color (with @opacity) instead of the
+ *  canvas style (preview of the Blob brush in the color of its result)
+ */
+void
+gimp_canvas_path_set_fill_color (GimpCanvasItem *path,
+                                 GeglColor      *color,
+                                 gdouble         opacity)
+{
+  GimpCanvasPathPrivate *private;
+
+  g_return_if_fail (GIMP_IS_CANVAS_PATH (path));
+
+  private = GET_PRIVATE (path);
+  private->has_fill_rgba = (color != NULL);
+
+  if (color)
+    {
+      gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), private->fill_rgba);
+      private->fill_rgba[3] *= CLAMP (opacity, 0.0, 1.0);
+    }
+
+  gimp_canvas_item_begin_change (path);
+  gimp_canvas_item_end_change (path);
+}
+
 GimpCanvasItem *
 gimp_canvas_path_new (GimpDisplayShell     *shell,
                       const GimpBezierDesc *bezier,
