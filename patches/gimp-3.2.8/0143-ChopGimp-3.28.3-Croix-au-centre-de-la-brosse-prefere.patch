---
 app/config/gimpdisplayconfig.c   | 18 ++++++++++++++++++
 app/config/gimpdisplayconfig.h   |  1 +
 app/dialogs/preferences-dialog.c | 20 ++++++++++++++++++++
 app/tools/gimppainttool.c        | 26 +++++++++++++++++++++++++-
 4 files changed, 64 insertions(+), 1 deletion(-)

diff --git a/app/config/gimpdisplayconfig.c b/app/config/gimpdisplayconfig.c
index b8f4848..e70939a 100644
--- a/app/config/gimpdisplayconfig.c
+++ b/app/config/gimpdisplayconfig.c
@@ -65,6 +65,7 @@ enum
   PROP_SHOW_BRUSH_OUTLINE,
   PROP_SNAP_BRUSH_OUTLINE,
   PROP_SHOW_PAINT_TOOL_CURSOR,
+  PROP_BRUSH_CROSSHAIR,
   PROP_IMAGE_TITLE_FORMAT,
   PROP_IMAGE_STATUS_FORMAT,
   PROP_MODIFIERS_MANAGER,
@@ -257,6 +258,17 @@ gimp_display_config_class_init (GimpDisplayConfigClass *klass)
                             TRUE,
                             GIMP_PARAM_STATIC_STRINGS);
 
+  /*  ChopGimp 3.28.3 (Photoshop « crosshair in brush tip »):
+   *  0 always, 1 small brushes only (3.24.10), 2 never
+   */
+  GIMP_CONFIG_PROP_INT (object_class, PROP_BRUSH_CROSSHAIR,
+                        "brush-crosshair",
+                        "Croix au centre de la brosse",
+                        "Petite croix au centre du contour de la brosse : "
+                        "0 toujours, 1 petites brosses seulement, 2 jamais",
+                        0, 2, 0,
+                        GIMP_PARAM_STATIC_STRINGS);
+
   GIMP_CONFIG_PROP_STRING (object_class, PROP_IMAGE_TITLE_FORMAT,
                            "image-title-format",
                            "Image title format",
@@ -546,6 +558,9 @@ gimp_display_config_set_property (GObject      *object,
     case PROP_SHOW_PAINT_TOOL_CURSOR:
       display_config->show_paint_tool_cursor = g_value_get_boolean (value);
       break;
+    case PROP_BRUSH_CROSSHAIR:
+      display_config->brush_crosshair = g_value_get_int (value);
+      break;
     case PROP_IMAGE_TITLE_FORMAT:
       g_set_str (&display_config->image_title_format, g_value_get_string (value));
       break;
@@ -677,6 +692,9 @@ gimp_display_config_get_property (GObject    *object,
     case PROP_SHOW_PAINT_TOOL_CURSOR:
       g_value_set_boolean (value, display_config->show_paint_tool_cursor);
       break;
+    case PROP_BRUSH_CROSSHAIR:
+      g_value_set_int (value, display_config->brush_crosshair);
+      break;
     case PROP_IMAGE_TITLE_FORMAT:
       g_value_set_string (value, display_config->image_title_format);
       break;
diff --git a/app/config/gimpdisplayconfig.h b/app/config/gimpdisplayconfig.h
index b595bd7..f4ef2a5 100644
--- a/app/config/gimpdisplayconfig.h
+++ b/app/config/gimpdisplayconfig.h
@@ -58,6 +58,7 @@ struct _GimpDisplayConfig
   gboolean            show_brush_outline;
   gboolean            snap_brush_outline;
   gboolean            show_paint_tool_cursor;
+  gint                brush_crosshair;   /* ChopGimp: 0 always, 1 small, 2 never */
   gchar              *image_title_format;
   gchar              *image_status_format;
   gdouble             monitor_xres;
diff --git a/app/dialogs/preferences-dialog.c b/app/dialogs/preferences-dialog.c
index 43f031c..ca781ae 100644
--- a/app/dialogs/preferences-dialog.c
+++ b/app/dialogs/preferences-dialog.c
@@ -3584,6 +3584,26 @@ prefs_boolean_combo_box_add (object, "initial-zoom-to-fit",
                           _("Show pointer for paint _tools"),
                           GTK_BOX (vbox2));
 
+  /*  ChopGimp 3.28.3: « Croix au centre de la brosse » (Photoshop)  */
+  {
+    GtkListStore *crosshair_store;
+    GtkWidget    *crosshair_grid;
+    GtkWidget    *crosshair_combo;
+
+    crosshair_store = gimp_int_store_new ("Toujours",                  0,
+                                          "Petites brosses seulement", 1,
+                                          "Jamais",                    2,
+                                          NULL);
+    crosshair_combo = gimp_prop_int_combo_box_new (object, "brush-crosshair",
+                                                   GIMP_INT_STORE (crosshair_store));
+    g_object_unref (crosshair_store);
+
+    crosshair_grid = prefs_grid_new (GTK_CONTAINER (vbox2));
+    prefs_widget_add_aligned (crosshair_combo,
+                              "Croix au centre de la _brosse :",
+                              GTK_GRID (crosshair_grid), 0, FALSE, NULL);
+  }
+
   /*  Extended Input Devices  */
   vbox2 = prefs_frame_new (_("Extended Input Devices"),
                            GTK_CONTAINER (vbox), FALSE);
diff --git a/app/tools/gimppainttool.c b/app/tools/gimppainttool.c
index 603c651..ebf495e 100644
--- a/app/tools/gimppainttool.c
+++ b/app/tools/gimppainttool.c
@@ -958,6 +958,30 @@ chopgimp_paint_tool_screen_size (GimpDrawTool *draw_tool,
   return image_size * MAX (shell->scale_x, shell->scale_y);
 }
 
+/*  ChopGimp 3.28.3: Préférences > Périphériques d'entrée > « Croix au
+ *  centre de la brosse » (gimprc brush-crosshair): always (default),
+ *  small brushes only (the 3.24.10 behaviour) or never; read at each
+ *  redraw, so a change applies at once
+ */
+static gboolean
+chopgimp_paint_tool_want_crosshair (GimpDrawTool *draw_tool,
+                                    gdouble       tip_size)
+{
+  GimpDisplayConfig *config;
+
+  config = GIMP_DISPLAY_CONFIG (GIMP_TOOL (draw_tool)->tool_info->gimp->config);
+
+  switch (config->brush_crosshair)
+    {
+    case 1:
+      return tip_size < CHOPGIMP_SMALL_TIP_SIZE;
+    case 2:
+      return FALSE;
+    default:
+      return TRUE;
+    }
+}
+
 static void
 gimp_paint_tool_draw (GimpDrawTool *draw_tool)
 {
@@ -1117,7 +1141,7 @@ gimp_paint_tool_draw (GimpDrawTool *draw_tool)
        *  (no outline at all here means the outline was too small)
        */
       if (paint_tool->draw_brush &&
-          tip_size < CHOPGIMP_SMALL_TIP_SIZE)
+          chopgimp_paint_tool_want_crosshair (draw_tool, tip_size))
         {
           gimp_draw_tool_add_handle (draw_tool,
                                      GIMP_HANDLE_CROSS,
-- 
