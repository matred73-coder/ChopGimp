+
+/*  dragging on the canvas moves an offset (GIMP_CONTROLLER_TYPE_OFFSET)  */
+
+static void
+offset_controller_callback (OffsetController *ctl,
+                            GeglRectangle    *area,
+                            gdouble           x,
+                            gdouble           y)
+{
+  const gchar *x_prop = NULL;
+  const gchar *y_prop = NULL;
+
+  ctl->area = *area;
+
+  ctl->get_props (ctl->config, &x_prop, &y_prop);
+
+  if (x_prop && y_prop)
+    g_object_set (ctl->config,
+                  x_prop, x,
+                  y_prop, y,
+                  NULL);
+}
+
+static void
+offset_controller_config_notify (GObject          *config,
+                                 const GParamSpec *pspec,
+                                 OffsetController *ctl)
+{
+  GimpControllerOffsetCallback  set_func;
+  const gchar                  *x_prop = NULL;
+  const gchar                  *y_prop = NULL;
+  gdouble                       x;
+  gdouble                       y;
+
+  ctl->get_props (config, &x_prop, &y_prop);
+
+  if (! x_prop || ! y_prop)
+    return;
+
+  g_object_get (config,
+                x_prop, &x,
+                y_prop, &y,
+                NULL);
+
+  set_func = (GimpControllerOffsetCallback) ctl->set_func;
+
+  set_func (ctl->set_data, &ctl->area, x, y);
+}
+
+static void
+offset_controller_free (OffsetController *ctl)
+{
+  g_slice_free (OffsetController, ctl);
+}
+
+static void
+layer_style_add_offset_controller (GObject                  *config,
+                                   GeglRectangle            *area,
+                                   OffsetPropsFunc           get_props,
+                                   const gchar              *status_title,
+                                   GimpCreateControllerFunc  create_controller_func,
+                                   gpointer                  creator)
+{
+  OffsetController *ctl;
+  OffsetController *old;
+
+  if (! create_controller_func)
+    return;
+
+  /*  a previous dialog on the same config  */
+  old = g_object_get_data (config, OFFSET_KEY);
+
+  if (old)
+    g_signal_handlers_disconnect_by_data (config, old);
+
+  ctl = g_slice_new0 (OffsetController);
+
+  ctl->config    = config;
+  ctl->get_props = get_props;
+
+  if (area)
+    ctl->area = *area;
+
+  ctl->set_func = create_controller_func (creator,
+                                          GIMP_CONTROLLER_TYPE_OFFSET,
+                                          status_title,
+                                          (GCallback) offset_controller_callback,
+                                          ctl,
+                                          &ctl->set_data);
+
+  g_object_set_data_full (config, OFFSET_KEY, ctl,
+                          (GDestroyNotify) offset_controller_free);
+
+  if (! ctl->set_func)
+    return;
+
+  offset_controller_config_notify (config, NULL, ctl);
+
+  g_signal_connect (config, "notify",
+                    G_CALLBACK (offset_controller_config_notify),
+                    ctl);
+}
+
+static void
+stroke_offset_props (GObject      *config,
+                     const gchar **x_prop,
+                     const gchar **y_prop)
+{
+  gint fill_type;
+
+  g_object_get (config, "fill-type", &fill_type, NULL);
+
+  /*  GimpContourFillType: color, gradient, pattern  */
+  switch (fill_type)
+    {
+    case 1:
+      *x_prop = "gradient-offset-x";
+      *y_prop = "gradient-offset-y";
+      break;
+
+    case 2:
+      *x_prop = "pattern-offset-x";
+      *y_prop = "pattern-offset-y";
+      break;
+
+    default:
+      break;
+    }
+}
+
+static void
+xy_offset_props (GObject      *config,
+                 const gchar **x_prop,
+                 const gchar **y_prop)
+{
+  *x_prop = "x";
+  *y_prop = "y";
+}
+
+
+/*  the parts of the fill shown for the fill type  */
+
+static void
+stroke_fill_type_notify (GObject          *config,
+                         const GParamSpec *pspec,
+                         GtkWidget        *stack)
+{
+  gint fill_type;
+
+  g_object_get (config, "fill-type", &fill_type, NULL);
+
+  gtk_widget_set_visible (g_object_get_data (G_OBJECT (stack), "color"),
+                          fill_type == 0);
+  gtk_widget_set_visible (g_object_get_data (G_OBJECT (stack), "gradient"),
+                          fill_type == 1);
+  gtk_widget_set_visible (g_object_get_data (G_OBJECT (stack), "pattern"),
+                          fill_type == 2);
+  gtk_widget_set_visible (g_object_get_data (G_OBJECT (stack), "hint"),
+                          fill_type != 0);
+}
+
+static void
+glow_source_notify (GObject          *config,
+                    const GParamSpec *pspec,
+                    GtkWidget        *stack)
+{
+  gboolean use_gradient;
+
+  g_object_get (config, "use-gradient", &use_gradient, NULL);
+
+  gtk_widget_set_visible (g_object_get_data (G_OBJECT (stack), "color"),
+                          ! use_gradient);
+  gtk_widget_set_visible (g_object_get_data (G_OBJECT (stack), "gradient"),
+                          use_gradient);
+}
+
+static void
+glow_source_toggled (GtkToggleButton *button,
+                     GObject         *config)
+{
+  if (gtk_toggle_button_get_active (button))
+    g_object_set (config,
+                  "use-gradient",
+                  GPOINTER_TO_INT (g_object_get_data (G_OBJECT (button),
+                                                      "use-gradient")),
+                  NULL);
+}
+
+static void
+glow_source_config_notify (GObject          *config,
+                           const GParamSpec *pspec,
+                           GtkWidget        *radio)
+{
+  gboolean use_gradient;
+
+  g_object_get (config, "use-gradient", &use_gradient, NULL);
+
+  if (use_gradient)
+    {
+      GSList *group = gtk_radio_button_get_group (GTK_RADIO_BUTTON (radio));
+
+      for (; group; group = g_slist_next (group))
+        if (GPOINTER_TO_INT (g_object_get_data (group->data, "use-gradient")))
+          gtk_toggle_button_set_active (group->data, TRUE);
+    }
+  else
+    {
+      gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (radio), TRUE);
+    }
+}
+
+
+/*  public functions  */
+
+/*  Contour (chopgimp:stroke), as Photoshop's "Contour": Structure, then
+ *  the fill, then GIMP's stroke options (dashes, caps, joins) folded
+ */
+GtkWidget *
+_gimp_prop_gui_new_chopgimp_stroke (GObject                  *config,
+                                    GParamSpec              **param_specs,
+                                    guint                     n_param_specs,
+                                    GeglRectangle            *area,
+                                    GimpContext              *context,
+                                    GimpCreatePickerFunc      create_picker_func,
+                                    GimpCreateControllerFunc  create_controller_func,
+                                    gpointer                  creator)
+{
+  GtkWidget *main_vbox;
+  GtkWidget *vbox;
+  GtkWidget *fill_vbox;
+  GtkWidget *box;
+  GtkWidget *expander;
+  GtkWidget *hint;
+
+  g_return_val_if_fail (G_IS_OBJECT (config), NULL);
+  g_return_val_if_fail (GIMP_IS_CONTEXT (context), NULL);
+
+  main_vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+
+  /*  Structure  */
+
+  vbox = layer_style_frame (main_vbox, "Structure");
+
+  layer_style_add_prop (vbox, config, "width", "Taille",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "position", "Position",
+                        area, context, create_picker_func, creator);
+  layer_style_add_mode (vbox, config, "mode");
+  layer_style_add_prop (vbox, config, "opacity", "Opacité",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "overprint", "Surimpression",
+                        area, context, create_picker_func, creator);
+
+  /*  Type de remplissage  */
+
+  vbox = layer_style_frame (main_vbox, "Type de remplissage");
+
+  layer_style_add_prop (vbox, config, "fill-type", "Remplissage",
+                        area, context, create_picker_func, creator);
+
+  /*  color  */
+  fill_vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+  gtk_box_pack_start (GTK_BOX (vbox), fill_vbox, FALSE, FALSE, 0);
+  g_object_set_data (G_OBJECT (main_vbox), "color", fill_vbox);
+
+  layer_style_add_prop (fill_vbox, config, "color", "Couleur",
+                        area, context, create_picker_func, creator);
+
+  /*  gradient  */
+  fill_vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+  gtk_box_pack_start (GTK_BOX (vbox), fill_vbox, FALSE, FALSE, 0);
+  g_object_set_data (G_OBJECT (main_vbox), "gradient", fill_vbox);
+
+  box = layer_style_resource_box (config, "gradient", STORE_GRADIENT_GGR,
+                                  context, "fill-type", 1);
+  gtk_box_pack_start (GTK_BOX (fill_vbox), box, FALSE, FALSE, 0);
+  gtk_widget_set_visible (box, TRUE);
+
+  layer_style_add_prop (fill_vbox, config, "gradient-reverse", "Inverser",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (fill_vbox, config, "gradient-style", "Style",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (fill_vbox, config, "gradient-angle", "Angle",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (fill_vbox, config, "gradient-scale", "Échelle (%)",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (fill_vbox, config, "align-with-layer",
+                        "Aligner sur le calque",
+                        area, context, create_picker_func, creator);
+  layer_style_add_offset (main_vbox, fill_vbox, config,
+                          "gradient-offset-x", "gradient-offset-y",
+                          area, context, create_picker_func, creator);
+
+  /*  pattern  */
+  fill_vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+  gtk_box_pack_start (GTK_BOX (vbox), fill_vbox, FALSE, FALSE, 0);
+  g_object_set_data (G_OBJECT (main_vbox), "pattern", fill_vbox);
+
+  box = layer_style_resource_box (config, "pattern", STORE_PATTERN,
+                                  context, "fill-type", 2);
+  gtk_box_pack_start (GTK_BOX (fill_vbox), box, FALSE, FALSE, 0);
+  gtk_widget_set_visible (box, TRUE);
+
+  layer_style_add_prop (fill_vbox, config, "pattern-scale", "Échelle (%)",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (fill_vbox, config, "pattern-angle", "Angle",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (fill_vbox, config, "align-with-layer",
+                        "Lier au calque",
+                        area, context, create_picker_func, creator);
+  layer_style_add_offset (main_vbox, fill_vbox, config,
+                          "pattern-offset-x", "pattern-offset-y",
+                          area, context, create_picker_func, creator);
+
+  hint = layer_style_add_hint (vbox,
+                               "Faites glisser sur l'image pour déplacer "
+                               "le dégradé ou le motif.");
+  g_object_set_data (G_OBJECT (main_vbox), "hint", hint);
+
+  g_signal_connect_object (config, "notify::fill-type",
+                           G_CALLBACK (stroke_fill_type_notify),
+                           main_vbox, 0);
+  stroke_fill_type_notify (config, NULL, main_vbox);
+
+  /*  ChopGimp's options, from Edit > Stroke Selection  */
+
+  expander = gtk_expander_new ("Options avancées (tirets, extrémités, angles)");
+  gtk_box_pack_start (GTK_BOX (main_vbox), expander, FALSE, FALSE, 0);
+  gtk_widget_set_visible (expander, TRUE);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+  gtk_container_add (GTK_CONTAINER (expander), vbox);
+  gtk_widget_set_visible (vbox, TRUE);
+
+  layer_style_add_prop (vbox, config, "antialias", NULL,
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "dash-preset", NULL,
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "cap-style", NULL,
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "join-style", NULL,
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "miter-limit", NULL,
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "threshold", NULL,
+                        area, context, create_picker_func, creator);
+
+  layer_style_add_offset_controller (config, area, stroke_offset_props,
+                                     "Contour : ",
+                                     create_controller_func, creator);
+
+  return main_vbox;
+}
+
+/*  ChopGimp 3.32.0: Satin (chopgimp:satin), as Photoshop's: Structure
+ *  (mode, color, opacity, angle, distance, size, contour, invert)
+ */
+GtkWidget *
+_gimp_prop_gui_new_chopgimp_satin (GObject                  *config,
+                                   GParamSpec              **param_specs,
+                                   guint                     n_param_specs,
+                                   GeglRectangle            *area,
+                                   GimpContext              *context,
+                                   GimpCreatePickerFunc      create_picker_func,
+                                   GimpCreateControllerFunc  create_controller_func,
+                                   gpointer                  creator)
+{
+  GtkWidget *main_vbox;
+  GtkWidget *vbox;
+
+  g_return_val_if_fail (G_IS_OBJECT (config), NULL);
+  g_return_val_if_fail (GIMP_IS_CONTEXT (context), NULL);
+
+  main_vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+
+  vbox = layer_style_frame (main_vbox, "Structure");
+
+  layer_style_add_mode (vbox, config, "mode");
+  layer_style_add_prop (vbox, config, "color", "Couleur",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "opacity", "Opacité",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "angle", "Angle",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "distance", "Distance",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "size", "Taille",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "contour", "Contour",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "invert", "Inverser",
+                        area, context, create_picker_func, creator);
+
+  return main_vbox;
+}
+
+/*  ChopGimp 3.32.0: Incrustation de motif (chopgimp:pattern-overlay), as
+ *  Photoshop's: mode, opacity, the pattern, angle, scale, « Lier au
+ *  calque », the offset (also moved by dragging on the image)
+ */
+GtkWidget *
+_gimp_prop_gui_new_chopgimp_pattern_overlay (GObject                  *config,
+                                             GParamSpec              **param_specs,
+                                             guint                     n_param_specs,
+                                             GeglRectangle            *area,
+                                             GimpContext              *context,
+                                             GimpCreatePickerFunc      create_picker_func,
+                                             GimpCreateControllerFunc  create_controller_func,
+                                             gpointer                  creator)
+{
+  GtkWidget *main_vbox;
+  GtkWidget *vbox;
+  GtkWidget *box;
+
+  g_return_val_if_fail (G_IS_OBJECT (config), NULL);
+  g_return_val_if_fail (GIMP_IS_CONTEXT (context), NULL);
+
+  main_vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+
+  vbox = layer_style_frame (main_vbox, "Motif");
+
+  layer_style_add_mode (vbox, config, "mode");
+  layer_style_add_prop (vbox, config, "opacity", "Opacité",
+                        area, context, create_picker_func, creator);
+
+  /*  GimpContourFillType 2: the pattern (stored at once if none is)  */
+  box = layer_style_resource_box (config, "pattern", STORE_PATTERN,
+                                  context, "fill-type", 2);
+  gtk_box_pack_start (GTK_BOX (vbox), box, FALSE, FALSE, 0);
+  gtk_widget_set_visible (box, TRUE);
+
+  layer_style_add_prop (vbox, config, "pattern-angle", "Angle",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "pattern-scale", "Échelle (%)",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "align-with-layer",
+                        "Lier au calque",
+                        area, context, create_picker_func, creator);
+  layer_style_add_offset (main_vbox, vbox, config,
+                          "pattern-offset-x", "pattern-offset-y",
+                          area, context, create_picker_func, creator);
+  layer_style_add_hint (vbox,
+                        "Faites glisser sur l'image pour déplacer le motif.");
+
+  layer_style_add_offset_controller (config, area, stroke_offset_props,
+                                     "Motif : ",
+                                     create_controller_func, creator);
+
+  return main_vbox;
+}
+
+/*  Ombre portée / Lueur externe (gegl:dropshadow) and Ombre interne /
+ *  Lueur interne (gegl:inner-glow), as Photoshop's: Structure (mode,
+ *  opacity, noise, color or gradient), Éléments (size, spread), Qualité
+ *  (contour, range), then the offset, also moved by dragging on the image
+ */
+static GtkWidget *
+layer_style_glow_gui (GObject                  *config,
+                      GeglRectangle            *area,
+                      GimpContext              *context,
+                      GimpCreatePickerFunc      create_picker_func,
+                      GimpCreateControllerFunc  create_controller_func,
+                      gpointer                  creator,
+                      gboolean                  inner)
+{
+  const gchar *color_prop = inner ? "value" : "color";
+  GtkWidget   *main_vbox;
+  GtkWidget   *vbox;
+  GtkWidget   *hbox;
+  GtkWidget   *source_vbox;
+  GtkWidget   *radio;
+  GtkWidget   *box;
+  GSList      *group = NULL;
+
+  main_vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+
+  /*  Structure  */
+
+  vbox = layer_style_frame (main_vbox, "Structure");
+
+  /*  the inner effects are blended with the layer's pixels by GIMP's
+   *  filter blend mode (the same as in "Options de fusion"); the drop
+   *  shadow and the outer glow onto the layers below, by their own
+   */
+  if (inner)
+    layer_style_add_mode (vbox, config, "gimp-mode");
+  else
+    layer_style_add_behind_mode (vbox, config);
+
+  layer_style_add_prop (vbox, config, "opacity", "Opacité",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "noise", "Bruit",
+                        area, context, create_picker_func, creator);
+
+  /*  Couleur / Dégradé  */
+  if (g_object_class_find_property (G_OBJECT_GET_CLASS (config),
+                                    "use-gradient"))
+    {
+      hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+      gtk_box_pack_start (GTK_BOX (vbox), hbox, FALSE, FALSE, 0);
+      gtk_widget_set_visible (hbox, TRUE);
+
+      radio = gtk_radio_button_new_with_label (group, "Couleur");
+      g_object_set_data (G_OBJECT (radio), "use-gradient", GINT_TO_POINTER (FALSE));
+      group = gtk_radio_button_get_group (GTK_RADIO_BUTTON (radio));
+      gtk_box_pack_start (GTK_BOX (hbox), radio, FALSE, FALSE, 0);
+      gtk_widget_set_visible (radio, TRUE);
+      g_signal_connect (radio, "toggled",
+                        G_CALLBACK (glow_source_toggled),
+                        config);
+
+      g_signal_connect_object (config, "notify::use-gradient",
+                               G_CALLBACK (glow_source_config_notify),
+                               radio, 0);
+
+      radio = gtk_radio_button_new_with_label (group, "Dégradé");
+      g_object_set_data (G_OBJECT (radio), "use-gradient", GINT_TO_POINTER (TRUE));
+      gtk_box_pack_start (GTK_BOX (hbox), radio, FALSE, FALSE, 0);
+      gtk_widget_set_visible (radio, TRUE);
+      g_signal_connect (radio, "toggled",
+                        G_CALLBACK (glow_source_toggled),
+                        config);
+
+      glow_source_config_notify (config, NULL,
+                                 GTK_WIDGET (g_slist_last (gtk_radio_button_get_group (GTK_RADIO_BUTTON (radio)))->data));
+    }
+
+  source_vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+  gtk_box_pack_start (GTK_BOX (vbox), source_vbox, FALSE, FALSE, 0);
+  gtk_widget_set_visible (source_vbox, TRUE);
+  g_object_set_data (G_OBJECT (main_vbox), "color", source_vbox);
+
+  layer_style_add_prop (source_vbox, config, color_prop, "Couleur",
+                        area, context, create_picker_func, creator);
+
+  if (g_object_class_find_property (G_OBJECT_GET_CLASS (config), "gradient"))
+    {
+      source_vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+      gtk_box_pack_start (GTK_BOX (vbox), source_vbox, FALSE, FALSE, 0);
+      g_object_set_data (G_OBJECT (main_vbox), "gradient", source_vbox);
+
+      box = layer_style_resource_box (config, "gradient",
+                                      STORE_GRADIENT_STOPS,
+                                      context, "use-gradient", TRUE);
+      gtk_box_pack_start (GTK_BOX (source_vbox), box, FALSE, FALSE, 0);
+      gtk_widget_set_visible (box, TRUE);
+
+      g_signal_connect_object (config, "notify::use-gradient",
+                               G_CALLBACK (glow_source_notify),
+                               main_vbox, 0);
+      glow_source_notify (config, NULL, main_vbox);
+    }
+
+  /*  Éléments  */
+
+  vbox = layer_style_frame (main_vbox, "Éléments");
+
+  layer_style_add_prop (vbox, config, "radius", "Taille",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "grow-radius",
+                        inner ? "Grossi" : "Étendue",
+                        area, context, create_picker_func, creator);
+  layer_style_add_prop (vbox, config, "grow-shape", "Forme",
+                        area, context, create_picker_func, creator);
+
+  if (inner)
+    layer_style_add_prop (vbox, config, "cover", NULL,
+                          area, context, create_picker_func, creator);
+
+  /*  Qualité  */
+
+  if (g_object_class_find_property (G_OBJECT_GET_CLASS (config), "contour"))
+    {
+      vbox = layer_style_frame (main_vbox, "Qualité");
+
+      layer_style_add_prop (vbox, config, "contour", "Contour",
+                            area, context, create_picker_func, creator);
+      layer_style_add_prop (vbox, config, "range", "Plage",
+                            area, context, create_picker_func, creator);
+    }
+
+  /*  Position  */
+
+  vbox = layer_style_frame (main_vbox, "Position");
+
+  layer_style_add_offset (main_vbox, vbox, config, "x", "y",
+                          area, context, create_picker_func, creator);
+  layer_style_add_hint (vbox,
+                        "Faites glisser sur l'image pour déplacer l'effet.");
+
+  layer_style_add_offset_controller (config, area, xy_offset_props,
+                                     inner ? "Ombre interne : " :
+                                             "Ombre portée : ",
+                                     create_controller_func, creator);
+
+  return main_vbox;
+}
+
+GtkWidget *
+_gimp_prop_gui_new_dropshadow (GObject                  *config,
+                               GParamSpec              **param_specs,
+                               guint                     n_param_specs,
+                               GeglRectangle            *area,
+                               GimpContext              *context,
+                               GimpCreatePickerFunc      create_picker_func,
+                               GimpCreateControllerFunc  create_controller_func,
+                               gpointer                  creator)
+{
+  g_return_val_if_fail (G_IS_OBJECT (config), NULL);
+  g_return_val_if_fail (GIMP_IS_CONTEXT (context), NULL);
+
+  return layer_style_glow_gui (config, area, context,
+                               create_picker_func, create_controller_func,
+                               creator, FALSE);
+}
+
+GtkWidget *
+_gimp_prop_gui_new_inner_glow (GObject                  *config,
+                               GParamSpec              **param_specs,
+                               guint                     n_param_specs,
+                               GeglRectangle            *area,
+                               GimpContext              *context,
+                               GimpCreatePickerFunc      create_picker_func,
+                               GimpCreateControllerFunc  create_controller_func,
+                               gpointer                  creator)
+{
+  g_return_val_if_fail (G_IS_OBJECT (config), NULL);
+  g_return_val_if_fail (GIMP_IS_CONTEXT (context), NULL);
+
+  return layer_style_glow_gui (config, area, context,
+                               create_picker_func, create_controller_func,
+                               creator, TRUE);
+}
