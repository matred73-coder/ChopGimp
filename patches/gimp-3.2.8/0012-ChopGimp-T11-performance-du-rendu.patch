diff --git a/app/operations/gimpoperationlayerstylefused.c b/app/operations/gimpoperationlayerstylefused.c
new file mode 100644
index 0000000..aad92e3
--- /dev/null
+++ b/app/operations/gimpoperationlayerstylefused.c
@@ -0,0 +1,2985 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * gimpoperationlayerstylefused.c
+ * ChopGimp: the layer style filters of a layer rendered in one operation
