diff --git a/app/gegl/gimp-gegl-graph-lock.c b/app/gegl/gimp-gegl-graph-lock.c
new file mode 100644
index 0000000..22b253b
--- /dev/null
+++ b/app/gegl/gimp-gegl-graph-lock.c
@@ -0,0 +1,781 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * gimp-gegl-graph-lock.c
+ * ChopGimp: keeps the main thread and the projection rendering thread
+ * away from each other's GEGL graph accesses.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*  The image graph is changed by the main thread without any lock (all
+ *  over app/core), and evaluated by the main thread too (lazy validation
+ *  of tiles, previews, bounding boxes...).  To render the projection in a
+ *  thread of its own, the main thread must never touch the graph while
+ *  that thread renders a chunk, and vice versa.
+ *
+ *  The "graph lock" is owned by the main thread by default.  The main
+ *  thread gives it up only when it waits for events in the main loop (in
+ *  the poll function of the outermost main loop), and takes it back
+ *  lazily, the first time it touches a GEGL graph afterwards: GEGL (patch
+ *  0006) calls our access function on entry of every function which
+ *  changes or evaluates a graph.  So all main-thread code runs exactly as
+ *  before with respect to the graph; it only waits, when it touches a
+ *  graph, for the chunk being rendered to be done (chunks are short).
+ *
+ *  The rendering thread takes the lock around each chunk, and lets the
+ *  main thread go first whenever it is waiting.
+ *
+ *  Code which touches graph-related state without going through GEGL
+ *  (tile validation handlers, the projection's own buffers) takes the
+ *  lock explicitly with gimp_gegl_graph_lock_main().  Inside a tile
+ *  handler, where a GEGL buffer mutex is held, it must not block:
+ *  gimp_gegl_graph_lock_try_main().
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gio/gio.h>
+#include <gegl.h>
+#include <gegl-plugin.h>
+
+#include "gimp-gegl-types.h"
+
+#include "gimp-gegl-graph-lock.h"
+
+
+enum
+{
+  OWNER_NONE,
+  OWNER_MAIN,
+  OWNER_WORKER
+};
+
+typedef struct
+{
+  GFunc    func;
+  gpointer data;
+} ThreadItem;
+
+
+static GThread     *main_thread  = NULL;
+static gboolean     initialized  = FALSE;
+static GMutex       lock_mutex;
+static GCond        lock_cond;
+static gint         owner        = OWNER_MAIN;  /* atomic reads */
+static gint         main_waiting = 0;
+static guint        serial       = 0;           /* atomic reads */
+static gint         base_depth   = -1;          /* main thread only */
+static GPollFunc    prev_poll    = NULL;
+static GAsyncQueue *queue        = NULL;
+
+
+/*  local functions  */
+
+static void
+gimp_gegl_graph_lock_acquire_main (void)
+{
+  g_mutex_lock (&lock_mutex);
+
+  main_waiting++;
+
+  while (owner == OWNER_WORKER)
+    g_cond_wait (&lock_cond, &lock_mutex);
+
+  main_waiting--;
+
+  g_atomic_int_set (&owner, OWNER_MAIN);
+  g_atomic_int_inc ((gint *) &serial);
+
+  g_mutex_unlock (&lock_mutex);
+}
+
+static void
+gimp_gegl_graph_lock_release_main (void)
+{
+  g_mutex_lock (&lock_mutex);
+
+  if (owner == OWNER_MAIN)
+    {
+      g_atomic_int_set (&owner, OWNER_NONE);
+      g_cond_broadcast (&lock_cond);
+    }
+
+  g_mutex_unlock (&lock_mutex);
+}
+
+/*  called by GEGL on entry of the functions changing or evaluating a
+ *  graph, in the calling thread
+ */
+static void
+gimp_gegl_graph_lock_access (gpointer data)
+{
+  if (g_thread_self () != main_thread)
+    return;
+
+  if (g_atomic_int_get (&owner) == OWNER_MAIN)
+    return;
+
+  gimp_gegl_graph_lock_acquire_main ();
+}
+
+static gint
+gimp_gegl_graph_lock_poll (GPollFD *ufds,
+                           guint    nfds,
+                           gint     timeout)
+{
+  if (g_thread_self () == main_thread)
+    {
+      gint depth = g_main_depth ();
+
+      if (base_depth < 0 || depth < base_depth)
+        base_depth = depth;
+
+      /*  only the outermost main loop gives the lock up: a nested main
+       *  loop (dialog, plug-in call, progress) may run in the middle of
+       *  a graph change
+       */
+      if (depth == base_depth &&
+          g_atomic_int_get (&owner) == OWNER_MAIN)
+        {
+          gimp_gegl_graph_lock_release_main ();
+        }
+    }
+
+  return prev_poll (ufds, nfds, timeout);
+}
+
+static gpointer
+gimp_gegl_graph_lock_thread_func (gpointer data)
+{
+  while (TRUE)
+    {
+      ThreadItem *item = g_async_queue_pop (queue);
+
+      item->func (item->data, NULL);
+
+      g_free (item);
+    }
+
+  return NULL;
+}
+
+
+/*  public functions  */
+
+/**
+ * gimp_gegl_graph_lock_threading_allowed:
+ *
+ * Returns: %FALSE when the CHOPGIMP_NO_THREADED_RENDER environment
+ * variable is set (to anything but "0"), which turns background
+ * rendering off whatever the preference.
+ */
+gboolean
+gimp_gegl_graph_lock_threading_allowed (void)
+{
+  static gint allowed = -1;
+
+  if (allowed < 0)
+    {
+      const gchar *env = g_getenv ("CHOPGIMP_NO_THREADED_RENDER");
+
+      allowed = (! env || ! *env || ! strcmp (env, "0"));
+    }
+
+  return allowed;
+}
+
+/**
+ * gimp_gegl_graph_lock_init:
+ *
+ * Installs the graph lock (GEGL access function and main loop poll
+ * function) and starts the rendering thread.  Must be called from the
+ * main thread, while it is running its main loop.  Can be called several
+ * times; once installed, the lock stays.
+ */
+void
+gimp_gegl_graph_lock_init (void)
+{
+  GMainContext *context;
+
+  if (initialized)
+    return;
+
+  main_thread = g_thread_self ();
+
+  g_mutex_init (&lock_mutex);
+  g_cond_init (&lock_cond);
+
+  owner = OWNER_MAIN;
+
+  context   = g_main_context_default ();
+  prev_poll = g_main_context_get_poll_func (context);
+
+  if (! prev_poll)
+    prev_poll = g_poll;
+
+  g_main_context_set_poll_func (context, gimp_gegl_graph_lock_poll);
+
+  queue = g_async_queue_new ();
+
+  g_thread_new ("chopgimp-render", gimp_gegl_graph_lock_thread_func, NULL);
+
+  gegl_set_graph_access_func (gimp_gegl_graph_lock_access, NULL);
+
+  initialized = TRUE;
+}
+
+gboolean
+gimp_gegl_graph_lock_is_initialized (void)
+{
+  return initialized;
+}
+
+gboolean
+gimp_gegl_graph_lock_is_main_thread (void)
+{
+  return (! main_thread || g_thread_self () == main_thread);
+}
+
+/**
+ * gimp_gegl_graph_lock_main:
+ *
+ * In the main thread, takes the graph lock (waiting for the chunk being
+ * rendered, if any) and keeps it until the main loop waits for events.
+ * Does nothing in other threads, or when the lock isn't installed.
+ *
+ * Must not be called while a GEGL buffer mutex is held (in a tile
+ * handler): use gimp_gegl_graph_lock_try_main() there.
+ */
+void
+gimp_gegl_graph_lock_main (void)
+{
+  if (! initialized || g_thread_self () != main_thread)
+    return;
+
+  if (g_atomic_int_get (&owner) == OWNER_MAIN)
+    return;
+
+  gimp_gegl_graph_lock_acquire_main ();
+}
+
+/**
+ * gimp_gegl_graph_lock_try_main:
+ *
+ * Like gimp_gegl_graph_lock_main(), without waiting.
+ *
+ * Returns: %TRUE if the caller may touch the graph: the main thread owns
+ * the lock, or the caller isn't the main thread, or the lock isn't
+ * installed.
+ */
+gboolean
+gimp_gegl_graph_lock_try_main (void)
+{
+  gboolean success = FALSE;
+
+  if (! initialized || g_thread_self () != main_thread)
+    return TRUE;
+
+  if (g_atomic_int_get (&owner) == OWNER_MAIN)
+    return TRUE;
+
+  g_mutex_lock (&lock_mutex);
+
+  if (owner == OWNER_NONE)
+    {
+      g_atomic_int_set (&owner, OWNER_MAIN);
+      g_atomic_int_inc ((gint *) &serial);
+
+      success = TRUE;
+    }
+
+  g_mutex_unlock (&lock_mutex);
+
+  return success;
+}
+
+gboolean
+gimp_gegl_graph_lock_main_owns (void)
+{
+  return (g_atomic_int_get (&owner) == OWNER_MAIN);
+}
+
+/**
+ * gimp_gegl_graph_lock_get_serial:
+ *
+ * Returns: a number which changes each time the main thread takes the
+ * graph lock, i.e. each time it may have changed a graph.
+ */
+guint
+gimp_gegl_graph_lock_get_serial (void)
+{
+  return (guint) g_atomic_int_get ((gint *) &serial);
+}
+
+/**
+ * gimp_gegl_graph_lock_is_base_dispatch:
+ *
+ * Returns: %TRUE if called from a main loop source dispatched by the
+ * outermost main loop: the main thread will give the lock up when this
+ * dispatch is done.
+ */
+gboolean
+gimp_gegl_graph_lock_is_base_dispatch (void)
+{
+  if (! initialized || g_thread_self () != main_thread || base_depth < 0)
+    return FALSE;
+
+  return (g_main_depth () == base_depth + 1);
+}
+
+/**
+ * gimp_gegl_graph_lock_worker_can_run:
+ *
+ * Returns: %FALSE if the main thread holds the lock in a nested main
+ * loop, so that the rendering thread is stuck until that loop ends.
+ */
+gboolean
+gimp_gegl_graph_lock_worker_can_run (void)
+{
+  if (! initialized)
+    return FALSE;
+
+  if (g_atomic_int_get (&owner) != OWNER_MAIN)
+    return TRUE;
+
+  return (base_depth >= 0 && g_main_depth () <= base_depth + 1);
+}
+
+void
+gimp_gegl_graph_lock_worker_acquire (void)
+{
+  g_mutex_lock (&lock_mutex);
+
+  while (owner != OWNER_NONE || main_waiting > 0)
+    g_cond_wait (&lock_cond, &lock_mutex);
+
+  g_atomic_int_set (&owner, OWNER_WORKER);
+
+  g_mutex_unlock (&lock_mutex);
+}
+
+void
+gimp_gegl_graph_lock_worker_release (void)
+{
+  g_mutex_lock (&lock_mutex);
+
+  if (owner == OWNER_WORKER)
+    {
+      g_atomic_int_set (&owner, OWNER_NONE);
+      g_cond_broadcast (&lock_cond);
+    }
+
+  g_mutex_unlock (&lock_mutex);
+}
+
+/**
+ * gimp_gegl_graph_run_in_thread:
+ * @func: the function to run
+ * @data: its first argument
+ *
+ * Runs @func in the rendering thread, after the functions queued before.
+ * The lock must be initialized.
+ */
+void
+gimp_gegl_graph_run_in_thread (GFunc    func,
+                               gpointer data)
+{
+  ThreadItem *item;
+
+  g_return_if_fail (initialized);
+
+  item       = g_new (ThreadItem, 1);
+  item->func = func;
+  item->data = data;
+
+  g_async_queue_push (queue, item);
+}
+
+
+/*  graph checks  */
+
+typedef gboolean (* NodeCheckFunc) (GeglNode      *node,
+                                    GeglOperation *operation);
+
+static gboolean
+gimp_gegl_graph_walk (GeglNode      *node,
+                      GHashTable    *visited,
+                      NodeCheckFunc  check)
+{
+  GeglOperation *operation = NULL;
+  GSList        *children;
+  GSList        *list;
+  gboolean       success   = TRUE;
+
+  if (! node || g_hash_table_contains (visited, node))
+    return TRUE;
+
+  g_hash_table_add (visited, node);
+
+  /*  not gegl_node_get_gegl_operation(), which counts as a graph access  */
+  g_object_get (node, "gegl-operation", &operation, NULL);
+
+  if (! check (node, operation))
+    {
+      success = FALSE;
+
+      if (g_getenv ("CHOPGIMP_DEBUG_GRAPH"))
+        g_printerr ("chopgimp: graph check failed at %s\n",
+                    operation ? gegl_operation_get_name (operation) : "?");
+    }
+
+  children = gegl_node_get_children (node);
+
+  for (list = children; list && success; list = g_slist_next (list))
+    {
+      if (! gimp_gegl_graph_walk (list->data, visited, check))
+        success = FALSE;
+    }
+
+  g_slist_free (children);
+
+  /*  follow the links leaving the graph too, but only from operation
+   *  nodes: gegl_node_get_producer() creates the proxies of graph nodes
+   *  (which includes meta operations)
+   */
+  if (success && operation && ! gegl_node_is_graph (node))
+    {
+      gchar **pads = gegl_node_list_input_pads (node);
+      gint    i;
+
+      for (i = 0; pads && pads[i] && success; i++)
+        {
+          GeglNode *producer = gegl_node_get_producer (node, pads[i], NULL);
+
+          if (producer &&
+              ! gimp_gegl_graph_walk (producer, visited, check))
+            {
+              success = FALSE;
+            }
+        }
+
+      g_strfreev (pads);
+    }
+
+  g_clear_object (&operation);
+
+  return success;
+}
+
+static gboolean
+gimp_gegl_graph_check (GeglNode      *graph,
+                       NodeCheckFunc  check)
+{
+  GHashTable *visited;
+  gboolean    success;
+
+  if (! graph)
+    return FALSE;
+
+  visited = g_hash_table_new (g_direct_hash, g_direct_equal);
+
+  success = gimp_gegl_graph_walk (graph, visited, check);
+
+  g_hash_table_unref (visited);
+
+  return success;
+}
+
+static gboolean
+gimp_gegl_graph_name_in (const gchar        *name,
+                         const gchar * const *names)
+{
+  gint i;
+
+  for (i = 0; names[i]; i++)
+    {
+      if (! strcmp (name, names[i]))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+/*  whether the operation's class has readable properties holding objects
+ *  (other than buffers and colors), which make an operation unsafe in the
+ *  rendering thread when they are set.  Cached on the type: the check
+ *  below runs for every node of the image graph, possibly at every
+ *  rendering job, and listing the properties of each operation dominated
+ *  it.  Thread-safe (type qdata is protected by GLib's type lock).
+ */
+static gboolean
+gimp_gegl_graph_class_has_object_props (GeglOperation *operation)
+{
+  static GQuark   quark = 0;
+  GType           type  = G_OBJECT_TYPE (operation);
+  gpointer        data;
+  GParamSpec    **pspecs;
+  guint           n_pspecs;
+  guint           i;
+  gboolean        has   = FALSE;
+
+  /*  racy, but every thread computes the same value  */
+  if (G_UNLIKELY (! quark))
+    quark = g_quark_from_static_string ("chopgimp-graph-object-props");
+
+  data = g_type_get_qdata (type, quark);
+
+  if (data)
+    return (GPOINTER_TO_INT (data) == 2);
+
+  pspecs = g_object_class_list_properties (G_OBJECT_GET_CLASS (operation),
+                                           &n_pspecs);
+
+  for (i = 0; i < n_pspecs && ! has; i++)
+    {
+      GParamSpec *pspec = pspecs[i];
+      GType       vtype = pspec->value_type;
+
+      if (! (pspec->flags & G_PARAM_READABLE))
+        continue;
+
+      if ((G_TYPE_IS_OBJECT (vtype) || G_TYPE_IS_INTERFACE (vtype)) &&
+          ! g_type_is_a (vtype, GEGL_TYPE_BUFFER)                  &&
+          ! g_type_is_a (vtype, GEGL_TYPE_COLOR))
+        {
+          has = TRUE;
+        }
+    }
+
+  g_free (pspecs);
+
+  g_type_set_qdata (type, quark, GINT_TO_POINTER (has ? 2 : 1));
+
+  return has;
+}
+
+/*  an operation can be processed in the rendering thread while the main
+ *  thread runs, if it only depends on plain property values (numbers,
+ *  enums, strings, colors) and buffers: objects of the application
+ *  (configurations, gradients, patterns, paths, curves...) are changed in
+ *  place by the main thread without any GEGL call, and the main thread
+ *  then runs concurrently with the rendering.
+ */
+static gboolean
+gimp_gegl_graph_check_threadable (GeglNode      *node,
+                                  GeglOperation *operation)
+{
+  static const gchar * const unsafe[] =
+  {
+    /*  write into buffers of the application  */
+    "gegl:write-buffer",
+    "gegl:buffer-sink",
+    "gegl:copy-buffer",
+    "gegl:introspect",
+    "gegl:display",
+    "gimp:histogram-sink",
+    NULL
+  };
+
+  GParamSpec **pspecs;
+  guint        n_pspecs;
+  guint        i;
+  gboolean     success = TRUE;
+  const gchar *name;
+
+  if (! operation)
+    return TRUE;
+
+  name = gegl_operation_get_name (operation);
+
+  if (! name || gimp_gegl_graph_name_in (name, unsafe) ||
+      g_str_has_suffix (name, "-save") || g_str_has_suffix (name, "-sink"))
+    {
+      return FALSE;
+    }
+
+  /*  most operations (point filters, composers, buffer sources, layer
+   *  modes...) have no object property at all
+   */
+  if (! gimp_gegl_graph_class_has_object_props (operation))
+    return TRUE;
+
+  pspecs = g_object_class_list_properties (G_OBJECT_GET_CLASS (operation),
+                                           &n_pspecs);
+
+  for (i = 0; i < n_pspecs && success; i++)
+    {
+      GParamSpec *pspec = pspecs[i];
+      GType       type  = pspec->value_type;
+
+      if (! (pspec->flags & G_PARAM_READABLE))
+        continue;
+
+      if (G_TYPE_IS_OBJECT (type) || G_TYPE_IS_INTERFACE (type))
+        {
+          GValue value = G_VALUE_INIT;
+
+          if (g_type_is_a (type, GEGL_TYPE_BUFFER) ||
+              g_type_is_a (type, GEGL_TYPE_COLOR))
+            continue;
+
+          g_value_init (&value, type);
+          g_object_get_property (G_OBJECT (operation), pspec->name, &value);
+
+          if (g_value_get_object (&value))
+            success = FALSE;
+
+          g_value_unset (&value);
+        }
+    }
+
+  g_free (pspecs);
+
+  return success;
+}
+
+/*  an operation gives, at a reduced resolution (mipmap level > 0), the
+ *  same image as at full resolution, downscaled (up to rounding): point
+ *  operations, and the operations of layer graphs which scale their
+ *  geometry with the level
+ */
+/*  ChopGimp 4.2.7: the level aware operations whose output at a level > 0
+ *  is a close draft, not the downscaled level 0 output: their sizes
+ *  (shadow offset, blur radius, stroke width) are rounded to the level,
+ *  and the layer styles recompute their planes without their cache.  Set
+ *  by gimp_gegl_graph_check_draftable() during a walk (main thread only).
+ */
+static const gchar * const level_approximate[] =
+{
+  "gegl:gblur-1d",
+  "gegl:median-blur",
+  "chopgimp:stroke",
+  "chopgimp:satin",
+  "chopgimp:pattern-overlay",
+  "chopgimp:layer-style-fused",
+  NULL
+};
+
+static gboolean draft_exact = TRUE;
+
+static gboolean
+gimp_gegl_graph_check_draftable (GeglNode      *node,
+                                 GeglOperation *operation)
+{
+  static const gchar * const level_aware[] =
+  {
+    "gegl:nop",
+    "gegl:clone",
+    "gegl:translate",
+    "gegl:crop",
+    "gegl:cache",
+    "gegl:buffer-source",
+    "gegl:convert-format",
+    "gegl:gblur-1d",
+    "gegl:median-blur",       /* level-aware since GEGL patch 0006 */
+    "gimp:buffer-source-validate",
+    "gimp:compose-crop",
+    /*  scale the stroke's width with the level (exact, the stroke of
+     *  the mipmapped layer), and the effects' sizes (a close draft)
+     */
+    "chopgimp:stroke",
+    /*  3.32.0: the same compositing, sizes scaled with the level  */
+    "chopgimp:satin",
+    "chopgimp:pattern-overlay",
+    "chopgimp:layer-style-fused",
+    /*  a point composer (behind effects, chopgimp-behind-effects.c)  */
+    "chopgimp:behind-knockout",
+    NULL
+  };
+
+  const gchar *name;
+
+  if (! operation)
+    return TRUE;
+
+  /*  meta operations: their child nodes are checked  */
+  if (GEGL_IS_OPERATION_META (operation))
+    return TRUE;
+
+  name = gegl_operation_get_name (operation);
+
+  if (! name)
+    return FALSE;
+
+  if (gimp_gegl_graph_name_in (name, level_aware))
+    {
+      if (gimp_gegl_graph_name_in (name, level_approximate))
+        draft_exact = FALSE;
+
+      return TRUE;
+    }
+
+  /*  ChopGimp's other operations don't know about levels  */
+  if (g_str_has_prefix (name, "chopgimp:"))
+    return FALSE;
+
+  if (GEGL_IS_OPERATION_POINT_FILTER (operation)    ||
+      GEGL_IS_OPERATION_POINT_COMPOSER (operation)  ||
+      GEGL_IS_OPERATION_POINT_COMPOSER3 (operation) ||
+      GEGL_IS_OPERATION_POINT_RENDER (operation))
+    {
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+/**
+ * gimp_gegl_graph_is_threadable:
+ * @graph: a #GeglNode
+ *
+ * Returns: whether every operation of @graph can be processed in the
+ * rendering thread while the main thread runs.  Must be called with the
+ * graph not being changed (main thread, or rendering thread holding the
+ * lock).
+ */
+gboolean
+gimp_gegl_graph_is_threadable (GeglNode *graph)
+{
+  return gimp_gegl_graph_check (graph, gimp_gegl_graph_check_threadable);
+}
+
+/**
+ * gimp_gegl_graph_is_draftable:
+ * @graph: a #GeglNode
+ *
+ * @exact: (out) (optional): whether, moreover, the image rendered at a
+ *         level > 0 is the downscaled level 0 image (no layer effect nor
+ *         blur, which only give a close draft there)
+ *
+ * Returns: whether @graph renders correctly (up to the resolution) at a
+ * mipmap level greater than 0.
+ */
+gboolean
+gimp_gegl_graph_is_draftable (GeglNode *graph,
+                              gboolean *exact)
+{
+  gboolean draftable;
+
+  draft_exact = TRUE;
+
+  draftable = gimp_gegl_graph_check (graph, gimp_gegl_graph_check_draftable);
+
+  if (exact)
+    *exact = draftable && draft_exact;
+
+  return draftable;
+}
