+/*  ChopGimp: a copy of the user's defaults of the layer style opened by
+ *  the action, saved as a preset of the operation by the style's dialog,
+ *  or NULL
+ */
+static GimpObject *
+filters_get_layer_style_default (Gimp        *gimp,
+                                 const gchar *action_name,
+                                 const gchar *operation,
+                                 const gchar *icon_name)
+{
+  const ChopGimpLayerStyle *style;
+  GimpContainer            *container;
+  GimpObject               *settings = NULL;
+  gchar                    *name;
+  GList                    *list;
+
+  style = chopgimp_layer_style_find_by_action (action_name);
+
+  if (! style || strcmp (style->operation, operation))
+    return NULL;
+
+  container =
+    gimp_operation_config_get_container (gimp,
+                                         gimp_operation_config_get_type (gimp,
+                                                                         operation,
+                                                                         icon_name,
+                                                                         GIMP_TYPE_OPERATION_SETTINGS),
+                                         (GCompareFunc) gimp_settings_compare);
+
+  name = g_strdup_printf (CHOPGIMP_LAYER_STYLE_DEFAULT_NAME, style->label);
+
+  for (list = GIMP_LIST (container)->queue->head; list; list = g_list_next (list))
+    {
+      GimpSettings *preset = list->data;
+
+      /*  a saved preset, not a "last used" one  */
+      if (preset->time == 0 &&
+          ! g_strcmp0 (gimp_object_get_name (preset), name))
+        {
+          settings = GIMP_OBJECT (gimp_config_duplicate (GIMP_CONFIG (preset)));
+          break;
+        }
+    }
+
+  g_free (name);
+
+  return settings;
+}
+
 void
 filters_run_procedure (Gimp          *gimp,
                        GimpDisplay   *display,
