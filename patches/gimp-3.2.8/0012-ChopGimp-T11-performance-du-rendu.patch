+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*  chopgimp:layer-style-fused renders consecutive layer style filters of
+ *  a drawable (drop shadow / outer glow, inner shadow / inner glow,
+ *  stroke) like the chain of GIMP drawable filters does, effect after
+ *  effect in the same order, with the same arithmetic, but:
+ *
+ *  - only alpha is processed where only alpha matters: the grow / shrink
+ *    of the glows is a min / max filter of the alpha (gegl:median-blur at
+ *    percentile 0 / 100 quantizes and processes 4 channels), the glow's
+ *    "median fix" is the percentile of 9 alpha values, the blur is the
+ *    same FIR filter on the alpha alone;
+ *  - each effect's intermediate plane (shadow alpha, glow alpha, stroke
+ *    coverage) is kept between renderings (1 to 2 bytes per pixel instead
+ *    of a 16 bytes per pixel cache per filter), and only recomputed where
+ *    the layer changed;
+ *  - the colors are composited once per pixel for all the effects, in the
+ *    applicator's format ("RGBA float"), without intermediate buffers;
+ *  - the effects share their alpha: the alpha of the layer after effect k
+ *    is computed once for the planes of the effects above it.
+ *
+ *  The result equals the chain's (to float precision, the glow alphas are
+ *  quantized to 1/255 like gegl:median-blur does); the cases it doesn't
+ *  render the same are not fused (gimpdrawable-fused-styles.c).
+ *
+ *  Mipmap levels: at level L > 0 (zoomed out draft rendering), the effects
+ *  are computed at the level's resolution with their sizes scaled by
+ *  1 / 2^L (the stroke exactly, see gimpoperationcontour.c), without the
+ *  plane cache.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <cairo.h>
+#include <gegl.h>
+#include <gegl-plugin.h>
+#include <gdk-pixbuf/gdk-pixbuf.h>
+
+#include "libgimpbase/gimpbase.h"
+
+#include "operations-types.h"
+
+#include "layer-modes/gimp-layer-modes.h"
+#include "layer-modes/gimpoperationlayermode-composite.h"
+
+#include "gimpoperationcontour.h"
+#include "gimpoperationlayerstylefused.h"
+
+
+#define CELL           64     /*  validity grid of the cached planes  */
+#define AHEAD          256    /*  computed around a requested region  */
+#define ROWS_COST      32.0   /*  thread cost, in rows                */
+
+
+enum
+{
+  PROP_0,
+  PROP_STYLE
+};
+
+
+/*  GimpFusedStyle  */
+
+G_DEFINE_BOXED_TYPE (GimpFusedStyle, gimp_fused_style,
+                     gimp_fused_style_ref, gimp_fused_style_unref)
+
+GimpFusedStyle *
+gimp_fused_style_new (gint n_effects)
+{
+  GimpFusedStyle *style = g_slice_new0 (GimpFusedStyle);
+
+  style->ref_count = 1;
+  style->n_effects = n_effects;
+  style->effects   = g_new0 (GimpFusedEffect, n_effects);
+
+  return style;
+}
+
+GimpFusedStyle *
+gimp_fused_style_ref (GimpFusedStyle *style)
+{
+  g_atomic_int_inc (&style->ref_count);
+
+  return style;
+}
+
+void
+gimp_fused_style_unref (GimpFusedStyle *style)
+{
+  if (g_atomic_int_dec_and_test (&style->ref_count))
+    {
+      gint i;
+
+      for (i = 0; i < style->n_effects; i++)
+        {
+          g_clear_object (&style->effects[i].color);
+          g_clear_object (&style->effects[i].stroke);
+        }
+
+      g_free (style->effects);
+      g_slice_free (GimpFusedStyle, style);
+    }
+}
+
+static gboolean
+gimp_fused_color_equal (GeglColor *c1,
+                        GeglColor *c2)
+{
+  gdouble a[4] = { 0, }, b[4] = { 0, };
+
+  if (! c1 || ! c2)
+    return c1 == c2;
+
+  gegl_color_get_rgba (c1, &a[0], &a[1], &a[2], &a[3]);
+  gegl_color_get_rgba (c2, &b[0], &b[1], &b[2], &b[3]);
+
+  return ! memcmp (a, b, sizeof (a));
+}
+
+gboolean
+gimp_fused_style_equal (const GimpFusedStyle *style1,
+                        const GimpFusedStyle *style2)
+{
+  gint i;
+
+  if (style1 == style2)
+    return TRUE;
+
+  if (! style1 || ! style2                    ||
+      style1->n_effects != style2->n_effects ||
+      style1->ahead     != style2->ahead)
+    return FALSE;
+
+  for (i = 0; i < style1->n_effects; i++)
+    {
+      const GimpFusedEffect *e1 = &style1->effects[i];
+      const GimpFusedEffect *e2 = &style2->effects[i];
+
+      if (e1->type            != e2->type            ||
+          e1->mode            != e2->mode            ||
+          e1->blend_space     != e2->blend_space     ||
+          e1->composite_space != e2->composite_space ||
+          e1->composite_mode  != e2->composite_mode  ||
+          e1->opacity         != e2->opacity         ||
+          e1->x               != e2->x               ||
+          e1->y               != e2->y               ||
+          e1->radius          != e2->radius          ||
+          e1->grow_shape      != e2->grow_shape      ||
+          e1->grow_radius     != e2->grow_radius     ||
+          e1->effect_opacity  != e2->effect_opacity  ||
+          e1->cover           != e2->cover           ||
+          e1->stroke          != e2->stroke          ||
+          e1->serial          != e2->serial          ||
+          ! gimp_fused_color_equal (e1->color, e2->color))
+        {
+          return FALSE;
+        }
+    }
+
+  return TRUE;
+}
+
+
+/*  the blend modes the applicator compositing below reproduces  */
+
+gboolean
+gimp_operation_layer_style_fused_mode_supported (GimpLayerMode           mode,
+                                                 GimpLayerColorSpace     blend_space,
+                                                 GimpLayerColorSpace     composite_space,
+                                                 GimpLayerCompositeMode  composite_mode,
+                                                 gdouble                 opacity)
+{
+  if (composite_mode == GIMP_LAYER_COMPOSITE_AUTO)
+    composite_mode = gimp_layer_mode_get_composite_mode (mode);
+
+  if (composite_space == GIMP_LAYER_COLOR_SPACE_AUTO)
+    composite_space = gimp_layer_mode_get_composite_space (mode);
+
+  if (mode == GIMP_LAYER_MODE_REPLACE)
+    {
+      /*  at full opacity, the filter's output, whatever the format  */
+      return (opacity == 1.0 &&
+              composite_mode == GIMP_LAYER_COMPOSITE_UNION);
+    }
+
+  if (mode == GIMP_LAYER_MODE_NORMAL)
+    return (composite_mode  == GIMP_LAYER_COMPOSITE_UNION &&
+            composite_space == GIMP_LAYER_COLOR_SPACE_RGB_LINEAR);
+
+  /*  these blend functions read their GeglOperation  */
+  if (mode == GIMP_LAYER_MODE_LUMA_DARKEN_ONLY  ||
+      mode == GIMP_LAYER_MODE_LUMA_LIGHTEN_ONLY ||
+      mode == GIMP_LAYER_MODE_LUMINANCE)
+    return FALSE;
+
+  if (gimp_layer_mode_is_legacy (mode)      ||
+      gimp_layer_mode_is_subtractive (mode) ||
+      ! gimp_layer_mode_get_blend_function (mode))
+    return FALSE;
+
+  if (g_strcmp0 (gimp_layer_mode_get_operation_name (mode),
+                 "gimp:layer-mode"))
+    return FALSE;
+
+  return (composite_space == GIMP_LAYER_COLOR_SPACE_RGB_LINEAR &&
+          composite_mode  != GIMP_LAYER_COMPOSITE_AUTO);
+}
+
+
+/*  the snapshot of a filter  */
+
+static gboolean
+fused_has_property (GeglNode    *node,
+                    const gchar *name)
+{
+  GeglOperation *op = gegl_node_get_gegl_operation (node);
+
+  return op && g_object_class_find_property (G_OBJECT_GET_CLASS (op), name);
+}
+
+/*  the layer style options of gegl:dropshadow and gegl:inner-glow (patch
+ *  GEGL 0005, gegl:glow-map) are not fused: their defaults only
+ */
+static gboolean
+fused_glow_options_default (GeglNode *node)
+{
+  gint     contour      = 0;
+  gdouble  range        = 1.0;
+  gdouble  noise        = 0.0;
+  gboolean use_gradient = FALSE;
+
+  if (fused_has_property (node, "contour"))
+    gegl_node_get (node, "contour", &contour, NULL);
+
+  if (fused_has_property (node, "range"))
+    gegl_node_get (node, "range", &range, NULL);
+
+  if (fused_has_property (node, "noise"))
+    gegl_node_get (node, "noise", &noise, NULL);
+
+  if (fused_has_property (node, "use-gradient"))
+    gegl_node_get (node, "use-gradient", &use_gradient, NULL);
+
+  return (contour == 0 && range >= 1.0 && noise <= 0.0 && ! use_gradient);
+}
+
+static gboolean
+fused_is_whole (gdouble value)
+{
+  return (value == floor (value) && fabs (value) < 1e6);
+}
+
+gboolean
+gimp_fused_effect_init (GimpFusedEffect        *effect,
+                        GeglNode               *node,
+                        GimpLayerMode           mode,
+                        GimpLayerColorSpace     blend_space,
+                        GimpLayerColorSpace     composite_space,
+                        GimpLayerCompositeMode  composite_mode,
+                        gdouble                 opacity)
+{
+  const gchar *operation;
+  gdouble      x = 0.0, y = 0.0;
+
+  memset (effect, 0, sizeof (GimpFusedEffect));
+
+  if (! node)
+    return FALSE;
+
+  operation = gegl_node_get_operation (node);
+
+  if (! operation)
+    return FALSE;
+
+  if (! gimp_operation_layer_style_fused_mode_supported (mode, blend_space,
+                                                         composite_space,
+                                                         composite_mode,
+                                                         opacity))
+    return FALSE;
+
+  effect->mode            = mode;
+  effect->blend_space     = blend_space;
+  effect->composite_space = composite_space;
+  effect->composite_mode  = composite_mode;
+  effect->opacity         = opacity;
+
+  if (! strcmp (operation, "gegl:dropshadow"))
+    {
+      effect->type = GIMP_FUSED_EFFECT_DROP_SHADOW;
+
+      gegl_node_get (node,
+                     "x",           &x,
+                     "y",           &y,
+                     "radius",      &effect->radius,
+                     "grow-shape",  &effect->grow_shape,
+                     "grow-radius", &effect->grow_radius,
+                     "color",       &effect->color,
+                     "opacity",     &effect->effect_opacity,
+                     NULL);
+
+      /*  above, gegl:dropshadow blurs with IIR  */
+      if (effect->radius > 40.0 || ! fused_glow_options_default (node))
+        goto fail;
+    }
+  else if (! strcmp (operation, "gegl:inner-glow"))
+    {
+      gdouble rgba[4];
+
+      effect->type = GIMP_FUSED_EFFECT_INNER_GLOW;
+
+      gegl_node_get (node,
+                     "x",           &x,
+                     "y",           &y,
+                     "radius",      &effect->radius,
+                     "grow-shape",  &effect->grow_shape,
+                     "grow-radius", &effect->grow_radius,
+                     "value",       &effect->color,
+                     "opacity",     &effect->effect_opacity,
+                     "cover",       &effect->cover,
+                     NULL);
+
+      if (! effect->color || ! fused_glow_options_default (node))
+        goto fail;
+
+      /*  gegl:color-overlay of a translucent color mixes it with the
+       *  layer's colors
+       */
+      gegl_color_get_rgba (effect->color, &rgba[0], &rgba[1], &rgba[2],
+                           &rgba[3]);
+
+      if (fabs (1.0 - rgba[3]) > 1e-6 || effect->radius > 40.0 ||
+          effect->grow_radius < 0.0)
+        goto fail;
+    }
+  else if (! strcmp (operation, "chopgimp:stroke"))
+    {
+      GeglOperation *op = gegl_node_get_gegl_operation (node);
+
+      if (! GIMP_IS_OPERATION_CONTOUR (op))
+        return FALSE;
+
+      /*  dashes depend on the whole outline  */
+      if (! gimp_operation_contour_get_is_local (GIMP_OPERATION_CONTOUR (op)))
+        return FALSE;
+
+      effect->type   = GIMP_FUSED_EFFECT_STROKE;
+      effect->stroke = g_object_ref (op);
+
+      return TRUE;
+    }
+  else
+    {
+      return FALSE;
+    }
+
+  /*  whole pixel offsets only (gegl:translate resamples the others)  */
+  if (! fused_is_whole (x) || ! fused_is_whole (y))
+    goto fail;
+
+  effect->x = (gint) x;
+  effect->y = (gint) y;
+
+  return TRUE;
+
+ fail:
+  gimp_fused_effect_clear (effect);
+
+  return FALSE;
+}
+
+void
+gimp_fused_effect_clear (GimpFusedEffect *effect)
+{
+  g_clear_object (&effect->color);
+  g_clear_object (&effect->stroke);
+}
+
+
+/*  planes  */
+
+typedef struct
+{
+  GeglRectangle  rect;       /*  where the plane is defined  */
+  gint           bpp;        /*  1 (u8) or 4 (float)         */
+  gint           stride;     /*  in pixels                   */
+  guchar        *data;
+  gboolean       owned;
+} Plane;
+
+/*  a cached plane: the plane over its whole rect, and which cells of it
+ *  are valid
+ */
+typedef struct
+{
+  Plane    plane;
+  Plane    burst;            /*  stroke: the shape burst distances  */
+  gboolean has_burst;
+  gint     n_cx;
+  gint     n_cy;
+  guchar  *valid;
+  gboolean allocated;
+} CachedPlane;
+
+struct _GimpFusedCache
+{
+  gint           ref_count;  /*  the renderings using it  */
+  GeglRectangle  in_rect;    /*  the input's extent the layout is for  */
+  gint           n_effects;
+  CachedPlane   *planes;
+};
+
+
+/*  the effects as rendered at a level  */
+
+typedef struct
+{
+  const GimpFusedEffect *effect;
+
+  GeglRectangle          in_bbox;      /*  of the layer before the effect  */
+  GeglRectangle          out_bbox;     /*  after it                        */
+  GeglRectangle          op_bbox;      /*  of the effect's output          */
+  GeglRectangle          plane_rect;   /*  where the plane is not zero     */
+
+  /*  drop shadow, inner glow  */
+  gint                   off_x;
+  gint                   off_y;
+  gboolean               grow_applied;
+  gint                   grow;         /*  gegl:median-blur's radius       */
+  gint                  *outline;      /*  half widths, per |dy|           */
+  gint                   clen;
+  gfloat                *cmatrix;
+  gfloat                 color[4];     /*  shadow: premultiplied color     */
+  gfloat                 value;        /*  the effect's opacity            */
+  gint                   cover_rank;   /*  inner glow: 1..9                */
+
+  /*  stroke  */
+  GimpOperationContour  *contour;
+  gint                   margin;
+  GeglRectangle          in_bbox0;     /*  in_bbox at level 0              */
+
+  /*  applicator  */
+  GimpLayerMode           mode;
+  GimpLayerCompositeMode  composite_mode;
+  gfloat                  opacity;
+  GimpLayerModeBlendFunc  blend_func;
+  const Babl             *to_blend;
+  const Babl             *from_blend;
+} Effect;
+
+typedef struct
+{
+  GimpOperationLayerStyleFused *self;
+  GimpFusedCache               *cache;     /*  NULL at level > 0  */
+  GeglBuffer                   *input;
+  const Babl                   *format;
+  gint                          level;
+  gint                          n;
+  Effect                       *effects;
+
+  guint                         generation;
+  gboolean                      ahead;
+
+  /*  level > 0: the planes computed during this call  */
+  Plane                        *temp;
+  Plane                        *temp_burst;
+} Ctx;
+
+
+static void            gimp_operation_layer_style_fused_finalize     (GObject             *object);
+static void            gimp_operation_layer_style_fused_get_property (GObject             *object,
+                                                                      guint                property_id,
+                                                                      GValue              *value,
+                                                                      GParamSpec          *pspec);
+static void            gimp_operation_layer_style_fused_set_property (GObject             *object,
+                                                                      guint                property_id,
+                                                                      const GValue        *value,
+                                                                      GParamSpec          *pspec);
+
+static void            gimp_operation_layer_style_fused_prepare      (GeglOperation       *operation);
+static GeglRectangle   gimp_operation_layer_style_fused_get_bounding_box
+                                                                     (GeglOperation       *operation);
+static GeglRectangle   gimp_operation_layer_style_fused_get_required_for_output
+                                                                     (GeglOperation       *operation,
+                                                                      const gchar         *input_pad,
+                                                                      const GeglRectangle *roi);
+static GeglRectangle   gimp_operation_layer_style_fused_get_invalidated_by_change
+                                                                     (GeglOperation       *operation,
+                                                                      const gchar         *input_pad,
+                                                                      const GeglRectangle *input_region);
+static GeglRectangle   gimp_operation_layer_style_fused_get_cached_region
+                                                                     (GeglOperation       *operation,
+                                                                      const GeglRectangle *roi);
+static gboolean        gimp_operation_layer_style_fused_process      (GeglOperation       *operation,
+                                                                      GeglBuffer          *input,
+                                                                      GeglBuffer          *output,
+                                                                      const GeglRectangle *roi,
+                                                                      gint                 level);
+
+static void            fused_cache_free                              (GimpFusedCache      *cache);
+
+
+G_DEFINE_TYPE (GimpOperationLayerStyleFused, gimp_operation_layer_style_fused,
+               GEGL_TYPE_OPERATION_FILTER)
+
+#define parent_class gimp_operation_layer_style_fused_parent_class
+
+
+static void
+gimp_operation_layer_style_fused_class_init (GimpOperationLayerStyleFusedClass *klass)
+{
+  GObjectClass             *object_class    = G_OBJECT_CLASS (klass);
+  GeglOperationClass       *operation_class = GEGL_OPERATION_CLASS (klass);
+  GeglOperationFilterClass *filter_class    = GEGL_OPERATION_FILTER_CLASS (klass);
+
+  object_class->finalize     = gimp_operation_layer_style_fused_finalize;
+  object_class->set_property = gimp_operation_layer_style_fused_set_property;
+  object_class->get_property = gimp_operation_layer_style_fused_get_property;
+
+  gegl_operation_class_set_keys (operation_class,
+                                 "name",        "chopgimp:layer-style-fused",
+                                 "categories",  "hidden",
+                                 "description", "Layer style filters "
+                                                "rendered together",
+                                 NULL);
+
+  operation_class->prepare                   = gimp_operation_layer_style_fused_prepare;
+  operation_class->get_bounding_box          = gimp_operation_layer_style_fused_get_bounding_box;
+  operation_class->get_required_for_output   = gimp_operation_layer_style_fused_get_required_for_output;
+  operation_class->get_invalidated_by_change = gimp_operation_layer_style_fused_get_invalidated_by_change;
+  operation_class->get_cached_region         = gimp_operation_layer_style_fused_get_cached_region;
+  /*  the operation distributes its own work between threads, each step
+   *  on the whole region (splitting the region would compute the margins
+   *  of the blurs once per thread)
+   */
+  operation_class->threaded                  = FALSE;
+
+  filter_class->process                      = gimp_operation_layer_style_fused_process;
+
+  g_object_class_install_property (object_class, PROP_STYLE,
+                                   g_param_spec_boxed ("style",
+                                                       "Style",
+                                                       "The fused effects",
+                                                       GIMP_TYPE_FUSED_STYLE,
+                                                       G_PARAM_READWRITE));
+}
+
+static void
+gimp_operation_layer_style_fused_init (GimpOperationLayerStyleFused *self)
+{
+  g_mutex_init (&self->mutex);
+  g_mutex_init (&self->state_mutex);
+
+  self->pending = g_array_new (FALSE, FALSE, sizeof (GeglRectangle));
+}
+
+static void
+gimp_operation_layer_style_fused_finalize (GObject *object)
+{
+  GimpOperationLayerStyleFused *self = GIMP_OPERATION_LAYER_STYLE_FUSED (object);
+
+  g_clear_pointer (&self->style, gimp_fused_style_unref);
+  g_clear_pointer (&self->cache, fused_cache_free);
+  g_array_free (self->pending, TRUE);
+  g_mutex_clear (&self->mutex);
+  g_mutex_clear (&self->state_mutex);
+
+  G_OBJECT_CLASS (parent_class)->finalize (object);
+}
+
+static void
+gimp_operation_layer_style_fused_get_property (GObject    *object,
+                                               guint       property_id,
+                                               GValue     *value,
+                                               GParamSpec *pspec)
+{
+  GimpOperationLayerStyleFused *self = GIMP_OPERATION_LAYER_STYLE_FUSED (object);
+
+  switch (property_id)
+    {
+    case PROP_STYLE:
+      g_mutex_lock (&self->state_mutex);
+      g_value_set_boxed (value, self->style);
+      g_mutex_unlock (&self->state_mutex);
+      break;
+
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_operation_layer_style_fused_set_property (GObject      *object,
+                                               guint         property_id,
+                                               const GValue *value,
+                                               GParamSpec   *pspec)
+{
+  GimpOperationLayerStyleFused *self = GIMP_OPERATION_LAYER_STYLE_FUSED (object);
+
+  switch (property_id)
+    {
+    case PROP_STYLE:
+      g_mutex_lock (&self->state_mutex);
+
+      g_clear_pointer (&self->style, gimp_fused_style_unref);
+      self->style = g_value_dup_boxed (value);
+
+      /*  the planes depend on all the properties  */
+      self->reset = TRUE;
+      self->generation++;
+      g_array_set_size (self->pending, 0);
+
+      g_mutex_unlock (&self->state_mutex);
+      break;
+
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_operation_layer_style_fused_prepare (GeglOperation *operation)
+{
+  const Babl *space  = gegl_operation_get_source_space (operation, "input");
+  const Babl *format = babl_format_with_space ("RGBA float", space);
+
+  gegl_operation_set_format (operation, "input",  format);
+  gegl_operation_set_format (operation, "output", format);
+}
+
+
+/*  rectangles  */
+
+static inline GeglRectangle
+rect_grow (const GeglRectangle *r,
+           gint                 dx,
+           gint                 dy)
+{
+  GeglRectangle result = *r;
+
+  if (gegl_rectangle_is_empty (r))
+    return result;
+
+  result.x      -= dx;
+  result.y      -= dy;
+  result.width  += 2 * dx;
+  result.height += 2 * dy;
+
+  return result;
+}
+
+static inline GeglRectangle
+rect_shift (const GeglRectangle *r,
+            gint                 dx,
+            gint                 dy)
+{
+  GeglRectangle result = *r;
+
+  result.x += dx;
+  result.y += dy;
+
+  return result;
+}
+
+static inline GeglRectangle
+rect_union (const GeglRectangle *a,
+            const GeglRectangle *b)
+{
+  GeglRectangle result;
+
+  if (gegl_rectangle_is_empty (a))
+    return *b;
+
+  if (gegl_rectangle_is_empty (b))
+    return *a;
+
+  gegl_rectangle_bounding_box (&result, a, b);
+
+  return result;
+}
+
+static inline GeglRectangle
+rect_intersect (const GeglRectangle *a,
+                const GeglRectangle *b)
+{
+  GeglRectangle result;
+
+  if (! gegl_rectangle_intersect (&result, a, b))
+    gegl_rectangle_set (&result, 0, 0, 0, 0);
+
+  return result;
+}
+
+
+/*  GEGL's FIR gaussian kernel (operations/common/gblur-1d.c)  */
+
+static gfloat
+fused_gaussian_func_1d (gfloat x,
+                        gfloat sigma)
+{
+  return (1.0 / (sigma * sqrt (2.0 * G_PI))) *
+          exp (-(x * x) / (2.0 * sigma * sigma));
+}
+
+static gint
+fused_fir_length (gfloat sigma)
+{
+  gint clen = sigma > GEGL_FLOAT_EPSILON ? ceil (sigma * 6.5) : 1;
+
+  clen = clen + ((clen + 1) % 2);
+
+  return clen;
+}
+
+static gint
+fused_fir_matrix (gfloat   sigma,
+                  gfloat **cmatrix)
+{
+  gint    clen = fused_fir_length (sigma);
+  gfloat *m    = g_new (gfloat, clen);
+
+  if (clen == 1)
+    {
+      m[0] = 1;
+    }
+  else
+    {
+      gint    i;
+      gdouble sum       = 0;
+      gint    half_clen = clen / 2;
+
+      for (i = 0; i < clen; i++)
+        {
+          m[i] = fused_gaussian_func_1d (i - half_clen, sigma);
+          sum += m[i];
+        }
+
+      for (i = 0; i < clen; i++)
+        m[i] /= sum;
+    }
+
+  *cmatrix = m;
+
+  return clen;
+}
+
+
+/*  gegl:median-blur's neighborhoods: the half width of each row  */
+
+static gint *
+fused_outline_new (gint shape,
+                   gint radius)
+{
+  gint *outline = g_new (gint, radius + 1);
+  gint  i;
+
+  for (i = 0; i <= radius; i++)
+    {
+      switch (shape)
+        {
+        case 0: /* square */
+          outline[i] = radius;
+          break;
+
+        case 1: /* circle */
+        default:
+          outline[i] = (gint) sqrt ((radius + .5) * (radius + .5) - i * i);
+          break;
+
+        case 2: /* diamond */
+          outline[i] = radius - i;
+          break;
+        }
+    }
+
+  return outline;
+}
+
+/*  gegl:median-blur's quantization  */
+static inline guchar
+fused_bin (gfloat value)
+{
+  return (guchar) floorf (CLAMP (value, 0.0f, 1.0f) * 255.0f + 0.5f);
+}
+
+
+/*  planes  */
+
+static void
+plane_init (Plane               *plane,
+            const GeglRectangle *rect,
+            gint                 bpp)
+{
+  plane->rect   = *rect;
+  plane->bpp    = bpp;
+  plane->stride = (bpp == 1) ? gimp_operation_contour_mask_stride (MAX (rect->width, 1))
+                             : MAX (rect->width, 1);
+  plane->data   = g_malloc0 ((gsize) plane->stride * MAX (rect->height, 1) * bpp);
+  plane->owned  = TRUE;
+}
+
+static void
+plane_clear (Plane *plane)
+{
+  if (plane->owned)
+    g_free (plane->data);
+
+  memset (plane, 0, sizeof (Plane));
+}
+
+static inline gpointer
+plane_at (const Plane *plane,
+          gint         x,
+          gint         y)
+{
+  return plane->data +
+         ((gsize) (y - plane->rect.y) * plane->stride + (x - plane->rect.x)) *
+         plane->bpp;
+}
+
+/*  a row of a plane as floats (0..1 for u8 planes), zero outside it  */
+static void
+plane_get_row (const Plane *plane,
+               gint         x,
+               gint         y,
+               gint         width,
+               gfloat      *dest)
+{
+  gint x1, x2, i;
+
+  if (! plane->data                                 ||
+      y <  plane->rect.y                            ||
+      y >= plane->rect.y + plane->rect.height)
+    {
+      memset (dest, 0, sizeof (gfloat) * width);
+      return;
+    }
+
+  x1 = MAX (x, plane->rect.x);
+  x2 = MIN (x + width, plane->rect.x + plane->rect.width);
+
+  for (i = 0; i < x1 - x && i < width; i++)
+    dest[i] = 0.0f;
+
+  if (x1 < x2)
+    {
+      if (plane->bpp == 4)
+        {
+          memcpy (dest + (x1 - x), plane_at (plane, x1, y),
+                  sizeof (gfloat) * (x2 - x1));
+        }
+      else
+        {
+          const guchar *src = plane_at (plane, x1, y);
+
+          for (i = 0; i < x2 - x1; i++)
+            dest[x1 - x + i] = src[i] / 255.0f;
+        }
+    }
+
+  for (i = MAX (x2 - x, 0); i < width; i++)
+    dest[i] = 0.0f;
+}
+
+/*  a row of a u8 plane as bytes, zero outside it  */
+static void
+plane_get_row_u8 (const Plane *plane,
+                  gint         x,
+                  gint         y,
+                  gint         width,
+                  guchar      *dest)
+{
+  gint x1, x2;
+
+  memset (dest, 0, width);
+
+  if (! plane->data                      ||
+      y <  plane->rect.y                 ||
+      y >= plane->rect.y + plane->rect.height)
+    return;
+
+  x1 = MAX (x, plane->rect.x);
+  x2 = MIN (x + width, plane->rect.x + plane->rect.width);
+
+  if (x1 < x2)
+    memcpy (dest + (x1 - x), plane_at (plane, x1, y), x2 - x1);
+}
+
+
+/*  the effects at a level  */
+
+static gint
+fused_scale (gdouble value,
+             gint    level)
+{
+  if (level <= 0)
+    return (gint) value;
+
+  return (gint) floor (value / (1 << level) + 0.5);
+}
+
+static GeglRectangle
+fused_applicator_bbox (const Effect        *e,
+                       const GeglRectangle *in,
+                       const GeglRectangle *op)
+{
+  switch (e->composite_mode)
+    {
+    case GIMP_LAYER_COMPOSITE_CLIP_TO_BACKDROP:
+      return *in;
+
+    case GIMP_LAYER_COMPOSITE_CLIP_TO_LAYER:
+      return *op;
+
+    case GIMP_LAYER_COMPOSITE_INTERSECTION:
+      return rect_intersect (in, op);
+
+    case GIMP_LAYER_COMPOSITE_UNION:
+    case GIMP_LAYER_COMPOSITE_AUTO:
+    default:
+      return rect_union (in, op);
+    }
+}
+
+/*  sets the effects up for rendering at level, the layer's extent (at
+ *  level 0) being in_rect; the level 0 extents are always computed, they
+ *  are the operation's bounding box
+ */
+static Effect *
+fused_effects_new (const GimpFusedStyle *style,
+                   const GeglRectangle  *in_rect0,
+                   gint                  level,
+                   const Babl           *format,
+                   GeglRectangle        *out_bbox)
+{
+  Effect        *effects = g_new0 (Effect, style->n_effects);
+  GeglRectangle  bbox;
+  GeglRectangle  bbox0 = *in_rect0;
+  gint           k;
+
+  gimp_operation_contour_scale_rect (in_rect0, level, &bbox);
+
+  for (k = 0; k < style->n_effects; k++)
+    {
+      const GimpFusedEffect *fe = &style->effects[k];
+      Effect                *e  = &effects[k];
+      GeglRectangle          op;
+
+      e->effect   = fe;
+      e->in_bbox  = bbox;
+      e->in_bbox0 = bbox0;
+
+      /*  the applicator  */
+
+      e->mode           = fe->mode;
+      e->opacity        = fe->opacity;
+      e->composite_mode = fe->composite_mode;
+
+      if (e->composite_mode == GIMP_LAYER_COMPOSITE_AUTO)
+        e->composite_mode = gimp_layer_mode_get_composite_mode (fe->mode);
+
+      if (fe->mode != GIMP_LAYER_MODE_REPLACE &&
+          fe->mode != GIMP_LAYER_MODE_NORMAL)
+        {
+          GimpLayerColorSpace blend_space = fe->blend_space;
+
+          if (blend_space == GIMP_LAYER_COLOR_SPACE_AUTO)
+            blend_space = gimp_layer_mode_get_blend_space (fe->mode);
+
+          e->blend_func = gimp_layer_mode_get_blend_function (fe->mode);
+
+          if (blend_space != GIMP_LAYER_COLOR_SPACE_RGB_LINEAR)
+            {
+              const Babl *blend_format;
+
+              switch (blend_space)
+                {
+                case GIMP_LAYER_COLOR_SPACE_RGB_NON_LINEAR:
+                  blend_format = babl_format_with_space ("R'G'B'A float", format);
+                  break;
+
+                case GIMP_LAYER_COLOR_SPACE_RGB_PERCEPTUAL:
+                  blend_format = babl_format_with_space ("R~G~B~A float", format);
+                  break;
+
+                case GIMP_LAYER_COLOR_SPACE_LAB:
+                  blend_format = babl_format_with_space ("CIE Lab alpha float", format);
+                  break;
+
+                default:
+                  blend_format = format;
+                  break;
+                }
+
+              if (blend_format != format)
+                {
+                  e->to_blend   = babl_fish (format, blend_format);
+                  e->from_blend = babl_fish (blend_format, format);
+                }
+            }
+        }
+      else if (fe->mode == GIMP_LAYER_MODE_REPLACE)
+        {
+          e->composite_mode = GIMP_LAYER_COMPOSITE_UNION;
+        }
+
+      /*  the effect  */
+
+      switch (fe->type)
+        {
+        case GIMP_FUSED_EFFECT_DROP_SHADOW:
+          {
+            GeglRectangle grown;
+            GeglRectangle blur;
+            gint          h;
+
+            e->off_x        = fused_scale (fe->x, level);
+            e->off_y        = fused_scale (fe->y, level);
+            e->grow_applied = fabs (fe->grow_radius) > 0.0001;
+            e->grow         = fused_scale ((gint) fe->grow_radius, level);
+            e->outline      = fused_outline_new (fe->grow_shape, abs (e->grow));
+            e->clen         = fused_fir_matrix (fe->radius / (1 << level),
+                                                &e->cmatrix);
+            e->value        = fe->effect_opacity;
+
+            if (fe->color)
+              gegl_color_get_pixel (fe->color,
+                                    babl_format_with_space ("RaGaBaA float",
+                                                            format),
+                                    e->color);
+
+            h = e->clen / 2;
+
+            grown = bbox;
+            if (e->grow_applied)
+              grown = rect_grow (&bbox, abs (e->grow), abs (e->grow));
+
+            blur = rect_grow (&grown, h, h);
+
+            e->plane_rect = rect_shift (&blur, e->off_x, e->off_y);
+            op            = rect_union (&bbox, &e->plane_rect);
+
+            /*  level 0  */
+            if (level > 0)
+              {
+                gint    g0 = (gint) fe->grow_radius;
+                gint    h0 = fused_fir_length (fe->radius) / 2;
+                GeglRectangle s0;
+
+                grown = bbox0;
+                if (e->grow_applied)
+                  grown = rect_grow (&bbox0, abs (g0), abs (g0));
+
+                s0    = rect_grow (&grown, h0, h0);
+                s0    = rect_shift (&s0, fe->x, fe->y);
+                s0    = rect_union (&bbox0, &s0);
+                bbox0 = fused_applicator_bbox (e, &bbox0, &s0);
+              }
+            else
+              {
+                bbox0 = fused_applicator_bbox (e, &bbox0, &op);
+              }
+          }
+          break;
+
+        case GIMP_FUSED_EFFECT_INNER_GLOW:
+          {
+            gfloat     rgba[4];
+            const Babl *perceptual;
+            gint        i;
+
+            e->off_x        = fused_scale (fe->x, level);
+            e->off_y        = fused_scale (fe->y, level);
+            e->grow_applied = TRUE;
+            e->grow         = fused_scale ((gint) fe->grow_radius, level);
+            e->outline      = fused_outline_new (fe->grow_shape, abs (e->grow));
+            e->clen         = fused_fir_matrix (fe->radius / (1 << level),
+                                                &e->cmatrix);
+            e->value        = fe->effect_opacity;
+            e->cover_rank   = MAX ((gint) ceil (9 * (fe->cover / 100.0)), 1);
+            e->cover_rank   = MIN (e->cover_rank, 9);
+
+            /*  the glow's color, as gegl:median-blur quantizes it (in
+             *  R'G'B'A float), back in the processing format
+             */
+            perceptual = babl_format_with_space ("R'G'B'A float", format);
+
+            rgba[0] = rgba[1] = rgba[2] = 0.0f;
+            rgba[3] = 1.0f;
+
+            if (fe->color)
+              gegl_color_get_pixel (fe->color,
+                                    babl_format_with_space ("RGBA float",
+                                                            format),
+                                    rgba);
+
+            rgba[3] = 1.0f;
+            babl_process (babl_fish (babl_format_with_space ("RGBA float",
+                                                             format),
+                                     perceptual),
+                          rgba, rgba, 1);
+
+            for (i = 0; i < 3; i++)
+              rgba[i] = fused_bin (rgba[i]) / 255.0f;
+
+            babl_process (babl_fish (perceptual, format), rgba, e->color, 1);
+            e->color[3] = 1.0f;
+
+            e->plane_rect = bbox;
+            op            = bbox;
+            bbox0         = fused_applicator_bbox (e, &bbox0, &bbox0);
+          }
+          break;
+
+        case GIMP_FUSED_EFFECT_STROKE:
+          {
+            GeglOperation *stroke = fe->stroke;
+            GeglRectangle  sb0;
+            gint           grow0;
+
+            e->contour = GIMP_OPERATION_CONTOUR (stroke);
+            e->margin  = gimp_operation_contour_get_level_margin (e->contour,
+                                                                  level);
+
+            /*  gimp_operation_contour_get_bounding_box()  */
+            grow0 = gimp_operation_contour_get_level_margin (e->contour, 0) - 1;
+
+            if (e->contour->position == GIMP_CONTOUR_POSITION_INSIDE)
+              grow0 = 0;
+
+            sb0 = rect_grow (&bbox0, grow0, grow0);
+            gimp_operation_contour_scale_rect (&sb0, level, &op);
+
+            e->plane_rect = op;
+            bbox0         = fused_applicator_bbox (e, &bbox0, &sb0);
+          }
+          break;
+        }
+
+      e->op_bbox  = op;
+      e->out_bbox = fused_applicator_bbox (e, &bbox, &op);
+
+      bbox = e->out_bbox;
+    }
+
+  if (out_bbox)
+    *out_bbox = bbox0;
+
+  return effects;
+}
+
+static void
+fused_effects_free (Effect *effects,
+                    gint    n)
+{
+  gint k;
+
+  for (k = 0; k < n; k++)
+    {
+      g_free (effects[k].outline);
+      g_free (effects[k].cmatrix);
+    }
+
+  g_free (effects);
+}
+
+/*  the area of the layer's alpha before effect k needed for its plane
+ *  over rect
+ */
+static GeglRectangle
+fused_dep_rect (const Effect        *e,
+                const GeglRectangle *rect)
+{
+  GeglRectangle r;
+  gint          h = e->clen / 2;
+  gint          g = abs (e->grow);
+
+  switch (e->effect->type)
+    {
+    case GIMP_FUSED_EFFECT_DROP_SHADOW:
+      r = rect_shift (rect, -e->off_x, -e->off_y);
+      r = rect_grow (&r, h, h);
+      if (e->grow_applied)
+        r = rect_grow (&r, g, g);
+      return r;
+
+    case GIMP_FUSED_EFFECT_INNER_GLOW:
+      {
+        GeglRectangle r1 = rect_grow (rect, 1, 1);
+
+        r = rect_shift (&r1, -e->off_x, -e->off_y);
+        r = rect_grow (&r, h + g, h + g);
+        r = rect_union (&r, &r1);
+        return rect_intersect (&r, &e->in_bbox);
+      }
+
+    case GIMP_FUSED_EFFECT_STROKE:
+      r = rect_grow (rect, e->margin, e->margin);
+      return rect_intersect (&r, &e->in_bbox);
+    }
+
+  return *rect;
+}
+
+
+/*  parallel loops  */
+
+typedef void (* RowFunc) (gint y1, gint y2, gpointer data);
+
+typedef struct
+{
+  RowFunc  func;
+  gpointer data;
+} RowJob;
+
+static void
+fused_rows_job (gsize    offset,
+                gsize    size,
+                gpointer data)
+{
+  RowJob *job = data;
+
+  job->func ((gint) offset, (gint) (offset + size), job->data);
+}
+
+static void
+fused_parallel_rows (gint     n_rows,
+                     RowFunc  func,
+                     gpointer data)
+{
+  RowJob job = { func, data };
+
+  if (n_rows <= 0)
+    return;
+
+  gegl_parallel_distribute_range (n_rows, ROWS_COST, fused_rows_job, &job);
+}
+
+
+/*  min / max filter of the quantized alpha (gegl:median-blur at
+ *  percentile 100, or 0 for a negative radius)
+ */
+
+typedef struct
+{
+  const guchar        *src;     /*  bins, over src_rect  */
+  GeglRectangle        src_rect;
+  GeglRectangle        clamp;   /*  abyss CLAMP: the input's extent  */
+  gboolean             clamped;
+  const gint          *outline;
+  gint                 radius;
+  gboolean             max;
+  gfloat              *dest;    /*  over dest_rect  */
+  GeglRectangle        dest_rect;
+} MorphJob;
+
+static inline guchar
+morph_src (const MorphJob *job,
+           gint            x,
+           gint            y)
+{
+  if (job->clamped)
+    {
+      x = CLAMP (x, job->clamp.x, job->clamp.x + job->clamp.width  - 1);
+      y = CLAMP (y, job->clamp.y, job->clamp.y + job->clamp.height - 1);
+    }
+
+  if (x <  job->src_rect.x || x >= job->src_rect.x + job->src_rect.width ||
+      y <  job->src_rect.y || y >= job->src_rect.y + job->src_rect.height)
+    return 0;
+
+  return job->src[(gsize) (y - job->src_rect.y) * job->src_rect.width +
+                  (x - job->src_rect.x)];
+}
+
+static void
+morph_rows (gint     y1,
+            gint     y2,
+            gpointer data)
+{
+  MorphJob *job   = data;
+  gint      r     = job->radius;
+  gint      w     = job->dest_rect.width;
+  gint      pad   = r;
+  gint      n     = w + 2 * pad;
+  guchar   *row   = g_new (guchar, n);
+  guchar   *g     = g_new (guchar, n);
+  guchar   *h     = g_new (guchar, n);
+  guchar   *acc   = g_new (guchar, w);
+  gint      y;
+
+  for (y = y1; y < y2; y++)
+    {
+      gint yy = job->dest_rect.y + y;
+      gint dy;
+      gint x;
+
+      memset (acc, job->max ? 0 : 255, w);
+
+      for (dy = -r; dy <= r; dy++)
+        {
+          gint half = job->outline[abs (dy)];
+          gint K    = 2 * half + 1;
+          gint i;
+
+          /*  the source row, padded by the radius  */
+          for (i = 0; i < n; i++)
+            row[i] = morph_src (job, job->dest_rect.x - pad + i, yy + dy);
+
+          if (half == 0)
+            {
+              for (x = 0; x < w; x++)
+                {
+                  guchar v = row[x + pad];
+
+                  acc[x] = job->max ? MAX (acc[x], v) : MIN (acc[x], v);
+                }
+
+              continue;
+            }
+
+          /*  van Herk / Gil-Werman: prefix and suffix extrema per block  */
+          for (i = 0; i < n; i++)
+            {
+              if (i % K == 0)
+                g[i] = row[i];
+              else
+                g[i] = job->max ? MAX (g[i - 1], row[i]) : MIN (g[i - 1], row[i]);
+            }
+
+          for (i = n - 1; i >= 0; i--)
+            {
+              if (i == n - 1 || (i + 1) % K == 0)
+                h[i] = row[i];
+              else
+                h[i] = job->max ? MAX (h[i + 1], row[i]) : MIN (h[i + 1], row[i]);
+            }
+
+          for (x = 0; x < w; x++)
+            {
+              gint   s = x + pad - half;   /*  window [s, s + K - 1]  */
+              guchar v;
+
+              v = job->max ? MAX (h[s], g[s + K - 1]) : MIN (h[s], g[s + K - 1]);
+
+              acc[x] = job->max ? MAX (acc[x], v) : MIN (acc[x], v);
+            }
+        }
+
+      for (x = 0; x < w; x++)
+        job->dest[(gsize) y * w + x] = acc[x] / 255.0f;
+    }
+
+  g_free (row);
+  g_free (g);
+  g_free (h);
+  g_free (acc);
+}
+
+/*  the grown / shrunk alpha of the layer over dest_rect, from its alpha
+ *  over alpha_rect (zero outside in_bbox)
+ */
+static gfloat *
+fused_morph (const Effect        *e,
+             const gfloat        *alpha,
+             const GeglRectangle *alpha_rect,
+             const GeglRectangle *dest_rect,
+             gboolean             clamped)
+{
+  MorphJob  job;
+  guchar   *bins;
+  gsize     n = (gsize) alpha_rect->width * alpha_rect->height;
+  gsize     i;
+  gboolean  dilate;
+
+  bins = g_new (guchar, n);
+
+  for (i = 0; i < n; i++)
+    bins[i] = fused_bin (alpha[i]);
+
+  /*  dilation for the shadow (percentile 100), erosion for the inner glow
+   *  (alpha percentile 0); a negative radius inverts the percentiles
+   */
+  dilate = (e->effect->type == GIMP_FUSED_EFFECT_DROP_SHADOW);
+
+  if (e->grow < 0)
+    dilate = ! dilate;
+
+  job.src       = bins;
+  job.src_rect  = *alpha_rect;
+  job.clamp     = e->in_bbox;
+  job.clamped   = clamped;
+  job.outline   = e->outline;
+  job.radius    = abs (e->grow);
+  job.max       = dilate;
+  job.dest      = g_new (gfloat, (gsize) dest_rect->width * dest_rect->height);
+  job.dest_rect = *dest_rect;
+
+  fused_parallel_rows (dest_rect->height, morph_rows, &job);
+
+  g_free (bins);
+
+  return job.dest;
+}
+
+
+/*  separable FIR blur, abyss none  */
+
+typedef struct
+{
+  const gfloat  *src;
+  GeglRectangle  src_rect;
+  gfloat        *dest;
+  GeglRectangle  dest_rect;
+  const gfloat  *cmatrix;
+  gint           clen;
+} BlurJob;
+
+static void
+blur_h_rows (gint     y1,
+             gint     y2,
+             gpointer data)
+{
+  BlurJob *job  = data;
+  gint     h    = job->clen / 2;
+  gint     w    = job->dest_rect.width;
+  gint     n    = w + job->clen - 1;
+  gfloat  *row  = g_new (gfloat, n);
+  gint     y;
+
+  for (y = y1; y < y2; y++)
+    {
+      gint          sy  = job->dest_rect.y + y - job->src_rect.y;
+      gfloat       *out = job->dest + (gsize) y * w;
+      gint          i;
+
+      for (i = 0; i < n; i++)
+        {
+          gint sx = job->dest_rect.x - h + i - job->src_rect.x;
+
+          if (sy < 0 || sy >= job->src_rect.height ||
+              sx < 0 || sx >= job->src_rect.width)
+            row[i] = 0.0f;
+          else
+            row[i] = job->src[(gsize) sy * job->src_rect.width + sx];
+        }
+
+      /*  the same sums as gblur-1d's fir_blur_1D() (in the same order),
+       *  one tap at a time over the row, which vectorizes
+       */
+      {
+        gint m;
+
+        for (i = 0; i < w; i++)
+          out[i] = 0.0f;
+
+        for (m = 0; m < job->clen; m++)
+          {
+            const gfloat  c = job->cmatrix[m];
+            const gfloat *r = row + m;
+
+            for (i = 0; i < w; i++)
+              out[i] += r[i] * c;
+          }
+      }
+    }
+
+  g_free (row);
+}
+
+static void
+blur_v_rows (gint     y1,
+             gint     y2,
+             gpointer data)
+{
+  BlurJob *job = data;
+  gint     h   = job->clen / 2;
+  gint     w   = job->dest_rect.width;
+  gfloat  *acc = g_new (gfloat, w);
+  gint     y;
+
+  for (y = y1; y < y2; y++)
+    {
+      gfloat *out = job->dest + (gsize) y * w;
+      gint    m;
+      gint    x;
+
+      memset (acc, 0, sizeof (gfloat) * w);
+
+      for (m = 0; m < job->clen; m++)
+        {
+          gint          sy = job->dest_rect.y + y - h + m - job->src_rect.y;
+          const gfloat *s;
+          gfloat        c  = job->cmatrix[m];
+
+          if (sy < 0 || sy >= job->src_rect.height)
+            continue;
+
+          s = job->src + (gsize) sy * job->src_rect.width +
+              (job->dest_rect.x - job->src_rect.x);
+
+          for (x = 0; x < w; x++)
+            acc[x] += s[x] * c;
+        }
+
+      for (x = 0; x < w; x++)
+        out[x] = acc[x];
+    }
+
+  g_free (acc);
+}
+
+/*  the blur of src (zero outside src_rect) over dest_rect  */
+static gfloat *
+fused_blur (const Effect        *e,
+            const gfloat        *src,
+            const GeglRectangle *src_rect,
+            const GeglRectangle *dest_rect)
+{
+  BlurJob        job;
+  GeglRectangle  tmp_rect;
+  gfloat        *tmp;
+  gint           h = e->clen / 2;
+
+  /*  horizontal pass, on the rows the vertical pass reads  */
+  tmp_rect        = *dest_rect;
+  tmp_rect.y     -= h;
+  tmp_rect.height += 2 * h;
+
+  tmp = g_new (gfloat, (gsize) tmp_rect.width * tmp_rect.height);
+
+  job.src       = src;
+  job.src_rect  = *src_rect;
+  job.dest      = tmp;
+  job.dest_rect = tmp_rect;
+  job.cmatrix   = e->cmatrix;
+  job.clen      = e->clen;
+
+  fused_parallel_rows (tmp_rect.height, blur_h_rows, &job);
+
+  job.src       = tmp;
+  job.src_rect  = tmp_rect;
+  job.dest      = g_new (gfloat, (gsize) dest_rect->width * dest_rect->height);
+  job.dest_rect = *dest_rect;
+
+  fused_parallel_rows (dest_rect->height, blur_v_rows, &job);
+
+  g_free (tmp);
+
+  return job.dest;
+}
+
+
+/*  forward declarations of the recursion  */
+
+static gfloat * fused_get_alpha   (Ctx                 *ctx,
+                                   gint                 j,
+                                   const GeglRectangle *rect);
+static void     fused_ensure_plane (Ctx                *ctx,
+                                   gint                 k,
+                                   const GeglRectangle *rect,
+                                   gboolean             ahead);
+
+
+/*  the plane of effect k over rect (inside its plane rect), written into
+ *  the given planes
+ */
+
+typedef struct
+{
+  const Effect  *e;
+  const gfloat  *alpha;      /*  the layer's alpha before the effect  */
+  GeglRectangle  alpha_rect;
+  const gfloat  *blur;       /*  the blurred alpha                    */
+  GeglRectangle  blur_rect;
+  Plane         *plane;
+  GeglRectangle  rect;
+} GlowJob;
+
+/*  inner glow: gegl:src-out, gegl:color-overlay, gegl:opacity then
+ *  gegl:median-blur of radius 1 at the "cover" percentile
+ */
+static void
+glow_rows (gint     y1,
+           gint     y2,
+           gpointer data)
+{
+  GlowJob      *job = data;
+  const Effect *e   = job->e;
+  gint          w   = job->rect.width + 2;
+  guchar       *bins[3];
+  gint          y;
+  gint          i;
+
+  for (i = 0; i < 3; i++)
+    bins[i] = g_new (guchar, w);
+
+  for (y = y1; y < y2; y++)
+    {
+      gint    yy  = job->rect.y + y;
+      guchar *out = plane_at (job->plane, job->rect.x, yy);
+      gint    x;
+
+      for (i = 0; i < 3; i++)
+        {
+          gint py = yy - 1 + i;
+
+          for (x = 0; x < w; x++)
+            {
+              gint   px = job->rect.x - 1 + x;
+              gfloat a  = 0.0f;
+
+              if (px >= e->in_bbox.x && px < e->in_bbox.x + e->in_bbox.width &&
+                  py >= e->in_bbox.y && py < e->in_bbox.y + e->in_bbox.height)
+                {
+                  gint   bx = px - e->off_x - job->blur_rect.x;
+                  gint   by = py - e->off_y - job->blur_rect.y;
+                  gfloat b  = 0.0f;
+                  gfloat la;
+
+                  la = job->alpha[(gsize) (py - job->alpha_rect.y) *
+                                  job->alpha_rect.width +
+                                  (px - job->alpha_rect.x)];
+
+                  if (bx >= 0 && bx < job->blur_rect.width &&
+                      by >= 0 && by < job->blur_rect.height)
+                    b = job->blur[(gsize) by * job->blur_rect.width + bx];
+
+                  /*  src-out, then the opacity  */
+                  a = la * (1.0f - b);
+                  a = a * e->value;
+                }
+
+              bins[i][x] = fused_bin (a);
+            }
+        }
+
+      for (x = 0; x < job->rect.width; x++)
+        {
+          guchar v[9];
+          gint   n = 0;
+          gint   a, b;
+
+          for (i = 0; i < 3; i++)
+            {
+              v[n++] = bins[i][x];
+              v[n++] = bins[i][x + 1];
+              v[n++] = bins[i][x + 2];
+            }
+
+          /*  the cover_rank-th smallest value  */
+          for (a = 1; a < 9; a++)
+            {
+              guchar t = v[a];
+
+              for (b = a; b > 0 && v[b - 1] > t; b--)
+                v[b] = v[b - 1];
+
+              v[b] = t;
+            }
+
+          out[x] = v[e->cover_rank - 1];
+        }
+    }
+
+  for (i = 0; i < 3; i++)
+    g_free (bins[i]);
+}
+
+typedef struct
+{
+  const Effect  *e;
+  const gfloat  *alpha;
+  GeglRectangle  alpha_rect;
+  Plane         *plane;
+  Plane         *burst;
+  GeglRectangle  rect;
+  gint           level;
+  gint           band;
+} StrokeJob;
+
+static void
+stroke_bands (gint     b1,
+              gint     b2,
+              gpointer data)
+{
+  StrokeJob    *job = data;
+  const Effect *e   = job->e;
+  gint          b;
+
+  for (b = b1; b < b2; b++)
+    {
+      GeglRectangle  band;
+      GeglRectangle  origin;
+      gfloat        *alpha;
+      guchar        *mask;
+      guchar        *burst = NULL;
+      gint           stride;
+      gint           y;
+
+      band        = job->rect;
+      band.y      = job->rect.y + b * job->band;
+      band.height = MIN (job->band, job->rect.y + job->rect.height - band.y);
+
+      origin = rect_grow (&band, e->margin, e->margin);
+      origin = rect_intersect (&origin, &e->in_bbox);
+      origin = rect_intersect (&origin, &job->alpha_rect);
+
+      /*  the alpha of the band's origin, contiguous  */
+      alpha = g_new (gfloat, (gsize) MAX (origin.width, 1) * MAX (origin.height, 1));
+
+      for (y = 0; y < origin.height; y++)
+        memcpy (alpha + (gsize) y * origin.width,
+                job->alpha +
+                (gsize) (origin.y + y - job->alpha_rect.y) * job->alpha_rect.width +
+                (origin.x - job->alpha_rect.x),
+                sizeof (gfloat) * origin.width);
+
+      stride = gimp_operation_contour_mask_stride (band.width);
+      mask   = g_malloc ((gsize) stride * band.height);
+
+      if (job->burst)
+        burst = g_malloc ((gsize) stride * band.height);
+
+      gimp_operation_contour_render_coverage (e->contour, alpha, &origin,
+                                              &band, job->level,
+                                              mask, stride, burst, stride);
+
+      for (y = 0; y < band.height; y++)
+        {
+          memcpy (plane_at (job->plane, band.x, band.y + y),
+                  mask + (gsize) y * stride, band.width);
+
+          if (burst)
+            memcpy (plane_at (job->burst, band.x, band.y + y),
+                    burst + (gsize) y * stride, band.width);
+        }
+
+      g_free (alpha);
+      g_free (mask);
+      g_free (burst);
+    }
+}
+
+/*  computes the plane of effect k over rect (inside the plane's rect)
+ *  into plane (and burst)
+ */
+static void
+fused_compute_plane (Ctx                 *ctx,
+                     gint                 k,
+                     const GeglRectangle *rect,
+                     Plane               *plane,
+                     Plane               *burst)
+{
+  const Effect  *e = &ctx->effects[k];
+  GeglRectangle  dep;
+  gfloat        *alpha;
+
+  if (gegl_rectangle_is_empty (rect))
+    return;
+
+  dep   = fused_dep_rect (e, rect);
+  alpha = fused_get_alpha (ctx, k - 1, &dep);
+
+  switch (e->effect->type)
+    {
+    case GIMP_FUSED_EFFECT_DROP_SHADOW:
+      {
+        GeglRectangle  blur_rect = rect_shift (rect, -e->off_x, -e->off_y);
+        GeglRectangle  grow_rect;
+        gfloat        *grown;
+        gfloat        *blurred;
+        gint           h = e->clen / 2;
+        gint           y;
+
+        grow_rect = rect_grow (&blur_rect, h, h);
+
+        if (e->grow_applied)
+          {
+            grown = fused_morph (e, alpha, &dep, &grow_rect, FALSE);
+          }
+        else
+          {
+            /*  dep == grow_rect  */
+            grown = alpha;
+            alpha = NULL;
+          }
+
+        blurred = fused_blur (e, grown, &grow_rect, &blur_rect);
+
+        for (y = 0; y < rect->height; y++)
+          memcpy (plane_at (plane, rect->x, rect->y + y),
+                  blurred + (gsize) y * rect->width,
+                  sizeof (gfloat) * rect->width);
+
+        g_free (grown);
+        g_free (blurred);
+      }
+      break;
+
+    case GIMP_FUSED_EFFECT_INNER_GLOW:
+      {
+        GlowJob        job;
+        GeglRectangle  r1   = rect_grow (rect, 1, 1);
+        GeglRectangle  blur_rect;
+        GeglRectangle  ero_rect;
+        GeglRectangle  ero_in;
+        gfloat        *eroded;
+        gfloat        *blurred;
+        gint           h = e->clen / 2;
+
+        /*  where the blurred, shrunk alpha is read (before the offset)  */
+        blur_rect = rect_shift (&r1, -e->off_x, -e->off_y);
+        ero_rect  = rect_grow (&blur_rect, h, h);
+
+        /*  the shrunk alpha only exists in the layer's extent  */
+        ero_in = rect_intersect (&ero_rect, &e->in_bbox);
+
+        if (! gegl_rectangle_is_empty (&ero_in))
+          {
+            gfloat *ero_full;
+            gint    y;
+
+            eroded = fused_morph (e, alpha, &dep, &ero_in, TRUE);
+
+            /*  zero outside the extent, for the blur  */
+            ero_full = g_new0 (gfloat, (gsize) ero_rect.width * ero_rect.height);
+
+            for (y = 0; y < ero_in.height; y++)
+              memcpy (ero_full +
+                      (gsize) (ero_in.y + y - ero_rect.y) * ero_rect.width +
+                      (ero_in.x - ero_rect.x),
+                      eroded + (gsize) y * ero_in.width,
+                      sizeof (gfloat) * ero_in.width);
+
+            g_free (eroded);
+
+            blurred = fused_blur (e, ero_full, &ero_rect, &blur_rect);
+
+            g_free (ero_full);
+          }
+        else
+          {
+            blurred = g_new0 (gfloat, (gsize) blur_rect.width * blur_rect.height);
+          }
+
+        job.e          = e;
+        job.alpha      = alpha;
+        job.alpha_rect = dep;
+        job.blur       = blurred;
+        job.blur_rect  = blur_rect;
+        job.plane      = plane;
+        job.rect       = *rect;
+
+        fused_parallel_rows (rect->height, glow_rows, &job);
+
+        g_free (blurred);
+      }
+      break;
+
+    case GIMP_FUSED_EFFECT_STROKE:
+      {
+        StrokeJob job;
+        gint      n_bands;
+
+        job.e          = e;
+        job.alpha      = alpha;
+        job.alpha_rect = dep;
+        job.plane      = plane;
+        job.burst      = burst;
+        job.rect       = *rect;
+        job.level      = ctx->level;
+
+        /*  bands of at least 128 rows, rendered in parallel (each finds
+         *  the outline around itself)
+         */
+        n_bands  = MAX (1, MIN (g_get_num_processors (),
+                                rect->height / 128));
+        job.band = (rect->height + n_bands - 1) / n_bands;
+        n_bands  = (rect->height + job.band - 1) / job.band;
+
+        {
+          RowJob rj = { stroke_bands, &job };
+
+          if (n_bands > 1)
+            gegl_parallel_distribute_range (n_bands, 0.01,
+                                            fused_rows_job, &rj);
+          else
+            stroke_bands (0, 1, &job);
+        }
+      }
+      break;
+    }
+
+  g_free (alpha);
+}
+
+
+/*  the plane cache (level 0)  */
+
+static void
+fused_cache_free (GimpFusedCache *cache)
+{
+  gint k;
+
+  if (! g_atomic_int_dec_and_test (&cache->ref_count))
+    return;
+
+  for (k = 0; k < cache->n_effects; k++)
+    {
+      plane_clear (&cache->planes[k].plane);
+      plane_clear (&cache->planes[k].burst);
+      g_free (cache->planes[k].valid);
+    }
+
+  g_free (cache->planes);
+  g_slice_free (GimpFusedCache, cache);
+}
+
+static GimpFusedCache *
+fused_cache_new (const GeglRectangle *in_rect,
+                 Effect              *effects,
+                 gint                 n)
+{
+  GimpFusedCache *cache = g_slice_new0 (GimpFusedCache);
+  gint            k;
+
+  cache->ref_count = 1;
+  cache->in_rect   = *in_rect;
+  cache->n_effects = n;
+  cache->planes    = g_new0 (CachedPlane, n);
+
+  for (k = 0; k < n; k++)
+    {
+      CachedPlane *cp = &cache->planes[k];
+
+      cp->plane.rect = effects[k].plane_rect;
+      cp->n_cx = (effects[k].plane_rect.width  + CELL - 1) / CELL;
+      cp->n_cy = (effects[k].plane_rect.height + CELL - 1) / CELL;
+      cp->has_burst =
+        (effects[k].effect->type == GIMP_FUSED_EFFECT_STROKE &&
+         gimp_operation_contour_get_needs_burst (effects[k].contour));
+    }
+
+  return cache;
+}
+
+/*  allocates the plane on first use; FALSE if out of memory  */
+static gboolean
+fused_cache_alloc (CachedPlane  *cp,
+                   const Effect *e)
+{
+  GeglRectangle rect = cp->plane.rect;
+  gint          bpp  = (e->effect->type == GIMP_FUSED_EFFECT_DROP_SHADOW) ? 4 : 1;
+  gsize         size;
+
+  if (cp->allocated)
+    return cp->plane.data != NULL;
+
+  cp->allocated = TRUE;
+
+  if (gegl_rectangle_is_empty (&rect))
+    return FALSE;
+
+  size = (gsize) (bpp == 1 ? gimp_operation_contour_mask_stride (rect.width)
+                           : rect.width) * rect.height * bpp;
+
+  cp->plane.data = g_try_malloc0 (size);
+
+  if (! cp->plane.data)
+    return FALSE;
+
+  cp->plane.bpp    = bpp;
+  cp->plane.stride = (bpp == 1) ? gimp_operation_contour_mask_stride (rect.width)
+                                : rect.width;
+  cp->plane.owned  = TRUE;
+
+  if (cp->has_burst)
+    {
+      cp->burst.rect   = rect;
+      cp->burst.bpp    = 1;
+      cp->burst.stride = cp->plane.stride;
+      cp->burst.data   = g_try_malloc0 (size);
+      cp->burst.owned  = TRUE;
+
+      if (! cp->burst.data)
+        {
+          plane_clear (&cp->plane);
+          return FALSE;
+        }
+    }
+
+  cp->valid = g_new0 (guchar, (gsize) cp->n_cx * cp->n_cy);
+
+  return TRUE;
+}
+
+/*  the bounding box of the invalid cells of the plane in rect  */
+static GeglRectangle
+fused_cache_missing (CachedPlane         *cp,
+                     const GeglRectangle *rect)
+{
+  GeglRectangle r = rect_intersect (rect, &cp->plane.rect);
+  gint          cx1, cy1, cx2, cy2;
+  gint          mx1 = G_MAXINT, my1 = G_MAXINT, mx2 = -1, my2 = -1;
+  gint          cx, cy;
+  GeglRectangle result = { 0, 0, 0, 0 };
+
+  if (gegl_rectangle_is_empty (&r))
+    return result;
+
+  cx1 = (r.x - cp->plane.rect.x) / CELL;
+  cy1 = (r.y - cp->plane.rect.y) / CELL;
+  cx2 = (r.x + r.width  - 1 - cp->plane.rect.x) / CELL;
+  cy2 = (r.y + r.height - 1 - cp->plane.rect.y) / CELL;
+
+  for (cy = cy1; cy <= cy2; cy++)
+    for (cx = cx1; cx <= cx2; cx++)
+      if (! cp->valid[cy * cp->n_cx + cx])
+        {
+          mx1 = MIN (mx1, cx);
+          my1 = MIN (my1, cy);
+          mx2 = MAX (mx2, cx);
+          my2 = MAX (my2, cy);
+        }
+
+  if (mx2 < 0)
+    return result;
+
+  result.x      = cp->plane.rect.x + mx1 * CELL;
+  result.y      = cp->plane.rect.y + my1 * CELL;
+  result.width  = (mx2 - mx1 + 1) * CELL;
+  result.height = (my2 - my1 + 1) * CELL;
+
+  return rect_intersect (&result, &cp->plane.rect);
+}
+
+static void
+fused_cache_set_valid (CachedPlane         *cp,
+                       const GeglRectangle *rect,
+                       gboolean             valid)
+{
+  GeglRectangle r = rect_intersect (rect, &cp->plane.rect);
+  gint          cx1, cy1, cx2, cy2;
+  gint          cx, cy;
+
+  if (gegl_rectangle_is_empty (&r) || ! cp->valid)
+    return;
+
+  cx1 = (r.x - cp->plane.rect.x) / CELL;
+  cy1 = (r.y - cp->plane.rect.y) / CELL;
+  cx2 = (r.x + r.width  - 1 - cp->plane.rect.x) / CELL;
+  cy2 = (r.y + r.height - 1 - cp->plane.rect.y) / CELL;
+
+  for (cy = cy1; cy <= cy2; cy++)
+    for (cx = cx1; cx <= cx2; cx++)
+      {
+        if (valid)
+          {
+            /*  only the cells (in the plane) computed in full  */
+            GeglRectangle cell = { cp->plane.rect.x + cx * CELL,
+                                   cp->plane.rect.y + cy * CELL,
+                                   CELL, CELL };
+            GeglRectangle inter;
+
+            cell = rect_intersect (&cell, &cp->plane.rect);
+
+            if (! gegl_rectangle_intersect (&inter, &cell, &r) ||
+                ! gegl_rectangle_equal (&inter, &cell))
+              continue;
+          }
+
+        cp->valid[cy * cp->n_cx + cx] = valid;
+      }
+}
+
+/*  the plane of effect k, valid over rect  */
+static void
+fused_ensure_plane (Ctx                 *ctx,
+                    gint                 k,
+                    const GeglRectangle *rect,
+                    gboolean             ahead)
+{
+  const Effect  *e = &ctx->effects[k];
+  GeglRectangle  r = rect_intersect (rect, &e->plane_rect);
+
+  if (gegl_rectangle_is_empty (&r))
+    return;
+
+  if (ctx->cache)
+    {
+      CachedPlane   *cp = &ctx->cache->planes[k];
+      GeglRectangle  missing;
+
+      if (fused_cache_alloc (cp, e))
+        {
+          GeglRectangle window = r;
+
+          missing = fused_cache_missing (cp, &r);
+
+          /*  GIMP renders in chunks: when a part of the region is
+           *  missing, the missing cells around it are computed too, in
+           *  one go (the blurs' margins and the alpha of the effects
+           *  below are computed once for the neighboring chunks)
+           */
+          if (ahead && ctx->ahead && ! gegl_rectangle_is_empty (&missing))
+            {
+              window  = rect_grow (&r, AHEAD, AHEAD);
+              window  = rect_intersect (&window, &e->plane_rect);
+              missing = fused_cache_missing (cp, &window);
+            }
+
+          /*  the missing cells, within the window only: the input is
+           *  only provided around the requested region
+           *  (get_required_for_output())
+           */
+          missing = rect_intersect (&missing, &window);
+
+          if (! gegl_rectangle_is_empty (&missing))
+            {
+              fused_compute_plane (ctx, k, &missing, &cp->plane,
+                                   cp->has_burst ? &cp->burst : NULL);
+
+              /*  unless the input changed meanwhile  */
+              g_mutex_lock (&ctx->self->state_mutex);
+              if (ctx->self->generation == ctx->generation)
+                fused_cache_set_valid (cp, &missing, TRUE);
+              g_mutex_unlock (&ctx->self->state_mutex);
+            }
+
+          return;
+        }
+
+      /*  out of memory: as at levels > 0  */
+    }
+
+  /*  no cache: the plane computed during this call, if it holds rect  */
+  {
+    Plane         *plane = &ctx->temp[k];
+    Plane         *burst = &ctx->temp_burst[k];
+    GeglRectangle  inter;
+    gboolean       needs_burst;
+
+    if (plane->data &&
+        gegl_rectangle_intersect (&inter, &plane->rect, &r) &&
+        gegl_rectangle_equal (&inter, &r))
+      return;
+
+    needs_burst = (e->effect->type == GIMP_FUSED_EFFECT_STROKE &&
+                   gimp_operation_contour_get_needs_burst (e->contour));
+
+    plane_clear (plane);
+    plane_clear (burst);
+
+    plane_init (plane, &r,
+                e->effect->type == GIMP_FUSED_EFFECT_DROP_SHADOW ? 4 : 1);
+
+    if (needs_burst)
+      plane_init (burst, &r, 1);
+
+    fused_compute_plane (ctx, k, &r, plane, needs_burst ? burst : NULL);
+  }
+}
+
+static const Plane *
+fused_get_plane (Ctx  *ctx,
+                 gint  k)
+{
+  if (ctx->cache && ctx->cache->planes[k].plane.data)
+    return &ctx->cache->planes[k].plane;
+
+  return &ctx->temp[k];
+}
+
+static const Plane *
+fused_get_burst (Ctx  *ctx,
+                 gint  k)
+{
+  if (ctx->cache && ctx->cache->planes[k].plane.data)
+    return ctx->cache->planes[k].has_burst ? &ctx->cache->planes[k].burst : NULL;
+
+  return ctx->temp_burst[k].data ? &ctx->temp_burst[k] : NULL;
+}
+
+
+/*  applying an effect to a row  */
+
+typedef struct
+{
+  gint                   width;
+  gfloat                *plane;     /*  floats            */
+  guchar                *mask;      /*  stroke coverage   */
+  guchar                *burst;
+  gfloat                *layer;     /*  the effect's output (RGBA)  */
+  gfloat                *blend_in;
+  gfloat                *blend_layer;
+  gfloat                *blend_out;
+  GimpContourComposite **contour;   /*  per effect          */
+} RowScratch;
+
+static RowScratch *
+row_scratch_new (Ctx  *ctx,
+                 gint  width)
+{
+  RowScratch *rs = g_slice_new0 (RowScratch);
+  gint        k;
+
+  rs->width       = width;
+  rs->plane       = g_new (gfloat, width);
+  rs->mask        = g_new (guchar, width);
+  rs->burst       = g_new (guchar, width);
+  rs->layer       = g_new (gfloat, 4 * width);
+  rs->blend_in    = g_new (gfloat, 4 * width);
+  rs->blend_layer = g_new (gfloat, 4 * width);
+  rs->blend_out   = g_new (gfloat, 4 * width);
+  rs->contour     = g_new0 (GimpContourComposite *, ctx->n);
+
+  for (k = 0; k < ctx->n; k++)
+    if (ctx->effects[k].effect->type == GIMP_FUSED_EFFECT_STROKE)
+      rs->contour[k] =
+        gimp_operation_contour_composite_new (ctx->effects[k].contour,
+                                              ctx->format,
+                                              &ctx->effects[k].in_bbox0,
+                                              ctx->level, width);
+
+  return rs;
+}
+
+static void
+row_scratch_free (Ctx        *ctx,
+                  RowScratch *rs)
+{
+  gint k;
+
+  for (k = 0; k < ctx->n; k++)
+    if (rs->contour[k])
+      gimp_operation_contour_composite_free (rs->contour[k]);
+
+  g_free (rs->contour);
+  g_free (rs->plane);
+  g_free (rs->mask);
+  g_free (rs->burst);
+  g_free (rs->layer);
+  g_free (rs->blend_in);
+  g_free (rs->blend_layer);
+  g_free (rs->blend_out);
+  g_slice_free (RowScratch, rs);
+}
+
+/*  the filter's applicator: layer (the effect's output) composited on
+ *  in, into in, like gimp:replace / gimp:normal / gimp:layer-mode
+ */
+static void
+fused_apply_mode (const Effect *e,
+                  RowScratch   *rs,
+                  gfloat       *in,
+                  const gfloat *layer,
+                  gint          width)
+{
+  if (e->mode == GIMP_LAYER_MODE_REPLACE)
+    {
+      /*  gimp:replace, union  */
+      gfloat opacity = e->opacity;
+      gint   x;
+
+      for (x = 0; x < width; x++)
+        {
+          gfloat *o = in + 4 * x;
+          const gfloat *l = layer + 4 * x;
+          gfloat  new_alpha;
+          gfloat  ratio;
+          gint    b;
+
+          new_alpha = (l[3] - o[3]) * opacity + o[3];
+          ratio     = opacity;
+
+          if (new_alpha)
+            ratio *= l[3] / new_alpha;
+
+          for (b = 0; b < 3; b++)
+            o[b] = (l[b] - o[b]) * ratio + o[b];
+
+          o[3] = new_alpha;
+        }
+    }
+  else if (e->mode == GIMP_LAYER_MODE_NORMAL)
+    {
+      gimp_operation_layer_mode_composite_union (in, layer, layer, NULL,
+                                                 e->opacity, in, width);
+    }
+  else
+    {
+      const gfloat *blend_in    = in;
+      const gfloat *blend_layer = layer;
+
+      if (e->to_blend)
+        {
+          babl_process (e->to_blend, in,    rs->blend_in,    width);
+          babl_process (e->to_blend, layer, rs->blend_layer, width);
+
+          blend_in    = rs->blend_in;
+          blend_layer = rs->blend_layer;
+        }
+
+      e->blend_func (NULL, blend_in, blend_layer, rs->blend_out, width);
+
+      if (e->from_blend)
+        babl_process (e->from_blend, rs->blend_out, rs->blend_out, width);
+
+      switch (e->composite_mode)
+        {
+        case GIMP_LAYER_COMPOSITE_CLIP_TO_BACKDROP:
+          gimp_operation_layer_mode_composite_clip_to_backdrop (in, layer,
+                                                                rs->blend_out,
+                                                                NULL,
+                                                                e->opacity,
+                                                                in, width);
+          break;
+
+        case GIMP_LAYER_COMPOSITE_CLIP_TO_LAYER:
+          gimp_operation_layer_mode_composite_clip_to_layer (in, layer,
+                                                             rs->blend_out,
+                                                             NULL,
+                                                             e->opacity,
+                                                             in, width);
+          break;
+
+        case GIMP_LAYER_COMPOSITE_INTERSECTION:
+          gimp_operation_layer_mode_composite_intersection (in, layer,
+                                                            rs->blend_out,
+                                                            NULL,
+                                                            e->opacity,
+                                                            in, width);
+          break;
+
+        case GIMP_LAYER_COMPOSITE_UNION:
+        default:
+          gimp_operation_layer_mode_composite_union (in, layer,
+                                                     rs->blend_out,
+                                                     NULL,
+                                                     e->opacity,
+                                                     in, width);
+          break;
+        }
+    }
+}
+
+/*  applies effect k to the row of the layer in (RGBA, in place) at x, y  */
+static void
+fused_apply_row (Ctx        *ctx,
+                 gint        k,
+                 RowScratch *rs,
+                 gfloat     *in,
+                 gint        x0,
+                 gint        y,
+                 gint        width)
+{
+  const Effect *e     = &ctx->effects[k];
+  const Plane  *plane = fused_get_plane (ctx, k);
+  gfloat       *layer = rs->layer;
+  gint          x;
+
+  /*  rows outside the effect's output and the layer: nothing  */
+  if ((y < e->op_bbox.y || y >= e->op_bbox.y + e->op_bbox.height) &&
+      (y < e->in_bbox.y || y >= e->in_bbox.y + e->in_bbox.height))
+    return;
+
+  switch (e->effect->type)
+    {
+    case GIMP_FUSED_EFFECT_DROP_SHADOW:
+      {
+        const gfloat *col = e->color;
+
+        plane_get_row (plane, x0, y, width, rs->plane);
+
+        for (x = 0; x < width; x++)
+          {
+            const gfloat *a  = in + 4 * x;
+            gfloat       *l  = layer + 4 * x;
+            gfloat        v  = rs->plane[x] * e->value;
+            gfloat        sa = col[3] * v;
+            gfloat        la = a[3];
+            gfloat        k1 = 1.0f - la;
+            gfloat        oa = la + sa * k1;
+
+            /*  layer OVER (color * blurred alpha * opacity), premultiplied  */
+            if (oa > 0.0f)
+              {
+                l[0] = (a[0] * la + col[0] * v * k1) / oa;
+                l[1] = (a[1] * la + col[1] * v * k1) / oa;
+                l[2] = (a[2] * la + col[2] * v * k1) / oa;
+              }
+            else
+              {
+                l[0] = l[1] = l[2] = 0.0f;
+              }
+
+            l[3] = oa;
+          }
+      }
+      break;
+
+    case GIMP_FUSED_EFFECT_INNER_GLOW:
+      plane_get_row (plane, x0, y, width, rs->plane);
+
+      for (x = 0; x < width; x++)
+        {
+          gfloat *l = layer + 4 * x;
+
+          l[0] = e->color[0];
+          l[1] = e->color[1];
+          l[2] = e->color[2];
+          l[3] = rs->plane[x];
+        }
+      break;
+
+    case GIMP_FUSED_EFFECT_STROKE:
+      {
+        const Plane *burst = fused_get_burst (ctx, k);
+
+        plane_get_row_u8 (plane, x0, y, width, rs->mask);
+
+        if (burst)
+          plane_get_row_u8 (burst, x0, y, width, rs->burst);
+
+        gimp_operation_contour_composite_row (rs->contour[k], in, layer,
+                                              rs->mask,
+                                              burst ? rs->burst : NULL,
+                                              x0, y, width);
+      }
+      break;
+    }
+
+  fused_apply_mode (e, rs, in, layer, width);
+}
+
+
+/*  the layer's alpha after effect j (-1: the input) over rect, zero
+ *  outside its extent
+ */
+
+typedef struct
+{
+  Ctx           *ctx;
+  gint           j;
+  gfloat        *alpha;
+  GeglRectangle  rect;
+} PropJob;
+
+static void
+prop_rows (gint     y1,
+           gint     y2,
+           gpointer data)
+{
+  PropJob    *job = data;
+  gint        w   = job->rect.width;
+  RowScratch *rs  = row_scratch_new (job->ctx, w);
+  gfloat     *row = g_new0 (gfloat, 4 * w);
+  gint        y;
+
+  for (y = y1; y < y2; y++)
+    {
+      gfloat *a = job->alpha + (gsize) y * w;
+      gint    x;
+
+      for (x = 0; x < w; x++)
+        {
+          row[4 * x + 0] = 0.0f;
+          row[4 * x + 1] = 0.0f;
+          row[4 * x + 2] = 0.0f;
+          row[4 * x + 3] = a[x];
+        }
+
+      fused_apply_row (job->ctx, job->j, rs, row,
+                       job->rect.x, job->rect.y + y, w);
+
+      for (x = 0; x < w; x++)
+        a[x] = row[4 * x + 3];
+    }
+
+  g_free (row);
+  row_scratch_free (job->ctx, rs);
+}
+
+/*  the input's alpha: babl has no fast path from 8 bit formats to
+ *  "A float" (3 to 4 times slower than to "RGBA float"), the rows are
+ *  read in the processing format
+ */
+typedef struct
+{
+  Ctx           *ctx;
+  gfloat        *alpha;
+  GeglRectangle  rect;     /*  of alpha        */
+  GeglRectangle  read;     /*  inside, to read */
+} InputJob;
+
+static void
+input_rows (gint     y1,
+            gint     y2,
+            gpointer data)
+{
+  InputJob      *job = data;
+  GeglRectangle  band;
+  gfloat        *rgba;
+  gint           y, x;
+
+  band        = job->read;
+  band.y      = job->read.y + y1;
+  band.height = y2 - y1;
+
+  rgba = g_new (gfloat, (gsize) band.width * band.height * 4);
+
+  gegl_buffer_get (job->ctx->input, &band, 1.0 / (1 << job->ctx->level),
+                   job->ctx->format, rgba,
+                   GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+
+  for (y = 0; y < band.height; y++)
+    {
+      const gfloat *src  = rgba + (gsize) y * band.width * 4 + 3;
+      gfloat       *dest = job->alpha +
+                           (gsize) (band.y + y - job->rect.y) * job->rect.width +
+                           (band.x - job->rect.x);
+
+      for (x = 0; x < band.width; x++)
+        dest[x] = src[4 * x];
+    }
+
+  g_free (rgba);
+}
+
+static gfloat *
+fused_get_alpha (Ctx                 *ctx,
+                 gint                 j,
+                 const GeglRectangle *rect)
+{
+  gfloat *alpha;
+
+  if (j < 0)
+    {
+      const GeglRectangle *bbox = &ctx->effects[0].in_bbox;
+      GeglRectangle        r    = rect_intersect (rect, bbox);
+
+      alpha = g_new0 (gfloat, (gsize) MAX (rect->width, 1) * MAX (rect->height, 1));
+
+      if (! gegl_rectangle_is_empty (&r))
+        {
+          InputJob job = { ctx, alpha, *rect, r };
+
+          fused_parallel_rows (r.height, input_rows, &job);
+        }
+
+      return alpha;
+    }
+
+  fused_ensure_plane (ctx, j, rect, FALSE);
+
+  alpha = fused_get_alpha (ctx, j - 1, rect);
+
+  {
+    PropJob job = { ctx, j, alpha, *rect };
+
+    fused_parallel_rows (rect->height, prop_rows, &job);
+  }
+
+  /*  zero outside the extent  */
+  {
+    const GeglRectangle *bbox = &ctx->effects[j].out_bbox;
+    gint                 y, x;
+
+    for (y = 0; y < rect->height; y++)
+      {
+        gint yy = rect->y + y;
+
+        for (x = 0; x < rect->width; x++)
+          {
+            gint xx = rect->x + x;
+
+            if (yy < bbox->y || yy >= bbox->y + bbox->height ||
+                xx < bbox->x || xx >= bbox->x + bbox->width)
+              alpha[(gsize) y * rect->width + x] = 0.0f;
+          }
+      }
+  }
+
+  return alpha;
+}
+
+
+/*  GeglOperation  */
+
+static GeglRectangle
+gimp_operation_layer_style_fused_get_bounding_box (GeglOperation *operation)
+{
+  GimpOperationLayerStyleFused *self   = GIMP_OPERATION_LAYER_STYLE_FUSED (operation);
+  GeglRectangle                 result = { 0, 0, 0, 0 };
+  const GeglRectangle          *in_rect;
+  Effect                       *effects;
+  GimpFusedStyle               *style;
+
+  in_rect = gegl_operation_source_get_bounding_box (operation, "input");
+
+  if (! in_rect)
+    return result;
+
+  if (gegl_rectangle_is_infinite_plane (in_rect) ||
+      gegl_rectangle_is_empty (in_rect))
+    return *in_rect;
+
+  g_mutex_lock (&self->state_mutex);
+  style = self->style ? gimp_fused_style_ref (self->style) : NULL;
+  g_mutex_unlock (&self->state_mutex);
+
+  if (! style)
+    return *in_rect;
+
+  effects = fused_effects_new (style, in_rect, 0,
+                               babl_format ("RGBA float"), &result);
+
+  fused_effects_free (effects, style->n_effects);
+  gimp_fused_style_unref (style);
+
+  return result;
+}
+
+/*  how far the effects reach, in level 0 pixels  */
+static gint
+fused_total_reach (GimpFusedStyle *style)
+{
+  gint reach = 0;
+  gint k;
+
+  for (k = 0; k < style->n_effects; k++)
+    {
+      const GimpFusedEffect *fe = &style->effects[k];
+
+      switch (fe->type)
+        {
+        case GIMP_FUSED_EFFECT_DROP_SHADOW:
+        case GIMP_FUSED_EFFECT_INNER_GLOW:
+          reach += fused_fir_length (fe->radius) / 2 +
+                   abs ((gint) fe->grow_radius) +
+                   MAX (abs (fe->x), abs (fe->y)) + 2;
+          break;
+
+        case GIMP_FUSED_EFFECT_STROKE:
+          reach += gimp_operation_contour_get_level_margin (GIMP_OPERATION_CONTOUR (fe->stroke), 0);
+          break;
+        }
+    }
+
+  return reach;
+}
+
+static GeglRectangle
+gimp_operation_layer_style_fused_get_required_for_output (GeglOperation       *operation,
+                                                          const gchar         *input_pad,
+                                                          const GeglRectangle *roi)
+{
+  GimpOperationLayerStyleFused *self = GIMP_OPERATION_LAYER_STYLE_FUSED (operation);
+  const GeglRectangle          *in_rect;
+  gint                          reach = 0;
+  gint                          ahead = 0;
+
+  in_rect = gegl_operation_source_get_bounding_box (operation, "input");
+
+  if (! in_rect || gegl_rectangle_is_infinite_plane (in_rect))
+    return *roi;
+
+  g_mutex_lock (&self->state_mutex);
+  if (self->style)
+    {
+      reach = fused_total_reach (self->style);
+
+      if (self->style->ahead)
+        ahead = AHEAD;
+    }
+  g_mutex_unlock (&self->state_mutex);
+
+  /*  the planes are computed ahead of the region (fused_ensure_plane()),
+   *  from the input there
+   */
+  return rect_grow (roi, reach + ahead, reach + ahead);
+}
+
+static GeglRectangle
+gimp_operation_layer_style_fused_get_invalidated_by_change (GeglOperation       *operation,
+                                                            const gchar         *input_pad,
+                                                            const GeglRectangle *input_region)
+{
+  GimpOperationLayerStyleFused *self = GIMP_OPERATION_LAYER_STYLE_FUSED (operation);
+  GeglRectangle                 region = *input_region;
+  gint                          k;
+
+  g_mutex_lock (&self->state_mutex);
+
+  if (! self->style)
+    {
+      g_mutex_unlock (&self->state_mutex);
+      return region;
+    }
+
+  self->generation++;
+
+  for (k = 0; k < self->style->n_effects; k++)
+    {
+      const GimpFusedEffect *fe = &self->style->effects[k];
+      GeglRectangle          affected;
+
+      switch (fe->type)
+        {
+        case GIMP_FUSED_EFFECT_DROP_SHADOW:
+        case GIMP_FUSED_EFFECT_INNER_GLOW:
+          {
+            gint reach = fused_fir_length (fe->radius) / 2 +
+                         abs ((gint) fe->grow_radius) + 1;
+
+            affected = rect_grow (&region, reach, reach);
+            affected = rect_shift (&affected, fe->x, fe->y);
+            affected = rect_union (&affected, &region);
+            affected = rect_grow (&affected, 1, 1);
+          }
+          break;
+
+        case GIMP_FUSED_EFFECT_STROKE:
+        default:
+          {
+            gint margin =
+              gimp_operation_contour_get_level_margin (GIMP_OPERATION_CONTOUR (fe->stroke), 0);
+
+            affected = rect_grow (&region, margin, margin);
+
+            gimp_operation_contour_input_changed (GIMP_OPERATION_CONTOUR (fe->stroke));
+          }
+          break;
+        }
+
+      /*  the plane of effect k is invalidated over the k-th rectangle
+       *  of the sequence, by the next rendering
+       */
+      g_array_append_val (self->pending, affected);
+
+      region = affected;
+    }
+
+  g_mutex_unlock (&self->state_mutex);
+
+  return region;
+}
+
+static GeglRectangle
+gimp_operation_layer_style_fused_get_cached_region (GeglOperation       *operation,
+                                                    const GeglRectangle *roi)
+{
+  return *roi;
+}
+
+
+/*  the colors of roi  */
+
+typedef struct
+{
+  Ctx           *ctx;
+  gfloat        *data;
+  GeglRectangle  roi;
+} ColorJob;
+
+static void
+color_rows (gint     y1,
+            gint     y2,
+            gpointer data)
+{
+  ColorJob   *job = data;
+  gint        w   = job->roi.width;
+  RowScratch *rs  = row_scratch_new (job->ctx, w);
+  gint        y;
+
+  /*  the layer's colors, read by each thread  */
+  gegl_buffer_get (job->ctx->input,
+                   GEGL_RECTANGLE (job->roi.x, job->roi.y + y1, w, y2 - y1),
+                   1.0 / (1 << job->ctx->level), job->ctx->format,
+                   job->data + (gsize) y1 * w * 4,
+                   GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+
+  for (y = y1; y < y2; y++)
+    {
+      gfloat *row = job->data + (gsize) y * w * 4;
+      gint    k;
+
+      for (k = 0; k < job->ctx->n; k++)
+        fused_apply_row (job->ctx, k, rs, row,
+                         job->roi.x, job->roi.y + y, w);
+    }
+
+  row_scratch_free (job->ctx, rs);
+}
+
+static void
+fused_copy (GeglBuffer          *input,
+            GeglBuffer          *output,
+            const GeglRectangle *roi,
+            gint                 level)
+{
+  const Babl         *format = gegl_buffer_get_format (output);
+  GeglBufferIterator *iter;
+
+  if (level == 0)
+    {
+      gegl_buffer_copy (input, roi, GEGL_ABYSS_NONE, output, roi);
+      return;
+    }
+
+  iter = gegl_buffer_iterator_new (output, roi, level, format,
+                                   GEGL_ACCESS_WRITE, GEGL_ABYSS_NONE, 2);
+  gegl_buffer_iterator_add (iter, input, roi, level, format,
+                            GEGL_ACCESS_READ, GEGL_ABYSS_NONE);
+
+  while (gegl_buffer_iterator_next (iter))
+    memcpy (iter->items[0].data, iter->items[1].data,
+            (gsize) iter->length * babl_format_get_bytes_per_pixel (format));
+}
+
+static gboolean
+gimp_operation_layer_style_fused_process (GeglOperation       *operation,
+                                          GeglBuffer          *input,
+                                          GeglBuffer          *output,
+                                          const GeglRectangle *roi0,
+                                          gint                 level)
+{
+  GimpOperationLayerStyleFused *self   = GIMP_OPERATION_LAYER_STYLE_FUSED (operation);
+  const Babl                   *format = gegl_operation_get_format (operation, "output");
+  const GeglRectangle          *in_rect;
+  GimpFusedStyle               *style;
+  Ctx                           ctx    = { 0, };
+  ColorJob                      job;
+  GeglRectangle                 roi_level;
+  const GeglRectangle          *roi    = &roi_level;
+  gint                          k;
+
+  in_rect = gegl_operation_source_get_bounding_box (operation, "input");
+
+  if (level < 0)
+    level = 0;
+
+  /*  GEGL gives the region in level 0 coordinates (like to
+   *  gegl:gblur-1d), the buffers are accessed in the level's
+   */
+  roi_level.x      = roi0->x >> level;
+  roi_level.y      = roi0->y >> level;
+  roi_level.width  = ((roi0->x + roi0->width)  >> level) - roi_level.x;
+  roi_level.height = ((roi0->y + roi0->height) >> level) - roi_level.y;
+
+  g_mutex_lock (&self->mutex);
+
+  /*  the style, and the changes since the last rendering  */
+  g_mutex_lock (&self->state_mutex);
+
+  style = self->style ? gimp_fused_style_ref (self->style) : NULL;
+
+  if (self->reset)
+    {
+      g_clear_pointer (&self->cache, fused_cache_free);
+      self->reset = FALSE;
+    }
+
+  if (self->cache && style &&
+      self->cache->n_effects == style->n_effects)
+    {
+      guint i;
+
+      for (i = 0; i < self->pending->len; i++)
+        fused_cache_set_valid (&self->cache->planes[i % style->n_effects],
+                               &g_array_index (self->pending, GeglRectangle, i),
+                               FALSE);
+    }
+  else
+    {
+      g_clear_pointer (&self->cache, fused_cache_free);
+    }
+
+  g_array_set_size (self->pending, 0);
+
+  ctx.generation = self->generation;
+
+  g_mutex_unlock (&self->state_mutex);
+
+  if (! style || style->n_effects == 0                  ||
+      ! in_rect || gegl_rectangle_is_empty (in_rect)    ||
+      gegl_rectangle_is_infinite_plane (in_rect))
+    {
+      g_clear_pointer (&style, gimp_fused_style_unref);
+      g_mutex_unlock (&self->mutex);
+      fused_copy (input, output, roi, level);
+      return TRUE;
+    }
+
+  ctx.self    = self;
+  ctx.input   = input;
+  ctx.format  = format;
+  ctx.level   = level;
+  ctx.n       = style->n_effects;
+  ctx.ahead   = style->ahead;
+  ctx.effects = fused_effects_new (style, in_rect, level, format, NULL);
+
+  ctx.temp       = g_new0 (Plane, ctx.n);
+  ctx.temp_burst = g_new0 (Plane, ctx.n);
+
+  if (level == 0)
+    {
+      if (self->cache && ! gegl_rectangle_equal (&self->cache->in_rect, in_rect))
+        g_clear_pointer (&self->cache, fused_cache_free);
+
+      if (! self->cache)
+        self->cache = fused_cache_new (in_rect, ctx.effects, ctx.n);
+
+      ctx.cache = self->cache;
+      g_atomic_int_inc (&ctx.cache->ref_count);
+    }
+  else
+    {
+      /*  levels > 0 don't use the cache  */
+      g_mutex_unlock (&self->mutex);
+    }
+
+  /*  1. the planes over roi, from the top effect down: the planes below
+   *  are computed over the larger areas the ones above need
+   */
+  for (k = ctx.n - 1; k >= 0; k--)
+    fused_ensure_plane (&ctx, k, roi, TRUE);
+
+  /*  the colors only read the planes over roi: GEGL can render other
+   *  regions meanwhile (sinks render in several threads); the cache
+   *  stays alive while referenced
+   */
+  if (level == 0)
+    g_mutex_unlock (&self->mutex);
+
+  /*  2. the colors: all the effects, one row at a time  */
+  job.ctx  = &ctx;
+  job.roi  = *roi;
+  job.data = g_new (gfloat, (gsize) roi->width * roi->height * 4);
+
+  fused_parallel_rows (roi->height, color_rows, &job);
+
+  gegl_buffer_set (output, roi, level, format, job.data, GEGL_AUTO_ROWSTRIDE);
+
+  g_free (job.data);
+
+  for (k = 0; k < ctx.n; k++)
+    {
+      plane_clear (&ctx.temp[k]);
+      plane_clear (&ctx.temp_burst[k]);
+    }
+
+  g_free (ctx.temp);
+  g_free (ctx.temp_burst);
+  fused_effects_free (ctx.effects, ctx.n);
+  gimp_fused_style_unref (style);
+
+  if (ctx.cache)
+    fused_cache_free (ctx.cache);
+
+  return TRUE;
+}
