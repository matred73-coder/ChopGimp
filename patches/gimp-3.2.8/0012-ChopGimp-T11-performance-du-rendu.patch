+ *  consecutive such filters, instead of each filter's own graph
+ *  (operation, blend mode, cache): the filter stack chains the fused node
+ *  in place of the filters (gimp_filter_stack_set_fuse_func()). Nothing
+ *  changes in the filters themselves.
+ *
+ *  A filter is left to its own graph when the fused operation would not
+ *  render it like that graph: its options (gimp_fused_effect_init()), or
+ *  its filter settings (gimp_drawable_filter_get_fusable(): mask, region,
+ *  clip, crop, preview, component restriction, a filter being edited by
+ *  a filter tool, or to be merged).
+ *
+ *  CHOPGIMP_FUSED_STYLES_DEBUG=1 prints the runs of fused filters.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+#include <gegl-plugin.h>
+
+#include "core-types.h"
+
+#include "operations/gimpoperationlayerstylefused.h"
+
+#include "chopgimp-behind-effects.h"
+#include "gimpdrawable.h"
+#include "gimpdrawable-filters.h"
+#include "gimpdrawable-fused-styles.h"
+#include "gimpdrawablefilter.h"
+#include "gimpfilterstack.h"
+
+
+#define STATE_KEY "chopgimp-fused-styles"
+
+
+typedef struct
+{
+  GList    *filters;   /*  the run, bottom up (not referenced)  */
+  GeglNode *node;      /*  its fused node                       */
+  GeglNode *crop;
+  GeglNode *op;
+} Run;
+
+typedef struct
+{
+  GimpDrawable *drawable;
+  GList        *runs;
+  guint         serial;
+  gboolean      updating;
+  gint          suspended;
+} State;
+
+
+static void
+run_free (Run *run)
+{
+  g_list_free (run->filters);
+  g_clear_object (&run->node);
+  g_slice_free (Run, run);
+}
+
+static void
+state_free (State *state)
+{
+  g_list_free_full (state->runs, (GDestroyNotify) run_free);
+  g_slice_free (State, state);
+}
+
+static gboolean
+gimp_drawable_fused_styles_effect (GimpFilter      *filter,
+                                   GimpFusedEffect *effect)
+{
+  GimpDrawableFilter *df;
+
+  if (! GIMP_IS_DRAWABLE_FILTER (filter))
+    return FALSE;
+
+  df = GIMP_DRAWABLE_FILTER (filter);
+
+  if (! gimp_drawable_filter_get_fusable (df))
+    return FALSE;
+
+  return gimp_fused_effect_init (effect,
+                                 gimp_drawable_filter_get_operation (df),
+                                 gimp_drawable_filter_get_paint_mode (df),
+                                 gimp_drawable_filter_get_blend_space (df),
+                                 gimp_drawable_filter_get_composite_space (df),
+                                 gimp_drawable_filter_get_composite_mode (df),
+                                 gimp_drawable_filter_get_opacity (df));
+}
+
+static gboolean
+filter_lists_equal (GList *a,
+                    GList *b)
+{
+  while (a && b)
+    {
+      if (a->data != b->data)
+        return FALSE;
+
+      a = g_list_next (a);
+      b = g_list_next (b);
+    }
+
+  return (a == NULL && b == NULL);
+}
+
+/*  the fused node of a run, reused from the previous runs if they had the
+ *  same filters, its style updated
+ */
+static Run *
+gimp_drawable_fused_styles_get_run (State           *state,
+                                    GList           *old_runs,
+                                    GList           *filters,
+                                    GimpFusedStyle  *style)
+{
+  GimpDrawableFilter *first = filters->data;
+  Run                *run   = NULL;
+  GList              *list;
+  GimpFusedStyle     *old_style = NULL;
+  GeglRectangle       crop;
+
+  for (list = old_runs; list; list = g_list_next (list))
+    {
+      Run *old = list->data;
+
+      if (old->node && filter_lists_equal (old->filters, filters))
+        {
+          run = g_slice_new0 (Run);
+          run->filters = g_list_copy (filters);
+          run->node    = g_object_ref (old->node);
+          run->crop    = old->crop;
+          run->op      = old->op;
+          break;
+        }
+    }
+
+  if (! run)
+    {
+      GeglNode *input;
+      GeglNode *output;
+
+      run = g_slice_new0 (Run);
+      run->filters = g_list_copy (filters);
+      run->node    = gegl_node_new ();
+
+      input  = gegl_node_get_input_proxy  (run->node, "input");
+      output = gegl_node_get_output_proxy (run->node, "output");
+
+      run->crop = gegl_node_new_child (run->node,
+                                       "operation", "gegl:nop",
+                                       NULL);
+      run->op   = gegl_node_new_child (run->node,
+                                       "operation", "chopgimp:layer-style-fused",
+                                       NULL);
+
+      gegl_node_link_many (input, run->crop, run->op, output, NULL);
+    }
+
+  /*  the first filter of the drawable crops its input to the drawable  */
+  if (gimp_drawable_filter_get_input_crop (first, &crop))
+    {
+      gdouble x, y, w, h;
+
+      if (strcmp (gegl_node_get_operation (run->crop), "gegl:crop"))
+        {
+          gegl_node_set (run->crop,
+                         "operation", "gegl:crop",
+                         "x",         (gdouble) crop.x,
+                         "y",         (gdouble) crop.y,
+                         "width",     (gdouble) crop.width,
+                         "height",    (gdouble) crop.height,
+                         NULL);
+        }
+      else
+        {
+          gegl_node_get (run->crop,
+                         "x", &x, "y", &y, "width", &w, "height", &h,
+                         NULL);
+
+          if (x != crop.x || y != crop.y || w != crop.width || h != crop.height)
+            gegl_node_set (run->crop,
+                           "x",      (gdouble) crop.x,
+                           "y",      (gdouble) crop.y,
+                           "width",  (gdouble) crop.width,
+                           "height", (gdouble) crop.height,
+                           NULL);
+        }
+    }
+  else if (strcmp (gegl_node_get_operation (run->crop), "gegl:nop"))
+    {
+      gegl_node_set (run->crop,
+                     "operation", "gegl:nop",
+                     NULL);
+    }
+
+  /*  setting the style invalidates the node: only when it changed  */
+  gegl_node_get (run->op, "style", &old_style, NULL);
+
+  if (! gimp_fused_style_equal (old_style, style))
+    gegl_node_set (run->op, "style", style, NULL);
+
+  if (old_style)
+    gimp_fused_style_unref (old_style);
+
+  return run;
+}
+
+static GList *
+gimp_drawable_fused_styles_fuse (GimpFilterStack *stack,
+                                 GList           *filters,
+                                 gpointer         user_data)
+{
+  static gint  debug    = -1;   /*  CHOPGIMP_FUSED_STYLES_DEBUG, read once  */
+  State       *state    = user_data;
+  GList       *nodes    = NULL;
+  GList       *old_runs = state->runs;
+  GList       *new_runs = NULL;
+  GList       *list;
+
+  /*  suspended: each filter renders itself  */
+  if (state->suspended)
+    {
+      for (list = filters; list; list = g_list_next (list))
+        nodes = g_list_append (nodes,
+                               gimp_filter_get_node (GIMP_FILTER (list->data)));
+
+      state->runs = NULL;
+      g_list_free_full (old_runs, (GDestroyNotify) run_free);
+
+      return nodes;
+    }
+
+  list = filters;
+
+  while (list)
+    {
+      GList           *run_filters = NULL;
+      GArray          *effects;
+      GimpFusedEffect  effect;
+
+      effects = g_array_new (FALSE, FALSE, sizeof (GimpFusedEffect));
+
+      /*  the longest run of fusable filters from here; a behind filter
+       *  (chopgimp-behind-effects.c) stands for itself: the filter
+       *  stack takes it out of the chain
+       */
+      while (list &&
+             ! chopgimp_behind_effects_is_behind (state->drawable,
+                                                  list->data)  &&
+             gimp_drawable_fused_styles_effect (list->data, &effect))
+        {
+          effect.serial = state->serial;
+
+          g_array_append_val (effects, effect);
+          run_filters = g_list_append (run_filters, list->data);
+
+          list = g_list_next (list);
+        }
+
+      if (run_filters)
+        {
+          GimpFusedStyle *style = gimp_fused_style_new (effects->len);
+          Run            *run;
+
+          memcpy (style->effects, effects->data,
+                  sizeof (GimpFusedEffect) * effects->len);
+
+          /*  the planes are computed ahead of the requested regions  */
+          style->ahead = TRUE;
+
+          run = gimp_drawable_fused_styles_get_run (state, old_runs,
+                                                    run_filters, style);
+
+          if (debug < 0)
+            debug = (g_getenv ("CHOPGIMP_FUSED_STYLES_DEBUG") != NULL);
+
+          if (debug)
+            g_printerr ("chopgimp: %d layer style filter(s) fused\n",
+                        (gint) effects->len);
+
+          gimp_fused_style_unref (style);
+
+          new_runs = g_list_append (new_runs, run);
+          nodes    = g_list_append (nodes, run->node);
+
+          g_list_free (run_filters);
+        }
+
+      g_array_free (effects, TRUE);
+
+      /*  a filter which stands for itself  */
+      if (list)
+        {
+          nodes = g_list_append (nodes,
+                                 gimp_filter_get_node (GIMP_FILTER (list->data)));
+
+          list = g_list_next (list);
+        }
+    }
+
+  state->runs = new_runs;
+  g_list_free_full (old_runs, (GDestroyNotify) run_free);
+
+  return nodes;
+}
+
+/*  a filter's operation changed: its effect's snapshot is taken again,
+ *  and the fused node invalidated
+ */
+static void
+gimp_drawable_fused_styles_filters_changed (GimpDrawable *drawable,
+                                            State        *state)
+{
+  state->serial++;
+
+  gimp_drawable_fused_styles_update (drawable);
+}
+
+
+/*  public functions  */
+
+void
+gimp_drawable_fused_styles_init (GimpDrawable *drawable)
+{
+  GimpContainer *stack;
+  State         *state;
+
+  g_return_if_fail (GIMP_IS_DRAWABLE (drawable));
+
+  stack = gimp_drawable_get_filters (drawable);
+
+  state = g_slice_new0 (State);
+  state->drawable = drawable;
+
+  g_object_set_data_full (G_OBJECT (drawable), STATE_KEY, state,
+                          (GDestroyNotify) state_free);
+
+  gimp_filter_stack_set_fuse_func (GIMP_FILTER_STACK (stack),
+                                   gimp_drawable_fused_styles_fuse,
+                                   state);
+
+  g_signal_connect (drawable, "filters-changed",
+                    G_CALLBACK (gimp_drawable_fused_styles_filters_changed),
+                    state);
+}
+
+/*  the filters' settings changed: the runs are found again  */
+void
+gimp_drawable_fused_styles_update (GimpDrawable *drawable)
+{
+  State *state;
+
+  g_return_if_fail (GIMP_IS_DRAWABLE (drawable));
+
+  state = g_object_get_data (G_OBJECT (drawable), STATE_KEY);
+
+  if (! state || state->updating)
+    return;
+
+  state->updating = TRUE;
+
+  gimp_filter_stack_relink (GIMP_FILTER_STACK (gimp_drawable_get_filters (drawable)));
+
+  /*  the fused filters' own caches are not used  */
+  gimp_drawable_filters_cache_update (drawable);
+
+  state->updating = FALSE;
+}
+
+gboolean
+gimp_drawable_fused_styles_is_fused (GimpDrawable *drawable,
+                                     GimpFilter   *filter)
+{
+  State *state;
+  GList *list;
+
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), FALSE);
+
+  state = g_object_get_data (G_OBJECT (drawable), STATE_KEY);
+
+  if (! state)
+    return FALSE;
+
+  for (list = state->runs; list; list = g_list_next (list))
+    {
+      Run *run = list->data;
+
+      if (g_list_find (run->filters, filter))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+/*  while a filter's own graph renders it (merging a filter or all of
+ *  them uses the filter's applicator), nothing is fused
+ */
+void
+gimp_drawable_fused_styles_suspend (GimpDrawable *drawable)
+{
+  State *state;
+
+  g_return_if_fail (GIMP_IS_DRAWABLE (drawable));
+
+  state = g_object_get_data (G_OBJECT (drawable), STATE_KEY);
+
+  if (! state)
+    return;
+
+  if (state->suspended++ == 0)
+    gimp_drawable_fused_styles_update (drawable);
+}
+
+void
+gimp_drawable_fused_styles_resume (GimpDrawable *drawable)
+{
+  State *state;
+
+  g_return_if_fail (GIMP_IS_DRAWABLE (drawable));
+
+  state = g_object_get_data (G_OBJECT (drawable), STATE_KEY);
+
+  if (! state || state->suspended == 0)
+    return;
+
+  if (--state->suspended == 0)
+    gimp_drawable_fused_styles_update (drawable);
+}
