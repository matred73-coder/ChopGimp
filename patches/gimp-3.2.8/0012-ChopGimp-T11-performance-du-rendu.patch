+  if (! crop)
+    {
+      if (g_strcmp0 (operation, "gegl:nop"))
+        gegl_node_set (node,
+                       "operation", "gegl:nop",
+                       NULL);
+      return;
+    }
+
+  if (! g_strcmp0 (operation, "gegl:crop"))
+    {
+      gdouble old_x, old_y, old_width, old_height;
+
+      gegl_node_get (node,
+                     "x",      &old_x,
+                     "y",      &old_y,
+                     "width",  &old_width,
+                     "height", &old_height,
+                     NULL);
+
+      if ((! set_xy || (old_x == x && old_y == y)) &&
+          old_width == width && old_height == height)
+        return;
+    }
+
+  if (set_xy)
+    gegl_node_set (node,
+                   "operation", "gegl:crop",
+                   "x",         x,
+                   "y",         y,
+                   "width",     width,
+                   "height",    height,
+                   NULL);
+  else
+    gegl_node_set (node,
+                   "operation", "gegl:crop",
+                   "width",     width,
+                   "height",    height,
+                   NULL);
+}
