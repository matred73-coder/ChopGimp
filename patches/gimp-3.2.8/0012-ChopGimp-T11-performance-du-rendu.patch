+gboolean   gimp_gegl_graph_lock_is_initialized     (void);
+
+gboolean   gimp_gegl_graph_lock_is_main_thread     (void);
+void       gimp_gegl_graph_lock_main               (void);
+gboolean   gimp_gegl_graph_lock_try_main           (void);
+gboolean   gimp_gegl_graph_lock_main_owns          (void);
+guint      gimp_gegl_graph_lock_get_serial         (void);
+
+gboolean   gimp_gegl_graph_lock_worker_can_run     (void);
+gboolean   gimp_gegl_graph_lock_is_base_dispatch   (void);
