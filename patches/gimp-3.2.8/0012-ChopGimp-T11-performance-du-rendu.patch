+void       gimp_gegl_graph_lock_worker_acquire     (void);
+void       gimp_gegl_graph_lock_worker_release     (void);
+
+void       gimp_gegl_graph_run_in_thread           (GFunc        func,
+                                                    gpointer     data);
+
+gboolean   gimp_gegl_graph_is_threadable           (GeglNode    *graph);
+gboolean   gimp_gegl_graph_is_draftable            (GeglNode    *graph,
+                                                    gboolean    *exact);
