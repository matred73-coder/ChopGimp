diff --git a/app/operations/chopgimp-layer-styles.h b/app/operations/chopgimp-layer-styles.h
new file mode 100644
index 0000000..8bb4ba0
--- /dev/null
+++ b/app/operations/chopgimp-layer-styles.h
@@ -0,0 +1,250 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-layer-styles.h
+ * ChopGimp : styles de calque façon Photoshop (Ombre portée, Lueur
+ * externe, Ombre interne, Lueur interne, Contour, Biseau)
+ *
+ * Each layer style is a GIMP filter (GEGL operation) opened in its
+ * filter dialog with starting settings, "operation\n(settings)" as
+ * filters_parse_operation() reads it. The same settings are the
+ * "factory" defaults restored by the dialog's "Rétablir" button. The
+ * user's own defaults ("Définir par défaut") are saved as a preset of the
+ * operation named after the style, see CHOPGIMP_LAYER_STYLE_DEFAULT_NAME.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <string.h>
+
+
+/*  starting ("factory") settings of each style, Photoshop's blend modes:
+ *  multiply for the inner shadow, screen for the inner glow (GIMP's
+ *  filter blend mode, which blends the glow with the layer's pixels);
+ *  multiply for the drop shadow, screen for the outer glow
+ *  (gegl:dropshadow's "blend-mode", GEGL patch 0007: composited onto the
+ *  layers below, app/core/chopgimp-behind-effects.c; "normal", the
+ *  default, chains the shadow with the layer as before)
+ */
+
+#define CHOPGIMP_LAYER_STYLE_DROP_SHADOW \
+  "gegl:dropshadow\n" \
+  "(blend-mode multiply)"
+
+#define CHOPGIMP_LAYER_STYLE_OUTER_GLOW \
+  "gegl:dropshadow\n" \
+  "(x 0.0)(y 0.0)(radius 18.0)(grow-shape circle)(grow-radius 2.0)" \
+  "(color (color-rgba 1.0 0.93 0.6 1.0))(opacity 1.0)(blend-mode screen)"
+
+/*  gegl:inner-glow only renders the glow: GIMP's blend mode (multiply,
+ *  screen) puts it on the layer, instead of "replace" which made the
+ *  inside of the layer transparent
+ */
+#define CHOPGIMP_LAYER_STYLE_INNER_SHADOW \
+  "gegl:inner-glow\n" \
+  "(x 4.0)(y 4.0)(radius 8.0)(grow-radius 2.0)" \
+  "(value (color-rgba 0.0 0.0 0.0 1.0))(opacity 0.75)(gimp-mode multiply)"
+
+#define CHOPGIMP_LAYER_STYLE_INNER_GLOW \
+  "gegl:inner-glow\n" \
+  "(x 0.0)(y 0.0)(radius 10.0)(grow-radius 0.0)" \
+  "(value (color-rgba 1.0 1.0 0.75 1.0))(opacity 0.75)(gimp-mode screen)"
+
+/*  app/operations/gimpoperationcontour.c: its defaults are the style's  */
+#define CHOPGIMP_LAYER_STYLE_STROKE \
+  "chopgimp:stroke"
+
+#define CHOPGIMP_LAYER_STYLE_BEVEL \
+  "gegl:bevel"
+
+/*  Calque > Style de calque > Incrustation couleur (filters-gegl-color-overlay)  */
+#define CHOPGIMP_LAYER_STYLE_COLOR_OVERLAY \
+  "gegl:color-overlay"
+
+/*  3.32.0 (app/operations/gimpoperationinnereffects.c): Satin in
+ *  Photoshop's defaults (black, multiply, 50 %, 19°, 11 px, 14 px,
+ *  inverted), Incrustation de motif (the chooser's pattern, stored when
+ *  the dialog opens)
+ */
+#define CHOPGIMP_LAYER_STYLE_SATIN \
+  "chopgimp:satin\n" \
+  "(color (color-rgba 0.0 0.0 0.0 1.0))(opacity 0.5)(mode multiply)" \
+  "(angle 19.0)(distance 11.0)(size 14.0)(invert yes)(contour gaussian)"
+
+#define CHOPGIMP_LAYER_STYLE_PATTERN_OVERLAY \
+  "chopgimp:pattern-overlay\n" \
+  "(fill-type pattern)(opacity 1.0)"
+
+
+/*  name of the preset holding the user's defaults of a style  */
+#define CHOPGIMP_LAYER_STYLE_DEFAULT_NAME "Par défaut (%s)"
+
+
+typedef struct
+{
+  const gchar *action;     /*  the action opening the style's dialog   */
+  const gchar *operation;  /*  its GEGL operation                      */
+  const gchar *label;      /*  its name, as the filter is named        */
+  const gchar *factory;    /*  "operation\n(settings)"                 */
+} ChopGimpLayerStyle;
+
+static const ChopGimpLayerStyle chopgimp_layer_styles[] =
+{
+  { "filters-dropshadow",            "gegl:dropshadow", "Ombre portée",
+    CHOPGIMP_LAYER_STYLE_DROP_SHADOW  },
+  { "filters-chopgimp-outer-glow",   "gegl:dropshadow", "Lueur externe",
+    CHOPGIMP_LAYER_STYLE_OUTER_GLOW   },
+  { "filters-chopgimp-inner-shadow", "gegl:inner-glow", "Ombre interne",
+    CHOPGIMP_LAYER_STYLE_INNER_SHADOW },
+  { "filters-chopgimp-inner-glow",   "gegl:inner-glow", "Lueur interne",
+    CHOPGIMP_LAYER_STYLE_INNER_GLOW   },
+  { "filters-chopgimp-stroke",       "chopgimp:stroke", "Contour",
+    CHOPGIMP_LAYER_STYLE_STROKE       },
+  { NULL,                            "gegl:bevel",      "Biseautage",
+    CHOPGIMP_LAYER_STYLE_BEVEL        },
+  { NULL,                            "gegl:color-overlay", "Incrustation couleur",
+    CHOPGIMP_LAYER_STYLE_COLOR_OVERLAY },
+  /*  3.32.0  */
+  { "filters-chopgimp-satin",        "chopgimp:satin",  "Satin",
+    CHOPGIMP_LAYER_STYLE_SATIN        },
+  { "filters-chopgimp-pattern-overlay", "chopgimp:pattern-overlay",
+    "Incrustation de motif",
+    CHOPGIMP_LAYER_STYLE_PATTERN_OVERLAY }
+};
+
+
+/*  the style of a filter: its operation and its name (the action's
+ *  label, e.g. "Lueur externe..." or "_Ombre portée…"); when the name is
+ *  not a style's, the first style of the operation. NULL if the
+ *  operation is not a layer style.
+ */
+static inline const ChopGimpLayerStyle *
+chopgimp_layer_style_find (const gchar *operation,
+                           const gchar *name)
+{
+  const ChopGimpLayerStyle *first = NULL;
+  gint                      i;
+
+  if (! operation)
+    return NULL;
+
+  for (i = 0; i < G_N_ELEMENTS (chopgimp_layer_styles); i++)
+    {
+      const ChopGimpLayerStyle *style = &chopgimp_layer_styles[i];
+
+      if (strcmp (style->operation, operation))
+        continue;
+
+      if (! first)
+        first = style;
+
+      if (name)
+        {
+          /*  skip the mnemonic underscores of an action's label  */
+          const gchar *n = name;
+          const gchar *l = style->label;
+
+          while (*n && *l)
+            {
+              if (*n == '_')
+                {
+                  n++;
+                  continue;
+                }
+
+              if (*n != *l)
+                break;
+
+              n++;
+              l++;
+            }
+
+          if (! *l)
+            return style;
+        }
+    }
+
+  return first;
+}
+
+static inline const ChopGimpLayerStyle *
+chopgimp_layer_style_find_by_action (const gchar *action)
+{
+  gint i;
+
+  if (! action)
+    return NULL;
+
+  for (i = 0; i < G_N_ELEMENTS (chopgimp_layer_styles); i++)
+    if (chopgimp_layer_styles[i].action &&
+        ! strcmp (chopgimp_layer_styles[i].action, action))
+      return &chopgimp_layer_styles[i];
+
+  return NULL;
+}
+
+/*  rank of a style in Photoshop's « Style de calque » window (Biseautage,
+ *  Contour, Ombre interne, Lueur interne, Satin, Incrustation couleur,
+ *  Incrustation de motif, Lueur externe, Ombre portée), -1 if unknown;
+ *  CHOPGIMP_NO_INNER_STYLES=1 leaves out Satin and Incrustation de motif
+ *  (3.32.0)
+ */
+static inline gboolean
+chopgimp_layer_style_hidden (const ChopGimpLayerStyle *style)
+{
+  static gint no_inner = -1;   /*  the variable is read once  */
+
+  if (no_inner < 0)
+    no_inner = (g_getenv ("CHOPGIMP_NO_INNER_STYLES") != NULL);
+
+  return (style && no_inner &&
+          (! strcmp (style->operation, "chopgimp:satin") ||
+           ! strcmp (style->operation, "chopgimp:pattern-overlay")));
+}
+
+static inline gint
+chopgimp_layer_style_rank (const ChopGimpLayerStyle *style)
+{
+  static const gchar * const order[] =
+  {
+    "Biseautage", "Contour", "Ombre interne", "Lueur interne", "Satin",
+    "Incrustation couleur", "Incrustation de motif", "Lueur externe",
+    "Ombre portée"
+  };
+  gint i;
+
+  if (! style || chopgimp_layer_style_hidden (style))
+    return -1;
+
+  for (i = 0; i < G_N_ELEMENTS (order); i++)
+    if (! strcmp (order[i], style->label))
+      return i;
+
+  return -1;
+}
+
+/*  the style of the n-th position of Photoshop's window, or NULL  */
+static inline const ChopGimpLayerStyle *
+chopgimp_layer_style_nth (gint n)
+{
+  gint i;
+
+  for (i = 0; i < G_N_ELEMENTS (chopgimp_layer_styles); i++)
+    if (chopgimp_layer_style_rank (&chopgimp_layer_styles[i]) == n)
+      return &chopgimp_layer_styles[i];
+
+  return NULL;
+}
