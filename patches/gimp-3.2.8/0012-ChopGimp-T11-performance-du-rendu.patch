+/*  one iteration of the job path.  Returns whether to call it again.  */
+static gboolean
+gimp_projection_job_iteration (GimpProjection *proj,
+                               gboolean        threaded,
+                               gboolean        drafting)
+{
+  GimpProjectionPrivate *priv = proj->priv;
+  ChopRenderJob         *job;
+
+  job = gimp_projection_job_new (proj, threaded, drafting);
+
+  if (! job)
+    return (priv->iter || priv->deferred_region || priv->refine_region);
+
+  priv->job = job;
+
+  /*  a small area costs the main thread less to render (GEGL's workers
+   *  share the work) than the round trip through the rendering thread,
+   *  and is on screen at once: while the user paints, the areas updated
+   *  at each frame are small, and in the thread they were often changed
+   *  again before being done (rendered and copied twice)
+   */
+  if (threaded)
+    {
+      gdouble rate = (priv->rate > 0.0 ?
+                      priv->rate : CHOPGIMP_PROJECTION_INITIAL_RATE);
+      gdouble cost = (gdouble) job->lrect.width * job->lrect.height / rate;
+
+      if (cost < (gdouble) gimp_projection_get_thread_min_time ())
+        threaded = FALSE;
+    }
+
+  if (threaded)
+    {
+      priv->job_watchdog_id =
+        g_timeout_add_full (GIMP_PRIORITY_PROJECTION_IDLE,
+                            CHOPGIMP_PROJECTION_WATCHDOG_INTERVAL,
+                            (GSourceFunc) gimp_projection_job_watchdog,
+                            proj, NULL);
+
+      gimp_gegl_graph_run_in_thread ((GFunc) gimp_projection_job_thread_func,
+                                     job);
+
+      /*  the done idle schedules the next iteration  */
+      return FALSE;
+    }
+
+  job->on_main = TRUE;
+
+  if (gimp_projection_job_run_main (proj, job))
+    gimp_projection_job_complete (proj, job);
+
+  return (priv->job || priv->iter || priv->deferred_region ||
+          priv->refine_region);
+}
