+/*  same as gimp_drawable_calculate_histogram_async(), on @buffer  */
+static void
+gimp_histogram_editor_calculate_buffer (GimpHistogramEditor *editor,
+                                        GeglBuffer          *buffer)
+{
+  GimpDrawable *drawable = editor->drawable;
+  GimpChannel  *mask;
+  GimpAsync    *async;
+  gint          x, y, width, height;
+
+  if (! gimp_item_mask_intersect (GIMP_ITEM (drawable),
+                                  &x, &y, &width, &height))
+    {
+      gimp_histogram_clear_values (editor->histogram, 0);
+      gimp_histogram_editor_info_update (editor);
+      return;
+    }
+
+  mask = gimp_image_get_mask (gimp_item_get_image (GIMP_ITEM (drawable)));
+
+  if (! gimp_channel_is_empty (mask))
+    {
+      gint off_x, off_y;
+
+      gimp_item_get_offset (GIMP_ITEM (drawable), &off_x, &off_y);
+
+      async = gimp_histogram_calculate_async (
+        editor->histogram, buffer,
+        GEGL_RECTANGLE (x, y, width, height),
+        gimp_drawable_get_buffer (GIMP_DRAWABLE (mask)),
+        GEGL_RECTANGLE (x + off_x, y + off_y, width, height));
+    }
+  else
+    {
+      async = gimp_histogram_calculate_async (
+        editor->histogram, buffer,
+        GEGL_RECTANGLE (x, y, width, height),
+        NULL, NULL);
+    }
+
+  gimp_histogram_editor_set_calculate_async (editor, async);
