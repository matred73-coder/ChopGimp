+gimp_drawable_filter_set_crop_node (GeglNode *node,
+                                    gboolean  crop,
+                                    gboolean  set_xy,
+                                    gdouble   x,
+                                    gdouble   y,
+                                    gdouble   width,
+                                    gdouble   height)
+{
