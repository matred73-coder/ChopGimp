+/*  ChopGimp: invalidates the previews of @drawable for a reason which
+ *  doesn't concern its pixels (e.g. a new thumbnail framing), keeping
+ *  the reduced copy of its effects.
+ */
+void
+gimp_drawable_invalidate_preview_layout (GimpDrawable *drawable)
+{
+  EffectsPreview *ep;
+
+  g_return_if_fail (GIMP_IS_DRAWABLE (drawable));
+
+  ep = g_object_get_data (G_OBJECT (drawable), EFFECTS_PREVIEW_KEY);
+
+  if (ep && ! ep->updated)
+    ep->keep = TRUE;
+
+  gimp_viewable_invalidate_preview (GIMP_VIEWABLE (drawable));
+}
+
+/*  ChopGimp: returns (a new reference to) the reduced copy of @drawable
+ *  with its effects, at 1 / 2^@level, if it was rendered at least once
+ *  and still matches the drawable; it may lag behind the very last
+ *  changes. Meant for cheap approximations (histogram while working).
+ */
+GeglBuffer *
+gimp_drawable_get_preview_effects_buffer (GimpDrawable *drawable,
+                                          gint         *level)
+{
+  EffectsPreview *ep;
+  GeglBuffer     *src;
+
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), NULL);
+  g_return_val_if_fail (level != NULL, NULL);
+
+  ep = g_object_get_data (G_OBJECT (drawable), EFFECTS_PREVIEW_KEY);
+
+  if (! ep || ! ep->buffer || ! ep->rendered)
+    return NULL;
+
+  src = gimp_drawable_get_buffer (drawable);
+
+  if (ep->src_buffer != (gpointer) src ||
+      ! gegl_rectangle_equal (&ep->extent, gegl_buffer_get_extent (src)) ||
+      ep->format != gegl_buffer_get_format (src))
+    return NULL;
+
+  *level = ep->level;
+
+  return g_object_ref (ep->buffer);
+}
