diff --git a/app/core/chopgimp-alpha-bounds.c b/app/core/chopgimp-alpha-bounds.c
new file mode 100644
index 0000000..2b1410f
--- /dev/null
+++ b/app/core/chopgimp-alpha-bounds.c
@@ -0,0 +1,600 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-alpha-bounds.c — ChopGimp: bounds of the visible pixels
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "libgimpmath/gimpmath.h"
+
+#include "core-types.h"
+
+#include "gimpdrawable.h"
+#include "gimpitem.h"
+#include "gimppickable-auto-shrink.h"
+#include "chopgimp-alpha-bounds.h"
+
+
+/*  ChopGimp 3.25.1: the alpha of the layer formats (RGBA, YA, linear or
+ *  not, any precision) is their last component, stored exactly like the
+ *  « A <type> » formats.  Reading the buffer in its own format and looking
+ *  at that component avoids the babl conversion to « A u8 », which has no
+ *  fast path (babl_fish_reference_process_float(), several times slower
+ *  and serialized by babl's global reference mutex: all the GEGL threads
+ *  waited on each other).  Measured on a 175 MB layer: ~300 ms → a few ms.
+ */
+typedef enum
+{
+  ALPHA_U8,
+  ALPHA_U16,
+  ALPHA_U32,
+  ALPHA_HALF,
+  ALPHA_FLOAT,
+  ALPHA_DOUBLE
+} AlphaKind;
+
+typedef struct
+{
+  const Babl *format;   /* the buffer format, read without conversion */
+  gint        bpp;      /* bytes per pixel                            */
+  gint        offset;   /* byte offset of the alpha in a pixel        */
+  gint        size;     /* bytes of the alpha component               */
+  AlphaKind   kind;
+  const Babl *type;     /* babl type of the alpha                     */
+} AlphaLayout;
+
+static gboolean
+chopgimp_alpha_layout (const Babl  *format,
+                       AlphaLayout *layout)
+{
+  const gchar *model;
+  const Babl  *type;
+  gint         n, i;
+
+  if (! format                      ||
+      ! babl_format_has_alpha (format) ||
+      babl_format_is_palette (format))
+    return FALSE;
+
+  model = babl_get_name (babl_format_get_model (format));
+
+  /*  only the models whose alpha is the last component  */
+  if (strcmp (model, "RGBA")     && strcmp (model, "R'G'B'A") &&
+      strcmp (model, "R~G~B~A")  && strcmp (model, "YA")      &&
+      strcmp (model, "Y'A")      && strcmp (model, "Y~A"))
+    return FALSE;
+
+  n    = babl_format_get_n_components (format);
+  type = babl_format_get_type (format, n - 1);
+
+  /*  same type for all the components (all the GIMP formats)  */
+  for (i = 0; i < n - 1; i++)
+    if (babl_format_get_type (format, i) != type)
+      return FALSE;
+
+  if      (type == babl_type ("u8"))     layout->kind = ALPHA_U8;
+  else if (type == babl_type ("u16"))    layout->kind = ALPHA_U16;
+  else if (type == babl_type ("u32"))    layout->kind = ALPHA_U32;
+  else if (type == babl_type ("half"))   layout->kind = ALPHA_HALF;
+  else if (type == babl_type ("float"))  layout->kind = ALPHA_FLOAT;
+  else if (type == babl_type ("double")) layout->kind = ALPHA_DOUBLE;
+  else
+    return FALSE;
+
+  layout->format = format;
+  layout->bpp    = babl_format_get_bytes_per_pixel (format);
+  layout->size   = layout->bpp / n;
+  layout->offset = layout->bpp - layout->size;
+  layout->type   = type;
+
+  return layout->size * n == layout->bpp;
+}
+
+/*  TRUE when the alpha at @p (pointing to the alpha component) is not 0.
+ *  « Not 0 » is never stricter than the old « A u8 » test (which rounded
+ *  tiny alphas of the high precisions to 0): the bounds can only be equal
+ *  or, for such tiny alphas, larger, never cut visible pixels.
+ */
+static inline gboolean
+chopgimp_alpha_nonzero (const guchar *p,
+                        AlphaKind     kind)
+{
+  switch (kind)
+    {
+    case ALPHA_U8:
+      return p[0] != 0;
+
+    case ALPHA_U16:
+      {
+        guint16 v;
+        memcpy (&v, p, sizeof (v));
+        return v != 0;
+      }
+
+    case ALPHA_U32:
+      {
+        guint32 v;
+        memcpy (&v, p, sizeof (v));
+        return v != 0;
+      }
+
+    case ALPHA_HALF:
+      {
+        guint16 v;
+        memcpy (&v, p, sizeof (v));
+        /*  positive and not ±0 (sign bit clear, some other bit set)  */
+        return (v & 0x7fff) != 0 && ! (v & 0x8000);
+      }
+
+    case ALPHA_FLOAT:
+      {
+        gfloat v;
+        memcpy (&v, p, sizeof (v));
+        return v > 0.0f;
+      }
+
+    case ALPHA_DOUBLE:
+      {
+        gdouble v;
+        memcpy (&v, p, sizeof (v));
+        return v > 0.0;
+      }
+    }
+
+  return FALSE;
+}
+
+#define BOUNDS_PIXELS_PER_THREAD (/* each thread costs as much as */ 64.0 * 64.0 /* pixels */)
+
+typedef struct
+{
+  GeglBuffer  *buffer;
+  AlphaLayout  layout;
+  GMutex       lock;
+  gint         x1, y1, x2, y2;  /* union of the threads' results, inclusive */
+} BoundsData;
+
+static void
+chopgimp_alpha_bounds_area (const GeglRectangle *area,
+                            BoundsData          *data)
+{
+  const AlphaLayout  *l    = &data->layout;
+  GeglBufferIterator *iter;
+  gint                x1 = G_MAXINT, y1 = G_MAXINT;
+  gint                x2 = G_MININT, y2 = G_MININT;
+
+  iter = gegl_buffer_iterator_new (data->buffer, area, 0, l->format,
+                                   GEGL_ACCESS_READ, GEGL_ABYSS_NONE, 1);
+
+  while (gegl_buffer_iterator_next (iter))
+    {
+      const guchar        *pixels = iter->items[0].data;
+      const GeglRectangle *roi    = &iter->items[0].roi;
+      gint                 row, col;
+
+      /*  a chunk already inside the bounds found so far adds nothing  */
+      if (roi->x >= x1 && roi->y >= y1 &&
+          roi->x + roi->width <= x2 + 1 && roi->y + roi->height <= y2 + 1)
+        continue;
+
+      for (row = 0; row < roi->height; row++)
+        {
+          const guchar *p = pixels + ((gsize) row * roi->width) * l->bpp + l->offset;
+          gint          first = -1, last = -1;
+
+          for (col = 0; col < roi->width; col++)
+            if (chopgimp_alpha_nonzero (p + (gsize) col * l->bpp, l->kind))
+              {
+                first = col;
+                break;
+              }
+
+          if (first < 0)
+            continue;
+
+          for (col = roi->width - 1; col >= first; col--)
+            if (chopgimp_alpha_nonzero (p + (gsize) col * l->bpp, l->kind))
+              {
+                last = col;
+                break;
+              }
+
+          x1 = MIN (x1, roi->x + first);
+          x2 = MAX (x2, roi->x + last);
+          y1 = MIN (y1, roi->y + row);
+          y2 = MAX (y2, roi->y + row);
+        }
+    }
+
+  if (x1 <= x2 && y1 <= y2)
+    {
+      g_mutex_lock (&data->lock);
+      data->x1 = MIN (data->x1, x1);
+      data->y1 = MIN (data->y1, y1);
+      data->x2 = MAX (data->x2, x2);
+      data->y2 = MAX (data->y2, y2);
+      g_mutex_unlock (&data->lock);
+    }
+}
+
+/*  the original scan, through a conversion to « A u8 » (other formats)  */
+static void
+chopgimp_alpha_bounds_convert (GeglBuffer *buffer,
+                               gint        w,
+                               gint        h,
+                               gint       *rx1,
+                               gint       *ry1,
+                               gint       *rx2,
+                               gint       *ry2)
+{
+  GeglBufferIterator *iter;
+  gint                x1 = G_MAXINT, y1 = G_MAXINT;
+  gint                x2 = G_MININT, y2 = G_MININT;
+
+  iter = gegl_buffer_iterator_new (buffer, GEGL_RECTANGLE (0, 0, w, h), 0,
+                                   babl_format ("A u8"),
+                                   GEGL_ACCESS_READ, GEGL_ABYSS_NONE, 1);
+
+  while (gegl_buffer_iterator_next (iter))
+    {
+      const guchar        *data = iter->items[0].data;
+      const GeglRectangle *roi  = &iter->items[0].roi;
+      gint                 row, col;
+
+      if (roi->x >= x1 && roi->y >= y1 &&
+          roi->x + roi->width <= x2 + 1 && roi->y + roi->height <= y2 + 1)
+        continue;
+
+      for (row = 0; row < roi->height; row++)
+        {
+          const guchar *p = data + row * roi->width;
+          gint          first = -1, last = -1;
+
+          for (col = 0; col < roi->width; col++)
+            if (p[col])
+              {
+                first = col;
+                break;
+              }
+
+          if (first < 0)
+            continue;
+
+          for (col = roi->width - 1; col >= first; col--)
+            if (p[col])
+              {
+                last = col;
+                break;
+              }
+
+          x1 = MIN (x1, roi->x + first);
+          x2 = MAX (x2, roi->x + last);
+          y1 = MIN (y1, roi->y + row);
+          y2 = MAX (y2, roi->y + row);
+        }
+    }
+
+  *rx1 = x1; *ry1 = y1; *rx2 = x2; *ry2 = y2;
+}
+
+GimpAutoShrink
+chopgimp_alpha_bounds (GimpDrawable *drawable,
+                       gint         *x,
+                       gint         *y,
+                       gint         *width,
+                       gint         *height)
+{
+  GeglBuffer *buffer;
+  BoundsData  data;
+  gint        w, h;
+  gint        x1, y1, x2, y2;
+
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), GIMP_AUTO_SHRINK_UNSHRINKABLE);
+
+  w = gimp_item_get_width  (GIMP_ITEM (drawable));
+  h = gimp_item_get_height (GIMP_ITEM (drawable));
+
+  *x = 0; *y = 0; *width = w; *height = h;
+
+  if (! gimp_drawable_has_alpha (drawable))
+    return GIMP_AUTO_SHRINK_UNSHRINKABLE;
+
+  buffer = gimp_drawable_get_buffer (drawable);
+
+  if (chopgimp_alpha_layout (gegl_buffer_get_format (buffer), &data.layout))
+    {
+      data.buffer = buffer;
+      data.x1 = G_MAXINT; data.y1 = G_MAXINT;
+      data.x2 = G_MININT; data.y2 = G_MININT;
+      g_mutex_init (&data.lock);
+
+      gegl_parallel_distribute_area (GEGL_RECTANGLE (0, 0, w, h),
+                                     BOUNDS_PIXELS_PER_THREAD,
+                                     GEGL_SPLIT_STRATEGY_AUTO,
+                                     (GeglParallelDistributeAreaFunc)
+                                       chopgimp_alpha_bounds_area,
+                                     &data);
+
+      g_mutex_clear (&data.lock);
+
+      x1 = data.x1; y1 = data.y1; x2 = data.x2; y2 = data.y2;
+    }
+  else
+    {
+      chopgimp_alpha_bounds_convert (buffer, w, h, &x1, &y1, &x2, &y2);
+    }
+
+  if (x1 > x2 || y1 > y2)
+    return GIMP_AUTO_SHRINK_EMPTY;
+
+  *x      = x1;
+  *y      = y1;
+  *width  = x2 - x1 + 1;
+  *height = y2 - y1 + 1;
+
+  if (*width == w && *height == h)
+    return GIMP_AUTO_SHRINK_UNSHRINKABLE;
+
+  return GIMP_AUTO_SHRINK_SHRINK;
+}
+
+
+/*  ChopGimp 3.25.1: cached bounds, for the transform controls of the Move
+ *  tool, recomputed on every undo step (hiding a layer, Ctrl+click on a
+ *  thumbnail, Select > None…) although the pixels had not changed.  The
+ *  cache lives on the GeglBuffer and is dropped by its « changed » signal
+ *  (every write: painting, filters, undo, gegl_buffer_copy()…); a new
+ *  buffer (resize, scale, undo of those) starts without cache.
+ */
+typedef struct
+{
+  gint           dirty;   /* atomic: set by any write to the buffer */
+  gint           w, h;
+  GimpAutoShrink result;
+  gint           x, y, width, height;
+} BoundsCache;
+
+static GQuark bounds_cache_quark = 0;
+
+static void
+chopgimp_alpha_bounds_buffer_changed (GeglBuffer          *buffer,
+                                      const GeglRectangle *rect,
+                                      BoundsCache         *cache)
+{
+  /*  may be called from any thread  */
+  g_atomic_int_set (&cache->dirty, 1);
+}
+
+GimpAutoShrink
+chopgimp_alpha_bounds_cached (GimpDrawable *drawable,
+                              gint         *x,
+                              gint         *y,
+                              gint         *width,
+                              gint         *height)
+{
+  GeglBuffer  *buffer;
+  BoundsCache *cache;
+  gint         w, h;
+
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), GIMP_AUTO_SHRINK_UNSHRINKABLE);
+
+  if (! bounds_cache_quark)
+    bounds_cache_quark = g_quark_from_static_string ("chopgimp-alpha-bounds-cache");
+
+  w      = gimp_item_get_width  (GIMP_ITEM (drawable));
+  h      = gimp_item_get_height (GIMP_ITEM (drawable));
+  buffer = gimp_drawable_get_buffer (drawable);
+  cache  = g_object_get_qdata (G_OBJECT (buffer), bounds_cache_quark);
+
+  if (! cache)
+    {
+      cache = g_new0 (BoundsCache, 1);
+      cache->dirty = 1;
+      g_object_set_qdata_full (G_OBJECT (buffer), bounds_cache_quark,
+                               cache, g_free);
+      gegl_buffer_signal_connect (buffer, "changed",
+                                  G_CALLBACK (chopgimp_alpha_bounds_buffer_changed),
+                                  cache);
+    }
+
+  /*  clear the flag before scanning: a write during the scan sets it
+   *  again and the next call scans again
+   */
+  if (g_atomic_int_compare_and_exchange (&cache->dirty, 1, 0) ||
+      cache->w != w || cache->h != h)
+    {
+      cache->w      = w;
+      cache->h      = h;
+      cache->result = chopgimp_alpha_bounds (drawable,
+                                             &cache->x, &cache->y,
+                                             &cache->width, &cache->height);
+    }
+
+  *x      = cache->x;
+  *y      = cache->y;
+  *width  = cache->width;
+  *height = cache->height;
+
+  return cache->result;
+}
+
+
+/*  ChopGimp 3.25.1: alpha of @src copied into @dest, whose format must be
+ *  the « A <type> » of the alpha of @src (gimp_channel_new_from_alpha():
+ *  Alpha to Selection, Ctrl+click on a thumbnail).  Plain byte copy of
+ *  the last component, in parallel; replaces a gegl_buffer_copy() through
+ *  babl's reference conversion, whose global mutex made all the GEGL
+ *  threads (and the interface) wait on each other (~1 s on a big layer).
+ *  Returns FALSE, doing nothing, for any other pair of formats.
+ */
+typedef struct
+{
+  GeglBuffer  *src;
+  GeglBuffer  *dest;
+  const Babl  *dest_format;
+  AlphaLayout  layout;
+} ExtractData;
+
+static void
+chopgimp_alpha_extract_area (const GeglRectangle *area,
+                             ExtractData         *data)
+{
+  const AlphaLayout  *l = &data->layout;
+  GeglBufferIterator *iter;
+
+  iter = gegl_buffer_iterator_new (data->dest, area, 0, data->dest_format,
+                                   GEGL_ACCESS_WRITE, GEGL_ABYSS_NONE, 2);
+  gegl_buffer_iterator_add (iter, data->src, area, 0, l->format,
+                            GEGL_ACCESS_READ, GEGL_ABYSS_NONE);
+
+  while (gegl_buffer_iterator_next (iter))
+    {
+      guchar       *d = iter->items[0].data;
+      const guchar *s = (const guchar *) iter->items[1].data + l->offset;
+      gint          n = iter->length;
+
+      if (l->size == 1)
+        {
+          while (n--)
+            {
+              *d++ = *s;
+              s += l->bpp;
+            }
+        }
+      else
+        {
+          while (n--)
+            {
+              memcpy (d, s, l->size);
+              d += l->size;
+              s += l->bpp;
+            }
+        }
+    }
+}
+
+gboolean
+chopgimp_alpha_extract (GeglBuffer *src,
+                        GeglBuffer *dest)
+{
+  ExtractData data;
+
+  g_return_val_if_fail (GEGL_IS_BUFFER (src), FALSE);
+  g_return_val_if_fail (GEGL_IS_BUFFER (dest), FALSE);
+
+  if (! chopgimp_alpha_layout (gegl_buffer_get_format (src), &data.layout))
+    return FALSE;
+
+  data.dest_format = gegl_buffer_get_format (dest);
+
+  if (babl_format_get_n_components (data.dest_format)    != 1                   ||
+      babl_format_get_type (data.dest_format, 0)         != data.layout.type    ||
+      babl_format_get_bytes_per_pixel (data.dest_format) != data.layout.size    ||
+      strcmp (babl_get_name (babl_format_get_model (data.dest_format)), "A")    ||
+      ! gegl_rectangle_equal (gegl_buffer_get_extent (src),
+                              gegl_buffer_get_extent (dest)))
+    return FALSE;
+
+  data.src  = src;
+  data.dest = dest;
+
+  gegl_parallel_distribute_area (gegl_buffer_get_extent (src),
+                                 BOUNDS_PIXELS_PER_THREAD,
+                                 GEGL_SPLIT_STRATEGY_AUTO,
+                                 (GeglParallelDistributeAreaFunc)
+                                   chopgimp_alpha_extract_area,
+                                 &data);
+
+  return TRUE;
+}
+
+
+GimpAutoShrink
+chopgimp_alpha_bounds_fast (GimpDrawable *drawable,
+                            gint          max_side,
+                            gint         *x,
+                            gint         *y,
+                            gint         *width,
+                            gint         *height)
+{
+  GeglBuffer *buffer;
+  gfloat     *data;
+  gdouble     scale;
+  gint        w, h, sw, sh, row, col;
+  gint        x1 = G_MAXINT, y1 = G_MAXINT;
+  gint        x2 = G_MININT, y2 = G_MININT;
+
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), GIMP_AUTO_SHRINK_UNSHRINKABLE);
+
+  w = gimp_item_get_width  (GIMP_ITEM (drawable));
+  h = gimp_item_get_height (GIMP_ITEM (drawable));
+
+  if (MAX (w, h) <= max_side || max_side <= 0)
+    return chopgimp_alpha_bounds (drawable, x, y, width, height);
+
+  *x = 0; *y = 0; *width = w; *height = h;
+
+  if (! gimp_drawable_has_alpha (drawable))
+    return GIMP_AUTO_SHRINK_UNSHRINKABLE;
+
+  scale = (gdouble) max_side / MAX (w, h);
+  sw    = MAX (1, (gint) ceil (w * scale));
+  sh    = MAX (1, (gint) ceil (h * scale));
+
+  /*  « A float » : a block holding only a few faint pixels keeps a
+   *  non-zero average (with « A u8 » it could round down to 0)
+   */
+  buffer = gimp_drawable_get_buffer (drawable);
+  data   = g_try_new (gfloat, (gsize) sw * sh);
+
+  if (! data)
+    return chopgimp_alpha_bounds (drawable, x, y, width, height);
+
+  gegl_buffer_get (buffer, GEGL_RECTANGLE (0, 0, sw, sh), scale,
+                   babl_format ("A float"), data,
+                   GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+
+  for (row = 0; row < sh; row++)
+    {
+      const gfloat *p = data + (gsize) row * sw;
+
+      for (col = 0; col < sw; col++)
+        if (p[col] > 0.0f)
+          {
+            x1 = MIN (x1, col);
+            x2 = MAX (x2, col);
+            y1 = MIN (y1, row);
+            y2 = MAX (y2, row);
+          }
+    }
+
+  g_free (data);
+
+  if (x1 > x2 || y1 > y2)
+    return GIMP_AUTO_SHRINK_EMPTY;
+
+  /*  back to full resolution, one sample of margin on each side  */
+  x1 = MAX (0, (gint) floor ((x1 - 1) / scale));
+  y1 = MAX (0, (gint) floor ((y1 - 1) / scale));
+  x2 = MIN (w - 1, (gint) ceil ((x2 + 2) / scale));
+  y2 = MIN (h - 1, (gint) ceil ((y2 + 2) / scale));
+
+  *x      = x1;
+  *y      = y1;
+  *width  = x2 - x1 + 1;
+  *height = y2 - y1 + 1;
+
+  if (*width == w && *height == h)
+    return GIMP_AUTO_SHRINK_UNSHRINKABLE;
+
+  return GIMP_AUTO_SHRINK_SHRINK;
+}
