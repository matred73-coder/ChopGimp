+
+/*  gradients and patterns, chosen with GIMP's choosers  */
+
+static gchar *
+layer_style_gradient_to_string (GimpGradient *gradient,
+                                GimpContext  *user_context,
+                                StoreKind     kind)
+{
+  GimpGradient *flat;
+  gchar        *string = NULL;
+
+  /*  the colors of the foreground / background segments are stored  */
+  if (gimp_gradient_has_fg_bg_segments (gradient))
+    flat = gimp_gradient_flatten (gradient, user_context);
+  else
+    flat = g_object_ref (gradient);
+
+  if (kind == STORE_GRADIENT_GGR)
+    {
+      GOutputStream *output = g_memory_output_stream_new_resizable ();
+
+      if (gimp_gradient_save (GIMP_DATA (flat), output, NULL))
+        {
+          gchar nul = '\0';
+
+          g_output_stream_write_all (output, &nul, 1, NULL, NULL, NULL);
+          g_output_stream_close (output, NULL, NULL);
+
+          string = g_memory_output_stream_steal_data (G_MEMORY_OUTPUT_STREAM (output));
+        }
+
+      g_object_unref (output);
+    }
+  else
+    {
+      GimpGradientSegment *seg = NULL;
+      GString             *str = g_string_new (NULL);
+      const Babl          *format = babl_format ("RGBA float");
+      gint                 i;
+
+      for (i = 0; i < GLOW_GRADIENT_SAMPLES; i++)
+        {
+          gdouble    pos   = (gdouble) i / (GLOW_GRADIENT_SAMPLES - 1);
+          GeglColor *color = NULL;
+          gfloat     rgba[4];
+          gchar      buf[G_ASCII_DTOSTR_BUF_SIZE];
+          gint       c;
+
+          seg = gimp_gradient_get_color_at (flat, NULL, seg, pos, FALSE,
+                                            GIMP_GRADIENT_BLEND_RGB_PERCEPTUAL,
+                                            &color);
+          gegl_color_get_pixel (color, format, rgba);
+          g_object_unref (color);
+
+          if (i > 0)
+            g_string_append_c (str, ';');
+
+          g_string_append (str,
+                           g_ascii_formatd (buf, sizeof (buf), "%.4f", pos));
+
+          for (c = 0; c < 4; c++)
+            {
+              g_string_append_c (str, ' ');
+              g_string_append (str,
+                               g_ascii_formatd (buf, sizeof (buf), "%.5f",
+                                                rgba[c]));
+            }
+        }
+
+      string = g_string_free (str, FALSE);
+    }
+
+  g_object_unref (flat);
+
+  return string;
+}
+
+static gchar *
+layer_style_pattern_to_string (GimpPattern *pattern)
+{
+  GOutputStream *memory;
+  GOutputStream *output;
+  GConverter    *compressor;
+  gchar         *string = NULL;
+
+  memory     = g_memory_output_stream_new_resizable ();
+  compressor = G_CONVERTER (g_zlib_compressor_new (G_ZLIB_COMPRESSOR_FORMAT_ZLIB, -1));
+  output     = g_converter_output_stream_new (memory, compressor);
+
+  if (gimp_pattern_save (GIMP_DATA (pattern), output, NULL) &&
+      g_output_stream_close (output, NULL, NULL))
+    {
+      GMemoryOutputStream *mem = G_MEMORY_OUTPUT_STREAM (memory);
+
+      string = g_base64_encode (g_memory_output_stream_get_data (mem),
+                                g_memory_output_stream_get_data_size (mem));
+    }
+
+  g_object_unref (output);
+  g_object_unref (compressor);
+  g_object_unref (memory);
+
+  return string;
+}
+
+/*  the name of the pattern stored by layer_style_pattern_to_string()  */
+static gchar *
+layer_style_pattern_name (const gchar *data)
+{
+  GInputStream *memory;
+  GInputStream *input;
+  GConverter   *decompressor;
+  guchar       *bytes;
+  gsize         n_bytes;
+  guint32       header[6];
+  gsize         n_read = 0;
+  gchar        *name   = NULL;
+
+  if (! data || ! *data)
+    return NULL;
+
+  bytes = g_base64_decode (data, &n_bytes);
+
+  if (! bytes || n_bytes == 0)
+    {
+      g_free (bytes);
+      return NULL;
+    }
+
+  memory       = g_memory_input_stream_new_from_data (bytes, n_bytes, g_free);
+  decompressor = G_CONVERTER (g_zlib_decompressor_new (G_ZLIB_COMPRESSOR_FORMAT_ZLIB));
+  input        = g_converter_input_stream_new (memory, decompressor);
+
+  /*  GimpPatternHeader: header_size, version, width, height, bytes,
+   *  magic, then the name (header_size - 24 bytes, NUL-terminated)
+   */
+  if (g_input_stream_read_all (input, header, sizeof (header),
+                               &n_read, NULL, NULL) &&
+      n_read == sizeof (header))
+    {
+      gsize size = g_ntohl (header[0]);
+
+      if (size > sizeof (header) && size < sizeof (header) + 1024)
+        {
+          gsize  name_size = size - sizeof (header);
+          gchar *buf       = g_malloc0 (name_size + 1);
+
+          if (g_input_stream_read_all (input, buf, name_size,
+                                       &n_read, NULL, NULL) &&
+              n_read == name_size)
+            name = buf;
+          else
+            g_free (buf);
+        }
+    }
+
+  g_object_unref (input);
+  g_object_unref (decompressor);
+  g_object_unref (memory);
+
+  return name;
+}
+
+static void
+resource_box_store (ResourceBox *rb)
+{
+  gchar *string = NULL;
+
+  if (rb->kind == STORE_PATTERN)
+    {
+      GimpPattern *pattern = gimp_context_get_pattern (rb->context);
+
+      if (pattern)
+        string = layer_style_pattern_to_string (pattern);
+    }
+  else
+    {
+      GimpGradient *gradient = gimp_context_get_gradient (rb->context);
+
+      if (gradient)
+        string = layer_style_gradient_to_string (gradient, rb->user_context,
+                                                 rb->kind);
+    }
+
+  if (string)
+    g_object_set (rb->config, rb->property, string, NULL);
+
+  g_free (string);
+}
+
+static void
+resource_box_changed (GimpContext *context,
+                      GimpObject  *resource,
+                      ResourceBox *rb)
+{
+  resource_box_store (rb);
+}
+
+/*  a resource is needed (its fill type or source is chosen) but none is
+ *  stored yet: store the chooser's
+ */
+static void
+resource_box_config_notify (GObject          *config,
+                            const GParamSpec *pspec,
+                            ResourceBox      *rb)
+{
+  GValue  value  = G_VALUE_INIT;
+  gint    active = FALSE;
+  gchar  *string = NULL;
+
+  if (! pspec || strcmp (pspec->name, rb->active_prop))
+    return;
+
+  g_value_init (&value, pspec->value_type);
+  g_object_get_property (config, rb->active_prop, &value);
+
+  if (G_VALUE_HOLDS_BOOLEAN (&value))
+    active = g_value_get_boolean (&value) == rb->active_value;
+  else if (G_VALUE_HOLDS_ENUM (&value))
+    active = g_value_get_enum (&value) == rb->active_value;
+
+  g_value_unset (&value);
+
+  if (! active)
+    return;
+
+  g_object_get (config, rb->property, &string, NULL);
+
+  if (! string || ! *string)
+    resource_box_store (rb);
+
+  g_free (string);
+}
+
+static void
+resource_box_free (ResourceBox *rb)
+{
+  g_signal_handlers_disconnect_by_data (rb->config, rb);
+  g_signal_handlers_disconnect_by_data (rb->context, rb);
+
+  g_object_unref (rb->context);
+  g_slice_free (ResourceBox, rb);
+}
+
+/*  GIMP's gradient or pattern chooser, storing the chosen one in the
+ *  config's property; active_prop == active_value is when the resource
+ *  is used
+ */
+static GtkWidget *
+layer_style_resource_box (GObject     *config,
+                          const gchar *property,
+                          StoreKind    kind,
+                          GimpContext *context,
+                          const gchar *active_prop,
+                          gint         active_value)
+{
+  ResourceBox   *rb;
+  GtkWidget     *box;
+  GimpContainer *container;
+  gchar         *string = NULL;
+  gchar         *name   = NULL;
+
+  rb = g_slice_new0 (ResourceBox);
+
+  rb->config       = config;
+  rb->property     = property;
+  rb->kind         = kind;
+  rb->user_context = context;
+  rb->context      = gimp_context_new (context->gimp, "chopgimp-layer-style",
+                                       context);
+  rb->active_prop  = active_prop;
+  rb->active_value = active_value;
+
+  /*  show the stored resource, if it is still there  */
+  g_object_get (config, property, &string, NULL);
+
+  if (kind == STORE_PATTERN)
+    {
+      container = gimp_data_factory_get_container (context->gimp->pattern_factory);
+      name      = layer_style_pattern_name (string);
+    }
+  else
+    {
+      container = gimp_data_factory_get_container (context->gimp->gradient_factory);
+
+      if (kind == STORE_GRADIENT_GGR && string)
+        {
+          const gchar *line = strstr (string, "\nName: ");
+
+          if (line)
+            {
+              const gchar *end;
+
+              line += strlen ("\nName: ");
+              end   = strchr (line, '\n');
+
+              name = end ? g_strndup (line, end - line) : g_strdup (line);
+            }
+        }
+    }
+
+  if (name)
+    {
+      GimpObject *resource = gimp_container_get_child_by_name (container,
+                                                                name);
+
+      if (resource && kind == STORE_PATTERN)
+        gimp_context_set_pattern (rb->context, GIMP_PATTERN (resource));
+      else if (resource)
+        gimp_context_set_gradient (rb->context, GIMP_GRADIENT (resource));
+    }
+
+  if (kind == STORE_PATTERN)
+    {
+      box = gimp_pattern_box_new (container, rb->context, NULL, 4);
+
+      g_signal_connect (rb->context, "pattern-changed",
+                        G_CALLBACK (resource_box_changed),
+                        rb);
+    }
+  else
+    {
+      box = gimp_gradient_box_new (container, rb->context, NULL, 4,
+                                   NULL, NULL);
+
+      g_signal_connect (rb->context, "gradient-changed",
+                        G_CALLBACK (resource_box_changed),
+                        rb);
+    }
+
+  g_signal_connect (config, "notify",
+                    G_CALLBACK (resource_box_config_notify),
+                    rb);
+
+  g_object_set_data_full (G_OBJECT (box), "chopgimp-resource-box", rb,
+                          (GDestroyNotify) resource_box_free);
+
+  /*  the resource is in use already, but none was stored  */
+  resource_box_config_notify (config,
+                              g_object_class_find_property (G_OBJECT_GET_CLASS (config),
+                                                            active_prop),
+                              rb);
+
+  g_free (string);
+  g_free (name);
+
+  return box;
+}
