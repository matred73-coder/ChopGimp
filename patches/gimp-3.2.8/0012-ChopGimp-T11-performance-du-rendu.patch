+/*  renders the effects of the drawable by chunks, at the viewable idle
+ *  priority, before the histogram copies the buffer (otherwise the
+ *  copy renders them all at once, in the main thread)
+ */
+typedef struct
+{
+  GeglBuffer        *buffer;
+  GeglRectangle      rect;
+  GimpChunkIterator *iter;
+} HistogramPrepare;
+
+static void
+histogram_prepare_free (HistogramPrepare *prep)
+{
+  if (prep->iter)
+    gimp_chunk_iterator_stop (prep->iter, TRUE);
+
+  g_object_unref (prep->buffer);
+
+  g_slice_free (HistogramPrepare, prep);
+}
+
+static void
+histogram_prepare_func (GimpAsync        *async,
+                        HistogramPrepare *prep)
+{
+  GimpTileHandlerValidate *validate;
+  GeglBuffer              *buffer;
+
+  validate = gimp_tile_handler_validate_get_assigned (prep->buffer);
+
+  if (validate)
+    {
+      if (! prep->iter)
+        {
+          cairo_region_t *region = cairo_region_copy (validate->dirty_region);
+
+          cairo_region_intersect_rectangle (
+            region, (const cairo_rectangle_int_t *) &prep->rect);
+
+          if (cairo_region_is_empty (region))
+            cairo_region_destroy (region);
+          else
+            prep->iter = gimp_chunk_iterator_new (region);
+        }
+
+      if (prep->iter)
+        {
+          if (gimp_chunk_iterator_next (prep->iter))
+            {
+              GeglRectangle rect;
+
+              gimp_tile_handler_validate_begin_validate (validate);
+
+              while (gimp_chunk_iterator_get_rect (prep->iter, &rect))
+                {
+                  gimp_tile_handler_validate_validate (validate,
+                                                       prep->buffer, &rect,
+                                                       FALSE, FALSE);
+                }
+
+              gimp_tile_handler_validate_end_validate (validate);
+
+              return;
+            }
+
+          prep->iter = NULL;
+        }
+    }
+
+  buffer = g_object_ref (prep->buffer);
+
+  histogram_prepare_free (prep);
+
+  gimp_async_finish_full (async, buffer, g_object_unref);
+}
+
+static void
+gimp_histogram_editor_prepare_callback (GimpAsync           *async,
+                                        GimpHistogramEditor *editor)
+{
+  if (editor->prepare_async != async)
+    return;
+
+  editor->prepare_async = NULL;
+
+  if (gimp_async_is_finished (async) &&
+      editor->drawable && editor->histogram &&
+      gimp_item_is_attached (GIMP_ITEM (editor->drawable)))
+    {
+      gimp_histogram_editor_calculate_buffer (editor,
+                                              gimp_async_get_result (async));
+    }
+  else
+    {
+      editor->bg_pending = FALSE;
+
+      if (editor->update_pending)
+        gimp_histogram_editor_update (editor);
+      else if (editor->recompute)
+        gtk_widget_queue_draw (GTK_WIDGET (editor->box));
+    }
+}
