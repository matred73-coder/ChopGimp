+/*  a quick histogram on a reduced sample of the drawable: its mipmap, or
+ *  the reduced copy of its effects kept for the layer thumbnails.
+ *  Returns FALSE if no cheap sample is available.
+ */
+static gboolean
+gimp_histogram_editor_sample (GimpHistogramEditor *editor)
+{
+  GimpDrawable  *drawable = editor->drawable;
+  GimpChannel   *mask;
+  GeglBuffer    *src;
+  GeglBuffer    *sample;
+  GeglBuffer    *mask_sample = NULL;
+  GimpTempBuf   *temp;
+  const Babl    *format;
+  GeglRectangle  rect;
+  gint           x, y, width, height;
+  gint           level = 0;
+  gint           k;
+  gint           f;
+
+  if (! gimp_item_mask_intersect (GIMP_ITEM (drawable),
+                                  &x, &y, &width, &height))
+    return FALSE;
+
+  if (gimp_drawable_has_visible_filters (drawable))
+    {
+      src = gimp_drawable_get_preview_effects_buffer (drawable, &level);
+
+      if (! src)
+        return FALSE;
+    }
+  else
+    {
+      src = g_object_ref (gimp_drawable_get_buffer (drawable));
+    }
+
+  for (k = level; (MAX (width, height) >> k) > SAMPLE_SIZE; k++);
+
+  /*  small enough: the exact histogram is cheap  */
+  if (k == 0)
+    {
+      g_object_unref (src);
+      return FALSE;
+    }
+
+  f = 1 << k;
+
+  rect.x      = x / f;
+  rect.y      = y / f;
+  rect.width  = MAX (1, (x + width  + f - 1) / f - rect.x);
+  rect.height = MAX (1, (y + height + f - 1) / f - rect.y);
+
+  format = gegl_buffer_get_format (src);
+
+  temp = gimp_temp_buf_new (rect.width, rect.height, format);
+  gegl_buffer_get (src, &rect, (gdouble) (1 << level) / f, format,
+                   gimp_temp_buf_get_data (temp),
+                   GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+  sample = gimp_temp_buf_create_buffer (temp);
+  gimp_temp_buf_unref (temp);
+
+  g_object_unref (src);
+
+  mask = gimp_image_get_mask (gimp_item_get_image (GIMP_ITEM (drawable)));
+
+  if (! gimp_channel_is_empty (mask))
+    {
+      const Babl *mask_format = babl_format ("Y float");
+      gint        off_x, off_y;
+
+      gimp_item_get_offset (GIMP_ITEM (drawable), &off_x, &off_y);
+
+      temp = gimp_temp_buf_new (rect.width, rect.height, mask_format);
+      gegl_buffer_get (gimp_drawable_get_buffer (GIMP_DRAWABLE (mask)),
+                       GEGL_RECTANGLE ((gint) floor ((gdouble) (rect.x * f + off_x) / f),
+                                       (gint) floor ((gdouble) (rect.y * f + off_y) / f),
+                                       rect.width, rect.height),
+                       1.0 / f, mask_format,
+                       gimp_temp_buf_get_data (temp),
+                       GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+      mask_sample = gimp_temp_buf_create_buffer (temp);
+      gimp_temp_buf_unref (temp);
+    }
+
+  gimp_histogram_calculate (editor->histogram, sample,
+                            GEGL_RECTANGLE (0, 0, rect.width, rect.height),
+                            mask_sample,
+                            mask_sample ?
+                            GEGL_RECTANGLE (0, 0, rect.width, rect.height) :
+                            NULL);
+
+  g_object_unref (sample);
+  g_clear_object (&mask_sample);
+
+  editor->sample_factor = ((gdouble) width * height /
+                           ((gdouble) rect.width * rect.height));
+
+  gimp_histogram_editor_info_update (editor);
+
+  return TRUE;
 }
 
