+{
+  gint64 now;
+
+  if (! proj->priv->fast_preview)
+    return FALSE;
+
+  now = g_get_monotonic_time ();
+
+  return (now - proj->priv->last_activity_time < CHOPGIMP_PROJECTION_ACTIVITY_TIME ||
+          now - proj->priv->last_update_time   < CHOPGIMP_PROJECTION_ACTIVITY_TIME);
+}
