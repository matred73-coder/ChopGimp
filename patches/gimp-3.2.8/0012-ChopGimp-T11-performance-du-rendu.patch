+
+#define STYLE_KEY   "chopgimp-layer-style"
+#define SESSION_KEY "chopgimp-layer-style-session"
+
+/*  set on the Gimp object by Calque > Style de calque > Options de
+ *  fusion… when the layer has no style: the window opens on an unchecked
+ *  Ombre portée (nothing is added unless an effect is checked)
+ */
+#define UNCHECKED_KEY "chopgimp-layer-style-unchecked"
+
+
+typedef struct
+{
+  GimpFilter *filter;
+  gboolean    active;
+} ActiveState;
+
+typedef struct
+{
+  GimpFilterTool           *filter_tool;
+  GimpDrawable             *drawable;
+
+  const ChopGimpLayerStyle *current;          /*  the edited effect      */
+  gboolean                  current_checked;  /*  its check box          */
+
+  gboolean                  validated;        /*  Valider was clicked    */
+  gboolean                  group_open;       /*  the session's undo group */
+  GimpUndo                 *group;
+
+  GList                    *actives;          /*  ActiveState at start   */
+
+  gboolean                  restore_merge;    /*  "merge-filter" was on  */
+
+  guint                     idle_id;
+  GimpDrawableFilter       *pending_filter;
+  const ChopGimpLayerStyle *pending_style;
+} LayerStyleSession;
+
+typedef struct
+{
+  GimpImage         *image;
+  GimpUndo          *group;
+  GList             *actives;
+  GimpFilterOptions *options;
+  gboolean           undo;
+  gboolean           restore_merge;
+} LayerStyleEnd;
+
+static void layer_style_group_interrupted (GimpImage *image,
+                                           gpointer   data);
+
+
+
+static void   layer_style_switch_later (LayerStyleSession        *session,
+                                        GimpDrawableFilter       *target,
+                                        const ChopGimpLayerStyle *style);
+
+
+/*  the preset holding the user's defaults of the style, or NULL  */
+static GimpSettings *
+layer_style_find_default (GimpFilterTool           *filter_tool,
+                          const ChopGimpLayerStyle *style)
+{
+  GimpSettings *found = NULL;
+  gchar        *name;
+  GList        *list;
+
+  if (! filter_tool->settings)
+    return NULL;
+
+  name = g_strdup_printf (CHOPGIMP_LAYER_STYLE_DEFAULT_NAME, style->label);
+
+  for (list = GIMP_LIST (filter_tool->settings)->queue->head;
+       list;
+       list = g_list_next (list))
+    {
+      GimpSettings *preset = list->data;
+
+      /*  a saved preset, not a "last used" one  */
+      if (preset->time == 0 &&
+          ! g_strcmp0 (gimp_object_get_name (preset), name))
+        {
+          found = preset;
+          break;
+        }
+    }
+
+  g_free (name);
+
+  return found;
+}
+
+static void
+layer_style_message (GimpFilterTool *filter_tool,
+                     const gchar    *message)
+{
+  GimpTool *tool = GIMP_TOOL (filter_tool);
+
+  if (tool->display)
+    gimp_tool_message_literal (tool, tool->display, message);
+}
+
+static void
+layer_style_set_default_clicked (GtkWidget      *button,
+                                 GimpFilterTool *filter_tool)
+{
+  const ChopGimpLayerStyle *style = g_object_get_data (G_OBJECT (button),
+                                                       STYLE_KEY);
+  GimpTool                 *tool  = GIMP_TOOL (filter_tool);
+  GimpSettings             *old;
+  GimpConfig               *preset;
+  gchar                    *name;
+  gchar                    *message;
+
+  if (! style || ! filter_tool->config || ! filter_tool->settings)
+    return;
+
+  old = layer_style_find_default (filter_tool, style);
+
+  if (old)
+    gimp_container_remove (filter_tool->settings, GIMP_OBJECT (old));
+
+  name = g_strdup_printf (CHOPGIMP_LAYER_STYLE_DEFAULT_NAME, style->label);
+
+  preset = gimp_config_duplicate (GIMP_CONFIG (filter_tool->config));
+
+  gimp_object_set_name (GIMP_OBJECT (preset), name);
+  g_object_set (preset,
+                "time", (gint64) 0,
+                NULL);
+
+  gimp_container_add (filter_tool->settings, GIMP_OBJECT (preset));
+  g_object_unref (preset);
+
+  gimp_operation_config_serialize (tool->tool_info->gimp,
+                                   filter_tool->settings, NULL);
+
+  message = g_strdup_printf ("Réglages enregistrés comme valeurs par défaut "
+                             "de « %s ».", style->label);
+  layer_style_message (filter_tool, message);
+
+  g_free (message);
+  g_free (name);
+}
+
+/*  the style's starting settings: the user's defaults, or the factory
+ *  settings
+ */
+static void
+layer_style_apply_default (GimpFilterTool           *filter_tool,
+                           const ChopGimpLayerStyle *style)
+{
+  GimpSettings *preset;
+
+  if (! style || ! filter_tool->config)
+    return;
+
+  preset = layer_style_find_default (filter_tool, style);
+
+  if (preset)
+    {
+      gimp_filter_tool_set_config (filter_tool, GIMP_CONFIG (preset));
+    }
+  else
+    {
+      /*  the style's factory settings  */
+      GimpConfig  *factory;
+      const gchar *settings = strchr (style->factory, '\n');
+
+      factory = g_object_new (G_TYPE_FROM_INSTANCE (filter_tool->config),
+                              NULL);
+
+      if (settings && settings[1])
+        {
+          GError *error = NULL;
+
+          if (! gimp_config_deserialize_string (factory, settings + 1, -1,
+                                                NULL, &error))
+            {
+              g_warning ("%s: %s", G_STRFUNC, error->message);
+              g_clear_error (&error);
+            }
+        }
+
+      gimp_filter_tool_set_config (filter_tool, factory);
+      g_object_unref (factory);
+    }
+}
+
+static void
+layer_style_reset_clicked (GtkWidget      *button,
+                           GimpFilterTool *filter_tool)
+{
+  const ChopGimpLayerStyle *style = g_object_get_data (G_OBJECT (button),
+                                                       STYLE_KEY);
+
+  layer_style_apply_default (filter_tool, style);
+}
+
+static gboolean
+layer_style_add_stroke_idle (gpointer data)
+{
+  Gimp    *gimp = data;
+  GAction *action;
+
+  action = g_action_map_lookup_action (G_ACTION_MAP (gimp->app),
+                                       "filters-chopgimp-stroke");
+
+  if (GIMP_IS_ACTION (action))
+    gimp_action_activate (GIMP_ACTION (action));
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+layer_style_add_stroke_clicked (GtkWidget      *button,
+                                GimpFilterTool *filter_tool)
+{
+  GimpTool          *tool    = GIMP_TOOL (filter_tool);
+  Gimp              *gimp    = tool->tool_info->gimp;
+  LayerStyleSession *session = g_object_get_data (G_OBJECT (filter_tool),
+                                                  SESSION_KEY);
+
+  if (! tool->display)
+    return;
+
+  /*  in the « Style de calque » window: a new stroke in the same window  */
+  if (session)
+    {
+      layer_style_switch_later (session, NULL,
+                                chopgimp_layer_style_find ("chopgimp:stroke",
+                                                           NULL));
+      return;
+    }
+
+  /*  as OK: the stroke is added to the layer (the dialog closes), then
+   *  a new one is opened, once the commit is done
+   */
+  gimp_tool_control (tool, GIMP_TOOL_ACTION_COMMIT, tool->display);
+
+  g_idle_add (layer_style_add_stroke_idle, gimp);
+}
+
+
+/*  « Style de calque » window: session  */
+
+static LayerStyleSession *
+layer_style_get_session (GimpFilterTool *filter_tool)
+{
+  return g_object_get_data (G_OBJECT (filter_tool), SESSION_KEY);
+}
+
+static void
+active_state_free (ActiveState *state)
+{
+  g_object_unref (state->filter);
+  g_free (state);
+}
+
+static void
+layer_style_session_free (LayerStyleSession *session)
+{
+  if (session->idle_id)
+    g_source_remove (session->idle_id);
+
+  g_clear_object (&session->pending_filter);
+  g_clear_weak_pointer (&session->group);
+  g_clear_object (&session->drawable);
+
+  /*  moved to the end of the session (LayerStyleEnd) by halt()  */
+  g_list_free_full (session->actives, (GDestroyNotify) active_state_free);
+  g_free (session);
+}
+
+/*  the style of the filter being edited, from its operation and its name  */
+static const ChopGimpLayerStyle *
+layer_style_get_current (GimpFilterTool *filter_tool)
+{
+  const ChopGimpLayerStyle *style;
+  const gchar              *name;
+  gchar                    *operation = NULL;
+
+  if (! filter_tool->operation)
+    return NULL;
+
+  gegl_node_get (filter_tool->operation,
+                 "operation", &operation,
+                 NULL);
+
+  if (filter_tool->existing_filter)
+    name = gimp_object_get_name (filter_tool->existing_filter);
+  else
+    name = gimp_tool_get_undo_desc (GIMP_TOOL (filter_tool));
+
+  style = chopgimp_layer_style_find (operation, name);
+
+  g_free (operation);
+
+  return style;
+}
+
+/*  the style of a filter of the layer, NULL if it is not a layer style  */
+static const ChopGimpLayerStyle *
+layer_style_of_filter (GimpDrawableFilter *filter)
+{
+  const ChopGimpLayerStyle *style;
+  GeglNode                 *node;
+  gchar                    *operation = NULL;
+
+  node = gimp_drawable_filter_get_operation (filter);
+
+  if (! node)
+    return NULL;
+
+  gegl_node_get (node,
+                 "operation", &operation,
+                 NULL);
+
+  style = chopgimp_layer_style_find (operation,
+                                     gimp_object_get_name (filter));
+
+  g_free (operation);
+
+  return style;
+}
+
+/*  the filters of the layer the window lists (not the one GIMP shows
+ *  while editing), from the bottom of the stack
+ */
+static GList *
+layer_style_get_filters (LayerStyleSession *session)
+{
+  GimpFilterTool *filter_tool = session->filter_tool;
+  GimpContainer  *filters;
+  GList          *result = NULL;
+  GList          *list;
+
+  filters = gimp_drawable_get_filters (session->drawable);
+
+  if (! filters)
+    return NULL;
+
+  for (list = GIMP_LIST (filters)->queue->head; list; list = g_list_next (list))
+    {
+      GimpDrawableFilter *filter = list->data;
+
+      if (! GIMP_IS_DRAWABLE_FILTER (filter)               ||
+          filter == filter_tool->filter                    ||
+          gimp_drawable_filter_get_temporary (filter))
+        continue;
+
+      result = g_list_prepend (result, filter);
+    }
+
+  return result;
+}
+
+/*  layer styles stay editable (Photoshop): « Appliquer directement au
+ *  calque » is off while the window adds an effect, the user's choice
+ *  comes back after it (layer_style_end_idle())
+ */
+static void
+layer_style_disable_merge (LayerStyleSession *session)
+{
+  GimpFilterOptions *options = GIMP_FILTER_TOOL_GET_OPTIONS (session->filter_tool);
+
+  if (options->merge_filter)
+    {
+      session->restore_merge = TRUE;
+
+      g_object_set (options,
+                    "merge-filter", FALSE,
+                    NULL);
+    }
+}
+
+static void
+layer_style_update_drawable (LayerStyleSession *session)
+{
+  gimp_drawable_update (session->drawable, 0, 0, -1, -1);
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (session->drawable)));
+}
+
+
+/*  switching to another effect  */
+
+static void
+layer_style_edit_config (GimpFilterTool     *filter_tool,
+                         GimpDrawableFilter *filter)
+{
+  GObject     *settings;
+  GeglNode    *node;
+  GParamSpec **pspecs;
+  guint        n_pspecs;
+  gchar       *operation = NULL;
+  gint         i;
+
+  /*  as gimpgeglprocedure.c does when editing a filter  */
+  node = gimp_drawable_filter_get_operation (filter);
+
+  gegl_node_get (node,
+                 "operation", &operation,
+                 NULL);
+
+  settings = g_object_new (G_TYPE_FROM_INSTANCE (filter_tool->config), NULL);
+
+  pspecs = gegl_operation_list_properties (operation, &n_pspecs);
+
+  for (i = 0; i < n_pspecs; i++)
+    {
+      GValue      value      = G_VALUE_INIT;
+      GParamSpec *pspec      = pspecs[i];
+      GParamSpec *gimp_pspec = g_object_class_find_property (G_OBJECT_GET_CLASS (settings),
+                                                             pspec->name);
+
+      if (! gimp_pspec)
+        continue;
+
+      g_value_init (&value, pspec->value_type);
+      gegl_node_get_property (node, pspec->name, &value);
+      g_object_set_property (settings, gimp_pspec->name, &value);
+      g_value_unset (&value);
+    }
+
+  g_free (pspecs);
+  g_free (operation);
+
+  g_object_set (settings,
+                "gimp-opacity", gimp_drawable_filter_get_opacity (filter),
+                "gimp-mode",    gimp_drawable_filter_get_paint_mode (filter),
+                "gimp-region",  gimp_drawable_filter_get_region (filter),
+                "gimp-clip",    gimp_drawable_filter_get_clip (filter),
+                NULL);
+
+  gimp_filter_tool_set_config (filter_tool, GIMP_CONFIG (settings));
+
+  g_object_unref (settings);
+}
+
+static void layer_style_update_gui (LayerStyleSession *session);
+
+/*  validates the edited effect without closing the window, then edits
+ *  @target (an effect of the layer) or a new effect of @style
+ */
+static void
+layer_style_switch (LayerStyleSession        *session,
+                    GimpDrawableFilter       *target,
+                    const ChopGimpLayerStyle *style)
+{
+  GimpFilterTool *filter_tool = session->filter_tool;
+  GimpTool       *tool        = GIMP_TOOL (filter_tool);
+  GimpImage      *image;
+  gchar          *operation   = NULL;
+  const gchar    *label;
+  const gchar    *icon_name;
+
+  if (! tool->display || ! filter_tool->filter || ! filter_tool->gui ||
+      ! GIMP_IS_OPERATION_TOOL (filter_tool))
+    return;
+
+  if (target)
+    {
+      GimpContainer *filters = gimp_drawable_get_filters (session->drawable);
+
+      if (! filters || ! gimp_container_have (filters, GIMP_OBJECT (target)) ||
+          target == filter_tool->existing_filter)
+        return;
+
+      gegl_node_get (gimp_drawable_filter_get_operation (target),
+                     "operation", &operation,
+                     NULL);
+
+      label     = gimp_object_get_name (target);
+      icon_name = gimp_viewable_get_icon_name (GIMP_VIEWABLE (target));
+      style     = layer_style_of_filter (target);
+    }
+  else if (style)
+    {
+      operation = g_strdup (style->operation);
+      label     = style->label;
+      icon_name = GIMP_ICON_GEGL;
+    }
+  else
+    {
+      return;
+    }
+
+  image = gimp_item_get_image (GIMP_ITEM (session->drawable));
+
+  /*  the tool must survive the undo steps and dirty signals  */
+  gimp_tool_control_push_preserve (tool->control, TRUE);
+
+  if (! session->group_open)
+    {
+      gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC,
+                                   "Style de calque");
+      session->group_open = TRUE;
+
+      g_set_weak_pointer (&session->group,
+                          gimp_undo_stack_peek (gimp_image_get_undo_stack (image)));
+
+      /*  3.28.2: an action on the image meanwhile closes the group first  */
+      chopgimp_image_undo_guard_set (image, layer_style_group_interrupted, session);
+    }
+
+  chopgimp_image_undo_guard_busy (image, TRUE);
+
+  /*  an effect added then unchecked is not added  */
+  if (filter_tool->existing_filter || session->current_checked)
+    gimp_filter_tool_commit_keep_dialog (filter_tool);
+
+  session->current         = style;
+  session->current_checked = TRUE;
+
+  if (! target)
+    layer_style_disable_merge (session);
+
+  gimp_operation_tool_set_operation (GIMP_OPERATION_TOOL (filter_tool),
+                                     target,
+                                     operation,
+                                     label, label, label,
+                                     icon_name,
+                                     GIMP_HELP_LAYER_EFFECTS);
+
+  if (filter_tool->config && filter_tool->filter)
+    {
+      if (target)
+        layer_style_edit_config (filter_tool, target);
+      else
+        layer_style_apply_default (filter_tool, style);
+    }
+
+  gimp_tool_control_pop_preserve (tool->control);
+
+  chopgimp_image_undo_guard_busy (image, FALSE);
+
+  g_free (operation);
+
+  layer_style_update_gui (session);
+}
+
+static gboolean
+layer_style_switch_idle (gpointer data)
+{
+  LayerStyleSession        *session = data;
+  GimpDrawableFilter       *target  = session->pending_filter;
+  const ChopGimpLayerStyle *style   = session->pending_style;
+
+  session->idle_id        = 0;
+  session->pending_filter = NULL;
+  session->pending_style  = NULL;
+
+  layer_style_switch (session, target, style);
+
+  g_clear_object (&target);
+
+  return G_SOURCE_REMOVE;
+}
+
+/*  from the widgets of the window, which the switch rebuilds  */
+static void
+layer_style_switch_later (LayerStyleSession        *session,
+                          GimpDrawableFilter       *target,
+                          const ChopGimpLayerStyle *style)
+{
+  if (! target && ! style)
+    return;
+
+  g_clear_object (&session->pending_filter);
+
+  if (target)
+    session->pending_filter = g_object_ref (target);
+
+  session->pending_style = style;
+
+  if (! session->idle_id)
+    session->idle_id = g_idle_add (layer_style_switch_idle, session);
+}
+
+
+/*  the effects column  */
+
+#define ROW_FILTER_KEY  "chopgimp-layer-style-filter"
+#define ROW_CURRENT_KEY "chopgimp-layer-style-current"
+
+static void
+layer_style_row_activated (GtkListBox        *list,
+                           GtkListBoxRow     *row,
+                           LayerStyleSession *session)
+{
+  const ChopGimpLayerStyle *style;
+  GimpDrawableFilter       *filter;
+
+  if (g_object_get_data (G_OBJECT (row), ROW_CURRENT_KEY))
+    return;
+
+  style  = g_object_get_data (G_OBJECT (row), STYLE_KEY);
+  filter = g_object_get_data (G_OBJECT (row), ROW_FILTER_KEY);
+
+  layer_style_switch_later (session, filter, style);
+}
+
+static void
+layer_style_check_toggled (GtkToggleButton   *check,
+                           LayerStyleSession *session)
+{
+  GimpFilterTool           *filter_tool = session->filter_tool;
+  GtkWidget                *row;
+  const ChopGimpLayerStyle *style;
+  GimpDrawableFilter       *filter;
+  gboolean                  active;
+
+  row    = gtk_widget_get_ancestor (GTK_WIDGET (check), GTK_TYPE_LIST_BOX_ROW);
+  active = gtk_toggle_button_get_active (check);
+
+  if (! row)
+    return;
+
+  style  = g_object_get_data (G_OBJECT (row), STYLE_KEY);
+  filter = g_object_get_data (G_OBJECT (row), ROW_FILTER_KEY);
+
+  if (g_object_get_data (G_OBJECT (row), ROW_CURRENT_KEY))
+    {
+      /*  the edited effect: its preview on or off, applied at the end  */
+      session->current_checked = active;
+
+      if (filter_tool->filter)
+        {
+          gimp_filter_set_active (GIMP_FILTER (filter_tool->filter), active);
+          layer_style_update_drawable (session);
+        }
+    }
+  else if (filter)
+    {
+      /*  Photoshop: unchecking an effect disables it  */
+      gimp_filter_set_active (GIMP_FILTER (filter), active);
+      layer_style_update_drawable (session);
+    }
+  else if (active)
+    {
+      /*  an absent effect: added with its default settings and edited  */
+      layer_style_switch_later (session, NULL, style);
+    }
+}
+
+static void
+layer_style_add_clicked (GtkWidget         *button,
+                         LayerStyleSession *session)
+{
+  layer_style_switch_later (session, NULL,
+                            g_object_get_data (G_OBJECT (button), STYLE_KEY));
+}
+
+static GtkWidget *
+layer_style_add_row (LayerStyleSession        *session,
+                     GtkWidget                *list,
+                     const ChopGimpLayerStyle *style,
+                     GimpDrawableFilter       *filter,
+                     gint                      index,
+                     gboolean                  current,
+                     gboolean                  checked,
+                     gboolean                  add_button)
+{
+  GtkWidget *row;
+  GtkWidget *hbox;
+  GtkWidget *check;
+  GtkWidget *label;
+  gchar     *text;
+
+  row = gtk_list_box_row_new ();
+  gtk_style_context_add_class (gtk_widget_get_style_context (row),
+                               "chopgimp-layer-style-row");
+  g_object_set_data (G_OBJECT (row), STYLE_KEY, (gpointer) style);
+
+  if (filter)
+    g_object_set_data_full (G_OBJECT (row), ROW_FILTER_KEY,
+                            g_object_ref (filter),
+                            (GDestroyNotify) g_object_unref);
+
+  if (current)
+    {
+      g_object_set_data (G_OBJECT (row), ROW_CURRENT_KEY, GINT_TO_POINTER (1));
+      gtk_style_context_add_class (gtk_widget_get_style_context (row),
+                                   "current");
+    }
+
+  gtk_container_add (GTK_CONTAINER (list), row);
+  gtk_widget_set_visible (row, TRUE);
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_container_add (GTK_CONTAINER (row), hbox);
+  gtk_widget_set_visible (hbox, TRUE);
+
+  check = gtk_check_button_new ();
+  gtk_widget_set_focus_on_click (check, FALSE);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (check), checked);
+  gtk_box_pack_start (GTK_BOX (hbox), check, FALSE, FALSE, 0);
+  gtk_widget_set_visible (check, TRUE);
+
+  gimp_help_set_help_data (check,
+                           filter || current ?
+                           "Activer ou désactiver cet effet" :
+                           "Ajouter cet effet au calque", NULL);
+
+  g_signal_connect (check, "toggled",
+                    G_CALLBACK (layer_style_check_toggled),
+                    session);
+
+  if (index > 0)
+    text = g_strdup_printf ("%s %d", style->label, index + 1);
+  else
+    text = g_strdup (style->label);
+
+  label = gtk_label_new (text);
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_END);
+  gtk_widget_set_hexpand (label, TRUE);
+  gtk_box_pack_start (GTK_BOX (hbox), label, TRUE, TRUE, 0);
+  gtk_widget_set_visible (label, TRUE);
+
+  if (current)
+    gimp_label_set_attributes (GTK_LABEL (label),
+                               PANGO_ATTR_WEIGHT, PANGO_WEIGHT_BOLD,
+                               -1);
+
+  g_free (text);
+
+  if (add_button)
+    {
+      GtkWidget *button;
+
+      button = gtk_button_new_from_icon_name (GIMP_ICON_LIST_ADD,
+                                              GTK_ICON_SIZE_MENU);
+      gtk_button_set_relief (GTK_BUTTON (button), GTK_RELIEF_NONE);
+      gtk_widget_set_focus_on_click (button, FALSE);
+      gtk_style_context_add_class (gtk_widget_get_style_context (button),
+                                   "chopgimp-layer-style-add");
+      g_object_set_data (G_OBJECT (button), STYLE_KEY, (gpointer) style);
+      gtk_box_pack_end (GTK_BOX (hbox), button, FALSE, FALSE, 0);
+      gtk_widget_set_visible (button, TRUE);
+
+      gimp_help_set_help_data (button,
+                               ! strcmp (style->operation, "chopgimp:stroke") ?
+                               "Ajouter un autre contour" :
+                               "Ajouter une autre ombre portée", NULL);
+
+      g_signal_connect (button, "clicked",
+                        G_CALLBACK (layer_style_add_clicked),
+                        session);
+    }
+
+  return row;
+}
+
+static void
+layer_style_update_gui (LayerStyleSession *session)
+{
+  GimpFilterTool *filter_tool = session->filter_tool;
+  GtkWidget      *side_box;
+  GtkWidget      *label;
+  GtkWidget      *scrolled;
+  GtkWidget      *list;
+  GtkWidget      *current_row = NULL;
+  GList          *filters;
+  gint            n;
+
+  if (! filter_tool->gui)
+    return;
+
+  side_box = gimp_tool_gui_get_side_box (filter_tool->gui);
+
+  if (! side_box)
+    return;
+
+  gimp_gtk_container_clear (GTK_CONTAINER (side_box));
+
+  label = gtk_label_new ("Styles");
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gimp_label_set_attributes (GTK_LABEL (label),
+                             PANGO_ATTR_WEIGHT, PANGO_WEIGHT_BOLD,
+                             -1);
+  gtk_style_context_add_class (gtk_widget_get_style_context (label),
+                               "chopgimp-layer-style-title");
+  gtk_box_pack_start (GTK_BOX (side_box), label, FALSE, FALSE, 0);
+  gtk_widget_set_visible (label, TRUE);
+
+  scrolled = gtk_scrolled_window_new (NULL, NULL);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled),
+                                  GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_scrolled_window_set_propagate_natural_height (GTK_SCROLLED_WINDOW (scrolled),
+                                                    TRUE);
+  gtk_scrolled_window_set_shadow_type (GTK_SCROLLED_WINDOW (scrolled),
+                                       GTK_SHADOW_IN);
+  gtk_box_pack_start (GTK_BOX (side_box), scrolled, TRUE, TRUE, 0);
+  gtk_widget_set_visible (scrolled, TRUE);
+
+  list = gtk_list_box_new ();
+  gtk_list_box_set_selection_mode (GTK_LIST_BOX (list), GTK_SELECTION_SINGLE);
+  gtk_list_box_set_activate_on_single_click (GTK_LIST_BOX (list), TRUE);
+  gtk_style_context_add_class (gtk_widget_get_style_context (list),
+                               "chopgimp-layer-style-list");
+  gtk_widget_set_size_request (list, 170, -1);
+  gtk_container_add (GTK_CONTAINER (scrolled), list);
+  gtk_widget_set_visible (list, TRUE);
+
+  filters = layer_style_get_filters (session);
+
+  for (n = 0; chopgimp_layer_style_nth (n); n++)
+    {
+      const ChopGimpLayerStyle *style = chopgimp_layer_style_nth (n);
+      gboolean                  multi;
+      gint                      index = 0;
+      GList                    *list2;
+      GtkWidget                *row;
+
+      multi = (! strcmp (style->operation, "chopgimp:stroke") ||
+               ! strcmp (style->label, "Ombre portée"));
+
+      for (list2 = filters; list2; list2 = g_list_next (list2))
+        {
+          GimpDrawableFilter *filter  = list2->data;
+          gboolean            current = (filter == filter_tool->existing_filter);
+          gboolean            checked;
+
+          if (layer_style_of_filter (filter) != style)
+            continue;
+
+          checked = current ? session->current_checked :
+                              gimp_filter_get_active (GIMP_FILTER (filter));
+
+          row = layer_style_add_row (session, list, style, filter, index,
+                                     current, checked, multi && index == 0);
+          if (current)
+            current_row = row;
+
+          index++;
+        }
+
+      /*  the effect being added  */
+      if (! filter_tool->existing_filter && session->current == style)
+        {
+          current_row = layer_style_add_row (session, list, style, NULL, index,
+                                             TRUE, session->current_checked,
+                                             multi && index == 0);
+          index++;
+        }
+
+      /*  an absent effect  */
+      if (index == 0)
+        layer_style_add_row (session, list, style, NULL, 0,
+                             FALSE, FALSE, FALSE);
+    }
+
+  g_list_free (filters);
+
+  if (current_row)
+    gtk_list_box_select_row (GTK_LIST_BOX (list),
+                             GTK_LIST_BOX_ROW (current_row));
+
+  g_signal_connect (list, "row-activated",
+                    G_CALLBACK (layer_style_row_activated),
+                    session);
+
+  gtk_widget_set_visible (side_box, TRUE);
+
+  gimp_tool_gui_set_title (filter_tool->gui, "Style de calque");
+
+  if (session->current)
+    gimp_tool_gui_set_description (filter_tool->gui, session->current->label);
+}
+
+
+/*  3.28.2: something else pushes an undo step while the session's group
+ *  is open: the group is closed (the effects so far are one step), the
+ *  next change of the window opens a new one; Annuler then keeps them
+ *  (the user's step is above them)
+ */
+static void
+layer_style_group_interrupted (GimpImage *image,
+                               gpointer   data)
+{
+  LayerStyleSession *session = data;
+
+  if (session->group_open)
+    {
+      gimp_image_undo_group_end (image);
+      session->group_open = FALSE;
+    }
+}
+
+/*  end of the session, once the tool is halted  */
+
+static gboolean
+layer_style_end_idle (gpointer data)
+{
+  LayerStyleEnd *end = data;
+
+  if (end->image)
+    {
+      if (end->undo && end->group &&
+          gimp_undo_stack_peek (gimp_image_get_undo_stack (end->image)) == end->group)
+        {
+          gimp_image_undo (end->image);
+        }
+
+      if (end->undo)
+        {
+          GList *list;
+
+          for (list = end->actives; list; list = g_list_next (list))
+            {
+              ActiveState *state = list->data;
+
+              if (gimp_filter_get_active (state->filter) != state->active)
+                {
+                  GimpDrawable *drawable;
+
+                  gimp_filter_set_active (state->filter, state->active);
+
+                  drawable =
+                    gimp_drawable_filter_get_drawable (GIMP_DRAWABLE_FILTER (state->filter));
+                  if (drawable)
+                    gimp_drawable_update (drawable, 0, 0, -1, -1);
+                }
+            }
+        }
+
+      gimp_image_flush (end->image);
+    }
+
+  if (end->restore_merge && end->options)
+    g_object_set (end->options,
+                  "merge-filter", TRUE,
+                  NULL);
+
+  g_list_free_full (end->actives, (GDestroyNotify) active_state_free);
+  g_clear_weak_pointer (&end->image);
+  g_clear_weak_pointer (&end->group);
+  g_clear_object (&end->options);
+  g_free (end);
+
+  return G_SOURCE_REMOVE;
+}
+
+
