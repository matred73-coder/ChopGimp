+/*  ChopGimp: filtered-output cache  */
+
+/*  only real (non-destructive) drawable filters count here,
+ *  not e.g. the floating selection filter
+ */
+static gboolean
+gimp_drawable_has_active_drawable_filters (GimpDrawable *drawable)
+{
+  GList *list;
+
+  for (list = GIMP_LIST (drawable->private->filter_stack)->queue->head;
+       list;
+       list = g_list_next (list))
+    {
+      GimpFilter *filter = list->data;
+
+      if (GIMP_IS_DRAWABLE_FILTER (filter) &&
+          gimp_filter_get_active (filter))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+/*  ChopGimp: per-filter caches. Each drawable filter's applicator has
+ *  its own gegl:cache (stock GIMP), so that changing a filter does not
+ *  recompute the ones below it. The topmost active filter's cache is an
+ *  exact copy of the drawable's cache right after it: it is disabled,
+ *  which saves a full-size RGBA float copy of the effects per layer,
+ *  unless the filter is being edited by a tool (temporary) or is going
+ *  to be merged (gimp_drawable_merge_filter() reuses its cache).
+ */
+static void
+gimp_drawable_filters_sync_applicator_caches (GimpDrawable *drawable)
+{
+  GList    *list;
+  gboolean  top = TRUE;
+
+  for (list = GIMP_LIST (drawable->private->filter_stack)->queue->head;
+       list;
+       list = g_list_next (list))
+    {
+      GimpFilter     *filter = list->data;
+      GimpApplicator *applicator;
+      gboolean        cache  = TRUE;
+
+      if (! GIMP_IS_DRAWABLE_FILTER (filter))
+        continue;
+
+      applicator = gimp_filter_get_applicator (filter);
+
+      if (! applicator)
+        continue;
+
+      /*  ChopGimp: a behind filter (chopgimp-behind-effects.c) is out of
+       *  the chain: its cache is the only one of its output, and it is
+       *  not the top of the chain
+       */
+      if (chopgimp_behind_effects_is_linked (drawable, filter))
+        {
+          if (! gimp_applicator_get_cache (applicator))
+            gimp_applicator_set_cache (applicator, TRUE);
+
+          continue;
+        }
+
+      if (top && gimp_filter_get_active (filter))
+        {
+          GimpDrawableFilter *drawable_filter = GIMP_DRAWABLE_FILTER (filter);
+
+          top = FALSE;
+
+          if (drawable->private->filters_cache_enabled            &&
+              ! gimp_drawable_filter_get_temporary (drawable_filter) &&
+              ! gimp_drawable_filter_get_to_be_merged (drawable_filter))
+            {
+              cache = FALSE;
+            }
