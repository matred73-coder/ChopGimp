+/*  ChopGimp 3.32.0: a new Satin or Incrustation de motif (made by the
+ *  filter tool) goes under the stroke, the bevel and the inner shadows /
+ *  glows of the layer, as Photoshop stacks its effects: otherwise the
+ *  overlay, composited inside the layer's alpha, would cover the stroke
+ *  outside the layer. Once, when first added (undo / redo keep their
+ *  position).
+ */
+static void
+gimp_drawable_filter_place_style (GimpDrawableFilter *filter)
+{
+  GimpContainer *filters;
+  const gchar   *op;
+  GList         *list;
+  gint           index;
+  gint           below = -1;
+  gint           i;
+
+  if (! g_object_get_data (G_OBJECT (filter), "chopgimp-place-style"))
+    return;
+
+  g_object_set_data (G_OBJECT (filter), "chopgimp-place-style", NULL);
+
+  op = gegl_node_get_operation (filter->operation);
+
+  if (! op || (strcmp (op, "chopgimp:satin") &&
+               strcmp (op, "chopgimp:pattern-overlay")))
+    return;
+
+  filters = gimp_drawable_get_filters (filter->drawable);
+  index   = gimp_container_get_child_index (filters, GIMP_OBJECT (filter));
+
+  /*  index 0 is the top of the stack (rendered last)  */
+  for (list = GIMP_LIST (filters)->queue->head, i = 0;
+       list;
+       list = g_list_next (list), i++)
+    {
+      GimpFilter  *other = list->data;
+      const gchar *o;
+
+      if (other == GIMP_FILTER (filter) || ! GIMP_IS_DRAWABLE_FILTER (other))
+        continue;
+
+      o = gegl_node_get_operation (GIMP_DRAWABLE_FILTER (other)->operation);
+
+      if (o && (! strcmp (o, "chopgimp:stroke") ||
+                ! strcmp (o, "gegl:bevel")      ||
+                ! strcmp (o, "gegl:inner-glow")))
+        below = i;
+    }
+
+  if (below > index)
+    gimp_container_reorder (filters, GIMP_OBJECT (filter), below);
+}
