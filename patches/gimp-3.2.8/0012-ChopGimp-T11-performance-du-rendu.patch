+/*  ChopGimp: the length of a filter's name without the "..." of the
+ *  action it was created by
+ */
+static gsize
+gimp_drawable_filters_editor_base_length (const gchar *name)
+{
+  gsize len = strlen (name);
+
+  while (len > 0)
+    {
+      if (len >= 3 && ! strncmp (name + len - 3, "...", 3))
+        len -= 3;
+      else if (len >= 3 && ! strncmp (name + len - 3, "\u2026", 3))
+        len -= 3;
+      else if (name[len - 1] == ' ')
+        len--;
+      else
+        break;
+    }
+
+  return len;
+}
+
+/*  ChopGimp: several filters of the same effect on a layer (two Contour,
+ *  as Photoshop allows) are numbered in the list: "Contour (1)",
+ *  "Contour (2)", from the bottom (the first applied)
+ */
+static void
+gimp_drawable_filters_editor_name_data_func (GtkTreeViewColumn *column,
+                                             GtkCellRenderer   *cell,
+                                             GtkTreeModel      *model,
+                                             GtkTreeIter       *iter,
+                                             gpointer           data)
+{
+  GimpContainerView *view      = GIMP_CONTAINER_VIEW (data);
+  GimpContainer     *container = gimp_container_view_get_container (view);
+  GimpViewRenderer  *renderer  = NULL;
+  gchar             *name      = NULL;
+  GList             *list;
+  gsize              base_len;
+  gint               count     = 0;
+  gint               index     = 0;
+
+  gtk_tree_model_get (model, iter,
+                      GIMP_CONTAINER_TREE_STORE_COLUMN_RENDERER, &renderer,
+                      GIMP_CONTAINER_TREE_STORE_COLUMN_NAME,     &name,
+                      -1);
+
+  if (! renderer || ! name || ! GIMP_IS_LIST (container))
+    {
+      g_clear_object (&renderer);
+      g_free (name);
+      return;
+    }
+
+  base_len = gimp_drawable_filters_editor_base_length (name);
+
+  for (list = GIMP_LIST (container)->queue->tail;
+       list;
+       list = g_list_previous (list))
+    {
+      const gchar *other = gimp_object_get_name (list->data);
+
+      if (other                                                     &&
+          gimp_drawable_filters_editor_base_length (other) == base_len &&
+          ! strncmp (other, name, base_len))
+        {
+          count++;
+
+          if (list->data == (gpointer) renderer->viewable)
+            index = count;
+        }
+    }
+
+  if (count > 1 && index > 0)
+    {
+      gchar *base = g_strndup (name, base_len);
+      gchar *text = g_strdup_printf ("%s (%d)", base, index);
+
+      g_object_set (cell, "text", text, NULL);
+
+      g_free (text);
+      g_free (base);
+    }
+
+  g_object_unref (renderer);
+  g_free (name);
+}
