+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-alpha-bounds.h — ChopGimp: bounds of the visible pixels
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+/*  Bounds of the non-transparent pixels of @drawable, in its own
+ *  coordinates.  Unlike gimp_pickable_auto_shrink(), which crops away
+ *  the colour of the corners (« autocrop »), only the alpha counts: an
+ *  opaque shape that fills its layer keeps all its pixels.
+ */
+GimpAutoShrink   chopgimp_alpha_bounds (GimpDrawable *drawable,
+                                        gint         *x,
+                                        gint         *y,
+                                        gint         *width,
+                                        gint         *height);
+
+/*  Same, remembered until the pixels of the drawable change (« changed »
+ *  signal of its buffer).  For display only (Move tool controls): the
+ *  crops use chopgimp_alpha_bounds().
+ */
+GimpAutoShrink   chopgimp_alpha_bounds_cached (GimpDrawable *drawable,
+                                               gint         *x,
+                                               gint         *y,
+                                               gint         *width,
+                                               gint         *height);
+
+/*  Copies the alpha of @src into @dest (format « A <type> » of the same
+ *  type, same extent) without babl conversion. FALSE if not applicable.
+ */
+gboolean         chopgimp_alpha_extract       (GeglBuffer   *src,
+                                               GeglBuffer   *dest);
+
+/*  Same, estimated on a reduced copy (mipmaps) when the drawable is
+ *  larger than @max_side: fast, never smaller than the real bounds (one
+ *  sample of margin).  For thumbnails, not for exact crops.
+ */
+GimpAutoShrink   chopgimp_alpha_bounds_fast (GimpDrawable *drawable,
+                                             gint          max_side,
+                                             gint         *x,
+                                             gint         *y,
+                                             gint         *width,
+                                             gint         *height);
diff --git a/app/core/chopgimp-fx-cache.c b/app/core/chopgimp-fx-cache.c
