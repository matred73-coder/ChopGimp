+  stack->fuse_data = user_data;
+}
+
+/*  ChopGimp: behind filters  */
+
+void
+gimp_filter_stack_set_behind_func (GimpFilterStack                  *stack,
+                                   GimpFilterStackBehindFunc         func,
+                                   GimpFilterStackBehindChangedFunc  changed_func,
+                                   gpointer                          user_data)
+{
+  g_return_if_fail (GIMP_IS_FILTER_STACK (stack));
+  g_return_if_fail (stack->graph == NULL);
+
+  stack->behind_func         = func;
+  stack->behind_changed_func = changed_func;
+  stack->behind_data         = user_data;
+}
+
+/*  the behind filters of the last relink, from the bottom up: a list of
+ *  GimpFilterStackBehind owned by the stack
+ */
+GList *
+gimp_filter_stack_get_behind (GimpFilterStack *stack)
+{
+  g_return_val_if_fail (GIMP_IS_FILTER_STACK (stack), NULL);
+
+  return stack->behind;
+}
+
+static void
+gimp_filter_stack_behind_free (GimpFilterStackBehind *behind)
+{
+  if (behind->knockout)
+    {
+      GeglNode *parent = gegl_node_get_parent (behind->knockout);
+
+      gegl_node_disconnect (behind->knockout, "input");
+      gegl_node_disconnect (behind->knockout, "aux");
+
+      if (parent)
+        gegl_node_remove_child (parent, behind->knockout);
+
+      g_object_unref (behind->knockout);
+    }
+
+  g_slice_free (GimpFilterStackBehind, behind);
+}
+
+static GimpFilterStackBehind *
+gimp_filter_stack_behind_find (GList      *behind,
+                               GimpFilter *filter)
+{
+  for (; behind; behind = g_list_next (behind))
+    {
+      GimpFilterStackBehind *b = behind->data;
+
+      if (b->filter == filter)
+        return b;
+    }
+
+  return NULL;
+}
+
+/*  links the active filters (or the nodes the fuse function returns for
+ *  them) from the input to the output of the graph, touching only the
+ *  links which change: relinking invalidates everything downstream
+ */
+void
+gimp_filter_stack_relink (GimpFilterStack *stack)
+{
+  g_return_if_fail (GIMP_IS_FILTER_STACK (stack));
+
+  gimp_filter_stack_relink_excluding (stack, NULL);
+}
+
+static void
+gimp_filter_stack_relink_excluding (GimpFilterStack *stack,
+                                    GimpFilter      *exclude)
+{
+  GList    *filters        = NULL;
+  GList    *nodes          = NULL;
+  GList    *behind_filters = NULL;
+  GList    *new_behind     = NULL;
+  GList    *old_behind;
+  GList    *list;
+  GeglNode *previous;
+  GeglNode *output;
+
+  if (! stack->graph)
+    return;
+
+  /*  the active filters, from the bottom up  */
+  for (list = GIMP_LIST (stack)->queue->head;
+       list;
+       list = g_list_next (list))
+    {
+      GimpFilter *filter = list->data;
+
+      if (filter != exclude && gimp_filter_get_active (filter))
+        filters = g_list_prepend (filters, filter);
+    }
+
+  /*  ChopGimp: the behind filters (the fuse function leaves them alone)  */
+  if (stack->behind_func)
+    {
+      for (list = filters; list; list = g_list_next (list))
+        if (stack->behind_func (stack, list->data, stack->behind_data))
+          behind_filters = g_list_prepend (behind_filters, list->data);
+
+      behind_filters = g_list_reverse (behind_filters);
+    }
+
+  if (stack->fuse_func)
+    nodes = stack->fuse_func (stack, filters, stack->fuse_data);
+  else
+    for (list = g_list_last (filters); list; list = g_list_previous (list))
+      nodes = g_list_prepend (nodes, gimp_filter_get_node (list->data));
+
+  /*  the fused nodes join the graph  */
+  for (list = nodes; list; list = g_list_next (list))
+    {
+      GeglNode *node = list->data;
+
+      if (gegl_node_get_parent (node) != stack->graph)
+        gegl_node_add_child (stack->graph, node);
+
+      if (! g_list_find (stack->fused_nodes, node))
+        {
+          GList *iter;
+          gboolean is_filter = FALSE;
+
+          for (iter = filters; iter; iter = g_list_next (iter))
+            if (gimp_filter_get_node (iter->data) == node)
+              {
+                is_filter = TRUE;
+                break;
+              }
+
+          if (! is_filter)
+            stack->fused_nodes = g_list_prepend (stack->fused_nodes,
+                                                 g_object_ref (node));
+        }
+    }
+
+  /*  the chain  */
+  previous = gegl_node_get_input_proxy (stack->graph, "input");
+
+  for (list = nodes; list; list = g_list_next (list))
+    {
+      GeglNode   *node          = list->data;
+      GimpFilter *behind_filter = NULL;
+      GList      *iter;
+
+      for (iter = behind_filters; iter; iter = g_list_next (iter))
+        if (gimp_filter_get_node (iter->data) == node)
+          {
+            behind_filter = iter->data;
+            break;
+          }
+
+      if (gegl_node_get_producer (node, "input", NULL) != previous)
+        gegl_node_link (previous, node);
+
+      /*  ChopGimp: a behind filter gets the chain's output at its place,
+       *  the chain goes on without it, its effect alone is kept
+       */
+      if (behind_filter)
+        {
+          GimpFilterStackBehind *behind;
+
+          behind = gimp_filter_stack_behind_find (stack->behind,
+                                                  behind_filter);
+
+          if (behind)
+            {
+              stack->behind = g_list_remove (stack->behind, behind);
+            }
+          else
+            {
+              behind = g_slice_new0 (GimpFilterStackBehind);
+              behind->filter   = behind_filter;
+              behind->knockout =
+                gegl_node_new_child (stack->graph,
+                                     "operation", "chopgimp:behind-knockout",
+                                     NULL);
+              g_object_ref (behind->knockout);
+            }
+
+          if (gegl_node_get_producer (behind->knockout, "input", NULL) != node)
+            gegl_node_connect (node, "output", behind->knockout, "input");
+
+          if (gegl_node_get_producer (behind->knockout, "aux", NULL) != previous)
+            gegl_node_connect (previous, "output", behind->knockout, "aux");
+
+          new_behind = g_list_append (new_behind, behind);
+
+          continue;
+        }
+
+      previous = node;
