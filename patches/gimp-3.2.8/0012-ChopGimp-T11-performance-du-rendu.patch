+
+/*  ChopGimp: the « Style de calque » window, see the top of the file.
+ *  Called at the end of gimp_filter_tool_initialize().
+ */
+void
+gimp_filter_tool_layer_style_start (GimpFilterTool *filter_tool)
+{
+  GimpTool                 *tool;
+  LayerStyleSession        *session;
+  const ChopGimpLayerStyle *style;
+  GimpDrawable             *drawable = NULL;
+
+  g_return_if_fail (GIMP_IS_FILTER_TOOL (filter_tool));
+
+  tool = GIMP_TOOL (filter_tool);
+
+  if (! filter_tool->gui)
+    return;
+
+  style = GIMP_IS_OPERATION_TOOL (filter_tool) ?
+          layer_style_get_current (filter_tool) : NULL;
+
+  if (filter_tool->existing_filter)
+    drawable = gimp_drawable_filter_get_drawable (filter_tool->existing_filter);
+  else if (tool->drawables)
+    drawable = tool->drawables->data;
+
+  if (! style || ! tool->display || ! GIMP_IS_LAYER (drawable))
+    {
+      GtkWidget *side_box = gimp_tool_gui_get_side_box (filter_tool->gui);
+
+      if (side_box)
+        gtk_widget_set_visible (side_box, FALSE);
+
+      return;
+    }
+
+  session = layer_style_get_session (filter_tool);
+
+  if (! session)
+    {
+      Gimp              *gimp    = tool->tool_info->gimp;
+      GList             *filters;
+      GList             *list;
+      gint64             unchecked;
+
+      session = g_new0 (LayerStyleSession, 1);
+
+      session->filter_tool     = filter_tool;
+      session->drawable        = g_object_ref (drawable);
+      session->current_checked = TRUE;
+
+      g_object_set_data_full (G_OBJECT (filter_tool), SESSION_KEY, session,
+                              (GDestroyNotify) layer_style_session_free);
+
+      /*  the active state of the effects, restored by Annuler (not
+       *  undoable in GIMP)
+       */
+      filters = layer_style_get_filters (session);
+
+      for (list = filters; list; list = g_list_next (list))
+        {
+          ActiveState *state;
+
+          if (list->data == filter_tool->existing_filter)
+            continue;
+
+          state = g_new0 (ActiveState, 1);
+          state->filter = g_object_ref (list->data);
+          state->active = gimp_filter_get_active (state->filter);
+
+          session->actives = g_list_prepend (session->actives, state);
+        }
+
+      g_list_free (filters);
+
+      if (! filter_tool->existing_filter)
+        layer_style_disable_merge (session);
+
+      /*  Options de fusion… on a layer without style  */
+      unchecked = GPOINTER_TO_SIZE (g_object_get_data (G_OBJECT (gimp),
+                                                       UNCHECKED_KEY));
+      g_object_set_data (G_OBJECT (gimp), UNCHECKED_KEY, NULL);
+
+      if (unchecked                                                     &&
+          (g_get_monotonic_time () / G_TIME_SPAN_SECOND) - unchecked < 5 &&
+          ! filter_tool->existing_filter                                 &&
+          filter_tool->filter)
+        {
+          session->current_checked = FALSE;
+
+          gimp_filter_set_active (GIMP_FILTER (filter_tool->filter), FALSE);
+          layer_style_update_drawable (session);
+        }
+    }
+
+  session->current = style;
+
+  layer_style_update_gui (session);
+}
+
+/*  TRUE while the session's undo group is open  */
+gboolean
+gimp_filter_tool_layer_style_in_group (GimpFilterTool *filter_tool)
+{
+  LayerStyleSession *session;
+
+  g_return_val_if_fail (GIMP_IS_FILTER_TOOL (filter_tool), FALSE);
+
+  session = layer_style_get_session (filter_tool);
+
+  return session && session->group_open;
+}
+
+/*  Valider: TRUE if the edited effect must not be committed (an effect
+ *  added then unchecked)
+ */
+gboolean
+gimp_filter_tool_layer_style_validate (GimpFilterTool *filter_tool)
+{
+  LayerStyleSession *session;
+
+  g_return_val_if_fail (GIMP_IS_FILTER_TOOL (filter_tool), FALSE);
+
+  session = layer_style_get_session (filter_tool);
+
+  if (! session)
+    return FALSE;
+
+  session->validated = TRUE;
+
+  return (! filter_tool->existing_filter && ! session->current_checked);
+}
+
+/*  the edited effect was committed as @filter: unchecked, it is disabled  */
+void
+gimp_filter_tool_layer_style_committed (GimpFilterTool     *filter_tool,
+                                        GimpDrawableFilter *filter)
+{
+  LayerStyleSession *session;
+  GimpContainer     *filters;
+
+  g_return_if_fail (GIMP_IS_FILTER_TOOL (filter_tool));
+  g_return_if_fail (GIMP_IS_DRAWABLE_FILTER (filter));
+
+  session = layer_style_get_session (filter_tool);
+
+  if (! session || session->current_checked)
+    return;
+
+  filters = gimp_drawable_get_filters (session->drawable);
+
+  /*  merged into the pixels  */
+  if (! filters || ! gimp_container_have (filters, GIMP_OBJECT (filter)))
+    return;
+
+  gimp_filter_set_active (GIMP_FILTER (filter), FALSE);
+  layer_style_update_drawable (session);
+}
+
+/*  start of gimp_filter_tool_halt(): ends the session's undo group;
+ *  Annuler undoes it and restores the active states, once the tool is
+ *  halted
+ */
+void
+gimp_filter_tool_layer_style_halt (GimpFilterTool *filter_tool)
+{
+  LayerStyleSession *session;
+  LayerStyleEnd     *end;
+  GimpImage         *image;
+
+  g_return_if_fail (GIMP_IS_FILTER_TOOL (filter_tool));
+
+  session = layer_style_get_session (filter_tool);
+
+  if (! session)
+    return;
+
+  if (session->idle_id)
+    {
+      g_source_remove (session->idle_id);
+      session->idle_id = 0;
+    }
+
+  if (filter_tool->gui)
+    {
