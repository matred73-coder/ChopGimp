@@ -0,0 +1,1403 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995-1997 Spencer Kimball and Peter Mattis
+ *
+ * gimppropgui-layer-style.c
+ * ChopGimp : fenêtres des styles de calque, disposées comme celles de
+ * Photoshop (Contour, Ombre portée, Lueur externe, Ombre interne, Lueur
+ * interne)
