+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+
+/*  One effect of the fused style: a GIMP drawable filter whose operation
+ *  is gegl:dropshadow (drop shadow, outer glow), gegl:inner-glow (inner
+ *  shadow, inner glow) or chopgimp:stroke, with the filter's blend mode
+ *  and opacity (GIMP's "Blending Options").
+ *
+ *  The values are a snapshot of the filter's properties, taken by
+ *  app/core/gimpdrawable-fused-styles.c, which only fuses the cases
+ *  the operation renders exactly like the chain of filters.
+ */
+
+typedef enum
+{
+  GIMP_FUSED_EFFECT_DROP_SHADOW,   /*  gegl:dropshadow  */
+  GIMP_FUSED_EFFECT_INNER_GLOW,    /*  gegl:inner-glow  */
+  GIMP_FUSED_EFFECT_STROKE         /*  chopgimp:stroke  */
+} GimpFusedEffectType;
+
+typedef struct
+{
+  GimpFusedEffectType     type;
+
+  /*  the filter's applicator  */
+  GimpLayerMode           mode;
+  GimpLayerColorSpace     blend_space;
+  GimpLayerColorSpace     composite_space;
+  GimpLayerCompositeMode  composite_mode;
+  gdouble                 opacity;
+
+  /*  gegl:dropshadow, gegl:inner-glow  */
+  gint                    x;              /*  whole pixels  */
+  gint                    y;
+  gdouble                 radius;         /*  blur std-dev  */
+  gint                    grow_shape;     /*  0 square, 1 circle, 2 diamond  */
+  gdouble                 grow_radius;
+  GeglColor              *color;
+  gdouble                 effect_opacity;
+  gdouble                 cover;          /*  gegl:inner-glow  */
+
+  /*  chopgimp:stroke: its operation (GimpOperationContour), used as is  */
+  GeglOperation          *stroke;
+
+  /*  changes when the filter's properties change  */
+  guint                   serial;
+} GimpFusedEffect;
+
+typedef struct _GimpFusedStyle GimpFusedStyle;
+
+struct _GimpFusedStyle
+{
+  gint             ref_count;
+  gint             n_effects;
+  GimpFusedEffect *effects;
+
+  /*  compute the planes ahead of the requested regions (the input is
+   *  then requested around them, see get_required_for_output())
+   */
+  gboolean         ahead;
+};
+
+#define GIMP_TYPE_FUSED_STYLE (gimp_fused_style_get_type ())
+
+GType            gimp_fused_style_get_type (void) G_GNUC_CONST;
+
+GimpFusedStyle * gimp_fused_style_new      (gint                  n_effects);
+GimpFusedStyle * gimp_fused_style_ref      (GimpFusedStyle       *style);
+void             gimp_fused_style_unref    (GimpFusedStyle       *style);
+gboolean         gimp_fused_style_equal    (const GimpFusedStyle *style1,
+                                            const GimpFusedStyle *style2);
+
+
+#define GIMP_TYPE_OPERATION_LAYER_STYLE_FUSED            (gimp_operation_layer_style_fused_get_type ())
+#define GIMP_OPERATION_LAYER_STYLE_FUSED(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), GIMP_TYPE_OPERATION_LAYER_STYLE_FUSED, GimpOperationLayerStyleFused))
+#define GIMP_OPERATION_LAYER_STYLE_FUSED_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass),  GIMP_TYPE_OPERATION_LAYER_STYLE_FUSED, GimpOperationLayerStyleFusedClass))
+#define GIMP_IS_OPERATION_LAYER_STYLE_FUSED(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), GIMP_TYPE_OPERATION_LAYER_STYLE_FUSED))
+#define GIMP_IS_OPERATION_LAYER_STYLE_FUSED_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass),  GIMP_TYPE_OPERATION_LAYER_STYLE_FUSED))
+#define GIMP_OPERATION_LAYER_STYLE_FUSED_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj),  GIMP_TYPE_OPERATION_LAYER_STYLE_FUSED, GimpOperationLayerStyleFusedClass))
+
+
+typedef struct _GimpOperationLayerStyleFused      GimpOperationLayerStyleFused;
+typedef struct _GimpOperationLayerStyleFusedClass GimpOperationLayerStyleFusedClass;
+typedef struct _GimpFusedCache                    GimpFusedCache;
+
+struct _GimpOperationLayerStyleFused
+{
+  GeglOperationFilter  parent_instance;
+
+  /*  short lock: the style, and the changes not yet applied to the
+   *  cache (the main thread never waits for a rendering)
+   */
+  GMutex               state_mutex;
+  GimpFusedStyle      *style;
+  GArray              *pending;      /*  invalidated rectangles  */
+  gboolean             reset;        /*  the style changed       */
+  guint                generation;
+
+  /*  rendering lock: the effects' intermediate planes (shadow alpha, glow
+   *  alpha, stroke coverage), kept between renderings at level 0
+   */
+  GMutex               mutex;
+  GimpFusedCache      *cache;
+};
+
+struct _GimpOperationLayerStyleFusedClass
+{
+  GeglOperationFilterClass  parent_class;
+};
+
+
+GType      gimp_operation_layer_style_fused_get_type (void) G_GNUC_CONST;
+
+/*  whether the operation can render this effect's blend mode  */
+gboolean   gimp_operation_layer_style_fused_mode_supported
+                                                     (GimpLayerMode           mode,
+                                                      GimpLayerColorSpace     blend_space,
+                                                      GimpLayerColorSpace     composite_space,
+                                                      GimpLayerCompositeMode  composite_mode,
+                                                      gdouble                 opacity);
+
+/*  fills effect from a layer style filter's operation node and its
+ *  applicator's settings; FALSE if the operation does not render this
+ *  filter exactly like the filter does (it must then not be fused)
+ */
+gboolean   gimp_fused_effect_init                    (GimpFusedEffect        *effect,
+                                                      GeglNode               *node,
+                                                      GimpLayerMode           mode,
+                                                      GimpLayerColorSpace     blend_space,
+                                                      GimpLayerColorSpace     composite_space,
+                                                      GimpLayerCompositeMode  composite_mode,
+                                                      gdouble                 opacity);
+void       gimp_fused_effect_clear                   (GimpFusedEffect        *effect);
