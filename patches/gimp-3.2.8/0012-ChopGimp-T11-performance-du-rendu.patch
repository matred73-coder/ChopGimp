+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "propgui-types.h"
+
+#include "operations/layer-modes/gimp-layer-modes.h"
+
+#include "core/gimp.h"
+#include "core/gimpcontainer.h"
+#include "core/gimpcontext.h"
+#include "core/gimpdatafactory.h"
+#include "core/gimpgradient.h"
+#include "core/gimpgradient-save.h"
+#include "core/gimppattern.h"
+#include "core/gimppattern-save.h"
+
+#include "widgets/gimplayermodebox.h"
+#include "widgets/gimppropwidgets.h"
+#include "widgets/gimpviewablebox.h"
+
+#include "gimppropgui.h"
+#include "gimppropgui-generic.h"
+#include "gimppropgui-layer-style.h"
+
+#include "gimp-intl.h"
+
+
+/*  number of colors of a gradient stored for gegl:dropshadow and
+ *  gegl:inner-glow (gegl:glow-map interpolates between them)
+ */
+#define GLOW_GRADIENT_SAMPLES 64
+
+#define OFFSET_KEY "chopgimp-layer-style-offset"
+
+
+typedef enum
+{
+  STORE_GRADIENT_GGR,    /*  chopgimp:stroke: a .ggr file's contents     */
+  STORE_GRADIENT_STOPS,  /*  gegl:glow-map: "pos r g b a;..."            */
+  STORE_PATTERN          /*  chopgimp:stroke: base64 of a zlib .pat file */
+} StoreKind;
+
+typedef struct
+{
+  GObject     *config;
+  const gchar *property;
+  StoreKind    kind;
+  GimpContext *user_context;  /*  for the FG/BG colors of gradients  */
+  GimpContext *context;       /*  holds the chosen gradient / pattern */
+  const gchar *active_prop;   /*  the property enabling the resource  */
+  gint         active_value;
+} ResourceBox;
+
+typedef void (* OffsetPropsFunc) (GObject      *config,
+                                  const gchar **x_prop,
+                                  const gchar **y_prop);
+
+typedef struct
+{
+  GObject         *config;
+  OffsetPropsFunc  get_props;
+  GCallback        set_func;
+  gpointer         set_data;
+  GeglRectangle    area;
+} OffsetController;
+
+
+/*  widgets  */
+
+/*  a property's widget, with Photoshop's label, packed in vbox  */
+static GtkWidget *
+layer_style_add_prop (GtkWidget            *vbox,
+                      GObject              *config,
+                      const gchar          *property,
+                      const gchar          *label_text,
+                      GeglRectangle        *area,
+                      GimpContext          *context,
+                      GimpCreatePickerFunc  create_picker_func,
+                      gpointer              creator)
+{
+  GtkWidget   *widget;
+  const gchar *label = NULL;
+
+  if (! g_object_class_find_property (G_OBJECT_GET_CLASS (config), property))
+    return NULL;
+
+  widget = gimp_prop_widget_new (config, property, area, context,
+                                 create_picker_func, NULL, creator,
+                                 &label);
+
+  if (! widget)
+    return NULL;
+
+  if (label_text)
+    {
+      if (GIMP_IS_SPIN_SCALE (widget))
+        {
+          gimp_spin_scale_set_label (GIMP_SPIN_SCALE (widget), label_text);
+        }
+      else if (GIMP_IS_INT_COMBO_BOX (widget))
+        {
+          gimp_int_combo_box_set_label (GIMP_INT_COMBO_BOX (widget),
+                                        label_text);
+        }
+      else if (GTK_IS_CHECK_BUTTON (widget))
+        {
+          gtk_button_set_label (GTK_BUTTON (widget), label_text);
+        }
+      else if (label)
+        {
+          label = label_text;
+        }
+    }
+
+  /*  opacities in percent, as in Photoshop (GEGL stores 0.0 – 1.0 or 2.0)  */
+  if (GIMP_IS_SPIN_SCALE (widget) && ! strcmp (property, "opacity"))
+    {
+      GParamSpec *pspec = g_object_class_find_property (G_OBJECT_GET_CLASS (config),
+                                                        property);
+
+      if (G_IS_PARAM_SPEC_DOUBLE (pspec) &&
+          G_PARAM_SPEC_DOUBLE (pspec)->maximum <= 2.0)
+        {
+          gimp_prop_widget_set_factor (widget, 100.0, 1.0, 10.0, 0);
+          /*  the slider spans 0 – 100 % (GEGL allows up to 200 %)  */
+          gimp_spin_scale_set_scale_limits (GIMP_SPIN_SCALE (widget),
+                                            0.0, 100.0);
+
+          if (g_object_class_find_property (G_OBJECT_GET_CLASS (widget),
+                                            "unit-suffix"))
+            g_object_set (widget, "unit-suffix", "%", NULL);
+        }
+    }
+
+  if (label)
+    {
+      GtkWidget *hbox;
+      GtkWidget *l;
+
+      hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+      gtk_box_pack_start (GTK_BOX (vbox), hbox, FALSE, FALSE, 0);
+      gtk_widget_set_visible (hbox, TRUE);
+
+      l = gtk_label_new_with_mnemonic (label);
+      gtk_label_set_xalign (GTK_LABEL (l), 0.0);
+      gtk_box_pack_start (GTK_BOX (hbox), l, FALSE, FALSE, 0);
+      gtk_widget_set_visible (l, TRUE);
+
+      gtk_box_pack_start (GTK_BOX (hbox), widget, TRUE, TRUE, 0);
+
+      gimp_prop_gui_bind_container (widget, hbox);
+    }
+  else
+    {
+      gtk_box_pack_start (GTK_BOX (vbox), widget, FALSE, FALSE, 0);
+    }
+
+  gtk_widget_set_visible (widget, TRUE);
+
+  return widget;
+}
+
+/*  a titled frame (GIMP's bold title), with a vbox inside  */
+static GtkWidget *
+layer_style_frame (GtkWidget   *parent,
+                   const gchar *title)
+{
+  GtkWidget *frame;
+  GtkWidget *vbox;
+
+  frame = gimp_frame_new (title);
+  gtk_box_pack_start (GTK_BOX (parent), frame, FALSE, FALSE, 0);
+  gtk_widget_set_visible (frame, TRUE);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+  gtk_container_add (GTK_CONTAINER (frame), vbox);
+  gtk_widget_set_visible (vbox, TRUE);
+
+  return vbox;
+}
+
+/*  the X / Y pair of an offset, linked by a chain, as the generic GUI
+ *  shows it
+ */
+static void
+layer_style_add_offset (GtkWidget            *main_vbox,
+                        GtkWidget            *vbox,
+                        GObject              *config,
+                        const gchar          *x_prop,
+                        const gchar          *y_prop,
+                        GeglRectangle        *area,
+                        GimpContext          *context,
+                        GimpCreatePickerFunc  create_picker_func,
+                        gpointer              creator)
+{
+  GParamSpec *pspecs[2];
+  GtkWidget  *gui;
+  GList      *chains;
+
+  pspecs[0] = g_object_class_find_property (G_OBJECT_GET_CLASS (config),
+                                            x_prop);
+  pspecs[1] = g_object_class_find_property (G_OBJECT_GET_CLASS (config),
+                                            y_prop);
+
+  if (! pspecs[0] || ! pspecs[1])
+    return;
+
+  gui = _gimp_prop_gui_new_generic (config, pspecs, 2, area, context,
+                                    create_picker_func, NULL, creator);
+  gtk_box_pack_start (GTK_BOX (vbox), gui, FALSE, FALSE, 0);
+  gtk_widget_set_visible (gui, TRUE);
+
+  /*  GimpOperationTool unlinks the chains of the GUI's "chains" while it
+   *  sets a whole config (presets, reset), gather them there
+   */
+  chains = g_list_copy (g_object_get_data (G_OBJECT (gui), "chains"));
+
+  if (chains)
+    {
+      GList *all = g_list_copy (g_object_get_data (G_OBJECT (main_vbox),
+                                                   "chains"));
+
+      g_object_set_data_full (G_OBJECT (main_vbox), "chains",
+                              g_list_concat (all, chains),
+                              (GDestroyNotify) g_list_free);
+    }
+}
