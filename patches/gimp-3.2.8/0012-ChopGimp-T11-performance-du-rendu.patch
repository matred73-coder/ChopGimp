diff --git a/app/core/gimpdrawable-preview.c b/app/core/gimpdrawable-preview.c
index 6437147..74ecd29 100644
--- a/app/core/gimpdrawable-preview.c
+++ b/app/core/gimpdrawable-preview.c
@@ -37,11 +37,13 @@
 #include "gimp.h"
 #include "gimp-parallel.h"
 #include "gimp-utils.h"
+#include "chopgimp-behind-effects.h"
 #include "gimpasync.h"
 #include "gimpchannel.h"
 #include "gimpchunkiterator.h"
 #include "gimpimage.h"
 #include "gimpimage-color-profile.h"
+#include "gimpdrawable-filters.h"
 #include "gimpdrawable-preview.h"
 #include "gimpdrawable-private.h"
 #include "gimplayer.h"
@@ -61,6 +63,40 @@ typedef struct
 } SubPreviewData;
 
 
+/*  ChopGimp: reduced copy of the filtered drawable, see below  */
+
+#define EFFECTS_PREVIEW_KEY   "gimp-drawable-effects-preview"
+#define EFFECTS_PREVIEW_SIZE  512  /* largest side of the reduced copy   */
+#define EFFECTS_PREVIEW_BLOCK 512  /* full-resolution rendering block    */
+
+typedef struct
+{
+  GimpDrawable   *drawable;    /* not referenced: owns this struct         */
+  GeglBuffer     *buffer;      /* the drawable with effects, at 1/2^level  */
+  gint            level;
+  GeglRectangle   extent;      /* full-resolution extent                   */
+  const Babl     *format;
+  gpointer        src_buffer;  /* compared only: a new buffer, all dirty   */
+  cairo_region_t *dirty;       /* full-resolution coordinates              */
+  gboolean        rendered;    /* rendered at least once                   */
+  gboolean        updated;     /* "update" since the last invalidation     */
+  gboolean        keep;        /* next invalidation leaves the pixels      */
+  gulong          update_id;
+  gulong          invalidate_id;
+} EffectsPreview;
+
+typedef struct
+{
+  GimpDrawable      *drawable;
+  GeglBuffer        *store;
+  const Babl        *format;
+  GeglRectangle      rect;
+  gdouble            scale;
+
+  GimpChunkIterator *iter;
+} EffectsPreviewData;
+
+
 /*  local function prototypes  */
 
 static SubPreviewData * sub_preview_data_new  (const Babl          *format,
@@ -105,6 +141,378 @@ sub_preview_data_free (SubPreviewData *data)
 }
 
 
+/*  ChopGimp: previews of drawables with effects.
+ *
+ *  gimp_drawable_get_buffer_with_effects() returns a new buffer, which
+ *  renders the whole drawable with its effects at full resolution (the
+ *  validate tile handler only renders level 0 tiles) each time a
+ *  preview is made, i.e. after each stroke on a big layer with a drop
+ *  shadow, glow or stroke.
+ *
+ *  Instead, each such drawable keeps a reduced copy of its filtered
+ *  output (EffectsPreview, at most EFFECTS_PREVIEW_SIZE pixels wide or
+ *  high, at a power of two scale). Only the areas reported by the
+ *  drawable's "update" signal (the same updates that drive the
+ *  projection) are rendered again, by blocks, from the drawable's
+ *  source node (whose gegl:cache keeps the effects rendered for the
+ *  canvas). An invalidation of the preview which comes without any
+ *  "update" (unknown reason) makes the whole copy dirty, to stay exact.
+ *
+ *  The reduced copy is made of the mipmap level @level of the filtered
+ *  drawable (rendered at full resolution, in the drawable's format,
+ *  then reduced by GEGL like the mipmaps of the old buffer), so the
+ *  previews read from it are the same as before. Larger previews (scale
+ *  above 1/2^level), group layers and drawables being painted keep the
+ *  old code path.
+ */
+
+static void
+effects_preview_free (EffectsPreview *ep)
+{
+  if (ep->update_id &&
+      g_signal_handler_is_connected (ep->drawable, ep->update_id))
+    g_signal_handler_disconnect (ep->drawable, ep->update_id);
+
+  if (ep->invalidate_id &&
+      g_signal_handler_is_connected (ep->drawable, ep->invalidate_id))
+    g_signal_handler_disconnect (ep->drawable, ep->invalidate_id);
+
+  g_clear_object (&ep->buffer);
+  g_clear_pointer (&ep->dirty, cairo_region_destroy);
+
+  g_slice_free (EffectsPreview, ep);
+}
+
+static void
+effects_preview_dirty_all (EffectsPreview *ep)
+{
+  cairo_region_destroy (ep->dirty);
+
+  ep->dirty = cairo_region_create_rectangle (
+    (const cairo_rectangle_int_t *) &ep->extent);
+}
+
+static void
+effects_preview_drawable_update (GimpDrawable   *drawable,
+                                 gint            x,
+                                 gint            y,
+                                 gint            width,
+                                 gint            height,
+                                 EffectsPreview *ep)
+{
+  GeglRectangle rect;
+
+  if (gegl_rectangle_intersect (&rect,
+                                GEGL_RECTANGLE (x, y, width, height),
+                                &ep->extent))
+    {
+      cairo_region_union_rectangle (ep->dirty,
+                                    (const cairo_rectangle_int_t *) &rect);
+    }
+
+  ep->updated = TRUE;
+  ep->keep    = FALSE;
+}
+
+static void
+effects_preview_invalidated (GimpViewable   *viewable,
+                             EffectsPreview *ep)
+{
+  if (! ep->updated && ! ep->keep)
+    effects_preview_dirty_all (ep);
+
+  ep->updated = FALSE;
+  ep->keep    = FALSE;
+}
+
+/*  returns the drawable's reduced copy if it can be used for a preview
+ *  at @scale (creating or resetting it as needed), or NULL
+ */
+static EffectsPreview *
+effects_preview_get (GimpDrawable *drawable,
+                     gdouble       scale)
+{
+  EffectsPreview      *ep;
+  GeglBuffer          *src;
+  const GeglRectangle *extent;
+  const Babl          *format;
+  gint                 level = 0;
+
+  if (drawable->private->paint_count != 0                   ||
+      ! gimp_drawable_has_visible_filters (drawable)        ||
+      gimp_viewable_get_children (GIMP_VIEWABLE (drawable)) ||
+      ! gimp_drawable_get_source_node (drawable))
+    return NULL;
+
+  src    = gimp_drawable_get_buffer (drawable);
+  extent = gegl_buffer_get_extent (src);
+  format = gegl_buffer_get_format (src);
+
+  if (extent->x != 0 || extent->y != 0 ||
+      extent->width <= 0 || extent->height <= 0)
+    return NULL;
+
+  while ((MAX (extent->width, extent->height) >> level) > EFFECTS_PREVIEW_SIZE)
+    level++;
+
+  if (scale > 1.0 / (1 << level) + 1e-9)
+    return NULL;
+
+  ep = g_object_get_data (G_OBJECT (drawable), EFFECTS_PREVIEW_KEY);
+
+  if (! ep)
+    {
+      ep = g_slice_new0 (EffectsPreview);
+
+      ep->drawable = drawable;
+      ep->dirty    = cairo_region_create ();
+
+      ep->update_id =
+        g_signal_connect (drawable, "update",
+                          G_CALLBACK (effects_preview_drawable_update),
+                          ep);
+      ep->invalidate_id =
+        g_signal_connect (drawable, "invalidate-preview",
+                          G_CALLBACK (effects_preview_invalidated),
+                          ep);
+
+      g_object_set_data_full (G_OBJECT (drawable), EFFECTS_PREVIEW_KEY, ep,
+                              (GDestroyNotify) effects_preview_free);
+    }
+
+  if (! ep->buffer                                ||
+      ep->src_buffer != (gpointer) src            ||
+      ! gegl_rectangle_equal (&ep->extent, extent) ||
+      ep->format     != format                    ||
+      ep->level      != level)
+    {
+      gint f = 1 << level;
+
+      g_clear_object (&ep->buffer);
+
+      ep->extent     = *extent;
+      ep->format     = format;
+      ep->level      = level;
+      ep->src_buffer = src;
+      ep->rendered   = FALSE;
+
+      ep->buffer = gegl_buffer_new (
+        GEGL_RECTANGLE (0, 0,
+                        (extent->width  + f - 1) / f,
+                        (extent->height + f - 1) / f),
+        format);
+
+      effects_preview_dirty_all (ep);
+    }
+
+  return ep;
+}
+
+/*  renders @rect (full-resolution coordinates) into the reduced copy  */
+static void
+effects_preview_render_rect (EffectsPreview      *ep,
+                             const GeglRectangle *rect)
+{
+  GeglNode *source = gimp_drawable_get_source_node (ep->drawable);
+  gint      f      = 1 << ep->level;
+  gint      x1, y1, x2, y2;
+  gint      bx, by;
+
+  /*  with the behind effects (shadows in a blend mode) under it  */
+  source = chopgimp_behind_effects_get_preview_source (ep->drawable, source);
+
+  /*  whole reduced pixels only  */
+  x1 = (rect->x / f) * f;
+  y1 = (rect->y / f) * f;
+  x2 = ((rect->x + rect->width  + f - 1) / f) * f;
+  y2 = ((rect->y + rect->height + f - 1) / f) * f;
+
+  for (by = y1; by < y2; by += EFFECTS_PREVIEW_BLOCK)
+    for (bx = x1; bx < x2; bx += EFFECTS_PREVIEW_BLOCK)
+      {
+        GeglRectangle block;
+        GeglRectangle clipped;
+
+        block.x      = bx;
+        block.y      = by;
+        block.width  = MIN (EFFECTS_PREVIEW_BLOCK, x2 - bx);
+        block.height = MIN (EFFECTS_PREVIEW_BLOCK, y2 - by);
+
+        /*  like the validate buffer, nothing is rendered outside of the
+         *  drawable's extent
+         */
+        if (gegl_rectangle_intersect (&clipped, &block, &ep->extent))
+          {
+            if (f == 1)
+              {
+                gegl_node_blit_buffer (source, ep->buffer, &clipped, 0,
+                                       GEGL_ABYSS_NONE);
+              }
+            else
+              {
+                GeglBuffer    *temp;
+                GeglRectangle  small;
+                GimpTempBuf   *pixels;
+
+                temp = gegl_buffer_new (&block, ep->format);
+
+                gegl_node_blit_buffer (source, temp, &clipped, 0,
+                                       GEGL_ABYSS_NONE);
+
+                small.x      = block.x      / f;
+                small.y      = block.y      / f;
+                small.width  = block.width  / f;
+                small.height = block.height / f;
+
+                gegl_rectangle_intersect (&small, &small,
+                                          gegl_buffer_get_extent (ep->buffer));
+
+                if (small.width > 0 && small.height > 0)
+                  {
+                    pixels = gimp_temp_buf_new (small.width, small.height,
+                                                ep->format);
+
+                    gegl_buffer_get (temp, &small, 1.0 / f, ep->format,
+                                     gimp_temp_buf_get_data (pixels),
+                                     GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+
+                    gegl_buffer_set (ep->buffer, &small, 0, ep->format,
+                                     gimp_temp_buf_get_data (pixels),
+                                     GEGL_AUTO_ROWSTRIDE);
+
+                    gimp_temp_buf_unref (pixels);
+                  }
+
+                g_object_unref (temp);
+              }
+          }
+
+        cairo_region_subtract_rectangle (ep->dirty,
+                                         (const cairo_rectangle_int_t *) &block);
+      }
+}
+
+static void
+effects_preview_flush (EffectsPreview *ep)
+{
+  cairo_region_t *region = cairo_region_copy (ep->dirty);
+  gint            n_rects;
+  gint            i;
+
+  n_rects = cairo_region_num_rectangles (region);
+
+  for (i = 0; i < n_rects; i++)
+    {
+      cairo_rectangle_int_t rect;
+
+      cairo_region_get_rectangle (region, i, &rect);
+
+      effects_preview_render_rect (ep, (const GeglRectangle *) &rect);
+    }
+
+  cairo_region_destroy (region);
+
+  ep->rendered = TRUE;
+}
+
+/*  synchronous read, returns FALSE if the reduced copy can't be used  */
+static gboolean
+effects_preview_read (GimpDrawable        *drawable,
+                      const GeglRectangle *rect,
+                      gdouble              scale,
+                      const Babl          *format,
+                      gpointer             data,
+                      gint                 rowstride)
+{
+  EffectsPreview *ep = effects_preview_get (drawable, scale);
+
+  if (! ep)
+    return FALSE;
+
+  effects_preview_flush (ep);
+
+  gegl_buffer_get (ep->buffer, rect, scale * (1 << ep->level),
+                   format, data, rowstride, GEGL_ABYSS_CLAMP);
+
+  return TRUE;
+}
+
+static void
+effects_preview_data_free (EffectsPreviewData *data)
+{
+  if (data->iter)
+    gimp_chunk_iterator_stop (data->iter, TRUE);
+
+  g_clear_object (&data->store);
+  g_object_unref (data->drawable);
+
+  g_slice_free (EffectsPreviewData, data);
+}
+
+static void
+effects_preview_async_func (GimpAsync          *async,
+                            EffectsPreviewData *data)
+{
+  EffectsPreview *ep;
+  GimpTempBuf    *preview;
+
+  ep = g_object_get_data (G_OBJECT (data->drawable), EFFECTS_PREVIEW_KEY);
+
+  if (! ep || ! ep->buffer)
+    {
+      effects_preview_data_free (data);
+      gimp_async_abort (async);
+      return;
+    }
+
+  /*  the copy was reset meanwhile (new buffer or size): start again  */
+  if (data->store != ep->buffer)
+    {
+      if (data->iter)
+        {
+          gimp_chunk_iterator_stop (data->iter, TRUE);
+          data->iter = NULL;
+        }
+
+      g_set_object (&data->store, ep->buffer);
+    }
+
+  if (! data->iter && ! cairo_region_is_empty (ep->dirty))
+    data->iter = gimp_chunk_iterator_new (cairo_region_copy (ep->dirty));
+
+  if (data->iter)
+    {
+      if (gimp_chunk_iterator_next (data->iter))
+        {
+          GeglRectangle rect;
+
+          while (gimp_chunk_iterator_get_rect (data->iter, &rect))
+            effects_preview_render_rect (ep, &rect);
+
+          return;
+        }
+
+      /*  one pass is enough: later updates invalidate the preview again  */
+      data->iter   = NULL;
+      ep->rendered = TRUE;
+    }
+
+  preview = gimp_temp_buf_new (data->rect.width, data->rect.height,
+                               data->format);
+
+  gegl_buffer_get (ep->buffer, &data->rect, data->scale * (1 << ep->level),
+                   gimp_temp_buf_get_format (preview),
+                   gimp_temp_buf_get_data (preview),
+                   GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_CLAMP);
+
+  effects_preview_data_free (data);
+
+  gimp_async_finish_full (async,
+                          preview,
+                          (GDestroyNotify) gimp_temp_buf_unref);
+}
