+/*  called from the sampling thread  */
+static void
+gimp_dashboard_sample_latency (GimpDashboard *dashboard,
+                               Variable       variable)
+{
+  GimpDashboardPrivate *priv          = dashboard->priv;
+  VariableData         *variable_data = &priv->variables[variable];
+
+  variable_data->available = g_atomic_int_get (&priv->latency_active);
+
+  if (variable == VARIABLE_LATENCY)
+    variable_data->value.integer = g_atomic_int_get (&priv->latency_last);
+  else
+    variable_data->value.integer = g_atomic_int_get (&priv->latency_max);
+}
