+/*  3.28.2: the point map of a « distort » group (warp / mesh / free) on
+ *  the box @bb (shared by the effect and chopgimp_geom_distort_map())
+ */
+static std::function<Point (const Point &)>
+chopgimp_distort_map (GKeyFile *kf, const gchar *g, const Geom::Rect &bb)
+{
+      std::string mode = ks (kf, g, "mode");
+      std::function<Point (const Point &)> map;
+
+      if (mode == "mesh" || mode == "free")
+        {
+          int                 rows = mode == "free" ? 1 : CLAMP ((int) kd (kf, g, "rows", 1), 1, 20);
+          int                 cols = mode == "free" ? 1 : CLAMP ((int) kd (kf, g, "cols", 1), 1, 20);
+          std::vector<Point>  grid = chopgimp_distort_mesh_points (ks (kf, g, "mesh"), rows, cols, bb);
+
+          if (mode == "free")
+            {
+              /*  homography of the unit square onto the 4 corners  */
+              Point  p0 = grid[0], p1 = grid[1], p2 = grid[3], p3 = grid[2];
+              double sx = p0[0] - p1[0] + p2[0] - p3[0];
+              double sy = p0[1] - p1[1] + p2[1] - p3[1];
+              double a, b, c, d, e, f, gg, h;
+
+              if (std::fabs (sx) < 1e-9 && std::fabs (sy) < 1e-9)
+                {
+                  a = p1[0] - p0[0]; b = p2[0] - p1[0]; c = p0[0];
+                  d = p1[1] - p0[1]; e = p2[1] - p1[1]; f = p0[1];
+                  gg = 0; h = 0;
+                }
+              else
+                {
+                  double dx1 = p1[0] - p2[0], dx2 = p3[0] - p2[0];
+                  double dy1 = p1[1] - p2[1], dy2 = p3[1] - p2[1];
+                  double den = dx1 * dy2 - dx2 * dy1;
+
+                  if (std::fabs (den) < 1e-12)
+                    den = 1e-12;
+
+                  gg = (sx * dy2 - dx2 * sy) / den;
+                  h  = (dx1 * sy - sx * dy1) / den;
+                  a  = p1[0] - p0[0] + gg * p1[0];
+                  b  = p3[0] - p0[0] + h * p3[0];
+                  c  = p0[0];
+                  d  = p1[1] - p0[1] + gg * p1[1];
+                  e  = p3[1] - p0[1] + h * p3[1];
+                  f  = p0[1];
+                }
+
+              map = [=] (const Point &p)
+                {
+                  double u = (p[0] - bb.left ()) / std::max (1e-9, bb.width ());
+                  double v = (p[1] - bb.top ())  / std::max (1e-9, bb.height ());
+                  double w = gg * u + h * v + 1.0;
+
+                  if (std::fabs (w) < 1e-9)
+                    w = 1e-9;
+
+                  return Point ((a * u + b * v + c) / w, (d * u + e * v + f) / w);
+                };
+            }
+          else
+            {
+              map = [=] (const Point &p)
+                {
+                  double u = (p[0] - bb.left ()) / std::max (1e-9, bb.width ());
+                  double v = (p[1] - bb.top ())  / std::max (1e-9, bb.height ());
+
+                  return chopgimp_distort_mesh_map (grid, rows, cols, bb, u, v);
+                };
+            }
+        }
+      else
+        {
+          std::string style = ks (kf, g, "style");
+          double      bend  = kd (kf, g, "bend", 50) / 100.0;
+          double      hd    = kd (kf, g, "hdist", 0) / 100.0;
+          double      vd    = kd (kf, g, "vdist", 0) / 100.0;
+          bool        vert  = kd (kf, g, "vertical", 0) > 0.5;
+          Point       c     = bb.midpoint ();
+          double      W     = std::max (1e-6, bb.width ()  / 2);
+          double      H     = std::max (1e-6, bb.height () / 2);
+
+          map = [=] (const Point &p)
+            {
+              /*  normalized: u along the warp, v across, -1..1  */
+              double u = (p[0] - c[0]) / W, v = (p[1] - c[1]) / H;
+              double A = W, B = H;
+
+              if (vert)
+                {
+                  std::swap (u, v);
+                  std::swap (A, B);
+                }
+
+              double uu = u, vv = v;
+              double k  = std::max (0.0, 1 - u * u);
+
+              if (style == "arc")
+                vv = v - bend * k;
+              else if (style == "arc-lower")
+                vv = v + bend * k * (v + 1) / 2;
+              else if (style == "arc-upper")
+                vv = v - bend * k * (1 - v) / 2;
+              else if (style == "bulge")
+                vv = v * (1 + bend * k);
+              else if (style == "shell-lower")
+                vv = -1 + (v + 1) * (1 + bend * k * 0.5);
+              else if (style == "shell-upper")
+                vv = 1 - (1 - v) * (1 + bend * k * 0.5);
+              else if (style == "flag")
+                vv = v + bend * 0.5 * std::sin (M_PI * u);
+              else if (style == "wave")
+                vv = v + bend * 0.5 * std::sin (M_PI * u) * (1 - 0.5 * v);
+              else if (style == "fish")
+                vv = v * (1 + bend * std::sin (M_PI * (u + 1) / 2) * (1 - u) / 2);
+              else if (style == "rise")
+                vv = v - bend * std::sin (M_PI / 2 * u);
+              else if (style == "fisheye")
+                {
+                  double r = std::sqrt (u * u + v * v);
+
+                  if (r < 1)
+                    {
+                      double f = 1 + bend * (1 - r * r) * 0.6;
+
+                      uu = u * f;
+                      vv = v * f;
+                    }
+                }
+              else if (style == "inflate")
+                {
+                  uu = u * (1 + bend * 0.5 * std::max (0.0, 1 - v * v));
+                  vv = v * (1 + bend * 0.5 * k);
+                }
+              else if (style == "squeeze")
+                {
+                  uu = u * (1 + bend * 0.35 * std::max (0.0, 1 - v * v));
+                  vv = v * (1 - bend * 0.5 * k);
+                }
+              else if (style == "twist")
+                {
+                  double r = std::sqrt (u * u + v * v);
+                  double a = bend * M_PI * std::max (0.0, 1 - r / 1.4142);
+
+                  uu = u * std::cos (a) - v * std::sin (a);
+                  vv = u * std::sin (a) + v * std::cos (a);
+                }
+              else if (style == "arch")
+                {
+                  /*  the horizontal axis becomes an arc (as « bend »)  */
+                  double ang = bend * M_PI;
+
+                  if (std::fabs (ang) > 1e-4)
+                    {
+                      double R  = 2.0 * A / ang;
+                      double x  = u * A, y = v * B;
+                      double a  = x / R;
+                      double rr = R - y;
+
+                      uu = std::sin (a) * rr / A;
+                      vv = (R - std::cos (a) * rr) / B;
+                    }
+                }
+
+              /*  « Distorsion horizontale / verticale »: perspective  */
+              if (std::fabs (hd) > 1e-9)
+                {
+                  double f = 1 + hd * uu * 0.5;
+
+                  vv *= f;
+                }
+              if (std::fabs (vd) > 1e-9)
+                uu *= 1 + vd * vv * 0.5;
+
+              if (vert)
+                {
+                  std::swap (uu, vv);
+                  std::swap (A, B);
+                }
+
+              return Point (c[0] + uu * A, c[1] + vv * B);
+            };
+        }
+
+      return map;
+}
