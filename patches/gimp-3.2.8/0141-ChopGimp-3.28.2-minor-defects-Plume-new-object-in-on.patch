+
+void
+chopgimp_vobject_bar_sync_scale_strokes (void)
+{
+  gboolean on = chopgimp_rc_get_boolean ("vector", "scale-strokes", TRUE);
+
+  chopgimp_vobjects_set_scale_strokes (on);
+
+  for (GSList *l = scale_checks; l; l = l->next)
+    if (gtk_toggle_button_get_active (l->data) != on)
+      gtk_toggle_button_set_active (l->data, on);
