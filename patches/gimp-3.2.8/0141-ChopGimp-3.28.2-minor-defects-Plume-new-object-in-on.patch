+static void
+scale_check_toggled (GtkToggleButton *button,
+                     gpointer         data)
+{
+  gboolean on = gtk_toggle_button_get_active (button);
+
+  if (on != chopgimp_vobjects_get_scale_strokes ())
+    {
+      chopgimp_rc_set_boolean ("vector", "scale-strokes", on);
+      chopgimp_vobject_bar_sync_scale_strokes ();
