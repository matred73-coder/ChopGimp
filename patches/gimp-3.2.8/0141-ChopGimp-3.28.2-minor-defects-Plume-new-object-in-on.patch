+/*  3.28.2: PNG in memory with cairo  */
+static cairo_status_t
+png_write (void                *closure,
+           const unsigned char *data,
+           unsigned int         length)
+{
+  g_byte_array_append (closure, data, length);
+  return CAIRO_STATUS_SUCCESS;
+}
+
+typedef struct
+{
+  const guchar *data;
+  gsize         size;
+  gsize         pos;
+} PngRead;
+
+static cairo_status_t
+png_read (void          *closure,
+          unsigned char *data,
+          unsigned int   length)
+{
+  PngRead *rd = closure;
+
+  if (rd->pos + length > rd->size)
+    return CAIRO_STATUS_READ_ERROR;
+
+  memcpy (data, rd->data + rd->pos, length);
+  rd->pos += length;
+
+  return CAIRO_STATUS_SUCCESS;
+}
