+  g_idle_add (swatch_drag_clear_idle, NULL);
+}
+
+static void
+swatch_drop_color (GtkWidget *widget,
+                   gint       x,
+                   gint       y,
+                   GeglColor *color,
+                   gpointer   data)
+{
+  Panel       *p      = data;
+  const gchar *target = g_object_get_data (G_OBJECT (widget), "chopgimp-id");
+  const gchar *moved  = chopgimp_vcolors_get_dragged ();
+  GList       *colors;
+  gint         pos;
+
+  if (! p->image || ! target || ! moved || ! g_strcmp0 (target, moved))
+    return;
+
+  colors = chopgimp_vcolors_list (p->image);
+  pos    = 0;
+
+  for (GList *l = colors; l; l = l->next, pos++)
+    if (! g_strcmp0 (((const ChopGimpVColor *) l->data)->id, target))
+      break;
+
+  g_list_free (colors);
+
+  {
+    gchar *id = g_strdup (moved);
+
+    if (chopgimp_vcolors_reorder (p->image, id, pos, TRUE))
+      {
+        g_free (p->selected);
+        p->selected = g_strdup (id);
+        gimp_image_flush (p->image);
+      }
+    g_free (id);
+  }
+}
