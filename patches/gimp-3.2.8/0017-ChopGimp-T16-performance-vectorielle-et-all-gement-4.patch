 static void             gimp_canvas_path_stroke       (GimpCanvasItem *item,
                                                        cairo_t        *cr);
+static void             gimp_canvas_path_fill         (GimpCanvasItem *item,
+                                                       cairo_t        *cr);
 
 
 G_DEFINE_TYPE_WITH_PRIVATE (GimpCanvasPath, gimp_canvas_path,
@@ -98,6 +103,7 @@ gimp_canvas_path_class_init (GimpCanvasPathClass *klass)
   item_class->draw           = gimp_canvas_path_draw;
   item_class->get_extents    = gimp_canvas_path_get_extents;
   item_class->stroke         = gimp_canvas_path_stroke;
+  item_class->fill           = gimp_canvas_path_fill;
 
   g_object_class_install_property (object_class, PROP_PATH,
                                    g_param_spec_boxed ("path", NULL, NULL,
@@ -319,6 +325,49 @@ gimp_canvas_path_stroke (GimpCanvasItem *item,
     }
 }
 
+static void
+gimp_canvas_path_fill (GimpCanvasItem *item,
+                       cairo_t        *cr)
+{
+  GimpCanvasPathPrivate *private = GET_PRIVATE (item);
+
+  if (private->has_fill_rgba)
+    {
+      cairo_set_source_rgba (cr, private->fill_rgba[0], private->fill_rgba[1],
+                             private->fill_rgba[2], private->fill_rgba[3]);
+      cairo_fill (cr);
+    }
+  else
+    {
+      GIMP_CANVAS_ITEM_CLASS (parent_class)->fill (item, cr);
+    }
+}
+
+/*  4.0.0: a filled path drawn in @color (with @opacity) instead of the
+ *  canvas style (preview of the Blob brush in the color of its result)
+ */
+void
+gimp_canvas_path_set_fill_color (GimpCanvasItem *path,
+                                 GeglColor      *color,
+                                 gdouble         opacity)
+{
+  GimpCanvasPathPrivate *private;
+
+  g_return_if_fail (GIMP_IS_CANVAS_PATH (path));
+
+  private = GET_PRIVATE (path);
+  private->has_fill_rgba = (color != NULL);
+
+  if (color)
+    {
+      gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), private->fill_rgba);
+      private->fill_rgba[3] *= CLAMP (opacity, 0.0, 1.0);
+    }
+
+  gimp_canvas_item_begin_change (path);
+  gimp_canvas_item_end_change (path);
+}
+
 GimpCanvasItem *
 gimp_canvas_path_new (GimpDisplayShell     *shell,
                       const GimpBezierDesc *bezier,
