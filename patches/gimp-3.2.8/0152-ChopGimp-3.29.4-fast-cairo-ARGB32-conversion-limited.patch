From 65775d0b40016e1ae93d8935fd0cf5a953db31e4 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Thu, 26 Nov 2026 08:55:49 +0100
Subject: [PATCH 152/152] ChopGimp 3.29.4: fast cairo-ARGB32 conversion limited
 to 8-bit layers (16- and 32-bit layers keep babl's conversion, no 8-bit
 quantization of their edges)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/path/chopgimp-vobject.c | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/app/path/chopgimp-vobject.c b/app/path/chopgimp-vobject.c
index 51ec456..158b060 100644
--- a/app/path/chopgimp-vobject.c
+++ b/app/path/chopgimp-vobject.c
@@ -4475,7 +4475,8 @@ union_ibounds (GimpVectorLayer *layer,
  *  vectorization).  The pixels are unpremultiplied here instead, in place
  *  and in parallel, to R'G'B'A u8 of the layer's space (same TRC: no color
  *  conversion), which is copied as is into an 8-bit perceptual layer and
- *  converted by babl's fast paths otherwise.  Result: round (c × 255 / a),
+ *  converted by babl's fast paths otherwise (8-bit layers only: 16- and
+ *  32-bit layers keep babl's conversion).  Result: round (c × 255 / a),
  *  what the reference conversion gives (± 1 at exact halves).
  *  CHOPGIMP_NO_FAST_BABL=1: babl's conversion as before.
  */
@@ -4570,7 +4571,13 @@ put_argb32 (GeglBuffer          *buffer,
   if (rect->width <= 0 || rect->height <= 0)
     return;
 
-  if (! fast_babl_enabled ())
+  /*  only 8-bit layers: unpremultiplying to u8 would quantize a 16- or
+   *  32-bit layer's semi-transparent edges to 8 bits; those keep babl's
+   *  conversion from the premultiplied data
+   */
+  if (! fast_babl_enabled () ||
+      babl_format_get_type (gegl_buffer_get_format (buffer), 0) !=
+      babl_type ("u8"))
     {
       gegl_buffer_set (buffer, rect, 0,
                        babl_format_with_space ("cairo-ARGB32", space),
-- 
2.53.0

