From f05f37a493c33cd4ec8df8b1c7679f01206c4533 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Wed, 11 Nov 2026 18:59:22 +0100
Subject: [PATCH 14/30] ChopGimp: click on the active tool group opens its tool
 list

---
 app/widgets/gimptoolbutton.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/app/widgets/gimptoolbutton.c b/app/widgets/gimptoolbutton.c
index 6e2912f..2be1579 100644
--- a/app/widgets/gimptoolbutton.c
+++ b/app/widgets/gimptoolbutton.c
@@ -629,6 +629,16 @@ gimp_tool_button_button_press (GtkWidget      *widget,
         {
           return TRUE;
         }
+      /*  ChopGimp: clicking a tool group whose tool is already active opens
+       *  the group's tool list at once (no need to right-click or hold).
+       */
+      else if (gdk_event_get_event_type ((GdkEvent *) event) == GDK_BUTTON_PRESS &&
+               event->button == 1 &&
+               gtk_toggle_tool_button_get_active (GTK_TOGGLE_TOOL_BUTTON (tool_button)) &&
+               gimp_tool_button_show_menu (tool_button, (GdkEvent *) event))
+        {
+          return TRUE;
+        }
       else if (gdk_event_get_event_type ((GdkEvent *) event) == GDK_BUTTON_PRESS && event->button == 1 &&
                ! tool_button->priv->menu_timeout_id)
         {
-- 
