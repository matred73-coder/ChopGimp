 }
 
+/*  3.29.6: 16- and 32-bit layers.  The premultiplied ARGB32 pixels are
+ *  unpremultiplied to R'G'B'A float (c / a exactly, in parallel), which
+ *  babl converts by its fast paths to any layer format; no quantization
+ *  to 8 bits of the unpremultiplied values (the semi-transparent edges keep
+ *  what the reference conversion gives).  CHOPGIMP_NO_FAST_FLOAT=1:
+ *  babl's reference conversion as before.
+ */
+typedef struct
+{
+  const guchar *data;
+  gint          stride;
+  gint          width;
+  gfloat       *out;
+} FloatJob;
+
+static void
+unpremul_float_rows (gsize    offset,
+                     gsize    size,
+                     gpointer user_data)
+{
+  FloatJob *job = user_data;
+
+  for (gsize y = offset; y < offset + size; y++)
+    {
+      const guint32 *px = (const guint32 *) (job->data + y * job->stride);
+      gfloat        *o  = job->out + y * (gsize) job->width * 4;
+
+      for (gint x = 0; x < job->width; x++, o += 4)
+        {
+          guint32 p = px[x];               /* native-endian ARGB */
+          guint   a = p >> 24;
+
+          if (a == 0)
+            {
+              o[0] = o[1] = o[2] = o[3] = 0.0f;
+            }
+          else
+            {
+              gfloat k = 1.0f / (gfloat) a;
+
+              o[0] = MIN (1.0f, ((p >> 16) & 0xff) * k);
+              o[1] = MIN (1.0f, ((p >>  8) & 0xff) * k);
+              o[2] = MIN (1.0f, ( p        & 0xff) * k);
+              o[3] = a / 255.0f;
+            }
+        }
+    }
+}
+
+static gboolean
+put_argb32_float (GeglBuffer          *buffer,
+                  const GeglRectangle *rect,
+                  const Babl          *space,
+                  const guchar        *data,
+                  gint                 stride)
+{
+  FloatJob job = { data, stride, rect->width, NULL };
+
+  if (g_getenv ("CHOPGIMP_NO_FAST_FLOAT"))
+    return FALSE;
+
+  job.out = g_try_malloc ((gsize) rect->width * rect->height * 4 * sizeof (gfloat));
+  if (! job.out)
+    return FALSE;
+
+  gegl_parallel_distribute_range (rect->height,
+                                  MAX (1, 32768 / MAX (1, rect->width)),
+                                  unpremul_float_rows, &job);
+
+  gegl_buffer_set (buffer, rect, 0,
+                   babl_format_with_space ("R'G'B'A float", space),
+                   job.out, GEGL_AUTO_ROWSTRIDE);
+
+  g_free (job.out);
+
+  return TRUE;
+}
+
 /*  writes a cairo ARGB32 image (@data, @stride, @rect's size) into @rect
  *  of @buffer; @data is modified (unpremultiplied in place)
  */
@@ -4583,6 +4802,11 @@ put_argb32 (GeglBuffer          *buffer,
       babl_format_get_type (gegl_buffer_get_format (buffer), 0) !=
       babl_type ("u8"))
     {
+      /*  3.29.6: 16 / 32 bits through float  */
+      if (fast_babl_enabled () &&
+          put_argb32_float (buffer, rect, space, data, stride))
+        return;
+
       gegl_buffer_set (buffer, rect, 0,
                        babl_format_with_space ("cairo-ARGB32", space),
                        data, stride);
@@ -4882,6 +5106,8 @@ vlayer_write_legacy (GimpVectorLayer *layer,
