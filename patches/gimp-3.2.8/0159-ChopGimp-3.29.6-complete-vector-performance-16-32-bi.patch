 app/path/chopgimp-vmaterial.h |   8 +
 app/path/chopgimp-vobject.c   | 600 ++++++++++++++++++++++++++++++++--
 app/path/chopgimp-vobject.h   |   3 +
 4 files changed, 648 insertions(+), 28 deletions(-)

