+/*  3.29.6: what the drawing of @o would make on demand from shared state
+ *  (GimpPath items of the image, cells of the vector patterns) is made
+ *  here, on the main thread; FALSE: @o is drawn one by one
+ */
+static gboolean
+par_prepare_leaf (ChopGimpVObject *o,
+                  GimpPath        *path)
+{
+  const ChopGimpVStyle *st = &o->style;
+
+  for (gint k = 0; k < chopgimp_vstyle_get_n_entries (st); k++)
+    {
+      ChopGimpVEntry       *e = chopgimp_vstyle_get_entry (st, k);
+      const ChopGimpVEntry *f;
+
+      if (! chopgimp_ventry_is_painted (e))
+        continue;
+
+      f = e->follow_fill ? chopgimp_vstyle_get_fill (st) : NULL;
+
+      if (! chopgimp_vmaterial_prepare_pattern (f ? &f->paint : &e->paint, path))
+        return FALSE;
+
+      /*  the same outline as draw_entry()'s profiled branch  */
+      if (e->kind == CHOPGIMP_VENTRY_STROKE && ! profile_is_uniform (e->profile) &&
+          ! g_hash_table_contains (par_outlines, e))
+        {
+          ChopGimpVEntry  e2 = *e;
+          GimpPath       *outline;
+
+          if (path_all_closed (path) && e->align != CHOPGIMP_STROKE_ALIGN_CENTER)
+            e2.width = e->width * 2.0;
+
+          outline = profile_outline (path, &e2);
+
+          if (outline)
+            gimp_path_get_bezier (outline);   /* made on demand */
+
+          /*  NULL kept too: nothing to draw, nothing to make  */
+          g_hash_table_insert (par_outlines, e, outline);
+        }
+    }
+
+  return TRUE;
+}
