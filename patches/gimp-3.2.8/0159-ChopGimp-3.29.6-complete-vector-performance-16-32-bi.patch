+/*  3.29.6: after an undo / redo, the legacy path is rewritten from the
+ *  objects later (once for several undo steps in a row), before the next
+ *  events; anything that reads it first (a new change, the XCF, a
+ *  replaced legacy path) writes it at once.  CHOPGIMP_NO_LAZY_LEGACY=1:
+ *  rewritten at every step as before.
+ */
+#define LEGACY_IDLE_KEY "chopgimp-legacy-idle"
+
+static void
+vlayer_flush_legacy (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+
+  if (vl && vl->legacy_dirty && vl->interactive == 0)
+    {
+      vlayer_write_legacy (layer, TRUE, FALSE);
+      vl->legacy_dirty = FALSE;
+    }
+}
+
+static gboolean
+legacy_idle (gpointer data)
+{
+  GimpVectorLayer *layer = data;
+
+  g_object_set_data (G_OBJECT (layer), LEGACY_IDLE_KEY, NULL);
+  vlayer_flush_legacy (layer);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+vlayer_write_legacy_later (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+
+  if (g_getenv ("CHOPGIMP_NO_LAZY_LEGACY") || vl->legacy)
+    {
+      vlayer_write_legacy (layer, TRUE, FALSE);
+      return;
+    }
+
+  vl->legacy_dirty = TRUE;
+
+  if (! g_object_get_data (G_OBJECT (layer), LEGACY_IDLE_KEY))
+    {
+      g_object_set_data (G_OBJECT (layer), LEGACY_IDLE_KEY, GINT_TO_POINTER (1));
+      g_idle_add_full (G_PRIORITY_HIGH, legacy_idle,
+                       g_object_ref (layer), g_object_unref);
+    }
+}
