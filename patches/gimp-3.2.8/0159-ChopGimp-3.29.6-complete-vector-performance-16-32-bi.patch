@@ -5533,6 +5772,244 @@ snapshot_fix (ChopGimpVObject *src,
                     g_ptr_array_index (dst->children, i));
 }
 
+/*  3.29.6 « annulation partielle »: a snapshot keeps only the leaves that
+ *  changed since the previous one (copies), and shares the others with
+ *  it (same objects, never changed while in snapshots: a leaf is copied
+ *  or swapped when its snapshot becomes the layer's objects again).  A
+ *  leaf is unchanged when it has the same revision (every change of the
+ *  rendering makes a new one), the same attributes and the same place in
+ *  the image (world matrix: its cached rendering stays right).  Undo and
+ *  redo swap the unchanged leaves of both states instead of copying them.
+ *  CHOPGIMP_NO_PARTIAL_UNDO=1: the whole tree is copied (3.29.2).
+ */
+static gboolean
+partial_undo_enabled (void)
+{
+  /*  read once: a snapshot made with it must be installed with it  */
+  static gint enabled = -1;
+
+  if (enabled < 0)
+    enabled = fast_undo_enabled () && g_getenv ("CHOPGIMP_NO_PARTIAL_UNDO") == NULL;
+
+  return enabled;
+}
+
+typedef struct
+{
+  ChopGimpVObject *node;
+  GimpMatrix3      world;
+} SnapRef;
+
+typedef struct
+{
+  GPtrArray   *array;      /* the children of its group */
+  guint        index;
+  GimpMatrix3  world;
+} SnapSlot;
+
+static void
+world_of_child (const GimpMatrix3     *parent_world,
+                const ChopGimpVObject *o,
+                GimpMatrix3           *world)
+{
+  *world = o->transform;
+
+  if (parent_world)
+    gimp_matrix3_mult (parent_world, world);
+}
+
+static gboolean
+leaf_same (const ChopGimpVObject *a,
+           const GimpMatrix3     *wa,
+           const ChopGimpVObject *b,
+           const GimpMatrix3     *wb)
+{
+  return (a->kind == CHOPGIMP_VOBJECT_PATH && b->kind == CHOPGIMP_VOBJECT_PATH &&
+          a->id == b->id && a->rev == b->rev &&
+          a->visible == b->visible && a->locked == b->locked &&
+          a->opacity == b->opacity && a->mode == b->mode &&
+          a->clip == b->clip && a->opmask == b->opmask &&
+          ! memcmp (&a->transform, &b->transform, sizeof (GimpMatrix3)) &&
+          ! memcmp (wa, wb, sizeof (GimpMatrix3)) &&
+          ! g_strcmp0 (a->name, b->name) && ! g_strcmp0 (a->lpe, b->lpe) &&
+          ! g_strcmp0 (a->livepaint, b->livepaint) &&
+          ! g_strcmp0 (a->symbol, b->symbol) && ! g_strcmp0 (a->blend, b->blend) &&
+          (a->path == NULL) == (b->path == NULL) &&
