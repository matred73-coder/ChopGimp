+static gboolean
+par_ext_enabled (void)
+{
+  return g_getenv ("CHOPGIMP_NO_PAR_RENDER_EXT") == NULL;
+}
+
+/*  the precomputed outlines of the profiled strokes (entry → GimpPath),
+ *  only while cache_leaves_parallel() runs; read-only for the threads
+ */
+static GHashTable *par_outlines = NULL;
+
+static void
