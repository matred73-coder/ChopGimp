+  if (ext)
+    return TRUE;
+
   for (gint k = 0; k < chopgimp_vstyle_get_n_entries (st); k++)
     {
       const ChopGimpVEntry *e = chopgimp_vstyle_get_entry (st, k);
@@ -4207,8 +4278,55 @@ typedef struct
   GArray          *rects;
