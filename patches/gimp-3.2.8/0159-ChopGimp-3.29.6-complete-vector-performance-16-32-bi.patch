+/*  the leaves of a snapshot by id, with their world matrix  */
+static void
+snap_index (ChopGimpVObject   *o,
+            const GimpMatrix3 *parent_world,
+            GHashTable        *ids)
+{
+  GimpMatrix3 w;
+
+  world_of_child (parent_world, o, &w);
+
+  if (o->kind != CHOPGIMP_VOBJECT_GROUP)
+    {
+      SnapRef *r = g_new (SnapRef, 1);
+
+      r->node  = o;
+      r->world = w;
+      g_hash_table_insert (ids, GUINT_TO_POINTER (o->id), r);
+    }
+  else if (o->children)
+    {
+      for (guint i = 0; i < o->children->len; i++)
+        snap_index (g_ptr_array_index (o->children, i), &w, ids);
+    }
+}
+
+/*  a snapshot of the live @o: the leaves of @prev that are unchanged are
+ *  shared, the others copied; the groups are always copied (their
+ *  parents are set by vlayer_reindex())
+ */
+static ChopGimpVObject *
+snap_copy (ChopGimpVObject   *o,
+           const GimpMatrix3 *parent_world,
+           GHashTable        *prev,
+           GimpImage         *image)
+{
+  ChopGimpVObject *c;
+  GimpMatrix3      w;
+
+  world_of_child (parent_world, o, &w);
+
+  if (o->kind != CHOPGIMP_VOBJECT_GROUP)
+    {
+      SnapRef *r = prev ? g_hash_table_lookup (prev, GUINT_TO_POINTER (o->id)) : NULL;
+
+      if (r && r->node != o && leaf_same (o, &w, r->node, &r->world))
+        return chopgimp_vobject_ref (r->node);
+
+      c = chopgimp_vobject_copy (o, image);
+      snapshot_fix (o, c);
+
+      return c;
+    }
+
+  c = vobj_alloc (CHOPGIMP_VOBJECT_GROUP, o->name);
+  vobj_copy_attrs (c, o);
+  snapshot_fix_one (o, c);
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      g_ptr_array_add (c->children,
+                       snap_copy (g_ptr_array_index (o->children, i), &w, prev, image));
+
+  return c;
+}
+
+static void
+slots_collect (ChopGimpVObject   *g,
+               const GimpMatrix3 *gw,
+               GHashTable        *slots)
+{
+  for (guint i = 0; g->children && i < g->children->len; i++)
+    {
+      ChopGimpVObject *o = g_ptr_array_index (g->children, i);
+      GimpMatrix3      w;
+
+      world_of_child (gw, o, &w);
+
+      if (o->kind == CHOPGIMP_VOBJECT_GROUP)
+        {
+          slots_collect (o, &w, slots);
+        }
+      else
+        {
+          SnapSlot *slot = g_new (SnapSlot, 1);
+
+          slot->array = g->children;
+          slot->index = i;
+          slot->world = w;
+          g_hash_table_insert (slots, GUINT_TO_POINTER (o->id), slot);
+        }
+    }
+}
+
+static void
+adopt_rec (ChopGimpVObject   *g,
+           const GimpMatrix3 *gw,
+           GHashTable        *slots,
+           GimpImage         *image)
+{
+  for (guint i = 0; g->children && i < g->children->len; i++)
+    {
+      ChopGimpVObject *s = g_ptr_array_index (g->children, i);
+      GimpMatrix3      w;
+      SnapSlot        *slot;
+      ChopGimpVObject *l;
+
+      world_of_child (gw, s, &w);
+
+      if (s->kind == CHOPGIMP_VOBJECT_GROUP)
+        {
+          adopt_rec (s, &w, slots, image);
+          continue;
+        }
+
+      slot = g_hash_table_lookup (slots, GUINT_TO_POINTER (s->id));
+      l    = slot ? g_ptr_array_index (slot->array, slot->index) : NULL;
+
+      if (l && l != s && leaf_same (l, &slot->world, s, &w))
+        {
+          /*  the live leaf stays live, the snapshot's goes to the other
+           *  state (same content, same place)
+           */
+          g->children->pdata[i]               = l;
+          slot->array->pdata[slot->index]     = s;
+          g_hash_table_remove (slots, GUINT_TO_POINTER (s->id));
+        }
+      else if (s->ref_count > 1)
+        {
+          /*  shared with other snapshots: a copy becomes live  */
+          ChopGimpVObject *c = chopgimp_vobject_copy (s, image);
+
+          snapshot_fix (s, c);
+          g->children->pdata[i] = c;
+          chopgimp_vobject_unref (s);
+        }
+    }
+}
+
+/*  @vl (a snapshot) becomes the objects of the layer instead of @old
+ *  (which becomes a snapshot): no leaf of @vl stays shared
+ */
+static void
+snap_adopt (ChopGimpVLayer *vl,
+            ChopGimpVLayer *old,
+            GimpImage      *image)
+{
+  GHashTable  *slots = g_hash_table_new_full (NULL, NULL, NULL, g_free);
+  GimpMatrix3  ow, nw;
+
+  world_of_child (NULL, old->root, &ow);
+  world_of_child (NULL, vl->root, &nw);
+
+  slots_collect (old->root, &ow, slots);
+  adopt_rec (vl->root, &nw, slots, image);
+  g_hash_table_unref (slots);
+
+  vlayer_reindex (vl);
+  vlayer_reindex (old);
+
+  /*  the effective paths follow the layer's effects  */
+  if (g_strcmp0 (vl->layer_lpe, old->layer_lpe))
+    vobj_invalidate (vl->root);
+
+  /*  the next snapshot shares with the state left  */
+  vl->snap_prev = chopgimp_vobject_ref (old->root);
+  vl->snap_ids  = g_hash_table_new_full (NULL, NULL, NULL, g_free);
+  snap_index (old->root, NULL, vl->snap_ids);
+}
