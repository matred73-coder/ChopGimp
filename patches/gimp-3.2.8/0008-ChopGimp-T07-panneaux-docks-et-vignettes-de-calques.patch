+}
+
+static void
+chopgimp_fx_strip_dispose (GObject *object)
+{
+  ChopGimpFxStrip *strip = CHOPGIMP_FX_STRIP (object);
+
+  chopgimp_fx_strip_set_drawable (strip, NULL);
+
+  if (strip->rebuild_idle)
+    {
+      g_source_remove (strip->rebuild_idle);
+      strip->rebuild_idle = 0;
+    }
+
+  G_OBJECT_CLASS (parent_class)->dispose (object);
+}
+
+
+/*  public functions  */
+
+GtkWidget *
+chopgimp_fx_strip_new (void)
+{
+  return g_object_new (CHOPGIMP_TYPE_FX_STRIP, NULL);
+}
+
+static void
+fx_strip_drawable_finalized (gpointer  data,
+                             GObject  *where_the_object_was)
+{
+  ChopGimpFxStrip *strip = CHOPGIMP_FX_STRIP (data);
+
+  strip->drawable       = NULL;
+  strip->active_handler = 0;
+
+  fx_strip_queue_rebuild (strip);
+}
+
+static void
+fx_strip_filter_active_changed (GimpFilter      *filter,
+                                ChopGimpFxStrip *strip)
+{
+  fx_strip_queue_rebuild (strip);
+}
+
+void
+chopgimp_fx_strip_set_drawable (ChopGimpFxStrip *strip,
+                                GimpDrawable    *drawable)
+{
+  g_return_if_fail (CHOPGIMP_IS_FX_STRIP (strip));
+  g_return_if_fail (drawable == NULL || GIMP_IS_DRAWABLE (drawable));
+
+  if (drawable == strip->drawable)
+    return;
+
+  if (strip->drawable)
+    {
+      if (strip->active_handler)
+        gimp_container_remove_handler (gimp_drawable_get_filters (strip->drawable),
+                                       strip->active_handler);
+      strip->active_handler = 0;
+
+      g_signal_handlers_disconnect_by_func (strip->drawable,
+                                            fx_strip_queue_rebuild,
+                                            strip);
+      g_object_weak_unref (G_OBJECT (strip->drawable),
+                           fx_strip_drawable_finalized, strip);
+    }
+
+  strip->drawable = drawable;
+
+  if (strip->drawable)
+    {
+      g_object_weak_ref (G_OBJECT (strip->drawable),
+                         fx_strip_drawable_finalized, strip);
+      g_signal_connect_swapped (strip->drawable, "filters-changed",
+                                G_CALLBACK (fx_strip_queue_rebuild),
+                                strip);
+      strip->active_handler =
+        gimp_container_add_handler (gimp_drawable_get_filters (strip->drawable),
+                                    "active-changed",
+                                    G_CALLBACK (fx_strip_filter_active_changed),
+                                    strip);
+    }
+
+  /*  at once: the strip shows / hides with the selection, no flicker  */
+  if (strip->rebuild_idle)
+    {
+      g_source_remove (strip->rebuild_idle);
+      strip->rebuild_idle = 0;
+    }
+
+  if (! gtk_widget_in_destruction (GTK_WIDGET (strip)))
+    fx_strip_rebuild (strip);
+}
+
+
+/*  private functions  */
+
+static gboolean
+fx_strip_rebuild_idle (gpointer data)
+{
+  ChopGimpFxStrip *strip = CHOPGIMP_FX_STRIP (data);
+
+  strip->rebuild_idle = 0;
+  fx_strip_rebuild (strip);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+fx_strip_queue_rebuild (ChopGimpFxStrip *strip)
+{
+  if (! strip->rebuild_idle)
+    strip->rebuild_idle = g_idle_add (fx_strip_rebuild_idle, strip);
+}
+
+/*  the editable effects of the drawable, from the top of the stack  */
+static GList *
+fx_strip_get_filters (ChopGimpFxStrip *strip)
+{
+  GimpContainer *filters;
+  GList         *result = NULL;
+  GList         *list;
+
+  if (! strip->drawable)
+    return NULL;
+
+  filters = gimp_drawable_get_filters (strip->drawable);
+
+  if (! GIMP_IS_LIST (filters))
+    return NULL;
+
+  for (list = GIMP_LIST (filters)->queue->head; list; list = g_list_next (list))
+    {
+      if (GIMP_IS_DRAWABLE_FILTER (list->data) &&
+          ! gimp_drawable_filter_get_temporary (list->data))
+        result = g_list_prepend (result, list->data);
+    }
+
+  return g_list_reverse (result);
+}
+
+/*  a filter given by a row, if it is still one of the drawable's  */
+static GimpDrawableFilter *
+fx_strip_row_filter (ChopGimpFxStrip *strip,
+                     GtkWidget       *widget)
+{
+  gpointer filter = g_object_get_data (G_OBJECT (widget), "chopgimp-filter");
+
+  if (! filter || ! strip->drawable ||
+      ! gimp_container_have (gimp_drawable_get_filters (strip->drawable),
+                             filter))
+    return NULL;
+
+  return filter;
+}
+
+/*  "Contour..." -> "Contour"; two filters of the same effect are numbered
+ *  from the bottom, as in the popover: "Contour (1)", "Contour (2)"
+ */
+static gsize
+fx_strip_base_length (const gchar *name)
+{
+  gsize len = strlen (name);
+
+  while (len > 0)
+    {
+      if (len >= 3 && ! strncmp (name + len - 3, "...", 3))
+        len -= 3;
+      else if (len >= 3 && ! strncmp (name + len - 3, "…", 3))
+        len -= 3;
+      else if (name[len - 1] == ' ')
+        len--;
+      else
+        break;
+    }
+
+  return len;
+}
+
+static gchar *
+fx_strip_filter_name (GList    *filters,
+                      gpointer  filter)
+{
+  const gchar *name = gimp_object_get_name (filter);
+  gsize        base_len;
+  gint         count = 0;
+  gint         index = 0;
+  GList       *list;
+
+  if (! name)
+    return g_strdup ("?");
+
+  base_len = fx_strip_base_length (name);
+
+  for (list = g_list_last (filters); list; list = g_list_previous (list))
+    {
+      const gchar *other = gimp_object_get_name (list->data);
+
+      if (other                                        &&
+          fx_strip_base_length (other) == base_len     &&
+          ! strncmp (other, name, base_len))
+        {
+          count++;
+
+          if (list->data == filter)
+            index = count;
+        }
+    }
+
+  if (count > 1 && index > 0)
+    {
+      gchar *base = g_strndup (name, base_len);
+      gchar *text = g_strdup_printf ("%s (%d)", base, index);
+
+      g_free (base);
+
+      return text;
+    }
+
+  return g_strndup (name, base_len);
+}
+
+static void
+fx_strip_rebuild (ChopGimpFxStrip *strip)
+{
+  GList    *filters;
+  GList    *list;
+  GString  *summary;
+  GList    *children;
+  gboolean  any_visible = FALSE;
+
+  children = gtk_container_get_children (GTK_CONTAINER (strip->list));
+  for (list = children; list; list = g_list_next (list))
+    gtk_widget_destroy (list->data);
+  g_list_free (children);
+
+  filters = fx_strip_get_filters (strip);
+
+  if (! filters)
+    {
+      gtk_widget_set_visible (GTK_WIDGET (strip), FALSE);
+      return;
+    }
+
+  summary = g_string_new (NULL);
+
+  for (list = filters; list; list = g_list_next (list))
+    {
+      GimpFilter *filter = list->data;
+      gchar      *name   = fx_strip_filter_name (filters, filter);
+      gboolean    active = gimp_filter_get_active (filter);
+      GtkWidget  *row;
+      GtkWidget  *eye;
+      GtkWidget  *image;
+      GtkWidget  *event_box;
+      GtkWidget  *label;
+      GtkWidget  *edit;
+
+      if (active)
+        any_visible = TRUE;
+
+      if (summary->len)
+        g_string_append (summary, ", ");
+      g_string_append (summary, name);
+
+      row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+      gtk_style_context_add_class (gtk_widget_get_style_context (row),
+                                   "chopgimp-fx-row");
+      if (! active)
+        gtk_style_context_add_class (gtk_widget_get_style_context (row),
+                                     "chopgimp-fx-off");
+      gtk_box_pack_start (GTK_BOX (strip->list), row, FALSE, FALSE, 0);
+      gtk_widget_set_visible (row, TRUE);
+
+      /*  👁  */
+      eye = gtk_toggle_button_new ();
+      gtk_button_set_relief (GTK_BUTTON (eye), GTK_RELIEF_NONE);
+      gtk_widget_set_can_focus (eye, FALSE);
+      gtk_style_context_add_class (gtk_widget_get_style_context (eye),
+                                   "chopgimp-fx-eye");
+      gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (eye), active);
+      gimp_help_set_help_data (eye, _("Afficher ou masquer cet effet"), NULL);
+      g_object_set_data (G_OBJECT (eye), "chopgimp-filter", filter);
+      gtk_box_pack_start (GTK_BOX (row), eye, FALSE, FALSE, 0);
+      gtk_widget_set_visible (eye, TRUE);
+
+      image = gtk_image_new_from_icon_name (GIMP_ICON_VISIBLE,
+                                            GTK_ICON_SIZE_MENU);
+      gtk_image_set_pixel_size (GTK_IMAGE (image), 16);
+      gtk_widget_set_opacity (image, active ? 1.0 : 0.25);
+      gtk_container_add (GTK_CONTAINER (eye), image);
+      gtk_widget_set_visible (image, TRUE);
+
+      g_signal_connect (eye, "toggled",
+                        G_CALLBACK (fx_strip_filter_toggled),
+                        strip);
+
+      /*  name, double click = edit  */
+      event_box = gtk_event_box_new ();
+      gtk_event_box_set_visible_window (GTK_EVENT_BOX (event_box), FALSE);
+      g_object_set_data (G_OBJECT (event_box), "chopgimp-filter", filter);
+      gtk_box_pack_start (GTK_BOX (row), event_box, TRUE, TRUE, 0);
+      gtk_widget_set_visible (event_box, TRUE);
+
+      g_signal_connect (event_box, "button-press-event",
+                        G_CALLBACK (fx_strip_name_pressed),
+                        strip);
+
+      label = gtk_label_new (name);
+      gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+      gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_END);
+      gtk_container_add (GTK_CONTAINER (event_box), label);
+      gtk_widget_set_visible (label, TRUE);
+
+      gimp_help_set_help_data (event_box,
+                               _("Double-clic : modifier l'effet"), NULL);
+
+      /*  ✎  */
+      edit = gtk_button_new_from_icon_name (GIMP_ICON_EDIT, GTK_ICON_SIZE_MENU);
+      gtk_button_set_relief (GTK_BUTTON (edit), GTK_RELIEF_NONE);
+      gtk_widget_set_can_focus (edit, FALSE);
+      gtk_style_context_add_class (gtk_widget_get_style_context (edit),
+                                   "chopgimp-fx-edit");
+      gimp_help_set_help_data (edit, _("Modifier l'effet"), NULL);
+      g_object_set_data (G_OBJECT (edit), "chopgimp-filter", filter);
+      gtk_box_pack_end (GTK_BOX (row), edit, FALSE, FALSE, 0);
+      gtk_widget_set_visible (edit, TRUE);
+
+      g_signal_connect (edit, "clicked",
+                        G_CALLBACK (fx_strip_edit_clicked),
+                        strip);
+
+      g_free (name);
+    }
+
+  gtk_label_set_text (GTK_LABEL (strip->summary), summary->str);
+  gimp_help_set_help_data (strip->summary, summary->str, NULL);
+  g_string_free (summary, TRUE);
+
+  g_signal_handlers_block_by_func (strip->all_toggle,
+                                   fx_strip_all_toggled, strip);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (strip->all_toggle),
+                                any_visible);
+  g_signal_handlers_unblock_by_func (strip->all_toggle,
+                                     fx_strip_all_toggled, strip);
+  gtk_widget_set_opacity (strip->all_image, any_visible ? 1.0 : 0.25);
+
+  gtk_image_set_from_icon_name (GTK_IMAGE (strip->arrow),
+                                fx_strip_expanded ?
+                                "pan-down-symbolic" : "pan-end-symbolic",
+                                GTK_ICON_SIZE_MENU);
+  gtk_widget_set_visible (strip->list, fx_strip_expanded);
+  gtk_widget_set_visible (strip->summary, ! fx_strip_expanded);
+
+  gtk_widget_set_visible (GTK_WIDGET (strip), TRUE);
+
+  g_list_free (filters);
+}
+
+static void
+fx_strip_update_drawable (ChopGimpFxStrip *strip)
+{
+  gimp_drawable_update (strip->drawable, 0, 0, -1, -1);
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (strip->drawable)));
+}
+
+static void
+fx_strip_header_clicked (GtkButton       *button,
+                         ChopGimpFxStrip *strip)
+{
+  fx_strip_expanded = ! fx_strip_expanded;
+
+  fx_strip_rebuild (strip);
+}
+
+static void
+fx_strip_all_toggled (GtkToggleButton *button,
+                      ChopGimpFxStrip *strip)
+{
+  GList    *filters = fx_strip_get_filters (strip);
+  GList    *list;
+  gboolean  visible = gtk_toggle_button_get_active (button);
+
+  if (! filters)
+    return;
+
+  for (list = filters; list; list = g_list_next (list))
+    gimp_filter_set_active (list->data, visible);
+
+  g_list_free (filters);
+
+  fx_strip_update_drawable (strip);
+}
+
+static void
+fx_strip_filter_toggled (GtkToggleButton *button,
+                         ChopGimpFxStrip *strip)
+{
+  GimpDrawableFilter *filter = fx_strip_row_filter (strip, GTK_WIDGET (button));
+
+  if (! filter)
+    return;
+
+  gimp_filter_set_active (GIMP_FILTER (filter),
+                          gtk_toggle_button_get_active (button));
+
+  fx_strip_update_drawable (strip);
+}
+
+/*  as gimp_drawable_filters_editor_edit_clicked()
+ *  (gimpdrawabletreeview-filters.c)
+ */
+static void
+fx_strip_edit_filter (ChopGimpFxStrip    *strip,
+                      GimpDrawableFilter *filter)
+{
+  GimpImage *image = gimp_item_get_image (GIMP_ITEM (strip->drawable));
+  GeglNode  *op;
+
+  if (! gimp_item_is_visible (GIMP_ITEM (strip->drawable)) &&
+      ! GIMP_GUI_CONFIG (image->gimp->config)->edit_non_visible)
+    {
+      gimp_message_literal (image->gimp, G_OBJECT (strip),
+                            GIMP_MESSAGE_ERROR,
+                            _("A selected layer is not visible."));
+      return;
+    }
+  else if (gimp_item_get_lock_content (GIMP_ITEM (strip->drawable)))
+    {
+      gimp_message_literal (image->gimp, G_OBJECT (strip),
+                            GIMP_MESSAGE_WARNING,
+                            _("A selected layer's pixels are locked."));
+      return;
+    }
+
+  op = gimp_drawable_filter_get_operation (filter);
+
+  if (op)
+    {
+      gchar *operation = NULL;
+      gchar *name      = NULL;
+
+      g_object_get (filter, "name",      &name,      NULL);
+      g_object_get (op,     "operation", &operation, NULL);
+
+      if (operation)
+        {
+          GimpProcedure *procedure;
+
+          procedure = gimp_gegl_procedure_new (image->gimp,
+                                               filter,
+                                               GIMP_RUN_INTERACTIVE, NULL,
+                                               operation,
+                                               name,
+                                               name,
+                                               NULL, NULL, NULL);
+
+          filters_run_procedure (image->gimp,
+                                 gimp_context_get_display (gimp_get_user_context (image->gimp)),
+                                 procedure, GIMP_RUN_INTERACTIVE);
+
+          g_object_unref (procedure);
+        }
+
+      g_free (name);
+      g_free (operation);
+    }
+}
+
+static void
+fx_strip_edit_clicked (GtkButton       *button,
+                       ChopGimpFxStrip *strip)
+{
+  GimpDrawableFilter *filter = fx_strip_row_filter (strip, GTK_WIDGET (button));
+
+  if (filter)
+    fx_strip_edit_filter (strip, filter);
+}
+
+static gboolean
+fx_strip_name_pressed (GtkWidget       *widget,
+                       GdkEventButton  *bevent,
+                       ChopGimpFxStrip *strip)
+{
+  if (bevent->button == 1 && bevent->type == GDK_2BUTTON_PRESS)
+    {
+      GimpDrawableFilter *filter = fx_strip_row_filter (strip, widget);
+
+      if (filter)
+        fx_strip_edit_filter (strip, filter);
+
+      return TRUE;
+    }
+
+  return FALSE;
+}
