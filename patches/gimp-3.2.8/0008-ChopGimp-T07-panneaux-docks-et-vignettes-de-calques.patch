+  gint           *min;
+  gint            total;
+  gint            i, j;
+
+  g_return_if_fail (GIMP_IS_PANED_BOX (paned_box));
+
+  children = gtk_container_get_children (GTK_CONTAINER (paned_box));
+  for (iter = children; iter; iter = g_list_next (iter))
+    if (GTK_IS_PANED (iter->data))
+      root = iter->data;
+  g_list_free (children);
+
+  if (! root)
+    return;
+
+  orientation = gtk_orientable_get_orientation (GTK_ORIENTABLE (paned_box));
+
+  leaves = g_ptr_array_new ();
+  gimp_paned_box_collect_leaves (root, leaves, &marked);
+
+  size = g_new0 (gint, leaves->len);
+  min  = g_new0 (gint, leaves->len);
+
+  targets = g_hash_table_new (NULL, NULL);
+  gimp_paned_box_current_sizes (root, orientation,
+                                gimp_paned_box_widget_size (root, orientation),
+                                targets);
+
+  for (i = 0; i < leaves->len; i++)
+    {
+      GtkWidget *leaf = g_ptr_array_index (leaves, i);
+
+      /*  never laid out yet: positions are left alone  */
+      if (gimp_paned_box_widget_size (leaf, orientation) <= 1)
+        allocated = FALSE;
+
+      size[i] = GPOINTER_TO_INT (g_hash_table_lookup (targets, leaf));
+
+      if (orientation == GTK_ORIENTATION_VERTICAL)
+        gtk_widget_get_preferred_height (leaf, &min[i], NULL);
+      else
+        gtk_widget_get_preferred_width (leaf, &min[i], NULL);
+
+      if (g_object_get_data (G_OBJECT (leaf), CHOPGIMP_COLLAPSED_KEY))
+        any_collapsed = TRUE;
+      else if (g_object_get_data (G_OBJECT (leaf), CHOPGIMP_SAVED_SIZE_KEY))
+        any_restored = TRUE;
+    }
+
+  /*  nothing collapsed, now or before: GIMP's own layout is left alone  */
+  if (! any_collapsed && ! any_restored && ! marked)
+    {
+      g_hash_table_unref (targets);
+      g_free (size);
+      g_free (min);
+      g_ptr_array_unref (leaves);
+      return;
+    }
+
+#define IS_COLLAPSED(n) \
+  (g_object_get_data (G_OBJECT (g_ptr_array_index (leaves, (n))), \
+                      CHOPGIMP_COLLAPSED_KEY) != NULL)
+
+  if (allocated)
+    {
+      for (i = 0; i < leaves->len; i++)
+        {
+          GObject *leaf = g_ptr_array_index (leaves, i);
+
+          if (IS_COLLAPSED (i))
+            {
+              gint freed = size[i] - min[i];
+              gint to    = -1;
+
+              if (freed <= 0)
+                continue;
+
+              /*  the next expanded group below, else above, else the last  */
+              for (j = i + 1; j < leaves->len && to < 0; j++)
+                if (! IS_COLLAPSED (j))
+                  to = j;
+              for (j = i - 1; j >= 0 && to < 0; j--)
+                if (! IS_COLLAPSED (j))
+                  to = j;
+              if (to < 0)
+                to = leaves->len - 1;
+
+              if (to == i)
+                continue;
+
+              if (! g_object_get_data (leaf, CHOPGIMP_SAVED_SIZE_KEY))
+                g_object_set_data (leaf, CHOPGIMP_SAVED_SIZE_KEY,
+                                   GINT_TO_POINTER (size[i]));
+
+              size[i]   = min[i];
+              size[to] += freed;
+            }
+          else if (g_object_get_data (leaf, CHOPGIMP_SAVED_SIZE_KEY))
+            {
+              /*  expanded again: take its former size back, from the
+               *  groups below first
+               */
+              gint wanted =
+                MAX (GPOINTER_TO_INT (g_object_get_data (leaf,
+                                                         CHOPGIMP_SAVED_SIZE_KEY)),
+                     min[i]) - size[i];
+              gint pass;
+
+              g_object_set_data (leaf, CHOPGIMP_SAVED_SIZE_KEY, NULL);
+
+              for (pass = 0; pass < 2 && wanted > 0; pass++)
+                for (j = (pass == 0 ? i + 1 : i - 1);
+                     j >= 0 && j < leaves->len && wanted > 0;
+                     j += (pass == 0 ? 1 : -1))
+                  {
+                    gint spare = size[j] - min[j];
+                    gint taken;
+
+                    /*  a collapsed group only gives its empty room  */
+                    if (spare <= 0)
+                      continue;
+
+                    taken    = MIN (spare, wanted);
+                    size[j] -= taken;
+                    size[i] += taken;
+                    wanted  -= taken;
+                  }
+            }
+        }
+    }
+
+#undef IS_COLLAPSED
+
+  for (i = 0; i < leaves->len; i++)
+    g_hash_table_insert (targets, g_ptr_array_index (leaves, i),
+                         GINT_TO_POINTER (size[i]));
+
+  g_object_set_data (G_OBJECT (paned_box), CHOPGIMP_LAYOUT_GUARD_KEY,
+                     GINT_TO_POINTER (TRUE));
+  gimp_paned_box_apply_collapsed (root, orientation, targets,
+                                  allocated, &total);
+  g_object_set_data (G_OBJECT (paned_box), CHOPGIMP_LAYOUT_GUARD_KEY, NULL);
+
+  g_hash_table_unref (targets);
+  g_free (size);
+  g_free (min);
+  g_ptr_array_unref (leaves);
+}
+
+/*  ChopGimp: flexible panel groups (Photoshop).
+ *
+ *  GIMP nests a GtkPaned per group and packs them with shrink = FALSE:
+ *  a separator only shares the room of its two neighbours and stops at
+ *  their minimum size. Here the groups may shrink down to their tab bar,
+ *  and dragging a separator pushes or pulls ALL the groups on the other
+ *  side, the nearest first: enlarging the group above shrinks the ones
+ *  below one after the other, and the other way round.
+ */
+
+static gint
+gimp_paned_box_leaf_min (GtkWidget      *leaf,
+                         GtkOrientation  orientation)
+{
+  gint min = CHOPGIMP_MIN_GROUP;
+
+  if (orientation != GTK_ORIENTATION_VERTICAL)
+    {
+      gtk_widget_get_preferred_width (leaf, &min, NULL);
+      return min;
+    }
+
+  if (g_object_get_data (G_OBJECT (leaf), CHOPGIMP_COLLAPSED_KEY))
+    {
+      gtk_widget_get_preferred_height (leaf, &min, NULL);
+    }
+  else if (GTK_IS_NOTEBOOK (leaf))
+    {
+      GtkNotebook *notebook = GTK_NOTEBOOK (leaf);
+      GtkWidget   *page     =
+        gtk_notebook_get_nth_page (notebook,
+                                   gtk_notebook_get_current_page (notebook));
+
+      /*  the height of the tab bar  */
+      if (page && gtk_widget_get_mapped (page))
+        {
+          GtkAllocation book_alloc;
+          GtkAllocation page_alloc;
+
+          gtk_widget_get_allocation (leaf, &book_alloc);
+          gtk_widget_get_allocation (page, &page_alloc);
+
+          if (page_alloc.y > book_alloc.y)
+            min = MAX (min, page_alloc.y - book_alloc.y + 2);
+        }
+    }
+
+  return min;
+}
+
+static gint
+gimp_paned_box_leaf_index (GPtrArray *leaves,
+                           GtkWidget *leaf)
+{
+  guint i;
+
+  for (i = 0; i < leaves->len; i++)
+    if (g_ptr_array_index (leaves, i) == leaf)
+      return i;
+
+  return -1;
+}
+
+static GtkWidget *
+gimp_paned_box_edge_leaf (GtkWidget *widget,
+                          gboolean   last)
+{
+  while (GTK_IS_PANED (widget))
+    {
+      GtkWidget *child = last ? gtk_paned_get_child2 (GTK_PANED (widget))
+                              : gtk_paned_get_child1 (GTK_PANED (widget));
+      if (! child)
+        child = last ? gtk_paned_get_child1 (GTK_PANED (widget))
+                     : gtk_paned_get_child2 (GTK_PANED (widget));
+      widget = child;
+    }
+
+  return widget;
+}
+
+static void
+gimp_paned_box_flexible_position (GtkPaned     *paned,
+                                  GParamSpec   *pspec,
+                                  GimpPanedBox *paned_box)
+{
+  GtkOrientation  orientation;
+  GtkWidget      *root  = NULL;
+  GdkEvent       *event;
+  GPtrArray      *leaves;
+  GHashTable     *targets;
+  GList          *children;
+  GList          *iter;
+  gboolean        marked = FALSE;
+  gint           *size;
+  gint           *min;
+  gint            n, b, f, i, j;
+  gint            total, sum = 0, handle;
+  gint            origin_p, old_boundary, new_boundary, delta, room, left;
+  gboolean        user_drag;
+
+  if (g_object_get_data (G_OBJECT (paned_box), CHOPGIMP_LAYOUT_GUARD_KEY))
+    return;
+
+  /*  only the separator dragged by the user, not GTK's own adjustments  */
+  event     = gtk_get_current_event ();
+  user_drag = event && gdk_event_get_event_type (event) == GDK_MOTION_NOTIFY;
+  if (event)
+    gdk_event_free (event);
+
+  if (! user_drag)
+    return;
+
+  children = gtk_container_get_children (GTK_CONTAINER (paned_box));
+  for (iter = children; iter; iter = g_list_next (iter))
+    if (GTK_IS_PANED (iter->data))
+      root = iter->data;
+  g_list_free (children);
+
+  if (! root || ! gtk_paned_get_child1 (paned) || ! gtk_paned_get_child2 (paned))
+    return;
+
+  orientation = gtk_orientable_get_orientation (GTK_ORIENTABLE (paned_box));
+
+  leaves = g_ptr_array_new ();
+  gimp_paned_box_collect_leaves (root, leaves, &marked);
+  n = leaves->len;
+
+  /*  b: first leaf after the separator; f: first leaf of the paned  */
+  b = gimp_paned_box_leaf_index (leaves,
+                                 gimp_paned_box_edge_leaf (gtk_paned_get_child2 (paned),
+                                                           FALSE));
+  f = gimp_paned_box_leaf_index (leaves,
+                                 gimp_paned_box_edge_leaf (gtk_paned_get_child1 (paned),
+                                                           FALSE));
+  if (n < 2 || b < 1 || f < 0 || f >= b)
+    {
+      g_ptr_array_unref (leaves);
+      return;
+    }
+
+  /*  the sizes before the drag: still the allocations at this point  */
+  size = g_new0 (gint, n);
+  min  = g_new0 (gint, n);
+
+  for (i = 0; i < n; i++)
+    {
+      GtkWidget *leaf = g_ptr_array_index (leaves, i);
+
+      size[i] = gimp_paned_box_widget_size (leaf, orientation);
+      min[i]  = MIN (gimp_paned_box_leaf_min (leaf, orientation), size[i]);
+      sum    += size[i];
+    }
+
+  total  = gimp_paned_box_widget_size (root, orientation);
+  handle = MAX (0, (total - sum) / (n - 1));
+
+  origin_p = 0;
+  for (i = 0; i < f; i++)
+    origin_p += size[i] + handle;
+
+  old_boundary = 0;
+  for (i = 0; i < b; i++)
+    old_boundary += size[i] + (i < b - 1 ? handle : 0);
+
+  new_boundary = origin_p + gtk_paned_get_position (paned);
+  delta        = new_boundary - old_boundary;
+
+  if (delta > 0)
+    {
+      /*  the group above grows, those below give their room in turn  */
+      for (room = 0, j = b; j < n; j++)
+        room += size[j] - min[j];
+
+      delta = MIN (delta, room);
+      size[b - 1] += delta;
+
+      for (left = delta, j = b; j < n && left > 0; j++)
+        {
+          gint take = MIN (size[j] - min[j], left);
+
+          size[j] -= take;
+          left    -= take;
+        }
+    }
+  else if (delta < 0)
+    {
+      delta = -delta;
+
+      for (room = 0, j = b - 1; j >= 0; j--)
+        room += size[j] - min[j];
+
+      delta = MIN (delta, room);
+      size[b] += delta;
+
+      for (left = delta, j = b - 1; j >= 0 && left > 0; j--)
+        {
+          gint take = MIN (size[j] - min[j], left);
+
+          size[j] -= take;
+          left    -= take;
+        }
+    }
+
+  targets = g_hash_table_new (NULL, NULL);
+  for (i = 0; i < n; i++)
+    g_hash_table_insert (targets, g_ptr_array_index (leaves, i),
+                         GINT_TO_POINTER (size[i]));
+
+  g_object_set_data (G_OBJECT (paned_box), CHOPGIMP_LAYOUT_GUARD_KEY,
+                     GINT_TO_POINTER (TRUE));
+  gimp_paned_box_apply_collapsed (root, orientation, targets, TRUE, &total);
+  g_object_set_data (G_OBJECT (paned_box), CHOPGIMP_LAYOUT_GUARD_KEY, NULL);
+
+  g_hash_table_unref (targets);
+  g_free (size);
+  g_free (min);
+  g_ptr_array_unref (leaves);
+}
+
+/*  after a size change (window made smaller…), GtkPaned takes the lost
+ *  room from the last groups, down to nothing: give every group its tab
+ *  bar back, taken from the groups that have room to spare
+ */
+static gboolean
+gimp_paned_box_reclamp_idle (gpointer data)
+{
+  GimpPanedBox *paned_box = data;
+  GtkWidget    *root      = NULL;
+  GList        *children, *iter;
+  GPtrArray    *leaves;
+  GHashTable   *targets;
+  gboolean      marked = FALSE;
+  gint         *size, *min;
+  gint          n, i, j, total, deficit = 0, spare = 0;
+
+  g_object_set_data (G_OBJECT (paned_box), "chopgimp-reclamp-id", NULL);
+
+  if (g_object_get_data (G_OBJECT (paned_box), CHOPGIMP_LAYOUT_GUARD_KEY))
+    return G_SOURCE_REMOVE;
+
+  children = gtk_container_get_children (GTK_CONTAINER (paned_box));
+  for (iter = children; iter; iter = g_list_next (iter))
+    if (GTK_IS_PANED (iter->data))
+      root = iter->data;
+  g_list_free (children);
+
+  if (! root)
+    return G_SOURCE_REMOVE;
+
+  leaves = g_ptr_array_new ();
+  gimp_paned_box_collect_leaves (root, leaves, &marked);
+  n = leaves->len;
+
+  if (n < 2)
+    {
+      g_ptr_array_unref (leaves);
+      return G_SOURCE_REMOVE;
+    }
+
+  size = g_new0 (gint, n);
+  min  = g_new0 (gint, n);
+
+  for (i = 0; i < n; i++)
+    {
+      GtkWidget *leaf = g_ptr_array_index (leaves, i);
+
+      size[i] = gimp_paned_box_widget_size (leaf, GTK_ORIENTATION_VERTICAL);
+      min[i]  = gimp_paned_box_leaf_min (leaf, GTK_ORIENTATION_VERTICAL);
+
+      if (size[i] + 1 < min[i])
+        deficit += min[i] - size[i];
+      else if (size[i] > min[i])
+        spare += size[i] - min[i];
+    }
+
+  if (deficit > 0 && spare >= deficit)
+    {
+      /*  take the room from the largest groups first  */
+      while (deficit > 0)
+        {
+          gint best = -1;
+
+          for (j = 0; j < n; j++)
+            if (size[j] > min[j] && (best < 0 || size[j] - min[j] > size[best] - min[best]))
+              best = j;
+
+          if (best < 0)
+            break;
+
+          for (i = 0; i < n && deficit > 0; i++)
+            if (size[i] < min[i])
+              {
+                gint take = MIN (MIN (min[i] - size[i], size[best] - min[best]), deficit);
+
+                size[i]    += take;
+                size[best] -= take;
+                deficit    -= take;
+
+                if (size[best] <= min[best])
+                  break;
+              }
+        }
+
+      targets = g_hash_table_new (NULL, NULL);
+      for (i = 0; i < n; i++)
+        g_hash_table_insert (targets, g_ptr_array_index (leaves, i),
+                             GINT_TO_POINTER (size[i]));
+
+      total = gimp_paned_box_widget_size (root, GTK_ORIENTATION_VERTICAL);
+
+      g_object_set_data (G_OBJECT (paned_box), CHOPGIMP_LAYOUT_GUARD_KEY,
+                         GINT_TO_POINTER (TRUE));
+      gimp_paned_box_apply_collapsed (root, GTK_ORIENTATION_VERTICAL,
+                                      targets, TRUE, &total);
+      g_object_set_data (G_OBJECT (paned_box), CHOPGIMP_LAYOUT_GUARD_KEY, NULL);
+
+      g_hash_table_unref (targets);
+    }
+
+  g_free (size);
+  g_free (min);
+  g_ptr_array_unref (leaves);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+gimp_paned_box_size_allocated (GtkWidget     *widget,
+                               GtkAllocation *allocation,
+                               gpointer       data)
+{
+  if (gtk_orientable_get_orientation (GTK_ORIENTABLE (widget)) != GTK_ORIENTATION_VERTICAL ||
+      g_object_get_data (G_OBJECT (widget), CHOPGIMP_LAYOUT_GUARD_KEY) ||
+      g_object_get_data (G_OBJECT (widget), "chopgimp-reclamp-id"))
+    return;
+
+  g_object_set_data (G_OBJECT (widget), "chopgimp-reclamp-id",
+                     GUINT_TO_POINTER (g_idle_add (gimp_paned_box_reclamp_idle, widget)));
+}
