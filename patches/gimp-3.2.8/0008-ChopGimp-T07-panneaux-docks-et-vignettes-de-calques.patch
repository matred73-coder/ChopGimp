+/*  ── ChopGimp: thumbnails cropped to the content ─────────────────── */
+
+gboolean
+chopgimp_thumbs_get_crop (void)
+{
+  /*  default: cropped, like Photoshop  */
+  return chopgimp_rc_get_boolean ("layers", "crop-thumbnails", TRUE);
+}
+
+static void
+chopgimp_invalidate_layers (GList *items)
+{
+  for (; items; items = items->next)
+    {
+      GimpViewable  *viewable = items->data;
+      GimpContainer *children = gimp_viewable_get_children (viewable);
+
+      gimp_viewable_invalidate_preview (viewable);
+
+      if (children)
+        chopgimp_invalidate_layers (GIMP_LIST (children)->queue->head);
+    }
+}
+
+void
+chopgimp_thumbs_set_crop (Gimp     *gimp,
+                          gboolean  crop)
+{
+  GList *list;
+
+  chopgimp_rc_set_boolean ("layers", "crop-thumbnails", crop);
+
+  if (gimp)
+    for (list = gimp_get_image_iter (gimp); list; list = list->next)
+      chopgimp_invalidate_layers (gimp_image_get_layer_iter (list->data));
+}
+
+#define CONTENT_BOUNDS_KEY "chopgimp-content-bounds"
+
+typedef struct
+{
+  gboolean computed;
+  gboolean stale;
+  gboolean ok;
+  gboolean pending;
+  gint64   time;
+  gpointer buffer;        /* compared only: a new buffer, new bounds */
+  gint     x, y, w, h;
+} ContentBounds;
+
+static void
+content_bounds_update (GimpDrawable *drawable,
+                       gint          x,
+                       gint          y,
+                       gint          width,
+                       gint          height,
+                       gpointer      data)
+{
+  ContentBounds *cb = g_object_get_data (G_OBJECT (drawable), CONTENT_BOUNDS_KEY);
+
+  if (cb)
+    cb->stale = TRUE;
+}
+
+static void
+content_bounds_invalidated (GimpViewable *viewable,
+                            gpointer      data)
+{
+  ContentBounds *cb = g_object_get_data (G_OBJECT (viewable), CONTENT_BOUNDS_KEY);
+
+  if (cb)
+    cb->stale = TRUE;
+}
+
+static void
+content_bounds_size_changed (GimpViewable *viewable,
+                             gpointer      data)
+{
+  ContentBounds *cb = g_object_get_data (G_OBJECT (viewable), CONTENT_BOUNDS_KEY);
+
+  /*  a new size: the old bounds are wrong, not just late  */
+  if (cb)
+    cb->computed = FALSE;
+}
+
+static gboolean
+content_bounds_refresh (gpointer data)
+{
+  GimpLayer     *layer = data;
+  ContentBounds *cb    = g_object_get_data (G_OBJECT (layer), CONTENT_BOUNDS_KEY);
+
+  if (cb)
+    cb->pending = FALSE;
+
+  /*  only the framing may change: keep the layer's reduced effects  */
+  gimp_drawable_invalidate_preview_layout (GIMP_DRAWABLE (layer));
+
+  /*  the group showing it too  */
+  if (gimp_layer_get_parent (layer))
+    gimp_viewable_invalidate_preview (GIMP_VIEWABLE (gimp_layer_get_parent (layer)));
+
+  g_object_unref (layer);
+
+  return G_SOURCE_REMOVE;
+}
+
+/*  content bounds of a layer in its own coordinates; for a group, the
+ *  union of its visible children (its projection may not be rendered yet)
+ */
+static gboolean
+chopgimp_content_bounds (GimpLayer *layer,
+                         gint      *x,
+                         gint      *y,
+                         gint      *w,
+                         gint      *h)
+{
+  GimpItem      *item     = GIMP_ITEM (layer);
+  GimpContainer *children = gimp_viewable_get_children (GIMP_VIEWABLE (layer));
+
+  if (children)
+    {
+      GList    *list;
+      gboolean  any = FALSE;
+      gint      ox, oy, x1 = 0, y1 = 0, x2 = 0, y2 = 0;
+
+      gimp_item_get_offset (item, &ox, &oy);
+
+      for (list = GIMP_LIST (children)->queue->head; list; list = list->next)
+        {
+          GimpItem *child = list->data;
+          gint      cx, cy, cw, ch, chx, chy;
+
+          if (! gimp_item_get_visible (child) ||
+              ! chopgimp_content_bounds (GIMP_LAYER (child), &cx, &cy, &cw, &ch))
+            continue;
+
+          gimp_item_get_offset (child, &chx, &chy);
+          cx += chx - ox;
+          cy += chy - oy;
+
+          if (! any)
+            {
+              x1 = cx; y1 = cy; x2 = cx + cw; y2 = cy + ch;
+              any = TRUE;
+            }
+          else
+            {
+              x1 = MIN (x1, cx);      y1 = MIN (y1, cy);
+              x2 = MAX (x2, cx + cw); y2 = MAX (y2, cy + ch);
+            }
+        }
+
+      x1 = MAX (x1, 0);
+      y1 = MAX (y1, 0);
+      x2 = MIN (x2, gimp_item_get_width  (item));
+      y2 = MIN (y2, gimp_item_get_height (item));
+
+      if (! any || x2 <= x1 || y2 <= y1)
+        return FALSE;
+
+      *x = x1; *y = y1; *w = x2 - x1; *h = y2 - y1;
+      return TRUE;
+    }
+
+  if ((gint64) gimp_item_get_width (item) * gimp_item_get_height (item) > 40000000)
+    return FALSE;
+
+  /*  the scan of the whole layer is cached: while painting, the bounds
+   *  are recomputed at most once a second
+   */
+  {
+    ContentBounds *cb  = g_object_get_data (G_OBJECT (layer), CONTENT_BOUNDS_KEY);
+    gint64         now = g_get_monotonic_time ();
+
+    if (! cb)
+      {
+        cb = g_new0 (ContentBounds, 1);
+        g_object_set_data_full (G_OBJECT (layer), CONTENT_BOUNDS_KEY, cb, g_free);
+        g_signal_connect (layer, "update",
+                          G_CALLBACK (content_bounds_update), NULL);
+        /*  some layers (vector layers) redraw without « update »  */
+        g_signal_connect (layer, "invalidate-preview",
+                          G_CALLBACK (content_bounds_invalidated), NULL);
+        g_signal_connect (layer, "size-changed",
+                          G_CALLBACK (content_bounds_size_changed), NULL);
+      }
+
+    if (cb->buffer != (gpointer) gimp_drawable_get_buffer (GIMP_DRAWABLE (layer)))
+      cb->computed = FALSE;
+
+    if (cb->computed && (! cb->stale || now - cb->time < G_USEC_PER_SEC))
+      {
+        /*  late bounds: render once more when they may be recomputed  */
+        if (cb->stale && ! cb->pending)
+          {
+            cb->pending = TRUE;
+            g_timeout_add_full (G_PRIORITY_LOW, 1100, content_bounds_refresh,
+                                g_object_ref (layer), NULL);
+          }
+
+        *x = cb->x; *y = cb->y; *w = cb->w; *h = cb->h;
+        return cb->ok;
+      }
+
+    /*  thumbnail: an estimate on a reduced copy is enough (and fast)  */
+    switch (chopgimp_alpha_bounds_fast (GIMP_DRAWABLE (layer), 512, x, y, w, h))
+      {
+      case GIMP_AUTO_SHRINK_SHRINK:
+        cb->ok = TRUE;
+        break;
+
+      case GIMP_AUTO_SHRINK_UNSHRINKABLE:
+        *x = 0; *y = 0;
+        *w = gimp_item_get_width  (item);
+        *h = gimp_item_get_height (item);
+        cb->ok = TRUE;
+        break;
+
+      default:
+        cb->ok = FALSE;
+        break;
+      }
+
+    cb->x = *x; cb->y = *y; cb->w = *w; cb->h = *h;
+    cb->computed = TRUE;
+    cb->stale    = FALSE;
+    cb->buffer   = gimp_drawable_get_buffer (GIMP_DRAWABLE (layer));
+    cb->time     = now;
+
+    return cb->ok;
+  }
+}
