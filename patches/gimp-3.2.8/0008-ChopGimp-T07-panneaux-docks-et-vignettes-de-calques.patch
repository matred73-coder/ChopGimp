diff --git a/app/widgets/gimpcellrendererviewable.c b/app/widgets/gimpcellrendererviewable.c
index d725f33..6ff3e49 100644
--- a/app/widgets/gimpcellrendererviewable.c
+++ b/app/widgets/gimpcellrendererviewable.c
@@ -306,9 +306,56 @@ gimp_cell_renderer_viewable_render (GtkCellRenderer      *cell,
 
       cairo_translate (cr, cell_area->x, cell_area->y);
 
-      gimp_view_renderer_draw (cellviewable->renderer, widget, cr,
-                               cell_area->width,
-                               cell_area->height);
+      /*  ChopGimp (lot C): rounded corners (« chopgimp-rounded » set on
+       *  the cell by the Layers panel)
+       */
+      if (g_object_get_data (G_OBJECT (cell), "chopgimp-rounded"))
+        {
+          GimpViewRenderer *renderer = cellviewable->renderer;
+          gint              bw       = renderer->border_width;
+          gdouble           w        = renderer->width  + 2 * bw;
+          gdouble           h        = renderer->height + 2 * bw;
+          gdouble           x        = (cell_area->width  - w) / 2.0;
+          gdouble           y        = (cell_area->height - h) / 2.0;
+          gdouble           r        = MIN (4.0, MIN (w, h) / 4.0);
+          GdkRGBA           color;
+
+          cairo_save (cr);
+          cairo_new_sub_path (cr);
+          cairo_arc (cr, x + w - r, y + r,     r, -G_PI / 2, 0);
+          cairo_arc (cr, x + w - r, y + h - r, r, 0,          G_PI / 2);
+          cairo_arc (cr, x + r,     y + h - r, r, G_PI / 2,   G_PI);
+          cairo_arc (cr, x + r,     y + r,     r, G_PI,       3 * G_PI / 2);
+          cairo_close_path (cr);
+          cairo_clip (cr);
+
+          gimp_view_renderer_draw (renderer, widget, cr,
+                                   cell_area->width,
+                                   cell_area->height);
+          cairo_restore (cr);
+
+          /*  a thin rounded outline instead of the square border  */
+          gtk_style_context_get_color (gtk_widget_get_style_context (widget),
+                                       gtk_widget_get_state_flags (widget),
+                                       &color);
+          color.alpha *= (flags & GTK_CELL_RENDERER_SELECTED) ? 0.7 : 0.3;
+
+          cairo_new_sub_path (cr);
+          cairo_arc (cr, x + w - r - 0.5, y + r + 0.5,     r, -G_PI / 2, 0);
+          cairo_arc (cr, x + w - r - 0.5, y + h - r - 0.5, r, 0,          G_PI / 2);
+          cairo_arc (cr, x + r + 0.5,     y + h - r - 0.5, r, G_PI / 2,   G_PI);
+          cairo_arc (cr, x + r + 0.5,     y + r + 0.5,     r, G_PI,       3 * G_PI / 2);
+          cairo_close_path (cr);
+          cairo_set_line_width (cr, 1.0);
+          gdk_cairo_set_source_rgba (cr, &color);
+          cairo_stroke (cr);
+        }
+      else
+        {
+          gimp_view_renderer_draw (cellviewable->renderer, widget, cr,
+                                   cell_area->width,
+                                   cell_area->height);
+        }
     }
 }
 
