+/*  ChopGimp (lot C): only the current selector is visible (the notebook
+ *  asks for the height of its tallest visible page), and the menu button
+ *  shows its icon
+ */
+static void
+gimp_color_editor_chop_sync_pages (GimpColorEditor *editor)
+{
+  GtkNotebook *notebook;
+  GtkWidget   *image;
+  gint         current;
+  gint         n_pages;
+  gint         i;
+
+  notebook = GTK_NOTEBOOK (gimp_color_notebook_get_notebook (GIMP_COLOR_NOTEBOOK (editor->notebook)));
+  current  = gtk_notebook_get_current_page (notebook);
+  n_pages  = gtk_notebook_get_n_pages (notebook);
+
+  if (current < 0)
+    return;
+
+  for (i = 0; i < n_pages; i++)
+    {
