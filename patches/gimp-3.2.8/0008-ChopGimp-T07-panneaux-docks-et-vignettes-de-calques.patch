+/*  ChopGimp: a panel may be smaller than its content, which is then cut
+ *  at the bottom (Photoshop): the panel groups can shrink freely.
+ */
+#define CHOPGIMP_DOCKABLE_MIN_HEIGHT 0
+
+static void
+gimp_dockable_get_preferred_height (GtkWidget *widget,
+                                    gint      *minimum,
+                                    gint      *natural)
+{
+  GTK_WIDGET_CLASS (g_type_class_peek (GTK_TYPE_BIN))->get_preferred_height (widget,
+                                                                            minimum,
+                                                                            natural);
+  *minimum = MIN (*minimum, CHOPGIMP_DOCKABLE_MIN_HEIGHT);
+}
+
+static void
+gimp_dockable_get_preferred_height_for_width (GtkWidget *widget,
+                                              gint       width,
+                                              gint      *minimum,
+                                              gint      *natural)
+{
+  GTK_WIDGET_CLASS (g_type_class_peek (GTK_TYPE_BIN))->get_preferred_height_for_width (widget,
+                                                                                      width,
+                                                                                      minimum,
+                                                                                      natural);
+  *minimum = MIN (*minimum, CHOPGIMP_DOCKABLE_MIN_HEIGHT);
+}
+
+/*  the panel has its own window: the part of the content cut at the
+ *  bottom is clipped for drawing AND for the pointer (the hidden buttons
+ *  of a shrunk panel must not catch the clicks of the group below)
+ */
+static void
+gimp_dockable_realize (GtkWidget *widget)
+{
+  GtkAllocation  allocation;
+  GdkWindow     *window;
+  GdkWindowAttr  attributes;
+  gint           attributes_mask;
+
+  gtk_widget_set_realized (widget, TRUE);
+  gtk_widget_get_allocation (widget, &allocation);
+
+  attributes.window_type = GDK_WINDOW_CHILD;
+  attributes.x           = allocation.x;
+  attributes.y           = allocation.y;
+  attributes.width       = allocation.width;
+  attributes.height      = allocation.height;
+  attributes.wclass      = GDK_INPUT_OUTPUT;
+  attributes.visual      = gtk_widget_get_visual (widget);
+  attributes.event_mask  = gtk_widget_get_events (widget) | GDK_EXPOSURE_MASK;
+  attributes_mask        = GDK_WA_X | GDK_WA_Y | GDK_WA_VISUAL;
+
+  window = gdk_window_new (gtk_widget_get_parent_window (widget),
+                           &attributes, attributes_mask);
+  gtk_widget_register_window (widget, window);
+  gtk_widget_set_window (widget, window);
+}
+
+static void
+gimp_dockable_size_allocate (GtkWidget     *widget,
+                             GtkAllocation *allocation)
+{
+  GtkWidget *child = gtk_bin_get_child (GTK_BIN (widget));
+
+  gtk_widget_set_allocation (widget, allocation);
+
+  if (gtk_widget_get_realized (widget))
+    gdk_window_move_resize (gtk_widget_get_window (widget),
+                            allocation->x, allocation->y,
+                            allocation->width, allocation->height);
+
+  if (child && gtk_widget_get_visible (child))
+    {
+      GtkAllocation child_alloc;
+      gint          child_min;
+
+      /*  the border width is already removed (handle_border_width);
+       *  coordinates are those of the panel's own window
+       */
+      child_alloc        = *allocation;
+      child_alloc.x      = 0;
+      child_alloc.y      = 0;
+      child_alloc.width  = MAX (1, child_alloc.width);
+      child_alloc.height = MAX (1, child_alloc.height);
+
+      /*  never under-allocated: laid out at its minimum, cut by the clip  */
+      gtk_widget_get_preferred_height_for_width (child, child_alloc.width,
+                                                 &child_min, NULL);
+      child_alloc.height = MAX (child_alloc.height, child_min);
+
+      gtk_widget_size_allocate (child, &child_alloc);
+    }
+
+  /*  draw only inside the panel  */
+  gtk_widget_set_clip (widget, allocation);
+}
+
+static gboolean
+gimp_dockable_draw (GtkWidget *widget,
+                    cairo_t   *cr)
+{
+  gboolean handled;
+
+  /*  own window: paint the panel background  */
+  gtk_render_background (gtk_widget_get_style_context (widget), cr, 0, 0,
+                         gtk_widget_get_allocated_width  (widget),
+                         gtk_widget_get_allocated_height (widget));
+
+  cairo_save (cr);
+  cairo_rectangle (cr, 0, 0,
+                   gtk_widget_get_allocated_width  (widget),
+                   gtk_widget_get_allocated_height (widget));
+  cairo_clip (cr);
+  handled = GTK_WIDGET_CLASS (g_type_class_peek (GTK_TYPE_BIN))->draw (widget, cr);
+  cairo_restore (cr);
+
+  return handled;
+}
