+static void
+gimp_color_select_chop_update_button (GimpColorSelect *select)
+{
+  GEnumClass         *channel_class;
+  const GimpEnumDesc *enum_desc;
+  GString            *text;
+  const gchar        *p;
+
+  if (! select->channel_label)
+    return;
+
+  channel_class = g_type_class_ref (GIMP_TYPE_COLOR_SELECTOR_CHANNEL);
+  enum_desc     = gimp_enum_get_desc (channel_class,
+                                      gimp_color_selector_get_channel (GIMP_COLOR_SELECTOR (select)));
+
+  if (enum_desc)
+    {
+      /*  "_H" -> "H ▾"  */
+      text = g_string_new (NULL);
+      for (p = gettext (enum_desc->value_desc); *p; p++)
+        if (*p != '_')
+          g_string_append_c (text, *p);
+      g_string_append (text, " \u25BE");
+
+      gtk_label_set_text (GTK_LABEL (select->channel_label), text->str);
+      gimp_help_set_help_data (select->channel_button,
+                               gettext (enum_desc->value_help), NULL);
+      g_string_free (text, TRUE);
     }
+
+  g_type_class_unref (channel_class);
 }
 
