+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+
+#include "widgets-types.h"
+
+#include "chopgimp-rc.h"
+
+
+static GKeyFile *chopgimp_rc = NULL;
+
+
+static gchar *
+chopgimp_rc_path (void)
+{
+  GFile *file = gimp_directory_file ("chopgimprc", NULL);
+  gchar *path = g_file_get_path (file);
+
+  g_object_unref (file);
+
+  return path;
+}
+
+static GKeyFile *
+chopgimp_rc_get (void)
+{
+  if (! chopgimp_rc)
+    {
+      gchar *path = chopgimp_rc_path ();
+
+      chopgimp_rc = g_key_file_new ();
+      g_key_file_load_from_file (chopgimp_rc, path,
+                                 G_KEY_FILE_KEEP_COMMENTS, NULL);
+      g_free (path);
+    }
+
+  return chopgimp_rc;
+}
+
+gboolean
+chopgimp_rc_get_boolean (const gchar *group,
+                         const gchar *key,
+                         gboolean     default_value)
+{
+  GError   *error = NULL;
+  gboolean  value = g_key_file_get_boolean (chopgimp_rc_get (),
+                                            group, key, &error);
+
+  if (error)
+    {
+      g_clear_error (&error);
+      return default_value;
+    }
+
+  return value;
+}
+
+void
+chopgimp_rc_set_boolean (const gchar *group,
+                         const gchar *key,
+                         gboolean     value)
+{
+  gchar *path = chopgimp_rc_path ();
+
+  g_key_file_set_boolean (chopgimp_rc_get (), group, key, value);
+  g_key_file_save_to_file (chopgimp_rc, path, NULL);
+
+  g_free (path);
+}
+
+gchar **
+chopgimp_rc_get_strings (const gchar *group,
+                         const gchar *key)
+{
+  gchar **list = g_key_file_get_string_list (chopgimp_rc_get (), group, key,
+                                             NULL, NULL);
+
+  return list ? list : g_new0 (gchar *, 1);
+}
+
+void
+chopgimp_rc_set_strings (const gchar         *group,
+                         const gchar         *key,
+                         const gchar * const *list)
+{
+  gchar *path = chopgimp_rc_path ();
+
+  g_key_file_set_string_list (chopgimp_rc_get (), group, key, list,
+                              g_strv_length ((gchar **) list));
+  g_key_file_save_to_file (chopgimp_rc, path, NULL);
+
+  g_free (path);
+}
+
+gchar *
+chopgimp_rc_get_string (const gchar *group,
+                        const gchar *key,
+                        const gchar *default_value)
+{
+  gchar *value = g_key_file_get_string (chopgimp_rc_get (), group, key, NULL);
+
+  return value ? value : g_strdup (default_value);
+}
+
+void
+chopgimp_rc_set_string (const gchar *group,
+                        const gchar *key,
+                        const gchar *value)
+{
+  gchar *path = chopgimp_rc_path ();
+
+  if (value)
+    g_key_file_set_string (chopgimp_rc_get (), group, key, value);
+  else
+    g_key_file_remove_key (chopgimp_rc_get (), group, key, NULL);
+
+  g_key_file_save_to_file (chopgimp_rc, path, NULL);
+  g_free (path);
+}
