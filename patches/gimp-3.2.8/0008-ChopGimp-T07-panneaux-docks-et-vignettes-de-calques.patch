+/*  ChopGimp (lot C): button bar at the bottom of the panels: icons at
+ *  16 px, buttons at their size (not homogeneous) with a gap before each
+ *  group (raise/lower, duplicate/anchor/merge, mask/fx/adjustment, CSS
+ *  « chopgimp-group-start »), the delete button at the right end.
+ */
+static void
+gimp_editor_chop_button (GimpEditor *editor,
+                         GtkWidget  *button)
+{
+  GimpEditorPrivate *priv = GET_PRIVATE (editor);
+  GtkWidget         *child;
+  const gchar       *id;
+  gboolean           is_delete;
+
+  if (chopgimp_panels_classic () || ! priv->button_box)
+    return;
+
+  if (gtk_box_get_homogeneous (GTK_BOX (priv->button_box)))
+    {
+      gtk_box_set_homogeneous (GTK_BOX (priv->button_box), FALSE);
+      gtk_style_context_add_class (gtk_widget_get_style_context (priv->button_box),
+                                   "chopgimp-button-bar");
+      gtk_style_context_add_class (gtk_widget_get_style_context (priv->button_box),
+                                   CHOPGIMP_PANELS_CLASS);
+    }
+
+  id        = g_object_get_data (G_OBJECT (button), "gimp-widget-identifier");
+  is_delete = (id && g_str_has_suffix (id, "-delete") && ! strstr (id, "-mask-"));
+
+  gtk_box_set_child_packing (GTK_BOX (priv->button_box), button,
+                             is_delete, TRUE, 0, GTK_PACK_START);
+
+  if (is_delete)
+    gtk_widget_set_halign (button, GTK_ALIGN_END);
+
+  if (id && (g_str_has_suffix (id, "-raise")     ||
+             g_str_has_suffix (id, "-duplicate") ||
+             ! strcmp (id, "layers-mask-add-button")))
+    gtk_style_context_add_class (gtk_widget_get_style_context (button),
+                                 "chopgimp-group-start");
+
+  child = gtk_bin_get_child (GTK_BIN (button));
+
+  if (GTK_IS_IMAGE (child))
+    gtk_image_set_pixel_size (GTK_IMAGE (child), 16);
+}
