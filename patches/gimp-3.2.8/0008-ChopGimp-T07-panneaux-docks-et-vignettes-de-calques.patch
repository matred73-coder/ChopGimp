+      GimpColorSelectorClass *selector_class;
+
+      selector_class = GIMP_COLOR_SELECTOR_GET_CLASS (page);
+
+      if (selector_class->icon_name)
+        gtk_image_set_from_icon_name (GTK_IMAGE (image),
