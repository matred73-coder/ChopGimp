+
+  guint          rebuild_idle;
+};
+
+
+static void   chopgimp_fx_strip_dispose        (GObject         *object);
+
+static void   fx_strip_queue_rebuild           (ChopGimpFxStrip *strip);
+static void   fx_strip_rebuild                 (ChopGimpFxStrip *strip);
+static void   fx_strip_header_clicked          (GtkButton       *button,
+                                                ChopGimpFxStrip *strip);
+static void   fx_strip_all_toggled             (GtkToggleButton *button,
+                                                ChopGimpFxStrip *strip);
+static void   fx_strip_filter_toggled          (GtkToggleButton *button,
+                                                ChopGimpFxStrip *strip);
+static void   fx_strip_edit_clicked            (GtkButton       *button,
+                                                ChopGimpFxStrip *strip);
+static gboolean fx_strip_name_pressed          (GtkWidget       *widget,
+                                                GdkEventButton  *bevent,
+                                                ChopGimpFxStrip *strip);
+
+
+G_DEFINE_TYPE (ChopGimpFxStrip, chopgimp_fx_strip, GTK_TYPE_BOX)
+
+#define parent_class chopgimp_fx_strip_parent_class
+
+
+/*  the list is shown or not for all the strips, for the session  */
+static gboolean fx_strip_expanded = TRUE;
+
+
+static void
+chopgimp_fx_strip_class_init (ChopGimpFxStripClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->dispose = chopgimp_fx_strip_dispose;
+}
+
+static void
+chopgimp_fx_strip_init (ChopGimpFxStrip *strip)
+{
+  GtkWidget *header;
+  GtkWidget *button;
+  GtkWidget *hbox;
+  GtkWidget *image;
+  GtkWidget *label;
+
+  gtk_orientable_set_orientation (GTK_ORIENTABLE (strip),
+                                  GTK_ORIENTATION_VERTICAL);
+  gtk_box_set_spacing (GTK_BOX (strip), 0);
+
+  gtk_style_context_add_class (gtk_widget_get_style_context (GTK_WIDGET (strip)),
+                               "chopgimp-fx-strip");
+  gtk_style_context_add_class (gtk_widget_get_style_context (GTK_WIDGET (strip)),
+                               CHOPGIMP_PANELS_CLASS);
+
+  /*  header: [▾ fx Effets  summary…] [👁]  */
+  header = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_style_context_add_class (gtk_widget_get_style_context (header),
+                               "chopgimp-fx-header");
+  gtk_box_pack_start (GTK_BOX (strip), header, FALSE, FALSE, 0);
+  gtk_widget_set_visible (header, TRUE);
+
+  button = gtk_button_new ();
+  gtk_button_set_relief (GTK_BUTTON (button), GTK_RELIEF_NONE);
+  gtk_widget_set_can_focus (button, FALSE);
+  gimp_help_set_help_data (button,
+                           _("Afficher ou masquer la liste des effets.\n"
+                             "Le bouton fx de la ligne du calque ouvre la "
+                             "liste complète (ordre, fusion, copie, "
+                             "suppression)."),
+                           NULL);
+  gtk_box_pack_start (GTK_BOX (header), button, TRUE, TRUE, 0);
+  gtk_widget_set_visible (button, TRUE);
+
+  g_signal_connect (button, "clicked",
+                    G_CALLBACK (fx_strip_header_clicked),
+                    strip);
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_container_add (GTK_CONTAINER (button), hbox);
+  gtk_widget_set_visible (hbox, TRUE);
+
+  strip->arrow = gtk_image_new_from_icon_name ("pan-down-symbolic",
+                                               GTK_ICON_SIZE_MENU);
+  gtk_image_set_pixel_size (GTK_IMAGE (strip->arrow), 12);
+  gtk_box_pack_start (GTK_BOX (hbox), strip->arrow, FALSE, FALSE, 0);
+  gtk_widget_set_visible (strip->arrow, TRUE);
+
+  image = gtk_image_new_from_icon_name (GIMP_ICON_EFFECT, GTK_ICON_SIZE_MENU);
+  gtk_image_set_pixel_size (GTK_IMAGE (image), 16);
+  gtk_box_pack_start (GTK_BOX (hbox), image, FALSE, FALSE, 0);
+  gtk_widget_set_visible (image, TRUE);
+
+  label = gtk_label_new (_("Effets"));
+  gtk_box_pack_start (GTK_BOX (hbox), label, FALSE, FALSE, 0);
+  gtk_widget_set_visible (label, TRUE);
+
+  strip->summary = gtk_label_new (NULL);
+  gtk_label_set_xalign (GTK_LABEL (strip->summary), 0.0);
+  gtk_label_set_ellipsize (GTK_LABEL (strip->summary), PANGO_ELLIPSIZE_END);
+  gtk_style_context_add_class (gtk_widget_get_style_context (strip->summary),
+                               "dim-label");
+  gtk_box_pack_start (GTK_BOX (hbox), strip->summary, TRUE, TRUE, 0);
+  gtk_widget_set_visible (strip->summary, TRUE);
+
+  strip->all_toggle = gtk_toggle_button_new ();
+  gtk_button_set_relief (GTK_BUTTON (strip->all_toggle), GTK_RELIEF_NONE);
+  gtk_widget_set_can_focus (strip->all_toggle, FALSE);
+  gtk_style_context_add_class (gtk_widget_get_style_context (strip->all_toggle),
+                               "chopgimp-fx-eye");
+  gimp_help_set_help_data (strip->all_toggle,
+                           _("Afficher ou masquer tous les effets du calque"),
+                           NULL);
+  gtk_box_pack_end (GTK_BOX (header), strip->all_toggle, FALSE, FALSE, 0);
+  gtk_widget_set_visible (strip->all_toggle, TRUE);
+
+  strip->all_image = gtk_image_new_from_icon_name (GIMP_ICON_VISIBLE,
+                                                   GTK_ICON_SIZE_MENU);
+  gtk_image_set_pixel_size (GTK_IMAGE (strip->all_image), 16);
+  gtk_container_add (GTK_CONTAINER (strip->all_toggle), strip->all_image);
+  gtk_widget_set_visible (strip->all_image, TRUE);
+
+  g_signal_connect (strip->all_toggle, "toggled",
