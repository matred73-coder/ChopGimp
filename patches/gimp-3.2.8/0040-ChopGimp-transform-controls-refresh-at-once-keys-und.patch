From: ChopGimp <mathieu.redon@proton.me>
Date: Thu, 12 Nov 2026 07:57:50 +0100
Subject: [PATCH 40/42] ChopGimp: transform controls refresh at once (keys,
 undo, Layers panel) and enclose all selected layers

---
 app/tools/chopgimp-tools.c        |  16 +++
 app/tools/chopgimp-tools.h        |   2 +
 app/tools/gimpmovetool.c          | 157 ++++++++++++++++++++++++++----
 app/tools/gimpmovetool.h          |   2 +
 app/tools/gimptransformgridtool.c |   7 +-
 5 files changed, 161 insertions(+), 23 deletions(-)

diff --git a/app/tools/chopgimp-tools.c b/app/tools/chopgimp-tools.c
index 76923ed..988b08a 100644
--- a/app/tools/chopgimp-tools.c
+++ b/app/tools/chopgimp-tools.c
@@ -131,6 +131,22 @@ chopgimp_crop_layer_to_content (GimpImage   *image,
   return TRUE;
 }
 
+gboolean
+chopgimp_crop_selected_layers (GimpImage   *image,
+                               GimpContext *context)
+{
+  GList    *iter;
+  gboolean  cropped = FALSE;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_ITEM_RESIZE,
+                               _("Crop Layer to Content"));
+  for (iter = gimp_image_get_selected_layers (image); iter; iter = iter->next)
+    cropped |= chopgimp_crop_layer_to_content (image, iter->data, context);
+  gimp_image_undo_group_end (image);
+
+  return cropped;
+}
+
 
 typedef struct
 {
diff --git a/app/tools/chopgimp-tools.h b/app/tools/chopgimp-tools.h
index a78b6a1..c9cac99 100644
--- a/app/tools/chopgimp-tools.h
+++ b/app/tools/chopgimp-tools.h
@@ -22,6 +22,8 @@ gboolean chopgimp_layer_content_bounds   (GimpLayer        *layer,
 gboolean chopgimp_crop_layer_to_content  (GimpImage        *image,
                                           GimpLayer        *layer,
                                           GimpContext      *context);
+gboolean chopgimp_crop_selected_layers   (GimpImage        *image,
+                                          GimpContext      *context);
 void     chopgimp_switch_tool_later      (Gimp             *gimp,
                                           GimpDisplay      *display,
                                           const gchar      *tool_name,
