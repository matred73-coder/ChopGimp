+/*  ChopGimp: an area changed: its draft is outdated, and the current job
+ *  must not mark it as up to date
+ */
+static void
+gimp_projection_note_invalidated (GimpProjection              *proj,
+                                  const cairo_rectangle_int_t *rect)
+{
+  if (proj->priv->drafted_region)
+    cairo_region_subtract_rectangle (proj->priv->drafted_region, rect);
+
+  if (proj->priv->job)
+    {
+      if (proj->priv->job_invalidated)
+        cairo_region_union_rectangle (proj->priv->job_invalidated, rect);
+      else
+        proj->priv->job_invalidated = cairo_region_create_rectangle (rect);
     }
 }
 
