+ *
+ *  A job renders one area of the projection (a few short slices, each a
+ *  GEGL blit) into memory of its own, at full resolution or, for a draft,
+ *  at a mipmap level > 0.  The main thread then copies the result into
+ *  the projection buffer and emits the update.
+ *
+ *  - Background rendering: the job runs in the rendering thread
+ *    (gimp-gegl-graph-lock.c), taking the graph lock around each slice;
+ *    the main thread keeps the projection buffer and all of the
+ *    projection's state to itself.
+ *
+ *  - Drafts (fast preview): while the user acts on the image, the changed
+ *    areas are rendered at a reduced resolution and written at the level
+ *    the display reads (upscaled at 100 % zoom); they are re-rendered at
+ *    full resolution once the image stops changing.  When the display is
+ *    zoomed out, the visible area is first rendered at the displayed
+ *    level, then refined.  Only graphs whose operations scale correctly
+ *    with the level are drafted (gimp_gegl_graph_is_draftable()).
+ *
+ *  Without either, the projection is rendered by the original code path
+ *  (gimp_projection_chunk_render_step()).
+ */
+
+static gboolean
+gimp_projection_draft_allowed (void)
+{
+  static gint allowed = -1;
+
+  if (allowed < 0)
+    {
+      const gchar *env = g_getenv ("CHOPGIMP_NO_DRAFT");
+
+      allowed = (! env || ! *env || ! strcmp (env, "0"));
+    }
+
+  return allowed;
+}
+
+/*  whether the user acts on the image (input events, or the image being
+ *  changed) -- the fast preview criterion
+ */
+static gboolean
+gimp_projection_is_acting (GimpProjection *proj)
+{
+  gint64 now;
+
+  if (! proj->priv->fast_preview)
+    return FALSE;
+
+  now = g_get_monotonic_time ();
+
+  return (now - proj->priv->last_activity_time < CHOPGIMP_PROJECTION_ACTIVITY_TIME ||
+          now - proj->priv->last_update_time   < CHOPGIMP_PROJECTION_ACTIVITY_TIME);
+}
+
+static gboolean
+gimp_projection_want_thread (GimpProjection *proj)
+{
+  GimpProjectionPrivate *priv = proj->priv;
+  guint                  serial;
+
+  if (! priv->background_render                    ||
+      ! gimp_gegl_graph_lock_threading_allowed ()  ||
+      ! gimp_gegl_graph_lock_is_initialized ()     ||
+      ! GIMP_IS_IMAGE (priv->projectable)          ||
+      ! gimp_gegl_graph_lock_is_base_dispatch ())
+    {
+      return FALSE;
+    }
+
+  /*  the main thread takes the graph lock (and bumps the serial) whenever
+   *  it may have changed the graph
+   */
+  serial = gimp_gegl_graph_lock_get_serial ();
+
+  if (! priv->threadable_valid || serial != priv->threadable_serial)
+    {
+      priv->threadable =
+        gimp_gegl_graph_is_threadable (gimp_projectable_get_graph (priv->projectable));
+
+      priv->threadable_serial = serial;
+      priv->threadable_valid  = TRUE;
+    }
+
+  return priv->threadable;
+}
+
+static gboolean
+gimp_projection_want_draft (GimpProjection *proj)
+{
+  GimpProjectionPrivate *priv = proj->priv;
+  gint64                 now;
+
+  if (! priv->draft || ! GIMP_IS_IMAGE (priv->projectable))
+    return FALSE;
+
+  now = g_get_monotonic_time ();
+
+  if (now - priv->draftable_time > CHOPGIMP_PROJECTION_DRAFTABLE_TIME)
+    {
+      priv->draftable =
+        gimp_gegl_graph_is_draftable (gimp_projectable_get_graph (priv->projectable));
+
+      priv->draftable_time = now;
+    }
+
+  return priv->draftable;
+}
+
+static void
+gimp_projection_job_free (ChopRenderJob *job)
+{
+  g_clear_object (&job->graph);
+  g_free (job->subs);
+  g_free (job->data);
+  g_slice_free (ChopRenderJob, job);
+}
+
+/*  the area of the slices of @job from @first to @last (excluded), in
+ *  level-0 coordinates, clipped to the job's area
+ */
+static cairo_region_t *
+gimp_projection_job_get_region (ChopRenderJob *job,
+                                gint           first,
+                                gint           last)
+{
+  cairo_region_t *region = cairo_region_create ();
+  gint            i;
+
+  for (i = first; i < last; i++)
+    {
+      GeglRectangle rect;
+
+      rect.x      = job->subs[i].x      << job->level;
+      rect.y      = job->subs[i].y      << job->level;
+      rect.width  = job->subs[i].width  << job->level;
+      rect.height = job->subs[i].height << job->level;
+
+      if (gegl_rectangle_intersect (&rect, &rect, &job->rect))
+        cairo_region_union_rectangle (region,
+                                      (const cairo_rectangle_int_t *) &rect);
+    }
+
+  return region;
+}
+
+static void
+gimp_projection_job_blit (ChopRenderJob *job,
+                          gint           i)
+{
+  const GeglRectangle *sub = &job->subs[i];
+  guchar              *dest;
+
+  dest = job->data +
+         (sub->y - job->lrect.y) * job->stride +
+         (sub->x - job->lrect.x) * job->bpp;
+
+  if (job->level == 0)
+    {
+      gegl_node_blit (job->graph, 1.0, sub, job->format,
+                      dest, job->stride, GEGL_BLIT_DEFAULT);
+    }
+  else
+    {
+      gegl_node_blit_level (job->graph, sub, job->level, job->format,
+                            dest, job->stride);
+    }
+}
+
+static gboolean
+gimp_projection_job_done_idle (ChopRenderJob *job)
+{
+  if (g_atomic_int_get (&job->cancelled))
+    {
+      gimp_projection_job_free (job);
+    }
+  else
+    {
+      gimp_projection_job_complete (job->proj, job);
+    }
+
+  return G_SOURCE_REMOVE;
+}
+
+/*  runs in the rendering thread  */
+static void
+gimp_projection_job_thread_func (ChopRenderJob *job,
+                                 gpointer       unused)
+{
+  gint i;
+
+  for (i = 0; i < job->n_subs; i++)
+    {
+      gint64 start;
+      guint  serial;
+
+      if (g_atomic_int_get (&job->cancelled))
+        break;
+
+      gimp_gegl_graph_lock_worker_acquire ();
+
+      if (g_atomic_int_get (&job->cancelled))
+        {
+          gimp_gegl_graph_lock_worker_release ();
+          break;
+        }
+
+      /*  the main thread may have changed the graph since it was checked:
+       *  check it again, the main thread can't change it meanwhile
+       */
+      serial = gimp_gegl_graph_lock_get_serial ();
+
+      if (serial != job->checked_serial)
+        {
+          if (! gimp_gegl_graph_is_threadable (job->graph))
+            {
+              job->aborted = TRUE;
+
+              gimp_gegl_graph_lock_worker_release ();
+              break;
+            }
+
+          job->checked_serial = serial;
+        }
+
+      start = g_get_monotonic_time ();
+
+      gimp_projection_job_blit (job, i);
+
+      job->elapsed += g_get_monotonic_time () - start;
+
+      gimp_gegl_graph_lock_worker_release ();
+
+      job->n_done = i + 1;
+    }
+
+  g_idle_add_full (GIMP_PRIORITY_PROJECTION_IDLE,
+                   (GSourceFunc) gimp_projection_job_done_idle,
+                   job, NULL);
+}
+
+/*  runs a job in the main thread, for one time slice.  Returns whether
+ *  it is done.
+ */
+static gboolean
+gimp_projection_job_run_main (GimpProjection *proj,
+                              ChopRenderJob  *job)
+{
+  gint64 start  = g_get_monotonic_time ();
+  gint64 budget = gimp_projection_get_job_time (proj, FALSE);
+
+  while (job->n_done < job->n_subs)
+    {
+      gint64 t = g_get_monotonic_time ();
+
+      gimp_projection_job_blit (job, job->n_done);
+
+      job->elapsed += g_get_monotonic_time () - t;
+      job->n_done++;
+
+      if (g_get_monotonic_time () - start >= budget)
+        break;
+    }
+
+  return (job->n_done == job->n_subs);
+}
+
+static gboolean
+gimp_projection_job_watchdog (GimpProjection *proj)
+{
+  /*  let the next iteration check that the rendering thread isn't stuck
+   *  behind a nested main loop
+   */
+  gimp_projection_chunk_render_schedule (proj);
+
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+gimp_projection_job_remove_watchdog (GimpProjection *proj)
+{
+  if (proj->priv->job_watchdog_id)
+    {
+      g_source_remove (proj->priv->job_watchdog_id);
+      proj->priv->job_watchdog_id = 0;
+    }
+}
+
+/*  cancels the current job.  Returns the area it was to render (level-0
+ *  coordinates), or NULL.
+ */
+static cairo_region_t *
+gimp_projection_job_cancel (GimpProjection *proj)
+{
+  GimpProjectionPrivate *priv = proj->priv;
+  ChopRenderJob         *job  = priv->job;
+  cairo_region_t        *region;
+
+  if (! job)
+    return NULL;
+
+  priv->job = NULL;
+
+  gimp_projection_job_remove_watchdog (proj);
+
+  g_clear_pointer (&priv->job_invalidated, cairo_region_destroy);
+
+  region = cairo_region_create_rectangle ((const cairo_rectangle_int_t *) &job->rect);
+
+  if (job->on_main)
+    gimp_projection_job_free (job);
+  else
+    g_atomic_int_set (&job->cancelled, TRUE); /* freed by its done idle */
+
+  return region;
+}
+
+/*  the time a job (or a slice of it) should take, in microseconds  */
+static gint64
+gimp_projection_get_job_time (GimpProjection *proj,
+                              gboolean        threaded)
+{
+  if (threaded)
+    return CHOPGIMP_PROJECTION_THREAD_SLICE_TIME;
+
+  if (proj->priv->fast_preview)
+    return gimp_projection_get_interval (proj) * G_TIME_SPAN_SECOND;
+
+  return G_TIME_SPAN_SECOND / 15;
+}
+
+/*  takes the next area to render out of the chunk iterator, and makes a
+ *  job of it.  Returns NULL if there is nothing left to render.
+ */
+static ChopRenderJob *
+gimp_projection_job_new (GimpProjection *proj,
+                         gboolean        threaded,
+                         gboolean        drafting)
+{
+  GimpProjectionPrivate *priv = proj->priv;
+  ChopRenderJob         *job;
+  cairo_region_t        *region;
+  cairo_region_t        *candidates;
+  cairo_rectangle_int_t  first;
+  GeglRectangle          bounding_box;
+  GeglRectangle          priority;
+  GeglRectangle          cell;
+  GeglRectangle          rect;
+  gboolean               has_priority;
+  gboolean               in_view;
+  gboolean               acting;
+  gint                   display_level = priv->display_level;
+  gint                   align_level;
+  gint                   align_w, align_h;
+  gint                   level         = 0;
+  gint64                 job_time;
+  gdouble                rate;
+  gdouble                target_pixels;
+  gint                   band_height;
+  gint                   y;
+  gint                   i;
+
+  if (! priv->iter)
+    return NULL;
+
+  region     = gimp_chunk_iterator_stop (priv->iter, FALSE);
+  priv->iter = NULL;
+
+  if (cairo_region_is_empty (region))
+    {
+      cairo_region_destroy (region);
+      return NULL;
+    }
+
+  bounding_box = gimp_projectable_get_bounding_box (priv->projectable);
+
+  /*  the visible part first  */
+  has_priority = gimp_projection_get_priority_area (proj, &priority);
+
+  candidates = cairo_region_copy (region);
+
+  if (has_priority)
+    {
+      cairo_region_intersect_rectangle (candidates,
+                                        (const cairo_rectangle_int_t *) &priority);
+
+      /*  drafts of the visible part before its refinement  */
+      if (drafting && priv->drafted_region &&
+          ! cairo_region_is_empty (candidates))
+        {
+          cairo_region_t *undrafted = cairo_region_copy (candidates);
+
+          cairo_region_subtract (undrafted, priv->drafted_region);
+
+          if (cairo_region_is_empty (undrafted))
+            {
+              cairo_region_destroy (undrafted);
+            }
+          else
+            {
+              cairo_region_destroy (candidates);
+              candidates = undrafted;
+            }
+        }
+
+      if (cairo_region_is_empty (candidates))
+        {
+          cairo_region_destroy (candidates);
+          candidates = cairo_region_copy (region);
+        }
+    }
+
+  cairo_region_get_rectangle (candidates, 0, &first);
+  cairo_region_destroy (candidates);
+
+  /*  align the areas to the tiles of the displayed level, so that a draft
+   *  is replaced at once by its refinement (a level-0 write damages the
+   *  whole tile of the levels above)
+   */
+  align_level = MIN (display_level, 2);
+
+  if (align_level > 0)
+    {
+      align_w = priv->tile_width  << align_level;
+      align_h = priv->tile_height << align_level;
+    }
+  else
+    {
+      align_w = align_h = 64;
+    }
+
+  cell.x      = (gint) floor ((gdouble) first.x / align_w) * align_w;
+  cell.y      = (gint) floor ((gdouble) first.y / align_h) * align_h;
+  cell.width  = align_w;
+  cell.height = align_h;
+
+  in_view = has_priority && gegl_rectangle_intersect (NULL, &cell, &priority);
+  acting  = gimp_projection_is_acting (proj);
+
+  if (drafting)
+    {
+      gboolean      drafted = FALSE;
+      GeglRectangle check;
+
+      /*  whether the area picked is drafted already (to be refined)  */
+      check.x      = first.x;
+      check.y      = first.y;
+      check.width  = first.width;
+      check.height = first.height;
+
+      if (priv->drafted_region &&
+          gegl_rectangle_intersect (&check, &check, &bounding_box))
+        {
+          drafted = (cairo_region_contains_rectangle (
+                       priv->drafted_region,
+                       (const cairo_rectangle_int_t *) &check) ==
+                     CAIRO_REGION_OVERLAP_IN);
+        }
+
+      if (! drafted)
+        {
+          if (acting)
+            level = MAX (1, display_level);
+          else if (display_level > 0 && in_view)
+            level = display_level;
+        }
+
+      level = MIN (level, CHOPGIMP_PROJECTION_MAX_DRAFT_LEVEL);
+    }
+
+  /*  the size of the area, from the measured rendering rate  */
+  job_time = gimp_projection_get_job_time (proj, threaded);
+  rate     = priv->rate > 0.0 ? priv->rate : CHOPGIMP_PROJECTION_INITIAL_RATE;
+
+  target_pixels = rate * job_time;
+
+  if (threaded)
+    target_pixels *= CHOPGIMP_PROJECTION_THREAD_SLICES;
+
+  if (align_level == 0)
+    {
+      gint side;
+
+      /*  at level-0 resolution  */
+      side = (gint) sqrt (target_pixels * (1 << (2 * level)));
+      side = CLAMP ((side + 32) / 64 * 64, 64, 512);
+
+      cell.width  = side;
+      cell.height = side;
+    }
+
+  /*  only what needs to be rendered in that cell  */
+  {
+    cairo_region_t        *in_cell = cairo_region_copy (region);
+    cairo_rectangle_int_t  extents;
+
+    cairo_region_intersect_rectangle (in_cell,
+                                      (const cairo_rectangle_int_t *) &cell);
+    cairo_region_get_extents (in_cell, &extents);
+    cairo_region_destroy (in_cell);
+
+    rect.x      = extents.x;
+    rect.y      = extents.y;
+    rect.width  = extents.width;
+    rect.height = extents.height;
+  }
+
+  /*  a draft covers whole pixels of its level: align the area on them
+   *  (inside the cell, which is aligned on 64 pixels at least), so that
+   *  no pixel outside of the area gets a draft without being refined
+   */
+  if (level > 0 && ! gegl_rectangle_is_empty (&rect))
+    {
+      gint a  = 1 << level;
+      gint x1 = (gint) floor ((gdouble) rect.x / a) * a;
+      gint y1 = (gint) floor ((gdouble) rect.y / a) * a;
+      gint x2 = (gint) ceil ((gdouble) (rect.x + rect.width)  / a) * a;
+      gint y2 = (gint) ceil ((gdouble) (rect.y + rect.height) / a) * a;
+
+      rect.x      = x1;
+      rect.y      = y1;
+      rect.width  = x2 - x1;
+      rect.height = y2 - y1;
+
+      gegl_rectangle_intersect (&rect, &rect, &cell);
+    }
+
+  if (! gegl_rectangle_intersect (&rect, &rect, &bounding_box))
+    {
+      /*  can't happen, the update region is clipped to the bounding box  */
+      cairo_region_subtract_rectangle (region,
+                                       (const cairo_rectangle_int_t *) &cell);
+      rect.width = 0;
+    }
+  else
+    {
+      cairo_region_subtract_rectangle (region,
+                                       (const cairo_rectangle_int_t *) &rect);
+    }
+
+  /*  the rest stays in the iterator  */
+  if (cairo_region_is_empty (region))
+    {
+      cairo_region_destroy (region);
+    }
+  else
+    {
+      priv->iter = gimp_chunk_iterator_new (region);
+
+      gimp_projection_update_priority_rect (proj);
+    }
+
+  if (gegl_rectangle_is_empty (&rect))
+    return NULL;
+
+  job = g_slice_new0 (ChopRenderJob);
+
+  job->proj   = proj;
+  job->graph  = g_object_ref (gimp_projectable_get_graph (priv->projectable));
+  job->format = gimp_projection_get_format (GIMP_PICKABLE (proj));
+  job->bpp    = babl_format_get_bytes_per_pixel (job->format);
+  job->level  = level;
+  job->rect   = rect;
+
+  /*  the area at the rendered level (rounded outwards)  */
+  job->lrect.x      = rect.x >> level;
+  job->lrect.y      = rect.y >> level;
+  job->lrect.width  = ((rect.x + rect.width  + (1 << level) - 1) >> level) -
+                      job->lrect.x;
+  job->lrect.height = ((rect.y + rect.height + (1 << level) - 1) >> level) -
+                      job->lrect.y;
+
+  job->stride = job->lrect.width * job->bpp;
+  job->data   = g_malloc ((gsize) job->stride * job->lrect.height);
+
+  /*  slices: bands of rows, each about one time slice  */
+  band_height = (gint) (rate * gimp_projection_get_job_time (proj, threaded) /
+                        MAX (job->lrect.width, 1));
+  band_height = CLAMP (band_height, 8, MAX (job->lrect.height, 8));
+
+  job->n_subs = (job->lrect.height + band_height - 1) / band_height;
+  job->subs   = g_new (GeglRectangle, job->n_subs);
+
+  for (i = 0, y = job->lrect.y; i < job->n_subs; i++, y += band_height)
+    {
+      job->subs[i].x      = job->lrect.x;
+      job->subs[i].y      = y;
+      job->subs[i].width  = job->lrect.width;
+      job->subs[i].height = MIN (band_height,
+                                 job->lrect.y + job->lrect.height - y);
+    }
+
+  job->checked_serial = priv->threadable_serial;
+
+  return job;
+}
+
+/*  writes a draft (rendered at job->level) into the projection buffer, at
+ *  the level the display reads
+ */
+static void
+gimp_projection_job_write_draft (GimpProjection *proj,
+                                 ChopRenderJob  *job,
+                                 gint            n_rows)
+{
+  GimpProjectionPrivate *priv   = proj->priv;
+  const GeglRectangle   *extent = gegl_buffer_get_extent (priv->buffer);
+  gint                   wlevel = MIN (priv->display_level, job->level);
+  gint                   factor = 1 << (job->level - wlevel);
+  GeglRectangle          wrect;
+  GeglRectangle          wextent;
+
+  /*  the written area, at the written level  */
+  wrect.x      = job->lrect.x * factor;
+  wrect.y      = job->lrect.y * factor;
+  wrect.width  = job->lrect.width * factor;
+  wrect.height = n_rows * factor;
+
+  wextent.x      = extent->x >> wlevel;
+  wextent.y      = extent->y >> wlevel;
+  wextent.width  = ((extent->x + extent->width  + (1 << wlevel) - 1) >> wlevel) -
+                   wextent.x;
+  wextent.height = ((extent->y + extent->height + (1 << wlevel) - 1) >> wlevel) -
+                   wextent.y;
+
+  if (! gegl_rectangle_intersect (&wrect, &wrect, &wextent))
+    return;
+
+  if (factor == 1)
+    {
+      gegl_buffer_set (priv->buffer, &wrect, wlevel, job->format,
+                       job->data +
+                       (wrect.y - job->lrect.y) * job->stride +
+                       (wrect.x - job->lrect.x) * job->bpp,
+                       job->stride);
+    }
+  else
+    {
+      gint    stride = wrect.width * job->bpp;
+      guchar *up     = g_malloc ((gsize) stride * wrect.height);
+      gint    x, y;
+
+      /*  nearest-neighbor upscaling  */
+      for (y = 0; y < wrect.height; y++)
+        {
+          const guchar *src_row = job->data +
+                                  ((wrect.y + y) / factor - job->lrect.y) *
+                                  job->stride;
+          guchar       *dest    = up + y * stride;
+
+          for (x = 0; x < wrect.width; x++)
+            {
+              memcpy (dest + x * job->bpp,
+                      src_row +
+                      ((wrect.x + x) / factor - job->lrect.x) * job->bpp,
+                      job->bpp);
+            }
+        }
+
+      gegl_buffer_set (priv->buffer, &wrect, wlevel, job->format,
+                       up, stride);
+
+      g_free (up);
+    }
+}
+
+/*  main thread: copies the result of a job into the projection  */
+static void
+gimp_projection_job_complete (GimpProjection *proj,
+                              ChopRenderJob  *job)
+{
+  GimpProjectionPrivate *priv = proj->priv;
+  cairo_region_t        *done;
+  cairo_region_t        *rest;
+  gint                   n_rows = 0;
+  gint                   i;
+
+  g_return_if_fail (priv->job == job);
+
+  priv->job = NULL;
+
+  gimp_projection_job_remove_watchdog (proj);
+
+  for (i = 0; i < job->n_done; i++)
+    n_rows += job->subs[i].height;
+
+  /*  measured rate, in rendered pixels per microsecond  */
+  if (job->n_done > 0 && job->elapsed > 0)
+    {
+      gdouble rate = (gdouble) job->lrect.width * n_rows / job->elapsed;
+
+      if (priv->rate > 0.0)
+        priv->rate = (priv->rate + rate) / 2.0;
+      else
+        priv->rate = rate;
+
+      priv->rate = CLAMP (priv->rate, 0.001, 10000.0);
+    }
+
+  if (job->aborted)
+    priv->threadable_valid = FALSE;
+
+  done = gimp_projection_job_get_region (job, 0, job->n_done);
+  rest = gimp_projection_job_get_region (job, job->n_done, job->n_subs);
+
+  {
+    static gint debug = -1;
+
+    if (debug < 0)
+      debug = (g_getenv ("CHOPGIMP_DEBUG_RENDER") != NULL);
+
+    if (debug)
+      g_printerr ("chopgimp: job %s level %d %dx%d+%d+%d slices %d/%d%s, "
+                  "%.1f ms, rate %.3f px/us\n",
+                  job->on_main ? "main" : "thread", job->level,
+                  job->rect.width, job->rect.height, job->rect.x, job->rect.y,
+                  job->n_done, job->n_subs, job->aborted ? " aborted" : "",
+                  job->elapsed / 1000.0, priv->rate);
+  }
+
+  if (priv->buffer && job->n_done > 0)
+    {
+      cairo_region_t *valid;
+      gint            n_rects;
+      gint            off_x, off_y;
+
+      gimp_tile_handler_validate_begin_validate (priv->validate_handler);
+
+      if (job->level == 0)
+        {
+          GeglRectangle rows = job->lrect;
+
+          rows.height = n_rows;
+
+          gegl_rectangle_intersect (&rows, &rows,
+                                    gegl_buffer_get_extent (priv->buffer));
+
+          gegl_buffer_set (priv->buffer, &rows, 0, job->format,
+                           job->data +
+                           (rows.y - job->lrect.y) * job->stride +
+                           (rows.x - job->lrect.x) * job->bpp,
+                           job->stride);
+        }
+      else
+        {
+          gimp_projection_job_write_draft (proj, job, n_rows);
+        }
+
+      gimp_tile_handler_validate_end_validate (priv->validate_handler);
+
+      /*  what wasn't invalidated meanwhile is now up to date  */
+      valid = cairo_region_copy (done);
+
+      if (priv->job_invalidated)
+        cairo_region_subtract (valid, priv->job_invalidated);
+
+      if (job->level == 0)
+        {
+          n_rects = cairo_region_num_rectangles (valid);
+
+          for (i = 0; i < n_rects; i++)
+            {
+              cairo_rectangle_int_t r;
+
+              cairo_region_get_rectangle (valid, i, &r);
+
+              gimp_tile_handler_validate_undo_invalidate (
+                priv->validate_handler, (const GeglRectangle *) &r);
+            }
+
+          if (priv->drafted_region)
+            cairo_region_subtract (priv->drafted_region, done);
+        }
+      else
+        {
+          /*  a draft: to be refined once the image stops changing  */
+          if (! priv->drafted_region)
+            priv->drafted_region = cairo_region_create ();
+
+          cairo_region_union (priv->drafted_region, valid);
+
+          if (! priv->refine_region)
+            priv->refine_region = cairo_region_create ();
+
+          cairo_region_union (priv->refine_region, done);
+        }
+
+      cairo_region_destroy (valid);
+
+      /*  update the display  */
+      gimp_projectable_get_offset (priv->projectable, &off_x, &off_y);
+
+      n_rects = cairo_region_num_rectangles (done);
+
+      for (i = 0; i < n_rects; i++)
+        {
+          cairo_rectangle_int_t r;
+
+          cairo_region_get_rectangle (done, i, &r);
+
+          g_signal_emit (proj, projection_signals[UPDATE], 0,
+                         TRUE,
+                         r.x + off_x, r.y + off_y,
+                         r.width, r.height);
+        }
+    }
+
+  g_clear_pointer (&priv->job_invalidated, cairo_region_destroy);
+
+  cairo_region_destroy (done);
+
+  gimp_projection_job_free (job);
+
+  /*  what wasn't rendered (cancelled slices) goes back to the iterator  */
+  if (! cairo_region_is_empty (rest))
+    gimp_projection_chunk_render_merge (proj, rest, TRUE);
+  else
+    cairo_region_destroy (rest);
+
+  /*  when the image isn't changing (a zoomed-out display being drawn),
+   *  the visible drafts are refined right away, before the parts out of
+   *  view
+   */
+  if (priv->refine_region && ! gimp_projection_defer_offscreen (proj))
+    gimp_projection_chunk_render_merge (proj, NULL, TRUE);
+
+  if (priv->iter || priv->deferred_region || priv->refine_region)
+    {
+      gimp_projection_chunk_render_schedule (proj);
+    }
+  else if (priv->invalidate_preview)
+    {
+      /* invalidate the preview here since it is constructed from
+       * the projection
+       */
+      priv->invalidate_preview = FALSE;
+
+      gimp_projectable_invalidate_preview (priv->projectable);
+    }
+}
+
+/*  one iteration of the job path.  Returns whether to call it again.  */
+static gboolean
+gimp_projection_job_iteration (GimpProjection *proj,
+                               gboolean        threaded,
+                               gboolean        drafting)
+{
+  GimpProjectionPrivate *priv = proj->priv;
+  ChopRenderJob         *job;
+
+  job = gimp_projection_job_new (proj, threaded, drafting);
+
+  if (! job)
+    return (priv->iter || priv->deferred_region || priv->refine_region);
+
+  priv->job = job;
+
+  if (threaded)
+    {
+      priv->job_watchdog_id =
+        g_timeout_add_full (GIMP_PRIORITY_PROJECTION_IDLE,
+                            CHOPGIMP_PROJECTION_WATCHDOG_INTERVAL,
+                            (GSourceFunc) gimp_projection_job_watchdog,
+                            proj, NULL);
+
+      gimp_gegl_graph_run_in_thread ((GFunc) gimp_projection_job_thread_func,
+                                     job);
+
+      /*  the done idle schedules the next iteration  */
+      return FALSE;
+    }
+
+  job->on_main = TRUE;
+
+  if (gimp_projection_job_run_main (proj, job))
+    gimp_projection_job_complete (proj, job);
+
+  return (priv->job || priv->iter || priv->deferred_region ||
+          priv->refine_region);
+}
