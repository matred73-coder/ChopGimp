+/**
+ * gimp_projection_set_background_render:
+ * @proj:              a #GimpProjection
+ * @background_render: whether to render in the rendering thread
+ *
+ * ChopGimp: when @background_render is %TRUE, the projection of an image
+ * is rendered in a thread of its own, so that heavy graphs don't block
+ * the main thread (see gimp-gegl-graph-lock.c).  Has no effect when the
+ * CHOPGIMP_NO_THREADED_RENDER environment variable is set.  Must be
+ * called from the main thread.
+ */
+void
+gimp_projection_set_background_render (GimpProjection *proj,
+                                       gboolean        background_render)
+{
+  g_return_if_fail (GIMP_IS_PROJECTION (proj));
+
+  background_render = (background_render                         &&
+                       GIMP_IS_IMAGE (proj->priv->projectable)   &&
+                       gimp_gegl_graph_lock_threading_allowed ());
+
+  if (background_render == proj->priv->background_render)
+    return;
+
+  if (background_render)
+    gimp_gegl_graph_lock_init ();
+
+  proj->priv->background_render = background_render;
+
+  if (! background_render && proj->priv->job && ! proj->priv->job->on_main)
+    {
+      cairo_region_t *region = gimp_projection_job_cancel (proj);
+
+      if (gimp_projection_chunk_render_merge (proj, region, TRUE))
+        gimp_projection_chunk_render_schedule (proj);
+    }
+}
+
+/**
+ * gimp_projection_set_display_scale:
+ * @proj:  a #GimpProjection
+ * @scale: the scale the projection is displayed at (in device pixels)
+ *
+ * ChopGimp: the display reads the projection buffer at the mipmap level
+ * matching @scale; drafts are written at that level.
+ */
+void
+gimp_projection_set_display_scale (GimpProjection *proj,
+                                   gdouble         scale)
+{
+  gint level = 0;
+
+  g_return_if_fail (GIMP_IS_PROJECTION (proj));
+
+  /*  as gegl_buffer_get()  */
+  while (scale > 0.0 && scale <= 0.5 && level < 8)
+    {
+      scale *= 2.0;
+      level++;
+    }
+
+  if (level != proj->priv->display_level)
+    {
+      proj->priv->display_level = level;
+
+      /*  drafts were written at the previous level  */
+      g_clear_pointer (&proj->priv->drafted_region, cairo_region_destroy);
+    }
+}
