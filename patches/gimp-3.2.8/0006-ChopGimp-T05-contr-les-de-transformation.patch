+/*  ChopGimp: release the on-canvas grid. Its properties are bound to the
+ *  (shared) tool options: a grid left alive after its tool is gone keeps
+ *  receiving the options' changes (e.g. Ctrl/Shift constraints while
+ *  hovering another grid) and called its "changed" handler on the dead
+ *  tool → crash. Disconnect every handler pointing at the tool first.
+ */
+static void
+chopgimp_transform_grid_release_widget (GimpTransformGridTool *tg_tool)
+{
+  if (! tg_tool->widget)
+    return;
+
+  g_signal_handlers_disconnect_by_data (tg_tool->widget, tg_tool);
+
+  if (GIMP_DRAW_TOOL (tg_tool)->widget == tg_tool->widget)
+    gimp_draw_tool_set_widget (GIMP_DRAW_TOOL (tg_tool), NULL);
+
+  g_clear_object (&tg_tool->widget);
+}
+
+/*  ChopGimp: the crop-to-content done at initialize is kept with the
+ *  transform (commit) ...
+ */
+static void
+chopgimp_transform_grid_forget_crop (GimpTransformGridTool *tg_tool)
+{
+  g_clear_weak_pointer (&tg_tool->chopgimp_crop_image);
+  g_clear_weak_pointer (&tg_tool->chopgimp_crop_undo);
+}
+
+/*  ... and taken back when the transform is cancelled, if it is still
+ *  the last undo step
+ */
+static void
+chopgimp_transform_grid_revert_crop (GimpTransformGridTool *tg_tool)
+{
+  GimpImage *image = tg_tool->chopgimp_crop_image;
+  GimpUndo  *undo  = tg_tool->chopgimp_crop_undo;
+
+  chopgimp_transform_grid_forget_crop (tg_tool);
+
+  if (image && undo                                   &&
+      gimp_image_get_undo_group_count (image) == 0    &&
+      gimp_undo_stack_peek (gimp_image_get_undo_stack (image)) == undo)
+    {
+      gimp_image_undo (image);
+      gimp_image_flush (image);
+    }
+}
