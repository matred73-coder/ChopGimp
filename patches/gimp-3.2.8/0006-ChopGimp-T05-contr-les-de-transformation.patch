+
+static gboolean
+chopgimp_layer_is_croppable (GimpLayer *layer)
+{
+  GimpItem *item = GIMP_ITEM (layer);
+
+  return ! gimp_viewable_get_children (GIMP_VIEWABLE (layer)) &&
+         ! gimp_item_is_text_layer (item)                     &&
+         ! gimp_item_is_vector_layer (item)                   &&
+         ! gimp_layer_is_floating_sel (layer);
+}
+
+/*  Bounds (image coordinates) of the visible content of @layer, like the
+ *  box Photoshop draws with « Show Transform Controls ».
+ */
+gboolean
+chopgimp_layer_content_bounds (GimpLayer *layer,
+                               gint      *x,
+                               gint      *y,
+                               gint      *width,
+                               gint      *height)
+{
+  GimpItem *item = GIMP_ITEM (layer);
+  gint      ox, oy, w, h;
+  gint      sx = 0, sy = 0, sw, sh;
+
+  gimp_item_get_offset (item, &ox, &oy);
+  w = sw = gimp_item_get_width  (item);
+  h = sh = gimp_item_get_height (item);
+
+  if (chopgimp_layer_is_croppable (layer))
+    {
+      /*  cached: called on every undo step while the Move tool is active
+       *  (only draws the controls; the crops recompute the bounds)
+       */
+      switch (chopgimp_alpha_bounds_cached (GIMP_DRAWABLE (layer), &sx, &sy, &sw, &sh))
+        {
+        case GIMP_AUTO_SHRINK_EMPTY:
+          return FALSE;
+
+        case GIMP_AUTO_SHRINK_UNSHRINKABLE:
+          sx = 0; sy = 0; sw = w; sh = h;
+          break;
+
+        case GIMP_AUTO_SHRINK_SHRINK:
+          break;
+        }
+    }
+
+  *x      = ox + sx;
+  *y      = oy + sy;
+  *width  = sw;
+  *height = sh;
+
+  return TRUE;
+}
+
+/*  Photoshop has no layer bounds: before transforming, fit the layer to its
+ *  content (no pixel is lost) so the handles surround the object.
+ */
+gboolean
+chopgimp_crop_layer_to_content (GimpImage   *image,
+                                GimpLayer   *layer,
+                                GimpContext *context)
+{
+  gint x, y, w, h;
+
+  if (! chopgimp_layer_is_croppable (layer)                    ||
+      gimp_item_is_content_locked  (GIMP_ITEM (layer), NULL)   ||
+      gimp_item_is_position_locked (GIMP_ITEM (layer), NULL))
+    return FALSE;
+
+  if (chopgimp_alpha_bounds (GIMP_DRAWABLE (layer), &x, &y, &w, &h) != GIMP_AUTO_SHRINK_SHRINK)
+    return FALSE;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_ITEM_RESIZE,
+                               _("Crop Layer to Content"));
+  gimp_item_resize (GIMP_ITEM (layer), context, GIMP_FILL_TRANSPARENT,
+                    w, h, -x, -y);
+  gimp_image_undo_group_end (image);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_crop_selected_layers (GimpImage   *image,
+                               GimpContext *context)
+{
+  GList    *iter;
+  gboolean  cropped = FALSE;
+  gboolean  needed  = FALSE;
+
+  /*  no undo step (which would also clear the redo history) when there
+   *  is nothing to crop
+   */
+  for (iter = gimp_image_get_selected_layers (image); iter && ! needed; iter = iter->next)
+    {
+      GimpLayer *layer = iter->data;
+      gint       x, y, w, h;
+
+      if (chopgimp_layer_is_croppable (layer)                    &&
+          ! gimp_item_is_content_locked  (GIMP_ITEM (layer), NULL) &&
+          ! gimp_item_is_position_locked (GIMP_ITEM (layer), NULL) &&
+          chopgimp_alpha_bounds (GIMP_DRAWABLE (layer), &x, &y, &w, &h) == GIMP_AUTO_SHRINK_SHRINK)
+        needed = TRUE;
+    }
+
+  if (! needed)
+    return FALSE;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_ITEM_RESIZE,
+                               _("Crop Layer to Content"));
+  for (iter = gimp_image_get_selected_layers (image); iter; iter = iter->next)
+    cropped |= chopgimp_crop_layer_to_content (image, iter->data, context);
+  gimp_image_undo_group_end (image);
+
+  return cropped;
+}
