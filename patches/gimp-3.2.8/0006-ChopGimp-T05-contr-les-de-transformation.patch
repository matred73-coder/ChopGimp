+typedef struct
+{
+  Gimp            *gimp;
+  GimpDisplay     *display;
+  gchar           *tool_name;
+  gboolean         press;
+  GimpCoords       coords;
+  guint32          time;
+  GdkModifierType  state;
+} SwitchData;
+
+static gboolean
+chopgimp_switch_tool_idle (SwitchData *s)
+{
+  GimpToolInfo *info = gimp_get_tool_info (s->gimp, s->tool_name);
+
+  if (info)
+    gimp_context_set_tool (gimp_get_user_context (s->gimp), info);
+
+  if (s->press && s->display && gimp_display_get_image (s->display))
+    {
+      if (tool_manager_initialize_active (s->gimp, s->display))
+        {
+          GdkSeat         *seat = gdk_display_get_default_seat (gdk_display_get_default ());
+          GdkModifierType  mask = 0;
+
+          tool_manager_button_press_active (s->gimp, &s->coords, s->time,
+                                            s->state, GIMP_BUTTON_PRESS_NORMAL,
+                                            s->display);
+
+          /*  the button was already released (quick click, double-click):
+           *  the new tool gets the release too, it must not stay active
+           */
+          gdk_window_get_device_position (gdk_get_default_root_window (),
+                                          gdk_seat_get_pointer (seat),
+                                          NULL, NULL, &mask);
+          if (! (mask & GDK_BUTTON1_MASK))
+            tool_manager_button_release_active (s->gimp, &s->coords, s->time,
+                                                s->state, s->display);
+        }
+    }
+
+  g_clear_object (&s->display);
+  g_free (s->tool_name);
+  g_free (s);
+
+  return G_SOURCE_REMOVE;
+}
+
+/*  Switch to @tool_name once the current event is handled; if @press_coords
+ *  is given, the new tool receives the button press (so the user's drag on
+ *  a handle continues in the new tool).
+ */
+void
+chopgimp_switch_tool_later (Gimp             *gimp,
+                            GimpDisplay      *display,
+                            const gchar      *tool_name,
+                            const GimpCoords *press_coords,
+                            guint32           time,
+                            GdkModifierType   state)
+{
+  SwitchData *s = g_new0 (SwitchData, 1);
+
+  s->gimp      = gimp;
+  s->display   = display ? g_object_ref (display) : NULL;
+  s->tool_name = g_strdup (tool_name);
+  s->time      = time;
+  s->state     = state;
+
+  if (press_coords)
+    {
+      s->press  = TRUE;
+      s->coords = *press_coords;
+    }
+
+  g_idle_add ((GSourceFunc) chopgimp_switch_tool_idle, s);
+}
+
+
+/*  (re)start a draw tool on @display and redraw it  */
+void
+chopgimp_draw_tool_redraw (GimpDrawTool *draw_tool,
+                           GimpDisplay  *display)
+{
+  g_return_if_fail (GIMP_IS_DRAW_TOOL (draw_tool));
+
+  gimp_draw_tool_pause (draw_tool);
+
+  if (gimp_draw_tool_is_active (draw_tool) && draw_tool->display != display)
+    gimp_draw_tool_stop (draw_tool);
+
+  if (! gimp_draw_tool_is_active (draw_tool))
+    gimp_draw_tool_start (draw_tool, display);
+
+  gimp_draw_tool_resume (draw_tool);
+}
+
+
+/*  ─── 4.1.1: ONE object selection, shared by every tool and panel ──────
+ *
+ *  The selection of objects lives in the active vector layer
+ *  (chopgimp_vlayer_get_selection) and every style change edits
+ *  chopgimp_vobjects_style_targets(). This watcher keeps the rest of the
+ *  application in step with it:
+ *
+ *   - the foreground / background colors follow the selected object when
+ *     it is selected (its fill / stroke), without changing it;
+ *   - with a vector tool, a new foreground / background color (swatch,
+ *     color dialog, picker, X) recolors the fill / stroke of the
+ *     selection (one undo step per burst);
+ *   - the fill / stroke options of the drawing tools (Forme, Plume,
+ *     Courbure, Crayon…) show the selection and edit it;
+ *   - one selection: when another layer becomes active, the objects of
+ *     the previous one are deselected (never edited unseen);
+ *   - a vector layer added by the user (new shape, import, duplicate,
+ *     vectorized text…) has its objects selected when it becomes active.
+ */
+
+static struct
+{
+  Gimp            *gimp;
+  GimpContext     *context;
+  GimpImage       *image;      /* weak */
+  GimpVectorLayer *layer;      /* weak, the watched active layer */
+  gboolean         syncing;
+} vss;
+
+static const gchar *const vss_vector_tools[] =
+{
+  "gimp-move-tool", "gimp-direct-select-tool", "gimp-direct-lasso-tool",
+  "gimp-shape-tool",
+  "gimp-path-tool", "gimp-curvature-tool", "gimp-vpencil-tool",
+  "gimp-vsmooth-tool", "gimp-vblob-tool", "gimp-shape-builder-tool",
+  "gimp-vscissors-tool", "gimp-vknife-tool", "gimp-vjoin-tool",
+  "gimp-width-tool", "gimp-envelope-tool", "gimp-live-paint-select-tool",
+  "gimp-vblend-tool", "gimp-vmesh-tool", "gimp-perspective-select-tool",
+  "gimp-color-picker-tool"
+};
+
+gboolean
+chopgimp_tool_is_vector (GimpToolInfo *info)
+{
+  const gchar *id = info ? gimp_object_get_name (info) : NULL;
+
+  if (! id)
+    return FALSE;
+
+  for (guint i = 0; i < G_N_ELEMENTS (vss_vector_tools); i++)
+    if (! strcmp (id, vss_vector_tools[i]))
+      return TRUE;
+
+  return FALSE;
+}
+
+static GimpPathOptions *
+vss_path_options (void)
+{
+  GimpToolInfo *info = vss.context ? gimp_context_get_tool (vss.context) : NULL;
+
+  if (info && GIMP_IS_PATH_OPTIONS (info->tool_options))
+    {
+      GimpPathOptions *popts = GIMP_PATH_OPTIONS (info->tool_options);
+
+      gimp_path_options_ensure_fill_stroke (popts);
+      return popts;
+    }
+
+  return NULL;
+}
+
+static GimpVectorLayer *
+vss_active_layer (void)
+{
+  return vss.image ? chopgimp_vobjects_get_active_layer (vss.image) : NULL;
+}
+
+/*  selection → foreground / background and the tool's fill / stroke  */
+static void
+vss_load (void)
+{
+  GimpVectorLayer *layer = vss_active_layer ();
+  GimpPathOptions *popts;
+  GeglColor       *fill, *stroke;
+  gboolean         ef, es;
+
+  if (! layer || vss.syncing)
+    return;
+
+  vss.syncing = TRUE;
+
+  if (chopgimp_vobjects_selection_colors (layer, &fill, &stroke))
+    {
+      if (fill)
+        gimp_context_set_foreground (vss.context, fill);
+      if (stroke)
+        gimp_context_set_background (vss.context, stroke);
+    }
+
+  if ((popts = vss_path_options ()) &&
+      chopgimp_vobjects_load_tool_style (layer, &ef, popts->fill_options,
+                                         &es, popts->stroke_options))
+    g_object_set (popts, "enable-fill", ef, "enable-stroke", es, NULL);
+
+  vss.syncing = FALSE;
+}
+
+static void
+vss_color_changed (GeglColor *color,
+                   gboolean   stroke)
+{
+  GimpVectorLayer *layer;
+
+  if (vss.syncing || ! color ||
+      ! chopgimp_tool_is_vector (gimp_context_get_tool (vss.context)) ||
+      ! (layer = vss_active_layer ()))
+    return;
+
+  if (chopgimp_vobjects_apply_color (layer, color, stroke, TRUE))
+    {
+      gimp_image_flush (vss.image);
+      vss_load ();   /* the tool's options show the new color */
+    }
+}
+
+static void
+vss_fg_changed (GimpContext *context,
+                GeglColor   *color,
+                gpointer     data)
+{
+  vss_color_changed (color, FALSE);
+}
+
+static void
+vss_bg_changed (GimpContext *context,
+                GeglColor   *color,
+                gpointer     data)
+{
+  vss_color_changed (color, TRUE);
+}
+
+/*  the fill / stroke options of a drawing tool → the selection  */
+static void
+vss_options_notify (GObject    *object,
+                    GParamSpec *pspec,
+                    gpointer    data)
+{
+  GimpPathOptions *popts = vss_path_options ();
+  GimpVectorLayer *layer;
+  gboolean         fill;
+
+  if (vss.syncing || ! popts || ! (layer = vss_active_layer ()))
+    return;
+
+  if (object == G_OBJECT (popts->fill_options))
+    fill = TRUE;
+  else if (object == G_OBJECT (popts->stroke_options))
+    fill = FALSE;
+  else if (object == G_OBJECT (popts) && ! strcmp (pspec->name, "enable-fill"))
+    fill = TRUE;
+  else if (object == G_OBJECT (popts) && ! strcmp (pspec->name, "enable-stroke"))
+    fill = FALSE;
+  else
+    return;
+
+  /*  the Direct Selection (A) bar edits the objects itself  */
+  {
+    GimpToolInfo *info = gimp_context_get_tool (vss.context);
+
+    if (! info || ! strcmp (gimp_object_get_name (info), "gimp-direct-select-tool") ||
+        ! strcmp (gimp_object_get_name (info), "gimp-direct-lasso-tool"))
+      return;
+  }
+
+  if (chopgimp_vobjects_apply_tool_style (layer,
+                                          popts->enable_fill, popts->fill_options,
+                                          popts->enable_stroke, popts->stroke_options,
+                                          fill))
+    gimp_image_flush (vss.image);
+}
+
+static void
+vss_tool_changed (GimpContext  *context,
+                  GimpToolInfo *info,
+                  gpointer      data)
+{
+  GimpPathOptions *popts = vss_path_options ();
+
+  if (popts && ! g_object_get_data (G_OBJECT (popts), "chopgimp-vss"))
+    {
+      g_object_set_data (G_OBJECT (popts), "chopgimp-vss", GINT_TO_POINTER (1));
+      g_signal_connect (popts, "notify::enable-fill",
+                        G_CALLBACK (vss_options_notify), NULL);
+      g_signal_connect (popts, "notify::enable-stroke",
+                        G_CALLBACK (vss_options_notify), NULL);
+      g_signal_connect (popts->fill_options, "notify",
+                        G_CALLBACK (vss_options_notify), NULL);
+      g_signal_connect (popts->stroke_options, "notify",
+                        G_CALLBACK (vss_options_notify), NULL);
+    }
+
+  vss_load ();
+}
+
+static void
+vss_selection_changed (GimpVectorLayer *layer,
+                       gpointer         data)
+{
+  vss_load ();
+}
+
+static void
+vss_watch_layer (GimpVectorLayer *layer)
+{
+  if (vss.layer == layer)
+    return;
+
+  if (vss.layer)
+    {
+      GimpVectorLayer *old = vss.layer;
+
+      g_signal_handlers_disconnect_by_func (old, vss_selection_changed, NULL);
+      g_object_remove_weak_pointer (G_OBJECT (old), (gpointer *) &vss.layer);
+      vss.layer = NULL;
+
+      /*  one selection: the objects of a layer that is no longer active
+       *  are deselected (no frame is shown for them, they must never be
+       *  edited unseen)
+       */
+      if (gimp_item_is_attached (GIMP_ITEM (old)) &&
+          chopgimp_vobjects_n_selected (old) > 0)
+        chopgimp_vlayer_set_selection (old, NULL, 0);
+    }
+
+  vss.layer = layer;
+
+  if (layer)
+    {
+      g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &vss.layer);
+      g_signal_connect (layer, "object-selection-changed",
+                        G_CALLBACK (vss_selection_changed), NULL);
+    }
+}
+
+static void
+vss_layers_changed (GimpImage *image,
+                    gpointer   data)
+{
+  GimpVectorLayer *layer = chopgimp_vobjects_get_target_layer (image);
+
+  /*  a vector layer the user just added: its objects are the selection  */
+  if (layer && g_object_get_data (G_OBJECT (layer), "chopgimp-new-layer"))
+    {
+      g_object_set_data (G_OBJECT (layer), "chopgimp-new-layer", NULL);
+      vss_watch_layer (layer);
+      chopgimp_vobjects_select_all (layer);
+    }
+  else
+    {
+      vss_watch_layer (layer);
+    }
+
+  vss_load ();
+}
+
+static void
+vss_image_changed (GimpContext *context,
+                   GimpImage   *image,
+                   gpointer     data)
+{
+  if (vss.image == image)
+    return;
+
+  if (vss.image)
+    {
+      g_signal_handlers_disconnect_by_func (vss.image, vss_layers_changed, NULL);
+      g_object_remove_weak_pointer (G_OBJECT (vss.image), (gpointer *) &vss.image);
+    }
+
+  /*  the layer of another image keeps its selection (not shown, but not
+   *  edited either: only the active image's active layer is)
+   */
+  if (vss.layer)
+    {
+      g_signal_handlers_disconnect_by_func (vss.layer, vss_selection_changed, NULL);
+      g_object_remove_weak_pointer (G_OBJECT (vss.layer), (gpointer *) &vss.layer);
+      vss.layer = NULL;
+    }
+
+  vss.image = image;
+
+  if (image)
+    {
+      g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &vss.image);
+      g_signal_connect (image, "selected-layers-changed",
+                        G_CALLBACK (vss_layers_changed), NULL);
+      vss_layers_changed (image, NULL);
+    }
+}
+
+/*  the colors and the drawing tool's options from the selection again
+ *  (guarded: loading them never edits the objects)
+ */
+void
+chopgimp_vselection_sync (void)
+{
+  vss_load ();
+}
+
+void
+chopgimp_vselection_init (Gimp *gimp)
+{
+  if (vss.gimp || ! chopgimp_vobjects_enabled ())
+    return;
+
+  vss.gimp    = gimp;
+  vss.context = gimp_get_user_context (gimp);
+
+  g_signal_connect (vss.context, "foreground-changed",
+                    G_CALLBACK (vss_fg_changed), NULL);
+  g_signal_connect (vss.context, "background-changed",
+                    G_CALLBACK (vss_bg_changed), NULL);
+  g_signal_connect (vss.context, "tool-changed",
+                    G_CALLBACK (vss_tool_changed), NULL);
+  g_signal_connect (vss.context, "image-changed",
+                    G_CALLBACK (vss_image_changed), NULL);
+
+  vss_tool_changed (vss.context, gimp_context_get_tool (vss.context), NULL);
+  vss_image_changed (vss.context, gimp_context_get_image (vss.context), NULL);
+}
