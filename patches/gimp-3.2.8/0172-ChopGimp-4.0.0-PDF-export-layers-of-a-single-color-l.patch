From 6bde46c1a762ff15d484f78c9fe429f529995e9b Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Thu, 26 Nov 2026 21:46:16 +0100
Subject: [PATCH 172/173] ChopGimp 4.0.0: PDF export (layers) of a single-color
 layer without asking GTK for a monitor

---
 plug-ins/common/file-pdf-chopgimp.h | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/plug-ins/common/file-pdf-chopgimp.h b/plug-ins/common/file-pdf-chopgimp.h
index 2f5af0e..0938661 100644
--- a/plug-ins/common/file-pdf-chopgimp.h
+++ b/plug-ins/common/file-pdf-chopgimp.h
@@ -1409,10 +1409,14 @@ chop_pdf_draw_content (ChopPdf   *cp,
 
     if (cp->vectorize && single)
       {
+        /*  4.0.0: the color itself, not the monitor's rendering  */
+        gdouble rgba[4];
+
         cairo_rectangle (cr, x, y,
                          gimp_drawable_get_width  (GIMP_DRAWABLE (layer)),
                          gimp_drawable_get_height (GIMP_DRAWABLE (layer)));
-        gimp_cairo_set_source_color (cr, color, NULL, FALSE, NULL);
+        gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), rgba);
+        cairo_set_source_rgba (cr, rgba[0], rgba[1], rgba[2], rgba[3]);
         cairo_fill (cr);
       }
     else
-- 
2.53.0

