Subject: [PATCH 158/158] =?UTF-8?q?ChopGimp=203.29.5:=20Red=C3=A9finir=20l?=
 =?UTF-8?q?es=20couleurs:=20=C2=AB=20Assigner=20les=20couleurs=20globales?=
 =?UTF-8?q?=20=C2=BB=20on=20its=20own=20row,=20larger=20default=20window?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 app/dialogs/chopgimp-recolor-dialog.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/app/dialogs/chopgimp-recolor-dialog.c b/app/dialogs/chopgimp-recolor-dialog.c
index a198e1b..b734a76 100644
--- a/app/dialogs/chopgimp-recolor-dialog.c
+++ b/app/dialogs/chopgimp-recolor-dialog.c
@@ -657,7 +657,7 @@ chopgimp_recolor_dialog_show (GimpImage   *image,
                                             GTK_RESPONSE_OK,
                                             GTK_RESPONSE_CANCEL,
                                             -1);
-  gtk_window_set_default_size (GTK_WINDOW (d->dialog), 460, 600);
+  gtk_window_set_default_size (GTK_WINDOW (d->dialog), 520, 640);
 
   g_object_set_data_full (G_OBJECT (d->dialog), "chopgimp-recolor", d,
                           (GDestroyNotify) dialog_free);
@@ -762,7 +762,11 @@ chopgimp_recolor_dialog_show (GimpImage   *image,
                                        "Couleurs globales)"), NULL);
   gtk_widget_set_sensitive (d->globals_button, globals != NULL);
   g_signal_connect (d->globals_button, "clicked", G_CALLBACK (globals_clicked), d);
-  gtk_box_pack_start (GTK_BOX (hbox), d->globals_button, FALSE, FALSE, 0);
+  /*  3.29.5: on its own row under « Réduire à » (the row was too wide
+   *  for the window and the button was cut)
+   */
+  gtk_widget_set_halign (d->globals_button, GTK_ALIGN_START);
+  gtk_grid_attach (GTK_GRID (grid), d->globals_button, 1, 2, 1, 1);
   g_list_free (globals);
 
   /*  the colors, by hue  */
