+/*  is the first (@at_end: last) sub-path of @d open? (the model draws
+ *  arrowheads at the ends of open sub-paths only)
+ */
+static gboolean
+svg_vend_open (const gchar *d,
+               gboolean     at_end)
+{
+  GPtrArray *polys = svg_vflatten (d);
+  gboolean   open  = FALSE;
+
+  if (polys->len > 0)
+    {
+      SvgVPoly *p = g_ptr_array_index (polys, at_end ? polys->len - 1 : 0);
+
+      open = ! p->closed && p->pts->len >= 4;
+    }
+
+  g_ptr_array_free (polys, TRUE);
+
+  return open;
+}
