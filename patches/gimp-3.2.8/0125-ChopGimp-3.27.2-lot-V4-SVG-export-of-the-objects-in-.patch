+static const gchar *
+svg_vmarker_id (SvgVWrite       *w,
+                const SvgVEntry *e,
+                const gchar     *shape,
+                gboolean         start)
+{
+  static const gchar *const shapes[] = { "triangle", "arrow", "circle", "square", "bar" };
+  const SvgVPaint *p     = &e->paint;
+  gdouble          rgba[4] = { 0.5, 0.5, 0.5, 1.0 };
+  gdouble          scale = CLAMP (e->arrow_scale, 0.1, 20.0);
+  gdouble          L     = 4.0 * MAX (e->width, 0.5) * scale;
+  gdouble          W     = L * 0.5;
+  gdouble          sg    = start ? -1.0 : 1.0;   /* start: points backwards */
+  gdouble          alpha;
+  GString         *key;
+  GString         *m;
+  const gchar     *id;
+  gchar           *new_id;
+  gboolean         known = FALSE;
+
+  for (guint i = 0; i < G_N_ELEMENTS (shapes); i++)
+    if (! g_strcmp0 (shape, shapes[i]))
+      known = TRUE;
+  if (! known)
+    shape = "triangle";
+
+  if (! g_strcmp0 (p->type, "color"))
+    memcpy (rgba, p->rgba, sizeof (rgba));
+  else if (svg_vpaint_is_gradient (p))
+    memcpy (rgba, g_array_index (p->stops, SvgVStop, 0).rgba, sizeof (rgba));
+  else if (g_strcmp0 (p->type, "pattern"))
