+/*  the swatch of a global color (an Inkscape « solid » swatch: a one-stop
+ *  <linearGradient inkscape:swatch="solid">), defined once per document
+ */
+static const gchar *
+svg_vswatch_id (SvgVWrite       *w,
+                const gchar     *global,
+                const gdouble    rgba[4])
+{
+  GString     *key = g_string_new (global);
+  const gchar *id;
+
+  g_string_append_c (key, ' ');
+  svg_vput_color (key, rgba);
+
+  id = g_hash_table_lookup (svg_vswatches, key->str);
+
+  if (! id)
+    {
+      GString *sid = g_string_new (NULL);
+      gchar   *new_id;
+      gint     n   = 1;
+
+      if (w->own_swatches)
+        g_string_printf (sid, "%s-global-", w->prefix);
+      else
+        g_string_assign (sid, "chopgimp-global-");
+
+      for (const gchar *c = global; *c; c++)
+        g_string_append_c (sid, g_ascii_isalnum (*c) || *c == '-' || *c == '_' ? *c : '_');
+
+      new_id = g_strdup (sid->str);
+
+      /*  the same global color, another color (not updated yet)  */
+      while (g_hash_table_find (svg_vswatches, svg_vvalue_is, new_id))
+        {
+          g_free (new_id);
+          new_id = g_strdup_printf ("%s-%d", sid->str, ++n);
+        }
+
+      g_string_free (sid, TRUE);
+
+      g_string_append_printf (w->defs,
+                              "<linearGradient id=\"%s\" inkscape:swatch=\"solid\""
+                              " inkscape:label=\"", new_id);
+      svg_vput_escaped (w->defs, global);
+      g_string_append (w->defs, "\" chopgimp:global=\"");
+      svg_vput_escaped (w->defs, global);
+      g_string_append (w->defs, "\">\n<stop offset=\"0\" style=\"stop-color:");
+      svg_vput_color (w->defs, rgba);
+      g_string_append (w->defs, ";stop-opacity:1\"/>\n</linearGradient>\n");
+
+      g_hash_table_insert (svg_vswatches, g_strdup (key->str), new_id);
+      id = new_id;
+    }
+
+  g_string_free (key, TRUE);
+
+  return id;
+}
