+
+  alpha = CLAMP (rgba[3] * e->opacity, 0.0, 1.0);
+
+  key = g_string_new (NULL);
+  g_string_append_printf (key, "%s %d ", shape, start);
+  svg_vput_num (key, L);
+  g_string_append_c (key, ' ');
+  svg_vput_num (key, e->width);
+  g_string_append_c (key, ' ');
+  svg_vput_color (key, rgba);
+  g_string_append_c (key, ' ');
+  svg_vput_num (key, alpha);
+  g_string_append_printf (key, " %s", e->cap ? e->cap : "butt");
+
+  if ((id = g_hash_table_lookup (w->markers, key->str)))
+    {
+      g_string_free (key, TRUE);
+      return id;
+    }
+
+  new_id = g_strdup_printf ("%s-m%u", w->prefix, g_hash_table_size (w->markers) + 1);
+  g_hash_table_insert (w->markers, g_string_free (key, FALSE), new_id);
+
+  m = w->defs;
+  g_string_append_printf (m, "<marker id=\"%s\" orient=\"auto\" markerUnits=\"userSpaceOnUse\""
+                          " refX=\"0\" refY=\"0\" markerWidth=\"1\" markerHeight=\"1\""
+                          " style=\"overflow:visible\" chopgimp:arrow=\"%s\""
+                          " chopgimp:arrow-scale=\"", new_id, shape);
+  svg_vput_num (m, scale);
+  g_string_append (m, "\">\n<path style=\"");
+
+  if (! strcmp (shape, "arrow"))
+    {
+      g_string_append (m, "fill:none;stroke:");
+      svg_vput_color (m, rgba);
+      if (alpha < 1.0)
+        {
+          g_string_append (m, ";stroke-opacity:");
+          svg_vput_num (m, alpha);
+        }
+      g_string_append (m, ";stroke-width:");
+      svg_vput_num (m, e->width);
+      g_string_append_printf (m, ";stroke-linejoin:miter;stroke-linecap:%s\" d=\"M ",
+                              ! g_strcmp0 (e->cap, "round")  ? "round"  :
+                              ! g_strcmp0 (e->cap, "square") ? "square" : "butt");
+      svg_vput_num (m, -sg * L); g_string_append_c (m, ' ');
+      svg_vput_num (m, W);       g_string_append (m, " L 0 0 L ");
+      svg_vput_num (m, -sg * L); g_string_append_c (m, ' ');
+      svg_vput_num (m, -W);
+      g_string_append (m, "\"/>\n</marker>\n");
+
+      return new_id;
+    }
+
+  g_string_append (m, "fill:");
+  svg_vput_color (m, rgba);
+  if (alpha < 1.0)
+    {
+      g_string_append (m, ";fill-opacity:");
+      svg_vput_num (m, alpha);
+    }
+  g_string_append (m, ";stroke:none\" d=\"");
+
+  if (! strcmp (shape, "circle"))
+    {
+      /*  centre W behind the tip, radius W  */
+      g_string_append (m, "M ");
+      svg_vput_num (m, 0);  g_string_append (m, " 0 A ");
+      svg_vput_num (m, W);  g_string_append_c (m, ' ');
+      svg_vput_num (m, W);  g_string_append (m, " 0 1 1 ");
+      svg_vput_num (m, -sg * L); g_string_append (m, " 0 A ");
+      svg_vput_num (m, W);  g_string_append_c (m, ' ');
+      svg_vput_num (m, W);  g_string_append (m, " 0 1 1 0 0 Z");
+    }
+  else
+    {
+      gdouble len = ! strcmp (shape, "triangle") ? L :
+                    ! strcmp (shape, "bar")      ? MAX (e->width, 0.5) : L;
+      gdouble pts[4][2];
+      gint    n_pts;
+
+      if (! strcmp (shape, "triangle"))
+        {
+          gdouble t[3][2] = { { 0, 0 }, { -sg * len, W }, { -sg * len, -W } };
+
+          memcpy (pts, t, sizeof (t));
+          n_pts = 3;
+        }
+      else
+        {
+          gdouble t[4][2] = { { 0, W }, { 0, -W }, { -sg * len, -W }, { -sg * len, W } };
+
+          memcpy (pts, t, sizeof (t));
+          n_pts = 4;
+        }
+
+      for (gint i = 0; i < n_pts; i++)
+        {
+          g_string_append (m, i ? " L " : "M ");
+          svg_vput_num (m, pts[i][0]);
+          g_string_append_c (m, ' ');
+          svg_vput_num (m, pts[i][1]);
+        }
+      g_string_append (m, " Z");
+    }
+
+  g_string_append (m, "\"/>\n</marker>\n");
+
+  return new_id;
+}
