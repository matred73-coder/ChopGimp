-/*  the visible, painted entries (SvgVEntry *, not owned)  */
+
+/*  ─── the geometry of d (arrowheads, width profiles) ─────────────────── */
+
+typedef struct
+{
+  GArray   *pts;            /* gdouble x, y, x, y… */
+  gboolean  closed;
+} SvgVPoly;
+
+static void
+svg_vpoly_free (SvgVPoly *p)
+{
+  g_array_free (p->pts, TRUE);
+  g_free (p);
+}
+
+static void
+svg_vpoly_add (SvgVPoly *p,
+               gdouble   x,
+               gdouble   y)
+{
+  g_array_append_val (p->pts, x);
+  g_array_append_val (p->pts, y);
+}
+
+/*  the sub-paths of d (M, L, C, Z, absolute, as the model writes them;
+ *  H, V and relative commands too) flattened: SvgVPoly *
+ */
 static GPtrArray *
-svg_vpainted (const SvgVNode *n)
+svg_vflatten (const gchar *d)
+{
+  GPtrArray   *out = g_ptr_array_new_with_free_func ((GDestroyNotify) svg_vpoly_free);
+  SvgVPoly    *cur = NULL;
+  const gchar *s   = d;
+  gchar        cmd = 0;
+  gdouble      x = 0, y = 0, sx = 0, sy = 0;
+
+  while (s && *s)
+    {
+      gdouble v[6];
+      gint    n_args;
+      gboolean rel;
+
+      while (*s == ' ' || *s == ',' || *s == '\t' || *s == '\n' || *s == '\r')
+        s++;
+      if (! *s)
+        break;
+
+      if (g_ascii_isalpha (*s))
+        cmd = *s++;
+      else if (! cmd)
+        break;
+
+      rel = g_ascii_islower (cmd);
+
+      switch (g_ascii_toupper (cmd))
+        {
+        case 'Z':
+          if (cur)
+            {
+              cur->closed = TRUE;
+              x = sx;
+              y = sy;
+            }
+          cur = NULL;
+          cmd = 0;
+          continue;
+        case 'M': case 'L': n_args = 2; break;
+        case 'H': case 'V': n_args = 1; break;
+        case 'C':           n_args = 6; break;
+        default:            return out;   /* not written by the model */
+        }
+
+      if (svg_vnums (s, v, n_args) < n_args)
+        break;
+
+      /*  skip the numbers read  */
+      for (gint i = 0; i < n_args; i++)
+        {
+          gchar *end;
+
+          while (*s == ' ' || *s == ',' || *s == '\t' || *s == '\n' || *s == '\r')
+            s++;
+          g_ascii_strtod (s, &end);
+          s = end;
+        }
+
+      if (rel)
+        for (gint i = 0; i < n_args; i += 2)
+          {
+            if (g_ascii_toupper (cmd) == 'V')
+              {
+                v[i] += y;
+                break;
+              }
+            v[i] += x;
+            if (i + 1 < n_args)
+              v[i + 1] += y;
+          }
+
+      switch (g_ascii_toupper (cmd))
+        {
+        case 'M':
+          cur = g_new0 (SvgVPoly, 1);
+          cur->pts = g_array_new (FALSE, FALSE, sizeof (gdouble));
+          g_ptr_array_add (out, cur);
+          x = sx = v[0];
+          y = sy = v[1];
+          svg_vpoly_add (cur, x, y);
+          cmd = rel ? 'l' : 'L';
+          break;
+
+        case 'L': case 'H': case 'V':
+          if (g_ascii_toupper (cmd) == 'H')
+            v[1] = y;
+          else if (g_ascii_toupper (cmd) == 'V')
+            v[1] = v[0], v[0] = x;
+          if (cur)
+            svg_vpoly_add (cur, v[0], v[1]);
+          x = v[0];
+          y = v[1];
+          break;
+
+        case 'C':
+          if (cur)
+            {
+              gdouble len = (hypot (v[0] - x, v[1] - y) + hypot (v[2] - v[0], v[3] - v[1]) +
+                             hypot (v[4] - v[2], v[5] - v[3]));
+              gint    steps = CLAMP ((gint) ceil (len / 2.0), 1, 64);
+
+              for (gint k = 1; k <= steps; k++)
+                {
+                  gdouble t = (gdouble) k / steps, u = 1.0 - t;
+
+                  svg_vpoly_add (cur,
+                                 u * u * u * x + 3 * u * u * t * v[0] + 3 * u * t * t * v[2] + t * t * t * v[4],
+                                 u * u * u * y + 3 * u * u * t * v[1] + 3 * u * t * t * v[3] + t * t * t * v[5]);
+                }
+            }
+          x = v[4];
+          y = v[5];
+          break;
+        }
+    }
+
+  return out;
+}
+
+/*  « t:w,… » of a width profile (the presets of chopgimp-vobject.c)  */
+static const gchar *
+svg_vprofile_points (const gchar *profile)
+{
+  static const gchar *const presets[][2] =
+  {
+    { "uniform",     "0:1,1:1"                           },
+    { "lens",        "0:0,0.5:1,1:0"                     },
+    { "taper-end",   "0:1,1:0"                           },
+    { "taper-start", "0:0,1:1"                           },
+    { "taper-both",  "0:0,0.15:1,0.85:1,1:0"             },
+    { "pinch",       "0:1,0.5:0.25,1:1"                  },
+    { "bulge-start", "0:0.4,0.2:1,1:0"                   },
+    { "wave",        "0:0.4,0.25:1,0.5:0.4,0.75:1,1:0.4" },
+  };
+
+  for (guint i = 0; i < G_N_ELEMENTS (presets); i++)
+    if (! g_strcmp0 (profile, presets[i][0]))
+      return presets[i][1];
+
+  return profile;
+}
+
+static gint
+svg_vcmp_double (gconstpointer a,
+                 gconstpointer b)
+{
+  gdouble x = *(const gdouble *) a, y = *(const gdouble *) b;
+
+  return x < y ? -1 : x > y ? 1 : 0;
+}
+
+/*  the outline of a stroke with a width profile, as the model draws it
+ *  (chopgimp-geom.cc, powerstroke: the width — a fraction of @width at
+ *  t along each sub-path, cosine-smoothed between the points — centred on
+ *  the path): d of a filled path (nonzero), NULL if empty
+ */
+static gchar *
+svg_vprofile_outline (const gchar *d,
+                      const gchar *profile,
+                      gdouble      width)
+{
+  GPtrArray *polys = svg_vflatten (d);
+  GArray    *prof  = g_array_new (FALSE, FALSE, sizeof (gdouble) * 2);
+  gchar    **pairs = g_strsplit (svg_vprofile_points (profile), ",", -1);
+  GString   *s     = g_string_new (NULL);
+
+  for (gchar **p = pairs; *p; p++)
+    {
+      gchar  *colon = strchr (*p, ':');
+      gdouble tw[2];
+
+      if (! colon)
+        continue;
+
+      tw[0] = CLAMP (g_ascii_strtod (*p, NULL), 0.0, 1.0);
+      tw[1] = MAX (0.0, g_ascii_strtod (colon + 1, NULL)) * width;
+      g_array_append_val (prof, tw);
+    }
+  g_strfreev (pairs);
+
+  if (prof->len == 0)
+    {
+      gdouble tw[2][2] = { { 0.0, width }, { 1.0, width } };
+
+      g_array_append_vals (prof, tw, 2);
+    }
+
+  g_array_sort (prof, svg_vcmp_double);
+
+  for (guint k = 0; k < polys->len; k++)
+    {
+      SvgVPoly *pl  = g_ptr_array_index (polys, k);
+      gdouble  *pt  = (gdouble *) pl->pts->data;
+      gint      np  = pl->pts->len / 2;
+      gdouble  *acc;
+      gdouble   total;
+      gint      n;
+      gdouble  *rx, *ry;
+
+      if (pl->closed && np > 1 &&
+          (pt[0] != pt[2 * (np - 1)] || pt[1] != pt[2 * (np - 1) + 1]))
+        {
+          svg_vpoly_add (pl, pt[0], pt[1]);
+          pt = (gdouble *) pl->pts->data;
+          np++;
+        }
+
+      if (np < 2)
+        continue;
+
+      acc = g_new (gdouble, np);
+      acc[0] = 0.0;
+      for (gint i = 1; i < np; i++)
+        acc[i] = acc[i - 1] + hypot (pt[2 * i] - pt[2 * i - 2], pt[2 * i + 1] - pt[2 * i - 1]);
+      total = acc[np - 1];
+
+      if (total <= 1e-9)
+        {
+          g_free (acc);
+          continue;
+        }
+
+      /*  n points evenly spaced along the sub-path  */
+      n  = MAX (24, (gint) (total / 3.0));
+      rx = g_new (gdouble, n);
+      ry = g_new (gdouble, n);
+
+      for (gint i = 0, j = 0; i < n; i++)
+        {
+          gdouble dd = total * i / (n - 1);
+          gdouble u;
+
+          while (j + 2 < np && acc[j + 1] < dd)
+            j++;
+
+          u = (dd - acc[j]) / MAX (1e-12, acc[j + 1] - acc[j]);
+          u = CLAMP (u, 0.0, 1.0);
+          rx[i] = pt[2 * j]     + u * (pt[2 * j + 2] - pt[2 * j]);
+          ry[i] = pt[2 * j + 1] + u * (pt[2 * j + 3] - pt[2 * j + 1]);
+        }
+
+      for (gint side = 0; side < 2; side++)
+        for (gint q = 0; q < n; q++)
+          {
+            gint     i  = side ? n - 1 - q : q;
+            gdouble  t  = (gdouble) i / (n - 1);
+            gint     a  = MAX (0, i - 1), b = MIN (n - 1, i + 1);
+            gdouble  dx = rx[b] - rx[a], dy = ry[b] - ry[a];
+            gdouble  l  = hypot (dx, dy);
+            gdouble *tw = (gdouble *) prof->data;
+            gint     m  = prof->len;
+            gdouble  wt;
+
+            if (t <= tw[0])
+              wt = tw[1];
+            else if (t >= tw[2 * (m - 1)])
+              wt = tw[2 * (m - 1) + 1];
+            else
+              {
+                gint  r = 1;
+                gdouble u;
+
+                while (r < m - 1 && t > tw[2 * r])
+                  r++;
+                u  = (t - tw[2 * (r - 1)]) / MAX (1e-9, tw[2 * r] - tw[2 * (r - 1)]);
+                u  = (1 - cos (u * G_PI)) / 2;
+                wt = tw[2 * (r - 1) + 1] + u * (tw[2 * r + 1] - tw[2 * (r - 1) + 1]);
+              }
+
+            wt = MAX (0.0, wt) / 2.0;
+
+            if (l > 1e-12)
+              {
+                dx /= l;
+                dy /= l;
+              }
+
+            g_string_append (s, (side == 0 && q == 0) ? (s->len ? " M " : "M ") : " L ");
+            svg_vput_num (s, rx[i] + (side ? dy : -dy) * wt);
+            g_string_append_c (s, ' ');
+            svg_vput_num (s, ry[i] + (side ? -dx : dx) * wt);
+          }
+
+      g_string_append (s, " Z");
+
+      g_free (acc);
+      g_free (rx);
+      g_free (ry);
+    }
