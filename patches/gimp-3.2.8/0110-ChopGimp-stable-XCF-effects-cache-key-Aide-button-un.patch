diff --git a/app/core/chopgimp-fx-render-version.h b/app/core/chopgimp-fx-render-version.h
new file mode 100644
index 0000000..8552939
--- /dev/null
+++ b/app/core/chopgimp-fx-render-version.h
@@ -0,0 +1,60 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-fx-render-version.h — ChopGimp: rendering version of the
+ * layer effects cache stored in XCF files (see chopgimp-fx-cache.c)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#ifndef __CHOPGIMP_FX_RENDER_VERSION_H__
+#define __CHOPGIMP_FX_RENDER_VERSION_H__
+
+/*  Part of the key of every effects cache stored in an XCF file, together
+ *  with the GIMP, GEGL and babl version numbers. A rebuild or a new
+ *  ChopGimp release keeps the stored caches valid as long as this string
+ *  is unchanged: BUMP IT (any new string, e.g. "2") whenever a change can
+ *  alter the pixels an effect renders, otherwise files opened afterwards
+ *  would show the stale, previously rendered effects. Bumping only makes
+ *  older caches be ignored (effects recomputed once, then saved again).
+ *
+ *  Requires a bump:
+ *  - app/operations/gimpoperationcontour.c (Contour / stroke rendering);
+ *  - app/operations/gimpoperationlayerstylefused.c and
+ *    app/core/gimpdrawable-fused-styles.c (fused layer styles: which
+ *    filters are fused and how);
+ *  - any other GIMP operation used as a layer filter (gimp:* operations
+ *    in app/operations/), layer modes / blend code
+ *    (app/operations/layer-modes/), filter stack composition
+ *    (gimpdrawable-filters.c, gimpdrawablefilter.c), or how layer
+ *    filters' arguments are converted when loading/saving XCF;
+ *  - GEGL patches touching rendering (patches/gegl-*: dropshadow,
+ *    inner-glow, glow-map, bevel, blurs — e.g. 0002 fir-blur,
+ *    0004 blur-alpha-only, 0005 glow-options) or any new GEGL patch
+ *    which changes an operation's output;
+ *  - babl patches / conversions (patches/babl-*: e.g. 0001 direct alpha
+ *    extraction) unless bit-identical to the reference conversion;
+ *  - a change of compiler flags known to change floating point results
+ *    (-ffast-math, -march / FMA contraction, ...).
+ *
+ *  Not needed: GEGL/babl version upgrades (their versions are in the key),
+ *  UI-only changes, changes which leave rendered pixels bit-identical.
+ *
+ *  History:
+ *  "1"  first release after 3.26.0: replaces the ELF build-id key of
+ *       3.25.1–3.26.0
+ */
+#define CHOPGIMP_FX_RENDER_VERSION "1"
+
+#endif /* __CHOPGIMP_FX_RENDER_VERSION_H__ */
