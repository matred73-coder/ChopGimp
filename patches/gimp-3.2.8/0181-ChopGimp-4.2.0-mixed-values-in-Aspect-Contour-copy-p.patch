                                                       ChopGimpVObject *from);
 
+/*  4.2.0: copy / paste of objects. Ctrl+C with selected objects keeps
+ *  them (with @clip, the object GIMP put on the clipboard at the same
+ *  time); Ctrl+V into a vector layer, while that copy is still the
+ *  clipboard, adds them as objects of the layer (in place) and they
+ *  become the selection. FALSE: nothing pasted (paste pixels as usual).
+ */
+void              chopgimp_vobjects_clipboard_copy   (GimpVectorLayer *layer,
+                                                      GObject         *clip);
+gboolean          chopgimp_vobjects_clipboard_paste  (GimpVectorLayer *layer,
+                                                      GObject         *clip);
+
 G_END_DECLS
