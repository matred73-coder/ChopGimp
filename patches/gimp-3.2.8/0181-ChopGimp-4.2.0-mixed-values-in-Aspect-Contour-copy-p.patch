+          gimp_canvas_polygon_set_points (private->lasso_poly,
+                                          (GimpVector2 *) private->lasso_pts->data,
+                                          private->lasso_pts->len);
+          return;
+        }
+
       gimp_canvas_rectangle_set (private->rb_rect,
                                  MIN (private->rb_x0, private->rb_x1),
                                  MIN (private->rb_y0, private->rb_y1),
@@ -1260,7 +1334,8 @@ gimp_tool_path_hover (GimpToolWidget   *widget,
 
