+/*  ─── 4.2.0: copy / paste of objects ─────────────────────────────────── */
+
+static gchar   *vclip_xml   = NULL;
+static GObject *vclip_owner = NULL;    /* weak: the clipboard object */
+
+void
+chopgimp_vobjects_clipboard_copy (GimpVectorLayer *layer,
+                                  GObject         *clip)
+{
+  GList *objects;
+
+  g_clear_pointer (&vclip_xml, g_free);
+  if (vclip_owner)
+    g_object_remove_weak_pointer (vclip_owner, (gpointer *) &vclip_owner);
+  vclip_owner = NULL;
+
+  if (! layer || ! chopgimp_vobjects_enabled () || ! clip)
+    return;
+
+  objects = chopgimp_vlayer_get_selected_objects (layer);
+
+  if (objects)
+    {
+      vclip_xml   = chopgimp_vobjects_to_xml (objects);
+      vclip_owner = clip;
+      g_object_add_weak_pointer (vclip_owner, (gpointer *) &vclip_owner);
+    }
+
+  g_list_free (objects);
+}
+
+gboolean
+chopgimp_vobjects_clipboard_paste (GimpVectorLayer *layer,
+                                   GObject         *clip)
+{
+  GimpImage       *image;
+  ChopGimpVObject *root;
+  GArray          *ids;
+
+  if (! layer || ! vclip_xml || ! vclip_owner || clip != vclip_owner ||
+      ! chopgimp_vobjects_enabled () || ! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  image = gimp_item_get_image (GIMP_ITEM (layer));
+  root  = chopgimp_vobjects_from_xml (image, vclip_xml);
+
+  if (! root || ! root->children || root->children->len == 0)
+    {
+      if (root)
+        chopgimp_vobject_unref (root);
+      return FALSE;
+    }
+
+  ids = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  chopgimp_vlayer_push_undo (layer, _("Coller les objets"));
+  chopgimp_vlayer_freeze (layer);
+
+  for (guint i = 0; i < root->children->len; i++)
+    {
+      ChopGimpVObject *copy = chopgimp_vobject_copy (g_ptr_array_index (root->children, i),
+                                                     image);
+
+      chopgimp_vlayer_insert (layer, copy, NULL, -1, FALSE);
+      g_array_append_val (ids, copy->id);
+      chopgimp_vobject_unref (copy);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  chopgimp_vobject_unref (root);
+
+  chopgimp_vlayer_set_selection (layer, (const guint *) ids->data, ids->len);
+  g_array_free (ids, TRUE);
+
+  return TRUE;
+}
diff --git a/app/path/chopgimp-vobject-ops.h b/app/path/chopgimp-vobject-ops.h
