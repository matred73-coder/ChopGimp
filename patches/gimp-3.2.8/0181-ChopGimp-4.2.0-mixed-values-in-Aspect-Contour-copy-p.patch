+/*  ChopGimp 4.2.0: inside the lasso outline (even-odd rule)  */
+static gboolean
+chopgimp_lasso_contains (GArray  *pts,
+                         gdouble  x,
+                         gdouble  y)
+{
+  const GimpVector2 *p      = (const GimpVector2 *) pts->data;
+  gint               n      = pts->len;
+  gboolean           inside = FALSE;
+
+  if (n < 3)
+    return FALSE;
+
+  for (gint i = 0, j = n - 1; i < n; j = i++)
+    if (((p[i].y > y) != (p[j].y > y)) &&
+        (x < (p[j].x - p[i].x) * (y - p[i].y) / (p[j].y - p[i].y) + p[i].x))
+      inside = ! inside;
+
+  return inside;
+}
