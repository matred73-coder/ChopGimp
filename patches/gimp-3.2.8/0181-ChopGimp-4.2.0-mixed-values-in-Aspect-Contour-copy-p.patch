+/*  ─── 4.2.0: « mixte » where the edited objects differ ──────────────── */
+
+typedef struct
+{
+  gboolean paint, visible, opacity, mode;
+  gboolean width, align, cap, join, miter, dashes, arrows, arrow_scale, profile, gradient;
+} Mixed;
+
+static gboolean
+paint_differs (const ChopGimpPaint *a,
+               const ChopGimpPaint *b)
+{
+  GeglColor *ca, *cb;
+  gdouble    ra[4] = { 0 }, rb[4] = { 0 };
+
+  if (a->type != b->type || a->pattern != b->pattern)
+    return TRUE;
+
+  ca = chopgimp_vpaint_get_main_color (a);
+  cb = chopgimp_vpaint_get_main_color (b);
+
+  if (! ca || ! cb)
+    return ca != cb;
+
+  gegl_color_get_rgba_with_space (ca, &ra[0], &ra[1], &ra[2], &ra[3], NULL);
+  gegl_color_get_rgba_with_space (cb, &rb[0], &rb[1], &rb[2], &rb[3], NULL);
+
+  for (gint i = 0; i < 4; i++)
+    if (fabs (ra[i] - rb[i]) > 1e-4)
+      return TRUE;
+
+  return FALSE;
+}
+
+static gboolean
+dashes_differ (GArray *a,
+               GArray *b)
+{
+  guint na = a ? a->len : 0;
+  guint nb = b ? b->len : 0;
+
+  if (na != nb)
+    return TRUE;
+
+  for (guint i = 0; i < na; i++)
+    if (fabs (g_array_index (a, gdouble, i) - g_array_index (b, gdouble, i)) > 1e-6)
+      return TRUE;
+
+  return FALSE;
+}
+
+static void
+entries_mixed (GList    *targets,
+               EntryRef  ref,
+               Mixed    *m)
+{
+  ChopGimpVEntry *e0 = NULL;
+
+  memset (m, 0, sizeof (Mixed));
+
+  for (GList *l = targets; l; l = l->next)
+    {
+      ChopGimpVObject *leaf = l->data;
+      ChopGimpVEntry  *e    = ref_entry (&leaf->style, ref);
+
+      if (! e)
+        {
+          /*  an object without this fill / stroke: everything differs  */
+          if (e0 || l != targets)
+            memset (m, 0xff, sizeof (Mixed));
+          continue;
+        }
+
+      if (! e0)
+        {
+          e0 = e;
+          continue;
+        }
+
+      m->paint       |= paint_differs (&e0->paint, &e->paint);
+      m->visible     |= (! e0->visible != ! e->visible);
+      m->opacity     |= fabs (e0->opacity - e->opacity) > 1e-6;
+      m->mode        |= (e0->mode != e->mode);
+      m->width       |= fabs (e0->width - e->width) > 1e-6;
+      m->align       |= (e0->align != e->align);
+      m->cap         |= (e0->cap != e->cap);
+      m->join        |= (e0->join != e->join);
+      m->miter       |= fabs (e0->miter_limit - e->miter_limit) > 1e-6;
+      m->dashes      |= dashes_differ (e0->dashes, e->dashes);
+      m->arrows      |= (g_strcmp0 (e0->arrow_start, e->arrow_start) ||
+                         g_strcmp0 (e0->arrow_end, e->arrow_end));
+      m->arrow_scale |= fabs (e0->arrow_scale - e->arrow_scale) > 1e-6;
+      m->profile     |= g_strcmp0 (e0->profile, e->profile) != 0;
+      m->gradient    |= (e0->stroke_gradient != e->stroke_gradient);
+    }
+}
+
+static gboolean
+spin_output_mixed (GtkSpinButton *spin,
+                   gpointer       data)
+{
+  if (g_object_get_data (G_OBJECT (spin), "chopgimp-mixed"))
+    {
+      gtk_entry_set_text (GTK_ENTRY (spin), _("mixte"));
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+/*  after gtk_spin_button_set_value(): « mixte » instead of the value  */
+static void
+spin_set_mixed (GtkWidget *spin,
+                gboolean   mixed)
+{
+  if (! spin)
+    return;
+
+  if (! g_object_get_data (G_OBJECT (spin), "chopgimp-mixed-hook"))
+    {
+      g_signal_connect (spin, "output", G_CALLBACK (spin_output_mixed), NULL);
+      g_object_set_data (G_OBJECT (spin), "chopgimp-mixed-hook", GINT_TO_POINTER (1));
+    }
+
+  g_object_set_data (G_OBJECT (spin), "chopgimp-mixed", GINT_TO_POINTER (mixed));
+
+  if (mixed)
+    gtk_entry_set_text (GTK_ENTRY (spin), _("mixte"));
+  else
+    gtk_spin_button_set_value (GTK_SPIN_BUTTON (spin),
+                               gtk_spin_button_get_value (GTK_SPIN_BUTTON (spin)));
+}
+
+/*  a value typed or stepped in a « mixte » field is the new value  */
+static void
+spin_unmix (GtkSpinButton *spin)
+{
+  g_object_set_data (G_OBJECT (spin), "chopgimp-mixed", NULL);
+}
+
+static void
+widget_set_mixed (GtkWidget *widget,
+                  gboolean   mixed)
+{
+  if (widget)
+    gtk_widget_set_opacity (widget, mixed ? 0.45 : 1.0);
+}
