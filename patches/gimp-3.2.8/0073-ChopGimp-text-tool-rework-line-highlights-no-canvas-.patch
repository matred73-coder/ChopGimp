+static void
+chopgimp_canvas_highlight_fill (GimpCanvasItem *item,
+                                cairo_t        *cr)
+{
+  /*  the blue of the selection, see through  */
+  cairo_set_source_rgba (cr, 0.22, 0.56, 0.94, 0.38);
+  cairo_fill (cr);
+}
+
+static void
+chopgimp_canvas_highlight_class_init (ChopGimpCanvasHighlightClass *klass)
+{
+  GimpCanvasItemClass *item_class = GIMP_CANVAS_ITEM_CLASS (klass);
+
+  item_class->fill = chopgimp_canvas_highlight_fill;
+}
