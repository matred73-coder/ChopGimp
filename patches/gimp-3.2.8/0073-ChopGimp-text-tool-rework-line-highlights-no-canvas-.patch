+GimpCanvasItem *
+chopgimp_canvas_highlight_new (GimpDisplayShell *shell,
+                               gdouble           x,
+                               gdouble           y,
+                               gdouble           width,
+                               gdouble           height)
+{
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), NULL);
+
+  return g_object_new (CHOPGIMP_TYPE_CANVAS_HIGHLIGHT,
+                       "shell",  shell,
+                       "x",      x,
+                       "y",      y,
+                       "width",  width,
+                       "height", height,
+                       "filled", TRUE,
+                       NULL);
+}
