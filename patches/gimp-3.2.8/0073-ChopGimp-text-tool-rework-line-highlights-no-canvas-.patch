+  GtkWidget *title  = gtk_label_new (NULL);
+  GtkWidget *sample = gtk_label_new (NULL);
+  gchar     *markup;
+
+  markup = g_markup_printf_escaped ("<small>%s%s</small>", badge, name);
+  gtk_label_set_markup (GTK_LABEL (title), markup);
+  g_free (markup);
+  gtk_label_set_xalign (GTK_LABEL (title), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (title), "dim-label");
+  gtk_label_set_xalign (GTK_LABEL (sample), 0.0);
