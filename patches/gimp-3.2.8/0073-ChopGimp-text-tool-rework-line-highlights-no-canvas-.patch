+/*  ChopGimp: bold / italic / underline / strike of the selected
+ *  characters, applied by the text tool being used
+ */
+static void
+gimp_options_bar_text_style_clicked (GtkButton *button,
+                                     Gimp      *gimp)
+{
+  GimpTool    *tool = tool_manager_get_active (gimp);
+  const gchar *tag  = g_object_get_data (G_OBJECT (button), "chopgimp-tag");
+  GimpTextTool *text_tool;
+
+  if (! GIMP_IS_TEXT_TOOL (tool) || ! GIMP_TEXT_TOOL (tool)->buffer)
+    return;
+
+  text_tool = GIMP_TEXT_TOOL (tool);
+
+  if (! strcmp (tag, "b"))
+    gimp_text_tool_toggle_tag (text_tool, text_tool->buffer->bold_tag);
+  else if (! strcmp (tag, "i"))
+    gimp_text_tool_toggle_tag (text_tool, text_tool->buffer->italic_tag);
+  else if (! strcmp (tag, "u"))
+    gimp_text_tool_toggle_tag (text_tool, text_tool->buffer->underline_tag);
+  else
+    gimp_text_tool_toggle_tag (text_tool, text_tool->buffer->strikethrough_tag);
+}
+
+static GtkWidget *
+gimp_options_bar_text_style_row (Gimp *gimp)
+{
+  static const struct { const gchar *tag, *markup, *tip; } styles[] =
+  {
+    { "b", "<b>G</b>",   N_("Gras (Ctrl+B)") },
+    { "i", "<i>I</i>",   N_("Italique (Ctrl+I)") },
+    { "u", "<u>S</u>",   N_("Souligné (Ctrl+U)") },
+    { "s", "<s>B</s>",   N_("Barré") },
+  };
+  GtkWidget *row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  guint      i;
+
+  for (i = 0; i < G_N_ELEMENTS (styles); i++)
+    {
+      GtkWidget *button = gtk_button_new ();
+      GtkWidget *label  = gtk_label_new (NULL);
+
+      gtk_label_set_markup (GTK_LABEL (label), styles[i].markup);
+      gtk_container_add (GTK_CONTAINER (button), label);
+      gtk_button_set_relief (GTK_BUTTON (button), GTK_RELIEF_NONE);
+      gtk_widget_set_can_focus (button, FALSE);
+      gimp_help_set_help_data (button, _(styles[i].tip), NULL);
+      g_object_set_data (G_OBJECT (button), "chopgimp-tag", (gpointer) styles[i].tag);
+      g_signal_connect (button, "clicked",
+                        G_CALLBACK (gimp_options_bar_text_style_clicked), gimp);
+      gtk_box_pack_start (GTK_BOX (row), button, FALSE, FALSE, 0);
+    }
+
+  gtk_widget_show_all (row);
+
+  return row;
+}
