+  GPtrArray *names;
+  guint      next;
+  guint      idle_id;
+  gboolean   chosen;
+  GtkWidget *hover_row;
+} Picker;
+
+enum { FILTER_ALL, FILTER_FAVORITES, FILTER_RECENT, FILTER_SERIF, FILTER_SANS,
+       FILTER_SCRIPT, FILTER_MONO };
+
+static gint
+font_category (const gchar *name)
+{
+  gchar *low = g_ascii_strdown (name, -1);
+  gint   cat = FILTER_SANS;
+
+  if (strstr (low, "mono") || strstr (low, "code") || strstr (low, "courier") ||
+      strstr (low, "console") || strstr (low, "typewriter"))
+    cat = FILTER_MONO;
+  else if (strstr (low, "script") || strstr (low, "hand") || strstr (low, "brush") ||
+           strstr (low, "callig") || strstr (low, "comic") || strstr (low, "pacifico") ||
+           strstr (low, "dancing") || strstr (low, "lobster"))
+    cat = FILTER_SCRIPT;
+  else if ((strstr (low, "serif") && ! strstr (low, "sans")) || strstr (low, "times") ||
+           strstr (low, "georgia") || strstr (low, "garamond") || strstr (low, "roman") ||
+           strstr (low, "baskerville") || strstr (low, "bodoni") || strstr (low, "palatino") ||
+           strstr (low, "book") || strstr (low, "caslon") || strstr (low, "playfair"))
+    cat = FILTER_SERIF;
+
+  g_free (low);
+
+  return cat;
 }
 
