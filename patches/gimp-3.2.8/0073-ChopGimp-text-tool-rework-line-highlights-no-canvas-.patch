+
+/* ─── Textes du document : all the text layers of the image ────────── */
+
+typedef struct
+{
+  Gimp      *gimp;
+  GtkWidget *list;
+  gchar     *stamp;
+  guint      refresh_id;
+} DocTexts;
+
+static void
+doc_texts_collect (GList *layers, GList **out)
+{
+  for (; layers; layers = layers->next)
+    {
+      GimpContainer *children = gimp_viewable_get_children (layers->data);
+
+      if (children)
+        doc_texts_collect (GIMP_LIST (children)->queue->head, out);
+      else if (gimp_item_is_text_layer (layers->data))
+        *out = g_list_append (*out, layers->data);
+    }
+}
+
+static void
+doc_texts_activated (GtkListBox *box, GtkListBoxRow *row, DocTexts *dt)
+{
+  GimpContext   *context = gimp_get_user_context (dt->gimp);
+  GimpImage     *image   = gimp_context_get_image (context);
+  GimpDisplay   *display = gimp_context_get_display (context);
+  GimpLayer     *layer;
+  GList         *sel;
+  GimpCoords     coords  = GIMP_COORDS_DEFAULT_VALUES;
+
+  if (! image)
+    return;
+
+  layer = gimp_image_get_layer_by_tattoo (image,
+                                          GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (row),
+                                                                               "tattoo")));
+  if (! layer)
+    return;
+
+  sel = g_list_prepend (NULL, layer);
+  gimp_image_set_selected_layers (image, sel);
+  g_list_free (sel);
+  gimp_image_flush (image);
+
+  /*  edit it right away: the text tool, as if clicked in the text  */
+  if (display)
+    {
+      gint x, y;
+
+      gimp_item_get_offset (GIMP_ITEM (layer), &x, &y);
+      coords.x = x + gimp_item_get_width  (GIMP_ITEM (layer)) / 2.0;
+      coords.y = y + gimp_item_get_height (GIMP_ITEM (layer)) / 2.0;
+
+      chopgimp_switch_tool_later (dt->gimp, display, "gimp-text-tool", &coords, 0, 0);
+    }
+}
+
+static gboolean
+doc_texts_refresh (DocTexts *dt)
+{
+  GimpImage *image = gimp_context_get_image (gimp_get_user_context (dt->gimp));
+  GList     *layers = NULL, *iter, *rows;
+  GString   *stamp  = g_string_new (NULL);
+
+  if (image)
+    doc_texts_collect (gimp_image_get_layer_iter (image), &layers);
+
+  for (iter = layers; iter; iter = iter->next)
+    {
+      GimpText *text = gimp_text_layer_get_text (iter->data);
+
+      g_string_append_printf (stamp, "%p:%u:%s:%s;", iter->data,
+                              g_str_hash (text->text ? text->text :
+                                          text->markup ? text->markup : ""),
+                              text->font ? gimp_object_get_name (text->font) : "",
+                              gimp_object_get_name (iter->data));
+    }
+
+  if (! g_strcmp0 (stamp->str, dt->stamp))
+    {
+      g_string_free (stamp, TRUE);
+      g_list_free (layers);
+      return G_SOURCE_CONTINUE;
+    }
+
+  g_free (dt->stamp);
+  dt->stamp = g_string_free (stamp, FALSE);
+
+  rows = gtk_container_get_children (GTK_CONTAINER (dt->list));
+  for (iter = rows; iter; iter = iter->next)
+    gtk_widget_destroy (iter->data);
+  g_list_free (rows);
+
+  for (iter = layers; iter; iter = iter->next)
+    {
+      GimpText  *text    = gimp_text_layer_get_text (iter->data);
+      gchar     *content = text->text ? g_strdup (text->text) :
+                           text->markup ? gimp_markup_extract_text (text->markup) :
+                           g_strdup ("");
+      GtkWidget *row     = gtk_list_box_row_new ();
+      GtkWidget *box     = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+      GtkWidget *title   = gtk_label_new (NULL);
+      GtkWidget *preview = gtk_label_new (NULL);
+      gchar     *markup;
+
+      if (g_utf8_strlen (content, -1) > 80)
+        *g_utf8_offset_to_pointer (content, 80) = '\0';
+
+      markup = g_markup_printf_escaped ("<small>%s</small>", gimp_object_get_name (iter->data));
+      gtk_label_set_markup (GTK_LABEL (title), markup);
+      g_free (markup);
+      gtk_style_context_add_class (gtk_widget_get_style_context (title), "dim-label");
+
+      markup = g_markup_printf_escaped ("<span font_desc=\"%s 14\">%s</span>",
+                                        text->font ? gimp_font_get_lookup_name (text->font) : "Sans",
+                                        content);
+      gtk_label_set_markup (GTK_LABEL (preview), markup);
+      g_free (markup);
+      g_free (content);
+
+      gtk_label_set_xalign (GTK_LABEL (title), 0.0);
+      gtk_label_set_xalign (GTK_LABEL (preview), 0.0);
+      gtk_label_set_line_wrap (GTK_LABEL (preview), TRUE);
+      gtk_label_set_lines (GTK_LABEL (preview), 3);
+      gtk_label_set_ellipsize (GTK_LABEL (preview), PANGO_ELLIPSIZE_END);
+
+      gtk_container_set_border_width (GTK_CONTAINER (box), 4);
+      gtk_box_pack_start (GTK_BOX (box), title,   FALSE, FALSE, 0);
+      gtk_box_pack_start (GTK_BOX (box), preview, FALSE, FALSE, 0);
+      gtk_container_add (GTK_CONTAINER (row), box);
+
+      g_object_set_data (G_OBJECT (row), "tattoo",
+                         GUINT_TO_POINTER (gimp_item_get_tattoo (iter->data)));
+      gtk_widget_show_all (row);
+      gtk_list_box_insert (GTK_LIST_BOX (dt->list), row, -1);
+    }
+
+  if (! layers)
+    {
+      GtkWidget *label = gtk_label_new (_("Aucun calque de texte dans l'image."));
+
+      gtk_style_context_add_class (gtk_widget_get_style_context (label), "dim-label");
+      gtk_widget_show (label);
+      gtk_list_box_insert (GTK_LIST_BOX (dt->list), label, -1);
+    }
+
+  g_list_free (layers);
+
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+doc_texts_free (DocTexts *dt)
+{
+  if (dt->refresh_id)
+    g_source_remove (dt->refresh_id);
+  g_free (dt->stamp);
+  g_free (dt);
+}
+
+GtkWidget *
+chopgimp_document_texts_panel_new (GimpDialogFactory *factory,
+                                   GimpContext       *context,
+                                   GimpUIManager     *ui_manager,
+                                   gint               view_size)
+{
+  DocTexts  *dt     = g_new0 (DocTexts, 1);
+  GtkWidget *editor = g_object_new (GIMP_TYPE_EDITOR, NULL);
+  GtkWidget *scroll = gtk_scrolled_window_new (NULL, NULL);
+
+  dt->gimp = context->gimp;
+  dt->list = gtk_list_box_new ();
+  gtk_list_box_set_activate_on_single_click (GTK_LIST_BOX (dt->list), TRUE);
+  g_signal_connect (dt->list, "row-activated", G_CALLBACK (doc_texts_activated), dt);
+
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scroll),
+                                  GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_container_add (GTK_CONTAINER (scroll), dt->list);
+  gtk_box_pack_start (GTK_BOX (editor), scroll, TRUE, TRUE, 0);
+  gtk_widget_show_all (scroll);
+
+  doc_texts_refresh (dt);
+  dt->refresh_id = g_timeout_add (700, (GSourceFunc) doc_texts_refresh, dt);
+  g_object_set_data_full (G_OBJECT (editor), "chopgimp-doc-texts", dt,
+                          (GDestroyNotify) doc_texts_free);
+
+  return editor;
+}
