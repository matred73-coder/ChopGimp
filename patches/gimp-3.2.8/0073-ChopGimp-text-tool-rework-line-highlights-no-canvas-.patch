+static gchar *
+picker_sample_text (Picker *pk)
 {
-  if (! panel->preview_chosen)
-    font_preview_restore (panel);
+  GimpTextTool  *tool  = panel_text_tool (pk->panel->gimp);
+  GimpTextLayer *layer = panel_layer (pk->panel);
+  gchar         *text  = NULL;
+
+  if (tool && gtk_text_buffer_get_has_selection (GTK_TEXT_BUFFER (tool->buffer)))
+    {
+      GtkTextIter a, b;
+
+      gtk_text_buffer_get_selection_bounds (GTK_TEXT_BUFFER (tool->buffer), &a, &b);
+      text = gtk_text_buffer_get_text (GTK_TEXT_BUFFER (tool->buffer), &a, &b, FALSE);
+    }
+  else if (layer && gimp_text_layer_get_text (layer))
+    {
+      GimpText *t = gimp_text_layer_get_text (layer);
+
+      text = t->text ? g_strdup (t->text) :
+             t->markup ? gimp_markup_extract_text (t->markup) : NULL;
+    }
+
+  if (text)
+    {
+      gchar *nl = strchr (text, '\n');
+
+      if (nl)
+        *nl = '\0';
+      if (g_utf8_strlen (text, -1) > 32)
+        *g_utf8_offset_to_pointer (text, 32) = '\0';
+    }
+
+  if (! text || ! *text)
+    {
+      g_free (text);
+      text = g_strdup (_("Échantillon Aa 123"));
+    }
+
+  return text;
 }
 
