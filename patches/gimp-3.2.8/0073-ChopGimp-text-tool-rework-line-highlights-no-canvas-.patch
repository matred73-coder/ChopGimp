+static void
+picker_collect_name (GimpObject *font, GPtrArray *names)
+{
+  g_ptr_array_add (names, g_strconcat (" ", gimp_object_get_name (font), NULL));
+}
+
+static void
+picker_fill (Picker *pk)
+{
+  gchar **favs    = chopgimp_rc_get_strings ("fonts", "favorites");
+  gchar **recents = chopgimp_rc_get_strings ("fonts", "recent");
+  gint    i;
+
+  pk->names = g_ptr_array_new_with_free_func (g_free);
+
+  for (i = 0; favs[i]; i++)
+    if (font_by_name (pk->panel->gimp, favs[i]))
+      g_ptr_array_add (pk->names, g_strconcat ("*", favs[i], NULL));
+
+  for (i = 0; recents[i]; i++)
+    if (font_by_name (pk->panel->gimp, recents[i]) &&
+        ! g_strv_contains ((const gchar * const *) favs, recents[i]))
+      g_ptr_array_add (pk->names, g_strconcat ("+", recents[i], NULL));
+
+  gimp_container_foreach (gimp_data_factory_get_container (pk->panel->gimp->font_factory),
+                          (GFunc) picker_collect_name, pk->names);
+
+  g_strfreev (favs);
+  g_strfreev (recents);
+
+  pk->next    = 0;
+  pk->idle_id = g_idle_add ((GSourceFunc) picker_fill_idle, pk);
+}
+
+static gboolean
+picker_filter (GtkListBoxRow *row, Picker *pk)
+{
+  const gchar *name   = g_object_get_data (G_OBJECT (row), "font");
+  const gchar *badge  = g_object_get_data (G_OBJECT (row), "badge");
+  const gchar *search = gtk_entry_get_text (GTK_ENTRY (pk->search));
+  gint         filter = gtk_combo_box_get_active (GTK_COMBO_BOX (pk->filter));
+  gint         cat    = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (row), "category"));
+  gboolean     fav    = badge && ! strcmp (badge, "★ ");
+  gboolean     recent = badge && *badge && ! fav;
+
+  /*  favourites and recents are listed once more among all the fonts:
+   *  show the copies only with no filter and no search
+   */
+  if (search && *search)
+    {
+      gchar *a = g_utf8_casefold (name, -1);
+      gchar *b = g_utf8_casefold (search, -1);
+      gboolean found = strstr (a, b) != NULL;
+
+      g_free (a);
+      g_free (b);
+
+      if (! found || fav || recent)
+        return FALSE;
     }
 
-  if (! names[0])
+  switch (filter)
     {
-      item = gtk_menu_item_new_with_label (_("   (vide)"));
-      gtk_widget_set_sensitive (item, FALSE);
-      gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+    case FILTER_FAVORITES: return fav;
+    case FILTER_RECENT:    return recent;
+    case FILTER_ALL:       return TRUE;
+    default:               return ! fav && ! recent && cat == filter;
     }
+}
