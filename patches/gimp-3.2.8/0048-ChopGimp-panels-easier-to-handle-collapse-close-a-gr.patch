+/*  ChopGimp « Reset panels »: recreate the docks @info describes for one
+ *  side of an existing dock container (the toolbox is left alone).
+ */
+void
+gimp_session_info_restore_side (GimpSessionInfo   *info,
+                                GimpDialogFactory *factory,
+                                GdkMonitor        *monitor,
+                                GimpDockContainer *container,
+                                GimpAlignmentType  side)
+{
+  GList *iter;
+
+  g_return_if_fail (GIMP_IS_SESSION_INFO (info));
+  g_return_if_fail (GIMP_IS_DIALOG_FACTORY (factory));
+  g_return_if_fail (GDK_IS_MONITOR (monitor));
+  g_return_if_fail (GIMP_IS_DOCK_CONTAINER (container));
+
+  for (iter = info->p->docks; iter; iter = g_list_next (iter))
+    {
+      GimpSessionInfoDock *dock_info = iter->data;
+      GimpDock            *dock;
+
+      if (dock_info->side != side ||
+          ! g_strcmp0 (dock_info->dock_type, "gimp-toolbox"))
+        continue;
+
+      dock = gimp_session_info_dock_restore (dock_info, factory, monitor,
+                                             container);
+
+      if (dock && dock_info->position != 0)
+        {
+          GtkWidget *parent = gtk_widget_get_parent (GTK_WIDGET (dock));
+
+          if (GTK_IS_PANED (parent) &&
+              GTK_WIDGET (dock) == gtk_paned_get_child2 (GTK_PANED (parent)))
+            gtk_paned_set_position (GTK_PANED (parent), dock_info->position);
+        }
+    }
+}
+
+const gchar *
+gimp_session_info_get_aux_value (GimpSessionInfo *info,
+                                 const gchar     *name)
+{
+  GList *iter;
+
+  g_return_val_if_fail (GIMP_IS_SESSION_INFO (info), NULL);
+  g_return_val_if_fail (name != NULL, NULL);
+
+  for (iter = info->p->aux_info; iter; iter = g_list_next (iter))
+    {
+      GimpSessionInfoAux *aux = iter->data;
+
+      if (! g_strcmp0 (aux->name, name))
+        return aux->value;
+    }
+
+  return NULL;
+}
