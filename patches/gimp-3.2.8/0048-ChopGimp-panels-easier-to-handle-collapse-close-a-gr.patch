+/*  ChopGimp: collapse / close a whole group of panels  */
+
+static GtkWidget *
+gimp_dockbook_chop_button (GimpDockbook  *dockbook,
+                           const gchar   *icon_name,
+                           const gchar   *fallback,
+                           const gchar   *tooltip,
+                           GCallback      callback,
+                           GtkWidget    **image)
+{
+  const gchar *names[] = { icon_name, fallback, NULL };
+  GIcon       *icon    = g_themed_icon_new_from_names ((gchar **) names, -1);
+  GtkWidget   *button  = gtk_button_new ();
+
+  *image = gtk_image_new_from_gicon (icon, GTK_ICON_SIZE_MENU);
+  g_object_unref (icon);
+
+  gtk_image_set_pixel_size (GTK_IMAGE (*image), 12);
+  gtk_container_add (GTK_CONTAINER (button), *image);
+  gtk_widget_set_visible (*image, TRUE);
+
+  gtk_widget_set_can_focus (button, FALSE);
+  gtk_button_set_relief (GTK_BUTTON (button), GTK_RELIEF_NONE);
+  gimp_help_set_help_data (button, tooltip, NULL);
+  gtk_widget_set_visible (button, TRUE);
+
+  g_signal_connect_swapped (button, "clicked", callback, dockbook);
+
+  return button;
+}
+
+static void
+gimp_dockbook_collapse_clicked (GimpDockbook *dockbook)
+{
+  gimp_dockbook_set_collapsed (dockbook, ! dockbook->p->collapsed);
+}
+
+static gboolean
+gimp_dockbook_close_idle (gpointer data)
+{
+  GimpDockbook *dockbook = data;
+
+  gimp_dockbook_close_group (dockbook);
+  g_object_unref (dockbook);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+gimp_dockbook_close_clicked (GimpDockbook *dockbook)
+{
+  /*  the button is destroyed with the group: not from its own handler  */
+  g_idle_add (gimp_dockbook_close_idle, g_object_ref (dockbook));
+}
+
+/*  Photoshop: double-click on a tab collapses the group to its tab bar,
+ *  a click on a tab of a collapsed group shows it again.
+ */
+static gboolean
+gimp_dockbook_button_press (GtkWidget      *widget,
+                            GdkEventButton *bevent,
+                            gpointer        data)
+{
+  GimpDockbook  *dockbook = GIMP_DOCKBOOK (widget);
+  GtkNotebook   *notebook = GTK_NOTEBOOK (widget);
+  GtkWidget     *page;
+  GdkWindow     *window;
+  GtkAllocation  allocation;
+  gint           root_x;
+  gint           root_y;
+
+  if (bevent->button != 1)
+    return FALSE;
+
+  page = gtk_notebook_get_nth_page (notebook,
+                                    gtk_notebook_get_current_page (notebook));
+  if (! page || ! (window = gtk_widget_get_parent_window (page)))
+    return FALSE;
+
+  /*  only in the tab bar, above the page  */
+  gtk_widget_get_allocation (page, &allocation);
+  gdk_window_get_root_coords (window, allocation.x, allocation.y,
+                              &root_x, &root_y);
+
+  if (bevent->y_root >= root_y)
+    return FALSE;
+
+  if (bevent->type == GDK_2BUTTON_PRESS)
+    {
+      /*  not the double click whose first click just expanded the group  */
+      if (! dockbook->p->expand_time ||
+          bevent->time - dockbook->p->expand_time > 700)
+        gimp_dockbook_set_collapsed (dockbook, ! dockbook->p->collapsed);
+
+      return TRUE;
+    }
+  else if (bevent->type == GDK_BUTTON_PRESS && dockbook->p->collapsed)
+    {
+      dockbook->p->expand_time = bevent->time;
+      gimp_dockbook_set_collapsed (dockbook, FALSE);
+    }
+
+  return FALSE;
+}
+
+
 /*  public functions  */
 
+gboolean
+gimp_dockbook_get_collapsed (GimpDockbook *dockbook)
+{
+  g_return_val_if_fail (GIMP_IS_DOCKBOOK (dockbook), FALSE);
+
+  return dockbook->p->collapsed;
+}
+
+void
+gimp_dockbook_set_collapsed (GimpDockbook *dockbook,
+                             gboolean      collapsed)
+{
+  const gchar *names[3] = { NULL, NULL, NULL };
+  GIcon       *icon;
+  GtkWidget   *paned_box;
+  GList       *children;
+  GList       *iter;
+
+  g_return_if_fail (GIMP_IS_DOCKBOOK (dockbook));
+
+  collapsed = collapsed ? TRUE : FALSE;
+
+  if (collapsed == dockbook->p->collapsed)
+    return;
+
+  dockbook->p->collapsed = collapsed;
+
+  /*  read by GimpPanedBox  */
+  g_object_set_data (G_OBJECT (dockbook), "chopgimp-collapsed",
+                     GINT_TO_POINTER (collapsed));
+
+  /*  the pages keep their tabs but lose their content: the notebook
+   *  then only asks for the height of its tab bar
+   */
+  children = gtk_container_get_children (GTK_CONTAINER (dockbook));
+  for (iter = children; iter; iter = g_list_next (iter))
+    {
+      GtkWidget *content = gtk_bin_get_child (GTK_BIN (iter->data));
+
+      if (content)
+        gtk_widget_set_visible (content, ! collapsed);
+    }
+  g_list_free (children);
+
+  names[0] = collapsed ? "chopgimp-panel-expand-symbolic" : "chopgimp-panel-collapse-symbolic";
+  names[1] = collapsed ? "go-next-symbolic"      : "go-down-symbolic";
+  icon = g_themed_icon_new_from_names ((gchar **) names, -1);
+  gtk_image_set_from_gicon (GTK_IMAGE (dockbook->p->collapse_image), icon,
+                            GTK_ICON_SIZE_MENU);
+  g_object_unref (icon);
+
+  gimp_help_set_help_data (dockbook->p->collapse_button,
+                           collapsed ?
+                           _("Développer ce groupe de panneaux "
+                             "(ou clic sur un onglet)") :
+                           _("Réduire ce groupe de panneaux "
+                             "(ou double-clic sur un onglet)"),
+                           NULL);
+
+  paned_box = gtk_widget_get_ancestor (GTK_WIDGET (dockbook),
+                                       GIMP_TYPE_PANED_BOX);
+  if (paned_box)
+    gimp_paned_box_update_collapsed (GIMP_PANED_BOX (paned_box));
+}
+
+/*  closes every panel of the group; the empty group removes itself  */
+void
+gimp_dockbook_close_group (GimpDockbook *dockbook)
+{
+  GList *children;
+  GList *iter;
+
+  g_return_if_fail (GIMP_IS_DOCKBOOK (dockbook));
+
+  g_object_ref (dockbook);
+
+  children = gtk_container_get_children (GTK_CONTAINER (dockbook));
+  for (iter = children; iter; iter = g_list_next (iter))
+    if (gtk_widget_get_parent (iter->data) == GTK_WIDGET (dockbook))
+      gtk_container_remove (GTK_CONTAINER (dockbook), iter->data);
+  g_list_free (children);
+
+  g_object_unref (dockbook);
+}
+
