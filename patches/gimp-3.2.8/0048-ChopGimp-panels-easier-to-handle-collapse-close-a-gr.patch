+/*  ChopGimp: hide / show the column of panels on the right  */
+void
+windows_hide_right_docks_cmd_callback (GimpAction *action,
+                                       GVariant   *value,
+                                       gpointer    data)
+{
+  Gimp     *gimp;
+  GList    *windows;
+  GList    *iter;
+  gboolean  active;
+  return_if_no_gimp (gimp, data);
+
+  active = g_variant_get_boolean (value);
+
+  if (active == chopgimp_rc_get_boolean ("panels", "right-hidden", FALSE))
+    return;
+
+  chopgimp_rc_set_boolean ("panels", "right-hidden", active);
+
+  windows = gimp_get_image_windows (gimp);
+  for (iter = windows; iter; iter = g_list_next (iter))
+    gimp_image_window_right_docks_changed (iter->data);
+  g_list_free (windows);
+}
+
+/*  ChopGimp: back to the factory arrangement of the panels  */
+void
+windows_reset_panels_cmd_callback (GimpAction *action,
+                                   GVariant   *value,
+                                   gpointer    data)
+{
+  Gimp       *gimp;
+  GList      *windows;
+  GimpAction *hide;
+  return_if_no_gimp (gimp, data);
+
+  /*  show the column again if it was hidden  */
+  hide = gimp_ui_manager_find_action (menus_get_image_manager_singleton (gimp),
+                                      "windows", "windows-hide-right-docks");
+  if (hide)
+    gimp_toggle_action_set_active (GIMP_TOGGLE_ACTION (hide), FALSE);
+
+  if (GIMP_GUI_CONFIG (gimp->config)->hide_docks)
+    g_object_set (gimp->config, "hide-docks", FALSE, NULL);
+
+  windows = gimp_get_image_windows (gimp);
+  if (windows)
+    gimp_image_window_reset_panels (windows->data);
+  g_list_free (windows);
+}
