+/*  ChopGimp: the column of panels on the right, and its strip  */
+
+static void
+gimp_image_window_update_right_docks (GimpImageWindow *window)
+{
+  GimpImageWindowPrivate *private = GIMP_IMAGE_WINDOW_GET_PRIVATE (window);
+  GimpGuiConfig          *config  = GIMP_GUI_CONFIG (private->gimp->config);
+  gboolean                show    = (config->single_window_mode &&
+                                     ! config->hide_docks);
+  gboolean                hidden  = chopgimp_rc_get_boolean ("panels",
+                                                             "right-hidden",
+                                                             FALSE);
+  const gchar            *names[] = { hidden ? "chopgimp-dock-show-symbolic" :
+                                               "chopgimp-dock-hide-symbolic",
+                                      hidden ? GIMP_ICON_MENU_LEFT :
+                                               GIMP_ICON_MENU_RIGHT,
+                                      NULL };
+  GIcon                  *icon;
+
+  gtk_widget_set_visible (private->right_docks, show && ! hidden);
+  gtk_widget_set_visible (private->right_strip, show);
+
+  icon = g_themed_icon_new_from_names ((gchar **) names, -1);
+  gtk_image_set_from_gicon (GTK_IMAGE (private->right_strip_image), icon,
+                            GTK_ICON_SIZE_MENU);
+  g_object_unref (icon);
+
+  gimp_help_set_help_data (private->right_strip,
+                           hidden ? _("Afficher les panneaux (Maj+Tab)") :
+                                    _("Masquer les panneaux (Maj+Tab)"),
+                           NULL);
+}
+
+static void
+gimp_image_window_right_strip_clicked (GimpImageWindow *window)
+{
+  GimpImageWindowPrivate *private = GIMP_IMAGE_WINDOW_GET_PRIVATE (window);
+
+  gimp_ui_manager_activate_action (menus_get_image_manager_singleton (private->gimp),
+                                   "windows", "windows-hide-right-docks");
+}
+
+/*  called when the « right-hidden » setting changed  */
+void
+gimp_image_window_right_docks_changed (GimpImageWindow *window)
+{
+  g_return_if_fail (GIMP_IS_IMAGE_WINDOW (window));
+
+  gimp_image_window_keep_canvas_pos (window);
+  gimp_image_window_update_right_docks (window);
+}
+
+static void
+gimp_image_window_close_books (GimpDockColumns *columns)
+{
+  GList *docks = g_list_copy (gimp_dock_columns_get_docks (columns));
+  GList *iter;
+
+  g_list_foreach (docks, (GFunc) g_object_ref, NULL);
+
+  for (iter = docks; iter; iter = g_list_next (iter))
+    {
+      GList *books = g_list_copy (gimp_dock_get_dockbooks (iter->data));
+      GList *book;
+
+      g_list_foreach (books, (GFunc) g_object_ref, NULL);
+
+      /*  an empty group removes itself, and so does an empty dock  */
+      for (book = books; book; book = g_list_next (book))
+        gimp_dockbook_close_group (book->data);
+
+      g_list_free_full (books, g_object_unref);
+    }
+
+  g_list_free_full (docks, g_object_unref);
+}
+
+/**
+ * gimp_image_window_reset_panels:
+ * @window:
+ *
+ * ChopGimp (Photoshop « Reset Essentials »): closes every panel and
+ * builds again the factory arrangement of the system sessionrc, without
+ * restarting. The toolbox itself is not touched.
+ **/
+void
+gimp_image_window_reset_panels (GimpImageWindow *window)
+{
+  GimpImageWindowPrivate *private;
+  GimpSessionInfo        *info    = NULL;
+  GFile                  *file;
+  GimpScanner            *scanner;
+  GList                  *dialogs;
+  GList                  *iter;
+  GtkAllocation           allocation;
+  const gchar            *value;
+
+  g_return_if_fail (GIMP_IS_IMAGE_WINDOW (window));
+
+  private = GIMP_IMAGE_WINDOW_GET_PRIVATE (window);
+
+  /*  the factory arrangement of the single-window mode  */
+  file    = gimp_sysconf_directory_file ("sessionrc", NULL);
+  scanner = gimp_scanner_new_file (file, NULL);
+  g_object_unref (file);
+
+  if (scanner)
+    {
+      GTokenType token;
+
+      g_scanner_scope_add_symbol (scanner, 0, "session-info",
+                                  GINT_TO_POINTER (1));
+
+      while (! info &&
+             (token = g_scanner_get_next_token (scanner)) != G_TOKEN_EOF &&
+             token != G_TOKEN_ERROR)
+        {
+          if (token == G_TOKEN_SYMBOL &&
+              scanner->value.v_symbol == GINT_TO_POINTER (1))
+            {
+              GimpDialogFactoryEntry *entry;
+              gchar                  *factory_name = NULL;
+
+              if (! gimp_scanner_parse_string (scanner, &factory_name))
+                break;
+              g_free (factory_name);
+
+              info = gimp_session_info_new ();
+
+              if (! gimp_config_deserialize (GIMP_CONFIG (info), scanner,
+                                             1, NULL))
+                {
+                  g_clear_object (&info);
+                  break;
+                }
+
+              entry = gimp_session_info_get_factory_entry (info);
+
+              if (! entry ||
+                  g_strcmp0 (entry->identifier, "gimp-single-image-window"))
+                g_clear_object (&info);
+            }
+        }
+
+      gimp_scanner_unref (scanner);
+    }
+
+  if (! info)
+    {
+      gimp_message_literal (private->gimp, G_OBJECT (window),
+                            GIMP_MESSAGE_WARNING,
+                            _("Disposition d'origine des panneaux introuvable."));
+      return;
+    }
+
+  gimp_image_window_keep_canvas_pos (window);
+
+  /*  floating dock windows first: their panels are singletons  */
+  dialogs = g_list_copy (gimp_dialog_factory_get_open_dialogs (private->dialog_factory));
+  g_list_foreach (dialogs, (GFunc) g_object_ref, NULL);
+  for (iter = dialogs; iter; iter = g_list_next (iter))
+    if (GIMP_IS_DOCK_WINDOW (iter->data))
+      gtk_widget_destroy (iter->data);
+  g_list_free_full (dialogs, g_object_unref);
+
+  gimp_image_window_close_books (GIMP_DOCK_COLUMNS (private->left_docks));
+  gimp_image_window_close_books (GIMP_DOCK_COLUMNS (private->right_docks));
+
+  gimp_session_info_restore_side (info, private->dialog_factory,
+                                  gimp_widget_get_monitor (GTK_WIDGET (window)),
+                                  GIMP_DOCK_CONTAINER (window),
+                                  GIMP_ALIGN_LEFT);
+  gimp_session_info_restore_side (info, private->dialog_factory,
+                                  gimp_widget_get_monitor (GTK_WIDGET (window)),
+                                  GIMP_DOCK_CONTAINER (window),
+                                  GIMP_ALIGN_RIGHT);
+
+  /*  widths of the two columns  */
+  value = gimp_session_info_get_aux_value (info,
+                                           GIMP_IMAGE_WINDOW_LEFT_DOCKS_WIDTH);
+  if (value && atoi (value) > 0)
+    gtk_paned_set_position (GTK_PANED (private->left_hpane), atoi (value));
+
+  value = gimp_session_info_get_aux_value (info,
+                                           GIMP_IMAGE_WINDOW_RIGHT_DOCKS_WIDTH);
+  gtk_widget_get_allocation (private->right_hpane, &allocation);
+  if (value && atoi (value) > 0 && allocation.width > atoi (value))
+    gtk_paned_set_position (GTK_PANED (private->right_hpane),
+                            allocation.width - atoi (value));
+
+  g_object_unref (info);
+
+  gimp_image_window_update_right_docks (window);
+}
