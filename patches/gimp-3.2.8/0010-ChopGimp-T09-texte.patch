+/*  ChopGimp: re-render after an outside change (the path of a text on
+ *  path was edited).  No undo: the text itself did not change.
+ */
+void
+gimp_text_layer_chopgimp_refresh (GimpTextLayer *layer)
+{
+  g_return_if_fail (GIMP_IS_TEXT_LAYER (layer));
+
+  if (! layer->text ||
+      gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)))
+    return;
+
+  gimp_text_layer_render (layer);
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+}
