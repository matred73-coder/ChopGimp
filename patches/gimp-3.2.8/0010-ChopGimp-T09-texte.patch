+
+#pragma once
+
+#include <cairo.h>
+
+typedef struct _ChopGimpTextFx ChopGimpTextFx;
+
+/*  The effect is described by the "chopgimp-fx" property of GimpText:
+ *
+ *    warp=arc;bend=50;hdist=0;vdist=0;vertical=0
+ *    path=<tattoo>;start=0;flip=0;shift=0
+ *    shape=<tattoo>;inset=0
+ *
+ *  A non-identity transformation matrix also goes through this
+ *  renderer, so the layer grows to the transformed text.
+ */
