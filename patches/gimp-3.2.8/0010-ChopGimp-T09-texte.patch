+
+typedef struct _Watch Watch;
+
+typedef struct
+{
+  Gimp          *gimp;
+  GtkWidget     *widget;         /* the dockable                       */
+  gboolean       paragraph;
+  gboolean       updating;
+  Watch         *watch;          /* refreshes it when something changed */
+  GimpTextLayer *shown_layer;
+  gchar         *shown_stamp;
+
+  /*  Character  */
+  GtkWidget     *font;
+  GtkWidget     *size;
+  GtkWidget     *leading;
+  GtkWidget     *tracking;
+  GtkWidget     *kerning;
+  GtkWidget     *vscale;
+  GtkWidget     *hscale;
+  GtkWidget     *baseline;
+  GtkWidget     *color;
+
+  GtkWidget     *favorite;
+  GimpFont      *preview_font;   /* font before a hover preview */
+  GimpTextLayer *preview_layer;  /* the layer showing it (weak)  */
+  gboolean       preview_chosen;
+
+  /*  Paragraph  */
+  GtkWidget     *indent;
+  GtkWidget     *box_mode;
+  GtkWidget     *hyphens;
+} Panel;
+
+
+/* ─── refreshing on events, not on a timer ─────────────────────────── *
+ *
+ *  A panel follows the user context (image, tool), the image (undo
+ *  steps, selected layers, resolution, the layer tree) and every text
+ *  layer of it (its GimpText, its name).  Bursts of changes end in a
+ *  single refresh; nothing is watched while the panel is hidden, and it
+ *  is refreshed when shown again.
+ */
+
+struct _Watch
+{
+  GtkWidget   *widget;
+  GSourceFunc  refresh;
+  gpointer     data;
+  guint        delay;     /* ms; 0: idle */
+  GimpContext *context;
+  GPtrArray   *objects;   /* watched objects, weakly referenced */
+  guint        source_id;
+};
+
+static gboolean watch_run (Watch *w);
+
+static void
+watch_object_gone (gpointer  data,
+                   GObject  *where_the_object_was)
+{
+  Watch *w = data;
+
+  g_ptr_array_remove_fast (w->objects, where_the_object_was);
+}
+
+static void
+watch_release (Watch *w)
+{
+  while (w->objects->len)
+    {
+      GObject *object = g_ptr_array_index (w->objects, w->objects->len - 1);
+
+      g_ptr_array_remove_index_fast (w->objects, w->objects->len - 1);
+      g_object_weak_unref (object, watch_object_gone, w);
+      g_signal_handlers_disconnect_by_data (object, w);
+    }
+}
+
+static void
+watch_queue (Watch *w)
+{
+  if (w->source_id || ! gtk_widget_get_mapped (w->widget))
+    return;
+
+  if (w->delay)
+    w->source_id = g_timeout_add (w->delay, (GSourceFunc) watch_run, w);
+  else
+    w->source_id = g_idle_add ((GSourceFunc) watch_run, w);
+}
+
+static gboolean
+watch_add (Watch    *w,
+           gpointer  object)
+{
+  if (g_ptr_array_find (w->objects, object, NULL))
+    return FALSE;
+
+  g_ptr_array_add (w->objects, object);
+  g_object_weak_ref (G_OBJECT (object), watch_object_gone, w);
+
+  return TRUE;
+}
+
+static void
+watch_signal (Watch       *w,
+              gpointer     object,
+              const gchar *signal)
+{
+  g_signal_connect_swapped (object, signal, G_CALLBACK (watch_queue), w);
+}
+
+static void
+watch_container (Watch         *w,
+                 GimpContainer *container)
+{
+  if (watch_add (w, container))
+    {
+      watch_signal (w, container, "add");
+      watch_signal (w, container, "remove");
+      watch_signal (w, container, "reorder");
+    }
+}
+
+static void
+watch_layers (Watch *w,
+              GList *layers)
+{
+  for (; layers; layers = layers->next)
+    {
+      GimpContainer *children = gimp_viewable_get_children (layers->data);
+
+      if (children)
+        {
+          watch_container (w, children);
+          watch_layers (w, GIMP_LIST (children)->queue->head);
+        }
+      else if (gimp_item_is_text_layer (layers->data))
+        {
+          GimpText *text = gimp_text_layer_get_text (layers->data);
+
+          if (watch_add (w, layers->data))
+            {
+              watch_signal (w, layers->data, "notify::text");
+              watch_signal (w, layers->data, "name-changed");
+            }
+
+          if (text && watch_add (w, text))
+            watch_signal (w, text, "changed");
+        }
+    }
+}
+
+/*  (re)connect to the current image and its text layers  */
+static void
+watch_sync (Watch *w)
+{
+  GimpImage *image = gimp_context_get_image (w->context);
+
+  watch_release (w);
+
+  if (! image)
+    return;
+
+  watch_add (w, image);
+  watch_signal (w, image, "undo-event");
+  watch_signal (w, image, "selected-layers-changed");
+  watch_signal (w, image, "resolution-changed");
+
+  watch_container (w, gimp_image_get_layers (image));
+  watch_layers (w, gimp_image_get_layer_iter (image));
+}
+
+static gboolean
+watch_run (Watch *w)
+{
+  w->source_id = 0;
+
+  watch_sync (w);
+  w->refresh (w->data);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+watch_image_changed (Watch *w)
+{
+  /*  never keep the previous image  */
+  watch_release (w);
+  watch_queue (w);
+}
+
+static void
+watch_unmap (Watch *w)
+{
+  if (w->source_id)
+    g_source_remove (w->source_id);
+  w->source_id = 0;
+
+  watch_release (w);
+}
+
+static Watch *
+watch_new (GtkWidget   *widget,
+           Gimp        *gimp,
+           GSourceFunc  refresh,
+           gpointer     data,
+           guint        delay)
+{
+  Watch *w = g_new0 (Watch, 1);
+
+  w->widget  = widget;
+  w->refresh = refresh;
+  w->data    = data;
+  w->delay   = delay;
+  w->context = gimp_get_user_context (gimp);
+  w->objects = g_ptr_array_new ();
+
+  g_signal_connect_swapped (w->context, "image-changed",
+                            G_CALLBACK (watch_image_changed), w);
+  g_signal_connect_swapped (w->context, "tool-changed",
+                            G_CALLBACK (watch_queue), w);
+
+  g_signal_connect_data (widget, "map",
+                         G_CALLBACK (watch_queue), w, NULL,
+                         G_CONNECT_SWAPPED | G_CONNECT_AFTER);
+  g_signal_connect_swapped (widget, "unmap",
+                            G_CALLBACK (watch_unmap), w);
+
+  watch_queue (w);
+
+  return w;
+}
+
+/*  from the widget's data destroy notify: its own handlers are gone  */
+static void
+watch_free (Watch *w)
+{
+  if (! w)
+    return;
+
+  if (w->source_id)
+    g_source_remove (w->source_id);
+
+  watch_release (w);
+  g_signal_handlers_disconnect_by_data (w->context, w);
+  g_ptr_array_free (w->objects, TRUE);
+  g_free (w);
+}
+
+
+/* ─── the target: text being edited, or the selected text layer ──── */
+
+typedef struct
+{
+  GimpTextLayer  *layer;
+  GimpTextBuffer *buffer;     /* the text tool's, or a temporary one */
+  gboolean        temporary;
+  GtkTextIter     start;
+  GtkTextIter     end;
+} Target;
+
+static GimpTextLayer *
+panel_text_layer (Gimp *gimp)
+{
+  GimpContext *context = gimp_get_user_context (gimp);
+  GimpImage   *image   = gimp_context_get_image (context);
+  GList       *iter;
+
+  if (! image)
+    return NULL;
+
+  /*  a rasterized text layer is not a text any more  */
+  for (iter = gimp_image_get_selected_layers (image); iter; iter = iter->next)
+    if (gimp_item_is_text_layer (GIMP_ITEM (iter->data)))
+      return iter->data;
+
+  return NULL;
+}
+
+static GimpTextTool *
+panel_text_tool (Gimp *gimp)
+{
+  GimpTool *tool = tool_manager_get_active (gimp);
+
+  if (GIMP_IS_TEXT_TOOL (tool) && GIMP_TEXT_TOOL (tool)->layer)
+    return GIMP_TEXT_TOOL (tool);
+
+  return NULL;
+}
+
+static gboolean
+target_begin (Panel *panel, Target *t)
+{
+  GimpTextTool *tool = panel_text_tool (panel->gimp);
+  GtkTextBuffer *buffer;
+
+  memset (t, 0, sizeof (Target));
+
+  if (tool)
+    {
+      t->layer  = tool->layer;
+      t->buffer = tool->buffer;
+    }
+  else
+    {
+      GimpText *text;
+
+      t->layer = panel_text_layer (panel->gimp);
+      if (! t->layer || ! (text = gimp_text_layer_get_text (t->layer)))
+        return FALSE;
+
+      t->buffer    = gimp_text_buffer_new ();
+      t->temporary = TRUE;
+
+      if (text->markup)
+        gimp_text_buffer_set_markup (t->buffer, text->markup);
+      else
+        gimp_text_buffer_set_text (t->buffer, text->text);
+    }
+
+  buffer = GTK_TEXT_BUFFER (t->buffer);
+
+  if (! gtk_text_buffer_get_selection_bounds (buffer, &t->start, &t->end))
+    gtk_text_buffer_get_bounds (buffer, &t->start, &t->end);
+
+  return TRUE;
+}
+
+/*  a temporary buffer is written back into the layer  */
+static void
+target_end (Target *t, const gchar *undo_desc)
+{
+  if (t->temporary)
+    {
+      gchar    *markup = gimp_text_buffer_get_markup (t->buffer);
+      GimpText *text   = gimp_text_layer_get_text (t->layer);
+
+      /*  nothing changed: no undo step  */
+      if (text && ! g_strcmp0 (markup, text->markup))
+        {
+          g_free (markup);
+          g_object_unref (t->buffer);
+          return;
+        }
+
+      gimp_text_layer_set (t->layer, undo_desc, "markup", markup, NULL);
+      g_free (markup);
+      g_object_unref (t->buffer);
+
+      gimp_image_flush (gimp_item_get_image (GIMP_ITEM (t->layer)));
+    }
+}
+
+static GimpTextLayer *
+panel_layer (Panel *panel)
+{
+  GimpTextTool *tool = panel_text_tool (panel->gimp);
+
+  return tool ? tool->layer : panel_text_layer (panel->gimp);
+}
+
+static void
+layer_flush (GimpTextLayer *layer)
+{
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+}
+
+static void
+layer_set_double (Panel *panel, const gchar *undo_desc, const gchar *prop, gdouble value)
+{
+  GimpTextLayer *layer = panel_layer (panel);
+
+  if (layer)
+    {
+      gimp_text_layer_set (layer, undo_desc, prop, value, NULL);
+      layer_flush (layer);
+    }
+}
+
+static void
+layer_set_int (Panel *panel, const gchar *undo_desc, const gchar *prop, gint value)
+{
+  GimpTextLayer *layer = panel_layer (panel);
+
+  if (layer)
+    {
+      gimp_text_layer_set (layer, undo_desc, prop, value, NULL);
+      layer_flush (layer);
+    }
+}
+
+/* ─── character operations ─────────────────────────────────────────── */
+
+static GimpFont *
+font_by_name (Gimp *gimp, const gchar *name)
+{
+  return GIMP_FONT (gimp_container_get_child_by_name (gimp_data_factory_get_container (gimp->font_factory),
+                                                      name));
+}
+
+static void
+font_list_add (const gchar *key, const gchar *name, gboolean front, gint max)
+{
+  gchar    **old  = chopgimp_rc_get_strings ("fonts", key);
+  GPtrArray *list = g_ptr_array_new ();
+  gint       i;
+
+  if (front)
+    g_ptr_array_add (list, (gpointer) name);
+
+  for (i = 0; old[i] && (gint) list->len < max; i++)
+    if (strcmp (old[i], name))
+      g_ptr_array_add (list, old[i]);
+
+  if (! front)
+    g_ptr_array_add (list, (gpointer) name);
+
+  g_ptr_array_add (list, NULL);
+  chopgimp_rc_set_strings ("fonts", key, (const gchar * const *) list->pdata);
+
+  g_ptr_array_free (list, TRUE);
+  g_strfreev (old);
+}
+
+static void
+font_list_remove (const gchar *key, const gchar *name)
+{
+  gchar    **old  = chopgimp_rc_get_strings ("fonts", key);
+  GPtrArray *list = g_ptr_array_new ();
+  gint       i;
+
+  for (i = 0; old[i]; i++)
+    if (strcmp (old[i], name))
+      g_ptr_array_add (list, old[i]);
+
+  g_ptr_array_add (list, NULL);
+  chopgimp_rc_set_strings ("fonts", key, (const gchar * const *) list->pdata);
+
+  g_ptr_array_free (list, TRUE);
+  g_strfreev (old);
+}
+
+static gboolean
+font_is_favorite (const gchar *name)
+{
+  gchar  **favs = chopgimp_rc_get_strings ("fonts", "favorites");
+  gboolean fav  = name && g_strv_contains ((const gchar * const *) favs, name);
+
+  g_strfreev (favs);
+
+  return fav;
+}
+
+static void
+font_apply (Panel *panel, const gchar *name)
+{
+  Target t;
+
+  if (! name || ! *name || ! target_begin (panel, &t))
+    return;
+
+  gimp_text_buffer_set_font (t.buffer, &t.start, &t.end, name);
+  target_end (&t, _("Police"));
+
+  font_list_add ("recent", name, TRUE, 8);
+}
+
+static void
+font_activate (GtkEntry *entry, Panel *panel)
+{
+  if (! panel->updating)
+    font_apply (panel, gtk_entry_get_text (entry));
+}
+
+static void
+favorite_update (Panel *panel)
+{
+  if (panel->favorite)
+    gtk_button_set_label (GTK_BUTTON (panel->favorite),
+                          font_is_favorite (gtk_entry_get_text (GTK_ENTRY (panel->font))) ?
+                          "★" : "☆");
+}
+
+static void
+favorite_clicked (GtkButton *button, Panel *panel)
+{
+  const gchar *name = gtk_entry_get_text (GTK_ENTRY (panel->font));
+
+  if (! name || ! *name)
+    return;
+
+  if (font_is_favorite (name))
+    font_list_remove ("favorites", name);
+  else
+    font_list_add ("favorites", name, FALSE, 200);
+
+  favorite_update (panel);
+}
+
+/*  hover preview: the whole layer shows the font, without undo  */
+static gboolean
+font_preview_possible (Panel *panel)
+{
+  GimpTextTool *tool = panel_text_tool (panel->gimp);
+
+  return ! (tool && gtk_text_buffer_get_has_selection (GTK_TEXT_BUFFER (tool->buffer))) &&
+         panel_layer (panel) != NULL;
+}
+
+static void
+font_preview_set_layer (Panel *panel, GimpTextLayer *layer)
+{
+  if (panel->preview_layer == layer)
+    return;
+
+  if (panel->preview_layer)
+    g_object_remove_weak_pointer (G_OBJECT (panel->preview_layer),
+                                  (gpointer *) &panel->preview_layer);
+
+  panel->preview_layer = layer;
+
+  if (layer)
+    g_object_add_weak_pointer (G_OBJECT (layer),
+                               (gpointer *) &panel->preview_layer);
+}
+
+/*  gives its font back to the layer that shows a preview, and only to it  */
+static void
+font_preview_restore (Panel *panel)
+{
+  GimpTextLayer *layer = panel->preview_layer;
+
+  if (panel->preview_font)
+    {
+      GimpText *text = layer ? gimp_text_layer_get_text (layer) : NULL;
+
+      if (text)
+        {
+          g_object_set (text, "font", panel->preview_font, NULL);
+          layer_flush (layer);
+        }
+      g_clear_object (&panel->preview_font);
+    }
+
+  font_preview_set_layer (panel, NULL);
+}
+
+static void
+font_preview_name (Panel *panel, const gchar *name)
+{
+  GimpTextLayer *layer = panel_layer (panel);
+  GimpFont      *font  = name ? font_by_name (panel->gimp, name) : NULL;
+  GimpText      *text;
+
+  if (! font || ! font_preview_possible (panel))
+    return;
+
+  /*  the target changed meanwhile: the previous one gets its font back  */
+  if (panel->preview_font && panel->preview_layer != layer)
+    font_preview_restore (panel);
+
+  text = gimp_text_layer_get_text (layer);
+  if (! text)
+    return;
+
+  if (! panel->preview_font)
+    {
+      panel->preview_font = g_object_ref (text->font);
+      font_preview_set_layer (panel, layer);
+    }
+
+  g_object_set (text, "font", font, NULL);
+  layer_flush (layer);
+}
+
+
+static void panel_free (Panel *panel);
+
+static void
+effect_clicked (GtkButton *button, Panel *panel)
+{
+  const gchar *name   = g_object_get_data (G_OBJECT (button), "chopgimp-action");
+  GAction     *action = g_action_map_lookup_action (G_ACTION_MAP (panel->gimp->app), name);
+
+  if (action && g_action_get_enabled (action))
+    g_action_activate (action, NULL);
+  else
+    gdk_display_beep (gtk_widget_get_display (GTK_WIDGET (button)));
+}
+
+/* ─── font picker: every font shown in its own face (Photoshop) ─────── */
+
+typedef struct
+{
+  Panel     *panel;
+  gboolean   own_panel;
+  GtkWidget *box;
+  GtkWidget *search;
+  GtkWidget *filter;
+  GtkWidget *sample;
+  GtkWidget *list;
+  GtkWidget *popover;
+  GPtrArray *names;
+  guint      next;
+  guint      idle_id;
+  gboolean   chosen;
+  GtkWidget *hover_row;
+} Picker;
+
+enum { FILTER_ALL, FILTER_FAVORITES, FILTER_RECENT, FILTER_SERIF, FILTER_SANS,
+       FILTER_SCRIPT, FILTER_MONO };
+
+static gint
+font_category (const gchar *name)
+{
+  gchar *low = g_ascii_strdown (name, -1);
+  gint   cat = FILTER_SANS;
+
+  if (strstr (low, "mono") || strstr (low, "code") || strstr (low, "courier") ||
+      strstr (low, "console") || strstr (low, "typewriter"))
+    cat = FILTER_MONO;
+  else if (strstr (low, "script") || strstr (low, "hand") || strstr (low, "brush") ||
+           strstr (low, "callig") || strstr (low, "comic") || strstr (low, "pacifico") ||
+           strstr (low, "dancing") || strstr (low, "lobster"))
+    cat = FILTER_SCRIPT;
+  else if ((strstr (low, "serif") && ! strstr (low, "sans")) || strstr (low, "times") ||
+           strstr (low, "georgia") || strstr (low, "garamond") || strstr (low, "roman") ||
+           strstr (low, "baskerville") || strstr (low, "bodoni") || strstr (low, "palatino") ||
+           strstr (low, "book") || strstr (low, "caslon") || strstr (low, "playfair"))
+    cat = FILTER_SERIF;
+
+  g_free (low);
+
+  return cat;
+}
+
+static gchar *
+picker_sample_text (Picker *pk)
+{
+  GimpTextTool  *tool  = panel_text_tool (pk->panel->gimp);
+  GimpTextLayer *layer = panel_layer (pk->panel);
+  gchar         *text  = NULL;
+
+  if (tool && gtk_text_buffer_get_has_selection (GTK_TEXT_BUFFER (tool->buffer)))
+    {
+      GtkTextIter a, b;
+
+      gtk_text_buffer_get_selection_bounds (GTK_TEXT_BUFFER (tool->buffer), &a, &b);
+      text = gtk_text_buffer_get_text (GTK_TEXT_BUFFER (tool->buffer), &a, &b, FALSE);
+    }
+  else if (layer && gimp_text_layer_get_text (layer))
+    {
+      GimpText *t = gimp_text_layer_get_text (layer);
+
+      text = t->text ? g_strdup (t->text) :
+             t->markup ? gimp_markup_extract_text (t->markup) : NULL;
+    }
+
+  if (text)
+    {
+      gchar *nl = strchr (text, '\n');
+
+      if (nl)
+        *nl = '\0';
+      if (g_utf8_strlen (text, -1) > 32)
+        *g_utf8_offset_to_pointer (text, 32) = '\0';
+    }
+
+  if (! text || ! *text)
+    {
+      g_free (text);
+      text = g_strdup (_("Échantillon Aa 123"));
+    }
+
+  return text;
+}
+
+static void
+picker_row_markup (Picker *pk, GtkWidget *row)
+{
+  const gchar *name   = g_object_get_data (G_OBJECT (row), "font");
+  GtkWidget   *label  = g_object_get_data (G_OBJECT (row), "sample");
+  GimpFont    *font   = font_by_name (pk->panel->gimp, name);
+  gchar       *markup;
+
+  markup = g_markup_printf_escaped ("<span font_desc=\"%s 17\">%s</span>",
+                                    font ? gimp_font_get_lookup_name (font) : "Sans",
+                                    gtk_entry_get_text (GTK_ENTRY (pk->sample)));
+  gtk_label_set_markup (GTK_LABEL (label), markup);
+  g_free (markup);
+}
+
+static GtkWidget *
+picker_make_row (Picker *pk, const gchar *name, const gchar *badge)
+{
+  GtkWidget *row    = gtk_list_box_row_new ();
+  GtkWidget *box    = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  GtkWidget *title  = gtk_label_new (NULL);
+  GtkWidget *sample = gtk_label_new (NULL);
+  gchar     *markup;
+
+  markup = g_markup_printf_escaped ("<small>%s%s</small>", badge, name);
+  gtk_label_set_markup (GTK_LABEL (title), markup);
+  g_free (markup);
+  gtk_label_set_xalign (GTK_LABEL (title), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (title), "dim-label");
+  gtk_label_set_xalign (GTK_LABEL (sample), 0.0);
+  gtk_label_set_ellipsize (GTK_LABEL (sample), PANGO_ELLIPSIZE_END);
+
+  gtk_container_set_border_width (GTK_CONTAINER (box), 4);
+  gtk_box_pack_start (GTK_BOX (box), title,  FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (box), sample, FALSE, FALSE, 0);
+  gtk_container_add (GTK_CONTAINER (row), box);
+
+  g_object_set_data_full (G_OBJECT (row), "font", g_strdup (name), g_free);
+  g_object_set_data (G_OBJECT (row), "sample", sample);
+  g_object_set_data (G_OBJECT (row), "badge", (gpointer) badge);
+  g_object_set_data (G_OBJECT (row), "category", GINT_TO_POINTER (font_category (name)));
+
+  picker_row_markup (pk, row);
+  gtk_widget_show_all (row);
+
+  return row;
+}
+
+/*  rows are made a few at a time: there may be a thousand fonts  */
+static gboolean
+picker_fill_idle (Picker *pk)
+{
+  guint end = MIN (pk->next + 40, pk->names->len);
+
+  for (; pk->next < end; pk->next++)
+    {
+      const gchar *entry = g_ptr_array_index (pk->names, pk->next);
+      const gchar *badge = entry[0] == '*' ? "★ " : entry[0] == '+' ? "🕘 " : "";
+
+      gtk_list_box_insert (GTK_LIST_BOX (pk->list),
+                           picker_make_row (pk, entry + 1, badge), -1);
+    }
+
+  if (pk->next >= pk->names->len)
+    {
+      pk->idle_id = 0;
+      return G_SOURCE_REMOVE;
+    }
+
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+picker_collect_name (GimpObject *font, GPtrArray *names)
+{
+  g_ptr_array_add (names, g_strconcat (" ", gimp_object_get_name (font), NULL));
+}
+
+static void
+picker_fill (Picker *pk)
+{
+  gchar **favs    = chopgimp_rc_get_strings ("fonts", "favorites");
+  gchar **recents = chopgimp_rc_get_strings ("fonts", "recent");
+  gint    i;
+
+  pk->names = g_ptr_array_new_with_free_func (g_free);
+
+  for (i = 0; favs[i]; i++)
+    if (font_by_name (pk->panel->gimp, favs[i]))
+      g_ptr_array_add (pk->names, g_strconcat ("*", favs[i], NULL));
+
+  for (i = 0; recents[i]; i++)
+    if (font_by_name (pk->panel->gimp, recents[i]) &&
+        ! g_strv_contains ((const gchar * const *) favs, recents[i]))
+      g_ptr_array_add (pk->names, g_strconcat ("+", recents[i], NULL));
+
+  gimp_container_foreach (gimp_data_factory_get_container (pk->panel->gimp->font_factory),
+                          (GFunc) picker_collect_name, pk->names);
+
+  g_strfreev (favs);
+  g_strfreev (recents);
+
+  pk->next    = 0;
+  pk->idle_id = g_idle_add ((GSourceFunc) picker_fill_idle, pk);
+}
+
+static gboolean
+picker_filter (GtkListBoxRow *row, Picker *pk)
+{
+  const gchar *name   = g_object_get_data (G_OBJECT (row), "font");
+  const gchar *badge  = g_object_get_data (G_OBJECT (row), "badge");
+  const gchar *search = gtk_entry_get_text (GTK_ENTRY (pk->search));
+  gint         filter = gtk_combo_box_get_active (GTK_COMBO_BOX (pk->filter));
+  gint         cat    = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (row), "category"));
+  gboolean     fav    = badge && ! strcmp (badge, "★ ");
+  gboolean     recent = badge && *badge && ! fav;
+
+  /*  favourites and recents are listed once more among all the fonts:
+   *  show the copies only with no filter and no search
+   */
+  if (search && *search)
+    {
+      gchar *a = g_utf8_casefold (name, -1);
+      gchar *b = g_utf8_casefold (search, -1);
+      gboolean found = strstr (a, b) != NULL;
+
+      g_free (a);
+      g_free (b);
+
+      if (! found || fav || recent)
+        return FALSE;
+    }
+
+  switch (filter)
+    {
+    case FILTER_FAVORITES: return fav;
+    case FILTER_RECENT:    return recent;
+    case FILTER_ALL:       return TRUE;
+    default:               return ! fav && ! recent && cat == filter;
+    }
+}
+
+static void
+picker_refilter (Picker *pk)
+{
+  gtk_list_box_invalidate_filter (GTK_LIST_BOX (pk->list));
+}
+
+static void
+picker_sample_changed (Picker *pk)
+{
+  GList *rows = gtk_container_get_children (GTK_CONTAINER (pk->list));
+  GList *iter;
+
+  for (iter = rows; iter; iter = iter->next)
+    picker_row_markup (pk, iter->data);
+
+  g_list_free (rows);
+}
+
+/*  live preview of the font under the pointer, or selected with the keys  */
+static void
+picker_preview_row (Picker *pk, GtkListBoxRow *row)
+{
+  if ((GtkWidget *) row == pk->hover_row)
+    return;
+
+  pk->hover_row = (GtkWidget *) row;
+
+  if (row)
+    font_preview_name (pk->panel, g_object_get_data (G_OBJECT (row), "font"));
+}
+
+static gboolean
+picker_motion (GtkWidget *list, GdkEventMotion *event, Picker *pk)
+{
+  picker_preview_row (pk, gtk_list_box_get_row_at_y (GTK_LIST_BOX (list), (gint) event->y));
+  return FALSE;
+}
+
+static gboolean
+picker_leave (GtkWidget *list, GdkEventCrossing *event, Picker *pk)
+{
+  if (! pk->chosen)
+    font_preview_restore (pk->panel);
+  pk->hover_row = NULL;
+  return FALSE;
+}
+
+static void
+picker_row_selected (GtkListBox *list, GtkListBoxRow *row, Picker *pk)
+{
+  picker_preview_row (pk, row);
+}
+
+static void
+picker_row_activated (GtkListBox *list, GtkListBoxRow *row, Picker *pk)
+{
+  const gchar *name = g_object_get_data (G_OBJECT (row), "font");
+
+  pk->chosen = TRUE;
+  font_preview_restore (pk->panel);
+
+  if (pk->panel->font)
+    {
+      pk->panel->updating = TRUE;
+      gtk_entry_set_text (GTK_ENTRY (pk->panel->font), name);
+      pk->panel->updating = FALSE;
+    }
+
+  font_apply (pk->panel, name);
+  favorite_update (pk->panel);
+
+  if (pk->popover)
+    gtk_popover_popdown (GTK_POPOVER (pk->popover));
+
+  pk->chosen = FALSE;
+}
+
+static void
+picker_free (Picker *pk)
+{
+  if (pk->idle_id)
+    g_source_remove (pk->idle_id);
+  if (pk->names)
+    g_ptr_array_unref (pk->names);
+  if (pk->own_panel)
+    panel_free (pk->panel);
+  g_free (pk);
+}
+
+static GtkWidget *
+picker_new (Panel *panel, gboolean own_panel)
+{
+  Picker    *pk     = g_new0 (Picker, 1);
+  GtkWidget *scroll = gtk_scrolled_window_new (NULL, NULL);
+  GtkWidget *row    = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gchar     *sample;
+  const gchar *filters[] = { N_("Toutes les polices"), N_("★ Favorites"), N_("Récentes"),
+                             N_("Avec empattement"), N_("Sans empattement"),
+                             N_("Manuscrites"), N_("Chasse fixe"), NULL };
+  gint       i;
+
+  pk->panel     = panel;
+  pk->own_panel = own_panel;
+  pk->box       = gtk_box_new (GTK_ORIENTATION_VERTICAL, 4);
+  gtk_container_set_border_width (GTK_CONTAINER (pk->box), 4);
+
+  pk->search = gtk_search_entry_new ();
+  gtk_entry_set_placeholder_text (GTK_ENTRY (pk->search), _("Rechercher une police"));
+  pk->filter = gtk_combo_box_text_new ();
+  for (i = 0; filters[i]; i++)
+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (pk->filter), _(filters[i]));
+  gtk_combo_box_set_active (GTK_COMBO_BOX (pk->filter), 0);
+  gtk_box_pack_start (GTK_BOX (row), pk->search, TRUE, TRUE, 0);
+  gtk_box_pack_start (GTK_BOX (row), pk->filter, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (pk->box), row, FALSE, FALSE, 0);
+
+  pk->sample = gtk_entry_new ();
+  sample = picker_sample_text (pk);
+  gtk_entry_set_text (GTK_ENTRY (pk->sample), sample);
+  g_free (sample);
+  gtk_widget_set_tooltip_text (pk->sample, _("Texte de l'aperçu"));
+  gtk_box_pack_start (GTK_BOX (pk->box), pk->sample, FALSE, FALSE, 0);
+
+  pk->list = gtk_list_box_new ();
+  gtk_list_box_set_activate_on_single_click (GTK_LIST_BOX (pk->list), TRUE);
+  gtk_list_box_set_filter_func (GTK_LIST_BOX (pk->list),
+                                (GtkListBoxFilterFunc) picker_filter, pk, NULL);
+  gtk_widget_add_events (pk->list, GDK_POINTER_MOTION_MASK | GDK_LEAVE_NOTIFY_MASK);
+  g_signal_connect (pk->list, "motion-notify-event", G_CALLBACK (picker_motion), pk);
+  g_signal_connect (pk->list, "leave-notify-event",  G_CALLBACK (picker_leave), pk);
+  g_signal_connect (pk->list, "row-selected",  G_CALLBACK (picker_row_selected), pk);
+  g_signal_connect (pk->list, "row-activated", G_CALLBACK (picker_row_activated), pk);
+
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scroll),
+                                  GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_container_add (GTK_CONTAINER (scroll), pk->list);
+  gtk_box_pack_start (GTK_BOX (pk->box), scroll, TRUE, TRUE, 0);
+
+  g_signal_connect_swapped (pk->search, "search-changed", G_CALLBACK (picker_refilter), pk);
+  g_signal_connect_swapped (pk->filter, "changed",        G_CALLBACK (picker_refilter), pk);
+  g_signal_connect_swapped (pk->sample, "changed",        G_CALLBACK (picker_sample_changed), pk);
+
+  g_object_set_data_full (G_OBJECT (pk->box), "chopgimp-picker", pk,
+                          (GDestroyNotify) picker_free);
+
+  picker_fill (pk);
+  gtk_widget_show_all (pk->box);
+
+  return pk->box;
+}
+
+static void
+picker_popover_closed (GtkPopover *popover, Panel *panel)
+{
+  font_preview_restore (panel);
+  gtk_widget_destroy (GTK_WIDGET (popover));
+}
+
+static void
+font_menu_clicked (GtkButton *button, Panel *panel)
+{
+  /*  every font with its preview (Photoshop's font menu)  */
+  GtkWidget *popover = gtk_popover_new (GTK_WIDGET (button));
+  GtkWidget *picker  = picker_new (panel, FALSE);
+  Picker    *pk      = g_object_get_data (G_OBJECT (picker), "chopgimp-picker");
+
+  pk->popover = popover;
+  gtk_widget_set_size_request (picker, 380, 460);
+  gtk_container_add (GTK_CONTAINER (popover), picker);
+  g_signal_connect (popover, "closed", G_CALLBACK (picker_popover_closed), panel);
+  gtk_popover_popup (GTK_POPOVER (popover));
+  gtk_widget_grab_focus (pk->search);
+}
+
+
+static void
+size_changed (GtkSpinButton *spin, Panel *panel)
+{
+  Target t;
+
+  if (panel->updating || ! target_begin (panel, &t))
+    return;
+
+  {
+    /*  the panel shows pixels, the size tags are in points  */
+    gdouble xres, yres;
+
+    gimp_image_get_resolution (gimp_item_get_image (GIMP_ITEM (t.layer)), &xres, &yres);
+    gimp_text_buffer_set_size (t.buffer, &t.start, &t.end,
+                               PANGO_SCALE * gimp_units_to_points (gtk_spin_button_get_value (spin),
+                                                                   gimp_unit_pixel (), yres));
+  }
+  target_end (&t, _("Taille du texte"));
+}
+
+static void
+kerning_changed (GtkSpinButton *spin, Panel *panel)
+{
+  Target t;
+
+  if (panel->updating || ! target_begin (panel, &t))
+    return;
+
