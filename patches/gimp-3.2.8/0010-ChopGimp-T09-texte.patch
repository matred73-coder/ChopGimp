+/*  ChopGimp: misspelled words underlined in red (layout coordinates
+ *  → image coordinates as for the selection).
+ */
+static gboolean
+chopgimp_text_tool_has_fx (GimpTextTool *text_tool)
+{
+  return chopgimp_text_fx_moves_glyphs (text_tool->layer->text->chopgimp_fx);
+}
+
+static void
+chopgimp_text_tool_draw_spelling (GimpDrawTool *draw_tool)
+{
+  GimpTextTool     *text_tool = GIMP_TEXT_TOOL (draw_tool);
+  GimpDisplayShell *shell;
+  PangoLayout      *layout;
+  const gchar      *text;
+  GArray           *bad;
+  GtkTextIter       cursor;
+  gint              cursor_index;
+  gint              offset_x, offset_y, off_x, off_y;
+  gdouble           step, amp;
+  gint              i;
+  GimpTextDirection direction = gimp_text_tool_get_direction (text_tool);
+
+  if (! GIMP_TOOL (draw_tool)->display || ! text_tool->layout ||
+      (direction != GIMP_TEXT_DIRECTION_LTR && direction != GIMP_TEXT_DIRECTION_RTL) ||
+      chopgimp_text_tool_has_fx (text_tool))
+    return;
+
+  layout = gimp_text_layout_get_pango_layout (text_tool->layout);
+  text   = pango_layout_get_text (layout);
+  bad    = chopgimp_spell_misspelled (text, text_tool->layer->text->language);
+
+  if (! bad)
+    return;
+
+  shell = gimp_display_get_shell (GIMP_TOOL (draw_tool)->display);
+  step  = 3.0 / MAX (shell->scale_x, 1e-6);
+  amp   = 1.2 / MAX (shell->scale_y, 1e-6);
+
+  gtk_text_buffer_get_iter_at_mark (GTK_TEXT_BUFFER (text_tool->buffer), &cursor,
+                                    gtk_text_buffer_get_insert (GTK_TEXT_BUFFER (text_tool->buffer)));
+  cursor_index = gimp_text_buffer_get_iter_index (text_tool->buffer, &cursor, TRUE);
+
+  gimp_text_layout_get_offsets (text_tool->layout, &offset_x, &offset_y);
+  chopgimp_text_fx_get_anchor (text_tool->layer, &off_x, &off_y);
+
+  for (i = 0; i + 1 < bad->len; i += 2)
+    {
+      gint            s = g_array_index (bad, gint, i);
+      gint            e = g_array_index (bad, gint, i + 1);
+      PangoRectangle  a, b;
+      gdouble         x1, x2, y, x;
+      GimpVector2    *pts;
+      gint            n = 0, max;
+      GimpCanvasItem *item;
+      GeglColor      *red;
+
+      /*  the word being typed is not marked  */
+      if (cursor_index >= s && cursor_index <= e)
+        continue;
+
+      pango_layout_index_to_pos (layout, s, &a);
+      pango_layout_index_to_pos (layout,
+                                 g_utf8_prev_char (text + e) - text, &b);
+
+      if (a.y != b.y)
+        continue;
+
+      x1 = (gdouble) MIN (a.x, b.x + b.width) / PANGO_SCALE;
+      x2 = (gdouble) MAX (a.x, b.x + b.width) / PANGO_SCALE;
+      y  = (gdouble) (a.y + a.height) / PANGO_SCALE - amp;
+
+      max = (gint) ((x2 - x1) / step) + 3;
+      pts = g_new (GimpVector2, max);
+
+      for (x = x1; x <= x2 && n < max; x += step, n++)
+        {
+          gdouble px = x, py = y + ((n % 2) ? -amp : amp) * 0.5;
+
+          gimp_text_layout_transform_point (text_tool->layout, &px, &py);
+          pts[n].x = px + offset_x + off_x;
+          pts[n].y = py + offset_y + off_y;
+        }
+
+      if (n > 1)
+        {
+          item = gimp_draw_tool_add_pen (draw_tool, pts, n,
