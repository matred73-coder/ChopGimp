+        gtk_box_pack_start (GTK_BOX (box), row, FALSE, FALSE, 0);
+      }
+    }
+  else
+    {
+      static const struct { gint justify; const gchar *last; const gchar *icon; const gchar *tip; } aligns[] =
+      {
+        { GIMP_TEXT_JUSTIFY_LEFT,   NULL,          "format-justify-left",   N_("Aligner à gauche") },
+        { GIMP_TEXT_JUSTIFY_CENTER, NULL,          "format-justify-center", N_("Centrer") },
+        { GIMP_TEXT_JUSTIFY_RIGHT,  NULL,          "format-justify-right",  N_("Aligner à droite") },
+        { GIMP_TEXT_JUSTIFY_FILL,   NULL,          "format-justify-fill",   N_("Justifier, dernière ligne à gauche") },
+        { GIMP_TEXT_JUSTIFY_FILL,   "last=center", "format-justify-fill",   N_("Justifier, dernière ligne centrée") },
+        { GIMP_TEXT_JUSTIFY_FILL,   "last=right",  "format-justify-fill",   N_("Justifier, dernière ligne à droite") },
+        { GIMP_TEXT_JUSTIFY_FILL,   "last=all",    "format-justify-fill",   N_("Tout justifier") },
+      };
+      static const gchar *marks[] = { NULL, NULL, NULL, "◧", "◫", "◨", "■" };
+      GtkWidget *row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 2);
+
+      for (guint i = 0; i < G_N_ELEMENTS (aligns); i++)
+        {
+          GtkWidget *b = marks[i] ? gtk_button_new_with_label (marks[i]) :
+                         gtk_button_new_from_icon_name (aligns[i].icon, GTK_ICON_SIZE_BUTTON);
+
+          gtk_widget_set_tooltip_text (b, _(aligns[i].tip));
+          gtk_widget_set_hexpand (b, TRUE);
+          g_object_set_data (G_OBJECT (b), "justify", GINT_TO_POINTER (aligns[i].justify));
+          g_object_set_data (G_OBJECT (b), "last", (gpointer) aligns[i].last);
+          g_signal_connect (b, "clicked", G_CALLBACK (justify_clicked), panel);
+          gtk_box_pack_start (GTK_BOX (row), b, TRUE, TRUE, 0);
+        }
+      gtk_grid_attach (GTK_GRID (grid), row, 0, 0, 2, 1);
+
+      panel->indent = spin_new (panel, -1000, 1000, 1, 1, G_CALLBACK (indent_changed));
+      grid_row (grid, 1, 0, "→≡", _("Retrait de première ligne (px)"), panel->indent);
+
+      panel->box_mode = gtk_check_button_new_with_label (_("Texte de paragraphe (cadre fixe)"));
+      g_signal_connect (panel->box_mode, "toggled", G_CALLBACK (box_mode_toggled), panel);
+      gtk_grid_attach (GTK_GRID (grid), panel->box_mode, 0, 2, 2, 1);
+
+      panel->hyphens = gtk_check_button_new_with_label (_("Césure"));
+      gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (panel->hyphens), TRUE);
+      g_signal_connect (panel->hyphens, "toggled", G_CALLBACK (hyphens_toggled), panel);
+      gtk_grid_attach (GTK_GRID (grid), panel->hyphens, 0, 3, 2, 1);
+
+      {
+        GtkWidget *quotes = gtk_check_button_new_with_label (_("Guillemets typographiques (« » ’)"));
+        GtkWidget *spell  = gtk_check_button_new_with_label (_("Vérifier l'orthographe pendant la saisie"));
+
+        gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (quotes),
