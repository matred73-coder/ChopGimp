+static gboolean
+panel_refresh (Panel *panel)
+{
+  GimpTextLayer *layer;
+  GimpText      *text;
+  gchar         *stamp;
+  gdouble        xres = 72.0, yres = 72.0;
+  gdouble        rgba[4] = { 0.0, 0.0, 0.0, 0.0 };
+  gdouble        a, b, d;
+
+  /*  hidden (another tab of the dock, closed…): nothing to show  */
+  if (panel->widget && ! gtk_widget_get_mapped (panel->widget))
+    return G_SOURCE_CONTINUE;
+
+  layer = panel_layer (panel);
+
+  if (! layer || ! (text = gimp_text_layer_get_text (layer)))
+    {
+      panel->shown_layer = NULL;
+      return G_SOURCE_CONTINUE;
+    }
+
+  if (text->color)
+    gegl_color_get_rgba (text->color, &rgba[0], &rgba[1], &rgba[2], &rgba[3]);
+
+  /*  refresh when the layer or its settings changed (undo, tool options…)  */
+  stamp = g_strdup_printf ("%p %p %s %g %p %g %g %g %g %g %g %g %g %d %d %d "
+                           "%g %g %g %g",
+                           (void *) layer, (void *) text,
+                           text->font ? gimp_object_get_name (text->font) : "",
+                           text->font_size, (void *) text->unit,
+                           text->line_spacing, text->letter_spacing,
+                           text->transformation.coeff[0][0],
+                           text->transformation.coeff[0][1],
+                           text->transformation.coeff[1][0],
+                           text->transformation.coeff[1][1],
+                           text->indent, text->outline_width,
+                           text->box_mode, text->justify, text->outline,
+                           rgba[0], rgba[1], rgba[2], rgba[3]);
+
+  if (layer == panel->shown_layer && ! g_strcmp0 (stamp, panel->shown_stamp))
+    {
+      g_free (stamp);
+      return G_SOURCE_CONTINUE;
+    }
+
+  g_free (panel->shown_stamp);
+  panel->shown_stamp = stamp;
+  panel->shown_layer = layer;
+
+  if (gimp_item_get_image (GIMP_ITEM (layer)))
+    gimp_image_get_resolution (gimp_item_get_image (GIMP_ITEM (layer)), &xres, &yres);
+
+  panel->updating = TRUE;
+
+  if (panel->font && text->font)
+    gtk_entry_set_text (GTK_ENTRY (panel->font), gimp_object_get_name (text->font));
+  favorite_update (panel);
+
+  /*  the field is in pixels, whatever the unit of the layer  */
+  spin_set (panel->size,     gimp_units_to_pixels (text->font_size, text->unit, yres));
+  spin_set (panel->leading,  text->line_spacing);
+  spin_set (panel->tracking, text->letter_spacing);
+  /*  the scales of the text, whatever its rotation and slant  */
+  if (! matrix_decompose (&text->transformation, &a, &b, &d))
+    a = d = 1.0;
+  spin_set (panel->hscale,   a * 100.0);
+  spin_set (panel->vscale,   fabs (d) * 100.0);
+  spin_set (panel->indent,   text->indent);
+
+  if (panel->color && text->color)
+    gimp_color_button_set_color (GIMP_COLOR_BUTTON (panel->color), text->color);
+
+  if (panel->box_mode)
+    gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (panel->box_mode),
+                                  text->box_mode == GIMP_TEXT_BOX_FIXED);
+
+  panel->updating = FALSE;
+
+  return G_SOURCE_CONTINUE;
+}
