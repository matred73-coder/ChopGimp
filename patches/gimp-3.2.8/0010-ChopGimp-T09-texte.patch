+                                            GimpTextLayer  *layer,
+                                            gint           *x,
+                                            gint           *y);
+void             chopgimp_text_fx_placed   (ChopGimpTextFx *fx,
+                                            GimpTextLayer  *layer);
+void             chopgimp_text_fx_draw     (ChopGimpTextFx *fx,
+                                            cairo_t        *cr,
+                                            GimpTextLayout *layout);
+void             chopgimp_text_fx_free     (ChopGimpTextFx *fx);
+
+void             chopgimp_text_fx_get_anchor (GimpTextLayer *layer,
+                                              gint          *x,
+                                              gint          *y);
+
+GimpPath       * chopgimp_text_fx_find_path  (GimpImage     *image,
+                                              GimpTattoo     tattoo);
+
+gchar          * chopgimp_text_fx_path_name    (GimpPath      *path);
+void             chopgimp_text_fx_sync_mask    (GimpTextLayer *layer);
+void             chopgimp_text_fx_reset_anchor (GimpTextLayer *layer);
+gboolean         chopgimp_text_fx_moves_glyphs (const gchar   *spec);
+gdouble          chopgimp_text_fx_padding      (GimpText      *text);
+
+/*  helpers for the user interface  */
+gchar          * chopgimp_text_fx_get_value (const gchar   *spec,
+                                             const gchar   *key);
+
+/*  a pattern as a cairo surface (in gimptextlayer.c)  */
+cairo_surface_t * chopgimp_text_layer_pattern_surface (GimpPattern *pattern);
