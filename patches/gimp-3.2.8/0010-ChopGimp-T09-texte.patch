+/*  the text matrix M as R·U: a rotation R, and U = [[a, b], [0, d]] in
+ *  text space; a: horizontal scale, d: vertical scale, b / d: slant
+ */
+static gboolean
+matrix_decompose (const GimpMatrix2 *m,
+                  gdouble           *a,
+                  gdouble           *b,
+                  gdouble           *d)
+{
+  gdouble ux, uy;
+
+  *a = hypot (m->coeff[0][0], m->coeff[1][0]);
+
+  if (*a < 1e-9)
+    {
+      *b = 0.0;
+      *d = 0.0;
+      return FALSE;
+    }
+
+  ux = m->coeff[0][0] / *a;
+  uy = m->coeff[1][0] / *a;
+
+  *b = ux * m->coeff[0][1] + uy * m->coeff[1][1];
+  *d = ux * m->coeff[1][1] - uy * m->coeff[0][1];
+
+  return TRUE;
+}
+
+/*  horizontal / vertical scale and faux italic: the text matrix, changed
+ *  in text space (M' = M · X) so a rotated text stays rotated
+ */
+static void
+matrix_update (Panel *panel, gint which, gdouble value)
+{
+  GimpTextLayer *layer = panel_layer (panel);
+  GimpText      *text;
+  GimpMatrix2    m;
+  gdouble        a, b, d;
+  gint           row;
+
+  if (panel->updating || ! layer || ! (text = gimp_text_layer_get_text (layer)))
+    return;
+
+  m = text->transformation;
+
+  if (! matrix_decompose (&m, &a, &b, &d) || fabs (d) < 1e-9)
+    return;
+
+  if (which == 0)          /* horizontal scale, %: M · diag (r, 1) */
+    {
+      gdouble r = (value / 100.0) / a;
+
+      for (row = 0; row < 2; row++)
+        m.coeff[row][0] *= r;
+    }
+  else if (which == 1)     /* vertical scale, %: M · diag (1, r) */
+    {
+      gdouble r = (value / 100.0) / fabs (d);
+
+      for (row = 0; row < 2; row++)
+        m.coeff[row][1] *= r;
+    }
+  else                     /* faux italic: M · [[1, t], [0, 1]] */
+    {
+      gdouble slant = (fabs (b / d) > 0.01) ? 0.0 : -0.21;
+      gdouble t     = (slant * fabs (d) - b) / a;
+
+      for (row = 0; row < 2; row++)
+        m.coeff[row][1] += t * m.coeff[row][0];
+    }
+
+  gimp_text_layer_set (layer, _("Transformation du texte"), "transformation", &m, NULL);
+  layer_flush (layer);
+}
+
+static void
+hscale_changed (GtkSpinButton *spin, Panel *panel)
+{
+  matrix_update (panel, 0, gtk_spin_button_get_value (spin));
+}
+
+static void
+vscale_changed (GtkSpinButton *spin, Panel *panel)
+{
+  matrix_update (panel, 1, gtk_spin_button_get_value (spin));
+}
