    */
-  if (gimp_editor_get_ui_manager (GIMP_EDITOR (view)))
-    gimp_ui_manager_update (gimp_editor_get_ui_manager (GIMP_EDITOR (view)), view);
+  elapsed = g_get_monotonic_time () - view->priv->last_flush_update;
+
+  if (elapsed >= 0 && elapsed < FLUSH_UPDATE_INTERVAL)
+    {
+      /*  still pending: come back when the interval is over  */
+      g_timeout_add_full (G_PRIORITY_LOW,
+                          (FLUSH_UPDATE_INTERVAL - elapsed) /
+                          G_TIME_SPAN_MILLISECOND + 1,
+                          (GSourceFunc) gimp_item_tree_view_image_flush_idle,
+                          g_object_ref (view), g_object_unref);
+
