@@ -898,6 +953,17 @@ gimp_text_layer_render (GimpTextLayer *layer)
 
   g_object_unref (layout);
 
+  /*  remember what was rendered (set_buffer() above forgot it)  */
+  g_clear_object (&layer->private->rendered_text);
+
+  if (width > 0 && height > 0)
+    {
+      layer->private->rendered_text   = gimp_config_duplicate (GIMP_CONFIG (layer->text));
+      layer->private->rendered_xres   = xres;
+      layer->private->rendered_yres   = yres;
+      layer->private->rendered_format = gimp_drawable_get_format (drawable);
+    }
+
   g_object_thaw_notify (G_OBJECT (drawable));
 
   return (width > 0 && height > 0);
