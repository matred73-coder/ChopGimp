+/*  how far from a pixel the outline can be and still affect it: the
+ *  stroke's reach on both sides of the path, whatever the position.
+ *  Solid strokes are local: a region of the output only depends on the
+ *  input's alpha in that region grown by this margin. The outline found
+ *  on such a crop has extra edges along the crop's border, more than the
+ *  stroke's reach away from the region, so they don't touch it.
+ */
+static gint
+gimp_operation_contour_get_margin (GimpOperationContour *self)
+{
+  gdouble half;
+
+  if (self->position == GIMP_CONTOUR_POSITION_CENTER)
+    half = self->width / 2.0;
+  else
+    half = self->width;
+
+  return (gint) ceil (half * G_SQRT2) + 3;
