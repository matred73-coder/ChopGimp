+      /*  ChopGimp: grow geometrically, very detailed masks (complex
+       *  alpha, Ctrl+click on a layer) produce hundreds of thousands
+       *  of segments and a linear growth made the copies quadratic
+       */
+      boundary->max_segs += MAX (MAX_SEGS_INC, boundary->max_segs / 2);
 
       boundary->segs = g_renew (GimpBoundSeg, boundary->segs, boundary->max_segs);
     }
@@ -642,9 +649,34 @@ make_horiz_segs (GimpBoundary *boundary,
 {
   gint empty_index;
   gint e_s, e_e;    /* empty segment start and end values */
+  gint lo, hi;
+
+  /*  ChopGimp: the empty segments are sorted and disjoint, so skip
+   *  (binary search) the ones ending at or before @start, and stop at
+   *  the first one starting at or after @end: neither can produce a
+   *  segment. The output is unchanged, but rows with thousands of runs
+   *  (detailed alpha) no longer cost runs × runs.
+   */
+  lo = 0;
+  hi = num_empty / 2;
+
+  while (lo < hi)
+    {
+      gint mid = (lo + hi) / 2;
 
-  for (empty_index = 0; empty_index < num_empty; empty_index += 2)
+      if (empty[mid * 2 + 1] <= start)
+        lo = mid + 1;
+      else
+        hi = mid;
+    }
+
+  empty += lo * 2;
+
+  for (empty_index = lo * 2; empty_index < num_empty; empty_index += 2)
     {
+      if (*empty >= end)
+        break;
+
       e_s = *empty++;
       e_e = *empty++;
 
@@ -663,6 +695,34 @@ make_horiz_segs (GimpBoundary *boundary,
     }
 }
 
+/*  returns row @y of @buffer (columns 0 to line_rect->width), fetching
+ *  BOUNDARY_BLOCK_ROWS rows at once into @block
+ */
+static const gfloat *
+boundary_get_line (GeglBuffer    *buffer,
+                   const Babl    *format,
+                   GeglRectangle *line_rect,
+                   gint           y,
+                   gfloat        *block,
+                   gint          *block_y)
+{
+  if (y < *block_y || y >= *block_y + BOUNDARY_BLOCK_ROWS)
+    {
+      GeglRectangle rect = *line_rect;
+
+      rect.y      = y;
+      rect.height = BOUNDARY_BLOCK_ROWS;
+
+      gegl_buffer_get (buffer, &rect, 1.0, format,
+                       block, GEGL_AUTO_ROWSTRIDE,
+                       GEGL_ABYSS_NONE);
+
+      *block_y = y;
+    }
+
+  return block + (gsize) (y - *block_y) * line_rect->width;
+}
