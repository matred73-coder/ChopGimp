+
+  /*  flushes from now on need a new update  */
+  g_atomic_int_set (&view->priv->flush_pending, 0);
+
+  if (gtk_widget_is_drawable (GTK_WIDGET (view)))
+    gimp_item_tree_view_flush_update (view);
+  else
+    view->priv->flush_on_map = TRUE;
 
