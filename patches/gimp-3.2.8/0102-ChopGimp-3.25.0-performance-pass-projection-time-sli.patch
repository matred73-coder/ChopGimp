+
+/*  dragging on the canvas moves an offset (GIMP_CONTROLLER_TYPE_OFFSET)  */
+
+static void
+offset_controller_callback (OffsetController *ctl,
+                            GeglRectangle    *area,
+                            gdouble           x,
+                            gdouble           y)
+{
+  const gchar *x_prop = NULL;
+  const gchar *y_prop = NULL;
+
+  ctl->area = *area;
+
+  ctl->get_props (ctl->config, &x_prop, &y_prop);
+
+  if (x_prop && y_prop)
+    g_object_set (ctl->config,
+                  x_prop, x,
+                  y_prop, y,
+                  NULL);
+}
+
+static void
+offset_controller_config_notify (GObject          *config,
+                                 const GParamSpec *pspec,
+                                 OffsetController *ctl)
+{
+  GimpControllerOffsetCallback  set_func;
+  const gchar                  *x_prop = NULL;
+  const gchar                  *y_prop = NULL;
+  gdouble                       x;
+  gdouble                       y;
+
+  ctl->get_props (config, &x_prop, &y_prop);
+
+  if (! x_prop || ! y_prop)
+    return;
+
+  g_object_get (config,
+                x_prop, &x,
+                y_prop, &y,
+                NULL);
+
+  set_func = (GimpControllerOffsetCallback) ctl->set_func;
+
+  set_func (ctl->set_data, &ctl->area, x, y);
+}
+
+static void
+offset_controller_free (OffsetController *ctl)
+{
+  g_slice_free (OffsetController, ctl);
+}
+
+static void
+layer_style_add_offset_controller (GObject                  *config,
+                                   GeglRectangle            *area,
+                                   OffsetPropsFunc           get_props,
+                                   const gchar              *status_title,
+                                   GimpCreateControllerFunc  create_controller_func,
+                                   gpointer                  creator)
+{
+  OffsetController *ctl;
+  OffsetController *old;
+
+  if (! create_controller_func)
+    return;
+
+  /*  a previous dialog on the same config  */
+  old = g_object_get_data (config, OFFSET_KEY);
+
+  if (old)
+    g_signal_handlers_disconnect_by_data (config, old);
+
+  ctl = g_slice_new0 (OffsetController);
+
+  ctl->config    = config;
+  ctl->get_props = get_props;
+
+  if (area)
+    ctl->area = *area;
+
+  ctl->set_func = create_controller_func (creator,
+                                          GIMP_CONTROLLER_TYPE_OFFSET,
+                                          status_title,
+                                          (GCallback) offset_controller_callback,
+                                          ctl,
+                                          &ctl->set_data);
+
+  g_object_set_data_full (config, OFFSET_KEY, ctl,
+                          (GDestroyNotify) offset_controller_free);
+
+  if (! ctl->set_func)
+    return;
+
+  offset_controller_config_notify (config, NULL, ctl);
+
+  g_signal_connect (config, "notify",
+                    G_CALLBACK (offset_controller_config_notify),
+                    ctl);
+}
+
+static void
+stroke_offset_props (GObject      *config,
+                     const gchar **x_prop,
+                     const gchar **y_prop)
+{
+  gint fill_type;
+
+  g_object_get (config, "fill-type", &fill_type, NULL);
+
+  /*  GimpContourFillType: color, gradient, pattern  */
+  switch (fill_type)
+    {
+    case 1:
+      *x_prop = "gradient-offset-x";
+      *y_prop = "gradient-offset-y";
+      break;
+
+    case 2:
+      *x_prop = "pattern-offset-x";
+      *y_prop = "pattern-offset-y";
+      break;
+
+    default:
+      break;
+    }
+}
+
+static void
+xy_offset_props (GObject      *config,
+                 const gchar **x_prop,
+                 const gchar **y_prop)
+{
+  *x_prop = "x";
+  *y_prop = "y";
+}
