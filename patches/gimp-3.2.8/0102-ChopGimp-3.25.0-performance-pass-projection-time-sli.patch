+}
+
+static gint
+gimp_tool_drag_button_press (GimpToolWidget      *widget,
+                             const GimpCoords    *coords,
+                             guint32              time,
+                             GdkModifierType      state,
+                             GimpButtonPressType  press_type)
+{
+  GimpToolDrag *drag = GIMP_TOOL_DRAG (widget);
+
+  if (press_type != GIMP_BUTTON_PRESS_NORMAL)
+    return 0;
+
+  drag->dragging = TRUE;
+  drag->start_x  = drag->x;
+  drag->start_y  = drag->y;
+  drag->press_x  = coords->x;
+  drag->press_y  = coords->y;
+
+  return 1;
+}
+
+static void
+gimp_tool_drag_button_release (GimpToolWidget        *widget,
+                               const GimpCoords      *coords,
+                               guint32                time,
+                               GdkModifierType        state,
+                               GimpButtonReleaseType  release_type)
+{
+  GimpToolDrag *drag = GIMP_TOOL_DRAG (widget);
+
+  drag->dragging = FALSE;
+
+  if (release_type == GIMP_BUTTON_RELEASE_CANCEL)
+    {
+      drag->x = drag->start_x;
+      drag->y = drag->start_y;
+
+      gimp_tool_widget_changed (widget);
+    }
+
+  gimp_tool_widget_set_status (widget, NULL);
+}
+
+static void
+gimp_tool_drag_motion (GimpToolWidget   *widget,
+                       const GimpCoords *coords,
+                       guint32           time,
+                       GdkModifierType   state)
+{
+  GimpToolDrag *drag = GIMP_TOOL_DRAG (widget);
+  gdouble       dx;
+  gdouble       dy;
+
+  if (! drag->dragging)
+    return;
+
+  dx = coords->x - drag->press_x;
+  dy = coords->y - drag->press_y;
+
+  /*  Shift constrains the move to an axis, as moving a layer  */
+  if (state & GDK_SHIFT_MASK)
+    {
+      if (fabs (dx) > fabs (dy))
+        dy = 0.0;
+      else
+        dx = 0.0;
+    }
+
+  drag->x = RINT (drag->start_x + dx);
+  drag->y = RINT (drag->start_y + dy);
+
+  gimp_tool_widget_set_status_coords (widget, "Décalage : ",
+                                      drag->x, ", ", drag->y, NULL);
+
+  gimp_tool_widget_changed (widget);
+}
+
+static GimpHit
+gimp_tool_drag_hit (GimpToolWidget   *widget,
+                    const GimpCoords *coords,
+                    GdkModifierType   state,
+                    gboolean          proximity)
+{
+  return GIMP_HIT_DIRECT;
+}
+
+static void
+gimp_tool_drag_hover (GimpToolWidget   *widget,
+                      const GimpCoords *coords,
+                      GdkModifierType   state,
+                      gboolean          proximity)
+{
+  if (proximity)
+    gimp_tool_widget_set_status (widget,
+                                 "Faites glisser sur l'image pour déplacer l'effet");
+  else
+    gimp_tool_widget_set_status (widget, NULL);
+}
+
+static gboolean
+gimp_tool_drag_get_cursor (GimpToolWidget     *widget,
+                           const GimpCoords   *coords,
+                           GdkModifierType     state,
+                           GimpCursorType     *cursor,
+                           GimpToolCursorType *tool_cursor,
+                           GimpCursorModifier *modifier)
+{
+  *cursor      = GIMP_CURSOR_MOUSE;
+  *tool_cursor = GIMP_TOOL_CURSOR_MOVE;
+  *modifier    = GIMP_CURSOR_MODIFIER_MOVE;
+
+  return TRUE;
+}
