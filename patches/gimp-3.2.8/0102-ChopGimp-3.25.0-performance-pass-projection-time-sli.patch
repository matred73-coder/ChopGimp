+/*  ChopGimp: drop the segments which cannot change the stroke: the ones
+ *  outside the area being drawn (zoomed in on a huge boundary), and the
+ *  exact repeats of a recently kept segment (zoomed out, many boundary
+ *  segments fall on the same screen pixel). The stroke of the remaining
+ *  path covers exactly the same pixels.
+ */
+#define SIMPLIFY_MIN_SEGS  1024
+#define SIMPLIFY_RECENT    16
+
+static gint
+gimp_canvas_boundary_simplify (cairo_t     *cr,
+                               GimpSegment *segs,
+                               gint         n_segs)
+{
+  GimpSegment recent[SIMPLIFY_RECENT];
+  gint        n_recent = 0;
+  gint        next     = 0;
+  gdouble     cx1, cy1, cx2, cy2;
+  gint        n        = 0;
+  gint        i;
+
+  cairo_clip_extents (cr, &cx1, &cy1, &cx2, &cy2);
+
+  /*  room for the widest stroke and the square caps  */
+  cx1 -= 4.0;
+  cy1 -= 4.0;
+  cx2 += 4.0;
+  cy2 += 4.0;
+
+  for (i = 0; i < n_segs; i++)
+    {
+      const GimpSegment *seg = &segs[i];
+      gboolean           dup = FALSE;
+      gint               j;
+
+      if (MAX (seg->x1, seg->x2) < cx1 || MIN (seg->x1, seg->x2) > cx2 ||
+          MAX (seg->y1, seg->y2) < cy1 || MIN (seg->y1, seg->y2) > cy2)
+        continue;
+
+      if (ABS (seg->x2 - seg->x1) <= 1 && ABS (seg->y2 - seg->y1) <= 1)
+        {
+          for (j = 0; j < n_recent && ! dup; j++)
+            dup = (recent[j].x1 == seg->x1 && recent[j].y1 == seg->y1 &&
+                   recent[j].x2 == seg->x2 && recent[j].y2 == seg->y2);
+
+          if (dup)
+            continue;
+
+          recent[next] = *seg;
+          next = (next + 1) % SIMPLIFY_RECENT;
+          n_recent = MIN (n_recent + 1, SIMPLIFY_RECENT);
+        }
+
+      segs[n++] = *seg;
+    }
+
+  return n;
+}
