+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <string.h>
+
+
+/*  starting ("factory") settings of each style, Photoshop's blend modes:
+ *  multiply for the inner shadow, screen for the inner glow (GIMP's
+ *  filter blend mode, which blends the glow with the layer's pixels)
+ */
+
+#define CHOPGIMP_LAYER_STYLE_DROP_SHADOW \
+  "gegl:dropshadow"
+
+#define CHOPGIMP_LAYER_STYLE_OUTER_GLOW \
+  "gegl:dropshadow\n" \
+  "(x 0.0)(y 0.0)(radius 18.0)(grow-shape circle)(grow-radius 2.0)" \
+  "(color (color-rgba 1.0 0.93 0.6 1.0))(opacity 1.0)"
+
+/*  gegl:inner-glow only renders the glow: GIMP's blend mode (multiply,
+ *  screen) puts it on the layer, instead of "replace" which made the
+ *  inside of the layer transparent
+ */
+#define CHOPGIMP_LAYER_STYLE_INNER_SHADOW \
+  "gegl:inner-glow\n" \
+  "(x 4.0)(y 4.0)(radius 8.0)(grow-radius 2.0)" \
+  "(value (color-rgba 0.0 0.0 0.0 1.0))(opacity 0.75)(gimp-mode multiply)"
+
+#define CHOPGIMP_LAYER_STYLE_INNER_GLOW \
+  "gegl:inner-glow\n" \
+  "(x 0.0)(y 0.0)(radius 10.0)(grow-radius 0.0)" \
+  "(value (color-rgba 1.0 1.0 0.75 1.0))(opacity 0.75)(gimp-mode screen)"
+
+/*  app/operations/gimpoperationcontour.c: its defaults are the style's  */
+#define CHOPGIMP_LAYER_STYLE_STROKE \
+  "chopgimp:stroke"
+
+#define CHOPGIMP_LAYER_STYLE_BEVEL \
+  "gegl:bevel"
+
+
+/*  name of the preset holding the user's defaults of a style  */
+#define CHOPGIMP_LAYER_STYLE_DEFAULT_NAME "Par défaut (%s)"
+
+
+typedef struct
+{
+  const gchar *action;     /*  the action opening the style's dialog   */
+  const gchar *operation;  /*  its GEGL operation                      */
+  const gchar *label;      /*  its name, as the filter is named        */
+  const gchar *factory;    /*  "operation\n(settings)"                 */
+} ChopGimpLayerStyle;
+
+static const ChopGimpLayerStyle chopgimp_layer_styles[] =
+{
+  { "filters-dropshadow",            "gegl:dropshadow", "Ombre portée",
+    CHOPGIMP_LAYER_STYLE_DROP_SHADOW  },
+  { "filters-chopgimp-outer-glow",   "gegl:dropshadow", "Lueur externe",
+    CHOPGIMP_LAYER_STYLE_OUTER_GLOW   },
+  { "filters-chopgimp-inner-shadow", "gegl:inner-glow", "Ombre interne",
+    CHOPGIMP_LAYER_STYLE_INNER_SHADOW },
+  { "filters-chopgimp-inner-glow",   "gegl:inner-glow", "Lueur interne",
+    CHOPGIMP_LAYER_STYLE_INNER_GLOW   },
+  { "filters-chopgimp-stroke",       "chopgimp:stroke", "Contour",
+    CHOPGIMP_LAYER_STYLE_STROKE       },
+  { NULL,                            "gegl:bevel",      "Biseautage",
+    CHOPGIMP_LAYER_STYLE_BEVEL        }
+};
+
+
+/*  the style of a filter: its operation and its name (the action's
+ *  label, e.g. "Lueur externe..." or "_Ombre portée…"); when the name is
+ *  not a style's, the first style of the operation. NULL if the
+ *  operation is not a layer style.
+ */
+static inline const ChopGimpLayerStyle *
+chopgimp_layer_style_find (const gchar *operation,
+                           const gchar *name)
+{
+  const ChopGimpLayerStyle *first = NULL;
+  gint                      i;
+
+  if (! operation)
+    return NULL;
+
+  for (i = 0; i < G_N_ELEMENTS (chopgimp_layer_styles); i++)
+    {
+      const ChopGimpLayerStyle *style = &chopgimp_layer_styles[i];
+
+      if (strcmp (style->operation, operation))
+        continue;
+
+      if (! first)
+        first = style;
+
+      if (name)
+        {
+          /*  skip the mnemonic underscores of an action's label  */
+          const gchar *n = name;
+          const gchar *l = style->label;
+
+          while (*n && *l)
+            {
+              if (*n == '_')
+                {
+                  n++;
+                  continue;
+                }
+
+              if (*n != *l)
+                break;
+
+              n++;
+              l++;
+            }
+
+          if (! *l)
+            return style;
+        }
+    }
+
+  return first;
+}
+
+static inline const ChopGimpLayerStyle *
+chopgimp_layer_style_find_by_action (const gchar *action)
+{
+  gint i;
+
+  if (! action)
+    return NULL;
+
+  for (i = 0; i < G_N_ELEMENTS (chopgimp_layer_styles); i++)
+    if (chopgimp_layer_styles[i].action &&
+        ! strcmp (chopgimp_layer_styles[i].action, action))
+      return &chopgimp_layer_styles[i];
+
+  return NULL;
+}
