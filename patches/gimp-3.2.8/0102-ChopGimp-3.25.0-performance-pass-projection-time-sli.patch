   GeglRectangle  line_rect = { 0, };
-  gfloat        *line_data;
+  const gfloat  *line_data;
   gint           scanline;
   gint           i;
   gint           start, end;
   gint          *tmp_segs;
+  gfloat        *block;
+  gint           block_y     = G_MININT;
 
   gint          num_empty_n = 0;
   gint          num_empty_c = 0;
@@ -691,7 +753,10 @@ generate_boundary (GeglBuffer          *buffer,
   line_rect.width  = gegl_buffer_get_width (buffer);
