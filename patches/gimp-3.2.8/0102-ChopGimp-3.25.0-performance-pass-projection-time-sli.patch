 static void
 gimp_operation_contour_init (GimpOperationContour *self)
 {
+  g_mutex_init (&self->outline_mutex);
+  g_mutex_init (&self->fill_mutex);
+}
+
+static void
+gimp_contour_fill_unref (GimpContourFill *fill)
+{
+  if (g_atomic_int_dec_and_test (&fill->ref_count))
+    {
+      g_free (fill->lut);
+      g_free (fill->pattern);
+      g_slice_free (GimpContourFill, fill);
+    }
+}
+
+/*  parses a gradient stored by gimp_gradient_save()  */
+static GObject *
+gimp_operation_contour_parse_gradient (const gchar *data)
+{
+  GInputStream *input;
+  GFile        *file;
+  GList        *list;
+  GObject      *gradient = NULL;
+
+  if (! data || ! g_str_has_prefix (data, "GIMP Gradient"))
+    return NULL;
+
+  input = g_memory_input_stream_new_from_data (data, strlen (data), NULL);
+  file  = g_file_new_for_path ("chopgimp-stroke.ggr");
+
+  list = gimp_gradient_load (NULL, file, input, NULL);
+
+  if (list)
+    gradient = g_object_ref (list->data);
+
+  g_list_free_full (list, g_object_unref);
+  g_object_unref (file);
+  g_object_unref (input);
+
+  return gradient;
+}
+
+/*  parses a pattern stored as base64 of a zlib-compressed .pat file  */
+static GObject *
+gimp_operation_contour_parse_pattern (const gchar *data)
+{
+  GInputStream  *memory;
+  GInputStream  *input;
+  GConverter    *decompressor;
+  GFile         *file;
+  GList         *list;
+  GObject       *pattern = NULL;
+  guchar        *bytes;
+  gsize          n_bytes;
+
+  if (! data || ! *data)
+    return NULL;
+
+  bytes = g_base64_decode (data, &n_bytes);
+
+  if (! bytes || n_bytes == 0)
+    {
+      g_free (bytes);
+      return NULL;
+    }
+
+  memory       = g_memory_input_stream_new_from_data (bytes, n_bytes, g_free);
+  decompressor = G_CONVERTER (g_zlib_decompressor_new (G_ZLIB_COMPRESSOR_FORMAT_ZLIB));
+  input        = g_converter_input_stream_new (memory, decompressor);
+  file         = g_file_new_for_path ("chopgimp-stroke.pat");
+
+  list = gimp_pattern_load (NULL, file, input, NULL);
+
+  if (list)
+    pattern = g_object_ref (list->data);
+
+  g_list_free_full (list, g_object_unref);
+  g_object_unref (file);
+  g_object_unref (input);
+  g_object_unref (decompressor);
+  g_object_unref (memory);
+
+  return pattern;
 }
 
