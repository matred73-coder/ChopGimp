+/*  ChopGimp: a slider drag, a preset or a color change notifies many
+ *  config properties in a row, and each notification used to apply the
+ *  filter at once (update of the bounding box and of the whole preview
+ *  area). Coalesce them: the filter's operation already has the latest
+ *  values, it is applied once, before the next redraw (the projection
+ *  renders at a lower idle priority, the visible area first).
+ */
+#define APPLY_IDLE_KEY "chopgimp-filter-tool-apply-idle"
+
+static gboolean
+gimp_filter_tool_apply_idle (gpointer data)
+{
+  GimpFilterTool *filter_tool = data;
+
+  g_object_set_data (G_OBJECT (filter_tool), APPLY_IDLE_KEY, NULL);
+
+  if (filter_tool->filter)
+    gimp_drawable_filter_apply (filter_tool->filter, NULL);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+gimp_filter_tool_queue_apply (GimpFilterTool *filter_tool)
+{
+  guint id;
+
+  if (g_object_get_data (G_OBJECT (filter_tool), APPLY_IDLE_KEY))
+    return;
+
+  id = g_idle_add_full (G_PRIORITY_HIGH_IDLE,
+                        gimp_filter_tool_apply_idle,
+                        g_object_ref (filter_tool),
+                        g_object_unref);
+
+  g_object_set_data (G_OBJECT (filter_tool), APPLY_IDLE_KEY,
+                     GUINT_TO_POINTER (id));
+}
+
+/*  runs a pending apply now (apply = TRUE) or drops it  */
+static void
+gimp_filter_tool_flush_apply (GimpFilterTool *filter_tool,
+                              gboolean        apply)
+{
+  guint id = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (filter_tool),
+                                                  APPLY_IDLE_KEY));
+
+  if (! id)
+    return;
+
+  g_object_set_data (G_OBJECT (filter_tool), APPLY_IDLE_KEY, NULL);
+  g_source_remove (id);
+
+  if (apply && filter_tool->filter)
+    gimp_drawable_filter_apply (filter_tool->filter, NULL);
+}
+
 static void
 gimp_filter_tool_halt (GimpFilterTool *filter_tool)
 {
   GimpTool *tool = GIMP_TOOL (filter_tool);
 
+  gimp_filter_tool_flush_apply (filter_tool, FALSE);
+
   gimp_filter_tool_disable_color_picking (filter_tool);
 
   if (tool->display)
@@ -1245,6 +1307,8 @@ gimp_filter_tool_commit (GimpFilterTool *filter_tool,
 {
   GimpTool *tool = GIMP_TOOL (filter_tool);
 
+  gimp_filter_tool_flush_apply (filter_tool, TRUE);
+
   if (filter_tool->gui)
     gimp_tool_gui_hide (filter_tool->gui);
 
