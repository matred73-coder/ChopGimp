+  /*  this invalidation covers a throttled one  */
+  gimp_view_renderer_remove_throttle (renderer);
+
+  renderer->priv->last_invalidate_time = g_get_monotonic_time ();
+
   GIMP_VIEW_RENDERER_GET_CLASS (renderer)->invalidate (renderer);
 
   renderer->priv->idle_id =
@@ -739,6 +761,69 @@ gimp_view_renderer_draw (GimpViewRenderer *renderer,
 
 /*  private functions  */
 
+/*  ChopGimp: the previews of images and items (layers with effects, whole
+ *  image composites) can be expensive to render. When their viewable is
+ *  invalidated again and again (painting, transforms, filter previews,
+ *  projection chunks...), the first invalidation is applied at once and
+ *  the following ones are coalesced: at most one render every
+ *  THROTTLE_INTERVAL, and always one after the last invalidation, so the
+ *  final preview is exact. Meanwhile the previous preview stays shown.
+ *  Other viewables (brushes, gradients being edited...) are not delayed.
+ */
+static void
+gimp_view_renderer_viewable_invalidated (GimpViewRenderer *renderer)
+{
+  gint64 elapsed;
+
+  if (! (GIMP_IS_IMAGE (renderer->viewable)       ||
+         GIMP_IS_IMAGE_PROXY (renderer->viewable) ||
+         GIMP_IS_ITEM (renderer->viewable)))
+    {
+      gimp_view_renderer_invalidate (renderer);
+      return;
+    }
+
+  /*  already scheduled after this invalidation  */
+  if (renderer->priv->throttle_id)
+    return;
+
+  elapsed = g_get_monotonic_time () - renderer->priv->last_invalidate_time;
+
+  if (elapsed >= THROTTLE_INTERVAL || elapsed < 0)
+    {
+      gimp_view_renderer_invalidate (renderer);
+    }
+  else
+    {
+      renderer->priv->throttle_id =
+        g_timeout_add_full (GIMP_PRIORITY_VIEWABLE_IDLE,
+                            (THROTTLE_INTERVAL - elapsed) /
+                            G_TIME_SPAN_MILLISECOND + 1,
+                            (GSourceFunc) gimp_view_renderer_throttle_timeout,
+                            renderer, NULL);
+    }
+}
+
+static gboolean
+gimp_view_renderer_throttle_timeout (GimpViewRenderer *renderer)
+{
+  renderer->priv->throttle_id = 0;
+
+  gimp_view_renderer_invalidate (renderer);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+gimp_view_renderer_remove_throttle (GimpViewRenderer *renderer)
+{
+  if (renderer->priv->throttle_id)
+    {
+      g_source_remove (renderer->priv->throttle_id);
+      renderer->priv->throttle_id = 0;
+    }
+}
+
