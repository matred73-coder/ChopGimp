+/*  ChopGimp: whether the layer's pixels are the rendering of its
+ *  current text, at the current resolution and format
+ */
+static gboolean
+gimp_text_layer_is_rendered (GimpTextLayer *layer)
+{
+  GimpTextLayerPrivate *private = layer->private;
+  GimpImage            *image;
+  gdouble               xres;
+  gdouble               yres;
+
+  if (! private->rendered_text || ! layer->text ||
+      ! gimp_item_is_attached (GIMP_ITEM (layer)) ||
+      gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)))
+    return FALSE;
+
+  image = gimp_item_get_image (GIMP_ITEM (layer));
+  gimp_image_get_resolution (image, &xres, &yres);
+
+  return (xres == private->rendered_xres &&
+          yres == private->rendered_yres &&
+          gimp_drawable_get_format (GIMP_DRAWABLE (layer)) ==
+          private->rendered_format &&
+          gimp_config_is_equal_to (GIMP_CONFIG (private->rendered_text),
+                                   GIMP_CONFIG (layer->text)));
+}
