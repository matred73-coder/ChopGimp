+/*  ChopGimp: main-thread latency.
+ *
+ *  While the dashboard is shown, a high priority timeout beats every
+ *  LATENCY_INTERVAL ms in the main thread. When the main thread is busy
+ *  (a long render, a long signal handler...), the beat comes late: the
+ *  delay is how long a click or a key would have waited. The last delay
+ *  and the longest one of the last LATENCY_WINDOW seconds are shown.
+ */
+#define LATENCY_INTERVAL 100 /* ms */
+#define LATENCY_WINDOW   5   /* s, number of latency_buckets */
+
+static gboolean
+gimp_dashboard_latency_beat (GimpDashboard *dashboard)
+{
+  GimpDashboardPrivate *priv   = dashboard->priv;
+  gint64                now    = g_get_monotonic_time ();
+  gint64                second = now / G_TIME_SPAN_SECOND;
+  gint                  delay;
+  gint                  max    = 0;
+  gint                  i;
+
+  delay = (now - priv->latency_time) / G_TIME_SPAN_MILLISECOND -
+          LATENCY_INTERVAL;
+  delay = CLAMP (delay, 0, G_MAXINT / 2);
+
+  if (second != priv->latency_second)
+    {
+      gint64 s;
+
+      for (s = priv->latency_second + 1;
+           s <= second && s <= priv->latency_second + LATENCY_WINDOW;
+           s++)
+        {
+          priv->latency_buckets[s % LATENCY_WINDOW] = 0;
+        }
+
+      priv->latency_second = second;
+    }
+
+  i = second % LATENCY_WINDOW;
+  priv->latency_buckets[i] = MAX (priv->latency_buckets[i], delay);
+
+  for (i = 0; i < LATENCY_WINDOW; i++)
+    max = MAX (max, priv->latency_buckets[i]);
+
+  g_atomic_int_set (&priv->latency_last, delay);
+  g_atomic_int_set (&priv->latency_max,  max);
+
+  priv->latency_time = now;
+
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+gimp_dashboard_latency_start (GimpDashboard *dashboard)
+{
+  GimpDashboardPrivate *priv = dashboard->priv;
+
+  if (priv->latency_id)
+    return;
+
+  priv->latency_time   = g_get_monotonic_time ();
+  priv->latency_second = priv->latency_time / G_TIME_SPAN_SECOND;
+  memset (priv->latency_buckets, 0, sizeof (priv->latency_buckets));
+
+  g_atomic_int_set (&priv->latency_last, 0);
+  g_atomic_int_set (&priv->latency_max,  0);
+  g_atomic_int_set (&priv->latency_active, TRUE);
+
+  priv->latency_id = g_timeout_add_full (G_PRIORITY_HIGH,
+                                         LATENCY_INTERVAL,
+                                         (GSourceFunc) gimp_dashboard_latency_beat,
+                                         dashboard, NULL);
+}
+
+static void
+gimp_dashboard_latency_stop (GimpDashboard *dashboard)
+{
+  GimpDashboardPrivate *priv = dashboard->priv;
+
+  g_atomic_int_set (&priv->latency_active, FALSE);
+
+  if (priv->latency_id)
+    {
+      g_source_remove (priv->latency_id);
+      priv->latency_id = 0;
+    }
+}
+
