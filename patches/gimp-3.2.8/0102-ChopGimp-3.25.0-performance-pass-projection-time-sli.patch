+/*  position (0..1) in the gradient of the pixel whose center is x, y
+ *  (layer coordinates), for the geometric styles; the gradient spans
+ *  the layer (aligned with the layer, as Photoshop's default)
+ */
+static gfloat
+gimp_operation_contour_gradient_pos (GimpOperationContour *self,
+                                     const GeglRectangle  *in_rect,
+                                     gdouble               x,
+                                     gdouble               y)
+{
+  gdouble angle = self->gradient_angle * G_PI / 180.0;
+  gdouble scale = MAX (self->gradient_scale, 1.0) / 100.0;
+  gdouble ux    = cos (angle);
+  gdouble uy    = -sin (angle);
+  gdouble w     = in_rect->width;
+  gdouble h     = in_rect->height;
+  gdouble dx    = x - (in_rect->x + w / 2.0 + self->gradient_offset_x);
+  gdouble dy    = y - (in_rect->y + h / 2.0 + self->gradient_offset_y);
+  gdouble pos   = 0.0;
+  gdouble len;
+
+  switch (self->gradient_style)
+    {
+    case GIMP_CONTOUR_GRADIENT_LINEAR:
+      len = (fabs (w * ux) + fabs (h * uy)) * scale;
+      pos = (dx * ux + dy * uy) / MAX (len, 1.0) + 0.5;
+      break;
+
+    case GIMP_CONTOUR_GRADIENT_REFLECTED:
+      len = (fabs (w * ux) + fabs (h * uy)) * scale;
+      pos = fabs (dx * ux + dy * uy) / MAX (len / 2.0, 1.0);
+      break;
+
+    case GIMP_CONTOUR_GRADIENT_RADIAL:
+      len = sqrt (w * w + h * h) / 2.0 * scale;
+      pos = sqrt (dx * dx + dy * dy) / MAX (len, 1.0);
+      break;
+
+    case GIMP_CONTOUR_GRADIENT_ANGLE:
+      pos = atan2 (-dy, dx) - angle;
+      pos = fmod (pos, 2.0 * G_PI);
+      if (pos < 0.0)
+        pos += 2.0 * G_PI;
+      pos /= 2.0 * G_PI;
+      break;
+
+    case GIMP_CONTOUR_GRADIENT_DIAMOND:
+      {
+        gdouble rx = dx * ux + dy * uy;
+        gdouble ry = dy * ux - dx * uy;
+
+        len = MAX (w, h) / 2.0 * scale;
+        pos = (fabs (rx) + fabs (ry)) / MAX (len, 1.0);
+      }
+      break;
+
+    case GIMP_CONTOUR_GRADIENT_SHAPE_BURST:
+      /*  computed from the burst surface  */
+      break;
+    }
+
+  return CLAMP (pos, 0.0, 1.0);
+}
