+/*  ChopGimp: « Aligner sur les pixels » (vector objects, chopgimp-vsnap.c)  */
+void
+gimp_display_shell_set_snap_to_pixels (GimpDisplayShell *shell,
+                                       gboolean          snap)
+{
+  GimpDisplayOptions *options;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  options = appearance_get_options (shell);
+
+  g_object_set (options, "snap-to-pixels", snap, NULL);
+}
+
+gboolean
+gimp_display_shell_get_snap_to_pixels (GimpDisplayShell *shell)
+{
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), FALSE);
+
+  return appearance_get_options (shell)->snap_to_pixels;
+}
