+static GimpValueArray *
+boolean_invoker (GimpProcedure         *procedure,
+                 Gimp                  *gimp,
+                 GimpContext           *context,
+                 GimpProgress          *progress,
+                 const GimpValueArray  *args,
+                 GError               **error)
+{
+  GimpPath **paths = g_value_get_boxed (gimp_value_array_index (args, 0));
+  gint       n     = gimp_core_object_array_get_length ((GObject **) paths);
+
+  if (n < 1)
+    return chopgimp_return_path (procedure, NULL, error);
+
+  return chopgimp_return_path (procedure,
+                               chopgimp_geom_boolean (paths, n, ARG_INT (1)),
+                               error);
+}
+
+static GimpValueArray *
+divide_invoker (GimpProcedure         *procedure,
+                Gimp                  *gimp,
+                GimpContext           *context,
+                GimpProgress          *progress,
+                const GimpValueArray  *args,
+                GError               **error)
+{
+  GimpPath      **paths = g_value_get_boxed (gimp_value_array_index (args, 0));
+  gint            n     = gimp_core_object_array_get_length ((GObject **) paths);
+  GimpPath      **pieces;
+  gint            n_pieces = 0;
+  GimpValueArray *return_vals;
+  GimpImage      *image;
+
+  if (n < 1)
+    return gimp_procedure_get_return_values (procedure, FALSE, NULL);
+
+  image = paths[0] ? gimp_item_get_image (GIMP_ITEM (paths[0])) : NULL;
+
+  if (! image || ! gimp_item_is_attached (GIMP_ITEM (paths[0])))
+    {
+      g_set_error_literal (error, GIMP_PDB_ERROR, GIMP_PDB_ERROR_INVALID_ARGUMENT,
+                           _("Les tracés doivent appartenir à une image."));
+      return gimp_procedure_get_return_values (procedure, FALSE,
+                                               error ? *error : NULL);
+    }
+
+  pieces = chopgimp_geom_divide (paths, n, &n_pieces);
+
+  /*  the pieces are added on top of the paths of the image, the first
+   *  one at the top (core object arrays are not readable from Python);
+   *  all of them are a single undo step
+   */
+  if (n_pieces > 0)
+    {
+      gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC,
+                                   _("Diviser les tracés"));
+
+      for (gint i = n_pieces - 1; i >= 0; i--)
+        gimp_image_add_path (image, pieces[i], GIMP_IMAGE_ACTIVE_PARENT, 0, TRUE);
+
+      gimp_image_undo_group_end (image);
+    }
+  g_free (pieces);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_int (gimp_value_array_index (return_vals, 1), n_pieces);
+
+  return return_vals;
+}
