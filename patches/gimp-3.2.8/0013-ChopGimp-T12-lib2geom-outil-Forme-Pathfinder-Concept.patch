+extern "C" gboolean
+chopgimp_geom_locate (GimpPath *path,
+                      gdouble   x,
+                      gdouble   y,
+                      gint     *stroke,
+                      gdouble  *t,
+                      gdouble  *distance)
+{
+  try
+    {
+      std::vector<Polyline> pls  = width_polylines (path);
+      double                best = G_MAXDOUBLE;
+      Point                 q (x, y);
+
+      for (size_t k = 0; k < pls.size (); k++)
+        {
+          const std::vector<Point> &pts = pls[k].pts;
+          double total = 0, acc = 0;
+
+          if (pts.size () < 2)
+            continue;
+
+          for (size_t i = 1; i < pts.size (); i++)
+            total += Geom::distance (pts[i - 1], pts[i]);
+
+          for (size_t i = 1; i < pts.size (); i++)
+            {
+              Point  a = pts[i - 1], b = pts[i];
+              double L = Geom::distance (a, b);
+              double u = L > 0 ? Geom::dot (q - a, b - a) / (L * L) : 0;
+              double d;
+
+              u = CLAMP (u, 0.0, 1.0);
+              d = Geom::distance (q, Geom::lerp (u, a, b));
+
+              if (d < best)
+                {
+                  best = d;
+                  if (stroke)
+                    *stroke = (gint) k;
+                  if (t)
+                    *t = total > 0 ? (acc + u * L) / total : 0;
+                }
+
+              acc += L;
+            }
+        }
+
+      if (distance)
+        *distance = best;
+
+      return best < G_MAXDOUBLE;
+    }
+  catch (...)
+    {
+      return FALSE;
+    }
+}
+
+extern "C" gboolean
+chopgimp_geom_point_at (GimpPath *path,
+                        gint      stroke,
+                        gdouble   t,
+                        gdouble  *x,
+                        gdouble  *y,
+                        gdouble  *nx,
+                        gdouble  *ny)
+{
+  try
+    {
+      std::vector<Polyline> pls = width_polylines (path);
+      double                total = 0, acc = 0, target;
+
+      if (stroke < 0 || stroke >= (gint) pls.size () || pls[stroke].pts.size () < 2)
+        return FALSE;
+
+      const std::vector<Point> &pts = pls[stroke].pts;
+
+      for (size_t i = 1; i < pts.size (); i++)
+        total += Geom::distance (pts[i - 1], pts[i]);
+
+      target = CLAMP (t, 0.0, 1.0) * total;
+
+      for (size_t i = 1; i < pts.size (); i++)
+        {
+          double L = Geom::distance (pts[i - 1], pts[i]);
+
+          if (acc + L >= target || i == pts.size () - 1)
+            {
+              double u   = L > 0 ? CLAMP ((target - acc) / L, 0.0, 1.0) : 0;
+              Point  p   = Geom::lerp (u, pts[i - 1], pts[i]);
+              Point  tan = safe_unit (pts[i] - pts[i - 1], Point (1, 0));
+
+              *x  = p[0];
+              *y  = p[1];
+              *nx = -tan[1];
+              *ny = tan[0];
+
+              return TRUE;
+            }
+
+          acc += L;
+        }
+    }
+  catch (...)
+    {
+    }
+
+  return FALSE;
+}
+
+extern "C" gboolean
+chopgimp_geom_column_extent (GimpPath *path,
+                             gdouble   x,
+                             gdouble  *top,
+                             gdouble  *bottom)
+{
+  try
+    {
+      bool   found = false;
+      double lo = G_MAXDOUBLE, hi = -G_MAXDOUBLE;
+
+      for (const Polyline &pl : sample_pv (to_pv (path), 1.0))
+        {
+          size_t n = pl.pts.size ();
+
+          for (size_t i = 0; i + 1 < n + (pl.closed ? 1 : 0); i++)
+            {
+              Point a = pl.pts[i], b = pl.pts[(i + 1) % n];
+
+              if ((a[0] <= x && b[0] >= x) || (b[0] <= x && a[0] >= x))
+                {
+                  double dx = b[0] - a[0];
+                  double yy = std::fabs (dx) > 1e-12 ? a[1] + (x - a[0]) / dx * (b[1] - a[1])
+                                                     : std::min (a[1], b[1]);
+
+                  lo = std::min (lo, yy);
+                  hi = std::max (hi, yy);
+                  found = true;
+                }
+            }
+        }
+
+      if (found)
+        {
+          *top    = lo;
+          *bottom = hi;
+        }
+
+      return found;
+    }
+  catch (...)
+    {
+      return FALSE;
+    }
+}
+
+extern "C" gdouble *
+chopgimp_geom_distort_mesh (const gchar *mesh,
+                            gint         rows,
+                            gint         cols,
+                            gdouble      x,
+                            gdouble      y,
+                            gdouble      width,
+                            gdouble      height)
+{
+  Geom::Rect         bb (x, y, x + MAX (width, 1e-6), y + MAX (height, 1e-6));
+  std::vector<Point> grid = chopgimp_distort_mesh_points (mesh ? mesh : "", rows, cols, bb);
+  gdouble           *out  = g_new (gdouble, grid.size () * 2);
+
+  for (size_t k = 0; k < grid.size (); k++)
+    {
+      out[2 * k]     = grid[k][0];
+      out[2 * k + 1] = grid[k][1];
+    }
+
+  return out;
+}
