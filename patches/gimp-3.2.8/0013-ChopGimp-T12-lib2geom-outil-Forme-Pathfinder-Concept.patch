+
+/*  3.27.3 (lot V5): « Vectoriser » for scripts. @options: an optional
+ *  preset id first (« 6-colors », « bw-logo »…), then « key=value » pairs
+ *  separated by « ; » (chopgimp_trace_options_to_string())
+ */
+static void
+trace_options_parse (ChopGimpTraceOptions *options,
+                     const gchar          *spec)
+{
+  const gchar *rest = spec;
+
+  if (spec && *spec)
+    {
+      const gchar *semi = strchr (spec, ';');
+      gchar       *head = semi ? g_strndup (spec, semi - spec) : g_strdup (spec);
+
+      g_strstrip (head);
+
+      if (*head && ! strchr (head, '='))
+        {
+          chopgimp_trace_options_set_preset (options, head);
+          rest = semi ? semi + 1 : "";
+        }
+
+      g_free (head);
+    }
+
+  if (rest && *rest)
+    chopgimp_trace_options_from_string (options, rest);
+}
+
+static GimpValueArray *
+image_trace_invoker (GimpProcedure         *procedure,
+                     Gimp                  *gimp,
+                     GimpContext           *context,
+                     GimpProgress          *progress,
+                     const GimpValueArray  *args,
+                     GError               **error)
+{
+  GimpDrawable         *drawable = ARG_OBJECT (0);
+  const gchar          *spec     = g_value_get_string (gimp_value_array_index (args, 1));
+  gboolean              sel_only = ARG_BOOL (2);
+  gboolean              live     = ARG_BOOL (3);
+  GimpImage            *image    = gimp_item_get_image (GIMP_ITEM (drawable));
+  GimpVectorLayer      *layer    = NULL;
+  ChopGimpTraceSource  *source;
+  ChopGimpTraceOptions  options;
+  GimpValueArray       *return_vals;
+
+  chopgimp_trace_options_init (&options);
+  chopgimp_trace_options_set_preset (&options, "default");
+  trace_options_parse (&options, spec);
+
+  source = chopgimp_vobjects_enabled () ? chopgimp_trace_source_new (drawable, sel_only) : NULL;
+
+  if (source)
+    {
+      ChopGimpTraceResult *result = chopgimp_trace_source_trace (source, &options,
+                                                                 progress, error);
+
+      if (result)
+        {
+          layer = chopgimp_trace_layer_new (image,
+                                            GIMP_IS_LAYER (drawable) ? GIMP_LAYER (drawable) : NULL,
+                                            result, live ? source : NULL, &options,
+                                            FALSE, FALSE, context);
+          chopgimp_trace_result_free (result);
+        }
+
+      chopgimp_trace_source_free (source);
+    }
+
+  chopgimp_trace_options_clear (&options);
+
+  if (! layer && error && ! *error)
+    g_set_error_literal (error, GIMP_PDB_ERROR, GIMP_PDB_ERROR_FAILED,
+                         "Nothing to trace (empty layer or selection, no shape "
+                         "with these options, or vector objects disabled)");
+
+  return_vals = gimp_procedure_get_return_values (procedure, layer != NULL,
+                                                  error ? *error : NULL);
+  if (layer)
+    g_value_set_object (gimp_value_array_index (return_vals, 1), layer);
+
+  return return_vals;
+}
+
+/*  live traces: « options » (the options string, empty: not a live
+ *  trace), « edited » (« 1 » when the objects changed since the trace),
+ *  « expand », « retrace[:spec] » (re-trace in place with @spec applied
+ *  on top of the current options)
+ */
+static GimpValueArray *
+image_trace_command_invoker (GimpProcedure         *procedure,
+                             Gimp                  *gimp,
+                             GimpContext           *context,
+                             GimpProgress          *progress,
+                             const GimpValueArray  *args,
+                             GError               **error)
+{
+  GimpVectorLayer *layer = ARG_OBJECT (0);
+  const gchar     *cmd   = g_value_get_string (gimp_value_array_index (args, 1));
+  gchar           *out   = NULL;
+  gboolean         done  = FALSE;
+  GimpValueArray  *return_vals;
+
+  if (! cmd)
+    cmd = "";
+
+  if (chopgimp_trace_layer_is_live (GIMP_ITEM (layer)))
+    {
+      if (! strcmp (cmd, "options"))
+        {
+          ChopGimpTraceOptions options;
+
+          chopgimp_trace_options_init (&options);
+          if (chopgimp_trace_layer_get (layer, NULL, &options, NULL))
+            {
+              out  = chopgimp_trace_options_to_string (&options);
+              done = TRUE;
+            }
+          chopgimp_trace_options_clear (&options);
+        }
+      else if (! strcmp (cmd, "edited"))
+        {
+          done = TRUE;
+          out  = g_strdup (chopgimp_trace_layer_is_edited (layer) ? "1" : "0");
+        }
+      else if (! strcmp (cmd, "expand"))
+        {
+          done = chopgimp_trace_layer_expand (layer, TRUE);
+        }
+      else if (g_str_has_prefix (cmd, "retrace"))
+        {
+          ChopGimpTraceSource  *source = NULL;
+          ChopGimpTraceOptions  options;
+          gboolean              flat   = FALSE;
+
+          chopgimp_trace_options_init (&options);
+
+          if (chopgimp_trace_layer_get (layer, &source, &options, &flat))
+            {
+              ChopGimpTraceResult *result;
+
+              if (cmd[7] == ':')
+                trace_options_parse (&options, cmd + 8);
+
+              result = chopgimp_trace_source_trace (source, &options, progress, NULL);
+              if (result)
+                {
+                  done = chopgimp_trace_layer_update (layer, result, source, &options, flat);
+                  chopgimp_trace_result_free (result);
+                }
+              chopgimp_trace_source_free (source);
+            }
+
+          chopgimp_trace_options_clear (&options);
+        }
+    }
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), done);
+  g_value_take_string (gimp_value_array_index (return_vals, 2), out ? out : g_strdup (""));
+
+  return return_vals;
+}
+
+/*  ─── 3.31.0 (lot 4a): artboards and perspective grid ─────────────── */
+
+static GimpValueArray *
+artboards_command_invoker (GimpProcedure         *procedure,
+                           Gimp                  *gimp,
+                           GimpContext           *context,
+                           GimpProgress          *progress,
+                           const GimpValueArray  *args,
+                           GError               **error)
+{
+  GimpImage      *image = ARG_OBJECT (0);
+  const gchar    *cmd   = g_value_get_string (gimp_value_array_index (args, 1));
+  gchar         **v;
+  gint            n;
+  gchar          *out  = NULL;
+  gboolean        done = FALSE;
+  GimpValueArray *return_vals;
+
+  if (! cmd)
+    cmd = "";
+
+  /*  « export|folder|ext|prefix|range »: « | » (paths may hold « : »)  */
+  v = g_strsplit (cmd, g_str_has_prefix (cmd, "export|") ? "|" : ":", 6);
+  n = g_strv_length (v);
+
+  if (n >= 1 && ! strcmp (v[0], "list"))
+    {
+      GArray  *a = chopgimp_artboards_get (image, NULL);
+      GString *s = g_string_new (NULL);
+
+      for (guint i = 0; i < a->len; i++)
+        {
+          ChopGimpArtboard *b = &g_array_index (a, ChopGimpArtboard, i);
+
+          g_string_append_printf (s, "%d %d %d %d %s\n", b->x, b->y, b->width, b->height, b->name);
+        }
+
+      chopgimp_artboards_free (a);
+      out  = g_string_free (s, FALSE);
+      done = TRUE;
+    }
+  else if (n >= 5 && ! strcmp (v[0], "add"))
+    {
+      gint i = chopgimp_artboards_add (image, atoi (v[1]), atoi (v[2]), atoi (v[3]), atoi (v[4]),
+                                       n >= 6 ? v[5] : NULL);
+
+      out  = g_strdup_printf ("%d", i);
+      done = TRUE;
+    }
+  else if (n >= 2 && ! strcmp (v[0], "remove"))
+    {
+      done = atoi (v[1]) < chopgimp_artboards_count (image);
+      chopgimp_artboards_remove (image, atoi (v[1]));
+    }
+  else if (n >= 3 && ! strcmp (v[0], "rename"))
+    {
+      chopgimp_artboards_rename (image, atoi (v[1]), v[2]);
+      done = TRUE;
+    }
+  else if (n >= 6 && ! strcmp (v[0], "rect"))
+    {
+      chopgimp_artboards_set_rect (image, atoi (v[1]), atoi (v[2]), atoi (v[3]),
+                                   atoi (v[4]), atoi (v[5]), FALSE);
+      done = TRUE;
+    }
+  else if (n >= 2 && ! strcmp (v[0], "duplicate"))
+    {
+      gint i = chopgimp_artboards_duplicate (image, atoi (v[1]), FALSE, 0, 0);
+
+      out  = g_strdup_printf ("%d", i);
+      done = i >= 0;
+    }
+  else if (n >= 3 && ! strcmp (v[0], "move"))
+    {
+      chopgimp_artboards_move_to (image, atoi (v[1]), atoi (v[2]));
+      done = TRUE;
+    }
+  else if (n >= 1 && ! strcmp (v[0], "active"))
+    {
+      if (n >= 2)
+        chopgimp_artboards_set_active (image, atoi (v[1]));
+      out  = g_strdup_printf ("%d", chopgimp_artboards_get_active (image));
+      done = TRUE;
+    }
+  else if (n >= 3 && ! strcmp (v[0], "find"))
+    {
+      out  = g_strdup_printf ("%d", chopgimp_artboards_find_at (image, g_ascii_strtod (v[1], NULL),
+                                                                 g_ascii_strtod (v[2], NULL)));
+      done = TRUE;
+    }
+  else if (n >= 1 && ! strcmp (v[0], "fit"))
+    {
+      done = chopgimp_artboards_fit_canvas (image, context);
+    }
+  else if (n >= 3 && ! strcmp (v[0], "export"))
+    {
+      GFile    *folder = g_file_new_for_path (v[1]);
+      gint      count  = chopgimp_artboards_count (image);
+      gboolean *sel    = g_new0 (gboolean, MAX (count, 1));
+      gint      written;
+
+      chopgimp_artboards_parse_range (n >= 5 ? v[4] : NULL, count, sel);
+      written = chopgimp_artboards_export (image, context, progress, folder, v[2],
+                                           n >= 4 ? v[3] : "", sel, error);
+      out  = g_strdup_printf ("%d", written);
+      done = written >= 0;
+
+      g_free (sel);
+      g_object_unref (folder);
+    }
+
+  g_strfreev (v);
+  gimp_image_flush (image);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), done);
+  g_value_take_string (gimp_value_array_index (return_vals, 2), out ? out : g_strdup (""));
+
+  return return_vals;
+}
+
+/*  the selected objects of @item when it is a vector layer with some,
+ *  else none (the item itself)
+ */
+static GArray *
+pgrid_objects (GimpItem *item)
+{
+  GArray *ids = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  if (GIMP_IS_VECTOR_LAYER (item) && gimp_item_is_vector_layer (item))
+    {
+      gint         n;
+      const guint *sel = chopgimp_vlayer_get_selection (GIMP_VECTOR_LAYER (item), &n);
+
+      g_array_append_vals (ids, sel, n);
+    }
+
+  return ids;
+}
+
+static GimpValueArray *
+perspective_command_invoker (GimpProcedure         *procedure,
+                             Gimp                  *gimp,
+                             GimpContext           *context,
+                             GimpProgress          *progress,
+                             const GimpValueArray  *args,
+                             GError               **error)
+{
+  GimpImage      *image = ARG_OBJECT (0);
+  GimpItem       *item  = ARG_OBJECT (1);
+  const gchar    *cmd   = g_value_get_string (gimp_value_array_index (args, 2));
+  gchar         **v;
+  gint            n;
+  gchar          *out  = NULL;
+  gboolean        done = FALSE;
+  ChopGimpPGrid   g;
+  GimpValueArray *return_vals;
+
+  if (! cmd)
+    cmd = "";
+
+  v = g_strsplit (cmd, ":", 8);
+  n = g_strv_length (v);
+
+  chopgimp_pgrid_get (image, &g);
+
+  if (n >= 1 && ! strcmp (v[0], "get"))
+    {
+      out  = chopgimp_pgrid_to_string (&g);
+      done = TRUE;
+    }
+  else if (n >= 2 && ! strcmp (v[0], "set"))
+    {
+      /*  « set:key=value;key=value… » (the keys of the parasite)  */
+      gchar *text = g_strdelimit (g_strdup (cmd + 4), ";", '\n');
+
+      chopgimp_pgrid_from_string (&g, text);
+      g_free (text);
+      chopgimp_pgrid_set (image, &g, "Grille de perspective", FALSE);
+      done = TRUE;
+    }
+  else if (n >= 1 && (! strcmp (v[0], "show") || ! strcmp (v[0], "hide")))
+    {
+      g.visible = ! strcmp (v[0], "show");
+      chopgimp_pgrid_set (image, &g, "Grille de perspective", FALSE);
+      done = TRUE;
+    }
+  else if (n >= 2 && ! strcmp (v[0], "type"))
+    {
+      chopgimp_pgrid_set_type (&g, atoi (v[1]),
+                               gimp_image_get_width (image), gimp_image_get_height (image));
+      chopgimp_pgrid_set (image, &g, "Grille de perspective", FALSE);
+      done = TRUE;
+    }
+  else if (n >= 2 && ! strcmp (v[0], "plane"))
+    {
+      chopgimp_pgrid_set_active_plane (image, CLAMP (atoi (v[1]), 0, 3));
+      done = TRUE;
+    }
+  else if (n >= 4 && (! strcmp (v[0], "project") || ! strcmp (v[0], "unproject")))
+    {
+      gdouble a = g_ascii_strtod (v[2], NULL), b = g_ascii_strtod (v[3], NULL);
+      gdouble x, y;
+
+      done = ! strcmp (v[0], "project")
+             ? chopgimp_pgrid_from_plane (&g, atoi (v[1]), a, b, &x, &y)
+             : chopgimp_pgrid_to_plane   (&g, atoi (v[1]), a, b, &x, &y);
+      if (done)
+        {
+          gchar bx[G_ASCII_DTOSTR_BUF_SIZE], by[G_ASCII_DTOSTR_BUF_SIZE];
+
+          /*  C locale: the result is parsed back by scripts  */
+          out = g_strdup_printf ("%s %s",
+                                 g_ascii_formatd (bx, sizeof bx, "%.3f", x),
+                                 g_ascii_formatd (by, sizeof by, "%.3f", y));
+        }
+    }
+  else if (n >= 1 && ! strcmp (v[0], "item-plane") && item)
+    {
+      out  = g_strdup_printf ("%d", chopgimp_pgrid_item_get_plane (item, n >= 2 ? atoi (v[1]) : 0));
+      done = TRUE;
+    }
+  else if (n >= 1 && (! strcmp (v[0], "attach") || ! strcmp (v[0], "release")) && item)
+    {
+      GArray *ids   = pgrid_objects (item);
+      gint    plane = ! strcmp (v[0], "attach")
+                      ? (n >= 2 ? atoi (v[1]) : (gint) chopgimp_pgrid_get_active_plane (image))
+                      : CHOPGIMP_PLANE_NONE;
+
+      if (ids->len)
+        for (guint i = 0; i < ids->len; i++)
+          chopgimp_pgrid_item_set_plane (item, g_array_index (ids, guint, i), plane, TRUE);
+      else
+        chopgimp_pgrid_item_set_plane (item, 0, plane, TRUE);
+
+      g_array_free (ids, TRUE);
+      done = TRUE;
+    }
+  else if (n >= 5 && ! strcmp (v[0], "drag") && item)
+    {
+      /*  « Sélection de perspective »: drag:x0:y0:x1:y1 (the object or the
+       *  selected objects of @item; placed on the active plane when free)
+       */
+      GArray      *ids   = pgrid_objects (item);
+      guint        first = ids->len ? g_array_index (ids, guint, 0) : 0;
+      gint         plane = chopgimp_pgrid_item_get_plane (item, first);
+      gboolean     place = FALSE;
+      GimpMatrix3  M;
+      gdouble      x0 = g_ascii_strtod (v[1], NULL), y0 = g_ascii_strtod (v[2], NULL);
+      gdouble      x1 = g_ascii_strtod (v[3], NULL), y1 = g_ascii_strtod (v[4], NULL);
+
+      if (plane == CHOPGIMP_PLANE_NONE)
+        {
+          plane = g.visible ? g.active_plane : CHOPGIMP_PLANE_NONE;
+          place = TRUE;
+        }
+
+      if (plane != CHOPGIMP_PLANE_NONE &&
+          (place ? chopgimp_pgrid_place_matrix (&g, plane, x0, y0, x1, y1, g.snap, &M)
+                 : chopgimp_pgrid_move_matrix  (&g, plane, x0, y0, x1, y1, g.snap, &M)))
+        {
+          gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC, "Sélection de perspective");
+
+          if (ids->len)
+            {
+              chopgimp_vlayer_transform (GIMP_VECTOR_LAYER (item), (guint *) ids->data,
+                                         ids->len, &M, TRUE, TRUE);
+              for (guint i = 0; i < ids->len; i++)
+                chopgimp_pgrid_item_set_plane (item, g_array_index (ids, guint, i), plane, TRUE);
+            }
+          else
+            {
+              /*  3.31.0 (4b): a pixel layer from its original  */
+              if (GIMP_IS_LAYER (item) && ! gimp_viewable_get_children (GIMP_VIEWABLE (item)) &&
+                  ! gimp_item_is_text_layer (item) && ! gimp_item_is_vector_layer (item) &&
+                  ! g_getenv ("CHOPGIMP_NO_PERSP_SOURCE"))
+                chopgimp_pgrid_transform_from_source (item, context, &M,
+                                                      gimp->config->interpolation_type);
+              else
+                gimp_item_transform (item, context, &M, GIMP_TRANSFORM_FORWARD,
+                                     gimp->config->interpolation_type,
+                                     GIMP_TRANSFORM_RESIZE_ADJUST, NULL);
+              chopgimp_pgrid_item_set_plane (item, 0, plane, TRUE);
+            }
+
+          gimp_image_undo_group_end (image);
+          done = TRUE;
+        }
+
+      g_array_free (ids, TRUE);
+    }
+  else if (n >= 5 && ! strcmp (v[0], "rect") && item && GIMP_IS_VECTOR_LAYER (item))
+    {
+      /*  a rectangle drawn on the active plane (the shape tool): rect:x0:y0:x1:y1
+       *  in image coordinates, its corners on the plane
+       */
+      gint     plane = chopgimp_pgrid_get_active_plane (image);
+      gdouble  u0, v0, u1, v1;
+
+      if (plane != CHOPGIMP_PLANE_NONE &&
+          chopgimp_pgrid_to_plane (&g, plane, g_ascii_strtod (v[1], NULL),
+                                   g_ascii_strtod (v[2], NULL), &u0, &v0) &&
+          chopgimp_pgrid_to_plane (&g, plane, g_ascii_strtod (v[3], NULL),
+                                   g_ascii_strtod (v[4], NULL), &u1, &v1))
+        {
+          GimpPath        *path = gimp_path_new (image, "Rectangle");
+          GimpStroke      *stroke;
+          GimpCoords       c = GIMP_COORDS_DEFAULT_VALUES;
+          GimpMatrix3      H;
+          ChopGimpVStyle   style;
+          ChopGimpVObject *obj;
+
+          if (g.snap)
+            {
+              chopgimp_pgrid_snap (&g, &u0, &v0, g.cell * 0.2);
+              chopgimp_pgrid_snap (&g, &u1, &v1, g.cell * 0.2);
+            }
+
+          g_object_ref_sink (path);
+          c.x = u0; c.y = v0; stroke = gimp_bezier_stroke_new_moveto (&c);
+          c.x = u1; c.y = v0; gimp_bezier_stroke_lineto (stroke, &c);
+          c.x = u1; c.y = v1; gimp_bezier_stroke_lineto (stroke, &c);
+          c.x = u0; c.y = v1; gimp_bezier_stroke_lineto (stroke, &c);
+          gimp_stroke_close (stroke);
+          gimp_path_stroke_add (path, stroke);
+          g_object_unref (stroke);
+
+          chopgimp_pgrid_plane_matrix (&g, plane, &H);
+          chopgimp_vpath_transform (path, &H);
+
+          memset (&style, 0, sizeof (style));
+          chopgimp_vobjects_style_from_tool (&style, image, TRUE, NULL, FALSE, NULL);
+          obj = chopgimp_vobjects_add_path (GIMP_VECTOR_LAYER (item), path, "Rectangle", &style);
+          chopgimp_vstyle_clear (&style);
+          g_object_unref (path);
+
+          if (obj)
+            {
+              chopgimp_pgrid_item_set_plane (item, obj->id, plane, FALSE);
+              out  = g_strdup_printf ("%u", obj->id);
+              done = TRUE;
+            }
+        }
+    }
+
+  g_strfreev (v);
+  gimp_image_flush (image);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), done);
+  g_value_take_string (gimp_value_array_index (return_vals, 2), out ? out : g_strdup (""));
+
+  return return_vals;
+}
+
+/*  ChopGimp 4.2.0: CMYK (core/chopgimp-cmyk.c), one procedure with
+ *  commands; never a PDB error: (done, message)
+ */
+static GimpValueArray *
+cmyk_command_invoker (GimpProcedure         *procedure,
+                      Gimp                  *gimp,
+                      GimpContext           *context,
+                      GimpProgress          *progress,
+                      const GimpValueArray  *args,
+                      GError               **error)
+{
+  GimpImage      *image = ARG_OBJECT (0);
+  const gchar    *cmd   = g_value_get_string (gimp_value_array_index (args, 1));
+  gchar         **part;
+  gchar          *out   = NULL;
+  gboolean        done  = FALSE;
+  GError         *err   = NULL;
+  GimpValueArray *return_vals;
+
+  part = g_strsplit (cmd ? cmd : "", "|", -1);
+
+  if (! part[0])
+    {
+      out = g_strdup ("commande vide");
+    }
+  else if (! strcmp (part[0], "list"))
+    {
+      GList   *files = chopgimp_cmyk_list_profiles (gimp);
+      GString *str   = g_string_new (NULL);
+
+      for (GList *l = files; l; l = l->next)
+        g_string_append_printf (str, "%s%s", str->len ? "\n" : "",
+                                g_file_peek_path (l->data));
+      g_list_free_full (files, g_object_unref);
+      out  = g_string_free (str, FALSE);
+      done = TRUE;
+    }
+  else if (! strcmp (part[0], "preferred"))
+    {
+      GimpColorProfile *profile = chopgimp_cmyk_get_preferred (gimp, &out);
+
+      if (profile)
+        {
+          g_free (out);
+          out  = g_strdup (gimp_color_profile_get_label (profile));
+          done = TRUE;
+          g_object_unref (profile);
+        }
+    }
+  else if (! strcmp (part[0], "set-preferred") && part[1])
+    {
+      GFile *file = g_file_new_for_path (part[1]);
+
+      done = chopgimp_cmyk_set_preferred (gimp, file, &err);
+      g_object_unref (file);
+    }
+  else if (! strcmp (part[0], "check") && part[1])
+    {
+      GFile            *file    = g_file_new_for_path (part[1]);
+      GimpColorProfile *profile = gimp_color_profile_new_from_file (file, &err);
+      GimpColorProfile *checked = profile ? chopgimp_cmyk_check_profile (profile, &err) : NULL;
+
+      if (checked)
+        {
+          out  = g_strdup (gimp_color_profile_get_label (checked));
+          done = TRUE;
+        }
+      g_clear_object (&checked);
+      g_clear_object (&profile);
+      g_object_unref (file);
+    }
+  else if (! strcmp (part[0], "rgb2cmyk") && part[1] && part[2] && part[3] && part[4])
+    {
+      /*  sRGB colors (0..1, « r,g,b;… ») to CMYK values (0..1) of the
+       *  profile @part[1] with intent @part[2] and black point
+       *  compensation @part[3] (PDF export for the printer)
+       */
+      GFile            *file    = g_file_new_for_path (part[1]);
+      GimpColorProfile *profile = gimp_color_profile_new_from_file (file, &err);
+      GimpColorProfile *checked = profile ? chopgimp_cmyk_check_profile (profile, &err) : NULL;
+
+      if (checked)
+        {
+          cmsHPROFILE   srgb = cmsCreate_sRGBProfile ();
+          cmsHTRANSFORM t    = cmsCreateTransform (srgb, TYPE_RGB_16,
+                                                   gimp_color_profile_get_lcms_profile (checked),
+                                                   TYPE_CMYK_16, atoi (part[2]),
+                                                   atoi (part[3]) ? cmsFLAGS_BLACKPOINTCOMPENSATION : 0);
+          if (t)
+            {
+              gchar  **cols = g_strsplit (part[4], ";", -1);
+              GString *str  = g_string_new (NULL);
+
+              for (gint i = 0; cols[i]; i++)
+                {
+                  gchar         **v = g_strsplit (cols[i], ",", -1);
+                  gdouble         r, g, b;
+                  cmsUInt16Number in[3], o[4];
+                  gchar           buf[4][G_ASCII_DTOSTR_BUF_SIZE];
+
+                  /*  C locale numbers (a French locale reads « 1,0 »)  */
+                  if (g_strv_length (v) != 3)
+                    {
+                      g_strfreev (v);
+                      continue;
+                    }
+                  r = g_ascii_strtod (v[0], NULL);
+                  g = g_ascii_strtod (v[1], NULL);
+                  b = g_ascii_strtod (v[2], NULL);
+                  g_strfreev (v);
+
+                  in[0] = CLAMP (r, 0.0, 1.0) * 65535.0 + 0.5;
+                  in[1] = CLAMP (g, 0.0, 1.0) * 65535.0 + 0.5;
+                  in[2] = CLAMP (b, 0.0, 1.0) * 65535.0 + 0.5;
+                  cmsDoTransform (t, in, o, 1);
+                  for (gint k = 0; k < 4; k++)
+                    g_ascii_formatd (buf[k], sizeof (buf[k]), "%.4f", o[k] / 65535.0);
+                  g_string_append_printf (str, "%s%s,%s,%s,%s", str->len ? ";" : "",
+                                          buf[0], buf[1], buf[2], buf[3]);
+                }
+
+              g_strfreev (cols);
+              cmsDeleteTransform (t);
+              out  = g_string_free (str, FALSE);
+              done = TRUE;
+            }
+          else
+            {
+              out = g_strdup ("transformation impossible");
+            }
+
+          cmsCloseProfile (srgb);
+        }
+
+      g_clear_object (&checked);
+      g_clear_object (&profile);
+      g_object_unref (file);
+    }
+  else if (! image)
+    {
+      out = g_strdup ("image requise");
+    }
+  else if (! strcmp (part[0], "is-cmyk"))
+    {
+      out  = g_strdup (chopgimp_image_is_cmyk (image) ? "1" : "0");
+      done = TRUE;
+    }
+  else if (! strcmp (part[0], "simulation"))
+    {
+      GimpColorProfile *sim = gimp_image_get_simulation_profile (image);
+
+      out  = g_strdup (sim ? gimp_color_profile_get_label (sim) : "");
+      done = TRUE;
+    }
+  else if (! strcmp (part[0], "set-cmyk") || ! strcmp (part[0], "set-rgb") ||
+           ! strcmp (part[0], "convert"))
+    {
+      GimpColorProfile *profile = NULL;
+
+      if (part[1] && *part[1])
+        {
+          GFile *file = g_file_new_for_path (part[1]);
+
+          profile = gimp_color_profile_new_from_file (file, &err);
+          g_object_unref (file);
+        }
+
+      if (part[1] && *part[1] && ! profile)
+        ;
+      else if (! strcmp (part[0], "convert"))
+        done = profile &&
+               chopgimp_image_convert_cmyk_profile (image, profile,
+                                                    part[2] ? atoi (part[2]) :
+                                                    GIMP_COLOR_RENDERING_INTENT_RELATIVE_COLORIMETRIC,
+                                                    part[2] && part[3] ? atoi (part[3]) != 0 : TRUE,
+                                                    progress, &err);
+      else
+        done = chopgimp_image_set_cmyk (image, ! strcmp (part[0], "set-cmyk"),
+                                        profile, &err);
+
+      g_clear_object (&profile);
+    }
+  else
+    {
+      out = g_strdup_printf ("commande inconnue : %s", part[0]);
+    }
+
+  if (err)
+    {
+      g_free (out);
+      out = g_strdup (err->message);
+      g_clear_error (&err);
+    }
+
+  g_strfreev (part);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), done);
+  g_value_take_string (gimp_value_array_index (return_vals, 2), out ? out : g_strdup (""));
+
+  return return_vals;
+}
+
+static GimpProcedure *
+chopgimp_procedure (GimpPDB          *pdb,
+                    GimpMarshalFunc   invoker,
+                    const gchar      *name,
+                    const gchar      *help)
+{
+  GimpProcedure *procedure = gimp_procedure_new (invoker, FALSE);
+
+  gimp_object_set_static_name (GIMP_OBJECT (procedure), name);
+  gimp_procedure_set_static_help (procedure, help, help, NULL);
+  gimp_procedure_set_static_attribution (procedure,
+                                         "ChopGimp (lib2geom / Inkscape)",
+                                         "ChopGimp", "2026");
+  return procedure;
+}
+
+static GParamSpec *
+path_arg (const gchar *name)
+{
+  return gimp_param_spec_path (name, name, "A path", FALSE, GIMP_PARAM_READWRITE);
+}
+
+static GParamSpec *
+paths_arg (const gchar *name)
+{
+  return gimp_param_spec_core_object_array (name, name, "Paths", GIMP_TYPE_PATH,
+                                            GIMP_PARAM_READWRITE);
+}
+
+static GParamSpec *
+int_arg (const gchar *name, gint min, gint max, gint def)
+{
+  return g_param_spec_int (name, name, name, min, max, def, GIMP_PARAM_READWRITE);
+}
+
+static GParamSpec *
+double_arg (const gchar *name, gdouble min, gdouble max, gdouble def)
+{
+  return g_param_spec_double (name, name, name, min, max, def, GIMP_PARAM_READWRITE);
+}
