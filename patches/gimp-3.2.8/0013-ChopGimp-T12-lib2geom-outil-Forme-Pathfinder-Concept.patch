+
+
+/*  ── options ─────────────────────────────────────────────────────── */
+
+enum
+{
+  PROP_0,
+  PROP_SHAPE_TYPE,
+  PROP_CORNER_RADIUS,
+  PROP_SIDES,
+  PROP_STAR_RATIO,
+  PROP_SPIRAL_TURNS,
+  PROP_SPIRAL_DECAY,
+  PROP_ARC_CLOSED,
+  PROP_ARC_CONCAVE,
+  PROP_GRID_ROWS,
+  PROP_GRID_COLS,
+  PROP_GRID_FRAME
+};
+
+static GType
+chopgimp_shape_type_get_type (void)
+{
+  static GType type = 0;
+
+  if (G_UNLIKELY (! type))
+    {
+      static const GEnumValue values[] =
+      {
+        { CHOPGIMP_SHAPE_RECTANGLE,         "CHOPGIMP_SHAPE_RECTANGLE",         "rectangle" },
+        { CHOPGIMP_SHAPE_ROUNDED_RECTANGLE, "CHOPGIMP_SHAPE_ROUNDED_RECTANGLE", "rounded-rectangle" },
+        { CHOPGIMP_SHAPE_ELLIPSE,           "CHOPGIMP_SHAPE_ELLIPSE",           "ellipse" },
+        { CHOPGIMP_SHAPE_POLYGON,           "CHOPGIMP_SHAPE_POLYGON",           "polygon" },
+        { CHOPGIMP_SHAPE_STAR,              "CHOPGIMP_SHAPE_STAR",              "star" },
+        { CHOPGIMP_SHAPE_LINE,              "CHOPGIMP_SHAPE_LINE",              "line" },
+        { CHOPGIMP_SHAPE_SPIRAL,            "CHOPGIMP_SHAPE_SPIRAL",            "spiral" },
+        { CHOPGIMP_SHAPE_ARC,               "CHOPGIMP_SHAPE_ARC",               "arc" },
+        { CHOPGIMP_SHAPE_RECT_GRID,         "CHOPGIMP_SHAPE_RECT_GRID",         "rectangular-grid" },
+        { CHOPGIMP_SHAPE_POLAR_GRID,        "CHOPGIMP_SHAPE_POLAR_GRID",        "polar-grid" },
+        { 0, NULL, NULL }
+      };
+      static const GimpEnumDesc descs[] =
+      {
+        { CHOPGIMP_SHAPE_RECTANGLE,         "Rectangle",           NULL },
+        { CHOPGIMP_SHAPE_ROUNDED_RECTANGLE, "Rectangle arrondi",   NULL },
+        { CHOPGIMP_SHAPE_ELLIPSE,           "Ellipse",             NULL },
+        { CHOPGIMP_SHAPE_POLYGON,           "Polygone",            NULL },
+        { CHOPGIMP_SHAPE_STAR,              "Étoile",              NULL },
+        { CHOPGIMP_SHAPE_LINE,              "Ligne",               NULL },
+        { CHOPGIMP_SHAPE_SPIRAL,            "Spirale",             NULL },
+        { CHOPGIMP_SHAPE_ARC,               "Arc",                 NULL },
+        { CHOPGIMP_SHAPE_RECT_GRID,         "Grille rectangulaire", NULL },
+        { CHOPGIMP_SHAPE_POLAR_GRID,        "Grille polaire",      NULL },
+        { 0, NULL, NULL }
+      };
+
+      type = g_enum_register_static ("ChopGimpShapeType", values);
+      gimp_enum_set_value_descriptions (type, descs);
+    }
+
+  return type;
+}
+
+G_DEFINE_TYPE (GimpShapeOptions, gimp_shape_options, GIMP_TYPE_PATH_OPTIONS)
+
+static void
+gimp_shape_options_set_property (GObject      *object,
+                                 guint         property_id,
+                                 const GValue *value,
+                                 GParamSpec   *pspec)
+{
+  GimpShapeOptions *options = GIMP_SHAPE_OPTIONS (object);
+
+  switch (property_id)
+    {
+    case PROP_SHAPE_TYPE:    options->shape_type    = g_value_get_enum   (value); break;
+    case PROP_CORNER_RADIUS: options->corner_radius = g_value_get_double (value); break;
+    case PROP_SIDES:         options->sides         = g_value_get_int    (value); break;
+    case PROP_STAR_RATIO:    options->star_ratio    = g_value_get_double (value); break;
+    case PROP_SPIRAL_TURNS:  options->spiral_turns  = g_value_get_double (value); break;
+    case PROP_SPIRAL_DECAY:  options->spiral_decay  = g_value_get_double (value); break;
+    case PROP_ARC_CLOSED:    options->arc_closed    = g_value_get_boolean (value); break;
+    case PROP_ARC_CONCAVE:   options->arc_concave   = g_value_get_boolean (value); break;
+    case PROP_GRID_ROWS:     options->grid_rows     = g_value_get_int    (value); break;
+    case PROP_GRID_COLS:     options->grid_cols     = g_value_get_int    (value); break;
+    case PROP_GRID_FRAME:    options->grid_frame    = g_value_get_boolean (value); break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_shape_options_get_property (GObject    *object,
+                                 guint       property_id,
+                                 GValue     *value,
+                                 GParamSpec *pspec)
+{
+  GimpShapeOptions *options = GIMP_SHAPE_OPTIONS (object);
+
+  switch (property_id)
+    {
+    case PROP_SHAPE_TYPE:    g_value_set_enum   (value, options->shape_type);    break;
+    case PROP_CORNER_RADIUS: g_value_set_double (value, options->corner_radius); break;
+    case PROP_SIDES:         g_value_set_int    (value, options->sides);         break;
+    case PROP_STAR_RATIO:    g_value_set_double (value, options->star_ratio);    break;
+    case PROP_SPIRAL_TURNS:  g_value_set_double (value, options->spiral_turns);  break;
+    case PROP_SPIRAL_DECAY:  g_value_set_double (value, options->spiral_decay);  break;
+    case PROP_ARC_CLOSED:    g_value_set_boolean (value, options->arc_closed);   break;
+    case PROP_ARC_CONCAVE:   g_value_set_boolean (value, options->arc_concave);  break;
+    case PROP_GRID_ROWS:     g_value_set_int    (value, options->grid_rows);     break;
+    case PROP_GRID_COLS:     g_value_set_int    (value, options->grid_cols);     break;
+    case PROP_GRID_FRAME:    g_value_set_boolean (value, options->grid_frame);   break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_shape_options_class_init (GimpShapeOptionsClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->set_property = gimp_shape_options_set_property;
+  object_class->get_property = gimp_shape_options_get_property;
+
+  GIMP_CONFIG_PROP_ENUM (object_class, PROP_SHAPE_TYPE,
+                         "shape-type", "Forme", NULL,
+                         chopgimp_shape_type_get_type (),
+                         CHOPGIMP_SHAPE_RECTANGLE,
+                         GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_DOUBLE (object_class, PROP_CORNER_RADIUS,
+                           "corner-radius", "Rayon des angles", NULL,
+                           0.0, 2000.0, 20.0,
+                           GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_INT (object_class, PROP_SIDES,
+                        "sides", "Côtés", NULL,
+                        3, 64, 6,
+                        GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_DOUBLE (object_class, PROP_STAR_RATIO,
+                           "star-ratio", "Creux de l'étoile", NULL,
+                           0.05, 0.95, 0.5,
+                           GIMP_PARAM_STATIC_STRINGS);
+
+  /*  3.29.0: Spirale, Arc, Grille rectangulaire, Grille polaire  */
+  GIMP_CONFIG_PROP_DOUBLE (object_class, PROP_SPIRAL_TURNS,
+                           "spiral-turns", "Tours", NULL,
+                           0.5, 30.0, 4.0,
+                           GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_DOUBLE (object_class, PROP_SPIRAL_DECAY,
+                           "spiral-decay", "Décroissance", NULL,
+                           5.0, 99.0, 80.0,
+                           GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, PROP_ARC_CLOSED,
+                            "arc-closed", "Arc fermé", NULL,
+                            FALSE,
+                            GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, PROP_ARC_CONCAVE,
+                            "arc-concave", "Concave", NULL,
+                            FALSE,
+                            GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_INT (object_class, PROP_GRID_ROWS,
+                        "grid-rows", "Lignes", NULL,
+                        1, 200, 5,
+                        GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_INT (object_class, PROP_GRID_COLS,
+                        "grid-cols", "Colonnes", NULL,
+                        1, 200, 5,
+                        GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, PROP_GRID_FRAME,
+                            "grid-frame", "Cadre", NULL,
+                            TRUE,
+                            GIMP_PARAM_STATIC_STRINGS);
+}
+
+static void
+gimp_shape_options_init (GimpShapeOptions *options)
+{
+}
+
+
+/*  ── tool ────────────────────────────────────────────────────────── */
+
+G_DEFINE_TYPE (GimpShapeTool, gimp_shape_tool, GIMP_TYPE_DRAW_TOOL)
+
+#define parent_class gimp_shape_tool_parent_class
+
+void
+gimp_shape_tool_register (GimpToolRegisterCallback  callback,
+                          gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_SHAPE_TOOL,
+                GIMP_TYPE_SHAPE_OPTIONS,
+                gimp_tool_options_empty_gui,
+                0,
+                "gimp-shape-tool",
+                _("Forme"),
+                _("Forme : dessiner un rectangle, une ellipse, un polygone, une étoile, "
+                  "une ligne, une spirale, un arc ou une grille en calque vectoriel "
+                  "(Maj : proportions, Alt : depuis le centre)"),
+                N_("_Forme"), "U",
+                NULL, "gimp-tool-shape",
+                "chopgimp-tool-shape",
+                data);
+}
+
+/*  bounding box of the shape being drawn, in image coordinates  */
+static void
+shape_bounds (GimpShapeTool *shape,
+              gdouble       *x,
+              gdouble       *y,
+              gdouble       *w,
+              gdouble       *h)
+{
+  gdouble dx = shape->cur_x - shape->start_x;
+  gdouble dy = shape->cur_y - shape->start_y;
+
+  if (shape->constrain)
+    {
+      gdouble m = MAX (fabs (dx), fabs (dy));
+
+      dx = (dx < 0) ? -m : m;
+      dy = (dy < 0) ? -m : m;
+    }
+
+  if (shape->from_center)
+    {
+      *x = shape->start_x - fabs (dx);
+      *y = shape->start_y - fabs (dy);
+      *w = 2 * fabs (dx);
+      *h = 2 * fabs (dy);
+    }
+  else
+    {
+      *x = MIN (shape->start_x, shape->start_x + dx);
+      *y = MIN (shape->start_y, shape->start_y + dy);
+      *w = fabs (dx);
+      *h = fabs (dy);
+    }
+}
+
+/*  end point of a line, with 45° constraint  */
+static void
+shape_line_end (GimpShapeTool *shape,
+                gdouble       *x,
+                gdouble       *y)
+{
+  gdouble dx = shape->cur_x - shape->start_x;
+  gdouble dy = shape->cur_y - shape->start_y;
+
+  if (shape->constrain)
+    {
+      gdouble len   = sqrt (dx * dx + dy * dy);
+      gdouble angle = RINT (atan2 (dy, dx) / (G_PI / 4)) * (G_PI / 4);
+
+      dx = len * cos (angle);
+      dy = len * sin (angle);
+    }
+
+  *x = shape->start_x + dx;
+  *y = shape->start_y + dy;
+}
+
+/*  polygon / star vertices inscribed in the box  */
+static gint
+shape_vertices (GimpShapeOptions *options,
+                gdouble x, gdouble y, gdouble w, gdouble h,
+                GimpVector2 *pts)
+{
+  gboolean star = options->shape_type == CHOPGIMP_SHAPE_STAR;
+  gint     n    = star ? options->sides * 2 : options->sides;
+  gdouble  cx   = x + w / 2, cy = y + h / 2;
+  gint     i;
+
+  for (i = 0; i < n; i++)
+    {
+      gdouble a = -G_PI / 2 + 2 * G_PI * i / n;
+      gdouble r = (star && (i % 2)) ? options->star_ratio : 1.0;
+
+      pts[i].x = cx + r * (w / 2) * cos (a);
+      pts[i].y = cy + r * (h / 2) * sin (a);
+    }
+
+  return n;
+}
+
+static GimpStroke *
+shape_build_stroke (GimpShapeTool    *shape,
+                    GimpShapeOptions *options)
+{
+  GimpStroke  *stroke = NULL;
+  GimpCoords   c, c1, c2;
+  gdouble      x, y, w, h;
+  GimpVector2  pts[130];
+  gint         n, i;
+
+  shape_bounds (shape, &x, &y, &w, &h);
+
+  switch (options->shape_type)
+    {
+    case CHOPGIMP_SHAPE_LINE:
+      {
+        gdouble ex, ey;
+
+        shape_line_end (shape, &ex, &ey);
+        c      = chopgimp_coords (shape->start_x, shape->start_y);
+        stroke = gimp_bezier_stroke_new_moveto (&c);
+        c      = chopgimp_coords (ex, ey);
+        gimp_bezier_stroke_lineto (stroke, &c);
+      }
+      return stroke;
+
+    case CHOPGIMP_SHAPE_ELLIPSE:
+      c = chopgimp_coords (x + w / 2, y + h / 2);
+      return gimp_bezier_stroke_new_ellipse (&c, w / 2, h / 2, 0.0);
+
+    case CHOPGIMP_SHAPE_ROUNDED_RECTANGLE:
+      {
+        gdouble r = MIN (options->corner_radius, MIN (w, h) / 2);
+        gdouble k = r * 0.5523;   /* cubic approximation of a quarter circle */
+
+        if (r > 0.5)
+          {
+            c = chopgimp_coords (x + r, y);           stroke = gimp_bezier_stroke_new_moveto (&c);
+            c = chopgimp_coords (x + w - r, y);       gimp_bezier_stroke_lineto (stroke, &c);
+            c1 = chopgimp_coords (x + w - r + k, y);  c2 = chopgimp_coords (x + w, y + r - k);  c = chopgimp_coords (x + w, y + r);
+            gimp_bezier_stroke_cubicto (stroke, &c1, &c2, &c);
+            c = chopgimp_coords (x + w, y + h - r);   gimp_bezier_stroke_lineto (stroke, &c);
+            c1 = chopgimp_coords (x + w, y + h - r + k);  c2 = chopgimp_coords (x + w - r + k, y + h);  c = chopgimp_coords (x + w - r, y + h);
+            gimp_bezier_stroke_cubicto (stroke, &c1, &c2, &c);
+            c = chopgimp_coords (x + r, y + h);       gimp_bezier_stroke_lineto (stroke, &c);
+            c1 = chopgimp_coords (x + r - k, y + h);  c2 = chopgimp_coords (x, y + h - r + k);  c = chopgimp_coords (x, y + h - r);
+            gimp_bezier_stroke_cubicto (stroke, &c1, &c2, &c);
+            c = chopgimp_coords (x, y + r);           gimp_bezier_stroke_lineto (stroke, &c);
+            c1 = chopgimp_coords (x, y + r - k);      c2 = chopgimp_coords (x + r - k, y);  c = chopgimp_coords (x + r, y);
+            gimp_bezier_stroke_cubicto (stroke, &c1, &c2, &c);
+            gimp_stroke_close (stroke);
+            return stroke;
+          }
+      }
+      /* fall through: radius 0 = plain rectangle */
+
+    case CHOPGIMP_SHAPE_RECTANGLE:
+      pts[0].x = x;     pts[0].y = y;
+      pts[1].x = x + w; pts[1].y = y;
+      pts[2].x = x + w; pts[2].y = y + h;
+      pts[3].x = x;     pts[3].y = y + h;
+      n = 4;
+      break;
+
+    case CHOPGIMP_SHAPE_POLYGON:
+    case CHOPGIMP_SHAPE_STAR:
+      n = shape_vertices (options, x, y, w, h, pts);
+      break;
+
+    default:
+      return NULL;
+    }
+
+  c      = chopgimp_coords (pts[0].x, pts[0].y);
+  stroke = gimp_bezier_stroke_new_moveto (&c);
+
+  for (i = 1; i < n; i++)
+    {
+      c = chopgimp_coords (pts[i].x, pts[i].y);
+      gimp_bezier_stroke_lineto (stroke, &c);
+    }
+
+  gimp_stroke_close (stroke);
+
+  return stroke;
+}
+
+/*  3.29.0: Spirale, Arc, Grilles (several strokes for the grids); NULL
+ *  for the other shapes (shape_build_stroke)
+ */
+static GList *
+shape_build_extra (GimpShapeTool    *shape,
+                   GimpShapeOptions *options)
+{
+  GList      *list = NULL;
+  GimpStroke *st;
+  GimpCoords  c, c1, c2;
+  gdouble     x, y, w, h;
+  const gdouble k = 0.5523;
+
+  shape_bounds (shape, &x, &y, &w, &h);
+
+  if (w < 1 && h < 1)
+    return NULL;
+
+  switch (options->shape_type)
+    {
+    case CHOPGIMP_SHAPE_SPIRAL:
+      {
+        /*  from the outside (start point side) to the center, a
+         *  logarithmic spiral: the radius × decay per turn; one cubic per
+         *  quarter turn
+         */
+        gdouble cx    = x + w / 2, cy = y + h / 2;
+        gdouble rx    = w / 2, ry = h / 2;
+        gdouble decay = options->spiral_decay / 100.0;
+        gint    n     = MAX (1, (gint) (options->spiral_turns * 4 + 0.5));
+        gdouble a0    = atan2 (shape->start_y - cy, shape->start_x - cx);
+        gdouble prev_x = 0, prev_y = 0, prev_tx = 0, prev_ty = 0;
+
+        st = NULL;
+
+        for (gint i = 0; i <= n; i++)
+          {
+            gdouble a   = a0 + i * G_PI / 2;
+            gdouble f   = pow (decay, i / 4.0);
+            gdouble px  = cx + rx * f * cos (a);
+            gdouble py  = cy + ry * f * sin (a);
+            /*  the derivative of (f(a) cos a, f(a) sin a) per quarter turn  */
+            gdouble lf  = log (decay) / (2 * G_PI);
+            gdouble tx  = rx * f * (lf * cos (a) - sin (a)) * (G_PI / 2) / 3.0;
+            gdouble ty  = ry * f * (lf * sin (a) + cos (a)) * (G_PI / 2) / 3.0;
+
+            if (i == 0)
+              {
+                c  = chopgimp_coords (px, py);
+                st = gimp_bezier_stroke_new_moveto (&c);
+              }
+            else
+              {
+                c1 = chopgimp_coords (prev_x + prev_tx, prev_y + prev_ty);
+                c2 = chopgimp_coords (px - tx, py - ty);
+                c  = chopgimp_coords (px, py);
+                gimp_bezier_stroke_cubicto (st, &c1, &c2, &c);
+              }
+
+            prev_x = px; prev_y = py; prev_tx = tx; prev_ty = ty;
+          }
+
+        list = g_list_append (list, st);
+      }
+      break;
+
+    case CHOPGIMP_SHAPE_ARC:
+      {
+        /*  a quarter ellipse from the bottom left to the top right of the
+         *  box; convex: centred on the top left corner, concave: on the
+         *  bottom right one; closed: through that corner
+         */
+        gdouble ox = options->arc_concave ? x + w : x;
+        gdouble oy = options->arc_concave ? y + h : y;
+
+        c  = chopgimp_coords (x, y + h);
+        st = gimp_bezier_stroke_new_moveto (&c);
+
+        if (options->arc_concave)
+          {
+            c1 = chopgimp_coords (x, y + h - k * h);
+            c2 = chopgimp_coords (x + w - k * w, y);
+          }
+        else
+          {
+            c1 = chopgimp_coords (x + k * w, y + h);
+            c2 = chopgimp_coords (x + w, y + k * h);
+          }
+
+        c = chopgimp_coords (x + w, y);
+        gimp_bezier_stroke_cubicto (st, &c1, &c2, &c);
+
+        if (options->arc_closed)
+          {
+            c = chopgimp_coords (ox, oy);
+            gimp_bezier_stroke_lineto (st, &c);
+            gimp_stroke_close (st);
+          }
+
+        list = g_list_append (list, st);
+      }
+      break;
+
+    case CHOPGIMP_SHAPE_RECT_GRID:
+      {
+        gint rows = MAX (1, options->grid_rows);
+        gint cols = MAX (1, options->grid_cols);
+
+        for (gint i = 1; i < rows; i++)
+          {
+            c  = chopgimp_coords (x, y + h * i / rows);
+            st = gimp_bezier_stroke_new_moveto (&c);
+            c  = chopgimp_coords (x + w, y + h * i / rows);
+            gimp_bezier_stroke_lineto (st, &c);
+            list = g_list_append (list, st);
+          }
+
+        for (gint i = 1; i < cols; i++)
+          {
+            c  = chopgimp_coords (x + w * i / cols, y);
+            st = gimp_bezier_stroke_new_moveto (&c);
+            c  = chopgimp_coords (x + w * i / cols, y + h);
+            gimp_bezier_stroke_lineto (st, &c);
+            list = g_list_append (list, st);
+          }
+
+        if (options->grid_frame)
+          {
+            c  = chopgimp_coords (x, y);         st = gimp_bezier_stroke_new_moveto (&c);
+            c  = chopgimp_coords (x + w, y);     gimp_bezier_stroke_lineto (st, &c);
+            c  = chopgimp_coords (x + w, y + h); gimp_bezier_stroke_lineto (st, &c);
+            c  = chopgimp_coords (x, y + h);     gimp_bezier_stroke_lineto (st, &c);
+            gimp_stroke_close (st);
+            list = g_list_append (list, st);
+          }
+      }
+      break;
+
+    case CHOPGIMP_SHAPE_POLAR_GRID:
+      {
+        gint    rings    = MAX (1, options->grid_rows);
+        gint    dividers = MAX (0, options->grid_cols);
+        gdouble cx       = x + w / 2, cy = y + h / 2;
+
+        for (gint i = 1; i <= rings; i++)
+          {
+            if (i == rings && ! options->grid_frame)
+              break;
+
+            c  = chopgimp_coords (cx, cy);
+            st = gimp_bezier_stroke_new_ellipse (&c, w / 2 * i / rings,
+                                                 h / 2 * i / rings, 0.0);
+            list = g_list_append (list, st);
+          }
+
+        for (gint i = 0; i < dividers; i++)
+          {
+            gdouble a = -G_PI / 2 + 2 * G_PI * i / dividers;
+
+            c  = chopgimp_coords (cx, cy);
+            st = gimp_bezier_stroke_new_moveto (&c);
+            c  = chopgimp_coords (cx + w / 2 * cos (a), cy + h / 2 * sin (a));
+            gimp_bezier_stroke_lineto (st, &c);
+            list = g_list_append (list, st);
+          }
+      }
+      break;
+
+    default:
+      break;
+    }
+
+  return list;
+}
+
+/*  adds @stroke and the strokes of @extra (unref'ed / freed) to @path  */
+static void
+shape_add_strokes (GimpPath   *path,
+                   GimpStroke *stroke,
+                   GList      *extra)
+{
+  if (stroke)
+    {
+      gimp_path_stroke_add (path, stroke);
+      g_object_unref (stroke);
+    }
+
+  for (GList *l = extra; l; l = l->next)
+    {
+      gimp_path_stroke_add (path, l->data);
+      g_object_unref (l->data);
+    }
+
+  g_list_free (extra);
+}
+
+/*  open shapes: stroked, not filled  */
+static gboolean
+shape_is_open (GimpShapeOptions *options)
+{
+  switch (options->shape_type)
+    {
+    case CHOPGIMP_SHAPE_LINE:
+    case CHOPGIMP_SHAPE_SPIRAL:
+    case CHOPGIMP_SHAPE_RECT_GRID:
+    case CHOPGIMP_SHAPE_POLAR_GRID:
+      return TRUE;
+    case CHOPGIMP_SHAPE_ARC:
+      return ! options->arc_closed;
+    default:
+      return FALSE;
+    }
+}
+
+/*  3.31.0: the homography of the plane the shape is drawn on  */
+static gboolean
+shape_persp_matrix (GimpShapeTool *shape,
+                    GimpImage     *image,
+                    GimpMatrix3   *H)
+{
+  ChopGimpPGrid g;
+
+  if (shape->persp_plane == CHOPGIMP_PLANE_NONE || ! image ||
+      ! chopgimp_pgrid_get (image, &g))
+    return FALSE;
+
+  chopgimp_pgrid_plane_matrix (&g, shape->persp_plane, H);
+
+  return TRUE;
+}
+
+/*  image → flat coordinates of the plane (snapped to the grid lines);
+ *  FALSE beyond the horizon
+ */
+static gboolean
+shape_persp_point (GimpShapeTool *shape,
+                   GimpImage     *image,
+                   gdouble        x,
+                   gdouble        y,
+                   gdouble       *u,
+                   gdouble       *v)
+{
+  ChopGimpPGrid g;
+
+  if (! image || ! chopgimp_pgrid_get (image, &g) ||
+      ! chopgimp_pgrid_to_plane (&g, shape->persp_plane, x, y, u, v))
+    return FALSE;
+
+  if (g.snap)
+    chopgimp_pgrid_snap (&g, u, v, g.cell * 0.2);
+
+  return TRUE;
+}
+
+static void
+shape_create_layer (GimpShapeTool *shape,
+                    GimpDisplay   *display)
+{
+  GimpShapeOptions *options = GIMP_SHAPE_OPTIONS (gimp_tool_get_options (GIMP_TOOL (shape)));
+  GimpPathOptions  *popts   = GIMP_PATH_OPTIONS (options);
+  GimpImage        *image   = gimp_display_get_image (display);
+  GimpStroke       *stroke  = shape_build_stroke (shape, options);
+  GList            *extra   = stroke ? NULL : shape_build_extra (shape, options);
+  GimpPath         *path;
+  GimpVectorLayer  *layer;
+  gboolean          is_line = shape_is_open (options);
+  GEnumValue       *ev;
+  GEnumClass       *ec;
+  const gchar      *name;
+
+  if (! stroke && ! extra)
+    return;
+
+  gimp_path_options_ensure_fill_stroke (popts);
+
+  ec   = g_type_class_ref (chopgimp_shape_type_get_type ());
+  ev   = g_enum_get_value (ec, options->shape_type);
+  name = gimp_enum_value_get_desc (ec, ev);
+
+  /*  ChopGimp lot V2 (Illustrator): « Ajouter au calque vectoriel actif »:
+   *  the shape becomes an object of the selected vector layer
+   */
+  if (popts->add_to_vector_layer &&
+      (layer = chopgimp_vobjects_get_target_layer (image)))
+    {
+      ChopGimpVStyle style;
+
+      ChopGimpVObject *obj;
+      GimpMatrix3      H;
+
+      path = gimp_path_new (image, name);
+      g_object_ref_sink (path);
+      shape_add_strokes (path, stroke, extra);
+
+      if (shape_persp_matrix (shape, image, &H))
+        chopgimp_vpath_transform (path, &H);
+
+      chopgimp_vobjects_style_from_tool (&style, image,
+                                         is_line ? FALSE : popts->enable_fill,
+                                         popts->fill_options,
+                                         is_line ? TRUE  : popts->enable_stroke,
+                                         popts->stroke_options);
+
+      shape->loading = TRUE;   /* the new object is selected: no restyling */
+      obj = chopgimp_vobjects_add_path (layer, path, name, &style);
+      shape->loading = FALSE;
+
+      /*  3.31.0: it belongs to the plane (Sélection de perspective)  */
+      if (obj && shape->persp_plane != CHOPGIMP_PLANE_NONE)
+        chopgimp_pgrid_item_set_plane (GIMP_ITEM (layer), obj->id, shape->persp_plane, FALSE);
+
+      chopgimp_vstyle_clear (&style);
+      g_object_unref (path);
+
+      gimp_image_flush (image);
+      g_type_class_unref (ec);
+      return;
+    }
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_DRAWABLE, name);
+
+  path = gimp_path_new (image, name);
+  shape_add_strokes (path, stroke, extra);
+
+  {
+    GimpMatrix3 H;
+
+    if (shape_persp_matrix (shape, image, &H))
+      chopgimp_vpath_transform (path, &H);
+  }
+
+  gimp_image_add_path (image, path, GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+
+  layer = gimp_vector_layer_new (image, path, gimp_get_user_context (image->gimp));
+
+  g_object_set (layer->options,
+                "enable-fill",   is_line ? FALSE : popts->enable_fill,
+                "enable-stroke", is_line ? TRUE  : popts->enable_stroke,
+                NULL);
+  gimp_config_sync (G_OBJECT (popts->fill_options),
+                    G_OBJECT (layer->options->fill_options), 0);
+  gimp_config_sync (G_OBJECT (popts->stroke_options),
+                    G_OBJECT (layer->options->stroke_options), 0);
+
+  gimp_image_add_layer (image, GIMP_LAYER (layer), GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+  gimp_vector_layer_refresh (layer);
+
+  if (shape->persp_plane != CHOPGIMP_PLANE_NONE)
+    chopgimp_pgrid_item_set_plane (GIMP_ITEM (layer), 0, shape->persp_plane, TRUE);
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+
+  g_type_class_unref (ec);
+}
+
+static void
+gimp_shape_tool_button_press (GimpTool            *tool,
+                              const GimpCoords    *coords,
+                              guint32              time,
+                              GdkModifierType      state,
+                              GimpButtonPressType  press_type,
+                              GimpDisplay         *display)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (tool);
+
+  if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+  tool->display = display;
+
+  shape->start_x = shape->cur_x = coords->x;
+  shape->start_y = shape->cur_y = coords->y;
+
+  /*  3.31.0: on the active plane of the perspective grid, the shape is
+   *  drawn in the flat coordinates of the plane
+   */
+  shape->persp_plane = chopgimp_pgrid_get_active_plane (gimp_display_get_image (display));
+
+  if (shape->persp_plane != CHOPGIMP_PLANE_NONE)
+    {
+      gdouble u, v;
+
+      if (shape_persp_point (shape, gimp_display_get_image (display),
+                             coords->x, coords->y, &u, &v))
+        {
+          shape->start_x = shape->cur_x = u;
+          shape->start_y = shape->cur_y = v;
+        }
+      else
+        {
+          shape->persp_plane = CHOPGIMP_PLANE_NONE;
+        }
+    }
+  shape->constrain   = (state & gimp_get_extend_selection_mask ()) != 0;
+  shape->from_center = (state & GDK_MOD1_MASK) != 0;
+
+  gimp_tool_control_activate (tool->control);
+  gimp_draw_tool_start (GIMP_DRAW_TOOL (tool), display);
+}
+
+static void
+gimp_shape_tool_motion (GimpTool         *tool,
+                        const GimpCoords *coords,
+                        guint32           time,
+                        GdkModifierType   state,
+                        GimpDisplay      *display)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (tool);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  if (shape->persp_plane != CHOPGIMP_PLANE_NONE)
+    {
+      gdouble u, v;
+
+      if (shape_persp_point (shape, gimp_display_get_image (display),
+                             coords->x, coords->y, &u, &v))
+        {
+          shape->cur_x = u;
+          shape->cur_y = v;
+        }
+    }
+  else
+    {
+      shape->cur_x = coords->x;
+      shape->cur_y = coords->y;
+    }
+
+  shape->constrain   = (state & gimp_get_extend_selection_mask ()) != 0;
+  shape->from_center = (state & GDK_MOD1_MASK) != 0;
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_shape_tool_active_modifier_key (GimpTool        *tool,
+                                     GdkModifierType  key,
+                                     gboolean         press,
+                                     GdkModifierType  state,
+                                     GimpDisplay     *display)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (tool);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+  shape->constrain   = (state & gimp_get_extend_selection_mask ()) != 0;
+  shape->from_center = (state & GDK_MOD1_MASK) != 0;
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_shape_tool_button_release (GimpTool              *tool,
+                                const GimpCoords      *coords,
+                                guint32                time,
+                                GdkModifierType        state,
+                                GimpButtonReleaseType  release_type,
+                                GimpDisplay           *display)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (tool);
+  gdouble        x, y, w, h;
+
+  gimp_tool_control_halt (tool->control);
+  gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+  if (release_type == GIMP_BUTTON_RELEASE_CANCEL)
+    return;
+
+  shape_bounds (shape, &x, &y, &w, &h);
+
+  if (GIMP_SHAPE_OPTIONS (gimp_tool_get_options (tool))->shape_type == CHOPGIMP_SHAPE_LINE)
+    {
+      if (fabs (shape->cur_x - shape->start_x) + fabs (shape->cur_y - shape->start_y) < 2)
+        return;
+    }
+  else if (w < 2 || h < 2)
+    {
+      return;
+    }
+
+  shape_create_layer (shape, display);
+}
+
+static void
+gimp_shape_tool_draw (GimpDrawTool *draw_tool)
+{
+  GimpShapeTool    *shape   = GIMP_SHAPE_TOOL (draw_tool);
+  GimpShapeOptions *options = GIMP_SHAPE_OPTIONS (gimp_tool_get_options (GIMP_TOOL (draw_tool)));
+  gdouble           x, y, w, h;
+  GimpVector2       pts[130];
+  gint              n;
+
+  shape_bounds (shape, &x, &y, &w, &h);
+
+  /*  3.31.0: on a plane of the perspective grid, the outline of the
+   *  shape through the plane's homography
+   */
+  if (shape->persp_plane != CHOPGIMP_PLANE_NONE)
+    {
+      GimpDisplay *display = GIMP_TOOL (draw_tool)->display;
+      GimpImage   *image   = display ? gimp_display_get_image (display) : NULL;
+      GimpMatrix3  H;
+
+      if (image && shape_persp_matrix (shape, image, &H))
+        {
+          GimpStroke *stroke = shape_build_stroke (shape, options);
+          GList      *extra  = stroke ? NULL : shape_build_extra (shape, options);
+          GimpPath   *path   = gimp_path_new (image, "preview");
+
+          g_object_ref_sink (path);
+          shape_add_strokes (path, stroke, extra);
+          chopgimp_vpath_transform (path, &H);
+
+          if (gimp_path_get_bezier (path))
+            {
+              GimpCanvasItem *item =
+                gimp_canvas_path_new (gimp_display_get_shell (display),
+                                      gimp_path_get_bezier (path), 0, 0, FALSE,
+                                      GIMP_PATH_STYLE_DEFAULT);
+
+              gimp_draw_tool_add_item (draw_tool, item);
+              g_object_unref (item);
+            }
+
+          g_object_unref (path);
+        }
+
+      return;
+    }
+
+  switch (options->shape_type)
+    {
+    case CHOPGIMP_SHAPE_LINE:
+      {
+        gdouble ex, ey;
+
+        shape_line_end (shape, &ex, &ey);
+        gimp_draw_tool_add_line (draw_tool, shape->start_x, shape->start_y, ex, ey);
+      }
+      break;
+
+    case CHOPGIMP_SHAPE_ELLIPSE:
+      gimp_draw_tool_add_arc (draw_tool, FALSE, x, y, w, h, 0.0, 2 * G_PI);
+      break;
+
+    case CHOPGIMP_SHAPE_POLYGON:
+    case CHOPGIMP_SHAPE_STAR:
+      n = shape_vertices (options, x, y, w, h, pts);
+      gimp_draw_tool_add_lines (draw_tool, pts, n, NULL, FALSE);
+      gimp_draw_tool_add_line (draw_tool, pts[n - 1].x, pts[n - 1].y, pts[0].x, pts[0].y);
+      break;
+
+    case CHOPGIMP_SHAPE_SPIRAL:
+    case CHOPGIMP_SHAPE_ARC:
+    case CHOPGIMP_SHAPE_RECT_GRID:
+    case CHOPGIMP_SHAPE_POLAR_GRID:
+      {
+        GimpDisplay *display = GIMP_TOOL (draw_tool)->display;
+        GimpImage   *image   = display ? gimp_display_get_image (display) : NULL;
+        GList       *extra   = image ? shape_build_extra (shape, options) : NULL;
+
+        if (extra)
+          {
+            GimpPath       *path = gimp_path_new (image, "preview");
+            GimpCanvasItem *item;
+
+            g_object_ref_sink (path);
+            shape_add_strokes (path, NULL, extra);
+
+            if (gimp_path_get_bezier (path))
+              {
+                item = gimp_canvas_path_new (gimp_display_get_shell (display),
+                                             gimp_path_get_bezier (path), 0, 0, FALSE,
+                                             GIMP_PATH_STYLE_DEFAULT);
+                gimp_draw_tool_add_item (draw_tool, item);
+                g_object_unref (item);
+              }
+
+            g_object_unref (path);
+          }
+      }
+      break;
+
+    default:
+      gimp_draw_tool_add_rectangle (draw_tool, FALSE, x, y, w, h);
+      break;
+    }
+}
+
+
+/*  ── Photoshop: the options bar edits the selected shape ─────────── */
+
+static GimpVectorLayer *
+shape_selected_vector_layer (GimpShapeTool *shape)
+{
+  GList *layers;
+
+  if (! shape->image)
+    return NULL;
+
+  layers = gimp_image_get_selected_layers (shape->image);
+
+  /*  not a rasterized one: its pixels would be overwritten  */
+  if (g_list_length (layers) == 1 &&
+      gimp_item_is_vector_layer (GIMP_ITEM (layers->data)))
+    return layers->data;
+
+  return NULL;
+}
+
+/*  selected shape → options (so the bar shows its fill / stroke)  */
+static void
+shape_load_from_layer (GimpShapeTool *shape)
+{
+  GimpVectorLayer *layer = shape_selected_vector_layer (shape);
+  GimpPathOptions *popts;
+
+  if (! layer || ! layer->options)
+    return;
+
+  popts = GIMP_PATH_OPTIONS (gimp_tool_get_options (GIMP_TOOL (shape)));
+  gimp_path_options_ensure_fill_stroke (popts);
+
+  /*  ChopGimp 4.1.1: a layer of objects: the options show the selection
+   *  (the one selection watcher, chopgimp-tools.c)
+   */
+  if (chopgimp_vobjects_layer_is_multi (layer))
+    {
+      chopgimp_vselection_sync ();
+      return;
+    }
+
+  shape->loading = TRUE;
+  g_object_set (popts,
+                "enable-fill",   layer->options->enable_fill,
+                "enable-stroke", layer->options->enable_stroke,
+                NULL);
+  gimp_config_sync (G_OBJECT (layer->options->fill_options),
+                    G_OBJECT (popts->fill_options), 0);
+  gimp_config_sync (G_OBJECT (layer->options->stroke_options),
+                    G_OBJECT (popts->stroke_options), 0);
+  shape->loading = FALSE;
+}
+
+/*  options changed in the bar → selected shape  */
+static void
+shape_options_notify (GObject       *object,
+                      GParamSpec    *pspec,
+                      GimpShapeTool *shape)
+{
+  GimpVectorLayer *layer;
+  GimpPathOptions *popts;
+
+  if (shape->loading)
+    return;
+
+  layer = shape_selected_vector_layer (shape);
+  if (! layer || ! layer->options)
+    return;
+
+  popts = GIMP_PATH_OPTIONS (gimp_tool_get_options (GIMP_TOOL (shape)));
+
+  if (object != G_OBJECT (popts->fill_options)   &&
+      object != G_OBJECT (popts->stroke_options) &&
+      strcmp (pspec->name, "enable-fill") && strcmp (pspec->name, "enable-stroke"))
+    return;
+
+  /*  ChopGimp 4.1.1: a layer of objects: the selected ones get the fill
+   *  (or the stroke) of the bar, by the one selection watcher
+   *  (chopgimp-tools.c); nothing selected: only the next shapes
+   */
+  if (chopgimp_vobjects_layer_is_multi (layer))
+    return;
+
+  /*  undoable; a burst of changes (a slider) is one step, separate
+   *  edits a moment apart are not
+   */
+  {
+    GimpUndo *undo = gimp_image_undo_can_compress (shape->image,
+                                                   GIMP_TYPE_VECTOR_LAYER_UNDO,
+                                                   GIMP_UNDO_VECTOR_LAYER);
+
+    if (undo &&
+        GIMP_ITEM_UNDO (undo)->item == GIMP_ITEM (layer) &&
+        gimp_undo_get_age (undo) <= 1)
+      gimp_undo_reset_age (undo);
+    else
+      gimp_image_undo_push_vector_layer (shape->image, _("Style de la forme"),
+                                         layer, NULL);
+  }
+
+  if (object == G_OBJECT (popts->fill_options))
+    gimp_config_sync (object, G_OBJECT (layer->options->fill_options), 0);
+  else if (object == G_OBJECT (popts->stroke_options))
+    gimp_config_sync (object, G_OBJECT (layer->options->stroke_options), 0);
+  else if (! strcmp (pspec->name, "enable-fill") || ! strcmp (pspec->name, "enable-stroke"))
+    g_object_set (layer->options,
+                  "enable-fill",   popts->enable_fill,
+                  "enable-stroke", popts->enable_stroke,
+                  NULL);
+  else
+    return;
+
+  gimp_vector_layer_refresh (layer);
+  gimp_image_flush (shape->image);
+}
+
+static void
+shape_object_selection_changed (GimpVectorLayer *layer,
+                                GimpShapeTool   *shape)
+{
+  shape_load_from_layer (shape);
+}
+
+/*  ChopGimp lot V2: follow the object selection of the vector layer  */
+static void
+shape_watch_vlayer (GimpShapeTool *shape)
+{
+  GimpVectorLayer *layer = shape_selected_vector_layer (shape);
+
+  if (layer == shape->vlayer)
+    return;
+
+  if (shape->vlayer)
+    {
+      g_signal_handlers_disconnect_by_func (shape->vlayer,
+                                            shape_object_selection_changed, shape);
+      g_object_remove_weak_pointer (G_OBJECT (shape->vlayer),
+                                    (gpointer *) &shape->vlayer);
+    }
+
+  shape->vlayer = layer;
+
+  if (layer)
+    {
+      g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &shape->vlayer);
+      g_signal_connect (layer, "object-selection-changed",
+                        G_CALLBACK (shape_object_selection_changed), shape);
+    }
+}
+
+static void
+shape_selected_layers_changed (GimpImage     *image,
+                               GimpShapeTool *shape)
+{
+  shape_watch_vlayer (shape);
+  shape_load_from_layer (shape);
+}
+
+static void
+shape_image_changed (GimpContext   *context,
+                     GimpImage     *image,
+                     GimpShapeTool *shape)
+{
+  if (shape->image)
+    g_signal_handlers_disconnect_by_func (shape->image,
+                                          shape_selected_layers_changed, shape);
+
+  shape->image = image;
+
+  if (image)
+    {
+      g_signal_connect_object (image, "selected-layers-changed",
+                               G_CALLBACK (shape_selected_layers_changed), shape, 0);
+      shape_watch_vlayer (shape);
+      shape_load_from_layer (shape);
+    }
+}
+
+static void
+gimp_shape_tool_constructed (GObject *object)
+{
+  GimpShapeTool   *shape = GIMP_SHAPE_TOOL (object);
+  GimpTool        *tool  = GIMP_TOOL (object);
+  GimpPathOptions *popts;
+  GimpContext     *context;
+
+  G_OBJECT_CLASS (parent_class)->constructed (object);
+
+  popts = GIMP_PATH_OPTIONS (gimp_tool_get_options (tool));
+  gimp_path_options_ensure_fill_stroke (popts);
+
+  g_signal_connect_object (popts, "notify",
+                           G_CALLBACK (shape_options_notify), shape, 0);
+  g_signal_connect_object (popts->fill_options, "notify",
+                           G_CALLBACK (shape_options_notify), shape, 0);
+  g_signal_connect_object (popts->stroke_options, "notify",
+                           G_CALLBACK (shape_options_notify), shape, 0);
+
+  context = gimp_get_user_context (tool->tool_info->gimp);
+  g_signal_connect_object (context, "image-changed",
+                           G_CALLBACK (shape_image_changed), shape, 0);
+  shape_image_changed (context, gimp_context_get_image (context), shape);
+}
+
+static void
+gimp_shape_tool_finalize (GObject *object)
+{
+  GimpShapeTool *shape = GIMP_SHAPE_TOOL (object);
+
+  if (shape->image)
+    g_signal_handlers_disconnect_by_func (shape->image,
+                                          shape_selected_layers_changed, shape);
+
+  shape->image = NULL;
+  shape_watch_vlayer (shape);   /* NULL: unwatched */
+
+  G_OBJECT_CLASS (parent_class)->finalize (object);
+}
+
+static void
+gimp_shape_tool_class_init (GimpShapeToolClass *klass)
+{
+  GObjectClass      *object_class    = G_OBJECT_CLASS (klass);
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  object_class->constructed       = gimp_shape_tool_constructed;
+  object_class->finalize          = gimp_shape_tool_finalize;
+
+  tool_class->button_press        = gimp_shape_tool_button_press;
+  tool_class->button_release      = gimp_shape_tool_button_release;
+  tool_class->motion              = gimp_shape_tool_motion;
+  tool_class->active_modifier_key = gimp_shape_tool_active_modifier_key;
+
+  draw_tool_class->draw = gimp_shape_tool_draw;
+
+  /*  a new shape is a new layer: the selected layer may be anything  */
+  tool_class->is_destructive = FALSE;
+}
+
+static void
+gimp_shape_tool_init (GimpShapeTool *shape)
+{
+  GimpTool *tool = GIMP_TOOL (shape);
+
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_RECT_SELECT);
+  gimp_tool_control_set_precision   (tool->control, GIMP_CURSOR_PRECISION_SUBPIXEL);
+}
