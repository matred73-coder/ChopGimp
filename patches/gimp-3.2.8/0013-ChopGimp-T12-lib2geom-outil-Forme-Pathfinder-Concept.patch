+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-shapetool.h — ChopGimp: Photoshop-like Shape tool (U)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "gimpdrawtool.h"
+#include "gimppathoptions.h"
+
+typedef enum
+{
+  CHOPGIMP_SHAPE_RECTANGLE,
+  CHOPGIMP_SHAPE_ROUNDED_RECTANGLE,
+  CHOPGIMP_SHAPE_ELLIPSE,
+  CHOPGIMP_SHAPE_POLYGON,
+  CHOPGIMP_SHAPE_STAR,
+  CHOPGIMP_SHAPE_LINE,
+  CHOPGIMP_SHAPE_SPIRAL,       /* 3.29.0 */
+  CHOPGIMP_SHAPE_ARC,
+  CHOPGIMP_SHAPE_RECT_GRID,
+  CHOPGIMP_SHAPE_POLAR_GRID
+} ChopGimpShapeType;
+
+#define GIMP_TYPE_SHAPE_OPTIONS  (gimp_shape_options_get_type ())
+#define GIMP_SHAPE_OPTIONS(obj)  (G_TYPE_CHECK_INSTANCE_CAST ((obj), GIMP_TYPE_SHAPE_OPTIONS, GimpShapeOptions))
+#define GIMP_TYPE_SHAPE_TOOL     (gimp_shape_tool_get_type ())
+#define GIMP_SHAPE_TOOL(obj)     (G_TYPE_CHECK_INSTANCE_CAST ((obj), GIMP_TYPE_SHAPE_TOOL, GimpShapeTool))
+
+typedef struct _GimpShapeOptions      GimpShapeOptions;
+typedef struct _GimpToolOptionsClass  GimpShapeOptionsClass;
+typedef struct _GimpShapeTool     GimpShapeTool;
+typedef struct _GimpDrawToolClass GimpShapeToolClass;
+
+struct _GimpShapeOptions
+{
+  GimpPathOptions    parent_instance;
+
+  ChopGimpShapeType  shape_type;
+  gdouble            corner_radius;
+  gint               sides;
+  gdouble            star_ratio;
+
+  /*  3.29.0  */
+  gdouble            spiral_turns;
+  gdouble            spiral_decay;    /* % of the radius kept per turn   */
+  gboolean           arc_closed;
+  gboolean           arc_concave;
+  gint               grid_rows;       /* rectangular: rows; polar: rings */
+  gint               grid_cols;       /* rectangular: columns; polar:
+                                       * dividers                       */
+  gboolean           grid_frame;
+};
+
+struct _GimpShapeTool
+{
+  GimpDrawTool  parent_instance;
+
+  gdouble       start_x, start_y;
+  gdouble       cur_x,   cur_y;
+  gboolean      constrain;
+  gboolean      from_center;
+
+  /*  Photoshop: the options bar edits the selected shape layer  */
+  GimpImage    *image;
+  gboolean      loading;
+
+  /*  ChopGimp lot V2: its selected objects (weak)  */
+  GimpVectorLayer *vlayer;
+
+  /*  3.31.0: drawn on this plane of the perspective grid (0: none);
+   *  start / cur are then flat coordinates of the plane
+   */
+  gint             persp_plane;
+};
+
+GType   gimp_shape_options_get_type (void) G_GNUC_CONST;
+GType   gimp_shape_tool_get_type    (void) G_GNUC_CONST;
+
+void    gimp_shape_tool_register    (GimpToolRegisterCallback  callback,
+                                     gpointer                  data);
