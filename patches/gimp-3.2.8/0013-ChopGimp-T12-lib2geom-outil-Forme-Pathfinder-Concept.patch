+  if (path)
+    /*  same ownership as the generated procedures (gimp-path-copy…)  */
+    g_value_set_object (gimp_value_array_index (return_vals, 1), path);
+
+  return return_vals;
+}
+
+/*  ChopGimp lot V2: Pathfinder on the selected objects of the active
+ *  vector layer; FALSE (nothing done) when there are not two of them, the
+ *  plug-in then works on the layers as before
+ */
+static GimpValueArray *
+vobjects_pathfinder_invoker (GimpProcedure         *procedure,
+                             Gimp                  *gimp,
+                             GimpContext           *context,
+                             GimpProgress          *progress,
+                             const GimpValueArray  *args,
+                             GError               **error)
+{
+  GimpImage       *image = ARG_OBJECT (0);
+  GimpVectorLayer *layer = chopgimp_vobjects_get_active_layer (image);
+  gboolean         done  = FALSE;
+  GimpValueArray  *return_vals;
+
+  if (layer && chopgimp_vobjects_can_pathfinder (layer))
+    done = chopgimp_vobjects_pathfinder (layer, ARG_INT (1));
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), done);
+
+  return return_vals;
+}
+
+/*  3.27.6: the « distort-* » and width profile commands  */
+static gboolean
+chopgimp_vobjects_distort_command (GimpVectorLayer *layer,
+                                   const gchar     *cmd)
+{
+  gchar  **v = g_strsplit (cmd, ":", -1);
+  gint     n = g_strv_length (v);
+  gboolean done = FALSE;
+
+  if (! strcmp (v[0], "distort-warp"))
+    {
+      ChopGimpDistort d;
+
+      chopgimp_vdistort_init (&d);
+      d.mode = CHOPGIMP_DISTORT_WARP;
+      if (n > 1) { g_free (d.style); d.style = g_strdup (v[1]); }
+      if (n > 2) d.bend     = g_ascii_strtod (v[2], NULL);
+      if (n > 3) d.hdist    = g_ascii_strtod (v[3], NULL);
+      if (n > 4) d.vdist    = g_ascii_strtod (v[4], NULL);
+      if (n > 5) d.vertical = atoi (v[5]) != 0;
+      done = chopgimp_vdistort_make (layer, &d, "Déformation");
+      chopgimp_vdistort_clear (&d);
+    }
+  else if (! strcmp (v[0], "distort-mesh") || ! strcmp (v[0], "distort-free"))
+    {
+      ChopGimpDistort d;
+
+      chopgimp_vdistort_init (&d);
+      d.mode = strcmp (v[0], "distort-free") ? CHOPGIMP_DISTORT_MESH : CHOPGIMP_DISTORT_FREE;
+      if (d.mode == CHOPGIMP_DISTORT_MESH)
+        {
+          d.rows = n > 1 ? CLAMP (atoi (v[1]), 1, 20) : 4;
+          d.cols = n > 2 ? CLAMP (atoi (v[2]), 1, 20) : 4;
+        }
+      done = chopgimp_vdistort_make (layer, &d, "Enveloppe");
+      chopgimp_vdistort_clear (&d);
+    }
+  else if (! strcmp (v[0], "distort-mesh-point") && n == 4)
+    {
+      GList *t = chopgimp_vdistort_targets (layer);
+      gint   k = atoi (v[1]);
+
+      chopgimp_vlayer_push_undo (layer, "Modifier l'enveloppe");
+      for (GList *l = t; l; l = l->next)
+        {
+          ChopGimpDistort d;
+
+          chopgimp_vdistort_init (&d);
+          if (chopgimp_vdistort_get (l->data, &d) && d.mode != CHOPGIMP_DISTORT_WARP &&
+              k >= 0 && k < (d.rows + 1) * (d.cols + 1))
+            {
+              d.mesh[2 * k]     = g_ascii_strtod (v[2], NULL);
+              d.mesh[2 * k + 1] = g_ascii_strtod (v[3], NULL);
+              chopgimp_vdistort_set (layer, ((ChopGimpVObject *) l->data)->id, &d, FALSE);
+              done = TRUE;
+            }
+          chopgimp_vdistort_clear (&d);
+        }
+      g_list_free (t);
+    }
+  else if (! strcmp (v[0], "distort-top"))
+    done = chopgimp_vdistort_make_top (layer, n > 1 ? atoi (v[1]) : 4, n > 2 ? atoi (v[2]) : 8);
+  else if (! strcmp (v[0], "distort-to-mesh"))   /* 3.28.2 */
+    done = chopgimp_vdistort_convert_to_mesh (layer);
+  else if (! strcmp (v[0], "distort-expand"))
+    done = chopgimp_vdistort_expand (layer);
+  else if (! strcmp (v[0], "distort-release"))
+    done = chopgimp_vdistort_release (layer);
+  else if (! strcmp (v[0], "width-profile") || ! strcmp (v[0], "save-profile"))
+    {
+      const gchar *arg = strchr (cmd, ':') + 1;
+      GList       *t   = chopgimp_vdistort_targets (layer);
+
+      if (! strcmp (v[0], "save-profile"))
+        {
+          ChopGimpVEntry *e = t ? chopgimp_vstyle_get_stroke (&((ChopGimpVObject *) t->data)->style)
+                                : NULL;
+
+          if (e && *arg)
+            {
+              chopgimp_vstyle_save_profile (arg, chopgimp_vstyle_get_profile_points (e->profile));
+              done = TRUE;
+            }
+        }
+      else if (t)
+        {
+          chopgimp_vlayer_push_undo (layer, "Profil de largeur");
+          for (GList *l = t; l; l = l->next)
+            {
+              ChopGimpVObject *o = l->data;
+              ChopGimpVEntry  *e = chopgimp_vstyle_get_stroke (&o->style);
+
+              if (! e)
+                continue;
+
+              g_free (e->profile);
+              e->profile = strcmp (arg, "uniform") ? g_strdup (arg) : NULL;
+              chopgimp_vlayer_object_changed (layer, o);
+              done = TRUE;
+            }
+        }
+
+      g_list_free (t);
+    }
+
+  g_strfreev (v);
+
+  return done;
+}
+
+
+/*  3.29.1 « couleur et matière » commands (chopgimp-vmaterial.h):
+ *    select-at:<x>:<y>, select-add-at:<x>:<y>, blend-make, blend-steps:<n>, blend-distance:<px>, blend-smooth,
+ *    blend-release, blend-expand, blend-reverse, blend-spine,
+ *    mesh-make:<rows>:<cols>[:<look 0..2>[:<highlight 0..1>]],
+ *    mesh-insert:<u>:<v>:#rrggbb (box units, on the selected objects),
+ *    freeform-make, stroke-gradient:<0|1|2>,
+ *    opmask-make[:<flags>], opmask-release, opmask-toggle:<flag>,
+ *    pattern-make[:<name>], pattern-apply:<name>, pattern-edit,
+ *    pattern-finish, pattern-type:<grid|brick-row|brick-column|hex>
+ *  3.30.0: repeat-radial[:<n>], repeat-grid[:<cols>:<rows>], repeat-mirror,
+ *    repeat-release, repeat-expand, brush-callig[:<angle>:<round>:<size>],
+ *    brush-art, brush-pattern[:<spacing>], brush-scatter[:<spacing>:<scatter>],
+ *    brush-define, brush-release, brush-expand, blob:<size>:x,y;x,y…[:#rrggbb],
+ *    brush-callig-random:<av>:<dv>, brush-lib-add:<type>, brush-lib-tile:<tile>,
+ *    brush-lib-apply, brush-lib-size:<%>, brush-lib-remove,
+ *    repeat-handle:<handle>:<x>:<y>
+ */
+/*  3.30.0: the library brush of the brush-lib-* test commands  */
+static gchar *cmd_brush_id = NULL;
+
+static gboolean
+chopgimp_vmaterial_command (GimpVectorLayer *layer,
+                            GimpContext     *context,
+                            const gchar     *cmd,
+                            gboolean        *done)
+{
+  gchar **v = g_strsplit (cmd, ":", 5);
+  gint    n = g_strv_length (v);
+  gboolean known = TRUE;
+
+  *done = FALSE;
+
+  if (! strcmp (v[0], "drag-sim") && n >= 4)
+    {
+      /*  3.29.2 (bench, tests): an interactive drag of the selected
+       *  objects, @steps translations of (dx, dy) as the objects tool
+       *  makes them, then the end of the gesture
+       */
+      const guint *sel;
+      gint         n_sel = 0;
+      gdouble      dx    = g_ascii_strtod (v[1], NULL);
+      gdouble      dy    = g_ascii_strtod (v[2], NULL);
+      gint         steps = CLAMP (atoi (v[3]), 1, 10000);
+
+      sel = chopgimp_vlayer_get_selection (layer, &n_sel);
+
+      if (n_sel > 0)
+        {
+          guint *ids = g_memdup2 (sel, n_sel * sizeof (guint));
+
+          chopgimp_vlayer_push_undo (layer, "Déplacer les objets");
+          chopgimp_vlayer_begin_interactive (layer);
+
+          for (gint i = 0; i < steps; i++)
+            chopgimp_vlayer_translate (layer, ids, n_sel, dx, dy, FALSE);
+
+          chopgimp_vlayer_end_interactive (layer);
+          g_free (ids);
+          *done = TRUE;
+        }
+    }
+  else if ((! strcmp (v[0], "bench-undo") || ! strcmp (v[0], "bench-redo")))
+    {
+      GimpImage *image = gimp_item_get_image (GIMP_ITEM (layer));
+
+      *done = (v[0][6] == 'u') ? gimp_image_undo (image) : gimp_image_redo (image);
+    }
+  else if (! strcmp (v[0], "select-at") && n >= 3)
+    {
+      /*  the selectable object at (x, y), image coordinates (tests)  */
+      ChopGimpVObject *o = chopgimp_vlayer_hit_test (layer,
+                                                     g_ascii_strtod (v[1], NULL),
+                                                     g_ascii_strtod (v[2], NULL),
+                                                     2.0, CHOPGIMP_HIT_SELECTABLE);
+
+      if (o)
+        {
+          chopgimp_vlayer_set_selection (layer, &o->id, 1);
+          *done = TRUE;
+        }
+    }
+  else if (! strcmp (v[0], "select-add-at") && n >= 3)
+    {
+      /*  3.29.1: adds the selectable object at (x, y) (tests)  */
+      ChopGimpVObject *o = chopgimp_vlayer_hit_test (layer,
+                                                     g_ascii_strtod (v[1], NULL),
+                                                     g_ascii_strtod (v[2], NULL),
+                                                     2.0, CHOPGIMP_HIT_SELECTABLE);
+
+      if (o)
+        {
+          chopgimp_vlayer_select (layer, o->id, TRUE);
+          *done = TRUE;
+        }
+    }
+  else if (! strcmp (v[0], "blend-make"))
+    *done = chopgimp_vblend_make (layer) != NULL;
+  else if (! strcmp (v[0], "blend-steps") && n >= 2)
+    /*  3.29.5: « blend-steps:N:1 » = orienter le long du tracé  */
+    *done = chopgimp_vblend_set_options (layer, CHOPGIMP_BLEND_STEPS,
+                                         g_ascii_strtod (v[1], NULL),
+                                         n >= 3 && atoi (v[2]) != 0);
+  else if (! strcmp (v[0], "blend-distance") && n >= 2)
+    *done = chopgimp_vblend_set_options (layer, CHOPGIMP_BLEND_DISTANCE,
+                                         g_ascii_strtod (v[1], NULL), FALSE);
+  else if (! strcmp (v[0], "blend-smooth"))
+    *done = chopgimp_vblend_set_options (layer, CHOPGIMP_BLEND_SMOOTH, 0.0, FALSE);
+  else if (! strcmp (v[0], "blend-release"))
+    *done = chopgimp_vblend_release (layer);
+  else if (! strcmp (v[0], "blend-expand"))
+    *done = chopgimp_vblend_expand (layer);
+  else if (! strcmp (v[0], "blend-reverse"))
+    *done = chopgimp_vblend_reverse (layer);
+  else if (! strcmp (v[0], "blend-spine"))
+    *done = chopgimp_vblend_replace_spine (layer);
+  /*  3.30.0: Répétition, Formes de pinceau, Pinceau goutte (tests)  */
+  else if (! strcmp (v[0], "repeat-radial") || ! strcmp (v[0], "repeat-grid") ||
+           ! strcmp (v[0], "repeat-mirror"))
+    {
+      ChopGimpRepeatType    type = (v[0][7] == 'r') ? CHOPGIMP_REPEAT_RADIAL :
+                                   (v[0][7] == 'g') ? CHOPGIMP_REPEAT_GRID :
+                                                      CHOPGIMP_REPEAT_MIRROR;
+      ChopGimpRepeatOptions o;
+
+      if (chopgimp_vrepeat_any (layer) && chopgimp_vrepeat_get_options (layer, &o))
+        {
+          /*  on a repeat: its options (repeat-radial:<n>, repeat-grid:<cols>:<rows>)  */
+          o.type = type;
+          if (type == CHOPGIMP_REPEAT_RADIAL && n >= 2)
+            o.count = atoi (v[1]);
+          if (type == CHOPGIMP_REPEAT_GRID && n >= 3)
+            {
+              o.cols = atoi (v[1]);
+              o.rows = atoi (v[2]);
+            }
+          *done = chopgimp_vrepeat_set_options (layer, &o);
+        }
+      else
+        {
+          ChopGimpVObject *g = chopgimp_vrepeat_make (layer, type, NULL);
+
+          if (g && n >= 2 && chopgimp_vrepeat_get_options (layer, &o))
+            {
+              if (type == CHOPGIMP_REPEAT_RADIAL)
+                o.count = atoi (v[1]);
+              else if (type == CHOPGIMP_REPEAT_GRID && n >= 3)
+                {
+                  o.cols = atoi (v[1]);
+                  o.rows = atoi (v[2]);
+                }
+              chopgimp_vrepeat_set_options (layer, &o);
+            }
+
+          *done = g != NULL;
+        }
+    }
+  else if (! strcmp (v[0], "repeat-release"))
+    *done = chopgimp_vrepeat_release (layer);
+  else if (! strcmp (v[0], "repeat-expand"))
+    *done = chopgimp_vrepeat_expand (layer);
+  else if (! strcmp (v[0], "brush-callig") || ! strcmp (v[0], "brush-art") ||
+           ! strcmp (v[0], "brush-pattern") || ! strcmp (v[0], "brush-scatter"))
+    {
+      ChopGimpVBrushType    type = (v[0][6] == 'c') ? CHOPGIMP_VBRUSH_CALLIGRAPHIC :
+                                   (v[0][6] == 'a') ? CHOPGIMP_VBRUSH_ART :
+                                   (v[0][6] == 'p') ? CHOPGIMP_VBRUSH_PATTERN :
+                                                      CHOPGIMP_VBRUSH_SCATTER;
+      ChopGimpVBrushOptions o;
+
+      /*  brush-callig:<angle>:<roundness>:<size>, brush-scatter:<spacing>:<scatter>  */
+      chopgimp_vbrush_default_options (type, &o);
+      o.use_defined = (type != CHOPGIMP_VBRUSH_CALLIGRAPHIC) && chopgimp_vbrush_has_defined ();
+
+      if (type == CHOPGIMP_VBRUSH_CALLIGRAPHIC)
+        {
+          if (n >= 2) o.angle     = g_ascii_strtod (v[1], NULL);
+          if (n >= 3) o.roundness = g_ascii_strtod (v[2], NULL);
+          if (n >= 4) o.size      = g_ascii_strtod (v[3], NULL);
+        }
+      else if (n >= 2)
+        {
+          o.spacing = g_ascii_strtod (v[1], NULL);
+          if (n >= 3)
+            o.scatter = g_ascii_strtod (v[2], NULL);
+        }
+
+      *done = chopgimp_vbrush_apply (layer, &o);
+    }
+  else if (! strcmp (v[0], "brush-callig-random") && n >= 3)
+    {
+      /*  brush-callig-random:<angle var>:<diameter var px>: random nibs  */
+      ChopGimpVBrushOptions o;
+
+      chopgimp_vbrush_default_options (CHOPGIMP_VBRUSH_CALLIGRAPHIC, &o);
+      o.size       = 12;
+      o.angle_mode = CHOPGIMP_VBRUSH_RANDOM;
+      o.angle_var  = g_ascii_strtod (v[1], NULL);
+      o.diam_mode  = CHOPGIMP_VBRUSH_RANDOM;
+      o.diam_var   = g_ascii_strtod (v[2], NULL);
+      *done = chopgimp_vbrush_apply (layer, &o);
+    }
+  else if (! strcmp (v[0], "brush-lib-add") && n >= 2)
+    {
+      /*  brush-lib-add:<0..3>: a library brush from the selection (the
+       *  « current » one of the next brush-lib-* commands)
+       */
+      g_free (cmd_brush_id);
+      cmd_brush_id = chopgimp_vbrush_library_add (layer, CLAMP (atoi (v[1]), 0, 3), NULL);
+      *done = cmd_brush_id != NULL;
+    }
+  else if (! strcmp (v[0], "brush-lib-tile") && n >= 2 && cmd_brush_id)
+    *done = chopgimp_vbrush_library_set_tile (cmd_brush_id, layer, CLAMP (atoi (v[1]), 0, 4));
+  else if (! strcmp (v[0], "brush-lib-apply") && cmd_brush_id)
+    *done = chopgimp_vbrush_apply_def (layer, cmd_brush_id);
+  else if (! strcmp (v[0], "brush-lib-size") && n >= 2 && cmd_brush_id)
+    {
+      /*  the brush's size changes: the brushed paths of the image follow  */
+      GList                *lib = chopgimp_vbrush_library_list ();
+      ChopGimpVBrushOptions o;
+      gboolean              found = FALSE;
+
+      for (GList *l = lib; l; l = l->next)
+        if (! g_strcmp0 (((ChopGimpVBrushDef *) l->data)->id, cmd_brush_id))
+          found = chopgimp_vbrush_def_get_options (l->data, &o);
+
+      chopgimp_vbrush_library_free (lib);
+
+      if (found)
+        {
+          o.size = g_ascii_strtod (v[1], NULL);
+          *done = chopgimp_vbrush_library_set_options (cmd_brush_id, &o,
+                                                       gimp_item_get_image (GIMP_ITEM (layer)));
+        }
+    }
+  else if (! strcmp (v[0], "brush-lib-remove") && cmd_brush_id)
+    *done = chopgimp_vbrush_library_remove (cmd_brush_id);
+  else if (! strcmp (v[0], "repeat-handle") && n >= 4)
+    {
+      /*  repeat-handle:<ChopGimpRepeatHandle>:<x>:<y>: a widget dragged  */
+      chopgimp_vlayer_push_undo (layer, "Répétition");
+      *done = chopgimp_vrepeat_drag_handle (layer, atoi (v[1]),
+                                            g_ascii_strtod (v[2], NULL),
+                                            g_ascii_strtod (v[3], NULL));
+    }
+  else if (! strcmp (v[0], "brush-define"))
+    *done = chopgimp_vbrush_define (layer);
+  else if (! strcmp (v[0], "brush-release"))
+    *done = chopgimp_vbrush_release (layer);
+  else if (! strcmp (v[0], "brush-expand"))
+    *done = chopgimp_vbrush_expand (layer);
+  else if (! strcmp (v[0], "blob") && n >= 3)
+    {
+      /*  blob:<size>:x,y;x,y…[:#rrggbb]: a stroke of the Pinceau goutte  */
+      gchar          **pts = g_strsplit (v[2], ";", -1);
+      GArray          *xy  = g_array_new (FALSE, FALSE, sizeof (gdouble));
+      ChopGimpVStyle   st;
+      ChopGimpVEntry  *f;
+      GeglColor       *color = gegl_color_new ("black");
+
+      for (gint i = 0; pts[i]; i++)
+        {
+          gchar **c = g_strsplit (pts[i], ",", 2);
+
+          if (c[0] && c[1])
+            {
+              gdouble x = g_ascii_strtod (c[0], NULL), y = g_ascii_strtod (c[1], NULL);
+
+              g_array_append_val (xy, x);
+              g_array_append_val (xy, y);
+            }
+
+          g_strfreev (c);
+        }
+
+      if (n >= 4 && strlen (v[3]) == 7 && v[3][0] == '#')
+        {
+          guint   rgb = (guint) g_ascii_strtoull (v[3] + 1, NULL, 16);
+          gdouble c[4] = { ((rgb >> 16) & 0xff) / 255.0, ((rgb >> 8) & 0xff) / 255.0,
+                           (rgb & 0xff) / 255.0, 1.0 };
+
+          gegl_color_set_pixel (color, babl_format ("R'G'B'A double"), c);
+        }
+
+      chopgimp_vstyle_init (&st);
+      f = chopgimp_vstyle_ensure_fill (&st);
+      chopgimp_vpaint_set_color (&f->paint, color);
+
+      *done = xy->len >= 2 &&
+              chopgimp_vblob_paint (layer, (gdouble *) xy->data, xy->len / 2,
+                                    g_ascii_strtod (v[1], NULL), 0.5, &st, FALSE) != NULL;
+
+      chopgimp_vstyle_clear (&st);
+      g_object_unref (color);
+      g_array_free (xy, TRUE);
+      g_strfreev (pts);
+    }
+  else if (! strcmp (v[0], "mesh-make") && n >= 3)
+    *done = chopgimp_vmaterial_make_mesh (layer, atoi (v[1]), atoi (v[2]),
+                                          n >= 4 ? atoi (v[3]) : CHOPGIMP_MESH_FLAT,
+                                          n >= 5 ? g_ascii_strtod (v[4], NULL) : 1.0);
+  else if (! strcmp (v[0], "mesh-insert") && n >= 4)
+    {
+      GList   *sel = chopgimp_vlayer_get_selected_objects (layer);
+      gdouble  rgba[4] = { 0, 0, 0, 1 };
+
+      if (strlen (v[3]) == 7 && v[3][0] == '#')
+        {
+          guint rgb = (guint) g_ascii_strtoull (v[3] + 1, NULL, 16);
+
+          rgba[0] = ((rgb >> 16) & 0xff) / 255.0;
+          rgba[1] = ((rgb >> 8) & 0xff) / 255.0;
+          rgba[2] = (rgb & 0xff) / 255.0;
+        }
+
+      if (sel)
+        chopgimp_vlayer_push_undo (layer, "Filet");
+
+      for (GList *l = sel; l; l = l->next)
+        {
+          ChopGimpVObject *o = l->data;
+          ChopGimpVEntry  *f = (o->kind == CHOPGIMP_VOBJECT_PATH)
+                               ? chopgimp_vstyle_get_fill (&o->style) : NULL;
+          ChopGimpMesh     m;
+
+          if (f && f->paint.type == CHOPGIMP_PAINT_MESH &&
+              chopgimp_vmesh_parse (f->paint.material, &m))
+            {
+              if (chopgimp_vmesh_insert (&m, g_ascii_strtod (v[1], NULL),
+                                         g_ascii_strtod (v[2], NULL), rgba))
+                {
+                  ChopGimpVStyle  st;
+                  ChopGimpVEntry *e;
+                  gchar          *spec = chopgimp_vmesh_to_spec (&m);
+
+                  chopgimp_vstyle_init (&st);
+                  chopgimp_vstyle_copy (&st, &o->style);
+                  e = chopgimp_vstyle_get_fill (&st);
+                  chopgimp_vpaint_set_material (&e->paint, CHOPGIMP_PAINT_MESH, spec,
+                                                e->paint.color);
+                  chopgimp_vlayer_set_style (layer, o->id, &st, FALSE);
+                  chopgimp_vstyle_clear (&st);
+                  g_free (spec);
+                  *done = TRUE;
+                }
+
+              chopgimp_vmesh_clear (&m);
+            }
+        }
+
+      g_list_free (sel);
+    }
+  else if (! strcmp (v[0], "freeform-make"))
+    *done = chopgimp_vmaterial_make_freeform (layer,
+                                              gimp_context_get_foreground (context),
+                                              gimp_context_get_background (context));
+  else if (! strcmp (v[0], "stroke-gradient") && n >= 2)
+    *done = chopgimp_vmaterial_set_stroke_gradient (layer, atoi (v[1]));
+  else if (! strcmp (v[0], "opmask-make"))
+    *done = chopgimp_vmaterial_opmask_make (layer, n >= 2 ? atoi (v[1])
+                                                          : CHOPGIMP_OPMASK_CLIP);
+  else if (! strcmp (v[0], "opmask-release"))
+    *done = chopgimp_vmaterial_opmask_release (layer);
+  else if (! strcmp (v[0], "opmask-toggle") && n >= 2)
+    *done = chopgimp_vmaterial_opmask_toggle (layer, atoi (v[1]));
+  else if (! strcmp (v[0], "pattern-make"))
+    {
+      gchar *spec = chopgimp_vmaterial_pattern_from_selection (layer,
+                                                               n >= 2 ? strchr (cmd, ':') + 1
+                                                                      : NULL);
+
+      *done = spec != NULL;
+      g_free (spec);
+    }
+  else if (! strcmp (v[0], "pattern-apply") && n >= 2)
+    {
+      GimpImage  *image = gimp_item_get_image (GIMP_ITEM (layer));
+      gchar     **specs = chopgimp_vpatterns_list (image);
+      const gchar *name = strchr (cmd, ':') + 1;
+
+      for (gint i = 0; specs[i] && ! *done; i++)
+        {
+          ChopGimpVPattern p;
+
+          if (chopgimp_vpattern_parse (specs[i], &p))
+            {
+              if (! g_strcmp0 (p.name, name))
+                *done = chopgimp_vmaterial_apply_pattern (layer, specs[i]);
+              chopgimp_vpattern_clear (&p);
+            }
+        }
+
+      g_strfreev (specs);
+    }
+  else if (! strcmp (v[0], "pattern-edit"))
+    *done = chopgimp_vmaterial_pattern_edit (layer);
+  else if (! strcmp (v[0], "pattern-finish"))
+    *done = chopgimp_vmaterial_pattern_finish (layer);
+  else if (! strcmp (v[0], "pattern-type") && n >= 2)
+    {
+      /*  the pattern of the selected objects' fill takes the tiling  */
+      GList *sel    = chopgimp_vlayer_get_selected_objects (layer);
+      GList *leaves = NULL;
+      gchar *spec   = NULL;
+
+      /*  the leaves of the selected groups too  */
+      for (GList *l = sel; l; l = l->next)
+        leaves = g_list_concat (leaves, chopgimp_vobjects_leaves_of (l->data));
+
+      for (GList *l = leaves; l && ! spec; l = l->next)
+        {
+          ChopGimpVObject *o = l->data;
+          ChopGimpVEntry  *f = (o->kind == CHOPGIMP_VOBJECT_PATH)
+                               ? chopgimp_vstyle_get_fill (&o->style) : NULL;
+
+          if (f && f->paint.type == CHOPGIMP_PAINT_VPATTERN)
+            spec = g_strdup (f->paint.material);
+        }
+
+      g_list_free (leaves);
+      g_list_free (sel);
+
+      if (spec)
+        {
+          ChopGimpVPattern p;
+
+          if (chopgimp_vpattern_parse (spec, &p))
+            {
+              gchar *ns;
+
+              p.type = (! strcmp (v[1], "brick-row")    ? CHOPGIMP_VPATTERN_BRICK_ROW    :
+                        ! strcmp (v[1], "brick-column") ? CHOPGIMP_VPATTERN_BRICK_COLUMN :
+                        ! strcmp (v[1], "hex")          ? CHOPGIMP_VPATTERN_HEX          :
+                                                          CHOPGIMP_VPATTERN_GRID);
+              ns = chopgimp_vpattern_to_spec (&p);
+              chopgimp_vpatterns_store (gimp_item_get_image (GIMP_ITEM (layer)), ns);
+              *done = chopgimp_vmaterial_apply_pattern (layer, ns);
+              g_free (ns);
+              chopgimp_vpattern_clear (&p);
+            }
+
+          g_free (spec);
+        }
+    }
+  else
+    known = FALSE;
+
+  g_strfreev (v);
+
+  return known;
+}
+
+/*  3.28.1: « livepaint-* » and « symbol-* » commands
+ *    livepaint-make, livepaint-add, livepaint-expand, livepaint-release,
+ *    livepaint-gap:<px>, livepaint-fill:<x>:<y>:#rrggbb (a region, image
+ *    coordinates; « none »: no fill), livepaint-stroke:<x>:<y>:#rrggbb,
+ *    livepaint-select:<x>:<y> (region, else segment),
+ *    symbol-new[:<name>], symbol-place:<id>, symbol-break, symbol-edit,
+ *    symbol-rename:<id>:<name>, symbol-delete:<id>
+ */
+static gboolean
+chopgimp_vobjects_livepaint_command (GimpVectorLayer *layer,
+                                     GimpContext     *context,
+                                     const gchar     *cmd)
+{
+  GimpImage *image = gimp_item_get_image (GIMP_ITEM (layer));
+  gchar    **v     = g_strsplit (cmd, ":", 4);
+  gint       n     = g_strv_length (v);
+  gboolean   done  = FALSE;
+
+  if (! strcmp (v[0], "livepaint-make"))
+    done = chopgimp_vlivepaint_make (layer) != NULL;
+  else if (! strcmp (v[0], "livepaint-add"))
+    done = chopgimp_vlivepaint_add (layer);
+  else if (! strcmp (v[0], "livepaint-expand"))
+    done = chopgimp_vlivepaint_expand (layer);
+  else if (! strcmp (v[0], "livepaint-release"))
+    done = chopgimp_vlivepaint_release (layer);
+  else if (! strcmp (v[0], "livepaint-gap") && n == 2)
+    done = chopgimp_vlivepaint_set_gap (layer, g_ascii_strtod (v[1], NULL));
+  else if ((! strcmp (v[0], "livepaint-fill") || ! strcmp (v[0], "livepaint-stroke")) &&
+           n == 4)
+    {
+      gboolean         edge = ! strcmp (v[0], "livepaint-stroke");
+      ChopGimpVObject *o    = chopgimp_vlivepaint_pick (layer,
+                                                        g_ascii_strtod (v[1], NULL),
+                                                        g_ascii_strtod (v[2], NULL),
+                                                        edge, 4.0);
+
+      if (o)
+        {
+          GeglColor *c = NULL;
+
+          if (strcmp (v[3], "none"))
+            {
+              c = gegl_color_new (NULL);
+              gegl_color_set_rgba_with_space (c, 0, 0, 0, 1, NULL);
+
+              if (strlen (v[3]) == 7 && v[3][0] == '#')
+                {
+                  guint rgb = (guint) g_ascii_strtoull (v[3] + 1, NULL, 16);
+
+                  gegl_color_set_rgba_with_space (c,
+                                                  ((rgb >> 16) & 0xff) / 255.0,
+                                                  ((rgb >> 8) & 0xff) / 255.0,
+                                                  (rgb & 0xff) / 255.0, 1.0, NULL);
+                }
+            }
+
+          chopgimp_vlivepaint_paint (layer, o, c, edge);
+          g_clear_object (&c);
+          done = TRUE;
+        }
+    }
+  else if (! strcmp (v[0], "livepaint-select") && n >= 3)
+    {
+      gdouble          x = g_ascii_strtod (v[1], NULL), y = g_ascii_strtod (v[2], NULL);
+      ChopGimpVObject *o = chopgimp_vlivepaint_pick (layer, x, y, FALSE, 4.0);
+
+      if (! o)
+        o = chopgimp_vlivepaint_pick (layer, x, y, TRUE, 4.0);
+
+      if (o)
+        {
+          chopgimp_vlayer_set_selection (layer, &o->id, 1);
+          done = TRUE;
+        }
+    }
+  else if (! strcmp (v[0], "symbol-new"))
+    {
+      gchar *id = chopgimp_vsymbols_make (layer, n > 1 ? strchr (cmd, ':') + 1 : NULL);
+
+      done = id != NULL;
+      g_free (id);
+    }
+  else if (! strcmp (v[0], "symbol-place") && n >= 2)
+    done = chopgimp_vsymbols_place (image, layer, v[1], context) != NULL;
+  else if (! strcmp (v[0], "symbol-break"))
+    done = chopgimp_vsymbols_break_link (layer);
+  else if (! strcmp (v[0], "symbol-edit"))
+    done = chopgimp_vsymbols_edit (layer, n > 1 ? v[1] : NULL);
+  else if (! strcmp (v[0], "symbol-rename") && n >= 3)
+    done = chopgimp_vsymbols_rename (image, v[1], strchr (strchr (cmd, ':') + 1, ':') + 1);
+  else if (! strcmp (v[0], "symbol-delete") && n >= 2)
+    done = chopgimp_vsymbols_remove (image, v[1]);
+
+  g_strfreev (v);
+
+  return done;
+}
+
+/*  ChopGimp lot V2: the « Objet » commands for scripts and plug-ins, on
+ *  the active vector layer: « decompose », « split-new », « select-all »,
+ *  « select-none »,
+ *  « group », « ungroup », « front », « forward », « backward », « back »,
+ *  « lock », « unlock-all », « hide », « show-all », « align-left »…
+ *  « align-bottom », « distribute-h », « distribute-v », « clip-make »,
+ *  « clip-release », « delete », « duplicate »
+ */
+static GimpValueArray *
+vobjects_command_invoker (GimpProcedure         *procedure,
+                          Gimp                  *gimp,
+                          GimpContext           *context,
+                          GimpProgress          *progress,
+                          const GimpValueArray  *args,
+                          GError               **error)
+{
+  static const gchar *const aligns[] = { "align-left", "align-hcenter", "align-right",
+                                         "align-top", "align-vcenter", "align-bottom",
+                                         "distribute-h", "distribute-v", NULL };
+  static const gchar *const arranges[] = { "front", "forward", "backward", "back", NULL };
+  GimpImage       *image = ARG_OBJECT (0);
+  const gchar     *cmd   = g_value_get_string (gimp_value_array_index (args, 1));
+  GimpVectorLayer *layer = NULL;
+  gboolean         done  = FALSE;
+  GimpValueArray  *return_vals;
+  GList           *layers = image ? gimp_image_get_selected_layers (image) : NULL;
+
+  if (g_list_length (layers) == 1 && GIMP_IS_VECTOR_LAYER (layers->data) &&
+      chopgimp_vobjects_enabled ())
+    layer = layers->data;
+
+  /*  4.2.1: an SVG of the clipboard pasted as objects (tests):
+   *  « paste-svg:<svg> » centered on the image, « paste-svg-in-place:<svg> »
+   */
+  if (image && cmd && (g_str_has_prefix (cmd, "paste-svg:") ||
+                       g_str_has_prefix (cmd, "paste-svg-in-place:")))
+    {
+      gboolean         in_place = g_str_has_prefix (cmd, "paste-svg-in-place:");
+      gdouble          center[2];
+      GimpVectorLayer *pasted   = NULL;
+
+      center[0] = gimp_image_get_width  (image) / 2.0;
+      center[1] = gimp_image_get_height (image) / 2.0;
+
+      done  = chopgimp_vobjects_paste_svg (image, context, strchr (cmd, ':') + 1,
+                                           in_place ? NULL : center, &pasted);
+      layer = pasted;
+      cmd   = NULL;
+    }
+
+  if (layer && cmd)
+    {
+      if (! strcmp (cmd, "decompose"))
+        done = chopgimp_vlayer_decompose (layer, TRUE) > 0;
+      /*  3.27.1: one object per island, no undo step, as « Créer un
+       *  calque vectoriel » does on a layer just made from a path
+       */
+      else if (! strcmp (cmd, "split-new"))
+        done = chopgimp_vlayer_split_new (layer) > 0;
+      /*  3.27.1: selecting is not an edit: any vector layer, as the
+       *  Move tool
+       */
+      else if (! strcmp (cmd, "select-all") &&
+               chopgimp_vobjects_layer_is_target (layer))
+        done = chopgimp_vobjects_select_all (layer);
+      /*  4.2.0: Ctrl+C / Ctrl+V of objects (tests; the clipboard object is
+       *  Gimp itself here)
+       */
+      else if (! strcmp (cmd, "copy-objects"))
+        {
+          chopgimp_vobjects_clipboard_copy (layer, G_OBJECT (gimp));
+          done = chopgimp_vobjects_n_selected (layer) > 0;
+        }
+      else if (! strcmp (cmd, "paste-objects"))
+        done = chopgimp_vobjects_clipboard_paste (layer, G_OBJECT (gimp));
+      else if (! strcmp (cmd, "select-none") &&
+               chopgimp_vobjects_layer_is_target (layer))
+        {
+          chopgimp_vlayer_set_selection (layer, NULL, 0);
+          done = TRUE;
+        }
+      /*  4.0.0: clicking an object and the Pinceau goutte work on any
+       *  vector layer, as the tools do, including a layer whose single
+       *  object was never edited
+       */
+      else if ((g_str_has_prefix (cmd, "select-at:") ||
+                g_str_has_prefix (cmd, "select-add-at:") ||
+                g_str_has_prefix (cmd, "blob:")) &&
+               chopgimp_vobjects_layer_is_target (layer) &&
+               chopgimp_vmaterial_command (layer, context, cmd, &done))
+        ;
+      else if (! chopgimp_vobjects_layer_is_multi (layer))
+        done = FALSE;
+      /*  3.29.3: selection by color / size, cleaning, colors  */
+      else if (! strcmp (cmd, "select-same-fill"))
+        done = chopgimp_vobjects_select_same (layer, CHOPGIMP_VSAME_FILL);
+      else if (! strcmp (cmd, "select-same-stroke"))
+        done = chopgimp_vobjects_select_same (layer, CHOPGIMP_VSAME_STROKE);
+      else if (! strcmp (cmd, "select-same-color"))
+        done = chopgimp_vobjects_select_same (layer, CHOPGIMP_VSAME_COLOR);
+      else if (! strcmp (cmd, "select-next-below"))
+        done = chopgimp_vobjects_select_adjacent (layer, FALSE);
+      else if (! strcmp (cmd, "select-next-above"))
+        done = chopgimp_vobjects_select_adjacent (layer, TRUE);
+      else if (! strcmp (cmd, "select-inverse"))
+        done = chopgimp_vobjects_select_inverse (layer);
+      else if (! strncmp (cmd, "select-smaller:", 15))
+        done = chopgimp_vobjects_select_smaller (layer, g_ascii_strtod (cmd + 15, NULL)) >= 0;
+      else if (! strncmp (cmd, "delete-smaller:", 15))
+        done = chopgimp_vobjects_delete_smaller (layer, g_ascii_strtod (cmd + 15, NULL)) >= 0;
+      else if (! strcmp (cmd, "merge-same-color"))
+        done = chopgimp_vobjects_merge_same_color (layer) >= 0;
+      else if (! strncmp (cmd, "simplify:", 9))
+        done = chopgimp_vobjects_simplify (layer, g_ascii_strtod (cmd + 9, NULL), TRUE) >= 0;
+      else if (! strncmp (cmd, "simplify-preview:", 17))
+        {
+          /*  3.29.3: preview then cancel; TRUE when the preview had
+           *  fewer nodes (the paths must be back afterwards)
+           */
+          ChopGimpVSimplify *sp = chopgimp_vsimplify_begin (layer);
+          gint               b = 0, a = 0;
+
+          chopgimp_vsimplify_preview (sp, g_ascii_strtod (cmd + 17, NULL), &b, &a);
+          chopgimp_vsimplify_end (sp, FALSE, 0.0);
+          done = sp && a < b;
+        }
+      else if (! strncmp (cmd, "replace-color:", 14) && strlen (cmd) >= 14 + 8 + 1 + 6)
+        {
+          /*  3.29.3 « Couleurs du dessin »: replace-color:RRGGBBAA:RRGGBB[AA]  */
+          guint32    key = (guint32) g_ascii_strtoull (cmd + 14, NULL, 16);
+          GeglColor *c   = gegl_color_new (NULL);
+          guint8     px[4];
+          guint32    v   = (guint32) g_ascii_strtoull (cmd + 23, NULL, 16);
+
+          if (strlen (cmd + 23) <= 6)
+            v = (v << 8) | 0xff;
+          px[0] = v >> 24; px[1] = (v >> 16) & 0xff; px[2] = (v >> 8) & 0xff; px[3] = v & 0xff;
+          gegl_color_set_pixel (c, babl_format ("R'G'B'A u8"), px);
+          done = chopgimp_vobjects_replace_color_key (layer, key, c) > 0;
+          g_object_unref (c);
+        }
+      else if (! strncmp (cmd, "fill-holes:", 11))
+        done = chopgimp_vobjects_fill_holes (layer, g_ascii_strtod (cmd + 11, NULL)) >= 0;
+      else if (! strcmp (cmd, "swap-fill-stroke"))
+        done = chopgimp_vobjects_swap_fill_stroke (layer);
+      else if (! strcmp (cmd, "fill-none"))
+        done = chopgimp_vobjects_apply_color (layer, NULL, FALSE, TRUE);
+      /*  4.1.1: a color for the fill / stroke of the selection, as a
+       *  swatch or the foreground color does (fill-color:RRGGBB)
+       */
+      else if ((! strncmp (cmd, "fill-color:", 11) || ! strncmp (cmd, "stroke-color:", 13)))
+        {
+          gboolean     stroke = cmd[0] == 's';
+          const gchar *hex    = cmd + (stroke ? 13 : 11);
+          guint        v      = (guint) g_ascii_strtoull (hex, NULL, 16);
+          GeglColor   *c      = gegl_color_new (NULL);
+
+          gegl_color_set_rgba_with_space (c, ((v >> 16) & 0xff) / 255.0,
+                                          ((v >> 8) & 0xff) / 255.0,
+                                          (v & 0xff) / 255.0, 1.0,
+                                          babl_space ("sRGB"));
+          done = chopgimp_vobjects_apply_color (layer, c, stroke, TRUE);
+          g_object_unref (c);
+        }
+      else if (! strcmp (cmd, "lock-others"))
+        done = chopgimp_vobjects_lock_others (layer);
+      else if (! strcmp (cmd, "hide-others"))
+        done = chopgimp_vobjects_hide_others (layer);
+      else if (! strcmp (cmd, "group"))
+        done = chopgimp_vobjects_group_selection (layer);
+      else if (! strcmp (cmd, "ungroup"))
+        done = chopgimp_vobjects_ungroup_selection (layer);
+      else if (! strcmp (cmd, "lock"))
+        done = chopgimp_vobjects_lock_selection (layer);
+      else if (! strcmp (cmd, "unlock-all"))
+        done = chopgimp_vobjects_unlock_all (layer);
+      else if (! strcmp (cmd, "hide"))
+        done = chopgimp_vobjects_hide_selection (layer);
+      else if (! strcmp (cmd, "show-all"))
+        done = chopgimp_vobjects_show_all (layer);
+      else if (! strcmp (cmd, "clip-make"))
+        done = chopgimp_vobjects_clip_make (layer);
+      else if (! strcmp (cmd, "clip-release"))
+        done = chopgimp_vobjects_clip_release (layer);
+      else if (! strcmp (cmd, "delete"))
+        done = chopgimp_vobjects_delete_selection (layer);
+      else if (! strcmp (cmd, "duplicate"))
+        done = chopgimp_vobjects_duplicate_selection (layer, TRUE);
+      /*  3.27.6 « Objet > Distorsion »: distort-warp:style:bend:hdist:vdist:vertical,
+       *  distort-mesh:rows:cols, distort-top, distort-free, distort-expand,
+       *  distort-release, distort-mesh-point:k:dx:dy (an envelope point, in
+       *  fractions of the box); outil Largeur: width-profile:<profile>
+       *  (« uniform », a preset or « t:w,… »), save-profile:<name>
+       */
+      else if (g_str_has_prefix (cmd, "distort-") || g_str_has_prefix (cmd, "width-profile:") ||
+               g_str_has_prefix (cmd, "save-profile:"))
+        done = chopgimp_vobjects_distort_command (layer, cmd);
+      /*  3.29.0: transform-again, transform-each:…, key:k, key-none,
+       *  align-to:…, box:…, flip-h, flip-v, corners:r[:mode[:k]], cut-at:x:y,
+       *  knife:x:y:…, join-at:x:y[:r] (chopgimp-vtransform.h)
+       */
+      else if (chopgimp_vtransform_command (layer, cmd, &done))
+        ;
+      /*  3.29.1: blend-*, mesh-*, freeform-make, stroke-gradient:n,
+       *  opmask-*, pattern-* (see chopgimp_vmaterial_command)
+       */
+      else if (chopgimp_vmaterial_command (layer, context, cmd, &done))
+        ;
+      else if (g_str_has_prefix (cmd, "livepaint-") || g_str_has_prefix (cmd, "symbol-"))
+        done = chopgimp_vobjects_livepaint_command (layer, context, cmd);
+      /*  3.28.2: scale-strokes:0|1 (« Mettre à l'échelle les contours et
+       *  effets »), scale-objects:<factor> (the selected objects, from
+       *  the origin, as the Selection tool would)
+       */
+      else if (g_str_has_prefix (cmd, "scale-strokes:"))
+        {
+          chopgimp_vobjects_set_scale_strokes (atoi (cmd + strlen ("scale-strokes:")) != 0);
+          done = TRUE;
+        }
+      else if (g_str_has_prefix (cmd, "scale-objects:"))
+        {
+          gdouble      f = g_ascii_strtod (cmd + strlen ("scale-objects:"), NULL);
+          gint         n = 0;
+          const guint *ids = chopgimp_vlayer_get_selection (layer, &n);
+          GimpMatrix3  m;
+
+          if (f > 0 && n > 0)
+            {
+              guint *copy = g_memdup2 (ids, n * sizeof (guint));
+
+              gimp_matrix3_identity (&m);
+              gimp_matrix3_scale (&m, f, f);
+              chopgimp_vlayer_transform (layer, copy, n, &m, FALSE, TRUE);
+              g_free (copy);
+              done = TRUE;
+            }
+        }
+      else
+        {
+          for (gint i = 0; aligns[i]; i++)
+            if (! strcmp (cmd, aligns[i]))
+              done = chopgimp_vobjects_align (layer, (ChopGimpVAlign) i);
+
+          for (gint i = 0; arranges[i]; i++)
+            if (! strcmp (cmd, arranges[i]))
+              done = chopgimp_vobjects_arrange (layer, (ChopGimpVArrange) i);
+        }
+    }
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), done);
+  g_value_set_int (gimp_value_array_index (return_vals, 2),
+                   layer ? chopgimp_vobjects_n_selected (layer) : 0);
+
+  return return_vals;
+}
+
+/*  3.27.2 (lot V4): the object tree of a vector layer as XML (the format
+ *  of the « chopgimp-vobjects » parasite), for the import and export
+ *  plug-ins (chopgimp_pdf.py, file-svg.c)
+ */
+static GimpValueArray *
+vobjects_get_xml_invoker (GimpProcedure         *procedure,
+                          Gimp                  *gimp,
+                          GimpContext           *context,
+                          GimpProgress          *progress,
+                          const GimpValueArray  *args,
+                          GError               **error)
+{
+  GimpVectorLayer *layer = ARG_OBJECT (0);
+  gchar           *xml   = NULL;
+  GimpValueArray  *return_vals;
+
+  if (layer && chopgimp_vobjects_enabled ())
+    xml = chopgimp_vlayer_get_xml (layer);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_take_string (gimp_value_array_index (return_vals, 1),
+                       xml ? xml : g_strdup (""));
+
+  return return_vals;
+}
+
+static GimpValueArray *
+vobjects_set_xml_invoker (GimpProcedure         *procedure,
+                          Gimp                  *gimp,
+                          GimpContext           *context,
+                          GimpProgress          *progress,
+                          const GimpValueArray  *args,
+                          GError               **error)
+{
+  GimpVectorLayer *layer = ARG_OBJECT (0);
+  const gchar     *xml   = g_value_get_string (gimp_value_array_index (args, 1));
+  gboolean         done  = FALSE;
+  GimpValueArray  *return_vals;
+
+  if (layer && xml && *xml && chopgimp_vobjects_enabled ())
+    done = chopgimp_vlayer_set_xml (layer, xml, TRUE);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), done);
+
+  return return_vals;
+}
+
+/*  ChopGimp 3.27.2 (lot V6 point 2): « Redéfinir les couleurs » from a
+ *  script. @spec: « key=value » separated by « ; », applied in this
+ *  order: map=RRGGBB>RRGGBB,… (one color → a new color), harmony=1..5
+ *  (Complémentaire, Triade, Analogues, Tétrade, Complémentaires
+ *  adjacentes) with base=RRGGBB (optional), reduce=N, globals=1 (nearest
+ *  global colors), hue=-180..180, sat=-100..100, light=-100..100, dry=1
+ *  (nothing applied). Returns « RRGGBB count -> RRGGBB [global-id] » per
+ *  color and the scope (selection, layers, image).
+ */
+static gboolean
+parse_hex (const gchar *hex,
+           gdouble     *rgb)
+{
+  guint v;
+
+  if (! hex || strlen (hex) < 6 || sscanf (hex, "%6x", &v) != 1)
+    return FALSE;
+
+  rgb[0] = ((v >> 16) & 0xff) / 255.0;
+  rgb[1] = ((v >>  8) & 0xff) / 255.0;
+  rgb[2] = ( v        & 0xff) / 255.0;
+
+  return TRUE;
+}
+
+static gchar *
+hex_of (const gdouble *rgb)
+{
+  return g_strdup_printf ("%02x%02x%02x",
+                          (gint) CLAMP (floor (rgb[0] * 255.0 + 0.5), 0, 255),
+                          (gint) CLAMP (floor (rgb[1] * 255.0 + 0.5), 0, 255),
+                          (gint) CLAMP (floor (rgb[2] * 255.0 + 0.5), 0, 255));
+}
+
+static GimpValueArray *
+vobjects_recolor_invoker (GimpProcedure         *procedure,
+                          Gimp                  *gimp,
+                          GimpContext           *context,
+                          GimpProgress          *progress,
+                          const GimpValueArray  *args,
+                          GError               **error)
+{
+  GimpImage       *image  = ARG_OBJECT (0);
+  const gchar     *spec   = g_value_get_string (gimp_value_array_index (args, 1));
+  ChopGimpRecolor *rc     = image ? chopgimp_recolor_new (image) : NULL;
+  GString         *out    = g_string_new (NULL);
+  gboolean         done   = FALSE;
+  gchar          **items  = g_strsplit (spec ? spec : "", ";", -1);
+  gdouble          hue = 0, sat = 0, light = 0;
+  gboolean         dry    = FALSE;
+  gint             harmony = 0;
+  gdouble          base[3];
+  gboolean         has_base = FALSE;
+  GimpValueArray  *return_vals;
+  static const gchar *scopes[] = { "selection", "layers", "image" };
+
+  for (gint i = 0; rc && items[i]; i++)
+    {
+      gchar *key = g_strstrip (items[i]);
+      gchar *val = strchr (key, '=');
+
+      if (! val)
+        {
+          *key = '\0';   /* ignored below */
+          continue;
+        }
+      *val++ = '\0';
+
+      if (! strcmp (key, "base"))
+        has_base = parse_hex (val, base);
+    }
+
+  for (gint i = 0; rc && items[i]; i++)
+    {
+      const gchar *key = items[i];
+      const gchar *val = key + strlen (key) + 1;
+
+      if (! *key)
+        continue;
+
+      if (! strcmp (key, "map"))
+        {
+          gchar **pairs = g_strsplit (val, ",", -1);
+
+          for (gint k = 0; pairs[k]; k++)
+            {
+              gchar  **ft = g_strsplit (pairs[k], ">", 2);
+              gdouble  from[3], to[3];
+              gint     idx;
+
+              if (ft[0] && ft[1] && parse_hex (ft[0], from) && parse_hex (ft[1], to) &&
+                  (idx = chopgimp_recolor_find (rc, from)) >= 0)
+                chopgimp_recolor_set_target (rc, idx, to);
+
+              g_strfreev (ft);
+            }
+
+          g_strfreev (pairs);
+        }
+      else if (! strcmp (key, "harmony"))
+        harmony = atoi (val);
+      else if (! strcmp (key, "reduce"))
+        {
+          if (harmony > 0)
+            chopgimp_recolor_harmony (rc, harmony - 1, has_base ? base : NULL);
+          harmony = 0;
+          chopgimp_recolor_reduce (rc, atoi (val));
+        }
+      else if (! strcmp (key, "globals"))
+        {
+          if (atoi (val))
+            chopgimp_recolor_assign_globals (rc);
+        }
+      else if (! strcmp (key, "hue"))
+        hue = g_ascii_strtod (val, NULL);
+      else if (! strcmp (key, "sat"))
+        sat = g_ascii_strtod (val, NULL) / 100.0;
+      else if (! strcmp (key, "light"))
+        light = g_ascii_strtod (val, NULL) / 100.0;
+      else if (! strcmp (key, "dry"))
+        dry = atoi (val) != 0;
+    }
+
+  if (rc)
+    {
+      if (harmony > 0)
+        chopgimp_recolor_harmony (rc, harmony - 1, has_base ? base : NULL);
+
+      chopgimp_recolor_set_adjust (rc, hue, sat, light);
+
+      g_string_append_printf (out, "scope %s objects %d\n",
+                              scopes[chopgimp_recolor_get_scope (rc)],
+                              chopgimp_recolor_get_n_objects (rc));
+
+      for (gint i = 0; i < chopgimp_recolor_get_n_colors (rc); i++)
+        {
+          ChopGimpRecolorColor *c = chopgimp_recolor_get_color (rc, i);
+          gdouble               rgb[3];
+          gchar                *a, *b;
+
+          chopgimp_recolor_get_final (rc, i, rgb);
+          a = hex_of (c->rgb);
+          b = hex_of (rgb);
+          g_string_append_printf (out, "%s %d -> %s%s%s %s\n", a, c->count, b,
+                                  c->global_id ? " " : "",
+                                  c->global_id ? c->global_id : "",
+                                  chopgimp_recolor_group_name (c->group));
+          g_free (a);
+          g_free (b);
+        }
+
+      if (! dry)
+        {
+          done = chopgimp_recolor_commit (rc);
+
+          if (done)
+            gimp_image_flush (image);
+        }
+
+      chopgimp_recolor_free (rc);
+    }
+
+  g_strfreev (items);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), done);
+  g_value_take_string (gimp_value_array_index (return_vals, 2), g_string_free (out, FALSE));
+
+  return return_vals;
+}
+
+/*  the selected objects of the active vector layer follow a global color
+ *  (@which: 1 fill, 2 stroke, 3 both; @id empty: unlinked)
+ */
+static GimpValueArray *
+vobjects_link_global_invoker (GimpProcedure         *procedure,
+                              Gimp                  *gimp,
+                              GimpContext           *context,
+                              GimpProgress          *progress,
+                              const GimpValueArray  *args,
+                              GError               **error)
+{
+  GimpImage       *image = ARG_OBJECT (0);
+  gint             which = ARG_INT (1);
+  const gchar     *id    = g_value_get_string (gimp_value_array_index (args, 2));
+  GimpVectorLayer *layer = image ? chopgimp_vobjects_get_target_layer (image) : NULL;
+  gint             n     = 0;
+  GimpValueArray  *return_vals;
+
+  if (layer)
+    n = chopgimp_vobjects_link_global (layer, which, (id && *id) ? id : NULL, TRUE);
+
+  if (n > 0)
+    gimp_image_flush (image);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_int (gimp_value_array_index (return_vals, 1), n);
+
+  return return_vals;
+}
