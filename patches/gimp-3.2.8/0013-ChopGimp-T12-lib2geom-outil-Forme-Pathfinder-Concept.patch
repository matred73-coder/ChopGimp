+/* ─── Shape Builder ────────────────────────────────────────────────── */
+
+typedef struct
+{
+  GimpDrawTool  parent_instance;
+
+  GimpImage    *image;
+  gint64        stamp;      /* image state the regions were computed for */
+  GList        *layers;     /* input vector layers, top first            */
+  GPtrArray    *regions;    /* GimpPath *, unattached                    */
+  GArray       *picked;     /* gint: indices into regions                */
+  gint          hover;
+  gboolean      erase;
+
+  /*  ChopGimp lot V2: on the objects of a vector layer  */
+  GimpVectorLayer *vlayer;  /* NULL: on the selected layers               */
+  GPtrArray    *objs;       /* ChopGimpVObject * (ref), bottom first      */
+  GPtrArray    *worlds;     /* GimpPath *: their shapes in the image      */
+} GimpShapeBuilderTool;
+
+typedef struct
+{
+  GimpDrawToolClass  parent_class;
+} GimpShapeBuilderToolClass;
+
+G_DEFINE_TYPE (GimpShapeBuilderTool, gimp_shape_builder_tool, GIMP_TYPE_DRAW_TOOL)
+
+#define MAX_SHAPES 12
+
+
+void
+gimp_shape_builder_tool_register (GimpToolRegisterCallback  callback,
+                                  gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_SHAPE_BUILDER_TOOL,
+                GIMP_TYPE_TOOL_OPTIONS,
+                gimp_tool_options_empty_gui,
+                0,
+                "gimp-shape-builder-tool",
+                _("Bâtisseur de formes"),
+                _("Bâtisseur de formes : glissez sur les zones des formes sélectionnées "
+                  "pour les fusionner, Alt pour les supprimer"),
+                N_("_Bâtisseur de formes"), NULL,
+                NULL, "gimp-tool-path",
+                "chopgimp-tool-shape-builder",
+                data);
+}
+
+static void
+shape_builder_clear (GimpShapeBuilderTool *sb)
+{
+  g_list_free_full (sb->layers, g_object_unref);
+  sb->layers = NULL;
+
+  if (sb->regions)
+    g_ptr_array_set_size (sb->regions, 0);
+
+  g_array_set_size (sb->picked, 0);
+  sb->hover = -1;
+  sb->image = NULL;
+  sb->stamp = 0;
+
+  sb->vlayer = NULL;
+  if (sb->objs)
+    g_ptr_array_set_size (sb->objs, 0);
+  if (sb->worlds)
+    g_ptr_array_set_size (sb->worlds, 0);
+}
+
+static gint64
+shape_builder_stamp (GimpImage *image)
+{
+  GimpUndo *undo  = gimp_undo_stack_peek (gimp_image_get_undo_stack (image));
+  gint64    stamp = (gint64) (gintptr) undo * 31 + 7;
+  GList    *iter;
+
+  for (iter = gimp_image_get_selected_layers (image); iter; iter = iter->next)
+    stamp = stamp * 131 + (gint64) (gintptr) iter->data;
+
+  /*  ChopGimp lot V2: and the selected objects  */
+  {
+    GimpVectorLayer *layer = chopgimp_vobjects_get_active_layer (image);
+
+    if (layer)
+      {
+        const guint *ids;
+        gint         n = 0;
+
+        ids = chopgimp_vlayer_get_selection (layer, &n);
+        for (gint i = 0; i < n; i++)
+          stamp = stamp * 131 + ids[i] + 1;
+      }
+  }
+
+  return stamp;
+}
+
+/*  ChopGimp lot V2: the shapes are the path objects of the selected
+ *  objects (all the objects when none is selected)
+ */
+static void
+shape_builder_update_objects (GimpShapeBuilderTool *sb,
+                              GimpVectorLayer      *layer)
+{
+  GList     *objs   = chopgimp_vlayer_get_selected_objects (layer);
+  GList     *leaves = NULL;
+  GimpPath **pieces;
+  gint       n_pieces = 0;
+
+  sb->vlayer = layer;
+
+  if (objs)
+    {
+      for (GList *o = objs; o; o = o->next)
+        leaves = g_list_concat (leaves, chopgimp_vobjects_leaves_of (o->data));
+      g_list_free (objs);
+    }
+  else
+    {
+      leaves = chopgimp_vlayer_get_leaves (layer);
+    }
+
+  for (GList *l = leaves; l && sb->objs->len < MAX_SHAPES * 2; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      GimpPath        *w;
+
+      if (! chopgimp_vobject_is_visible (o) || chopgimp_vobject_is_locked (o) ||
+          gimp_path_get_n_strokes (o->path) == 0)
+        continue;
+
+      w = chopgimp_vobject_get_world_path (layer, o, FALSE);
+      g_object_ref_sink (w);
+
+      g_ptr_array_add (sb->objs, chopgimp_vobject_ref (o));
+      g_ptr_array_add (sb->worlds, w);
+    }
+
+  g_list_free (leaves);
+
+  if (sb->objs->len == 0)
+    return;
+
+  pieces = chopgimp_geom_divide ((GimpPath **) sb->worlds->pdata, sb->worlds->len,
+                                 &n_pieces);
+
+  for (gint i = 0; i < n_pieces; i++)
+    g_ptr_array_add (sb->regions, pieces[i]);
+
+  g_free (pieces);
+}
+
+static ChopGimpVObject *
+shape_builder_owner_object (GimpShapeBuilderTool *sb,
+                            GimpPath             *region)
+{
+  gdouble x, y;
+
+  if (chopgimp_geom_interior_point (region, &x, &y))
+    for (gint i = (gint) sb->objs->len - 1; i >= 0; i--)
+      if (chopgimp_geom_contains (sb->worlds->pdata[i], x, y))
+        return sb->objs->pdata[i];
+
+  return sb->objs->pdata[sb->objs->len - 1];
+}
+
+/*  the regions of the selected vector layers, computed again when the
+ *  image or the selection changed
+ */
+static void
+shape_builder_update_regions (GimpShapeBuilderTool *sb,
+                              GimpImage            *image)
+{
+  GList     *iter;
+  GimpPath **paths;
+  GimpPath **pieces;
+  gint       n = 0, n_pieces = 0;
+
+  if (sb->image == image && sb->stamp == shape_builder_stamp (image))
+    return;
+
+  shape_builder_clear (sb);
+  sb->image = image;
+  sb->stamp = shape_builder_stamp (image);
+
+  /*  ChopGimp lot V2: a vector layer with several objects  */
+  {
+    GimpVectorLayer *layer = chopgimp_vobjects_get_active_layer (image);
+
+    if (layer)
+      {
+        shape_builder_update_objects (sb, layer);
+        return;
+      }
+  }
+
+  /*  selected layers come top first  */
+  for (iter = gimp_image_get_selected_layers (image); iter; iter = iter->next)
+    if (gimp_item_is_vector_layer (GIMP_ITEM (iter->data)) &&
+        gimp_vector_layer_get_path (iter->data) &&
+        g_list_length (sb->layers) < MAX_SHAPES)
+      sb->layers = g_list_append (sb->layers, g_object_ref (iter->data));
+
+  if (! sb->layers)
+    return;
+
+  paths = g_new0 (GimpPath *, g_list_length (sb->layers));
+  for (iter = sb->layers; iter; iter = iter->next)
+    paths[n++] = gimp_vector_layer_get_path (iter->data);
+
+  pieces = chopgimp_geom_divide (paths, n, &n_pieces);
+
+  for (gint i = 0; i < n_pieces; i++)
+    g_ptr_array_add (sb->regions, pieces[i]);
+
+  g_free (pieces);
+  g_free (paths);
+}
+
+static gint
+shape_builder_region_at (GimpShapeBuilderTool *sb,
+                         gdouble               x,
+                         gdouble               y)
+{
+  /*  the smallest region under the pointer  */
+  gint    best      = -1;
+  gdouble best_area = G_MAXDOUBLE;
+
+  for (guint i = 0; i < sb->regions->len; i++)
+    {
+      GimpPath *r = g_ptr_array_index (sb->regions, i);
+
+      if (chopgimp_geom_contains (r, x, y))
+        {
+          gdouble a = chopgimp_geom_area (r);
+
+          if (a < best_area)
+            {
+              best      = i;
+              best_area = a;
+            }
+        }
+    }
+
+  return best;
+}
+
+static gboolean
+shape_builder_picked (GimpShapeBuilderTool *sb,
+                      gint                  index)
+{
+  for (guint i = 0; i < sb->picked->len; i++)
+    if (g_array_index (sb->picked, gint, i) == index)
+      return TRUE;
+
+  return FALSE;
+}
+
+/*  the input layer that gives its style to a region: the topmost one
+ *  covering most of it
+ */
+static GimpVectorLayer *
+shape_builder_owner (GimpShapeBuilderTool *sb,
+                     GimpPath             *region)
+{
+  gdouble x, y;
+  GList  *iter;
+
+  /*  the topmost shape containing a point of the region  */
+  if (chopgimp_geom_interior_point (region, &x, &y))
+    for (iter = sb->layers; iter; iter = iter->next)
+      if (chopgimp_geom_contains (gimp_vector_layer_get_path (iter->data), x, y))
+        return iter->data;
+
+  return sb->layers->data;
+}
+
+static GimpLayer *
+shape_builder_new_layer (GimpImage       *image,
+                         GimpPath        *path,
+                         GimpVectorLayer *style,
+                         GimpContext     *context,
+                         GimpLayer       *parent,
+                         gint             position)
+{
+  GimpVectorLayer        *layer;
+  GimpVectorLayerOptions *src = gimp_vector_layer_get_options (style);
+  GimpVectorLayerOptions *dst;
+
+  gimp_object_set_name (GIMP_OBJECT (path), gimp_object_get_name (style));
+  gimp_image_add_path (image, path, NULL, -1, TRUE);
+
+  layer = gimp_vector_layer_new (image, path, context);
+  dst   = gimp_vector_layer_get_options (layer);
+
+  g_object_set (dst,
+                "enable-fill",   src->enable_fill,
+                "enable-stroke", src->enable_stroke,
+                NULL);
+  gimp_config_sync (G_OBJECT (src->fill_options),   G_OBJECT (dst->fill_options),   0);
+  gimp_config_sync (G_OBJECT (src->stroke_options), G_OBJECT (dst->stroke_options), 0);
+
+  gimp_object_set_name (GIMP_OBJECT (layer), gimp_object_get_name (style));
+  gimp_layer_set_opacity (GIMP_LAYER (layer),
+                          gimp_layer_get_opacity (GIMP_LAYER (style)), FALSE);
+
+  gimp_image_add_layer (image, GIMP_LAYER (layer), parent, position, TRUE);
+  gimp_vector_layer_refresh (layer);
+
+  return GIMP_LAYER (layer);
+}
+
+/*  ChopGimp lot V2: the regions become objects of the layer  */
+static void
+shape_builder_apply_objects (GimpShapeBuilderTool *sb)
+{
+  GimpVectorLayer *layer = sb->vlayer;
+  GimpImage       *image = sb->image;
+  ChopGimpVObject *top   = sb->objs->pdata[sb->objs->len - 1];
+  ChopGimpVObject *parent;
+  ChopGimpVObject *merged = NULL;
+  gint             pos;
+
+  /*  the topmost input, its group  */
+  for (guint i = 0; i < sb->objs->len; i++)
+    {
+      ChopGimpVObject *o = sb->objs->pdata[i];
+
+      if (o->parent == top->parent &&
+          chopgimp_vobject_get_index (o) > chopgimp_vobject_get_index (top))
+        top = o;
+    }
+
+  parent = top->parent;
+  pos    = chopgimp_vobject_get_index (top) + 1;
+
+  chopgimp_vlayer_push_undo (layer, _("Bâtisseur de formes"));
+  chopgimp_vlayer_freeze (layer);
+
+  if (! sb->erase)
+    {
+      GimpPath **picked = g_new0 (GimpPath *, sb->picked->len);
+      GimpPath  *shape;
+
+      for (guint i = 0; i < sb->picked->len; i++)
+        {
+          GimpPath *r = g_ptr_array_index (sb->regions,
+                                           g_array_index (sb->picked, gint, i));
+
+          picked[i] = chopgimp_geom_offset (r, 0.05, CHOPGIMP_JOIN_MITER);
+          if (! picked[i])
+            picked[i] = GIMP_PATH (gimp_item_duplicate (GIMP_ITEM (r), GIMP_TYPE_PATH));
+        }
+
+      shape = chopgimp_geom_boolean (picked, sb->picked->len, CHOPGIMP_BOOL_UNION);
+
+      if (shape)
+        {
+          GimpPath *tight = chopgimp_geom_offset (shape, -0.05, CHOPGIMP_JOIN_MITER);
+
+          if (tight)
+            {
+              g_object_unref (shape);
+              shape = tight;
+            }
+        }
+
+      for (guint i = 0; i < sb->picked->len; i++)
+        g_clear_object (&picked[i]);
+      g_free (picked);
+
+      if (shape)
+        {
+          ChopGimpVObject *owner =
+            shape_builder_owner_object (sb, g_ptr_array_index (sb->regions,
+                                                               g_array_index (sb->picked, gint, 0)));
+
+          merged = chopgimp_vobject_new_path (image, shape, owner->name, &owner->style);
+          chopgimp_vobjects_insert_world (layer, merged, parent, pos);
+          chopgimp_vobject_unref (merged);
+          g_object_unref (shape);
+        }
+    }
+
+  /*  the regions left alone keep the style of their shape (below the
+   *  merged one); the picked ones too when the union failed
+   */
+  for (guint i = 0; i < sb->regions->len; i++)
+    {
+      GimpPath        *r = g_ptr_array_index (sb->regions, i);
+      ChopGimpVObject *owner;
+      ChopGimpVObject *piece;
+
+      if (shape_builder_picked (sb, i) && (sb->erase || merged))
+        continue;
+
+      owner = shape_builder_owner_object (sb, r);
+      piece = chopgimp_vobject_new_path (image, r, owner->name, &owner->style);
+      chopgimp_vobjects_insert_world (layer, piece, parent, pos);
+      chopgimp_vobject_unref (piece);
+    }
+
+  for (guint i = 0; i < sb->objs->len; i++)
+    chopgimp_vlayer_remove (layer, ((ChopGimpVObject *) sb->objs->pdata[i])->id, FALSE);
+
+  chopgimp_vlayer_thaw (layer);
+
+  if (merged)
+    chopgimp_vlayer_set_selection (layer, &merged->id, 1);
+  else
+    chopgimp_vlayer_set_selection (layer, NULL, 0);
+
+  gimp_image_flush (image);
+
+  shape_builder_clear (sb);
+}
+
+static void shape_builder_apply_layers (GimpShapeBuilderTool *sb,
+                                        GimpDisplay          *display);
+
+static void
+shape_builder_apply (GimpShapeBuilderTool *sb,
+                     GimpDisplay          *display)
+{
+  if (sb->vlayer)
+    {
+      if (sb->picked->len && sb->objs->len)
+        shape_builder_apply_objects (sb);
+    }
+  else
+    {
+      shape_builder_apply_layers (sb, display);
+    }
+}
+
+static void
+shape_builder_apply_layers (GimpShapeBuilderTool *sb,
+                            GimpDisplay          *display)
+{
+
+  GimpImage   *image   = sb->image;
+  GimpContext *context = gimp_get_user_context (image->gimp);
+  GimpLayer   *top     = sb->layers->data;
+  GimpLayer   *parent  = gimp_layer_get_parent (top);
+  gint         pos     = gimp_item_get_index (GIMP_ITEM (top));
+  GimpLayer   *merged  = NULL;
+  GList       *paths   = NULL;
+  GList       *iter;
+
+  if (! sb->picked->len)
+    return;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC,
+                               _("Bâtisseur de formes"));
+
+  /*  the regions left alone keep the style of their shape  */
+  for (guint i = 0; i < sb->regions->len; i++)
+    {
+      GimpPath *r = g_ptr_array_index (sb->regions, i);
+
+      if (shape_builder_picked (sb, i))
+        continue;
+
+      shape_builder_new_layer (image,
+                               GIMP_PATH (gimp_item_duplicate (GIMP_ITEM (r), GIMP_TYPE_PATH)),
+                               shape_builder_owner (sb, r), context, parent, pos);
+    }
+
+  if (! sb->erase)
+    {
+      GimpPath **picked = g_new0 (GimpPath *, sb->picked->len);
+      GimpPath  *shape;
+
+      /*  neighbouring regions share their edges exactly, which the union
+       *  does not handle: each one is grown by a hair, merged, and the
+       *  result shrunk back
+       */
+      for (guint i = 0; i < sb->picked->len; i++)
+        {
+          GimpPath *r = g_ptr_array_index (sb->regions,
+                                           g_array_index (sb->picked, gint, i));
+
+          picked[i] = chopgimp_geom_offset (r, 0.05, CHOPGIMP_JOIN_MITER);
+          if (! picked[i])
+            picked[i] = GIMP_PATH (gimp_item_duplicate (GIMP_ITEM (r), GIMP_TYPE_PATH));
+        }
+
+      shape = chopgimp_geom_boolean (picked, sb->picked->len, CHOPGIMP_BOOL_UNION);
+
+      if (shape)
+        {
+          GimpPath *tight = chopgimp_geom_offset (shape, -0.05, CHOPGIMP_JOIN_MITER);
+
+          if (tight)
+            {
+              g_object_unref (shape);
+              shape = tight;
+            }
+        }
+
+      for (guint i = 0; i < sb->picked->len; i++)
+        g_clear_object (&picked[i]);
+
+      if (shape)
+        {
+          merged = shape_builder_new_layer (image, shape,
+                                            shape_builder_owner (sb,
+                                              g_ptr_array_index (sb->regions,
+                                                                 g_array_index (sb->picked, gint, 0))),
+                                            context, parent, pos);
+        }
+      else
+        {
+          /*  the union failed: keep the picked regions as they are,
+           *  never lose them
+           */
+          for (guint i = 0; i < sb->picked->len; i++)
+            {
+              GimpPath *r = g_ptr_array_index (sb->regions,
+                                               g_array_index (sb->picked, gint, i));
+
+              merged = shape_builder_new_layer (image,
+                                                GIMP_PATH (gimp_item_duplicate (GIMP_ITEM (r),
+                                                                                GIMP_TYPE_PATH)),
+                                                shape_builder_owner (sb, r),
+                                                context, parent, pos);
+            }
+        }
+      g_free (picked);
+    }
+
+  /*  the input shapes go, and with them their paths, unless another
+   *  vector layer still draws one
+   */
+  for (iter = sb->layers; iter; iter = iter->next)
+    {
+      GimpPath *path = gimp_vector_layer_get_path (iter->data);
+
+      if (path)
+        paths = g_list_prepend (paths, g_object_ref (path));
+
+      gimp_image_remove_layer (image, iter->data, TRUE, NULL);
+    }
+
+  for (iter = paths; iter; iter = iter->next)
+    {
+      GimpPath *path   = iter->data;
+      gboolean  in_use = FALSE;
+      GList    *all;
+      GList    *l;
+
+      if (! gimp_item_is_attached (GIMP_ITEM (path)) ||
+          gimp_item_get_image (GIMP_ITEM (path)) != image)
+        continue;
+
+      all = gimp_image_get_layer_list (image);
+      for (l = all; l && ! in_use; l = l->next)
+        if (gimp_item_is_vector_layer (GIMP_ITEM (l->data)) &&
+            gimp_vector_layer_get_path (l->data) == path)
+          in_use = TRUE;
+      g_list_free (all);
+
+      if (! in_use)
+        gimp_image_remove_path (image, path, TRUE, NULL);
+    }
+  g_list_free_full (paths, g_object_unref);
+
+  if (merged)
+    {
+      GList *sel = g_list_prepend (NULL, merged);
+
+      gimp_image_set_selected_layers (image, sel);
+      g_list_free (sel);
+    }
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+
+  shape_builder_clear (sb);
+}
+
+static void
+gimp_shape_builder_tool_oper_update (GimpTool         *tool,
+                                     const GimpCoords *coords,
+                                     GdkModifierType   state,
+                                     gboolean          proximity,
+                                     GimpDisplay      *display)
+{
+  GimpShapeBuilderTool *sb    = (GimpShapeBuilderTool *) tool;
+  GimpImage            *image = gimp_display_get_image (display);
+  gint                  hover;
+
+  if (! image)
+    return;
+
+  shape_builder_update_regions (sb, image);
+
+  hover = proximity ? shape_builder_region_at (sb, coords->x, coords->y) : -1;
+
+  if (! sb->layers && ! sb->vlayer)
+    gimp_tool_replace_status (tool, display,
+                              _("Sélectionnez au moins une forme (calques vectoriels)"));
+  else
+    gimp_tool_replace_status (tool, display,
+                              _("Glisser : fusionner les zones — Alt+glisser : les supprimer"));
+
+  if (hover != sb->hover || ! gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    {
+      sb->hover = hover;
+      chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (sb), display);
+    }
+}
+
+static void
+gimp_shape_builder_tool_button_press (GimpTool            *tool,
+                                      const GimpCoords    *coords,
+                                      guint32              time,
+                                      GdkModifierType      state,
+                                      GimpButtonPressType  press_type,
+                                      GimpDisplay         *display)
+{
+  GimpShapeBuilderTool *sb    = (GimpShapeBuilderTool *) tool;
+  GimpImage            *image = gimp_display_get_image (display);
+  gint                  r;
+
+  if (press_type != GIMP_BUTTON_PRESS_NORMAL || ! image)
+    return;
+
+  shape_builder_update_regions (sb, image);
+
+  if (! sb->layers && ! (sb->vlayer && sb->objs->len))
+    {
+      gimp_tool_message_literal (tool, display,
+                                 _("Sélectionnez les formes à combiner "
+                                   "(calques vectoriels, Maj+clic dans le panneau Calques)."));
+      return;
+    }
+
+  tool->display = display;
+  sb->erase     = (state & GDK_MOD1_MASK) != 0;
+  g_array_set_size (sb->picked, 0);
+
+  r = shape_builder_region_at (sb, coords->x, coords->y);
+  if (r >= 0)
+    g_array_append_val (sb->picked, r);
+
+  gimp_tool_control_activate (tool->control);
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (sb), display);
+}
+
+static void
+gimp_shape_builder_tool_motion (GimpTool         *tool,
+                                const GimpCoords *coords,
+                                guint32           time,
+                                GdkModifierType   state,
+                                GimpDisplay      *display)
+{
+  GimpShapeBuilderTool *sb = (GimpShapeBuilderTool *) tool;
+  gint                  r  = shape_builder_region_at (sb, coords->x, coords->y);
+
+  sb->hover = r;
+
+  if (r >= 0 && ! shape_builder_picked (sb, r))
+    g_array_append_val (sb->picked, r);
+
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (sb), display);
+}
+
+static void
+gimp_shape_builder_tool_button_release (GimpTool              *tool,
+                                        const GimpCoords      *coords,
+                                        guint32                time,
+                                        GdkModifierType        state,
+                                        GimpButtonReleaseType  release_type,
+                                        GimpDisplay           *display)
+{
+  GimpShapeBuilderTool *sb = (GimpShapeBuilderTool *) tool;
+
+  gimp_tool_control_halt (tool->control);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (sb));
+
+  if (release_type != GIMP_BUTTON_RELEASE_CANCEL && sb->picked->len)
+    shape_builder_apply (sb, display);
+
+  g_array_set_size (sb->picked, 0);
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (sb));
+}
+
+static void
+gimp_shape_builder_tool_draw (GimpDrawTool *draw_tool)
+{
+  GimpShapeBuilderTool *sb    = (GimpShapeBuilderTool *) draw_tool;
+  GimpDisplayShell     *shell = gimp_display_get_shell (draw_tool->display);
+
+  if (! sb->regions)
+    return;
+
+  for (guint i = 0; i < sb->regions->len; i++)
+    {
+      GimpPath       *r      = g_ptr_array_index (sb->regions, i);
+      gboolean        picked = shape_builder_picked (sb, i);
+      gboolean        hover  = ((gint) i == sb->hover);
+      GimpCanvasItem *item;
+
+      /*  every region outlined, the hovered / picked ones filled  */
+      item = gimp_canvas_path_new (shell, gimp_path_get_bezier (r), 0, 0,
+                                   picked || hover, GIMP_PATH_STYLE_DEFAULT);
+      gimp_canvas_item_set_highlight (item, picked || hover);
+      gimp_draw_tool_add_item (draw_tool, item);
+      g_object_unref (item);
+    }
+}
+
+static void
+gimp_shape_builder_tool_control (GimpTool       *tool,
+                                 GimpToolAction  action,
+                                 GimpDisplay    *display)
+{
+  if (action == GIMP_TOOL_ACTION_HALT || action == GIMP_TOOL_ACTION_COMMIT)
+    {
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+      shape_builder_clear ((GimpShapeBuilderTool *) tool);
+    }
+
+  GIMP_TOOL_CLASS (gimp_shape_builder_tool_parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_shape_builder_tool_finalize (GObject *object)
+{
+  GimpShapeBuilderTool *sb = (GimpShapeBuilderTool *) object;
+
+  shape_builder_clear (sb);
+  g_ptr_array_unref (sb->regions);
+  g_array_unref (sb->picked);
+  g_ptr_array_unref (sb->objs);
+  g_ptr_array_unref (sb->worlds);
+
+  G_OBJECT_CLASS (gimp_shape_builder_tool_parent_class)->finalize (object);
+}
+
+static void
+gimp_shape_builder_tool_class_init (GimpShapeBuilderToolClass *klass)
+{
+  GObjectClass      *object_class    = G_OBJECT_CLASS (klass);
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  object_class->finalize     = gimp_shape_builder_tool_finalize;
+
+  /*  it replaces shapes, it does not paint on the layer: vector layers
+   *  must not be refused (« must be rasterized »)
+   */
+  tool_class->is_destructive = FALSE;
+
+  tool_class->control        = gimp_shape_builder_tool_control;
+  tool_class->oper_update    = gimp_shape_builder_tool_oper_update;
+  tool_class->button_press   = gimp_shape_builder_tool_button_press;
+  tool_class->motion         = gimp_shape_builder_tool_motion;
+  tool_class->button_release = gimp_shape_builder_tool_button_release;
+
+  draw_tool_class->draw      = gimp_shape_builder_tool_draw;
+}
+
+static void
+gimp_shape_builder_tool_init (GimpShapeBuilderTool *sb)
+{
+  GimpTool *tool = GIMP_TOOL (sb);
+
+  sb->regions = g_ptr_array_new_with_free_func (g_object_unref);
+  sb->picked  = g_array_new (FALSE, FALSE, sizeof (gint));
+  sb->objs    = g_ptr_array_new_with_free_func ((GDestroyNotify) chopgimp_vobject_unref);
+  sb->worlds  = g_ptr_array_new_with_free_func (g_object_unref);
+  sb->hover   = -1;
+
+  gimp_tool_control_set_motion_mode (tool->control, GIMP_MOTION_MODE_EXACT);
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_PATHS);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_MOUSE);
+}
+
+
+/* ─── Direct Selection (A) ─────────────────────────────────────────── */
+
+typedef GimpPathTool      GimpDirectSelectTool;
+typedef GimpPathToolClass GimpDirectSelectToolClass;
+
+G_DEFINE_TYPE (GimpDirectSelectTool, gimp_direct_select_tool, GIMP_TYPE_PATH_TOOL)
+
+void
+gimp_direct_select_tool_register (GimpToolRegisterCallback  callback,
+                                  gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_DIRECT_SELECT_TOOL,
+                GIMP_TYPE_PATH_OPTIONS,
+                gimp_path_options_gui,
+                GIMP_PAINT_OPTIONS_CONTEXT_MASK |
+                GIMP_CONTEXT_PROP_MASK_PATTERN  |
+                GIMP_CONTEXT_PROP_MASK_GRADIENT,
+                "gimp-direct-select-tool",
+                _("Sélection directe"),
+                _("Sélection directe : modifier les nœuds d'une forme ou d'un chemin "
+                  "(glisser dans le vide : sélection au cadre)"),
+                N_("Sélection _directe"), "A",
+                NULL, GIMP_HELP_TOOL_PATH,
+                "chopgimp-tool-direct-select",
+                data);
+}
+
+static void
+gimp_direct_select_tool_class_init (GimpDirectSelectToolClass *klass)
+{
+}
+
+static void
+gimp_direct_select_tool_init (GimpDirectSelectTool *tool)
+{
+  /*  read by gimp_path_tool_start()  */
+  g_object_set_data (G_OBJECT (tool), "chopgimp-direct-select", GINT_TO_POINTER (TRUE));
+}
+
+
+/* ─── Lasso direct (ChopGimp 4.2.0, Illustrator's Direct Selection Lasso) ── */
+
+typedef GimpPathTool      GimpDirectLassoTool;
+typedef GimpPathToolClass GimpDirectLassoToolClass;
+
+G_DEFINE_TYPE (GimpDirectLassoTool, gimp_direct_lasso_tool, GIMP_TYPE_PATH_TOOL)
+
+void
+gimp_direct_lasso_tool_register (GimpToolRegisterCallback  callback,
+                                 gpointer                  data)
+{
+  /*  no shortcut: Q (Illustrator) is the quick mask of Photoshop  */
+  (* callback) (GIMP_TYPE_DIRECT_LASSO_TOOL,
+                GIMP_TYPE_PATH_OPTIONS,
+                gimp_path_options_gui,
+                GIMP_PAINT_OPTIONS_CONTEXT_MASK |
+                GIMP_CONTEXT_PROP_MASK_PATTERN  |
+                GIMP_CONTEXT_PROP_MASK_GRADIENT,
+                "gimp-direct-lasso-tool",
+                _("Lasso direct"),
+                _("Lasso direct : entourer à main levée des nœuds ; leurs objets sont "
+                  "sélectionnés (Maj : ajouter, Alt : retirer)"),
+                N_("_Lasso direct"), NULL,
+                NULL, GIMP_HELP_TOOL_PATH,
+                "chopgimp-tool-direct-lasso",
+                data);
+}
+
+static void
+gimp_direct_lasso_tool_class_init (GimpDirectLassoToolClass *klass)
+{
+}
+
+static void
+gimp_direct_lasso_tool_init (GimpDirectLassoTool *tool)
+{
+  /*  read by gimp_path_tool_start(): a Direct Selection with a lasso  */
+  g_object_set_data (G_OBJECT (tool), "chopgimp-direct-select", GINT_TO_POINTER (TRUE));
+  g_object_set_data (G_OBJECT (tool), "chopgimp-direct-lasso",  GINT_TO_POINTER (TRUE));
+}
