+/* ─── 3.27.6: outil Largeur, Enveloppe ─────────────────────────────── */
+
+/*  the polylines the width profiles are drawn along (as width_shape2)  */
+static std::vector<Polyline>
+width_polylines (GimpPath *path)
+{
+  std::vector<Polyline> out;
+
+  for (const Geom::Path &p : to_pv (path))
+    {
+      Polyline pl = { sample_path (p, 1.0), p.closed () };
+
+      out.push_back (pl);
+    }
+
+  return out;
+}
