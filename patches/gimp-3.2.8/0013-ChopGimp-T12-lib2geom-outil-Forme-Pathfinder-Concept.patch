+
+static Point
+disp_at (const std::vector<Point> &grid, int cols, int i, int j,
+         const Geom::Rect &bb, int rows)
+{
+  i = CLAMP (i, 0, rows);
+  j = CLAMP (j, 0, cols);
+
+  return grid[i * (cols + 1) + j] -
+         Point (bb.left () + (double) j / cols * bb.width (),
+                bb.top ()  + (double) i / rows * bb.height ());
+}
+
+/*  3.27.6 « Enveloppe »: the (rows + 1) × (cols + 1) points of the mesh,
+ *  row by row, from @spec « dx,dy;dx,dy;… » (offsets from the regular
+ *  grid over @bb, in fractions of its size; missing points: no offset)
+ */
+static std::vector<Point>
+chopgimp_distort_mesh_points (const std::string &spec, int rows, int cols,
+                              const Geom::Rect &bb)
+{
+  std::vector<Point>  grid;
+  gchar             **items = g_strsplit (spec.c_str (), ";", -1);
+  int                 n     = items ? g_strv_length (items) : 0;
+
+  for (int i = 0; i <= rows; i++)
+    for (int j = 0; j <= cols; j++)
+      {
+        int    k  = i * (cols + 1) + j;
+        double dx = 0, dy = 0;
+
+        if (k < n && items[k] && *items[k])
+          {
+            gchar *comma = strchr (items[k], ',');
+
+            dx = g_ascii_strtod (items[k], NULL);
+            dy = comma ? g_ascii_strtod (comma + 1, NULL) : 0;
+          }
+
+        grid.push_back (Point (bb.left () + ((double) j / cols + dx) * bb.width (),
+                               bb.top ()  + ((double) i / rows + dy) * bb.height ()));
+      }
+
+  g_strfreev (items);
+
+  return grid;
+}
+
+/*  Catmull-Rom weights (the ends extrapolated linearly)  */
+static double
+cr_interp (double p0, double p1, double p2, double p3, double t)
+{
+  return 0.5 * ((2 * p1) + (-p0 + p2) * t +
+                (2 * p0 - 5 * p1 + 4 * p2 - p3) * t * t +
+                (-p0 + 3 * p1 - 3 * p2 + p3) * t * t * t);
+}
+
+/*  (u, v) in 0..1 → the smooth surface through the mesh points  */
+static Point
+chopgimp_distort_mesh_map (const std::vector<Point> &grid, int rows, int cols,
+                           const Geom::Rect &bb, double u, double v)
+{
+  /*  the displacement of each point from the regular grid  */
+  auto disp = [&] (int i, int j) -> Point
+    {
+      Point base (bb.left () + (double) j / cols * bb.width (),
+                  bb.top ()  + (double) i / rows * bb.height ());
+
+      if (i < 0)    return disp_at (grid, cols, 0, j, bb, rows) * 2.0 - disp_at (grid, cols, 1, j, bb, rows);
+      if (i > rows) return disp_at (grid, cols, rows, j, bb, rows) * 2.0 - disp_at (grid, cols, rows - 1, j, bb, rows);
+      if (j < 0)    return disp_at (grid, cols, i, 0, bb, rows) * 2.0 - disp_at (grid, cols, i, 1, bb, rows);
+      if (j > cols) return disp_at (grid, cols, i, cols, bb, rows) * 2.0 - disp_at (grid, cols, i, cols - 1, bb, rows);
+
+      return grid[i * (cols + 1) + j] - base;
+    };
+  double fu = CLAMP (u, -0.5, 1.5) * cols, fv = CLAMP (v, -0.5, 1.5) * rows;
+  int    j  = CLAMP ((int) std::floor (fu), 0, cols - 1);
+  int    i  = CLAMP ((int) std::floor (fv), 0, rows - 1);
+  double s  = fu - j, t = fv - i;
+  Point  col[4];
+
+  for (int a = 0; a < 4; a++)
+    {
+      Point d0 = disp (i - 1 + a, j - 1), d1 = disp (i - 1 + a, j);
+      Point d2 = disp (i - 1 + a, j + 1), d3 = disp (i - 1 + a, j + 2);
+
+      col[a] = Point (cr_interp (d0[0], d1[0], d2[0], d3[0], s),
+                      cr_interp (d0[1], d1[1], d2[1], d3[1], s));
+    }
+
+  Point d (cr_interp (col[0][0], col[1][0], col[2][0], col[3][0], t),
+           cr_interp (col[0][1], col[1][1], col[2][1], col[3][1], t));
+
+  return Point (bb.left () + u * bb.width (), bb.top () + v * bb.height ()) + d;
+}
+
+/*  3.28.2: the point map of a « distort » group (warp / mesh / free) on
+ *  the box @bb (shared by the effect and chopgimp_geom_distort_map())
+ */
+static std::function<Point (const Point &)>
+chopgimp_distort_map (GKeyFile *kf, const gchar *g, const Geom::Rect &bb)
+{
+      std::string mode = ks (kf, g, "mode");
+      std::function<Point (const Point &)> map;
+
+      if (mode == "mesh" || mode == "free")
+        {
+          int                 rows = mode == "free" ? 1 : CLAMP ((int) kd (kf, g, "rows", 1), 1, 20);
+          int                 cols = mode == "free" ? 1 : CLAMP ((int) kd (kf, g, "cols", 1), 1, 20);
+          std::vector<Point>  grid = chopgimp_distort_mesh_points (ks (kf, g, "mesh"), rows, cols, bb);
+
+          if (mode == "free")
+            {
+              /*  homography of the unit square onto the 4 corners  */
+              Point  p0 = grid[0], p1 = grid[1], p2 = grid[3], p3 = grid[2];
+              double sx = p0[0] - p1[0] + p2[0] - p3[0];
+              double sy = p0[1] - p1[1] + p2[1] - p3[1];
+              double a, b, c, d, e, f, gg, h;
+
+              if (std::fabs (sx) < 1e-9 && std::fabs (sy) < 1e-9)
+                {
+                  a = p1[0] - p0[0]; b = p2[0] - p1[0]; c = p0[0];
+                  d = p1[1] - p0[1]; e = p2[1] - p1[1]; f = p0[1];
+                  gg = 0; h = 0;
+                }
+              else
+                {
+                  double dx1 = p1[0] - p2[0], dx2 = p3[0] - p2[0];
+                  double dy1 = p1[1] - p2[1], dy2 = p3[1] - p2[1];
+                  double den = dx1 * dy2 - dx2 * dy1;
+
+                  if (std::fabs (den) < 1e-12)
+                    den = 1e-12;
+
+                  gg = (sx * dy2 - dx2 * sy) / den;
+                  h  = (dx1 * sy - sx * dy1) / den;
+                  a  = p1[0] - p0[0] + gg * p1[0];
+                  b  = p3[0] - p0[0] + h * p3[0];
+                  c  = p0[0];
+                  d  = p1[1] - p0[1] + gg * p1[1];
+                  e  = p3[1] - p0[1] + h * p3[1];
+                  f  = p0[1];
+                }
+
+              map = [=] (const Point &p)
+                {
+                  double u = (p[0] - bb.left ()) / std::max (1e-9, bb.width ());
+                  double v = (p[1] - bb.top ())  / std::max (1e-9, bb.height ());
+                  double w = gg * u + h * v + 1.0;
+
+                  if (std::fabs (w) < 1e-9)
+                    w = 1e-9;
+
+                  return Point ((a * u + b * v + c) / w, (d * u + e * v + f) / w);
+                };
+            }
+          else
+            {
+              map = [=] (const Point &p)
+                {
+                  double u = (p[0] - bb.left ()) / std::max (1e-9, bb.width ());
+                  double v = (p[1] - bb.top ())  / std::max (1e-9, bb.height ());
+
+                  return chopgimp_distort_mesh_map (grid, rows, cols, bb, u, v);
+                };
+            }
+        }
+      else
+        {
+          std::string style = ks (kf, g, "style");
+          double      bend  = kd (kf, g, "bend", 50) / 100.0;
+          double      hd    = kd (kf, g, "hdist", 0) / 100.0;
+          double      vd    = kd (kf, g, "vdist", 0) / 100.0;
+          bool        vert  = kd (kf, g, "vertical", 0) > 0.5;
+          Point       c     = bb.midpoint ();
+          double      W     = std::max (1e-6, bb.width ()  / 2);
+          double      H     = std::max (1e-6, bb.height () / 2);
+
+          map = [=] (const Point &p)
+            {
+              /*  normalized: u along the warp, v across, -1..1  */
+              double u = (p[0] - c[0]) / W, v = (p[1] - c[1]) / H;
+              double A = W, B = H;
+
+              if (vert)
+                {
+                  std::swap (u, v);
+                  std::swap (A, B);
+                }
+
+              double uu = u, vv = v;
+              double k  = std::max (0.0, 1 - u * u);
+
+              if (style == "arc")
+                vv = v - bend * k;
+              else if (style == "arc-lower")
+                vv = v + bend * k * (v + 1) / 2;
+              else if (style == "arc-upper")
+                vv = v - bend * k * (1 - v) / 2;
+              else if (style == "bulge")
+                vv = v * (1 + bend * k);
+              else if (style == "shell-lower")
+                vv = -1 + (v + 1) * (1 + bend * k * 0.5);
+              else if (style == "shell-upper")
+                vv = 1 - (1 - v) * (1 + bend * k * 0.5);
+              else if (style == "flag")
+                vv = v + bend * 0.5 * std::sin (M_PI * u);
+              else if (style == "wave")
+                vv = v + bend * 0.5 * std::sin (M_PI * u) * (1 - 0.5 * v);
+              else if (style == "fish")
+                vv = v * (1 + bend * std::sin (M_PI * (u + 1) / 2) * (1 - u) / 2);
+              else if (style == "rise")
+                vv = v - bend * std::sin (M_PI / 2 * u);
+              else if (style == "fisheye")
+                {
+                  double r = std::sqrt (u * u + v * v);
+
+                  if (r < 1)
+                    {
+                      double f = 1 + bend * (1 - r * r) * 0.6;
+
+                      uu = u * f;
+                      vv = v * f;
+                    }
+                }
+              else if (style == "inflate")
+                {
+                  uu = u * (1 + bend * 0.5 * std::max (0.0, 1 - v * v));
+                  vv = v * (1 + bend * 0.5 * k);
+                }
+              else if (style == "squeeze")
+                {
+                  uu = u * (1 + bend * 0.35 * std::max (0.0, 1 - v * v));
+                  vv = v * (1 - bend * 0.5 * k);
+                }
+              else if (style == "twist")
+                {
+                  double r = std::sqrt (u * u + v * v);
+                  double a = bend * M_PI * std::max (0.0, 1 - r / 1.4142);
+
+                  uu = u * std::cos (a) - v * std::sin (a);
+                  vv = u * std::sin (a) + v * std::cos (a);
+                }
+              else if (style == "arch")
+                {
+                  /*  the horizontal axis becomes an arc (as « bend »)  */
+                  double ang = bend * M_PI;
+
+                  if (std::fabs (ang) > 1e-4)
+                    {
+                      double R  = 2.0 * A / ang;
+                      double x  = u * A, y = v * B;
+                      double a  = x / R;
+                      double rr = R - y;
+
+                      uu = std::sin (a) * rr / A;
+                      vv = (R - std::cos (a) * rr) / B;
+                    }
+                }
+
+              /*  « Distorsion horizontale / verticale »: perspective  */
+              if (std::fabs (hd) > 1e-9)
+                {
+                  double f = 1 + hd * uu * 0.5;
+
+                  vv *= f;
+                }
+              if (std::fabs (vd) > 1e-9)
+                uu *= 1 + vd * vv * 0.5;
+
+              if (vert)
+                {
+                  std::swap (uu, vv);
+                  std::swap (A, B);
+                }
+
+              return Point (c[0] + uu * A, c[1] + vv * B);
+            };
+        }
+
+      return map;
+}
+
+
+/*  bend @shape along @spine: x of the shape → distance along the spine  */
+static Geom::PathVector
+along_path (const Geom::PathVector &shape, const Geom::PathVector &spine,
+            bool repeat, double spacing)
+{
+  Geom::PathVector out;
+
+  if (shape.empty () || spine.empty ())
+    return shape;
+
+  std::vector<Point> sp   = sample_path (spine[0], 1.0);
+  double             slen = polyline_length (sp, spine[0].closed ());
+  std::vector<Point> rs   = resample (sp, spine[0].closed (),
+                                      std::max (2, (int) slen), NULL);
+  if (sp.size () < 2 || slen <= 0 || rs.size () < 2)
+    return shape;
+
+  std::vector<Point> nr   = normals (rs, spine[0].closed ());
+  Geom::Rect         bb   = pv_bounds (shape);
+  double             w    = std::max (1.0, bb.width ());
+  int                copies = repeat ? std::max (1, (int) (slen / (w + spacing))) : 1;
+  double             scale  = repeat ? 1.0 : slen / w;
+
+  auto map = [&] (Point p, int copy)
+    {
+      double x = (p[Geom::X] - bb.left ()) * scale + copy * (w + spacing);
+      double y = p[Geom::Y] - bb.midpoint ()[Geom::Y];
+      double f = std::min ((double) rs.size () - 1, std::max (0.0, x / slen * (rs.size () - 1)));
+      size_t i = std::min (rs.size () - 2, (size_t) f);
+      double t = f - i;
+      Point  base = Geom::lerp (t, rs[i], rs[i + 1]);
+      Point  n    = safe_unit (Geom::lerp (t, nr[i], nr[i + 1]), Point (0, 1));
+
+      return base + n * y;
+    };
+
+  for (int c = 0; c < copies; c++)
+    for (const Polyline &pl : sample_pv (shape, 1.5))
+      {
+        std::vector<Point> mapped;
+
+        for (const Point &p : pl.pts)
+          mapped.push_back (map (p, c));
+
+        out.push_back (fit_points (mapped, pl.closed, 0.3));
+      }
+
+  return out;
+}
+
+/* ─── 3.29.0 « Angles dynamiques » (live corners) ──────────────────── */
+
+/*  the curves of @p, degenerate ones (and an empty closing segment)
+ *  left out
+ */
+static std::vector<std::unique_ptr<Geom::Curve>>
+corner_curves (const Geom::Path &p)
+{
+  std::vector<std::unique_ptr<Geom::Curve>> curves;
+  size_t                                    n = p.closed () ? p.size_closed () : p.size_open ();
+
+  for (size_t i = 0; i < n; i++)
+    if (! p[i].isDegenerate ())
+      curves.emplace_back (p[i].duplicate ());
+
+  return curves;
+}
+
+/*  a corner between @a (incoming) and @b (outgoing): the angle between
+ *  their tangents is more than about 2°
+ */
+static bool
+is_corner (const Geom::Curve &a,
+           const Geom::Curve &b,
+           double            *turn)
+{
+  Point  tin  = a.unitTangentAt (1.0);
+  Point  tout = b.unitTangentAt (0.0);
+  double c    = CLAMP (Geom::dot (tin, tout), -1.0, 1.0);
+  double t    = acos (c);
+
+  if (turn)
+    *turn = t;
+
+  return t > 0.035 && t < G_PI - 0.01;
+}
+
+/*  the time on @c (from its end when @from_end) at distance @len from
+ *  that end, by bisection
+ */
+static double
+time_at_distance (const Geom::Curve &c,
+                  double             len,
+                  bool               from_end)
+{
+  Point  o  = from_end ? c.finalPoint () : c.initialPoint ();
+  double lo = 0.0, hi = 1.0;
+
+  if (Geom::distance (o, from_end ? c.initialPoint () : c.finalPoint ()) <= len)
+    return from_end ? 0.0 : 1.0;
+
+  for (int i = 0; i < 40; i++)
+    {
+      double m = (lo + hi) / 2.0;
+      double t = from_end ? 1.0 - m : m;
+
+      if (Geom::distance (o, c.pointAt (t)) < len)
+        lo = m;
+      else
+        hi = m;
+    }
+
+  return from_end ? 1.0 - (lo + hi) / 2.0 : (lo + hi) / 2.0;
+}
+
+/*  « corners » effect: radius=R (all corners), radii=« k:r,k:r » (corner
+ *  k of the shape, in the order of chopgimp_geom_corner_points), mode=
+ *  round | inverted | chamfer
+ */
+static Geom::PathVector
+corners_pv (const Geom::PathVector &in,
+            double                  radius,
+            const std::string      &radii,
+            const std::string      &mode)
+{
+  Geom::PathVector                   out;
+  std::unordered_map<int, double>    per;
+  int                                k = 0;
+
+  if (! radii.empty ())
+    {
+      gchar **v = g_strsplit (radii.c_str (), ",", -1);
+
+      for (gchar **s = v; s && *s; s++)
+        {
+          gchar *c = strchr (*s, ':');
+
+          if (c)
+            per[atoi (*s)] = g_ascii_strtod (c + 1, NULL);
+        }
+
+      g_strfreev (v);
+    }
+
+  for (const Geom::Path &p : in)
+    {
+      auto   curves = corner_curves (p);
+      size_t n      = curves.size ();
+      bool   closed = p.closed ();
+
+      if (n < 2)
+        {
+          out.push_back (p);
+          continue;
+        }
+
+      /*  for each node j (between curve j-1 and j): its cut length  */
+      std::vector<double> cut (n, 0.0);
+      std::vector<double> rad (n, 0.0);
+
+      for (size_t j = closed ? 0 : 1; j < n; j++)
+        {
+          const Geom::Curve &a = *curves[(j + n - 1) % n];
+          const Geom::Curve &b = *curves[j];
+          double             turn;
+
+          if (! is_corner (a, b, &turn))
+            continue;
+
+          double r = per.count (k) ? per[k] : radius;
+
+          k++;
+
+          if (r <= 0.01)
+            continue;
+
+          /*  the tangent length of a circle of radius r in that corner,
+           *  at most half of each neighbouring segment
+           */
+          double len  = r * tan (turn / 2.0);
+          double maxl = 0.5 * std::min (Geom::distance (a.initialPoint (), a.finalPoint ()),
+                                        Geom::distance (b.initialPoint (), b.finalPoint ()));
+
+          cut[j] = std::min (len, maxl);
+          rad[j] = r;
+        }
+
+      Geom::Path res;
+      bool       started = false;
+
+      res.setStitching (true);   /* tiny gaps from the portions: a segment */
+
+      for (size_t i = 0; i < n; i++)
+        {
+          const Geom::Curve &c   = *curves[i];
+          double             t0  = 0.0, t1 = 1.0;
+          size_t             nxt = (i + 1) % n;
+
+          if (cut[i] > 0)
+            t0 = time_at_distance (c, cut[i], false);
+          if ((closed || i + 1 < n) && cut[nxt] > 0)
+            t1 = time_at_distance (c, cut[nxt], true);
+
+          if (t1 <= t0 + 1e-6)
+            continue;
+
+          std::unique_ptr<Geom::Curve> part (c.portion (t0, t1));
+
+          if (! started)
+            {
+              res.start (part->initialPoint ());
+              started = true;
+            }
+          else if (Geom::distance (res.finalPoint (), part->initialPoint ()) > 1e-6)
+            {
+              res.appendNew<Geom::LineSegment> (part->initialPoint ());
+            }
+
+          res.append (*part);
+
+          /*  the corner after this curve  */
+          if ((closed || i + 1 < n) && cut[nxt] > 0)
+            {
+              const Geom::Curve &b    = *curves[nxt];
+              double             tb   = time_at_distance (b, cut[nxt], false);
+              Point              A    = res.finalPoint ();
+              Point              B    = b.pointAt (tb);
+              Point              P    = c.finalPoint ();
+              Point              tin  = c.unitTangentAt (1.0);
+              Point              tout = b.unitTangentAt (0.0);
+
+              if (mode == "chamfer")
+                {
+                  res.appendNew<Geom::LineSegment> (B);
+                }
+              else if (mode == "inverted")
+                {
+                  /*  a concave arc centred on the corner  */
+                  Point  va    = A - P, vb = B - P;
+                  double ang   = Geom::angle_between (va, vb);
+                  double h     = 4.0 / 3.0 * tan (fabs (ang) / 4.0) * Geom::L2 (va);
+                  Point  na    = Geom::rot90 (Geom::unit_vector (va));
+                  Point  nb    = Geom::rot90 (Geom::unit_vector (vb));
+
+                  if (Geom::dot (na, vb) < 0) na = -na;
+                  if (Geom::dot (nb, va) < 0) nb = -nb;
+
+                  res.appendNew<Geom::CubicBezier> (A + na * h, B + nb * h, B);
+                }
+              else
+                {
+                  double turn = acos (CLAMP (Geom::dot (tin, tout), -1.0, 1.0));
+                  double r    = Geom::distance (A, P) / MAX (tan (turn / 2.0), 1e-6);
+                  double h    = 4.0 / 3.0 * tan (turn / 4.0) * r;
+
+                  res.appendNew<Geom::CubicBezier> (A + tin * h, B - tout * h, B);
+                }
+            }
+        }
+
+      if (started)
+        {
+          if (closed)
+            res.close (true);
+
+          out.push_back (res);
+        }
+      else
+        {
+          out.push_back (p);
+        }
+    }
+
+  return out;
+}
+
+static Geom::PathVector
+apply_effect (GKeyFile *kf, const gchar *g, const Geom::PathVector &in, GimpImage *image)
+{
+  std::string      type = ks (kf, g, "type");
+  Geom::PathVector out;
+
+  if (type == "zigzag" || type == "wave" || type == "roughen")
+    {
+      double size   = kd (kf, g, "size", 8);
+      double ridges = kd (kf, g, "ridges", 24);
+      double length = kd (kf, g, "wavelength", 60);
+      bool   smooth = kd (kf, g, "smooth", 0) > 0.5 || type != "zigzag";
+      std::mt19937 rnd ((unsigned) kd (kf, g, "seed", 1));
+      std::uniform_real_distribution<double> uni (-1.0, 1.0);
+
+      for (const Polyline &pl : sample_pv (in, 1.0))
+        {
+          double             total = polyline_length (pl.pts, pl.closed);
+          int                n;
+          std::vector<Point> rp, nr, res;
+
+          if (type == "zigzag")
+            n = std::max (4, (int) ridges * 2) + (pl.closed ? 0 : 1);
+          else if (type == "wave")
+            n = std::max (16, (int) (total / std::max (2.0, length / 8.0)));
+          else
+            n = std::max (8, (int) (total / std::max (1.0, 100.0 / kd (kf, g, "detail", 20))));
+
+          rp = resample (pl.pts, pl.closed, n);
+          nr = normals (rp, pl.closed);
+
+          for (size_t i = 0; i < rp.size (); i++)
+            {
+              double d;
+
+              if (type == "zigzag")
+                d = size * ((i % 2) ? 1 : -1);
+              else if (type == "wave")
+                d = size * std::sin (2 * M_PI / std::max (1.0, length) *
+                                     total * i / (pl.closed ? n : n - 1));
+              else
+                d = size * uni (rnd);
+
+              res.push_back (rp[i] + nr[i] * d);
+            }
+
+          out.push_back (fit_points (res, pl.closed, 0.4, ! smooth));
+        }
+    }
+  else if (type == "twist" || type == "pucker")
+    {
+      Point  c   = pv_bounds (in).midpoint ();
+      double amt = kd (kf, g, type == "twist" ? "angle" : "amount", type == "twist" ? 90 : 40);
+      double rmax = 1;
+
+      for (const Polyline &pl : sample_pv (in, 2.0))
+        for (const Point &p : pl.pts)
+          rmax = std::max (rmax, Geom::distance (p, c));
+
+      for (const Polyline &pl : sample_pv (in, 2.0))
+        {
+          std::vector<Point> res;
+          int                n = pl.pts.size ();
+
+          for (int i = 0; i < n; i++)
+            {
+              Point  d = pl.pts[i] - c;
+              double r = Geom::L2 (d);
+
+              if (type == "twist")
+                {
+                  double a = amt * M_PI / 180 * (1 - r / rmax);
+
+                  res.push_back (c + d * Geom::Rotate (a));
+                }
+              else
+                {
+                  /*  pucker (< 0) / bloat (> 0): 0 at the corners of a
+                   *  regular shape, maximal between them
+                   */
+                  double w = std::fabs (std::sin (M_PI * 6 * i / n));
+
+                  res.push_back (c + d * (1 + amt / 100.0 * w));
+                }
+            }
+
+          out.push_back (fit_points (res, pl.closed, 0.4));
+        }
+    }
+  else if (type == "taper" || type == "powerstroke")
+    {
+      double width = kd (kf, g, "width", 12);
+      std::function<double (double)> prof;
+
+      if (type == "taper")
+        {
+          double s = std::max (0.0, kd (kf, g, "start", 0.2));
+          double e = std::max (0.0, kd (kf, g, "end", 0.2));
+
+          prof = [=] (double t)
+            {
+              double f = 1.0;
+
+              if (s > 0 && t < s)
+                f = t / s;
+              if (e > 0 && t > 1 - e)
+                f = std::min (f, (1 - t) / e);
+
+              return width * std::sqrt (std::max (0.0, f));
+            };
+        }
+      else
+        {
+          std::string spec = ks (kf, g, "widths");
+          auto        lp   = width_profile_side (spec, width, 0);
+          auto        rp   = width_profile_side (spec, width, 1);
+
+          for (const Polyline &pl : sample_pv (in, 1.0))
+            out.push_back (width_shape2 (pl.pts, pl.closed, lp, rp));
+
+          return out.empty () ? in : out;
+        }
+
+      for (const Polyline &pl : sample_pv (in, 1.0))
+        out.push_back (width_shape (pl.pts, pl.closed, prof));
+    }
+  else if (type == "envelope")
+    {
+      Geom::Rect bb = pv_bounds (in);
+      Point      tl = bb.corner (0) + Point (kd (kf, g, "tl-x", 0), kd (kf, g, "tl-y", 0));
+      Point      tr = bb.corner (1) + Point (kd (kf, g, "tr-x", 0), kd (kf, g, "tr-y", 0));
+      Point      br = bb.corner (2) + Point (kd (kf, g, "br-x", 0), kd (kf, g, "br-y", 0));
+      Point      bl = bb.corner (3) + Point (kd (kf, g, "bl-x", 0), kd (kf, g, "bl-y", 0));
+
+      for (const Polyline &pl : sample_pv (in, 1.5))
+        {
+          std::vector<Point> res;
+
+          for (const Point &p : pl.pts)
+            {
+              double u = (p[Geom::X] - bb.left ()) / std::max (1.0, bb.width ());
+              double v = (p[Geom::Y] - bb.top ())  / std::max (1.0, bb.height ());
+
+              res.push_back (Geom::lerp (v, Geom::lerp (u, tl, tr), Geom::lerp (u, bl, br)));
+            }
+
+          out.push_back (fit_points (res, pl.closed, 0.3));
+        }
+    }
+  else if (type == "bend")
+    {
+      /*  the horizontal axis becomes an arc of « angle » degrees  */
+      Geom::Rect bb    = pv_bounds (in);
+      double     angle = kd (kf, g, "angle", 60) * M_PI / 180;
+
+      if (std::fabs (angle) < 1e-3 || bb.width () < 1e-6)
+        return in;
+
+      double R  = bb.width () / angle;
+      Point  cc = Point (bb.midpoint ()[Geom::X], bb.midpoint ()[Geom::Y] + R);
+
+      for (const Polyline &pl : sample_pv (in, 1.5))
+        {
+          std::vector<Point> res;
+
+          for (const Point &p : pl.pts)
+            {
+              double a = (p[Geom::X] - bb.midpoint ()[Geom::X]) / R;
+              double r = R - (p[Geom::Y] - bb.midpoint ()[Geom::Y]);
+
+              res.push_back (cc + Point (std::sin (a) * r, -std::cos (a) * r));
+            }
+
+          out.push_back (fit_points (res, pl.closed, 0.3));
+        }
+    }
+  else if (type == "corners")
+    {
+      /*  3.29.0 « Angles dynamiques »  */
+      out = corners_pv (in, kd (kf, g, "radius", 0), ks (kf, g, "radii"), ks (kf, g, "mode"));
+    }
+  else if (type == "distort")
+    {
+      /*  3.27.6 « Objet > Distorsion »: mode « warp » (Illustrator's
+       *  Déformation presets), « mesh » (Enveloppe: a grid of points) or
+       *  « free » (Distorsion libre: 4 corners, perspective)
+       */
+      Geom::Rect  bb   = pv_bounds (in);
+      std::string box  = ks (kf, g, "box");
+      std::function<Point (const Point &)> map;
+
+      /*  « box=x,y,w,h »: the box the distortion is drawn on (set when
+       *  it was made: editing the contents does not move the envelope)
+       */
+      if (! box.empty ())
+        {
+          gchar **v = g_strsplit (box.c_str (), ",", -1);
+
+          if (g_strv_length (v) == 4)
+            {
+              double bx = g_ascii_strtod (v[0], NULL), by = g_ascii_strtod (v[1], NULL);
+              double bw = g_ascii_strtod (v[2], NULL), bh = g_ascii_strtod (v[3], NULL);
+
+              if (bw > 1e-6 && bh > 1e-6)
+                bb = Geom::Rect (bx, by, bx + bw, by + bh);
+            }
+
+          g_strfreev (v);
+        }
+
+      if (bb.width () < 1e-6 && bb.height () < 1e-6)
+        return in;
+
+      map = chopgimp_distort_map (kf, g, bb);
+
+      for (const Polyline &pl : sample_pv (in, 1.5))
+        {
+          std::vector<Point> res;
+
+          for (const Point &p : pl.pts)
+            res.push_back (map (p));
+
+          out.push_back (fit_points (res, pl.closed, 0.25));
+        }
+    }
+  else if (type == "pattern")
+    {
+      Geom::PathVector pattern = layer_pv (image, kd (kf, g, "pattern-tattoo", 0));
+
+      if (pattern.empty ())
+        return in;
+
+      out = along_path (pattern, in, kd (kf, g, "repeat", 1) > 0.5, kd (kf, g, "spacing", 4));
+    }
+  else if (type == "along")
+    {
+      /*  this shape bent along another path (Inkscape « Bend »)  */
+      Geom::PathVector spine = layer_pv (image, kd (kf, g, "spine-tattoo", 0));
+
+      if (spine.empty ())
+        return in;
+
+      out = along_path (in, spine, false, 0);
+    }
+  else if (type == "offset")
+    {
+      out = offset_pv (in, kd (kf, g, "distance", 5), CHOPGIMP_JOIN_ROUND);
+    }
+  else if (type == "round")
+    {
+      Geom::PathVector res;
+
+      for (const Geom::Path &p : in)
+        {
+          std::vector<Seg> segs = round_segs (path_to_segs (p), p.closed (),
+                                              kd (kf, g, "radius", 10), NULL);
+
+          if (segs.empty ())
+            {
+              res.push_back (p);
+              continue;
+            }
+
+          Stroke st = segs_to_stroke (segs, p.closed ());
+
+          res.push_back (stroke_to_path (st, false));
+        }
+
+      out = res;
+    }
+  else
+    {
+      return in;
+    }
+
+  return out.empty () ? in : out;
+}
+
+extern "C" GimpPath *
+chopgimp_geom_effects (GimpPath    *path,
+                       const gchar *spec)
+{
+  try
+    {
+    /*  freed on every way out, exceptions included  */
+    std::unique_ptr<GKeyFile, void (*) (GKeyFile *)>
+      kf (g_key_file_new (), g_key_file_free);
+    std::unique_ptr<gchar *, void (*) (gchar **)>
+      groups (NULL, g_strfreev);
+    Geom::PathVector pv;
+    GimpImage       *image = gimp_item_get_image (GIMP_ITEM (path));
+
+    if (! spec || ! g_key_file_load_from_data (kf.get (), spec, -1, G_KEY_FILE_NONE, NULL))
+      return NULL;
+
+    pv = to_pv (path);
+    groups.reset (g_key_file_get_groups (kf.get (), NULL));
+
+    /*  the effects apply in the order of their groups ([0], [1]…)  */
+    std::vector<std::string> order;
+
+    for (gchar **g = groups.get (); g && *g; g++)
+      order.push_back (*g);
+
+    std::sort (order.begin (), order.end (),
+               [] (const std::string &a, const std::string &b)
+               { return atoi (a.c_str ()) < atoi (b.c_str ()); });
+
+    for (const std::string &g : order)
+      {
+        if (kd (kf.get (), g.c_str (), "enabled", 1) < 0.5)
+          continue;
+
+        try
+          {
+            pv = apply_effect (kf.get (), g.c_str (), pv, image);
+          }
+        catch (std::exception &e)
+          {
+            g_warning ("ChopGimp path effect %s: %s", g.c_str (), e.what ());
+          }
+        catch (...)
+          {
+            g_warning ("ChopGimp path effect %s: lib2geom error", g.c_str ());
+          }
+      }
+
+    return from_pv (path, pv);
+    }
+  catch (...)
+    {
+      g_warning ("ChopGimp %s: lib2geom error", G_STRFUNC);
+      return NULL;
+    }
+}
+
+/* ─── islands (ChopGimp 3.27: « Décomposer les sous-tracés ») ──────── */
+
+/*  for each sub-path of @path, the index of the outer outline it belongs
+ *  to (itself for an outline, the smallest enclosing outline for a hole)
+ */
+extern "C" gint *
+chopgimp_geom_stroke_islands (GimpPath *path,
+                              gint     *n_strokes)
+{
+  std::vector<Geom::Path> subs;
+  std::vector<bool>       valid;
+  gint                   *owner;
+  gint                    n = 0;
+
+  for (GimpStroke *s = gimp_path_stroke_get_next (path, NULL);
+       s;
+       s = gimp_path_stroke_get_next (path, s))
+    {
+      Stroke   st;
+      gboolean closed = FALSE;
+
+      st.closed = false;
+
+      if (GIMP_IS_BEZIER_STROKE (s))
+        {
+          GArray *a = gimp_stroke_control_points_get (s, &closed);
+
+          for (guint i = 0; i + 2 < a->len; i += 3)
+            {
+              Node node;
+
+              node.in       = to_pt (&g_array_index (a, GimpAnchor, i));
+              node.pt       = to_pt (&g_array_index (a, GimpAnchor, i + 1));
+              node.out      = to_pt (&g_array_index (a, GimpAnchor, i + 2));
+              node.selected = FALSE;
+              st.nodes.push_back (node);
+            }
+
+          st.closed = closed;
+          g_array_free (a, TRUE);
+        }
+
+      try
+        {
+          subs.push_back (st.nodes.size () > 1 ? stroke_to_path (st, true)
+                                               : Geom::Path ());
+          valid.push_back (st.nodes.size () > 1);
+        }
+      catch (...)
+        {
+          subs.push_back (Geom::Path ());
+          valid.push_back (false);
+        }
+
+      n++;
+    }
+
+  *n_strokes = n;
+  owner      = g_new (gint, MAX (n, 1));
+
+  for (gint i = 0; i < n; i++)
+    owner[i] = i;
+
+  try
+    {
+      std::vector<int>    depth (n, 0);
+      std::vector<double> area (n, 0.0);
+      std::vector<Point>  probe (n);
+
+      for (gint i = 0; i < n; i++)
+        if (valid[i])
+          {
+            probe[i] = subs[i].empty () ? subs[i].initialPoint ()
+                                        : subs[i][0].pointAt (0.5);
+            area[i]  = path_area (subs[i]);
+          }
+
+      for (gint i = 0; i < n; i++)
+        if (valid[i])
+          for (gint j = 0; j < n; j++)
+            if (j != i && valid[j] && subs[j].winding (probe[i]) != 0)
+              depth[i]++;
+
+      for (gint i = 0; i < n; i++)
+        {
+          double best = -1;
+
+          if (! valid[i] || depth[i] % 2 == 0)
+            continue;
+
+          for (gint j = 0; j < n; j++)
+            if (j != i && valid[j] && depth[j] == depth[i] - 1 &&
+                subs[j].winding (probe[i]) != 0 &&
+                (best < 0 || area[j] < best))
+              {
+                best     = area[j];
+                owner[i] = j;
+              }
+        }
+    }
+  catch (...)
+    {
+      g_warning ("ChopGimp %s: lib2geom error", G_STRFUNC);
+
+      for (gint i = 0; i < n; i++)
+        owner[i] = i;
+    }
+
+  return owner;
+}
