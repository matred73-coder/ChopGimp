+
+/* ─── live paint (3.27.7): the planar arrangement of paths ─────────── */
+
+namespace
+{
+  struct PlanarSrc
+  {
+    Geom::Path p;
+    int        src;
+    double     t0, t1;      /* the time range of the original sub-path   */
+  };
+
+  struct PlanarEdge
+  {
+    Geom::Path p;
+    Geom::Path draw;        /* clipped to the original range (no gap)    */
+    bool       has_draw;
+    int        src;
+    int        u, v;
+    double     ang_u, ang_v;
+  };
+
+  double
+  leave_angle (const Geom::Path &p, bool from_end)
+  {
+    Geom::Point d (0, 0);
+    double      T = p.size_default ();
+
+    try
+      {
+        if (! from_end)
+          d = p[0].unitTangentAt (0.0);
+        else
+          d = -p[p.size_default () - 1].unitTangentAt (1.0);
+      }
+    catch (...)
+      {
+      }
+
+    if (! std::isfinite (d[Geom::X]) || Geom::L2 (d) < 1e-9)
+      {
+        double s = std::min (0.05, T);
+
+        d = from_end ? p.pointAt (T - s) - p.finalPoint ()
+                     : p.pointAt (s) - p.initialPoint ();
+      }
+
+    return std::atan2 (d[Geom::Y], d[Geom::X]);
+  }
+
+  void
+  sample_into (const Geom::Path &p, std::vector<Point> &pts)
+  {
+    double T = p.size_default ();
+    int    n = std::max (4, (int) std::ceil (T * 12));
+
+    for (int k = 0; k < n; k++)
+      pts.push_back (p.pointAt (T * k / n));
+  }
+
+  double
+  poly_area (const std::vector<Point> &pts)
+  {
+    double a = 0;
+
+    for (size_t i = 0; i < pts.size (); i++)
+      {
+        const Point &p = pts[i];
+        const Point &q = pts[(i + 1) % pts.size ()];
+
+        a += p[Geom::X] * q[Geom::Y] - q[Geom::X] * p[Geom::Y];
+      }
+
+    return a / 2.0;
+  }
+
+  int
+  uf_find (std::vector<int> &uf, int x)
+  {
+    while (uf[x] != x)
+      x = uf[x] = uf[uf[x]];
+
+    return x;
+  }
+}
+
+extern "C" gboolean
+chopgimp_geom_planar (GimpPath   **paths,
+                      gint         n_paths,
+                      gdouble      gap,
+                      GimpPath  ***faces,
+                      gint        *n_faces,
+                      GimpPath  ***edges,
+                      gint       **edge_src,
+                      gint        *n_edges)
+{
+  *faces    = NULL;
+  *edges    = NULL;
+  *edge_src = NULL;
+  *n_faces  = 0;
+  *n_edges  = 0;
+
+  if (n_paths < 1)
+    return FALSE;
+
+  try
+    {
+      std::vector<PlanarSrc>            srcs;
+      std::vector<std::vector<double>>  cuts;
+      std::vector<PlanarEdge>           E;
+      std::vector<Point>                V;
+      const double                      vtol = 0.02;
+
+      /*  1. the sub-paths, open ones extended by @gap at both ends  */
+      for (gint i = 0; i < n_paths; i++)
+        {
+          Geom::PathVector pv = to_pv (paths[i]);
+
+          for (const Geom::Path &p : pv)
+            {
+              PlanarSrc s;
+
+              if (p.size_default () == 0)
+                continue;
+
+              s.p   = p;
+              s.src = i;
+              s.t0  = 0;
+              s.t1  = p.size_default ();
+
+              if (! p.closed () && gap > 0)
+                {
+                  double      T  = p.size_default ();
+                  Geom::Point a  = p.initialPoint (), b = p.finalPoint ();
+                  Geom::Point da = a - p.pointAt (std::min (0.05, T));
+                  Geom::Point db = b - p.pointAt (std::max (T - 0.05, 0.0));
+
+                  if (Geom::L2 (da) > 1e-9 && Geom::L2 (db) > 1e-9)
+                    {
+                      Geom::Path e (a + Geom::unit_vector (da) * gap);
+
+                      e.setStitching (true);
+                      e.appendNew<Geom::LineSegment> (a);
+                      for (const Geom::Curve &c : p)
+                        e.append (c);
+                      e.appendNew<Geom::LineSegment> (b + Geom::unit_vector (db) * gap);
+
+                      s.p  = e;
+                      s.t0 = 1;
+                      s.t1 = 1 + T;
+                    }
+                }
+
+              srcs.push_back (s);
+            }
+        }
+
+      if (srcs.empty ())
+        return FALSE;
+
+      /*  2. where they cross  */
+      cuts.resize (srcs.size ());
+
+      for (size_t i = 0; i < srcs.size (); i++)
+        {
+          cuts[i].push_back (0.0);
+          if (! srcs[i].p.closed ())
+            cuts[i].push_back (srcs[i].p.size_default ());
+        }
+
+      /*  3.28.2: the boxes once, and the pairs by a sweep on x (only the
+       *  boxes that can overlap are tested)
+       */
+      std::vector<Geom::OptRect> boxes (srcs.size ());
+      std::vector<size_t>        order (srcs.size ());
+
+      for (size_t i = 0; i < srcs.size (); i++)
+        {
+          boxes[i] = srcs[i].p.boundsFast ();
+          if (boxes[i])
+            boxes[i]->expandBy (1.0);
+          order[i] = i;
+        }
+
+      std::sort (order.begin (), order.end (), [&] (size_t a, size_t b)
+        {
+          double xa = boxes[a] ? boxes[a]->left () : 1e300;
+          double xb = boxes[b] ? boxes[b]->left () : 1e300;
+          return xa < xb;
+        });
+
+      for (size_t i = 0; i < srcs.size (); i++)
+        for (const Geom::PathIntersection &x : srcs[i].p.intersectSelf ())
+          {
+            cuts[i].push_back (x.first.curve_index + x.first.t);
+            cuts[i].push_back (x.second.curve_index + x.second.t);
+          }
+
+      for (size_t oi = 0; oi < order.size (); oi++)
+        {
+          size_t i = order[oi];
+
+          if (! boxes[i])
+            continue;
+
+          for (size_t oj = oi + 1; oj < order.size (); oj++)
+            {
+              size_t j = order[oj];
+
+              if (! boxes[j] || boxes[j]->left () > boxes[i]->right ())
+                break;
+
+              if (! boxes[i]->intersects (*boxes[j]))
+                continue;
+
+              /*  the same order of the pair as before (i < j)  */
+              size_t a = std::min (i, j), b = std::max (i, j);
+
+              for (const Geom::PathIntersection &x : srcs[a].p.intersect (srcs[b].p))
+                {
+                  cuts[a].push_back (x.first.curve_index + x.first.t);
+                  cuts[b].push_back (x.second.curve_index + x.second.t);
+                }
+            }
+        }
+
+      /*  3. the edges between the cuts  */
+      /*  3.28.2: a grid of cells of vtol (was a linear search)  */
+      std::unordered_map<long long, std::vector<int>> vgrid;
+      auto vkey = [&] (long long cx, long long cy) -> long long
+        {
+          return (cx << 32) ^ (cy & 0xffffffffLL);
+        };
+      auto vertex = [&] (const Point &pt) -> int
+        {
+          long long cx = (long long) std::floor (pt[0] / std::max (vtol, 1e-9));
+          long long cy = (long long) std::floor (pt[1] / std::max (vtol, 1e-9));
+
+          for (long long dx = -1; dx <= 1; dx++)
+            for (long long dy = -1; dy <= 1; dy++)
+              {
+                auto it = vgrid.find (vkey (cx + dx, cy + dy));
+
+                if (it != vgrid.end ())
+                  for (int k : it->second)
+                    if (Geom::L2 (V[k] - pt) < vtol)
+                      return k;
+              }
+
+          V.push_back (pt);
+          vgrid[vkey (cx, cy)].push_back ((int) V.size () - 1);
+          return (int) V.size () - 1;
+        };
+
+      for (size_t i = 0; i < srcs.size (); i++)
+        {
+          const Geom::Path    &p      = srcs[i].p;
+          double               T      = p.size_default ();
+          bool                 closed = p.closed ();
+          std::vector<double> &c      = cuts[i];
+          std::vector<double>  u;
+
+          for (double &t : c)
+            t = CLAMP (t, 0.0, T);
+
+          std::sort (c.begin (), c.end ());
+
+          for (double t : c)
+            if (u.empty () || t - u.back () > 1e-6)
+              u.push_back (t);
+
+          if (closed && u.size () > 1 && T - u.back () < 1e-6)
+            u.pop_back ();
+
+          for (size_t k = 0; k < u.size (); k++)
+            {
+              double     a = u[k], b;
+              PlanarEdge e;
+
+              if (k + 1 < u.size ())
+                b = u[k + 1];
+              else if (closed)
+                b = u[0] + T;
+              else
+                break;
+
+              if (b - a < 1e-9)
+                continue;
+
+              if (b <= T + 1e-12)
+                {
+                  e.p = p.portion (a, std::min (b, T));
+                }
+              else
+                {
+                  Geom::Path rest = p.portion (0.0, b - T);
+
+                  e.p = p.portion (a, T);
+                  e.p.setStitching (true);
+                  for (const Geom::Curve &cv : rest)
+                    e.p.append (cv);
+                }
+
+              e.p.close (false);
+              e.src      = srcs[i].src;
+              e.has_draw = false;
+
+              {
+                double ca = std::max (a, srcs[i].t0);
+                double cb = std::min (b, srcs[i].t1);
+
+                if (b > T)   /* wrapped: closed sub-paths have no gap */
+                  {
+                    e.draw     = e.p;
+                    e.has_draw = true;
+                  }
+                else if (cb - ca > 1e-6)
+                  {
+                    e.draw     = p.portion (ca, cb);
+                    e.has_draw = true;
+                  }
+              }
+
+              e.u = vertex (e.p.initialPoint ());
+              e.v = vertex (e.p.finalPoint ());
+
+              if (e.u == e.v)
+                {
+                  Geom::OptRect r = e.p.boundsFast ();
+
+                  if (! r || (r->width () < vtol && r->height () < vtol))
+                    continue;
+                }
+
+              e.ang_u = leave_angle (e.p, false);
+              e.ang_v = leave_angle (e.p, true);
+
+              E.push_back (e);
+            }
+        }
+
+      /*  4. the faces: walk the half-edges, the face on the left  */
+      size_t                         nh = E.size () * 2;
+      std::vector<std::vector<int>>  out (V.size ());
+      std::vector<int>               pos (nh, 0);
+      std::vector<char>              seen (nh, 0);
+      std::vector<int>               uf (V.size ());
+
+      auto origin = [&] (int h) { return (h & 1) ? E[h / 2].v : E[h / 2].u; };
+      auto target = [&] (int h) { return (h & 1) ? E[h / 2].u : E[h / 2].v; };
+      auto angle  = [&] (int h) { return (h & 1) ? E[h / 2].ang_v : E[h / 2].ang_u; };
+
+      for (size_t k = 0; k < V.size (); k++)
+        uf[k] = (int) k;
+
+      for (size_t h = 0; h < nh; h++)
+        out[origin ((int) h)].push_back ((int) h);
+
+      for (size_t e = 0; e < E.size (); e++)
+        uf[uf_find (uf, E[e].u)] = uf_find (uf, E[e].v);
+
+      for (auto &list : out)
+        {
+          std::sort (list.begin (), list.end (),
+                     [&] (int a, int b) { return angle (a) < angle (b); });
+
+          for (size_t k = 0; k < list.size (); k++)
+            pos[list[k]] = (int) k;
+        }
+
+      struct Cycle { Geom::Path path; double area; int comp; };
+      std::vector<Cycle> cycles;
+
+      for (size_t h0 = 0; h0 < nh; h0++)
+        {
+          Cycle              cy;
+          std::vector<Point> pts;
+          int                h     = (int) h0;
+          size_t             guard = 0;
+
+          if (seen[h0])
+            continue;
+
+          cy.path = Geom::Path (Geom::Point (0, 0));
+          cy.path.setStitching (true);
+          bool first = true;
+
+          while (! seen[h] && guard++ <= nh)
+            {
+              const Geom::Path piece = (h & 1) ? E[h / 2].p.reversed () : E[h / 2].p;
+              std::vector<int>   &lst = out[target (h)];
+              int                 tw  = h ^ 1;
+              int                 deg = (int) lst.size ();
+
+              seen[h] = 1;
+
+              if (first)
+                {
+                  cy.path = Geom::Path (piece.initialPoint ());
+                  cy.path.setStitching (true);
+                  first = false;
+                }
+
+              for (const Geom::Curve &c : piece)
+                cy.path.append (c);
+
+              sample_into (piece, pts);
+
+              h = lst[(pos[tw] - 1 + deg) % deg];
+            }
+
+          cy.path.close (true);
+          cy.area = poly_area (pts);
+          cy.comp = uf_find (uf, origin ((int) h0));
+
+          if (std::fabs (cy.area) >= 0.25)
+            cycles.push_back (cy);
+        }
+
+      /*  bounded faces (positive), and the outer outline of each
+       *  component (negative) as a hole of the smallest face around it
+       */
+      std::vector<Geom::PathVector> fpv;
+      std::vector<int>              fidx;
+
+      for (size_t k = 0; k < cycles.size (); k++)
+        if (cycles[k].area > 0)
+          {
+            fpv.push_back (Geom::PathVector (cycles[k].path));
+            fidx.push_back ((int) k);
+          }
+
+      for (const Cycle &cy : cycles)
+        {
+          int    best   = -1;
+          double best_a = 0;
+          Point  pt     = cy.path.initialPoint ();
+
+          if (cy.area > 0)
+            continue;
+
+          for (size_t f = 0; f < fidx.size (); f++)
+            {
+              const Cycle &fc = cycles[fidx[f]];
+
+              if (fc.comp == cy.comp)
+                continue;
+
+              if (fc.path.winding (pt) != 0 &&
+                  (best < 0 || fc.area < best_a))
+                {
+                  best   = (int) f;
+                  best_a = fc.area;
+                }
+            }
+
+          if (best >= 0)
+            fpv[best].push_back (cy.path);
+        }
+
+      /*  5. out  */
+      {
+        std::vector<GimpPath *> fo;
+        std::vector<GimpPath *> eo;
+        std::vector<gint>       es;
+
+        for (const Geom::PathVector &pv : fpv)
+          if (GimpPath *gp = from_pv (paths[0], pv))
+            fo.push_back (gp);
+
+        for (const PlanarEdge &e : E)
+          if (e.has_draw)
+            if (GimpPath *gp = from_pv (paths[0], Geom::PathVector (e.draw)))
+              {
+                eo.push_back (gp);
+                es.push_back (e.src);
+              }
+
+        *n_faces  = fo.size ();
+        *faces    = g_new0 (GimpPath *, fo.size () + 1);
+        std::copy (fo.begin (), fo.end (), *faces);
+
+        *n_edges  = eo.size ();
+        *edges    = g_new0 (GimpPath *, eo.size () + 1);
+        *edge_src = g_new0 (gint, es.size () + 1);
+        std::copy (eo.begin (), eo.end (), *edges);
+        std::copy (es.begin (), es.end (), *edge_src);
+      }
+
+      return TRUE;
+    }
+  catch (...)
+    {
+      g_warning ("ChopGimp %s: lib2geom error", G_STRFUNC);
+      return FALSE;
+    }
+}
+
+extern "C" gdouble
+chopgimp_geom_distance (GimpPath *path,
+                        gdouble   x,
+                        gdouble   y)
+{
+  try
+    {
+      Geom::PathVector pv   = to_pv (path);
+      double           best = G_MAXDOUBLE;
+
+      for (const Geom::Path &p : pv)
+        {
+          double d = G_MAXDOUBLE;
+
+          if (p.size_default () == 0)
+            continue;
+
+          p.nearestTime (Point (x, y), &d);
+          best = std::min (best, d);
+        }
+
+      return best;
+    }
+  catch (...)
+    {
+      return G_MAXDOUBLE;
+    }
+}
+
+extern "C" gboolean
+chopgimp_geom_midpoint (GimpPath *path,
+                        gdouble  *x,
+                        gdouble  *y)
+{
+  try
+    {
+      Geom::PathVector pv = to_pv (path);
+
+      for (const Geom::Path &p : pv)
+        if (p.size_default () > 0)
+          {
+            Point m = p.pointAt (p.size_default () / 2.0);
+
+            *x = m[Geom::X];
+            *y = m[Geom::Y];
+            return TRUE;
+          }
+    }
+  catch (...)
+    {
+    }
+
+  return FALSE;
+}
+
+
+/* ─── 3.28.2: points through a distortion (Convertir en maille) ──────── */
+
+extern "C" gboolean
+chopgimp_geom_distort_map (const gchar *spec,
+                           gdouble     *xy,
+                           gint         n)
+{
+  GKeyFile  *kf     = g_key_file_new ();
+  gchar    **groups = NULL;
+  gboolean   done   = FALSE;
+
+  if (! spec || ! g_key_file_load_from_data (kf, spec, -1, G_KEY_FILE_NONE, NULL))
+    {
+      g_key_file_free (kf);
+      return FALSE;
+    }
+
+  groups = g_key_file_get_groups (kf, NULL);
+
+  for (gchar **g = groups; g && *g && ! done; g++)
+    {
+      if (ks (kf, *g, "type") != "distort")
+        continue;
+
+      std::string box = ks (kf, *g, "box");
+      gchar     **v   = g_strsplit (box.c_str (), ",", -1);
+
+      if (g_strv_length (v) == 4)
+        {
+          double bx = g_ascii_strtod (v[0], NULL), by = g_ascii_strtod (v[1], NULL);
+          double bw = g_ascii_strtod (v[2], NULL), bh = g_ascii_strtod (v[3], NULL);
+
+          if (bw > 1e-6 && bh > 1e-6)
+            {
+              Geom::Rect bb (bx, by, bx + bw, by + bh);
+              auto       map = chopgimp_distort_map (kf, *g, bb);
+
+              if (map)
+                {
+                  for (gint i = 0; i < n; i++)
+                    {
+                      Point q = map (Point (xy[2 * i], xy[2 * i + 1]));
+
+                      xy[2 * i]     = q[0];
+                      xy[2 * i + 1] = q[1];
+                    }
+                  done = TRUE;
+                }
+            }
+        }
+
+      g_strfreev (v);
+    }
+
+  g_strfreev (groups);
+  g_key_file_free (kf);
+
+  return done;
+}
+
+
+/* ─── 3.29.0: drawing tools (Courbure, Crayon, Lissage, Ciseaux,
+ *     Jonction) and live corners ────────────────────────────────────── */
+
+extern "C" gdouble *
+chopgimp_geom_corner_points (GimpPath *path,
+                             gint     *n_corners)
+{
+  try
+    {
+    std::vector<double> v;
+
+    for (const Geom::Path &p : to_pv (path))
+      {
+        auto   curves = corner_curves (p);
+        size_t n      = curves.size ();
+
+        if (n < 2)
+          continue;
+
+        for (size_t j = p.closed () ? 0 : 1; j < n; j++)
+          {
+            const Geom::Curve &a = *curves[(j + n - 1) % n];
+            const Geom::Curve &b = *curves[j];
+
+            if (is_corner (a, b, (double *) NULL))
+              {
+                Point P   = b.initialPoint ();
+                Point bis = Geom::unit_vector (b.unitTangentAt (0.0) - a.unitTangentAt (1.0));
+
+                v.push_back (P[Geom::X]);
+                v.push_back (P[Geom::Y]);
+                v.push_back (bis[Geom::X]);
+                v.push_back (bis[Geom::Y]);
+              }
+          }
+      }
+
+    *n_corners = v.size () / 4;
+
+    if (v.empty ())
+      return NULL;
+
+    return (gdouble *) g_memdup2 (v.data (), v.size () * sizeof (double));
+    }
+  catch (...)
+    {
+      *n_corners = 0;
+      return NULL;
+    }
+}
+
+/*  cubic Béziers through the points (Schneider's fit, as Inkscape's pencil)  */
+static Geom::Path
+fit_path (const std::vector<Point> &pts,
+          double                    tolerance,
+          bool                      closed)
+{
+  Geom::Path path;
+
+  if (pts.size () < 2)
+    return path;
+
+  std::vector<Point> b (4 * 256);
+  int                n = Geom::bezier_fit_cubic_r (b.data (), pts.data (), pts.size (),
+                                                   tolerance * tolerance, 256);
+
+  if (n <= 0)
+    {
+      path.start (pts.front ());
+      for (size_t i = 1; i < pts.size (); i++)
+        path.appendNew<Geom::LineSegment> (pts[i]);
+    }
+  else
+    {
+      path.start (b[0]);
+      for (int i = 0; i < n; i++)
+        path.appendNew<Geom::CubicBezier> (b[4 * i + 1], b[4 * i + 2], b[4 * i + 3]);
+    }
+
+  if (closed)
+    path.close (true);
+
+  return path;
+}
+
+/*  @like: any path of the image (gives the image of the result)  */
+extern "C" GimpPath *
+chopgimp_geom_fit_points (GimpPath      *like,
+                          const gdouble *xy,
+                          gint           n,
+                          gdouble        tolerance,
+                          gboolean       closed)
+{
+  try
+    {
+    std::vector<Point> pts;
+
+    for (gint i = 0; i < n; i++)
+      {
+        Point p (xy[2 * i], xy[2 * i + 1]);
+
+        if (pts.empty () || Geom::distance (pts.back (), p) > 0.5)
+          pts.push_back (p);
+      }
+
+    if (pts.size () < 2)
+      return NULL;
+
+    Geom::PathVector pv;
+
+    pv.push_back (fit_path (pts, MAX (tolerance, 0.1), closed));
+
+    return from_pv (like, pv);
+    }
+  catch (...)
+    {
+      g_warning ("ChopGimp %s: lib2geom error", G_STRFUNC);
+      return NULL;
+    }
+}
+
+/*  « Lissage »: the parts of @path within @radius of (x, y) are sampled,
+ *  smoothed (moving average) and refitted; the rest is kept
+ */
+extern "C" GimpPath *
+chopgimp_geom_smooth_local (GimpPath *path,
+                            gdouble   x,
+                            gdouble   y,
+                            gdouble   radius,
+                            gdouble   strength)
+{
+  try
+    {
+    Geom::PathVector in = to_pv (path), out;
+    Point            c (x, y);
+    bool             changed = false;
+
+    for (const Geom::Path &p : in)
+      {
+        Geom::OptRect bb = p.boundsFast ();
+
+        if (! bb || ! [&] { Geom::Rect r = *bb; r.expandBy (radius); return r.contains (c); } ())
+          {
+            out.push_back (p);
+            continue;
+          }
+
+        /*  sample the whole sub-path  */
+        std::vector<Point> s;
+        size_t             nc = p.closed () ? p.size_closed () : p.size_open ();
+
+        for (size_t i = 0; i < nc; i++)
+          for (int k = 0; k < 12; k++)
+            s.push_back (p[i].pointAt (k / 12.0));
+        if (! p.closed ())
+          s.push_back (p.finalPoint ());
+
+        bool near = false;
+
+        for (const Point &q : s)
+          if (Geom::distance (q, c) < radius)
+            near = true;
+
+        if (! near || s.size () < 4)
+          {
+            out.push_back (p);
+            continue;
+          }
+
+        /*  uniform resampling (step ≈ 1.5 px), so that the neighbourhood
+         *  of a sample is a length on the path and not a parameter
+         */
+        {
+          const double       step = 1.5;
+          std::vector<Point> u;
+          double             carry = 0.0;
+
+          u.push_back (s[0]);
+          for (size_t i = 1; i < s.size (); i++)
+            {
+              Point  a   = s[i - 1], b = s[i];
+              double len = Geom::distance (a, b);
+              double t   = step - carry;
+
+              while (t <= len)
+                {
+                  u.push_back (a + (b - a) * (t / len));
+                  t += step;
+                }
+              carry = len - (t - step);
+            }
+          if (! p.closed () && Geom::distance (u.back (), s.back ()) > 1e-6)
+            u.push_back (s.back ());
+          if (u.size () >= 4)
+            s = u;
+        }
+
+        /*  smoothing inside the brush: each sample moves towards the
+         *  mean of the samples within 0.4 × the radius along the path
+         *  (box filter, no kink), weight falling to 0 at the edge of the
+         *  brush so that the rest of the path does not move
+         */
+        int    passes = 1 + (int) (CLAMP (strength, 0.0, 1.0) * 8);
+        size_t m      = MAX (2, (size_t) (radius * 0.4 / 1.5));
+        size_t ns     = s.size ();
+
+        for (int pass = 0; pass < passes; pass++)
+          {
+            std::vector<Point> t = s;
+
+            for (size_t i = 0; i < ns; i++)
+              {
+                double d = Geom::distance (s[i], c);
+
+                if (d >= radius)
+                  continue;
+                if (! p.closed () && (i < m || i + m >= ns))
+                  continue;
+
+                {
+                  Point  mean (0, 0);
+                  double w = 0.8 * (1.0 - d / radius);
+
+                  for (size_t k = 0; k <= 2 * m; k++)
+                    mean += s[(i + ns - m + k) % ns];
+                  mean /= (double) (2 * m + 1);
+
+                  t[i] = s[i] * (1.0 - w) + mean * w;
+                }
+              }
+
+            s = t;
+          }
+
+        out.push_back (fit_path (s, 0.6, p.closed ()));
+        changed = true;
+      }
+
+    return changed ? from_pv (path, out) : NULL;
+    }
+  catch (...)
+    {
+      g_warning ("ChopGimp %s: lib2geom error", G_STRFUNC);
+      return NULL;
+    }
+}
+
+/*  « Ciseaux »: cuts the sub-path nearest to (x, y) (within @tolerance)
+ *  there: a closed one opens at that point, an open one becomes two;
+ *  NULL when nothing is near
+ */
+extern "C" GimpPath *
+chopgimp_geom_cut_at (GimpPath *path,
+                      gdouble   x,
+                      gdouble   y,
+                      gdouble   tolerance)
+{
+  try
+    {
+    Geom::PathVector in = to_pv (path), out;
+    Point            c (x, y);
+    int              best = -1;
+    double           best_d = tolerance;
+    Geom::PathTime   best_t;
+
+    for (size_t i = 0; i < in.size (); i++)
+      {
+        Geom::PathTime t = in[i].nearestTime (c);
+        double         d = Geom::distance (in[i].pointAt (t), c);
+
+        if (d <= best_d)
+          {
+            best   = i;
+            best_d = d;
+            best_t = t;
+          }
+      }
+
+    if (best < 0)
+      return NULL;
+
+    for (size_t i = 0; i < in.size (); i++)
+      {
+        const Geom::Path &p = in[i];
+
+        if ((int) i != best)
+          {
+            out.push_back (p);
+            continue;
+          }
+
+        double tt = best_t.curve_index + best_t.t;
+        double te = p.closed () ? (double) p.size_closed () : (double) p.size_open ();
+
+        if (p.closed ())
+          {
+            Geom::Path a = p.portion (tt, te);
+            Geom::Path b = p.portion (0.0, tt);
+
+            a.setStitching (true);
+
+            if (b.size () > 0)
+              a.append (b);
+            a.close (false);
+            out.push_back (a);
+          }
+        else
+          {
+            if (tt > 1e-4)
+              out.push_back (p.portion (0.0, tt));
+            if (te - tt > 1e-4)
+              out.push_back (p.portion (tt, te));
+          }
+      }
+
+    return from_pv (path, out);
+    }
+  catch (...)
+    {
+      g_warning ("ChopGimp %s: lib2geom error", G_STRFUNC);
+      return NULL;
+    }
+}
+
+/*  the ends of the open sub-paths: x, y pairs, two per open sub-path
+ *  (start, end), in the order of the sub-paths; g_free
+ */
+extern "C" gdouble *
+chopgimp_geom_endpoints (GimpPath *path,
+                         gint     *n_open)
+{
+  try
+    {
+    std::vector<double> v;
+
+    for (const Geom::Path &p : to_pv (path))
+      if (! p.closed ())
+        {
+          v.push_back (p.initialPoint ()[Geom::X]);
+          v.push_back (p.initialPoint ()[Geom::Y]);
+          v.push_back (p.finalPoint ()[Geom::X]);
+          v.push_back (p.finalPoint ()[Geom::Y]);
+        }
+
+    *n_open = v.size () / 4;
+
+    return v.empty () ? NULL
+                      : (gdouble *) g_memdup2 (v.data (), v.size () * sizeof (double));
+    }
+  catch (...)
+    {
+      *n_open = 0;
+      return NULL;
+    }
+}
+
+/*  « Jonction »: joins the end @end_a (0: start, 1: end) of the open
+ *  sub-path @sub_a of @a to the end @end_b of the sub-path @sub_b of @b
+ *  (@b may be @a: the same sub-path is closed). Ends closer than 0.5 px
+ *  are merged, else a line joins them. The other sub-paths of @a (and
+ *  of @b) are kept. NULL on failure.
+ */
+extern "C" GimpPath *
+chopgimp_geom_join (GimpPath *a,
+                    gint      sub_a,
+                    gint      end_a,
+                    GimpPath *b,
+                    gint      sub_b,
+                    gint      end_b)
+{
+  try
+    {
+    Geom::PathVector pa = to_pv (a), pb = (b == a) ? pa : to_pv (b), out;
+    std::vector<int> open_a, open_b;
+
+    for (size_t i = 0; i < pa.size (); i++)
+      if (! pa[i].closed ()) open_a.push_back (i);
+    for (size_t i = 0; i < pb.size (); i++)
+      if (! pb[i].closed ()) open_b.push_back (i);
+
+    if (sub_a < 0 || sub_a >= (int) open_a.size () ||
+        sub_b < 0 || sub_b >= (int) open_b.size ())
+      return NULL;
+
+    int        ia = open_a[sub_a], ib = open_b[sub_b];
+    Geom::Path x  = pa[ia];
+
+    if (b == a && ia == ib)
+      {
+        if (end_a == end_b)
+          return NULL;
+
+        if (Geom::distance (x.initialPoint (), x.finalPoint ()) < 0.5)
+          x.setFinal (x.initialPoint ());
+        x.close (true);
+
+        for (size_t i = 0; i < pa.size (); i++)
+          out.push_back ((int) i == ia ? x : pa[i]);
+
+        return from_pv (a, out);
+      }
+
+    Geom::Path y = pb[ib];
+
+    if (end_a == 0) x = x.reversed ();   /* the joined end is x's final point */
+    if (end_b == 1) y = y.reversed ();   /* and y's initial point             */
+
+    x.setStitching (true);
+
+    if (Geom::distance (x.finalPoint (), y.initialPoint ()) < 0.5)
+      x.setFinal (y.initialPoint ());
+    else
+      x.appendNew<Geom::LineSegment> (y.initialPoint ());
+
+    x.append (y);
+
+    for (size_t i = 0; i < pa.size (); i++)
+      if ((int) i != ia && ! (b == a && (int) i == ib))
+        out.push_back (pa[i]);
+
+    out.push_back (x);
+
+    return from_pv (a, out);
+    }
+  catch (...)
+    {
+      g_warning ("ChopGimp %s: lib2geom error", G_STRFUNC);
+      return NULL;
+    }
+}
