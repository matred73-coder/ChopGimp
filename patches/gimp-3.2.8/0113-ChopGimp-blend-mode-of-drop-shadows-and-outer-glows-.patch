+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-behind-effects.c
+ * ChopGimp: drop shadows and outer glows composited with their own blend
+ * mode onto the layers below, as in Photoshop
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*  In Photoshop, a drop shadow or an outer glow is composited with its
+ *  own blend mode (Multiply, Screen...) onto what lies below the layer,
+ *  then the layer is composited with its mode. A GIMP filter only sees
+ *  its layer: the filter renders the layer over the shadow, and the
+ *  result is composited with the layer's mode.
+ *
+ *  A gegl:dropshadow filter whose "blend-mode" (GEGL patch 0007) is not
+ *  "normal" is a "behind effect" (in replace mode, on a layer which is
+ *  not a floating selection, a pass-through group, a layer excluding its
+ *  backdrop or showing its mask):
+ *
+ *  - the filter stack (gimp_filter_stack_set_behind_func()) takes it out
+ *    of the filters' chain: its node gets the chain's output at its
+ *    place, the filters above go on without it. A chopgimp:behind-knockout
+ *    node gives the effect alone: the filter's output minus its input,
+ *    i.e. the shadow where the layer does not cover it (Photoshop's
+ *    "Layer Knocks Out Drop Shadow");
+ *
+ *  - the layer's node composites each behind effect, from the bottom up,
+ *    onto the backdrop before the layer's mode node:
+ *
+ *      input (backdrop) -> compose 1 -> ... -> compose n -> mode node
+ *                              ^aux                ^aux       ^aux layer
+ *              knockout 1 -> translate   knockout n -> translate
+ *
+ *    each compose node is a gimp:layer-mode node in the effect's blend
+ *    mode, with the layer's opacity and mask (aux2), the translate node
+ *    follows the layer's offset. The layer's own mode, opacity and mask
+ *    are unchanged.
+ *
+ *  Nothing changes for any other filter: a "normal" drop shadow (all the
+ *  files saved before) is chained as before, the layer's node is the
+ *  same. The drawable's bounding box includes the behind effects. A
+ *  behind filter is not fused (gimpdrawable-fused-styles.c), keeps its
+ *  own cache, and is chained again (normal mode) while the filters are
+ *  merged (rasterized), since the layers below are not part of the
+ *  layer.
+ *
+ *  CHOPGIMP_NO_BEHIND_MODES=1 in the environment turns this off: every
+ *  filter is chained, the blend mode of shadows is then ignored.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+#include <gegl-plugin.h>
+
+#include "core-types.h"
+
+#include "gegl/gimp-gegl-nodes.h"
+
+#include "gimpdrawable.h"
+#include "gimpdrawable-filters.h"
+#include "gimpdrawablefilter.h"
+#include "gimpfilterstack.h"
+#include "gimpitem.h"
+#include "gimplayer.h"
+#include "gimplayermask.h"
+
+#include "chopgimp-behind-effects.h"
+
+
+#define STATE_KEY "chopgimp-behind-effects"
+
+
+typedef struct
+{
+  GeglNode      *knockout;  /*  the stack's, not referenced     */
+  GeglNode      *offset;    /*  gegl:translate, in layer node   */
+  GeglNode      *compose;   /*  gimp:layer-mode, in layer node  */
+  GimpLayerMode  mode;
+  gdouble        opacity;
+} Entry;
+
+typedef struct
+{
+  GimpDrawable *drawable;
+  GeglNode     *node;       /*  the layer's node, once built     */
+  GArray       *entries;    /*  Entry, bottom up                 */
+  gint          suspended;
+} State;
+
+
+static void
+state_free (State *state)
+{
+  g_array_free (state->entries, TRUE);
+  g_slice_free (State, state);
+}
+
+static State *
+get_state (GimpDrawable *drawable)
+{
+  return g_object_get_data (G_OBJECT (drawable), STATE_KEY);
+}
+
+gboolean
+chopgimp_behind_effects_enabled (void)
+{
+  static gint enabled = -1;
+
+  if (enabled < 0)
+    {
+      const gchar *env = g_getenv ("CHOPGIMP_NO_BEHIND_MODES");
+
+      enabled = ! (env && *env && strcmp (env, "0"));
+    }
+
+  return enabled;
+}
+
+GimpLayerMode
+chopgimp_behind_effects_get_filter_mode (GimpFilter *filter)
+{
+  static GParamSpec *pspec = NULL;
+  static gboolean    known = FALSE;
+  GeglNode          *node;
+  const gchar       *operation;
+  gint               value = 0;
+  GEnumValue        *enum_value;
+  GEnumClass        *mode_class;
+  GEnumValue        *mode_value;
+
+  if (! GIMP_IS_DRAWABLE_FILTER (filter))
+    return GIMP_LAYER_MODE_NORMAL;
+
+  node = gimp_drawable_filter_get_operation (GIMP_DRAWABLE_FILTER (filter));
+
+  if (! node)
+    return GIMP_LAYER_MODE_NORMAL;
+
+  operation = gegl_node_get_operation (node);
+
+  if (! operation || strcmp (operation, "gegl:dropshadow"))
+    return GIMP_LAYER_MODE_NORMAL;
+
+  /*  without GEGL patch 0007, there is no blend mode  */
+  if (! known)
+    {
+      pspec = gegl_operation_find_property ("gegl:dropshadow", "blend-mode");
+      known = TRUE;
+    }
+
+  if (! pspec || ! G_IS_PARAM_SPEC_ENUM (pspec))
+    return GIMP_LAYER_MODE_NORMAL;
+
+  gegl_node_get (node, "blend-mode", &value, NULL);
+
+  enum_value = g_enum_get_value (G_PARAM_SPEC_ENUM (pspec)->enum_class, value);
+
+  if (! enum_value)
+    return GIMP_LAYER_MODE_NORMAL;
+
+  /*  the nicks are GimpLayerMode's  */
+  mode_class = g_type_class_ref (GIMP_TYPE_LAYER_MODE);
+  mode_value = g_enum_get_value_by_nick (mode_class, enum_value->value_nick);
+  g_type_class_unref (mode_class);
+
+  if (! mode_value)
+    return GIMP_LAYER_MODE_NORMAL;
+
+  return (GimpLayerMode) mode_value->value;
+}
+
+/*  the layer can have behind effects  */
+static gboolean
+layer_accepts_behind (GimpLayer *layer)
+{
+  GimpLayerMask *mask = gimp_layer_get_mask (layer);
+
+  return (! gimp_layer_is_floating_sel (layer)                         &&
+          gimp_layer_get_mode (layer) != GIMP_LAYER_MODE_PASS_THROUGH &&
+          ! gimp_layer_get_excludes_backdrop (layer)                  &&
+          ! (mask && gimp_layer_get_show_mask (layer)));
+}
+
+gboolean
+chopgimp_behind_effects_is_behind (GimpDrawable *drawable,
+                                   GimpFilter   *filter)
+{
+  State *state;
+
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), FALSE);
+  g_return_val_if_fail (GIMP_IS_FILTER (filter), FALSE);
+
+  if (! chopgimp_behind_effects_enabled ())
+    return FALSE;
+
+  state = get_state (drawable);
+
+  if (! state || state->suspended || ! GIMP_IS_LAYER (drawable))
+    return FALSE;
+
+  if (! GIMP_IS_DRAWABLE_FILTER (filter) ||
+      ! gimp_filter_get_active (filter))
+    return FALSE;
+
+  /*  the filter's output is the layer over its shadow  */
+  if (gimp_drawable_filter_get_paint_mode (GIMP_DRAWABLE_FILTER (filter)) !=
+      GIMP_LAYER_MODE_REPLACE)
+    return FALSE;
+
+  if (chopgimp_behind_effects_get_filter_mode (filter) ==
+      GIMP_LAYER_MODE_NORMAL)
+    return FALSE;
+
+  return layer_accepts_behind (GIMP_LAYER (drawable));
+}
+
+gboolean
+chopgimp_behind_effects_is_linked (GimpDrawable *drawable,
+                                   GimpFilter   *filter)
+{
+  GList *list;
+
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), FALSE);
+
+  if (! get_state (drawable))
+    return FALSE;
+
+  for (list = gimp_filter_stack_get_behind (GIMP_FILTER_STACK (gimp_drawable_get_filters (drawable)));
+       list;
+       list = g_list_next (list))
+    {
+      GimpFilterStackBehind *behind = list->data;
+
+      if (behind->filter == filter)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+
+/*  the layer's node  */
+
+static void
+knockout_invalidated (GeglNode            *node,
+                      const GeglRectangle *rect,
+                      GimpDrawable        *drawable)
+{
+  /*  groups update the area GEGL invalidated through their filters  */
+  gimp_drawable_add_filters_invalidated (drawable, rect);
+}
+
+static void
+entry_destroy (State *state,
+               Entry *entry)
+{
+  GimpItem *item = GIMP_ITEM (state->drawable);
+
+  g_signal_handlers_disconnect_by_func (entry->knockout,
+                                        knockout_invalidated,
+                                        state->drawable);
+
+  gegl_node_disconnect (entry->compose, "input");
+  gegl_node_disconnect (entry->compose, "aux");
+  gegl_node_disconnect (entry->compose, "aux2");
+  gegl_node_disconnect (entry->offset,  "input");
+
+  gimp_item_remove_offset_node (item, entry->offset);
+
+  gegl_node_remove_child (state->node, entry->compose);
+  gegl_node_remove_child (state->node, entry->offset);
+}
+
+static void
+link_if_needed (GeglNode    *source,
+                GeglNode    *sink,
+                const gchar *sink_pad)
+{
+  if (gegl_node_get_producer (sink, sink_pad, NULL) != source)
+    gegl_node_connect (source, "output", sink, sink_pad);
+}
+
+static void
+layer_relink (State *state)
+{
+  GimpDrawable *drawable = state->drawable;
+  GimpLayer    *layer;
+  GimpLayerMask *mask;
+  GeglNode     *input;
+  GeglNode     *mode_node;
+  GeglNode     *previous;
+  GeglNode     *mask_node = NULL;
+  GArray       *entries;
+  GList        *behind    = NULL;
+  GList        *list;
+  guint         i;
+
+  if (! state->node || ! GIMP_IS_LAYER (drawable))
+    return;
+
+  layer = GIMP_LAYER (drawable);
+
+  /*  gimp_layer_get_node() not finished  */
+  if (! layer->layer_offset_node || ! layer->mask_offset_node)
+    return;
+
+  if (! gimp_drawable_get_filters_bypass (drawable))
+    behind = gimp_filter_stack_get_behind (GIMP_FILTER_STACK (gimp_drawable_get_filters (drawable)));
+
+  /*  nothing to do, nothing done (the graph of before)  */
+  if (! behind && state->entries->len == 0)
+    return;
+
+  input     = gegl_node_get_input_proxy (state->node, "input");
+  mode_node = gimp_drawable_get_mode_node (drawable);
+  mask      = gimp_layer_get_mask (layer);
+
+  if (mask                              &&
+      gimp_layer_get_apply_mask (layer) &&
+      ! gimp_layer_get_show_mask (layer))
+    {
+      mask_node = layer->mask_offset_node;
+    }
+
+  entries = g_array_new (FALSE, TRUE, sizeof (Entry));
+
+  for (list = behind; list; list = g_list_next (list))
+    {
+      GimpFilterStackBehind *b     = list->data;
+      Entry                  entry = { 0, };
+      GimpLayerMode          mode;
+      gboolean               found = FALSE;
+
+      for (i = 0; i < state->entries->len; i++)
+        {
+          Entry *old = &g_array_index (state->entries, Entry, i);
+
+          if (old->knockout == b->knockout)
+            {
+              entry = *old;
+              g_array_remove_index (state->entries, i);
+              found = TRUE;
+              break;
+            }
+        }
+
+      if (! found)
+        {
+          entry.knockout = b->knockout;
+          entry.offset   = gegl_node_new_child (state->node,
+                                                "operation", "gegl:translate",
+                                                NULL);
+          gimp_item_add_offset_node (GIMP_ITEM (layer), entry.offset);
+
+          entry.compose  = gegl_node_new_child (state->node,
+                                                "operation", "gimp:normal",
+                                                NULL);
+          entry.mode     = (GimpLayerMode) -1;
+          entry.opacity  = -1.0;
+
+          g_signal_connect_object (entry.knockout, "invalidated",
+                                   G_CALLBACK (knockout_invalidated),
+                                   drawable, 0);
+        }
+
+      mode = chopgimp_behind_effects_get_filter_mode (b->filter);
+
+      if (mode != entry.mode)
+        {
+          gimp_gegl_mode_node_set_mode (entry.compose, mode,
+                                        GIMP_LAYER_COLOR_SPACE_AUTO,
+                                        GIMP_LAYER_COLOR_SPACE_AUTO,
+                                        GIMP_LAYER_COMPOSITE_AUTO);
+          entry.mode = mode;
+        }
+
+      if (gimp_layer_get_opacity (layer) != entry.opacity)
+        {
+          entry.opacity = gimp_layer_get_opacity (layer);
+          gimp_gegl_mode_node_set_opacity (entry.compose, entry.opacity);
+        }
+
+      link_if_needed (entry.knockout, entry.offset, "input");
+      link_if_needed (entry.offset, entry.compose, "aux");
+
+      if (mask_node)
+        link_if_needed (mask_node, entry.compose, "aux2");
+      else if (gegl_node_get_producer (entry.compose, "aux2", NULL))
+        gegl_node_disconnect (entry.compose, "aux2");
+
+      g_array_append_val (entries, entry);
+    }
+
+  /*  the chain, onto the backdrop, before the layer  */
+  previous = input;
+
+  for (i = 0; i < entries->len; i++)
+    {
+      Entry *entry = &g_array_index (entries, Entry, i);
+
+      link_if_needed (previous, entry->compose, "input");
+
+      previous = entry->compose;
+    }
+
+  if (entries->len > 0)
+    {
+      link_if_needed (previous, mode_node, "input");
+    }
+  else
+    {
+      GeglNode *producer = gegl_node_get_producer (mode_node, "input", NULL);
+
+      /*  the chain is gone: back to the graph of before, unless the
+       *  input was linked again meanwhile (group layers)
+       */
+      for (i = 0; i < state->entries->len; i++)
+        {
+          Entry *old = &g_array_index (state->entries, Entry, i);
+
+          if (producer == old->compose)
+            {
+              if (gimp_layer_get_mode (layer) == GIMP_LAYER_MODE_PASS_THROUGH &&
+                  gimp_layer_get_excludes_backdrop (layer))
+                gegl_node_disconnect (mode_node, "input");
+              else
+                gegl_node_link (input, mode_node);
+
+              break;
+            }
+        }
+    }
+
+  /*  the effects no longer behind  */
+  for (i = 0; i < state->entries->len; i++)
+    entry_destroy (state, &g_array_index (state->entries, Entry, i));
+
+  g_array_free (state->entries, TRUE);
+  state->entries = entries;
+}
+
+
+/*  the filter stack  */
+
+static gboolean
+stack_behind_func (GimpFilterStack *stack,
+                   GimpFilter      *filter,
+                   gpointer         user_data)
+{
+  State *state = user_data;
+
+  return chopgimp_behind_effects_is_behind (state->drawable, filter);
+}
+
+static void
+stack_behind_changed (GimpFilterStack *stack,
+                      gpointer         user_data)
+{
+  layer_relink (user_data);
+}
+
+static void
+filters_changed (GimpDrawable *drawable,
+                 State        *state)
+{
+  chopgimp_behind_effects_update (drawable);
+}
+
+
+/*  public functions  */
+
+void
+chopgimp_behind_effects_init (GimpDrawable *drawable)
+{
+  State *state;
+
+  g_return_if_fail (GIMP_IS_DRAWABLE (drawable));
+
+  if (! chopgimp_behind_effects_enabled ())
+    return;
+
+  state = g_slice_new0 (State);
+  state->drawable = drawable;
+  state->entries  = g_array_new (FALSE, TRUE, sizeof (Entry));
+
+  g_object_set_data_full (G_OBJECT (drawable), STATE_KEY, state,
+                          (GDestroyNotify) state_free);
+
+  gimp_filter_stack_set_behind_func (GIMP_FILTER_STACK (gimp_drawable_get_filters (drawable)),
+                                     stack_behind_func,
+                                     stack_behind_changed,
+                                     state);
+
+  g_signal_connect (drawable, "filters-changed",
+                    G_CALLBACK (filters_changed),
+                    state);
+}
+
+void
+chopgimp_behind_effects_update (GimpDrawable *drawable)
+{
+  GimpFilterStack *stack;
+  State           *state;
+  GList           *linked;
+  GList           *list;
+  gboolean         same = TRUE;
+
+  g_return_if_fail (GIMP_IS_DRAWABLE (drawable));
+
+  state = get_state (drawable);
+
+  if (! state)
+    return;
+
+  stack  = GIMP_FILTER_STACK (gimp_drawable_get_filters (drawable));
+  linked = gimp_filter_stack_get_behind (stack);
+
+  /*  the behind filters, from the bottom up, as linked?  */
+  for (list = GIMP_LIST (stack)->queue->tail;
+       list;
+       list = g_list_previous (list))
+    {
+      GimpFilter *filter = list->data;
+
+      if (! gimp_filter_get_active (filter) ||
+          ! chopgimp_behind_effects_is_behind (drawable, filter))
+        continue;
+
+      if (! linked ||
+          ((GimpFilterStackBehind *) linked->data)->filter != filter)
+        {
+          same = FALSE;
+          break;
+        }
+
+      linked = g_list_next (linked);
+    }
+
+  if (linked)
+    same = FALSE;
+
+  if (same)
+    {
+      /*  modes, opacity, mask, bypass  */
+      layer_relink (state);
+    }
+  else
+    {
+      /*  the stack calls layer_relink()  */
+      gimp_filter_stack_relink (stack);
+
+      gimp_drawable_filters_cache_update (drawable);
+    }
+}
+
+void
+chopgimp_behind_effects_layer_node (GimpLayer *layer,
+                                    GeglNode  *node)
+{
+  State *state;
+
+  g_return_if_fail (GIMP_IS_LAYER (layer));
+  g_return_if_fail (GEGL_IS_NODE (node));
+
+  state = get_state (GIMP_DRAWABLE (layer));
+
+  if (! state)
+    return;
+
+  state->node = node;
+
+  chopgimp_behind_effects_update (GIMP_DRAWABLE (layer));
+}
+
+void
+chopgimp_behind_effects_add_bounding_box (GimpDrawable  *drawable,
+                                          GeglRectangle *bounding_box)
+{
