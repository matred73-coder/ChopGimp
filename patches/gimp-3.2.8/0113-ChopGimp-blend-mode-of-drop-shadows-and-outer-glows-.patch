+/*  ChopGimp: Mode of the drop shadow / outer glow: gegl:dropshadow's
+ *  "blend-mode" (GEGL patch 0007, an enum with the nicks of GIMP's layer
+ *  modes), composited onto the layers below
+ *  (app/core/chopgimp-behind-effects.c), chosen in GIMP's layer modes
+ */
+static GimpLayerMode
+behind_mode_from_config (GObject *config)
+{
+  GParamSpec    *pspec;
+  GEnumValue    *value;
+  GEnumClass    *mode_class;
+  GEnumValue    *mode_value = NULL;
+  gint           v          = 0;
+
+  pspec = g_object_class_find_property (G_OBJECT_GET_CLASS (config),
+                                        "blend-mode");
+
+  if (! pspec || ! G_IS_PARAM_SPEC_ENUM (pspec))
+    return GIMP_LAYER_MODE_NORMAL;
+
+  g_object_get (config, "blend-mode", &v, NULL);
+
+  value = g_enum_get_value (G_PARAM_SPEC_ENUM (pspec)->enum_class, v);
+
+  mode_class = g_type_class_ref (GIMP_TYPE_LAYER_MODE);
+
+  if (value)
+    mode_value = g_enum_get_value_by_nick (mode_class, value->value_nick);
+
+  g_type_class_unref (mode_class);
+
+  return mode_value ? (GimpLayerMode) mode_value->value :
+                      GIMP_LAYER_MODE_NORMAL;
+}
+
+static void behind_mode_box_notify (GimpLayerModeBox *box,
+                                    GParamSpec       *pspec,
+                                    GObject          *config);
+
+static void
+behind_mode_config_notify (GObject          *config,
+                           GParamSpec       *pspec,
+                           GimpLayerModeBox *box)
+{
+  GimpLayerMode mode = behind_mode_from_config (config);
+
+  if (gimp_layer_mode_box_get_mode (box) != mode)
+    {
+      g_signal_handlers_block_by_func (box, behind_mode_box_notify, config);
+      gimp_layer_mode_box_set_mode (box, mode);
+      g_signal_handlers_unblock_by_func (box, behind_mode_box_notify, config);
+    }
+}
+
+static void
+behind_mode_box_notify (GimpLayerModeBox *box,
+                        GParamSpec       *pspec,
+                        GObject          *config)
+{
+  GParamSpec *config_pspec;
+  GEnumClass *mode_class;
+  GEnumValue *mode_value;
+  GEnumValue *value = NULL;
+
+  config_pspec = g_object_class_find_property (G_OBJECT_GET_CLASS (config),
+                                               "blend-mode");
+
+  mode_class = g_type_class_ref (GIMP_TYPE_LAYER_MODE);
+  mode_value = g_enum_get_value (mode_class, gimp_layer_mode_box_get_mode (box));
+
+  if (mode_value && config_pspec && G_IS_PARAM_SPEC_ENUM (config_pspec))
+    value = g_enum_get_value_by_nick (G_PARAM_SPEC_ENUM (config_pspec)->enum_class,
+                                      mode_value->value_nick);
+
+  g_type_class_unref (mode_class);
+
+  if (value)
+    {
+      gint v = 0;
+
+      g_object_get (config, "blend-mode", &v, NULL);
+
+      if (v != value->value)
+        g_object_set (config, "blend-mode", value->value, NULL);
+    }
+  else
+    {
+      /*  a mode a shadow can't have (legacy...): back to the shadow's  */
+      behind_mode_config_notify (config, NULL, box);
+    }
+}
+
+static void
+layer_style_add_behind_mode (GtkWidget *vbox,
+                             GObject   *config)
+{
+  GtkWidget *mode_box;
+
+  if (! g_object_class_find_property (G_OBJECT_GET_CLASS (config),
+                                      "blend-mode"))
+    return;
+
+  mode_box = gimp_layer_mode_box_new (GIMP_LAYER_MODE_CONTEXT_LAYER);
+  gimp_layer_mode_box_set_label (GIMP_LAYER_MODE_BOX (mode_box),
+                                 "Mode de fusion");
+  gimp_layer_mode_box_set_mode (GIMP_LAYER_MODE_BOX (mode_box),
+                                behind_mode_from_config (config));
+  gtk_box_pack_start (GTK_BOX (vbox), mode_box, FALSE, FALSE, 0);
+  gtk_widget_set_visible (mode_box, TRUE);
+
+  gimp_help_set_help_data (mode_box,
+                           "Mode de fusion de l'effet avec les calques du "
+                           "dessous, comme dans Photoshop (Produit pour une "
+                           "ombre, Écran pour une lueur). Normal : l'effet "
+                           "est fusionné avec le calque, comme avant.",
+                           NULL);
+
+  g_signal_connect_object (mode_box, "notify::layer-mode",
+                           G_CALLBACK (behind_mode_box_notify),
+                           config, 0);
+  g_signal_connect_object (config, "notify::blend-mode",
+                           G_CALLBACK (behind_mode_config_notify),
+                           mode_box, 0);
+}
+
