+      gint            e = g_array_index (bad, gint, i + 1);
+      PangoRectangle  a, b;
+      gdouble         x1, x2, y, x;
+      GimpVector2    *pts;
+      gint            n = 0, max;
+      GimpCanvasItem *item;
