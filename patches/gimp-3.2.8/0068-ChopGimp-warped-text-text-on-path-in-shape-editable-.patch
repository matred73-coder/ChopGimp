+void             chopgimp_text_fx_free     (ChopGimpTextFx *fx);
+
+void             chopgimp_text_fx_get_anchor (GimpTextLayer *layer,
+                                              gint          *x,
+                                              gint          *y);
+
+GimpPath       * chopgimp_text_fx_find_path  (GimpImage     *image,
+                                              GimpTattoo     tattoo);
