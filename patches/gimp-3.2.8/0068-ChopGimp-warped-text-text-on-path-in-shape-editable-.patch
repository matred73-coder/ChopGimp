+static GimpValueArray *
+text_fx_set_invoker (GimpProcedure         *procedure,
+                     Gimp                  *gimp,
+                     GimpContext           *context,
+                     GimpProgress          *progress,
+                     const GimpValueArray  *args,
+                     GError               **error)
+{
+  GimpTextLayer *layer     = ARG_OBJECT (0);
+  const gchar   *spec      = g_value_get_string (gimp_value_array_index (args, 1));
+  gboolean       push_undo = ARG_BOOL (2);
+  GimpText      *text      = gimp_text_layer_get_text (layer);
+
+  if (! text || ! gimp_item_is_attached (GIMP_ITEM (layer)))
+    return gimp_procedure_get_return_values (procedure, FALSE, NULL);
+
+  if (spec && ! *spec)
+    spec = NULL;
+
+  if (push_undo)
+    gimp_text_layer_set (layer, _("Effet de texte"), "chopgimp-fx", spec, NULL);
+  else
+    g_object_set (text, "chopgimp-fx", spec, NULL);
+
+  return gimp_procedure_get_return_values (procedure, TRUE, NULL);
+}
+
+static GimpValueArray *
+text_fx_get_invoker (GimpProcedure         *procedure,
+                     Gimp                  *gimp,
+                     GimpContext           *context,
+                     GimpProgress          *progress,
+                     const GimpValueArray  *args,
+                     GError               **error)
+{
+  GimpTextLayer  *layer = ARG_OBJECT (0);
+  GimpText       *text  = gimp_text_layer_get_text (layer);
+  GimpValueArray *return_vals;
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_string (gimp_value_array_index (return_vals, 1),
+                      text && text->chopgimp_fx ? text->chopgimp_fx : "");
+
+  return return_vals;
+}
+
 
 static GimpProcedure *
 chopgimp_procedure (GimpPDB          *pdb,
@@ -385,4 +434,29 @@ register_chopgimp_procs (GimpPDB *pdb)
                                                             FALSE, GIMP_PARAM_READWRITE));
   gimp_pdb_register_procedure (pdb, p);
   g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, text_fx_set_invoker, "chopgimp-text-fx-set",
+                          "Text effect of a text layer, which stays editable: "
+                          "warp=<style>;bend=50;hdist=0;vdist=0;vertical=0 | "
+                          "path=<tattoo>;start=0;flip=0;shift=0 | shape=<tattoo>;inset=0 | "
+                          "empty (none).  Without undo for live previews.");
+  gimp_procedure_add_argument (p, gimp_param_spec_text_layer ("layer", "layer", "Text layer",
+                                                              FALSE, GIMP_PARAM_READWRITE));
+  gimp_procedure_add_argument (p, gimp_param_spec_string ("spec", "spec", "Effect",
+                                                          FALSE, TRUE, FALSE, NULL,
+                                                          GIMP_PARAM_READWRITE));
+  gimp_procedure_add_argument (p, g_param_spec_boolean ("push-undo", "push-undo", "Undoable",
+                                                        TRUE, GIMP_PARAM_READWRITE));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, text_fx_get_invoker, "chopgimp-text-fx-get",
+                          "Text effect of a text layer (empty: none).");
+  gimp_procedure_add_argument (p, gimp_param_spec_text_layer ("layer", "layer", "Text layer",
+                                                              FALSE, GIMP_PARAM_READWRITE));
+  gimp_procedure_add_return_value (p, gimp_param_spec_string ("spec", "spec", "Effect",
+                                                              FALSE, TRUE, FALSE, NULL,
+                                                              GIMP_PARAM_READWRITE));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
 }
diff --git a/app/text/chopgimp-textfx.c b/app/text/chopgimp-textfx.c
new file mode 100644
index 0000000..536b5b2
--- /dev/null
+++ b/app/text/chopgimp-textfx.c
@@ -0,0 +1,1579 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-textfx.c — ChopGimp: warped text (the 15 Photoshop styles),
+ * text on a path, text in a shape, and transformations that keep the
+ * text editable.
+ *
+ * The text is turned into glyph outlines (one outline per glyph, keeping
+ * the colour of its run), the outlines are flattened, moved, and filled
+ * with cairo.  The text layer stays a text layer: the effect is the
+ * "chopgimp-fx" property of its GimpText, so it is undoable, saved in
+ * the XCF and re-applied whenever the text changes.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <cairo.h>
+#include <gegl.h>
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <pango/pangocairo.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+
+#include "text-types.h"
+#include "path/path-types.h"
+
+#include "core/gimpdrawable.h"
+#include "core/gimpimage.h"
+#include "core/gimpitem.h"
+#include "core/gimprasterizable.h"
+
+#include "path/gimppath.h"
+#include "path/gimpstroke.h"
+#include "path/gimpvectorlayer.h"
+
+#include "gimptext.h"
+#include "gimptextlayer.h"
+#include "gimptextlayout.h"
+#include "chopgimp-textfx.h"
+
+
+#define SHIFT_PARASITE "chopgimp-text-shift"
+#define SEG_MAX        1.5   /* longest flattened segment before warping */
+
+
+typedef struct
+{
+  gdouble x, y;
+} Pt;
+
+typedef struct
+{
+  GArray   *pts;   /* Pt */
+  gdouble   gx;    /* centre of its glyph (rigid placement on a path)  */
+  gboolean  bend;  /* underline / strikethrough: bent point by point   */
+} Sub;
+
+typedef struct
+{
+  gdouble    r, g, b;
+  GPtrArray *subs;
+} Piece;
+
+typedef enum
+{
+  FX_MATRIX,
+  FX_WARP,
+  FX_PATH,
+  FX_SHAPE
+} FxMode;
+
+struct _ChopGimpTextFx
+{
+  FxMode     mode;
+  GPtrArray *pieces;
+  gint       ox, oy;          /* layer-local (matrix, warp) or image (path, shape) */
+  gint       width, height;
+  gboolean   absolute;
+  gint       anchor_x, anchor_y;
+  gint       new_x, new_y;
+};
+
+
+static const gchar *warp_styles[] =
+{
+  "arc", "arc-lower", "arc-upper", "arch", "bulge", "shell-lower",
+  "shell-upper", "flag", "wave", "fish", "rise", "fisheye", "inflate",
+  "squeeze", "twist", NULL
+};
+
+
+/*  spec  */
+
+gchar *
+chopgimp_text_fx_get_value (const gchar *spec,
+                            const gchar *key)
+{
+  gchar  **items;
+  gchar   *value = NULL;
+  gint     i;
+
+  if (! spec || ! *spec)
+    return NULL;
+
+  items = g_strsplit (spec, ";", -1);
+
+  for (i = 0; items[i] && ! value; i++)
+    {
+      gchar *eq = strchr (items[i], '=');
+
+      if (eq && (gsize) (eq - items[i]) == strlen (key) &&
+          ! strncmp (items[i], key, eq - items[i]))
+        value = g_strdup (eq + 1);
+    }
+
+  g_strfreev (items);
+
+  return value;
+}
+
+static gdouble
+spec_double (const gchar *spec,
+             const gchar *key,
+             gdouble      def)
+{
+  gchar   *v = chopgimp_text_fx_get_value (spec, key);
+  gdouble  d = v ? g_ascii_strtod (v, NULL) : def;
+
+  g_free (v);
+
+  return d;
+}
+
+const gchar **
+chopgimp_text_fx_warp_styles (void)
+{
+  return warp_styles;
+}
+
+
+/*  outlines  */
+
+static void
+sub_free (Sub *sub)
+{
+  g_array_unref (sub->pts);
+  g_free (sub);
+}
+
+static void
+piece_free (Piece *piece)
+{
+  g_ptr_array_unref (piece->subs);
+  g_free (piece);
+}
+
+static Piece *
+fx_piece (ChopGimpTextFx *fx,
+          gdouble         r,
+          gdouble         g,
+          gdouble         b)
+{
+  Piece *piece;
+
+  if (fx->pieces->len)
+    {
+      piece = g_ptr_array_index (fx->pieces, fx->pieces->len - 1);
+
+      if (piece->r == r && piece->g == g && piece->b == b)
+        return piece;
+    }
+
+  piece       = g_new0 (Piece, 1);
+  piece->r    = r;
+  piece->g    = g;
+  piece->b    = b;
+  piece->subs = g_ptr_array_new_with_free_func ((GDestroyNotify) sub_free);
+
+  g_ptr_array_add (fx->pieces, piece);
+
+  return piece;
+}
+
+/*  takes the current path of cr, in device coordinates  */
+static void
+fx_take_path (Piece    *piece,
+              cairo_t  *cr,
+              gdouble   gx,
+              gboolean  bend)
+{
+  cairo_matrix_t  m;
+  cairo_path_t   *path;
+  Sub            *sub = NULL;
+  gdouble         gy  = 0.0;
+  gint            i;
+
+  cairo_user_to_device (cr, &gx, &gy);
+
+  cairo_get_matrix (cr, &m);
+  cairo_identity_matrix (cr);
+  path = cairo_copy_path_flat (cr);
+  cairo_set_matrix (cr, &m);
+
+  for (i = 0; i < path->num_data; i += path->data[i].header.length)
+    {
+      cairo_path_data_t *d = &path->data[i];
+      Pt                 pt;
+
+      switch (d->header.type)
+        {
+        case CAIRO_PATH_MOVE_TO:
+          sub       = g_new0 (Sub, 1);
+          sub->pts  = g_array_new (FALSE, FALSE, sizeof (Pt));
+          sub->gx   = gx;
+          sub->bend = bend;
+          g_ptr_array_add (piece->subs, sub);
+          /* fall through */
+        case CAIRO_PATH_LINE_TO:
+          if (! sub)
+            break;
+          pt.x = d[1].point.x;
+          pt.y = d[1].point.y;
+          g_array_append_val (sub->pts, pt);
+          break;
+
+        default:
+          break;
+        }
+    }
+
+  cairo_path_destroy (path);
+  cairo_new_path (cr);
+}
+
+/*  all runs of a layout (or of its first line), at the current matrix  */
+static void
+fx_collect (ChopGimpTextFx *fx,
+            cairo_t        *cr,
+            PangoLayout    *pl,
+            gboolean        first_line_only)
+{
+  PangoLayoutIter *iter  = pango_layout_get_iter (pl);
+  PangoLayoutLine *first = pango_layout_get_line_readonly (pl, 0);
+
+  do
+    {
+      PangoLayoutRun   *run = pango_layout_iter_get_run_readonly (iter);
+      PangoRectangle    log;
+      PangoColor        color = { 0, 0, 0 };
+      gint              underline = PANGO_UNDERLINE_NONE;
+      gboolean          strike    = FALSE;
+      PangoFont        *font;
+      Piece            *piece;
+      GSList           *list;
+      gdouble           x, y, base;
+      gint              i;
+
+      if (first_line_only &&
+          pango_layout_iter_get_line_readonly (iter) != first)
+        break;
+
+      if (! run)
+        continue;
+
+      font = run->item->analysis.font;
+
+      pango_layout_iter_get_run_extents (iter, NULL, &log);
+
+      base = (gdouble) pango_layout_iter_get_baseline (iter) / PANGO_SCALE;
+      x    = (gdouble) log.x / PANGO_SCALE;
+      y    = base - (gdouble) run->y_offset / PANGO_SCALE;
+
+      for (list = run->item->analysis.extra_attrs; list; list = list->next)
+        {
+          PangoAttribute *attr = list->data;
+
+          switch ((gint) attr->klass->type)
+            {
+            case PANGO_ATTR_FOREGROUND:
+              color = ((PangoAttrColor *) attr)->color;
+              break;
+            case PANGO_ATTR_UNDERLINE:
+              underline = ((PangoAttrInt *) attr)->value;
+              break;
+            case PANGO_ATTR_STRIKETHROUGH:
+              strike = ((PangoAttrInt *) attr)->value;
+              break;
+            default:
+              break;
+            }
+        }
+
+      piece = fx_piece (fx,
+                        color.red   / 65535.0,
+                        color.green / 65535.0,
+                        color.blue  / 65535.0);
+
+      for (i = 0; i < run->glyphs->num_glyphs; i++)
+        {
+          PangoGlyphInfo   info  = run->glyphs->glyphs[i];
+          gint             zero  = 0;
+          PangoGlyphString single;
+          gdouble          w     = (gdouble) info.geometry.width / PANGO_SCALE;
+
+          if (info.glyph != PANGO_GLYPH_EMPTY &&
+              ! (info.glyph & PANGO_GLYPH_UNKNOWN_FLAG))
+            {
+              single.num_glyphs  = 1;
+              single.glyphs      = &info;
+              single.log_clusters = &zero;
+              single.space       = 1;
+
+              cairo_new_path (cr);
+              cairo_move_to (cr, x, y);
+              pango_cairo_glyph_string_path (cr, font, &single);
+
+              fx_take_path (piece, cr, x + w / 2.0, FALSE);
+            }
+
+          x += w;
+        }
+
+      if (underline != PANGO_UNDERLINE_NONE || strike)
+        {
+          PangoFontMetrics *metrics = pango_font_get_metrics (font, NULL);
+          gdouble           rx      = (gdouble) log.x     / PANGO_SCALE;
+          gdouble           rw      = (gdouble) log.width / PANGO_SCALE;
+
+          if (underline != PANGO_UNDERLINE_NONE)
+            {
+              gdouble pos   = pango_font_metrics_get_underline_position  (metrics);
+              gdouble thick = pango_font_metrics_get_underline_thickness (metrics);
+
+              cairo_new_path (cr);
+              cairo_rectangle (cr, rx, y - pos / PANGO_SCALE,
+                               rw, MAX (1.0, thick / PANGO_SCALE));
+              fx_take_path (piece, cr, rx + rw / 2.0, TRUE);
+            }
+
+          if (strike)
+            {
+              gdouble pos   = pango_font_metrics_get_strikethrough_position  (metrics);
+              gdouble thick = pango_font_metrics_get_strikethrough_thickness (metrics);
+
+              cairo_new_path (cr);
+              cairo_rectangle (cr, rx, y - pos / PANGO_SCALE,
+                               rw, MAX (1.0, thick / PANGO_SCALE));
+              fx_take_path (piece, cr, rx + rw / 2.0, TRUE);
+            }
+
+          pango_font_metrics_unref (metrics);
+        }
+    }
+  while (pango_layout_iter_next_run (iter));
+
+  pango_layout_iter_free (iter);
+}
+
+static void
+fx_subdivide (ChopGimpTextFx *fx,
+              gboolean        bend_only)
+{
+  gint p, s;
+
+  for (p = 0; p < fx->pieces->len; p++)
+    {
+      Piece *piece = g_ptr_array_index (fx->pieces, p);
+
+      for (s = 0; s < piece->subs->len; s++)
+        {
+          Sub    *sub = g_ptr_array_index (piece->subs, s);
+          GArray *out;
+          gint    i, n = sub->pts->len;
+
+          if ((bend_only && ! sub->bend) || n < 2)
+            continue;
+
+          out = g_array_sized_new (FALSE, FALSE, sizeof (Pt), n * 2);
+
+          for (i = 0; i < n; i++)
+            {
+              Pt      a = g_array_index (sub->pts, Pt, i);
+              Pt      b = g_array_index (sub->pts, Pt, (i + 1) % n);
+              gdouble len = hypot (b.x - a.x, b.y - a.y);
+              gint    k, steps = MAX (1, (gint) ceil (len / SEG_MAX));
+
+              for (k = 0; k < steps; k++)
+                {
+                  Pt q;
+
+                  q.x = a.x + (b.x - a.x) * k / steps;
+                  q.y = a.y + (b.y - a.y) * k / steps;
+                  g_array_append_val (out, q);
+                }
+            }
+
+          g_array_unref (sub->pts);
+          sub->pts = out;
+        }
+    }
+}
+
+static gboolean
+fx_bounds (ChopGimpTextFx *fx,
+           gdouble        *x1,
+           gdouble        *y1,
+           gdouble        *x2,
+           gdouble        *y2)
+{
+  gboolean any = FALSE;
+  gint     p, s, i;
+
+  *x1 = *y1 =  G_MAXDOUBLE;
+  *x2 = *y2 = -G_MAXDOUBLE;
+
+  for (p = 0; p < fx->pieces->len; p++)
+    {
+      Piece *piece = g_ptr_array_index (fx->pieces, p);
+
+      for (s = 0; s < piece->subs->len; s++)
+        {
+          Sub *sub = g_ptr_array_index (piece->subs, s);
+
+          for (i = 0; i < sub->pts->len; i++)
+            {
+              Pt pt = g_array_index (sub->pts, Pt, i);
+
+              *x1 = MIN (*x1, pt.x);
+              *y1 = MIN (*y1, pt.y);
+              *x2 = MAX (*x2, pt.x);
+              *y2 = MAX (*y2, pt.y);
+              any = TRUE;
+            }
+        }
+    }
+
+  return any;
+}
+
+
+/*  warp (Photoshop « Déformer le texte »)  */
+
+typedef struct
+{
+  gint     style;
+  gdouble  bend, hdist, vdist;
+  gboolean vertical;
+  gdouble  cx, cy, hw, hh;
+} Warp;
+
+static void
+warp_point (const Warp *w,
+            gdouble    *px,
+            gdouble    *py)
+{
+  gdouble x  = *px, y = *py;
+  gdouble cx = w->cx, cy = w->cy, hw = w->hw, hh = w->hh;
+  gdouble b  = w->bend;
+  gdouble u, v, dv = 0.0;
+
+  if (w->vertical)
+    {
+      gdouble t;
+
+      t = x;  x  = y;  y  = t;
+      t = cx; cx = cy; cy = t;
+      t = hw; hw = hh; hh = t;
+    }
+
+  u = (x - cx) / hw;
+  v = (y - cy) / hh;
+
+  /*  perspective-like distortions  */
+  v *= 1.0 + w->hdist * u * 0.5;
+  u *= 1.0 - w->vdist * v * 0.5;
+
+  switch (w->style)
+    {
+    case 0: /* arc */
+      {
+        gdouble theta = fabs (b) * G_PI;
+
+        if (theta > 1e-4)
+          {
+            gdouble R   = (2.0 * hw) / theta;
+            gdouble phi = u * theta / 2.0;
+            gdouble yy  = v * hh;
+
+            if (b > 0)
+              {
+                gdouble r = R - yy;
+
+                x = cx + r * sin (phi);
+                y = cy + R - r * cos (phi);
+              }
+            else
+              {
+                gdouble r = R + yy;
+
+                x = cx + r * sin (phi);
+                y = cy - R + r * cos (phi);
+              }
+            goto done;
+          }
+      }
+      break;
+
+    case 1: /* arc lower */
+      dv = b * (1.0 - u * u) * (1.0 + v) / 2.0;
+      break;
+
+    case 2: /* arc upper */
+      dv = -b * (1.0 - u * u) * (1.0 - v) / 2.0;
+      break;
+
+    case 3: /* arch */
+      dv = -b * (1.0 - u * u);
+      break;
+
+    case 4: /* bulge */
+      dv = b * (1.0 - u * u) * v;
+      break;
+
+    case 5: /* shell lower */
+      dv = b * (1.0 - u * u) * (1.0 + v) / 2.0 * 1.2 -
+           b * u * u * (1.0 - v) / 2.0 * 0.4;
+      break;
+
+    case 6: /* shell upper */
+      dv = -b * (1.0 - u * u) * (1.0 - v) / 2.0 * 1.2 +
+           b * u * u * (1.0 + v) / 2.0 * 0.4;
+      break;
+
+    case 7: /* flag */
+      dv = -b * 0.6 * sin (G_PI * u);
+      break;
+
+    case 8: /* wave */
+      dv = -b * 0.6 * sin (G_PI * u + v * 0.9);
+      break;
+
+    case 9: /* fish */
+      dv = b * v * 0.8 * sin (G_PI * (u + 1.0) * 0.75);
+      break;
+
+    case 10: /* rise */
+      dv = -b * 0.8 * sin (G_PI * u / 2.0);
+      break;
+
+    case 11: /* fisheye: radial power, no folding */
+      {
+        gdouble r = sqrt (u * u + v * v);
+
+        if (r > 1e-9 && r < 1.0)
+          {
+            gdouble f = pow (r, 1.0 / (1.0 + 0.8 * b) - 1.0);
+
+            u *= f;
+            v *= f;
+          }
+      }
+      break;
+
+    case 12: /* inflate */
+      {
+        gdouble nu = u + b * 0.12 * sin (G_PI * u) * (1.0 - v * v);
+        gdouble nv = v * (1.0 + b * 0.45 * (1.0 - u * u));
+
+        u = nu;
+        v = nv;
+      }
+      break;
+
+    case 13: /* squeeze */
+      {
+        gdouble nu = u - b * 0.10 * sin (G_PI * u) * v * v;
+        gdouble nv = v * (1.0 - b * 0.45 * (1.0 - u * u));
+
+        u = nu;
+        v = nv;
+      }
+      break;
+
+    case 14: /* twist */
+      {
+        gdouble ax = u * hw, ay = v * hh;
+        gdouble r  = hypot (ax, ay) / MAX (hw, hh);
+        gdouble a  = b * G_PI / 2.0 * MAX (0.0, 1.0 - r);
+        gdouble c  = cos (a), s = sin (a);
+
+        u = (ax * c - ay * s) / hw;
+        v = (ax * s + ay * c) / hh;
+      }
+      break;
+
+    default:
+      break;
+    }
+
+  x = cx + u * hw;
+  y = cy + (v + dv) * hh;
+
+ done:
+  if (w->vertical)
+    {
+      *px = y;
+      *py = x;
+    }
+  else
+    {
+      *px = x;
+      *py = y;
+    }
+}
+
+static void
+fx_warp (ChopGimpTextFx *fx,
+         const gchar    *spec)
+{
+  gchar   *style = chopgimp_text_fx_get_value (spec, "warp");
+  Warp     w     = { 0, };
+  gdouble  x1, y1, x2, y2;
+  gint     p, s, i;
+
+  w.style = 0;
+  for (i = 0; warp_styles[i]; i++)
+    if (! g_strcmp0 (style, warp_styles[i]))
+      w.style = i;
+  g_free (style);
+
+  w.bend     = CLAMP (spec_double (spec, "bend",  50.0), -100, 100) / 100.0;
+  w.hdist    = CLAMP (spec_double (spec, "hdist",  0.0), -100, 100) / 100.0;
+  w.vdist    = CLAMP (spec_double (spec, "vdist",  0.0), -100, 100) / 100.0;
+  w.vertical = spec_double (spec, "vertical", 0.0) != 0.0;
+
+  if (! fx_bounds (fx, &x1, &y1, &x2, &y2))
+    return;
+
+  w.cx = (x1 + x2) / 2.0;
+  w.cy = (y1 + y2) / 2.0;
+  w.hw = MAX ((x2 - x1) / 2.0, 1.0);
+  w.hh = MAX ((y2 - y1) / 2.0, 1.0);
+
+  fx_subdivide (fx, FALSE);
+
+  for (p = 0; p < fx->pieces->len; p++)
+    {
+      Piece *piece = g_ptr_array_index (fx->pieces, p);
+
+      for (s = 0; s < piece->subs->len; s++)
+        {
+          Sub *sub = g_ptr_array_index (piece->subs, s);
+
+          for (i = 0; i < sub->pts->len; i++)
+            {
+              Pt *pt = &g_array_index (sub->pts, Pt, i);
+
+              warp_point (&w, &pt->x, &pt->y);
+            }
+        }
+    }
+}
+
+
+/*  paths  */
+
+static GArray *
+stroke_polyline (GimpStroke *stroke,
+                 gboolean   *closed)
+{
+  GArray *coords = gimp_stroke_interpolate (stroke, 0.2, closed);
+  GArray *pts;
+  gint    i;
+
+  if (! coords)
+    return NULL;
+
+  pts = g_array_new (FALSE, FALSE, sizeof (Pt));
+
+  for (i = 0; i < coords->len; i++)
+    {
+      GimpCoords *c = &g_array_index (coords, GimpCoords, i);
+      Pt          pt = { c->x, c->y };
+
+      if (pts->len)
+        {
+          Pt last = g_array_index (pts, Pt, pts->len - 1);
+
+          if (hypot (pt.x - last.x, pt.y - last.y) < 1e-6)
+            continue;
+        }
+
+      g_array_append_val (pts, pt);
+    }
+
+  g_array_free (coords, TRUE);
+
+  if (pts->len < 2)
+    {
+      g_array_unref (pts);
+      return NULL;
+    }
+
+  return pts;
+}
+
+typedef struct
+{
+  GArray   *pts;
+  gdouble  *len;     /* cumulative length at each point */
+  gdouble   total;
+  gboolean  closed;
+} Line;
+
+static void
+line_sample (const Line *line,
+             gdouble     s,
+             Pt         *p,
+             Pt         *t)
+{
+  gint    n = line->pts->len;
+  gint    lo, hi;
+  Pt      a, b;
+  gdouble seg, f;
+
+  if (line->closed && line->total > 0)
+    {
+      s = fmod (s, line->total);
+      if (s < 0)
+        s += line->total;
+    }
+
+  if (s <= 0)
+    {
+      lo = 0;
+    }
+  else if (s >= line->total)
+    {
+      lo = n - 2;
+    }
+  else
+    {
+      lo = 0;
+      hi = n - 1;
+
+      while (hi - lo > 1)
+        {
+          gint mid = (lo + hi) / 2;
+
+          if (line->len[mid] <= s)
+            lo = mid;
+          else
+            hi = mid;
+        }
+    }
+
+  a   = g_array_index (line->pts, Pt, lo);
+  b   = g_array_index (line->pts, Pt, lo + 1);
+  seg = MAX (line->len[lo + 1] - line->len[lo], 1e-9);
+  f   = (s - line->len[lo]) / seg;   /* may be < 0 or > 1: extrapolation */
+
+  p->x = a.x + (b.x - a.x) * f;
+  p->y = a.y + (b.y - a.y) * f;
+  t->x = (b.x - a.x) / seg;
+  t->y = (b.y - a.y) / seg;
+}
+
+static gboolean
+fx_on_path (ChopGimpTextFx *fx,
+            GimpPath       *path,
+            const gchar    *spec,
+            PangoLayout    *pl,
+            GimpText       *text)
+{
+  GimpStroke     *stroke = gimp_path_stroke_get_next (path, NULL);
+  Line            line   = { 0, };
+  PangoRectangle  logical;
+  gdouble         start, shift, s0, base;
+  gboolean        flip;
+  gint            p, s, i;
+
+  if (! stroke)
+    return FALSE;
+
+  line.pts = stroke_polyline (stroke, &line.closed);
+  if (! line.pts)
+    return FALSE;
+
+  flip  = spec_double (spec, "flip",  0.0) != 0.0;
+  start = spec_double (spec, "start", 0.0) / 100.0;
+  shift = spec_double (spec, "shift", 0.0);
+
+  if (flip)
+    {
+      GArray *rev = g_array_sized_new (FALSE, FALSE, sizeof (Pt), line.pts->len);
+
+      for (i = line.pts->len - 1; i >= 0; i--)
+        g_array_append_val (rev, g_array_index (line.pts, Pt, i));
+
+      g_array_unref (line.pts);
+      line.pts = rev;
+    }
+
+  line.len    = g_new (gdouble, line.pts->len);
+  line.len[0] = 0.0;
+
+  for (i = 1; i < line.pts->len; i++)
+    {
+      Pt a = g_array_index (line.pts, Pt, i - 1);
+      Pt b = g_array_index (line.pts, Pt, i);
+
+      line.len[i] = line.len[i - 1] + hypot (b.x - a.x, b.y - a.y);
+    }
+
+  line.total = line.len[line.pts->len - 1];
+
+  pango_layout_get_pixel_extents (pl, NULL, &logical);
+  base = (gdouble) pango_layout_get_baseline (pl) / PANGO_SCALE;
+
+  switch (text->justify)
+    {
+    case GIMP_TEXT_JUSTIFY_CENTER:
+      s0 = (line.total - logical.width) / 2.0 + start * line.total;
+      break;
+    case GIMP_TEXT_JUSTIFY_RIGHT:
+      s0 = line.total - logical.width - start * line.total;
+      break;
+    default:
+      s0 = start * line.total;
+      break;
+    }
+
+  fx_subdivide (fx, TRUE);
+
+  for (p = 0; p < fx->pieces->len; p++)
+    {
+      Piece *piece = g_ptr_array_index (fx->pieces, p);
+
+      for (s = 0; s < piece->subs->len; s++)
+        {
+          Sub *sub = g_ptr_array_index (piece->subs, s);
+          Pt   P, T, N;
+
+          if (! sub->bend)
+            {
+              line_sample (&line, s0 + sub->gx, &P, &T);
+              N.x =  T.y;
+              N.y = -T.x;
+            }
+
+          for (i = 0; i < sub->pts->len; i++)
+            {
+              Pt     *pt = &g_array_index (sub->pts, Pt, i);
+              gdouble dx, dy;
+
+              if (sub->bend)
+                {
+                  line_sample (&line, s0 + pt->x, &P, &T);
+                  N.x =  T.y;
+                  N.y = -T.x;
+                  dx  = 0.0;
+                }
+              else
+                {
+                  dx = pt->x - sub->gx;
+                }
+
+              dy = base - pt->y + shift;
+
+              pt->x = P.x + dx * T.x + dy * N.x;
+              pt->y = P.y + dx * T.y + dy * N.y;
+            }
+        }
+    }
+
+  g_free (line.len);
+  g_array_unref (line.pts);
+
+  return TRUE;
+}
+
+
+/*  text in a shape  */
+
+static gint
+cmp_double (gconstpointer a,
+            gconstpointer b)
+{
+  gdouble x = *(const gdouble *) a, y = *(const gdouble *) b;
+
+  return (x > y) - (x < y);
+}
+
+/*  even-odd intervals of the shape on the horizontal line at y  */
+static GArray *
+shape_intervals (GPtrArray *polys,
+                 gdouble    y)
+{
+  GArray *xs  = g_array_new (FALSE, FALSE, sizeof (gdouble));
+  GArray *out = g_array_new (FALSE, FALSE, sizeof (gdouble));
+  gint    p, i;
+
+  for (p = 0; p < polys->len; p++)
+    {
+      GArray *pts = g_ptr_array_index (polys, p);
+      gint    n   = pts->len;
+
+      for (i = 0; i < n; i++)
+        {
+          Pt a = g_array_index (pts, Pt, i);
+          Pt b = g_array_index (pts, Pt, (i + 1) % n);
+
+          if ((a.y <= y && b.y > y) || (b.y <= y && a.y > y))
+            {
+              gdouble x = a.x + (y - a.y) * (b.x - a.x) / (b.y - a.y);
+
+              g_array_append_val (xs, x);
+            }
+        }
+    }
+
+  g_array_sort (xs, cmp_double);
+
+  for (i = 0; i + 1 < xs->len; i += 2)
+    {
+      g_array_append_val (out, g_array_index (xs, gdouble, i));
+      g_array_append_val (out, g_array_index (xs, gdouble, i + 1));
+    }
+
+  g_array_unref (xs);
+
+  return out;
+}
+
+static GArray *
+intervals_intersect (GArray *a,
+                     GArray *b)
+{
+  GArray *out = g_array_new (FALSE, FALSE, sizeof (gdouble));
+  gint    i, j;
+
+  for (i = 0; i + 1 < a->len; i += 2)
+    for (j = 0; j + 1 < b->len; j += 2)
+      {
+        gdouble lo = MAX (g_array_index (a, gdouble, i),
+                          g_array_index (b, gdouble, j));
+        gdouble hi = MIN (g_array_index (a, gdouble, i + 1),
+                          g_array_index (b, gdouble, j + 1));
+
+        if (hi > lo)
+          {
+            g_array_append_val (out, lo);
+            g_array_append_val (out, hi);
+          }
+      }
+
+  return out;
+}
+
+static gboolean
+shape_span (GPtrArray *polys,
+            gdouble    y1,
+            gdouble    y2,
+            gdouble    inset,
+            gdouble   *x1,
+            gdouble   *x2)
+{
+  const gdouble f[3] = { 0.02, 0.5, 0.98 };
+  GArray       *acc  = NULL;
+  gdouble       best = 0.0;
+  gint          k, i;
+
+  for (k = 0; k < 3; k++)
+    {
+      GArray *cur = shape_intervals (polys, y1 + (y2 - y1) * f[k]);
+
+      if (acc)
+        {
+          GArray *tmp = intervals_intersect (acc, cur);
+
+          g_array_unref (acc);
+          g_array_unref (cur);
+          acc = tmp;
+        }
+      else
+        {
+          acc = cur;
+        }
+    }
+
+  for (i = 0; i + 1 < acc->len; i += 2)
+    {
+      gdouble lo = g_array_index (acc, gdouble, i)     + inset;
+      gdouble hi = g_array_index (acc, gdouble, i + 1) - inset;
+
+      if (hi - lo > best)
+        {
+          best = hi - lo;
+          *x1  = lo;
+          *x2  = hi;
+        }
+    }
+
+  g_array_unref (acc);
+
+  return best > 0.0;
+}
+
+static gboolean
+fx_in_shape (ChopGimpTextFx *fx,
+             cairo_t        *cr,
+             GimpPath       *path,
+             const gchar    *spec,
+             PangoLayout    *src)
+{
+  GPtrArray     *polys = g_ptr_array_new_with_free_func ((GDestroyNotify) g_array_unref);
+  GimpStroke    *stroke;
+  const gchar   *txt   = pango_layout_get_text (src);
+  PangoAttrList *attrs = pango_layout_get_attributes (src);
+  gdouble        inset = spec_double (spec, "inset", 0.0);
+  gdouble        spacing = (gdouble) pango_layout_get_spacing (src) / PANGO_SCALE;
+  gdouble        top = G_MAXDOUBLE, bottom = -G_MAXDOUBLE;
+  gdouble        y;
+  gint           total = strlen (txt);
+  gint           pos   = 0;
+  gint           i, guard = 0;
+
+  for (stroke = gimp_path_stroke_get_next (path, NULL);
+       stroke;
+       stroke = gimp_path_stroke_get_next (path, stroke))
+    {
+      gboolean  closed;
+      GArray   *pts = stroke_polyline (stroke, &closed);
+
+      if (! pts)
+        continue;
+
+      for (i = 0; i < pts->len; i++)
+        {
+          Pt pt = g_array_index (pts, Pt, i);
+
+          top    = MIN (top,    pt.y);
+          bottom = MAX (bottom, pt.y);
+        }
+
+      g_ptr_array_add (polys, pts);
+    }
+
+  if (! polys->len)
+    {
+      g_ptr_array_unref (polys);
+      return FALSE;
+    }
+
+  y = top + inset;
+
+  while (pos < total && guard++ < 10000)
+    {
+      PangoLayout     *pl = pango_layout_copy (src);
+      PangoLayoutLine *l0;
+      PangoRectangle   ink, log;
+      gdouble          lh, x1, x2;
+      gint             len;
+
+      pango_layout_set_text (pl, txt + pos, -1);
+
+      if (attrs)
+        {
+          PangoAttrList *a = pango_attr_list_copy (attrs);
+
+          pango_attr_list_update (a, 0, pos, 0);
+          pango_layout_set_attributes (pl, a);
+          pango_attr_list_unref (a);
+        }
+
+      pango_layout_set_width (pl, -1);
+      l0 = pango_layout_get_line_readonly (pl, 0);
+      pango_layout_line_get_pixel_extents (l0, &ink, &log);
+      lh = MAX (1, log.height);
+
+      if (y + lh > bottom - inset)
+        {
+          g_object_unref (pl);
+          break;
+        }
+
+      if (! shape_span (polys, y, y + lh, inset, &x1, &x2) ||
+          x2 - x1 < lh * 0.6)
+        {
+          y += MAX (1.0, lh / 4.0);
+          g_object_unref (pl);
+          continue;
+        }
+
+      pango_layout_set_width (pl, pango_units_from_double (x2 - x1));
+      l0  = pango_layout_get_line_readonly (pl, 0);
+      len = l0->length;
+
+      cairo_save (cr);
+      cairo_translate (cr, x1, y);
+      fx_collect (fx, cr, pl, TRUE);
+      cairo_restore (cr);
+
+      pango_layout_line_get_pixel_extents (l0, &ink, &log);
+      lh = MAX (1, log.height);
+
+      pos += len;
+      if (pos < total && txt[pos] == '\r')
+        pos++;
+      if (pos < total && txt[pos] == '\n')
+        pos++;
+      else if (len == 0)
+        pos = g_utf8_next_char (txt + pos) - txt;
+
+      y += lh + spacing;
+
+      g_object_unref (pl);
+    }
+
+  g_ptr_array_unref (polys);
+
+  return TRUE;
+}
+
+
+/*  placement bookkeeping: how far the layer was moved from its anchor  */
+
+static void
+get_shift (GimpItem *item,
+           gint     *dx,
+           gint     *dy)
+{
+  const GimpParasite *parasite = gimp_item_parasite_find (item, SHIFT_PARASITE);
+
+  *dx = *dy = 0;
+
+  if (parasite)
+    {
+      guint32       size;
+      const gchar  *data = gimp_parasite_get_data (parasite, &size);
+      gchar        *str  = g_strndup (data, size);
+
+      if (sscanf (str, "%d %d", dx, dy) != 2)
+        *dx = *dy = 0;
+
+      g_free (str);
+    }
+}
+
+static void
+set_shift (GimpItem *item,
+           gint      dx,
+           gint      dy)
+{
+  if (dx == 0 && dy == 0)
+    {
+      if (gimp_item_parasite_find (item, SHIFT_PARASITE))
+        gimp_item_parasite_detach (item, SHIFT_PARASITE, FALSE);
+    }
+  else
+    {
+      gchar        *str = g_strdup_printf ("%d %d", dx, dy);
+      GimpParasite *parasite;
+
+      parasite = gimp_parasite_new (SHIFT_PARASITE, GIMP_PARASITE_PERSISTENT,
+                                    strlen (str) + 1, str);
+      gimp_item_parasite_attach (item, parasite, FALSE);
+      gimp_parasite_free (parasite);
+      g_free (str);
+    }
+}
+
+static void
+fx_unshift (GimpTextLayer *layer)
+{
+  GimpItem *item = GIMP_ITEM (layer);
+  gint      dx, dy;
+
+  get_shift (item, &dx, &dy);
+
+  if (dx || dy)
+    {
+      if (gimp_item_is_attached (item))
+        gimp_drawable_update (GIMP_DRAWABLE (item), 0, 0, -1, -1);
+
+      gimp_item_set_offset (item,
+                            gimp_item_get_offset_x (item) - dx,
+                            gimp_item_get_offset_y (item) - dy);
+      set_shift (item, 0, 0);
+    }
+}
+
+
+/*  following the path  */
+
+static gboolean
+fx_refresh_idle (gpointer data)
+{
+  GimpTextLayer *layer = data;
+
+  g_object_set_data (G_OBJECT (layer), "chopgimp-fx-idle", NULL);
+
+  if (gimp_item_is_attached (GIMP_ITEM (layer)))
+    gimp_text_layer_chopgimp_refresh (layer);
+
+  g_object_unref (layer);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+fx_path_thaw (GimpPath      *path,
+              GimpTextLayer *layer)
+{
+  if (g_object_get_data (G_OBJECT (layer), "chopgimp-fx-idle"))
+    return;
+
+  g_object_set_data (G_OBJECT (layer), "chopgimp-fx-idle", GINT_TO_POINTER (1));
+  g_idle_add (fx_refresh_idle, g_object_ref (layer));
+}
+
+static void
+fx_follow (GimpTextLayer *layer,
+           GimpPath      *path)
+{
+  GimpPath *old = g_object_get_data (G_OBJECT (layer), "chopgimp-fx-path");
+
+  if (old == path)
+    return;
+
+  if (old)
+    g_signal_handlers_disconnect_by_func (old, fx_path_thaw, layer);
+
+  if (path)
+    g_signal_connect_object (path, "thaw", G_CALLBACK (fx_path_thaw), layer, 0);
+
+  g_object_set_data_full (G_OBJECT (layer), "chopgimp-fx-path",
+                          path ? g_object_ref (path) : NULL,
+                          path ? g_object_unref : NULL);
+}
+
+
+/*  public  */
+
+GimpPath *
+chopgimp_text_fx_find_path (GimpImage  *image,
+                            GimpTattoo  tattoo)
+{
+  GimpPath *path = gimp_image_get_path_by_tattoo (image, tattoo);
+  GList    *layers, *list;
+
+  if (path || ! tattoo)
+    return path;
+
+  /*  the path of a vector layer  */
+  layers = gimp_image_get_layer_list (image);
+
+  for (list = layers; list && ! path; list = list->next)
+    if (GIMP_IS_VECTOR_LAYER (list->data))
+      {
+        GimpPath *p = gimp_vector_layer_get_path (list->data);
+
+        if (p && gimp_item_get_tattoo (GIMP_ITEM (p)) == tattoo)
+          path = p;
+      }
+
+  g_list_free (layers);
+
+  return path;
+}
+
+ChopGimpTextFx *
+chopgimp_text_fx_build (GimpTextLayer  *layer,
+                        GimpTextLayout *layout)
+{
+  GimpText        *text  = layer->text;
+  const gchar     *spec  = text->chopgimp_fx;
+  GimpImage       *image = gimp_item_get_image (GIMP_ITEM (layer));
+  ChopGimpTextFx  *fx;
+  GimpPath        *path  = NULL;
+  FxMode           mode;
+  gchar           *v;
+  cairo_surface_t *surface;
+  cairo_t         *cr;
+  PangoLayout     *pl;
+  gboolean         ok    = TRUE;
+  gdouble          x1, y1, x2, y2, pad;
+  const GimpMatrix2 *m   = &text->transformation;
+
+  if ((v = chopgimp_text_fx_get_value (spec, "warp")) && strcmp (v, "none"))
+    mode = FX_WARP;
+  else if (g_free (v), (v = chopgimp_text_fx_get_value (spec, "path")))
+    mode = FX_PATH;
+  else if ((v = chopgimp_text_fx_get_value (spec, "shape")))
+    mode = FX_SHAPE;
+  else if (fabs (m->coeff[0][0] - 1.0) > 1e-6 || fabs (m->coeff[0][1]) > 1e-6 ||
+           fabs (m->coeff[1][0])       > 1e-6 || fabs (m->coeff[1][1] - 1.0) > 1e-6)
+    mode = FX_MATRIX;
+  else
+    {
+      fx_follow (layer, NULL);
+      fx_unshift (layer);
+      return NULL;
+    }
+
+  if (mode == FX_PATH || mode == FX_SHAPE)
+    {
+      path = chopgimp_text_fx_find_path (image, (GimpTattoo) atoi (v));
+    }
+  g_free (v);
+
+  fx_follow (layer, path);
+
+  if (((mode == FX_PATH || mode == FX_SHAPE) && ! path) ||
+      text->base_dir == GIMP_TEXT_DIRECTION_TTB_RTL         ||
+      text->base_dir == GIMP_TEXT_DIRECTION_TTB_RTL_UPRIGHT ||
+      text->base_dir == GIMP_TEXT_DIRECTION_TTB_LTR         ||
+      text->base_dir == GIMP_TEXT_DIRECTION_TTB_LTR_UPRIGHT)
+    {
+      fx_unshift (layer);
+      return NULL;
+    }
+
+  fx         = g_new0 (ChopGimpTextFx, 1);
+  fx->mode   = mode;
+  fx->pieces = g_ptr_array_new_with_free_func ((GDestroyNotify) piece_free);
+  fx->absolute = (mode == FX_PATH || mode == FX_SHAPE);
+
+  surface = cairo_image_surface_create (CAIRO_FORMAT_A8, 1, 1);
+  cr      = cairo_create (surface);
+  pl      = gimp_text_layout_get_pango_layout (layout);
+
+  switch (mode)
+    {
+    case FX_MATRIX:
+    case FX_WARP:
+      {
+        cairo_matrix_t trafo;
+        gint           x, y;
+
+        gimp_text_layout_get_offsets (layout, &x, &y);
+        cairo_translate (cr, x, y);
+        gimp_text_layout_get_transform (layout, &trafo);
+        cairo_transform (cr, &trafo);
+
+        fx_collect (fx, cr, pl, FALSE);
+
+        cairo_identity_matrix (cr);
+
+        if (mode == FX_WARP)
+          fx_warp (fx, spec);
+      }
+      break;
+
+    case FX_PATH:
+      fx_collect (fx, cr, pl, FALSE);
+      ok = fx_on_path (fx, path, spec, pl, text);
+      break;
+
+    case FX_SHAPE:
+      ok = fx_in_shape (fx, cr, path, spec, pl);
+      break;
+    }
+
+  cairo_destroy (cr);
+  cairo_surface_destroy (surface);
+
+  if (! ok || ! fx_bounds (fx, &x1, &y1, &x2, &y2))
+    {
+      chopgimp_text_fx_free (fx);
+      fx_unshift (layer);
+      return NULL;
+    }
+
+  pad = 2.0;
+  if (text->outline != GIMP_TEXT_OUTLINE_NONE)
+    pad += text->outline_width;
+
+  fx->ox     = (gint) floor (x1 - pad);
+  fx->oy     = (gint) floor (y1 - pad);
+  fx->width  = (gint) ceil  (x2 + pad) - fx->ox;
+  fx->height = (gint) ceil  (y2 + pad) - fx->oy;
+
+  return fx;
+}
+
+gboolean
+chopgimp_text_fx_get_size (ChopGimpTextFx *fx,
+                           gint           *width,
+                           gint           *height)
+{
+  *width  = fx->width;
+  *height = fx->height;
+
+  return (fx->width > 0 && fx->height > 0);
+}
+
+void
+chopgimp_text_fx_get_offset (ChopGimpTextFx *fx,
+                             GimpTextLayer  *layer,
+                             gint           *x,
+                             gint           *y)
+{
+  GimpItem *item = GIMP_ITEM (layer);
+  gint      dx, dy;
+
+  get_shift (item, &dx, &dy);
+
+  fx->anchor_x = gimp_item_get_offset_x (item) - dx;
+  fx->anchor_y = gimp_item_get_offset_y (item) - dy;
+
+  if (fx->absolute)
+    {
+      fx->new_x = fx->ox;
+      fx->new_y = fx->oy;
+    }
+  else
+    {
+      fx->new_x = fx->anchor_x + fx->ox;
+      fx->new_y = fx->anchor_y + fx->oy;
+    }
+
+  *x = fx->new_x;
+  *y = fx->new_y;
+}
+
+void
+chopgimp_text_fx_get_anchor (GimpTextLayer *layer,
+                             gint          *x,
+                             gint          *y)
+{
+  GimpItem *item = GIMP_ITEM (layer);
+  gint      dx, dy;
+
+  get_shift (item, &dx, &dy);
+
+  *x = gimp_item_get_offset_x (item) - dx;
+  *y = gimp_item_get_offset_y (item) - dy;
+}
+
+void
+chopgimp_text_fx_placed (ChopGimpTextFx *fx,
+                         GimpTextLayer  *layer)
+{
+  set_shift (GIMP_ITEM (layer),
+             fx->new_x - fx->anchor_x,
+             fx->new_y - fx->anchor_y);
+}
+
+static void
+fx_append_path (ChopGimpTextFx *fx,
+                cairo_t        *cr,
+                Piece          *only)
+{
+  gint p, s, i;
+
+  for (p = 0; p < fx->pieces->len; p++)
+    {
+      Piece *piece = g_ptr_array_index (fx->pieces, p);
+
+      if (only && piece != only)
+        continue;
+
+      for (s = 0; s < piece->subs->len; s++)
+        {
+          Sub *sub = g_ptr_array_index (piece->subs, s);
+
+          for (i = 0; i < sub->pts->len; i++)
+            {
+              Pt pt = g_array_index (sub->pts, Pt, i);
+
+              if (i == 0)
+                cairo_move_to (cr, pt.x, pt.y);
+              else
+                cairo_line_to (cr, pt.x, pt.y);
+            }
+
+          cairo_close_path (cr);
+        }
+    }
+}
+
+static void
+fx_stroke (ChopGimpTextFx *fx,
+           cairo_t        *cr,
+           GimpTextLayout *layout,
+           GimpText       *text)
+{
+  const Babl *format = gimp_text_layout_get_format (layout, "double");
+  gdouble     color[3];
+
+  gegl_color_get_pixel (text->outline_foreground, format, color);
+  if (babl_space_is_gray (babl_format_get_space (format)))
+    color[1] = color[2] = color[0];
+
+  cairo_save (cr);
+
+  cairo_set_source_rgba (cr, color[0], color[1], color[2], 1.0);
+  cairo_set_antialias (cr, text->outline_antialias ?
+                       CAIRO_ANTIALIAS_GRAY : CAIRO_ANTIALIAS_NONE);
+  cairo_set_line_join (cr,
+                       text->outline_join_style == GIMP_JOIN_MITER ? CAIRO_LINE_JOIN_MITER :
+                       text->outline_join_style == GIMP_JOIN_ROUND ? CAIRO_LINE_JOIN_ROUND :
+                       CAIRO_LINE_JOIN_BEVEL);
+  cairo_set_miter_limit (cr, text->outline_miter_limit);
+  cairo_set_line_width (cr, text->outline_width * 2);
+
+  if (text->outline_direction == GIMP_TEXT_OUTLINE_DIRECTION_INNER)
+    {
+      cairo_new_path (cr);
+      fx_append_path (fx, cr, NULL);
+      cairo_clip (cr);
+    }
+
+  cairo_new_path (cr);
+  fx_append_path (fx, cr, NULL);
+  cairo_stroke (cr);
+
+  cairo_restore (cr);
+}
+
+void
+chopgimp_text_fx_draw (ChopGimpTextFx *fx,
+                       cairo_t        *cr,
+                       GimpTextLayout *layout)
+{
+  GimpText *text   = gimp_text_layout_get_text (layout);
+  gboolean  fill   = text->outline != GIMP_TEXT_OUTLINE_STROKE_ONLY;
+  gboolean  stroke = text->outline != GIMP_TEXT_OUTLINE_NONE;
+  gboolean  under  = stroke && fill &&
+                     text->outline_direction == GIMP_TEXT_OUTLINE_DIRECTION_OUTER;
+  gint      p;
+
+  cairo_save (cr);
+
+  cairo_translate (cr, -fx->ox, -fx->oy);
+  cairo_set_fill_rule (cr, CAIRO_FILL_RULE_WINDING);
+  cairo_set_antialias (cr, text->antialias ?
+                       CAIRO_ANTIALIAS_GRAY : CAIRO_ANTIALIAS_NONE);
+
+  if (under)
+    fx_stroke (fx, cr, layout, text);
+
+  if (fill)
+    {
+      for (p = 0; p < fx->pieces->len; p++)
+        {
+          Piece *piece = g_ptr_array_index (fx->pieces, p);
+
+          cairo_new_path (cr);
+          fx_append_path (fx, cr, piece);
+          cairo_set_source_rgba (cr, piece->r, piece->g, piece->b, 1.0);
+          cairo_fill (cr);
+        }
+    }
+
+  if (stroke && ! under)
+    fx_stroke (fx, cr, layout, text);
+
+  cairo_restore (cr);
+}
+
+void
+chopgimp_text_fx_free (ChopGimpTextFx *fx)
+{
+  if (! fx)
+    return;
+
+  g_ptr_array_unref (fx->pieces);
+  g_free (fx);
+}
