+static gboolean chopgimp_text_tool_has_fx (GimpTextTool *text_tool);
+
+/*  ChopGimp: right click on a misspelled word: suggestions  */
+typedef struct
+{
+  GimpTextTool *text_tool;
+  gint          start;
+  gint          end;
+  gchar        *word;
+  gchar        *lang;
+} SpellFix;
+
+static void
+spell_fix_free (SpellFix *fix)
+{
+  g_free (fix->word);
+  g_free (fix->lang);
+  g_free (fix);
+}
+
+static void
+spell_replace (GtkMenuItem *item,
+               SpellFix    *fix)
+{
+  GtkTextBuffer *buffer = GTK_TEXT_BUFFER (fix->text_tool->buffer);
+  const gchar   *repl   = g_object_get_data (G_OBJECT (item), "chopgimp-word");
+  GtkTextIter    start, end;
+
+  gimp_text_buffer_get_iter_at_index (fix->text_tool->buffer, &start, fix->start, TRUE);
+  gimp_text_buffer_get_iter_at_index (fix->text_tool->buffer, &end,   fix->end,   TRUE);
+
+  gtk_text_buffer_begin_user_action (buffer);
+  gtk_text_buffer_delete (buffer, &start, &end);
+  gtk_text_buffer_insert (buffer, &start, repl, -1);
+  gtk_text_buffer_end_user_action (buffer);
+}
+
+static void
+spell_learn (GtkMenuItem *item,
+             SpellFix    *fix)
+{
+  chopgimp_spell_learn (fix->lang, fix->word,
+                        GPOINTER_TO_INT (g_object_get_data (G_OBJECT (item), "permanent")));
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (fix->text_tool));
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (fix->text_tool));
+}
+
+static gboolean
+spell_menu_destroy (gpointer menu)
+{
+  gtk_widget_destroy (menu);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+spell_menu_deactivate (GtkMenuShell *menu)
+{
+  g_idle_add (spell_menu_destroy, menu);
+}
+
+static gboolean
+chopgimp_text_tool_spell_popup (GimpTextTool     *text_tool,
+                                const GimpCoords *coords,
+                                GimpDisplay      *display)
+{
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  PangoLayout      *layout;
+  const gchar      *text;
+  gdouble           x, y;
+  gint              offset_x, offset_y, off_x, off_y;
+  gint              index, trailing, start, end;
+  gchar            *word;
+  gchar           **suggestions;
+  GtkWidget        *menu, *item;
+  SpellFix         *fix;
+  gint              i;
+
+  if (! text_tool->layer || ! text_tool->layout || ! text_tool->layer->text ||
+      ! chopgimp_spell_enabled () || chopgimp_text_tool_has_fx (text_tool))
+    return FALSE;
+
+  layout = gimp_text_layout_get_pango_layout (text_tool->layout);
+  text   = pango_layout_get_text (layout);
+
+  gimp_text_layout_get_offsets (text_tool->layout, &offset_x, &offset_y);
+  chopgimp_text_fx_get_anchor (text_tool->layer, &off_x, &off_y);
+
+  x = coords->x - off_x - offset_x;
+  y = coords->y - off_y - offset_y;
+  gimp_text_layout_untransform_point (text_tool->layout, &x, &y);
+
+  if (! pango_layout_xy_to_index (layout, x * PANGO_SCALE, y * PANGO_SCALE,
+                                  &index, &trailing) ||
+      ! chopgimp_spell_word_at (text, index, &start, &end))
+    return FALSE;
+
+  word = g_strndup (text + start, end - start);
+
+  if (! chopgimp_spell_is_wrong (text_tool->layer->text->language, word))
+    {
+      g_free (word);
+      return FALSE;
+    }
+
+  fix            = g_new0 (SpellFix, 1);
+  fix->text_tool = text_tool;
+  fix->start     = start;
+  fix->end       = end;
+  fix->word      = word;
+  fix->lang      = g_strdup (text_tool->layer->text->language);
+
+  menu = gtk_menu_new ();
+  g_object_set_data_full (G_OBJECT (menu), "chopgimp-fix", fix,
+                          (GDestroyNotify) spell_fix_free);
+
+  suggestions = chopgimp_spell_suggest (fix->lang, word);
+
+  for (i = 0; suggestions[i]; i++)
+    {
+      item = gtk_menu_item_new ();
+      gtk_container_add (GTK_CONTAINER (item), gtk_label_new (NULL));
+      {
+        gchar *markup = g_markup_printf_escaped ("<b>%s</b>", suggestions[i]);
+        gtk_label_set_markup (GTK_LABEL (gtk_bin_get_child (GTK_BIN (item))), markup);
+        gtk_label_set_xalign (GTK_LABEL (gtk_bin_get_child (GTK_BIN (item))), 0.0);
+        g_free (markup);
+      }
+      g_object_set_data_full (G_OBJECT (item), "chopgimp-word",
+                              g_strdup (suggestions[i]), g_free);
+      g_signal_connect (item, "activate", G_CALLBACK (spell_replace), fix);
+      gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+    }
+
+  if (! suggestions[0])
+    {
+      item = gtk_menu_item_new_with_label (_("(aucune suggestion)"));
+      gtk_widget_set_sensitive (item, FALSE);
+      gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+    }
+
+  g_strfreev (suggestions);
+
+  gtk_menu_shell_append (GTK_MENU_SHELL (menu), gtk_separator_menu_item_new ());
+
+  item = gtk_menu_item_new_with_label (_("Ajouter au dictionnaire"));
+  g_object_set_data (G_OBJECT (item), "permanent", GINT_TO_POINTER (TRUE));
+  g_signal_connect (item, "activate", G_CALLBACK (spell_learn), fix);
+  gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+
+  item = gtk_menu_item_new_with_label (_("Ignorer"));
+  g_signal_connect (item, "activate", G_CALLBACK (spell_learn), fix);
+  gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+
+  gtk_widget_show_all (menu);
+  gtk_menu_attach_to_widget (GTK_MENU (menu), shell->canvas, NULL);
+  g_signal_connect (menu, "deactivate", G_CALLBACK (spell_menu_deactivate), NULL);
+  gtk_menu_popup_at_pointer (GTK_MENU (menu), NULL);
+
+  return TRUE;
+}
+
