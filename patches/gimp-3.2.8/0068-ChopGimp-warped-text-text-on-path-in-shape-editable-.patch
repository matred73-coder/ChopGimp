+/*  ChopGimp: a click on a path starts a text on that path, a click in a
+ *  vector shape starts a text that fills the shape (Photoshop).
+ */
+static gdouble
+chopgimp_path_distance (GimpPath *path,
+                        gdouble   x,
+                        gdouble   y)
+{
+  GimpStroke *stroke = NULL;
+  gdouble     best   = G_MAXDOUBLE;
+
+  while ((stroke = gimp_path_stroke_get_next (path, stroke)))
+    {
+      GimpCoords coords = GIMP_COORDS_DEFAULT_VALUES;
+      gdouble    dist;
+
+      coords.x = x;
+      coords.y = y;
+      dist = gimp_stroke_nearest_point_get (stroke, &coords, 1.0,
+                                            NULL, NULL, NULL, NULL);
+      if (dist >= 0.0)
+        best = MIN (best, dist);
+    }
+
+  return best;
+}
+
+static gchar *
+chopgimp_text_tool_fx_at (GimpImage        *image,
+                          GimpDisplayShell *shell,
+                          const GimpCoords *coords)
+{
+  gdouble    eps = 6.0 / MAX (shell->scale_x, 1e-6);
+  GimpPath  *path;
+  GimpLayer *layer;
+  GList     *list;
+
+  path = gimp_image_pick_path (image, coords->x, coords->y, eps, eps);
+
+  for (list = gimp_image_get_selected_paths (image); list && ! path; list = list->next)
+    if (chopgimp_path_distance (list->data, coords->x, coords->y) < eps)
+      path = list->data;
+
+  if (path)
+    return g_strdup_printf ("path=%u;start=0;flip=0;shift=0",
+                            gimp_item_get_tattoo (GIMP_ITEM (path)));
+
+  layer = gimp_image_pick_layer (image, coords->x, coords->y, NULL);
+
+  if (GIMP_IS_VECTOR_LAYER (layer) &&
+      (path = gimp_vector_layer_get_path (GIMP_VECTOR_LAYER (layer))))
+    {
+      if (chopgimp_path_distance (path, coords->x, coords->y) < eps)
+        return g_strdup_printf ("path=%u;start=0;flip=0;shift=0",
+                                gimp_item_get_tattoo (GIMP_ITEM (path)));
+
+      return g_strdup_printf ("shape=%u;inset=6",
+                              gimp_item_get_tattoo (GIMP_ITEM (path)));
+    }
+
+  return NULL;
+}
