+/*  ChopGimp: an affine transformation becomes part of the text matrix,
+ *  the layer stays an editable text layer (Photoshop behaviour).
+ *  Returns FALSE when the pixels have to be transformed instead.
+ */
+static gboolean
+chopgimp_text_layer_apply_matrix (GimpTextLayer     *layer,
+                                  const GimpMatrix3 *matrix,
+                                  gboolean           push_undo)
+{
+  GimpItem       *item  = GIMP_ITEM (layer);
+  GimpImage      *image = gimp_item_get_image (item);
+  GimpText       *text  = layer->text;
+  GimpTextLayout *layout;
+  GimpMatrix2     lin;
+  gchar          *mode;
+  gdouble         xres, yres;
+  gdouble         px, py, nx, ny;
+  gint            ex, ey, ax, ay, bx, by;
+
+  if (! text || ! gimp_item_is_attached (item) ||
+      gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)) ||
+      gimp_layer_get_mask (GIMP_LAYER (layer))                    ||
+      ! gimp_matrix3_is_affine (matrix))
+    return FALSE;
+
+  /*  text on a path or in a shape follows its path, not a matrix  */
+  if ((mode = chopgimp_text_fx_get_value (text->chopgimp_fx, "path")) ||
+      (mode = chopgimp_text_fx_get_value (text->chopgimp_fx, "shape")))
+    {
+      g_free (mode);
+      return FALSE;
+    }
+
+  gimp_image_get_resolution (image, &xres, &yres);
+  layout = gimp_text_layout_new (text, image, xres, yres, NULL);
+  if (! layout)
+    return FALSE;
+  gimp_text_layout_get_offsets (layout, &ex, &ey);
+  g_object_unref (layout);
+
+  /*  where the origin of the text is now, and where it must go  */
+  chopgimp_text_fx_get_anchor (layer, &ax, &ay);
+  px = ax + ex;
+  py = ay + ey;
+  gimp_matrix3_transform_point (matrix, px, py, &nx, &ny);
+
+  lin.coeff[0][0] = matrix->coeff[0][0] * text->transformation.coeff[0][0] +
+                    matrix->coeff[0][1] * text->transformation.coeff[1][0];
+  lin.coeff[0][1] = matrix->coeff[0][0] * text->transformation.coeff[0][1] +
+                    matrix->coeff[0][1] * text->transformation.coeff[1][1];
+  lin.coeff[1][0] = matrix->coeff[1][0] * text->transformation.coeff[0][0] +
+                    matrix->coeff[1][1] * text->transformation.coeff[1][0];
+  lin.coeff[1][1] = matrix->coeff[1][0] * text->transformation.coeff[0][1] +
+                    matrix->coeff[1][1] * text->transformation.coeff[1][1];
+
+  if (push_undo)
+    gimp_text_layer_set (layer, NULL, "transformation", &lin, NULL);
+  else
+    g_object_set (text, "transformation", &lin, NULL);
+
+  chopgimp_text_fx_get_anchor (layer, &bx, &by);
+
+  gimp_item_translate (item,
+                       floor (nx - ex - bx + 0.5),
+                       floor (ny - ey - by + 0.5),
+                       push_undo);
+
+  return TRUE;
+}
+
+static void
+chopgimp_text_layer_transform (GimpItem               *item,
+                               GimpContext            *context,
+                               const GimpMatrix3      *matrix,
+                               GimpTransformDirection  direction,
+                               GimpInterpolationType   interpolation,
+                               GimpTransformResize     clip_result,
+                               GimpProgress           *progress,
+                               gboolean                push_undo)
+{
+  GimpMatrix3 m = *matrix;
+
+  if (direction == GIMP_TRANSFORM_BACKWARD)
+    gimp_matrix3_invert (&m);
+
+  if (! chopgimp_text_layer_apply_matrix (GIMP_TEXT_LAYER (item), &m, push_undo))
+    GIMP_ITEM_CLASS (parent_class)->transform (item, context, matrix, direction,
+                                               interpolation, clip_result,
+                                               progress, push_undo);
+}
+
+static void
+chopgimp_text_layer_flip (GimpItem            *item,
+                          GimpContext         *context,
+                          GimpOrientationType  flip_type,
+                          gdouble              axis,
+                          gboolean             clip_result)
+{
+  GimpMatrix3 m;
+
+  gimp_matrix3_identity (&m);
+  gimp_transform_matrix_flip (&m, flip_type, axis);
+
+  if (! chopgimp_text_layer_apply_matrix (GIMP_TEXT_LAYER (item), &m,
+                                          gimp_item_is_attached (item)))
+    GIMP_ITEM_CLASS (parent_class)->flip (item, context, flip_type, axis,
+                                          clip_result);
+}
+
+static void
+chopgimp_text_layer_rotate (GimpItem         *item,
+                            GimpContext      *context,
+                            GimpRotationType  rotate_type,
+                            gdouble           center_x,
+                            gdouble           center_y,
+                            gboolean          clip_result)
+{
+  GimpMatrix3 m;
+
+  gimp_matrix3_identity (&m);
+  gimp_transform_matrix_rotate (&m, rotate_type, center_x, center_y);
+
+  if (! chopgimp_text_layer_apply_matrix (GIMP_TEXT_LAYER (item), &m,
+                                          gimp_item_is_attached (item)))
+    GIMP_ITEM_CLASS (parent_class)->rotate (item, context, rotate_type,
+                                            center_x, center_y, clip_result);
+}
+
+static void
+chopgimp_text_layer_scale (GimpItem              *item,
+                           gint                   new_width,
+                           gint                   new_height,
+                           gint                   new_offset_x,
+                           gint                   new_offset_y,
+                           GimpInterpolationType  interpolation,
+                           GimpProgress          *progress)
+{
+  GimpMatrix3 m;
+  gdouble     sx = (gdouble) new_width  / MAX (1, gimp_item_get_width  (item));
+  gdouble     sy = (gdouble) new_height / MAX (1, gimp_item_get_height (item));
+
+  /*  image scaling: the whole image is resampled, keep the default  */
+  gimp_matrix3_identity (&m);
+  gimp_matrix3_translate (&m, -gimp_item_get_offset_x (item),
+                              -gimp_item_get_offset_y (item));
+  gimp_matrix3_scale (&m, sx, sy);
+  gimp_matrix3_translate (&m, new_offset_x, new_offset_y);
+
+  if (! chopgimp_text_layer_apply_matrix (GIMP_TEXT_LAYER (item), &m,
+                                          gimp_item_is_attached (item)))
+    GIMP_ITEM_CLASS (parent_class)->scale (item, new_width, new_height,
+                                           new_offset_x, new_offset_y,
+                                           interpolation, progress);
+}
