diff --git a/app/widgets/chopgimp-spell.c b/app/widgets/chopgimp-spell.c
new file mode 100644
index 0000000..1c4a915
--- /dev/null
+++ b/app/widgets/chopgimp-spell.c
@@ -0,0 +1,476 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-spell.c — ChopGimp: spell checking of texts (Hunspell).
+ *
+ * libhunspell is loaded at run time (it is part of the GNOME runtime),
+ * the French dictionary is shipped in /app/share/hunspell.  The words
+ * the user adds are kept in ${gimp_dir}/chopgimp-dictionary-<lang>.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gio/gio.h>
+#include <gmodule.h>
+
+#include "libgimpbase/gimpbase.h"
+
+#include "chopgimp-rc.h"
+#include "chopgimp-spell.h"
+
+
+typedef gpointer (* CreateFunc)   (const gchar *aff, const gchar *dic);
+typedef gint     (* SpellFunc)    (gpointer h, const gchar *word);
+typedef gint     (* SuggestFunc)  (gpointer h, gchar ***list, const gchar *word);
+typedef void     (* FreeListFunc) (gpointer h, gchar ***list, gint n);
+typedef gint     (* AddFunc)      (gpointer h, const gchar *word);
+typedef gchar  * (* EncodingFunc) (gpointer h);
+
+static struct
+{
+  gboolean     tried;
+  GModule     *module;
+  CreateFunc   create;
+  SpellFunc    spell;
+  SuggestFunc  suggest;
+  FreeListFunc free_list;
+  AddFunc      add;
+  EncodingFunc encoding;
+} hun;
+
+typedef struct
+{
+  gpointer    handle;
+  gchar      *encoding;   /* NULL: UTF-8 */
+  gchar      *key;
+  GHashTable *cache;      /* word → GINT_TO_POINTER (1 ok / 2 wrong) */
+} Dict;
+
+static GHashTable *dicts = NULL;   /* key → Dict (or NULL: unavailable) */
+
+
+static gboolean
+hun_load (void)
+{
+  if (hun.tried)
+    return hun.module != NULL;
+
+  hun.tried  = TRUE;
+  hun.module = g_module_open ("libhunspell-1.7.so.0", G_MODULE_BIND_LAZY);
+
+  if (! hun.module)
+    return FALSE;
+
+  if (! g_module_symbol (hun.module, "Hunspell_create",    (gpointer *) &hun.create)    ||
+      ! g_module_symbol (hun.module, "Hunspell_spell",     (gpointer *) &hun.spell)     ||
+      ! g_module_symbol (hun.module, "Hunspell_suggest",   (gpointer *) &hun.suggest)   ||
+      ! g_module_symbol (hun.module, "Hunspell_free_list", (gpointer *) &hun.free_list) ||
+      ! g_module_symbol (hun.module, "Hunspell_add",       (gpointer *) &hun.add)       ||
+      ! g_module_symbol (hun.module, "Hunspell_get_dic_encoding",
+                         (gpointer *) &hun.encoding))
+    {
+      g_module_close (hun.module);
+      hun.module = NULL;
+    }
+
+  return hun.module != NULL;
+}
+
+static gchar *
+lang_key (const gchar *lang)
+{
+  const gchar * const *names;
+  gchar               *key;
+
+  if (! lang || ! *lang)
+    {
+      names = g_get_language_names ();
+      lang  = names[0];
+    }
+
+  key = g_ascii_strdown (lang, 2);
+
+  if (strlen (key) < 2 || ! g_ascii_isalpha (key[0]))
+    {
+      g_free (key);
+      key = g_strdup ("fr");
+    }
+
+  return key;
+}
+
+static gchar *
+personal_path (const gchar *key)
+{
+  gchar *name = g_strdup_printf ("chopgimp-dictionary-%s", key);
+  gchar *path = g_build_filename (gimp_directory (), name, NULL);
+
+  g_free (name);
+
+  return path;
+}
+
+static gchar *
+to_dict (Dict        *dict,
+         const gchar *word)
+{
+  if (! dict->encoding)
+    return g_strdup (word);
+
+  return g_convert (word, -1, dict->encoding, "UTF-8", NULL, NULL, NULL);
+}
+
+static Dict *
+dict_get (const gchar *lang)
+{
+  static const gchar *dirs[] = { "/app/share/hunspell", "/usr/share/hunspell",
+                                 "/usr/share/myspell", NULL };
+  gchar *key;
+  Dict  *dict;
+  gint   d, c;
+
+  if (! hun_load ())
+    return NULL;
+
+  if (! dicts)
+    dicts = g_hash_table_new (g_str_hash, g_str_equal);
+
+  key = lang_key (lang);
+
+  if (g_hash_table_contains (dicts, key))
+    {
+      dict = g_hash_table_lookup (dicts, key);
+      g_free (key);
+      return dict;
+    }
+
+  dict = NULL;
+
+  {
+    gchar *full = g_strdup_printf ("%s_%c%c", key,
+                                   g_ascii_toupper (key[0]), g_ascii_toupper (key[1]));
+    const gchar *candidates[] = { key, full,
+                                  ! strcmp (key, "en") ? "en_US" : NULL,
+                                  ! strcmp (key, "en") ? "en_GB" : NULL,
+                                  NULL };
+
+    for (c = 0; candidates[c] && ! dict; c++)
+      for (d = 0; dirs[d] && ! dict; d++)
+        {
+          gchar *aff = g_strdup_printf ("%s/%s.aff", dirs[d], candidates[c]);
+          gchar *dic = g_strdup_printf ("%s/%s.dic", dirs[d], candidates[c]);
+
+          if (g_file_test (aff, G_FILE_TEST_EXISTS) &&
+              g_file_test (dic, G_FILE_TEST_EXISTS))
+            {
+              gpointer handle = hun.create (aff, dic);
+
+              if (handle)
+                {
+                  const gchar *enc = hun.encoding (handle);
+
+                  dict         = g_new0 (Dict, 1);
+                  dict->handle = handle;
+                  dict->key    = g_strdup (key);
+                  dict->cache  = g_hash_table_new_full (g_str_hash, g_str_equal,
+                                                        g_free, NULL);
+                  if (enc && g_ascii_strcasecmp (enc, "UTF-8") &&
+                      g_ascii_strcasecmp (enc, "UTF8"))
+                    dict->encoding = g_strdup (enc);
+                }
+            }
+
+          g_free (aff);
+          g_free (dic);
+        }
+
+    g_free (full);
+  }
+
+  if (dict)
+    {
+      gchar  *path = personal_path (key);
+      gchar  *contents;
+
+      if (g_file_get_contents (path, &contents, NULL, NULL))
+        {
+          gchar **words = g_strsplit (contents, "\n", -1);
+
+          for (c = 0; words[c]; c++)
+            if (*words[c])
+              {
+                gchar *w = to_dict (dict, words[c]);
+
+                if (w)
+                  hun.add (dict->handle, w);
+                g_free (w);
+              }
+
+          g_strfreev (words);
+          g_free (contents);
+        }
+
+      g_free (path);
+    }
+
+  g_hash_table_insert (dicts, key, dict);
+
+  return dict;
+}
+
+gboolean
+chopgimp_spell_enabled (void)
+{
+  return chopgimp_rc_get_boolean ("text", "spell-check", TRUE);
+}
+
+static gboolean
+word_ok (Dict        *dict,
+         const gchar *word)
+{
+  gpointer cached = g_hash_table_lookup (dict->cache, word);
+  gchar   *w;
+  gboolean ok;
+
+  if (cached)
+    return GPOINTER_TO_INT (cached) == 1;
+
+  w  = to_dict (dict, word);
+  ok = w ? (hun.spell (dict->handle, w) != 0) : TRUE;
+
+  /*  typographic apostrophe: also try the ASCII one  */
+  if (! ok && strstr (word, "’"))
+    {
+      gchar **parts = g_strsplit (word, "’", -1);
+      gchar  *ascii = g_strjoinv ("'", parts);
+
+      g_free (w);
+      w  = to_dict (dict, ascii);
+      ok = w ? (hun.spell (dict->handle, w) != 0) : TRUE;
+
+      g_free (ascii);
+      g_strfreev (parts);
+    }
+
+  g_free (w);
+
+  g_hash_table_insert (dict->cache, g_strdup (word), GINT_TO_POINTER (ok ? 1 : 2));
+
+  return ok;
+}
+
+static gboolean
+is_word_char (gunichar c)
+{
+  return g_unichar_isalpha (c) || g_unichar_ismark (c);
+}
+
+static gboolean
+is_joiner (gunichar c)
+{
+  return c == '\'' || c == 0x2019 || c == '-';
+}
+
+/*  next word of text from pos: its byte range  */
+static gboolean
+next_word (const gchar *text,
+           gint         pos,
+           gint        *start,
+           gint        *end)
+{
+  const gchar *p = text + pos;
+
+  while (*p && ! is_word_char (g_utf8_get_char (p)))
+    p = g_utf8_next_char (p);
+
+  if (! *p)
+    return FALSE;
+
+  *start = p - text;
+
+  while (*p)
+    {
+      gunichar c = g_utf8_get_char (p);
+
+      if (is_word_char (c))
+        {
+          p = g_utf8_next_char (p);
+        }
+      else if (is_joiner (c))
+        {
+          const gchar *n = g_utf8_next_char (p);
+
+          if (*n && is_word_char (g_utf8_get_char (n)))
+            p = n;
+          else
+            break;
+        }
+      else
+        {
+          break;
+        }
+    }
+
+  *end = p - text;
+
+  return TRUE;
+}
+
+static gboolean
+word_needs_check (const gchar *word)
+{
+  const gchar *p;
+  gboolean     all_upper = TRUE;
+
+  if (g_utf8_strlen (word, -1) < 2)
+    return FALSE;
+
+  for (p = word; *p; p = g_utf8_next_char (p))
+    {
+      gunichar c = g_utf8_get_char (p);
+
+      if (g_unichar_isdigit (c))
+        return FALSE;
+      if (g_unichar_islower (c))
+        all_upper = FALSE;
+    }
+
+  /*  acronyms (« CEN », « GIMP ») are not checked  */
+  return ! all_upper;
+}
+
+GArray *
+chopgimp_spell_misspelled (const gchar *text,
+                           const gchar *lang)
+{
+  Dict   *dict;
+  GArray *bad;
+  gint    pos = 0, start, end;
+
+  if (! text || ! chopgimp_spell_enabled () || ! (dict = dict_get (lang)))
+    return NULL;
+
+  bad = g_array_new (FALSE, FALSE, sizeof (gint));
+
+  while (next_word (text, pos, &start, &end))
+    {
+      gchar *word = g_strndup (text + start, end - start);
+
+      if (word_needs_check (word) && ! word_ok (dict, word))
+        {
+          g_array_append_val (bad, start);
+          g_array_append_val (bad, end);
+        }
+
+      g_free (word);
+      pos = end;
+    }
+
+  return bad;
+}
+
+gboolean
+chopgimp_spell_word_at (const gchar *text,
+                        gint         index,
+                        gint        *start,
+                        gint        *end)
+{
+  gint pos = 0;
+
+  while (next_word (text, pos, start, end))
+    {
+      if (index >= *start && index <= *end)
+        return TRUE;
+
+      pos = *end;
+    }
+
+  return FALSE;
+}
+
+gboolean
+chopgimp_spell_is_wrong (const gchar *lang,
+                         const gchar *word)
+{
+  Dict *dict = dict_get (lang);
+
+  return dict && word_needs_check (word) && ! word_ok (dict, word);
+}
+
+gchar **
+chopgimp_spell_suggest (const gchar *lang,
+                        const gchar *word)
+{
+  Dict      *dict = dict_get (lang);
+  GPtrArray *out  = g_ptr_array_new ();
+  gchar    **list = NULL;
+  gchar     *w;
+  gint       n, i;
+
+  if (dict && (w = to_dict (dict, word)))
+    {
+      n = hun.suggest (dict->handle, &list, w);
+
+      for (i = 0; i < n && out->len < 8; i++)
+        {
+          gchar *s = dict->encoding ?
+                     g_convert (list[i], -1, "UTF-8", dict->encoding, NULL, NULL, NULL) :
+                     g_strdup (list[i]);
+          if (s)
+            g_ptr_array_add (out, s);
+        }
+
+      if (list)
+        hun.free_list (dict->handle, &list, n);
+
+      g_free (w);
+    }
+
+  g_ptr_array_add (out, NULL);
+
+  return (gchar **) g_ptr_array_free (out, FALSE);
+}
+
+void
+chopgimp_spell_learn (const gchar *lang,
+                      const gchar *word,
+                      gboolean     permanent)
+{
+  Dict  *dict = dict_get (lang);
+  gchar *w;
+
+  if (! dict)
+    return;
+
+  if ((w = to_dict (dict, word)))
+    hun.add (dict->handle, w);
+  g_free (w);
+
+  g_hash_table_insert (dict->cache, g_strdup (word), GINT_TO_POINTER (1));
+
+  if (permanent)
+    {
+      gchar         *path = personal_path (dict->key);
+      GFile         *file = g_file_new_for_path (path);
+      GOutputStream *out  = G_OUTPUT_STREAM (g_file_append_to (file, G_FILE_CREATE_NONE,
+                                                               NULL, NULL));
+
+      if (out)
+        {
+          gchar *line = g_strconcat (word, "\n", NULL);
+
+          g_output_stream_write_all (out, line, strlen (line), NULL, NULL, NULL);
+          g_output_stream_close (out, NULL, NULL);
+          g_object_unref (out);
+          g_free (line);
+        }
+
+      g_object_unref (file);
+      g_free (path);
+    }
+}
