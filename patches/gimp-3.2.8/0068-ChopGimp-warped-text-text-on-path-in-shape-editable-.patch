+/* ─── Glyphes ──────────────────────────────────────────────────────── */
+
+typedef struct
+{
+  Gimp       *gimp;
+  GtkWidget  *combo;
+  GtkWidget  *flow;
+  gchar      *font;        /* lookup name of the font shown */
+  guint       refresh_id;
+} Glyphs;
+
+static const struct { const gchar *name; gunichar first, last; } glyph_ranges[] =
+{
+  { N_("Ponctuation et espaces"),  0x2010, 0x205E },
+  { N_("Latin étendu"),            0x00A1, 0x017F },
+  { N_("Symboles monétaires"),     0x20A0, 0x20C0 },
+  { N_("Exposants et indices"),    0x2070, 0x209C },
+  { N_("Symboles de lettres"),     0x2100, 0x214F },
+  { N_("Fractions et chiffres"),   0x2150, 0x218B },
+  { N_("Flèches"),                 0x2190, 0x21FF },
+  { N_("Mathématiques"),           0x2200, 0x22FF },
+  { N_("Formes géométriques"),     0x25A0, 0x25FF },
+  { N_("Symboles divers"),         0x2600, 0x26FF },
+  { N_("Dingbats"),                0x2700, 0x27BF },
+  { N_("Grec"),                    0x0370, 0x03FF },
+  { N_("Ligatures et formes"),     0xFB00, 0xFB06 },
+};
+
+static void
+glyph_insert (GtkButton *button, Glyphs *g)
+{
+  const gchar  *str  = g_object_get_data (G_OBJECT (button), "glyph");
+  GimpTool     *tool = tool_manager_get_active (g->gimp);
+
+  if (GIMP_IS_TEXT_TOOL (tool) && GIMP_TEXT_TOOL (tool)->layer)
+    {
+      GtkTextBuffer *buffer = GTK_TEXT_BUFFER (GIMP_TEXT_TOOL (tool)->buffer);
+
+      gtk_text_buffer_begin_user_action (buffer);
+      gtk_text_buffer_delete_selection (buffer, TRUE, TRUE);
+      gimp_text_buffer_insert (GIMP_TEXT_TOOL (tool)->buffer, str);
+      gtk_text_buffer_end_user_action (buffer);
+    }
+  else
+    {
+      GimpTextLayer *layer = panel_text_layer (g->gimp);
+      GimpText      *text;
+
+      if (layer && (text = gimp_text_layer_get_text (layer)))
+        {
+          GimpTextBuffer *buffer = gimp_text_buffer_new ();
+          GtkTextIter     end;
+          gchar          *markup;
+
+          if (text->markup)
+            gimp_text_buffer_set_markup (buffer, text->markup);
+          else
+            gimp_text_buffer_set_text (buffer, text->text);
+
+          gtk_text_buffer_get_end_iter (GTK_TEXT_BUFFER (buffer), &end);
+          gtk_text_buffer_insert (GTK_TEXT_BUFFER (buffer), &end, str, -1);
+
+          markup = gimp_text_buffer_get_markup (buffer);
+          gimp_text_layer_set (layer, _("Insérer un glyphe"), "markup", markup, NULL);
+          g_free (markup);
+          g_object_unref (buffer);
+          layer_flush (layer);
+        }
+    }
+}
+
+static void
+glyphs_fill (Glyphs *g)
+{
+  gint                  r = gtk_combo_box_get_active (GTK_COMBO_BOX (g->combo));
+  PangoContext         *context;
+  PangoFontDescription *desc;
+  PangoFont            *font;
+  GList                *children, *list;
+  gunichar              c;
+
+  children = gtk_container_get_children (GTK_CONTAINER (g->flow));
+  for (list = children; list; list = list->next)
+    gtk_widget_destroy (list->data);
+  g_list_free (children);
+
+  if (r < 0)
+    return;
+
+  context = gtk_widget_get_pango_context (g->flow);
+  desc    = pango_font_description_from_string (g->font ? g->font : "Sans");
+  font    = pango_context_load_font (context, desc);
+
+  for (c = glyph_ranges[r].first; c <= glyph_ranges[r].last; c++)
+    {
+      GtkWidget *button, *label;
+      gchar      utf8[8] = { 0, };
+      gchar     *markup, *tip, *esc;
+
+      if (! g_unichar_isdefined (c) || g_unichar_iszerowidth (c) ||
+          g_unichar_type (c) == G_UNICODE_SPACE_SEPARATOR ||
+          (font && ! pango_font_has_char (font, c)))
+        continue;
+
+      g_unichar_to_utf8 (c, utf8);
+      esc    = g_markup_escape_text (utf8, -1);
+      markup = g_strdup_printf ("<span font_desc=\"%s 16\">%s</span>",
+                                g->font ? g->font : "Sans", esc);
+      tip    = g_strdup_printf ("U+%04X", c);
+
+      label  = gtk_label_new (NULL);
+      gtk_label_set_markup (GTK_LABEL (label), markup);
+      button = gtk_button_new ();
+      gtk_button_set_relief (GTK_BUTTON (button), GTK_RELIEF_NONE);
+      gtk_container_add (GTK_CONTAINER (button), label);
+      gtk_widget_set_size_request (button, 34, 34);
+      gtk_widget_set_tooltip_text (button, tip);
+      g_object_set_data_full (G_OBJECT (button), "glyph", g_strdup (utf8), g_free);
+      g_signal_connect (button, "clicked", G_CALLBACK (glyph_insert), g);
+      gtk_container_add (GTK_CONTAINER (g->flow), button);
+
+      g_free (esc);
+      g_free (markup);
+      g_free (tip);
+    }
+
+  if (font)
+    g_object_unref (font);
+  pango_font_description_free (desc);
+
+  gtk_widget_show_all (g->flow);
+}
+
+static gboolean
+glyphs_refresh (Glyphs *g)
+{
+  GimpTool      *tool  = tool_manager_get_active (g->gimp);
+  GimpTextLayer *layer = (GIMP_IS_TEXT_TOOL (tool) && GIMP_TEXT_TOOL (tool)->layer) ?
+                         GIMP_TEXT_TOOL (tool)->layer : panel_text_layer (g->gimp);
+  const gchar   *font  = NULL;
+  GimpText      *text;
+
+  if (layer && (text = gimp_text_layer_get_text (layer)) && text->font)
+    font = gimp_font_get_lookup_name (text->font);
+
+  if (font && g_strcmp0 (font, g->font))
+    {
+      g_free (g->font);
+      g->font = g_strdup (font);
+      glyphs_fill (g);
+    }
+
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+glyphs_free (Glyphs *g)
+{
+  if (g->refresh_id)
+    g_source_remove (g->refresh_id);
+  g_free (g->font);
+  g_free (g);
+}
+
+GtkWidget *
+chopgimp_glyphs_panel_new (GimpDialogFactory *factory,
+                           GimpContext       *context,
+                           GimpUIManager     *ui_manager,
+                           gint               view_size)
+{
+  Glyphs    *g      = g_new0 (Glyphs, 1);
+  GtkWidget *editor = g_object_new (GIMP_TYPE_EDITOR, NULL);
+  GtkWidget *box    = gtk_box_new (GTK_ORIENTATION_VERTICAL, 4);
+  GtkWidget *scroll = gtk_scrolled_window_new (NULL, NULL);
+
+  g->gimp  = context->gimp;
+  g->combo = gtk_combo_box_text_new ();
+
+  for (guint i = 0; i < G_N_ELEMENTS (glyph_ranges); i++)
+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (g->combo), _(glyph_ranges[i].name));
+  gtk_combo_box_set_active (GTK_COMBO_BOX (g->combo), 0);
+  g_signal_connect_swapped (g->combo, "changed", G_CALLBACK (glyphs_fill), g);
+
+  g->flow = gtk_flow_box_new ();
+  gtk_flow_box_set_selection_mode (GTK_FLOW_BOX (g->flow), GTK_SELECTION_NONE);
+  gtk_flow_box_set_max_children_per_line (GTK_FLOW_BOX (g->flow), 30);
+  gtk_flow_box_set_homogeneous (GTK_FLOW_BOX (g->flow), TRUE);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scroll),
+                                  GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_container_add (GTK_CONTAINER (scroll), g->flow);
+
+  gtk_container_set_border_width (GTK_CONTAINER (box), 4);
+  gtk_box_pack_start (GTK_BOX (box), g->combo, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (box), scroll, TRUE, TRUE, 0);
+  gtk_box_pack_start (GTK_BOX (editor), box, TRUE, TRUE, 0);
+  gtk_widget_show_all (box);
+
+  glyphs_fill (g);
+
+  g->refresh_id = g_timeout_add (600, (GSourceFunc) glyphs_refresh, g);
+  g_object_set_data_full (G_OBJECT (editor), "chopgimp-glyphs", g,
+                          (GDestroyNotify) glyphs_free);
+
+  return editor;
+}
+
+
+/* ─── Styles de texte ──────────────────────────────────────────────── */
+
+typedef struct
+{
+  Gimp      *gimp;
+  GtkWidget *list;
+  GtkWidget *name;
+  Panel     *panel;        /* for the target helpers */
+} Styles;
+
+static const gchar *style_attrs[] = { "text_transform", "variant", "font_features",
+                                      "baseline_shift", "font_scale", NULL };
+
+static gchar *
+styles_path (void)
+{
+  return g_build_filename (gimp_directory (), "chopgimp-text-styles", NULL);
+}
+
+static GKeyFile *
+styles_load (void)
+{
+  GKeyFile *kf   = g_key_file_new ();
+  gchar    *path = styles_path ();
+
+  g_key_file_load_from_file (kf, path, G_KEY_FILE_NONE, NULL);
+  g_free (path);
+
+  return kf;
+}
+
+static void
+styles_save (GKeyFile *kf)
+{
+  gchar *path = styles_path ();
+
+  g_key_file_save_to_file (kf, path, NULL);
+  g_free (path);
+}
+
+static void
+styles_fill (Styles *st)
+{
+  GKeyFile *kf     = styles_load ();
+  gchar   **groups = g_key_file_get_groups (kf, NULL);
+  GList    *children, *list;
+  gint      i;
+
+  children = gtk_container_get_children (GTK_CONTAINER (st->list));
+  for (list = children; list; list = list->next)
+    gtk_widget_destroy (list->data);
+  g_list_free (children);
+
+  for (i = 0; groups[i]; i++)
+    {
+      gchar     *font  = g_key_file_get_string (kf, groups[i], "font", NULL);
+      gchar     *color = g_key_file_get_string (kf, groups[i], "color", NULL);
+      GimpFont  *f     = font ? font_by_name (st->gimp, font) : NULL;
+      GtkWidget *label = gtk_label_new (NULL);
+      gchar     *markup;
+
+      markup = g_markup_printf_escaped ("<span font_desc=\"%s 13\" foreground=\"%s\">%s</span>"
+                                        "  <small>%s</small>",
+                                        f ? gimp_font_get_lookup_name (f) : "Sans",
+                                        color ? color : "#000000",
+                                        groups[i], font ? font : "");
+      gtk_label_set_markup (GTK_LABEL (label), markup);
+      gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+      g_object_set_data_full (G_OBJECT (label), "style", g_strdup (groups[i]), g_free);
+      gtk_container_add (GTK_CONTAINER (st->list), label);
+
+      g_free (markup);
+      g_free (font);
+      g_free (color);
+    }
+
+  gtk_widget_show_all (st->list);
+  g_strfreev (groups);
+  g_key_file_unref (kf);
+}
+
+static const gchar *
+styles_selected (Styles *st)
+{
+  GtkListBoxRow *row = gtk_list_box_get_selected_row (GTK_LIST_BOX (st->list));
+
+  if (! row)
+    return NULL;
+
+  return g_object_get_data (G_OBJECT (gtk_bin_get_child (GTK_BIN (row))), "style");
+}
+
+/*  the style of the selection (or of the layer)  */
+static void
+styles_capture (Styles *st, const gchar *name)
+{
+  Target    t;
+  GKeyFile *kf;
+  GimpText *text;
+  gdouble   xres, yres;
+  guchar    rgb[3];
+  gchar    *hex;
+  gint      i;
+
+  if (! name || ! *name || ! target_begin (st->panel, &t))
+    return;
+
+  text = gimp_text_layer_get_text (t.layer);
+  gimp_image_get_resolution (gimp_item_get_image (GIMP_ITEM (t.layer)), &xres, &yres);
+
+  kf = styles_load ();
+  g_key_file_remove_group (kf, name, NULL);
+
+  g_key_file_set_string (kf, name, "font", gimp_object_get_name (text->font));
+  g_key_file_set_double (kf, name, "size",
+                         gimp_units_to_pixels (text->font_size, text->unit, yres));
+  gegl_color_get_pixel (text->color, babl_format ("R'G'B' u8"), rgb);
+  hex = g_strdup_printf ("#%02x%02x%02x", rgb[0], rgb[1], rgb[2]);
+  g_key_file_set_string (kf, name, "color", hex);
+  g_free (hex);
+  g_key_file_set_double  (kf, name, "tracking", text->letter_spacing);
+  g_key_file_set_double  (kf, name, "leading",  text->line_spacing);
+  g_key_file_set_integer (kf, name, "justify",  text->justify);
+
+  for (i = 0; style_attrs[i]; i++)
+    {
+      const gchar *v = gimp_text_buffer_get_iter_attr (t.buffer, &t.start, style_attrs[i]);
+
+      if (v)
+        g_key_file_set_string (kf, name, style_attrs[i], v);
+    }
+
+  styles_save (kf);
+  g_key_file_unref (kf);
+
+  if (t.temporary)
+    g_object_unref (t.buffer);
+
+  styles_fill (st);
+}
+
+static void
+styles_apply (Styles *st, const gchar *name)
+{
+  GKeyFile     *kf;
+  GimpTextTool *tool = panel_text_tool (st->gimp);
+  gboolean      selection;
+  Target        t;
+  gchar        *font, *color;
+  gdouble       size, xres, yres;
+  GimpImage    *image;
+  GeglColor    *gcolor = NULL;
+  gint          i;
+
+  if (! name)
+    return;
+
+  kf = styles_load ();
+  if (! g_key_file_has_group (kf, name))
+    {
+      g_key_file_unref (kf);
+      return;
+    }
+
+  selection = tool && gtk_text_buffer_get_has_selection (GTK_TEXT_BUFFER (tool->buffer));
+
+  if (! target_begin (st->panel, &t))
+    {
+      g_key_file_unref (kf);
+      return;
+    }
+
+  image = gimp_item_get_image (GIMP_ITEM (t.layer));
+  gimp_image_get_resolution (image, &xres, &yres);
+
+  font  = g_key_file_get_string (kf, name, "font", NULL);
+  color = g_key_file_get_string (kf, name, "color", NULL);
+  size  = g_key_file_get_double (kf, name, "size", NULL);
+
+  if (color)
+    {
+      gcolor = gegl_color_new (NULL);
+      gegl_color_set_rgba (gcolor, 0, 0, 0, 1);
+      {
+        guint r = 0, g = 0, b = 0;
+
+        if (sscanf (color, "#%02x%02x%02x", &r, &g, &b) == 3)
+          {
+            guchar rgb[3] = { r, g, b };
+
+            gegl_color_set_pixel (gcolor, babl_format ("R'G'B' u8"), rgb);
+          }
+      }
+    }
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_TEXT, _("Style de texte"));
+
+  if (selection)
+    {
+      /*  character style on the selected characters  */
+      if (font)
+        gimp_text_buffer_set_font (t.buffer, &t.start, &t.end, font);
+      if (size > 0)
+        gimp_text_buffer_set_size (t.buffer, &t.start, &t.end,
+                                   PANGO_SCALE * gimp_units_to_points (size, gimp_unit_pixel (), yres));
+      if (gcolor)
+        gimp_text_buffer_set_color (t.buffer, &t.start, &t.end, gcolor);
+    }
+  else
+    {
+      GimpFont *f = font ? font_by_name (st->gimp, font) : NULL;
+
+      if (t.temporary)
+        {
+          g_object_unref (t.buffer);
+          t.temporary = FALSE;
+        }
+
+      /*  paragraph style on the whole layer  */
+      if (f)
+        gimp_text_layer_set (t.layer, NULL, "font", f, NULL);
+      if (size > 0)
+        gimp_text_layer_set (t.layer, NULL, "font-size", size, "unit", gimp_unit_pixel (), NULL);
+      if (gcolor)
+        gimp_text_layer_set (t.layer, NULL, "color", gcolor, NULL);
+      gimp_text_layer_set (t.layer, NULL,
+                           "letter-spacing", g_key_file_get_double (kf, name, "tracking", NULL),
+                           "line-spacing",   g_key_file_get_double (kf, name, "leading", NULL),
+                           "justify",        g_key_file_get_integer (kf, name, "justify", NULL),
+                           NULL);
+
+      /*  … and the character attributes on all of it  */
+      target_begin (st->panel, &t);
+      gtk_text_buffer_get_bounds (GTK_TEXT_BUFFER (t.buffer), &t.start, &t.end);
+    }
+
+  for (i = 0; style_attrs[i]; i++)
+    {
+      gchar *v = g_key_file_get_string (kf, name, style_attrs[i], NULL);
+
+      gimp_text_buffer_set_attr (t.buffer, &t.start, &t.end, style_attrs[i], v);
+      g_free (v);
+    }
+
+  target_end (&t, NULL);
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+
+  g_clear_object (&gcolor);
+  g_free (font);
+  g_free (color);
+  g_key_file_unref (kf);
+}
+
+static void
+styles_new_clicked (GtkButton *button, Styles *st)
+{
+  const gchar *name = gtk_entry_get_text (GTK_ENTRY (st->name));
+
+  if (name && *name)
+    {
+      styles_capture (st, name);
+      gtk_entry_set_text (GTK_ENTRY (st->name), "");
+    }
+}
+
+static void
+styles_redefine_clicked (GtkButton *button, Styles *st)
+{
+  styles_capture (st, styles_selected (st));
+}
+
+static void
+styles_apply_clicked (GtkButton *button, Styles *st)
+{
+  styles_apply (st, styles_selected (st));
+}
+
+static void
+styles_row_activated (GtkListBox *box, GtkListBoxRow *row, Styles *st)
+{
+  styles_apply (st, styles_selected (st));
+}
+
+static void
+styles_delete_clicked (GtkButton *button, Styles *st)
+{
+  const gchar *name = styles_selected (st);
+
+  if (name)
+    {
+      GKeyFile *kf = styles_load ();
+
+      g_key_file_remove_group (kf, name, NULL);
+      styles_save (kf);
+      g_key_file_unref (kf);
+      styles_fill (st);
+    }
+}
+
+static void
+styles_free (Styles *st)
+{
+  panel_free (st->panel);
+  g_free (st);
+}
+
+GtkWidget *
+chopgimp_text_styles_panel_new (GimpDialogFactory *factory,
+                                GimpContext       *context,
+                                GimpUIManager     *ui_manager,
+                                gint               view_size)
+{
+  Styles    *st     = g_new0 (Styles, 1);
+  GtkWidget *editor = g_object_new (GIMP_TYPE_EDITOR, NULL);
+  GtkWidget *box    = gtk_box_new (GTK_ORIENTATION_VERTICAL, 4);
+  GtkWidget *scroll = gtk_scrolled_window_new (NULL, NULL);
+  GtkWidget *row    = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 2);
+  GtkWidget *add;
+  static const struct { const gchar *icon; const gchar *tip; GCallback cb; } buttons[] =
+  {
+    { "object-select-symbolic",  N_("Appliquer le style (ou double-clic) : à la sélection en cours "
+                                    "d'édition, sinon à tout le calque"), G_CALLBACK (styles_apply_clicked) },
+    { "view-refresh-symbolic",   N_("Redéfinir le style d'après le texte sélectionné"),
+                                 G_CALLBACK (styles_redefine_clicked) },
+    { "edit-delete-symbolic",    N_("Supprimer le style"), G_CALLBACK (styles_delete_clicked) },
+  };
+
+  st->gimp        = context->gimp;
+  st->panel       = g_new0 (Panel, 1);
+  st->panel->gimp = context->gimp;
+
+  st->list = gtk_list_box_new ();
+  gtk_list_box_set_activate_on_single_click (GTK_LIST_BOX (st->list), FALSE);
+  g_signal_connect (st->list, "row-activated", G_CALLBACK (styles_row_activated), st);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scroll),
+                                  GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_container_add (GTK_CONTAINER (scroll), st->list);
+
+  st->name = gtk_entry_new ();
+  gtk_entry_set_placeholder_text (GTK_ENTRY (st->name), _("Nom du nouveau style"));
+  g_signal_connect_swapped (st->name, "activate", G_CALLBACK (styles_new_clicked), st);
+  add = gtk_button_new_from_icon_name ("list-add-symbolic", GTK_ICON_SIZE_BUTTON);
+  gtk_widget_set_tooltip_text (add, _("Créer un style d'après le texte sélectionné"));
+  g_signal_connect (add, "clicked", G_CALLBACK (styles_new_clicked), st);
+  gtk_box_pack_start (GTK_BOX (row), st->name, TRUE, TRUE, 0);
+  gtk_box_pack_start (GTK_BOX (row), add, FALSE, FALSE, 0);
+
+  gtk_container_set_border_width (GTK_CONTAINER (box), 4);
+  gtk_box_pack_start (GTK_BOX (box), row, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (box), scroll, TRUE, TRUE, 0);
+
+  for (guint i = 0; i < G_N_ELEMENTS (buttons); i++)
+    {
+      GtkWidget *b = gimp_editor_add_button (GIMP_EDITOR (editor), buttons[i].icon,
+                                             _(buttons[i].tip), NULL,
+                                             NULL, NULL, NULL);
+      g_signal_connect (b, "clicked", buttons[i].cb, st);
+    }
+
+  gtk_box_pack_start (GTK_BOX (editor), box, TRUE, TRUE, 0);
+  gtk_widget_show_all (box);
+
+  styles_fill (st);
+
+  g_object_set_data_full (G_OBJECT (editor), "chopgimp-styles", st,
+                          (GDestroyNotify) styles_free);
+
+  return editor;
+}
