+static GimpFont *
+font_by_name (Gimp *gimp, const gchar *name)
+{
+  return GIMP_FONT (gimp_container_get_child_by_name (gimp_data_factory_get_container (gimp->font_factory),
+                                                      name));
+}
+
 static void
-font_activate (GtkEntry *entry, Panel *panel)
+font_list_add (const gchar *key, const gchar *name, gboolean front, gint max)
+{
+  gchar    **old  = chopgimp_rc_get_strings ("fonts", key);
+  GPtrArray *list = g_ptr_array_new ();
+  gint       i;
+
+  if (front)
+    g_ptr_array_add (list, (gpointer) name);
+
+  for (i = 0; old[i] && (gint) list->len < max; i++)
+    if (strcmp (old[i], name))
+      g_ptr_array_add (list, old[i]);
+
+  if (! front)
+    g_ptr_array_add (list, (gpointer) name);
+
+  g_ptr_array_add (list, NULL);
+  chopgimp_rc_set_strings ("fonts", key, (const gchar * const *) list->pdata);
+
+  g_ptr_array_free (list, TRUE);
+  g_strfreev (old);
+}
+
+static void
+font_list_remove (const gchar *key, const gchar *name)
+{
+  gchar    **old  = chopgimp_rc_get_strings ("fonts", key);
+  GPtrArray *list = g_ptr_array_new ();
+  gint       i;
+
+  for (i = 0; old[i]; i++)
+    if (strcmp (old[i], name))
+      g_ptr_array_add (list, old[i]);
+
+  g_ptr_array_add (list, NULL);
+  chopgimp_rc_set_strings ("fonts", key, (const gchar * const *) list->pdata);
+
+  g_ptr_array_free (list, TRUE);
+  g_strfreev (old);
+}
+
+static gboolean
+font_is_favorite (const gchar *name)
+{
+  gchar  **favs = chopgimp_rc_get_strings ("fonts", "favorites");
+  gboolean fav  = name && g_strv_contains ((const gchar * const *) favs, name);
+
+  g_strfreev (favs);
+
+  return fav;
+}
+
+static void
+font_apply (Panel *panel, const gchar *name)
 {
   Target t;
 
-  if (panel->updating || ! target_begin (panel, &t))
+  if (! name || ! *name || ! target_begin (panel, &t))
     return;
 
-  gimp_text_buffer_set_font (t.buffer, &t.start, &t.end, gtk_entry_get_text (entry));
+  gimp_text_buffer_set_font (t.buffer, &t.start, &t.end, name);
   target_end (&t, _("Police"));
+
+  font_list_add ("recent", name, TRUE, 8);
+}
+
+static void
+font_activate (GtkEntry *entry, Panel *panel)
+{
+  if (! panel->updating)
+    font_apply (panel, gtk_entry_get_text (entry));
+}
+
+static void
+favorite_update (Panel *panel)
+{
+  if (panel->favorite)
+    gtk_button_set_label (GTK_BUTTON (panel->favorite),
+                          font_is_favorite (gtk_entry_get_text (GTK_ENTRY (panel->font))) ?
+                          "★" : "☆");
+}
+
+static void
+favorite_clicked (GtkButton *button, Panel *panel)
+{
+  const gchar *name = gtk_entry_get_text (GTK_ENTRY (panel->font));
+
+  if (! name || ! *name)
+    return;
+
+  if (font_is_favorite (name))
+    font_list_remove ("favorites", name);
+  else
+    font_list_add ("favorites", name, FALSE, 200);
+
+  favorite_update (panel);
+}
+
+/*  hover preview: the whole layer shows the font, without undo  */
+static gboolean
+font_preview_possible (Panel *panel)
+{
+  GimpTextTool *tool = panel_text_tool (panel->gimp);
+
+  return ! (tool && gtk_text_buffer_get_has_selection (GTK_TEXT_BUFFER (tool->buffer))) &&
+         panel_layer (panel) != NULL;
+}
+
+static void
+font_item_select (GtkMenuItem *item, Panel *panel)
+{
+  GimpTextLayer *layer = panel_layer (panel);
+  GimpFont      *font  = font_by_name (panel->gimp,
+                                       g_object_get_data (G_OBJECT (item), "font"));
+
+  if (! font || ! font_preview_possible (panel))
+    return;
+
+  if (! panel->preview_font)
+    panel->preview_font = g_object_ref (gimp_text_layer_get_text (layer)->font);
+
+  g_object_set (gimp_text_layer_get_text (layer), "font", font, NULL);
+  layer_flush (layer);
+}
+
+static void
+font_preview_restore (Panel *panel)
+{
+  GimpTextLayer *layer = panel_layer (panel);
+
+  if (panel->preview_font)
+    {
+      if (layer)
+        {
+          g_object_set (gimp_text_layer_get_text (layer), "font", panel->preview_font, NULL);
+          layer_flush (layer);
+        }
+      g_clear_object (&panel->preview_font);
+    }
+}
+
+static void
+font_item_activate (GtkMenuItem *item, Panel *panel)
+{
+  const gchar *name = g_object_get_data (G_OBJECT (item), "font");
+
+  panel->preview_chosen = TRUE;
+  font_preview_restore (panel);
+
+  panel->updating = TRUE;
+  gtk_entry_set_text (GTK_ENTRY (panel->font), name);
+  panel->updating = FALSE;
+
+  font_apply (panel, name);
+  favorite_update (panel);
+}
+
+static void
+font_menu_deactivate (GtkMenuShell *menu, Panel *panel)
+{
+  if (! panel->preview_chosen)
+    font_preview_restore (panel);
+}
+
+static void
+font_menu_add_section (Panel *panel, GtkWidget *menu, const gchar *title, const gchar *key)
+{
+  gchar    **names = chopgimp_rc_get_strings ("fonts", key);
+  GtkWidget *item;
+  gint       i;
+
+  item = gtk_menu_item_new_with_label (title);
+  gtk_widget_set_sensitive (item, FALSE);
+  gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+
+  for (i = 0; names[i]; i++)
+    {
+      GimpFont *font = font_by_name (panel->gimp, names[i]);
+      gchar    *markup;
+
+      if (! font)
+        continue;
+
+      markup = g_markup_printf_escaped ("<span font_desc=\"%s 12\">%s</span>",
+                                        gimp_font_get_lookup_name (font), names[i]);
+      item = gtk_menu_item_new_with_label ("");
+      gtk_label_set_markup (GTK_LABEL (gtk_bin_get_child (GTK_BIN (item))), markup);
+      g_free (markup);
+
+      g_object_set_data_full (G_OBJECT (item), "font", g_strdup (names[i]), g_free);
+      g_signal_connect (item, "select",   G_CALLBACK (font_item_select),   panel);
+      g_signal_connect (item, "activate", G_CALLBACK (font_item_activate), panel);
+      gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+    }
+
+  if (! names[0])
+    {
+      item = gtk_menu_item_new_with_label (_("   (vide)"));
+      gtk_widget_set_sensitive (item, FALSE);
+      gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+    }
+
+  g_strfreev (names);
+}
+
+static gboolean
+font_menu_destroy (gpointer menu)
+{
+  gtk_widget_destroy (menu);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+font_menu_hidden (GtkWidget *menu, Panel *panel)
+{
+  g_idle_add (font_menu_destroy, menu);
+}
+
+static void
+font_menu_clicked (GtkButton *button, Panel *panel)
+{
+  GtkWidget *menu = gtk_menu_new ();
+
+  panel->preview_chosen = FALSE;
+
+  font_menu_add_section (panel, menu, _("★ Favoris"), "favorites");
+  gtk_menu_shell_append (GTK_MENU_SHELL (menu), gtk_separator_menu_item_new ());
+  font_menu_add_section (panel, menu, _("Récentes"), "recent");
+
+  g_signal_connect (menu, "deactivate", G_CALLBACK (font_menu_deactivate), panel);
+  g_signal_connect (menu, "hide", G_CALLBACK (font_menu_hidden), panel);
+  gtk_widget_show_all (menu);
+  gtk_menu_popup_at_widget (GTK_MENU (menu), GTK_WIDGET (button),
+                            GDK_GRAVITY_SOUTH_WEST, GDK_GRAVITY_NORTH_WEST, NULL);
 }
 
