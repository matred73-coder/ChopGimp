@@ -70,6 +72,7 @@ file_save (Gimp                *gimp,
   GimpPDBStatusType  status     = GIMP_PDB_EXECUTION_ERROR;
   GFile             *local_file = NULL;
   gboolean           mounted    = TRUE;
+  GList             *hidden_sketches = NULL;   /*  ChopGimp  */
   GError            *my_error   = NULL;
