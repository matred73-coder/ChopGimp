diff --git a/app/dialogs/chopgimp-trace-dialog.c b/app/dialogs/chopgimp-trace-dialog.c
new file mode 100644
index 0000000..7db8d7a
--- /dev/null
+++ b/app/dialogs/chopgimp-trace-dialog.c
@@ -0,0 +1,1243 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-trace-dialog.c — ChopGimp 3.27.3 (lot V5, lot V6 point 4):
+ * « Vectoriser… », Illustrator's Image Trace panel
+ *
+ *  - presets, view (result / outlines / outlines + source), mode, palette,
+ *    colors or threshold; « Avancé »: paths, corners, noise, blur, method,
+ *    fills / strokes, snap curves to lines, ignore white / transparency,
+ *    engine, groups by color;
+ *  - live preview on the canvas: the trace runs in a thread (GTask) a
+ *    moment after the last change, the previous run is cancelled; a
+ *    progress bar and « Arrêter » for long runs;
+ *  - « Vectoriser »: a new vector layer (core/chopgimp-trace-layer.c),
+ *    kept as a live trace (« Vectorisation dynamique ») unless unchecked;
+ *    on a live trace layer: re-traced in place, or « Décomposer ».
+ *
+ * Non-modal: the canvas can be zoomed and scrolled to inspect the preview.
+ * The dialog closes when its layer goes away.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpcolor/gimpcolor.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "dialogs-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpchannel.h"
+#include "core/gimpcontext.h"
+#include "core/gimpdrawable.h"
+#include "core/gimpimage.h"
+#include "core/gimplayer.h"
+#include "core/gimppalette.h"
+#include "core/chopgimp-trace-layer.h"
+
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-trace.h"
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vcolors.h"
+
+#include "display/gimpdisplay.h"
+#include "display/gimpdisplayshell.h"
+#include "display/gimpdisplayshell-items.h"
+#include "display/chopgimp-canvastrace.h"
+
+#include "widgets/gimphelp-ids.h"
+
+#include "chopgimp-trace-dialog.h"
+
+#include "gimp-intl.h"
+
+
+#define RESPONSE_EXPAND 1
+#define TRACE_DELAY     250   /* ms after the last change */
+
+enum
+{
+  PALETTE_AUTO,
+  PALETTE_LIMITED,
+  PALETTE_GLOBALS,
+  PALETTE_SWATCHES
+};
+
+typedef struct
+{
+  GimpImage            *image;
+  GimpContext          *context;
+  GimpDrawable         *drawable;     /* the traced layer, or the live trace */
+  GimpVectorLayer      *live;         /* editing this live trace, or NULL    */
+  GimpDisplay          *display;      /* weak                                */
+  GimpCanvasItem       *item;
+
+  ChopGimpTraceSource  *source;
+  ChopGimpTraceOptions  options;
+  gboolean              flat;
+
+  ChopGimpTraceResult  *result;       /* of the current options, or older    */
+  gboolean              stale;        /* @result is not of the options       */
+  GCancellable         *cancellable;  /* of the running trace                */
+  gboolean              running;
+  gboolean              commit;       /* apply when the trace is done        */
+  gdouble               fraction;     /* written by the thread               */
+  gint64                started;
+  guint                 timeout_id;
+  guint                 progress_id;
+  gboolean              updating;
+  gboolean              closed;
+
+  GtkWidget            *dialog;
+  GtkWidget            *preset;
+  GtkWidget            *view;
+  GtkWidget            *mode;
+  GtkWidget            *palette;
+  GtkWidget            *colors;       /* spin scales                         */
+  GtkWidget            *fidelity;
+  GtkWidget            *threshold;
+  GtkWidget            *paths;
+  GtkWidget            *corners;
+  GtkWidget            *noise;
+  GtkWidget            *blur;
+  GtkWidget            *method;
+  GtkWidget            *fills;
+  GtkWidget            *strokes;
+  GtkWidget            *stroke_width;
+  GtkWidget            *stroke_length;
+  GtkWidget            *snap_lines;
+  GtkWidget            *ignore_white;
+  GtkWidget            *ignore_transparent;
+  GtkWidget            *invert;
+  GtkWidget            *engine;
+  GtkWidget            *grouped;
+  GtkWidget            *selection_only;
+  GtkWidget            *hide_original;
+  GtkWidget            *live_toggle;
+  GtkWidget            *preview;
+  GtkWidget            *stats;
+  GtkWidget            *progress;
+  GtkWidget            *stop;
+  GtkWidget            *warning;
+
+  GtkAdjustment        *colors_adj;
+  GtkAdjustment        *fidelity_adj;
+  GtkAdjustment        *threshold_adj;
+  GtkAdjustment        *paths_adj;
+  GtkAdjustment        *corners_adj;
+  GtkAdjustment        *noise_adj;
+  GtkAdjustment        *blur_adj;
+  GtkAdjustment        *stroke_width_adj;
+  GtkAdjustment        *stroke_length_adj;
+} Dialog;
+
+
+static void   schedule_trace (Dialog *d);
+static void   start_trace    (Dialog *d);
+static void   do_commit      (Dialog *d);
+
+
+/*  ─── helpers ───────────────────────────────────────────────────────── */
+
+static GtkWidget *
+combo_new (const gchar * const *labels)
+{
+  GtkWidget *combo = gtk_combo_box_text_new ();
+
+  for (gint i = 0; labels[i]; i++)
+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (combo), _(labels[i]));
+
+  return combo;
+}
+
+static void   option_changed (Dialog *d);
+
+static void
+adj_changed (GtkAdjustment *adj,
+             Dialog        *d)
+{
+  option_changed (d);
+}
+
+static GtkWidget *
+scale_new (Dialog         *d,
+           GtkAdjustment **adj,
+           const gchar    *label,
+           gdouble         lower,
+           gdouble         upper,
+           gdouble         step,
+           gint            digits,
+           const gchar    *suffix,
+           const gchar    *tip)
+{
+  GtkWidget *scale;
+
+  *adj  = gtk_adjustment_new (lower, lower, upper, step, step * 10, 0);
+  scale = gimp_spin_scale_new (*adj, label, digits);
+
+  if (suffix &&
+      g_object_class_find_property (G_OBJECT_GET_CLASS (scale), "unit-suffix"))
+    g_object_set (scale, "unit-suffix", suffix, NULL);
+
+  if (tip)
+    gimp_help_set_help_data (scale, tip, NULL);
+
+  g_signal_connect (*adj, "value-changed", G_CALLBACK (adj_changed), d);
+
+  return scale;
+}
+
+static void
+toggle_changed (GtkToggleButton *button,
+                Dialog          *d)
+{
+  option_changed (d);
+}
+
+static GtkWidget *
+check_new (Dialog      *d,
+           const gchar *label,
+           const gchar *tip)
+{
+  GtkWidget *check = gtk_check_button_new_with_mnemonic (label);
+
+  if (tip)
+    gimp_help_set_help_data (check, tip, NULL);
+
+  g_signal_connect (check, "toggled", G_CALLBACK (toggle_changed), d);
+
+  return check;
+}
+
+static void
+grid_row (GtkWidget   *grid,
+          gint         row,
+          const gchar *label,
+          GtkWidget   *widget)
+{
+  if (label)
+    {
+      GtkWidget *l = gtk_label_new_with_mnemonic (label);
+
+      gtk_label_set_xalign (GTK_LABEL (l), 0.0);
+      gtk_label_set_mnemonic_widget (GTK_LABEL (l), widget);
+      gtk_grid_attach (GTK_GRID (grid), l, 0, row, 1, 1);
+      gtk_grid_attach (GTK_GRID (grid), widget, 1, row, 1, 1);
+    }
+  else
+    {
+      gtk_grid_attach (GTK_GRID (grid), widget, 0, row, 2, 1);
+    }
+
+  gtk_widget_set_hexpand (widget, TRUE);
+}
+
+static GimpDisplayShell *
+dialog_shell (Dialog *d)
+{
+  return d->display ? gimp_display_get_shell (d->display) : NULL;
+}
+
+
+/*  ─── options ↔ widgets ─────────────────────────────────────────────── */
+
+static void
+custom_colors_clear (Dialog *d)
+{
+  for (gint i = 0; i < d->options.n_custom; i++)
+    g_clear_object (&d->options.custom[i]);
+
+  g_clear_pointer (&d->options.custom, g_free);
+  d->options.n_custom = 0;
+}
+
+/*  CUSTOM palettes: the global colors of the image, or the swatches of
+ *  the active palette
+ */
+static void
+custom_colors_load (Dialog *d,
+                    gint    which)
+{
+  GPtrArray *colors = g_ptr_array_new ();
+
+  custom_colors_clear (d);
+
+  if (which == PALETTE_GLOBALS)
+    {
+      GList *list = chopgimp_vcolors_list (d->image);
+
+      for (GList *l = list; l; l = l->next)
+        {
+          const ChopGimpVColor *c = l->data;
+
+          g_ptr_array_add (colors, gegl_color_duplicate (c->color));
+        }
+
+      g_list_free (list);
+    }
+  else
+    {
+      GimpPalette *palette = gimp_context_get_palette (d->context);
+
+      if (palette)
+        for (GList *l = gimp_palette_get_colors (palette); l; l = l->next)
+          {
+            GimpPaletteEntry *e = l->data;
+
+            g_ptr_array_add (colors, gegl_color_duplicate (e->color));
+          }
+    }
+
+  d->options.n_custom = colors->len;
+  d->options.custom   = (GeglColor **) g_ptr_array_free (colors, FALSE);
+}
+
+static void
+update_sensitivity (Dialog *d)
+{
+  gboolean potrace = d->options.engine == CHOPGIMP_TRACE_ENGINE_POTRACE;
+  gboolean bw      = d->options.mode == CHOPGIMP_TRACE_MODE_BW;
+  gboolean pal     = ! bw && d->options.engine != CHOPGIMP_TRACE_ENGINE_CENTERLINE;
+
+  gtk_widget_set_visible (d->colors,    pal && d->options.palette == CHOPGIMP_TRACE_PALETTE_LIMITED);
+  gtk_widget_set_visible (d->fidelity,  pal && d->options.palette == CHOPGIMP_TRACE_PALETTE_AUTO);
+  gtk_widget_set_visible (d->threshold, ! pal);
+  gtk_widget_set_sensitive (d->palette, pal);
+  gtk_widget_set_sensitive (d->mode,    d->options.engine != CHOPGIMP_TRACE_ENGINE_CENTERLINE);
+  gtk_widget_set_sensitive (d->method,  potrace && ! bw);
+  gtk_widget_set_sensitive (d->fills,   potrace);
+  gtk_widget_set_sensitive (d->strokes, potrace);
+  gtk_widget_set_sensitive (d->stroke_width,
+                            d->options.engine == CHOPGIMP_TRACE_ENGINE_CENTERLINE ||
+                            (potrace && d->options.strokes));
+  gtk_widget_set_sensitive (d->stroke_length,
+                            d->options.engine == CHOPGIMP_TRACE_ENGINE_CENTERLINE ||
+                            (potrace && d->options.strokes));
+  gtk_widget_set_sensitive (d->invert, bw || d->options.engine == CHOPGIMP_TRACE_ENGINE_CENTERLINE);
+}
+
+static void
+widgets_from_options (Dialog *d)
+{
+  ChopGimpTraceOptions *o = &d->options;
+  gint                  palette;
+
+  d->updating = TRUE;
+
+  gtk_combo_box_set_active (GTK_COMBO_BOX (d->mode),   o->mode);
+  gtk_combo_box_set_active (GTK_COMBO_BOX (d->engine), o->engine);
+  gtk_combo_box_set_active (GTK_COMBO_BOX (d->method), o->method);
+
+  switch (o->palette)
+    {
+    case CHOPGIMP_TRACE_PALETTE_AUTO:    palette = PALETTE_AUTO;    break;
+    case CHOPGIMP_TRACE_PALETTE_LIMITED: palette = PALETTE_LIMITED; break;
+    default:
+      palette = gtk_combo_box_get_active (GTK_COMBO_BOX (d->palette));
+      if (palette != PALETTE_SWATCHES)
+        palette = PALETTE_GLOBALS;
+      break;
+    }
+  gtk_combo_box_set_active (GTK_COMBO_BOX (d->palette), palette);
+
+  gtk_adjustment_set_value (d->colors_adj,        o->n_colors);
+  gtk_adjustment_set_value (d->fidelity_adj,      o->color_fidelity);
+  gtk_adjustment_set_value (d->threshold_adj,     o->threshold);
+  gtk_adjustment_set_value (d->paths_adj,         o->paths);
+  gtk_adjustment_set_value (d->corners_adj,       o->corners);
+  gtk_adjustment_set_value (d->noise_adj,         o->noise);
+  gtk_adjustment_set_value (d->blur_adj,          o->blur);
+  gtk_adjustment_set_value (d->stroke_width_adj,  o->max_stroke_width);
+  gtk_adjustment_set_value (d->stroke_length_adj, o->min_stroke_length);
+
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->fills),              o->fills);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->strokes),            o->strokes);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->snap_lines),         o->snap_lines);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->ignore_white),       o->ignore_white);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->ignore_transparent), o->ignore_transparent);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->invert),             o->invert);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->grouped),            ! d->flat);
+
+  update_sensitivity (d);
+
+  d->updating = FALSE;
+}
+
+static void
+options_from_widgets (Dialog *d)
+{
+  ChopGimpTraceOptions *o = &d->options;
+  gint                  palette;
+
+  o->mode    = gtk_combo_box_get_active (GTK_COMBO_BOX (d->mode));
+  o->engine  = gtk_combo_box_get_active (GTK_COMBO_BOX (d->engine));
+  if (! chopgimp_trace_engine_available (o->engine))
+    {
+      o->engine = CHOPGIMP_TRACE_ENGINE_POTRACE;
+      gtk_combo_box_set_active (GTK_COMBO_BOX (d->engine), o->engine);
+    }
+  o->method  = gtk_combo_box_get_active (GTK_COMBO_BOX (d->method));
+  palette    = gtk_combo_box_get_active (GTK_COMBO_BOX (d->palette));
+
+  switch (palette)
+    {
+    case PALETTE_AUTO:
+      o->palette = CHOPGIMP_TRACE_PALETTE_AUTO;
+      break;
+
+    case PALETTE_LIMITED:
+      o->palette = CHOPGIMP_TRACE_PALETTE_LIMITED;
+      break;
+
+    default:
+      if (o->palette != CHOPGIMP_TRACE_PALETTE_CUSTOM ||
+          GPOINTER_TO_INT (g_object_get_data (G_OBJECT (d->palette),
+                                              "chopgimp-loaded")) != palette)
+        {
+          custom_colors_load (d, palette);
+          g_object_set_data (G_OBJECT (d->palette), "chopgimp-loaded",
+                             GINT_TO_POINTER (palette));
+        }
+      o->palette = CHOPGIMP_TRACE_PALETTE_CUSTOM;
+      break;
+    }
+
+  o->n_colors           = gtk_adjustment_get_value (d->colors_adj);
+  o->color_fidelity     = gtk_adjustment_get_value (d->fidelity_adj);
+  o->threshold          = gtk_adjustment_get_value (d->threshold_adj);
+  o->paths              = gtk_adjustment_get_value (d->paths_adj);
+  o->corners            = gtk_adjustment_get_value (d->corners_adj);
+  o->noise              = gtk_adjustment_get_value (d->noise_adj);
+  o->blur               = gtk_adjustment_get_value (d->blur_adj);
+  o->max_stroke_width   = gtk_adjustment_get_value (d->stroke_width_adj);
+  o->min_stroke_length  = gtk_adjustment_get_value (d->stroke_length_adj);
+  o->fills              = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->fills));
+  o->strokes            = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->strokes));
+  o->snap_lines         = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->snap_lines));
+  o->ignore_white       = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->ignore_white));
+  o->ignore_transparent = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->ignore_transparent));
+  o->invert             = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->invert));
+  d->flat               = ! gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->grouped));
+
+  /*  at least something to make  */
+  if (o->engine == CHOPGIMP_TRACE_ENGINE_POTRACE && ! o->fills && ! o->strokes)
+    o->fills = TRUE;
+}
+
+static void
+option_changed (Dialog *d)
+{
+  if (d->updating || d->closed)
+    return;
+
+  options_from_widgets (d);
+
+  /*  a manual change: « Personnalisé » (the first entry)  */
+  d->updating = TRUE;
+  gtk_combo_box_set_active (GTK_COMBO_BOX (d->preset), 0);
+  d->updating = FALSE;
+
+  update_sensitivity (d);
+
+  d->stale = TRUE;
+  schedule_trace (d);
+}
+
+static void
+preset_changed (GtkComboBox *combo,
+                Dialog      *d)
+{
+  const gchar * const *ids = chopgimp_trace_get_presets ();
+  gint                 i   = gtk_combo_box_get_active (combo);
+
+  if (d->updating || d->closed || i < 1)
+    return;
+
+  if (chopgimp_trace_options_set_preset (&d->options, ids[i - 1]))
+    {
+      widgets_from_options (d);
+      d->stale = TRUE;
+      schedule_trace (d);
+    }
+}
+
+
+/*  ─── the preview ───────────────────────────────────────────────────── */
+
+static void
+preview_update (Dialog *d)
+{
+  GimpDisplayShell *shell = dialog_shell (d);
+  gboolean          show  = (gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->preview)) &&
+                             d->result && ! d->closed);
+
+  if (show && shell && ! d->item)
+    {
+      d->item = chopgimp_canvas_trace_new (shell, &d->source->rect);
+      gimp_display_shell_add_item (shell, d->item);
+    }
+  else if (! show && d->item)
+    {
+      if (shell)
+        gimp_display_shell_remove_item (shell, d->item);
+
+      g_clear_object (&d->item);
+    }
+
+  if (d->item)
+    chopgimp_canvas_trace_set_result (CHOPGIMP_CANVAS_TRACE (d->item), d->result,
+                                      gtk_combo_box_get_active (GTK_COMBO_BOX (d->view)));
+}
+
+static void
+stats_update (Dialog *d)
+{
+  gchar *text;
+
+  if (! d->result)
+    text = g_strdup (d->running ? _("Vectorisation…") : "");
+  else
+    text = g_strdup_printf (_("%d chemins · %d couleurs · %d points d'ancrage"),
+                            d->result->n_paths, d->result->n_colors,
+                            d->result->n_anchors);
+
+  gtk_label_set_text (GTK_LABEL (d->stats), text);
+  g_free (text);
+}
+
+static gboolean
+progress_tick (Dialog *d)
+{
+  /*  only for runs that take some time  */
+  if (d->running && g_get_monotonic_time () - d->started > 400000)
+    {
+      gtk_widget_show (d->progress);
+      gtk_widget_show (d->stop);
+      gtk_progress_bar_set_fraction (GTK_PROGRESS_BAR (d->progress),
+                                     CLAMP (d->fraction, 0.0, 1.0));
+    }
+
+  return G_SOURCE_CONTINUE;
+}
+
+typedef struct
+{
+  Dialog        *d;
+  GeglBuffer    *buffer;
+  GeglRectangle  rect;
+  gchar         *options;
+} TraceJob;
+
+static void
+trace_job_free (TraceJob *job)
+{
+  g_object_unref (job->buffer);
+  g_free (job->options);
+  g_free (job);
+}
+
+static void
+thread_progress (gdouble  fraction,
+                 gpointer data)
+{
+  /*  a plain double, read by progress_tick(): a torn value only shows a
+   *  wrong bar for 100 ms
+   */
+  ((Dialog *) data)->fraction = fraction;
+}
+
+static void
+trace_thread (GTask        *task,
+              gpointer      source_object,
+              gpointer      task_data,
+              GCancellable *cancellable)
+{
+  TraceJob             *job    = task_data;
+  ChopGimpTraceOptions  options;
+  ChopGimpTraceResult  *result;
+  GError               *error  = NULL;
+
+  chopgimp_trace_options_init (&options);
+  chopgimp_trace_options_from_string (&options, job->options);
+
+  result = chopgimp_trace_run (job->buffer, &job->rect, NULL, &options,
+                               cancellable, thread_progress, job->d, &error);
+
+  chopgimp_trace_options_clear (&options);
+
+  if (result)
+    g_task_return_pointer (task, result, (GDestroyNotify) chopgimp_trace_result_free);
+  else if (error)
+    g_task_return_error (task, error);
+  else
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED, "trace failed");
+}
+
+static void
+trace_done (GObject      *object,
+            GAsyncResult *res,
+            gpointer      data)
+{
+  GtkWidget           *dialog = GTK_WIDGET (object);
+  Dialog              *d      = g_object_get_data (G_OBJECT (dialog), "chopgimp-trace");
+  GCancellable        *cancel = g_task_get_cancellable (G_TASK (res));
+  GError              *error  = NULL;
+  ChopGimpTraceResult *result = g_task_propagate_pointer (G_TASK (res), &error);
+
+  /*  an older run (cancelled and replaced), or the dialog went away  */
+  if (! d || d->closed || cancel != d->cancellable)
+    {
+      g_clear_pointer (&result, chopgimp_trace_result_free);
+      g_clear_error (&error);
+      return;
+    }
+
+  d->running = FALSE;
+  g_clear_object (&d->cancellable);
+  gtk_widget_hide (d->progress);
+  gtk_widget_hide (d->stop);
+
+  if (result)
+    {
+      if (d->item)
+        chopgimp_canvas_trace_set_result (CHOPGIMP_CANVAS_TRACE (d->item), NULL, 0);
+
+      g_clear_pointer (&d->result, chopgimp_trace_result_free);
+      d->result = result;
+    }
+  else if (! g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    {
+      gimp_message_literal (d->image->gimp, G_OBJECT (d->dialog),
+                            GIMP_MESSAGE_WARNING,
+                            error ? error->message : _("La vectorisation a échoué."));
+      d->commit = FALSE;
+    }
+
+  g_clear_error (&error);
+
+  gtk_dialog_set_response_sensitive (GTK_DIALOG (d->dialog), GTK_RESPONSE_OK, TRUE);
+  preview_update (d);
+  stats_update (d);
+
+  /*  options changed meanwhile  */
+  if (d->stale && ! d->timeout_id)
+    {
+      start_trace (d);
+      return;
+    }
+
+  if (d->commit)
+    do_commit (d);
+}
+
+static void
+start_trace (Dialog *d)
+{
+  TraceJob *job;
+  GTask    *task;
+
+  if (d->closed)
+    return;
+
+  if (d->cancellable)
+    g_cancellable_cancel (d->cancellable);
+  g_clear_object (&d->cancellable);
+
+  job          = g_new0 (TraceJob, 1);
+  job->d       = d;
+  job->buffer  = g_object_ref (d->source->buffer);
+  job->rect    = d->source->rect;
+  job->options = chopgimp_trace_options_to_string (&d->options);
+
+  d->cancellable = g_cancellable_new ();
+  d->running     = TRUE;
+  d->stale       = FALSE;
+  d->fraction    = 0.0;
+  d->started     = g_get_monotonic_time ();
+
+  /*  the task keeps the dialog widget (and so @d) alive  */
+  task = g_task_new (d->dialog, d->cancellable, trace_done, NULL);
+  g_task_set_task_data (task, job, (GDestroyNotify) trace_job_free);
+  g_task_run_in_thread (task, trace_thread);
+  g_object_unref (task);
+
+  stats_update (d);
+}
+
+static gboolean
+trace_timeout (Dialog *d)
+{
+  d->timeout_id = 0;
+
+  /*  a run is going on: start again when it is done (trace_done)  */
+  if (d->running && d->cancellable)
+    g_cancellable_cancel (d->cancellable);
+
+  start_trace (d);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+schedule_trace (Dialog *d)
+{
+  if (d->closed)
+    return;
+
+  if (! gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->preview)) && ! d->commit)
+    return;
+
+  if (d->timeout_id)
+    g_source_remove (d->timeout_id);
+
+  d->timeout_id = g_timeout_add (TRACE_DELAY, (GSourceFunc) trace_timeout, d);
+}
+
+static void
+stop_clicked (GtkButton *button,
+              Dialog    *d)
+{
+  if (d->cancellable)
+    g_cancellable_cancel (d->cancellable);
+
+  d->commit = FALSE;
+}
+
+static void
+view_changed (GtkComboBox *combo,
+              Dialog      *d)
+{
+  preview_update (d);
+}
+
+static void
+preview_toggled (GtkToggleButton *button,
+                 Dialog          *d)
+{
+  if (gtk_toggle_button_get_active (button) && (d->stale || ! d->result))
+    {
+      d->stale = TRUE;
+      schedule_trace (d);
+    }
+
+  preview_update (d);
+}
+
+static void
+selection_only_toggled (GtkToggleButton *button,
+                        Dialog          *d)
+{
+  ChopGimpTraceSource *source;
+
+  if (d->live)
+    return;
+
+  source = chopgimp_trace_source_new (d->drawable,
+                                      gtk_toggle_button_get_active (button));
+  if (! source)
+    return;
+
+  /*  the canvas item covers the traced area: a new one  */
+  if (d->item)
+    {
+      GimpDisplayShell *shell = dialog_shell (d);
+
+      if (shell)
+        gimp_display_shell_remove_item (shell, d->item);
+
+      g_clear_object (&d->item);
+    }
+
+  g_clear_pointer (&d->result, chopgimp_trace_result_free);
+  chopgimp_trace_source_free (d->source);
+  d->source = source;
+
+  d->stale = TRUE;
+  schedule_trace (d);
+  stats_update (d);
+}
+
+
+/*  ─── apply ─────────────────────────────────────────────────────────── */
+
+static void
+dialog_close (Dialog *d)
+{
+  if (d->closed)
+    return;
+
+  d->closed = TRUE;
+  gtk_widget_destroy (d->dialog);
+}
+
+static void
+do_commit (Dialog *d)
+{
+  gboolean live;
+
+  d->commit = FALSE;
+
+  if (! d->result || d->result->shapes->len == 0)
+    {
+      gimp_message_literal (d->image->gimp, G_OBJECT (d->dialog),
+                            GIMP_MESSAGE_WARNING,
+                            _("La vectorisation ne donne aucune forme : changez le "
+                              "seuil, les couleurs ou décochez « Ignorer le blanc »."));
+      return;
+    }
+
+  live = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->live_toggle));
+
+  if (d->live)
+    {
+      chopgimp_trace_layer_update (d->live, d->result, live ? d->source : NULL,
+                                   &d->options, d->flat);
+      if (! live)
+        chopgimp_trace_layer_expand (d->live, TRUE);
+    }
+  else
+    {
+      chopgimp_trace_layer_new (d->image,
+                                GIMP_IS_LAYER (d->drawable) ? GIMP_LAYER (d->drawable) : NULL,
+                                d->result, live ? d->source : NULL,
+                                &d->options, d->flat,
+                                gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->hide_original)),
+                                d->context);
+    }
+
+  gimp_image_flush (d->image);
+
+  dialog_close (d);
+}
+
+static void
+dialog_response (GtkWidget *widget,
+                 gint       response_id,
+                 Dialog    *d)
+{
+  switch (response_id)
+    {
+    case GTK_RESPONSE_OK:
+      d->commit = TRUE;
+
+      if (d->result && ! d->stale && ! d->running && ! d->timeout_id)
+        {
+          do_commit (d);
+        }
+      else
+        {
+          /*  wait for the trace of the current options  */
+          gtk_dialog_set_response_sensitive (GTK_DIALOG (d->dialog), GTK_RESPONSE_OK, FALSE);
+
+          if (! d->running || d->timeout_id)
+            {
+              if (d->timeout_id)
+                {
+                  g_source_remove (d->timeout_id);
+                  d->timeout_id = 0;
+                }
+              start_trace (d);
+            }
+        }
+      break;
+
+    case RESPONSE_EXPAND:
+      if (d->live)
+        {
+          chopgimp_trace_layer_expand (d->live, TRUE);
+          gimp_image_flush (d->image);
+        }
+      dialog_close (d);
+      break;
+
+    default:
+      dialog_close (d);
+      break;
+    }
+}
+
+static void
+drawable_removed (GimpItem *item,
+                  Dialog   *d)
+{
+  dialog_close (d);
+}
+
+static void
+dialog_destroyed (GtkWidget *widget,
+                  Dialog    *d)
+{
+  GimpDisplayShell *shell;
+
+  d->closed = TRUE;
+
+  if (d->timeout_id)
+    g_source_remove (d->timeout_id);
+  d->timeout_id = 0;
+
+  if (d->progress_id)
+    g_source_remove (d->progress_id);
+  d->progress_id = 0;
+
+  if (d->cancellable)
+    g_cancellable_cancel (d->cancellable);
+
+  shell = dialog_shell (d);
+  if (d->item && shell)
+    gimp_display_shell_remove_item (shell, d->item);
+  g_clear_object (&d->item);
+
+  g_signal_handlers_disconnect_by_data (d->drawable, d);
+}
+
+static void
+dialog_free (Dialog *d)
+{
+  if (d->display)
+    g_object_remove_weak_pointer (G_OBJECT (d->display), (gpointer *) &d->display);
+
+  g_clear_object (&d->cancellable);
+  g_clear_pointer (&d->result, chopgimp_trace_result_free);
+  chopgimp_trace_source_free (d->source);
+  custom_colors_clear (d);
+  chopgimp_trace_options_clear (&d->options);
+  g_object_unref (d->drawable);
+  g_object_unref (d->image);
+  g_free (d);
+}
+
+
+/*  ─── public ────────────────────────────────────────────────────────── */
+
+void
+chopgimp_trace_dialog_show (GimpImage    *image,
+                            GimpDrawable *drawable,
+                            GimpDisplay  *display,
+                            GimpContext  *context,
+                            GtkWidget    *parent)
+{
+  static const gchar *views[]    = { N_("Résultat"), N_("Contours"),
+                                     N_("Contours + source"), NULL };
+  static const gchar *modes[]    = { N_("Couleur"), N_("Niveaux de gris"),
+                                     N_("Noir et blanc"), NULL };
+  static const gchar *palettes[] = { N_("Automatique"), N_("Limitée"),
+                                     N_("Couleurs globales du document"),
+                                     N_("Nuancier actif"), NULL };
+  static const gchar *methods[]  = { N_("Adjacent (formes découpées)"),
+                                     N_("Superposé (formes empilées)"), NULL };
+  static const gchar *engines[]  = { N_("Contours remplis (potrace)"),
+                                     N_("Tracé central (autotrace)"),
+                                     N_("Pixel art (depixelize)"), NULL };
+  Dialog              *d;
+  GtkWidget           *vbox;
+  GtkWidget           *grid;
+  GtkWidget           *expander;
+  GtkWidget           *hbox;
+  GtkWidget           *sep;
+  GimpChannel         *mask;
+  gboolean             has_selection;
+  gint                 row = 0;
+
+  g_return_if_fail (GIMP_IS_IMAGE (image));
+  g_return_if_fail (GIMP_IS_DRAWABLE (drawable));
+
+  d          = g_new0 (Dialog, 1);
+  d->image   = g_object_ref (image);
+  d->context = context;
+  d->drawable = g_object_ref (drawable);
+  d->display = display;
+  if (display)
+    g_object_add_weak_pointer (G_OBJECT (display), (gpointer *) &d->display);
+
+  chopgimp_trace_options_init (&d->options);
+
+  if (chopgimp_trace_layer_is_live (GIMP_ITEM (drawable)))
+    {
+      d->live = GIMP_VECTOR_LAYER (drawable);
+
+      if (! chopgimp_trace_layer_get (d->live, &d->source, &d->options, &d->flat))
+        {
+          gimp_message_literal (image->gimp, G_OBJECT (parent), GIMP_MESSAGE_WARNING,
+                                _("Les données de vectorisation de ce calque sont "
+                                  "illisibles : décomposez-le (Objet > Vectorisation "
+                                  "> Décomposer)."));
+          dialog_free (d);
+          return;
+        }
+    }
+  else
+    {
+      d->source = chopgimp_trace_source_new (drawable, FALSE);
+
+      if (! d->source)
+        {
+          gimp_message_literal (image->gimp, G_OBJECT (parent), GIMP_MESSAGE_WARNING,
+                                _("Rien à vectoriser : le calque est vide."));
+          dialog_free (d);
+          return;
+        }
+
+      chopgimp_trace_options_set_preset (&d->options, "default");
+    }
+
+  mask          = gimp_image_get_mask (image);
+  has_selection = mask && ! gimp_channel_is_empty (mask);
+
+  /*  buttons at the bottom, like the filter dialogs (no header bar)  */
+  d->dialog = g_object_new (GIMP_TYPE_DIALOG,
+                            "title",          d->live ? _("Options de vectorisation")
+                                                      : _("Vectoriser"),
+                            "role",           "chopgimp-image-trace",
+                            "modal",          FALSE,
