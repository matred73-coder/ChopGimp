diff --git a/app/display/chopgimp-canvastrace.c b/app/display/chopgimp-canvastrace.c
new file mode 100644
index 0000000..efd77de
--- /dev/null
+++ b/app/display/chopgimp-canvastrace.c
@@ -0,0 +1,128 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-canvastrace.c — ChopGimp 3.27.3 (lot V5): the live preview of
+ * « Vectoriser » on the canvas
+ *
+ * The traced area is covered with white (the « paper »: the result is
+ * seen alone, as in Illustrator) for the views « Résultat » and
+ * « Contours »; « Contours + source » draws the outlines over the image.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "display-types.h"
+
+#include "path/chopgimp-trace.h"
+
+#include "gimpdisplayshell.h"
+#include "chopgimp-canvastrace.h"
+
+
+G_DEFINE_TYPE (ChopGimpCanvasTrace, chopgimp_canvas_trace, GIMP_TYPE_CANVAS_ITEM)
+
+
+static void
+chopgimp_canvas_trace_bounds (GimpCanvasItem        *item,
+                              cairo_rectangle_int_t *bounds)
+{
+  ChopGimpCanvasTrace *trace = CHOPGIMP_CANVAS_TRACE (item);
+  gdouble              x1, y1, x2, y2;
+
+  gimp_canvas_item_transform_xy_f (item, trace->area.x, trace->area.y, &x1, &y1);
+  gimp_canvas_item_transform_xy_f (item,
+                                   trace->area.x + trace->area.width,
+                                   trace->area.y + trace->area.height,
+                                   &x2, &y2);
+
+  /*  strokes may go a little past the area  */
+  bounds->x      = floor (MIN (x1, x2)) - 4;
+  bounds->y      = floor (MIN (y1, y2)) - 4;
+  bounds->width  = ceil (MAX (x1, x2)) + 4 - bounds->x;
+  bounds->height = ceil (MAX (y1, y2)) + 4 - bounds->y;
+}
+
+static cairo_region_t *
+chopgimp_canvas_trace_get_extents (GimpCanvasItem *item)
+{
+  cairo_rectangle_int_t r;
+
+  chopgimp_canvas_trace_bounds (item, &r);
+
+  return cairo_region_create_rectangle (&r);
+}
+
+static void
+chopgimp_canvas_trace_draw (GimpCanvasItem *item,
+                            cairo_t        *cr)
+{
+  ChopGimpCanvasTrace *trace = CHOPGIMP_CANVAS_TRACE (item);
+  GimpDisplayShell    *shell = gimp_canvas_item_get_shell (item);
+
+  cairo_save (cr);
+
+  cairo_translate (cr, -shell->offset_x, -shell->offset_y);
+  cairo_scale (cr, shell->scale_x, shell->scale_y);
+
+  if (trace->view != 2)
+    {
+      cairo_rectangle (cr, trace->area.x, trace->area.y,
+                       trace->area.width, trace->area.height);
+      cairo_set_source_rgb (cr, 1.0, 1.0, 1.0);
+      cairo_fill (cr);
+    }
+
+  if (trace->result)
+    chopgimp_trace_result_draw (trace->result, cr, trace->view);
+
+  cairo_restore (cr);
+}
+
+static void
+chopgimp_canvas_trace_class_init (ChopGimpCanvasTraceClass *klass)
+{
+  GimpCanvasItemClass *item_class = GIMP_CANVAS_ITEM_CLASS (klass);
+
+  item_class->draw        = chopgimp_canvas_trace_draw;
+  item_class->get_extents = chopgimp_canvas_trace_get_extents;
+}
+
+static void
+chopgimp_canvas_trace_init (ChopGimpCanvasTrace *trace)
+{
+}
+
+GimpCanvasItem *
+chopgimp_canvas_trace_new (GimpDisplayShell    *shell,
+                           const GeglRectangle *area)
+{
+  ChopGimpCanvasTrace *trace;
+
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), NULL);
+
+  trace = g_object_new (CHOPGIMP_TYPE_CANVAS_TRACE, "shell", shell, NULL);
+  trace->area = *area;
+
+  return GIMP_CANVAS_ITEM (trace);
+}
+
+void
+chopgimp_canvas_trace_set_result (ChopGimpCanvasTrace *trace,
+                                  gconstpointer        result,
+                                  gint                 view)
+{
+  g_return_if_fail (CHOPGIMP_CANVAS_TRACE (trace));
+
+  gimp_canvas_item_begin_change (GIMP_CANVAS_ITEM (trace));
+  trace->result = result;
+  trace->view   = view;
+  gimp_canvas_item_end_change (GIMP_CANVAS_ITEM (trace));
+}
diff --git a/app/display/chopgimp-canvastrace.h b/app/display/chopgimp-canvastrace.h
new file mode 100644
index 0000000..4c91c8e
--- /dev/null
+++ b/app/display/chopgimp-canvastrace.h
@@ -0,0 +1,44 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-canvastrace.h — ChopGimp 3.27.3 (lot V5): the live preview of
+ * « Vectoriser » on the canvas (vector, sharp at every zoom)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "gimpcanvasitem.h"
+
+
+#define CHOPGIMP_TYPE_CANVAS_TRACE (chopgimp_canvas_trace_get_type ())
+#define CHOPGIMP_CANVAS_TRACE(obj) (G_TYPE_CHECK_INSTANCE_CAST ((obj), CHOPGIMP_TYPE_CANVAS_TRACE, ChopGimpCanvasTrace))
+
+typedef struct _ChopGimpCanvasTrace      ChopGimpCanvasTrace;
+typedef struct _ChopGimpCanvasTraceClass ChopGimpCanvasTraceClass;
+
+struct _ChopGimpCanvasTrace
+{
+  GimpCanvasItem  parent_instance;
+
+  gconstpointer   result;    /* const ChopGimpTraceResult *, borrowed */
+  gint            view;      /* 0 result, 1 outlines, 2 outlines + source */
+  GeglRectangle   area;      /* the traced area (image px)             */
+};
+
+struct _ChopGimpCanvasTraceClass
+{
+  GimpCanvasItemClass parent_class;
+};
+
+
+GType            chopgimp_canvas_trace_get_type   (void) G_GNUC_CONST;
+
+GimpCanvasItem * chopgimp_canvas_trace_new        (GimpDisplayShell    *shell,
+                                                   const GeglRectangle *area);
+/*  @result is borrowed: set NULL before freeing it  */
+void             chopgimp_canvas_trace_set_result (ChopGimpCanvasTrace *trace,
+                                                   gconstpointer        result,
+                                                   gint                 view);
