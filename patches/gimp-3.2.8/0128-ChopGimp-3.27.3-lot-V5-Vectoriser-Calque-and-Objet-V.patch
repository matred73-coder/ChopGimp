+/*  3.27.3 (lot V5, lot V6 point 4): « Vectoriser… » on the selected layer;
+ *  on a live trace, its options (it is re-traced in place)
+ */
+void
+vector_objects_image_trace_cmd_callback (GimpAction *action,
+                                         GVariant   *value,
+                                         gpointer    data)
+{
+  GimpImage *image;
+  GtkWidget *widget;
+  GList     *layers;
+  return_if_no_image (image, data);
+  return_if_no_widget (widget, data);
+
+  layers = gimp_image_get_selected_layers (image);
+  if (g_list_length (layers) != 1)
+    return;
+
+  chopgimp_trace_dialog_show (image, GIMP_DRAWABLE (layers->data),
+                              action_data_get_display (data),
+                              action_data_get_context (data), widget);
+}
+
+void
+vector_objects_image_trace_expand_cmd_callback (GimpAction *action,
+                                                GVariant   *value,
+                                                gpointer    data)
+{
+  GimpImage *image;
+  GList     *layers;
+  return_if_no_image (image, data);
+
+  layers = gimp_image_get_selected_layers (image);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_ITEM_PROPERTIES,
+                               _("Décomposer la vectorisation"));
+
+  for (GList *l = layers; l; l = l->next)
+    if (chopgimp_trace_layer_is_live (l->data))
+      chopgimp_trace_layer_expand (l->data, TRUE);
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+}
