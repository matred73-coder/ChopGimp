+/*  ─── sources ───────────────────────────────────────────────────────── */
+
+ChopGimpTraceSource *
+chopgimp_trace_source_new (GimpDrawable *drawable,
+                           gboolean      selection_only)
+{
+  GimpItem            *item  = GIMP_ITEM (drawable);
+  GimpImage           *image = gimp_item_get_image (item);
+  GimpChannel         *mask  = gimp_image_get_mask (image);
+  ChopGimpTraceSource *source;
+  GeglRectangle        rect;
+  gint                 off_x, off_y;
+  gboolean             use_mask = FALSE;
+  guchar              *pixels;
+
+  gimp_item_get_offset (item, &off_x, &off_y);
+
+  rect.x      = off_x;
+  rect.y      = off_y;
+  rect.width  = gimp_item_get_width  (item);
+  rect.height = gimp_item_get_height (item);
+
+  if (selection_only && mask && ! gimp_channel_is_empty (mask))
+    {
+      gint x, y, w, h;
+
+      if (gimp_item_bounds (GIMP_ITEM (mask), &x, &y, &w, &h) &&
+          gegl_rectangle_intersect (&rect, &rect, GEGL_RECTANGLE (x, y, w, h)))
+        use_mask = TRUE;
+      else
+        return NULL;
+    }
+
+  if (rect.width < 1 || rect.height < 1)
+    return NULL;
+
+  pixels = g_malloc ((gsize) rect.width * rect.height * 4);
+
+  gegl_buffer_get (gimp_drawable_get_buffer (drawable),
+                   GEGL_RECTANGLE (rect.x - off_x, rect.y - off_y,
+                                   rect.width, rect.height),
+                   1.0, babl_format ("R'G'B'A u8"), pixels,
+                   GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+
+  if (use_mask)
+    {
+      guchar *m = g_malloc ((gsize) rect.width * rect.height);
+
+      gegl_buffer_get (gimp_drawable_get_buffer (GIMP_DRAWABLE (mask)), &rect,
+                       1.0, babl_format ("Y u8"), m,
+                       GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+
+      for (gsize i = 0; i < (gsize) rect.width * rect.height; i++)
+        pixels[i * 4 + 3] = (pixels[i * 4 + 3] * m[i] + 127) / 255;
+
+      g_free (m);
+    }
+
+  source         = g_new0 (ChopGimpTraceSource, 1);
+  source->rect   = rect;
+  source->buffer = gegl_buffer_new (&rect, babl_format ("R'G'B'A u8"));
+
+  gegl_buffer_set (source->buffer, &rect, 0, babl_format ("R'G'B'A u8"),
+                   pixels, GEGL_AUTO_ROWSTRIDE);
+  g_free (pixels);
+
+  return source;
+}
+
+void
+chopgimp_trace_source_free (ChopGimpTraceSource *source)
+{
+  if (source)
+    {
+      g_clear_object (&source->buffer);
+      g_free (source);
+    }
+}
+
+static void
+trace_progress (gdouble  fraction,
+                gpointer data)
+{
+  if (data)
+    gimp_progress_set_value (GIMP_PROGRESS (data), fraction);
+}
+
+ChopGimpTraceResult *
+chopgimp_trace_source_trace (ChopGimpTraceSource        *source,
+                             const ChopGimpTraceOptions *options,
+                             GimpProgress               *progress,
+                             GError                    **error)
+{
+  ChopGimpTraceResult *result;
+
+  g_return_val_if_fail (source != NULL, NULL);
+
+  if (progress)
+    gimp_progress_start (progress, FALSE, _("Vectorisation"));
+
+  result = chopgimp_trace_run (source->buffer, &source->rect, NULL, options,
+                               NULL, trace_progress, progress, error);
+
+  if (progress)
+    gimp_progress_end (progress);
+
+  return result;
+}
+
+
+/*  ─── the parasite ──────────────────────────────────────────────────── */
+
+static gchar *
+objects_sum (GimpVectorLayer *layer)
+{
+  gchar *xml = chopgimp_vlayer_get_xml (layer);
+  gchar *sum = g_compute_checksum_for_string (G_CHECKSUM_SHA1, xml ? xml : "", -1);
+
+  g_free (xml);
+
+  return sum;
+}
+
+static gboolean
+attach_parasite (GimpVectorLayer            *layer,
+                 ChopGimpTraceSource        *source,
+                 const ChopGimpTraceOptions *options,
+                 gboolean                    flat)
+{
+  const GeglRectangle *r = &source->rect;
+  GdkPixbuf           *pixbuf;
+  gchar               *png  = NULL;
+  gsize                size = 0;
+  gchar               *opts;
+  gchar               *sum;
+  GString             *data;
+  GimpParasite        *parasite;
+
+  pixbuf = gdk_pixbuf_new (GDK_COLORSPACE_RGB, TRUE, 8, r->width, r->height);
+  gegl_buffer_get (source->buffer, r, 1.0, babl_format ("R'G'B'A u8"),
+                   gdk_pixbuf_get_pixels (pixbuf),
+                   gdk_pixbuf_get_rowstride (pixbuf), GEGL_ABYSS_NONE);
+
+  if (! gdk_pixbuf_save_to_buffer (pixbuf, &png, &size, "png", NULL,
+                                   "compression", "6", NULL))
+    {
+      g_object_unref (pixbuf);
+      return FALSE;
+    }
+
+  g_object_unref (pixbuf);
+
+  opts = chopgimp_trace_options_to_string (options);
+  sum  = objects_sum (layer);
+
+  data = g_string_new ("chopgimp-trace 1\n");
+  g_string_append_printf (data, "x=%d\ny=%d\nw=%d\nh=%d\nflat=%d\nsum=%s\noptions=%s\n\n",
+                          r->x, r->y, r->width, r->height, flat ? 1 : 0, sum, opts);
+  g_string_append_len (data, png, size);
+
+  parasite = gimp_parasite_new (CHOPGIMP_TRACE_PARASITE,
+                                GIMP_PARASITE_PERSISTENT | GIMP_PARASITE_UNDOABLE,
+                                data->len, data->str);
+  gimp_item_parasite_attach (GIMP_ITEM (layer), parasite, TRUE);
+  gimp_parasite_free (parasite);
+
+  g_string_free (data, TRUE);
+  g_free (png);
+  g_free (opts);
+  g_free (sum);
+
+  return TRUE;
+}
+
+/*  the header lines of the parasite (key → value) and where the PNG starts  */
+static GHashTable *
+parse_header (const GimpParasite *parasite,
+              const guchar      **png,
+              gsize              *png_size)
+{
+  guint32       size = 0;
+  const gchar  *data = gimp_parasite_get_data (parasite, &size);
+  const gchar  *end;
+  GHashTable   *keys;
+  gchar       **lines;
+
+  if (! data || size < 16 || strncmp (data, "chopgimp-trace 1\n", 17))
+    return NULL;
+
+  end = g_strstr_len (data, size, "\n\n");
+  if (! end)
+    return NULL;
+
+  keys  = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+  {
+    gchar *head = g_strndup (data, end - data);
+
+    lines = g_strsplit (head, "\n", -1);
+    g_free (head);
+  }
+
+  for (gint i = 1; lines[i]; i++)
+    {
+      gchar *eq = strchr (lines[i], '=');
+
+      if (eq)
+        g_hash_table_insert (keys, g_strndup (lines[i], eq - lines[i]),
+                             g_strdup (eq + 1));
+    }
+
+  g_strfreev (lines);
+
+  *png      = (const guchar *) end + 2;
+  *png_size = size - (end + 2 - data);
+
+  return keys;
+}
+
+static gint
+key_int (GHashTable  *keys,
+         const gchar *key)
+{
+  const gchar *v = g_hash_table_lookup (keys, key);
+
+  return v ? atoi (v) : 0;
+}
+
+
+/*  ─── live traces ───────────────────────────────────────────────────── */
+
+gboolean
+chopgimp_trace_layer_is_live (GimpItem *item)
+{
+  return (GIMP_IS_VECTOR_LAYER (item) &&
+          gimp_item_is_vector_layer (item) &&
+          gimp_item_parasite_find (item, CHOPGIMP_TRACE_PARASITE) != NULL);
+}
+
+gboolean
+chopgimp_trace_layer_get (GimpVectorLayer       *layer,
+                          ChopGimpTraceSource  **source,
+                          ChopGimpTraceOptions  *options,
+                          gboolean              *flat)
+{
+  const GimpParasite *parasite;
+  GHashTable         *keys;
+  const guchar       *png;
+  gsize               png_size;
+  gboolean            ok = FALSE;
+
+  if (! chopgimp_trace_layer_is_live (GIMP_ITEM (layer)))
+    return FALSE;
+
+  parasite = gimp_item_parasite_find (GIMP_ITEM (layer), CHOPGIMP_TRACE_PARASITE);
+  keys     = parse_header (parasite, &png, &png_size);
+  if (! keys)
+    return FALSE;
+
+  if (options)
+    chopgimp_trace_options_from_string (options, g_hash_table_lookup (keys, "options"));
+
+  if (flat)
+    *flat = key_int (keys, "flat") != 0;
+
+  if (! source)
+    {
+      ok = TRUE;
+    }
+  else
+    {
+      GInputStream *stream = g_memory_input_stream_new_from_data (png, png_size, NULL);
+      GdkPixbuf    *pixbuf = gdk_pixbuf_new_from_stream (stream, NULL, NULL);
+      GeglRectangle rect   = { key_int (keys, "x"), key_int (keys, "y"),
+                               key_int (keys, "w"), key_int (keys, "h") };
+
+      g_object_unref (stream);
+
+      if (pixbuf &&
+          gdk_pixbuf_get_width  (pixbuf) == rect.width  &&
+          gdk_pixbuf_get_height (pixbuf) == rect.height &&
+          gdk_pixbuf_get_n_channels (pixbuf) == 4)
+        {
+          ChopGimpTraceSource *s = g_new0 (ChopGimpTraceSource, 1);
+
+          s->rect   = rect;
+          s->buffer = gegl_buffer_new (&rect, babl_format ("R'G'B'A u8"));
+          gegl_buffer_set (s->buffer, &rect, 0, babl_format ("R'G'B'A u8"),
+                           gdk_pixbuf_get_pixels (pixbuf),
+                           gdk_pixbuf_get_rowstride (pixbuf));
+          *source = s;
+          ok      = TRUE;
+        }
+
+      g_clear_object (&pixbuf);
+    }
+
+  g_hash_table_unref (keys);
+
+  return ok;
+}
+
+gboolean
+chopgimp_trace_layer_is_edited (GimpVectorLayer *layer)
+{
+  const GimpParasite *parasite;
+  GHashTable         *keys;
+  const guchar       *png;
+  gsize               png_size;
+  gchar              *sum;
+  gboolean            edited;
+
+  if (! chopgimp_trace_layer_is_live (GIMP_ITEM (layer)))
+    return FALSE;
+
+  parasite = gimp_item_parasite_find (GIMP_ITEM (layer), CHOPGIMP_TRACE_PARASITE);
+  keys     = parse_header (parasite, &png, &png_size);
+  if (! keys)
+    return FALSE;
+
+  sum    = objects_sum (layer);
+  edited = g_strcmp0 (sum, g_hash_table_lookup (keys, "sum")) != 0;
+
+  g_free (sum);
+  g_hash_table_unref (keys);
+
+  return edited;
+}
+
+static GimpPath *
+placeholder_path (GimpImage           *image,
+                  const gchar         *name,
+                  const GeglRectangle *r)
+{
+  GimpPath   *path = gimp_path_new (image, name);
+  GimpCoords  c    = GIMP_COORDS_DEFAULT_VALUES;
+  GimpStroke *stroke;
+
+  c.x = r->x;
+  c.y = r->y;
+  stroke = gimp_bezier_stroke_new_moveto (&c);
+  c.x = r->x + r->width;
+  gimp_bezier_stroke_lineto (stroke, &c);
+  c.y = r->y + r->height;
+  gimp_bezier_stroke_lineto (stroke, &c);
+  c.x = r->x;
+  gimp_bezier_stroke_lineto (stroke, &c);
+  gimp_stroke_close (stroke);
+
+  gimp_path_stroke_add (path, stroke);
+  g_object_unref (stroke);
+
+  return path;
+}
+
+GimpVectorLayer *
+chopgimp_trace_layer_new (GimpImage                  *image,
+                          GimpLayer                  *above,
+                          const ChopGimpTraceResult  *result,
+                          ChopGimpTraceSource        *source,
+                          const ChopGimpTraceOptions *options,
+                          gboolean                    flat,
+                          gboolean                    hide_above,
+                          GimpContext                *context)
+{
+  GimpVectorLayer *layer;
+  GimpPath        *path;
+  GimpLayer       *parent   = NULL;
+  gint             position = 0;
+  gchar           *name;
+  gchar           *xml;
+  GeglRectangle    rect;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+  g_return_val_if_fail (result != NULL, NULL);
+
+  if (! chopgimp_vobjects_enabled () || ! result->shapes || result->shapes->len == 0)
+    return NULL;
+
+  xml = chopgimp_trace_result_to_xml (result, flat);
+  if (! xml)
+    return NULL;
+
+  if (above)
+    {
+      parent   = gimp_layer_get_parent (above);
+      position = gimp_item_get_index (GIMP_ITEM (above));
+      name     = g_strdup_printf (_("%s vectorisé"),
+                                  gimp_object_get_name (above));
+    }
+  else
+    {
+      name = g_strdup (_("Vectorisation"));
+    }
+
+  rect = (GeglRectangle) { result->offset_x, result->offset_y,
+                           MAX (1, result->width), MAX (1, result->height) };
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_LAYER_ADD, _("Vectoriser"));
+
+  path = placeholder_path (image, name, &rect);
+  gimp_image_add_path (image, path, GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+
+  layer = gimp_vector_layer_new (image, path, context);
+  gimp_object_set_name (GIMP_OBJECT (layer), name);
+  gimp_image_add_layer (image, GIMP_LAYER (layer), parent, position, TRUE);
+
+  if (! chopgimp_vlayer_set_xml (layer, xml, TRUE))
+    {
+      gimp_image_remove_layer (image, GIMP_LAYER (layer), TRUE, NULL);
+      gimp_image_remove_path (image, path, TRUE, NULL);
+      layer = NULL;
+    }
+  else
+    {
+      if (source)
+        attach_parasite (layer, source, options, flat);
+
+      if (above && hide_above)
+        gimp_item_set_visible (GIMP_ITEM (above), FALSE, TRUE);
+
+      gimp_image_set_selected_layers (image, g_list_prepend (NULL, layer));
+    }
+
+  gimp_image_undo_group_end (image);
+
+  g_free (name);
+  g_free (xml);
+
+  return layer;
+}
+
+gboolean
+chopgimp_trace_layer_update (GimpVectorLayer            *layer,
+                             const ChopGimpTraceResult  *result,
+                             ChopGimpTraceSource        *source,
+                             const ChopGimpTraceOptions *options,
+                             gboolean                    flat)
+{
+  GimpImage *image;
+  gchar     *xml;
+  gboolean   ok;
+
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), FALSE);
+  g_return_val_if_fail (result != NULL, FALSE);
+
+  if (! result->shapes || result->shapes->len == 0)
+    return FALSE;
+
+  xml = chopgimp_trace_result_to_xml (result, flat);
+  if (! xml)
+    return FALSE;
+
+  image = gimp_item_get_image (GIMP_ITEM (layer));
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_ITEM_PROPERTIES,
+                               _("Options de vectorisation"));
+
+  ok = chopgimp_vlayer_set_xml (layer, xml, TRUE);
+
+  if (ok && source)
+    attach_parasite (layer, source, options, flat);
+
+  gimp_image_undo_group_end (image);
+
+  g_free (xml);
+
+  return ok;
+}
+
+gboolean
+chopgimp_trace_layer_expand (GimpVectorLayer *layer,
+                             gboolean         push_undo)
+{
+  if (! chopgimp_trace_layer_is_live (GIMP_ITEM (layer)))
+    return FALSE;
+
+  gimp_item_parasite_detach (GIMP_ITEM (layer), CHOPGIMP_TRACE_PARASITE, push_undo);
+
+  return TRUE;
+}
diff --git a/app/core/chopgimp-trace-layer.h b/app/core/chopgimp-trace-layer.h
new file mode 100644
index 0000000..34579c1
--- /dev/null
+++ b/app/core/chopgimp-trace-layer.h
@@ -0,0 +1,96 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-trace-layer.h — ChopGimp 3.27.3 (lot V5, lot V6 point 4):
+ * « Vectoriser » into a vector layer, and the « vectorisation dynamique »
+ * (live trace) kept on that layer.
+ *
+ * A live trace is a vector layer with the item parasite « chopgimp-trace »
+ * (persistent, undoable, copied with the layer):
+ *
+ *     "chopgimp-trace 1\n"
+ *     "x=<int>\ny=<int>\nw=<int>\nh=<int>\n"      the traced area (image px)
+ *     "flat=0|1\n"                                 no groups by color
+ *     "sum=<sha1>\n"                               of the objects as traced
+ *     "options=<chopgimp_trace_options_to_string>\n"
+ *     "\n"                                         end of the header, then
+ *     PNG                                          the source pixels (the
+ *                                                  selection, if any, is
+ *                                                  in their alpha)
+ *
+ * Like Illustrator, the trace can be re-adjusted (« Options de
+ * vectorisation… ») until it is decomposed (« Décomposer »: the parasite
+ * goes, the objects stay). Editing the objects of a live trace does not
+ * decompose it: the dialog then warns that re-tracing replaces those
+ * edits (the objects no longer match « sum »).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "path/chopgimp-trace.h"
+
+
+#define CHOPGIMP_TRACE_PARASITE "chopgimp-trace"
+
+
+typedef struct
+{
+  GeglBuffer    *buffer;    /* R'G'B'A u8, extent == @rect (image coords) */
+  GeglRectangle  rect;
+} ChopGimpTraceSource;
+
+
+/*  the pixels of @drawable (image coordinates), only inside the selection
+ *  when @selection_only and the image has one; NULL when empty
+ */
+ChopGimpTraceSource * chopgimp_trace_source_new      (GimpDrawable          *drawable,
+                                                      gboolean               selection_only);
+void                  chopgimp_trace_source_free     (ChopGimpTraceSource   *source);
+
+/*  traces @source (synchronous; the dialog runs chopgimp_trace_run()
+ *  itself in a thread)
+ */
+ChopGimpTraceResult * chopgimp_trace_source_trace    (ChopGimpTraceSource   *source,
+                                                      const ChopGimpTraceOptions *options,
+                                                      GimpProgress          *progress,
+                                                      GError               **error);
+
+
+/*  ─── live traces ───────────────────────────────────────────────────── */
+
+gboolean              chopgimp_trace_layer_is_live   (GimpItem              *item);
+/*  the source and options of a live trace (FALSE: not one, or damaged)  */
+gboolean              chopgimp_trace_layer_get       (GimpVectorLayer       *layer,
+                                                      ChopGimpTraceSource  **source,
+                                                      ChopGimpTraceOptions  *options,
+                                                      gboolean              *flat);
+/*  the objects were changed since the last trace  */
+gboolean              chopgimp_trace_layer_is_edited (GimpVectorLayer       *layer);
+
+/*  a new vector layer with the objects of @result, above @above (or at
+ *  the top), named « <name of above> vectorisé »; @source: keep a live
+ *  trace (NULL: plain objects); @hide_above: the traced layer is hidden.
+ *  One undo step. NULL when the result is empty or objects are disabled.
+ */
+GimpVectorLayer     * chopgimp_trace_layer_new       (GimpImage             *image,
+                                                      GimpLayer             *above,
+                                                      const ChopGimpTraceResult *result,
+                                                      ChopGimpTraceSource   *source,
+                                                      const ChopGimpTraceOptions *options,
+                                                      gboolean               flat,
+                                                      gboolean               hide_above,
+                                                      GimpContext           *context);
+/*  re-trace into @layer (its objects replaced, the parasite updated), one
+ *  undo step
+ */
+gboolean              chopgimp_trace_layer_update    (GimpVectorLayer       *layer,
+                                                      const ChopGimpTraceResult *result,
+                                                      ChopGimpTraceSource   *source,
+                                                      const ChopGimpTraceOptions *options,
+                                                      gboolean               flat);
+/*  « Décomposer »: the live trace becomes plain objects  */
+gboolean              chopgimp_trace_layer_expand    (GimpVectorLayer       *layer,
+                                                      gboolean               push_undo);
