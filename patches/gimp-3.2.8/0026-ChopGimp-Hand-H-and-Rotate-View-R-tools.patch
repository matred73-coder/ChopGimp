+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-viewtools.h — ChopGimp: Photoshop Hand (H) and Rotate View (R) tools
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "gimptool.h"
+
+#define GIMP_TYPE_HAND_TOOL         (gimp_hand_tool_get_type ())
+#define GIMP_TYPE_ROTATE_VIEW_TOOL  (gimp_rotate_view_tool_get_type ())
+
+typedef struct _GimpViewDragTool      GimpViewDragTool;
+typedef struct _GimpViewDragToolClass GimpViewDragToolClass;
+
+struct _GimpViewDragTool
+{
+  GimpTool  parent_instance;
+
+  gdouble   last_x;
+  gdouble   last_y;
+};
+
+struct _GimpViewDragToolClass
+{
+  GimpToolClass  parent_class;
+};
+
+GType   gimp_hand_tool_get_type          (void) G_GNUC_CONST;
+GType   gimp_rotate_view_tool_get_type   (void) G_GNUC_CONST;
+
+void    gimp_hand_tool_register          (GimpToolRegisterCallback  callback,
+                                          gpointer                  data);
+void    gimp_rotate_view_tool_register   (GimpToolRegisterCallback  callback,
+                                          gpointer                  data);
