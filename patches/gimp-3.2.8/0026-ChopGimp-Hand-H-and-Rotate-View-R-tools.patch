+ */
+
+#include "config.h"
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "tools-types.h"
+
+#include "core/gimptooloptions.h"
+
+#include "widgets/gimpwidgets-utils.h"
+
+#include "display/gimpdisplay.h"
+#include "display/gimpdisplayshell.h"
+#include "display/gimpdisplayshell-rotate.h"
+#include "display/gimpdisplayshell-scroll.h"
+#include "display/gimpdisplayshell-transform.h"
+
+#include "chopgimp-viewtools.h"
+#include "gimptoolcontrol.h"
+#include "gimptooloptions-gui.h"
+
+#include "gimp-intl.h"
+
+
+typedef GimpViewDragTool      GimpHandTool;
+typedef GimpViewDragToolClass GimpHandToolClass;
+typedef GimpViewDragTool      GimpRotateViewTool;
+typedef GimpViewDragToolClass GimpRotateViewToolClass;
+
+G_DEFINE_TYPE (GimpHandTool,       gimp_hand_tool,        GIMP_TYPE_TOOL)
+G_DEFINE_TYPE (GimpRotateViewTool, gimp_rotate_view_tool, GIMP_TYPE_TOOL)
+
+
+void
+gimp_hand_tool_register (GimpToolRegisterCallback  callback,
+                         gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_HAND_TOOL,
+                GIMP_TYPE_TOOL_OPTIONS,
+                gimp_tool_options_empty_gui,
+                0,
+                "gimp-hand-tool",
+                _("Main"),
+                _("Main : faire défiler l'image en glissant"),
+                N_("_Main"), "H",
+                NULL, NULL,
+                "chopgimp-tool-hand",
+                data);
+}
+
+void
+gimp_rotate_view_tool_register (GimpToolRegisterCallback  callback,
+                                gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_ROTATE_VIEW_TOOL,
+                GIMP_TYPE_TOOL_OPTIONS,
+                gimp_tool_options_empty_gui,
+                0,
+                "gimp-rotate-view-tool",
+                _("Rotation de la vue"),
+                _("Rotation de la vue : faire pivoter l'affichage (Maj : par pas de 15°, "
+                  "double-clic : remettre droit)"),
+                N_("_Rotation de la vue"), "R",
+                NULL, NULL,
+                "chopgimp-tool-rotate-view",
+                data);
+}
+
+
+/*  common: remember the pointer position in window coordinates  */
+
+static void
+view_drag_store (GimpTool         *tool,
+                 const GimpCoords *coords,
+                 GimpDisplay      *display)
+{
+  GimpViewDragTool *vt    = (GimpViewDragTool *) tool;
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+
+  gimp_display_shell_transform_xy_f (shell, coords->x, coords->y,
+                                     &vt->last_x, &vt->last_y);
+}
+
+static void
+view_drag_button_press (GimpTool            *tool,
+                        const GimpCoords    *coords,
+                        guint32              time,
+                        GdkModifierType      state,
+                        GimpButtonPressType  press_type,
+                        GimpDisplay         *display)
+{
+  tool->display = display;
+  view_drag_store (tool, coords, display);
+  gimp_tool_control_activate (tool->control);
+}
+
+static void
+view_drag_button_release (GimpTool              *tool,
+                          const GimpCoords      *coords,
+                          guint32                time,
+                          GdkModifierType        state,
+                          GimpButtonReleaseType  release_type,
+                          GimpDisplay           *display)
+{
+  gimp_tool_control_halt (tool->control);
+}
+
+static void
+view_drag_class_init (GimpToolClass *tool_class)
+{
+  tool_class->button_press   = view_drag_button_press;
+  tool_class->button_release = view_drag_button_release;
+}
+
+static void
+view_drag_init (GimpTool           *tool,
+                GimpToolCursorType  cursor)
+{
+  gimp_tool_control_set_motion_mode (tool->control, GIMP_MOTION_MODE_EXACT);
+  gimp_tool_control_set_tool_cursor (tool->control, cursor);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_MOUSE);
+  gimp_tool_control_set_wants_all_key_events (tool->control, FALSE);
+}
+
+
+/*  Hand  */
+
+static void
+gimp_hand_tool_motion (GimpTool         *tool,
+                       const GimpCoords *coords,
+                       guint32           time,
+                       GdkModifierType   state,
+                       GimpDisplay      *display)
+{
+  GimpViewDragTool *vt    = (GimpViewDragTool *) tool;
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           x, y;
+
+  gimp_display_shell_transform_xy_f (shell, coords->x, coords->y, &x, &y);
+
+  gimp_display_shell_scroll (shell,
+                             (gint) (vt->last_x - x),
+                             (gint) (vt->last_y - y));
+
+  /*  keep the pointer position in window coordinates  */
+  vt->last_x = x;
+  vt->last_y = y;
+}
+
+static void
+gimp_hand_tool_class_init (GimpHandToolClass *klass)
+{
+  GimpToolClass *tool_class = GIMP_TOOL_CLASS (klass);
+
+  view_drag_class_init (tool_class);
+  tool_class->motion = gimp_hand_tool_motion;
+}
+
+static void
+gimp_hand_tool_init (GimpHandTool *tool)
+{
+  view_drag_init (GIMP_TOOL (tool), GIMP_TOOL_CURSOR_HAND);
+}
+
+
+/*  Rotate view  */
+
+static void
+gimp_rotate_view_tool_button_press (GimpTool            *tool,
+                                    const GimpCoords    *coords,
+                                    guint32              time,
+                                    GdkModifierType      state,
+                                    GimpButtonPressType  press_type,
+                                    GimpDisplay         *display)
+{
+  if (press_type == GIMP_BUTTON_PRESS_DOUBLE)
+    {
+      gimp_display_shell_rotate_to (gimp_display_get_shell (display), 0.0);
+      return;
+    }
+
+  gimp_display_get_shell (display)->rotate_drag_angle =
+    gimp_display_get_shell (display)->rotate_angle;
+
+  view_drag_button_press (tool, coords, time, state, press_type, display);
+}
+
+static void
+gimp_rotate_view_tool_motion (GimpTool         *tool,
+                              const GimpCoords *coords,
+                              guint32           time,
+                              GdkModifierType   state,
+                              GimpDisplay      *display)
+{
+  GimpViewDragTool *vt    = (GimpViewDragTool *) tool;
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           x, y;
+
+  gimp_display_shell_transform_xy_f (shell, coords->x, coords->y, &x, &y);
+
+  gimp_display_shell_rotate_drag (shell, vt->last_x, vt->last_y, x, y,
+                                  (state & gimp_get_extend_selection_mask ()) != 0);
+
+  vt->last_x = x;
+  vt->last_y = y;
+}
+
+static void
+gimp_rotate_view_tool_class_init (GimpRotateViewToolClass *klass)
+{
+  GimpToolClass *tool_class = GIMP_TOOL_CLASS (klass);
+
+  view_drag_class_init (tool_class);
+  tool_class->button_press = gimp_rotate_view_tool_button_press;
+  tool_class->motion       = gimp_rotate_view_tool_motion;
+}
+
+static void
+gimp_rotate_view_tool_init (GimpRotateViewTool *tool)
+{
+  view_drag_init (GIMP_TOOL (tool), GIMP_TOOL_CURSOR_ROTATE);
+}
