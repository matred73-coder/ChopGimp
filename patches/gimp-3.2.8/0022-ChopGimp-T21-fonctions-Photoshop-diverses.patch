+/*  ChopGimp: tiles creating a document from a template in one click  */
+static const struct { const gchar *template; const gchar *label; const gchar *size; } chopgimp_presets[] =
+{
+  { "Défaut — Document par défaut 1920×1080",              N_("Par défaut"),  "1920 × 1080" },
+  { "Impression — A4 portrait",                              N_("A4"),          "300 ppp" },
+  { "Réseaux sociaux — Instagram publication 1080×1080",     N_("Instagram"),   "1080 × 1080" },
+  { "Réseaux sociaux — Instagram / TikTok story 1080×1920",  N_("Story"),       "1080 × 1920" },
+  { "Web — Bannière 1200×628",                               N_("Bannière"),    "1200 × 628" },
+  { "Vidéo — UHD 4K 3840×2160",                              N_("4K"),          "3840 × 2160" },
+  { "Illustration — Toile 4000×4000",                        N_("Toile"),       "4000 × 4000" },
+};
+
+static void
+chopgimp_welcome_preset_clicked (GtkButton *button,
+                                 GtkWidget *welcome_dialog)
+{
+  Gimp         *gimp     = g_object_get_data (G_OBJECT (button), "gimp");
+  GimpTemplate *template = g_object_get_data (G_OBJECT (button), "template");
+  GimpContext  *context  = gimp_get_user_context (gimp);
+  GimpImage    *image;
+
+  image = gimp_image_new_from_template (gimp, template, context);
+  gimp_create_display (gimp, image, gimp_template_get_unit (template), 1.0,
+                       G_OBJECT (gimp_widget_get_monitor (GTK_WIDGET (button))));
+  g_object_unref (image);
+
+  gtk_widget_destroy (welcome_dialog);
+}
+
+static void
+chopgimp_welcome_presets (Gimp      *gimp,
+                          GtkWidget *welcome_dialog,
+                          GtkWidget *main_vbox)
+{
+  GtkWidget *vbox = main_vbox;
+  GtkWidget *flow = gtk_flow_box_new ();
+  guint      i;
+
+  gtk_box_pack_start (GTK_BOX (main_vbox),
+                      chopgimp_welcome_heading (_("Nouveau document")),
+                      FALSE, FALSE, 0);
+
+  gtk_flow_box_set_selection_mode (GTK_FLOW_BOX (flow), GTK_SELECTION_NONE);
+  /*  min = max: the height asked for at the minimum width is one row
+   *  (else the scrolled page asks for 7 rows and the window is too tall)
+   */
+  gtk_flow_box_set_min_children_per_line (GTK_FLOW_BOX (flow), 7);
+  gtk_flow_box_set_max_children_per_line (GTK_FLOW_BOX (flow), 7);
+  gtk_flow_box_set_homogeneous (GTK_FLOW_BOX (flow), TRUE);
+  gtk_box_pack_start (GTK_BOX (vbox), flow, FALSE, FALSE, 0);
+
+  for (i = 0; i < G_N_ELEMENTS (chopgimp_presets); i++)
+    {
+      GimpTemplate *template;
+      GtkWidget    *button, *box, *label;
+      gchar        *markup;
+
+      template = (GimpTemplate *)
+        gimp_container_get_child_by_name (gimp->templates, chopgimp_presets[i].template);
+      if (! template)
+        continue;
+
+      button = gtk_button_new ();
+      box    = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+      gtk_box_pack_start (GTK_BOX (box),
+                          gtk_image_new_from_icon_name ("document-new", GTK_ICON_SIZE_DND),
+                          FALSE, FALSE, 0);
+      label  = gtk_label_new (NULL);
+      markup = g_markup_printf_escaped ("<b>%s</b>\n<small>%s</small>",
+                                        _(chopgimp_presets[i].label),
+                                        chopgimp_presets[i].size);
+      gtk_label_set_markup (GTK_LABEL (label), markup);
+      gtk_label_set_justify (GTK_LABEL (label), GTK_JUSTIFY_CENTER);
+      g_free (markup);
+      gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+      gtk_container_add (GTK_CONTAINER (button), box);
+      gtk_widget_set_tooltip_text (button, chopgimp_presets[i].template);
+
+      g_object_set_data (G_OBJECT (button), "gimp", gimp);
+      g_object_set_data (G_OBJECT (button), "template", template);
+      g_signal_connect (button, "clicked",
+                        G_CALLBACK (chopgimp_welcome_preset_clicked), welcome_dialog);
+
+      gtk_container_add (GTK_CONTAINER (flow), button);
+    }
+
+  gtk_widget_show_all (flow);
+}
+
+static GtkWidget *
+chopgimp_welcome_heading (const gchar *text)
+{
+  GtkWidget *label = gtk_label_new (NULL);
+  gchar     *markup = g_markup_printf_escaped ("<b>%s</b>", text);
+
+  gtk_label_set_markup (GTK_LABEL (label), markup);
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_widget_set_margin_top (label, 4);
+  g_free (markup);
+
+  return label;
+}
+
+static GtkWidget *
+chopgimp_welcome_recent_tile (Gimp          *gimp,
+                              GimpImagefile *imagefile,
+                              const gchar   *path,
+                              gint           index)
+{
+  GtkWidget     *box   = gtk_box_new (GTK_ORIENTATION_VERTICAL, 3);
+  GtkWidget     *frame = gtk_frame_new (NULL);
+  GtkWidget     *view;
+  GtkWidget     *label;
+  GimpThumbnail *thumb = gimp_imagefile_get_thumbnail (imagefile);
+  GFile         *file  = g_file_new_for_path (path);
+  GFileInfo     *info;
+  GString       *sub   = g_string_new (NULL);
+  gchar         *basename = g_path_get_basename (path);
+  gchar         *markup;
+  gchar         *dirname;
+  gchar         *tooltip;
+
+  /*  a fixed square cell: the thumbnail centred in it  */
+  gtk_widget_set_size_request (frame, 120, 120);
+  gtk_frame_set_shadow_type (GTK_FRAME (frame), GTK_SHADOW_NONE);
+  gtk_style_context_add_class (gtk_widget_get_style_context (frame), "view");
+  view = gimp_view_new (gimp_get_user_context (gimp), GIMP_VIEWABLE (imagefile),
+                        112, 0, FALSE);
+  gtk_widget_set_halign (view, GTK_ALIGN_CENTER);
+  gtk_widget_set_valign (view, GTK_ALIGN_CENTER);
+  gtk_container_add (GTK_CONTAINER (frame), view);
+  gtk_box_pack_start (GTK_BOX (box), frame, FALSE, FALSE, 0);
+
+  label = gtk_label_new (basename);
+  gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_MIDDLE);
+  gtk_label_set_max_width_chars (GTK_LABEL (label), 16);
+  gtk_label_set_width_chars (GTK_LABEL (label), 16);
+  gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+
+  if (thumb)
+    {
+      gint w = 0, h = 0;
+
+      g_object_get (thumb, "image-width", &w, "image-height", &h, NULL);
+      if (w > 0 && h > 0)
+        g_string_append_printf (sub, "%d × %d", w, h);
+    }
+
+  info = g_file_query_info (file, G_FILE_ATTRIBUTE_TIME_MODIFIED,
+                            G_FILE_QUERY_INFO_NONE, NULL, NULL);
+  if (info)
+    {
+      GDateTime *dt = g_file_info_get_modification_date_time (info);
+
+      if (dt)
+        {
+          GDateTime *local = g_date_time_to_local (dt);
+          gchar     *date  = g_date_time_format (local, "%d/%m/%Y");
+
+          g_string_append_printf (sub, "%s%s", sub->len ? " · " : "", date);
+          g_free (date);
+          g_date_time_unref (local);
+          g_date_time_unref (dt);
+        }
+      g_object_unref (info);
+    }
+
+  label  = gtk_label_new (NULL);
+  markup = g_markup_printf_escaped ("<small>%s</small>", sub->str);
+  gtk_label_set_markup (GTK_LABEL (label), markup);
+  gtk_style_context_add_class (gtk_widget_get_style_context (label), "dim-label");
+  gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+  g_free (markup);
+
+  dirname = g_path_get_dirname (path);
+  tooltip = g_strdup_printf ("%s\n%s", basename, dirname);
+  gtk_widget_set_tooltip_text (box, tooltip);
+  g_free (tooltip);
+  g_free (dirname);
+
+  g_object_set_data_full (G_OBJECT (box), "action_name",
+                          g_strdup_printf ("file-open-recent-%02u", index + 1),
+                          g_free);
+
+  g_string_free (sub, TRUE);
+  g_free (basename);
+  g_object_unref (file);
+
+  gtk_widget_show_all (box);
+
+  return box;
+}
