@@ -369,6 +472,79 @@ edit_paste_cmd_callback (GimpAction *action,
   if (! display)
     return;
 
+  /*  ChopGimp 4.2.0: objects copied from a vector layer, pasted into a
+   *  vector layer: new objects of it, selected
+   */
+  {
+    GList      *sel   = gimp_image_get_selected_layers (image);
+    GimpObject *clip  = gimp_clipboard_get_object (image->gimp);
+    gboolean    done  = FALSE;
+
+    if (clip && sel && ! sel->next && GIMP_IS_VECTOR_LAYER (sel->data) &&
+        paste_type != GIMP_PASTE_TYPE_NEW_LAYER                       &&
+        paste_type != GIMP_PASTE_TYPE_NEW_LAYER_IN_PLACE)
+      done = chopgimp_vobjects_clipboard_paste (sel->data, G_OBJECT (clip));
+
+    g_clear_object (&clip);
+
+    /*  ChopGimp 4.2.1: an SVG copied from Inkscape or Illustrator
+     *  (image/svg+xml, or a text holding an <svg>): objects of the active
+     *  vector layer (else of a new one), selected; not GIMP's own copies
+     */
+    if (! done && chopgimp_vobjects_enabled ()                       &&
+        paste_type != GIMP_PASTE_TYPE_NEW_LAYER                       &&
+        paste_type != GIMP_PASTE_TYPE_NEW_LAYER_IN_PLACE)
+      {
+        GtkClipboard *cb = gtk_clipboard_get_for_display (gdk_display_get_default (),
+                                                          GDK_SELECTION_CLIPBOARD);
+        gchar        *svg = NULL;
+        gsize         len = 0;
+
+        if (cb && gtk_clipboard_get_owner (cb) != G_OBJECT (image->gimp))
+          {
+            gchar *data_svg = gimp_clipboard_get_svg (image->gimp, &len);
+
+            /*  the stream is not 0-terminated  */
+            if (data_svg)
+              svg = g_strndup (data_svg, len);
+            g_free (data_svg);
+
+            if (! svg && gtk_clipboard_wait_is_text_available (cb))
+              svg = gtk_clipboard_wait_for_text (cb);
+
+            if (svg && ! chopgimp_vobjects_text_is_svg (svg))
+              g_clear_pointer (&svg, g_free);
+          }
+
+        if (svg)
+          {
+            GimpDisplayShell *shell = gimp_display_get_shell (display);
+            gboolean          in_place;
+            gdouble           center[2];
+
+            in_place = (paste_type == GIMP_PASTE_TYPE_FLOATING_IN_PLACE                 ||
+                        paste_type == GIMP_PASTE_TYPE_FLOATING_INTO_IN_PLACE            ||
+                        paste_type == GIMP_PASTE_TYPE_NEW_LAYER_OR_FLOATING_IN_PLACE    ||
+                        paste_type == GIMP_PASTE_TYPE_NEW_MERGED_LAYER_OR_FLOATING_IN_PLACE);
+
+            gimp_display_shell_untransform_xy_f (shell,
+                                                 shell->disp_width  / 2.0,
+                                                 shell->disp_height / 2.0,
+                                                 &center[0], &center[1]);
+
+            done = chopgimp_vobjects_paste_svg (image, action_data_get_context (data),
+                                                svg, in_place ? NULL : center, NULL);
+            g_free (svg);
+          }
+      }
+
+    if (done)
+      {
+        gimp_image_flush (image);
+        return;
+      }
+  }
