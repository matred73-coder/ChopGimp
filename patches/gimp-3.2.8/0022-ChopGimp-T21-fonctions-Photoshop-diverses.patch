diff --git a/app/gui/chopgimp-autosave.c b/app/gui/chopgimp-autosave.c
new file mode 100644
index 0000000..4b600a9
--- /dev/null
+++ b/app/gui/chopgimp-autosave.c
@@ -0,0 +1,629 @@
+/* ChopGimp — enregistrement automatique et récupération
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * Toutes les N minutes (chopgimprc [autosave] minutes, 5 par défaut,
+ * 0 = désactivé), chaque image modifiée depuis sa dernière copie est
+ * enregistrée en XCF dans <gimpdir>/autosave/<id>.xcf, avec une fiche
+ * <id>.txt (nom affiché, fichier d'origine). L'écriture passe par
+ * xcf_save_stream : l'image ne change pas d'état (ni « enregistrée », ni
+ * dans les documents récents). Jamais pendant un trait ou une
+ * transformation (outil actif) ni dans les 2 s qui suivent une action de
+ * l'utilisateur (souris, stylet, clavier) : l'écriture, synchrone, bloque
+ * l'interface le temps d'enregistrer l'image (≈ 0,5 à 2 s pour une affiche
+ * A4 à 300 ppp), elle est donc repoussée de 5 s en 5 s jusqu'à une pause.
+ *
+ * Une copie disparaît quand l'image est enregistrée (plus modifiée) ou
+ * fermée ; toutes disparaissent quand ChopGimp se ferme normalement.
+ * Au démarrage, des copies restantes viennent d'une session interrompue :
+ * elles sont mises de côté (autosave/recuperation/) et une fenêtre
+ * propose de les rouvrir, sous leur nom d'origine et marquées modifiées.
+ */
+
+#include "config.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <glib/gstdio.h>
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "gui-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpcontainer.h"
+#include "core/gimpcontext.h"
+#include "core/gimpimage.h"
+#include "core/gimptoolinfo.h"
+
+#include "file/file-open.h"
+
+#include "tools/gimptool.h"
+#include "tools/gimptoolcontrol.h"
+#include "tools/tool_manager.h"
+
+#include "widgets/chopgimp-rc.h"
+
+#include "xcf/xcf.h"
+
+#include "chopgimp-autosave.h"
+
+
+typedef struct
+{
+  guint  serial;     /*  change serial of the image when it was saved  */
+  gint64 saved_at;   /*  monotonic time of that save  */
+} SavedCopy;
+
+#define AUTOSAVE_QUIET_TIME  (2 * G_TIME_SPAN_SECOND) /*  no input for 2 s  */
+#define AUTOSAVE_RETRY_DELAY 5                        /*  seconds  */
+
+static gchar      *autosave_dir      = NULL;
+static GHashTable *saved_times       = NULL;   /*  image id → SavedCopy  */
+static guint       timer_id          = 0;
+static guint       period            = 0;      /*  seconds between autosaves  */
+static gulong      input_hook_id     = 0;
+static gint64      last_input        = 0;      /*  monotonic time of the last user input  */
+static guint       recovery_timer_id = 0;
+static gpointer    recovery_pending  = NULL;   /*  Recovery not shown yet  */
+
+
+/*  per-image change counter: gimp_image_get_dirty_time() is only set on
+ *  the first dirtying, so it cannot tell whether an image changed since
+ *  the last autosave / timelapse frame.  Count "dirty" and "clean"
+ *  emissions instead (undo/redo emit them as well).
+ */
+static void
+chopgimp_image_changed (GimpImage     *image,
+                        GimpDirtyMask  dirty_mask,
+                        gpointer       data)
+{
+  guint serial;
+
+  serial = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (image),
+                                                "chopgimp-serial"));
+  g_object_set_data (G_OBJECT (image), "chopgimp-serial",
+                     GUINT_TO_POINTER (serial + 1));
+}
+
+guint
+chopgimp_image_change_serial (GimpImage *image)
+{
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), 0);
+
+  if (! g_object_get_data (G_OBJECT (image), "chopgimp-serial-hooked"))
+    {
+      g_signal_connect (image, "dirty",
+                        G_CALLBACK (chopgimp_image_changed), NULL);
+      g_signal_connect (image, "clean",
+                        G_CALLBACK (chopgimp_image_changed), NULL);
+      g_object_set_data (G_OBJECT (image), "chopgimp-serial-hooked",
+                         GINT_TO_POINTER (TRUE));
+    }
+
+  return GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (image),
+                                              "chopgimp-serial"));
+}
+
+
+static gchar *
+autosave_path (gint id, const gchar *ext)
+{
+  gchar *name = g_strdup_printf ("%d.%s", id, ext);
+  gchar *path = g_build_filename (autosave_dir, name, NULL);
+
+  g_free (name);
+  return path;
+}
+
+/*  « …/12.xcf » → « …/12.txt »  */
+static gchar *
+sidecar (const gchar *xcf)
+{
+  gsize n = strlen (xcf);
+
+  return g_strdup_printf ("%.*stxt", (gint) (n > 3 ? n - 3 : n), xcf);
+}
+
+static void
+autosave_forget (gint id)
+{
+  gchar *xcf = autosave_path (id, "xcf");
+  gchar *txt = autosave_path (id, "txt");
+
+  g_unlink (xcf);
+  g_unlink (txt);
+  g_free (xcf);
+  g_free (txt);
+  g_hash_table_remove (saved_times, GINT_TO_POINTER (id));
+}
+
+static gboolean
+autosave_image (Gimp      *gimp,
+                GimpImage *image)
+{
+  gint           id   = gimp_image_get_id (image);
+  gchar         *xcf  = autosave_path (id, "xcf");
+  gchar         *tmp  = g_strconcat (xcf, ".part", NULL);
+  GFile         *file = g_file_new_for_path (tmp);
+  GError        *error = NULL;
+  GOutputStream *out;
+  gboolean       ok   = FALSE;
+
+  out = G_OUTPUT_STREAM (g_file_replace (file, NULL, FALSE, G_FILE_CREATE_PRIVATE, NULL, &error));
+  if (out)
+    {
+      ok = xcf_save_stream (gimp, image, out, file, NULL, &error);
+      g_output_stream_close (out, NULL, NULL);
+      g_object_unref (out);
+    }
+
+  if (ok && g_rename (tmp, xcf) == 0)
+    {
+      GFile *orig = gimp_image_get_file (image);
+      gchar *txt  = autosave_path (id, "txt");
+      gchar *uri;
+      gchar *info;
+
+      if (! orig)
+        orig = gimp_image_get_imported_file (image);
+      uri  = orig ? g_file_get_uri (orig) : NULL;
+      info = g_strdup_printf ("%s\n%s\n", gimp_image_get_display_name (image),
+                              uri ? uri : "");
+      g_file_set_contents (txt, info, -1, NULL);
+      g_free (info);
+      g_free (uri);
+      g_free (txt);
+    }
+  else
+    {
+      g_unlink (tmp);
+      if (error)
+        g_printerr ("ChopGimp : enregistrement automatique impossible (%s)\n", error->message);
+      ok = FALSE;
+    }
+
+  g_clear_error (&error);
+  g_object_unref (file);
+  g_free (tmp);
+  g_free (xcf);
+  return ok;
+}
+
+/*  every input event (any widget): only stores the time, cheap enough for
+ *  motion events
+ */
+static gboolean
+autosave_input_hook (GSignalInvocationHint *ihint,
+                     guint                  n_param_values,
+                     const GValue          *param_values,
+                     gpointer               data)
+{
+  GdkEvent *event;
+
+  if (n_param_values < 2)
+    return TRUE;
+
+  event = g_value_get_boxed (&param_values[1]);
+  if (! event)
+    return TRUE;
+
+  switch (event->type)
+    {
+    case GDK_MOTION_NOTIFY:
+    case GDK_BUTTON_PRESS:
+    case GDK_2BUTTON_PRESS:
+    case GDK_3BUTTON_PRESS:
+    case GDK_BUTTON_RELEASE:
+    case GDK_KEY_PRESS:
+    case GDK_KEY_RELEASE:
+    case GDK_SCROLL:
+    case GDK_TOUCH_BEGIN:
+    case GDK_TOUCH_UPDATE:
+    case GDK_TOUCH_END:
+    case GDK_TOUCHPAD_SWIPE:
+    case GDK_TOUCHPAD_PINCH:
+      last_input = g_get_monotonic_time ();
+      break;
+
+    default:
+      break;
+    }
+
+  return TRUE;
+}
+
+static gboolean autosave_tick (gpointer data);
+
+static void
+autosave_schedule (Gimp  *gimp,
+                   guint  seconds)
+{
+  if (timer_id)
+    g_source_remove (timer_id);
+  timer_id = g_timeout_add_seconds (seconds, autosave_tick, gimp);
+}
+
+/*  the user is drawing, dragging or typing: saving now would freeze the
+ *  canvas under the pointer
+ */
+static gboolean
+autosave_user_busy (Gimp *gimp)
+{
+  GimpTool *tool = tool_manager_get_active (gimp);
+
+  /*  never in the middle of a stroke or a transform  */
+  if (tool && tool->control && gimp_tool_control_is_active (tool->control))
+    return TRUE;
+
+  if (g_get_monotonic_time () - last_input < AUTOSAVE_QUIET_TIME)
+    return TRUE;
+
+  return FALSE;
+}
+
+static gboolean
+autosave_tick (gpointer data)
+{
+  Gimp       *gimp = data;
+  GList      *list;
+  GHashTable *alive;
+  GList      *ids, *iter;
+  GimpImage  *oldest        = NULL;
+  gint64      oldest_time   = G_MAXINT64;
+  guint       oldest_serial = 0;
+
+  timer_id = 0;
+
+  /*  postponed, checked again in a few seconds  */
+  if (autosave_user_busy (gimp))
+    {
+      autosave_schedule (gimp, AUTOSAVE_RETRY_DELAY);
+      return G_SOURCE_REMOVE;
+    }
+
+  alive = g_hash_table_new (NULL, NULL);
+
+  for (list = gimp_get_image_iter (gimp); list; list = g_list_next (list))
+    {
+      GimpImage *image  = list->data;
+      gint       id     = gimp_image_get_id (image);
+      guint      serial = chopgimp_image_change_serial (image);
+      SavedCopy *prev;
+
+      g_hash_table_add (alive, GINT_TO_POINTER (id));
+
+      if (! gimp_image_is_dirty (image))
+        {
+          if (g_hash_table_contains (saved_times, GINT_TO_POINTER (id)))
+            autosave_forget (id);
+          continue;
+        }
+
+      prev = g_hash_table_lookup (saved_times, GINT_TO_POINTER (id));
+      if (prev && prev->serial == serial)
+        continue;
+
+      /*  round-robin: the save is synchronous, so only one image per
+       *  tick, the one whose copy is the oldest (never saved first)
+       */
+      if (! oldest || (prev ? prev->saved_at : 0) < oldest_time)
+        {
+          oldest        = image;
+          oldest_time   = prev ? prev->saved_at : 0;
+          oldest_serial = serial;
+        }
+    }
+
+  if (oldest)
+    {
+      gint       id    = gimp_image_get_id (oldest);
+      gint64     start = g_get_monotonic_time ();
+      gboolean   ok    = autosave_image (gimp, oldest);
+      SavedCopy *copy  = g_hash_table_lookup (saved_times, GINT_TO_POINTER (id));
+
+      if (gimp->be_verbose)
+        g_printerr ("ChopGimp : enregistrement automatique de l'image %d en %.2f s\n",
+                    id, (g_get_monotonic_time () - start) / 1e6);
+
+      if (! copy)
+        {
+          copy = g_new0 (SavedCopy, 1);
+          copy->serial = G_MAXUINT;     /*  no copy yet  */
+          g_hash_table_insert (saved_times, GINT_TO_POINTER (id), copy);
+        }
+
+      if (ok)
+        copy->serial = oldest_serial;
+
+      /*  a failed save is retried, after the other images  */
+      copy->saved_at = g_get_monotonic_time ();
+    }
+
+  /*  closed images  */
+  ids = g_hash_table_get_keys (saved_times);
+  for (iter = ids; iter; iter = iter->next)
+    if (! g_hash_table_contains (alive, iter->data))
+      autosave_forget (GPOINTER_TO_INT (iter->data));
+  g_list_free (ids);
+  g_hash_table_destroy (alive);
+
+  /*  other modified images wait for the next period (one save per tick)  */
+  autosave_schedule (gimp, period);
+
+  return G_SOURCE_REMOVE;
+}
+
+
+/*  recovery  */
+
+typedef struct
+{
+  Gimp   *gimp;
+  GSList *files;      /*  xcf paths in recuperation/  */
+} Recovery;
+
+static void
+recovery_free (Recovery *r)
+{
+  g_slist_free_full (r->files, g_free);
+  g_free (r);
+}
+
+static void
+recovery_open (Recovery *r)
+{
+  GimpContext *context = gimp_get_user_context (r->gimp);
+  GSList      *iter;
+
+  for (iter = r->files; iter; iter = iter->next)
+    {
+      const gchar       *xcf  = iter->data;
+      gchar             *txt  = sidecar (xcf);
+      gchar             *info = NULL;
+      GFile             *file = g_file_new_for_path (xcf);
+      GimpPDBStatusType  status;
+      GimpImage         *image;
+
+      image = file_open_with_display (r->gimp, context, NULL, file, TRUE, NULL, &status, NULL);
+
+      if (image && g_file_get_contents (txt, &info, NULL, NULL))
+        {
+          gchar **lines = g_strsplit (info, "\n", 3);
+
+          if (lines[0] && lines[1] && *lines[1])
+            {
+              GFile *orig = g_file_new_for_uri (lines[1]);
+              gchar *base = g_file_get_basename (orig);
+
+              if (g_str_has_suffix (base, ".xcf") || g_str_has_suffix (base, ".xcf.gz") ||
+                  g_str_has_suffix (base, ".xcf.bz2") || g_str_has_suffix (base, ".xcf.xz"))
+                gimp_image_set_file (image, orig);
+              else
+                gimp_image_set_imported_file (image, orig);
+              g_free (base);
+              g_object_unref (orig);
+            }
+          g_strfreev (lines);
+        }
+      if (image)
+        gimp_image_dirty (image, GIMP_DIRTY_IMAGE);
+
+      g_free (info);
+      g_free (txt);
+      g_object_unref (file);
+    }
+}
+
+static void
+recovery_delete (Recovery *r)
+{
+  GSList *iter;
+
+  for (iter = r->files; iter; iter = iter->next)
+    {
+      const gchar *xcf = iter->data;
+      gchar       *txt = sidecar (xcf);
+
+      g_unlink (xcf);
+      g_unlink (txt);
+      g_free (txt);
+    }
+}
+
+static void
+recovery_response (GtkDialog *dialog,
+                   gint       response,
+                   Recovery  *r)
+{
+  if (response == GTK_RESPONSE_ACCEPT)
+    {
+      recovery_open (r);
+      recovery_delete (r);
+    }
+  else if (response == GTK_RESPONSE_REJECT)
+    {
+      recovery_delete (r);
+    }
+  /*  « Plus tard » : les copies restent dans autosave/recuperation/  */
+
+  gtk_widget_destroy (GTK_WIDGET (dialog));
+}
+
+static gboolean
+recovery_dialog (gpointer data)
+{
+  Recovery  *r = data;
+  GtkWidget *dialog;
+  GString   *names = g_string_new (NULL);
+  GSList    *iter;
+
+  recovery_timer_id = 0;
+  recovery_pending  = NULL;
+
+  for (iter = r->files; iter; iter = iter->next)
+    {
+      const gchar *xcf  = iter->data;
+      gchar       *txt  = sidecar (xcf);
+      gchar       *info = NULL;
+
+      if (g_file_get_contents (txt, &info, NULL, NULL))
+        {
+          gchar *nl = strchr (info, '\n');
+
+          if (nl)
+            *nl = '\0';
+          g_string_append_printf (names, "  • %s\n", info);
+        }
+      else
+        {
+          g_string_append_printf (names, "  • %s\n", xcf);
+        }
+      g_free (info);
+      g_free (txt);
+    }
+
+  dialog = gtk_message_dialog_new (NULL, 0, GTK_MESSAGE_QUESTION, GTK_BUTTONS_NONE,
+                                   "Documents non enregistrés de la session précédente");
+  gtk_message_dialog_format_secondary_text (GTK_MESSAGE_DIALOG (dialog),
+                                            "ChopGimp ne s'est pas fermé normalement. "
+                                            "Copies enregistrées automatiquement :\n\n%s\n"
+                                            "Les rouvrir ? (marquées modifiées, à enregistrer)",
+                                            names->str);
+  gtk_window_set_title (GTK_WINDOW (dialog), "Récupération");
+  gtk_dialog_add_buttons (GTK_DIALOG (dialog),
+                          "_Supprimer",  GTK_RESPONSE_REJECT,
+                          "_Plus tard",  GTK_RESPONSE_CANCEL,
+                          "_Rouvrir",    GTK_RESPONSE_ACCEPT,
+                          NULL);
+  gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_ACCEPT);
+  g_signal_connect_data (dialog, "response", G_CALLBACK (recovery_response),
+                         r, (GClosureNotify) recovery_free, 0);
+  gtk_widget_show (dialog);
+  g_string_free (names, TRUE);
+
+  return G_SOURCE_REMOVE;
+}
+
+
+void
+chopgimp_autosave_init (Gimp *gimp)
+{
+  gchar       *recup;
+  GDir        *dir;
+  const gchar *name;
+  Recovery    *r;
+  gchar       *minutes;
+  gint         m;
+
+  autosave_dir = g_build_filename (gimp_directory (), "autosave", NULL);
+  recup        = g_build_filename (autosave_dir, "recuperation", NULL);
+  g_mkdir_with_parents (recup, 0700);
+  saved_times  = g_hash_table_new_full (NULL, NULL, NULL, g_free);
+
+  /*  leftovers of an interrupted session: aside, for the recovery dialog
+   *  (image ids start again at 1 in this session)
+   */
+  if ((dir = g_dir_open (autosave_dir, 0, NULL)))
+    {
+      while ((name = g_dir_read_name (dir)))
+        {
+          if (g_str_has_suffix (name, ".xcf") || g_str_has_suffix (name, ".txt"))
+            {
+              gchar *src   = g_build_filename (autosave_dir, name, NULL);
+              gchar *stamp = g_strdup_printf ("%" G_GINT64_FORMAT "-%s",
+                                              g_get_real_time () / 1000000, name);
+              gchar *dst   = g_build_filename (recup, stamp, NULL);
+
+              g_rename (src, dst);
+              g_free (src);
+              g_free (stamp);
+              g_free (dst);
+            }
+          else if (g_str_has_suffix (name, ".part"))
+            {
+              gchar *src = g_build_filename (autosave_dir, name, NULL);
+
+              g_unlink (src);
+              g_free (src);
+            }
+        }
+      g_dir_close (dir);
+    }
+
+  r = g_new0 (Recovery, 1);
+  r->gimp = gimp;
+  if ((dir = g_dir_open (recup, 0, NULL)))
+    {
+      while ((name = g_dir_read_name (dir)))
+        if (g_str_has_suffix (name, ".xcf"))
+          r->files = g_slist_prepend (r->files, g_build_filename (recup, name, NULL));
+      g_dir_close (dir);
+    }
+  if (r->files)
+    {
+      recovery_pending  = r;
+      recovery_timer_id = g_timeout_add_seconds (4, recovery_dialog, r);
+    }
+  else
+    recovery_free (r);
+  g_free (recup);
+
+  minutes = chopgimp_rc_get_string ("autosave", "minutes", "5");
+  m = atoi (minutes);
+  g_free (minutes);
+  if (m > 0)
+    {
+      period = m * 60;
+      input_hook_id = g_signal_add_emission_hook (g_signal_lookup ("event", GTK_TYPE_WIDGET),
+                                                  0, autosave_input_hook, NULL, NULL);
+      autosave_schedule (gimp, period);
+    }
+}
+
+void
+chopgimp_autosave_exit (void)
+{
+  GDir        *dir;
+  const gchar *name;
+
+  if (timer_id)
+    g_source_remove (timer_id);
+  timer_id = 0;
+
+  if (input_hook_id)
+    g_signal_remove_emission_hook (g_signal_lookup ("event", GTK_TYPE_WIDGET),
+                                   input_hook_id);
+  input_hook_id = 0;
+
+  /*  recovery dialog never shown: its copies stay in recuperation/  */
+  if (recovery_timer_id)
+    {
+      g_source_remove (recovery_timer_id);
+      recovery_free (recovery_pending);
+    }
+  recovery_timer_id = 0;
+  recovery_pending  = NULL;
+
+  if (! autosave_dir || ! (dir = g_dir_open (autosave_dir, 0, NULL)))
+    return;
+
+  /*  normal exit: this session's copies are no longer needed  */
+  while ((name = g_dir_read_name (dir)))
+    if (g_str_has_suffix (name, ".xcf") || g_str_has_suffix (name, ".txt") ||
+        g_str_has_suffix (name, ".part"))
+      {
+        gchar *path = g_build_filename (autosave_dir, name, NULL);
+
+        g_unlink (path);
+        g_free (path);
+      }
+  g_dir_close (dir);
+}
