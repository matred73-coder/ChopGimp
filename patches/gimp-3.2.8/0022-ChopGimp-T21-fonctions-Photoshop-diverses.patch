+/*  ChopGimp: the brush mask modulated by the paper grain, in canvas
+ *  coordinates (the grain stays still on the sheet; x0, y0 are canvas
+ *  coordinates of the mask's top-left pixel). Returns a scratch mask owned
+ *  by @core (valid until the next dab), or NULL when there is no texture.
+ */
+static const GimpTempBuf *
+chopgimp_paper_mask (GimpBrushCore     *core,
+                     const GimpTempBuf *mask,
+                     gint               x0,
+                     gint               y0)
+{
+  static const Babl *y_float = NULL;
+  const gfloat      *src;
+  gfloat            *dest;
+  gint              *cols;
+  gint               w, h, i, j;
+  gdouble            k, s;
+
+  if (! y_float)
+    y_float = babl_format ("Y float");
+
+  if (! core->paper || gimp_temp_buf_get_format (mask) != y_float)
+    return NULL;
+
+  w = gimp_temp_buf_get_width  (mask);
+  h = gimp_temp_buf_get_height (mask);
+  k = 1.0 / MAX (core->paper_scale, 0.01);
+  s = core->paper_strength;
+
+  /*  the pasted mask is used synchronously by gimp_paint_core_paste(),
+   *  so one output buffer per core is enough
+   */
+  if (! core->paper_scratch                                ||
+      gimp_temp_buf_get_width  (core->paper_scratch) != w ||
+      gimp_temp_buf_get_height (core->paper_scratch) != h)
+    {
+      g_clear_pointer (&core->paper_scratch, gimp_temp_buf_unref);
+      core->paper_scratch = gimp_temp_buf_new (w, h, y_float);
+    }
+
+  if (core->paper_cols_len < w)
+    {
+      g_free (core->paper_cols);
+      core->paper_cols     = g_new (gint, w);
+      core->paper_cols_len = w;
+    }
+
+  src  = (const gfloat *) gimp_temp_buf_get_data (mask);
+  dest = (gfloat *) gimp_temp_buf_get_data (core->paper_scratch);
+  cols = core->paper_cols;
+
+  for (i = 0; i < w; i++)
+    {
+      gint px = ((gint) floor ((x0 + i) * k)) % core->paper_w;
+
+      if (px < 0)
+        px += core->paper_w;
+
+      cols[i] = px;
+    }
+
+  for (j = 0; j < h; j++)
+    {
+      gint          py  = ((gint) floor ((y0 + j) * k)) % core->paper_h;
+      const gfloat *row;
+      const gfloat *in;
+      gfloat       *out;
+
+      if (py < 0)
+        py += core->paper_h;
+
+      row = core->paper + py * core->paper_w;
+      in  = src  + j * w;
+      out = dest + j * w;
+
+      for (i = 0; i < w; i++)
+        out[i] = in[i] * (gfloat) (1.0 - s + s * row[cols[i]]);
+    }
+
+  return core->paper_scratch;
+}
