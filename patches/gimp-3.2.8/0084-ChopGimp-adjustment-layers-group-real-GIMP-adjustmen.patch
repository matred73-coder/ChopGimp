+/*  ChopGimp: adjustment layer (Photoshop). A group « ◐ name » takes the
+ *  selected layer and every layer below it (same parent); the group is
+ *  selected and the GIMP adjustment is started on it: a filter on a group
+ *  always stays an editable non-destructive filter (fx), with its full
+ *  dialog and live preview. Opacity / visibility of the group act as those
+ *  of the adjustment.
+ */
+void
+layers_adjustment_cmd_callback (GimpAction *action,
+                                GVariant   *value,
+                                gpointer    data)
+{
+  static const struct { const gchar *label; const gchar *filter; } adjustments[] =
+  {
+    { "Niveaux", "filters-levels" },
+    { "Courbes", "filters-curves" },
+    { "Luminosité/Contraste", "filters-brightness-contrast" },
+    { "Exposition", "filters-exposure" },
+    { "Vibrance", "filters-saturation" },
+    { "Teinte/Saturation", "filters-hue-saturation" },
+    { "Balance des couleurs", "filters-color-balance" },
+    { "Noir et blanc", "filters-mono-mixer" },
+    { "Filtre photo", "filters-color-temperature" },
+    { "Mélangeur de couches", "filters-channel-mixer" },
+    { "Coloriser", "filters-colorize" },
+    { "Négatif", "filters-invert-perceptual" },
+    { "Isohélie", "filters-posterize" },
+    { "Seuil", "filters-threshold" },
+    { "Tons foncés/Tons clairs", "filters-shadows-highlights" },
+  };
+  GimpImage     *image;
+  GimpLayer     *layer;
+  GimpLayer     *parent;
+  GimpLayer     *group;
+  GimpContainer *container;
+  GList         *below = NULL;
+  GList         *iter;
+  GList         *sel;
+  gint           index, n, i;
+  gchar         *name;
+  return_if_no_image (image, data);
+
+  index = g_variant_get_int32 (value);
+  if (index < 0 || index >= (gint) G_N_ELEMENTS (adjustments))
+    return;
+
+  sel = gimp_image_get_selected_layers (image);
+  if (g_list_length (sel) != 1)
+    return;
+
+  layer     = sel->data;
+  parent    = GIMP_LAYER (gimp_item_get_parent (GIMP_ITEM (layer)));
+  container = gimp_item_get_container (GIMP_ITEM (layer));
+  n         = gimp_container_get_n_children (container);
+
+  for (i = gimp_item_get_index (GIMP_ITEM (layer)); i < n; i++)
+    below = g_list_append (below, gimp_container_get_child_by_index (container, i));
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_LAYER_ADD,
+                               _("Nouveau calque de réglage"));
+
+  group = gimp_group_layer_new (image);
+  name  = g_strdup_printf ("◐ %s", adjustments[index].label);
+  gimp_object_take_name (GIMP_OBJECT (group), name);
+  gimp_image_add_layer (image, group, parent, gimp_item_get_index (GIMP_ITEM (layer)), TRUE);
+
+  for (iter = below, i = 0; iter; iter = iter->next, i++)
+    gimp_image_reorder_item (image, iter->data, GIMP_ITEM (group), i, TRUE, NULL);
+
+  sel = g_list_prepend (NULL, group);
+  gimp_image_set_selected_layers (image, sel);
+  g_list_free (sel);
+  g_list_free (below);
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+
+  /*  the real adjustment dialog, on the group  */
+  gimp_ui_manager_activate_action (menus_get_image_manager_singleton (image->gimp),
+                                   "filters", adjustments[index].filter);
+}
