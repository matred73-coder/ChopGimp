@@ -0,0 +1,649 @@
+/* ChopGimp — journal de session et traceur de plantage
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * 1. Journal de session : la sortie d'erreur (et standard) du processus,
+ *    héritée par les plug-ins, passe par un tube ; un fil la recopie,
+ *    horodatée, dans <gimpdir>/logs/session-AAAAMMJJ-HHMMSS.log (10
+ *    dernières sessions gardées) et dans la sortie d'origine.
+ *
+ * 2. Rapport de plantage : SIGSEGV, SIGBUS, SIGFPE, SIGILL et SIGABRT,
+ *    dans n'importe quel fil, écrivent <gimpdir>/CrashLog/
+ *    chopgimp-crash-<date>.txt AVANT le traitement de GIMP (qui alloue de
+ *    la mémoire et lance un débogueur, et peut donc échouer quand le tas
+ *    est abîmé). Le gestionnaire n'utilise que des appels sûrs dans un
+ *    signal (write, open, read…) plus backtrace() / dladdr(), préchargés
+ *    au démarrage, sur une pile de secours (débordement de pile).
+ *    Contenu : signal et adresse, fil, plug-in en cours, dernières
+ *    actions, images ouvertes, mémoire, pile d'appels (module + décalage,
+ *    à traduire par tools/crash_symbolize.sh), fin du journal.
+ *
+ * 3. Au démarrage suivant, chopgimp_crash_take_previous() rend le rapport
+ *    non encore vu (fenêtre « ChopGimp s'est arrêté… »).
+ */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE 1            /* dladdr(), Dl_info */
+#endif
+
+#include "config.h"
+
+#include <string.h>
+#include <time.h>
+
+#include <glib.h>
+#include <glib/gstdio.h>
+#include <gio/gio.h>
+
+#ifndef G_OS_WIN32
+#include <dlfcn.h>
+#include <execinfo.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+
+#include "libgimpbase/gimpbase.h"
+
+#include "chopgimp-crash.h"
+
+
+#define N_ACTIONS  16
+#define ACTION_LEN 64
+#define KEEP_LOGS  10
+
+static gchar  *log_path  = NULL;
+static gchar  *crash_dir = NULL;
+static gchar  *seen_path = NULL;
+static gchar   version[64] = "?";
+#ifndef G_OS_WIN32
+static gchar   exe_path[512] = "";
+#endif
+
+#ifndef G_OS_WIN32
+
+static gint    log_fd    = -1;
+static gint    orig_err  = -1;
+static pid_t   main_tid  = 0;
+
+static gchar   ctx_plugin[256];
+static gchar   ctx_images[2048];
+static gchar   ctx_actions[N_ACTIONS][ACTION_LEN];
+static volatile gint ctx_action_next = 0;
+
+static volatile sig_atomic_t in_handler = 0;
+
+static struct sigaction old_actions[NSIG];
+
+static const gint fatal_signals[] = { SIGSEGV, SIGBUS, SIGFPE, SIGILL, SIGABRT };
+
+
+/*  écriture sûre dans un gestionnaire de signal  */
+
+static void
+w_str (gint fd, const gchar *s)
+{
+  gsize n = strlen (s);
+
+  while (n > 0)
+    {
+      gssize r = write (fd, s, n);
+
+      if (r <= 0)
+        return;
+      s += r;
+      n -= r;
+    }
+}
+
+static void
+w_num (gint fd, guint64 v, guint base, gint width)
+{
+  gchar buf[32];
+  gint  i = sizeof (buf) - 1;
+
+  buf[i] = '\0';
+  do
+    {
+      buf[--i] = "0123456789abcdef"[v % base];
+      v /= base;
+      width--;
+    }
+  while ((v || width > 0) && i > 0);
+
+  w_str (fd, buf + i);
+}
+
+static void
+w_hex (gint fd, guint64 v)
+{
+  w_str (fd, "0x");
+  w_num (fd, v, 16, 1);
+}
+
+static const gchar *
+signal_name (gint sig)
+{
+  switch (sig)
+    {
+    case SIGSEGV: return "SIGSEGV (accès mémoire invalide)";
+    case SIGBUS:  return "SIGBUS (erreur de bus)";
+    case SIGFPE:  return "SIGFPE (erreur arithmétique)";
+    case SIGILL:  return "SIGILL (instruction illégale)";
+    case SIGABRT: return "SIGABRT (arrêt demandé : erreur fatale ou assertion)";
+    }
+  return "signal inconnu";
+}
+
+/*  copie un fichier (ex. /proc/self/status) en ne gardant que certaines
+ *  lignes (préfixes), ou tout si prefixes == NULL
+ */
+static void
+w_file (gint fd, const gchar *path, off_t from_end, const gchar **prefixes)
+{
+  gchar  buf[4096];
+  gint   in = open (path, O_RDONLY);
+  gssize n;
+
+  if (in < 0)
+    return;
+
+  if (from_end > 0)
+    {
+      off_t size = lseek (in, 0, SEEK_END);
+
+      lseek (in, size > from_end ? size - from_end : 0, SEEK_SET);
+    }
+
+  if (! prefixes)
+    {
+      while ((n = read (in, buf, sizeof (buf))) > 0)
+        if (write (fd, buf, n) < 0)
+          break;
+    }
+  else
+    {
+      /*  /proc/self/status est petit : une lecture suffit  */
+      gchar *line, *end;
+
+      n = read (in, buf, sizeof (buf) - 1);
+      if (n > 0)
+        {
+          buf[n] = '\0';
+          for (line = buf; line && *line; line = end)
+            {
+              const gchar **p;
+
+              end = strchr (line, '\n');
+              if (end)
+                *end++ = '\0';
+              for (p = prefixes; *p; p++)
+                if (! strncmp (line, *p, strlen (*p)))
+                  {
+                    w_str (fd, "  ");
+                    w_str (fd, line);
+                    w_str (fd, "\n");
+                  }
+            }
+        }
+    }
+  close (in);
+}
+
+static void
+write_report (gint sig, siginfo_t *info)
+{
+  static const gchar *mem[] = { "VmPeak", "VmHWM", "VmRSS", "VmSwap", "Threads", NULL };
+  gchar   path[1024];
+  void   *frames[64];
+  gint    n_frames, i, fd;
+  time_t  t = time (NULL);
+  pid_t   tid = syscall (SYS_gettid);
+
+  if (! crash_dir)
+    return;
+
+  /*  chemin : <crash_dir>/chopgimp-crash-<secondes>.txt (sans printf)  */
+  path[0] = '\0';
+  g_strlcat (path, crash_dir, sizeof (path));
+  g_strlcat (path, "/chopgimp-crash-", sizeof (path));
+  {
+    gchar  num[24];
+    gint   k = sizeof (num) - 1;
+    guint64 v = (guint64) t;
+
+    num[k] = '\0';
+    do { num[--k] = '0' + v % 10; v /= 10; } while (v && k > 0);
+    g_strlcat (path, num + k, sizeof (path));
+  }
+  g_strlcat (path, ".txt", sizeof (path));
+
+  fd = open (path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+  if (fd < 0)
+    fd = orig_err >= 0 ? orig_err : 2;
+
+  w_str (fd, "ChopGimp ");
+  w_str (fd, version);
+  w_str (fd, " (GIMP " GIMP_APP_VERSION_STRING ") — rapport de plantage\n");
+  w_str (fd, "Date (secondes depuis 1970) : ");
+  w_num (fd, (guint64) t, 10, 1);
+  w_str (fd, "\nSignal : ");
+  w_str (fd, signal_name (sig));
+  if (info && (sig == SIGSEGV || sig == SIGBUS || sig == SIGFPE || sig == SIGILL))
+    {
+      w_str (fd, " à l'adresse ");
+      w_hex (fd, (guint64) (guintptr) info->si_addr);
+    }
+  w_str (fd, "\nFil : ");
+  w_num (fd, (guint64) tid, 10, 1);
+  w_str (fd, tid == main_tid ? " (fil principal)\n" : " (fil de calcul)\n");
+
+  w_str (fd, "\n== Plug-in ==\n  ");
+  w_str (fd, ctx_plugin[0] ? ctx_plugin : "aucun");
+
+  w_str (fd, "\n\n== Dernières actions (la plus récente en bas) ==\n");
+  for (i = 0; i < N_ACTIONS; i++)
+    {
+      const gchar *a = ctx_actions[(ctx_action_next + i) % N_ACTIONS];
+
+      if (a[0])
+        {
+          w_str (fd, "  ");
+          w_str (fd, a);
+          w_str (fd, "\n");
+        }
+    }
+
+  w_str (fd, "\n== Images ouvertes ==\n");
+  w_str (fd, ctx_images[0] ? ctx_images : "  (inconnu)\n");
+
+  w_str (fd, "\n== Mémoire ==\n");
+  w_file (fd, "/proc/self/status", 0, mem);
+
+  w_str (fd, "\n== Pile d'appels (module +décalage [symbole]) ==\n");
+  n_frames = backtrace (frames, G_N_ELEMENTS (frames));
+  for (i = 0; i < n_frames; i++)
+    {
+      Dl_info dl;
+
+      w_str (fd, "  #");
+      w_num (fd, i, 10, 2);
+      w_str (fd, " ");
+      if (dladdr (frames[i], &dl) && dl.dli_fname)
+        {
+          /*  le programme lui-même est nommé par argv[0] : chemin réel  */
+          w_str (fd, (! strchr (dl.dli_fname, '/') && exe_path[0]) ? exe_path : dl.dli_fname);
+          w_str (fd, " +");
+          w_hex (fd, (guint64) ((guintptr) frames[i] - (guintptr) dl.dli_fbase));
+          if (dl.dli_sname)
+            {
+              w_str (fd, " [");
+              w_str (fd, dl.dli_sname);
+              w_str (fd, "+");
+              w_hex (fd, (guint64) ((guintptr) frames[i] - (guintptr) dl.dli_saddr));
+              w_str (fd, "]");
+            }
+        }
+      else
+        {
+          w_hex (fd, (guint64) (guintptr) frames[i]);
+        }
+      w_str (fd, "\n");
+    }
+
+  if (log_path)
+    {
+      w_str (fd, "\n== Fin du journal de la session (");
+      w_str (fd, log_path);
+      w_str (fd, ") ==\n");
+      w_file (fd, log_path, 12000, NULL);
+    }
+
+  w_str (fd, "\n== Fin du rapport ==\n");
+
+  if (fd != orig_err && fd != 2)
+    close (fd);
+
+  if (orig_err >= 0)
+    {
+      w_str (orig_err, "\nChopGimp : plantage, rapport écrit dans ");
+      w_str (orig_err, path);
+      w_str (orig_err, "\n");
+    }
+}
+
+static void
+crash_handler (gint sig, siginfo_t *info, void *ucontext)
+{
+  struct sigaction *old = &old_actions[sig];
+
+  if (! in_handler)
+    {
+      struct timespec pause = { 0, 80 * 1000 * 1000 };
+
+      in_handler = 1;
+      /*  laisser le fil du journal recopier le dernier message (g_error)  */
+      nanosleep (&pause, NULL);
+      write_report (sig, info);
+    }
+
+  /*  puis le traitement de GIMP (ou celui par défaut)  */
+  sigaction (sig, old, NULL);
+
+  if (old->sa_flags & SA_SIGINFO)
+    {
+      if (old->sa_sigaction)
+        old->sa_sigaction (sig, info, ucontext);
+    }
+  else if (old->sa_handler != SIG_DFL && old->sa_handler != SIG_IGN)
+    {
+      old->sa_handler (sig);
+    }
+
+  signal (sig, SIG_DFL);
+  raise (sig);
+}
+
+
+/*  journal de session : fil de recopie du tube  */
+
+static gpointer
+tee_thread (gpointer data)
+{
+  gint     in    = GPOINTER_TO_INT (data);
+  gboolean bol   = TRUE;
+  gchar    buf[4096];
+  gssize   n;
+
+  while ((n = read (in, buf, sizeof (buf))) > 0)
+    {
+      gchar *p = buf, *end = buf + n;
+
+      if (orig_err >= 0 && write (orig_err, buf, n) < 0)
+        {
+          /*  sortie d'origine fermée : on continue avec le fichier seul  */
+        }
+
+      /*  horodatage au début de chaque ligne  */
+      while (p < end)
+        {
+          gchar *nl = memchr (p, '\n', end - p);
+          gchar *stop = nl ? nl + 1 : end;
+
+          if (bol)
+            {
+              GDateTime *now = g_date_time_new_now_local ();
+              gchar     *ts  = g_date_time_format (now, "%H:%M:%S ");
+
+              w_str (log_fd, ts);
+              g_free (ts);
+              g_date_time_unref (now);
+            }
+          if (write (log_fd, p, stop - p) < 0)
+            break;
+          bol = nl != NULL;
+          p = stop;
+        }
+    }
+
+  return NULL;
+}
+
+static gint
+compare_names (gconstpointer a, gconstpointer b)
+{
+  return strcmp (*(const gchar **) a, *(const gchar **) b);
+}
+
+static void
+rotate_logs (const gchar *dir)
+{
+  GDir        *d = g_dir_open (dir, 0, NULL);
+  GPtrArray   *names;
+  const gchar *name;
+  guint        i;
+
+  if (! d)
+    return;
+
+  names = g_ptr_array_new_with_free_func (g_free);
+  while ((name = g_dir_read_name (d)))
+    if (g_str_has_prefix (name, "session-") && g_str_has_suffix (name, ".log"))
+      g_ptr_array_add (names, g_strdup (name));
+  g_dir_close (d);
+
+  g_ptr_array_sort (names, compare_names);
+  for (i = 0; i + (KEEP_LOGS - 1) < names->len; i++)
+    {
+      gchar *p = g_build_filename (dir, g_ptr_array_index (names, i), NULL);
+
+      g_unlink (p);
+      g_free (p);
+    }
+  g_ptr_array_free (names, TRUE);
+}
+
+#endif /* ! G_OS_WIN32 */
+
+
+void
+chopgimp_crash_init (void)
+{
+  gchar *log_dir;
+
+  crash_dir = g_build_filename (gimp_directory (), "CrashLog", NULL);
+  seen_path = g_build_filename (crash_dir, ".vu", NULL);
+  log_dir   = g_build_filename (gimp_directory (), "logs", NULL);
+  g_mkdir_with_parents (crash_dir, 0700);
+  g_mkdir_with_parents (log_dir, 0700);
+
+  {
+    gchar *vfile = g_build_filename (gimp_installation_directory (), "share", "chopgimp", "VERSION", NULL);
+    gchar *text  = NULL;
+
+    if (g_file_get_contents (vfile, &text, NULL, NULL))
+      g_strlcpy (version, g_strstrip (text), sizeof (version));
+    g_free (text);
+    g_free (vfile);
+  }
+
+#ifndef G_OS_WIN32
+  main_tid = syscall (SYS_gettid);
+  {
+    gssize n = readlink ("/proc/self/exe", exe_path, sizeof (exe_path) - 1);
+
+    exe_path[n > 0 ? n : 0] = '\0';
+  }
+
+  if (! g_getenv ("CHOPGIMP_NO_SESSION_LOG"))
+    {
+      GDateTime *now  = g_date_time_new_now_local ();
+      gchar     *base = g_date_time_format (now, "session-%Y%m%d-%H%M%S.log");
+      gint       fds[2];
+
+      rotate_logs (log_dir);
+      log_path = g_build_filename (log_dir, base, NULL);
+      g_free (base);
+      g_date_time_unref (now);
+
+      log_fd = open (log_path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644);
+
+      if (log_fd >= 0 && pipe (fds) == 0)
+        {
+          gchar *head = g_strdup_printf ("ChopGimp %s — début de session (pid %d)\n",
+                                         version, (gint) getpid ());
+
+          orig_err = dup (2);
+          fcntl (orig_err, F_SETFD, FD_CLOEXEC);
+          fcntl (fds[0], F_SETFD, FD_CLOEXEC);
+          dup2 (fds[1], 2);
+          dup2 (fds[1], 1);
+          close (fds[1]);
+          setvbuf (stdout, NULL, _IOLBF, 0);
+
+          g_thread_unref (g_thread_new ("chopgimp-log", tee_thread,
+                                        GINT_TO_POINTER (fds[0])));
+          w_str (2, head);
+          g_free (head);
+        }
+      else
+        {
+          g_clear_pointer (&log_path, g_free);
+          if (log_fd >= 0)
+            close (log_fd);
+          log_fd = -1;
+        }
+    }
+
+  /*  précharger backtrace() et dladdr() (libgcc, chargeur) hors signal  */
+  {
+    void    *f[4];
+    Dl_info  dl;
+
+    backtrace (f, 4);
+    dladdr ((void *) chopgimp_crash_init, &dl);
+  }
+
+  /*  pile de secours : un débordement de pile reste tracé  */
+  {
+    stack_t ss;
+
+    ss.ss_size  = 256 * 1024;
+    ss.ss_sp    = g_malloc (ss.ss_size);
+    ss.ss_flags = 0;
+    sigaltstack (&ss, NULL);
+  }
+
+  {
+    struct sigaction sa;
+    guint            i;
+
+    memset (&sa, 0, sizeof (sa));
+    sa.sa_sigaction = crash_handler;
+    sa.sa_flags     = SA_SIGINFO | SA_ONSTACK;
+    sigemptyset (&sa.sa_mask);
+
+    for (i = 0; i < G_N_ELEMENTS (fatal_signals); i++)
+      sigaction (fatal_signals[i], &sa, &old_actions[fatal_signals[i]]);
+  }
+#endif
+
+  g_free (log_dir);
+}
+
+void
+chopgimp_crash_note_plugin (const gchar *procedure,
+                            gboolean     running)
+{
+#ifndef G_OS_WIN32
+  if (running)
+    {
+      GDateTime *now = g_date_time_new_now_local ();
+      gchar     *ts  = g_date_time_format (now, "%H:%M:%S");
+
+      g_snprintf (ctx_plugin, sizeof (ctx_plugin), "%s (en cours depuis %s)", procedure, ts);
+      g_free (ts);
+      g_date_time_unref (now);
+    }
+  else
+    {
+      g_snprintf (ctx_plugin, sizeof (ctx_plugin), "aucun (dernier : %s, terminé)", procedure);
+    }
+  if (log_fd >= 0)
+    g_printerr ("[plug-in] %s %s\n", procedure, running ? "lancé" : "terminé");
+#endif
+}
+
+void
+chopgimp_crash_note_action (const gchar *action)
+{
+#ifndef G_OS_WIN32
+  gint i = ctx_action_next;
+
+  g_strlcpy (ctx_actions[i], action, ACTION_LEN);
+  ctx_action_next = (i + 1) % N_ACTIONS;
+  if (log_fd >= 0)
+    g_printerr ("[action] %s\n", action);
+#endif
+}
+
+void
+chopgimp_crash_note_images (const gchar *summary)
+{
+#ifndef G_OS_WIN32
+  /*  écrit d'un bloc : le gestionnaire peut lire une version partielle,
+   *  jamais déborder (terminée par \0)
+   */
+  g_strlcpy (ctx_images, summary, sizeof (ctx_images));
+#endif
+}
+
+const gchar *
+chopgimp_crash_log_path (void)
+{
+  return log_path;
+}
+
+const gchar *
+chopgimp_crash_dir (void)
+{
+  return crash_dir;
+}
+
+gchar *
+chopgimp_crash_take_previous (void)
+{
+  GDir        *d;
+  const gchar *name;
+  gchar       *best      = NULL;
+  gint64       best_time = 0;
+  GStatBuf     st;
+  gint64       seen      = 0;
+  gchar       *contents  = NULL;
+
+  if (! crash_dir || ! (d = g_dir_open (crash_dir, 0, NULL)))
+    return NULL;
+
+  if (g_stat (seen_path, &st) == 0)
+    seen = st.st_mtime;
+
+  while ((name = g_dir_read_name (d)))
+    {
+      gchar *p;
+
+      if (! g_str_has_prefix (name, "chopgimp-crash-"))
+        continue;
+      p = g_build_filename (crash_dir, name, NULL);
+      if (g_stat (p, &st) == 0 && st.st_mtime > seen && st.st_mtime > best_time)
+        {
+          g_free (best);
+          best      = p;
+          best_time = st.st_mtime;
+        }
+      else
+        {
+          g_free (p);
+        }
+    }
+  g_dir_close (d);
+
+  if (best)
+    {
+      gchar *text = NULL;
+
+      if (g_file_get_contents (best, &text, NULL, NULL))
+        contents = g_strdup_printf ("%s\n%s", best, text);
+      g_free (text);
+      g_free (best);
+    }
+
+  /*  marquer comme vu  */
+  g_file_set_contents (seen_path, "", 0, NULL);
+
+  return contents;
+}
diff --git a/app/chopgimp-crash.h b/app/chopgimp-crash.h
new file mode 100644
index 0000000..8aee030
--- /dev/null
+++ b/app/chopgimp-crash.h
@@ -0,0 +1,30 @@
+/* ChopGimp — journal de session et traceur de plantage
