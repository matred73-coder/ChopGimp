+#ifndef __CHOPGIMP_CRASH_H__
+#define __CHOPGIMP_CRASH_H__
+
+/*  au tout début de main(), après gimp_init_signal_handlers()  */
+void   chopgimp_crash_init          (void);
+
+/*  contexte noté dans le journal et repris dans le rapport de plantage  */
+void   chopgimp_crash_note_plugin   (const gchar *procedure,
+                                     gboolean     running);
+void   chopgimp_crash_note_action   (const gchar *action);
+void   chopgimp_crash_note_images   (const gchar *summary);
+
+/*  chemin du journal de la session (NULL si désactivé)  */
+const gchar * chopgimp_crash_log_path      (void);
+const gchar * chopgimp_crash_dir           (void);
+
+/*  rapport de la session précédente non encore vu (à libérer) ou NULL ;
+ *  le marque comme vu
+ */
+gchar       * chopgimp_crash_take_previous (void);
+
+#endif /* __CHOPGIMP_CRASH_H__ */
