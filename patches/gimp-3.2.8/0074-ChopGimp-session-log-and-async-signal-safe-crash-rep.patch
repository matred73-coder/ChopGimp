+/*  ChopGimp: traceur de plantage — images ouvertes (repris dans le
+ *  rapport) et rapport de la session précédente au démarrage
+ */
+static gboolean
+chopgimp_crash_images_tick (gpointer data)
+{
+  static gchar *previous = NULL;
+  Gimp         *gimp     = data;
+  GString      *str      = g_string_new (NULL);
+  GList        *list;
+
+  for (list = gimp_get_image_iter (gimp); list; list = g_list_next (list))
+    {
+      GimpImage *image = list->data;
+
+      g_string_append_printf (str, "  %s — %d×%d, %d calques, %s %d bits\n",
+                              gimp_image_get_display_name (image),
+                              gimp_image_get_width (image),
+                              gimp_image_get_height (image),
+                              gimp_image_get_n_layers (image),
+                              gimp_image_get_base_type (image) == GIMP_RGB ? "RVB" :
+                              gimp_image_get_base_type (image) == GIMP_GRAY ? "gris" : "indexé",
+                              babl_format_get_bytes_per_pixel (gimp_image_get_layer_format (image, FALSE)) * 8 /
+                              babl_format_get_n_components (gimp_image_get_layer_format (image, FALSE)));
+    }
+  if (! str->len)
+    g_string_append (str, "  aucune\n");
+
+  if (g_strcmp0 (previous, str->str))
+    {
+      chopgimp_crash_note_images (str->str);
+      g_printerr ("[images]\n%s", str->str);
+      g_free (previous);
+      previous = g_strdup (str->str);
+    }
+  g_string_free (str, TRUE);
+
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+chopgimp_crash_dialog_response (GtkDialog *dialog,
+                                gint       response,
+                                gchar     *report)
+{
+  if (response == 1)
+    {
+      gtk_clipboard_set_text (gtk_clipboard_get (GDK_SELECTION_CLIPBOARD), report, -1);
+      return;
+    }
+  if (response == 2)
+    {
+      gchar *uri = g_filename_to_uri (chopgimp_crash_dir (), NULL, NULL);
+
+      if (uri)
+        gtk_show_uri_on_window (GTK_WINDOW (dialog), uri, GDK_CURRENT_TIME, NULL);
+      g_free (uri);
+      return;
+    }
+  gtk_widget_destroy (GTK_WIDGET (dialog));
+}
+
+/*  test du traceur (banc de test seulement) : CHOPGIMP_CRASH_TEST=N plante
+ *  le fil principal au bout de N secondes, =tN un fil de calcul
+ */
+static gpointer
+chopgimp_crash_test_now (gpointer data)
+{
+  volatile gint *nowhere = NULL;
+
+  *nowhere = 1;
+  return NULL;
+}
+
+static gboolean
+chopgimp_crash_test (gpointer data)
+{
+  if (GPOINTER_TO_INT (data))
+    g_thread_new ("chopgimp-crash-test", chopgimp_crash_test_now, NULL);
+  else
+    chopgimp_crash_test_now (NULL);
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+chopgimp_crash_previous (gpointer data)
+{
+  gchar     *report = chopgimp_crash_take_previous ();
+  GtkWidget *dialog;
+  gchar     *path, *nl, *details;
+
+  if (! report)
+    return G_SOURCE_REMOVE;
+
+  /*  1re ligne : chemin du rapport ; puis le signal et le plug-in  */
+  path = g_strdup (report);
+  if ((nl = strchr (path, '\n')))
+    *nl = '\0';
+  details = NULL;
+  {
+    gchar **lines = g_strsplit (report, "\n", 12);
+    GString *s = g_string_new (NULL);
+    gint     i;
+
+    for (i = 0; lines[i]; i++)
+      if (g_str_has_prefix (lines[i], "Signal") || g_str_has_prefix (lines[i], "Fil") ||
+          (i > 0 && g_str_has_prefix (lines[i - 1], "== Plug-in")))
+        g_string_append_printf (s, "%s\n", g_strstrip (lines[i]));
+    g_strfreev (lines);
+    details = g_string_free (s, FALSE);
+  }
+
+  dialog = gtk_message_dialog_new (NULL, 0, GTK_MESSAGE_WARNING, GTK_BUTTONS_NONE,
+                                   "ChopGimp s'est arrêté brutalement lors de la dernière session");
+  gtk_message_dialog_format_secondary_text (GTK_MESSAGE_DIALOG (dialog),
+                                            "%s\nUn rapport a été enregistré :\n%s\n\n"
+                                            "Copiez-le pour le transmettre : il indique où "
+                                            "le programme s'est arrêté.",
+                                            details, path);
+  gtk_window_set_title (GTK_WINDOW (dialog), "Rapport de plantage");
+  gtk_dialog_add_buttons (GTK_DIALOG (dialog),
+                          "_Copier le rapport", 1,
+                          "_Ouvrir le dossier", 2,
+                          "_Fermer",            GTK_RESPONSE_CLOSE,
+                          NULL);
+  g_signal_connect_data (dialog, "response",
+                         G_CALLBACK (chopgimp_crash_dialog_response),
+                         report, (GClosureNotify) g_free, 0);
+  gtk_widget_show (dialog);
+
+  g_free (path);
+  g_free (details);
+
+  return G_SOURCE_REMOVE;
+}
+
 static void
 gui_restore_after_callback (Gimp               *gimp,
                             GimpInitStatusFunc  status_callback)
@@ -757,6 +894,18 @@ gui_restore_after_callback (Gimp               *gimp,
   /*  indicate that the application has finished loading  */
   gdk_notify_startup_complete ();
 
+  /*  ChopGimp: traceur de plantage  */
+  g_timeout_add_seconds (5, chopgimp_crash_images_tick, gimp);
+  g_timeout_add_seconds (3, chopgimp_crash_previous, gimp);
+  if (g_getenv ("CHOPGIMP_CRASH_TEST"))
+    {
+      const gchar *v      = g_getenv ("CHOPGIMP_CRASH_TEST");
+      gboolean     thread = v[0] == 't';
+
+      g_timeout_add_seconds (MAX (1, atoi (thread ? v + 1 : v)),
+                             chopgimp_crash_test, GINT_TO_POINTER (thread));
+    }
+
   /*  clear startup monitor variables  */
   initial_monitor = NULL;
 }
