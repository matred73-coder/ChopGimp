+/*  ─── ChopGimp 3.28.3: Lasso magnétique ─────────────────────────────  */
+
+static void
+magnetic_clear_live (GimpIscissorsTool *iscissors)
+{
+  iscissors->live_has_prev = FALSE;
+
+  if (iscissors->live)
+    {
+      isegment_free (iscissors->live);
+      iscissors->live = NULL;
+    }
+}
+
+/*  the points of a straight segment, from (x2, y2) back to (x1, y1)
+ *  like plot_pixels()
+ */
+static void
+isegment_make_straight (ISegment *segment)
+{
+  gint dx    = segment->x2 - segment->x1;
+  gint dy    = segment->y2 - segment->y1;
+  gint steps = MAX (ABS (dx), ABS (dy));
+  gint i;
+
+  if (segment->points)
+    g_ptr_array_free (segment->points, TRUE);
+
+  segment->points = g_ptr_array_new ();
+
+  for (i = 0; i <= steps; i++)
+    {
+      gint x = segment->x2 - (steps ? RINT ((gdouble) dx * i / steps) : 0);
+      gint y = segment->y2 - (steps ? RINT ((gdouble) dy * i / steps) : 0);
+
+      g_ptr_array_add (segment->points, GINT_TO_POINTER ((y << 16) + x));
+    }
+}
+
+/*  the point @n pixels along @segment from its start (x1, y1); the
+ *  points are stored from the end (plot_pixels()) or from the start
+ *  (straight vertical or horizontal runs of calculate_segment())
+ */
+static gboolean
+isegment_point_from_start (ISegment *segment,
+                           gint      n,
+                           gint     *x,
+                           gint     *y)
+{
+  guint32 first;
+  gint    len;
+  gint    index;
+
+  if (! segment->points || segment->points->len < 2)
+    return FALSE;
+
+  len = segment->points->len;
+
+  if (n <= 0 || n >= len)
+    return FALSE;
+
+  first = GPOINTER_TO_INT (g_ptr_array_index (segment->points, 0));
+
+  if ((gint) (first & 0x0000ffff) == segment->x1 &&
+      (gint) (first >> 16)        == segment->y1)
+    index = n;
+  else
+    index = len - 1 - n;
+
+  first = GPOINTER_TO_INT (g_ptr_array_index (segment->points, index));
+
+  *x = first & 0x0000ffff;
+  *y = first >> 16;
+
+  return TRUE;
+}
+
+/*  the segment from the last point to the pointer follows the edge;
+ *  points are placed by themselves every « Fréquence » pixels (screen
+ *  pixels, so the result does not depend on the zoom)
+ */
+static void
+magnetic_update_live_one (GimpIscissorsTool *iscissors,
+                          const GimpCoords  *coords,
+                          GdkModifierType    state,
+                          GimpDisplay       *display);
+
+/*  ChopGimp 3.29.5: a jump of the mouse of more than 100 screen pixels
+ *  (fast moves): the edge is followed through intermediate positions
+ *  every 40 screen pixels, as if the mouse had moved slowly, so that no
+ *  point is placed off the edge (CHOPGIMP_NO_LASSO_STEPS=1: as before)
+ */
+static void
+magnetic_update_live (GimpIscissorsTool *iscissors,
+                      const GimpCoords  *coords,
+                      GdkModifierType    state,
+                      GimpDisplay       *display)
+{
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           scale = (shell && shell->scale_x > 0.0) ? shell->scale_x : 1.0;
+  ISegment         *last  = g_queue_peek_tail (iscissors->curve->segments);
+
+  if (last && ! (state & GDK_MOD1_MASK) && ! g_getenv ("CHOPGIMP_NO_LASSO_STEPS"))
+    {
+      gdouble px, py, dist;
+
+      if (iscissors->live_has_prev)
+        {
+          px = iscissors->live_px;
+          py = iscissors->live_py;
+        }
+      else if (last->x1 == last->x2 && last->y1 == last->y2)
+        {
+          px = last->x1;
+          py = last->y1;
+        }
+      else
+        {
+          px = last->x2;
+          py = last->y2;
+        }
+
+      dist = hypot (coords->x - px, coords->y - py) * scale;
+
+      if (dist > 100.0)
+        {
+          gint n = MIN ((gint) ceil (dist / 40.0), 64);
+
+          for (gint k = 1; k < n; k++)
+            {
+              GimpCoords c = *coords;
+
+              c.x = px + (coords->x - px) * k / n;
+              c.y = py + (coords->y - py) * k / n;
+
+              magnetic_update_live_one (iscissors, &c, state, display);
+            }
+        }
+    }
+
+  magnetic_update_live_one (iscissors, coords, state, display);
+
+  iscissors->live_has_prev = TRUE;
+  iscissors->live_px       = coords->x;
+  iscissors->live_py       = coords->y;
+}
+
+static void
+magnetic_update_live_one (GimpIscissorsTool *iscissors,
+                          const GimpCoords  *coords,
+                          GdkModifierType    state,
+                          GimpDisplay       *display)
+{
+  GimpTool             *tool    = GIMP_TOOL (iscissors);
+  GimpIscissorsOptions *options = GIMP_ISCISSORS_TOOL_GET_OPTIONS (tool);
+  GimpImage            *image   = gimp_display_get_image (display);
+  GimpDisplayShell     *shell   = gimp_display_get_shell (display);
+  ISegment             *last;
+  gboolean              free_line;
+  gint                  ax, ay;
+  gint                  x, y;
+  gint                  spacing = 0;
+  gint                  guard;
+
+  last = g_queue_peek_tail (iscissors->curve->segments);
+
+  if (! last)
+    return;
+
+  if (last->x1 == last->x2 && last->y1 == last->y2)
+    {
+      ax = last->x1;
+      ay = last->y1;
+    }
+  else
+    {
+      ax = last->x2;
+      ay = last->y2;
+    }
+
+  free_line = (state & GDK_MOD1_MASK) != 0;
+
+  x = RINT (coords->x);
+  y = RINT (coords->y);
+
+  if (! free_line && ! (state & gimp_get_extend_selection_mask ()))
+    find_max_gradient (iscissors, GIMP_PICKABLE (image), &x, &y);
+
+  x = CLAMP (x, 0, gimp_image_get_width  (image) - 1);
+  y = CLAMP (y, 0, gimp_image_get_height (image) - 1);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  if (! iscissors->live)
+    iscissors->live = isegment_new (ax, ay, x, y);
+
+  iscissors->live->x1 = ax;
+  iscissors->live->y1 = ay;
+  iscissors->live->x2 = x;
+  iscissors->live->y2 = y;
+  iscissors->live_free = free_line;
+
+  if (free_line)
+    isegment_make_straight (iscissors->live);
+  else
+    calculate_segment (iscissors, iscissors->live);
+
+  /*  Fréquence 0..100 → one point every 110..10 screen pixels  */
+  if (! free_line && options->magnetic_frequency > 0)
+    {
+      gdouble scale = (shell && shell->scale_x > 0.0) ? shell->scale_x : 1.0;
+
+      spacing = RINT ((10.0 + (100 - options->magnetic_frequency)) / scale);
+      spacing = MAX (spacing, 4);
+    }
+
+  for (guard = 0;
+       spacing > 0 && guard < 64 &&
+       iscissors->live->points &&
+       (gint) iscissors->live->points->len > spacing;
+       guard++)
+    {
+      ISegment *segment;
+      gint      px, py;
+
+      if (! isegment_point_from_start (iscissors->live, spacing, &px, &py))
+        break;
+
+      gimp_iscissors_tool_push_undo (iscissors);
+
+      last = g_queue_peek_tail (iscissors->curve->segments);
+
+      if (last->x1 == last->x2 && last->y1 == last->y2)
+        {
+          last->x2 = px;
+          last->y2 = py;
+          calculate_segment (iscissors, last);
+        }
+      else
+        {
+          segment = icurve_append_segment (iscissors->curve,
+                                           ax, ay, px, py);
+          calculate_segment (iscissors, segment);
+        }
+
+      gimp_iscissors_tool_free_redo (iscissors);
+
+      ax = px;
+      ay = py;
+
+      iscissors->live->x1 = ax;
+      iscissors->live->y1 = ay;
+      calculate_segment (iscissors, iscissors->live);
+    }
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
