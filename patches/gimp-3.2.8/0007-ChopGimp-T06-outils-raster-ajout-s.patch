diff --git a/app/paint/gimppaintcore.c b/app/paint/gimppaintcore.c
index 408b9f3..c049e55 100644
--- a/app/paint/gimppaintcore.c
+++ b/app/paint/gimppaintcore.c
@@ -388,6 +388,9 @@ gimp_paint_core_start (GimpPaintCore     *core,
                                            sizeof (GimpCoords),
                                            STROKE_BUFFER_INIT_SIZE);
 
+  core->stab_valid   = FALSE;
+  core->stab_release = FALSE;
+
   /* remember the last stroke's endpoint for later undo */
   core->start_coords = core->last_coords;
   core->cur_coords   = *coords;
@@ -1667,6 +1670,40 @@ gimp_paint_core_smooth_coords (GimpPaintCore    *core,
   if (core->stroke_buffer == NULL)
     return; /* Paint core has not initialized yet */
 
+  /*  ChopGimp: string stabilizer. The tip stays still while the cursor
+   *  moves within the string length, then is pulled along it.
+   */
+  if (smoothing_options->stabilizer)
+    {
+      gdouble dx, dy, d, len = smoothing_options->stabilizer_length;
+
+      core->stab_raw = *coords;
+
+      if (core->stab_release)          /*  catch-up at the end of the stroke  */
+        return;
+
+      if (! core->stab_valid)
+        {
+          core->stab       = *coords;
+          core->stab_valid = TRUE;
+          return;
+        }
+
+      dx = coords->x - core->stab.x;
+      dy = coords->y - core->stab.y;
+      d  = sqrt (dx * dx + dy * dy);
+
+      if (d > len)
+        {
+          core->stab.x += dx * (d - len) / d;
+          core->stab.y += dy * (d - len) / d;
+        }
+
+      coords->x = core->stab.x;
+      coords->y = core->stab.y;
+      return;
+    }
+
   if (smoothing_options->use_smoothing &&
       smoothing_options->smoothing_quality > 0)
     {
