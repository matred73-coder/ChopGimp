diff --git a/app/core/chopgimp-alpha-bounds.c b/app/core/chopgimp-alpha-bounds.c
new file mode 100644
index 0000000..4825b19
--- /dev/null
+++ b/app/core/chopgimp-alpha-bounds.c
@@ -0,0 +1,103 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-alpha-bounds.c — ChopGimp: bounds of the visible pixels
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "core-types.h"
+
+#include "gimpdrawable.h"
+#include "gimpitem.h"
+#include "gimppickable-auto-shrink.h"
+#include "chopgimp-alpha-bounds.h"
+
+
+GimpAutoShrink
+chopgimp_alpha_bounds (GimpDrawable *drawable,
+                       gint         *x,
+                       gint         *y,
+                       gint         *width,
+                       gint         *height)
+{
+  GeglBuffer         *buffer;
+  GeglBufferIterator *iter;
+  gint                w, h;
+  gint                x1 = G_MAXINT, y1 = G_MAXINT;
+  gint                x2 = G_MININT, y2 = G_MININT;
+
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), GIMP_AUTO_SHRINK_UNSHRINKABLE);
+
+  w = gimp_item_get_width  (GIMP_ITEM (drawable));
+  h = gimp_item_get_height (GIMP_ITEM (drawable));
+
+  *x = 0; *y = 0; *width = w; *height = h;
+
+  if (! gimp_drawable_has_alpha (drawable))
+    return GIMP_AUTO_SHRINK_UNSHRINKABLE;
+
+  buffer = gimp_drawable_get_buffer (drawable);
+  iter   = gegl_buffer_iterator_new (buffer, GEGL_RECTANGLE (0, 0, w, h), 0,
+                                     babl_format ("A u8"),
+                                     GEGL_ACCESS_READ, GEGL_ABYSS_NONE, 1);
+
+  while (gegl_buffer_iterator_next (iter))
+    {
+      const guchar        *data = iter->items[0].data;
+      const GeglRectangle *roi  = &iter->items[0].roi;
+      gint                 row, col;
+
+      /*  a chunk already inside the bounds found so far adds nothing  */
+      if (roi->x >= x1 && roi->y >= y1 &&
+          roi->x + roi->width <= x2 + 1 && roi->y + roi->height <= y2 + 1)
+        continue;
+
+      for (row = 0; row < roi->height; row++)
+        {
+          const guchar *p = data + row * roi->width;
+          gint          first = -1, last = -1;
+
+          for (col = 0; col < roi->width; col++)
+            if (p[col])
+              {
+                first = col;
+                break;
+              }
+
+          if (first < 0)
+            continue;
+
+          for (col = roi->width - 1; col >= first; col--)
+            if (p[col])
+              {
+                last = col;
+                break;
+              }
+
+          x1 = MIN (x1, roi->x + first);
+          x2 = MAX (x2, roi->x + last);
+          y1 = MIN (y1, roi->y + row);
+          y2 = MAX (y2, roi->y + row);
+        }
+    }
+
+  if (x1 > x2 || y1 > y2)
+    return GIMP_AUTO_SHRINK_EMPTY;
+
+  *x      = x1;
+  *y      = y1;
+  *width  = x2 - x1 + 1;
+  *height = y2 - y1 + 1;
+
+  if (*width == w && *height == h)
+    return GIMP_AUTO_SHRINK_UNSHRINKABLE;
+
+  return GIMP_AUTO_SHRINK_SHRINK;
+}
diff --git a/app/core/chopgimp-alpha-bounds.h b/app/core/chopgimp-alpha-bounds.h
new file mode 100644
index 0000000..3f17f59
--- /dev/null
+++ b/app/core/chopgimp-alpha-bounds.h
@@ -0,0 +1,21 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-alpha-bounds.h — ChopGimp: bounds of the visible pixels
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+/*  Bounds of the non-transparent pixels of @drawable, in its own
+ *  coordinates.  Unlike gimp_pickable_auto_shrink(), which crops away
+ *  the colour of the corners (« autocrop »), only the alpha counts: an
+ *  opaque shape that fills its layer keeps all its pixels.
+ */
+GimpAutoShrink   chopgimp_alpha_bounds (GimpDrawable *drawable,
+                                        gint         *x,
+                                        gint         *y,
+                                        gint         *width,
+                                        gint         *height);
