       path = chopgimp_text_fx_find_path (image, (GimpTattoo) atoi (v));
+
+      /*  tattoos are only unique in one image: after a copy into another
+       *  image, the same number may be another path
+       */
+      if (path && pname)
+        {
+          gchar *name = chopgimp_text_fx_path_name (path);
+
