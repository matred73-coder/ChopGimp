   pad = 2.0;
   if (text->outline != GIMP_TEXT_OUTLINE_NONE)
-    pad += text->outline_width;
+    pad += text->outline_width *
+           (text->outline_join_style == GIMP_JOIN_MITER ?
+            MAX (1.0, MIN (text->outline_miter_limit, 4.0)) : 1.0);
 
   fx->ox     = (gint) floor (x1 - pad);
   fx->oy     = (gint) floor (y1 - pad);
@@ -1510,6 +1527,20 @@ chopgimp_text_fx_moves_glyphs (const gchar *spec)
   return moves;
 }
 
+/*  the name of a path as written in a spec (no « ; » nor « = »)  */
+gchar *
+chopgimp_text_fx_path_name (GimpPath *path)
+{
+  gchar *name = g_strdup (gimp_object_get_name (path));
+  gchar *p;
+
+  for (p = name; *p; p++)
+    if (*p == ';' || *p == '=')
+      *p = '_';
+
+  return name;
+}
+
 void
 chopgimp_text_fx_get_anchor (GimpTextLayer *layer,
                              gint          *x,
@@ -1589,8 +1620,27 @@ fx_stroke (ChopGimpTextFx *fx,
                        text->outline_join_style == GIMP_JOIN_ROUND ? CAIRO_LINE_JOIN_ROUND :
                        CAIRO_LINE_JOIN_BEVEL);
   cairo_set_miter_limit (cr, text->outline_miter_limit);
+  cairo_set_line_cap (cr,
+                      text->outline_cap_style == GIMP_CAP_BUTT  ? CAIRO_LINE_CAP_BUTT :
+                      text->outline_cap_style == GIMP_CAP_ROUND ? CAIRO_LINE_CAP_ROUND :
+                      CAIRO_LINE_CAP_SQUARE);
   cairo_set_line_width (cr, text->outline_width * 2);
 
+  /*  dashes, in multiples of the outline width (as the plain renderer)  */
+  if (text->outline_dash_info && text->outline_dash_info->len >= 2)
+    {
+      gint     n      = text->outline_dash_info->len;
+      gdouble *dashes = g_new (gdouble, n);
+      gdouble  unit   = MAX (text->outline_width, 1.0);
+      gint     k;
+
+      for (k = 0; k < n; k++)
+        dashes[k] = unit * g_array_index (text->outline_dash_info, gdouble, k);
+
+      cairo_set_dash (cr, dashes, n, text->outline_dash_offset * unit);
+      g_free (dashes);
+    }
+
   if (text->outline_direction == GIMP_TEXT_OUTLINE_DIRECTION_INNER)
     {
       cairo_new_path (cr);
