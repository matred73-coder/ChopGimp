+          if (f)
+            gimp_text_layer_set (t.layer, NULL, "font", f, NULL);
+          if (size > 0)
+            gimp_text_layer_set (t.layer, NULL, "font-size", size, "unit", gimp_unit_pixel (), NULL);
+          if (gcolor)
+            gimp_text_layer_set (t.layer, NULL, "color", gcolor, NULL);
+          gimp_text_layer_set (t.layer, NULL,
+                               "letter-spacing", g_key_file_get_double (kf, name, "tracking", NULL),
+                               "line-spacing",   g_key_file_get_double (kf, name, "leading", NULL),
+                               "justify",        g_key_file_get_integer (kf, name, "justify", NULL),
+                               NULL);
+        }
 
       /*  … and the character attributes on all of it  */
       target_begin (st->panel, &t);
@@ -1599,7 +1623,10 @@ styles_apply (Styles *st, const gchar *name)
 
   target_end (&t, NULL);
 
-  gimp_image_undo_group_end (image);
+  if (tool)
+    gtk_text_buffer_end_user_action (GTK_TEXT_BUFFER (tool->buffer));
