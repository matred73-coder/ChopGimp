+/*  after a size change (window made smaller…), GtkPaned takes the lost
+ *  room from the last groups, down to nothing: give every group its tab
+ *  bar back, taken from the groups that have room to spare
+ */
+static gboolean
+gimp_paned_box_reclamp_idle (gpointer data)
+{
+  GimpPanedBox *paned_box = data;
+  GtkWidget    *root      = NULL;
+  GList        *children, *iter;
+  GPtrArray    *leaves;
+  GHashTable   *targets;
+  gboolean      marked = FALSE;
+  gint         *size, *min;
+  gint          n, i, j, total, deficit = 0, spare = 0;
+
+  g_object_set_data (G_OBJECT (paned_box), "chopgimp-reclamp-id", NULL);
+
+  if (g_object_get_data (G_OBJECT (paned_box), CHOPGIMP_LAYOUT_GUARD_KEY))
+    return G_SOURCE_REMOVE;
+
+  children = gtk_container_get_children (GTK_CONTAINER (paned_box));
+  for (iter = children; iter; iter = g_list_next (iter))
+    if (GTK_IS_PANED (iter->data))
+      root = iter->data;
+  g_list_free (children);
+
+  if (! root)
+    return G_SOURCE_REMOVE;
+
+  leaves = g_ptr_array_new ();
+  gimp_paned_box_collect_leaves (root, leaves, &marked);
+  n = leaves->len;
+
+  if (n < 2)
+    {
+      g_ptr_array_unref (leaves);
+      return G_SOURCE_REMOVE;
+    }
+
+  size = g_new0 (gint, n);
+  min  = g_new0 (gint, n);
+
+  for (i = 0; i < n; i++)
+    {
+      GtkWidget *leaf = g_ptr_array_index (leaves, i);
+
+      size[i] = gimp_paned_box_widget_size (leaf, GTK_ORIENTATION_VERTICAL);
+      min[i]  = gimp_paned_box_leaf_min (leaf, GTK_ORIENTATION_VERTICAL);
+
+      if (size[i] + 1 < min[i])
+        deficit += min[i] - size[i];
+      else if (size[i] > min[i])
+        spare += size[i] - min[i];
+    }
+
+  if (deficit > 0 && spare >= deficit)
+    {
+      /*  take the room from the largest groups first  */
+      while (deficit > 0)
+        {
+          gint best = -1;
+
+          for (j = 0; j < n; j++)
+            if (size[j] > min[j] && (best < 0 || size[j] - min[j] > size[best] - min[best]))
+              best = j;
+
+          if (best < 0)
+            break;
+
+          for (i = 0; i < n && deficit > 0; i++)
+            if (size[i] < min[i])
+              {
+                gint take = MIN (MIN (min[i] - size[i], size[best] - min[best]), deficit);
+
+                size[i]    += take;
+                size[best] -= take;
+                deficit    -= take;
+
+                if (size[best] <= min[best])
+                  break;
+              }
+        }
+
+      targets = g_hash_table_new (NULL, NULL);
+      for (i = 0; i < n; i++)
+        g_hash_table_insert (targets, g_ptr_array_index (leaves, i),
+                             GINT_TO_POINTER (size[i]));
+
+      total = gimp_paned_box_widget_size (root, GTK_ORIENTATION_VERTICAL);
+
+      g_object_set_data (G_OBJECT (paned_box), CHOPGIMP_LAYOUT_GUARD_KEY,
+                         GINT_TO_POINTER (TRUE));
+      gimp_paned_box_apply_collapsed (root, GTK_ORIENTATION_VERTICAL,
+                                      targets, TRUE, &total);
+      g_object_set_data (G_OBJECT (paned_box), CHOPGIMP_LAYOUT_GUARD_KEY, NULL);
+
+      g_hash_table_unref (targets);
+    }
+
+  g_free (size);
+  g_free (min);
+  g_ptr_array_unref (leaves);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+gimp_paned_box_size_allocated (GtkWidget     *widget,
+                               GtkAllocation *allocation,
+                               gpointer       data)
+{
+  if (gtk_orientable_get_orientation (GTK_ORIENTABLE (widget)) != GTK_ORIENTATION_VERTICAL ||
+      g_object_get_data (G_OBJECT (widget), CHOPGIMP_LAYOUT_GUARD_KEY) ||
+      g_object_get_data (G_OBJECT (widget), "chopgimp-reclamp-id"))
+    return;
+
+  g_object_set_data (G_OBJECT (widget), "chopgimp-reclamp-id",
+                     GUINT_TO_POINTER (g_idle_add (gimp_paned_box_reclamp_idle, widget)));
+}
