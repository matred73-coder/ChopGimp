+#include "gimpprocedure.h"
+#include "chopgimp-cmds.h"
+
+#include "gimp-intl.h"
+
+
+#define ARG_OBJECT(n) g_value_get_object (gimp_value_array_index (args, (n)))
+#define ARG_INT(n)    g_value_get_int (gimp_value_array_index (args, (n)))
+#define ARG_DOUBLE(n) g_value_get_double (gimp_value_array_index (args, (n)))
+#define ARG_BOOL(n)   g_value_get_boolean (gimp_value_array_index (args, (n)))
+
+static GimpValueArray *
+chopgimp_return_path (GimpProcedure *procedure,
+                      GimpPath      *path,
+                      GError       **error)
+{
+  GimpValueArray *return_vals;
+
+  return_vals = gimp_procedure_get_return_values (procedure, path != NULL,
+                                                  error ? *error : NULL);
+  if (path)
+    /*  same ownership as the generated procedures (gimp-path-copy…)  */
+    g_value_set_object (gimp_value_array_index (return_vals, 1), path);
+
+  return return_vals;
+}
+
+static GimpValueArray *
+boolean_invoker (GimpProcedure         *procedure,
+                 Gimp                  *gimp,
+                 GimpContext           *context,
+                 GimpProgress          *progress,
+                 const GimpValueArray  *args,
+                 GError               **error)
+{
+  GimpPath **paths = g_value_get_boxed (gimp_value_array_index (args, 0));
+  gint       n     = gimp_core_object_array_get_length ((GObject **) paths);
+
+  if (n < 1)
+    return chopgimp_return_path (procedure, NULL, error);
+
+  return chopgimp_return_path (procedure,
+                               chopgimp_geom_boolean (paths, n, ARG_INT (1)),
+                               error);
+}
+
+static GimpValueArray *
+divide_invoker (GimpProcedure         *procedure,
+                Gimp                  *gimp,
+                GimpContext           *context,
+                GimpProgress          *progress,
+                const GimpValueArray  *args,
+                GError               **error)
+{
+  GimpPath      **paths = g_value_get_boxed (gimp_value_array_index (args, 0));
+  gint            n     = gimp_core_object_array_get_length ((GObject **) paths);
+  GimpPath      **pieces;
+  gint            n_pieces = 0;
+  GimpValueArray *return_vals;
+
+  if (n < 1)
+    return gimp_procedure_get_return_values (procedure, FALSE, NULL);
+
+  pieces = chopgimp_geom_divide (paths, n, &n_pieces);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boxed (gimp_value_array_index (return_vals, 1), pieces);
+
+  /*  the array is copied, its paths are kept (inserted by the caller)  */
+  g_free (pieces);
+
+  return return_vals;
+}
+
+static GimpValueArray *
+offset_invoker (GimpProcedure         *procedure,
+                Gimp                  *gimp,
+                GimpContext           *context,
+                GimpProgress          *progress,
+                const GimpValueArray  *args,
+                GError               **error)
+{
+  return chopgimp_return_path (procedure,
+                               chopgimp_geom_offset (ARG_OBJECT (0), ARG_DOUBLE (1),
+                                                     ARG_INT (2)),
+                               error);
+}
+
+static GimpValueArray *
+outline_invoker (GimpProcedure         *procedure,
+                 Gimp                  *gimp,
+                 GimpContext           *context,
+                 GimpProgress          *progress,
+                 const GimpValueArray  *args,
+                 GError               **error)
+{
+  return chopgimp_return_path (procedure,
+                               chopgimp_geom_outline (ARG_OBJECT (0), ARG_DOUBLE (1),
+                                                      ARG_INT (2), ARG_INT (3)),
+                               error);
+}
+
+static GimpValueArray *
+simplify_invoker (GimpProcedure         *procedure,
+                  Gimp                  *gimp,
+                  GimpContext           *context,
+                  GimpProgress          *progress,
+                  const GimpValueArray  *args,
+                  GError               **error)
+{
+  return chopgimp_return_path (procedure,
+                               chopgimp_geom_simplify (ARG_OBJECT (0), ARG_DOUBLE (1)),
+                               error);
+}
+
+static GimpValueArray *
+round_invoker (GimpProcedure         *procedure,
+               Gimp                  *gimp,
+               GimpContext           *context,
+               GimpProgress          *progress,
+               const GimpValueArray  *args,
+               GError               **error)
+{
+  return chopgimp_return_path (procedure,
+                               chopgimp_geom_round_corners (ARG_OBJECT (0),
+                                                            ARG_DOUBLE (1),
+                                                            ARG_BOOL (2)),
+                               error);
+}
+
+static GimpValueArray *
+reverse_invoker (GimpProcedure         *procedure,
+                 Gimp                  *gimp,
+                 GimpContext           *context,
+                 GimpProgress          *progress,
+                 const GimpValueArray  *args,
+                 GError               **error)
+{
+  return chopgimp_return_path (procedure,
+                               chopgimp_geom_reverse (ARG_OBJECT (0)),
+                               error);
+}
+
+static GimpValueArray *
+effects_invoker (GimpProcedure         *procedure,
+                 Gimp                  *gimp,
+                 GimpContext           *context,
+                 GimpProgress          *progress,
+                 const GimpValueArray  *args,
+                 GError               **error)
+{
+  return chopgimp_return_path (procedure,
+                               chopgimp_geom_effects (ARG_OBJECT (0),
+                                                      g_value_get_string (gimp_value_array_index (args, 1))),
+                               error);
+}
+
+static GimpValueArray *
+info_invoker (GimpProcedure         *procedure,
+              Gimp                  *gimp,
+              GimpContext           *context,
+              GimpProgress          *progress,
+              const GimpValueArray  *args,
+              GError               **error)
+{
+  GimpPath       *path = ARG_OBJECT (0);
+  GimpValueArray *return_vals;
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_int    (gimp_value_array_index (return_vals, 1),
+                      chopgimp_geom_count_nodes (path));
+  g_value_set_double (gimp_value_array_index (return_vals, 2),
+                      chopgimp_geom_area (path));
+
+  return return_vals;
+}
+
+static GimpValueArray *
+nodes_invoker (GimpProcedure         *procedure,
+               Gimp                  *gimp,
+               GimpContext           *context,
+               GimpProgress          *progress,
+               const GimpValueArray  *args,
+               GError               **error)
+{
+  GimpPath       *path  = ARG_OBJECT (0);
+  gint            op    = ARG_INT (1);
+  gdouble         value = ARG_DOUBLE (2);
+  GimpImage      *image = gimp_item_get_image (GIMP_ITEM (path));
+  gboolean        changed;
+  GimpValueArray *return_vals;
+
+  if (gimp_item_is_attached (GIMP_ITEM (path)) &&
+      op != CHOPGIMP_NODES_SELECT_ALL && op != CHOPGIMP_NODES_SELECT_NONE)
+    gimp_image_undo_push_path_mod (image, _("Modifier les nœuds"), path);
+
+  changed = chopgimp_geom_nodes (path, op, value);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), changed);
+
+  return return_vals;
+}
+
+
+static GimpProcedure *
+chopgimp_procedure (GimpPDB          *pdb,
+                    GimpMarshalFunc   invoker,
+                    const gchar      *name,
+                    const gchar      *help)
+{
+  GimpProcedure *procedure = gimp_procedure_new (invoker, FALSE);
+
+  gimp_object_set_static_name (GIMP_OBJECT (procedure), name);
+  gimp_procedure_set_static_help (procedure, help, help, NULL);
+  gimp_procedure_set_static_attribution (procedure,
+                                         "ChopGimp (lib2geom / Inkscape)",
+                                         "ChopGimp", "2026");
+  return procedure;
+}
+
+static GParamSpec *
+path_arg (const gchar *name)
+{
+  return gimp_param_spec_path (name, name, "A path", FALSE, GIMP_PARAM_READWRITE);
+}
+
+static GParamSpec *
+paths_arg (const gchar *name)
+{
+  return gimp_param_spec_core_object_array (name, name, "Paths", GIMP_TYPE_PATH,
+                                            GIMP_PARAM_READWRITE);
+}
+
+static GParamSpec *
+int_arg (const gchar *name, gint min, gint max, gint def)
+{
+  return g_param_spec_int (name, name, name, min, max, def, GIMP_PARAM_READWRITE);
+}
+
+static GParamSpec *
+double_arg (const gchar *name, gdouble min, gdouble max, gdouble def)
+{
+  return g_param_spec_double (name, name, name, min, max, def, GIMP_PARAM_READWRITE);
+}
+
+void
+register_chopgimp_procs (GimpPDB *pdb)
+{
+  GimpProcedure *p;
+
+  p = chopgimp_procedure (pdb, boolean_invoker, "chopgimp-path-boolean",
+                          "Pathfinder: union (0), first minus the others (1), "
+                          "intersection (2), exclusion (3) of paths. Returns a new path "
+                          "to insert in the image.");
+  gimp_procedure_add_argument (p, paths_arg ("paths"));
+  gimp_procedure_add_argument (p, int_arg ("operation", 0, 3, 0));
+  gimp_procedure_add_return_value (p, path_arg ("path"));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, divide_invoker, "chopgimp-path-divide",
+                          "Pathfinder « Divide »: every region of the arrangement of the paths.");
+  gimp_procedure_add_argument (p, paths_arg ("paths"));
+  gimp_procedure_add_return_value (p, paths_arg ("pieces"));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, offset_invoker, "chopgimp-path-offset",
+                          "Grow (> 0) or shrink (< 0) a shape; join: miter (0), round (1), bevel (2).");
+  gimp_procedure_add_argument (p, path_arg ("path"));
+  gimp_procedure_add_argument (p, double_arg ("distance", -10000, 10000, 5));
+  gimp_procedure_add_argument (p, int_arg ("join", 0, 2, 1));
+  gimp_procedure_add_return_value (p, path_arg ("result"));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, outline_invoker, "chopgimp-path-outline",
+                          "Stroke to path: the outline of the stroke as a filled shape; "
+                          "cap: butt (0), round (1), square (2).");
+  gimp_procedure_add_argument (p, path_arg ("path"));
+  gimp_procedure_add_argument (p, double_arg ("width", 0, 10000, 4));
+  gimp_procedure_add_argument (p, int_arg ("join", 0, 2, 0));
+  gimp_procedure_add_argument (p, int_arg ("cap", 0, 2, 0));
+  gimp_procedure_add_return_value (p, path_arg ("result"));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, simplify_invoker, "chopgimp-path-simplify",
+                          "Fewer nodes, the shape kept within the tolerance (px).");
+  gimp_procedure_add_argument (p, path_arg ("path"));
+  gimp_procedure_add_argument (p, double_arg ("tolerance", 0.1, 1000, 2));
+  gimp_procedure_add_return_value (p, path_arg ("result"));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, round_invoker, "chopgimp-path-round-corners",
+                          "Round the corners (all, or only the selected nodes).");
+  gimp_procedure_add_argument (p, path_arg ("path"));
+  gimp_procedure_add_argument (p, double_arg ("radius", 0, 10000, 10));
+  gimp_procedure_add_argument (p, g_param_spec_boolean ("selected-only", "selected-only",
+                                                        "Only the selected nodes",
+                                                        FALSE, GIMP_PARAM_READWRITE));
+  gimp_procedure_add_return_value (p, path_arg ("result"));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, reverse_invoker, "chopgimp-path-reverse",
+                          "Reverse the direction of every sub-path.");
+  gimp_procedure_add_argument (p, path_arg ("path"));
+  gimp_procedure_add_return_value (p, path_arg ("result"));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, effects_invoker, "chopgimp-path-effects",
+                          "Apply a stack of path effects (key file text) and return the result.");
+  gimp_procedure_add_argument (p, path_arg ("path"));
+  gimp_procedure_add_argument (p, gimp_param_spec_string ("spec", "spec", "Effects",
+                                                          FALSE, FALSE, FALSE, NULL,
+                                                          GIMP_PARAM_READWRITE));
+  gimp_procedure_add_return_value (p, path_arg ("result"));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, info_invoker, "chopgimp-path-info",
+                          "Number of nodes and filled area of a path.");
+  gimp_procedure_add_argument (p, path_arg ("path"));
+  gimp_procedure_add_return_value (p, int_arg ("n-nodes", 0, G_MAXINT, 0));
+  gimp_procedure_add_return_value (p, double_arg ("area", 0, G_MAXDOUBLE, 0));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, nodes_invoker, "chopgimp-path-nodes",
+                          "Operation on the selected nodes of a path (undoable): "
+                          "see ChopGimpNodesOp in app/path/chopgimp-geom.h.");
+  gimp_procedure_add_argument (p, path_arg ("path"));
+  gimp_procedure_add_argument (p, int_arg ("operation", 0, CHOPGIMP_NODES_SELECT_NONE, 0));
+  gimp_procedure_add_argument (p, double_arg ("value", -10000, 10000, 0));
+  gimp_procedure_add_return_value (p, g_param_spec_boolean ("changed", "changed", "changed",
+                                                            FALSE, GIMP_PARAM_READWRITE));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+}
