+
+} /* extern "C" */
+
+
+using Geom::Point;
+
+/* ─── GimpPath ⇄ Geom::PathVector ──────────────────────────────────── */
+
+/*  one cubic segment (a line has its handles on its ends)  */
+struct Seg
+{
+  Point p0, p1, p2, p3;
+};
+
+/*  a node of a GIMP Bézier stroke: in-handle, anchor, out-handle  */
+struct Node
+{
+  Point    in, pt, out;
+  gboolean selected;
+};
+
+struct Stroke
+{
+  std::vector<Node> nodes;
+  bool              closed;
+};
+
+static Point
+to_pt (const GimpAnchor *a)
+{
+  return Point (a->position.x, a->position.y);
+}
+
+static std::vector<Stroke>
+read_strokes (GimpPath *path)
+{
+  std::vector<Stroke> out;
+
+  for (GimpStroke *s = gimp_path_stroke_get_next (path, NULL);
+       s;
+       s = gimp_path_stroke_get_next (path, s))
+    {
+      gboolean  closed = FALSE;
+      GArray   *a;
+      Stroke    st;
+
+      if (! GIMP_IS_BEZIER_STROKE (s))
+        continue;
+
+      a = gimp_stroke_control_points_get (s, &closed);
+
+      for (guint i = 0; i + 2 < a->len; i += 3)
+        {
+          Node n;
+
+          n.in       = to_pt (&g_array_index (a, GimpAnchor, i));
+          n.pt       = to_pt (&g_array_index (a, GimpAnchor, i + 1));
+          n.out      = to_pt (&g_array_index (a, GimpAnchor, i + 2));
+          n.selected = g_array_index (a, GimpAnchor, i + 1).selected;
+          st.nodes.push_back (n);
+        }
+
+      st.closed = closed;
+      g_array_free (a, TRUE);
+
+      if (! st.nodes.empty ())
+        out.push_back (st);
+    }
+
+  return out;
+}
+
+static void
+append_seg (Geom::Path &p, const Point &c1, const Point &c2, const Point &b)
+{
+  if (Geom::are_near (c1, p.finalPoint ()) && Geom::are_near (c2, b))
+    p.appendNew<Geom::LineSegment> (b);
+  else
+    p.appendNew<Geom::CubicBezier> (c1, c2, b);
+}
+
+static Geom::Path
+stroke_to_path (const Stroke &st, bool force_close)
+{
+  const std::vector<Node> &n = st.nodes;
+  Geom::Path               p (n[0].pt);
+
+  for (size_t k = 1; k < n.size (); k++)
+    append_seg (p, n[k - 1].out, n[k].in, n[k].pt);
+
+  if ((st.closed || force_close) && n.size () > 1)
+    {
+      if (! Geom::are_near (n.back ().out, n.back ().pt) ||
+          ! Geom::are_near (n[0].in, n[0].pt))
+        append_seg (p, n.back ().out, n[0].in, n[0].pt);
+
+      p.close (true);
+    }
+
+  return p;
+}
+
+static Geom::PathVector
+to_pv (GimpPath *path, bool force_close = false)
+{
+  Geom::PathVector pv;
+
+  for (const Stroke &st : read_strokes (path))
+    if (st.nodes.size () > 1)
+      pv.push_back (stroke_to_path (st, force_close));
+
+  return pv;
+}
+
+static void
+curve_to_segs (const Geom::Curve &c, std::vector<Seg> &segs)
+{
+  auto b = dynamic_cast<const Geom::BezierCurve *> (&c);
+
+  if (c.isDegenerate ())
+    return;
+
+  if (b && b->order () == 1)
+    {
+      segs.push_back ({ c.initialPoint (), c.initialPoint (),
+                        c.finalPoint (), c.finalPoint () });
+    }
+  else if (b && b->order () == 2)
+    {
+      Point q0 = (*b)[0], q1 = (*b)[1], q2 = (*b)[2];
+
+      segs.push_back ({ q0, q0 + (q1 - q0) * (2.0 / 3.0),
+                        q2 + (q1 - q2) * (2.0 / 3.0), q2 });
+    }
+  else if (b && b->order () == 3)
+    {
+      segs.push_back ({ (*b)[0], (*b)[1], (*b)[2], (*b)[3] });
+    }
+  else
+    {
+      Geom::Path cubic = Geom::cubicbezierpath_from_sbasis (c.toSBasis (), 0.1);
+
+      for (const Geom::Curve &cc : cubic)
+        curve_to_segs (cc, segs);
+    }
+}
+
+static std::vector<Seg>
+path_to_segs (const Geom::Path &p)
+{
+  std::vector<Seg> segs;
+
+  for (size_t i = 0; i < p.size_closed (); i++)
+    curve_to_segs (p[i], segs);
+
+  return segs;
+}
+
+static GimpCoords
+coords (const Point &p)
+{
+  GimpCoords c = GIMP_COORDS_DEFAULT_VALUES;
+
+  c.x = p[Geom::X];
+  c.y = p[Geom::Y];
+
+  return c;
+}
+
+static void
+add_stroke (GimpPath *path, const Stroke &st)
+{
+  std::vector<GimpCoords> c;
+  GimpStroke             *stroke;
+
+  if (st.nodes.size () < 2 && ! (st.nodes.size () == 1 && st.closed))
+    return;
+
+  for (const Node &n : st.nodes)
+    {
+      c.push_back (coords (n.in));
+      c.push_back (coords (n.pt));
+      c.push_back (coords (n.out));
+    }
+
+  stroke = gimp_bezier_stroke_new_from_coords (c.data (), c.size (), st.closed);
+
+  /*  keep the node selection  */
+  {
+    gint i = 0;
+
+    for (GList *l = stroke->anchors->head; l; l = l->next, i++)
+      {
+        GimpAnchor *a = (GimpAnchor *) l->data;
+
+        if (a->type == GIMP_ANCHOR_ANCHOR)
+          a->selected = st.nodes[i / 3].selected;
+      }
+  }
+
+  gimp_path_stroke_add (path, stroke);
+  g_object_unref (stroke);
+}
+
+static Stroke
+segs_to_stroke (const std::vector<Seg> &segs, bool closed)
+{
+  Stroke st;
+  size_t n = segs.size ();
+
+  st.closed = closed;
+
+  for (size_t i = 0; i < n; i++)
+    {
+      Node node;
+
+      node.pt       = segs[i].p0;
+      node.out      = segs[i].p1;
+      node.in       = (i > 0) ? segs[i - 1].p2 : (closed ? segs[n - 1].p2 : segs[i].p0);
+      node.selected = FALSE;
+      st.nodes.push_back (node);
+    }
+
+  if (! closed && n > 0)
+    st.nodes.push_back ({ segs[n - 1].p2, segs[n - 1].p3, segs[n - 1].p3, FALSE });
+
+  return st;
+}
+
+static GimpPath *
+from_pv (GimpPath *like, const Geom::PathVector &pv, const gchar *name = NULL)
+{
+  GimpImage *image = gimp_item_get_image (GIMP_ITEM (like));
+  GimpPath  *path  = gimp_path_new (image,
+                                    name ? name : gimp_object_get_name (like));
+  gboolean   any   = FALSE;
+
+  gimp_path_freeze (path);
+
+  for (const Geom::Path &p : pv)
+    {
+      std::vector<Seg> segs = path_to_segs (p);
+
+      if (segs.empty ())
+        continue;
+
+      add_stroke (path, segs_to_stroke (segs, p.closed ()));
+      any = TRUE;
+    }
+
+  gimp_path_thaw (path);
+
+  if (! any)
+    {
+      g_object_unref (path);
+      return NULL;
+    }
+
+  return path;
+}
+
+/* ─── measures ─────────────────────────────────────────────────────── */
+
+static double
+pv_area (const Geom::PathVector &pv)
+{
+  double total = 0.0;
+
+  for (const Geom::Path &p : pv)
+    {
+      Geom::Point c;
+      double      a = 0.0;
+      Geom::Path  closed = p;
+
+      closed.close (true);
+      Geom::centroid (closed.toPwSb (), c, a);
+      total += a;
+    }
+
+  return std::fabs (total);
+}
+
+/* ─── booleans (Pathfinder) ────────────────────────────────────────── */
+
+static Geom::PathVector
+bool_op (const Geom::PathVector &a, const Geom::PathVector &b, ChopGimpBoolOp op)
+{
+  if (a.empty ())
+    return (op == CHOPGIMP_BOOL_UNION || op == CHOPGIMP_BOOL_EXCLUSION) ? b
+                                                                         : Geom::PathVector ();
+  if (b.empty ())
+    return (op == CHOPGIMP_BOOL_INTERSECTION) ? Geom::PathVector () : a;
+
+  try
+    {
+      Geom::PathIntersectionGraph pig (a, b, 1e-4);
+
+      switch (op)
+        {
+        case CHOPGIMP_BOOL_UNION:        return pig.getUnion ();
+        case CHOPGIMP_BOOL_DIFFERENCE:   return pig.getAminusB ();
+        case CHOPGIMP_BOOL_INTERSECTION: return pig.getIntersection ();
+        case CHOPGIMP_BOOL_EXCLUSION:    return pig.getXOR ();
+        }
+    }
+  catch (std::exception &e)
+    {
+      g_warning ("ChopGimp Pathfinder: %s", e.what ());
+    }
+
+  return Geom::PathVector ();
+}
+
+/*  a shape: every sub-path closed, no empty sub-path  */
+static Geom::PathVector
+shape_of (GimpPath *path)
+{
+  return to_pv (path, true);
+}
+
+extern "C" GimpPath *
+chopgimp_geom_boolean (GimpPath       **paths,
+                       gint             n_paths,
+                       ChopGimpBoolOp   op)
+{
+  Geom::PathVector result;
+
+  g_return_val_if_fail (n_paths >= 1, NULL);
+
+  result = shape_of (paths[0]);
+
+  for (gint i = 1; i < n_paths; i++)
+    {
+      Geom::PathVector other = shape_of (paths[i]);
+
+      if (op == CHOPGIMP_BOOL_DIFFERENCE)
+        result = bool_op (result, other, CHOPGIMP_BOOL_DIFFERENCE);
+      else
+        result = bool_op (result, other, op);
+    }
+
+  return from_pv (paths[0], result);
+}
+
+/*  all the regions of the arrangement of the shapes (Pathfinder
+ *  « Divide », shape builder)
+ */
+static std::vector<Geom::PathVector>
+divide_pv (const std::vector<Geom::PathVector> &shapes)
+{
+  std::vector<Geom::PathVector> pieces;
+
+  for (const Geom::PathVector &s : shapes)
+    {
+      std::vector<Geom::PathVector> next;
+      Geom::PathVector              rest = s;
+
+      for (const Geom::PathVector &p : pieces)
+        {
+          Geom::PathVector in  = bool_op (p, s, CHOPGIMP_BOOL_INTERSECTION);
+          Geom::PathVector out = bool_op (p, s, CHOPGIMP_BOOL_DIFFERENCE);
+
+          if (pv_area (in) > 0.5)
+            next.push_back (in);
+          if (pv_area (out) > 0.5)
+            next.push_back (out);
+
+          rest = bool_op (rest, p, CHOPGIMP_BOOL_DIFFERENCE);
+        }
+
+      if (pv_area (rest) > 0.5)
+        next.push_back (rest);
+
+      pieces = next;
+    }
+
+  return pieces;
+}
+
+extern "C" GimpPath **
+chopgimp_geom_divide (GimpPath **paths,
+                      gint       n_paths,
+                      gint      *n_pieces)
+{
+  std::vector<Geom::PathVector> shapes;
+  std::vector<GimpPath *>       out;
+  GimpPath                    **result;
+
+  for (gint i = 0; i < n_paths; i++)
+    shapes.push_back (shape_of (paths[i]));
+
+  for (const Geom::PathVector &p : divide_pv (shapes))
+    {
+      GimpPath *gp = from_pv (paths[0], p);
+
+      if (gp)
+        out.push_back (gp);
+    }
+
+  *n_pieces = out.size ();
+  result    = g_new0 (GimpPath *, out.size () + 1);
+  std::copy (out.begin (), out.end (), result);
+
+  return result;
+}
+
+/* ─── offset, outline ──────────────────────────────────────────────── */
+
+static Inkscape::LineJoinType
+ink_join (ChopGimpJoin join)
+{
+  switch (join)
+    {
+    case CHOPGIMP_JOIN_ROUND: return Inkscape::JOIN_ROUND;
+    case CHOPGIMP_JOIN_BEVEL: return Inkscape::JOIN_BEVEL;
+    default:                  return Inkscape::JOIN_MITER;
+    }
+}
+
+static Inkscape::LineCapType
+ink_cap (ChopGimpCap cap)
+{
+  switch (cap)
+    {
+    case CHOPGIMP_CAP_ROUND:  return Inkscape::BUTT_ROUND;
+    case CHOPGIMP_CAP_SQUARE: return Inkscape::BUTT_SQUARE;
+    default:                  return Inkscape::BUTT_FLAT;
+    }
+}
+
+static Geom::PathVector
+outline_pv (const Geom::PathVector &pv, double width, ChopGimpJoin join, ChopGimpCap cap)
+{
+  Geom::PathVector result;
+
+  for (const Geom::Path &p : pv)
+    {
+      Geom::PathVector o;
+
+      try
+        {
+          o = Inkscape::outline (p, width, 4.0, ink_join (join), ink_cap (cap));
+        }
+      catch (std::exception &e)
+        {
+          g_warning ("ChopGimp outline: %s", e.what ());
+          continue;
+        }
+
+      result = result.empty () ? o : bool_op (result, o, CHOPGIMP_BOOL_UNION);
+    }
+
+  return result;
+}
+
+extern "C" GimpPath *
+chopgimp_geom_outline (GimpPath     *path,
+                       gdouble       width,
+                       ChopGimpJoin  join,
+                       ChopGimpCap   cap)
+{
+  return from_pv (path, outline_pv (to_pv (path), std::fabs (width), join, cap));
+}
+
+extern "C" GimpPath *
+chopgimp_geom_offset (GimpPath     *path,
+                      gdouble       distance,
+                      ChopGimpJoin  join)
+{
+  Geom::PathVector shape;
+  Geom::PathVector open;
+  Geom::PathVector result;
+
+  for (const Geom::Path &p : to_pv (path))
+    (p.closed () ? shape : open).push_back (p);
+
+  if (std::fabs (distance) < 1e-6)
+    return from_pv (path, to_pv (path));
+
+  if (! shape.empty ())
+    {
+      Geom::PathVector ring = outline_pv (shape, 2.0 * std::fabs (distance),
+                                          join, CHOPGIMP_CAP_BUTT);
+
+      result = bool_op (shape, ring,
+                        distance > 0 ? CHOPGIMP_BOOL_UNION : CHOPGIMP_BOOL_DIFFERENCE);
+    }
+
+  /*  an open path grows into the band around it  */
+  if (! open.empty () && distance > 0)
+    {
+      Geom::PathVector band = outline_pv (open, 2.0 * distance, join, CHOPGIMP_CAP_ROUND);
+
+      result = result.empty () ? band : bool_op (result, band, CHOPGIMP_BOOL_UNION);
+    }
+
+  return from_pv (path, result);
+}
+
+/* ─── sampling and fitting ─────────────────────────────────────────── */
+
+static std::vector<Point>
+sample_path (const Geom::Path &p, double step)
+{
+  std::vector<Point> pts;
+
+  for (size_t i = 0; i < p.size_closed (); i++)
+    {
+      const Geom::Curve &c = p[i];
+      double             len;
+      int                n;
+
+      if (c.isDegenerate ())
+        continue;
+
+      len = c.length (0.1);
+      n   = std::max (1, (int) std::ceil (len / step));
+
+      for (int k = 0; k < n; k++)
+        {
+          Point q = c.pointAt ((double) k / n);
+
+          if (pts.empty () || ! Geom::are_near (q, pts.back (), 1e-6))
+            pts.push_back (q);
+        }
+    }
+
+  if (! p.closed ())
+    pts.push_back (p.finalPoint ());
+
+  return pts;
+}
+
+/*  smooth cubic fit of a polyline (tolerance in px)  */
+static Geom::Path
+fit_points (std::vector<Point> pts, bool closed, double tolerance, bool polyline = false)
+{
+  Geom::Path p;
+
+  if (pts.size () < 2)
+    return p;
+
+  if (closed)
+    pts.push_back (pts[0]);
+
+  p.start (pts[0]);
+
+  if (polyline)
+    {
+      for (size_t i = 1; i < pts.size (); i++)
+        if (! Geom::are_near (pts[i], p.finalPoint (), 1e-6))
+          p.appendNew<Geom::LineSegment> (pts[i]);
+    }
+  else
+    {
+      std::vector<Point> bez (4 * pts.size ());
+      int                n;
+
+      n = Geom::bezier_fit_cubic_r (bez.data (), pts.data (), pts.size (),
+                                    tolerance * tolerance, pts.size ());
+
+      if (n <= 0)
+        return fit_points (pts, false, tolerance, true);
+
+      for (int i = 0; i < n; i++)
+        p.appendNew<Geom::CubicBezier> (bez[4 * i + 1], bez[4 * i + 2], bez[4 * i + 3]);
+    }
+
+  if (closed)
+    p.close (true);
+
+  return p;
+}
+
+/*  corners (tangent break) of a path, as curve indices  */
+static bool
+is_corner (const Geom::Curve &a, const Geom::Curve &b, double degrees = 25.0)
+{
+  Point ta = Geom::unit_vector (a.unitTangentAt (1.0));
+  Point tb = Geom::unit_vector (b.unitTangentAt (0.0));
+
+  return Geom::dot (ta, tb) < std::cos (degrees * M_PI / 180.0);
+}
+
+static Geom::Path
+simplify_path (const Geom::Path &p, double tolerance)
+{
+  std::vector<std::vector<Point>> runs (1);
+  size_t                          n = p.size_closed ();
+  Geom::Path                      out;
+  bool                            first = true;
+
+  /*  split at the corners so they stay sharp  */
+  for (size_t i = 0; i < n; i++)
+    {
+      const Geom::Curve &c = p[i];
+
+      if (c.isDegenerate ())
+        continue;
+
+      Geom::Path single (c.initialPoint ());
+
+      single.append (c.duplicate ());
+
+      for (Point q : sample_path (single, std::max (1.0, tolerance / 2.0)))
+        if (runs.back ().empty () || ! Geom::are_near (q, runs.back ().back (), 1e-6))
+          runs.back ().push_back (q);
+
+      if (i + 1 < n && is_corner (c, p[i + 1]))
+        runs.push_back ({ runs.back ().back () });
+    }
+
+  for (auto &run : runs)
+    {
+      Geom::Path part = fit_points (run, false, tolerance);
+
+      if (part.empty () && part.initialPoint () == part.finalPoint ())
+        continue;
+
+      if (first)
+        {
+          out   = part;
+          first = false;
+        }
+      else
+        {
+          for (const Geom::Curve &c : part)
+            out.append (c.duplicate ());
+        }
+    }
+
+  out.close (p.closed ());
+
+  return out;
+}
+
+extern "C" GimpPath *
+chopgimp_geom_simplify (GimpPath *path,
+                        gdouble   tolerance)
+{
+  Geom::PathVector out;
+
+  for (const Geom::Path &p : to_pv (path))
+    out.push_back (simplify_path (p, std::max (0.1, tolerance)));
+
+  return from_pv (path, out);
+}
+
+/* ─── rounded corners ──────────────────────────────────────────────── */
+
+static Point
+cubic_at (const Seg &s, double t)
+{
+  double u = 1 - t;
+
+  return s.p0 * (u * u * u) + s.p1 * (3 * u * u * t) + s.p2 * (3 * u * t * t) + s.p3 * (t * t * t);
+}
+
+/*  split a cubic at t (de Casteljau)  */
+static void
+cubic_split (const Seg &s, double t, Seg &a, Seg &b)
+{
+  Point p01 = Geom::lerp (t, s.p0, s.p1), p12 = Geom::lerp (t, s.p1, s.p2);
+  Point p23 = Geom::lerp (t, s.p2, s.p3);
+  Point p012 = Geom::lerp (t, p01, p12), p123 = Geom::lerp (t, p12, p23);
+  Point m = Geom::lerp (t, p012, p123);
+
+  a = { s.p0, p01, p012, m };
+  b = { m, p123, p23, s.p3 };
+}
+
+static double
+seg_length (const Seg &s)
+{
+  double len = 0;
+  Point  prev = s.p0;
+
+  for (int i = 1; i <= 16; i++)
+    {
+      Point q = cubic_at (s, i / 16.0);
+
+      len += Geom::distance (prev, q);
+      prev = q;
+    }
+
+  return len;
+}
+
+/*  parameter at distance d from the start (or the end)  */
+static double
+seg_param (const Seg &s, double d, bool from_end)
+{
+  double len = seg_length (s);
+  double t   = (len > 0) ? std::min (1.0, d / len) : 0.0;
+
+  return from_end ? 1.0 - t : t;
+}
+
+static Point
+seg_tangent (const Seg &s, bool at_end)
+{
+  Point d = at_end ? (s.p3 - (Geom::are_near (s.p2, s.p3) ? s.p1 : s.p2))
+                   : ((Geom::are_near (s.p1, s.p0) ? s.p2 : s.p1) - s.p0);
+
+  if (Geom::are_near (d, Point (0, 0)))
+    d = at_end ? s.p3 - s.p0 : s.p3 - s.p0;
+
+  return Geom::are_near (d, Point (0, 0)) ? Point (1, 0) : Geom::unit_vector (d);
+}
+
+static std::vector<Seg>
+round_segs (std::vector<Seg> segs, bool closed, double radius,
+            const std::vector<bool> *selected)
+{
+  size_t           n = segs.size ();
+  std::vector<Seg> out;
+  std::vector<Seg> work = segs;
+
+  if (n < 2 || radius <= 0)
+    return segs;
+
+  /*  corner k sits between segment k-1 and segment k  */
+  std::vector<double> cut (n, 0.0);
+  std::vector<bool>   corner (n, false);
+
+  for (size_t k = 0; k < n; k++)
+    {
+      if (! closed && k == 0)
+        continue;
+
+      const Seg &a = segs[(k + n - 1) % n];
+      const Seg &b = segs[k];
+      Point      ta = seg_tangent (a, true), tb = seg_tangent (b, false);
+      double     phi = std::acos (std::max (-1.0, std::min (1.0, Geom::dot (ta, tb))));
+
+      if (phi < 5 * M_PI / 180 || (selected && ! (*selected)[k]))
+        continue;
+
+      double t = radius * std::tan (phi / 2);
+
+      t = std::min ({ t, 0.5 * seg_length (a), 0.5 * seg_length (b) });
+
+      if (t > 0.1)
+        {
+          corner[k] = true;
+          cut[k]    = t;
+        }
+    }
+
+  /*  trim the segments, then add the fillets  */
+  std::vector<Seg> trimmed (n);
+
+  for (size_t k = 0; k < n; k++)
+    {
+      Seg s = work[k], a, b;
+
+      if (corner[k])
+        {
+          cubic_split (s, seg_param (s, cut[k], false), a, b);
+          s = b;
+        }
+
+      size_t next = (k + 1) % n;
+
+      if ((closed || k + 1 < n) && corner[next])
+        {
+          Seg whole = s;
+
+          cubic_split (whole, seg_param (whole, cut[next], true), a, b);
+          s = a;
+        }
+
+      trimmed[k] = s;
+    }
+
+  for (size_t k = 0; k < n; k++)
+    {
+      if (corner[k] && (closed || k > 0))
+        {
+          const Seg &prev = trimmed[(k + n - 1) % n];
+          const Seg &cur  = trimmed[k];
+          Point      a    = prev.p3, b = cur.p0;
+          Point      ta   = seg_tangent (segs[(k + n - 1) % n], true);
+          Point      tb   = seg_tangent (segs[k], false);
+          double     phi  = std::acos (std::max (-1.0, std::min (1.0, Geom::dot (ta, tb))));
+          double     r    = cut[k] / std::max (1e-6, std::tan (phi / 2));
+          double     h    = (4.0 / 3.0) * std::tan (phi / 4) * r;
+
+          out.push_back ({ a, a + ta * h, b - tb * h, b });
+        }
+
+      out.push_back (trimmed[k]);
+    }
+
+  /*  closed: the first fillet belongs before the first segment  */
+  return out;
+}
+
+static GimpPath *
+round_corners (GimpPath *path, double radius, bool selected_only)
+{
+  GimpImage *image  = gimp_item_get_image (GIMP_ITEM (path));
+  GimpPath  *result = gimp_path_new (image, gimp_object_get_name (path));
+
+  gimp_path_freeze (result);
+
+  for (const Stroke &st : read_strokes (path))
+    {
+      Geom::Path        p    = stroke_to_path (st, false);
+      std::vector<Seg>  segs = path_to_segs (p);
+      std::vector<bool> sel;
+      Stroke            out;
+
+      if (segs.empty ())
+        continue;
+
+      for (size_t k = 0; k < segs.size (); k++)
+        sel.push_back (k < st.nodes.size () && st.nodes[k].selected);
+
+      out = segs_to_stroke (round_segs (segs, st.closed, radius,
+                                        selected_only ? &sel : NULL),
+                            st.closed);
+      add_stroke (result, out);
+    }
+
+  gimp_path_thaw (result);
+
+  return result;
+}
+
+extern "C" GimpPath *
+chopgimp_geom_round_corners (GimpPath *path,
+                             gdouble   radius,
+                             gboolean  selected_only)
+{
+  return round_corners (path, radius, selected_only);
+}
+
+extern "C" GimpPath *
+chopgimp_geom_reverse (GimpPath *path)
+{
+  Geom::PathVector pv = to_pv (path);
+
+  for (Geom::Path &p : pv)
+    p = p.reversed ();
+
+  return from_pv (path, pv);
+}
+
+extern "C" gint
+chopgimp_geom_count_nodes (GimpPath *path)
+{
+  gint n = 0;
+
+  for (const Stroke &st : read_strokes (path))
+    n += st.nodes.size ();
+
+  return n;
+}
+
+extern "C" gdouble
+chopgimp_geom_area (GimpPath *path)
+{
+  return pv_area (shape_of (path));
+}
+
+/* ─── node editing ─────────────────────────────────────────────────── */
+
+static Point
+safe_unit (const Point &v, const Point &fallback)
+{
+  return Geom::are_near (v, Point (0, 0)) ? fallback : Geom::unit_vector (v);
+}
+
+static void
+set_node_type (Stroke &st, size_t i, ChopGimpNodesOp op)
+{
+  std::vector<Node> &n    = st.nodes;
+  size_t             size = n.size ();
+  Node              &node = n[i];
+  bool               has_prev = st.closed || i > 0;
+  bool               has_next = st.closed || i + 1 < size;
+  Point              prev = has_prev ? n[(i + size - 1) % size].pt : node.pt;
+  Point              next = has_next ? n[(i + 1) % size].pt : node.pt;
+  double             l_in  = Geom::distance (node.in,  node.pt);
+  double             l_out = Geom::distance (node.out, node.pt);
+  Point              dir;
+
+  if (op == CHOPGIMP_NODES_CORNER)
+    {
+      node.in = node.out = node.pt;
+      return;
+    }
+
+  dir = safe_unit (next - prev, Point (1, 0));
+
+  if (op == CHOPGIMP_NODES_SMOOTH && l_in + l_out > 0.5)
+    dir = safe_unit (node.out - node.in, dir);
+
+  if (op == CHOPGIMP_NODES_AUTO || l_in < 0.5)
+    l_in = Geom::distance (prev, node.pt) / 3.0;
+  if (op == CHOPGIMP_NODES_AUTO || l_out < 0.5)
+    l_out = Geom::distance (next, node.pt) / 3.0;
+
+  if (op == CHOPGIMP_NODES_SYMMETRIC)
+    l_in = l_out = (l_in + l_out) / 2.0;
+
+  if (has_prev)
+    node.in = node.pt - dir * l_in;
+  if (has_next)
+    node.out = node.pt + dir * l_out;
+}
+
+static void
+move_node (Node &n, const Point &to)
+{
+  Point d = to - n.pt;
+
+  n.pt  += d;
+  n.in  += d;
+  n.out += d;
+}
+
+/*  one cubic fitted to the path between nodes a and b of a stroke  */
+static void
+refit_span (Stroke &st, size_t a, size_t b, Point &out_a, Point &in_b)
+{
+  std::vector<Point> pts;
+  size_t             size = st.nodes.size ();
+
+  for (size_t k = a; k != b; k = (k + 1) % size)
+    {
+      const Node &p = st.nodes[k];
+      const Node &q = st.nodes[(k + 1) % size];
+      Seg         s = { p.pt, p.out, q.in, q.pt };
+
+      for (int j = 0; j < 12; j++)
+        pts.push_back (cubic_at (s, j / 12.0));
+    }
+
+  pts.push_back (st.nodes[b].pt);
+
+  {
+    Point bez[4];
+
+    if (Geom::bezier_fit_cubic (bez, pts.data (), pts.size (), 1e9) > 0)
+      {
+        out_a = bez[1];
+        in_b  = bez[2];
+        return;
+      }
+  }
+
+  out_a = st.nodes[a].pt;
+  in_b  = st.nodes[b].pt;
+}
+
+static bool
+nodes_on_strokes (std::vector<Stroke> &strokes, ChopGimpNodesOp op, double value)
+{
+  std::vector<Node *> sel;
+  bool                changed = false;
+
+  for (Stroke &st : strokes)
+    for (Node &n : st.nodes)
+      if (n.selected)
+        sel.push_back (&n);
+
+  switch (op)
+    {
+    case CHOPGIMP_NODES_SELECT_ALL:
+    case CHOPGIMP_NODES_SELECT_NONE:
+      for (Stroke &st : strokes)
+        for (Node &n : st.nodes)
+          n.selected = (op == CHOPGIMP_NODES_SELECT_ALL);
+      return true;
+
+    case CHOPGIMP_NODES_CORNER:
+    case CHOPGIMP_NODES_SMOOTH:
+    case CHOPGIMP_NODES_SYMMETRIC:
+    case CHOPGIMP_NODES_AUTO:
+      for (Stroke &st : strokes)
+        for (size_t i = 0; i < st.nodes.size (); i++)
+          if (st.nodes[i].selected)
+            {
+              set_node_type (st, i, op);
+              changed = true;
+            }
+      return changed;
+
+    case CHOPGIMP_NODES_TO_LINE:
+    case CHOPGIMP_NODES_TO_CURVE:
+      for (Stroke &st : strokes)
+        {
+          size_t size = st.nodes.size ();
+
+          for (size_t i = 0; i < size; i++)
+            {
+              size_t j = (i + 1) % size;
+
+              if ((! st.closed && i + 1 == size) ||
+                  ! st.nodes[i].selected || ! st.nodes[j].selected)
+                continue;
+
+              Node &a = st.nodes[i], &b = st.nodes[j];
+
+              if (op == CHOPGIMP_NODES_TO_LINE)
+                {
+                  a.out = a.pt;
+                  b.in  = b.pt;
+                }
+              else if (Geom::are_near (a.out, a.pt) && Geom::are_near (b.in, b.pt))
+                {
+                  a.out = a.pt + (b.pt - a.pt) / 3.0;
+                  b.in  = b.pt - (b.pt - a.pt) / 3.0;
+                }
+              changed = true;
+            }
+        }
+      return changed;
+
+    case CHOPGIMP_NODES_ALIGN_LEFT:
+    case CHOPGIMP_NODES_ALIGN_HCENTER:
+    case CHOPGIMP_NODES_ALIGN_RIGHT:
+    case CHOPGIMP_NODES_ALIGN_TOP:
+    case CHOPGIMP_NODES_ALIGN_VCENTER:
+    case CHOPGIMP_NODES_ALIGN_BOTTOM:
+      {
+        bool   horiz = (op <= CHOPGIMP_NODES_ALIGN_RIGHT);
+        int    axis  = horiz ? Geom::X : Geom::Y;
+        double lo = G_MAXDOUBLE, hi = -G_MAXDOUBLE, target;
+
+        if (sel.size () < 2)
+          return false;
+
+        for (Node *n : sel)
+          {
+            lo = std::min (lo, n->pt[axis]);
+            hi = std::max (hi, n->pt[axis]);
+          }
+
+        if (op == CHOPGIMP_NODES_ALIGN_LEFT || op == CHOPGIMP_NODES_ALIGN_TOP)
+          target = lo;
+        else if (op == CHOPGIMP_NODES_ALIGN_RIGHT || op == CHOPGIMP_NODES_ALIGN_BOTTOM)
+          target = hi;
+        else
+          target = (lo + hi) / 2.0;
+
+        for (Node *n : sel)
+          {
+            Point to = n->pt;
+
+            to[axis] = target;
+            move_node (*n, to);
+          }
+        return true;
+      }
+
+    case CHOPGIMP_NODES_DISTRIBUTE_H:
+    case CHOPGIMP_NODES_DISTRIBUTE_V:
+      {
+        int axis = (op == CHOPGIMP_NODES_DISTRIBUTE_H) ? Geom::X : Geom::Y;
+
+        if (sel.size () < 3)
+          return false;
+
+        std::sort (sel.begin (), sel.end (),
+                   [axis] (Node *a, Node *b) { return a->pt[axis] < b->pt[axis]; });
+
+        double lo = sel.front ()->pt[axis], hi = sel.back ()->pt[axis];
+
+        for (size_t i = 1; i + 1 < sel.size (); i++)
+          {
+            Point to = sel[i]->pt;
+
+            to[axis] = lo + (hi - lo) * i / (sel.size () - 1);
+            move_node (*sel[i], to);
+          }
+        return true;
+      }
+
+    case CHOPGIMP_NODES_DELETE_KEEP:
+      for (Stroke &st : strokes)
+        {
+          size_t            size = st.nodes.size ();
+          std::vector<Node> kept;
+          std::vector<size_t> keep_idx;
+
+          for (size_t i = 0; i < size; i++)
+            {
+              bool end = ! st.closed && (i == 0 || i + 1 == size);
+
+              if (! st.nodes[i].selected || end)
+                keep_idx.push_back (i);
+            }
+
+          if (keep_idx.size () == size)
+            continue;
+
+          changed = true;
+
+          if (keep_idx.size () < 2)
+            {
+              st.nodes.clear ();
+              continue;
+            }
+
+          for (size_t j = 0; j < keep_idx.size (); j++)
+            kept.push_back (st.nodes[keep_idx[j]]);
+
+          for (size_t j = 0; j < keep_idx.size (); j++)
+            {
+              bool last = (j + 1 == keep_idx.size ());
+
+              if (last && ! st.closed)
+                break;
+
+              size_t a = keep_idx[j];
+              size_t b = keep_idx[last ? 0 : j + 1];
+
+              /*  only spans where nodes were removed are refitted  */
+              if ((b + size - a) % size > 1 || (last && keep_idx.size () < size &&
+                                                (a + 1) % size != b))
+                {
+                  Point out_a, in_b;
+
+                  refit_span (st, a, b, out_a, in_b);
+                  kept[j].out                    = out_a;
+                  kept[last ? 0 : j + 1].in      = in_b;
+                }
+            }
+
+          for (Node &n : kept)
+            n.selected = FALSE;
+
+          st.nodes = kept;
+        }
+      return changed;
+
+    case CHOPGIMP_NODES_JOIN:
+      {
+        /*  ends selected: the same open stroke closes, two strokes merge  */
+        std::vector<std::pair<size_t, bool>> ends;   /* stroke, at its end  */
+
+        for (size_t s = 0; s < strokes.size (); s++)
+          {
+            Stroke &st = strokes[s];
+
+            if (st.closed || st.nodes.empty ())
+              continue;
+
+            if (st.nodes.front ().selected)
+              ends.push_back ({ s, false });
+            if (st.nodes.size () > 1 && st.nodes.back ().selected)
+              ends.push_back ({ s, true });
+          }
+
+        if (ends.size () != 2)
+          return false;
+
+        if (ends[0].first == ends[1].first)
+          {
+            strokes[ends[0].first].closed = true;
+            return true;
+          }
+
+        Stroke &a = strokes[ends[0].first];
+        Stroke &b = strokes[ends[1].first];
+
+        /*  a must end with its selected node, b start with its one  */
+        auto reverse = [] (Stroke &st)
+          {
+            std::reverse (st.nodes.begin (), st.nodes.end ());
+            for (Node &n : st.nodes)
+              std::swap (n.in, n.out);
+          };
+
+        if (! ends[0].second)
+          reverse (a);
+        if (ends[1].second)
+          reverse (b);
+
+        if (Geom::distance (a.nodes.back ().pt, b.nodes.front ().pt) < 0.5)
+          {
+            a.nodes.back ().out = b.nodes.front ().out;
+            a.nodes.insert (a.nodes.end (), b.nodes.begin () + 1, b.nodes.end ());
+          }
+        else
+          {
+            a.nodes.insert (a.nodes.end (), b.nodes.begin (), b.nodes.end ());
+          }
+
+        b.nodes.clear ();
+        return true;
+      }
+
+    case CHOPGIMP_NODES_BREAK:
+      {
+        std::vector<Stroke> result;
+
+        for (Stroke &st : strokes)
+          {
+            std::vector<Node> nodes = st.nodes;
+            bool              any   = false;
+
+            for (const Node &n : nodes)
+              any = any || n.selected;
+
+            if (! any || nodes.size () < 2)
+              {
+                result.push_back (st);
+                continue;
+              }
+
+            changed = true;
+
+            if (st.closed)
+              {
+                /*  open the path at the first selected node  */
+                size_t first = 0;
+
+                while (! nodes[first].selected)
+                  first++;
+
+                std::rotate (nodes.begin (), nodes.begin () + first, nodes.end ());
+                nodes.push_back (nodes[0]);
+                nodes.front ().in  = nodes.front ().pt;
+                nodes.back ().out  = nodes.back ().pt;
+                nodes.front ().selected = nodes.back ().selected = FALSE;
+              }
+
+            /*  then cut at the other selected nodes  */
+            Stroke part;
+
+            part.closed = false;
+
+            for (size_t i = 0; i < nodes.size (); i++)
+              {
+                Node n = nodes[i];
+
+                part.nodes.push_back (n);
+
+                if (n.selected && i > 0 && i + 1 < nodes.size ())
+                  {
+                    part.nodes.back ().out      = n.pt;
+                    part.nodes.back ().selected = FALSE;
+                    result.push_back (part);
+                    part.nodes.clear ();
+
+                    n.in       = n.pt;
+                    n.selected = FALSE;
+                    part.nodes.push_back (n);
+                  }
+              }
+
+            result.push_back (part);
+          }
+
+        strokes = result;
+        return changed;
+      }
+
+    case CHOPGIMP_NODES_ROUND:
+      /*  done on the whole path, see below  */
+      return false;
+    }
+
+  return false;
+}
+
+extern "C" gboolean
+chopgimp_geom_nodes (GimpPath        *path,
+                     ChopGimpNodesOp  op,
+                     gdouble          value)
+{
+  std::vector<Stroke> strokes;
+  GimpStroke         *s;
+
+  if (op == CHOPGIMP_NODES_ROUND)
+    {
+      GimpPath *rounded = round_corners (path, value, true);
+
+      if (! rounded)
+        return FALSE;
+
+      gimp_path_freeze (path);
+      while ((s = gimp_path_stroke_get_next (path, NULL)))
+        gimp_path_stroke_remove (path, s);
+      gimp_path_add_strokes (rounded, path);
+      gimp_path_thaw (path);
+      g_object_unref (rounded);
+
+      return TRUE;
+    }
+
+  strokes = read_strokes (path);
+
+  if (! nodes_on_strokes (strokes, op, value))
+    return FALSE;
+
+  gimp_path_freeze (path);
+
+  while ((s = gimp_path_stroke_get_next (path, NULL)))
+    gimp_path_stroke_remove (path, s);
+
+  for (const Stroke &st : strokes)
+    if (! st.nodes.empty ())
+      add_stroke (path, st);
+
+  gimp_path_thaw (path);
+
+  return TRUE;
+}
+
+/* ─── live path effects ────────────────────────────────────────────── */
+
+struct Polyline
+{
+  std::vector<Point> pts;
+  bool               closed;
+};
+
+static std::vector<Polyline>
+sample_pv (const Geom::PathVector &pv, double step)
+{
+  std::vector<Polyline> out;
+
+  for (const Geom::Path &p : pv)
+    {
+      Polyline pl = { sample_path (p, step), p.closed () };
+
+      if (pl.pts.size () > 1)
+        out.push_back (pl);
+    }
+
+  return out;
+}
+
+/*  n points evenly spaced along a polyline  */
+static std::vector<Point>
+resample (const std::vector<Point> &pts, bool closed, int n, double *total = NULL)
+{
+  std::vector<Point>  seq = pts;
+  std::vector<double> acc (1, 0.0);
+  std::vector<Point>  out;
+
+  if (closed)
+    seq.push_back (pts[0]);
+
+  for (size_t i = 1; i < seq.size (); i++)
+    acc.push_back (acc.back () + Geom::distance (seq[i - 1], seq[i]));
+
+  if (total)
+    *total = acc.back ();
+
+  if (acc.back () <= 0 || n < 2)
+    return pts;
+
+  double step = acc.back () / (closed ? n : n - 1);
+  size_t j    = 0;
+
+  for (int k = 0; k < n; k++)
+    {
+      double d = k * step;
+
+      while (j + 2 < seq.size () && acc[j + 1] < d)
+        j++;
+
+      double seg = acc[j + 1] - acc[j];
+      double t   = seg > 0 ? (d - acc[j]) / seg : 0;
+
+      out.push_back (Geom::lerp (std::min (1.0, std::max (0.0, t)), seq[j], seq[j + 1]));
+    }
+
+  return out;
+}
+
+static std::vector<Point>
+normals (const std::vector<Point> &pts, bool closed)
+{
+  std::vector<Point> out;
+  size_t             n = pts.size ();
+
+  for (size_t i = 0; i < n; i++)
+    {
+      Point a = closed ? pts[(i + n - 1) % n] : pts[i > 0 ? i - 1 : 0];
+      Point b = closed ? pts[(i + 1) % n] : pts[std::min (i + 1, n - 1)];
+      Point t = safe_unit (b - a, Point (1, 0));
+
+      out.push_back (Point (-t[Geom::Y], t[Geom::X]));
+    }
+
+  return out;
+}
+
+static double
+polyline_length (const std::vector<Point> &pts, bool closed)
+{
+  double total = 0;
+
+  resample (pts, closed, 2, &total);
+
+  return total;
+}
+
+static Geom::Path
+width_shape (const std::vector<Point> &pts, bool closed,
+             std::function<double (double)> width)
+{
+  double             len = polyline_length (pts, closed);
+  int                n   = std::max (24, (int) (len / 3.0));
+  std::vector<Point> rp  = resample (pts, false, n);
+  std::vector<Point> nr  = normals (rp, false);
+  std::vector<Point> left, right;
+
+  for (int i = 0; i < n; i++)
+    {
+      double w = std::max (0.0, width ((double) i / (n - 1))) / 2.0;
+
+      left.push_back (rp[i] + nr[i] * w);
+      right.push_back (rp[i] - nr[i] * w);
+    }
+
+  std::reverse (right.begin (), right.end ());
+  left.insert (left.end (), right.begin (), right.end ());
+
+  return fit_points (left, true, 0.3);
+}
+
+/*  piecewise-linear interpolation of « pos:width » pairs  */
+static std::function<double (double)>
+width_profile (const std::string &spec, double fallback)
+{
+  std::vector<std::pair<double, double>> pts;
+  gchar **pairs = g_strsplit (spec.c_str (), ",", -1);
+
+  for (gchar **p = pairs; p && *p; p++)
+    {
+      gchar **kv = g_strsplit (*p, ":", 2);
+
+      if (kv[0] && kv[1])
+        pts.push_back ({ g_ascii_strtod (kv[0], NULL), g_ascii_strtod (kv[1], NULL) });
+
+      g_strfreev (kv);
+    }
+
+  g_strfreev (pairs);
+
+  std::sort (pts.begin (), pts.end ());
+
+  if (pts.empty ())
+    pts = { { 0.0, fallback }, { 1.0, fallback } };
+
+  return [pts] (double t)
+    {
+      if (t <= pts.front ().first)
+        return pts.front ().second;
+      if (t >= pts.back ().first)
+        return pts.back ().second;
+
+      for (size_t i = 1; i < pts.size (); i++)
+        if (t <= pts[i].first)
+          {
+            double u = (t - pts[i - 1].first) /
+                       std::max (1e-9, pts[i].first - pts[i - 1].first);
+
+            /*  smooth (cosine) between the width points  */
+            u = (1 - std::cos (u * M_PI)) / 2;
+
+            return pts[i - 1].second + u * (pts[i].second - pts[i - 1].second);
+          }
+
+      return pts.back ().second;
+    };
+}
+
+static double
+kd (GKeyFile *kf, const gchar *group, const gchar *key, double fallback)
+{
+  gchar *v = g_key_file_get_value (kf, group, key, NULL);
+  double d = v ? g_ascii_strtod (v, NULL) : fallback;
+
+  g_free (v);
+
+  return d;
+}
+
+static std::string
+ks (GKeyFile *kf, const gchar *group, const gchar *key)
+{
+  gchar       *v = g_key_file_get_value (kf, group, key, NULL);
+  std::string  s = v ? v : "";
+
+  g_free (v);
+
+  return s;
+}
+
+static Geom::Rect
+pv_bounds (const Geom::PathVector &pv)
+{
+  Geom::OptRect r = pv.boundsFast ();
+
+  return r ? *r : Geom::Rect (0, 0, 1, 1);
+}
+
+/*  path of another vector layer, by tattoo (pattern, spine)  */
+static Geom::PathVector
+layer_pv (GimpImage *image, double tattoo)
+{
+  GimpPath *path;
+
+  if (! image || tattoo <= 0)
+    return Geom::PathVector ();
+
+  path = chopgimp_vector_layer_path_by_tattoo (image, (guint) tattoo);
+
+  return path ? to_pv (path) : Geom::PathVector ();
+}
+
+/*  bend @shape along @spine: x of the shape → distance along the spine  */
+static Geom::PathVector
+along_path (const Geom::PathVector &shape, const Geom::PathVector &spine,
+            bool repeat, double spacing)
+{
+  Geom::PathVector out;
+
+  if (shape.empty () || spine.empty ())
+    return shape;
+
+  std::vector<Point> sp   = sample_path (spine[0], 1.0);
+  double             slen = polyline_length (sp, spine[0].closed ());
+  std::vector<Point> rs   = resample (sp, spine[0].closed (),
+                                      std::max (2, (int) slen), NULL);
+  std::vector<Point> nr   = normals (rs, spine[0].closed ());
+  Geom::Rect         bb   = pv_bounds (shape);
+  double             w    = std::max (1.0, bb.width ());
+  int                copies = repeat ? std::max (1, (int) (slen / (w + spacing))) : 1;
+  double             scale  = repeat ? 1.0 : slen / w;
+
+  auto map = [&] (Point p, int copy)
+    {
+      double x = (p[Geom::X] - bb.left ()) * scale + copy * (w + spacing);
+      double y = p[Geom::Y] - bb.midpoint ()[Geom::Y];
+      double f = std::min ((double) rs.size () - 1, std::max (0.0, x / slen * (rs.size () - 1)));
+      size_t i = std::min (rs.size () - 2, (size_t) f);
+      double t = f - i;
+      Point  base = Geom::lerp (t, rs[i], rs[i + 1]);
+      Point  n    = safe_unit (Geom::lerp (t, nr[i], nr[i + 1]), Point (0, 1));
+
+      return base + n * y;
+    };
+
+  for (int c = 0; c < copies; c++)
+    for (const Polyline &pl : sample_pv (shape, 1.5))
+      {
+        std::vector<Point> mapped;
+
+        for (const Point &p : pl.pts)
+          mapped.push_back (map (p, c));
+
+        out.push_back (fit_points (mapped, pl.closed, 0.3));
+      }
+
+  return out;
+}
+
+static Geom::PathVector
+apply_effect (GKeyFile *kf, const gchar *g, const Geom::PathVector &in, GimpImage *image)
+{
+  std::string      type = ks (kf, g, "type");
+  Geom::PathVector out;
+
+  if (type == "zigzag" || type == "wave" || type == "roughen")
+    {
+      double size   = kd (kf, g, "size", 8);
+      double ridges = kd (kf, g, "ridges", 24);
+      double length = kd (kf, g, "wavelength", 60);
+      bool   smooth = kd (kf, g, "smooth", 0) > 0.5 || type != "zigzag";
+      std::mt19937 rnd ((unsigned) kd (kf, g, "seed", 1));
+      std::uniform_real_distribution<double> uni (-1.0, 1.0);
+
+      for (const Polyline &pl : sample_pv (in, 1.0))
+        {
+          double             total = polyline_length (pl.pts, pl.closed);
+          int                n;
+          std::vector<Point> rp, nr, res;
+
+          if (type == "zigzag")
+            n = std::max (4, (int) ridges * 2) + (pl.closed ? 0 : 1);
+          else if (type == "wave")
+            n = std::max (16, (int) (total / std::max (2.0, length / 8.0)));
+          else
+            n = std::max (8, (int) (total / std::max (1.0, 100.0 / kd (kf, g, "detail", 20))));
+
+          rp = resample (pl.pts, pl.closed, n);
+          nr = normals (rp, pl.closed);
+
+          for (size_t i = 0; i < rp.size (); i++)
+            {
+              double d;
+
+              if (type == "zigzag")
+                d = size * ((i % 2) ? 1 : -1);
+              else if (type == "wave")
+                d = size * std::sin (2 * M_PI / std::max (1.0, length) *
+                                     total * i / (pl.closed ? n : n - 1));
+              else
+                d = size * uni (rnd);
+
+              res.push_back (rp[i] + nr[i] * d);
+            }
+
+          out.push_back (fit_points (res, pl.closed, 0.4, ! smooth));
+        }
+    }
+  else if (type == "twist" || type == "pucker")
+    {
+      Point  c   = pv_bounds (in).midpoint ();
+      double amt = kd (kf, g, type == "twist" ? "angle" : "amount", type == "twist" ? 90 : 40);
+      double rmax = 1;
+
+      for (const Polyline &pl : sample_pv (in, 2.0))
+        for (const Point &p : pl.pts)
+          rmax = std::max (rmax, Geom::distance (p, c));
+
+      for (const Polyline &pl : sample_pv (in, 2.0))
+        {
+          std::vector<Point> res;
+          int                n = pl.pts.size ();
+
+          for (int i = 0; i < n; i++)
+            {
+              Point  d = pl.pts[i] - c;
+              double r = Geom::L2 (d);
+
+              if (type == "twist")
+                {
+                  double a = amt * M_PI / 180 * (1 - r / rmax);
+
+                  res.push_back (c + d * Geom::Rotate (a));
+                }
+              else
+                {
+                  /*  pucker (< 0) / bloat (> 0): 0 at the corners of a
+                   *  regular shape, maximal between them
+                   */
+                  double w = std::fabs (std::sin (M_PI * 6 * i / n));
+
+                  res.push_back (c + d * (1 + amt / 100.0 * w));
+                }
+            }
+
+          out.push_back (fit_points (res, pl.closed, 0.4));
+        }
+    }
+  else if (type == "taper" || type == "powerstroke")
+    {
+      double width = kd (kf, g, "width", 12);
+      std::function<double (double)> prof;
+
+      if (type == "taper")
+        {
+          double s = std::max (0.0, kd (kf, g, "start", 0.2));
+          double e = std::max (0.0, kd (kf, g, "end", 0.2));
+
+          prof = [=] (double t)
+            {
+              double f = 1.0;
+
+              if (s > 0 && t < s)
+                f = t / s;
+              if (e > 0 && t > 1 - e)
+                f = std::min (f, (1 - t) / e);
+
+              return width * std::sqrt (std::max (0.0, f));
+            };
+        }
+      else
+        {
+          prof = width_profile (ks (kf, g, "widths"), width);
+        }
+
+      for (const Polyline &pl : sample_pv (in, 1.0))
+        out.push_back (width_shape (pl.pts, pl.closed, prof));
+    }
+  else if (type == "envelope")
+    {
+      Geom::Rect bb = pv_bounds (in);
+      Point      tl = bb.corner (0) + Point (kd (kf, g, "tl-x", 0), kd (kf, g, "tl-y", 0));
+      Point      tr = bb.corner (1) + Point (kd (kf, g, "tr-x", 0), kd (kf, g, "tr-y", 0));
+      Point      br = bb.corner (2) + Point (kd (kf, g, "br-x", 0), kd (kf, g, "br-y", 0));
+      Point      bl = bb.corner (3) + Point (kd (kf, g, "bl-x", 0), kd (kf, g, "bl-y", 0));
+
+      for (const Polyline &pl : sample_pv (in, 1.5))
+        {
+          std::vector<Point> res;
+
+          for (const Point &p : pl.pts)
+            {
+              double u = (p[Geom::X] - bb.left ()) / std::max (1.0, bb.width ());
+              double v = (p[Geom::Y] - bb.top ())  / std::max (1.0, bb.height ());
+
+              res.push_back (Geom::lerp (v, Geom::lerp (u, tl, tr), Geom::lerp (u, bl, br)));
+            }
+
+          out.push_back (fit_points (res, pl.closed, 0.3));
+        }
+    }
+  else if (type == "bend")
+    {
+      /*  the horizontal axis becomes an arc of « angle » degrees  */
+      Geom::Rect bb    = pv_bounds (in);
+      double     angle = kd (kf, g, "angle", 60) * M_PI / 180;
+
+      if (std::fabs (angle) < 1e-3)
+        return in;
+
+      double R  = bb.width () / angle;
+      Point  cc = Point (bb.midpoint ()[Geom::X], bb.midpoint ()[Geom::Y] + R);
+
+      for (const Polyline &pl : sample_pv (in, 1.5))
+        {
+          std::vector<Point> res;
+
+          for (const Point &p : pl.pts)
+            {
+              double a = (p[Geom::X] - bb.midpoint ()[Geom::X]) / R;
+              double r = R - (p[Geom::Y] - bb.midpoint ()[Geom::Y]);
+
+              res.push_back (cc + Point (std::sin (a) * r, -std::cos (a) * r));
+            }
+
+          out.push_back (fit_points (res, pl.closed, 0.3));
+        }
+    }
+  else if (type == "pattern")
+    {
+      Geom::PathVector pattern = layer_pv (image, kd (kf, g, "pattern-tattoo", 0));
+
+      if (pattern.empty ())
+        return in;
+
+      out = along_path (pattern, in, kd (kf, g, "repeat", 1) > 0.5, kd (kf, g, "spacing", 4));
+    }
+  else if (type == "along")
+    {
+      /*  this shape bent along another path (Inkscape « Bend »)  */
+      Geom::PathVector spine = layer_pv (image, kd (kf, g, "spine-tattoo", 0));
+
+      if (spine.empty ())
+        return in;
+
+      out = along_path (in, spine, false, 0);
+    }
+  else if (type == "offset")
+    {
+      double d = kd (kf, g, "distance", 5);
+      Geom::PathVector ring = outline_pv (in, 2 * std::fabs (d), CHOPGIMP_JOIN_ROUND,
+                                          CHOPGIMP_CAP_ROUND);
+
+      out = bool_op (in, ring, d > 0 ? CHOPGIMP_BOOL_UNION : CHOPGIMP_BOOL_DIFFERENCE);
+    }
+  else if (type == "round")
+    {
+      Geom::PathVector res;
+
+      for (const Geom::Path &p : in)
+        {
+          std::vector<Seg> segs = round_segs (path_to_segs (p), p.closed (),
+                                              kd (kf, g, "radius", 10), NULL);
+          Stroke st = segs_to_stroke (segs, p.closed ());
+
+          res.push_back (stroke_to_path (st, false));
+        }
+
+      out = res;
+    }
+  else
+    {
+      return in;
+    }
+
+  return out.empty () ? in : out;
+}
+
+extern "C" GimpPath *
+chopgimp_geom_effects (GimpPath    *path,
+                       const gchar *spec)
+{
+  GKeyFile        *kf = g_key_file_new ();
+  gchar          **groups;
+  Geom::PathVector pv;
+  GimpImage       *image = gimp_item_get_image (GIMP_ITEM (path));
+
+  if (! spec || ! g_key_file_load_from_data (kf, spec, -1, G_KEY_FILE_NONE, NULL))
+    {
+      g_key_file_free (kf);
+      return NULL;
+    }
+
+  pv     = to_pv (path);
+  groups = g_key_file_get_groups (kf, NULL);
+
+  /*  the effects apply in the order of their groups ([0], [1]…)  */
+  std::vector<std::string> order;
+
+  for (gchar **g = groups; g && *g; g++)
+    order.push_back (*g);
+
+  std::sort (order.begin (), order.end (),
+             [] (const std::string &a, const std::string &b)
+             { return atoi (a.c_str ()) < atoi (b.c_str ()); });
+
+  for (const std::string &g : order)
+    {
+      if (kd (kf, g.c_str (), "enabled", 1) < 0.5)
+        continue;
+
+      try
+        {
+          pv = apply_effect (kf, g.c_str (), pv, image);
+        }
+      catch (std::exception &e)
+        {
+          g_warning ("ChopGimp path effect %s: %s", g.c_str (), e.what ());
+        }
+    }
+
+  g_strfreev (groups);
+  g_key_file_free (kf);
+
+  return from_pv (path, pv);
+}
