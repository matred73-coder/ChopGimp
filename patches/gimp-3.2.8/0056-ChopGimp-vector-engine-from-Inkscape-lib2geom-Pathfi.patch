+G_BEGIN_DECLS
+
+typedef enum
+{
+  CHOPGIMP_BOOL_UNION,
+  CHOPGIMP_BOOL_DIFFERENCE,    /* the first path minus all the others  */
+  CHOPGIMP_BOOL_INTERSECTION,
+  CHOPGIMP_BOOL_EXCLUSION
+} ChopGimpBoolOp;
+
+typedef enum
+{
+  CHOPGIMP_JOIN_MITER,
+  CHOPGIMP_JOIN_ROUND,
+  CHOPGIMP_JOIN_BEVEL
+} ChopGimpJoin;
+
+typedef enum
+{
+  CHOPGIMP_CAP_BUTT,
+  CHOPGIMP_CAP_ROUND,
+  CHOPGIMP_CAP_SQUARE
+} ChopGimpCap;
+
+typedef enum
+{
+  CHOPGIMP_NODES_CORNER,       /* handles retracted                      */
+  CHOPGIMP_NODES_SMOOTH,       /* handles aligned, lengths kept          */
+  CHOPGIMP_NODES_SYMMETRIC,    /* handles aligned, same length           */
+  CHOPGIMP_NODES_AUTO,         /* handles from the neighbours            */
+  CHOPGIMP_NODES_TO_LINE,      /* segments between selected nodes → line */
+  CHOPGIMP_NODES_TO_CURVE,     /* line segments → curves                 */
+  CHOPGIMP_NODES_ALIGN_LEFT,
+  CHOPGIMP_NODES_ALIGN_HCENTER,
+  CHOPGIMP_NODES_ALIGN_RIGHT,
+  CHOPGIMP_NODES_ALIGN_TOP,
+  CHOPGIMP_NODES_ALIGN_VCENTER,
+  CHOPGIMP_NODES_ALIGN_BOTTOM,
+  CHOPGIMP_NODES_DISTRIBUTE_H,
+  CHOPGIMP_NODES_DISTRIBUTE_V,
+  CHOPGIMP_NODES_DELETE_KEEP,  /* delete, refit the curve                */
+  CHOPGIMP_NODES_JOIN,         /* join two selected end nodes            */
+  CHOPGIMP_NODES_BREAK,        /* cut the path at the selected nodes     */
+  CHOPGIMP_NODES_ROUND,        /* round the selected corners (value = r) */
+  CHOPGIMP_NODES_SELECT_ALL,
+  CHOPGIMP_NODES_SELECT_NONE
+} ChopGimpNodesOp;
+
+/*  all functions returning a GimpPath return a new, unattached path
+ *  of the image of their input (NULL on failure or empty result)
+ */
+GimpPath  * chopgimp_geom_boolean       (GimpPath       **paths,
+                                         gint             n_paths,
+                                         ChopGimpBoolOp   op);
+GimpPath ** chopgimp_geom_divide        (GimpPath       **paths,
+                                         gint             n_paths,
+                                         gint            *n_pieces);
+GimpPath  * chopgimp_geom_offset        (GimpPath        *path,
+                                         gdouble          distance,
+                                         ChopGimpJoin     join);
+GimpPath  * chopgimp_geom_outline       (GimpPath        *path,
+                                         gdouble          width,
+                                         ChopGimpJoin     join,
+                                         ChopGimpCap      cap);
+GimpPath  * chopgimp_geom_simplify      (GimpPath        *path,
+                                         gdouble          tolerance);
+GimpPath  * chopgimp_geom_round_corners (GimpPath        *path,
