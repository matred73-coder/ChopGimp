+// SPDX-License-Identifier: GPL-2.0-or-later
+/* ChopGimp: declarations taken from Inkscape 1.4 src/helper/geom-pathstroke.h
+ * (Authors: Liam P. White, Tavmjong Bah, Alexander Brock), only what the
+ * outline / offset code needs.
+ */
+#pragma once
+
+#include <vector>
+#include <2geom/path.h>
+#include <2geom/pathvector.h>
+
+namespace Inkscape {
+
+enum LineJoinType {
+    JOIN_BEVEL,
+    JOIN_ROUND,
+    JOIN_MITER,
+    JOIN_MITER_CLIP,
+    JOIN_EXTRAPOLATE,
+    JOIN_EXTRAPOLATE1,
+    JOIN_EXTRAPOLATE2,
+    JOIN_EXTRAPOLATE3,
+};
+
+enum LineCapType {
+    BUTT_FLAT,
+    BUTT_ROUND,
+    BUTT_SQUARE,
+    BUTT_PEAK,
+};
+
+Geom::PathVector outline (Geom::Path const &input, double width, double miter,
+                          LineJoinType join = JOIN_BEVEL, LineCapType cap = BUTT_FLAT,
+                          double tolerance = -1);
+
+Geom::Path half_outline (Geom::Path const &input, double width, double miter,
+                         LineJoinType join = JOIN_BEVEL, double tolerance = -1);
+
+void outline_join (Geom::Path &res, Geom::Path const &outgoing, Geom::Point in_tang,
+                   Geom::Point out_tang, double width, double miter, LineJoinType join);
+
+} // namespace Inkscape
