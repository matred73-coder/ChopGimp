+/*  ChopGimp: live path effects. When the layer carries the parasite
+ *  « chopgimp-lpe » (a key file: one group per effect), it is drawn from
+ *  the path transformed by the effects; its own path stays editable, and
+ *  the result follows every change of it, like Inkscape's path effects.
+ */
+GimpPath *
+chopgimp_vector_layer_path_by_tattoo (GimpImage *image,
+                                      guint      tattoo)
+{
+  GimpLayer *layer = gimp_image_get_layer_by_tattoo (image, tattoo);
+
+  if (GIMP_IS_VECTOR_LAYER (layer))
+    return gimp_vector_layer_get_path (GIMP_VECTOR_LAYER (layer));
+
+  return NULL;
+}
+
+static GimpPath *
+chopgimp_vector_layer_effective_path (GimpVectorLayer *layer)
+{
+  const GimpParasite *parasite;
+  gchar              *spec;
+  guint32             size = 0;
+  const gchar        *data;
+  GimpPath           *path;
+
+  if (! layer->options || ! layer->options->path)
+    return NULL;
+
+  parasite = gimp_item_parasite_find (GIMP_ITEM (layer), "chopgimp-lpe");
+  if (! parasite)
+    return NULL;
+
+  data = gimp_parasite_get_data (parasite, &size);
+  if (! data || size == 0)
+    return NULL;
+
+  spec = g_strndup (data, size);
+  path = chopgimp_geom_effects (layer->options->path, spec);
+  g_free (spec);
+
+  return path;
+}
