From f8a1e78658ca11f267b0c48c638105edf708f340 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Sat, 14 Nov 2026 21:54:58 +0100
Subject: [PATCH] ChopGimp: clone source - no cross at the old source while
 choosing a new one

---
 app/tools/gimpsourcetool.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/app/tools/gimpsourcetool.c b/app/tools/gimpsourcetool.c
index 7c683cb..30fe194 100644
--- a/app/tools/gimpsourcetool.c
+++ b/app/tools/gimpsourcetool.c
@@ -442,7 +442,11 @@ gimp_source_tool_draw (GimpDrawTool *draw_tool)
             }
         }
 
-      if (source_tool->src_outline)
+      /* ChopGimp (Photoshop) : pendant le choix d'une nouvelle source
+       * (modificateur enfoncé), rien n'est dessiné à l'ancienne : la
+       * croix qui remplaçait le contour prêtait à confusion.
+       */
+      if (source_tool->src_outline || ! source_tool->show_source_outline)
         {
           if (source_tool->src_handle)
             {
-- 
