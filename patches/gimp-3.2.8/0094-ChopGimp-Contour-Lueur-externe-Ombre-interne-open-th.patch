From 46164e5670f656089ca44bf75f800e40d1dd5ce8 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Sat, 14 Nov 2026 22:35:23 +0100
Subject: [PATCH] ChopGimp: Contour, Lueur externe, Ombre interne open their
 filter dialog with preset settings (like Drop Shadow)

---
 app/actions/filters-actions.c     | 38 +++++++++++++++++++++++++++++++
 app/actions/filters-commands.c    | 18 +++++++++++++--
 app/dialogs/chopgimp-textpanels.c |  4 ++--
 3 files changed, 56 insertions(+), 4 deletions(-)

diff --git a/app/actions/filters-actions.c b/app/actions/filters-actions.c
index ffab83c..9625f09 100644
--- a/app/actions/filters-actions.c
+++ b/app/actions/filters-actions.c
@@ -275,6 +275,40 @@ static const GimpStringActionEntry filters_interactive_actions[] =
     "gegl:dropshadow",
     GIMP_HELP_FILTER_DROPSHADOW },
 
+  /*  ChopGimp : styles de calque façon Photoshop, chacun dans la fenêtre
+   *  de son filtre (comme l'ombre portée), avec des réglages de départ.
+   */
+  { "filters-chopgimp-stroke", GIMP_ICON_GEGL,
+    NC_("filters-action", "Contour..."), NULL, { NULL }, NULL,
+    "gegl:dropshadow\n"
+    "(x 0.0)(y 0.0)(radius 0.0)(grow-shape circle)(grow-radius 3.0)"
+    "(color (color-rgba 0.0 0.0 0.0 1.0))(opacity 1.0)",
+    GIMP_HELP_FILTER_DROPSHADOW },
+
+  { "filters-chopgimp-outer-glow", GIMP_ICON_GEGL,
+    NC_("filters-action", "Lueur externe..."), NULL, { NULL }, NULL,
+    "gegl:dropshadow\n"
+    "(x 0.0)(y 0.0)(radius 18.0)(grow-shape circle)(grow-radius 2.0)"
+    "(color (color-rgba 1.0 0.93 0.6 1.0))(opacity 1.0)",
+    GIMP_HELP_FILTER_DROPSHADOW },
+
+  { "filters-chopgimp-inner-shadow", GIMP_ICON_GEGL,
+    NC_("filters-action", "Ombre interne..."), NULL, { NULL }, NULL,
+    /*  gegl:inner-glow ne rend que la lueur : mode Normal (posée sur le
+     *  calque) au lieu de Remplacer, sinon l'intérieur devient transparent
+     */
+    "gegl:inner-glow\n"
+    "(x 4.0)(y 4.0)(radius 8.0)(grow-radius 2.0)"
+    "(value (color-rgba 0.0 0.0 0.0 1.0))(opacity 0.75)(gimp-mode normal)",
+    NULL },
+
+  { "filters-chopgimp-inner-glow", GIMP_ICON_GEGL,
+    NC_("filters-action", "Lueur interne..."), NULL, { NULL }, NULL,
+    "gegl:inner-glow\n"
+    "(x 0.0)(y 0.0)(radius 10.0)(grow-radius 0.0)"
+    "(value (color-rgba 1.0 1.0 0.75 1.0))(opacity 0.75)(gimp-mode normal)",
+    NULL },
+
   { "filters-edge", GIMP_ICON_GEGL,
     NC_("filters-action", "_Edge..."), NULL, { NULL }, NULL,
     "gegl:edge",
@@ -1069,6 +1103,10 @@ filters_actions_update (GimpActionGroup *group,
   SET_SENSITIVE ("filters-desaturate",              writable && !gray);
 
   SET_SENSITIVE ("filters-dropshadow",              writable && alpha);
+  SET_SENSITIVE ("filters-chopgimp-stroke",         writable && alpha);
+  SET_SENSITIVE ("filters-chopgimp-outer-glow",     writable && alpha);
+  SET_SENSITIVE ("filters-chopgimp-inner-shadow",   writable && alpha);
+  SET_SENSITIVE ("filters-chopgimp-inner-glow",     writable && alpha);
   SET_SENSITIVE ("filters-edge",                    writable && !is_group);
   SET_SENSITIVE ("filters-hue-saturation",          writable && !gray);
   SET_SENSITIVE ("filters-long-shadow",             writable && alpha);
diff --git a/app/actions/filters-commands.c b/app/actions/filters-commands.c
index 9beecec..7062b6a 100644
--- a/app/actions/filters-commands.c
+++ b/app/actions/filters-commands.c
@@ -119,6 +119,8 @@ filters_apply_interactive_cmd_callback (GimpAction *action,
 {
   GimpImage     *image;
   GList         *drawables;
+  gchar         *operation;
+  GimpObject    *settings;
   GimpProcedure *procedure;
   GVariant      *variant;
 
@@ -131,16 +133,28 @@ filters_apply_interactive_cmd_callback (GimpAction *action,
       return;
     }
 
+  /*  ChopGimp : « opération\n(réglages) » ouvre la fenêtre du filtre
+   *  avec ces réglages de départ (styles Contour, Lueur externe…)
+   */
+  operation = filters_parse_operation (image->gimp,
+                                       g_variant_get_string (value, NULL),
+                                       gimp_action_get_icon_name (action),
+                                       &settings);
+
   procedure = gimp_gegl_procedure_new (image->gimp,
                                        NULL,
-                                       GIMP_RUN_INTERACTIVE, NULL,
-                                       g_variant_get_string (value, NULL),
+                                       GIMP_RUN_INTERACTIVE, settings,
+                                       operation,
                                        gimp_action_get_name (action),
                                        gimp_action_get_label (action),
                                        gimp_action_get_tooltip (action),
                                        gimp_action_get_icon_name (action),
                                        gimp_action_get_help_id (action));
 
+  g_free (operation);
+  if (settings)
+    g_object_unref (settings);
+
   gimp_filter_history_add (image->gimp, procedure);
 
   variant = g_variant_new_uint64 (GPOINTER_TO_SIZE (procedure));
diff --git a/app/dialogs/chopgimp-textpanels.c b/app/dialogs/chopgimp-textpanels.c
index 562444a..bd2fc83 100644
--- a/app/dialogs/chopgimp-textpanels.c
+++ b/app/dialogs/chopgimp-textpanels.c
@@ -1688,8 +1688,8 @@ panel_new (Gimp *gimp, gboolean paragraph)
       {
         static const gchar *const effects[] =
         {
-          "chopgimp-layer-style",         N_("Ombre…"),
-          "photogimp-style-stroke",       N_("Contour…"),
+          "filters-dropshadow",           N_("Ombre…"),
+          "filters-chopgimp-stroke",      N_("Contour…"),
           "chopgimp-fx-gradient-overlay", N_("Dégradé…"),
           NULL
         };
-- 
2.53.0

