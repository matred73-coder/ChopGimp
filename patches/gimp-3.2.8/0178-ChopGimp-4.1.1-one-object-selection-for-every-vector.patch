+/*  4.1.1: « mixte » where the edited objects differ  */
+static gboolean
+same_paint (const ChopGimpVEntry *a,
+            const ChopGimpVEntry *b)
+{
+  gboolean ona = a && a->visible && a->paint.type != CHOPGIMP_PAINT_NONE;
+  gboolean onb = b && b->visible && b->paint.type != CHOPGIMP_PAINT_NONE;
+  guint8   ca[4], cb[4];
+
+  if (ona != onb)
+    return FALSE;
+  if (! ona)
+    return TRUE;
+  if (a->paint.type != b->paint.type)
+    return FALSE;
+  if (a->paint.type != CHOPGIMP_PAINT_COLOR)
+    return a->paint.pattern == b->paint.pattern;
+  if (! a->paint.color || ! b->paint.color)
+    return a->paint.color == b->paint.color;
+
+  gegl_color_get_pixel (a->paint.color, babl_format ("R'G'B'A u8"), ca);
+  gegl_color_get_pixel (b->paint.color, babl_format ("R'G'B'A u8"), cb);
+
+  return memcmp (ca, cb, 4) == 0;
+}
+
+static void
+props_compute_mixed (ChopGimpVObjectProps *p,
+                     GList                *targets)
+{
+  ChopGimpVObject *first = targets ? targets->data : NULL;
+
+  p->fill_mixed = p->stroke_mixed = p->width_mixed = p->opacity_mixed = FALSE;
+
+  for (GList *l = targets ? targets->next : NULL; l; l = l->next)
+    {
+      ChopGimpVObject *o  = l->data;
+      ChopGimpVEntry  *f0 = chopgimp_vstyle_get_fill (&first->style);
+      ChopGimpVEntry  *s0 = chopgimp_vstyle_get_stroke (&first->style);
+      ChopGimpVEntry  *f  = chopgimp_vstyle_get_fill (&o->style);
+      ChopGimpVEntry  *s  = chopgimp_vstyle_get_stroke (&o->style);
+
+      if (! same_paint (f0, f))
+        p->fill_mixed = TRUE;
+      if (! same_paint (s0, s))
+        p->stroke_mixed = TRUE;
+      if (fabs ((s0 ? s0->width : 0.0) - (s ? s->width : 0.0)) > 1e-6)
+        p->width_mixed = TRUE;
+      if (fabs (first->opacity - o->opacity) > 1e-6)
+        p->opacity_mixed = TRUE;
+    }
+}
+
+static void
+props_show_mixed (ChopGimpVObjectProps *p)
+{
+  if (p->fill_widget)
+    {
+      gtk_widget_set_opacity (p->fill_widget, p->fill_mixed ? 0.45 : 1.0);
+      gimp_help_set_help_data (p->fill_widget,
+                               p->fill_mixed ? _("Fond des objets : mixte "
+                                                 "(les objets sélectionnés diffèrent)")
+                                             : _("Fond des objets"), NULL);
+    }
+  if (p->stroke_widget)
+    {
+      gtk_widget_set_opacity (p->stroke_widget, p->stroke_mixed ? 0.45 : 1.0);
+      gimp_help_set_help_data (p->stroke_widget,
+                               p->stroke_mixed ? _("Contour des objets : mixte "
+                                                   "(les objets sélectionnés diffèrent)")
+                                               : _("Contour des objets"), NULL);
+    }
+  if (p->width_widget)
+    chopgimp_value_field_set_mixed (CHOPGIMP_VALUE_FIELD (p->width_widget), p->width_mixed);
+  if (p->opacity_widget)
+    chopgimp_value_field_set_mixed (CHOPGIMP_VALUE_FIELD (p->opacity_widget), p->opacity_mixed);
+}
