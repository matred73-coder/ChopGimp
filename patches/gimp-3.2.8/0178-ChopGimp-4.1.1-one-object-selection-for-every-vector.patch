+/*  ─── 4.1.1: the one object selection and what a style change edits ── */
+
+/*  the path objects a style change edits: the visible, unlocked leaves of
+ *  the selected objects (a group gives its leaves), each one once, bottom
+ *  first. Every style edit (bar, panels, colors, commands) goes through
+ *  this list: one source of truth.
+ */
+GList *
+chopgimp_vobjects_style_targets (GimpVectorLayer *layer)
+{
+  GList      *objs;
+  GList      *targets = NULL;
+  GHashTable *seen;
+
+  if (! layer || ! chopgimp_vlayer_get_root (layer))
+    return NULL;
+
+  objs = chopgimp_vlayer_get_selected_objects (layer);
+  seen = g_hash_table_new (NULL, NULL);
+
+  for (GList *o = objs; o; o = o->next)
+    {
+      GList *leaves = chopgimp_vobjects_leaves_of (o->data);
+
+      for (GList *l = leaves; l; l = l->next)
+        {
+          ChopGimpVObject *leaf = l->data;
+
+          if (leaf->kind != CHOPGIMP_VOBJECT_PATH        ||
+              ! chopgimp_vobject_is_visible (leaf)       ||
+              chopgimp_vobject_is_locked (leaf)          ||
+              g_hash_table_contains (seen, GUINT_TO_POINTER (leaf->id)))
+            continue;
+
+          g_hash_table_add (seen, GUINT_TO_POINTER (leaf->id));
+          targets = g_list_prepend (targets, leaf);
+        }
+
+      g_list_free (leaves);
+    }
+
+  g_hash_table_destroy (seen);
+  g_list_free (objs);
+
+  return g_list_reverse (targets);
+}
+
+/*  one undo step per modification: a burst of changes of the same kind
+ *  (a slider, the color dialog) on the same layer, with nothing else
+ *  pushed in between, is one step. TRUE when a step was pushed.
+ */
+gboolean
+chopgimp_vobjects_style_undo (GimpVectorLayer *layer,
+                              const gchar     *desc)
+{
+  static GimpVectorLayer *last_layer = NULL;
+  static GQuark           last_desc  = 0;
+  static gint64           last_time  = 0;
+  static gpointer         last_undo  = NULL;
+  GimpImage              *image      = gimp_item_get_image (GIMP_ITEM (layer));
+  GQuark                  q          = g_quark_from_string (desc ? desc : "");
+  gint64                  now        = g_get_monotonic_time ();
+  gpointer                top;
+
+  top = gimp_undo_stack_peek (gimp_image_get_undo_stack (image));
+
+  if (layer == last_layer && q == last_desc && top && top == last_undo &&
+      now - last_time < 700000)
+    {
+      last_time = now;
+      return FALSE;
+    }
+
+  chopgimp_vlayer_push_undo (layer, desc);
+
+  last_layer = layer;
+  last_desc  = q;
+  last_time  = now;
+  last_undo  = gimp_undo_stack_peek (gimp_image_get_undo_stack (image));
+
+  return TRUE;
+}
+
+static gboolean
+paint_has_color (const ChopGimpVEntry *e,
+                 GeglColor            *color)
+{
+  guint8 a[4], b[4];
+
+  if (! e || ! e->visible || e->paint.type != CHOPGIMP_PAINT_COLOR ||
+      ! e->paint.color || ! color)
+    return FALSE;
+
+  gegl_color_get_pixel (e->paint.color, babl_format ("R'G'B'A u8"), a);
+  gegl_color_get_pixel (color, babl_format ("R'G'B'A u8"), b);
+
+  return memcmp (a, b, 4) == 0;
+}
