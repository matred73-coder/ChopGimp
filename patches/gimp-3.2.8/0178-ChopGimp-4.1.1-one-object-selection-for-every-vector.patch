+      chopgimp_vstyle_init (&st);
+      chopgimp_vstyle_copy (&st, &leaf->style);
+      chopgimp_vstyle_init (&tmp);
+      chopgimp_vstyle_copy (&tmp, &bar);
+
+      if (fill)
+        chopgimp_vstyle_copy_primary_fill (&st, &tmp);
+      else
+        chopgimp_vstyle_copy_primary_stroke (&st, &tmp);
+
+      chopgimp_vstyle_clear (&tmp);
+
+      chopgimp_vlayer_set_style (layer, leaf->id, &st, FALSE);
+      chopgimp_vstyle_clear (&st);
     }
 
   chopgimp_vlayer_thaw (layer);
-  g_list_free (objs);
+
+  chopgimp_vstyle_clear (&bar);
+  g_list_free (targets);
+
+  return TRUE;
+}
+
+/*  the style of the first target into a tool's options (the options bar
+ *  shows the selection); FALSE when nothing is selected
+ */
+gboolean
+chopgimp_vobjects_load_tool_style (GimpVectorLayer   *layer,
+                                   gboolean          *enable_fill,
+                                   GimpFillOptions   *fill_options,
+                                   gboolean          *enable_stroke,
+                                   GimpStrokeOptions *stroke_options)
+{
+  GList                  *targets = chopgimp_vobjects_style_targets (layer);
+  ChopGimpVObject        *leaf    = targets ? targets->data : NULL;
+  GimpVectorLayerOptions *tmp;
+
+  g_list_free (targets);
+
+  if (! leaf)
+    return FALSE;
+
+  tmp = g_object_new (GIMP_TYPE_VECTOR_LAYER_OPTIONS,
+                      "gimp", gimp_item_get_image (GIMP_ITEM (layer))->gimp,
+                      NULL);
+  chopgimp_vstyle_to_options (&leaf->style, tmp);
+
+  *enable_fill   = tmp->enable_fill;
+  *enable_stroke = tmp->enable_stroke;
+
+  if (fill_options)
+    gimp_config_sync (G_OBJECT (tmp->fill_options), G_OBJECT (fill_options), 0);
+  if (stroke_options)
+    gimp_config_sync (G_OBJECT (tmp->stroke_options), G_OBJECT (stroke_options), 0);
+
+  g_object_unref (tmp);
+
+  return TRUE;
+}
+
+/*  the colors of the first target: its plain fill and stroke colors
+ *  (owned by the object), NULL when not a plain color
+ */
+gboolean
+chopgimp_vobjects_selection_colors (GimpVectorLayer  *layer,
+                                    GeglColor       **fill,
+                                    GeglColor       **stroke)
+{
+  GList           *targets = chopgimp_vobjects_style_targets (layer);
+  ChopGimpVObject *leaf    = targets ? targets->data : NULL;
+  ChopGimpVEntry  *e;
+
+  g_list_free (targets);
+
+  *fill = *stroke = NULL;
+
+  if (! leaf)
+    return FALSE;
+
+  e = chopgimp_vstyle_get_fill (&leaf->style);
+  if (e && e->visible && e->paint.type == CHOPGIMP_PAINT_COLOR)
+    *fill = e->paint.color;
+
+  e = chopgimp_vstyle_get_stroke (&leaf->style);
+  if (e && e->visible && e->paint.type == CHOPGIMP_PAINT_COLOR && e->width > 0.0)
+    *stroke = e->paint.color;
 
   return TRUE;
 }
