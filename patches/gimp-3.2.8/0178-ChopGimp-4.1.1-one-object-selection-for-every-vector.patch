+/*  4.1.1: the objects owning the selected nodes of the edited path, plus
+ *  the object clicked, plus the previous selection with Maj, become the
+ *  one object selection (a click in the void: nothing)
+ */
+static void
+gimp_path_tool_vobj_select_owners (GimpPathTool *path_tool)
+{
+  GimpVectorLayer *layer = path_tool->vobj_layer;
+  GArray          *ids;
+  GimpStroke      *s = NULL;
+
+  path_tool->vobj_track = FALSE;
+
+  if (! layer || ! path_tool->vobj_path || ! gimp_item_is_attached (GIMP_ITEM (layer)))
+    return;
+
+  ids = g_array_new (FALSE, FALSE, sizeof (guint));
+
+#define ADD_ID(id) G_STMT_START {                                   \
+    guint _id = (id);                                               \
+    gboolean _has = FALSE;                                          \
+    for (guint _i = 0; _i < ids->len && ! _has; _i++)               \
+      _has = g_array_index (ids, guint, _i) == _id;                 \
+    if (_id && ! _has && chopgimp_vlayer_get_object (layer, _id))   \
+      g_array_append_val (ids, _id);                                \
+  } G_STMT_END
+
+  if (path_tool->vobj_press_shift && path_tool->vobj_prev_sel)
+    for (guint i = 0; i < path_tool->vobj_prev_sel->len; i++)
+      ADD_ID (g_array_index (path_tool->vobj_prev_sel, guint, i));
+
+  while ((s = gimp_path_stroke_get_next (path_tool->vobj_path, s)))
+    {
+      guint id = path_tool->vobj_multi
+                 ? GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (s), CHOPGIMP_VOBJ_ID_KEY))
+                 : path_tool->vobj_id;
+
+      for (GList *l = s->anchors->head; l; l = l->next)
+        if (((GimpAnchor *) l->data)->selected)
+          {
+            ADD_ID (id);
+            break;
+          }
+    }
+
+  ADD_ID (path_tool->vobj_press_leaf);
+
+#undef ADD_ID
+
+  {
+    const guint *cur;
+    gint         n    = 0;
+    gboolean     same;
+
+    cur  = chopgimp_vlayer_get_selection (layer, &n);
+    same = (guint) n == ids->len;
+
+    for (guint i = 0; i < ids->len && same; i++)
+      same = chopgimp_vlayer_is_selected (layer, g_array_index (ids, guint, i));
+
+    if (! same)
+      chopgimp_vlayer_set_selection (layer, (const guint *) ids->data, ids->len);
+
+    (void) cur;
+  }
+
+  g_array_free (ids, TRUE);
+}
