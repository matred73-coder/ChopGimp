 =?UTF-8?q?preview=20=C2=AB=20Contours=20+=20source=20=C2=BB=20draws=20the?=
 =?UTF-8?q?=20outlines=20over=20the=20source=20pixels=20(also=20when=20the?=
 =?UTF-8?q?=20layer=20is=20hidden,=20and=20the=20stored=20source=20of=20a?=
 =?UTF-8?q?=20live=20trace);=20=C2=AB=20Options=20de=20vectorisation?=
 =?UTF-8?q?=E2=80=A6=20=C2=BB=20does=20nothing=20on=20a=20layer=20that=20i?=
 =?UTF-8?q?s=20not=20a=20live=20trace?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 app/actions/vector-objects-commands.c |  9 ++++
 app/dialogs/chopgimp-trace-dialog.c   |  1 +
 app/display/chopgimp-canvastrace.c    | 62 +++++++++++++++++++++++----
 app/display/chopgimp-canvastrace.h    |  6 +++
 4 files changed, 69 insertions(+), 9 deletions(-)

diff --git a/app/actions/vector-objects-commands.c b/app/actions/vector-objects-commands.c
index ab63743..4c7a1dd 100644
--- a/app/actions/vector-objects-commands.c
+++ b/app/actions/vector-objects-commands.c
@@ -20,6 +20,8 @@
 
 #include "config.h"
 
+#include <string.h>
+
 #include <gegl.h>
 #include <gtk/gtk.h>
 
@@ -44,6 +46,8 @@
 
 #include "display/gimpdisplay.h"
 
+#include "widgets/gimpaction.h"
+
 #include "actions.h"
 #include "vector-objects-commands.h"
 
@@ -208,6 +212,11 @@ vector_objects_image_trace_cmd_callback (GimpAction *action,
   if (g_list_length (layers) != 1)
     return;
 
+  /*  « Options de vectorisation… »: only on a live trace  */
+  if (! strcmp (gimp_action_get_name (action), "layers-image-trace-options") &&
+      ! chopgimp_trace_layer_is_live (layers->data))
+    return;
+
   chopgimp_trace_dialog_show (image, GIMP_DRAWABLE (layers->data),
                               action_data_get_display (data),
                               action_data_get_context (data), widget);
diff --git a/app/dialogs/chopgimp-trace-dialog.c b/app/dialogs/chopgimp-trace-dialog.c
index 32788a0..f790965 100644
--- a/app/dialogs/chopgimp-trace-dialog.c
+++ b/app/dialogs/chopgimp-trace-dialog.c
@@ -480,6 +480,7 @@ preview_update (Dialog *d)
   if (show && shell && ! d->item)
     {
       d->item = chopgimp_canvas_trace_new (shell, &d->source->rect);
+      chopgimp_canvas_trace_set_source (CHOPGIMP_CANVAS_TRACE (d->item), d->source->buffer);
       gimp_display_shell_add_item (shell, d->item);
     }
   else if (! show && d->item)
diff --git a/app/display/chopgimp-canvastrace.c b/app/display/chopgimp-canvastrace.c
index efd77de..b53aa87 100644
--- a/app/display/chopgimp-canvastrace.c
+++ b/app/display/chopgimp-canvastrace.c
@@ -3,8 +3,8 @@
  * « Vectoriser » on the canvas
  *
  * The traced area is covered with white (the « paper »: the result is
- * seen alone, as in Illustrator) for the views « Résultat » and
- * « Contours »; « Contours + source » draws the outlines over the image.
+ * seen alone, as in Illustrator); « Contours + source » draws the
+ * outlines over the source pixels (even when the layer is hidden).
  *
  * This program is free software: you can redistribute it and/or modify
  * it under the terms of the GNU General Public License as published by
@@ -72,24 +72,44 @@ chopgimp_canvas_trace_draw (GimpCanvasItem *item,
   cairo_translate (cr, -shell->offset_x, -shell->offset_y);
   cairo_scale (cr, shell->scale_x, shell->scale_y);
 
-  if (trace->view != 2)
+  cairo_rectangle (cr, trace->area.x, trace->area.y,
+                   trace->area.width, trace->area.height);
+  cairo_set_source_rgb (cr, 1.0, 1.0, 1.0);
+  cairo_fill (cr);
+
+  if (trace->view == 2 && trace->source)
     {
-      cairo_rectangle (cr, trace->area.x, trace->area.y,
-                       trace->area.width, trace->area.height);
-      cairo_set_source_rgb (cr, 1.0, 1.0, 1.0);
-      cairo_fill (cr);
+      cairo_set_source_surface (cr, trace->source, trace->area.x, trace->area.y);
+      cairo_pattern_set_filter (cairo_get_source (cr),
+                                shell->scale_x > 2.0 ? CAIRO_FILTER_NEAREST
+                                                     : CAIRO_FILTER_GOOD);
+      cairo_paint_with_alpha (cr, 0.6);
     }
 
+  /*  « Contours + source »: the outlines alone, over the source  */
   if (trace->result)
-    chopgimp_trace_result_draw (trace->result, cr, trace->view);
+    chopgimp_trace_result_draw (trace->result, cr, trace->view == 2 ? 1 : trace->view);
 
   cairo_restore (cr);
 }
 
+static void
+chopgimp_canvas_trace_finalize (GObject *object)
+{
+  ChopGimpCanvasTrace *trace = CHOPGIMP_CANVAS_TRACE (object);
+
+  g_clear_pointer (&trace->source, cairo_surface_destroy);
+
+  G_OBJECT_CLASS (chopgimp_canvas_trace_parent_class)->finalize (object);
+}
+
 static void
 chopgimp_canvas_trace_class_init (ChopGimpCanvasTraceClass *klass)
 {
-  GimpCanvasItemClass *item_class = GIMP_CANVAS_ITEM_CLASS (klass);
+  GObjectClass        *object_class = G_OBJECT_CLASS (klass);
+  GimpCanvasItemClass *item_class   = GIMP_CANVAS_ITEM_CLASS (klass);
+
+  object_class->finalize  = chopgimp_canvas_trace_finalize;
 
   item_class->draw        = chopgimp_canvas_trace_draw;
   item_class->get_extents = chopgimp_canvas_trace_get_extents;
@@ -126,3 +146,27 @@ chopgimp_canvas_trace_set_result (ChopGimpCanvasTrace *trace,
   trace->view   = view;
   gimp_canvas_item_end_change (GIMP_CANVAS_ITEM (trace));
 }
+
+void
+chopgimp_canvas_trace_set_source (ChopGimpCanvasTrace *trace,
+                                  GeglBuffer          *buffer)
+{
+  cairo_surface_t *surface = NULL;
+
+  g_return_if_fail (CHOPGIMP_CANVAS_TRACE (trace));
+
+  if (buffer)
+    {
+      surface = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+                                            trace->area.width, trace->area.height);
+      gegl_buffer_get (buffer, &trace->area, 1.0, babl_format ("cairo-ARGB32"),
+                       cairo_image_surface_get_data (surface),
+                       cairo_image_surface_get_stride (surface), GEGL_ABYSS_NONE);
+      cairo_surface_mark_dirty (surface);
+    }
+
+  gimp_canvas_item_begin_change (GIMP_CANVAS_ITEM (trace));
+  g_clear_pointer (&trace->source, cairo_surface_destroy);
+  trace->source = surface;
+  gimp_canvas_item_end_change (GIMP_CANVAS_ITEM (trace));
+}
diff --git a/app/display/chopgimp-canvastrace.h b/app/display/chopgimp-canvastrace.h
index 4c91c8e..f4495d8 100644
--- a/app/display/chopgimp-canvastrace.h
+++ b/app/display/chopgimp-canvastrace.h
@@ -26,6 +26,7 @@ struct _ChopGimpCanvasTrace
   gconstpointer   result;    /* const ChopGimpTraceResult *, borrowed */
   gint            view;      /* 0 result, 1 outlines, 2 outlines + source */
   GeglRectangle   area;      /* the traced area (image px)             */
+  gpointer        source;    /* cairo_surface_t * of the source pixels */
 };
 
 struct _ChopGimpCanvasTraceClass
@@ -38,6 +39,11 @@ GType            chopgimp_canvas_trace_get_type   (void) G_GNUC_CONST;
 
 GimpCanvasItem * chopgimp_canvas_trace_new        (GimpDisplayShell    *shell,
                                                    const GeglRectangle *area);
+/*  the pixels shown under the outlines in the view « Contours + source »
+ *  (a copy is kept; @buffer covers @area)
+ */
+void             chopgimp_canvas_trace_set_source (ChopGimpCanvasTrace *trace,
+                                                   GeglBuffer          *buffer);
 /*  @result is borrowed: set NULL before freeing it  */
 void             chopgimp_canvas_trace_set_result (ChopGimpCanvasTrace *trace,
                                                    gconstpointer        result,
-- 
