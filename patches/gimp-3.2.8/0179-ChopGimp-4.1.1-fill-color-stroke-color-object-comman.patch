From b0d66eccd954eb34780467f07d0a84440be437e7 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Fri, 27 Nov 2026 07:17:23 +0100
Subject: [PATCH] ChopGimp 4.1.1: fill-color / stroke-color object commands
 (tests), no crash when no tool is set

- chopgimp-vobjects-command fill-color:RRGGBB / stroke-color:RRGGBB: the
  color goes to the selection as a swatch does (smoke tests of the one
  selection)
- the selection watcher ignores option changes while no tool is set
---
 app/pdb/chopgimp-cmds.c    | 20 +++++++++++++++++++-
 app/tools/chopgimp-tools.c |  9 ++++++---
 2 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/app/pdb/chopgimp-cmds.c b/app/pdb/chopgimp-cmds.c
index 462f307..b887559 100644
--- a/app/pdb/chopgimp-cmds.c
+++ b/app/pdb/chopgimp-cmds.c
@@ -906,6 +906,23 @@ vobjects_command_invoker (GimpProcedure         *procedure,
         done = chopgimp_vobjects_swap_fill_stroke (layer);
       else if (! strcmp (cmd, "fill-none"))
         done = chopgimp_vobjects_apply_color (layer, NULL, FALSE, TRUE);
+      /*  4.1.1: a color for the fill / stroke of the selection, as a
+       *  swatch or the foreground color does (fill-color:RRGGBB)
+       */
+      else if ((! strncmp (cmd, "fill-color:", 11) || ! strncmp (cmd, "stroke-color:", 13)))
+        {
+          gboolean     stroke = cmd[0] == 's';
+          const gchar *hex    = cmd + (stroke ? 13 : 11);
+          guint        v      = (guint) g_ascii_strtoull (hex, NULL, 16);
+          GeglColor   *c      = gegl_color_new (NULL);
+
+          gegl_color_set_rgba_with_space (c, ((v >> 16) & 0xff) / 255.0,
+                                          ((v >> 8) & 0xff) / 255.0,
+                                          (v & 0xff) / 255.0, 1.0,
+                                          babl_space ("sRGB"));
+          done = chopgimp_vobjects_apply_color (layer, c, stroke, TRUE);
+          g_object_unref (c);
+        }
       else if (! strcmp (cmd, "lock-others"))
         done = chopgimp_vobjects_lock_others (layer);
       else if (! strcmp (cmd, "hide-others"))
@@ -2116,7 +2133,8 @@ register_chopgimp_procs (GimpPDB *pdb)
                           "duplicate; 3.27.6: distort-warp:style:bend:hdist:vdist:vertical, "
                           "distort-mesh:rows:cols, distort-mesh-point:k:dx:dy, distort-top, "
                           "distort-free, distort-expand, distort-release, "
-                          "width-profile:<profile>, save-profile:<name>. Returns whether something changed and the number of "
+                          "width-profile:<profile>, save-profile:<name>; 4.1.1: fill-color:RRGGBB, "
+                          "stroke-color:RRGGBB. Returns whether something changed and the number of "
                           "selected objects.");
   gimp_procedure_add_argument (p, gimp_param_spec_image ("image", "image", "The image",
                                                          FALSE, GIMP_PARAM_READWRITE));
diff --git a/app/tools/chopgimp-tools.c b/app/tools/chopgimp-tools.c
index ed94f50..6ff6010 100644
--- a/app/tools/chopgimp-tools.c
+++ b/app/tools/chopgimp-tools.c
@@ -442,9 +442,12 @@ vss_options_notify (GObject    *object,
     return;
 
   /*  the Direct Selection (A) bar edits the objects itself  */
-  if (! strcmp (gimp_object_get_name (gimp_context_get_tool (vss.context)),
-                "gimp-direct-select-tool"))
-    return;
+  {
+    GimpToolInfo *info = gimp_context_get_tool (vss.context);
+
+    if (! info || ! strcmp (gimp_object_get_name (info), "gimp-direct-select-tool"))
+      return;
+  }
 
   if (chopgimp_vobjects_apply_tool_style (layer,
                                           popts->enable_fill, popts->fill_options,
-- 
2.53.0

