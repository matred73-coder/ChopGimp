+/*  ChopGimp 3.27: vector layers with several objects  */
+
+void
+layers_vobjects_merge_cmd_callback (GimpAction *action,
+                                    GVariant   *value,
+                                    gpointer    data)
+{
+  GimpImage   *image;
+  GimpContext *context;
+  GList       *layers;
+  return_if_no_layers (image, layers, data);
+  return_if_no_context (context, data);
+
+  if (chopgimp_vlayer_merge_layers (image, layers, context))
+    gimp_image_flush (image);
+}
+
+void
+layers_vobjects_split_cmd_callback (GimpAction *action,
+                                    GVariant   *value,
+                                    gpointer    data)
+{
+  GimpImage   *image;
+  GimpContext *context;
+  GList       *layers;
+  GList       *targets = NULL;
+  GList       *iter;
+  gboolean     done    = FALSE;
+  return_if_no_layers (image, layers, data);
+  return_if_no_context (context, data);
+
+  for (iter = layers; iter; iter = iter->next)
+    if (GIMP_IS_VECTOR_LAYER (iter->data) &&
+        chopgimp_vlayer_can_split (iter->data))
+      targets = g_list_prepend (targets, iter->data);
+
+  if (! targets)
+    return;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_LAYER_ADD,
+                               "Dissocier en calques");
+
+  for (iter = targets; iter; iter = iter->next)
+    {
+      GList *new_layers = chopgimp_vlayer_split_to_layers (iter->data, context);
+
+      if (new_layers)
+        done = TRUE;
+
+      g_list_free (new_layers);
+    }
+
+  gimp_image_undo_group_end (image);
+
+  g_list_free (targets);
+
+  if (done)
+    gimp_image_flush (image);
+}
+
+void
+layers_vobjects_decompose_cmd_callback (GimpAction *action,
+                                        GVariant   *value,
+                                        gpointer    data)
+{
+  GimpImage *image;
+  GList     *layers;
+  GList     *iter;
+  gint       n = 0;
+  return_if_no_layers (image, layers, data);
+
+  layers = g_list_copy (layers);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_ITEM_PROPERTIES,
+                               "Décomposer les sous-tracés en objets");
+
+  for (iter = layers; iter; iter = iter->next)
+    if (GIMP_IS_VECTOR_LAYER (iter->data) &&
+        chopgimp_vlayer_can_decompose (iter->data))
+      n += chopgimp_vlayer_decompose (iter->data, TRUE);
+
+  gimp_image_undo_group_end (image);
+
+  g_list_free (layers);
+
+  if (n > 0)
+    gimp_image_flush (image);
+}
