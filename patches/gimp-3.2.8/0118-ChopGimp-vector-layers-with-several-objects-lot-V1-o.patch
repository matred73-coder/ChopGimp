+
+
+typedef enum
+{
+  CHOPGIMP_VOBJECT_PATH,
+  CHOPGIMP_VOBJECT_GROUP
+} ChopGimpVObjectKind;
+
+typedef enum
+{
+  CHOPGIMP_PAINT_NONE,
+  CHOPGIMP_PAINT_COLOR,
+  CHOPGIMP_PAINT_LINEAR_GRADIENT,
+  CHOPGIMP_PAINT_RADIAL_GRADIENT,
+  CHOPGIMP_PAINT_PATTERN
+} ChopGimpPaintType;
+
+typedef enum
+{
+  CHOPGIMP_STROKE_ALIGN_CENTER,
+  CHOPGIMP_STROKE_ALIGN_INSIDE,    /* closed sub-paths only (else center) */
+  CHOPGIMP_STROKE_ALIGN_OUTSIDE
+} ChopGimpStrokeAlign;
+
+typedef enum
+{
+  CHOPGIMP_HIT_SELECTABLE,   /* the child of the entered group (or the
+                              * top-level object) containing the hit    */
+  CHOPGIMP_HIT_LEAF          /* the deepest path object                  */
+} ChopGimpHitMode;
+
+typedef struct
+{
+  gdouble    offset;          /* 0..1 */
+  GeglColor *color;           /* owned */
+} ChopGimpGradientStop;
+
+typedef struct
+{
+  ChopGimpPaintType  type;
+  GeglColor         *color;   /* COLOR (owned)                                */
+  /*  LINEAR: from (x1, y1) to (x2, y2);
+   *  RADIAL: centre (x1, y1), radius r, focal point (x2, y2);
+   *  all relative to the object's bounding box (0..1)
+   */
+  gdouble            x1, y1, x2, y2, r;
+  GArray            *stops;   /* ChopGimpGradientStop, sorted by offset (owned) */
+  GimpPattern       *pattern; /* PATTERN (ref), tiled in image space          */
+} ChopGimpPaint;
+
+typedef struct
+{
+  ChopGimpPaint        fill;
+  gboolean             fill_nonzero;  /* FALSE: even-odd, like GIMP          */
+  ChopGimpPaint        stroke;
+  gdouble              stroke_width;  /* pixels (scaled by the transformation) */
+  ChopGimpStrokeAlign  stroke_align;
+  GimpCapStyle         cap;
+  GimpJoinStyle        join;
+  gdouble              miter_limit;
+  GArray              *dashes;        /* gdouble, in multiples of the width
+                                       * (GIMP's convention); NULL = solid   */
+  gdouble              dash_offset;   /* pixels                              */
+  gboolean             antialias;
+} ChopGimpVStyle;
+
+struct _ChopGimpVObject
+{
+  /*  read-only: change them with the functions below  */
+  guint                id;            /* unique in the layer; the root is 0  */
+  ChopGimpVObjectKind  kind;
+  gchar               *name;
+  GimpPath            *path;          /* PATH: an unattached GimpPath of the
+                                       * layer's image, local coordinates    */
+  GimpMatrix3          transform;     /* local → parent (affine part used)   */
+  ChopGimpVStyle       style;         /* PATH only                           */
+  gdouble              opacity;       /* 0..1                                */
+  GimpLayerMode        mode;          /* normal, multiply, screen, overlay,
+                                       * darken, lighten, dodge, burn, hard
+                                       * and soft light, difference,
+                                       * exclusion, addition, HSL color and
+                                       * LCh hue/chroma/lightness are
+                                       * rendered; others render as normal  */
+  gboolean             visible;
+  gboolean             locked;
+  gchar               *lpe;           /* live path effects (key file of
+                                       * chopgimp_geom_effects) or NULL: then
+                                       * the layer's « chopgimp-lpe » parasite
+                                       * applies                             */
+  GPtrArray           *children;      /* GROUP: ChopGimpVObject *, bottom → top */
+  ChopGimpVObject     *parent;        /* the group; NULL for the root        */
+
+  /*< private >*/
+  gint                 ref_count;
+  gpointer             cache;         /* cairo_surface_t * of the rendering  */
+  gint                 cache_x, cache_y;
+  gboolean             bounds_valid[2];
+  gdouble              bounds[2][4];
+  GimpPath            *effective;     /* path after the live effects         */
+  gboolean             effective_valid;
+};
