+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vobject.c — ChopGimp 3.27: vector layers with several objects
+ * (see chopgimp-vobject.h for the model and the rules)
+ *
+ * Parasite « chopgimp-vobjects » (persistent, on the vector layer):
+ *
+ *   <chopgimp-vobjects version="1" next-id="7" options-style="…">
+ *     <group id="0" name="">                      the root
+ *       <path id="3" name="Cercle" d="M … C … Z" transform="a b c d e f"
+ *             opacity="1" mode="normal" visible="1" locked="0"
+ *             fill-rule="evenodd" antialias="1">
+ *         <fill type="color" color="r g b a"/>    sRGB R'G'B'A
+ *         <stroke type="linear" x1 y1 x2 y2 width="3" align="inside"
+ *                 cap="round" join="miter" miter="10" dash="2 1"
+ *                 dash-offset="0">
+ *           <stop offset="0" color="…"/> …
+ *         </stroke>
+ *         <lpe>key file</lpe>
+ *       </path>
+ *       <group id="5" name="Groupe" …> … </group>
+ *     </group>
+ *   </chopgimp-vobjects>
+ *
+ * The same text is the state kept by an undo step (with the selection
+ * and the « legacy » flag).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
