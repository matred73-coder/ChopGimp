+#define PARASITE_NAME     "chopgimp-vobjects"
+#define CACHE_MAX_PIXELS  (16 * 1024 * 1024)
+#define BAND_MAX_PIXELS   (4 * 1024 * 1024)
+#define LAYOUT_HISTORY    8
+#define GEOM_TOLERANCE    1e-3
+
+enum
+{
+  CHANGE_GEOMETRY  = 1 << 0,
+  CHANGE_STYLE     = 1 << 1,
+  CHANGE_STRUCTURE = 1 << 2,
+  CHANGE_ALL       = 0x7
+};
+
+struct _ChopGimpVLayer
+{
+  ChopGimpVObject *root;
+  GHashTable      *by_id;        /* id → ChopGimpVObject *               */
+  guint            next_id;
+  gboolean         legacy;       /* never edited as objects               */
+  gint             syncing;      /* writing the legacy path / options     */
+  GArray          *selection;    /* guint                                 */
+  guint            entered;
+
+  GHashTable      *stroke_map;   /* legacy stroke id → object id          */
+  gint             mapped;
+  GPtrArray       *layouts;      /* GArray of object ids by sub-path      */
+
+  gchar           *opt_sig;      /* signature of the legacy fill / stroke */
+  gchar           *layer_lpe;    /* the layer's « chopgimp-lpe » in use   */
+
+  gint             freeze;
+  guint            pending;
+  gboolean         pending_all;
+  GeglRectangle    pending_rect;
+};
+
+
+/*  ─── switch ────────────────────────────────────────────────────────── */
+
+gboolean
+chopgimp_vobjects_enabled (void)
+{
+  static gint enabled = -1;
+
+  if (enabled < 0)
+    {
+      const gchar *env = g_getenv ("CHOPGIMP_NO_VOBJECTS");
+
+      enabled = ! (env && *env && strcmp (env, "0") != 0);
+    }
+
+  return enabled;
+}
+
+
+/*  ─── small helpers ─────────────────────────────────────────────────── */
+
+static void
+put_num (GString *s,
+         gdouble  v)
+{
+  gchar buf[G_ASCII_DTOSTR_BUF_SIZE];
+
+  if (fabs (v) < 1e-12)
+    v = 0.0;
+
+  g_string_append (s, g_ascii_formatd (buf, sizeof (buf), "%.12g", v));
+}
+
+static const gchar *
+attr (const gchar **names,
+      const gchar **values,
+      const gchar  *key)
+{
+  for (gint i = 0; names[i]; i++)
+    if (! strcmp (names[i], key))
+      return values[i];
+
+  return NULL;
+}
+
+static gdouble
+attr_num (const gchar **names,
+          const gchar **values,
+          const gchar  *key,
+          gdouble       def)
+{
+  const gchar *v = attr (names, values, key);
+
+  return v ? g_ascii_strtod (v, NULL) : def;
+}
+
+static gint
+enum_from_nick (GType        type,
+                const gchar *nick,
+                gint         def)
+{
+  GEnumClass *klass;
+  GEnumValue *ev;
+  gint        value = def;
+
+  if (! nick)
+    return def;
+
+  klass = g_type_class_ref (type);
+  ev    = g_enum_get_value_by_nick (klass, nick);
+
+  if (ev)
+    value = ev->value;
+
+  g_type_class_unref (klass);
+
+  return value;
+}
+
+static const gchar *
+enum_to_nick (GType type,
+              gint  value)
+{
+  GEnumClass  *klass = g_type_class_ref (type);
+  GEnumValue  *ev    = g_enum_get_value (klass, value);
+  const gchar *nick  = ev ? ev->value_nick : "";
+
+  g_type_class_unref (klass);
+
+  return nick;
+}
+
+static void
+color_rgba (GeglColor  *color,
+            const Babl *space,
+            gdouble     rgba[4])
+{
+  rgba[0] = rgba[1] = rgba[2] = 0.0;
+  rgba[3] = 1.0;
+
+  if (color)
+    gegl_color_get_pixel (color, babl_format_with_space ("R'G'B'A double", space),
+                          rgba);
+}
+
+static GeglColor *
+color_parse (const gchar *s)
+{
+  GeglColor *color = gegl_color_new (NULL);
+  gdouble    rgba[4] = { 0, 0, 0, 1 };
+  gchar     *end;
+
+  if (s)
+    for (gint i = 0; i < 4 && *s; i++)
+      {
+        rgba[i] = g_ascii_strtod (s, &end);
+        if (end == s)
+          break;
+        s = end;
+      }
+
+  gegl_color_set_pixel (color, babl_format ("R'G'B'A double"), rgba);
+
+  return color;
+}
+
+static void
+put_color (GString   *s,
+           GeglColor *color)
+{
+  gdouble rgba[4];
+
+  color_rgba (color, NULL, rgba);
+
+  for (gint i = 0; i < 4; i++)
+    {
+      if (i)
+        g_string_append_c (s, ' ');
+      put_num (s, rgba[i]);
+    }
+}
+
+static gboolean
+is_normal_mode (GimpLayerMode mode)
+{
+  return mode == GIMP_LAYER_MODE_NORMAL || mode == GIMP_LAYER_MODE_NORMAL_LEGACY;
+}
+
+static cairo_operator_t
+mode_operator (GimpLayerMode mode)
+{
+  switch (mode)
+    {
+    case GIMP_LAYER_MODE_MULTIPLY:
+    case GIMP_LAYER_MODE_MULTIPLY_LEGACY:     return CAIRO_OPERATOR_MULTIPLY;
+    case GIMP_LAYER_MODE_SCREEN:
+    case GIMP_LAYER_MODE_SCREEN_LEGACY:       return CAIRO_OPERATOR_SCREEN;
+    case GIMP_LAYER_MODE_OVERLAY:
+    case GIMP_LAYER_MODE_OVERLAY_LEGACY:      return CAIRO_OPERATOR_OVERLAY;
+    case GIMP_LAYER_MODE_DARKEN_ONLY:
+    case GIMP_LAYER_MODE_DARKEN_ONLY_LEGACY:  return CAIRO_OPERATOR_DARKEN;
+    case GIMP_LAYER_MODE_LIGHTEN_ONLY:
+    case GIMP_LAYER_MODE_LIGHTEN_ONLY_LEGACY: return CAIRO_OPERATOR_LIGHTEN;
+    case GIMP_LAYER_MODE_DODGE:
+    case GIMP_LAYER_MODE_DODGE_LEGACY:        return CAIRO_OPERATOR_COLOR_DODGE;
+    case GIMP_LAYER_MODE_BURN:
+    case GIMP_LAYER_MODE_BURN_LEGACY:         return CAIRO_OPERATOR_COLOR_BURN;
+    case GIMP_LAYER_MODE_HARDLIGHT:
+    case GIMP_LAYER_MODE_HARDLIGHT_LEGACY:    return CAIRO_OPERATOR_HARD_LIGHT;
+    case GIMP_LAYER_MODE_SOFTLIGHT:
+    case GIMP_LAYER_MODE_SOFTLIGHT_LEGACY:    return CAIRO_OPERATOR_SOFT_LIGHT;
+    case GIMP_LAYER_MODE_DIFFERENCE:
+    case GIMP_LAYER_MODE_DIFFERENCE_LEGACY:   return CAIRO_OPERATOR_DIFFERENCE;
+    case GIMP_LAYER_MODE_EXCLUSION:           return CAIRO_OPERATOR_EXCLUSION;
+    case GIMP_LAYER_MODE_ADDITION:
+    case GIMP_LAYER_MODE_ADDITION_LEGACY:     return CAIRO_OPERATOR_ADD;
+    case GIMP_LAYER_MODE_BEHIND:
+    case GIMP_LAYER_MODE_BEHIND_LEGACY:       return CAIRO_OPERATOR_DEST_OVER;
+    case GIMP_LAYER_MODE_HSV_HUE:
+    case GIMP_LAYER_MODE_HSV_HUE_LEGACY:
+    case GIMP_LAYER_MODE_LCH_HUE:             return CAIRO_OPERATOR_HSL_HUE;
+    case GIMP_LAYER_MODE_HSV_SATURATION:
+    case GIMP_LAYER_MODE_HSV_SATURATION_LEGACY:
+    case GIMP_LAYER_MODE_LCH_CHROMA:          return CAIRO_OPERATOR_HSL_SATURATION;
+    case GIMP_LAYER_MODE_HSL_COLOR:
+    case GIMP_LAYER_MODE_HSL_COLOR_LEGACY:
+    case GIMP_LAYER_MODE_LCH_COLOR:           return CAIRO_OPERATOR_HSL_COLOR;
+    case GIMP_LAYER_MODE_HSV_VALUE:
+    case GIMP_LAYER_MODE_HSV_VALUE_LEGACY:
+    case GIMP_LAYER_MODE_LCH_LIGHTNESS:       return CAIRO_OPERATOR_HSL_LUMINOSITY;
+    default:                                  return CAIRO_OPERATOR_OVER;
+    }
+}
+
+static void
+matrix_to_cairo (const GimpMatrix3 *m,
+                 cairo_matrix_t    *c)
+{
+  cairo_matrix_init (c,
+                     m->coeff[0][0], m->coeff[1][0],
+                     m->coeff[0][1], m->coeff[1][1],
+                     m->coeff[0][2], m->coeff[1][2]);
+}
+
+static gdouble
+matrix_scale (const GimpMatrix3 *m)
+{
+  gdouble det = m->coeff[0][0] * m->coeff[1][1] - m->coeff[0][1] * m->coeff[1][0];
+
+  return sqrt (fabs (det));
+}
+
+static cairo_t *
+measure_cr (void)
+{
+  cairo_surface_t *s  = cairo_image_surface_create (CAIRO_FORMAT_A8, 1, 1);
+  cairo_t         *cr = cairo_create (s);
+
+  cairo_surface_destroy (s);
+
+  return cr;
+}
+
+static gboolean
+append_path (cairo_t  *cr,
+             GimpPath *path)
+{
+  const GimpBezierDesc *b;
+
+  if (! path || gimp_path_get_n_strokes (path) == 0)
+    return FALSE;
+
+  b = gimp_path_get_bezier (path);
+
+  if (! b || b->num_data == 0)
+    return FALSE;
+
+  cairo_append_path (cr, (cairo_path_t *) b);
+
+  return TRUE;
+}
+
+static gboolean
+path_all_closed (GimpPath *path)
+{
+  GimpStroke *s;
+  gboolean    any = FALSE;
+
+  for (s = gimp_path_stroke_get_next (path, NULL); s;
+       s = gimp_path_stroke_get_next (path, s))
+    {
+      if (! s->closed)
+        return FALSE;
+      any = TRUE;
+    }
+
+  return any;
+}
+
+/*  transforms all the strokes of an unattached path in place  */
+static void
+path_transform (GimpPath          *path,
+                const GimpMatrix3 *matrix)
+{
+  GQueue  strokes = G_QUEUE_INIT;
+  GList  *list;
+
+  if (gimp_matrix3_is_identity (matrix))
+    return;
+
+  gimp_path_freeze (path);
+
+  while (! g_queue_is_empty (path->strokes))
+    {
+      GimpStroke *stroke = g_queue_peek_head (path->strokes);
+
+      g_object_ref (stroke);
+      gimp_path_stroke_remove (path, stroke);
+      gimp_stroke_transform (stroke, matrix, &strokes);
+      g_object_unref (stroke);
+    }
+
+  path->last_stroke_id = 0;
+
+  for (list = strokes.head; list; list = g_list_next (list))
+    {
+      gimp_path_stroke_add (path, list->data);
+      g_object_unref (list->data);
+    }
+
+  g_queue_clear (&strokes);
+
+  gimp_path_thaw (path);
+}
+
+static void
+path_clear (GimpPath *path)
+{
+  GimpStroke *s;
+
+  while ((s = gimp_path_stroke_get_next (path, NULL)))
+    gimp_path_stroke_remove (path, s);
+
+  path->last_stroke_id = 0;
+}
+
+/*  @s (image space) equals @t (local space, mapped by @world)?  */
+static gboolean
+stroke_equal (GimpStroke        *s,
+              GimpStroke        *t,
+              const GimpMatrix3 *world)
+{
+  gboolean  sc = FALSE, tc = FALSE;
+  GArray   *a  = gimp_stroke_control_points_get (s, &sc);
+  GArray   *b  = gimp_stroke_control_points_get (t, &tc);
+  gboolean  eq = (sc == tc && a->len == b->len &&
+                  G_OBJECT_TYPE (s) == G_OBJECT_TYPE (t));
+
+  for (guint i = 0; eq && i < a->len; i++)
+    {
+      GimpAnchor *pa = &g_array_index (a, GimpAnchor, i);
+      GimpAnchor *pb = &g_array_index (b, GimpAnchor, i);
+      gdouble     x  = pb->position.x;
+      gdouble     y  = pb->position.y;
+
+      if (world)
+        gimp_matrix3_transform_point (world, pb->position.x, pb->position.y,
+                                      &x, &y);
+
+      if (fabs (pa->position.x - x) > GEOM_TOLERANCE ||
+          fabs (pa->position.y - y) > GEOM_TOLERANCE)
+        eq = FALSE;
+    }
+
+  g_array_free (a, TRUE);
+  g_array_free (b, TRUE);
+
+  return eq;
+}
+
+
+/*  ─── SVG path data ─────────────────────────────────────────────────── */
+
+static void
+put_pt (GString           *s,
+        const GimpCoords  *c)
+{
+  g_string_append_c (s, ' ');
+  put_num (s, c->x);
+  g_string_append_c (s, ' ');
+  put_num (s, c->y);
+}
+
+static gchar *
+path_to_d (GimpPath *path)
+{
+  GString    *s = g_string_new (NULL);
+  GimpStroke *stroke;
+
+  for (stroke = gimp_path_stroke_get_next (path, NULL); stroke;
+       stroke = gimp_path_stroke_get_next (path, stroke))
+    {
+      gboolean  closed = FALSE;
+      GArray   *a      = gimp_stroke_control_points_get (stroke, &closed);
+      guint     n      = a->len / 3;
+
+      if (n > 0)
+        {
+          GimpAnchor *an = (GimpAnchor *) a->data;
+
+          if (s->len)
+            g_string_append_c (s, ' ');
+
+          g_string_append_c (s, 'M');
+          put_pt (s, &an[1].position);
+
+          for (guint k = 1; k < n; k++)
+            {
+              g_string_append (s, " C");
+              put_pt (s, &an[3 * (k - 1) + 2].position);
+              put_pt (s, &an[3 * k].position);
+              put_pt (s, &an[3 * k + 1].position);
+            }
+
+          if (closed)
+            {
+              g_string_append (s, " C");
+              put_pt (s, &an[3 * (n - 1) + 2].position);
+              put_pt (s, &an[0].position);
+              put_pt (s, &an[1].position);
+              g_string_append (s, " Z");
+            }
+        }
+
+      g_array_free (a, TRUE);
+    }
+
+  return g_string_free (s, FALSE);
+}
+
+typedef struct
+{
+  GArray   *coords;   /* GimpCoords: in, pt, out per node */
+  gboolean  open;
+} DStroke;
+
+static GimpCoords
+mkc (gdouble x,
+     gdouble y)
+{
+  GimpCoords c = GIMP_COORDS_DEFAULT_VALUES;
+
+  c.x = x;
+  c.y = y;
+
+  return c;
+}
+
+static void
+d_flush (GimpPath *path,
+         DStroke  *ds,
+         gboolean  closed)
+{
+  guint n = ds->coords->len / 3;
+
+  if (n > 0 && (n > 1 || closed))
+    {
+      GimpCoords *c = (GimpCoords *) ds->coords->data;
+      GimpStroke *stroke;
+
+      if (closed && n > 1 &&
+          fabs (c[3 * (n - 1) + 1].x - c[1].x) < 1e-9 &&
+          fabs (c[3 * (n - 1) + 1].y - c[1].y) < 1e-9)
+        {
+          /*  the closing curve landed on the start: its handle is the
+           *  in-handle of the first node
+           */
+          c[0] = c[3 * (n - 1)];
+          g_array_set_size (ds->coords, 3 * (n - 1));
+          n--;
+        }
+
+      stroke = gimp_bezier_stroke_new_from_coords ((GimpCoords *) ds->coords->data,
+                                                   3 * n, closed);
+      gimp_path_stroke_add (path, stroke);
+      g_object_unref (stroke);
+    }
+
+  g_array_set_size (ds->coords, 0);
+  ds->open = FALSE;
+}
+
+static gboolean
+d_number (const gchar **p,
+          gdouble      *v)
+{
+  const gchar *s = *p;
+  gchar       *end;
+
+  while (*s == ' ' || *s == ',' || *s == '\t' || *s == '\n' || *s == '\r')
+    s++;
+
+  if (! (*s == '-' || *s == '+' || *s == '.' || g_ascii_isdigit (*s)))
+    return FALSE;
+
+  *v = g_ascii_strtod (s, &end);
+
+  if (end == s)
+    return FALSE;
+
+  *p = end;
+
+  return TRUE;
+}
+
+/*  M L H V C Z (absolute and relative); other commands end the parse  */
+static void
+path_from_d (GimpPath    *path,
+             const gchar *d)
+{
+  DStroke      ds   = { g_array_new (FALSE, FALSE, sizeof (GimpCoords)), FALSE };
+  gdouble      cx   = 0, cy = 0, sx = 0, sy = 0;
+  gchar        cmd  = 0;
+  const gchar *p    = d;
+
+  if (! d)
+    {
+      g_array_free (ds.coords, TRUE);
+      return;
+    }
+
+  gimp_path_freeze (path);
+
+  while (*p)
+    {
+      gdouble v[6];
+      gboolean rel;
+
+      while (*p == ' ' || *p == ',' || *p == '\t' || *p == '\n' || *p == '\r')
+        p++;
+
+      if (! *p)
+        break;
+
+      if (g_ascii_isalpha (*p))
+        cmd = *p++;
+      else if (! cmd)
+        break;
+
+      rel = g_ascii_islower (cmd);
+
+      switch (g_ascii_toupper (cmd))
+        {
+        case 'Z':
+          if (ds.open)
+            d_flush (path, &ds, TRUE);
+          cx = sx; cy = sy;
+          cmd = 0;
+          break;
+
+        case 'M':
+          if (! d_number (&p, &v[0]) || ! d_number (&p, &v[1]))
+            goto done;
+          if (ds.open)
+            d_flush (path, &ds, FALSE);
+          cx = rel ? cx + v[0] : v[0];
+          cy = rel ? cy + v[1] : v[1];
+          sx = cx; sy = cy;
+          {
+            GimpCoords c = mkc (cx, cy);
+
+            g_array_append_val (ds.coords, c);
+            g_array_append_val (ds.coords, c);
+            g_array_append_val (ds.coords, c);
+          }
+          ds.open = TRUE;
+          cmd = rel ? 'l' : 'L';
+          break;
+
+        case 'L':
+        case 'H':
+        case 'V':
+          {
+            gchar      up = g_ascii_toupper (cmd);
+            gdouble    x  = cx, y = cy;
+            GimpCoords c;
+
+            if (up == 'L')
+              {
+                if (! d_number (&p, &v[0]) || ! d_number (&p, &v[1]))
+                  goto done;
+                x = rel ? cx + v[0] : v[0];
+                y = rel ? cy + v[1] : v[1];
+              }
+            else
+              {
+                if (! d_number (&p, &v[0]))
+                  goto done;
+                if (up == 'H')
+                  x = rel ? cx + v[0] : v[0];
+                else
+                  y = rel ? cy + v[0] : v[0];
+              }
+
+            if (! ds.open)
+              {
+                c = mkc (cx, cy);
+                g_array_append_val (ds.coords, c);
+                g_array_append_val (ds.coords, c);
+                g_array_append_val (ds.coords, c);
+                ds.open = TRUE;
+              }
+
+            c = mkc (x, y);
+            g_array_append_val (ds.coords, c);
+            g_array_append_val (ds.coords, c);
+            g_array_append_val (ds.coords, c);
+            cx = x; cy = y;
+          }
+          break;
+
+        case 'C':
+          {
+            GimpCoords c;
+            guint      n;
+
+            for (gint i = 0; i < 6; i++)
+              if (! d_number (&p, &v[i]))
+                goto done;
+
+            if (rel)
+              for (gint i = 0; i < 6; i += 2)
+                {
+                  v[i]     += cx;
+                  v[i + 1] += cy;
+                }
+
+            if (! ds.open)
+              {
+                c = mkc (cx, cy);
+                g_array_append_val (ds.coords, c);
+                g_array_append_val (ds.coords, c);
+                g_array_append_val (ds.coords, c);
+                ds.open = TRUE;
+              }
+
+            n = ds.coords->len;
+            g_array_index (ds.coords, GimpCoords, n - 1) = mkc (v[0], v[1]);
+
+            c = mkc (v[2], v[3]);
+            g_array_append_val (ds.coords, c);
+            c = mkc (v[4], v[5]);
+            g_array_append_val (ds.coords, c);
+            g_array_append_val (ds.coords, c);
+            cx = v[4]; cy = v[5];
+          }
+          break;
+
+        default:
+          g_printerr ("ChopGimp: unsupported path command « %c »\n", cmd);
+          goto done;
+        }
+    }
+
+ done:
+  if (ds.open)
+    d_flush (path, &ds, FALSE);
+
+  g_array_free (ds.coords, TRUE);
+
+  gimp_path_thaw (path);
+}
+
+
+/*  ─── paints and styles ─────────────────────────────────────────────── */
+
+static void
+paint_clear (ChopGimpPaint *p)
+{
+  g_clear_object (&p->color);
+  g_clear_object (&p->pattern);
+
+  if (p->stops)
+    {
+      for (guint i = 0; i < p->stops->len; i++)
+        g_clear_object (&g_array_index (p->stops, ChopGimpGradientStop, i).color);
+
+      g_array_free (p->stops, TRUE);
+      p->stops = NULL;
+    }
+
+  p->type = CHOPGIMP_PAINT_NONE;
+}
+
+static void
+paint_copy (ChopGimpPaint       *dest,
+            const ChopGimpPaint *src)
+{
+  paint_clear (dest);
+
+  *dest = *src;
+  dest->color   = src->color   ? gegl_color_duplicate (src->color) : NULL;
+  dest->pattern = src->pattern ? g_object_ref (src->pattern)       : NULL;
+  dest->stops   = NULL;
+
+  if (src->stops)
+    for (guint i = 0; i < src->stops->len; i++)
+      {
+        ChopGimpGradientStop *st = &g_array_index (src->stops, ChopGimpGradientStop, i);
+
+        chopgimp_vpaint_add_stop (dest, st->offset, st->color);
+      }
+}
+
+void
+chopgimp_vpaint_set_color (ChopGimpPaint *paint,
+                           GeglColor     *color)
+{
+  paint_clear (paint);
+
+  paint->type  = CHOPGIMP_PAINT_COLOR;
+  paint->color = color ? gegl_color_duplicate (color) : gegl_color_new ("black");
+}
+
+void
+chopgimp_vpaint_add_stop (ChopGimpPaint *paint,
+                          gdouble        offset,
+                          GeglColor     *color)
+{
+  ChopGimpGradientStop st;
+  guint                i;
+
+  if (! paint->stops)
+    paint->stops = g_array_new (FALSE, TRUE, sizeof (ChopGimpGradientStop));
+
+  st.offset = CLAMP (offset, 0.0, 1.0);
+  st.color  = color ? gegl_color_duplicate (color) : gegl_color_new ("black");
+
+  for (i = 0; i < paint->stops->len; i++)
+    if (g_array_index (paint->stops, ChopGimpGradientStop, i).offset > st.offset)
+      break;
+
+  g_array_insert_val (paint->stops, i, st);
+}
+
+void
+chopgimp_vstyle_init (ChopGimpVStyle *style)
+{
+  memset (style, 0, sizeof (ChopGimpVStyle));
+
+  chopgimp_vpaint_set_color (&style->fill, NULL);
+  style->stroke.type   = CHOPGIMP_PAINT_NONE;
+  style->stroke_width  = 1.0;
+  style->stroke_align  = CHOPGIMP_STROKE_ALIGN_CENTER;
+  style->cap           = GIMP_CAP_BUTT;
+  style->join          = GIMP_JOIN_MITER;
+  style->miter_limit   = 10.0;
+  style->antialias     = TRUE;
+}
+
+void
+chopgimp_vstyle_clear (ChopGimpVStyle *style)
+{
+  paint_clear (&style->fill);
+  paint_clear (&style->stroke);
+
+  if (style->dashes)
+    {
+      g_array_free (style->dashes, TRUE);
+      style->dashes = NULL;
+    }
+}
+
+void
+chopgimp_vstyle_copy (ChopGimpVStyle       *dest,
+                      const ChopGimpVStyle *src)
+{
+  ChopGimpPaint fill   = { 0, };
+  ChopGimpPaint stroke = { 0, };
+
+  if (dest == src)
+    return;
+
+  paint_copy (&fill,   &src->fill);
+  paint_copy (&stroke, &src->stroke);
+
+  chopgimp_vstyle_clear (dest);
+
+  *dest = *src;
+  dest->fill   = fill;
+  dest->stroke = stroke;
+  dest->dashes = NULL;
+
+  if (src->dashes && src->dashes->len > 0)
+    dest->dashes = gimp_dash_pattern_copy (src->dashes);
+}
+
+static gdouble
+options_stroke_width (GimpVectorLayerOptions *options)
+{
+  GimpStrokeOptions *so    = options->stroke_options;
+  gdouble            width = gimp_stroke_options_get_width (so);
+  GimpUnit          *unit  = gimp_stroke_options_get_unit (so);
+
+  if (unit && unit != gimp_unit_pixel () && options->path)
+    {
+      GimpImage *image = gimp_item_get_image (GIMP_ITEM (options->path));
+      gdouble    xres, yres;
+
+      gimp_image_get_resolution (image, &xres, &yres);
+      width = gimp_units_to_pixels (width, unit, yres);
+    }
+
+  return width;
+}
+
+static void
+paint_from_fill_options (ChopGimpPaint   *paint,
+                         GimpFillOptions *fo,
+                         gboolean         enabled)
+{
+  paint_clear (paint);
+
+  if (! enabled)
+    return;
+
+  if (gimp_fill_options_get_custom_style (fo) == GIMP_CUSTOM_STYLE_PATTERN &&
+      gimp_context_get_pattern (GIMP_CONTEXT (fo)))
+    {
+      paint->type    = CHOPGIMP_PAINT_PATTERN;
+      paint->pattern = g_object_ref (gimp_context_get_pattern (GIMP_CONTEXT (fo)));
+    }
+  else
+    {
+      chopgimp_vpaint_set_color (paint,
+                                 gimp_context_get_foreground (GIMP_CONTEXT (fo)));
+    }
+}
+
+void
+chopgimp_vstyle_from_options (ChopGimpVStyle         *style,
+                              GimpVectorLayerOptions *options)
+{
+  GimpStrokeOptions *so = options->stroke_options;
+  GArray            *dash;
+
+  chopgimp_vstyle_clear (style);
+  chopgimp_vstyle_init (style);
+
+  paint_from_fill_options (&style->fill, options->fill_options,
+                           options->enable_fill);
+  paint_from_fill_options (&style->stroke, GIMP_FILL_OPTIONS (so),
+                           options->enable_stroke);
+
+  style->fill_nonzero = FALSE;
+  style->stroke_width = options_stroke_width (options);
+  style->stroke_align = CHOPGIMP_STROKE_ALIGN_CENTER;
+  style->cap          = gimp_stroke_options_get_cap_style (so);
+  style->join         = gimp_stroke_options_get_join_style (so);
+  style->miter_limit  = gimp_stroke_options_get_miter_limit (so);
+  style->dash_offset  = gimp_stroke_options_get_dash_offset (so);
+  style->antialias    = gimp_fill_options_get_antialias (options->fill_options);
+
+  dash = gimp_stroke_options_get_dash_info (so);
+  if (dash && dash->len > 0)
+    style->dashes = gimp_dash_pattern_copy (dash);
+}
+
+static GeglColor *
+paint_main_color (const ChopGimpPaint *p)
+{
+  if (p->type == CHOPGIMP_PAINT_COLOR)
+    return p->color;
+
+  if ((p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+       p->type == CHOPGIMP_PAINT_RADIAL_GRADIENT) && p->stops && p->stops->len)
+    return g_array_index (p->stops, ChopGimpGradientStop, 0).color;
+
+  return NULL;
+}
+
+static void
+paint_to_fill_options (const ChopGimpPaint *paint,
+                       GimpFillOptions     *fo)
+{
+  GeglColor *color = paint_main_color (paint);
+
+  if (paint->type == CHOPGIMP_PAINT_PATTERN && paint->pattern)
+    {
+      gimp_fill_options_set_custom_style (fo, GIMP_CUSTOM_STYLE_PATTERN);
+      gimp_context_set_pattern (GIMP_CONTEXT (fo), paint->pattern);
+    }
+  else if (color)
+    {
+      gimp_fill_options_set_custom_style (fo, GIMP_CUSTOM_STYLE_SOLID_COLOR);
+      gimp_context_set_foreground (GIMP_CONTEXT (fo), color);
+    }
+}
+
+void
+chopgimp_vstyle_to_options (const ChopGimpVStyle   *style,
+                            GimpVectorLayerOptions *options)
+{
+  GimpStrokeOptions *so = options->stroke_options;
+
+  g_object_set (options,
+                "enable-fill",   style->fill.type != CHOPGIMP_PAINT_NONE,
+                "enable-stroke", (style->stroke.type != CHOPGIMP_PAINT_NONE &&
+                                  style->stroke_width > 0),
+                NULL);
+
+  paint_to_fill_options (&style->fill,   options->fill_options);
+  paint_to_fill_options (&style->stroke, GIMP_FILL_OPTIONS (so));
+
+  g_object_set (so,
+                "width",       style->stroke_width,
+                "unit",        gimp_unit_pixel (),
+                "cap-style",   style->cap,
+                "join-style",  style->join,
+                "miter-limit", style->miter_limit,
+                "dash-offset", style->dash_offset,
+                NULL);
+
+  if (style->dashes && style->dashes->len > 0)
+    gimp_stroke_options_take_dash_pattern (so, GIMP_DASH_CUSTOM,
+                                           gimp_dash_pattern_copy (style->dashes));
+  else
+    gimp_stroke_options_take_dash_pattern (so, GIMP_DASH_LINE,
+                                           gimp_dash_pattern_new_from_preset (GIMP_DASH_LINE));
+
+  gimp_fill_options_set_antialias (options->fill_options, style->antialias);
+  gimp_fill_options_set_antialias (GIMP_FILL_OPTIONS (so), style->antialias);
+}
+
+
+/*  ─── objects ───────────────────────────────────────────────────────── */
+
+static ChopGimpVObject *
+vobj_alloc (ChopGimpVObjectKind kind,
+            const gchar        *name)
+{
+  ChopGimpVObject *o = g_new0 (ChopGimpVObject, 1);
+
+  o->ref_count = 1;
+  o->kind      = kind;
+  o->name      = g_strdup (name ? name : "");
+  o->opacity   = 1.0;
+  o->mode      = GIMP_LAYER_MODE_NORMAL;
+  o->visible   = TRUE;
+  gimp_matrix3_identity (&o->transform);
+  chopgimp_vstyle_init (&o->style);
+
+  if (kind == CHOPGIMP_VOBJECT_GROUP)
+    {
+      o->children = g_ptr_array_new_with_free_func ((GDestroyNotify) chopgimp_vobject_unref);
+      paint_clear (&o->style.fill);
+    }
+
+  return o;
+}
+
+static void
+vobj_drop_cache (ChopGimpVObject *o)
+{
+  if (o->cache)
+    {
+      cairo_surface_destroy (o->cache);
+      o->cache = NULL;
+    }
+
+  o->bounds_valid[0] = o->bounds_valid[1] = FALSE;
+}
+
+/*  geometry or style changed: forget the renderings (whole subtree)  */
+static void
+vobj_invalidate (ChopGimpVObject *o)
+{
+  vobj_drop_cache (o);
+  g_clear_object (&o->effective);
+  o->effective_valid = FALSE;
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      vobj_invalidate (g_ptr_array_index (o->children, i));
+}
+
+ChopGimpVObject *
+chopgimp_vobject_new_path (GimpImage            *image,
+                           GimpPath             *path,
+                           const gchar          *name,
+                           const ChopGimpVStyle *style)
+{
+  ChopGimpVObject *o;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  o       = vobj_alloc (CHOPGIMP_VOBJECT_PATH, name);
+  o->path = g_object_ref_sink (gimp_path_new (image, o->name));
+
+  if (path)
+    gimp_path_copy_strokes (path, o->path);
+
+  if (style)
+    chopgimp_vstyle_copy (&o->style, style);
+
+  return o;
+}
+
+ChopGimpVObject *
+chopgimp_vobject_new_group (const gchar *name)
+{
+  return vobj_alloc (CHOPGIMP_VOBJECT_GROUP, name ? name : "Groupe");
+}
+
+ChopGimpVObject *
+chopgimp_vobject_ref (ChopGimpVObject *object)
+{
+  g_return_val_if_fail (object != NULL, NULL);
+
+  object->ref_count++;
+
+  return object;
+}
+
+void
+chopgimp_vobject_unref (ChopGimpVObject *object)
+{
+  if (! object || --object->ref_count > 0)
+    return;
+
+  vobj_drop_cache (object);
+  g_clear_object (&object->effective);
+  g_clear_object (&object->path);
+  chopgimp_vstyle_clear (&object->style);
+  g_free (object->name);
+  g_free (object->lpe);
+
+  if (object->children)
+    {
+      for (guint i = 0; i < object->children->len; i++)
+        ((ChopGimpVObject *) g_ptr_array_index (object->children, i))->parent = NULL;
+
+      g_ptr_array_free (object->children, TRUE);
+    }
+
+  g_free (object);
+}
+
+ChopGimpVObject *
+chopgimp_vobject_copy (ChopGimpVObject *object,
+                       GimpImage       *dest_image)
+{
+  ChopGimpVObject *c;
+
+  g_return_val_if_fail (object != NULL, NULL);
+
+  c = vobj_alloc (object->kind, object->name);
+
+  c->transform = object->transform;
+  c->opacity   = object->opacity;
+  c->mode      = object->mode;
+  c->visible   = object->visible;
+  c->locked    = object->locked;
+  c->lpe       = g_strdup (object->lpe);
+  chopgimp_vstyle_copy (&c->style, &object->style);
+
+  if (object->path)
+    {
+      c->path = g_object_ref_sink (gimp_path_new (dest_image, c->name));
+      gimp_path_copy_strokes (object->path, c->path);
+    }
+
+  if (object->children)
+    for (guint i = 0; i < object->children->len; i++)
+      {
+        ChopGimpVObject *child = chopgimp_vobject_copy (g_ptr_array_index (object->children, i),
+                                                        dest_image);
+
+        child->parent = c;
+        g_ptr_array_add (c->children, child);
+      }
+
+  return c;
+}
+
+gint
+chopgimp_vobject_get_index (ChopGimpVObject *object)
+{
+  guint i;
+
+  if (! object->parent)
+    return -1;
+
+  if (g_ptr_array_find (object->parent->children, object, &i))
+    return i;
+
+  return -1;
+}
+
+gboolean
+chopgimp_vobject_is_ancestor (ChopGimpVObject *ancestor,
+                              ChopGimpVObject *object)
+{
+  for (object = object ? object->parent : NULL; object; object = object->parent)
+    if (object == ancestor)
+      return TRUE;
+
+  return FALSE;
+}
+
+gboolean
+chopgimp_vobject_is_visible (ChopGimpVObject *object)
+{
+  for (; object; object = object->parent)
+    if (! object->visible)
+      return FALSE;
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobject_is_locked (ChopGimpVObject *object)
+{
+  for (; object; object = object->parent)
+    if (object->locked)
+      return TRUE;
+
+  return FALSE;
+}
+
+void
+chopgimp_vobject_get_world_matrix (ChopGimpVObject *object,
+                                   GimpMatrix3     *matrix)
+{
+  ChopGimpVObject *p;
+
+  *matrix = object->transform;
+
+  for (p = object->parent; p; p = p->parent)
+    gimp_matrix3_mult (&p->transform, matrix);
+}
+
+static void
+collect_leaves (ChopGimpVObject  *o,
+                GList           **list)
+{
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    {
+      *list = g_list_prepend (*list, o);
+    }
+  else if (o->children)
+    {
+      for (guint i = 0; i < o->children->len; i++)
+        collect_leaves (g_ptr_array_index (o->children, i), list);
+    }
+}
+
+static GList *
+leaves_of (ChopGimpVObject *o)
+{
+  GList *list = NULL;
+
+  if (o)
+    collect_leaves (o, &list);
+
+  return g_list_reverse (list);
+}
+
+
+/*  ─── per-layer state ───────────────────────────────────────────────── */
+
+static void
+index_rec (ChopGimpVLayer  *vl,
+           ChopGimpVObject *o)
+{
+  g_hash_table_insert (vl->by_id, GUINT_TO_POINTER (o->id), o);
+
+  if (o->id >= vl->next_id)
+    vl->next_id = o->id + 1;
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      {
+        ChopGimpVObject *c = g_ptr_array_index (o->children, i);
+
+        c->parent = o;
+        index_rec (vl, c);
+      }
+}
+
+static void
+vlayer_reindex (ChopGimpVLayer *vl)
+{
+  g_hash_table_remove_all (vl->by_id);
+  index_rec (vl, vl->root);
+}
+
+static ChopGimpVLayer *
+vlayer_new (void)
+{
+  ChopGimpVLayer *vl = g_new0 (ChopGimpVLayer, 1);
+
+  vl->root       = vobj_alloc (CHOPGIMP_VOBJECT_GROUP, "");
+  vl->by_id      = g_hash_table_new (NULL, NULL);
+  vl->next_id    = 1;
+  vl->selection  = g_array_new (FALSE, FALSE, sizeof (guint));
+  vl->stroke_map = g_hash_table_new (NULL, NULL);
+  vl->layouts    = g_ptr_array_new_with_free_func ((GDestroyNotify) g_array_unref);
+
+  vlayer_reindex (vl);
+
+  return vl;
+}
+
+void
+chopgimp_vlayer_free (ChopGimpVLayer *vl)
+{
+  if (! vl)
+    return;
+
+  chopgimp_vobject_unref (vl->root);
+  g_hash_table_unref (vl->by_id);
+  g_array_free (vl->selection, TRUE);
+  g_hash_table_unref (vl->stroke_map);
+  g_ptr_array_unref (vl->layouts);
+  g_free (vl->opt_sig);
+  g_free (vl->layer_lpe);
+  g_free (vl);
+}
+
+/*  new ids for the objects without one or with a taken one  */
+static void
+assign_ids (ChopGimpVLayer  *vl,
+            ChopGimpVObject *o)
+{
+  if (o->id == 0 || g_hash_table_contains (vl->by_id, GUINT_TO_POINTER (o->id)))
+    o->id = vl->next_id++;
+
+  g_hash_table_insert (vl->by_id, GUINT_TO_POINTER (o->id), o);
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      {
+        ChopGimpVObject *c = g_ptr_array_index (o->children, i);
+
+        c->parent = o;
+        assign_ids (vl, c);
+      }
+}
+
+static void
+vlayer_push_layout (ChopGimpVLayer *vl,
+                    GArray         *layout)
+{
+  g_ptr_array_add (vl->layouts, layout);
+
+  while (vl->layouts->len > LAYOUT_HISTORY)
+    g_ptr_array_remove_index (vl->layouts, 0);
+}
+
+/*  the layout of the legacy path when it is written from @leaves in order  */
+static GArray *
+layout_of_leaves (GList *leaves)
+{
+  GArray *layout = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      gint             n = gimp_path_get_n_strokes (o->path);
+
+      for (gint i = 0; i < n; i++)
+        g_array_append_val (layout, o->id);
+    }
+
+  return layout;
+}
+
+static gchar *
+options_sig (GimpVectorLayerOptions *options);
+static void
+vlayer_style_from_options (GimpVectorLayer *layer);
+
+/*  the layer's state, creating the legacy object #1 when needed  */
+static ChopGimpVLayer *
+vlayer_ensure (GimpVectorLayer *layer)
+{
+  GimpVectorLayerOptions *options = layer->options;
+  ChopGimpVLayer         *vl;
+  ChopGimpVObject        *o;
+  GimpStroke             *s;
+  GimpImage              *image;
+
+  if (layer->vobjects)
+    return layer->vobjects;
+
+  if (! chopgimp_vobjects_enabled () || ! options || ! options->path)
+    return NULL;
+
+  image = gimp_item_get_image (GIMP_ITEM (layer));
+  vl    = vlayer_new ();
+  o     = chopgimp_vobject_new_path (image, options->path,
+                                     gimp_object_get_name (layer), NULL);
+  chopgimp_vstyle_from_options (&o->style, options);
+
+  o->parent = vl->root;
+  g_ptr_array_add (vl->root->children, o);
+  assign_ids (vl, o);
+
+  vl->legacy = TRUE;
+
+  for (s = gimp_path_stroke_get_next (options->path, NULL); s;
+       s = gimp_path_stroke_get_next (options->path, s))
+    {
+      g_hash_table_insert (vl->stroke_map, GINT_TO_POINTER (gimp_stroke_get_id (s)),
+                           GUINT_TO_POINTER (o->id));
+      vl->mapped++;
+    }
+
+  {
+    GList *leaves = g_list_prepend (NULL, o);
+
+    vlayer_push_layout (vl, layout_of_leaves (leaves));
+    g_list_free (leaves);
+  }
+
+  vl->opt_sig = options_sig (options);
+
+  layer->vobjects = vl;
+
+  return vl;
+}
+
+static gboolean
+layer_usable (GimpVectorLayer *layer)
+{
+  return (GIMP_IS_VECTOR_LAYER (layer) &&
+          gimp_item_is_vector_layer (GIMP_ITEM (layer)));
+}
+
+ChopGimpVObject *
+chopgimp_vlayer_get_root (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl;
+
+  if (! layer_usable (layer))
+    return NULL;
+
+  vl = vlayer_ensure (layer);
+
+  return vl ? vl->root : NULL;
+}
+
+gboolean
+chopgimp_vlayer_has_objects (GimpVectorLayer *layer)
+{
+  return (GIMP_IS_VECTOR_LAYER (layer) && layer->vobjects &&
+          ! layer->vobjects->legacy);
+}
+
+gboolean
+chopgimp_vlayer_is_legacy (GimpVectorLayer *layer)
+{
+  return ! layer->vobjects || layer->vobjects->legacy;
+}
+
+ChopGimpVObject *
+chopgimp_vlayer_get_object (GimpVectorLayer *layer,
+                            guint            id)
+{
+  ChopGimpVLayer *vl;
+
+  if (! layer_usable (layer) || ! (vl = vlayer_ensure (layer)))
+    return NULL;
+
+  return g_hash_table_lookup (vl->by_id, GUINT_TO_POINTER (id));
+}
+
+GList *
+chopgimp_vlayer_get_leaves (GimpVectorLayer *layer)
+{
+  return leaves_of (chopgimp_vlayer_get_root (layer));
+}
+
+gint
+chopgimp_vlayer_count_leaves (GimpVectorLayer *layer)
+{
+  GList *leaves = chopgimp_vlayer_get_leaves (layer);
+  gint   n      = g_list_length (leaves);
+
+  g_list_free (leaves);
+
+  return n;
+}
+
+static ChopGimpVObject *
+first_leaf (ChopGimpVObject *root)
+{
+  GList           *leaves = leaves_of (root);
+  ChopGimpVObject *first  = leaves ? leaves->data : NULL;
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      if (gimp_path_get_n_strokes (o->path) > 0)
+        {
+          first = o;
+          break;
+        }
+    }
+
+  g_list_free (leaves);
+
+  return first;
+}
+
+ChopGimpVObject *
+chopgimp_vlayer_get_first_leaf (GimpVectorLayer *layer)
+{
+  return first_leaf (chopgimp_vlayer_get_root (layer));
+}
+
+
+/*  ─── serialization ─────────────────────────────────────────────────── */
+
+static void
+write_paint (GString             *s,
+             const gchar         *element,
+             const ChopGimpPaint *p,
+             const ChopGimpVStyle *style)
+{
+  static const gchar *types[] = { "none", "color", "linear", "radial", "pattern" };
+  gboolean            stops   = (p->stops && p->stops->len > 0 &&
+                                 (p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+                                  p->type == CHOPGIMP_PAINT_RADIAL_GRADIENT));
+
+  g_string_append_printf (s, "<%s type=\"%s\"", element, types[p->type]);
+
+  if (p->type == CHOPGIMP_PAINT_COLOR)
+    {
+      g_string_append (s, " color=\"");
+      put_color (s, p->color);
+      g_string_append_c (s, '"');
+    }
+  else if (p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+           p->type == CHOPGIMP_PAINT_RADIAL_GRADIENT)
+    {
+      const gchar *keys[]   = { "x1", "y1", "x2", "y2", "r" };
+      gdouble      values[] = { p->x1, p->y1, p->x2, p->y2, p->r };
+
+      for (gint i = 0; i < 5; i++)
+        {
+          g_string_append_printf (s, " %s=\"", keys[i]);
+          put_num (s, values[i]);
+          g_string_append_c (s, '"');
+        }
+    }
+  else if (p->type == CHOPGIMP_PAINT_PATTERN && p->pattern)
+    {
+      gchar *name = g_markup_escape_text (gimp_object_get_name (p->pattern), -1);
+
+      g_string_append_printf (s, " pattern=\"%s\"", name);
+      g_free (name);
+    }
+
+  if (style)
+    {
+      g_string_append (s, " width=\"");
+      put_num (s, style->stroke_width);
+      g_string_append_printf (s, "\" align=\"%s\" cap=\"%s\" join=\"%s\" miter=\"",
+                              style->stroke_align == CHOPGIMP_STROKE_ALIGN_INSIDE  ? "inside"  :
+                              style->stroke_align == CHOPGIMP_STROKE_ALIGN_OUTSIDE ? "outside" :
+                                                                                     "center",
+                              enum_to_nick (GIMP_TYPE_CAP_STYLE,  style->cap),
+                              enum_to_nick (GIMP_TYPE_JOIN_STYLE, style->join));
+      put_num (s, style->miter_limit);
+      g_string_append_c (s, '"');
+
+      if (style->dashes && style->dashes->len > 0)
+        {
+          g_string_append (s, " dash=\"");
+          for (guint i = 0; i < style->dashes->len; i++)
+            {
+              if (i)
+                g_string_append_c (s, ' ');
+              put_num (s, g_array_index (style->dashes, gdouble, i));
+            }
+          g_string_append (s, "\" dash-offset=\"");
+          put_num (s, style->dash_offset);
+          g_string_append_c (s, '"');
+        }
+    }
+
+  if (! stops)
+    {
+      g_string_append (s, "/>\n");
+      return;
+    }
+
+  g_string_append (s, ">\n");
+
+  for (guint i = 0; i < p->stops->len; i++)
+    {
+      ChopGimpGradientStop *st = &g_array_index (p->stops, ChopGimpGradientStop, i);
+
+      g_string_append (s, "<stop offset=\"");
+      put_num (s, st->offset);
+      g_string_append (s, "\" color=\"");
+      put_color (s, st->color);
+      g_string_append (s, "\"/>\n");
+    }
+
+  g_string_append_printf (s, "</%s>\n", element);
+}
+
+static void
+write_object (GString         *s,
+              ChopGimpVObject *o,
+              gboolean         drop_empty)
+{
+  gchar *name;
+  gint   i;
+
+  if (drop_empty && o->kind == CHOPGIMP_VOBJECT_PATH &&
+      gimp_path_get_n_strokes (o->path) == 0)
+    return;
+
+  name = g_markup_escape_text (o->name ? o->name : "", -1);
+
+  g_string_append_printf (s, "<%s id=\"%u\" name=\"%s\"",
+                          o->kind == CHOPGIMP_VOBJECT_GROUP ? "group" : "path",
+                          o->id, name);
+  g_free (name);
+
+  if (! gimp_matrix3_is_identity (&o->transform))
+    {
+      gdouble m[6] = { o->transform.coeff[0][0], o->transform.coeff[1][0],
+                       o->transform.coeff[0][1], o->transform.coeff[1][1],
+                       o->transform.coeff[0][2], o->transform.coeff[1][2] };
+
+      g_string_append (s, " transform=\"");
+      for (i = 0; i < 6; i++)
+        {
+          if (i)
+            g_string_append_c (s, ' ');
+          put_num (s, m[i]);
+        }
+      g_string_append_c (s, '"');
+    }
+
+  g_string_append (s, " opacity=\"");
+  put_num (s, o->opacity);
+  g_string_append_printf (s, "\" mode=\"%s\" visible=\"%d\" locked=\"%d\"",
+                          enum_to_nick (GIMP_TYPE_LAYER_MODE, o->mode),
+                          o->visible ? 1 : 0, o->locked ? 1 : 0);
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    {
+      gchar *d = path_to_d (o->path);
+
+      g_string_append_printf (s, " fill-rule=\"%s\" antialias=\"%d\" d=\"%s\">\n",
+                              o->style.fill_nonzero ? "nonzero" : "evenodd",
+                              o->style.antialias ? 1 : 0, d);
+      g_free (d);
+
+      write_paint (s, "fill",   &o->style.fill,   NULL);
+      write_paint (s, "stroke", &o->style.stroke, &o->style);
+    }
+  else
+    {
+      g_string_append (s, ">\n");
+    }
+
+  if (o->lpe)
+    {
+      gchar *lpe = g_markup_escape_text (o->lpe, -1);
+
+      g_string_append_printf (s, "<lpe>%s</lpe>\n", lpe);
+      g_free (lpe);
+    }
+
+  if (o->children)
+    for (guint k = 0; k < o->children->len; k++)
+      write_object (s, g_ptr_array_index (o->children, k), drop_empty);
+
+  g_string_append_printf (s, "</%s>\n",
+                          o->kind == CHOPGIMP_VOBJECT_GROUP ? "group" : "path");
+}
+
+/*  @state: also the selection, the entered group and the legacy flag
+ *  (undo); otherwise empty objects are dropped (file)
+ */
+static gchar *
+vlayer_serialize (GimpVectorLayer *layer,
+                  gboolean         state)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+  GString        *s  = g_string_new (NULL);
+
+  g_string_append_printf (s, "<chopgimp-vobjects version=\"1\" next-id=\"%u\"",
+                          vl->next_id);
+
+  if (vl->opt_sig)
+    {
+      gchar *sig = g_markup_escape_text (vl->opt_sig, -1);
+
+      g_string_append_printf (s, " options-style=\"%s\"", sig);
+      g_free (sig);
+    }
+
+  if (state)
+    {
+      g_string_append_printf (s, " legacy=\"%d\" entered=\"%u\" selection=\"",
+                              vl->legacy ? 1 : 0, vl->entered);
+
+      for (guint i = 0; i < vl->selection->len; i++)
+        g_string_append_printf (s, i ? " %u" : "%u",
+                                g_array_index (vl->selection, guint, i));
+
+      g_string_append_c (s, '"');
+    }
+
+  g_string_append (s, ">\n");
+
+  write_object (s, vl->root, ! state);
+
+  g_string_append (s, "</chopgimp-vobjects>\n");
+
+  return g_string_free (s, FALSE);
+}
+
+/*  the legacy fill / stroke as text, to notice changes made to them  */
+static gchar *
+options_sig (GimpVectorLayerOptions *options)
+{
+  ChopGimpVStyle style;
+  GString       *s = g_string_new (NULL);
+
+  chopgimp_vstyle_init (&style);
+  chopgimp_vstyle_from_options (&style, options);
+
+  write_paint (s, "fill",   &style.fill,   NULL);
+  write_paint (s, "stroke", &style.stroke, &style);
+  g_string_append_printf (s, "aa=%d", style.antialias);
+
+  chopgimp_vstyle_clear (&style);
+
+  return g_string_free (s, FALSE);
+}
+
+typedef struct
+{
+  GimpImage        *image;
+  ChopGimpVLayer   *vl;
+  GPtrArray        *stack;
+  ChopGimpVObject  *object;     /* the current one */
+  ChopGimpPaint    *paint;
+  gboolean          in_lpe;
+  GString          *text;
+  gboolean          has_legacy;
+} ParseData;
+
+static void
+parse_paint (ParseData       *pd,
+             ChopGimpPaint   *p,
+             const gchar    **names,
+             const gchar    **values)
+{
+  const gchar *type = attr (names, values, "type");
+
+  paint_clear (p);
+
+  if (! g_strcmp0 (type, "color"))
+    {
+      p->type  = CHOPGIMP_PAINT_COLOR;
+      p->color = color_parse (attr (names, values, "color"));
+    }
+  else if (! g_strcmp0 (type, "linear") || ! g_strcmp0 (type, "radial"))
+    {
+      p->type = (! strcmp (type, "linear") ? CHOPGIMP_PAINT_LINEAR_GRADIENT
+                                           : CHOPGIMP_PAINT_RADIAL_GRADIENT);
+      p->x1   = attr_num (names, values, "x1", 0.0);
+      p->y1   = attr_num (names, values, "y1", 0.0);
+      p->x2   = attr_num (names, values, "x2", 1.0);
+      p->y2   = attr_num (names, values, "y2", 0.0);
+      p->r    = attr_num (names, values, "r",  0.5);
+    }
+  else if (! g_strcmp0 (type, "pattern"))
+    {
+      const gchar   *name      = attr (names, values, "pattern");
+      GimpContainer *container = gimp_data_factory_get_container (pd->image->gimp->pattern_factory);
+      GimpObject    *pattern   = name ? gimp_container_get_child_by_name (container, name) : NULL;
+
+      if (pattern)
+        {
+          p->type    = CHOPGIMP_PAINT_PATTERN;
+          p->pattern = g_object_ref (GIMP_PATTERN (pattern));
+        }
+      else
+        {
+          /*  a missing pattern: grey, like GIMP's fallback  */
+          GeglColor *grey = gegl_color_new ("gray");
+
+          chopgimp_vpaint_set_color (p, grey);
+          g_object_unref (grey);
+        }
+    }
+}
+
+static void
+parse_start (GMarkupParseContext  *context,
+             const gchar          *element,
+             const gchar         **names,
+             const gchar         **values,
+             gpointer              user_data,
+             GError              **error)
+{
+  ParseData *pd = user_data;
+
+  if (! strcmp (element, "chopgimp-vobjects"))
+    {
+      const gchar *v;
+
+      pd->vl->next_id = (guint) attr_num (names, values, "next-id", 1);
+
+      if ((v = attr (names, values, "options-style")))
+        pd->vl->opt_sig = g_strdup (v);
+
+      if ((v = attr (names, values, "legacy")))
+        {
+          pd->has_legacy = TRUE;
+          pd->vl->legacy = atoi (v) != 0;
+        }
+
+      pd->vl->entered = (guint) attr_num (names, values, "entered", 0);
+
+      if ((v = attr (names, values, "selection")))
+        {
+          gchar **ids = g_strsplit (v, " ", -1);
+
+          for (gint i = 0; ids[i]; i++)
+            if (*ids[i])
+              {
+                guint id = (guint) g_ascii_strtoull (ids[i], NULL, 10);
+
+                g_array_append_val (pd->vl->selection, id);
+              }
+
+          g_strfreev (ids);
+        }
+    }
+  else if (! strcmp (element, "group") || ! strcmp (element, "path"))
+    {
+      gboolean         group = ! strcmp (element, "group");
+      ChopGimpVObject *o;
+      ChopGimpVObject *parent = pd->stack->len ? g_ptr_array_index (pd->stack,
+                                                                    pd->stack->len - 1)
+                                               : NULL;
+      const gchar     *v;
+
+      if (! parent && group)
+        {
+          o = pd->vl->root;   /* the root group */
+        }
+      else
+        {
+          if (! parent)
+            parent = pd->vl->root;
+
+          if (parent->kind != CHOPGIMP_VOBJECT_GROUP)
+            {
+              g_set_error (error, G_MARKUP_ERROR, G_MARKUP_ERROR_INVALID_CONTENT,
+                           "object inside a path");
+              return;
+            }
+
+          o = group ? vobj_alloc (CHOPGIMP_VOBJECT_GROUP, attr (names, values, "name"))
+                    : chopgimp_vobject_new_path (pd->image, NULL,
+                                                 attr (names, values, "name"), NULL);
+          o->id     = (guint) attr_num (names, values, "id", 0);
+          o->parent = parent;
+          g_ptr_array_add (parent->children, o);
+        }
+
+      if ((v = attr (names, values, "transform")))
+        {
+          gdouble m[6] = { 1, 0, 0, 1, 0, 0 };
+          gchar  *end;
+
+          for (gint i = 0; i < 6 && *v; i++)
+            {
+              m[i] = g_ascii_strtod (v, &end);
+              if (end == v)
+                break;
+              v = end;
+            }
+
+          gimp_matrix3_identity (&o->transform);
+          o->transform.coeff[0][0] = m[0];
+          o->transform.coeff[1][0] = m[1];
+          o->transform.coeff[0][1] = m[2];
+          o->transform.coeff[1][1] = m[3];
+          o->transform.coeff[0][2] = m[4];
+          o->transform.coeff[1][2] = m[5];
+        }
+
+      o->opacity = CLAMP (attr_num (names, values, "opacity", 1.0), 0.0, 1.0);
+      o->mode    = enum_from_nick (GIMP_TYPE_LAYER_MODE,
+                                   attr (names, values, "mode"),
+                                   GIMP_LAYER_MODE_NORMAL);
+      o->visible = attr_num (names, values, "visible", 1) != 0;
+      o->locked  = attr_num (names, values, "locked", 0) != 0;
+
+      if (! group)
+        {
+          o->style.fill_nonzero = ! g_strcmp0 (attr (names, values, "fill-rule"),
+                                               "nonzero");
+          o->style.antialias    = attr_num (names, values, "antialias", 1) != 0;
+          paint_clear (&o->style.fill);
+          path_from_d (o->path, attr (names, values, "d"));
+        }
+
+      g_ptr_array_add (pd->stack, o);
+      pd->object = o;
+    }
+  else if (pd->object && (! strcmp (element, "fill") || ! strcmp (element, "stroke")))
+    {
+      gboolean        stroke = ! strcmp (element, "stroke");
+      ChopGimpVStyle *st     = &pd->object->style;
+
+      pd->paint = stroke ? &st->stroke : &st->fill;
+      parse_paint (pd, pd->paint, names, values);
+
+      if (stroke)
+        {
+          const gchar *align = attr (names, values, "align");
+          const gchar *dash  = attr (names, values, "dash");
+
+          st->stroke_width = attr_num (names, values, "width", 1.0);
+          st->stroke_align = (! g_strcmp0 (align, "inside")  ? CHOPGIMP_STROKE_ALIGN_INSIDE  :
+                              ! g_strcmp0 (align, "outside") ? CHOPGIMP_STROKE_ALIGN_OUTSIDE :
+                                                               CHOPGIMP_STROKE_ALIGN_CENTER);
+          st->cap          = enum_from_nick (GIMP_TYPE_CAP_STYLE,
+                                             attr (names, values, "cap"), GIMP_CAP_BUTT);
+          st->join         = enum_from_nick (GIMP_TYPE_JOIN_STYLE,
+                                             attr (names, values, "join"), GIMP_JOIN_MITER);
+          st->miter_limit  = attr_num (names, values, "miter", 10.0);
+          st->dash_offset  = attr_num (names, values, "dash-offset", 0.0);
+
+          if (dash)
+            {
+              gchar *end;
+
+              st->dashes = g_array_new (FALSE, FALSE, sizeof (gdouble));
+
+              while (*dash)
+                {
+                  gdouble v = g_ascii_strtod (dash, &end);
+
+                  if (end == dash)
+                    break;
+
+                  g_array_append_val (st->dashes, v);
+                  dash = end;
+                }
+
+              if (st->dashes->len == 0)
+                {
+                  g_array_free (st->dashes, TRUE);
+                  st->dashes = NULL;
+                }
+            }
+        }
+    }
+  else if (pd->paint && ! strcmp (element, "stop"))
+    {
+      GeglColor *color = color_parse (attr (names, values, "color"));
+
+      chopgimp_vpaint_add_stop (pd->paint, attr_num (names, values, "offset", 0.0),
+                                color);
+      g_object_unref (color);
+    }
+  else if (pd->object && ! strcmp (element, "lpe"))
+    {
+      pd->in_lpe = TRUE;
+      g_string_truncate (pd->text, 0);
+    }
+}
+
+static void
+parse_end (GMarkupParseContext  *context,
+           const gchar          *element,
+           gpointer              user_data,
+           GError              **error)
+{
+  ParseData *pd = user_data;
+
+  if (! strcmp (element, "group") || ! strcmp (element, "path"))
+    {
+      if (pd->stack->len)
+        g_ptr_array_remove_index (pd->stack, pd->stack->len - 1);
+
+      pd->object = pd->stack->len ? g_ptr_array_index (pd->stack, pd->stack->len - 1)
+                                  : NULL;
+    }
+  else if (! strcmp (element, "fill") || ! strcmp (element, "stroke"))
+    {
+      pd->paint = NULL;
+    }
+  else if (! strcmp (element, "lpe") && pd->in_lpe)
+    {
+      pd->in_lpe = FALSE;
+
+      if (pd->object)
+        {
+          g_free (pd->object->lpe);
+          pd->object->lpe = pd->text->len ? g_strdup (pd->text->str) : NULL;
+        }
+    }
+}
+
+static void
+parse_text (GMarkupParseContext  *context,
+            const gchar          *text,
+            gsize                 len,
+            gpointer              user_data,
+            GError              **error)
+{
+  ParseData *pd = user_data;
+
+  if (pd->in_lpe)
+    g_string_append_len (pd->text, text, len);
+}
+
+/*  a new state from the text; NULL on error  */
+static ChopGimpVLayer *
+vlayer_parse (GimpImage   *image,
+              const gchar *xml,
+              gsize        len,
+              gboolean    *has_legacy)
+{
+  static const GMarkupParser parser = { parse_start, parse_end, parse_text, NULL, NULL };
+  GMarkupParseContext       *context;
+  ParseData                  pd     = { 0, };
+  GError                    *error  = NULL;
+  guint                      next_id;
+
+  pd.image = image;
+  pd.vl    = vlayer_new ();
+  pd.stack = g_ptr_array_new ();
+  pd.text  = g_string_new (NULL);
+
+  context = g_markup_parse_context_new (&parser, 0, &pd, NULL);
+
+  if (! g_markup_parse_context_parse (context, xml, len, &error) ||
+      ! g_markup_parse_context_end_parse (context, &error))
+    {
+      g_printerr ("ChopGimp: invalid vector objects: %s\n",
+                  error ? error->message : "?");
+      g_clear_error (&error);
+      chopgimp_vlayer_free (pd.vl);
+      pd.vl = NULL;
+    }
+
+  g_markup_parse_context_free (context);
+  g_ptr_array_free (pd.stack, TRUE);
+  g_string_free (pd.text, TRUE);
+
+  if (pd.vl)
+    {
+      GHashTable *seen = g_hash_table_new (NULL, NULL);
+      GList      *all  = NULL;
+      GList      *l;
+
+      /*  ids: unique, non-zero (except the root)  */
+      next_id = pd.vl->next_id;
+      pd.vl->root->id = 0;
+      g_hash_table_add (seen, GUINT_TO_POINTER (0));
+
+      {
+        GPtrArray *queue = g_ptr_array_new ();
+
+        g_ptr_array_add (queue, pd.vl->root);
+
+        for (guint i = 0; i < queue->len; i++)
+          {
+            ChopGimpVObject *o = g_ptr_array_index (queue, i);
+
+            if (o->children)
+              for (guint k = 0; k < o->children->len; k++)
+                g_ptr_array_add (queue, g_ptr_array_index (o->children, k));
+
+            if (o != pd.vl->root)
+              all = g_list_prepend (all, o);
+          }
+
+        g_ptr_array_free (queue, TRUE);
+      }
+
+      for (l = all; l; l = l->next)
+        {
+          ChopGimpVObject *o = l->data;
+
+          if (o->id >= next_id)
+            next_id = o->id + 1;
+        }
+
+      all = g_list_reverse (all);
+
+      for (l = all; l; l = l->next)
+        {
+          ChopGimpVObject *o = l->data;
+
+          if (o->id == 0 || g_hash_table_contains (seen, GUINT_TO_POINTER (o->id)))
+            o->id = next_id++;
+
+          g_hash_table_add (seen, GUINT_TO_POINTER (o->id));
+        }
+
+      g_list_free (all);
+      g_hash_table_unref (seen);
+
+      vlayer_reindex (pd.vl);
+      pd.vl->next_id = MAX (pd.vl->next_id, next_id);
+    }
+
+  if (has_legacy)
+    *has_legacy = pd.has_legacy;
+
+  return pd.vl;
+}
+
+
+/*  ─── live effects, bounds ──────────────────────────────────────────── */
+
+static gchar *
+layer_lpe_spec (GimpVectorLayer *layer)
+{
+  const GimpParasite *parasite;
+  const gchar        *data;
+  guint32             size = 0;
+
+  parasite = gimp_item_parasite_find (GIMP_ITEM (layer), "chopgimp-lpe");
+  if (! parasite)
+    return NULL;
+
+  data = gimp_parasite_get_data (parasite, &size);
+  if (! data || size == 0)
+    return NULL;
+
+  return g_strndup (data, size);
+}
+
+/*  the layer's own live effects changed: the objects without effects of
+ *  their own are drawn again
+ */
+static void
+vlayer_check_layer_lpe (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl   = layer->vobjects;
+  gchar          *spec = layer_lpe_spec (layer);
+
+  if (g_strcmp0 (spec, vl->layer_lpe))
+    {
+      GList *leaves = leaves_of (vl->root);
+
+      for (GList *l = leaves; l; l = l->next)
+        {
+          ChopGimpVObject *o = l->data;
+
+          if (! o->lpe)
+            vobj_invalidate (o);
+        }
+
+      g_list_free (leaves);
+
+      g_free (vl->layer_lpe);
+      vl->layer_lpe = spec;
+    }
+  else
+    {
+      g_free (spec);
+    }
+}
+
+static GimpPath *
+vobj_effective (GimpVectorLayer *layer,
+                ChopGimpVObject *o)
+{
+  if (! o->path)
+    return NULL;
+
+  if (! o->effective_valid)
+    {
+      const gchar *spec = o->lpe;
+
+      if (! spec && layer->vobjects)
+        spec = layer->vobjects->layer_lpe;
+
+      g_clear_object (&o->effective);
+
+      if (spec && *spec && gimp_path_get_n_strokes (o->path) > 0)
+        o->effective = chopgimp_geom_effects (o->path, spec);
+
+      o->effective_valid = TRUE;
+    }
+
+  return o->effective ? o->effective : o->path;
+}
+
+static gboolean
+style_has_stroke (const ChopGimpVStyle *st)
+{
+  return st->stroke.type != CHOPGIMP_PAINT_NONE && st->stroke_width > 0.0;
+}
+
+static void
+setup_stroke (cairo_t              *cr,
+              const ChopGimpVStyle *st,
+              gdouble               width)
+{
+  cairo_set_line_width (cr, width);
+
+  switch (st->cap)
+    {
+    case GIMP_CAP_ROUND:  cairo_set_line_cap (cr, CAIRO_LINE_CAP_ROUND);  break;
+    case GIMP_CAP_SQUARE: cairo_set_line_cap (cr, CAIRO_LINE_CAP_SQUARE); break;
+    default:              cairo_set_line_cap (cr, CAIRO_LINE_CAP_BUTT);   break;
+    }
+
+  switch (st->join)
+    {
+    case GIMP_JOIN_ROUND: cairo_set_line_join (cr, CAIRO_LINE_JOIN_ROUND); break;
+    case GIMP_JOIN_BEVEL: cairo_set_line_join (cr, CAIRO_LINE_JOIN_BEVEL); break;
+    default:              cairo_set_line_join (cr, CAIRO_LINE_JOIN_MITER); break;
+    }
+
+  cairo_set_miter_limit (cr, MAX (st->miter_limit, 1.0));
+
+  if (st->dashes && st->dashes->len > 0)
+    {
+      gdouble *d     = g_new (gdouble, st->dashes->len);
+      gdouble  total = 0.0;
+
+      for (guint i = 0; i < st->dashes->len; i++)
+        {
+          d[i]   = MAX (0.0, g_array_index (st->dashes, gdouble, i)) * st->stroke_width;
+          total += d[i];
+        }
+
+      if (total > 0.0)
+        cairo_set_dash (cr, d, st->dashes->len, st->dash_offset);
+      else
+        cairo_set_dash (cr, NULL, 0, 0);
+
+      g_free (d);
+    }
+  else
+    {
+      cairo_set_dash (cr, NULL, 0, 0);
+    }
+}
+
+/*  image-space bounds of a leaf (FALSE: empty)  */
+static gboolean
+leaf_bounds (GimpVectorLayer *layer,
+             ChopGimpVObject *o,
+             gboolean         with_stroke,
+             gdouble         *b)
+{
+  gint idx = with_stroke ? 1 : 0;
+
+  if (! o->bounds_valid[idx])
+    {
+      GimpPath       *path = vobj_effective (layer, o);
+      GimpMatrix3     wm;
+      cairo_matrix_t  cm;
+      cairo_t        *cr   = measure_cr ();
+      gdouble         x1, y1, x2, y2;
+
+      chopgimp_vobject_get_world_matrix (o, &wm);
+      matrix_to_cairo (&wm, &cm);
+      cairo_set_matrix (cr, &cm);
+
+      o->bounds[idx][0] = o->bounds[idx][1] =  G_MAXDOUBLE;
+      o->bounds[idx][2] = o->bounds[idx][3] = -G_MAXDOUBLE;
+
+      if (append_path (cr, path))
+        {
+          gdouble px[4], py[4];
+
+          cairo_path_extents (cr, &x1, &y1, &x2, &y2);
+
+          if (with_stroke && style_has_stroke (&o->style))
+            {
+              gdouble sx1, sy1, sx2, sy2;
+              gdouble w = o->style.stroke_width;
+
+              if (o->style.stroke_align == CHOPGIMP_STROKE_ALIGN_OUTSIDE &&
+                  path_all_closed (path))
+                w *= 2.0;
+              else if (o->style.stroke_align == CHOPGIMP_STROKE_ALIGN_INSIDE &&
+                       path_all_closed (path))
+                w = 0.0;
+
+              if (w > 0.0)
+                {
+                  setup_stroke (cr, &o->style, w);
+                  cairo_set_dash (cr, NULL, 0, 0);
+                  cairo_stroke_extents (cr, &sx1, &sy1, &sx2, &sy2);
+
+                  x1 = MIN (x1, sx1);
+                  y1 = MIN (y1, sy1);
+                  x2 = MAX (x2, sx2);
+                  y2 = MAX (y2, sy2);
+                }
+            }
+
+          px[0] = x1; py[0] = y1;
+          px[1] = x2; py[1] = y1;
+          px[2] = x1; py[2] = y2;
+          px[3] = x2; py[3] = y2;
+
+          for (gint i = 0; i < 4; i++)
+            {
+              cairo_user_to_device (cr, &px[i], &py[i]);
+
+              o->bounds[idx][0] = MIN (o->bounds[idx][0], px[i]);
+              o->bounds[idx][1] = MIN (o->bounds[idx][1], py[i]);
+              o->bounds[idx][2] = MAX (o->bounds[idx][2], px[i]);
+              o->bounds[idx][3] = MAX (o->bounds[idx][3], py[i]);
+            }
+        }
+
+      cairo_destroy (cr);
+      o->bounds_valid[idx] = TRUE;
+    }
+
+  if (o->bounds[idx][0] > o->bounds[idx][2])
+    return FALSE;
+
+  memcpy (b, o->bounds[idx], 4 * sizeof (gdouble));
+
+  return TRUE;
+}
+
+static gboolean
+object_bounds (GimpVectorLayer *layer,
+               ChopGimpVObject *o,
+               gboolean         with_stroke,
+               gboolean         visible_only,
+               gdouble         *b)
+{
+  gboolean any = FALSE;
+
+  if (visible_only && ! o->visible)
+    return FALSE;
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    return leaf_bounds (layer, o, with_stroke, b);
+
+  b[0] = b[1] =  G_MAXDOUBLE;
+  b[2] = b[3] = -G_MAXDOUBLE;
+
+  for (guint i = 0; i < o->children->len; i++)
+    {
+      gdouble cb[4];
+
+      if (object_bounds (layer, g_ptr_array_index (o->children, i),
+                         with_stroke, visible_only, cb))
+        {
+          b[0] = MIN (b[0], cb[0]);
+          b[1] = MIN (b[1], cb[1]);
+          b[2] = MAX (b[2], cb[2]);
+          b[3] = MAX (b[3], cb[3]);
+          any  = TRUE;
+        }
+    }
+
+  return any;
+}
+
+gboolean
+chopgimp_vobject_get_bounds (GimpVectorLayer *layer,
+                             ChopGimpVObject *object,
+                             gboolean         with_stroke,
+                             gdouble         *x1,
+                             gdouble         *y1,
+                             gdouble         *x2,
+                             gdouble         *y2)
+{
+  gdouble b[4];
+
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), FALSE);
+  g_return_val_if_fail (object != NULL, FALSE);
+
+  if (layer->vobjects)
+    vlayer_check_layer_lpe (layer);
+
+  if (! object_bounds (layer, object, with_stroke, FALSE, b))
+    return FALSE;
+
+  if (x1) *x1 = b[0];
+  if (y1) *y1 = b[1];
+  if (x2) *x2 = b[2];
+  if (y2) *y2 = b[3];
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vlayer_get_bounds (GimpVectorLayer *layer,
+                            const guint     *ids,
+                            gint             n_ids,
+                            gboolean         with_stroke,
+                            gdouble         *x1,
+                            gdouble         *y1,
+                            gdouble         *x2,
+                            gdouble         *y2)
+{
+  gdouble  b[4] = { G_MAXDOUBLE, G_MAXDOUBLE, -G_MAXDOUBLE, -G_MAXDOUBLE };
+  gboolean any  = FALSE;
+
+  for (gint i = 0; i < n_ids; i++)
+    {
+      ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, ids[i]);
+      gdouble          ob[4];
+
+      if (o && chopgimp_vobject_get_bounds (layer, o, with_stroke,
+                                            &ob[0], &ob[1], &ob[2], &ob[3]))
+        {
+          b[0] = MIN (b[0], ob[0]);
+          b[1] = MIN (b[1], ob[1]);
+          b[2] = MAX (b[2], ob[2]);
+          b[3] = MAX (b[3], ob[3]);
+          any  = TRUE;
+        }
+    }
+
+  if (any)
+    {
+      if (x1) *x1 = b[0];
+      if (y1) *y1 = b[1];
+      if (x2) *x2 = b[2];
+      if (y2) *y2 = b[3];
+    }
+
+  return any;
+}
+
+/*  integer rendering bounds of a leaf, one pixel of margin  */
+static gboolean
+leaf_ibounds (GimpVectorLayer *layer,
+              ChopGimpVObject *o,
+              GeglRectangle   *r)
+{
+  gdouble b[4];
+
+  if (! leaf_bounds (layer, o, TRUE, b))
+    return FALSE;
+
+  r->x      = (gint) floor (b[0]) - 1;
+  r->y      = (gint) floor (b[1]) - 1;
+  r->width  = (gint) ceil (b[2]) + 1 - r->x;
+  r->height = (gint) ceil (b[3]) + 1 - r->y;
+
+  return r->width > 0 && r->height > 0;
+}
+
+
+/*  ─── rendering ─────────────────────────────────────────────────────── */
+
+static cairo_pattern_t *
+make_source (const ChopGimpPaint *p,
+             const Babl          *space,
+             GimpPath            *local,
+             const cairo_matrix_t *world)
+{
+  cairo_pattern_t *pat = NULL;
+
+  switch (p->type)
+    {
+    case CHOPGIMP_PAINT_COLOR:
+      {
+        gdouble rgba[4];
+
+        color_rgba (p->color, space, rgba);
+        pat = cairo_pattern_create_rgba (rgba[0], rgba[1], rgba[2], rgba[3]);
+      }
+      break;
+
+    case CHOPGIMP_PAINT_LINEAR_GRADIENT:
+    case CHOPGIMP_PAINT_RADIAL_GRADIENT:
+      {
+        cairo_t        *cr = measure_cr ();
+        gdouble         x1 = 0, y1 = 0, x2 = 1, y2 = 1;
+        cairo_matrix_t  m;
+
+        if (append_path (cr, local))
+          cairo_path_extents (cr, &x1, &y1, &x2, &y2);
+        cairo_destroy (cr);
+
+        if (x2 - x1 < 1e-6) x2 = x1 + 1;
+        if (y2 - y1 < 1e-6) y2 = y1 + 1;
+
+        if (p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT)
+          pat = cairo_pattern_create_linear (p->x1, p->y1, p->x2, p->y2);
+        else
+          pat = cairo_pattern_create_radial (p->x2, p->y2, 0.0,
+                                             p->x1, p->y1, MAX (p->r, 1e-6));
+
+        /*  user (local) → bounding box units  */
+        cairo_matrix_init_scale (&m, 1.0 / (x2 - x1), 1.0 / (y2 - y1));
+        cairo_matrix_translate (&m, -x1, -y1);
+        cairo_pattern_set_matrix (pat, &m);
+        cairo_pattern_set_extend (pat, CAIRO_EXTEND_PAD);
+
+        if (p->stops)
+          for (guint i = 0; i < p->stops->len; i++)
+            {
+              ChopGimpGradientStop *st = &g_array_index (p->stops, ChopGimpGradientStop, i);
+              gdouble               rgba[4];
+
+              color_rgba (st->color, space, rgba);
+              cairo_pattern_add_color_stop_rgba (pat, st->offset,
+                                                 rgba[0], rgba[1], rgba[2], rgba[3]);
+            }
+      }
+      break;
+
+    case CHOPGIMP_PAINT_PATTERN:
+      if (p->pattern)
+        {
+          GimpTempBuf     *mask = gimp_pattern_get_mask (p->pattern);
+          GeglBuffer      *buf  = gimp_temp_buf_create_buffer (mask);
+          gint             w    = gimp_temp_buf_get_width  (mask);
+          gint             h    = gimp_temp_buf_get_height (mask);
+          cairo_surface_t *surf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32, w, h);
+
+          cairo_surface_flush (surf);
+          gegl_buffer_get (buf, GEGL_RECTANGLE (0, 0, w, h), 1.0,
+                           babl_format_with_space ("cairo-ARGB32", space),
+                           cairo_image_surface_get_data (surf),
+                           cairo_image_surface_get_stride (surf),
+                           GEGL_ABYSS_NONE);
+          cairo_surface_mark_dirty (surf);
+          g_object_unref (buf);
+
+          pat = cairo_pattern_create_for_surface (surf);
+          cairo_surface_destroy (surf);
+
+          cairo_pattern_set_extend (pat, CAIRO_EXTEND_REPEAT);
+          /*  tiled in image space, like GIMP's pattern fills  */
+          cairo_pattern_set_matrix (pat, world);
+        }
+      break;
+
+    default:
+      break;
+    }
+
+  return pat;
+}
+
+/*  draws a leaf at full opacity (cr: image coordinates)  */
+static void
+draw_leaf (cairo_t         *cr,
+           GimpVectorLayer *layer,
+           ChopGimpVObject *o,
+           const Babl      *space)
+{
+  const ChopGimpVStyle *st   = &o->style;
+  GimpPath             *path = vobj_effective (layer, o);
+  GimpMatrix3           wm;
+  cairo_matrix_t        world;
+  cairo_pattern_t      *pat;
+  cairo_fill_rule_t     rule = st->fill_nonzero ? CAIRO_FILL_RULE_WINDING
+                                                : CAIRO_FILL_RULE_EVEN_ODD;
+
+  if (! path || gimp_path_get_n_strokes (path) == 0)
+    return;
+
+  chopgimp_vobject_get_world_matrix (o, &wm);
+  matrix_to_cairo (&wm, &world);
+
+  cairo_save (cr);
+  cairo_set_operator (cr, CAIRO_OPERATOR_OVER);
+  cairo_transform (cr, &world);
+  cairo_set_antialias (cr, st->antialias ? CAIRO_ANTIALIAS_DEFAULT
+                                         : CAIRO_ANTIALIAS_NONE);
+
+  if (st->fill.type != CHOPGIMP_PAINT_NONE &&
+      (pat = make_source (&st->fill, space, path, &world)))
+    {
+      cairo_new_path (cr);
+      append_path (cr, path);
+      cairo_set_fill_rule (cr, rule);
+      cairo_set_source (cr, pat);
+      cairo_fill (cr);
+      cairo_pattern_destroy (pat);
+    }
+
+  if (style_has_stroke (st) &&
+      (pat = make_source (&st->stroke, space, path, &world)))
+    {
+      ChopGimpStrokeAlign align = st->stroke_align;
+
+      if (! path_all_closed (path))
+        align = CHOPGIMP_STROKE_ALIGN_CENTER;
+
+      cairo_set_source (cr, pat);
+      cairo_new_path (cr);
+
+      switch (align)
+        {
+        case CHOPGIMP_STROKE_ALIGN_INSIDE:
+          cairo_save (cr);
+          setup_stroke (cr, st, st->stroke_width * 2.0);
+          append_path (cr, path);
+          cairo_set_fill_rule (cr, rule);
+          cairo_clip_preserve (cr);
+          cairo_stroke (cr);
+          cairo_restore (cr);
+          break;
+
+        case CHOPGIMP_STROKE_ALIGN_OUTSIDE:
+          cairo_save (cr);
+          setup_stroke (cr, st, st->stroke_width * 2.0);
+          cairo_rectangle (cr, -1e7, -1e7, 2e7, 2e7);
+          append_path (cr, path);
+          cairo_set_fill_rule (cr, CAIRO_FILL_RULE_EVEN_ODD);
+          cairo_clip (cr);
+          append_path (cr, path);
+          cairo_stroke (cr);
+          cairo_restore (cr);
+          break;
+
+        default:
+          setup_stroke (cr, st, st->stroke_width);
+          append_path (cr, path);
+          cairo_stroke (cr);
+          break;
+        }
+
+      cairo_pattern_destroy (pat);
+    }
+
+  cairo_restore (cr);
+}
+
+static cairo_surface_t *
+leaf_cache (GimpVectorLayer     *layer,
+            ChopGimpVObject     *o,
+            const Babl          *space,
+            const GeglRectangle *ib)
+{
+  if (o->cache)
+    return o->cache;
+
+  if ((gint64) ib->width * ib->height > CACHE_MAX_PIXELS)
+    return NULL;
+
+  {
+    cairo_surface_t *surf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+                                                        ib->width, ib->height);
+    cairo_t         *cr   = cairo_create (surf);
+
+    cairo_translate (cr, -ib->x, -ib->y);
+    draw_leaf (cr, layer, o, space);
+    cairo_destroy (cr);
+    cairo_surface_flush (surf);
+
+    o->cache   = surf;
+    o->cache_x = ib->x;
+    o->cache_y = ib->y;
+  }
+
+  return o->cache;
+}
+
+static void
+composite (cairo_t             *cr,
+           GimpVectorLayer     *layer,
+           ChopGimpVObject     *o,
+           const GeglRectangle *band,
+           const Babl          *space)
+{
+  cairo_operator_t op = mode_operator (o->mode);
+  gboolean         simple;
+
+  if (! o->visible || o->opacity <= 0.0)
+    return;
+
+  simple = (o->opacity >= 1.0 && op == CAIRO_OPERATOR_OVER);
+
+  if (o->kind == CHOPGIMP_VOBJECT_GROUP)
+    {
+      if (o->children->len == 0)
+        return;
+
+      if (! simple)
+        cairo_push_group (cr);
+
+      for (guint i = 0; i < o->children->len; i++)
+        composite (cr, layer, g_ptr_array_index (o->children, i), band, space);
+
+      if (! simple)
+        {
+          cairo_pop_group_to_source (cr);
+          cairo_set_operator (cr, op);
+          cairo_paint_with_alpha (cr, o->opacity);
+          cairo_set_operator (cr, CAIRO_OPERATOR_OVER);
+        }
+    }
+  else
+    {
+      GeglRectangle    ib, isect;
+      cairo_surface_t *surf;
+
+      if (! leaf_ibounds (layer, o, &ib) ||
+          ! gegl_rectangle_intersect (&isect, &ib, band))
+        return;
+
+      surf = leaf_cache (layer, o, space, &ib);
+
+      cairo_save (cr);
+      cairo_rectangle (cr, isect.x, isect.y, isect.width, isect.height);
+      cairo_clip (cr);
+
+      if (surf)
+        {
+          cairo_set_operator (cr, op);
+          cairo_set_source_surface (cr, surf, o->cache_x, o->cache_y);
+          cairo_paint_with_alpha (cr, o->opacity);
+        }
+      else if (! simple)
+        {
+          cairo_push_group (cr);
+          draw_leaf (cr, layer, o, space);
+          cairo_pop_group_to_source (cr);
+          cairo_set_operator (cr, op);
+          cairo_paint_with_alpha (cr, o->opacity);
+        }
+      else
+        {
+          draw_leaf (cr, layer, o, space);
+        }
+
+      cairo_restore (cr);
+    }
+}
+
+static gboolean
+union_ibounds (GimpVectorLayer *layer,
+               ChopGimpVObject *o,
+               GeglRectangle   *r)
+{
+  gboolean any = FALSE;
+
+  if (! o->visible || o->opacity <= 0.0)
+    return FALSE;
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    return leaf_ibounds (layer, o, r);
+
+  for (guint i = 0; i < o->children->len; i++)
+    {
+      GeglRectangle cr;
+
+      if (union_ibounds (layer, g_ptr_array_index (o->children, i), &cr))
+        {
+          if (any)
+            gegl_rectangle_bounding_box (r, r, &cr);
+          else
+            *r = cr;
+
+          any = TRUE;
+        }
+    }
+
+  return any;
+}
+
+/*  draws the objects into the layer; @dirty (image coordinates) NULL:
+ *  everything. The layer follows the bounds of its objects.
+ */
+static void
+vlayer_render_region (GimpVectorLayer     *layer,
+                      const GeglRectangle *dirty)
+{
+  GimpDrawable  *drawable = GIMP_DRAWABLE (layer);
+  GimpItem      *item     = GIMP_ITEM (layer);
+  ChopGimpVLayer *vl      = layer->vobjects;
+  const Babl    *space;
+  const Babl    *fmt;
+  GeglBuffer    *buffer;
+  GeglRectangle  u, cur, region;
+  gboolean       full;
+  gint           band_h;
+
+  if (! gimp_item_is_attached (item) ||
+      gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)))
+    return;
+
+  vlayer_check_layer_lpe (layer);
+
+  space = babl_format_get_space (gimp_drawable_get_format (drawable));
+  fmt   = babl_format_with_space ("cairo-ARGB32", space);
+
+  gimp_item_get_offset (item, &cur.x, &cur.y);
+  cur.width  = gimp_item_get_width  (item);
+  cur.height = gimp_item_get_height (item);
+
+  if (! union_ibounds (layer, vl->root, &u))
+    {
+      if (cur.width > 0 && cur.height > 0)
+        u = cur;
+      else
+        u = *GEGL_RECTANGLE (0, 0, 1, 1);
+    }
+
+  full = (! dirty || ! gegl_rectangle_equal (&u, &cur));
+
+  if (full)
+    {
+      g_object_freeze_notify (G_OBJECT (drawable));
+
+      buffer = gegl_buffer_new (GEGL_RECTANGLE (0, 0, u.width, u.height),
+                                gimp_drawable_get_format (drawable));
+      gimp_drawable_set_buffer (drawable, FALSE, NULL, buffer);
+      g_object_unref (buffer);
+
+      gimp_item_set_offset (item, u.x, u.y);
+      region = u;
+    }
+  else if (! gegl_rectangle_intersect (&region, dirty, &u))
+    {
+      return;
+    }
+
+  buffer = gimp_drawable_get_buffer (drawable);
+  band_h = MAX (1, MIN (region.height, BAND_MAX_PIXELS / MAX (1, region.width)));
+
+  for (gint y = region.y; y < region.y + region.height; y += band_h)
+    {
+      GeglRectangle    band = { region.x, y, region.width,
+                                MIN (band_h, region.y + region.height - y) };
+      cairo_surface_t *surf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+                                                          band.width, band.height);
+      cairo_t         *cr   = cairo_create (surf);
+
+      cairo_translate (cr, -band.x, -band.y);
+      composite (cr, layer, vl->root, &band, space);
+      cairo_destroy (cr);
+      cairo_surface_flush (surf);
+
+      gegl_buffer_set (buffer,
+                       GEGL_RECTANGLE (band.x - u.x, band.y - u.y,
+                                       band.width, band.height),
+                       0, fmt,
+                       cairo_image_surface_get_data (surf),
+                       cairo_image_surface_get_stride (surf));
+
+      cairo_surface_destroy (surf);
+    }
+
+  if (full)
+    {
+      g_object_thaw_notify (G_OBJECT (drawable));
+      gimp_drawable_update (drawable, 0, 0, -1, -1);
+    }
+  else
+    {
+      gimp_drawable_update (drawable, region.x - u.x, region.y - u.y,
+                            region.width, region.height);
+    }
+
+  gimp_viewable_invalidate_preview (GIMP_VIEWABLE (layer));
+}
+
+gboolean
+chopgimp_vlayer_render (GimpVectorLayer *layer,
+                        gboolean         invalidate_all)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+
+  if (! chopgimp_vobjects_enabled () || ! vl)
+    return FALSE;
+
+  /*  a refresh after the legacy fill / stroke were changed in place
+   *  (PDB gimp-vector-layer-set-fill-color…): object #1 takes them
+   */
+  if (invalidate_all && layer->options && ! vl->syncing)
+    vlayer_style_from_options (layer);
+
+  if (vl->legacy)
+    return FALSE;
+
+  if (invalidate_all)
+    vobj_invalidate (vl->root);
+
+  vlayer_render_region (layer, NULL);
+
+  return TRUE;
+}
+
+
+/*  ─── the legacy path and style ─────────────────────────────────────── */
+
+/*  objects → legacy path (all the sub-paths) and fill / stroke (object #1)  */
+static void
+vlayer_write_legacy (GimpVectorLayer *layer,
+                     gboolean         geometry,
+                     gboolean         style)
+{
+  GimpVectorLayerOptions *options = layer->options;
+  ChopGimpVLayer         *vl      = layer->vobjects;
+
+  if (! options || ! vl)
+    return;
+
+  vl->syncing++;
+
+  if (geometry && options->path)
+    {
+      GimpPath *u      = options->path;
+      GList    *leaves = leaves_of (vl->root);
+      GArray   *layout = g_array_new (FALSE, FALSE, sizeof (guint));
+
+      gimp_path_freeze (u);
+      path_clear (u);
+      g_hash_table_remove_all (vl->stroke_map);
+
+      for (GList *l = leaves; l; l = l->next)
+        {
+          ChopGimpVObject *o = l->data;
+          GimpMatrix3      wm;
+          GimpStroke      *s;
+          gboolean         identity;
+
+          chopgimp_vobject_get_world_matrix (o, &wm);
+          identity = gimp_matrix3_is_identity (&wm);
+
+          for (s = gimp_path_stroke_get_next (o->path, NULL); s;
+               s = gimp_path_stroke_get_next (o->path, s))
+            {
+              GimpStroke *d = gimp_stroke_duplicate (s);
+
+              if (! identity)
+                gimp_stroke_transform (d, &wm, NULL);
+
+              gimp_path_stroke_add (u, d);
+              g_hash_table_insert (vl->stroke_map,
+                                   GINT_TO_POINTER (gimp_stroke_get_id (d)),
+                                   GUINT_TO_POINTER (o->id));
+              g_array_append_val (layout, o->id);
+              g_object_unref (d);
+            }
+        }
+
+      vl->mapped = layout->len;
+      vlayer_push_layout (vl, layout);
+      g_list_free (leaves);
+
+      gimp_path_thaw (u);
+    }
+
+  if (style)
+    {
+      ChopGimpVObject *first = first_leaf (vl->root);
+
+      if (first)
+        {
+          gchar *sig;
+
+          chopgimp_vstyle_to_options (&first->style, options);
+
+          sig = options_sig (options);
+          g_free (vl->opt_sig);
+          vl->opt_sig = sig;
+        }
+    }
+
+  vl->syncing--;
+}
+
+/*  legacy path → objects: each sub-path goes back to its object  */
+static void
+vlayer_pull_legacy_path (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer   *vl = layer->vobjects;
+  GimpPath         *u  = layer->options ? layer->options->path : NULL;
+  GList            *leaves;
+  GPtrArray        *strokes;
+  ChopGimpVObject **owners;
+  GimpStroke       *s;
+  gboolean          by_id;
+  GArray           *layout;
+  guint             n;
+
+  if (! u)
+    return;
+
+  leaves  = leaves_of (vl->root);
+  strokes = g_ptr_array_new ();
+
+  for (s = gimp_path_stroke_get_next (u, NULL); s;
+       s = gimp_path_stroke_get_next (u, s))
+    g_ptr_array_add (strokes, s);
+
+  n      = strokes->len;
+  owners = g_new0 (ChopGimpVObject *, MAX (n, 1));
+
+  /*  1. same sub-paths (moved, edited in place): by id  */
+  by_id = (n == (guint) vl->mapped && n > 0);
+
+  for (guint i = 0; by_id && i < n; i++)
+    {
+      gpointer id;
+
+      if (! g_hash_table_lookup_extended (vl->stroke_map,
+                                          GINT_TO_POINTER (gimp_stroke_get_id (strokes->pdata[i])),
+                                          NULL, &id) ||
+          ! (owners[i] = g_hash_table_lookup (vl->by_id, id)) ||
+          owners[i]->kind != CHOPGIMP_VOBJECT_PATH)
+        by_id = FALSE;
+    }
+
+  if (! by_id)
+    {
+      gboolean found = FALSE;
+
+      memset (owners, 0, sizeof (ChopGimpVObject *) * MAX (n, 1));
+
+      /*  2. a known layout of the same length (undo, transformation)  */
+      for (gint k = (gint) vl->layouts->len - 1; k >= 0 && ! found && n > 0; k--)
+        {
+          GArray *lay = g_ptr_array_index (vl->layouts, k);
+
+          if (lay->len != n)
+            continue;
+
+          found = TRUE;
+
+          for (guint i = 0; i < n && found; i++)
+            {
+              ChopGimpVObject *o = g_hash_table_lookup (vl->by_id,
+                                                        GUINT_TO_POINTER (g_array_index (lay, guint, i)));
+
+              if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+                found = FALSE;
+              else
+                owners[i] = o;
+            }
+        }
+
+      /*  3. by id where known, else the object of the previous sub-path  */
+      if (! found)
+        {
+          ChopGimpVObject *prev = leaves ? leaves->data : NULL;
+
+          for (guint i = 0; i < n; i++)
+            {
+              gpointer         id;
+              ChopGimpVObject *o = NULL;
+
+              if (g_hash_table_lookup_extended (vl->stroke_map,
+                                                GINT_TO_POINTER (gimp_stroke_get_id (strokes->pdata[i])),
+                                                NULL, &id))
+                o = g_hash_table_lookup (vl->by_id, id);
+
+              if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+                o = prev;
+
+              if (! o)
+                {
+                  /*  no object left: a new one, with the legacy style  */
+                  GimpImage *image = gimp_item_get_image (GIMP_ITEM (layer));
+
+                  o = chopgimp_vobject_new_path (image, NULL,
+                                                 gimp_object_get_name (layer), NULL);
+                  chopgimp_vstyle_from_options (&o->style, layer->options);
+                  o->parent = vl->root;
+                  g_ptr_array_add (vl->root->children, o);
+                  assign_ids (vl, o);
+                  leaves = g_list_append (leaves, o);
+                }
+
+              owners[i] = o;
+              prev      = o;
+            }
+        }
+    }
+
+  /*  rebuild the objects whose sub-paths changed  */
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      GimpMatrix3      wm, inv;
+      gboolean         identity;
+      gboolean         same = TRUE;
+      GimpStroke      *t    = gimp_path_stroke_get_next (o->path, NULL);
+
+      chopgimp_vobject_get_world_matrix (o, &wm);
+      identity = gimp_matrix3_is_identity (&wm);
+
+      for (guint i = 0; i < n && same; i++)
+        if (owners[i] == o)
+          {
+            if (! t || ! stroke_equal (strokes->pdata[i], t, identity ? NULL : &wm))
+              same = FALSE;
+            else
+              t = gimp_path_stroke_get_next (o->path, t);
+          }
+
+      if (same && ! t)
+        continue;
+
+      inv = wm;
+      gimp_matrix3_invert (&inv);
+
+      gimp_path_freeze (o->path);
+      path_clear (o->path);
+
+      for (guint i = 0; i < n; i++)
+        if (owners[i] == o)
+          {
+            GimpStroke *d = gimp_stroke_duplicate (strokes->pdata[i]);
+
+            if (! identity)
+              gimp_stroke_transform (d, &inv, NULL);
+
+            gimp_path_stroke_add (o->path, d);
+            g_object_unref (d);
+          }
+
+      gimp_path_thaw (o->path);
+      vobj_invalidate (o);
+    }
+
+  /*  the new map  */
+  g_hash_table_remove_all (vl->stroke_map);
+  layout = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  for (guint i = 0; i < n; i++)
+    {
+      g_hash_table_insert (vl->stroke_map,
+                           GINT_TO_POINTER (gimp_stroke_get_id (strokes->pdata[i])),
+                           GUINT_TO_POINTER (owners[i]->id));
+      g_array_append_val (layout, owners[i]->id);
+    }
+
+  vl->mapped = n;
+  vlayer_push_layout (vl, layout);
+
+  g_free (owners);
+  g_ptr_array_free (strokes, TRUE);
+  g_list_free (leaves);
+}
+
+static void
+vlayer_style_from_options (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer  *vl    = layer->vobjects;
+  gchar           *sig   = options_sig (layer->options);
+  ChopGimpVObject *first = first_leaf (vl->root);
+
+  if (g_strcmp0 (sig, vl->opt_sig) && first)
+    {
+      chopgimp_vstyle_from_options (&first->style, layer->options);
+      vobj_invalidate (first);
+    }
+
+  g_free (vl->opt_sig);
+  vl->opt_sig = sig;
+}
+
+gboolean
+chopgimp_vlayer_options_notify (GimpVectorLayer *layer,
+                                const gchar     *property)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+
+  if (! vl || ! layer->options)
+    return FALSE;
+
+  if (vl->syncing)
+    return TRUE;
+
+  if (! strcmp (property, "path") || ! strcmp (property, "path-tattoo"))
+    {
+      vlayer_pull_legacy_path (layer);
+    }
+  else if (! strcmp (property, "enable-fill")    ||
+           ! strcmp (property, "enable-stroke")  ||
+           ! strcmp (property, "fill-options")   ||
+           ! strcmp (property, "stroke-options") ||
+           ! strcmp (property, "fill-style")     ||
+           ! strcmp (property, "fill-color")     ||
+           ! strcmp (property, "fill-pattern"))
+    {
+      vlayer_style_from_options (layer);
+    }
+  else
+    {
+      return FALSE;
+    }
+
+  g_signal_emit_by_name (layer, "objects-changed", NULL);
+
+  return FALSE;
+}
+
+
+/*  ─── changes ───────────────────────────────────────────────────────── */
+
+static void
+vlayer_prune_selection (ChopGimpVLayer *vl,
+                        gboolean       *changed)
+{
+  for (guint i = 0; i < vl->selection->len; )
+    {
+      guint id = g_array_index (vl->selection, guint, i);
+
+      if (! g_hash_table_contains (vl->by_id, GUINT_TO_POINTER (id)) || id == 0)
+        {
+          g_array_remove_index (vl->selection, i);
+          *changed = TRUE;
+        }
+      else
+        {
+          i++;
+        }
+    }
+
+  if (vl->entered)
+    {
+      ChopGimpVObject *o = g_hash_table_lookup (vl->by_id, GUINT_TO_POINTER (vl->entered));
+
+      if (! o || o->kind != CHOPGIMP_VOBJECT_GROUP)
+        {
+          vl->entered = 0;
+          *changed    = TRUE;
+        }
+    }
+}
+
+/*  after a change of the objects: legacy view, rendering, signals  */
+static void
+vlayer_commit (GimpVectorLayer     *layer,
+               guint                what,
+               const GeglRectangle *dirty)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+  gboolean        sel_changed = FALSE;
+
+  if (! vl)
+    return;
+
+  if (vl->freeze > 0)
+    {
+      if (! dirty || vl->pending_all)
+        vl->pending_all = TRUE;
+      else if (vl->pending)
+        gegl_rectangle_bounding_box (&vl->pending_rect, &vl->pending_rect, dirty);
+      else
+        vl->pending_rect = *dirty;
+
+      vl->pending |= what;
+      return;
+    }
+
+  if (what & CHANGE_STRUCTURE)
+    {
+      vlayer_reindex (vl);
+      vlayer_prune_selection (vl, &sel_changed);
+    }
+
+  vlayer_write_legacy (layer,
+                       (what & (CHANGE_GEOMETRY | CHANGE_STRUCTURE)) != 0,
+                       TRUE);
+
+  if (layer_usable (layer))
+    {
+      if (vl->legacy)
+        gimp_vector_layer_refresh (layer);
+      else
+        vlayer_render_region (layer, dirty);
+    }
+
+  g_signal_emit_by_name (layer, "objects-changed", dirty);
+
+  if (sel_changed)
+    g_signal_emit_by_name (layer, "object-selection-changed");
+}
+
+/*  starts a change: TRUE when @layer can be changed  */
+static gboolean
+vlayer_begin (GimpVectorLayer *layer,
+              const gchar     *undo_desc,
+              gboolean         push_undo)
+{
+  ChopGimpVLayer *vl;
+
+  if (! layer_usable (layer) || ! (vl = vlayer_ensure (layer)))
+    return FALSE;
+
+  if (push_undo)
+    chopgimp_vlayer_push_undo (layer, undo_desc);
+
+  vl->legacy = FALSE;
+
+  return TRUE;
+}
+
+static void
+dirty_of (GimpVectorLayer *layer,
+          ChopGimpVObject *o,
+          GeglRectangle   *r,
+          gboolean        *any)
+{
+  GList *leaves = (o->kind == CHOPGIMP_VOBJECT_PATH) ? g_list_prepend (NULL, o)
+                                                      : leaves_of (o);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      GeglRectangle ib;
+
+      if (leaf_ibounds (layer, l->data, &ib))
+        {
+          if (*any)
+            gegl_rectangle_bounding_box (r, r, &ib);
+          else
+            *r = ib;
+
+          *any = TRUE;
+        }
+    }
+
+  g_list_free (leaves);
+}
+
+void
+chopgimp_vlayer_freeze (GimpVectorLayer *layer)
+{
+  if (layer_usable (layer) && vlayer_ensure (layer))
+    layer->vobjects->freeze++;
+}
+
+void
+chopgimp_vlayer_thaw (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+
+  if (! vl || vl->freeze == 0)
+    return;
+
+  if (--vl->freeze == 0 && vl->pending)
+    {
+      guint         what = vl->pending;
+      GeglRectangle r    = vl->pending_rect;
+      gboolean      all  = vl->pending_all;
+
+      vl->pending     = 0;
+      vl->pending_all = FALSE;
+
+      vlayer_commit (layer, what, all ? NULL : &r);
+    }
+}
+
+void
+chopgimp_vlayer_object_changed (GimpVectorLayer *layer,
+                                ChopGimpVObject *object)
+{
+  ChopGimpVLayer *vl;
+
+  if (! layer_usable (layer) || ! (vl = vlayer_ensure (layer)))
+    return;
+
+  vl->legacy = FALSE;
+  vobj_invalidate (object ? object : vl->root);
+
+  vlayer_commit (layer, CHANGE_ALL, NULL);
+}
+
+
+/*  ─── undo ──────────────────────────────────────────────────────────── */
+
+#define CHOPGIMP_TYPE_VOBJECTS_UNDO (chopgimp_vobjects_undo_get_type ())
+#define CHOPGIMP_VOBJECTS_UNDO(obj) (G_TYPE_CHECK_INSTANCE_CAST ((obj), CHOPGIMP_TYPE_VOBJECTS_UNDO, ChopGimpVObjectsUndo))
+
+typedef struct
+{
+  GimpItemUndo            parent_instance;
+
+  gchar                  *state;
+  GimpVectorLayerOptions *options;
+} ChopGimpVObjectsUndo;
+
+typedef struct
+{
+  GimpItemUndoClass  parent_class;
+} ChopGimpVObjectsUndoClass;
+
+GType chopgimp_vobjects_undo_get_type (void);
+
+G_DEFINE_TYPE (ChopGimpVObjectsUndo, chopgimp_vobjects_undo, GIMP_TYPE_ITEM_UNDO)
+
+static void
+chopgimp_vobjects_undo_constructed (GObject *object)
+{
+  ChopGimpVObjectsUndo *undo = CHOPGIMP_VOBJECTS_UNDO (object);
+  GimpVectorLayer      *layer;
+
+  G_OBJECT_CLASS (chopgimp_vobjects_undo_parent_class)->constructed (object);
+
+  layer = GIMP_VECTOR_LAYER (GIMP_ITEM_UNDO (undo)->item);
+
+  if (layer->vobjects)
+    undo->state = vlayer_serialize (layer, TRUE);
+
+  if (layer->options)
+    undo->options = gimp_config_duplicate (GIMP_CONFIG (layer->options));
+}
+
+/*  the state @xml replaces the objects of @layer  */
+static void
+vlayer_restore (GimpVectorLayer *layer,
+                const gchar     *xml)
+{
+  ChopGimpVLayer *old = layer->vobjects;
+  ChopGimpVLayer *vl;
+  gboolean        has_legacy;
+
+  vl = xml ? vlayer_parse (gimp_item_get_image (GIMP_ITEM (layer)), xml,
+                           strlen (xml), &has_legacy)
+           : NULL;
+
+  if (xml && ! vl)
+    return;
+
+  if (vl && old)
+    {
+      vl->freeze = old->freeze;
+
+      /*  the legacy path keeps its map: it is rewritten below anyway  */
+      g_ptr_array_extend_and_steal (vl->layouts, old->layouts);
+      old->layouts = g_ptr_array_new_with_free_func ((GDestroyNotify) g_array_unref);
+    }
+
+  layer->vobjects = vl;
+  chopgimp_vlayer_free (old);
+}
+
+static void
+chopgimp_vobjects_undo_pop (GimpUndo            *undo,
+                            GimpUndoMode         undo_mode,
+                            GimpUndoAccumulator *accum)
+{
+  ChopGimpVObjectsUndo   *vundo = CHOPGIMP_VOBJECTS_UNDO (undo);
+  GimpVectorLayer        *layer = GIMP_VECTOR_LAYER (GIMP_ITEM_UNDO (undo)->item);
+  gchar                  *state;
+  GimpVectorLayerOptions *options = NULL;
+
+  GIMP_UNDO_CLASS (chopgimp_vobjects_undo_parent_class)->pop (undo, undo_mode, accum);
+
+  state = layer->vobjects ? vlayer_serialize (layer, TRUE) : NULL;
+
+  if (layer->options)
+    options = gimp_config_duplicate (GIMP_CONFIG (layer->options));
+
+  vlayer_restore (layer, vundo->state);
+
+  /*  the legacy fill / stroke as they were (exactly, for the legacy
+   *  renderer); the legacy path is rewritten from the objects
+   */
+  if (layer->options && vundo->options)
+    {
+      if (layer->vobjects)
+        layer->vobjects->syncing++;
+
+      gimp_config_sync (G_OBJECT (vundo->options), G_OBJECT (layer->options), 0);
+
+      if (layer->vobjects)
+        layer->vobjects->syncing--;
+    }
+
+  g_free (vundo->state);
+  vundo->state = state;
+  g_clear_object (&vundo->options);
+  vundo->options = options;
+
+  if (layer->vobjects)
+    {
+      ChopGimpVLayer *vl = layer->vobjects;
+
+      vlayer_write_legacy (layer, TRUE, FALSE);
+
+      g_free (vl->opt_sig);
+      vl->opt_sig = layer->options ? options_sig (layer->options) : NULL;
+
+      if (layer_usable (layer))
+        {
+          if (vl->legacy)
+            gimp_vector_layer_refresh (layer);
+          else
+            vlayer_render_region (layer, NULL);
+        }
+    }
+  else if (layer_usable (layer))
+    {
+      gimp_vector_layer_refresh (layer);
+    }
+
+  g_signal_emit_by_name (layer, "objects-changed", NULL);
+  g_signal_emit_by_name (layer, "object-selection-changed");
+}
+
+static void
+chopgimp_vobjects_undo_free (GimpUndo     *undo,
+                             GimpUndoMode  undo_mode)
+{
+  ChopGimpVObjectsUndo *vundo = CHOPGIMP_VOBJECTS_UNDO (undo);
+
+  g_clear_pointer (&vundo->state, g_free);
+  g_clear_object (&vundo->options);
+
+  GIMP_UNDO_CLASS (chopgimp_vobjects_undo_parent_class)->free (undo, undo_mode);
+}
+
+static gint64
+chopgimp_vobjects_undo_get_memsize (GimpObject *object,
+                                    gint64     *gui_size)
+{
+  ChopGimpVObjectsUndo *vundo = CHOPGIMP_VOBJECTS_UNDO (object);
+  gint64                size  = vundo->state ? strlen (vundo->state) + 1 : 0;
+
+  size += gimp_object_get_memsize (GIMP_OBJECT (vundo->options), NULL);
+
+  return size + GIMP_OBJECT_CLASS (chopgimp_vobjects_undo_parent_class)->get_memsize (object,
+                                                                                    gui_size);
+}
+
+static void
+chopgimp_vobjects_undo_class_init (ChopGimpVObjectsUndoClass *klass)
+{
+  GObjectClass    *object_class      = G_OBJECT_CLASS (klass);
+  GimpObjectClass *gimp_object_class = GIMP_OBJECT_CLASS (klass);
+  GimpUndoClass   *undo_class        = GIMP_UNDO_CLASS (klass);
+
+  object_class->constructed      = chopgimp_vobjects_undo_constructed;
+  gimp_object_class->get_memsize = chopgimp_vobjects_undo_get_memsize;
+  undo_class->pop                = chopgimp_vobjects_undo_pop;
+  undo_class->free               = chopgimp_vobjects_undo_free;
+}
+
+static void
+chopgimp_vobjects_undo_init (ChopGimpVObjectsUndo *undo)
+{
+}
+
+void
+chopgimp_vlayer_push_undo (GimpVectorLayer *layer,
+                           const gchar     *undo_desc)
+{
+  GimpImage *image;
+
+  g_return_if_fail (GIMP_IS_VECTOR_LAYER (layer));
+
+  if (! gimp_item_is_attached (GIMP_ITEM (layer)) ||
+      ! layer_usable (layer) || ! vlayer_ensure (layer))
+    return;
+
+  image = gimp_item_get_image (GIMP_ITEM (layer));
+
+  gimp_image_undo_push (image, CHOPGIMP_TYPE_VOBJECTS_UNDO,
+                        GIMP_UNDO_CHOPGIMP_VOBJECTS,
+                        undo_desc ? undo_desc : "Modifier les objets",
+                        GIMP_DIRTY_ITEM | GIMP_DIRTY_DRAWABLE,
+                        "item", layer,
+                        NULL);
+}
+
+
+/*  ─── structure ─────────────────────────────────────────────────────── */
+
+static ChopGimpVObject *
+group_or_root (ChopGimpVLayer  *vl,
+               ChopGimpVObject *parent)
+{
+  if (! parent || parent->kind != CHOPGIMP_VOBJECT_GROUP)
+    return vl->root;
+
+  return parent;
+}
+
+static void
+insert_child (ChopGimpVObject *parent,
+              ChopGimpVObject *o,
+              gint             position)
+{
+  if (position < 0 || position > (gint) parent->children->len)
+    position = parent->children->len;
+
+  o->parent = parent;
+  g_ptr_array_insert (parent->children, position, o);
+}
+
+/*  detaches @o from its parent and returns the reference it held  */
+static ChopGimpVObject *
+detach_child (ChopGimpVObject *o)
+{
+  ChopGimpVObject *parent = o->parent;
+  guint            i;
+
+  if (parent && g_ptr_array_find (parent->children, o, &i))
+    {
+      ChopGimpVObject *self = g_ptr_array_steal_index (parent->children, i);
+
+      self->parent = NULL;
+      return self;
+    }
+
+  return chopgimp_vobject_ref (o);
+}
+
+void
+chopgimp_vlayer_insert (GimpVectorLayer *layer,
+                        ChopGimpVObject *object,
+                        ChopGimpVObject *parent,
+                        gint             position,
+                        gboolean         push_undo)
+{
+  ChopGimpVLayer *vl;
+
+  g_return_if_fail (object != NULL && object->parent == NULL);
+
+  if (! vlayer_begin (layer, "Ajouter un objet", push_undo))
+    return;
+
+  vl = layer->vobjects;
+
+  insert_child (group_or_root (vl, parent), chopgimp_vobject_ref (object), position);
+  assign_ids (vl, object);
+  vobj_invalidate (object);
+
+  vlayer_commit (layer, CHANGE_STRUCTURE, NULL);
+}
+
+void
+chopgimp_vlayer_remove (GimpVectorLayer *layer,
+                        guint            id,
+                        gboolean         push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+
+  if (! o || id == 0)
+    return;
+
+  if (! vlayer_begin (layer, "Supprimer un objet", push_undo))
+    return;
+
+  chopgimp_vobject_unref (detach_child (o));
+
+  vlayer_commit (layer, CHANGE_STRUCTURE, NULL);
+}
+
+void
+chopgimp_vlayer_reorder (GimpVectorLayer *layer,
+                         guint            id,
+                         ChopGimpVObject *new_parent,
+                         gint             position,
+                         gboolean         push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+  ChopGimpVObject *parent;
+  GimpMatrix3      old_world, parent_world;
+
+  if (! o || id == 0)
+    return;
+
+  parent = group_or_root (layer->vobjects, new_parent);
+
+  if (parent == o || chopgimp_vobject_is_ancestor (o, parent))
+    return;
+
+  if (! vlayer_begin (layer, "Réorganiser les objets", push_undo))
+    return;
+
+  /*  the object keeps its place in the image  */
+  chopgimp_vobject_get_world_matrix (o, &old_world);
+  chopgimp_vobject_get_world_matrix (parent, &parent_world);
+
+  o = detach_child (o);
+  insert_child (parent, o, position);
+
+  gimp_matrix3_invert (&parent_world);
+  gimp_matrix3_mult (&parent_world, &old_world);
+  o->transform = old_world;
+
+  vobj_invalidate (o);
+  vlayer_commit (layer, CHANGE_STRUCTURE, NULL);
+}
+
+static gint
+compare_index (gconstpointer a,
+               gconstpointer b)
+{
+  return (chopgimp_vobject_get_index (*(ChopGimpVObject **) a) -
+          chopgimp_vobject_get_index (*(ChopGimpVObject **) b));
+}
+
+ChopGimpVObject *
+chopgimp_vlayer_group (GimpVectorLayer *layer,
+                       const guint     *ids,
+                       gint             n_ids,
+                       const gchar     *name,
+                       gboolean         push_undo)
+{
+  ChopGimpVObject *parent = NULL;
+  ChopGimpVObject *group;
+  GPtrArray       *objs;
+  gint             top = -1;
+
+  if (n_ids < 1 || ! chopgimp_vlayer_get_root (layer))
+    return NULL;
+
+  objs = g_ptr_array_new ();
+
+  for (gint i = 0; i < n_ids; i++)
+    {
+      ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, ids[i]);
+
+      if (! o || ids[i] == 0 || g_ptr_array_find (objs, o, NULL))
+        continue;
+
+      if (parent && o->parent != parent)
+        {
+          g_ptr_array_free (objs, TRUE);
+          return NULL;
+        }
+
+      parent = o->parent;
+      g_ptr_array_add (objs, o);
+    }
+
+  if (objs->len == 0 || ! vlayer_begin (layer, "Grouper", push_undo))
+    {
+      g_ptr_array_free (objs, TRUE);
+      return NULL;
+    }
+
+  g_ptr_array_sort (objs, compare_index);
+  top = chopgimp_vobject_get_index (objs->pdata[objs->len - 1]) - (gint) objs->len + 1;
+
+  group = chopgimp_vobject_new_group (name);
+
+  for (guint i = 0; i < objs->len; i++)
+    insert_child (group, detach_child (objs->pdata[i]), -1);
+
+  insert_child (parent, group, top);
+  assign_ids (layer->vobjects, group);
+
+  g_ptr_array_free (objs, TRUE);
+
+  vobj_invalidate (group);
+  vlayer_commit (layer, CHANGE_STRUCTURE, NULL);
+
+  return group;
+}
+
+void
+chopgimp_vlayer_ungroup (GimpVectorLayer *layer,
+                         guint            group_id,
+                         gboolean         push_undo)
+{
+  ChopGimpVObject *group = chopgimp_vlayer_get_object (layer, group_id);
+  ChopGimpVObject *parent;
+  gint             index;
+
+  if (! group || group_id == 0 || group->kind != CHOPGIMP_VOBJECT_GROUP)
+    return;
+
+  if (! vlayer_begin (layer, "Dissocier le groupe", push_undo))
+    return;
+
+  parent = group->parent;
+  index  = chopgimp_vobject_get_index (group);
+  group  = detach_child (group);
+
+  while (group->children->len > 0)
+    {
+      ChopGimpVObject *c = g_ptr_array_steal_index (group->children, 0);
+      GimpMatrix3      t = c->transform;
+
+      gimp_matrix3_mult (&group->transform, &t);
+      c->transform = t;
+      c->opacity  *= group->opacity;
+      c->visible   = c->visible && group->visible;
+      c->locked    = c->locked || group->locked;
+
+      if (is_normal_mode (c->mode))
+        c->mode = group->mode;
+
+      c->parent = NULL;
+      insert_child (parent, c, index++);
+      vobj_invalidate (c);
+    }
+
+  chopgimp_vobject_unref (group);
+
+  vlayer_commit (layer, CHANGE_STRUCTURE, NULL);
+}
+
+
+/*  ─── geometry ──────────────────────────────────────────────────────── */
+
+static void
+add_world_strokes (GimpVectorLayer *layer,
+                   ChopGimpVObject *o,
+                   GimpPath        *dest,
+                   gboolean         with_effects)
+{
+  GList *leaves = (o->kind == CHOPGIMP_VOBJECT_PATH) ? g_list_prepend (NULL, o)
+                                                      : leaves_of (o);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *leaf = l->data;
+      GimpPath        *src  = with_effects ? vobj_effective (layer, leaf) : leaf->path;
+      GimpMatrix3      wm;
+      GimpStroke      *s;
+
+      chopgimp_vobject_get_world_matrix (leaf, &wm);
+
+      for (s = gimp_path_stroke_get_next (src, NULL); s;
+           s = gimp_path_stroke_get_next (src, s))
+        {
+          GimpStroke *d = gimp_stroke_duplicate (s);
+
+          if (! gimp_matrix3_is_identity (&wm))
+            gimp_stroke_transform (d, &wm, NULL);
+
+          gimp_path_stroke_add (dest, d);
+          g_object_unref (d);
+        }
+    }
+
+  g_list_free (leaves);
+}
+
+GimpPath *
+chopgimp_vobject_get_world_path (GimpVectorLayer *layer,
+                                 ChopGimpVObject *object,
+                                 gboolean         with_effects)
+{
+  GimpPath *path;
+
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), NULL);
+  g_return_val_if_fail (object != NULL, NULL);
+
+  if (layer->vobjects)
+    vlayer_check_layer_lpe (layer);
+
+  path = gimp_path_new (gimp_item_get_image (GIMP_ITEM (layer)), object->name);
+
+  gimp_path_freeze (path);
+  add_world_strokes (layer, object, path, with_effects);
+  gimp_path_thaw (path);
+
+  return path;
+}
+
+static gboolean
+leaf_hit (GimpVectorLayer *layer,
+          ChopGimpVObject *o,
+          gdouble          x,
+          gdouble          y,
+          gdouble          tolerance)
+{
+  GimpPath       *path = vobj_effective (layer, o);
+  GimpMatrix3     wm;
+  cairo_matrix_t  cm;
+  cairo_t        *cr;
+  gboolean        hit  = FALSE;
+  gdouble         b[4];
+  gdouble         ux = x, uy = y;
+  gdouble         scale;
+
+  if (! leaf_bounds (layer, o, TRUE, b) ||
+      x < b[0] - tolerance || x > b[2] + tolerance ||
+      y < b[1] - tolerance || y > b[3] + tolerance)
+    return FALSE;
+
+  chopgimp_vobject_get_world_matrix (o, &wm);
+  matrix_to_cairo (&wm, &cm);
+  scale = MAX (matrix_scale (&wm), 1e-6);
+
+  cr = measure_cr ();
+  cairo_set_matrix (cr, &cm);
+  append_path (cr, path);
+  cairo_device_to_user (cr, &ux, &uy);
+
+  if (o->style.fill.type != CHOPGIMP_PAINT_NONE)
+    {
+      cairo_set_fill_rule (cr, o->style.fill_nonzero ? CAIRO_FILL_RULE_WINDING
+                                                     : CAIRO_FILL_RULE_EVEN_ODD);
+      hit = cairo_in_fill (cr, ux, uy);
+    }
+
+  if (! hit)
+    {
+      gdouble w = style_has_stroke (&o->style) ? o->style.stroke_width : 0.0;
+
+      if (o->style.stroke_align != CHOPGIMP_STROKE_ALIGN_CENTER)
+        w *= 2.0;
+
+      setup_stroke (cr, &o->style, MAX (w, 0.0) + 2.0 * tolerance / scale);
+      cairo_set_dash (cr, NULL, 0, 0);
+      hit = cairo_in_stroke (cr, ux, uy);
+    }
+
+  cairo_destroy (cr);
+
+  return hit;
+}
+
+static ChopGimpVObject *
+hit_rec (GimpVectorLayer *layer,
+         ChopGimpVObject *o,
+         gdouble          x,
+         gdouble          y,
+         gdouble          tolerance)
+{
+  if (! o->visible || o->locked)
+    return NULL;
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    return leaf_hit (layer, o, x, y, tolerance) ? o : NULL;
+
+  for (gint i = (gint) o->children->len - 1; i >= 0; i--)
+    {
+      ChopGimpVObject *hit = hit_rec (layer, g_ptr_array_index (o->children, i),
+                                      x, y, tolerance);
+
+      if (hit)
+        return hit;
+    }
+
+  return NULL;
+}
+
+/*  the selectable object containing @o: the child of the entered group,
+ *  or the top-level one
+ */
+static ChopGimpVObject *
+selectable_of (ChopGimpVLayer  *vl,
+               ChopGimpVObject *o)
+{
+  ChopGimpVObject *entered = vl->entered ? g_hash_table_lookup (vl->by_id,
+                                                                GUINT_TO_POINTER (vl->entered))
+                                         : NULL;
+  ChopGimpVObject *context = (entered && chopgimp_vobject_is_ancestor (entered, o))
+                             ? entered : vl->root;
+
+  while (o->parent && o->parent != context)
+    o = o->parent;
+
+  return o;
+}
+
+ChopGimpVObject *
+chopgimp_vlayer_hit_test (GimpVectorLayer *layer,
+                          gdouble          x,
+                          gdouble          y,
+                          gdouble          tolerance,
+                          ChopGimpHitMode  mode)
+{
+  ChopGimpVObject *root = chopgimp_vlayer_get_root (layer);
+  ChopGimpVObject *hit;
+
+  if (! root)
+    return NULL;
+
+  vlayer_check_layer_lpe (layer);
+
+  hit = hit_rec (layer, root, x, y, MAX (tolerance, 0.0));
+
+  if (hit && mode == CHOPGIMP_HIT_SELECTABLE)
+    hit = selectable_of (layer->vobjects, hit);
+
+  return hit;
+}
+
+GList *
+chopgimp_vlayer_objects_in_rect (GimpVectorLayer *layer,
+                                 gdouble          x,
+                                 gdouble          y,
+                                 gdouble          width,
+                                 gdouble          height,
+                                 gboolean         touch)
+{
+  ChopGimpVObject *root = chopgimp_vlayer_get_root (layer);
+  ChopGimpVObject *context;
+  GList           *list = NULL;
+
+  if (! root)
+    return NULL;
+
+  vlayer_check_layer_lpe (layer);
+
+  context = layer->vobjects->entered
+            ? g_hash_table_lookup (layer->vobjects->by_id,
+                                   GUINT_TO_POINTER (layer->vobjects->entered))
+            : NULL;
+
+  if (! context)
+    context = root;
+
+  for (guint i = 0; i < context->children->len; i++)
+    {
+      ChopGimpVObject *o = g_ptr_array_index (context->children, i);
+      gdouble          b[4];
+
+      if (! chopgimp_vobject_is_visible (o) || chopgimp_vobject_is_locked (o) ||
+          ! object_bounds (layer, o, TRUE, TRUE, b))
+        continue;
+
+      if (touch ? (b[2] >= x && b[0] <= x + width && b[3] >= y && b[1] <= y + height)
+                : (b[0] >= x && b[2] <= x + width && b[1] >= y && b[3] <= y + height))
+        list = g_list_prepend (list, o);
+    }
+
+  return g_list_reverse (list);
+}
+
+void
+chopgimp_vlayer_set_path (GimpVectorLayer *layer,
+                          guint            id,
+                          GimpPath        *path,
+                          gboolean         push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+  GeglRectangle    r;
+  gboolean         any = FALSE;
+
+  if (! o || o->kind != CHOPGIMP_VOBJECT_PATH || ! GIMP_IS_PATH (path))
+    return;
+
+  if (! vlayer_begin (layer, "Modifier le tracé de l'objet", push_undo))
+    return;
+
+  dirty_of (layer, o, &r, &any);
+  gimp_path_copy_strokes (path, o->path);
+  vobj_invalidate (o);
+  dirty_of (layer, o, &r, &any);
+
+  vlayer_commit (layer, CHANGE_GEOMETRY, any ? &r : NULL);
+}
+
+/*  bakes the world transformation of a leaf into its path  */
+static void
+bake_leaf (ChopGimpVObject   *o,
+           const GimpMatrix3 *local)
+{
+  gdouble scale = matrix_scale (local);
+
+  path_transform (o->path, local);
+
+  if (scale > 0.0)
+    {
+      o->style.stroke_width *= scale;
+      o->style.dash_offset  *= scale;
+    }
+
+  gimp_matrix3_identity (&o->transform);
+}
+
+void
+chopgimp_vlayer_transform (GimpVectorLayer   *layer,
+                           const guint       *ids,
+                           gint               n_ids,
+                           const GimpMatrix3 *matrix,
+                           gboolean           bake,
+                           gboolean           push_undo)
+{
+  GPtrArray     *objs;
+  GeglRectangle  r;
+  gboolean       any = FALSE;
+
+  if (! matrix || ! chopgimp_vlayer_get_root (layer))
+    return;
+
+  objs = g_ptr_array_new ();
+
+  for (gint i = 0; i < n_ids; i++)
+    {
+      ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, ids[i]);
+      gboolean         skip = FALSE;
+
+      if (! o || ids[i] == 0)
+        continue;
+
+      /*  an object inside another transformed one moves with it  */
+      for (gint k = 0; k < n_ids; k++)
+        {
+          ChopGimpVObject *other = chopgimp_vlayer_get_object (layer, ids[k]);
+
+          if (other && other != o && chopgimp_vobject_is_ancestor (other, o))
+            skip = TRUE;
+        }
+
+      if (! skip && ! g_ptr_array_find (objs, o, NULL))
+        g_ptr_array_add (objs, o);
+    }
+
+  if (objs->len == 0 || ! vlayer_begin (layer, "Transformer les objets", push_undo))
+    {
+      g_ptr_array_free (objs, TRUE);
+      return;
+    }
+
+  for (guint i = 0; i < objs->len; i++)
+    {
+      ChopGimpVObject *o = objs->pdata[i];
+      GimpMatrix3      pw, pwi, t;
+
+      dirty_of (layer, o, &r, &any);
+
+      /*  T' = PW⁻¹ · M · PW · T  */
+      if (o->parent)
+        chopgimp_vobject_get_world_matrix (o->parent, &pw);
+      else
+        gimp_matrix3_identity (&pw);
+
+      pwi = pw;
+      gimp_matrix3_invert (&pwi);
+
+      t = o->transform;
+      gimp_matrix3_mult (&pw, &t);
+      gimp_matrix3_mult (matrix, &t);
+      gimp_matrix3_mult (&pwi, &t);
+
+      if (bake && o->kind == CHOPGIMP_VOBJECT_PATH)
+        bake_leaf (o, &t);
+      else
+        o->transform = t;
+
+      vobj_invalidate (o);
+      dirty_of (layer, o, &r, &any);
+    }
+
+  g_ptr_array_free (objs, TRUE);
+
+  vlayer_commit (layer, CHANGE_GEOMETRY, any ? &r : NULL);
+}
+
+void
+chopgimp_vlayer_translate (GimpVectorLayer *layer,
+                           const guint     *ids,
+                           gint             n_ids,
+                           gdouble          dx,
+                           gdouble          dy,
+                           gboolean         push_undo)
+{
+  GimpMatrix3 m;
+
+  gimp_matrix3_identity (&m);
+  gimp_matrix3_translate (&m, dx, dy);
+
+  chopgimp_vlayer_transform (layer, ids, n_ids, &m, FALSE, push_undo);
+}
+
+
+/*  ─── style and properties ──────────────────────────────────────────── */
+
+void
+chopgimp_vlayer_set_style (GimpVectorLayer      *layer,
+                           guint                 id,
+                           const ChopGimpVStyle *style,
+                           gboolean              push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+  GList           *leaves;
+  GeglRectangle    r;
+  gboolean         any = FALSE;
+
+  if (! o || ! style)
+    return;
+
+  if (! vlayer_begin (layer, "Modifier le style de l'objet", push_undo))
+    return;
+
+  leaves = (o->kind == CHOPGIMP_VOBJECT_PATH) ? g_list_prepend (NULL, o)
+                                               : leaves_of (o);
+
+  dirty_of (layer, o, &r, &any);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *leaf = l->data;
+
+      chopgimp_vstyle_copy (&leaf->style, style);
+      vobj_invalidate (leaf);
+    }
+
+  dirty_of (layer, o, &r, &any);
+  g_list_free (leaves);
+
+  vlayer_commit (layer, CHANGE_STYLE, any ? &r : NULL);
+}
+
+void
+chopgimp_vlayer_set_props (GimpVectorLayer *layer,
+                           guint            id,
+                           const gchar     *name,
+                           gdouble          opacity,
+                           gint             mode,
+                           gint             visible,
+                           gint             locked,
+                           gboolean         push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+  GeglRectangle    r;
+  gboolean         any = FALSE;
+  guint            what = CHANGE_STYLE;
+
+  if (! o || id == 0)
+    return;
+
+  if (! vlayer_begin (layer, "Modifier l'objet", push_undo))
+    return;
+
+  dirty_of (layer, o, &r, &any);
+
+  if (name)
+    {
+      g_free (o->name);
+      o->name = g_strdup (name);
+    }
+
+  if (opacity >= 0.0)
+    o->opacity = CLAMP (opacity, 0.0, 1.0);
+
+  if (mode >= 0)
+    o->mode = mode;
+
+  if (visible >= 0 && (visible != 0) != o->visible)
+    {
+      o->visible = visible != 0;
+      what      |= CHANGE_GEOMETRY;   /* the layer bounds may change */
+    }
+
+  if (locked >= 0)
+    o->locked = locked != 0;
+
+  vlayer_commit (layer, what, any ? &r : NULL);
+}
+
+void
+chopgimp_vlayer_set_lpe (GimpVectorLayer *layer,
+                         guint            id,
+                         const gchar     *spec,
+                         gboolean         push_undo)
+{
+  ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, id);
+
+  if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+    return;
+
+  if (! vlayer_begin (layer, "Effets de tracé de l'objet", push_undo))
+    return;
+
+  g_free (o->lpe);
+  o->lpe = (spec && *spec) ? g_strdup (spec) : NULL;
+  vobj_invalidate (o);
+
+  vlayer_commit (layer, CHANGE_STYLE, NULL);
+}
+
+
+/*  ─── selection ─────────────────────────────────────────────────────── */
+
+const guint *
+chopgimp_vlayer_get_selection (GimpVectorLayer *layer,
+                               gint            *n_ids)
+{
+  ChopGimpVLayer *vl = layer_usable (layer) ? vlayer_ensure (layer) : NULL;
+
+  if (n_ids)
+    *n_ids = vl ? vl->selection->len : 0;
+
+  return vl ? (const guint *) vl->selection->data : NULL;
+}
+
+GList *
+chopgimp_vlayer_get_selected_objects (GimpVectorLayer *layer)
+{
+  gint         n;
+  const guint *ids  = chopgimp_vlayer_get_selection (layer, &n);
+  GList       *list = NULL;
+
+  for (gint i = 0; i < n; i++)
+    {
+      ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, ids[i]);
+
+      if (o)
+        list = g_list_prepend (list, o);
+    }
+
+  return g_list_reverse (list);
+}
+
+void
+chopgimp_vlayer_set_selection (GimpVectorLayer *layer,
+                               const guint     *ids,
+                               gint             n_ids)
+{
+  ChopGimpVLayer *vl = layer_usable (layer) ? vlayer_ensure (layer) : NULL;
+
+  if (! vl)
+    return;
+
+  g_array_set_size (vl->selection, 0);
+
+  for (gint i = 0; i < n_ids; i++)
+    if (ids[i] != 0 && g_hash_table_contains (vl->by_id, GUINT_TO_POINTER (ids[i])) &&
+        ! chopgimp_vlayer_is_selected (layer, ids[i]))
+      g_array_append_val (vl->selection, ids[i]);
+
+  g_signal_emit_by_name (layer, "object-selection-changed");
+}
+
+gboolean
+chopgimp_vlayer_is_selected (GimpVectorLayer *layer,
+                             guint            id)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+
+  if (! vl)
+    return FALSE;
+
+  for (guint i = 0; i < vl->selection->len; i++)
+    if (g_array_index (vl->selection, guint, i) == id)
+      return TRUE;
+
+  return FALSE;
+}
+
+void
+chopgimp_vlayer_select (GimpVectorLayer *layer,
+                        guint            id,
+                        gboolean         add)
+{
+  ChopGimpVLayer *vl = layer_usable (layer) ? vlayer_ensure (layer) : NULL;
+
+  if (! vl || id == 0 || ! g_hash_table_contains (vl->by_id, GUINT_TO_POINTER (id)))
+    return;
+
+  if (! add)
+    g_array_set_size (vl->selection, 0);
+
+  if (! chopgimp_vlayer_is_selected (layer, id))
+    g_array_append_val (vl->selection, id);
+
+  g_signal_emit_by_name (layer, "object-selection-changed");
+}
+
+void
+chopgimp_vlayer_deselect (GimpVectorLayer *layer,
+                          guint            id)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+
+  if (! vl)
+    return;
+
+  for (guint i = 0; i < vl->selection->len; i++)
+    if (g_array_index (vl->selection, guint, i) == id)
+      {
+        g_array_remove_index (vl->selection, i);
+        g_signal_emit_by_name (layer, "object-selection-changed");
+        return;
+      }
+}
+
+guint
+chopgimp_vlayer_get_entered_group (GimpVectorLayer *layer)
+{
+  return layer->vobjects ? layer->vobjects->entered : 0;
+}
+
+void
+chopgimp_vlayer_enter_group (GimpVectorLayer *layer,
+                             guint            group_id)
+{
+  ChopGimpVLayer  *vl = layer_usable (layer) ? vlayer_ensure (layer) : NULL;
+  ChopGimpVObject *o;
+
+  if (! vl)
+    return;
+
+  o = group_id ? g_hash_table_lookup (vl->by_id, GUINT_TO_POINTER (group_id)) : NULL;
+
+  vl->entered = (o && o->kind == CHOPGIMP_VOBJECT_GROUP) ? group_id : 0;
+
+  g_signal_emit_by_name (layer, "object-selection-changed");
+}
+
+
+/*  ─── commands ──────────────────────────────────────────────────────── */
+
+static gboolean
+layer_mode_is_normal (GimpLayer *layer)
+{
+  return is_normal_mode (gimp_layer_get_mode (layer));
+}
+
+/*  removes a vector layer and its path (when no other layer uses it)  */
+static void
+remove_vector_layer (GimpImage       *image,
+                     GimpVectorLayer *layer)
+{
+  GimpPath *path = layer->options && layer->options->path
+                   ? g_object_ref (layer->options->path) : NULL;
+
+  gimp_image_remove_layer (image, GIMP_LAYER (layer), TRUE, NULL);
+
+  if (path)
+    {
+      if (gimp_item_is_attached (GIMP_ITEM (path)) &&
+          ! gimp_path_attached_to_vector_layer (path, image))
+        gimp_image_remove_path (image, path, TRUE, NULL);
+
+      g_object_unref (path);
+    }
+}
+
+GimpVectorLayer *
+chopgimp_vlayer_merge_layers (GimpImage   *image,
+                              GList       *layers,
+                              GimpContext *context)
+{
+  GList           *all;
+  GList           *order = NULL;
+  GList           *l;
+  GimpVectorLayer *target;
+  ChopGimpVObject *troot;
+  gint             pos   = 0;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  if (! chopgimp_vobjects_enabled ())
+    return NULL;
+
+  /*  the chosen vector layers, bottom → top  */
+  all = gimp_image_get_layer_list (image);
+
+  for (l = all; l; l = l->next)
+    if (g_list_find (layers, l->data) &&
+        GIMP_IS_VECTOR_LAYER (l->data) && layer_usable (l->data))
+      order = g_list_prepend (order, l->data);
+
+  g_list_free (all);
+
+  if (g_list_length (order) < 2)
+    {
+      g_list_free (order);
+      return NULL;
+    }
+
+  target = g_list_last (order)->data;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_IMAGE_LAYERS_MERGE,
+                               "Fusionner en un calque vectoriel");
+
+  troot = chopgimp_vlayer_get_root (target);
+
+  if (! troot)
+    {
+      gimp_image_undo_group_end (image);
+      g_list_free (order);
+      return NULL;
+    }
+
+  chopgimp_vlayer_push_undo (target, "Fusionner en un calque vectoriel");
+  target->vobjects->legacy = FALSE;
+  chopgimp_vlayer_freeze (target);
+
+  /*  the topmost layer's own opacity and mode go to its objects  */
+  if (gimp_layer_get_opacity (GIMP_LAYER (target)) < 1.0 ||
+      ! layer_mode_is_normal (GIMP_LAYER (target)))
+    {
+      ChopGimpVObject *g = chopgimp_vobject_new_group (gimp_object_get_name (target));
+
+      while (troot->children->len > 0)
+        insert_child (g, g_ptr_array_steal_index (troot->children, 0), -1);
+
+      g->opacity = gimp_layer_get_opacity (GIMP_LAYER (target));
+      g->mode    = gimp_layer_get_mode (GIMP_LAYER (target));
+      insert_child (troot, g, -1);
+      assign_ids (target->vobjects, g);
+
+      gimp_layer_set_opacity (GIMP_LAYER (target), 1.0, TRUE);
+      gimp_layer_set_mode (GIMP_LAYER (target), GIMP_LAYER_MODE_NORMAL, TRUE);
+    }
+
+  for (l = order; l && l->data != target; l = l->next)
+    {
+      GimpVectorLayer *src   = l->data;
+      ChopGimpVObject *sroot = chopgimp_vlayer_get_root (src);
+      ChopGimpVObject *obj;
+      gdouble          opacity = gimp_layer_get_opacity (GIMP_LAYER (src));
+      GimpLayerMode    mode    = gimp_layer_get_mode (GIMP_LAYER (src));
+      gboolean         visible = gimp_item_get_visible (GIMP_ITEM (src));
+
+      if (! sroot)
+        continue;
+
+      if (sroot->children->len == 1)
+        {
+          obj = chopgimp_vobject_copy (g_ptr_array_index (sroot->children, 0), image);
+
+          if (obj->kind == CHOPGIMP_VOBJECT_PATH)
+            {
+              g_free (obj->name);
+              obj->name = g_strdup (gimp_object_get_name (src));
+            }
+
+          obj->opacity *= opacity;
+
+          if (! is_normal_mode (mode) && is_normal_mode (obj->mode))
+            obj->mode = mode;
+        }
+      else
+        {
+          obj = chopgimp_vobject_copy (sroot, image);
+          g_free (obj->name);
+          obj->name    = g_strdup (gimp_object_get_name (src));
+          obj->opacity = opacity;
+          obj->mode    = mode;
+          obj->id      = 0;
+        }
+
+      obj->visible = obj->visible && visible;
+
+      insert_child (troot, obj, pos++);
+      assign_ids (target->vobjects, obj);
+    }
+
+  vobj_invalidate (troot);
+  vlayer_commit (target, CHANGE_STRUCTURE, NULL);
+  chopgimp_vlayer_thaw (target);
+
+  for (l = order; l && l->data != target; l = l->next)
+    remove_vector_layer (image, l->data);
+
+  {
+    GList *sel = g_list_prepend (NULL, target);
+
+    gimp_image_set_selected_layers (image, sel);
+    g_list_free (sel);
+  }
+
+  gimp_image_undo_group_end (image);
+
+  g_list_free (order);
+
+  return target;
+}
+
+static void
+split_items (ChopGimpVObject  *root,
+             GPtrArray        *items)
+{
+  if (root->children->len == 1)
+    {
+      ChopGimpVObject *only = g_ptr_array_index (root->children, 0);
+
+      if (only->kind == CHOPGIMP_VOBJECT_GROUP && only->children->len >= 2)
+        {
+          for (guint i = 0; i < only->children->len; i++)
+            g_ptr_array_add (items, g_ptr_array_index (only->children, i));
+          return;
+        }
+    }
+
+  for (guint i = 0; i < root->children->len; i++)
+    g_ptr_array_add (items, g_ptr_array_index (root->children, i));
+}
+
+gboolean
+chopgimp_vlayer_can_split (GimpVectorLayer *layer)
+{
+  GPtrArray *items;
+  gboolean   ok;
+
+  if (! chopgimp_vobjects_enabled () || ! layer_usable (layer) ||
+      ! layer->vobjects || layer->vobjects->legacy)
+    return FALSE;
+
+  items = g_ptr_array_new ();
+  split_items (layer->vobjects->root, items);
+  ok = items->len >= 2;
+  g_ptr_array_free (items, TRUE);
+
+  return ok;
+}
+
+GList *
+chopgimp_vlayer_split_to_layers (GimpVectorLayer *layer,
+                                 GimpContext     *context)
+{
+  GimpImage *image;
+  GimpLayer *parent;
+  GPtrArray *items;
+  GList     *result = NULL;
+  gint       position;
+
+  if (! chopgimp_vlayer_can_split (layer))
+    return NULL;
+
+  image    = gimp_item_get_image (GIMP_ITEM (layer));
+  parent   = gimp_layer_get_parent (GIMP_LAYER (layer));
+  position = gimp_item_get_index (GIMP_ITEM (layer));
+  items    = g_ptr_array_new ();
+
+  vlayer_check_layer_lpe (layer);
+  split_items (layer->vobjects->root, items);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_LAYER_ADD,
+                               "Dissocier en calques");
+
+  for (guint i = 0; i < items->len; i++)
+    {
+      ChopGimpVObject *item = items->pdata[i];
+      const gchar     *name = (item->name && *item->name) ? item->name
+                                                          : gimp_object_get_name (layer);
+      GimpPath        *wpath;
+      GimpVectorLayer *nl;
+      ChopGimpVObject *copy;
+      ChopGimpVLayer  *vl;
+      GimpMatrix3      wm;
+      gdouble          opacity = 1.0;
+      gboolean         visible = TRUE;
+      ChopGimpVObject *p;
+
+      wpath = chopgimp_vobject_get_world_path (layer, item, FALSE);
+      gimp_object_set_name (GIMP_OBJECT (wpath), name);
+      gimp_image_add_path (image, wpath, GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+
+      /*  the image owns @wpath now (it was floating)  */
+      nl = gimp_vector_layer_new (image, wpath, context);
+
+      gimp_object_set_name (GIMP_OBJECT (nl), name);
+
+      /*  the object in its new layer, where it was in the image  */
+      copy = chopgimp_vobject_copy (item, image);
+      chopgimp_vobject_get_world_matrix (item, &wm);
+      copy->transform = wm;
+
+      for (p = item->parent; p; p = p->parent)
+        {
+          opacity *= p->opacity;
+          visible  = visible && p->visible;
+        }
+
+      copy->opacity *= opacity;
+
+      vl = vlayer_new ();
+      insert_child (vl->root, copy, -1);
+      assign_ids (vl, copy);
+      vl->legacy  = FALSE;
+      nl->vobjects = vl;
+
+      vlayer_write_legacy (nl, TRUE, TRUE);
+
+      gimp_layer_set_opacity (GIMP_LAYER (nl),
+                              gimp_layer_get_opacity (GIMP_LAYER (layer)), FALSE);
+      gimp_layer_set_mode (GIMP_LAYER (nl),
+                           gimp_layer_get_mode (GIMP_LAYER (layer)), FALSE);
+      gimp_item_set_visible (GIMP_ITEM (nl),
+                             visible && gimp_item_get_visible (GIMP_ITEM (layer)),
+                             FALSE);
+
+      gimp_image_add_layer (image, GIMP_LAYER (nl), parent, position, TRUE);
+
+      result = g_list_prepend (result, nl);
+    }
+
+  g_ptr_array_free (items, TRUE);
+
+  remove_vector_layer (image, layer);
+
+  gimp_image_set_selected_layers (image, result);
+
+  gimp_image_undo_group_end (image);
+
+  return result;
+}
+
+static void
+decompose_targets (GimpVectorLayer *layer,
+                   GPtrArray       *targets)
+{
+  ChopGimpVLayer *vl   = layer->vobjects;
+  GList          *from = NULL;
+
+  for (guint i = 0; i < vl->selection->len; i++)
+    {
+      ChopGimpVObject *o = g_hash_table_lookup (vl->by_id,
+                                                GUINT_TO_POINTER (g_array_index (vl->selection,
+                                                                                 guint, i)));
+      if (o)
+        from = g_list_concat (from, leaves_of (o));
+    }
+
+  if (! from)
+    from = leaves_of (vl->root);
+
+  for (GList *l = from; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      if (! o->locked && gimp_path_get_n_strokes (o->path) >= 2 &&
+          ! g_ptr_array_find (targets, o, NULL))
+        g_ptr_array_add (targets, o);
+    }
+
+  g_list_free (from);
+}
+
+gboolean
+chopgimp_vlayer_can_decompose (GimpVectorLayer *layer)
+{
+  GPtrArray *targets;
+  gboolean   ok;
+
+  if (! chopgimp_vobjects_enabled () || ! layer_usable (layer) || ! layer->options ||
+      ! layer->options->path)
+    return FALSE;
+
+  if (! layer->vobjects)
+    return gimp_path_get_n_strokes (layer->options->path) >= 2;
+
+  targets = g_ptr_array_new ();
+  decompose_targets (layer, targets);
+  ok = targets->len > 0;
+  g_ptr_array_free (targets, TRUE);
+
+  return ok;
+}
+
+gint
+chopgimp_vlayer_decompose (GimpVectorLayer *layer,
+                           gboolean         push_undo)
+{
+  GimpImage *image;
+  GPtrArray *targets;
+  GArray    *new_ids;
+  gint       n_new = 0;
+
+  if (! chopgimp_vlayer_get_root (layer))
+    return 0;
+
+  image   = gimp_item_get_image (GIMP_ITEM (layer));
+  targets = g_ptr_array_new ();
+  new_ids = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  decompose_targets (layer, targets);
+
+  for (guint t = 0; t < targets->len; t++)
+    {
+      ChopGimpVObject  *o = targets->pdata[t];
+      gint              n = 0;
+      gint             *owner = chopgimp_geom_stroke_islands (o->path, &n);
+      GPtrArray        *strokes = g_ptr_array_new ();
+      GimpStroke       *s;
+      ChopGimpVObject  *parent;
+      gint              index;
+      gint              k = 0;
+      gint              n_islands = 0;
+
+      for (s = gimp_path_stroke_get_next (o->path, NULL); s;
+           s = gimp_path_stroke_get_next (o->path, s))
+        g_ptr_array_add (strokes, s);
+
+      for (gint i = 0; i < n; i++)
+        if (owner[i] == i)
+          n_islands++;
+
+      if (n_islands < 2 || (guint) n != strokes->len)
+        {
+          g_free (owner);
+          g_ptr_array_free (strokes, TRUE);
+          continue;
+        }
+
+      if (n_new == 0 &&
+          ! vlayer_begin (layer, "Décomposer les sous-tracés en objets", push_undo))
+        {
+          g_free (owner);
+          g_ptr_array_free (strokes, TRUE);
+          break;
+        }
+
+      parent = o->parent;
+      index  = chopgimp_vobject_get_index (o);
+
+      for (gint i = 0; i < n; i++)
+        {
+          ChopGimpVObject *piece;
+          gchar           *name;
+
+          if (owner[i] != i)
+            continue;
+
+          name  = g_strdup_printf ("%s %d", (o->name && *o->name) ? o->name : "Objet",
+                                   ++k);
+          piece = chopgimp_vobject_new_path (image, NULL, name, &o->style);
+          g_free (name);
+
+          piece->transform = o->transform;
+          piece->opacity   = o->opacity;
+          piece->mode      = o->mode;
+          piece->visible   = o->visible;
+          piece->lpe       = g_strdup (o->lpe);
+
+          gimp_path_freeze (piece->path);
+
+          for (gint j = 0; j < n; j++)
+            if (owner[j] == i)
+              {
+                GimpStroke *d = gimp_stroke_duplicate (strokes->pdata[j]);
+
+                gimp_path_stroke_add (piece->path, d);
+                g_object_unref (d);
+              }
+
+          gimp_path_thaw (piece->path);
+
+          insert_child (parent, piece, index + k - 1);
+          assign_ids (layer->vobjects, piece);
+          g_array_append_val (new_ids, piece->id);
+          n_new++;
+        }
+
+      chopgimp_vobject_unref (detach_child (o));
+
+      g_free (owner);
+      g_ptr_array_free (strokes, TRUE);
+    }
+
+  g_ptr_array_free (targets, TRUE);
+
+  if (n_new > 0)
+    {
+      ChopGimpVLayer *vl = layer->vobjects;
+
+      vlayer_commit (layer, CHANGE_STRUCTURE, NULL);
+
+      g_array_set_size (vl->selection, 0);
+      g_array_append_vals (vl->selection, new_ids->data, new_ids->len);
+      g_signal_emit_by_name (layer, "object-selection-changed");
+    }
+
+  g_array_free (new_ids, TRUE);
+
+  return n_new;
+}
+
+
+/*  ─── gimpvectorlayer.c and XCF hooks ───────────────────────────────── */
+
+gint64
+chopgimp_vlayer_get_memsize (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl   = layer->vobjects;
+  gint64          size = 0;
+  GList          *leaves;
+
+  if (! vl)
+    return 0;
+
+  leaves = leaves_of (vl->root);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      size += sizeof (ChopGimpVObject) +
+              gimp_object_get_memsize (GIMP_OBJECT (o->path), NULL);
+
+      if (o->cache)
+        size += (gint64) cairo_image_surface_get_stride (o->cache) *
+                cairo_image_surface_get_height (o->cache);
+    }
+
+  g_list_free (leaves);
+
+  return size;
+}
+
+/*  the map of the legacy path after a load or a copy: by position  */
+static void
+vlayer_map_by_position (GimpVectorLayer *layer)
+{
+  ChopGimpVLayer *vl     = layer->vobjects;
+  GList          *leaves = leaves_of (vl->root);
+
+  g_hash_table_remove_all (vl->stroke_map);
+  vl->mapped = 0;
+  vlayer_push_layout (vl, layout_of_leaves (leaves));
+  g_list_free (leaves);
+}
+
+void
+chopgimp_vlayer_duplicate (GimpVectorLayer *src,
+                           GimpVectorLayer *dest)
+{
+  gchar *xml;
+
+  if (! src->vobjects || ! dest->options)
+    return;
+
+  xml = vlayer_serialize (src, TRUE);
+
+  chopgimp_vlayer_free (dest->vobjects);
+  dest->vobjects = vlayer_parse (gimp_item_get_image (GIMP_ITEM (dest)), xml,
+                                 strlen (xml), NULL);
+  g_free (xml);
+
+  if (dest->vobjects)
+    {
+      ChopGimpVLayer *vl = dest->vobjects;
+
+      vl->legacy = src->vobjects->legacy;
+      g_array_set_size (vl->selection, 0);
+      vl->entered = 0;
+
+      vlayer_map_by_position (dest);
+    }
+}
+
+void
+chopgimp_vlayer_convert (GimpVectorLayer *layer,
+                         GimpImage       *dest_image)
+{
+  ChopGimpVLayer *vl = layer->vobjects;
+  ChopGimpVLayer *nvl;
+  gchar          *xml;
+
+  if (! vl)
+    return;
+
+  xml = vlayer_serialize (layer, TRUE);
+  nvl = vlayer_parse (dest_image, xml, strlen (xml), NULL);
+  g_free (xml);
+
+  if (nvl)
+    {
+      nvl->legacy = vl->legacy;
+      layer->vobjects = nvl;
+      chopgimp_vlayer_free (vl);
+      vlayer_map_by_position (layer);
+    }
+}
+
+void
+chopgimp_vlayer_xcf_save_prepare (GimpVectorLayer *layer)
+{
+  GimpParasiteList *parasites;
+  GimpParasite     *parasite;
+  gchar            *xml;
+
+  if (! chopgimp_vobjects_enabled ())
+    return;
+
+  parasites = gimp_item_get_parasites (GIMP_ITEM (layer));
+
+  if (! layer->vobjects || layer->vobjects->legacy)
+    {
+      if (gimp_parasite_list_find (parasites, PARASITE_NAME))
+        gimp_parasite_list_remove (parasites, PARASITE_NAME);
+      return;
+    }
+
+  /*  the legacy fill / stroke as saved, to notice changes made elsewhere  */
+  if (layer->options)
+    {
+      g_free (layer->vobjects->opt_sig);
+      layer->vobjects->opt_sig = options_sig (layer->options);
+    }
+
+  xml      = vlayer_serialize (layer, FALSE);
+  parasite = gimp_parasite_new (PARASITE_NAME, GIMP_PARASITE_PERSISTENT,
+                                strlen (xml) + 1, xml);
+  gimp_parasite_list_add (parasites, parasite);
+  gimp_parasite_free (parasite);
+  g_free (xml);
+}
+
+void
+chopgimp_vlayer_xcf_load (GimpVectorLayer *layer)
+{
+  const GimpParasite *parasite;
+  const gchar        *data;
+  guint32             size = 0;
+  ChopGimpVLayer     *vl;
+  gchar              *saved_sig;
+
+  if (! chopgimp_vobjects_enabled () || ! layer->options || ! layer->options->path)
+    return;
+
+  parasite = gimp_item_parasite_find (GIMP_ITEM (layer), PARASITE_NAME);
+  if (! parasite)
+    return;
+
+  data = gimp_parasite_get_data (parasite, &size);
+  if (! data || size == 0)
+    return;
+
+  if (data[size - 1] == '\0')
+    size--;
+
+  vl = vlayer_parse (gimp_item_get_image (GIMP_ITEM (layer)), data, size, NULL);
+  if (! vl)
+    return;
+
+  vl->legacy = FALSE;
+  g_array_set_size (vl->selection, 0);
+  vl->entered = 0;
+
+  chopgimp_vlayer_free (layer->vobjects);
+  layer->vobjects = vl;
+
+  /*  the legacy path may have been edited by a GIMP without objects:
+   *  its sub-paths go back to the objects
+   */
+  vlayer_map_by_position (layer);
+  vlayer_pull_legacy_path (layer);
+
+  saved_sig   = vl->opt_sig;
+  vl->opt_sig = NULL;
+
+  if (saved_sig)
+    {
+      vl->opt_sig = saved_sig;
+      vlayer_style_from_options (layer);
+    }
+  else
+    {
+      vl->opt_sig = options_sig (layer->options);
+    }
+
+  if (layer_usable (layer))
+    vlayer_render_region (layer, NULL);
+}
