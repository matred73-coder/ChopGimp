+/* ─── islands (ChopGimp 3.27: « Décomposer les sous-tracés ») ──────── */
+
+/*  for each sub-path of @path, the index of the outer outline it belongs
+ *  to (itself for an outline, the smallest enclosing outline for a hole)
+ */
+extern "C" gint *
+chopgimp_geom_stroke_islands (GimpPath *path,
+                              gint     *n_strokes)
+{
+  std::vector<Geom::Path> subs;
+  std::vector<bool>       valid;
+  gint                   *owner;
+  gint                    n = 0;
+
+  for (GimpStroke *s = gimp_path_stroke_get_next (path, NULL);
+       s;
+       s = gimp_path_stroke_get_next (path, s))
+    {
+      Stroke   st;
+      gboolean closed = FALSE;
+
+      st.closed = false;
+
+      if (GIMP_IS_BEZIER_STROKE (s))
+        {
+          GArray *a = gimp_stroke_control_points_get (s, &closed);
+
+          for (guint i = 0; i + 2 < a->len; i += 3)
+            {
+              Node node;
+
+              node.in       = to_pt (&g_array_index (a, GimpAnchor, i));
+              node.pt       = to_pt (&g_array_index (a, GimpAnchor, i + 1));
+              node.out      = to_pt (&g_array_index (a, GimpAnchor, i + 2));
+              node.selected = FALSE;
+              st.nodes.push_back (node);
+            }
+
+          st.closed = closed;
+          g_array_free (a, TRUE);
+        }
+
+      try
+        {
+          subs.push_back (st.nodes.size () > 1 ? stroke_to_path (st, true)
+                                               : Geom::Path ());
+          valid.push_back (st.nodes.size () > 1);
+        }
+      catch (...)
+        {
+          subs.push_back (Geom::Path ());
+          valid.push_back (false);
+        }
+
+      n++;
+    }
+
+  *n_strokes = n;
+  owner      = g_new (gint, MAX (n, 1));
+
+  for (gint i = 0; i < n; i++)
+    owner[i] = i;
+
+  try
+    {
+      std::vector<int>    depth (n, 0);
+      std::vector<double> area (n, 0.0);
+      std::vector<Point>  probe (n);
+
+      for (gint i = 0; i < n; i++)
+        if (valid[i])
+          {
+            probe[i] = subs[i].empty () ? subs[i].initialPoint ()
+                                        : subs[i][0].pointAt (0.5);
+            area[i]  = path_area (subs[i]);
+          }
+
+      for (gint i = 0; i < n; i++)
+        if (valid[i])
+          for (gint j = 0; j < n; j++)
+            if (j != i && valid[j] && subs[j].winding (probe[i]) != 0)
+              depth[i]++;
+
+      for (gint i = 0; i < n; i++)
+        {
+          double best = -1;
+
+          if (! valid[i] || depth[i] % 2 == 0)
+            continue;
+
+          for (gint j = 0; j < n; j++)
+            if (j != i && valid[j] && depth[j] == depth[i] - 1 &&
+                subs[j].winding (probe[i]) != 0 &&
+                (best < 0 || area[j] < best))
+              {
+                best     = area[j];
+                owner[i] = j;
+              }
+        }
+    }
+  catch (...)
+    {
+      g_warning ("ChopGimp %s: lib2geom error", G_STRFUNC);
+
+      for (gint i = 0; i < n; i++)
+        owner[i] = i;
+    }
+
+  return owner;
+}
