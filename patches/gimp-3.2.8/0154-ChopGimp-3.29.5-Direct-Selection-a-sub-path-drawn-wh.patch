From: ChopGimp <mathieu.redon@proton.me>
Date: Thu, 26 Nov 2026 13:30:38 +0100
Subject: [PATCH 154/158] =?UTF-8?q?ChopGimp=203.29.5:=20Direct=20Selection?=
 =?UTF-8?q?:=20a=20sub-path=20drawn=20while=20several=20objects=20are=20ed?=
 =?UTF-8?q?ited=20becomes=20a=20new=20object=20instead=20of=20being=20drop?=
 =?UTF-8?q?ped=20(CHOPGIMP=5FNO=5FMULTI=5FNEW=5FPATH);=20dynamic=20corner?=
 =?UTF-8?q?=20widgets=20redrawn=20when=20the=20object=20changes=20and=20wh?=
 =?UTF-8?q?ile=20their=20radius=20is=20dragged;=20objects=20bar=20first=20?=
 =?UTF-8?q?in=20the=20options=20bar=20so=20=C2=AB=20Rayon=20=C2=BB=20stays?=
 =?UTF-8?q?=20visible?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 app/display/gimpoptionsbar.c |  6 ++-
 app/tools/gimppathtool.c     | 84 ++++++++++++++++++++++++++++++++++++
 2 files changed, 89 insertions(+), 1 deletion(-)

diff --git a/app/display/gimpoptionsbar.c b/app/display/gimpoptionsbar.c
index 98293f2..f5be6ce 100644
--- a/app/display/gimpoptionsbar.c
+++ b/app/display/gimpoptionsbar.c
@@ -228,7 +228,11 @@ static const BarSpec bar_specs[] =
                                      "@stroke-opacity", "@stroke-dash", "|",
                                      "add-to-vector-layer", "|", "@pathfinder", NULL } },
   { "gimp-shape-builder-tool",     { "@pathfinder", "|", "@vobjects", NULL } },
-  { "gimp-direct-select-tool",     { "@nodes", "|", "@pathfinder", "|", "@vobjects", NULL } },
+  /*  3.29.5: the objects first: at equal priority the rightmost item
+   *  goes first into « ⋯ », so the « Rayon » of the dynamic corners stays
+   *  in the bar (it went into « ⋯ » at 1600 px)
+   */
+  { "gimp-direct-select-tool",     { "@vobjects", "|", "@nodes", "|", "@pathfinder", NULL } },
   /*  3.27.6: outil Largeur, outil Enveloppe  */
   { "gimp-width-tool",             { "@widthprofile", "|", "@vobjects", NULL } },
   { "gimp-envelope-tool",          { "@distort", "|", "@vobjects", NULL } },
diff --git a/app/tools/gimppathtool.c b/app/tools/gimppathtool.c
index 0c16b32..1784d4a 100644
--- a/app/tools/gimppathtool.c
+++ b/app/tools/gimppathtool.c
@@ -386,6 +386,74 @@ gimp_path_tool_vobj_thaw_multi (GimpPath     *path,
   guint      i;
 
   path_tool->vobj_writing = TRUE;
+
+  /*  3.29.5: a new sub-path drawn while several objects are edited has no
+   *  object: it becomes a new object (style of the last edited object),
+   *  its strokes are marked and it joins the edited objects
+   *  (CHOPGIMP_NO_MULTI_NEW_PATH=1: dropped, as before)
+   */
+  if (! g_getenv ("CHOPGIMP_NO_MULTI_NEW_PATH"))
+    {
+      GimpPath   *extra = NULL;
+      GList      *fresh = NULL;
+      GimpStroke *s     = NULL;
+
+      while ((s = gimp_path_stroke_get_next (path, s)))
+        {
+          if (! g_object_get_data (G_OBJECT (s), CHOPGIMP_VOBJ_ID_KEY))
+            {
+              GimpStroke *copy = gimp_stroke_duplicate (s);
+
+              if (! extra)
+                {
+                  extra = gimp_path_new (image, _("Tracé"));
+                  g_object_ref_sink (extra);
+                }
+
+              gimp_path_stroke_add (extra, copy);
+              g_object_unref (copy);
+              fresh = g_list_prepend (fresh, s);
+            }
+        }
+
+      if (extra)
+        {
+          ChopGimpVObject *like = NULL;
+          ChopGimpVObject *made;
+          ChopGimpVStyle   style;
+
+          for (i = path_tool->vobj_multi->len; i > 0 && ! like; i--)
+            {
+              like = chopgimp_vlayer_get_object (path_tool->vobj_layer,
+                                                 g_array_index (path_tool->vobj_multi,
+                                                                guint, i - 1));
+              if (like && like->kind != CHOPGIMP_VOBJECT_PATH)
+                like = NULL;
+            }
+
+          chopgimp_vstyle_init (&style);
+          if (like)
+            chopgimp_vstyle_copy (&style, &like->style);
+
+          made = chopgimp_vobjects_add_path (path_tool->vobj_layer, extra,
+                                             _("Tracé"), &style);
+          chopgimp_vstyle_clear (&style);
+
+          if (made)
+            {
+              for (GList *l = fresh; l; l = l->next)
+                g_object_set_data (G_OBJECT (l->data), CHOPGIMP_VOBJ_ID_KEY,
+                                   GUINT_TO_POINTER (made->id));
+
+              g_array_append_val (path_tool->vobj_multi, made->id);
+            }
+
+          g_object_unref (extra);
+        }
+
+      g_list_free (fresh);
+    }
+
   chopgimp_vlayer_freeze (path_tool->vobj_layer);
 
   for (i = 0; i < path_tool->vobj_multi->len; i++)
@@ -509,6 +577,15 @@ gimp_path_tool_vobj_changed (GimpVectorLayer *layer,
   path_tool->vobj_writing = FALSE;
 
   g_object_unref (world);
+
+  /*  3.29.5: the dynamic corner widgets of the object drawn again (undo,
+   *  radius changed in the options bar…)
+   */
+  if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (path_tool)))
+    {
+      gimp_draw_tool_pause (GIMP_DRAW_TOOL (path_tool));
+      gimp_draw_tool_resume (GIMP_DRAW_TOOL (path_tool));
+    }
 }
 
 /*  Direct Selection (A) on an object: its nodes only  */
@@ -863,6 +940,13 @@ gimp_path_tool_motion (GimpTool         *tool,
       chopgimp_vtransform_set_corner (path_tool->vobj_layer, path_tool->vobj_id,
                                       path_tool->corner_k, MAX (r, 0.0), -1, FALSE);
       gimp_image_flush (gimp_display_get_image (display));
+
+      /*  3.29.5: the corner widgets follow the radius  */
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        {
+          gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+          gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+        }
       return;
     }
 
-- 
