From c9f59aa3271d256710c0673afe8b65407ce4607b Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Thu, 12 Nov 2026 13:28:10 +0100
Subject: [PATCH 45/46] ChopGimp: Windows identity of the executables

ChopGimp icon in gimp.ico (built from branding/png by
tools/windows_branding.py) and ChopGimp product name and description in
the version resources, shown by the Task Manager, the taskbar and the
file properties. Windows-only files.
---
 build/windows/gimp-plug-ins.rc.in |   7 ++++---
 build/windows/gimp.rc.in          |   7 ++++---
 gimp-data/images/logo/gimp.ico    | Bin 166229 -> 61526 bytes
 3 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/build/windows/gimp-plug-ins.rc.in b/build/windows/gimp-plug-ins.rc.in
index 760acbe..fae89c6 100644
--- a/build/windows/gimp-plug-ins.rc.in
+++ b/build/windows/gimp-plug-ins.rc.in
@@ -4,16 +4,17 @@
 #define _QUOTE(x) #x
 #define QUOTE(x) _QUOTE(x)
 
-#define VER_COMPANYNAME_STR         "Spencer Kimball, Peter Mattis and the GIMP Development Team"
+/* ChopGimp: name shown by Windows (Task Manager, file properties) */
+#define VER_COMPANYNAME_STR         "ChopGimp (based on GIMP by Spencer Kimball, Peter Mattis and the GIMP Development Team)"
 
 #define VER_PRODUCTVERSION          @GIMP_MAJOR_VERSION@,@GIMP_MINOR_VERSION@,@GIMP_MICRO_VERSION@,0
 #define VER_PRODUCTVERSION_STR      "@GIMP_MAJOR_VERSION@.@GIMP_MINOR_VERSION@.@GIMP_MICRO_VERSION@\0"
-#define VER_PRODUCTNAME_STR         "@GIMP_FULL_NAME@"
+#define VER_PRODUCTNAME_STR         "ChopGimp"
 
 #define VER_FILEVERSION             @GIMP_MAJOR_VERSION@,@GIMP_MINOR_VERSION@,@GIMP_MICRO_VERSION@,0
 #define VER_FILEVERSION_STR         "@GIMP_MAJOR_VERSION@.@GIMP_MINOR_VERSION@.@GIMP_MICRO_VERSION@.0\0"
 
-#define VER_FILEDESCRIPTION_STR     "@GIMP_FULL_NAME@ Plug-In"
+#define VER_FILEDESCRIPTION_STR     "ChopGimp Plug-In"
 #define VER_INTERNALNAME_STR        QUOTE(INTERNALNAME_STR)
 #define VER_ORIGINALFILENAME_STR    QUOTE(ORIGINALFILENAME_STR)
 
diff --git a/build/windows/gimp.rc.in b/build/windows/gimp.rc.in
index ac74f05..2cf436c 100644
--- a/build/windows/gimp.rc.in
+++ b/build/windows/gimp.rc.in
@@ -5,16 +5,17 @@
 #define QUOTE(x) _QUOTE(x)
 #define CONCAT(x,y) x ## y
 
-#define VER_COMPANYNAME_STR         "Spencer Kimball, Peter Mattis and the GIMP Development Team"
+/* ChopGimp: name shown by Windows (Task Manager, taskbar, file properties) */
+#define VER_COMPANYNAME_STR         "ChopGimp (based on GIMP by Spencer Kimball, Peter Mattis and the GIMP Development Team)"
 
 #define VER_PRODUCTVERSION          @GIMP_MAJOR_VERSION@,@GIMP_MINOR_VERSION@,@GIMP_MICRO_VERSION@,0
 #define VER_PRODUCTVERSION_STR      "@GIMP_MAJOR_VERSION@.@GIMP_MINOR_VERSION@.@GIMP_MICRO_VERSION@\0"
-#define VER_PRODUCTNAME_STR         "@GIMP_FULL_NAME@"
+#define VER_PRODUCTNAME_STR         "ChopGimp"
 
 #define VER_FILEVERSION             @GIMP_MAJOR_VERSION@,@GIMP_MINOR_VERSION@,@GIMP_MICRO_VERSION@,0
 #define VER_FILEVERSION_STR         "@GIMP_MAJOR_VERSION@.@GIMP_MINOR_VERSION@.@GIMP_MICRO_VERSION@.0\0"
 
-#define VER_FILEDESCRIPTION_STR     "@GIMP_FULL_NAME@"
+#define VER_FILEDESCRIPTION_STR     "ChopGimp"
 #define VER_INTERNALNAME_STR        QUOTE(INTERNALNAME_STR)
 #define VER_ORIGINALFILENAME_STR    QUOTE(ORIGINALFILENAME_STR)
 
diff --git a/gimp-data/images/logo/gimp.ico b/gimp-data/images/logo/gimp.ico
index 055a51a7f93fa93a1628b7b8e963c0e1db179854..c543b6158ae71e2bce1ee92bcac623806b467c10 100644
