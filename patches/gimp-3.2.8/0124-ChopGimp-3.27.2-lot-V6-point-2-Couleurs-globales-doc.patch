+++ b/app/path/chopgimp-vrecolor.h
@@ -0,0 +1,160 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vrecolor.h — ChopGimp 3.27.2 (lot V6 point 2): « Redéfinir les
+ * couleurs » (Illustrator's Recolor Artwork) and the links of the
+ * selected objects to the global colors (chopgimp-vcolors.h)
+ *
+ * A recolor session (ChopGimpRecolor) gathers the path objects to work
+ * on, keeps a copy of their styles, and lists the distinct colors they
+ * use (COLOR paints of fills and strokes, gradient stops) with their
+ * number of uses, sorted by hue group. Each color gets a new color (a
+ * color, or a global color it is then linked to); global hue /
+ * saturation / lightness shifts apply on top. The new colors can be
+ * previewed (no undo step) and committed as ONE undo step.
+ *
+ *   objects: the selected objects of the only selected vector layer;
+ *   else all the objects of the selected vector layers; else all the
+ *   objects of all the vector layers of the image (locked objects
+ *   excluded).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+G_BEGIN_DECLS
+
+
+typedef struct _ChopGimpRecolor ChopGimpRecolor;
+
+typedef enum
+{
+  CHOPGIMP_RECOLOR_SELECTION,   /* the selected objects of one layer      */
+  CHOPGIMP_RECOLOR_LAYERS,      /* all the objects of the selected layers */
+  CHOPGIMP_RECOLOR_IMAGE        /* all the vector layers of the image     */
+} ChopGimpRecolorScope;
+
+#define CHOPGIMP_RECOLOR_N_GROUPS 9   /* 8 hue groups + « Neutres »        */
+
+typedef struct
+{
+  gdouble   rgb[3];        /* the color used, R'G'B' 0..1 (8 bits)       */
+  gint      count;         /* number of uses                             */
+  gint      group;         /* 0..8, see chopgimp_recolor_group_name()    */
+  gchar    *orig_global;   /* the global color all its plain uses follow */
+
+  /*  the new color  */
+  gboolean  has_target;
+  gdouble   target[3];
+  gchar    *global_id;     /* NULL, or the global color it becomes       */
+
+  /*< private >*/
+  gint      global_state;
+} ChopGimpRecolorColor;
+
+
+/*  NULL when there is nothing to recolor (no objects, objects disabled)  */
+ChopGimpRecolor      * chopgimp_recolor_new          (GimpImage       *image);
+/*  reverts a preview first  */
+void                   chopgimp_recolor_free         (ChopGimpRecolor *rc);
+
+GimpImage            * chopgimp_recolor_get_image    (ChopGimpRecolor *rc);
+ChopGimpRecolorScope   chopgimp_recolor_get_scope    (ChopGimpRecolor *rc);
+gint                   chopgimp_recolor_get_n_objects (ChopGimpRecolor *rc);
+gint                   chopgimp_recolor_get_n_colors (ChopGimpRecolor *rc);
+/*  sorted by group, then most used first  */
+ChopGimpRecolorColor * chopgimp_recolor_get_color    (ChopGimpRecolor *rc,
+                                                      gint             index);
+/*  the index of the color @rgb (8 bits), or -1  */
+gint                   chopgimp_recolor_find         (ChopGimpRecolor *rc,
+                                                      const gdouble   *rgb);
+const gchar          * chopgimp_recolor_group_name   (gint             group);
+
+/*  @rgb NULL: back to the current color  */
+void                   chopgimp_recolor_set_target   (ChopGimpRecolor *rc,
+                                                      gint             index,
+                                                      const gdouble   *rgb);
+/*  the new color is @rgb after the global shifts (the target is @rgb
+ *  with the shifts undone)
+ */
+void                   chopgimp_recolor_set_final    (ChopGimpRecolor *rc,
+                                                      gint             index,
+                                                      const gdouble   *rgb);
+/*  @id NULL: not a global color any more  */
+void                   chopgimp_recolor_set_global   (ChopGimpRecolor *rc,
+                                                      gint             index,
+                                                      const gchar     *id);
+void                   chopgimp_recolor_reset        (ChopGimpRecolor *rc);
+/*  @hue in degrees (-180..180), @saturation and @lightness -1..1  */
+void                   chopgimp_recolor_set_adjust   (ChopGimpRecolor *rc,
+                                                      gdouble          hue,
+                                                      gdouble          saturation,
+                                                      gdouble          lightness);
+/*  the color the objects will get  */
+void                   chopgimp_recolor_get_final    (ChopGimpRecolor *rc,
+                                                      gint             index,
+                                                      gdouble         *rgb);
+gboolean               chopgimp_recolor_is_changed   (ChopGimpRecolor *rc,
+                                                      gint             index);
+
+/*  harmonies (those of Couleurs > Harmonies, chopgimp_atelier.py):
+ *  NULL-terminated, translated labels
+ */
+const gchar * const  * chopgimp_recolor_harmony_names (void);
+/*  the hue groups follow the harmony @harmony built on the hue of @base
+ *  (NULL: the most used color); each color keeps its saturation, value
+ *  and its hue offset in its group. Returns the number of colors changed.
+ */
+gint                   chopgimp_recolor_harmony      (ChopGimpRecolor *rc,
+                                                      gint             harmony,
+                                                      const gdouble   *base);
+/*  « Réduire à N couleurs »: k-means in CIE Lab (weighted by the uses);
+ *  each color becomes the most used color of its cluster. Returns the
+ *  number of colors left.
+ */
+gint                   chopgimp_recolor_reduce       (ChopGimpRecolor *rc,
+                                                      gint             n);
+/*  each color becomes the nearest global color of the image (CIE Lab);
+ *  returns the number of colors assigned (0: no global color)
+ */
+gint                   chopgimp_recolor_assign_globals (ChopGimpRecolor *rc);
+
+/*  the new colors on the objects, no undo step (the dialog's preview)  */
+void                   chopgimp_recolor_preview      (ChopGimpRecolor *rc);
+void                   chopgimp_recolor_revert       (ChopGimpRecolor *rc);
+/*  one undo step « Redéfinir les couleurs »; FALSE when nothing changed  */
+gboolean               chopgimp_recolor_commit       (ChopGimpRecolor *rc);
+
+
+/*  ─── links to the global colors ────────────────────────────────────── */
+
+typedef enum
+{
+  CHOPGIMP_VLINK_FILL   = 1 << 0,
+  CHOPGIMP_VLINK_STROKE = 1 << 1
+} ChopGimpVLink;
+
+/*  the path objects of the selected objects of @layer (all of them when
+ *  @all), g_list_free only
+ */
+GList                * chopgimp_vobjects_selected_leaves (GimpVectorLayer *layer,
+                                                      gboolean         all);
+/*  the primary fill and / or stroke of the selected objects of @layer
+ *  follow the global color @id; @id NULL: their fills and / or strokes
+ *  stop following any global color (they keep the color). One undo step.
+ *  Returns the number of objects changed.
