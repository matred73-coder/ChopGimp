+
+#include "gimp-intl.h"
+
+
+/*  ─── the swatch ────────────────────────────────────────────────────── */
+
+static gboolean
+swatch_draw (GtkWidget *widget,
+             cairo_t   *cr)
+{
+  GeglColor *color = g_object_get_data (G_OBJECT (widget), "chopgimp-color");
+  gint       w     = gtk_widget_get_allocated_width (widget);
+  gint       h     = gtk_widget_get_allocated_height (widget);
+  gdouble    rgba[4] = { 0, 0, 0, 1 };
+  gdouble    t;
+
+  if (color)
+    gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), rgba);
+
+  /*  checks under a transparent color  */
+  if (rgba[3] < 1.0)
+    {
+      gint c = MAX (3, MIN (w, h) / 4);
+
+      for (gint y = 0; y < h; y += c)
+        for (gint x = 0; x < w; x += c)
+          {
+            gdouble g = (((x / c) + (y / c)) & 1) ? 0.6 : 0.85;
+
+            cairo_set_source_rgb (cr, g, g, g);
+            cairo_rectangle (cr, x, y, c, c);
+            cairo_fill (cr);
+          }
+    }
+
+  cairo_set_source_rgba (cr, rgba[0], rgba[1], rgba[2], rgba[3]);
+  cairo_rectangle (cr, 0, 0, w, h);
+  cairo_fill (cr);
+
+  cairo_set_line_width (cr, 1.0);
+  cairo_set_source_rgba (cr, 0, 0, 0, 0.45);
+  cairo_rectangle (cr, 0.5, 0.5, w - 1, h - 1);
+  cairo_stroke (cr);
+
+  /*  the « globale » corner triangle, bottom right  */
+  t = MAX (5.0, MIN (w, h) * 0.42);
+
+  cairo_move_to (cr, w,     h - t);
+  cairo_line_to (cr, w,     h);
+  cairo_line_to (cr, w - t, h);
+  cairo_close_path (cr);
+  cairo_set_source_rgb (cr, 1, 1, 1);
+  cairo_fill_preserve (cr);
+  cairo_set_source_rgba (cr, 0, 0, 0, 0.6);
+  cairo_stroke (cr);
+
+  return TRUE;
+}
+
+GtkWidget *
+chopgimp_global_swatch_new (GeglColor *color,
+                            gint       size)
+{
+  GtkWidget *area = gtk_drawing_area_new ();
+
+  gtk_widget_set_size_request (area, size, size);
+  g_signal_connect (area, "draw", G_CALLBACK (swatch_draw), NULL);
+  chopgimp_global_swatch_set_color (area, color);
+
+  return area;
+}
+
+void
+chopgimp_global_swatch_set_color (GtkWidget *swatch,
+                                  GeglColor *color)
+{
+  g_return_if_fail (GTK_IS_WIDGET (swatch));
+
+  g_object_set_data_full (G_OBJECT (swatch), "chopgimp-color",
+                          color ? gegl_color_duplicate (color) : NULL,
+                          color ? g_object_unref : NULL);
+  gtk_widget_queue_draw (swatch);
+}
+
+
+/*  ─── the panel ─────────────────────────────────────────────────────── */
+
+typedef struct
+{
+  Gimp            *gimp;
+  GimpContext     *context;
+  GtkWidget       *editor;
+  GtkWidget       *hint;
+  GtkWidget       *content;
+  GtkWidget       *empty;
+  GtkWidget       *flow;
+  GtkWidget       *list_toggle;
+
+  GtkWidget       *new_button;
+  GtkWidget       *edit_button;
+  GtkWidget       *rename_button;
+  GtkWidget       *delete_button;
+  GtkWidget       *fill_button;
+  GtkWidget       *stroke_button;
+  GtkWidget       *unlink_button;
+
+  GimpImage       *image;      /* weak */
+  GObject         *registry;   /* owned by the image */
+  GimpVectorLayer *layer;      /* weak */
+
+  gchar           *selected;   /* id */
+  gboolean         loading;
+  guint            idle_id;
+
+  GtkWidget       *color_dialog;
+  gchar           *edit_id;
+  GeglColor       *edit_orig;
+} Panel;
+
+
+static void panel_queue_refresh (Panel *p);
+static void panel_refresh       (Panel *p);
+
+
+static gint
+n_selected_objects (Panel *p)
+{
+  return p->layer ? chopgimp_vobjects_n_selected (p->layer) : 0;
+}
+
+static void
+panel_update_sensitivity (Panel *p)
+{
+  gboolean sel  = (p->selected != NULL && p->image &&
+                   chopgimp_vcolors_lookup (p->image, p->selected) != NULL);
+  gboolean objs = n_selected_objects (p) > 0;
+
+  gtk_widget_set_sensitive (p->new_button,    p->image != NULL);
+  gtk_widget_set_sensitive (p->edit_button,   sel);
+  gtk_widget_set_sensitive (p->rename_button, sel);
+  gtk_widget_set_sensitive (p->delete_button, sel);
+  gtk_widget_set_sensitive (p->fill_button,   sel && objs);
+  gtk_widget_set_sensitive (p->stroke_button, sel && objs);
+  gtk_widget_set_sensitive (p->unlink_button, objs);
+}
+
+static void
+flow_selection_changed (GtkFlowBox *flow,
+                        Panel      *p)
+{
+  GList *sel;
+
+  if (p->loading)
+    return;
+
+  sel = gtk_flow_box_get_selected_children (flow);
+
+  g_free (p->selected);
+  p->selected = sel ? g_strdup (g_object_get_data (sel->data, "chopgimp-id")) : NULL;
+  g_list_free (sel);
+
+  panel_update_sensitivity (p);
+}
+
+static gchar *
+color_hex (GeglColor *color)
+{
+  gdouble rgba[4];
+
+  gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), rgba);
+
+  return g_strdup_printf ("#%02x%02x%02x",
+                          (gint) CLAMP (rgba[0] * 255.0 + 0.5, 0, 255),
+                          (gint) CLAMP (rgba[1] * 255.0 + 0.5, 0, 255),
+                          (gint) CLAMP (rgba[2] * 255.0 + 0.5, 0, 255));
+}
+
+static void
+panel_refresh (Panel *p)
+{
+  GList    *colors;
+  GList    *children;
+  gboolean  list_mode;
+
+  if (! chopgimp_vobjects_enabled ())
+    return;
+
+  gtk_widget_set_visible (p->hint,    p->image == NULL);
+  gtk_widget_set_visible (p->content, p->image != NULL);
+
+  children = gtk_container_get_children (GTK_CONTAINER (p->flow));
+  for (GList *l = children; l; l = l->next)
+    gtk_widget_destroy (l->data);
+  g_list_free (children);
+
+  if (! p->image)
+    {
+      panel_update_sensitivity (p);
+      return;
+    }
+
+  list_mode = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (p->list_toggle));
+  gtk_flow_box_set_max_children_per_line (GTK_FLOW_BOX (p->flow), list_mode ? 1 : 64);
+
+  p->loading = TRUE;
+
+  colors = chopgimp_vcolors_list (p->image);
+
+  for (GList *l = colors; l; l = l->next)
+    {
+      const ChopGimpVColor *c     = l->data;
+      gint                  users = chopgimp_vcolors_count_users (p->image, c->id);
+      GtkWidget            *child = gtk_flow_box_child_new ();
+      GtkWidget            *box   = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+      gchar                *hex   = color_hex (c->color);
+      gchar                *tip;
+
+      g_object_set_data_full (G_OBJECT (child), "chopgimp-id", g_strdup (c->id), g_free);
+      gtk_container_add (GTK_CONTAINER (child), box);
+
+      gtk_box_pack_start (GTK_BOX (box),
+                          chopgimp_global_swatch_new (c->color, list_mode ? 20 : 26),
+                          FALSE, FALSE, 0);
+
+      if (list_mode)
+        {
+          GtkWidget *name  = gtk_label_new (c->name);
+          gchar     *count = g_strdup_printf ("%d", users);
+          GtkWidget *n     = gtk_label_new (count);
+
+          gtk_label_set_xalign (GTK_LABEL (name), 0.0);
+          gtk_label_set_ellipsize (GTK_LABEL (name), PANGO_ELLIPSIZE_END);
+          gtk_box_pack_start (GTK_BOX (box), name, TRUE, TRUE, 0);
+          gtk_style_context_add_class (gtk_widget_get_style_context (n), "dim-label");
+          gtk_box_pack_end (GTK_BOX (box), n, FALSE, FALSE, 0);
+          g_free (count);
+        }
+
+      tip = g_strdup_printf (users == 0 ? _("%s\n%s — aucun objet ne l'utilise") :
+                             users == 1 ? _("%s\n%s — utilisée par %d objet") :
+                                          _("%s\n%s — utilisée par %d objets"),
+                             c->name, hex, users);
+      gtk_widget_set_tooltip_text (child, tip);
+      g_free (tip);
+      g_free (hex);
+
+      gtk_widget_show_all (child);
+      gtk_container_add (GTK_CONTAINER (p->flow), child);
+
+      if (! g_strcmp0 (c->id, p->selected))
+        gtk_flow_box_select_child (GTK_FLOW_BOX (p->flow), GTK_FLOW_BOX_CHILD (child));
+    }
+
+  gtk_widget_set_visible (p->empty, colors == NULL);
+
+  if (p->selected && ! chopgimp_vcolors_lookup (p->image, p->selected))
+    g_clear_pointer (&p->selected, g_free);
+
+  g_list_free (colors);
+
+  p->loading = FALSE;
+
+  panel_update_sensitivity (p);
+}
+
+static gboolean
+panel_refresh_idle (gpointer data)
+{
+  Panel *p = data;
+
+  p->idle_id = 0;
+  panel_refresh (p);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+panel_queue_refresh (Panel *p)
+{
+  /*  a hidden panel is refreshed when shown  */
+  if (! p->idle_id && gtk_widget_get_mapped (p->editor))
+    p->idle_id = g_idle_add (panel_refresh_idle, p);
+}
+
+
+/*  ─── following the image ───────────────────────────────────────────── */
+
+static void
+panel_set_layer (Panel           *p,
+                 GimpVectorLayer *layer)
+{
+  if (layer == p->layer)
+    return;
+
+  if (p->layer)
+    {
+      g_signal_handlers_disconnect_by_data (p->layer, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->layer), (gpointer *) &p->layer);
+    }
+
+  p->layer = layer;
+
+  if (layer)
+    {
+      g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &p->layer);
+      g_signal_connect_swapped (layer, "objects-changed",
+                                G_CALLBACK (panel_queue_refresh), p);
+      g_signal_connect_swapped (layer, "object-selection-changed",
+                                G_CALLBACK (panel_queue_refresh), p);
+    }
+}
+
+static void
+panel_layers_changed (Panel *p)
+{
+  panel_set_layer (p, p->image ? chopgimp_vobjects_get_target_layer (p->image) : NULL);
+  panel_queue_refresh (p);
+}
+
+static void
+panel_set_image (Panel     *p,
+                 GimpImage *image)
+{
+  if (image == p->image)
+    return;
+
+  panel_set_layer (p, NULL);
+
+  if (p->color_dialog)
+    gtk_widget_destroy (p->color_dialog);
+
+  if (p->registry)
+    {
+      g_signal_handlers_disconnect_by_data (p->registry, p);
+      g_object_remove_weak_pointer (p->registry, (gpointer *) &p->registry);
+      p->registry = NULL;
+    }
+
+  if (p->image)
+    {
+      g_signal_handlers_disconnect_by_data (p->image, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->image), (gpointer *) &p->image);
+    }
+
+  p->image = image;
+  g_clear_pointer (&p->selected, g_free);
+
+  if (image)
+    {
+      g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &p->image);
+      g_signal_connect_swapped (image, "selected-layers-changed",
+                                G_CALLBACK (panel_layers_changed), p);
+
+      p->registry = chopgimp_vcolors_get_registry (image);
+
+      if (p->registry)
+        {
+          g_object_add_weak_pointer (p->registry, (gpointer *) &p->registry);
+          g_signal_connect_swapped (p->registry, "global-colors-changed",
+                                    G_CALLBACK (panel_queue_refresh), p);
+          g_signal_connect_swapped (p->registry, "global-color-changed",
+                                    G_CALLBACK (panel_queue_refresh), p);
+        }
+
+      panel_set_layer (p, chopgimp_vobjects_get_target_layer (image));
+    }
+
+  panel_queue_refresh (p);
+}
+
+static void
+panel_image_changed (GimpContext *context,
+                     GimpImage   *image,
+                     Panel       *p)
+{
+  panel_set_image (p, image);
+}
+
+
+/*  ─── actions ───────────────────────────────────────────────────────── */
+
+/*  the color of the primary fill of the first selected object, or NULL  */
+static GeglColor *
+selection_fill_color (Panel *p)
+{
+  GList           *leaves = chopgimp_vobjects_selected_leaves (p->layer, FALSE);
+  ChopGimpVObject *leaf   = leaves ? leaves->data : NULL;
+  ChopGimpVEntry  *fill   = leaf ? chopgimp_vstyle_get_fill (&leaf->style) : NULL;
+
+  g_list_free (leaves);
+
+  if (fill && fill->paint.type == CHOPGIMP_PAINT_COLOR)
+    return fill->paint.color;
+
+  return NULL;
+}
+
+static gchar *
+new_name (GimpImage *image)
+{
+  GList *colors = chopgimp_vcolors_list (image);
+  gint   n      = g_list_length (colors) + 1;
+
+  g_list_free (colors);
+
+  return g_strdup_printf (_("Couleur globale %d"), n);
+}
+
+static void
+new_clicked (GtkWidget *button,
+             Panel     *p)
+{
+  GeglColor *color;
+  gboolean   link;
+  gchar     *name;
+  gchar     *id;
+
+  if (! p->image)
+    return;
+
+  color = selection_fill_color (p);
+  link  = (color != NULL);
+  color = color ? gegl_color_duplicate (color)
+                : gegl_color_duplicate (gimp_context_get_foreground (p->context));
+  name  = new_name (p->image);
+
+  gimp_image_undo_group_start (p->image, GIMP_UNDO_GROUP_MISC,
+                               _("Nouvelle couleur globale"));
+
+  id = chopgimp_vcolors_add (p->image, name, color, NULL, TRUE);
+
+  /*  made from the selected objects: they follow it  */
+  if (id && link && p->layer)
+    chopgimp_vobjects_link_global (p->layer, CHOPGIMP_VLINK_FILL, id, TRUE);
+
+  gimp_image_undo_group_end (p->image);
+  gimp_image_flush (p->image);
+
+  g_free (p->selected);
+  p->selected = id;
+
+  g_free (name);
+  g_object_unref (color);
+
+  panel_queue_refresh (p);
+}
+
+static void
+color_dialog_update (GimpColorDialog      *dialog,
+                     GeglColor            *color,
+                     GimpColorDialogState  state,
+                     Panel                *p)
+{
+  if (! p->image || ! p->edit_id)
+    {
+      gtk_widget_destroy (GTK_WIDGET (dialog));
+      return;
+    }
+
+  switch (state)
+    {
+    case GIMP_COLOR_DIALOG_UPDATE:
+      /*  live: every linked object follows, no undo step yet  */
+      chopgimp_vcolors_set_color (p->image, p->edit_id, color, FALSE);
+      gimp_image_flush (p->image);
+      break;
+
+    case GIMP_COLOR_DIALOG_OK:
+      {
+        GeglColor *final = gegl_color_duplicate (color);
+
+        /*  one undo step from the color before the dialog  */
+        chopgimp_vcolors_set_color (p->image, p->edit_id, p->edit_orig, FALSE);
+        chopgimp_vcolors_set_color (p->image, p->edit_id, final, TRUE);
+        gimp_image_flush (p->image);
+        g_object_unref (final);
+        gtk_widget_destroy (GTK_WIDGET (dialog));
+      }
+      break;
+
+    case GIMP_COLOR_DIALOG_CANCEL:
+      chopgimp_vcolors_set_color (p->image, p->edit_id, p->edit_orig, FALSE);
+      gimp_image_flush (p->image);
+      gtk_widget_destroy (GTK_WIDGET (dialog));
+      break;
+    }
+}
+
+static void
+color_dialog_destroyed (GtkWidget *dialog,
+                        Panel     *p)
+{
+  p->color_dialog = NULL;
+  g_clear_pointer (&p->edit_id, g_free);
+  g_clear_object (&p->edit_orig);
+}
+
+static void
+edit_clicked (GtkWidget *button,
+              Panel     *p)
+{
+  const ChopGimpVColor *c;
+  gchar                *desc;
+
+  if (! p->image || ! p->selected ||
+      ! (c = chopgimp_vcolors_lookup (p->image, p->selected)))
+    return;
+
+  if (p->color_dialog)
+    gtk_widget_destroy (p->color_dialog);
+
+  p->edit_id   = g_strdup (c->id);
+  p->edit_orig = gegl_color_duplicate (c->color);
+
+  desc = g_strdup_printf (_("Couleur globale « %s » : les objets liés suivent"), c->name);
+
+  p->color_dialog =
+    gimp_color_dialog_new (GIMP_VIEWABLE (p->image), p->context, FALSE,
+                           _("Modifier la couleur globale"),
+                           GIMP_ICON_PALETTE, desc,
+                           p->editor,
+                           gimp_dialog_factory_get_singleton (),
+                           "chopgimp-global-color-dialog",
+                           c->color, TRUE, TRUE);
+  g_free (desc);
+
+  g_signal_connect (p->color_dialog, "destroy",
+                    G_CALLBACK (color_dialog_destroyed), p);
+  g_signal_connect (p->color_dialog, "update",
+                    G_CALLBACK (color_dialog_update), p);
+
+  gtk_window_present (GTK_WINDOW (p->color_dialog));
+}
+
+static void
+flow_child_activated (GtkFlowBox      *flow,
+                      GtkFlowBoxChild *child,
+                      Panel           *p)
+{
+  g_free (p->selected);
+  p->selected = g_strdup (g_object_get_data (G_OBJECT (child), "chopgimp-id"));
+
+  edit_clicked (NULL, p);
+}
+
+static void
+rename_callback (GtkWidget   *query_box,
+                 const gchar *string,
+                 gpointer     data)
+{
+  GimpImage *image = data;
+  gchar     *id    = g_object_get_data (G_OBJECT (query_box), "chopgimp-id");
+
+  if (id && string && *string &&
+      chopgimp_vcolors_rename (image, id, string, TRUE))
+    gimp_image_flush (image);
+}
+
+static void
+rename_clicked (GtkWidget *button,
+                Panel     *p)
+{
+  const ChopGimpVColor *c;
+  GtkWidget            *box;
+
+  if (! p->image || ! p->selected ||
+      ! (c = chopgimp_vcolors_lookup (p->image, p->selected)))
+    return;
+
+  box = gimp_query_string_box (_("Renommer la couleur globale"),
+                               p->editor,
+                               gimp_standard_help_func, GIMP_HELP_PATH_DIALOG,
+                               _("Nom de la couleur globale :"),
+                               c->name,
+                               G_OBJECT (p->image), "disconnect",
+                               rename_callback, p->image, NULL);
+  g_object_set_data_full (G_OBJECT (box), "chopgimp-id", g_strdup (c->id), g_free);
+  gtk_widget_show (box);
+}
+
+static void
+delete_clicked (GtkWidget *button,
+                Panel     *p)
+{
+  if (p->image && p->selected &&
+      chopgimp_vcolors_remove (p->image, p->selected, TRUE))
+    gimp_image_flush (p->image);
+}
+
+static void
+link_clicked (GtkWidget *button,
+              Panel     *p)
+{
+  ChopGimpVLink which = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (button),
+                                                            "chopgimp-which"));
+  gboolean      unlink = (button == p->unlink_button);
+
+  if (! p->image || ! p->layer || (! unlink && ! p->selected))
+    return;
+
+  if (chopgimp_vobjects_link_global (p->layer, which, unlink ? NULL : p->selected, TRUE) > 0)
+    gimp_image_flush (p->image);
+}
+
+static void
+list_toggled (GtkToggleButton *toggle,
+              Panel           *p)
+{
+  panel_queue_refresh (p);
+}
+
+
+/*  ─── construction ──────────────────────────────────────────────────── */
+
+static void
+panel_free (Panel *p)
+{
+  panel_set_image (p, NULL);
+
+  if (p->idle_id)
+    g_source_remove (p->idle_id);
+  p->idle_id = 0;
+
+  g_signal_handlers_disconnect_by_data (p->context, p);
+
+  g_free (p->selected);
+  g_free (p);
+}
+
+static GtkWidget *
+add_button (Panel       *p,
+            const gchar *icon,
+            const gchar *tip,
+            GCallback    callback)
+{
+  GtkWidget *b = gimp_editor_add_button (GIMP_EDITOR (p->editor), icon, tip, NULL,
+                                         NULL, NULL, NULL);
+
+  g_signal_connect (b, "clicked", callback, p);
+
+  return b;
+}
+
+GtkWidget *
+chopgimp_global_colors_editor_new (GimpDialogFactory *factory,
+                                   GimpContext       *context,
+                                   GimpUIManager     *ui_manager,
+                                   gint               view_size)
+{
+  Panel     *p      = g_new0 (Panel, 1);
+  GtkWidget *editor = g_object_new (GIMP_TYPE_EDITOR, NULL);
+  GtkWidget *box    = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  GtkWidget *hbox;
+  GtkWidget *label;
+  GtkWidget *scrolled;
+
+  p->gimp    = context->gimp;
+  p->editor  = editor;
+  p->context = gimp_get_user_context (context->gimp);
+
+  gtk_style_context_add_class (gtk_widget_get_style_context (editor),
+                               "chopgimp-global-colors");
+
+  gtk_container_set_border_width (GTK_CONTAINER (box), 6);
+  gtk_box_pack_start (GTK_BOX (editor), box, TRUE, TRUE, 0);
+  gtk_widget_set_visible (box, TRUE);
+
+  g_object_set_data_full (G_OBJECT (editor), "chopgimp-panel", p,
+                          (GDestroyNotify) panel_free);
+
+  if (! chopgimp_vobjects_enabled ())
+    {
+      label = gtk_label_new (_("Les objets vectoriels sont désactivés "
+                               "(CHOPGIMP_NO_VOBJECTS=1)."));
+      gtk_label_set_line_wrap (GTK_LABEL (label), TRUE);
+      gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+      gtk_widget_set_visible (label, TRUE);
+
+      return editor;
+    }
+
+  p->hint = gtk_label_new (_("Ouvrez une image : ses couleurs globales "
+                             "s'affichent ici."));
+  gtk_label_set_line_wrap (GTK_LABEL (p->hint), TRUE);
+  gtk_label_set_xalign (GTK_LABEL (p->hint), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (p->hint), "dim-label");
+  gtk_box_pack_start (GTK_BOX (box), p->hint, FALSE, FALSE, 0);
+  gtk_widget_set_no_show_all (p->hint, TRUE);
+
+  p->content = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_box_pack_start (GTK_BOX (box), p->content, TRUE, TRUE, 0);
+
+  /*  Nuancier du document   [Liste]  */
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_box_pack_start (GTK_BOX (p->content), hbox, FALSE, FALSE, 0);
+
+  label = gtk_label_new (_("Nuancier du document"));
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (label), "dim-label");
+  gtk_box_pack_start (GTK_BOX (hbox), label, TRUE, TRUE, 0);
+
+  p->list_toggle = gtk_toggle_button_new_with_label (_("Liste"));
+  gtk_button_set_relief (GTK_BUTTON (p->list_toggle), GTK_RELIEF_NONE);
+  gimp_help_set_help_data (p->list_toggle, _("Afficher en liste, avec les noms"), NULL);
+  g_signal_connect (p->list_toggle, "toggled", G_CALLBACK (list_toggled), p);
+  gtk_box_pack_end (GTK_BOX (hbox), p->list_toggle, FALSE, FALSE, 0);
+
+  p->empty = gtk_label_new (_("Aucune couleur globale. « Nouvelle couleur globale » "
+                              "crée une nuance qui met à jour tous les objets qui "
+                              "l'utilisent quand on la modifie."));
+  gtk_label_set_line_wrap (GTK_LABEL (p->empty), TRUE);
+  gtk_label_set_xalign (GTK_LABEL (p->empty), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (p->empty), "dim-label");
+  gtk_box_pack_start (GTK_BOX (p->content), p->empty, FALSE, FALSE, 0);
+  gtk_widget_set_no_show_all (p->empty, TRUE);
+
+  scrolled = gtk_scrolled_window_new (NULL, NULL);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled),
+                                  GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_box_pack_start (GTK_BOX (p->content), scrolled, TRUE, TRUE, 0);
+
+  p->flow = gtk_flow_box_new ();
+  gtk_flow_box_set_selection_mode (GTK_FLOW_BOX (p->flow), GTK_SELECTION_SINGLE);
+  gtk_flow_box_set_activate_on_single_click (GTK_FLOW_BOX (p->flow), FALSE);
+  gtk_flow_box_set_homogeneous (GTK_FLOW_BOX (p->flow), FALSE);
+  gtk_flow_box_set_row_spacing (GTK_FLOW_BOX (p->flow), 2);
+  gtk_flow_box_set_column_spacing (GTK_FLOW_BOX (p->flow), 2);
+  gtk_widget_set_valign (p->flow, GTK_ALIGN_START);
+  g_signal_connect (p->flow, "selected-children-changed",
+                    G_CALLBACK (flow_selection_changed), p);
+  g_signal_connect (p->flow, "child-activated",
+                    G_CALLBACK (flow_child_activated), p);
+  gtk_container_add (GTK_CONTAINER (scrolled), p->flow);
+
+  gtk_widget_show_all (p->content);
+  gtk_widget_set_no_show_all (p->content, TRUE);
+
+  p->new_button    = add_button (p, GIMP_ICON_DOCUMENT_NEW,
+                                 _("Nouvelle couleur globale (le fond de l'objet "
+                                   "sélectionné, qui la suit alors, sinon la couleur "
+                                   "de premier plan)"),
+                                 G_CALLBACK (new_clicked));
+  p->edit_button   = add_button (p, GIMP_ICON_EDIT,
+                                 _("Modifier la couleur globale : tous les objets "
+                                   "liés suivent (double-clic)"),
+                                 G_CALLBACK (edit_clicked));
+  p->rename_button = add_button (p, GIMP_ICON_FORMAT_TEXT_BOLD,
+                                 _("Renommer la couleur globale"),
+                                 G_CALLBACK (rename_clicked));
+  p->delete_button = add_button (p, GIMP_ICON_EDIT_DELETE,
+                                 _("Supprimer la couleur globale (les objets gardent "
+                                   "la couleur)"),
+                                 G_CALLBACK (delete_clicked));
+  p->fill_button   = add_button (p, GIMP_ICON_TOOL_BUCKET_FILL,
+                                 _("Appliquer au fond des objets sélectionnés (liés)"),
+                                 G_CALLBACK (link_clicked));
+  g_object_set_data (G_OBJECT (p->fill_button), "chopgimp-which",
+                     GINT_TO_POINTER (CHOPGIMP_VLINK_FILL));
+  p->stroke_button = add_button (p, GIMP_ICON_PATH_STROKE,
+                                 _("Appliquer au contour des objets sélectionnés (liés)"),
+                                 G_CALLBACK (link_clicked));
+  g_object_set_data (G_OBJECT (p->stroke_button), "chopgimp-which",
+                     GINT_TO_POINTER (CHOPGIMP_VLINK_STROKE));
+  p->unlink_button = add_button (p, GIMP_ICON_CHAIN_HORIZONTAL_BROKEN,
+                                 _("Délier : le fond et le contour des objets "
+                                   "sélectionnés ne suivent plus de couleur globale"),
+                                 G_CALLBACK (link_clicked));
+  g_object_set_data (G_OBJECT (p->unlink_button), "chopgimp-which",
+                     GINT_TO_POINTER (CHOPGIMP_VLINK_FILL | CHOPGIMP_VLINK_STROKE));
+
+  g_signal_connect (p->context, "image-changed",
+                    G_CALLBACK (panel_image_changed), p);
+  g_signal_connect_data (editor, "map", G_CALLBACK (panel_queue_refresh), p, NULL,
+                         G_CONNECT_SWAPPED | G_CONNECT_AFTER);
+
+  panel_set_image (p, gimp_context_get_image (p->context));
+  panel_refresh (p);
+
+  return editor;
+}
