+/*  ChopGimp 3.27.2 (lot V6 point 2): « Redéfinir les couleurs » from a
+ *  script. @spec: « key=value » separated by « ; », applied in this
+ *  order: map=RRGGBB>RRGGBB,… (one color → a new color), harmony=1..5
+ *  (Complémentaire, Triade, Analogues, Tétrade, Complémentaires
+ *  adjacentes) with base=RRGGBB (optional), reduce=N, globals=1 (nearest
+ *  global colors), hue=-180..180, sat=-100..100, light=-100..100, dry=1
+ *  (nothing applied). Returns « RRGGBB count -> RRGGBB [global-id] » per
+ *  color and the scope (selection, layers, image).
+ */
+static gboolean
+parse_hex (const gchar *hex,
+           gdouble     *rgb)
+{
+  guint v;
+
+  if (! hex || strlen (hex) < 6 || sscanf (hex, "%6x", &v) != 1)
+    return FALSE;
+
+  rgb[0] = ((v >> 16) & 0xff) / 255.0;
+  rgb[1] = ((v >>  8) & 0xff) / 255.0;
+  rgb[2] = ( v        & 0xff) / 255.0;
+
+  return TRUE;
+}
+
+static gchar *
+hex_of (const gdouble *rgb)
+{
+  return g_strdup_printf ("%02x%02x%02x",
+                          (gint) CLAMP (floor (rgb[0] * 255.0 + 0.5), 0, 255),
+                          (gint) CLAMP (floor (rgb[1] * 255.0 + 0.5), 0, 255),
+                          (gint) CLAMP (floor (rgb[2] * 255.0 + 0.5), 0, 255));
+}
+
+static GimpValueArray *
+vobjects_recolor_invoker (GimpProcedure         *procedure,
+                          Gimp                  *gimp,
+                          GimpContext           *context,
+                          GimpProgress          *progress,
+                          const GimpValueArray  *args,
+                          GError               **error)
+{
+  GimpImage       *image  = ARG_OBJECT (0);
+  const gchar     *spec   = g_value_get_string (gimp_value_array_index (args, 1));
+  ChopGimpRecolor *rc     = image ? chopgimp_recolor_new (image) : NULL;
+  GString         *out    = g_string_new (NULL);
+  gboolean         done   = FALSE;
+  gchar          **items  = g_strsplit (spec ? spec : "", ";", -1);
+  gdouble          hue = 0, sat = 0, light = 0;
+  gboolean         dry    = FALSE;
+  gint             harmony = 0;
+  gdouble          base[3];
+  gboolean         has_base = FALSE;
+  GimpValueArray  *return_vals;
+  static const gchar *scopes[] = { "selection", "layers", "image" };
+
+  for (gint i = 0; rc && items[i]; i++)
+    {
+      gchar *key = g_strstrip (items[i]);
+      gchar *val = strchr (key, '=');
+
+      if (! val)
+        {
+          *key = '\0';   /* ignored below */
+          continue;
+        }
+      *val++ = '\0';
+
+      if (! strcmp (key, "base"))
+        has_base = parse_hex (val, base);
+    }
+
+  for (gint i = 0; rc && items[i]; i++)
+    {
+      const gchar *key = items[i];
+      const gchar *val = key + strlen (key) + 1;
+
+      if (! *key)
+        continue;
+
+      if (! strcmp (key, "map"))
+        {
+          gchar **pairs = g_strsplit (val, ",", -1);
+
+          for (gint k = 0; pairs[k]; k++)
+            {
+              gchar  **ft = g_strsplit (pairs[k], ">", 2);
+              gdouble  from[3], to[3];
+              gint     idx;
+
+              if (ft[0] && ft[1] && parse_hex (ft[0], from) && parse_hex (ft[1], to) &&
+                  (idx = chopgimp_recolor_find (rc, from)) >= 0)
+                chopgimp_recolor_set_target (rc, idx, to);
+
+              g_strfreev (ft);
+            }
+
+          g_strfreev (pairs);
+        }
+      else if (! strcmp (key, "harmony"))
+        harmony = atoi (val);
+      else if (! strcmp (key, "reduce"))
+        {
+          if (harmony > 0)
+            chopgimp_recolor_harmony (rc, harmony - 1, has_base ? base : NULL);
+          harmony = 0;
+          chopgimp_recolor_reduce (rc, atoi (val));
+        }
+      else if (! strcmp (key, "globals"))
+        {
+          if (atoi (val))
+            chopgimp_recolor_assign_globals (rc);
+        }
+      else if (! strcmp (key, "hue"))
+        hue = g_ascii_strtod (val, NULL);
+      else if (! strcmp (key, "sat"))
+        sat = g_ascii_strtod (val, NULL) / 100.0;
+      else if (! strcmp (key, "light"))
+        light = g_ascii_strtod (val, NULL) / 100.0;
+      else if (! strcmp (key, "dry"))
+        dry = atoi (val) != 0;
+    }
+
+  if (rc)
+    {
+      if (harmony > 0)
+        chopgimp_recolor_harmony (rc, harmony - 1, has_base ? base : NULL);
+
+      chopgimp_recolor_set_adjust (rc, hue, sat, light);
+
+      g_string_append_printf (out, "scope %s objects %d\n",
+                              scopes[chopgimp_recolor_get_scope (rc)],
+                              chopgimp_recolor_get_n_objects (rc));
+
+      for (gint i = 0; i < chopgimp_recolor_get_n_colors (rc); i++)
+        {
+          ChopGimpRecolorColor *c = chopgimp_recolor_get_color (rc, i);
+          gdouble               rgb[3];
+          gchar                *a, *b;
+
+          chopgimp_recolor_get_final (rc, i, rgb);
+          a = hex_of (c->rgb);
+          b = hex_of (rgb);
+          g_string_append_printf (out, "%s %d -> %s%s%s %s\n", a, c->count, b,
+                                  c->global_id ? " " : "",
+                                  c->global_id ? c->global_id : "",
+                                  chopgimp_recolor_group_name (c->group));
+          g_free (a);
+          g_free (b);
+        }
+
+      if (! dry)
+        {
+          done = chopgimp_recolor_commit (rc);
+
+          if (done)
+            gimp_image_flush (image);
+        }
+
+      chopgimp_recolor_free (rc);
+    }
+
+  g_strfreev (items);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), done);
+  g_value_take_string (gimp_value_array_index (return_vals, 2), g_string_free (out, FALSE));
+
+  return return_vals;
+}
+
+/*  the selected objects of the active vector layer follow a global color
+ *  (@which: 1 fill, 2 stroke, 3 both; @id empty: unlinked)
+ */
+static GimpValueArray *
+vobjects_link_global_invoker (GimpProcedure         *procedure,
+                              Gimp                  *gimp,
+                              GimpContext           *context,
+                              GimpProgress          *progress,
+                              const GimpValueArray  *args,
+                              GError               **error)
+{
+  GimpImage       *image = ARG_OBJECT (0);
+  gint             which = ARG_INT (1);
+  const gchar     *id    = g_value_get_string (gimp_value_array_index (args, 2));
+  GimpVectorLayer *layer = image ? chopgimp_vobjects_get_target_layer (image) : NULL;
+  gint             n     = 0;
+  GimpValueArray  *return_vals;
+
+  if (layer)
+    n = chopgimp_vobjects_link_global (layer, which, (id && *id) ? id : NULL, TRUE);
+
+  if (n > 0)
+    gimp_image_flush (image);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_int (gimp_value_array_index (return_vals, 1), n);
+
+  return return_vals;
+}
