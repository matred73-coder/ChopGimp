diff --git a/app/dialogs/chopgimp-recolor-dialog.c b/app/dialogs/chopgimp-recolor-dialog.c
new file mode 100644
index 0000000..35bc0a9
--- /dev/null
+++ b/app/dialogs/chopgimp-recolor-dialog.c
@@ -0,0 +1,814 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-recolor-dialog.c — ChopGimp 3.27.2 (lot V6 point 2): « Objet >
+ * Redéfinir les couleurs… » (Illustrator's Recolor Artwork)
