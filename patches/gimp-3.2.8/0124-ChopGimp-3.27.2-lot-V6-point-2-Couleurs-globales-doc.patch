+gint                   chopgimp_vobjects_link_global (GimpVectorLayer *layer,
+                                                      ChopGimpVLink    which,
+                                                      const gchar     *id,
+                                                      gboolean         push_undo);
+/*  the global color followed by the primary fill / stroke of the first
+ *  selected object, or NULL
+ */
+const gchar          * chopgimp_vobjects_get_global  (GimpVectorLayer *layer,
+                                                      ChopGimpVLink    which);
+
+
+G_END_DECLS
