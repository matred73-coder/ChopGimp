+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*    Redéfinir les couleurs
+ *    6 couleurs dans 4 objets (la sélection)
+ *
+ *    Harmonie [Aucune ▾]  Base [■▾]
+ *    Réduire à [3] couleurs [Réduire]   [Assigner les couleurs globales]
+ *    ── Rouges ──────────────────────────
+ *    ■ ×3   →   [■▾] ◆ Bleu marque   ↺
+ *    ■ ×1   →   [■▾]                  ↺
+ *    ── Neutres ─────────────────────────
+ *    …
+ *    Teinte ─────●───── 0°  Saturation … Luminosité …
+ *    [✓] Aperçu            [Réinitialiser] [Annuler] [Valider]
+ *
+ *  The new color [■▾] opens a popover: the global colors of the image
+ *  (a click links the color to it), « Couleur libre », and a color
+ *  selector. The preview applies the new colors to the objects with no
+ *  undo step; Valider is ONE undo step, Annuler puts everything back.
+ *  The dialog is modal: the objects cannot change under the preview.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpcolor/gimpcolor.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "dialogs-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpcontext.h"
+#include "core/gimpimage.h"
+
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vcolors.h"
+#include "path/chopgimp-vrecolor.h"
+
+#include "widgets/gimphelp-ids.h"
+#include "widgets/chopgimp-global-colors-editor.h"
+
+#include "chopgimp-recolor-dialog.h"
+
+#include "gimp-intl.h"
+
+
+typedef struct _Dialog Dialog;
+
+typedef struct
+{
+  Dialog    *dialog;
+  gint       index;
+  GtkWidget *new_area;
+  GtkWidget *global_label;
+  GtkWidget *reset;
+  GtkWidget *selection;    /* in the popover, made on demand */
+} Row;
+
+struct _Dialog
+{
+  GimpImage       *image;
+  GimpContext     *context;
+  ChopGimpRecolor *rc;
+  GtkWidget       *dialog;
+  GtkWidget       *harmony;
+  GtkWidget       *base_area;
+  GeglColor       *base;
+  GtkWidget       *reduce;
+  GtkWidget       *globals_button;
+  GtkWidget       *preview;
+  GtkAdjustment   *hue;
+  GtkAdjustment   *sat;
+  GtkAdjustment   *light;
+  GPtrArray       *rows;       /* Row * */
+  gboolean         loading;
+  guint            idle_id;
+};
+
+
+static GeglColor *
+color_of (const gdouble *rgb)
+{
+  GeglColor *color = gegl_color_new (NULL);
+
+  gegl_color_set_pixel (color, babl_format ("R'G'B' double"), rgb);
+
+  return color;
+}
+
+static void
+rgb_of (GeglColor *color,
+        gdouble   *rgb)
+{
+  gegl_color_get_pixel (color, babl_format ("R'G'B' double"), rgb);
+}
+
+
+/*  ─── updates ───────────────────────────────────────────────────────── */
+
+static gboolean
+preview_idle (gpointer data)
+{
+  Dialog *d = data;
+
+  d->idle_id = 0;
+
+  if (gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (d->preview)))
+    chopgimp_recolor_preview (d->rc);
+  else
+    chopgimp_recolor_revert (d->rc);
+
+  gimp_image_flush (d->image);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+dialog_rows_update (Dialog *d)
+{
+  for (guint i = 0; i < d->rows->len; i++)
+    {
+      Row                  *r = g_ptr_array_index (d->rows, i);
+      ChopGimpRecolorColor *c = chopgimp_recolor_get_color (d->rc, r->index);
+      const ChopGimpVColor *g = c->global_id ? chopgimp_vcolors_lookup (d->image, c->global_id)
+                                             : NULL;
+      gdouble               rgb[3];
+      GeglColor            *color;
+
+      chopgimp_recolor_get_final (d->rc, r->index, rgb);
+      color = color_of (rgb);
+      gimp_color_area_set_color (GIMP_COLOR_AREA (r->new_area), color);
+      g_object_unref (color);
+
+      if (g)
+        {
+          gchar *text = g_strdup_printf ("◆ %s", g->name);
+
+          gtk_label_set_text (GTK_LABEL (r->global_label), text);
+          g_free (text);
+        }
+      else
+        {
+          gtk_label_set_text (GTK_LABEL (r->global_label), "");
+        }
+
+      gtk_widget_set_sensitive (r->reset, c->has_target || c->global_id);
+    }
+}
+
+static void
+dialog_changed (Dialog *d)
+{
+  dialog_rows_update (d);
+
+  if (! d->idle_id)
+    d->idle_id = g_idle_add (preview_idle, d);
+}
+
+
+/*  ─── a row ─────────────────────────────────────────────────────────── */
+
+static void
+row_selection_changed (GimpColorSelection *selection,
+                       Row                *r)
+{
+  Dialog    *d = r->dialog;
+  GeglColor *color;
+  gdouble    rgb[3];
+
+  if (d->loading)
+    return;
+
+  color = gimp_color_selection_get_color (selection);
+  rgb_of (color, rgb);
+  g_object_unref (color);
+
+  chopgimp_recolor_set_final (d->rc, r->index, rgb);
+  dialog_changed (d);
+}
+
+static void
+row_global_clicked (GtkButton *button,
+                    Row       *r)
+{
+  const gchar *id      = g_object_get_data (G_OBJECT (button), "chopgimp-global");
+  GtkWidget   *popover = gtk_widget_get_ancestor (GTK_WIDGET (button), GTK_TYPE_POPOVER);
+
+  chopgimp_recolor_set_global (r->dialog->rc, r->index, id);
+
+  /*  « Couleur libre »: the color stays what it was  */
+  if (! id)
+    {
+      ChopGimpRecolorColor *c = chopgimp_recolor_get_color (r->dialog->rc, r->index);
+
+      if (c->has_target)
+        chopgimp_recolor_set_target (r->dialog->rc, r->index, c->target);
+    }
+
+  dialog_changed (r->dialog);
+
+  if (popover)
+    gtk_popover_popdown (GTK_POPOVER (popover));
+}
+
+static void
+row_popover_show (GtkWidget *popover,
+                  Row       *r)
+{
+  Dialog               *d   = r->dialog;
+  ChopGimpRecolorColor *c   = chopgimp_recolor_get_color (d->rc, r->index);
+  GtkWidget            *old = gtk_bin_get_child (GTK_BIN (popover));
+  GtkWidget            *vbox;
+  GtkWidget            *grid;
+  GtkWidget            *button;
+  GtkWidget            *label;
+  GList                *globals;
+  GeglColor            *color;
+  gdouble               rgb[3];
+  gint                  i = 0;
+
+  if (old)
+    gtk_widget_destroy (old);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_container_set_border_width (GTK_CONTAINER (vbox), 8);
+
+  globals = chopgimp_vcolors_list (d->image);
+
+  label = gtk_label_new (_("Couleurs globales"));
+  gtk_widget_set_halign (label, GTK_ALIGN_START);
+  gtk_style_context_add_class (gtk_widget_get_style_context (label), "dim-label");
+  gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 0);
+
+  grid = gtk_grid_new ();
+  gtk_box_pack_start (GTK_BOX (vbox), grid, FALSE, FALSE, 0);
+
+  for (GList *l = globals; l; l = l->next, i++)
+    {
+      const ChopGimpVColor *g = l->data;
+
+      button = gtk_button_new ();
+      gtk_container_add (GTK_CONTAINER (button), chopgimp_global_swatch_new (g->color, 18));
+      gtk_button_set_relief (GTK_BUTTON (button),
+                             ! g_strcmp0 (g->id, c->global_id) ? GTK_RELIEF_NORMAL
+                                                               : GTK_RELIEF_NONE);
+      gimp_help_set_help_data (button, g->name, NULL);
+      g_object_set_data_full (G_OBJECT (button), "chopgimp-global", g_strdup (g->id), g_free);
+      g_signal_connect (button, "clicked", G_CALLBACK (row_global_clicked), r);
+      gtk_grid_attach (GTK_GRID (grid), button, i % 10, i / 10, 1, 1);
+    }
+
+  if (! globals)
+    {
+      label = gtk_label_new (_("Aucune dans ce document (panneau Couleurs globales)"));
+      gtk_widget_set_halign (label, GTK_ALIGN_START);
+      gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 0);
+    }
+
+  g_list_free (globals);
+
+  if (c->global_id)
+    {
+      button = gtk_button_new_with_label (_("Couleur libre (ne plus suivre la couleur globale)"));
+      g_signal_connect (button, "clicked", G_CALLBACK (row_global_clicked), r);
+      gtk_box_pack_start (GTK_BOX (vbox), button, FALSE, FALSE, 0);
+    }
+
+  r->selection = gimp_color_selection_new ();
+  gimp_color_selection_set_show_alpha (GIMP_COLOR_SELECTION (r->selection), FALSE);
+
+  d->loading = TRUE;
+  color = color_of (c->rgb);
+  gimp_color_selection_set_old_color (GIMP_COLOR_SELECTION (r->selection), color);
+  g_object_unref (color);
+  chopgimp_recolor_get_final (d->rc, r->index, rgb);
+  color = color_of (rgb);
+  gimp_color_selection_set_color (GIMP_COLOR_SELECTION (r->selection), color);
+  g_object_unref (color);
+  d->loading = FALSE;
+
+  g_signal_connect (r->selection, "color-changed",
+                    G_CALLBACK (row_selection_changed), r);
+  gtk_box_pack_start (GTK_BOX (vbox), r->selection, FALSE, FALSE, 0);
+
+  gtk_container_add (GTK_CONTAINER (popover), vbox);
+  gtk_widget_show_all (vbox);
+}
+
+static void
+row_reset_clicked (GtkButton *button,
+                   Row       *r)
+{
+  chopgimp_recolor_set_target (r->dialog->rc, r->index, NULL);
+  dialog_changed (r->dialog);
+}
+
+static void
+row_use_as_base (GtkButton *button,
+                 Row       *r)
+{
+  Dialog               *d = r->dialog;
+  ChopGimpRecolorColor *c = chopgimp_recolor_get_color (d->rc, r->index);
+
+  g_clear_object (&d->base);
+  d->base = color_of (c->rgb);
+  gimp_color_area_set_color (GIMP_COLOR_AREA (d->base_area), d->base);
+
+  /*  the harmony follows its new base  */
+  if (gtk_combo_box_get_active (GTK_COMBO_BOX (d->harmony)) > 0)
+    g_signal_emit_by_name (d->harmony, "changed");
+}
+
+static GtkWidget *
+row_new (Dialog *d,
+         gint    index)
+{
+  ChopGimpRecolorColor *c   = chopgimp_recolor_get_color (d->rc, index);
+  Row                  *r   = g_new0 (Row, 1);
+  GtkWidget            *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  GtkWidget            *button;
+  GtkWidget            *area;
+  GtkWidget            *label;
+  GtkWidget            *popover;
+  GeglColor            *color;
+  gchar                *text;
+
+  r->dialog = d;
+  r->index  = index;
+  g_ptr_array_add (d->rows, r);
+  g_object_set_data_full (G_OBJECT (box), "chopgimp-row", r, g_free);
+
+  /*  the current color (a click: the base of the harmonies)  */
+  button = gtk_button_new ();
+  gtk_button_set_relief (GTK_BUTTON (button), GTK_RELIEF_NONE);
+  color = color_of (c->rgb);
+  area  = gimp_color_area_new (color, GIMP_COLOR_AREA_FLAT, 0);
+  g_object_unref (color);
+  gtk_widget_set_size_request (area, 36, 18);
+  gtk_container_add (GTK_CONTAINER (button), area);
+  gimp_help_set_help_data (button, _("Couleur actuelle (un clic : base des harmonies)"), NULL);
+  g_signal_connect (button, "clicked", G_CALLBACK (row_use_as_base), r);
+  gtk_box_pack_start (GTK_BOX (box), button, FALSE, FALSE, 0);
+
+  text  = g_strdup_printf ("×%d", c->count);
+  label = gtk_label_new (text);
+  g_free (text);
+  gtk_label_set_width_chars (GTK_LABEL (label), 4);
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (label), "dim-label");
+  gimp_help_set_help_data (label, _("Nombre d'utilisations (fonds, contours, arrêts de "
+                                    "dégradé)"), NULL);
+  gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+
+  if (c->orig_global)
+    {
+      const ChopGimpVColor *g = chopgimp_vcolors_lookup (d->image, c->orig_global);
+
+      label = gtk_label_new ("◆");
+      gimp_help_set_help_data (label, g ? g->name : _("Couleur globale"), NULL);
+      gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+    }
+
+  gtk_box_pack_start (GTK_BOX (box), gtk_label_new ("→"), FALSE, FALSE, 0);
+
+  /*  the new color  */
+  button = gtk_menu_button_new ();
+  color  = color_of (c->rgb);
+  r->new_area = gimp_color_area_new (color, GIMP_COLOR_AREA_FLAT, 0);
+  g_object_unref (color);
+  gtk_widget_set_size_request (r->new_area, 48, 18);
+  gtk_container_add (GTK_CONTAINER (button), r->new_area);
+  gimp_help_set_help_data (button, _("Nouvelle couleur : une couleur globale ou une "
+                                     "couleur libre"), NULL);
+  popover = gtk_popover_new (button);
+  gtk_menu_button_set_popover (GTK_MENU_BUTTON (button), popover);
+  g_signal_connect (popover, "show", G_CALLBACK (row_popover_show), r);
+  gtk_box_pack_start (GTK_BOX (box), button, FALSE, FALSE, 0);
+
+  r->global_label = gtk_label_new ("");
+  gtk_label_set_xalign (GTK_LABEL (r->global_label), 0.0);
+  gtk_label_set_ellipsize (GTK_LABEL (r->global_label), PANGO_ELLIPSIZE_END);
+  gtk_box_pack_start (GTK_BOX (box), r->global_label, TRUE, TRUE, 0);
+
+  r->reset = gtk_button_new_from_icon_name (GIMP_ICON_RESET, GTK_ICON_SIZE_MENU);
+  gtk_button_set_relief (GTK_BUTTON (r->reset), GTK_RELIEF_NONE);
+  gimp_help_set_help_data (r->reset, _("Garder la couleur actuelle"), NULL);
+  g_signal_connect (r->reset, "clicked", G_CALLBACK (row_reset_clicked), r);
+  gtk_box_pack_end (GTK_BOX (box), r->reset, FALSE, FALSE, 0);
+
+  return box;
+}
+
+
+/*  ─── options ───────────────────────────────────────────────────────── */
+
+static void
+harmony_changed (GtkComboBox *combo,
+                 Dialog      *d)
+{
+  gint    h = gtk_combo_box_get_active (combo);
+  gdouble rgb[3];
+
+  if (d->loading)
+    return;
+
+  if (h <= 0)
+    {
+      for (gint i = 0; i < chopgimp_recolor_get_n_colors (d->rc); i++)
+        chopgimp_recolor_set_target (d->rc, i, NULL);
+    }
+  else
+    {
+      if (d->base)
+        rgb_of (d->base, rgb);
+
+      chopgimp_recolor_harmony (d->rc, h - 1, d->base ? rgb : NULL);
+    }
+
+  dialog_changed (d);
+}
+
+static void
+base_selection_changed (GimpColorSelection *selection,
+                        Dialog             *d)
+{
+  g_clear_object (&d->base);
+  d->base = gimp_color_selection_get_color (selection);
+  gimp_color_area_set_color (GIMP_COLOR_AREA (d->base_area), d->base);
+
+  if (gtk_combo_box_get_active (GTK_COMBO_BOX (d->harmony)) > 0)
+    harmony_changed (GTK_COMBO_BOX (d->harmony), d);
+}
+
+static void
+base_popover_show (GtkWidget *popover,
+                   Dialog    *d)
+{
+  GtkWidget *old = gtk_bin_get_child (GTK_BIN (popover));
+  GtkWidget *sel;
+
+  if (old)
+    gtk_widget_destroy (old);
+
+  sel = gimp_color_selection_new ();
+  gimp_color_selection_set_show_alpha (GIMP_COLOR_SELECTION (sel), FALSE);
+  gtk_container_set_border_width (GTK_CONTAINER (sel), 8);
+
+  if (d->base)
+    {
+      gimp_color_selection_set_old_color (GIMP_COLOR_SELECTION (sel), d->base);
+      gimp_color_selection_set_color (GIMP_COLOR_SELECTION (sel), d->base);
+    }
+
+  g_signal_connect (sel, "color-changed", G_CALLBACK (base_selection_changed), d);
+  gtk_container_add (GTK_CONTAINER (popover), sel);
+  gtk_widget_show_all (sel);
+}
+
+static void
+reduce_clicked (GtkButton *button,
+                Dialog    *d)
+{
+  chopgimp_recolor_reduce (d->rc,
+                           gtk_spin_button_get_value_as_int (GTK_SPIN_BUTTON (d->reduce)));
+  dialog_changed (d);
+}
+
+static void
+globals_clicked (GtkButton *button,
+                 Dialog    *d)
+{
+  chopgimp_recolor_assign_globals (d->rc);
+  dialog_changed (d);
+}
+
+static void
+adjust_changed (GtkAdjustment *adj,
+                Dialog        *d)
+{
+  if (d->loading)
+    return;
+
+  chopgimp_recolor_set_adjust (d->rc,
+                               gtk_adjustment_get_value (d->hue),
+                               gtk_adjustment_get_value (d->sat)   / 100.0,
+                               gtk_adjustment_get_value (d->light) / 100.0);
+  dialog_changed (d);
+}
+
+static void
+preview_toggled (GtkToggleButton *toggle,
+                 Dialog          *d)
+{
+  dialog_changed (d);
+}
+
+#define RESPONSE_RESET 1
+
+static void
+dialog_response (GtkWidget *widget,
+                 gint       response,
+                 Dialog    *d)
+{
+  if (response == RESPONSE_RESET)
+    {
+      d->loading = TRUE;
+      chopgimp_recolor_reset (d->rc);
+      gtk_combo_box_set_active (GTK_COMBO_BOX (d->harmony), 0);
+      gtk_adjustment_set_value (d->hue,   0.0);
+      gtk_adjustment_set_value (d->sat,   0.0);
+      gtk_adjustment_set_value (d->light, 0.0);
+      d->loading = FALSE;
+      dialog_changed (d);
+      return;
+    }
+
+  if (d->idle_id)
+    {
+      g_source_remove (d->idle_id);
+      d->idle_id = 0;
+    }
+
+  if (response == GTK_RESPONSE_OK)
+    {
+      chopgimp_recolor_commit (d->rc);
+    }
+  else
+    {
+      chopgimp_recolor_revert (d->rc);
+    }
+
+  gimp_image_flush (d->image);
+
+  gtk_widget_destroy (widget);
+}
+
+static void
+dialog_free (Dialog *d)
+{
+  if (d->idle_id)
+    g_source_remove (d->idle_id);
+
+  /*  reverts an uncommitted preview  */
+  chopgimp_recolor_free (d->rc);
+
+  g_ptr_array_free (d->rows, TRUE);
+  g_clear_object (&d->base);
+  g_object_unref (d->image);
+  g_free (d);
+}
+
+
+/*  ─── the dialog ────────────────────────────────────────────────────── */
+
+void
+chopgimp_recolor_dialog_show (GimpImage   *image,
+                              GimpContext *context,
+                              GtkWidget   *parent)
+{
+  ChopGimpRecolor *rc;
+  Dialog          *d;
+  GtkWidget       *vbox;
+  GtkWidget       *hbox;
+  GtkWidget       *grid;
+  GtkWidget       *label;
+  GtkWidget       *button;
+  GtkWidget       *popover;
+  GtkWidget       *scrolled;
+  GtkWidget       *list;
+  GtkWidget       *scale;
+  GList           *globals;
+  gchar           *text;
+  gint             n_colors;
+  gint             group = -1;
+  static const gchar *scopes[] =
+  {
+    N_("les objets sélectionnés"),
+    N_("les calques vectoriels sélectionnés"),
+    N_("tous les calques vectoriels")
+  };
+
+  g_return_if_fail (GIMP_IS_IMAGE (image));
+
+  if (! chopgimp_vobjects_enabled ())
+    return;
+
+  rc = chopgimp_recolor_new (image);
+
+  if (! rc)
+    {
+      gimp_message_literal (image->gimp, parent ? G_OBJECT (parent) : NULL,
+                            GIMP_MESSAGE_INFO,
+                            _("Redéfinir les couleurs : aucune couleur à redéfinir "
+                              "(sélectionnez des objets d'un calque vectoriel, ou "
+                              "un calque vectoriel)."));
+      return;
+    }
+
+  n_colors = chopgimp_recolor_get_n_colors (rc);
+
+  d          = g_new0 (Dialog, 1);
+  d->image   = g_object_ref (image);
+  d->context = context;
+  d->rc      = rc;
+  d->rows    = g_ptr_array_new ();
+
+  d->dialog = gimp_dialog_new (_("Redéfinir les couleurs"),
+                               "chopgimp-recolor",
+                               parent ? gtk_widget_get_toplevel (parent) : NULL,
+                               GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
+                               gimp_standard_help_func, GIMP_HELP_PATH_DIALOG,
+
+                               _("_Réinitialiser"), RESPONSE_RESET,
+                               _("_Annuler"),       GTK_RESPONSE_CANCEL,
+                               _("_Valider"),       GTK_RESPONSE_OK,
+
+                               NULL);
+
+  gimp_dialog_set_alternative_button_order (GTK_DIALOG (d->dialog),
+                                            RESPONSE_RESET,
+                                            GTK_RESPONSE_OK,
+                                            GTK_RESPONSE_CANCEL,
+                                            -1);
+  gtk_window_set_default_size (GTK_WINDOW (d->dialog), 460, 600);
+
+  g_object_set_data_full (G_OBJECT (d->dialog), "chopgimp-recolor", d,
+                          (GDestroyNotify) dialog_free);
+  g_signal_connect (d->dialog, "response", G_CALLBACK (dialog_response), d);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 8);
+  gtk_container_set_border_width (GTK_CONTAINER (vbox), 12);
+  gtk_box_pack_start (GTK_BOX (gtk_dialog_get_content_area (GTK_DIALOG (d->dialog))),
+                      vbox, TRUE, TRUE, 0);
+
+  text = g_strdup_printf (n_colors > 1 ? _("%d couleurs dans %d objet(s) : %s") :
+                                         _("%d couleur dans %d objet(s) : %s"),
+                          n_colors, chopgimp_recolor_get_n_objects (rc),
+                          _(scopes[chopgimp_recolor_get_scope (rc)]));
+  label = gtk_label_new (text);
+  g_free (text);
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 0);
+
+  /*  options  */
+  grid = gtk_grid_new ();
+  gtk_grid_set_row_spacing (GTK_GRID (grid), 6);
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 6);
+  gtk_box_pack_start (GTK_BOX (vbox), grid, FALSE, FALSE, 0);
+
+  label = gtk_label_new (_("Harmonie"));
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_grid_attach (GTK_GRID (grid), label, 0, 0, 1, 1);
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  gtk_grid_attach (GTK_GRID (grid), hbox, 1, 0, 1, 1);
+
+  d->harmony = gtk_combo_box_text_new ();
+  gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (d->harmony), _("Aucune"));
+  {
+    const gchar * const *names = chopgimp_recolor_harmony_names ();
+
+    for (gint i = 0; names[i]; i++)
+      gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (d->harmony), names[i]);
+  }
+  gtk_combo_box_set_active (GTK_COMBO_BOX (d->harmony), 0);
+  gimp_help_set_help_data (d->harmony, _("Les groupes de teintes suivent l'harmonie "
+                                         "(roue chromatique) bâtie sur la couleur de "
+                                         "base ; chaque couleur garde sa saturation et "
+                                         "sa luminosité"), NULL);
+  g_signal_connect (d->harmony, "changed", G_CALLBACK (harmony_changed), d);
+  gtk_box_pack_start (GTK_BOX (hbox), d->harmony, FALSE, FALSE, 0);
+
+  gtk_box_pack_start (GTK_BOX (hbox), gtk_label_new (_("Base")), FALSE, FALSE, 0);
+
+  button = gtk_menu_button_new ();
+  {
+    ChopGimpRecolorColor *top = chopgimp_recolor_get_color (rc, 0);
+
+    /*  the most used color of a hue (else the first one)  */
+    for (gint i = 0; i < n_colors; i++)
+      {
+        ChopGimpRecolorColor *c = chopgimp_recolor_get_color (rc, i);
+
+        if (c->group < CHOPGIMP_RECOLOR_N_GROUPS - 1 &&
+            (top->group == CHOPGIMP_RECOLOR_N_GROUPS - 1 || c->count > top->count))
+          top = c;
+      }
+
+    d->base = color_of (top->rgb);
+  }
+  d->base_area = gimp_color_area_new (d->base, GIMP_COLOR_AREA_FLAT, 0);
+  gtk_widget_set_size_request (d->base_area, 36, 18);
+  gtk_container_add (GTK_CONTAINER (button), d->base_area);
+  gimp_help_set_help_data (button, _("Couleur de base des harmonies (ou un clic sur "
+                                     "une couleur actuelle)"), NULL);
+  popover = gtk_popover_new (button);
+  gtk_menu_button_set_popover (GTK_MENU_BUTTON (button), popover);
+  g_signal_connect (popover, "show", G_CALLBACK (base_popover_show), d);
+  gtk_box_pack_start (GTK_BOX (hbox), button, FALSE, FALSE, 0);
+
+  label = gtk_label_new (_("Réduire à"));
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_grid_attach (GTK_GRID (grid), label, 0, 1, 1, 1);
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  gtk_grid_attach (GTK_GRID (grid), hbox, 1, 1, 1, 1);
+
+  d->reduce = gtk_spin_button_new_with_range (1, MAX (1, n_colors), 1);
+  gtk_spin_button_set_value (GTK_SPIN_BUTTON (d->reduce), MAX (1, MIN (n_colors - 1, 3)));
+  gtk_box_pack_start (GTK_BOX (hbox), d->reduce, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (hbox), gtk_label_new (_("couleurs")), FALSE, FALSE, 0);
+
+  button = gtk_button_new_with_label (_("Réduire"));
+  gimp_help_set_help_data (button, _("Regrouper les couleurs proches (k-moyennes dans "
+                                     "l'espace Lab) : chaque groupe prend sa couleur la "
+                                     "plus utilisée"), NULL);
+  g_signal_connect (button, "clicked", G_CALLBACK (reduce_clicked), d);
+  gtk_box_pack_start (GTK_BOX (hbox), button, FALSE, FALSE, 0);
+
+  globals = chopgimp_vcolors_list (image);
+  d->globals_button = gtk_button_new_with_label (_("Assigner les couleurs globales"));
+  gimp_help_set_help_data (d->globals_button,
+                           globals ? _("Chaque couleur devient la couleur globale la plus "
+                                       "proche, et les objets la suivent") :
+                                     _("Aucune couleur globale dans ce document (panneau "
+                                       "Couleurs globales)"), NULL);
+  gtk_widget_set_sensitive (d->globals_button, globals != NULL);
+  g_signal_connect (d->globals_button, "clicked", G_CALLBACK (globals_clicked), d);
+  gtk_box_pack_start (GTK_BOX (hbox), d->globals_button, FALSE, FALSE, 0);
+  g_list_free (globals);
+
+  /*  the colors, by hue  */
+  scrolled = gtk_scrolled_window_new (NULL, NULL);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled),
+                                  GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_scrolled_window_set_shadow_type (GTK_SCROLLED_WINDOW (scrolled), GTK_SHADOW_IN);
+  gtk_box_pack_start (GTK_BOX (vbox), scrolled, TRUE, TRUE, 0);
+
+  list = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+  gtk_container_set_border_width (GTK_CONTAINER (list), 6);
+  gtk_container_add (GTK_CONTAINER (scrolled), list);
+
+  for (gint i = 0; i < n_colors; i++)
+    {
+      ChopGimpRecolorColor *c = chopgimp_recolor_get_color (rc, i);
+
+      if (c->group != group)
+        {
+          gchar *markup;
+
+          group  = c->group;
+          markup = g_markup_printf_escaped ("<b>%s</b>", chopgimp_recolor_group_name (group));
+          label  = gtk_label_new (NULL);
+          gtk_label_set_markup (GTK_LABEL (label), markup);
+          g_free (markup);
+          gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+          gtk_widget_set_margin_top (label, i > 0 ? 6 : 0);
+          gtk_box_pack_start (GTK_BOX (list), label, FALSE, FALSE, 0);
+        }
+
+      gtk_box_pack_start (GTK_BOX (list), row_new (d, i), FALSE, FALSE, 0);
+    }
+
+  /*  global shifts  */
+  d->hue   = gtk_adjustment_new (0.0, -180.0, 180.0, 1.0, 15.0, 0.0);
+  d->sat   = gtk_adjustment_new (0.0, -100.0, 100.0, 1.0, 10.0, 0.0);
+  d->light = gtk_adjustment_new (0.0, -100.0, 100.0, 1.0, 10.0, 0.0);
+
+  scale = gimp_spin_scale_new (d->hue, _("Teinte (°)"), 0);
+  gtk_box_pack_start (GTK_BOX (vbox), scale, FALSE, FALSE, 0);
+  scale = gimp_spin_scale_new (d->sat, _("Saturation (%)"), 0);
+  gtk_box_pack_start (GTK_BOX (vbox), scale, FALSE, FALSE, 0);
+  scale = gimp_spin_scale_new (d->light, _("Luminosité (%)"), 0);
+  gtk_box_pack_start (GTK_BOX (vbox), scale, FALSE, FALSE, 0);
+
+  g_signal_connect (d->hue,   "value-changed", G_CALLBACK (adjust_changed), d);
+  g_signal_connect (d->sat,   "value-changed", G_CALLBACK (adjust_changed), d);
+  g_signal_connect (d->light, "value-changed", G_CALLBACK (adjust_changed), d);
+
+  d->preview = gtk_check_button_new_with_mnemonic (_("A_perçu"));
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (d->preview), TRUE);
+  g_signal_connect (d->preview, "toggled", G_CALLBACK (preview_toggled), d);
+  gtk_box_pack_start (GTK_BOX (vbox), d->preview, FALSE, FALSE, 0);
+
+  dialog_rows_update (d);
+
+  gtk_widget_show_all (d->dialog);
+  gtk_window_present (GTK_WINDOW (d->dialog));
+}
