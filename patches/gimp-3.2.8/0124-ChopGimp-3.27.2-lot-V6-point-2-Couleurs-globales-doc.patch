+typedef struct
+{
+  GimpVectorLayer *layer;      /* ref */
+  guint            id;
+  ChopGimpVStyle   orig;
+  gboolean         modified;   /* by the preview */
+} Target;
+
+struct _ChopGimpRecolor
+{
+  GimpImage            *image;      /* ref */
+  ChopGimpRecolorScope  scope;
+  GPtrArray            *targets;    /* Target * */
+  GPtrArray            *colors;     /* ChopGimpRecolorColor * */
+  GHashTable           *index;      /* key → index + 1 */
+  gdouble               hue, sat, light;
+  gboolean              previewed;
+};
+
+
+/*  ─── colors ────────────────────────────────────────────────────────── */
+
+static guint
+rgb_key (const gdouble *rgb)
+{
+  guint r = (guint) CLAMP (floor (rgb[0] * 255.0 + 0.5), 0, 255);
+  guint g = (guint) CLAMP (floor (rgb[1] * 255.0 + 0.5), 0, 255);
+  guint b = (guint) CLAMP (floor (rgb[2] * 255.0 + 0.5), 0, 255);
+
+  return (r << 16) | (g << 8) | b;
+}
+
+static void
+rgb_round (gdouble *rgb)
+{
+  for (gint i = 0; i < 3; i++)
+    rgb[i] = CLAMP (floor (rgb[i] * 255.0 + 0.5), 0, 255) / 255.0;
+}
+
+static void
+color_rgba (GeglColor *color,
+            gdouble   *rgba)
+{
+  gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), rgba);
+}
+
+static void
+rgb_to_hsv (const gdouble *rgb,
+            gdouble       *hsv)
+{
+  gdouble max = MAX (rgb[0], MAX (rgb[1], rgb[2]));
+  gdouble min = MIN (rgb[0], MIN (rgb[1], rgb[2]));
+  gdouble d   = max - min;
+  gdouble h   = 0.0;
+
+  if (d > 1e-12)
+    {
+      if (max == rgb[0])
+        h = fmod ((rgb[1] - rgb[2]) / d, 6.0);
+      else if (max == rgb[1])
+        h = (rgb[2] - rgb[0]) / d + 2.0;
+      else
+        h = (rgb[0] - rgb[1]) / d + 4.0;
+
+      h *= 60.0;
+      if (h < 0.0)
+        h += 360.0;
+    }
+
+  hsv[0] = h;
+  hsv[1] = max > 1e-12 ? d / max : 0.0;
+  hsv[2] = max;
+}
+
+static void
+hsv_to_rgb (const gdouble *hsv,
+            gdouble       *rgb)
+{
+  gdouble h = fmod (hsv[0], 360.0);
+  gdouble c, x, m;
+  gint    i;
+
+  if (h < 0.0)
+    h += 360.0;
+
+  c = hsv[2] * hsv[1];
+  x = c * (1.0 - fabs (fmod (h / 60.0, 2.0) - 1.0));
+  m = hsv[2] - c;
+  i = (gint) (h / 60.0) % 6;
+
+  switch (i)
+    {
+    case 0:  rgb[0] = c; rgb[1] = x; rgb[2] = 0; break;
+    case 1:  rgb[0] = x; rgb[1] = c; rgb[2] = 0; break;
+    case 2:  rgb[0] = 0; rgb[1] = c; rgb[2] = x; break;
+    case 3:  rgb[0] = 0; rgb[1] = x; rgb[2] = c; break;
+    case 4:  rgb[0] = x; rgb[1] = 0; rgb[2] = c; break;
+    default: rgb[0] = c; rgb[1] = 0; rgb[2] = x; break;
+    }
+
+  for (i = 0; i < 3; i++)
+    rgb[i] = CLAMP (rgb[i] + m, 0.0, 1.0);
+}
+
+static void
+rgb_to_hsl (const gdouble *rgb,
+            gdouble       *hsl)
+{
+  gdouble max = MAX (rgb[0], MAX (rgb[1], rgb[2]));
+  gdouble min = MIN (rgb[0], MIN (rgb[1], rgb[2]));
+  gdouble hsv[3];
+  gdouble l   = (max + min) / 2.0;
+  gdouble d   = max - min;
+
+  rgb_to_hsv (rgb, hsv);
+
+  hsl[0] = hsv[0];
+  hsl[1] = (d < 1e-12) ? 0.0 : d / (1.0 - fabs (2.0 * l - 1.0));
+  hsl[1] = CLAMP (hsl[1], 0.0, 1.0);
+  hsl[2] = l;
+}
+
+static void
+hsl_to_rgb (const gdouble *hsl,
+            gdouble       *rgb)
+{
+  gdouble c = (1.0 - fabs (2.0 * hsl[2] - 1.0)) * hsl[1];
+  gdouble hsv[3];
+
+  /*  through HSV: V = L + C / 2, S = C / V  */
+  hsv[0] = hsl[0];
+  hsv[2] = hsl[2] + c / 2.0;
+  hsv[1] = hsv[2] > 1e-12 ? c / hsv[2] : 0.0;
+
+  hsv_to_rgb (hsv, rgb);
+}
+
+static void
+rgb_to_lab (const gdouble *rgb,
+            gdouble       *lab)
+{
+  babl_process (babl_fish (babl_format ("R'G'B' double"),
+                           babl_format ("CIE Lab double")),
+                rgb, lab, 1);
+}
+
+static gdouble
+lab_dist2 (const gdouble *a,
+           const gdouble *b)
+{
+  return (a[0] - b[0]) * (a[0] - b[0]) +
+         (a[1] - b[1]) * (a[1] - b[1]) +
+         (a[2] - b[2]) * (a[2] - b[2]);
+}
+
+/*  the hue groups  */
+static const struct { gdouble from; const gchar *name; } groups[] =
+{
+  {  -15.0, N_("Rouges")   },
+  {   15.0, N_("Oranges")  },
+  {   45.0, N_("Jaunes")   },
+  {   70.0, N_("Verts")    },
+  {  165.0, N_("Cyans")    },
+  {  200.0, N_("Bleus")    },
+  {  255.0, N_("Violets")  },
+  {  290.0, N_("Roses")    },
+  {  345.0, N_("Neutres")  }   /* not a hue: grays, black, white */
+};
+
+static gint
+group_of (const gdouble *rgb)
+{
+  gdouble hsv[3];
+  gdouble h;
+
+  rgb_to_hsv (rgb, hsv);
+
+  if (hsv[1] < 0.12 || hsv[2] < 0.08)
+    return CHOPGIMP_RECOLOR_N_GROUPS - 1;
+
+  h = hsv[0] >= 345.0 ? hsv[0] - 360.0 : hsv[0];
+
+  for (gint g = CHOPGIMP_RECOLOR_N_GROUPS - 2; g > 0; g--)
+    if (h >= groups[g].from)
+      return g;
+
+  return 0;
+}
+
+const gchar *
+chopgimp_recolor_group_name (gint group)
+{
+  if (group < 0 || group >= CHOPGIMP_RECOLOR_N_GROUPS)
+    return "";
+
+  return _(groups[group].name);
+}
+
+
+/*  ─── gathering ─────────────────────────────────────────────────────── */
+
+static void
+target_free (Target *t)
+{
+  chopgimp_vstyle_clear (&t->orig);
+  g_object_unref (t->layer);
+  g_free (t);
+}
+
+static void
+color_free (ChopGimpRecolorColor *c)
+{
+  g_free (c->orig_global);
+  g_free (c->global_id);
+  g_free (c);
+}
+
+static gboolean
+layer_usable (GimpVectorLayer *layer)
+{
+  return (GIMP_IS_VECTOR_LAYER (layer) &&
+          chopgimp_vobjects_layer_is_target (layer) &&
+          chopgimp_vlayer_get_root (layer) != NULL);
+}
+
+GList *
+chopgimp_vobjects_selected_leaves (GimpVectorLayer *layer,
+                                   gboolean         all)
+{
+  GList *leaves = NULL;
+  GList *objs;
+
+  if (! layer || ! chopgimp_vlayer_get_root (layer))
+    return NULL;
+
+  if (all)
+    return chopgimp_vlayer_get_leaves (layer);
+
+  objs = chopgimp_vlayer_get_selected_objects (layer);
+
+  for (GList *o = objs; o; o = o->next)
+    leaves = g_list_concat (leaves, chopgimp_vobjects_leaves_of (o->data));
+
+  g_list_free (objs);
+
+  return leaves;
+}
+
+static void
+add_layer_targets (ChopGimpRecolor *rc,
+                   GimpVectorLayer *layer,
+                   gboolean         all)
+{
+  GList *leaves = chopgimp_vobjects_selected_leaves (layer, all);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *leaf = l->data;
+      Target          *t;
+
+      if (all && chopgimp_vobject_is_locked (leaf))
+        continue;
+
+      t        = g_new0 (Target, 1);
+      t->layer = g_object_ref (layer);
+      t->id    = leaf->id;
+      chopgimp_vstyle_init (&t->orig);
+      chopgimp_vstyle_copy (&t->orig, &leaf->style);
+      g_ptr_array_add (rc->targets, t);
+    }
+
+  g_list_free (leaves);
+}
+
+static void
+count_color (ChopGimpRecolor *rc,
+             GHashTable      *seen,
+             GeglColor       *color,
+             const gchar     *global_id)
+{
+  ChopGimpRecolorColor *c;
+  gdouble               rgba[4];
+  guint                 key;
+
+  if (! color)
+    return;
+
+  color_rgba (color, rgba);
+  key = rgb_key (rgba);
+
+  c = g_hash_table_lookup (seen, GUINT_TO_POINTER (key));
+
+  if (! c)
+    {
+      c = g_new0 (ChopGimpRecolorColor, 1);
+      c->rgb[0] = rgba[0];
+      c->rgb[1] = rgba[1];
+      c->rgb[2] = rgba[2];
+      rgb_round (c->rgb);
+      c->group = group_of (c->rgb);
+      g_hash_table_insert (seen, GUINT_TO_POINTER (key), c);
+      g_ptr_array_add (rc->colors, c);
+    }
+
+  c->count++;
+
+  /*  the global color followed by all its plain uses (0: none seen yet,
+   *  1: @orig_global, 2: mixed)
+   */
+  if (c->global_state == 0)
+    {
+      c->global_state = 1;
+      c->orig_global  = g_strdup (global_id);
+    }
+  else if (c->global_state == 1 && g_strcmp0 (c->orig_global, global_id))
+    {
+      c->global_state = 2;
+      g_clear_pointer (&c->orig_global, g_free);
+    }
+}
+
+static gint
+color_cmp (gconstpointer a,
+           gconstpointer b)
+{
+  const ChopGimpRecolorColor *x = *(ChopGimpRecolorColor **) a;
+  const ChopGimpRecolorColor *y = *(ChopGimpRecolorColor **) b;
+  gdouble                     hx[3], hy[3];
+
+  if (x->group != y->group)
+    return x->group - y->group;
+
+  if (x->count != y->count)
+    return y->count - x->count;
+
+  rgb_to_hsv (x->rgb, hx);
+  rgb_to_hsv (y->rgb, hy);
+
+  if (x->group == CHOPGIMP_RECOLOR_N_GROUPS - 1)
+    return (hy[2] > hx[2]) - (hy[2] < hx[2]);
+
+  return (hx[0] > hy[0]) - (hx[0] < hy[0]);
+}
+
+ChopGimpRecolor *
+chopgimp_recolor_new (GimpImage *image)
+{
+  ChopGimpRecolor *rc;
+  GList           *selected;
+  GList           *vlayers = NULL;
+  GHashTable      *seen;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  if (! chopgimp_vobjects_enabled ())
+    return NULL;
+
+  rc          = g_new0 (ChopGimpRecolor, 1);
+  rc->image   = g_object_ref (image);
+  rc->targets = g_ptr_array_new_with_free_func ((GDestroyNotify) target_free);
+  rc->colors  = g_ptr_array_new_with_free_func ((GDestroyNotify) color_free);
+  rc->index   = g_hash_table_new (NULL, NULL);
+
+  selected = gimp_image_get_selected_layers (image);
+
+  for (GList *l = selected; l; l = l->next)
+    if (layer_usable (l->data))
+      vlayers = g_list_append (vlayers, l->data);
+
+  if (vlayers && ! vlayers->next &&
+      chopgimp_vobjects_n_selected (vlayers->data) > 0)
+    {
+      rc->scope = CHOPGIMP_RECOLOR_SELECTION;
+      add_layer_targets (rc, vlayers->data, FALSE);
+    }
+  else if (vlayers)
+    {
+      rc->scope = CHOPGIMP_RECOLOR_LAYERS;
+
+      for (GList *l = vlayers; l; l = l->next)
+        add_layer_targets (rc, l->data, TRUE);
+    }
+  else
+    {
+      GList *all = gimp_image_get_layer_list (image);
+
+      rc->scope = CHOPGIMP_RECOLOR_IMAGE;
+
+      for (GList *l = all; l; l = l->next)
+        if (layer_usable (l->data))
+          add_layer_targets (rc, l->data, TRUE);
+
+      g_list_free (all);
+    }
+
+  g_list_free (vlayers);
+
+  /*  the distinct colors  */
+  seen = g_hash_table_new (NULL, NULL);
+
+  for (guint i = 0; i < rc->targets->len; i++)
+    {
+      Target *t = g_ptr_array_index (rc->targets, i);
+
+      for (gint k = 0; k < chopgimp_vstyle_get_n_entries (&t->orig); k++)
+        {
+          ChopGimpPaint *p = &chopgimp_vstyle_get_entry (&t->orig, k)->paint;
+
+          if (p->type == CHOPGIMP_PAINT_COLOR)
+            count_color (rc, seen, p->color, p->global_id);
+          else if ((p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+                    p->type == CHOPGIMP_PAINT_RADIAL_GRADIENT) && p->stops)
+            for (guint s = 0; s < p->stops->len; s++)
+              count_color (rc, seen,
+                           g_array_index (p->stops, ChopGimpGradientStop, s).color,
+                           NULL);
+        }
+    }
+
+  g_hash_table_destroy (seen);
+
+  if (rc->colors->len == 0)
+    {
+      chopgimp_recolor_free (rc);
+      return NULL;
+    }
+
+  g_ptr_array_sort (rc->colors, color_cmp);
+
+  for (guint i = 0; i < rc->colors->len; i++)
+    {
+      ChopGimpRecolorColor *c = g_ptr_array_index (rc->colors, i);
+
+      g_hash_table_insert (rc->index, GUINT_TO_POINTER (rgb_key (c->rgb)),
+                           GINT_TO_POINTER (i + 1));
+    }
+
+  return rc;
+}
+
+void
+chopgimp_recolor_free (ChopGimpRecolor *rc)
+{
+  if (! rc)
+    return;
+
+  chopgimp_recolor_revert (rc);
+
+  g_ptr_array_free (rc->targets, TRUE);
+  g_ptr_array_free (rc->colors, TRUE);
+  g_hash_table_destroy (rc->index);
+  g_object_unref (rc->image);
+  g_free (rc);
+}
+
+GimpImage *
+chopgimp_recolor_get_image (ChopGimpRecolor *rc)
+{
+  return rc->image;
+}
+
+ChopGimpRecolorScope
+chopgimp_recolor_get_scope (ChopGimpRecolor *rc)
+{
+  return rc->scope;
+}
+
+gint
+chopgimp_recolor_get_n_objects (ChopGimpRecolor *rc)
+{
+  return rc->targets->len;
+}
+
+gint
+chopgimp_recolor_get_n_colors (ChopGimpRecolor *rc)
+{
+  return rc->colors->len;
+}
+
+ChopGimpRecolorColor *
+chopgimp_recolor_get_color (ChopGimpRecolor *rc,
+                            gint             index)
+{
+  if (index < 0 || index >= (gint) rc->colors->len)
+    return NULL;
+
+  return g_ptr_array_index (rc->colors, index);
+}
+
+gint
+chopgimp_recolor_find (ChopGimpRecolor *rc,
+                       const gdouble   *rgb)
+{
+  return GPOINTER_TO_INT (g_hash_table_lookup (rc->index,
+                                               GUINT_TO_POINTER (rgb_key (rgb)))) - 1;
+}
+
+
+/*  ─── the new colors ────────────────────────────────────────────────── */
+
+void
+chopgimp_recolor_set_target (ChopGimpRecolor *rc,
+                             gint             index,
+                             const gdouble   *rgb)
+{
+  ChopGimpRecolorColor *c = chopgimp_recolor_get_color (rc, index);
+
+  if (! c)
+    return;
+
+  g_clear_pointer (&c->global_id, g_free);
+
+  c->has_target = (rgb != NULL);
+
+  if (rgb)
+    {
+      c->target[0] = CLAMP (rgb[0], 0.0, 1.0);
+      c->target[1] = CLAMP (rgb[1], 0.0, 1.0);
+      c->target[2] = CLAMP (rgb[2], 0.0, 1.0);
+    }
+}
+
+void
+chopgimp_recolor_set_global (ChopGimpRecolor *rc,
+                             gint             index,
+                             const gchar     *id)
+{
+  ChopGimpRecolorColor *c = chopgimp_recolor_get_color (rc, index);
+
+  if (! c)
+    return;
+
+  g_free (c->global_id);
+  c->global_id = (id && chopgimp_vcolors_lookup (rc->image, id)) ? g_strdup (id) : NULL;
+}
+
+void
+chopgimp_recolor_reset (ChopGimpRecolor *rc)
+{
+  for (guint i = 0; i < rc->colors->len; i++)
+    chopgimp_recolor_set_target (rc, i, NULL);
+
+  rc->hue = rc->sat = rc->light = 0.0;
+}
+
+void
+chopgimp_recolor_set_adjust (ChopGimpRecolor *rc,
+                             gdouble          hue,
+                             gdouble          saturation,
+                             gdouble          lightness)
+{
+  rc->hue   = CLAMP (hue, -180.0, 180.0);
+  rc->sat   = CLAMP (saturation, -1.0, 1.0);
+  rc->light = CLAMP (lightness, -1.0, 1.0);
+}
+
+/*  the new color before the global shifts  */
+static void
+color_base (ChopGimpRecolorColor *c,
+            gdouble              *rgb)
+{
+  memcpy (rgb, c->has_target ? c->target : c->rgb, sizeof (gdouble) * 3);
+}
+
+static gboolean
+global_rgb (ChopGimpRecolor *rc,
+            const gchar     *id,
+            gdouble         *rgb)
+{
+  GeglColor *color = id ? chopgimp_vcolors_get_color (rc->image, id) : NULL;
+  gdouble    rgba[4];
+
+  if (! color)
+    return FALSE;
+
+  color_rgba (color, rgba);
+  memcpy (rgb, rgba, sizeof (gdouble) * 3);
+
+  return TRUE;
+}
+
+void
+chopgimp_recolor_get_final (ChopGimpRecolor *rc,
+                            gint             index,
+                            gdouble         *rgb)
+{
+  ChopGimpRecolorColor *c = chopgimp_recolor_get_color (rc, index);
+  gdouble               hsl[3];
+
+  if (! c)
+    return;
+
+  /*  a global color is taken as it is  */
+  if (c->global_id && global_rgb (rc, c->global_id, rgb))
+    return;
+
+  color_base (c, rgb);
+
+  if (rc->hue == 0.0 && rc->sat == 0.0 && rc->light == 0.0)
+    return;
+
+  rgb_to_hsl (rgb, hsl);
+
+  hsl[0] += rc->hue;
+
+  if (rc->sat > 0.0)
+    hsl[1] += (1.0 - hsl[1]) * rc->sat;
+  else
+    hsl[1] += hsl[1] * rc->sat;
+
+  if (rc->light > 0.0)
+    hsl[2] += (1.0 - hsl[2]) * rc->light;
+  else
+    hsl[2] += hsl[2] * rc->light;
+
+  hsl[1] = CLAMP (hsl[1], 0.0, 1.0);
+  hsl[2] = CLAMP (hsl[2], 0.0, 1.0);
+
+  hsl_to_rgb (hsl, rgb);
+}
+
+static gdouble
+unshift (gdouble v,
+         gdouble a)
+{
+  if (a > 0.0)
+    return a < 1.0 ? (v - a) / (1.0 - a) : v;
+
+  if (a < 0.0)
+    return a > -1.0 ? v / (1.0 + a) : v;
+
+  return v;
+}
+
+void
+chopgimp_recolor_set_final (ChopGimpRecolor *rc,
+                            gint             index,
+                            const gdouble   *rgb)
+{
+  gdouble hsl[3];
+  gdouble target[3];
+
+  if (rc->hue == 0.0 && rc->sat == 0.0 && rc->light == 0.0)
+    {
+      chopgimp_recolor_set_target (rc, index, rgb);
+      return;
+    }
+
+  rgb_to_hsl (rgb, hsl);
+
+  hsl[0] -= rc->hue;
+  hsl[1]  = CLAMP (unshift (hsl[1], rc->sat),   0.0, 1.0);
+  hsl[2]  = CLAMP (unshift (hsl[2], rc->light), 0.0, 1.0);
+
+  hsl_to_rgb (hsl, target);
+  chopgimp_recolor_set_target (rc, index, target);
+}
+
+gboolean
+chopgimp_recolor_is_changed (ChopGimpRecolor *rc,
+                             gint             index)
+{
+  ChopGimpRecolorColor *c = chopgimp_recolor_get_color (rc, index);
+  gdouble               rgb[3];
+
+  if (! c)
+    return FALSE;
+
+  chopgimp_recolor_get_final (rc, index, rgb);
+
+  if (c->global_id && g_strcmp0 (c->global_id, c->orig_global))
+    return TRUE;
+
+  return rgb_key (rgb) != rgb_key (c->rgb);
+}
+
+
+/*  ─── harmonies, reduction, global colors ───────────────────────────── */
+
+/*  those of « Couleurs > Harmonies » (plug-ins/chopgimp_atelier), in
+ *  degrees, the base first
+ */
+static const struct { const gchar *name; gint n; gdouble offsets[4]; } harmonies[] =
+{
+  { N_("Complémentaire"),             2, { 0, 180 } },
+  { N_("Triade"),                     3, { 0, 120, 240 } },
+  { N_("Analogues"),                  3, { 0, -30, 30 } },
+  { N_("Tétrade"),                    4, { 0, 90, 180, 270 } },
+  { N_("Complémentaires adjacentes"), 3, { 0, 150, 210 } }
+};
+
+const gchar * const *
+chopgimp_recolor_harmony_names (void)
+{
+  static const gchar *names[G_N_ELEMENTS (harmonies) + 1] = { NULL, };
+
+  if (! names[0])
+    for (guint i = 0; i < G_N_ELEMENTS (harmonies); i++)
+      names[i] = _(harmonies[i].name);
+
+  return names;
+}
+
+gint
+chopgimp_recolor_harmony (ChopGimpRecolor *rc,
+                          gint             harmony,
+                          const gdouble   *base)
+{
+  gint     totals[CHOPGIMP_RECOLOR_N_GROUPS] = { 0, };
+  gint     main_of[CHOPGIMP_RECOLOR_N_GROUPS];
+  gint     rank[CHOPGIMP_RECOLOR_N_GROUPS];
+  gint     order[CHOPGIMP_RECOLOR_N_GROUPS];
+  gint     n_groups = 0;
+  gdouble  base_hsv[3];
+  gint     changed  = 0;
+
+  if (harmony < 0 || harmony >= (gint) G_N_ELEMENTS (harmonies))
+    return 0;
+
+  for (gint g = 0; g < CHOPGIMP_RECOLOR_N_GROUPS; g++)
+    main_of[g] = rank[g] = -1;
+
+  /*  the hue groups, most used first; their main color  */
+  for (guint i = 0; i < rc->colors->len; i++)
+    {
+      ChopGimpRecolorColor *c = g_ptr_array_index (rc->colors, i);
+
+      if (c->group == CHOPGIMP_RECOLOR_N_GROUPS - 1)
+        continue;
+
+      totals[c->group] += c->count;
+
+      if (main_of[c->group] < 0 ||
+          ((ChopGimpRecolorColor *) g_ptr_array_index (rc->colors,
+                                                       main_of[c->group]))->count < c->count)
+        main_of[c->group] = i;
+    }
+
+  for (gint g = 0; g < CHOPGIMP_RECOLOR_N_GROUPS - 1; g++)
+    if (totals[g] > 0)
+      order[n_groups++] = g;
+
+  if (n_groups == 0)
+    return 0;
+
+  for (gint a = 0; a < n_groups; a++)
+    for (gint b = a + 1; b < n_groups; b++)
+      if (totals[order[b]] > totals[order[a]])
+        {
+          gint t = order[a]; order[a] = order[b]; order[b] = t;
+        }
+
+  for (gint r = 0; r < n_groups; r++)
+    rank[order[r]] = r;
+
+  if (base)
+    rgb_to_hsv (base, base_hsv);
+  else
+    rgb_to_hsv (((ChopGimpRecolorColor *)
+                 g_ptr_array_index (rc->colors, main_of[order[0]]))->rgb, base_hsv);
+
+  for (guint i = 0; i < rc->colors->len; i++)
+    {
+      ChopGimpRecolorColor *c = g_ptr_array_index (rc->colors, i);
+      gdouble               hsv[3], main_hsv[3], rgb[3], d;
+      gint                  r;
+
+      if (c->group == CHOPGIMP_RECOLOR_N_GROUPS - 1)
+        continue;
+
+      r = rank[c->group];
+
+      rgb_to_hsv (c->rgb, hsv);
+      rgb_to_hsv (((ChopGimpRecolorColor *)
+                   g_ptr_array_index (rc->colors, main_of[c->group]))->rgb, main_hsv);
+
+      d = hsv[0] - main_hsv[0];
+      if (d > 180.0)  d -= 360.0;
+      if (d < -180.0) d += 360.0;
+
+      hsv[0] = base_hsv[0] + harmonies[harmony].offsets[r % harmonies[harmony].n] + d;
+
+      hsv_to_rgb (hsv, rgb);
+      chopgimp_recolor_set_target (rc, i, rgb);
+      changed++;
+    }
+
+  return changed;
+}
+
+gint
+chopgimp_recolor_reduce (ChopGimpRecolor *rc,
+                         gint             n)
+{
+  gint     n_colors = rc->colors->len;
+  gdouble *lab;
+  gdouble *centers;
+  gint    *assign;
+  gint     k;
+
+  if (n <= 0 || n >= n_colors)
+    return n_colors;
+
+  k       = n;
+  lab     = g_new (gdouble, n_colors * 3);
+  centers = g_new (gdouble, k * 3);
+  assign  = g_new (gint, n_colors);
+
+  for (gint i = 0; i < n_colors; i++)
+    {
+      gdouble rgb[3];
+
+      color_base (g_ptr_array_index (rc->colors, i), rgb);
+      rgb_to_lab (rgb, lab + i * 3);
+    }
+
+  /*  k-means++ seeding, deterministic: the most used color, then each
+   *  time the color with the largest weighted distance to the centres
+   */
+  {
+    gint first = 0;
+
+    for (gint i = 1; i < n_colors; i++)
+      if (((ChopGimpRecolorColor *) g_ptr_array_index (rc->colors, i))->count >
+          ((ChopGimpRecolorColor *) g_ptr_array_index (rc->colors, first))->count)
+        first = i;
+
+    memcpy (centers, lab + first * 3, sizeof (gdouble) * 3);
+
+    for (gint c = 1; c < k; c++)
+      {
+        gdouble best   = -1.0;
+        gint    best_i = 0;
+
+        for (gint i = 0; i < n_colors; i++)
+          {
+            gdouble d = G_MAXDOUBLE;
+
+            for (gint j = 0; j < c; j++)
+              d = MIN (d, lab_dist2 (lab + i * 3, centers + j * 3));
+
+            d *= ((ChopGimpRecolorColor *) g_ptr_array_index (rc->colors, i))->count;
+
+            if (d > best)
+              {
+                best   = d;
+                best_i = i;
+              }
+          }
+
+        memcpy (centers + c * 3, lab + best_i * 3, sizeof (gdouble) * 3);
+      }
+  }
+
+  for (gint iter = 0; iter < 50; iter++)
+    {
+      gboolean moved = FALSE;
+
+      for (gint i = 0; i < n_colors; i++)
+        {
+          gdouble best   = G_MAXDOUBLE;
+          gint    best_c = 0;
+
+          for (gint c = 0; c < k; c++)
+            {
+              gdouble d = lab_dist2 (lab + i * 3, centers + c * 3);
+
+              if (d < best)
+                {
+                  best   = d;
+                  best_c = c;
+                }
+            }
+
+          if (iter == 0 || assign[i] != best_c)
+            moved = TRUE;
+
+          assign[i] = best_c;
+        }
+
+      if (! moved && iter > 0)
+        break;
+
+      for (gint c = 0; c < k; c++)
+        {
+          gdouble sum[3] = { 0, 0, 0 };
+          gdouble w      = 0.0;
+
+          for (gint i = 0; i < n_colors; i++)
+            if (assign[i] == c)
+              {
+                gdouble cw = ((ChopGimpRecolorColor *) g_ptr_array_index (rc->colors, i))->count;
+
+                sum[0] += lab[i * 3 + 0] * cw;
+                sum[1] += lab[i * 3 + 1] * cw;
+                sum[2] += lab[i * 3 + 2] * cw;
+                w      += cw;
+              }
+
+          if (w > 0.0)
+            {
+              centers[c * 3 + 0] = sum[0] / w;
+              centers[c * 3 + 1] = sum[1] / w;
+              centers[c * 3 + 2] = sum[2] / w;
+            }
+        }
+    }
+
+  /*  each cluster takes the color of its most used member  */
+  for (gint c = 0; c < k; c++)
+    {
+      gint    rep = -1;
+      gdouble rgb[3];
+
+      for (gint i = 0; i < n_colors; i++)
+        if (assign[i] == c &&
+            (rep < 0 ||
+             ((ChopGimpRecolorColor *) g_ptr_array_index (rc->colors, i))->count >
+             ((ChopGimpRecolorColor *) g_ptr_array_index (rc->colors, rep))->count))
+          rep = i;
+
+      if (rep < 0)
+        continue;
+
+      color_base (g_ptr_array_index (rc->colors, rep), rgb);
+
+      for (gint i = 0; i < n_colors; i++)
+        if (assign[i] == c)
+          chopgimp_recolor_set_target (rc, i, rgb);
+    }
+
+  g_free (lab);
+  g_free (centers);
+  g_free (assign);
+
+  return MIN (k, n_colors);
+}
+
+gint
+chopgimp_recolor_assign_globals (ChopGimpRecolor *rc)
+{
+  GList   *globals = chopgimp_vcolors_list (rc->image);
+  gint     n_glob  = g_list_length (globals);
+  gdouble *lab;
+  gint     i, n    = 0;
+  GList   *l;
+
+  if (n_glob == 0)
+    return 0;
+
+  lab = g_new (gdouble, n_glob * 3);
+
+  for (l = globals, i = 0; l; l = l->next, i++)
+    {
+      const ChopGimpVColor *g = l->data;
+      gdouble               rgba[4];
+
+      color_rgba (g->color, rgba);
+      rgb_to_lab (rgba, lab + i * 3);
+    }
+
+  for (guint c = 0; c < rc->colors->len; c++)
+    {
+      gdouble     rgb[3], clab[3];
+      gdouble     best = G_MAXDOUBLE;
+      const gchar *id  = NULL;
+
+      color_base (g_ptr_array_index (rc->colors, c), rgb);
+      rgb_to_lab (rgb, clab);
+
+      for (l = globals, i = 0; l; l = l->next, i++)
+        {
+          gdouble d = lab_dist2 (clab, lab + i * 3);
+
+          if (d < best)
+            {
+              best = d;
+              id   = ((const ChopGimpVColor *) l->data)->id;
+            }
+        }
+
+      if (id)
+        {
+          chopgimp_recolor_set_global (rc, c, id);
+          n++;
+        }
+    }
+
+  g_free (lab);
+  g_list_free (globals);
+
+  return n;
+}
+
+
+/*  ─── applying ──────────────────────────────────────────────────────── */
+
+/*  @color takes the new color of its row (alpha kept); TRUE when changed  */
+static gboolean
+remap_color (ChopGimpRecolor  *rc,
+             GeglColor       **color)
+{
+  gdouble rgba[4];
+  gdouble rgb[3];
+  gint    i;
+
+  if (! *color)
+    return FALSE;
+
+  color_rgba (*color, rgba);
+  i = chopgimp_recolor_find (rc, rgba);
+
+  if (i < 0 || ! chopgimp_recolor_is_changed (rc, i))
+    return FALSE;
+
+  chopgimp_recolor_get_final (rc, i, rgb);
+
+  if (rgb_key (rgb) == rgb_key (rgba))
+    return FALSE;
+
+  rgba[0] = rgb[0];
+  rgba[1] = rgb[1];
+  rgba[2] = rgb[2];
+  g_object_unref (*color);
+  *color = gegl_color_new (NULL);
+  gegl_color_set_pixel (*color, babl_format ("R'G'B'A double"), rgba);
+
+  return TRUE;
+}
+
+static gboolean
+remap_style (ChopGimpRecolor *rc,
+             ChopGimpVStyle  *st)
+{
+  gboolean changed = FALSE;
+
+  for (gint k = 0; k < chopgimp_vstyle_get_n_entries (st); k++)
+    {
+      ChopGimpPaint *p = &chopgimp_vstyle_get_entry (st, k)->paint;
+
+      if (p->type == CHOPGIMP_PAINT_COLOR && p->color)
+        {
+          gdouble               rgba[4];
+          gint                  i;
+          ChopGimpRecolorColor *c;
+
+          color_rgba (p->color, rgba);
+          i = chopgimp_recolor_find (rc, rgba);
+          c = chopgimp_recolor_get_color (rc, i);
+
+          if (! c || ! chopgimp_recolor_is_changed (rc, i))
+            continue;
+
+          if (c->global_id)
+            {
+              if (g_strcmp0 (p->global_id, c->global_id))
+                {
+                  chopgimp_vpaint_set_global (p, rc->image, c->global_id);
+                  changed = TRUE;
+                }
+            }
+          else
+            {
+              GeglColor *color = gegl_color_duplicate (p->color);
+
+              /*  a new plain color: the link is broken  */
+              if (remap_color (rc, &color))
+                {
+                  chopgimp_vpaint_set_color (p, color);
+                  changed = TRUE;
+                }
+
+              g_object_unref (color);
+            }
+        }
+      else if ((p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+                p->type == CHOPGIMP_PAINT_RADIAL_GRADIENT) && p->stops)
+        {
+          for (guint s = 0; s < p->stops->len; s++)
+            if (remap_color (rc, &g_array_index (p->stops, ChopGimpGradientStop, s).color))
+              changed = TRUE;
+        }
+    }
+
+  return changed;
+}
+
+static GList *
+target_layers (ChopGimpRecolor *rc)
+{
+  GList *layers = NULL;
+
+  for (guint i = 0; i < rc->targets->len; i++)
+    {
+      Target *t = g_ptr_array_index (rc->targets, i);
+
+      if (! g_list_find (layers, t->layer))
+        layers = g_list_append (layers, t->layer);
+    }
+
+  return layers;
+}
+
+static gboolean
+target_valid (Target *t)
+{
+  return (gimp_item_is_attached (GIMP_ITEM (t->layer)) &&
+          chopgimp_vlayer_get_object (t->layer, t->id) != NULL);
+}
+
+void
+chopgimp_recolor_preview (ChopGimpRecolor *rc)
+{
+  GList *layers = target_layers (rc);
+
+  for (GList *l = layers; l; l = l->next)
+    chopgimp_vlayer_freeze (l->data);
+
+  for (guint i = 0; i < rc->targets->len; i++)
+    {
+      Target         *t = g_ptr_array_index (rc->targets, i);
+      ChopGimpVStyle  st;
+
+      if (! target_valid (t))
+        continue;
+
+      chopgimp_vstyle_init (&st);
+      chopgimp_vstyle_copy (&st, &t->orig);
+
+      if (remap_style (rc, &st))
+        {
+          chopgimp_vlayer_set_style (t->layer, t->id, &st, FALSE);
+          t->modified = TRUE;
+        }
+      else if (t->modified)
+        {
+          chopgimp_vlayer_set_style (t->layer, t->id, &t->orig, FALSE);
+          t->modified = FALSE;
+        }
+
+      chopgimp_vstyle_clear (&st);
+    }
+
+  for (GList *l = layers; l; l = l->next)
+    chopgimp_vlayer_thaw (l->data);
+
+  g_list_free (layers);
+
+  rc->previewed = TRUE;
+}
+
+void
+chopgimp_recolor_revert (ChopGimpRecolor *rc)
+{
+  GList *layers;
+
+  if (! rc->previewed)
+    return;
+
+  layers = target_layers (rc);
+
+  for (GList *l = layers; l; l = l->next)
+    chopgimp_vlayer_freeze (l->data);
+
+  for (guint i = 0; i < rc->targets->len; i++)
+    {
+      Target *t = g_ptr_array_index (rc->targets, i);
+
+      if (t->modified && target_valid (t))
+        chopgimp_vlayer_set_style (t->layer, t->id, &t->orig, FALSE);
+
+      t->modified = FALSE;
+    }
+
+  for (GList *l = layers; l; l = l->next)
+    chopgimp_vlayer_thaw (l->data);
+
+  g_list_free (layers);
+
+  rc->previewed = FALSE;
+}
+
+gboolean
+chopgimp_recolor_commit (ChopGimpRecolor *rc)
+{
+  GPtrArray *styles;
+  GList     *layers  = NULL;
+  gboolean   any     = FALSE;
+
+  /*  the undo steps hold the styles before the preview  */
+  chopgimp_recolor_revert (rc);
+
+  styles = g_ptr_array_new ();
+
+  for (guint i = 0; i < rc->targets->len; i++)
+    {
+      Target         *t  = g_ptr_array_index (rc->targets, i);
+      ChopGimpVStyle *st = NULL;
+
+      if (target_valid (t))
+        {
+          st = g_new0 (ChopGimpVStyle, 1);
+          chopgimp_vstyle_init (st);
+          chopgimp_vstyle_copy (st, &t->orig);
+
+          if (remap_style (rc, st))
+            {
+              any = TRUE;
+
+              if (! g_list_find (layers, t->layer))
+                layers = g_list_append (layers, t->layer);
+            }
+          else
+            {
+              chopgimp_vstyle_clear (st);
+              g_clear_pointer (&st, g_free);
+            }
+        }
+
+      g_ptr_array_add (styles, st);
+    }
+
+  if (any)
+    {
+      gimp_image_undo_group_start (rc->image, GIMP_UNDO_GROUP_ITEM_PROPERTIES,
+                                   _("Redéfinir les couleurs"));
+
+      for (GList *l = layers; l; l = l->next)
+        {
+          chopgimp_vlayer_push_undo (l->data, _("Redéfinir les couleurs"));
+          chopgimp_vlayer_freeze (l->data);
+        }
+
+      for (guint i = 0; i < rc->targets->len; i++)
+        {
+          Target         *t  = g_ptr_array_index (rc->targets, i);
+          ChopGimpVStyle *st = g_ptr_array_index (styles, i);
+
+          if (st)
+            chopgimp_vlayer_set_style (t->layer, t->id, st, FALSE);
+        }
+
+      for (GList *l = layers; l; l = l->next)
+        chopgimp_vlayer_thaw (l->data);
+
+      gimp_image_undo_group_end (rc->image);
+    }
+
+  for (guint i = 0; i < styles->len; i++)
+    {
+      ChopGimpVStyle *st = g_ptr_array_index (styles, i);
+
+      if (st)
+        {
+          chopgimp_vstyle_clear (st);
+          g_free (st);
+        }
+    }
+
+  g_ptr_array_free (styles, TRUE);
+  g_list_free (layers);
+
+  return any;
+}
+
+
+/*  ─── links to the global colors ────────────────────────────────────── */
+
+gint
+chopgimp_vobjects_link_global (GimpVectorLayer *layer,
+                               ChopGimpVLink    which,
+                               const gchar     *id,
+                               gboolean         push_undo)
+{
+  GimpImage *image;
+  GList     *leaves;
+  GPtrArray *styles;
+  gint       n = 0;
+
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), 0);
+
+  image = gimp_item_get_image (GIMP_ITEM (layer));
+
+  if (id && ! chopgimp_vcolors_lookup (image, id))
+    return 0;
+
+  leaves = chopgimp_vobjects_selected_leaves (layer, FALSE);
+  styles = g_ptr_array_new ();
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *leaf    = l->data;
+      ChopGimpVStyle  *st      = g_new0 (ChopGimpVStyle, 1);
+      gboolean         changed = FALSE;
+
+      chopgimp_vstyle_init (st);
+      chopgimp_vstyle_copy (st, &leaf->style);
+
+      if (id)
+        {
+          if (which & CHOPGIMP_VLINK_FILL)
+            {
+              ChopGimpVEntry *e = chopgimp_vstyle_ensure_fill (st);
+
+              if (g_strcmp0 (e->paint.global_id, id) || ! e->visible)
+                {
+                  chopgimp_vpaint_set_global (&e->paint, image, id);
+                  e->visible = TRUE;
+                  changed    = TRUE;
+                }
+            }
+
+          if (which & CHOPGIMP_VLINK_STROKE)
+            {
+              ChopGimpVEntry *e = chopgimp_vstyle_ensure_stroke (st);
+
+              if (g_strcmp0 (e->paint.global_id, id) || ! e->visible || e->width <= 0.0)
+                {
+                  chopgimp_vpaint_set_global (&e->paint, image, id);
+                  e->visible = TRUE;
+                  if (e->width <= 0.0)
+                    e->width = 1.0;
+                  changed = TRUE;
+                }
+            }
+        }
+      else
+        {
+          for (gint k = 0; k < chopgimp_vstyle_get_n_entries (st); k++)
+            {
+              ChopGimpVEntry *e = chopgimp_vstyle_get_entry (st, k);
+              ChopGimpVLink   w = (e->kind == CHOPGIMP_VENTRY_FILL) ? CHOPGIMP_VLINK_FILL
+                                                                    : CHOPGIMP_VLINK_STROKE;
+
+              if ((which & w) && e->paint.global_id)
+                {
+                  chopgimp_vpaint_set_global (&e->paint, image, NULL);
+                  changed = TRUE;
+                }
+            }
+        }
+
+      if (! changed)
+        {
+          chopgimp_vstyle_clear (st);
+          g_clear_pointer (&st, g_free);
+        }
+      else
+        {
+          n++;
+        }
+
+      g_ptr_array_add (styles, st);
+    }
+
+  if (n > 0)
+    {
+      GList *l;
+      guint  i;
+
+      if (push_undo)
+        chopgimp_vlayer_push_undo (layer, id ? _("Lier à une couleur globale")
+                                             : _("Délier de la couleur globale"));
+
+      chopgimp_vlayer_freeze (layer);
+
+      for (l = leaves, i = 0; l; l = l->next, i++)
+        {
+          ChopGimpVStyle *st = g_ptr_array_index (styles, i);
+
+          if (st)
+            chopgimp_vlayer_set_style (layer, ((ChopGimpVObject *) l->data)->id, st, FALSE);
+        }
+
+      chopgimp_vlayer_thaw (layer);
+    }
+
+  for (guint i = 0; i < styles->len; i++)
+    {
+      ChopGimpVStyle *st = g_ptr_array_index (styles, i);
+
+      if (st)
+        {
+          chopgimp_vstyle_clear (st);
+          g_free (st);
+        }
+    }
+
+  g_ptr_array_free (styles, TRUE);
+  g_list_free (leaves);
+
+  return n;
+}
+
+const gchar *
+chopgimp_vobjects_get_global (GimpVectorLayer *layer,
+                              ChopGimpVLink    which)
+{
+  GList           *leaves;
+  ChopGimpVObject *leaf;
+  ChopGimpVEntry  *e = NULL;
+
+  if (! layer)
+    return NULL;
+
+  leaves = chopgimp_vobjects_selected_leaves (layer, FALSE);
+  leaf   = leaves ? leaves->data : NULL;
+  g_list_free (leaves);
+
+  if (! leaf)
+    return NULL;
+
+  if (which & CHOPGIMP_VLINK_FILL)
+    e = chopgimp_vstyle_get_fill (&leaf->style);
+  else
+    e = chopgimp_vstyle_get_stroke (&leaf->style);
+
+  return e ? e->paint.global_id : NULL;
+}
