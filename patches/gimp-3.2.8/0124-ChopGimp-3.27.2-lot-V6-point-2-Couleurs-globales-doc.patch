+#include "path/chopgimp-vcolors.h"
+#include "path/chopgimp-vrecolor.h"
+
+#include "gimpcolordialog.h"
+#include "gimpdialogfactory.h"
+#include "gimpeditor.h"
+#include "gimphelp-ids.h"
+#include "gimpwidgets-utils.h"
+
