+/*  ─── 3.27.7: Peinture dynamique, Symboles ──────────────────────────── */
+
+#define return_if_no_target(image,layer,data) \
+  return_if_no_image (image, data);            \
+  layer = chopgimp_vobjects_get_target_layer (image); \
+  if (! layer)                                 \
+    return
+
+void
+vector_objects_livepaint_make_cmd_callback (GimpAction *action,
+                                            GVariant   *value,
+                                            gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_target (image, layer, data);
+
+  if (chopgimp_vlivepaint_make (layer))
+    {
+      gimp_image_flush (image);
+      distort_select_tool (image, data, "gimp-live-paint-bucket-tool");
+    }
+}
+
+#define TARGET_COMMAND(name, call)                         \
+void                                                       \
+vector_objects_##name##_cmd_callback (GimpAction *action,  \
+                                      GVariant   *value,   \
+                                      gpointer    data)    \
+{                                                          \
+  GimpImage       *image;                                  \
+  GimpVectorLayer *layer;                                  \
+  return_if_no_target (image, layer, data);                \
+                                                           \
+  if (call (layer))                                        \
+    gimp_image_flush (image);                              \
+}
+
+TARGET_COMMAND (livepaint_add,     chopgimp_vlivepaint_add)
+TARGET_COMMAND (livepaint_expand,  chopgimp_vlivepaint_expand)
+TARGET_COMMAND (livepaint_release, chopgimp_vlivepaint_release)
+TARGET_COMMAND (symbol_break,      chopgimp_vsymbols_break_link)
+
+static void
+livepaint_gap_callback (GtkWidget *query_box,
+                        gdouble    value,
+                        gpointer   data)
+{
+  GimpVectorLayer *layer = data;
+
+  if (gimp_item_is_attached (GIMP_ITEM (layer)) &&
+      chopgimp_vlivepaint_set_gap (layer, value))
+    gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+}
+
+void
+vector_objects_livepaint_gap_cmd_callback (GimpAction *action,
+                                           GVariant   *value,
+                                           gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  GtkWidget       *box;
+  gdouble          gap;
+  return_if_no_target (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  gap = chopgimp_vlivepaint_get_gap (layer);
+  if (gap < 0)
+    return;
+
+  box = gimp_query_double_box (_("Options d'écarts"),
+                               widget,
+                               gimp_standard_help_func, NULL,
+                               _("Fermer les ouvertures plus étroites que (px, 0 : aucune) :"),
+                               gap, 0.0, 100.0, 1,
+                               G_OBJECT (layer), "removed",
+                               livepaint_gap_callback, layer, NULL);
+  gtk_widget_show (box);
+}
+
+static void
+symbol_new_callback (GtkWidget   *query_box,
+                     const gchar *string,
+                     gpointer     data)
+{
+  GimpVectorLayer *layer = data;
+  gchar           *id;
+
+  if (! gimp_item_is_attached (GIMP_ITEM (layer)))
+    return;
+
+  id = chopgimp_vsymbols_make (layer, string);
+
+  if (id)
+    gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+
+  g_free (id);
+}
+
+void
+vector_objects_symbol_new_cmd_callback (GimpAction *action,
+                                        GVariant   *value,
+                                        gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  GtkWidget       *box;
+  GList           *list;
+  gchar           *name;
+  return_if_no_target (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  if (! chopgimp_vsymbols_can_make (layer))
+    return;
+
+  list = chopgimp_vsymbols_list (image);
+  name = g_strdup_printf (_("Symbole %d"), g_list_length (list) + 1);
+  chopgimp_vsymbols_list_free (list);
+
+  box = gimp_query_string_box (_("Nouveau symbole"),
+                               widget,
+                               gimp_standard_help_func, NULL,
+                               _("Nom du symbole :"),
+                               name,
+                               G_OBJECT (layer), "removed",
+                               symbol_new_callback, layer, NULL);
+  gtk_widget_show (box);
+  g_free (name);
+}
+
+void
+vector_objects_symbol_edit_cmd_callback (GimpAction *action,
+                                         GVariant   *value,
+                                         gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_target (image, layer, data);
+
+  if (chopgimp_vsymbols_edit (layer, NULL))
+    {
+      gimp_image_flush (image);
+      distort_select_tool (image, data, "gimp-move-tool");
+    }
+}
