+
+/*  3.28.1: « livepaint-* » and « symbol-* » commands
+ *    livepaint-make, livepaint-add, livepaint-expand, livepaint-release,
+ *    livepaint-gap:<px>, livepaint-fill:<x>:<y>:#rrggbb (a region, image
+ *    coordinates; « none »: no fill), livepaint-stroke:<x>:<y>:#rrggbb,
+ *    livepaint-select:<x>:<y> (region, else segment),
+ *    symbol-new[:<name>], symbol-place:<id>, symbol-break, symbol-edit,
+ *    symbol-rename:<id>:<name>, symbol-delete:<id>
+ */
+static gboolean
+chopgimp_vobjects_livepaint_command (GimpVectorLayer *layer,
+                                     GimpContext     *context,
+                                     const gchar     *cmd)
+{
+  GimpImage *image = gimp_item_get_image (GIMP_ITEM (layer));
+  gchar    **v     = g_strsplit (cmd, ":", 4);
+  gint       n     = g_strv_length (v);
+  gboolean   done  = FALSE;
+
+  if (! strcmp (v[0], "livepaint-make"))
+    done = chopgimp_vlivepaint_make (layer) != NULL;
+  else if (! strcmp (v[0], "livepaint-add"))
+    done = chopgimp_vlivepaint_add (layer);
+  else if (! strcmp (v[0], "livepaint-expand"))
+    done = chopgimp_vlivepaint_expand (layer);
+  else if (! strcmp (v[0], "livepaint-release"))
+    done = chopgimp_vlivepaint_release (layer);
+  else if (! strcmp (v[0], "livepaint-gap") && n == 2)
+    done = chopgimp_vlivepaint_set_gap (layer, g_ascii_strtod (v[1], NULL));
+  else if ((! strcmp (v[0], "livepaint-fill") || ! strcmp (v[0], "livepaint-stroke")) &&
+           n == 4)
+    {
+      gboolean         edge = ! strcmp (v[0], "livepaint-stroke");
+      ChopGimpVObject *o    = chopgimp_vlivepaint_pick (layer,
+                                                        g_ascii_strtod (v[1], NULL),
+                                                        g_ascii_strtod (v[2], NULL),
+                                                        edge, 4.0);
+
+      if (o)
+        {
+          GeglColor *c = NULL;
+
+          if (strcmp (v[3], "none"))
+            {
+              c = gegl_color_new (NULL);
+              gegl_color_set_rgba_with_space (c, 0, 0, 0, 1, NULL);
+
+              if (strlen (v[3]) == 7 && v[3][0] == '#')
+                {
+                  guint rgb = (guint) g_ascii_strtoull (v[3] + 1, NULL, 16);
+
+                  gegl_color_set_rgba_with_space (c,
+                                                  ((rgb >> 16) & 0xff) / 255.0,
+                                                  ((rgb >> 8) & 0xff) / 255.0,
+                                                  (rgb & 0xff) / 255.0, 1.0, NULL);
+                }
+            }
+
+          chopgimp_vlivepaint_paint (layer, o, c, edge);
+          g_clear_object (&c);
+          done = TRUE;
+        }
+    }
+  else if (! strcmp (v[0], "livepaint-select") && n >= 3)
+    {
+      gdouble          x = g_ascii_strtod (v[1], NULL), y = g_ascii_strtod (v[2], NULL);
+      ChopGimpVObject *o = chopgimp_vlivepaint_pick (layer, x, y, FALSE, 4.0);
+
+      if (! o)
+        o = chopgimp_vlivepaint_pick (layer, x, y, TRUE, 4.0);
+
+      if (o)
+        {
+          chopgimp_vlayer_set_selection (layer, &o->id, 1);
+          done = TRUE;
+        }
+    }
+  else if (! strcmp (v[0], "symbol-new"))
+    {
+      gchar *id = chopgimp_vsymbols_make (layer, n > 1 ? strchr (cmd, ':') + 1 : NULL);
+
+      done = id != NULL;
+      g_free (id);
+    }
+  else if (! strcmp (v[0], "symbol-place") && n >= 2)
+    done = chopgimp_vsymbols_place (image, layer, v[1], context) != NULL;
+  else if (! strcmp (v[0], "symbol-break"))
+    done = chopgimp_vsymbols_break_link (layer);
+  else if (! strcmp (v[0], "symbol-edit"))
+    done = chopgimp_vsymbols_edit (layer, n > 1 ? v[1] : NULL);
+  else if (! strcmp (v[0], "symbol-rename") && n >= 3)
+    done = chopgimp_vsymbols_rename (image, v[1], strchr (strchr (cmd, ':') + 1, ':') + 1);
+  else if (! strcmp (v[0], "symbol-delete") && n >= 2)
+    done = chopgimp_vsymbols_remove (image, v[1]);
+
+  g_strfreev (v);
+
+  return done;
+}
