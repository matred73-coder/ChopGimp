+/*  ─── 3.27.7: helpers for live paint and symbols ────────────────────── */
+
+void
+chopgimp_vpath_transform (GimpPath          *path,
+                          const GimpMatrix3 *matrix)
+{
+  g_return_if_fail (GIMP_IS_PATH (path) && matrix != NULL);
+
+  path_transform (path, matrix);
+}
+
+gchar *
+chopgimp_vpath_to_d (GimpPath *path)
+{
+  g_return_val_if_fail (GIMP_IS_PATH (path), NULL);
+
+  return path_to_d (path);
+}
+
+gchar *
+chopgimp_vobjects_to_xml (GList *objects)
+{
+  GString *s = g_string_new ("<chopgimp-vobjects version=\"2\" next-id=\"1\">\n"
+                             "<group id=\"0\" name=\"\">\n");
+
+  for (GList *l = objects; l; l = l->next)
+    write_object (s, l->data, TRUE);
+
+  g_string_append (s, "</group>\n</chopgimp-vobjects>\n");
+
+  return g_string_free (s, FALSE);
+}
+
+ChopGimpVObject *
+chopgimp_vobjects_from_xml (GimpImage   *image,
+                            const gchar *xml)
+{
+  ChopGimpVLayer  *vl;
+  ChopGimpVObject *root;
+
+  if (! xml || ! GIMP_IS_IMAGE (image))
+    return NULL;
+
+  vl = vlayer_parse (image, xml, strlen (xml), NULL);
+
+  if (! vl)
+    return NULL;
+
+  root = chopgimp_vobject_ref (vl->root);
+  chopgimp_vlayer_free (vl);
+
+  return root;
+}
+
+void
+chopgimp_vlayer_subtree_changed (GimpVectorLayer *layer,
+                                 ChopGimpVObject *object,
+                                 const gchar     *undo_desc)
+{
+  ChopGimpVLayer *vl;
+
+  if (! layer_usable (layer) || ! (vl = vlayer_ensure (layer)))
+    return;
+
+  if (undo_desc)
+    chopgimp_vlayer_push_undo (layer, undo_desc);
+
+  vl->legacy = FALSE;
+  vlayer_reindex (vl);
+  vlayer_assign_missing_ids (vl, vl->root);
+  vobj_invalidate (object ? object : vl->root);
+
+  vlayer_commit (layer, CHANGE_ALL, NULL);
+}
+
+/*  the image-space box of the leaves of a tree that is not in a layer
+ *  (control points, strokes ignored); FALSE when empty
+ */
+static void
+preview_bounds_rec (ChopGimpVObject *o,
+                    gdouble          b[4],
+                    gboolean        *any)
+{
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    {
+      GimpMatrix3  m;
+      GimpStroke  *stroke = NULL;
+
+      if (! o->path)
+        return;
+
+      chopgimp_vobject_get_world_matrix (o, &m);
+
+      while ((stroke = gimp_path_stroke_get_next (o->path, stroke)))
+        {
+          GArray *anchors = gimp_stroke_control_points_get (stroke, NULL);
+
+          for (guint k = 0; anchors && k < anchors->len; k++)
+            {
+              GimpAnchor *a = &g_array_index (anchors, GimpAnchor, k);
+              gdouble     x, y;
+
+              gimp_matrix3_transform_point (&m, a->position.x, a->position.y, &x, &y);
+
+              if (! *any)
+                {
+                  b[0] = b[2] = x;
+                  b[1] = b[3] = y;
+                  *any = TRUE;
+                }
+              else
+                {
+                  b[0] = MIN (b[0], x);
+                  b[1] = MIN (b[1], y);
+                  b[2] = MAX (b[2], x);
+                  b[3] = MAX (b[3], y);
+                }
+            }
+
+          if (anchors)
+            g_array_unref (anchors);
+        }
+    }
+  else if (o->children)
+    {
+      for (guint i = 0; i < o->children->len; i++)
+        preview_bounds_rec (g_ptr_array_index (o->children, i), b, any);
+    }
+}
+
+gboolean
+chopgimp_vobject_preview_bounds (ChopGimpVObject *root,
+                                 gdouble          bounds[4])
+{
+  gboolean any = FALSE;
+
+  if (root)
+    preview_bounds_rec (root, bounds, &any);
+
+  return any;
+}
+
+void
+chopgimp_vobject_draw_preview (ChopGimpVObject *root,
+                               gpointer         data)
+{
+  cairo_t *cr = data;
+  GList   *leaves;
+
+  if (! root || ! cr)
+    return;
+
+  leaves = leaves_of (root);
+
+  for (GList *l = leaves; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      GimpMatrix3      wm;
+      cairo_matrix_t   world;
+
+      if (! o->path || ! chopgimp_vobject_is_visible (o) ||
+          gimp_path_get_n_strokes (o->path) == 0)
+        continue;
+
+      chopgimp_vobject_get_world_matrix (o, &wm);
+      matrix_to_cairo (&wm, &world);
+
+      cairo_save (cr);
+      cairo_transform (cr, &world);
+
+      for (gint k = 0; k < chopgimp_vstyle_get_n_entries (&o->style); k++)
+        {
+          ChopGimpVEntry *e = chopgimp_vstyle_get_entry (&o->style, k);
+
+          if (chopgimp_ventry_is_painted (e))
+            draw_entry (cr, &o->style, e, o->path, NULL, &world);
+        }
+
+      cairo_restore (cr);
+    }
+
+  g_list_free (leaves);
+}
