+
+#include "gimppath.h"
+#include "gimpbezierstroke.h"
+#include "gimpvectorlayer.h"
+#include "chopgimp-vobject.h"
+#include "chopgimp-vsymbols.h"
+
+#include "gimp-intl.h"
+
+
+#define PARASITE "chopgimp-symbols"
+
+
+/*  ─── the registry (image parasite) ─────────────────────────────────── */
+
+void
+chopgimp_vsymbol_free (ChopGimpVSymbol *s)
+{
+  if (! s)
+    return;
+
+  g_free (s->id);
+  g_free (s->name);
+  g_free (s->xml);
+  g_free (s);
+}
+
+void
+chopgimp_vsymbols_list_free (GList *list)
+{
+  g_list_free_full (list, (GDestroyNotify) chopgimp_vsymbol_free);
+}
+
+typedef struct
+{
+  GList           *list;
+  ChopGimpVSymbol *cur;
+  GString         *text;
+} Parse;
+
+static void
+p_start (GMarkupParseContext  *ctx,
+         const gchar          *element,
+         const gchar         **names,
+         const gchar         **values,
+         gpointer              data,
+         GError              **error)
+{
+  Parse *p = data;
+
+  if (! strcmp (element, "symbol"))
+    {
+      p->cur = g_new0 (ChopGimpVSymbol, 1);
+
+      for (gint i = 0; names[i]; i++)
+        {
+          if (! strcmp (names[i], "id"))
+            p->cur->id = g_strdup (values[i]);
+          else if (! strcmp (names[i], "name"))
+            p->cur->name = g_strdup (values[i]);
+        }
+
+      g_string_truncate (p->text, 0);
+    }
+}
+
+static void
+p_end (GMarkupParseContext  *ctx,
+       const gchar          *element,
+       gpointer              data,
+       GError              **error)
+{
+  Parse *p = data;
+
+  if (! strcmp (element, "symbol") && p->cur)
+    {
+      p->cur->xml = g_strdup (p->text->str);
+
+      if (p->cur->id)
+        {
+          if (! p->cur->name)
+            p->cur->name = g_strdup (p->cur->id);
+          p->list = g_list_append (p->list, p->cur);
+        }
+      else
+        {
+          chopgimp_vsymbol_free (p->cur);
+        }
+
+      p->cur = NULL;
+    }
+}
+
+static void
+p_text (GMarkupParseContext  *ctx,
+        const gchar          *text,
+        gsize                 len,
+        gpointer              data,
+        GError              **error)
+{
+  Parse *p = data;
+
+  if (p->cur)
+    g_string_append_len (p->text, text, len);
+}
+
+/*  GMarkup hands CDATA sections to the passthrough callback  */
+static void
+p_passthrough (GMarkupParseContext  *ctx,
+               const gchar          *text,
+               gsize                 len,
+               gpointer              data,
+               GError              **error)
+{
+  Parse *p = data;
+
+  if (p->cur && len >= 12 && ! strncmp (text, "<![CDATA[", 9) &&
+      ! strncmp (text + len - 3, "]]>", 3))
+    g_string_append_len (p->text, text + 9, len - 12);
+}
+
+GList *
+chopgimp_vsymbols_list (GimpImage *image)
+{
+  static const GMarkupParser parser = { p_start, p_end, p_text, p_passthrough, NULL };
+  const GimpParasite        *parasite;
+  GMarkupParseContext       *ctx;
+  Parse                      p = { NULL, NULL, NULL };
+  const gchar               *data;
+  guint32                    size = 0;
+
+  if (! GIMP_IS_IMAGE (image) ||
+      ! (parasite = gimp_image_parasite_find (image, PARASITE)))
+    return NULL;
+
+  data = gimp_parasite_get_data (parasite, &size);
+
+  if (! data || size == 0)
+    return NULL;
+
+  p.text = g_string_new (NULL);
+  ctx    = g_markup_parse_context_new (&parser, 0, &p, NULL);
+
+  if (! g_markup_parse_context_parse (ctx, data, size, NULL) ||
+      ! g_markup_parse_context_end_parse (ctx, NULL))
+    {
+      chopgimp_vsymbol_free (p.cur);
+      chopgimp_vsymbols_list_free (p.list);
+      p.list = NULL;
+    }
+
+  g_markup_parse_context_free (ctx);
+  g_string_free (p.text, TRUE);
+
+  return p.list;
+}
+
+static void
+symbols_save (GimpImage   *image,
+              GList       *list,
+              gboolean     push_undo)
+{
+  GString      *s = g_string_new ("<chopgimp-symbols version=\"1\">\n");
+  GimpParasite *parasite;
+
+  for (GList *l = list; l; l = l->next)
+    {
+      ChopGimpVSymbol *sym  = l->data;
+      gchar           *id   = g_markup_escape_text (sym->id, -1);
+      gchar           *name = g_markup_escape_text (sym->name ? sym->name : "", -1);
+
+      g_string_append_printf (s, "<symbol id=\"%s\" name=\"%s\"><![CDATA[%s]]></symbol>\n",
+                              id, name, sym->xml ? sym->xml : "");
+      g_free (id);
+      g_free (name);
+    }
+
+  g_string_append (s, "</chopgimp-symbols>\n");
+
+  parasite = gimp_parasite_new (PARASITE,
+                                GIMP_PARASITE_PERSISTENT | GIMP_PARASITE_UNDOABLE,
+                                s->len, s->str);
+  gimp_image_parasite_attach (image, parasite, push_undo);
+  gimp_parasite_free (parasite);
+
+  g_string_free (s, TRUE);
+}
+
+static ChopGimpVSymbol *
+list_find (GList       *list,
+           const gchar *id)
+{
+  for (GList *l = list; l; l = l->next)
+    if (! g_strcmp0 (((ChopGimpVSymbol *) l->data)->id, id))
+      return l->data;
+
+  return NULL;
+}
+
+ChopGimpVSymbol *
+chopgimp_vsymbols_lookup (GimpImage   *image,
+                          const gchar *id)
+{
+  GList           *list = chopgimp_vsymbols_list (image);
+  ChopGimpVSymbol *s    = list_find (list, id);
+  ChopGimpVSymbol *copy = NULL;
+
+  if (s)
+    {
+      copy       = g_new0 (ChopGimpVSymbol, 1);
+      copy->id   = g_strdup (s->id);
+      copy->name = g_strdup (s->name);
+      copy->xml  = g_strdup (s->xml);
+    }
+
+  chopgimp_vsymbols_list_free (list);
+
+  return copy;
+}
+
+ChopGimpVObject *
+chopgimp_vsymbol_get_objects (GimpImage             *image,
+                              const ChopGimpVSymbol *symbol)
+{
+  return symbol ? chopgimp_vobjects_from_xml (image, symbol->xml) : NULL;
+}
+
+/*  the objects of an occurrence as text, without ids (to compare)  */
+static gchar *
+content_xml (ChopGimpVObject *group)
+{
+  static GRegex *ids = NULL;
+  GList         *kids = NULL;
+  gchar         *xml, *clean;
+
+  if (! ids)
+    ids = g_regex_new (" id=\"[0-9]+\"", G_REGEX_OPTIMIZE, 0, NULL);
+
+  for (guint i = 0; i < group->children->len; i++)
+    kids = g_list_append (kids, g_ptr_array_index (group->children, i));
+
+  xml   = chopgimp_vobjects_to_xml (kids);
+  clean = g_regex_replace_literal (ids, xml, -1, 0, "", 0, NULL);
+
+  g_list_free (kids);
+  g_free (xml);
+
+  return clean;
+}
+
+static void
+zero_ids (ChopGimpVObject *o)
+{
+  o->id = 0;
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      zero_ids (g_ptr_array_index (o->children, i));
+}
+
+/*  the children of @group become a copy of the objects of @xml  */
+static gboolean
+set_content (GimpImage       *image,
+             ChopGimpVObject *group,
+             const gchar     *xml)
+{
+  ChopGimpVObject *root = chopgimp_vobjects_from_xml (image, xml);
+
+  if (! root)
+    return FALSE;
+
+  g_ptr_array_set_size (group->children, 0);
+
+  for (guint i = 0; i < root->children->len; i++)
+    {
+      ChopGimpVObject *c = g_ptr_array_index (root->children, i);
+
+      zero_ids (c);
+      c->parent = group;
+      g_ptr_array_add (group->children, chopgimp_vobject_ref (c));
+    }
+
+  chopgimp_vobject_unref (root);
+
+  return TRUE;
+}
+
+ChopGimpVObject *
+chopgimp_vsymbols_occurrence_of (ChopGimpVObject *o)
+{
+  for (; o; o = o->parent)
+    if (o->kind == CHOPGIMP_VOBJECT_GROUP && o->symbol)
+      return o;
+
+  return NULL;
+}
+
+static void
+collect_occurrences (ChopGimpVObject  *o,
+                     const gchar      *id,
+                     GList           **list)
+{
+  if (o->kind != CHOPGIMP_VOBJECT_GROUP)
+    return;
+
+  if (o->symbol && (! id || ! strcmp (o->symbol, id)))
+    {
+      *list = g_list_append (*list, o);
+      return;   /* not inside an occurrence */
+    }
+
+  for (guint i = 0; i < o->children->len; i++)
+    collect_occurrences (g_ptr_array_index (o->children, i), id, list);
+}
+
+/*  the vector layers of @image with objects (g_list_free)  */
+static GList *
+vector_layers (GimpImage *image)
+{
+  GList *all = gimp_image_get_layer_list (image);
+  GList *out = NULL;
+
+  for (GList *l = all; l; l = l->next)
+    if (GIMP_IS_VECTOR_LAYER (l->data) &&
+        gimp_item_is_vector_layer (GIMP_ITEM (l->data)) &&
+        chopgimp_vlayer_has_objects (l->data))
+      out = g_list_append (out, l->data);
+
+  g_list_free (all);
+
+  return out;
+}
+
+gint
+chopgimp_vsymbols_count_uses (GimpImage   *image,
+                              const gchar *id)
+{
+  GList *layers = vector_layers (image);
+  gint   n      = 0;
+
+  for (GList *l = layers; l; l = l->next)
+    {
+      GList *occ = NULL;
+
+      collect_occurrences (chopgimp_vlayer_get_root (l->data), id, &occ);
+      n += g_list_length (occ);
+      g_list_free (occ);
+    }
+
+  g_list_free (layers);
+
+  return n;
+}
+
+
+/*  ─── following the changes ─────────────────────────────────────────── */
+
+static gint busy = 0;
+
+gboolean
+chopgimp_vsymbols_layer_changed (GimpVectorLayer *layer)
+{
+  GimpImage       *image;
+  ChopGimpVObject *root;
+  GList           *occ = NULL;
+  GList           *list;
+  GList           *changed = NULL;   /* ChopGimpVSymbol * (in list) */
+  GList           *sources = NULL;   /* the occurrence that changed it */
+  gboolean         here    = FALSE;
+
+  if (busy || ! (root = chopgimp_vlayer_get_root (layer)))
+    return FALSE;
+
+  collect_occurrences (root, NULL, &occ);
+
+  if (! occ)
+    return FALSE;
+
+  image = gimp_item_get_image (GIMP_ITEM (layer));
+  list  = chopgimp_vsymbols_list (image);
+
+  {
+    guint            eid     = chopgimp_vlayer_get_entered_group (layer);
+    ChopGimpVObject *entered = eid ? chopgimp_vlayer_get_object (layer, eid) : NULL;
+
+    for (GList *l = occ; l; l = l->next)
+      {
+        ChopGimpVObject *o   = l->data;
+        ChopGimpVSymbol *sym = list_find (list, o->symbol);
+        gchar           *xml;
+
+        if (! sym || g_list_find (changed, sym))
+          continue;
+
+        xml = content_xml (o);
+
+        if (! g_strcmp0 (xml, sym->xml))
+          {
+            g_free (xml);
+            continue;
+          }
+
+        /*  changed outside « Modifier le symbole » (a distortion, a style
+         *  applied to the occurrence…): this occurrence leaves the symbol
+         *  (an undo brings the link back)
+         */
+        if (! entered || ! (entered == o || chopgimp_vobject_is_ancestor (o, entered)))
+          {
+            g_clear_pointer (&o->symbol, g_free);
+            g_free (xml);
+            continue;
+          }
+
+        g_free (sym->xml);
+        sym->xml = xml;
+        changed  = g_list_append (changed, sym);
+        sources  = g_list_append (sources, o);
+      }
+  }
+
+  if (changed)
+    {
+      GList *layers;
+
+      busy++;
+
+      symbols_save (image, list, FALSE);
+
+      layers = vector_layers (image);
+
+      for (GList *ll = layers; ll; ll = ll->next)
+        {
+          GimpVectorLayer *vl   = ll->data;
+          gboolean         any  = FALSE;
+
+          for (GList *c = changed, *src = sources; c; c = c->next, src = src->next)
+            {
+              ChopGimpVSymbol *sym    = c->data;
+              GList           *others = NULL;
+
+              collect_occurrences (chopgimp_vlayer_get_root (vl), sym->id, &others);
+
+              for (GList *o = others; o; o = o->next)
+                if (o->data != src->data && set_content (image, o->data, sym->xml))
+                  any = TRUE;
+
+              g_list_free (others);
+            }
+
+          if (any)
+            {
+              if (vl == layer)
+                here = TRUE;
+              else
+                chopgimp_vlayer_subtree_changed (vl, NULL, NULL);
+            }
+        }
+
+      g_list_free (layers);
+
+      busy--;
+    }
+
+  g_list_free (changed);
+  g_list_free (sources);
+  g_list_free (occ);
+  chopgimp_vsymbols_list_free (list);
+
+  return here;
+}
+
+
+/*  ─── commands ──────────────────────────────────────────────────────── */
+
+static GList *
+selected_same_parent (GimpVectorLayer *layer)
+{
+  GList           *sel    = chopgimp_vlayer_get_selected_objects (layer);
+  ChopGimpVObject *parent = NULL;
+
+  for (GList *l = sel; l; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+
+      if (l != sel && o->parent != parent)
+        {
+          g_list_free (sel);
+          return NULL;
+        }
+
+      parent = o->parent;
+    }
+
+  return sel;
+}
+
+gboolean
+chopgimp_vsymbols_can_make (GimpVectorLayer *layer)
+{
+  GList    *sel;
+  gboolean  can;
+
+  if (! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  sel = selected_same_parent (layer);
+  can = sel != NULL;
+  g_list_free (sel);
+
+  return can;
+}
+
+static gchar *
+new_id (GList *list)
+{
+  for (gint n = g_list_length (list) + 1; ; n++)
+    {
+      gchar *id = g_strdup_printf ("s%d", n);
+
+      if (! list_find (list, id))
+        return id;
+
+      g_free (id);
+    }
+}
+
+gchar *
+chopgimp_vsymbols_make (GimpVectorLayer *layer,
+                        const gchar     *name)
+{
+  GimpImage       *image;
+  GList           *sel, *list;
+  GArray          *ids;
+  ChopGimpVObject *g;
+  ChopGimpVSymbol *sym;
+  gchar           *label;
+
+  if (! chopgimp_vsymbols_can_make (layer))
+    return NULL;
+
+  image = gimp_item_get_image (GIMP_ITEM (layer));
+  sel   = selected_same_parent (layer);
+  list  = chopgimp_vsymbols_list (image);
+
+  sym     = g_new0 (ChopGimpVSymbol, 1);
+  sym->id = new_id (list);
+  label   = (name && *name) ? g_strdup (name)
+                            : g_strdup_printf (_("Symbole %d"), g_list_length (list) + 1);
+  sym->name = label;
+
+  ids = g_array_new (FALSE, FALSE, sizeof (guint));
+  for (GList *l = sel; l; l = l->next)
+    g_array_append_val (ids, ((ChopGimpVObject *) l->data)->id);
+  g_list_free (sel);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC, _("Nouveau symbole"));
+
+  g = chopgimp_vlayer_group (layer, (guint *) ids->data, ids->len, sym->name, TRUE);
+  g_array_free (ids, TRUE);
+
+  if (! g)
+    {
+      gimp_image_undo_group_end (image);
+      chopgimp_vsymbol_free (sym);
+      chopgimp_vsymbols_list_free (list);
+      return NULL;
+    }
+
+  sym->xml = content_xml (g);
+  list     = g_list_append (list, sym);
+
+  busy++;
+  symbols_save (image, list, TRUE);
+  g->symbol = g_strdup (sym->id);
+  chopgimp_vlayer_subtree_changed (layer, g, NULL);
+  busy--;
+
+  chopgimp_vlayer_set_selection (layer, &g->id, 1);
+
+  gimp_image_undo_group_end (image);
+
+  {
+    gchar *id = g_strdup (sym->id);
+
+    chopgimp_vsymbols_list_free (list);
+    return id;
+  }
+}
+
+ChopGimpVObject *
+chopgimp_vsymbols_place (GimpImage       *image,
+                         GimpVectorLayer *layer,
+                         const gchar     *id,
+                         GimpContext     *context)
+{
+  ChopGimpVSymbol *sym = chopgimp_vsymbols_lookup (image, id);
+  ChopGimpVObject *occ;
+  gdouble          b[4];
+  GimpMatrix3      m;
+
+  if (! sym)
+    return NULL;
+
+  occ         = chopgimp_vobject_new_group (sym->name);
+  occ->symbol = g_strdup (sym->id);
+
+  if (! set_content (image, occ, sym->xml))
+    {
+      chopgimp_vobject_unref (occ);
+      chopgimp_vsymbol_free (sym);
+      return NULL;
+    }
+
+  /*  in the center of the image  */
+  gimp_matrix3_identity (&m);
+  if (chopgimp_vobject_preview_bounds (occ, b))
+    gimp_matrix3_translate (&m,
+                            gimp_image_get_width (image)  / 2.0 - (b[0] + b[2]) / 2.0,
+                            gimp_image_get_height (image) / 2.0 - (b[1] + b[3]) / 2.0);
+  occ->transform = m;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC, _("Placer une occurrence"));
+
+  if (! layer)
+    {
+      /*  a new vector layer holding the occurrence  */
+      GimpPath   *path   = gimp_path_new (image, sym->name);
+      GimpCoords  c      = GIMP_COORDS_DEFAULT_VALUES;
+      GimpStroke *stroke;
+      GList      *one    = g_list_prepend (NULL, occ);
+      gchar      *xml;
+
+      c.x = gimp_image_get_width (image) / 2.0;
+      c.y = gimp_image_get_height (image) / 2.0;
+      stroke = gimp_bezier_stroke_new_moveto (&c);
+      c.x += 1;
+      gimp_bezier_stroke_lineto (stroke, &c);
+      gimp_path_stroke_add (path, stroke);
+      g_object_unref (stroke);
+
+      gimp_image_add_path (image, path, GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+      layer = gimp_vector_layer_new (image, path, context);
+      gimp_image_add_layer (image, GIMP_LAYER (layer), GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+
+      xml = chopgimp_vobjects_to_xml (one);
+      g_list_free (one);
+      chopgimp_vobject_unref (occ);
+
+      busy++;
+      chopgimp_vlayer_set_xml (layer, xml, TRUE);
+      busy--;
+      g_free (xml);
+
+      {
+        ChopGimpVObject *root = chopgimp_vlayer_get_root (layer);
+
+        occ = (root && root->children->len) ? g_ptr_array_index (root->children,
+                                                                 root->children->len - 1)
+                                            : NULL;
+      }
+    }
+  else
+    {
+      busy++;
+      chopgimp_vlayer_insert (layer, occ, NULL, -1, TRUE);
+      busy--;
+    }
+
+  if (occ)
+    chopgimp_vlayer_set_selection (layer, &occ->id, 1);
+
+  gimp_image_undo_group_end (image);
+  chopgimp_vsymbol_free (sym);
+
+  return occ;
+}
+
+gboolean
+chopgimp_vsymbols_rename (GimpImage   *image,
+                          const gchar *id,
+                          const gchar *name)
+{
+  GList           *list = chopgimp_vsymbols_list (image);
+  ChopGimpVSymbol *sym  = list_find (list, id);
+
+  if (! sym || ! name || ! *name)
+    {
+      chopgimp_vsymbols_list_free (list);
+      return FALSE;
+    }
+
+  g_free (sym->name);
+  sym->name = g_strdup (name);
+  symbols_save (image, list, TRUE);
+  chopgimp_vsymbols_list_free (list);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vsymbols_remove (GimpImage   *image,
+                          const gchar *id)
+{
+  GList           *list = chopgimp_vsymbols_list (image);
+  ChopGimpVSymbol *sym  = list_find (list, id);
+
+  if (! sym)
+    {
+      chopgimp_vsymbols_list_free (list);
+      return FALSE;
+    }
+
+  list = g_list_remove (list, sym);
+  chopgimp_vsymbol_free (sym);
+  symbols_save (image, list, TRUE);
+  chopgimp_vsymbols_list_free (list);
+
+  return TRUE;
+}
+
+static GList *
+selected_occurrences (GimpVectorLayer *layer)
+{
+  GList *sel = chopgimp_vlayer_get_selected_objects (layer);
+  GList *out = NULL;
+
+  for (GList *l = sel; l; l = l->next)
+    {
+      ChopGimpVObject *o = chopgimp_vsymbols_occurrence_of (l->data);
+
+      if (o && ! g_list_find (out, o))
+        out = g_list_append (out, o);
+    }
+
+  g_list_free (sel);
+
+  return out;
+}
+
+gboolean
+chopgimp_vsymbols_any_selected (GimpVectorLayer *layer)
+{
+  GList    *occ;
+  gboolean  any;
+
+  if (! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  occ = selected_occurrences (layer);
+  any = occ != NULL;
+  g_list_free (occ);
+
+  return any;
+}
+
+gboolean
+chopgimp_vsymbols_break_link (GimpVectorLayer *layer)
+{
+  GList *occ = chopgimp_vlayer_get_root (layer) ? selected_occurrences (layer) : NULL;
+
+  if (! occ)
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Rompre le lien avec le symbole"));
+
+  for (GList *l = occ; l; l = l->next)
+    g_clear_pointer (&((ChopGimpVObject *) l->data)->symbol, g_free);
+
+  chopgimp_vlayer_subtree_changed (layer, NULL, NULL);
+  g_list_free (occ);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vsymbols_edit (GimpVectorLayer *layer,
+                        const gchar     *id)
+{
+  ChopGimpVObject *occ = NULL;
+  GList           *list;
+  GArray          *ids;
+
+  if (! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  list = selected_occurrences (layer);
+  if (list && (! id || ! g_strcmp0 (((ChopGimpVObject *) list->data)->symbol, id)))
+    occ = list->data;
+  g_list_free (list);
+
+  if (! occ && id)
+    {
+      list = NULL;
+      collect_occurrences (chopgimp_vlayer_get_root (layer), id, &list);
+      occ = list ? list->data : NULL;
+      g_list_free (list);
+    }
+
+  if (! occ)
+    return FALSE;
+
+  chopgimp_vlayer_enter_group (layer, occ->id);
+
+  ids = g_array_new (FALSE, FALSE, sizeof (guint));
+  for (guint i = 0; i < occ->children->len; i++)
+    g_array_append_val (ids, ((ChopGimpVObject *) g_ptr_array_index (occ->children, i))->id);
+
+  chopgimp_vlayer_set_selection (layer, (guint *) ids->data, ids->len);
+  g_array_free (ids, TRUE);
+
+  return TRUE;
+}
