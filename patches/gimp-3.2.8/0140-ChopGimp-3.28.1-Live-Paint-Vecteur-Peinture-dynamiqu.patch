+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vsymbols.h — ChopGimp 3.27.7 (lot V6 point 7): « Symboles »
+ *
+ * A symbol is a set of vector objects kept by the image (parasite
+ * « chopgimp-symbols », saved in the XCF, undoable). Its occurrences are
+ * group objects of vector layers (symbol="<id>") holding a copy of the
+ * symbol's objects, each with its own transformation: they are drawn,
+ * saved and exported as plain groups (an older ChopGimp sees groups).
+ *
+ * Changing the objects of an occurrence (« Modifier le symbole » enters
+ * it) changes the symbol, and every other occurrence follows, in every
+ * layer of the image (on the commit of the changed layer; the other
+ * occurrences follow without undo steps of their own, so an undo of the
+ * change brings them all back). « Rompre le lien » makes an occurrence a
+ * plain group; a deleted symbol leaves its occurrences as they are.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "chopgimp-vobject.h"
+
+G_BEGIN_DECLS
+
+
+typedef struct
+{
+  gchar *id;
+  gchar *name;
+  gchar *xml;      /* chopgimp_vobjects_to_xml() of its objects, no ids */
+} ChopGimpVSymbol;
+
+/*  the symbols of @image, in order (chopgimp_vsymbols_list_free)  */
+GList           * chopgimp_vsymbols_list           (GimpImage       *image);
+void              chopgimp_vsymbols_list_free      (GList           *list);
+/*  a copy (chopgimp_vsymbol_free), NULL if none  */
+ChopGimpVSymbol * chopgimp_vsymbols_lookup         (GimpImage       *image,
+                                                    const gchar     *id);
+void              chopgimp_vsymbol_free            (ChopGimpVSymbol *symbol);
+/*  the objects of a symbol, as the children of a root group (unref)  */
+ChopGimpVObject * chopgimp_vsymbol_get_objects     (GimpImage       *image,
+                                                    const ChopGimpVSymbol *symbol);
+
+/*  the symbol @object is an occurrence of (itself or a group around it),
+ *  or NULL
+ */
+ChopGimpVObject * chopgimp_vsymbols_occurrence_of  (ChopGimpVObject *object);
+
+/*  ─── commands (one undo step each) ─────────────────────────────────── */
+
+/*  « Nouveau symbole »: the selected objects (same parent) become the
+ *  symbol and its first occurrence (selected); its id (g_free) or NULL
+ */
+gboolean          chopgimp_vsymbols_can_make       (GimpVectorLayer *layer);
+gchar           * chopgimp_vsymbols_make           (GimpVectorLayer *layer,
+                                                    const gchar     *name);
+/*  « Placer une occurrence » in the center of the image, on top of @layer
+ *  (NULL: a new vector layer is made); the new occurrence or NULL
+ */
+ChopGimpVObject * chopgimp_vsymbols_place          (GimpImage       *image,
+                                                    GimpVectorLayer *layer,
+                                                    const gchar     *id,
+                                                    GimpContext     *context);
+gboolean          chopgimp_vsymbols_rename         (GimpImage       *image,
+                                                    const gchar     *id,
+                                                    const gchar     *name);
+gboolean          chopgimp_vsymbols_remove         (GimpImage       *image,
+                                                    const gchar     *id);
+/*  « Rompre le lien »: the selected occurrences become plain groups  */
+gboolean          chopgimp_vsymbols_any_selected   (GimpVectorLayer *layer);
+gboolean          chopgimp_vsymbols_break_link     (GimpVectorLayer *layer);
+/*  « Modifier le symbole »: enters the selected occurrence (or the first
+ *  occurrence of @id in @layer) and selects its objects; FALSE if none
+ */
+gboolean          chopgimp_vsymbols_edit           (GimpVectorLayer *layer,
+                                                    const gchar     *id);
+/*  the number of occurrences of @id in the image  */
+gint              chopgimp_vsymbols_count_uses     (GimpImage       *image,
+                                                    const gchar     *id);
+
+/*  called by the layer after each change (chopgimp-vobject.c); TRUE
+ *  when objects of @layer were replaced (new ones have id 0)
+ */
+gboolean          chopgimp_vsymbols_layer_changed  (GimpVectorLayer *layer);
+
+
+G_END_DECLS
