+
+#define TOL_PX 5.0
+
+typedef struct
+{
+  GimpDrawTool     parent_instance;
+
+  gboolean         select;     /* the selection tool                     */
+  GimpVectorLayer *layer;      /* weak                                   */
+  guint            hover;      /* object id under the pointer, 0: none   */
+  gboolean         hover_edge;
+} GimpLivePaintTool;
+
+typedef struct
+{
+  GimpDrawToolClass parent_class;
+} GimpLivePaintToolClass;
+
+GType gimp_live_paint_tool_get_type        (void) G_GNUC_CONST;
+GType gimp_live_paint_select_tool_get_type (void) G_GNUC_CONST;
+
+G_DEFINE_TYPE (GimpLivePaintTool, gimp_live_paint_tool, GIMP_TYPE_DRAW_TOOL)
+
+/*  the selection tool is the same class with select = TRUE  */
+typedef GimpLivePaintTool      GimpLivePaintSelectTool;
+typedef GimpLivePaintToolClass GimpLivePaintSelectToolClass;
+
+G_DEFINE_TYPE (GimpLivePaintSelectTool, gimp_live_paint_select_tool,
+               gimp_live_paint_tool_get_type ())
+
+
+/*  ─── tool options: color buttons for the selection ─────────────────── */
+
+static GimpVectorLayer *
+lp_layer_of (Gimp *gimp)
+{
+  GimpContext *context = gimp_get_user_context (gimp);
+  GimpImage   *image   = context ? gimp_context_get_image (context) : NULL;
+
+  return image ? chopgimp_vobjects_get_target_layer (image) : NULL;
+}
+
+static void
+lp_apply_clicked (GtkWidget       *button,
+                  GimpToolOptions *options)
+{
+  Gimp            *gimp  = GIMP_CONTEXT (options)->gimp;
+  GimpVectorLayer *layer = lp_layer_of (gimp);
+  gint             which = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (button), "which"));
+  GeglColor       *fg;
+  GList           *sel;
+  gboolean         pushed = FALSE;
+
+  if (! layer)
+    return;
+
+  fg  = gimp_context_get_foreground (gimp_get_user_context (gimp));
+  sel = chopgimp_vlayer_get_selected_objects (layer);
+
+  chopgimp_vlayer_freeze (layer);
+
+  for (GList *l = sel; l; l = l->next)
+    {
+      ChopGimpVObject *o    = l->data;
+      gboolean         edge = (which == 1);
+
+      if (o->kind != CHOPGIMP_VOBJECT_PATH)
+        continue;
+
+      if (! pushed)
+        {
+          chopgimp_vlayer_push_undo (layer, _("Peinture dynamique"));
+          pushed = TRUE;
+        }
+
+      if (which == 2)
+        {
+          ChopGimpVEntry *e = chopgimp_vstyle_get_fill (&o->style);
+
+          if (e)
+            chopgimp_vpaint_clear (&e->paint);
+          chopgimp_vlayer_object_changed (layer, o);
+        }
+      else
+        {
+          ChopGimpVEntry *e = edge ? chopgimp_vstyle_ensure_stroke (&o->style)
+                                   : chopgimp_vstyle_ensure_fill (&o->style);
+
+          chopgimp_vpaint_set_color (&e->paint, fg);
+          g_clear_pointer (&e->paint.global_id, g_free);
+          e->visible = TRUE;
+          if (e->opacity <= 0.0)
+            e->opacity = 1.0;
+          if (edge && e->width <= 0.0)
+            e->width = 1.0;
+          chopgimp_vlayer_object_changed (layer, o);
+        }
+    }
+
+  chopgimp_vlayer_thaw (layer);
+  g_list_free (sel);
+
+  if (pushed)
+    gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+}
+
+static GtkWidget *
+lp_options_gui_common (GimpToolOptions *options,
+                       gboolean         select)
+{
+  GtkWidget *vbox  = gimp_tool_options_gui (options);
+  GtkWidget *label = gtk_label_new (select
+                                    ? _("Clic : sélectionner une zone (ou un segment près "
+                                        "du pointeur), Maj+clic : ajouter. Le panneau "
+                                        "Aspect et les boutons ci-dessous changent leur "
+                                        "fond ou leur contour.")
+                                    : _("Clic : remplir la zone avec la couleur de premier "
+                                        "plan. Maj+clic : peindre le segment de tracé. "
+                                        "Alt+clic : prendre la couleur de la zone. "
+                                        "Créer le groupe : Vecteur > Peinture dynamique > "
+                                        "Créer (Ctrl+Maj+Alt+X)."));
+
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (label), TRUE);
+  gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 0);
+  gtk_widget_show (label);
+
+  if (select)
+    {
+      const gchar *labels[] = { N_("Fond ← premier plan"),
+                                N_("Contour ← premier plan"),
+                                N_("Aucun fond") };
+
+      for (gint i = 0; i < 3; i++)
+        {
+          GtkWidget *b = gtk_button_new_with_label (_(labels[i]));
+
+          g_object_set_data (G_OBJECT (b), "which", GINT_TO_POINTER (i));
+          g_signal_connect (b, "clicked", G_CALLBACK (lp_apply_clicked), options);
+          gtk_box_pack_start (GTK_BOX (vbox), b, FALSE, FALSE, 0);
+          gtk_widget_show (b);
+        }
+    }
+
+  return vbox;
+}
+
+static GtkWidget *
+lp_bucket_options_gui (GimpToolOptions *options)
+{
+  return lp_options_gui_common (options, FALSE);
+}
+
+static GtkWidget *
+lp_select_options_gui (GimpToolOptions *options)
+{
+  return lp_options_gui_common (options, TRUE);
+}
+
+void
+gimp_live_paint_bucket_tool_register (GimpToolRegisterCallback  callback,
+                                      gpointer                  data)
+{
+  (* callback) (gimp_live_paint_tool_get_type (),
+                GIMP_TYPE_TOOL_OPTIONS,
+                lp_bucket_options_gui,
+                GIMP_CONTEXT_PROP_MASK_FOREGROUND,
+                "gimp-live-paint-bucket-tool",
+                _("Pot de peinture dynamique"),
+                _("Pot de peinture dynamique : remplir les zones et peindre les segments "
+                  "d'un groupe de peinture dynamique (K)"),
+                N_("Pot de peinture _dynamique"), NULL,
+                NULL, GIMP_HELP_TOOL_PATH,
+                "chopgimp-tool-live-paint-bucket",
+                data);
+}
+
+void
+gimp_live_paint_select_tool_register (GimpToolRegisterCallback  callback,
+                                      gpointer                  data)
+{
+  (* callback) (gimp_live_paint_select_tool_get_type (),
+                GIMP_TYPE_TOOL_OPTIONS,
+                lp_select_options_gui,
+                GIMP_CONTEXT_PROP_MASK_FOREGROUND,
+                "gimp-live-paint-select-tool",
+                _("Sélection de peinture dynamique"),
+                _("Sélection de peinture dynamique : sélectionner des zones et des "
+                  "segments d'un groupe de peinture dynamique (Maj+K)"),
+                N_("Sélection de peinture d_ynamique"), NULL,
+                NULL, GIMP_HELP_TOOL_PATH,
+                "chopgimp-tool-live-paint-select",
+                data);
+}
+
+
+/*  ─── picking ───────────────────────────────────────────────────────── */
+
+static ChopGimpVObject *
+lp_pick (GimpLivePaintTool *lp,
+         GimpDisplay       *display,
+         const GimpCoords  *coords,
+         gboolean           edge_first,
+         gboolean          *is_edge)
+{
+  GimpImage        *image = gimp_display_get_image (display);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           tol   = TOL_PX / MAX (1e-6, shell->scale_x);
+  ChopGimpVObject  *o     = NULL;
+
+  lp->layer = image ? chopgimp_vobjects_get_target_layer (image) : NULL;
+
+  if (! lp->layer)
+    return NULL;
+
+  *is_edge = FALSE;
+
+  if (edge_first)
+    {
+      o = chopgimp_vlivepaint_pick (lp->layer, coords->x, coords->y, TRUE, tol);
+      *is_edge = (o != NULL);
+    }
+
+  if (! o)
+    o = chopgimp_vlivepaint_pick (lp->layer, coords->x, coords->y, FALSE, tol);
+
+  return o;
+}
+
+static void
+gimp_live_paint_tool_oper_update (GimpTool         *tool,
+                                  const GimpCoords *coords,
+                                  GdkModifierType   state,
+                                  gboolean          proximity,
+                                  GimpDisplay      *display)
+{
+  GimpLivePaintTool *lp   = (GimpLivePaintTool *) tool;
+  gboolean           edge = FALSE;
+  ChopGimpVObject   *o    = NULL;
+
+  if (proximity)
+    o = lp_pick (lp, display, coords,
+                 lp->select || (state & gimp_get_extend_selection_mask ()), &edge);
+
+  lp->hover      = o ? o->id : 0;
+  lp->hover_edge = edge;
+
+  if (! lp->layer)
+    gimp_tool_replace_status (tool, display,
+                              _("Sélectionnez un calque vectoriel avec un groupe de "
+                                "peinture dynamique (Vecteur > Peinture dynamique > Créer)"));
+  else if (! o)
+    gimp_tool_replace_status (tool, display,
+                              chopgimp_vlivepaint_can_make (lp->layer)
+                              ? _("Pas de peinture dynamique ici : Vecteur > Peinture "
+                                  "dynamique > Créer (Ctrl+Maj+Alt+X) sur les objets "
+                                  "sélectionnés")
+                              : _("Survolez une zone d'un groupe de peinture dynamique"));
+  else if (lp->select)
+    gimp_tool_replace_status (tool, display,
+                              edge ? _("Clic : sélectionner ce segment, Maj+clic : ajouter")
+                                   : _("Clic : sélectionner cette zone, Maj+clic : ajouter"));
+  else
+    gimp_tool_replace_status (tool, display,
+                              edge ? _("Clic : peindre ce segment (couleur de premier plan)")
+                                   : _("Clic : remplir cette zone — Maj : segment, "
+                                       "Alt : prendre sa couleur"));
+
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (lp), display);
+}
+
+static void
+gimp_live_paint_tool_button_press (GimpTool            *tool,
+                                   const GimpCoords    *coords,
+                                   guint32              time,
+                                   GdkModifierType      state,
+                                   GimpButtonPressType  press_type,
+                                   GimpDisplay         *display)
+{
+  GimpLivePaintTool *lp      = (GimpLivePaintTool *) tool;
+  GimpImage         *image   = gimp_display_get_image (display);
+  GimpContext       *context = gimp_get_user_context (image->gimp);
+  gboolean           shift   = (state & gimp_get_extend_selection_mask ()) != 0;
+  gboolean           alt     = (state & GDK_MOD1_MASK) != 0;
+  gboolean           edge    = FALSE;
+  ChopGimpVObject   *o;
+
+  if (press_type != GIMP_BUTTON_PRESS_NORMAL || ! image)
+    return;
+
+  o = lp_pick (lp, display, coords, lp->select || shift, &edge);
+
+  if (lp->select)
+    {
+      if (! lp->layer)
+        return;
+
+      if (o)
+        {
+          if (shift && chopgimp_vlayer_is_selected (lp->layer, o->id))
+            chopgimp_vlayer_deselect (lp->layer, o->id);
+          else
+            chopgimp_vlayer_select (lp->layer, o->id, shift);
+        }
+      else if (! shift)
+        {
+          chopgimp_vlayer_set_selection (lp->layer, NULL, 0);
+        }
+
+      gimp_image_flush (image);
+    }
+  else if (o)
+    {
+      if (alt)
+        {
+          ChopGimpVEntry *e = edge ? chopgimp_vstyle_get_stroke (&o->style)
+                                   : chopgimp_vstyle_get_fill (&o->style);
+          GeglColor      *c = e ? chopgimp_vpaint_get_main_color (&e->paint) : NULL;
+
+          if (c)
+            gimp_context_set_foreground (context, c);
+        }
+      else
+        {
+          chopgimp_vlivepaint_paint (lp->layer, o,
+                                     gimp_context_get_foreground (context), edge);
+          gimp_image_flush (image);
+        }
+    }
+
+  tool->display = display;
+  chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (lp), display);
+}
+
+static void
+lp_add_outline (GimpDrawTool    *dt,
+                GimpVectorLayer *layer,
+                ChopGimpVObject *o,
+                gboolean         highlight)
+{
+  GimpDisplayShell *shell = gimp_display_get_shell (dt->display);
+  GimpPath         *wp    = chopgimp_vobject_get_world_path (layer, o, FALSE);
+  GimpCanvasItem   *item;
+
+  if (! wp)
+    return;
+
+  g_object_ref_sink (wp);
+
+  if (gimp_path_get_bezier (wp))
+    {
+      item = gimp_canvas_path_new (shell, gimp_path_get_bezier (wp), 0, 0,
+                                   FALSE, GIMP_PATH_STYLE_DEFAULT);
+      gimp_canvas_item_set_highlight (item, highlight);
+      gimp_draw_tool_add_item (dt, item);
+      g_object_unref (item);
+    }
+
+  g_object_unref (wp);
+}
+
+static void
+gimp_live_paint_tool_draw (GimpDrawTool *dt)
+{
+  GimpLivePaintTool *lp = (GimpLivePaintTool *) dt;
+  ChopGimpVObject   *o;
+
+  if (! lp->layer || ! gimp_item_is_attached (GIMP_ITEM (lp->layer)))
+    return;
+
+  if (lp->select)
+    {
+      GList *sel = chopgimp_vlayer_get_selected_objects (lp->layer);
+
+      for (GList *l = sel; l; l = l->next)
+        {
+          ChopGimpLivePaintRole role = chopgimp_vlivepaint_role (l->data);
+
+          if (role == CHOPGIMP_LIVEPAINT_FACE || role == CHOPGIMP_LIVEPAINT_EDGE)
+            lp_add_outline (dt, lp->layer, l->data, FALSE);
+        }
+
+      g_list_free (sel);
+    }
+
+  if (lp->hover && (o = chopgimp_vlayer_get_object (lp->layer, lp->hover)))
+    lp_add_outline (dt, lp->layer, o, TRUE);
+}
+
+static void
+gimp_live_paint_tool_control (GimpTool       *tool,
+                              GimpToolAction  action,
+                              GimpDisplay    *display)
+{
+  GimpLivePaintTool *lp = (GimpLivePaintTool *) tool;
+
+  if (action == GIMP_TOOL_ACTION_HALT || action == GIMP_TOOL_ACTION_COMMIT)
+    {
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+      lp->layer = NULL;
+      lp->hover = 0;
+    }
+
+  GIMP_TOOL_CLASS (gimp_live_paint_tool_parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_live_paint_tool_class_init (GimpLivePaintToolClass *klass)
+{
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  tool_class->is_destructive = FALSE;
+
+  tool_class->control        = gimp_live_paint_tool_control;
+  tool_class->oper_update    = gimp_live_paint_tool_oper_update;
+  tool_class->button_press   = gimp_live_paint_tool_button_press;
+
+  draw_tool_class->draw      = gimp_live_paint_tool_draw;
+}
+
+static void
+gimp_live_paint_tool_init (GimpLivePaintTool *lp)
+{
+  GimpTool *tool = GIMP_TOOL (lp);
+
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_BUCKET_FILL);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_MOUSE);
+}
+
+static void
+gimp_live_paint_select_tool_class_init (GimpLivePaintSelectToolClass *klass)
+{
+}
+
+static void
+gimp_live_paint_select_tool_init (GimpLivePaintSelectTool *lp)
+{
+  GimpTool *tool = GIMP_TOOL (lp);
+
+  lp->select = TRUE;
+
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_PATHS);
+}
