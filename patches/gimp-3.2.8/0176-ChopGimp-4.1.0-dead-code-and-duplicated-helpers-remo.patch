+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vutil.h — ChopGimp 4.1.0: helpers shared by the vector object
+ * modules (formerly copied in chopgimp-vbrush.c, chopgimp-vrepeat.c,
+ * chopgimp-vmaterial.c, chopgimp-vcolors.c and chopgimp-vobject.c).
+ *
+ * A « spec » is the « blend » field of a dynamic group (Transition,
+ * brush, repeat): words « key=value » separated by spaces, the last one
+ * « sig=S » being the signature of what the generated children were made
+ * from.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+
+/*  value of « @key=… » in @spec (newly allocated), NULL when absent  */
+gchar    * chopgimp_spec_word      (const gchar     *spec,
+                                    const gchar     *key);
+/*  same, as a number; @def when absent or not finite  */
+gdouble    chopgimp_spec_dbl       (const gchar     *spec,
+                                    const gchar     *key,
+                                    gdouble          def);
+/*  @spec without its « sig=… » word  */
+gchar    * chopgimp_spec_body      (const gchar     *spec);
+/*  appends « @key=@v » (%.6g, C locale) after a space  */
+void       chopgimp_spec_put_dbl   (GString         *s,
+                                    const gchar     *key,
+                                    gdouble          v);
+/*  MD5 of the spec body of @g and of the XML of @src  */
+gchar    * chopgimp_spec_signature (ChopGimpVObject *g,
+                                    ChopGimpVObject *src);
+
+/*  appends @v (%.12g, C locale, -0 and tiny values written 0)  */
+void       chopgimp_put_num        (GString         *s,
+                                    gdouble          v);
+
+/*  the world path of @o in the coordinates of the group @g  */
+GimpPath * chopgimp_vobject_path_in (GimpVectorLayer *layer,
+                                     ChopGimpVObject *o,
+                                     ChopGimpVObject *g);
+
+/*  a point with the default pressure, tilt, etc.  */
+GimpCoords chopgimp_coords          (gdouble          x,
+                                     gdouble          y);
+/*  box of the anchors and handles of @path: @b = x1, y1, x2, y2; FALSE
+ *  when it has none
+ */
+gboolean   chopgimp_path_anchor_bbox (GimpPath       *path,
+                                      gdouble         b[4]);
