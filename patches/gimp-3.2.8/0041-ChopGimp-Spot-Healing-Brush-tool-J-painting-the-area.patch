+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpconfig/gimpconfig.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "tools-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpchannel.h"
+#include "core/gimpchannel-select.h"
+#include "core/gimpimage.h"
+#include "core/gimpimage-undo.h"
+#include "core/gimplayer.h"
+#include "core/gimpparamspecs.h"
+#include "core/gimpprogress.h"
+#include "core/gimptooloptions.h"
+
+#include "pdb/gimppdb.h"
+
+#include "display/gimpdisplay.h"
+#include "display/gimpdisplayshell.h"
+
+#include "chopgimp-spothealtool.h"
+#include "gimptoolcontrol.h"
+#include "gimptooloptions-gui.h"
+
+#include "gimp-intl.h"
+
+
+/*  options  */
+
+enum
+{
+  PROP_0,
+  PROP_SIZE
+};
+
+typedef struct
+{
+  GimpToolOptions  parent_instance;
+  gdouble          size;
+} GimpSpotHealOptions;
+
+typedef struct
+{
+  GimpToolOptionsClass  parent_class;
+} GimpSpotHealOptionsClass;
+
+G_DEFINE_TYPE (GimpSpotHealOptions, gimp_spot_heal_options, GIMP_TYPE_TOOL_OPTIONS)
+
+static void
+gimp_spot_heal_options_set_property (GObject      *object,
+                                     guint         property_id,
+                                     const GValue *value,
+                                     GParamSpec   *pspec)
+{
+  GimpSpotHealOptions *options = (GimpSpotHealOptions *) object;
+
+  if (property_id == PROP_SIZE)
+    options->size = g_value_get_double (value);
+  else
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+}
+
+static void
+gimp_spot_heal_options_get_property (GObject    *object,
+                                     guint       property_id,
+                                     GValue     *value,
+                                     GParamSpec *pspec)
+{
+  GimpSpotHealOptions *options = (GimpSpotHealOptions *) object;
+
+  if (property_id == PROP_SIZE)
+    g_value_set_double (value, options->size);
+  else
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+}
+
+static void
+gimp_spot_heal_options_class_init (GimpSpotHealOptionsClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->set_property = gimp_spot_heal_options_set_property;
+  object_class->get_property = gimp_spot_heal_options_get_property;
+
+  GIMP_CONFIG_PROP_DOUBLE (object_class, PROP_SIZE,
+                           "size",
+                           _("Taille"),
+                           _("Diamètre du correcteur, en pixels"),
+                           1.0, 1000.0, 40.0,
+                           GIMP_PARAM_STATIC_STRINGS);
+}
+
+static void
+gimp_spot_heal_options_init (GimpSpotHealOptions *options)
+{
+}
+
+static GtkWidget *
+gimp_spot_heal_options_gui (GimpToolOptions *tool_options)
+{
+  GObject   *config = G_OBJECT (tool_options);
+  GtkWidget *vbox   = gimp_tool_options_gui (tool_options);
+  GtkWidget *scale;
+  GtkWidget *label;
+
+  scale = gimp_prop_spin_scale_new (config, "size", 1.0, 10.0, 0);
+  gimp_spin_scale_set_scale_limits (GIMP_SPIN_SCALE (scale), 1.0, 300.0);
+  gimp_spin_scale_set_gamma (GIMP_SPIN_SCALE (scale), 1.7);
+  gtk_box_pack_start (GTK_BOX (vbox), scale, FALSE, FALSE, 0);
+
+  label = gtk_label_new (_("Peignez sur le défaut : la zone est reconstruite "
+                           "d'après son entourage au relâchement.\n"
+                           "[ et ] : taille du correcteur."));
+  gtk_label_set_line_wrap (GTK_LABEL (label), TRUE);
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gimp_label_set_attributes (GTK_LABEL (label),
+                             PANGO_ATTR_SCALE, PANGO_SCALE_SMALL, -1);
+  gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 0);
+  gtk_widget_show (label);
+
+  return vbox;
+}
+
+
+/*  tool  */
+
+typedef struct
+{
+  GimpDrawTool  parent_instance;
+
+  GArray       *points;        /* GimpVector2, image coordinates */
+  gdouble       cx, cy;        /* pointer, for the brush outline */
+  gboolean      show_cursor;
+} GimpSpotHealTool;
+
+typedef struct
+{
+  GimpDrawToolClass  parent_class;
+} GimpSpotHealToolClass;
+
+G_DEFINE_TYPE (GimpSpotHealTool, gimp_spot_heal_tool, GIMP_TYPE_DRAW_TOOL)
+
+#define SPOT_HEAL_OPTIONS(t) ((GimpSpotHealOptions *) gimp_tool_get_options (GIMP_TOOL (t)))
+
+
+void
+gimp_spot_heal_tool_register (GimpToolRegisterCallback  callback,
+                              gpointer                  data)
+{
+  (* callback) (GIMP_TYPE_SPOT_HEAL_TOOL,
+                GIMP_TYPE_SPOT_HEAL_OPTIONS,
+                gimp_spot_heal_options_gui,
+                0,
+                "gimp-spot-heal-tool",
+                _("Correcteur localisé"),
+                _("Correcteur localisé : peignez sur un défaut, il est remplacé "
+                  "par une texture reconstruite d'après les alentours"),
+                N_("Correcteur _localisé"), "J",
+                NULL, "gimp-tool-heal",
+                "chopgimp-tool-spot-heal",
+                data);
+}
+
+static void
+spot_heal_redraw (GimpSpotHealTool *st,
+                  GimpDisplay      *display)
+{
+  GimpDrawTool *draw_tool = GIMP_DRAW_TOOL (st);
+
+  gimp_draw_tool_pause (draw_tool);
+
+  if (gimp_draw_tool_is_active (draw_tool) && draw_tool->display != display)
+    gimp_draw_tool_stop (draw_tool);
+
+  if (! gimp_draw_tool_is_active (draw_tool))
+    gimp_draw_tool_start (draw_tool, display);
+
+  gimp_draw_tool_resume (draw_tool);
+}
+
+static void
+spot_heal_add_point (GimpSpotHealTool *st,
+                     gdouble           x,
+                     gdouble           y,
+                     gboolean          force)
+{
+  GimpVector2 p = { x, y };
+
+  if (! force && st->points->len)
+    {
+      GimpVector2 *last    = &g_array_index (st->points, GimpVector2,
+                                             st->points->len - 1);
+      gdouble      spacing = MAX (1.0, SPOT_HEAL_OPTIONS (st)->size / 8.0);
+
+      if (hypot (x - last->x, y - last->y) < spacing)
+        return;
+    }
+
+  g_array_append_val (st->points, p);
+}
+
+static void
+gimp_spot_heal_tool_button_press (GimpTool            *tool,
+                                  const GimpCoords    *coords,
+                                  guint32              time,
+                                  GdkModifierType      state,
+                                  GimpButtonPressType  press_type,
+                                  GimpDisplay         *display)
+{
+  GimpSpotHealTool *st    = (GimpSpotHealTool *) tool;
+  GimpImage        *image = gimp_display_get_image (display);
+  GList            *drawables;
+  const gchar      *message = NULL;
+
+  if (press_type != GIMP_BUTTON_PRESS_NORMAL)
+    return;
+
+  drawables = gimp_image_get_selected_drawables (image);
+
+  if (g_list_length (drawables) != 1)
+    message = _("Sélectionnez un seul calque.");
+  else if (gimp_viewable_get_children (GIMP_VIEWABLE (drawables->data)))
+    message = _("Impossible de corriger un groupe de calques.");
+  else if (gimp_item_is_content_locked (GIMP_ITEM (drawables->data), NULL))
+    message = _("Les pixels de ce calque sont verrouillés.");
+
+  g_list_free (drawables);
+
+  if (message)
+    {
+      gimp_tool_message_literal (tool, display, message);
+      return;
+    }
+
+  tool->display = display;
+  g_array_set_size (st->points, 0);
+  spot_heal_add_point (st, coords->x, coords->y, TRUE);
+
+  gimp_tool_control_activate (tool->control);
+  spot_heal_redraw (st, display);
+}
+
+static void
+gimp_spot_heal_tool_motion (GimpTool         *tool,
+                            const GimpCoords *coords,
+                            guint32           time,
+                            GdkModifierType   state,
+                            GimpDisplay      *display)
+{
+  GimpSpotHealTool *st = (GimpSpotHealTool *) tool;
+
+  st->cx = coords->x;
+  st->cy = coords->y;
+  spot_heal_add_point (st, coords->x, coords->y, FALSE);
+  spot_heal_redraw (st, display);
+}
+
+static void
+spot_heal_apply (GimpSpotHealTool *st,
+                 GimpDisplay      *display)
+{
+  GimpTool       *tool    = GIMP_TOOL (st);
+  GimpImage      *image   = gimp_display_get_image (display);
+  Gimp           *gimp    = image->gimp;
+  GimpChannel    *mask    = gimp_image_get_mask (image);
+  GimpChannel    *saved   = NULL;
+  GList          *drawables;
+  GimpDrawable   *array[2] = { NULL, NULL };
+  GimpValueArray *return_vals;
+  GError         *error   = NULL;
+  gint            r       = MAX (1, (gint) (SPOT_HEAL_OPTIONS (st)->size / 2.0 + 0.5));
+  guint           i;
+
+  drawables = gimp_image_get_selected_drawables (image);
+  if (! drawables)
+    return;
+  array[0] = drawables->data;
+  g_list_free (drawables);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC,
+                               _("Correcteur localisé"));
+
+  if (! gimp_channel_is_empty (mask))
+    saved = GIMP_CHANNEL (gimp_item_duplicate (GIMP_ITEM (mask), GIMP_TYPE_CHANNEL));
+
+  /*  the painted stroke becomes the area to rebuild  */
+  for (i = 0; i < st->points->len; i++)
+    {
+      GimpVector2 *p = &g_array_index (st->points, GimpVector2, i);
+
+      gimp_channel_select_ellipse (mask,
+                                   (gint) (p->x - r), (gint) (p->y - r),
+                                   2 * r, 2 * r,
+                                   i == 0 ? GIMP_CHANNEL_OP_REPLACE
+                                          : GIMP_CHANNEL_OP_ADD,
+                                   TRUE, FALSE, 0.0, 0.0,
+                                   i == 0);
+    }
+
+  return_vals =
+    gimp_pdb_execute_procedure_by_name (gimp->pdb,
+                                        gimp_get_user_context (gimp),
+                                        GIMP_PROGRESS (display),
+                                        &error,
+                                        "chopgimp-content-aware-fill",
+                                        GIMP_TYPE_RUN_MODE,          GIMP_RUN_NONINTERACTIVE,
+                                        GIMP_TYPE_IMAGE,             image,
+                                        GIMP_TYPE_CORE_OBJECT_ARRAY, array,
+                                        G_TYPE_NONE);
+
+  if (g_value_get_enum (gimp_value_array_index (return_vals, 0)) != GIMP_PDB_SUCCESS)
+    gimp_tool_message_literal (tool, display,
+                               error ? error->message :
+                               _("La correction a échoué (module Resynthesizer absent ?)."));
+  g_clear_error (&error);
+  gimp_value_array_unref (return_vals);
+
+  /*  give the user's selection back  */
+  if (saved)
+    {
+      gimp_channel_select_channel (mask, NULL, saved, 0, 0,
+                                   GIMP_CHANNEL_OP_REPLACE, FALSE, 0.0, 0.0);
+      g_object_unref (saved);
+    }
+  else
+    {
+      gimp_channel_clear (mask, NULL, TRUE);
+    }
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+}
+
+static void
+gimp_spot_heal_tool_button_release (GimpTool              *tool,
+                                    const GimpCoords      *coords,
+                                    guint32                time,
+                                    GdkModifierType        state,
+                                    GimpButtonReleaseType  release_type,
+                                    GimpDisplay           *display)
+{
+  GimpSpotHealTool *st = (GimpSpotHealTool *) tool;
+
+  gimp_tool_control_halt (tool->control);
+
+  if (release_type != GIMP_BUTTON_RELEASE_CANCEL && st->points->len)
+    spot_heal_apply (st, display);
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (st));
+  g_array_set_size (st->points, 0);
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (st));
+}
+
+static gboolean
+gimp_spot_heal_tool_key_press (GimpTool    *tool,
+                               GdkEventKey *kevent,
+                               GimpDisplay *display)
+{
+  GimpSpotHealOptions *options = SPOT_HEAL_OPTIONS (tool);
+
+  /*  Photoshop: [ and ] change the brush size  */
+  if (kevent->keyval == GDK_KEY_bracketleft ||
+      kevent->keyval == GDK_KEY_bracketright)
+    {
+      gdouble step = MAX (1.0, options->size * 0.1);
+      gdouble size = options->size +
+                     (kevent->keyval == GDK_KEY_bracketright ? step : -step);
+
+      g_object_set (options, "size", CLAMP (size, 1.0, 1000.0), NULL);
+      spot_heal_redraw ((GimpSpotHealTool *) tool, display);
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+static void
+gimp_spot_heal_tool_oper_update (GimpTool         *tool,
+                                 const GimpCoords *coords,
+                                 GdkModifierType   state,
+                                 gboolean          proximity,
+                                 GimpDisplay      *display)
+{
+  GimpSpotHealTool *st = (GimpSpotHealTool *) tool;
+
+  st->cx          = coords->x;
+  st->cy          = coords->y;
+  st->show_cursor = proximity;
+
+  spot_heal_redraw (st, display);
+}
+
+static void
+gimp_spot_heal_tool_draw (GimpDrawTool *draw_tool)
+{
+  GimpSpotHealTool    *st      = (GimpSpotHealTool *) draw_tool;
+  GimpSpotHealOptions *options = SPOT_HEAL_OPTIONS (st);
+  gdouble              d       = options->size;
+
+  if (st->points->len)
+    {
+      GimpDisplayShell *shell = gimp_display_get_shell (draw_tool->display);
+
+      gimp_draw_tool_add_pen (draw_tool,
+                              (const GimpVector2 *) st->points->data,
+                              st->points->len,
+                              GIMP_CONTEXT (options),
+                              GIMP_ACTIVE_COLOR_FOREGROUND,
+                              MAX (1, (gint) (d * shell->scale_y)));
+    }
+
+  if (st->show_cursor || st->points->len)
+    gimp_draw_tool_add_arc (draw_tool, FALSE,
+                            st->cx - d / 2.0, st->cy - d / 2.0, d, d,
+                            0.0, 2.0 * G_PI);
+}
+
+static void
+gimp_spot_heal_tool_finalize (GObject *object)
+{
+  GimpSpotHealTool *st = (GimpSpotHealTool *) object;
+
+  g_clear_pointer (&st->points, g_array_unref);
+
+  G_OBJECT_CLASS (gimp_spot_heal_tool_parent_class)->finalize (object);
+}
+
+static void
+gimp_spot_heal_tool_class_init (GimpSpotHealToolClass *klass)
+{
+  GObjectClass      *object_class    = G_OBJECT_CLASS (klass);
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  object_class->finalize     = gimp_spot_heal_tool_finalize;
+
+  tool_class->button_press   = gimp_spot_heal_tool_button_press;
+  tool_class->motion         = gimp_spot_heal_tool_motion;
+  tool_class->button_release = gimp_spot_heal_tool_button_release;
+  tool_class->key_press      = gimp_spot_heal_tool_key_press;
+  tool_class->oper_update    = gimp_spot_heal_tool_oper_update;
+
+  draw_tool_class->draw      = gimp_spot_heal_tool_draw;
+}
+
+static void
+gimp_spot_heal_tool_init (GimpSpotHealTool *st)
+{
+  GimpTool *tool = GIMP_TOOL (st);
+
+  st->points = g_array_new (FALSE, FALSE, sizeof (GimpVector2));
+
+  gimp_tool_control_set_motion_mode (tool->control, GIMP_MOTION_MODE_EXACT);
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_HEAL);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_MOUSE);
+  gimp_tool_control_set_wants_click (tool->control, TRUE);
+}
