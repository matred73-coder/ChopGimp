+/*  ChopGimp 3.31.0: Fichier > Exporter les plans de travail…  */
+void
+file_export_artboards_cmd_callback (GimpAction *action,
+                                    GVariant   *value,
+                                    gpointer    data)
+{
+  GimpDisplay *display;
+  GimpImage   *image;
+  return_if_no_display (display, data);
+
+  image = gimp_display_get_image (display);
+
+  if (chopgimp_artboards_count (image) == 0)
+    {
+      gimp_message_literal (image->gimp, G_OBJECT (gimp_display_get_shell (display)),
+                            GIMP_MESSAGE_WARNING,
+                            _("L'image n'a pas de plan de travail : créez-en avec l'outil "
+                              "Plan de travail (Maj+O)."));
+      return;
+    }
+
+  chopgimp_artboards_export_dialog (image, action_data_get_context (data),
+                                    GTK_WIDGET (gimp_display_get_shell (display)));
+}
