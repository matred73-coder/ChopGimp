+/*  ─── ChopGimp 3.31.0: perspective grid (Affichage > Grille de
+ *  perspective) and artboards
+ */
+
+static void
+pgrid_change (GimpImage   *image,
+              const gchar *what,
+              gint         value)
+{
+  ChopGimpPGrid g;
+
+  chopgimp_pgrid_get (image, &g);
+
+  if (! strcmp (what, "show"))
+    {
+      if (g.visible == (value != 0))
+        return;
+      g.visible = value != 0;
+    }
+  else if (! strcmp (what, "snap"))
+    {
+      if (g.snap == (value != 0))
+        return;
+      g.snap = value != 0;
+    }
+  else if (! strcmp (what, "lock"))
+    {
+      if (g.locked == (value != 0))
+        return;
+      g.locked = value != 0;
+    }
+  else if (! strcmp (what, "type"))
+    {
+      chopgimp_pgrid_set_type (&g, value,
+                               gimp_image_get_width (image), gimp_image_get_height (image));
+      g.visible = TRUE;
+    }
+  else if (! strcmp (what, "reset"))
+    {
+      chopgimp_pgrid_init (&g, g.type ? g.type : 2,
+                           gimp_image_get_width (image), gimp_image_get_height (image));
+      g.visible = TRUE;
+    }
+
+  chopgimp_pgrid_set (image, &g, _("Grille de perspective"), FALSE);
+  gimp_image_flush (image);
+}
+
+void
+view_perspective_grid_show_cmd_callback (GimpAction *action,
+                                         GVariant   *value,
+                                         gpointer    data)
+{
