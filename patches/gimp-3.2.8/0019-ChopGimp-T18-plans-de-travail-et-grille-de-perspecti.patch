+/*  ─── the grid tool ─────────────────────────────────────────────────── */
+
+typedef enum
+{
+  GH_NONE = -1,
+  GH_VL,
+  GH_VR,
+  GH_VV,
+  GH_HORIZON,
+  GH_ORIGIN,
+  GH_EXT_L,
+  GH_EXT_R,
+  GH_HEIGHT,
+  GH_CELL,
+  GH_OFF_L,
+  GH_OFF_R,
+  GH_OFF_F,
+  GH_LAST
+} GridHandle;
+
+typedef struct
+{
+  GimpDrawTool   parent_instance;
+
+  GimpImage     *image;       /* weak: the options follow its grid */
+  gboolean       loading;
+
+  gint           drag;        /* GridHandle */
+  gint           hover;
+  ChopGimpPGrid  orig;
+  gdouble        sx, sy;
+} GimpPGridTool;
+
+typedef struct
+{
+  GimpDrawToolClass parent_class;
+} GimpPGridToolClass;
+
+static GType gimp_pgrid_tool_get_type (void) G_GNUC_CONST;
+
+G_DEFINE_TYPE (GimpPGridTool, gimp_pgrid_tool, GIMP_TYPE_DRAW_TOOL)
+
+
+static gboolean
+handle_pos (const ChopGimpPGrid *g,
+            gint                 h,
+            gdouble             *x,
+            gdouble             *y)
+{
+  gdouble c = g->cell;
+
+  switch (h)
+    {
+    case GH_VL:
+      *x = g->vl[0]; *y = g->vl[1];
+      return TRUE;
+
+    case GH_VR:
+      *x = g->vr[0]; *y = g->vr[1];
+      return g->type >= 2;
+
+    case GH_VV:
+      *x = g->vv[0]; *y = g->vv[1];
+      return g->type == 3;
+
+    case GH_HORIZON:
+      if (g->type == 1)
+        {
+          *x = g->vl[0] - 4 * c;
+          *y = g->vl[1];
+        }
+      else
+        {
+          *x = (g->vl[0] + g->vr[0]) / 2.0;
+          *y = (g->vl[1] + g->vr[1]) / 2.0;
+        }
+      return TRUE;
+
+    case GH_ORIGIN:
+      *x = g->origin[0]; *y = g->origin[1];
+      return TRUE;
+
+    case GH_EXT_L:
+      return chopgimp_pgrid_project (g, 0, 0, g->extent_l * c, x, y);
+
+    case GH_EXT_R:
+      return chopgimp_pgrid_project (g, g->extent_r * c, 0, 0, x, y);
+
+    case GH_HEIGHT:
+      {
+        gdouble u1, v1, u2, v2;
+
+        chopgimp_pgrid_plane_range (g, CHOPGIMP_PLANE_LEFT, &u1, &v1, &u2, &v2);
+        return chopgimp_pgrid_project (g, 0, -v1, 0, x, y);
+      }
+
+    case GH_CELL:
+      return chopgimp_pgrid_project (g, 0, c, 0, x, y);
+
+    case GH_OFF_L:
+      return chopgimp_pgrid_project (g, g->offset[CHOPGIMP_PLANE_LEFT], 0,
+                                     g->extent_l * c, x, y);
+
+    case GH_OFF_R:
+      return chopgimp_pgrid_project (g, g->extent_r * c, 0,
+                                     g->offset[CHOPGIMP_PLANE_RIGHT], x, y);
+
+    case GH_OFF_F:
+      return chopgimp_pgrid_project (g, g->extent_r * c / 2.0, g->offset[CHOPGIMP_PLANE_FLOOR],
+                                     g->extent_l * c / 2.0, x, y);
+
+    default:
+      return FALSE;
+    }
+}
+
+static GimpHandleType
+handle_type (gint h)
+{
+  switch (h)
+    {
+    case GH_VL: case GH_VR: case GH_VV:     return GIMP_HANDLE_FILLED_CIRCLE;
+    case GH_HORIZON: case GH_ORIGIN:        return GIMP_HANDLE_FILLED_DIAMOND;
+    case GH_OFF_L: case GH_OFF_R: case GH_OFF_F: return GIMP_HANDLE_DIAMOND;
+    case GH_CELL:                           return GIMP_HANDLE_SQUARE;
+    default:                                return GIMP_HANDLE_CIRCLE;
+    }
+}
+
+static const gchar *
+handle_tip (gint h)
+{
+  switch (h)
+    {
+    case GH_VL:      return _("Point de fuite gauche");
+    case GH_VR:      return _("Point de fuite droit");
+    case GH_VV:      return _("Point de fuite vertical");
+    case GH_HORIZON: return _("Ligne d'horizon");
+    case GH_ORIGIN:  return _("Niveau du sol : déplace la grille");
+    case GH_EXT_L:   return _("Étendue du plan gauche");
+    case GH_EXT_R:   return _("Étendue du plan droit");
+    case GH_HEIGHT:  return _("Hauteur de la grille");
+    case GH_CELL:    return _("Taille de cellule");
+    case GH_OFF_L:   return _("Position du plan gauche");
+    case GH_OFF_R:   return _("Position du plan droit");
+    case GH_OFF_F:   return _("Hauteur du plan horizontal");
+    default:         return NULL;
+    }
+}
+
+static gint
+grid_hit (GimpPGridTool       *gt,
+          GimpDisplay         *display,
+          const ChopGimpPGrid *g,
+          gdouble              x,
+          gdouble              y)
+{
+  for (gint h = GH_LAST - 1; h >= 0; h--)
+    {
+      gdouble hx, hy;
+
+      if (handle_pos (g, h, &hx, &hy) &&
+          gimp_draw_tool_on_handle (GIMP_DRAW_TOOL (gt), display, x, y,
+                                    GIMP_HANDLE_CIRCLE, hx, hy,
+                                    HANDLE_SIZE + 4, HANDLE_SIZE + 4,
+                                    GIMP_HANDLE_ANCHOR_CENTER))
+        return h;
+    }
+
+  return GH_NONE;
+}
+
+/*  options ← grid of the image  */
+static void
+grid_to_options (GimpPGridTool       *gt,
+                 const ChopGimpPGrid *g)
+{
+  GimpPGridOptions *o = PGRID_OPTIONS (gt);
+  GeglColor        *l = rgb_color (g->color[CHOPGIMP_PLANE_LEFT]);
+  GeglColor        *r = rgb_color (g->color[CHOPGIMP_PLANE_RIGHT]);
+  GeglColor        *f = rgb_color (g->color[CHOPGIMP_PLANE_FLOOR]);
+
+  gt->loading = TRUE;
+  g_object_set (o,
+                "pgrid-type",         g->type,
+                "pgrid-cell",         g->cell,
+                "pgrid-extent-l",     g->extent_l,
+                "pgrid-extent-r",     g->extent_r,
+                "pgrid-height",       g->height,
+                "pgrid-opacity",      g->opacity * 100.0,
+                "pgrid-snap",         g->snap,
+                "pgrid-locked",       g->locked,
+                "pgrid-lock-station", g->lock_station,
+                "pgrid-color-left",   l,
+                "pgrid-color-right",  r,
+                "pgrid-color-floor",  f,
+                NULL);
+  gt->loading = FALSE;
+
+  g_object_unref (l);
+  g_object_unref (r);
+  g_object_unref (f);
+}
+
+/*  grid of the image ← options  */
+static void
+pgrid_options_notify (GimpPGridOptions *o,
+                      GParamSpec       *pspec,
+                      GimpPGridTool    *gt)
+{
+  ChopGimpPGrid g;
+
+  if (gt->loading || ! gt->image)
+    return;
+
+  chopgimp_pgrid_get (gt->image, &g);
+
+  chopgimp_pgrid_set_type (&g, o->type,
+                           gimp_image_get_width (gt->image),
+                           gimp_image_get_height (gt->image));
+  g.cell         = o->cell;
+  g.extent_l     = o->extent_l;
+  g.extent_r     = o->extent_r;
+  g.height       = o->height;
+  g.opacity      = o->opacity / 100.0;
+  g.snap         = o->snap;
+  g.locked       = o->locked;
+  g.lock_station = o->lock_station;
+  g.visible      = TRUE;
+  g.color[CHOPGIMP_PLANE_LEFT]  = color_rgb (o->color[CHOPGIMP_PLANE_LEFT]);
+  g.color[CHOPGIMP_PLANE_RIGHT] = color_rgb (o->color[CHOPGIMP_PLANE_RIGHT]);
+  g.color[CHOPGIMP_PLANE_FLOOR] = color_rgb (o->color[CHOPGIMP_PLANE_FLOOR]);
+
+  chopgimp_pgrid_set (gt->image, &g, _("Grille de perspective"), TRUE);
+  gimp_image_flush (gt->image);
+}
+
+static void
+grid_parasite_changed (GimpImage     *image,
+                       const gchar   *name,
+                       GimpPGridTool *gt)
+{
+  ChopGimpPGrid g;
+
+  if (! g_strcmp0 (name, CHOPGIMP_PGRID_PARASITE) && ! gt->loading && gt->drag == GH_NONE)
+    {
+      chopgimp_pgrid_get (image, &g);
+      grid_to_options (gt, &g);
+    }
+}
+
+/*  the tool works on @image: its grid is shown and fills the options  */
+static void
+grid_tool_set_image (GimpPGridTool *gt,
+                     GimpImage     *image)
+{
+  ChopGimpPGrid g;
+
+  if (gt->image == image)
+    return;
+
+  if (gt->image)
+    {
+      g_signal_handlers_disconnect_by_data (gt->image, gt);
+      g_object_remove_weak_pointer (G_OBJECT (gt->image), (gpointer *) &gt->image);
+    }
+
+  gt->image = image;
+
+  if (! image)
+    return;
+
+  g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &gt->image);
+  g_signal_connect (image, "parasite-attached", G_CALLBACK (grid_parasite_changed), gt);
+  g_signal_connect (image, "parasite-detached", G_CALLBACK (grid_parasite_changed), gt);
+
+  /*  Illustrator: choosing the tool shows the grid  */
+  if (! chopgimp_pgrid_get (image, &g) || ! g.visible)
+    {
+      g.visible = TRUE;
+      gt->loading = TRUE;
+      chopgimp_pgrid_set (image, &g, _("Afficher la grille de perspective"), FALSE);
+      gt->loading = FALSE;
+      gimp_image_flush (image);
+    }
+
+  grid_to_options (gt, &g);
+}
+
+static void
+grid_drag (GimpPGridTool *gt,
+           gdouble        x,
+           gdouble        y,
+           ChopGimpPGrid *g)
+{
+  ChopGimpPGrid flat = gt->orig;
+  gdouble       dx   = x - gt->sx;
+  gdouble       dy   = y - gt->sy;
+  gdouble       u, v;
+
+  *g = gt->orig;
+
+  /*  the measures are taken on the planes at their place (no offset)  */
+  for (gint i = 0; i < 4; i++)
+    flat.offset[i] = 0.0;
+
+  switch (gt->drag)
+    {
+    case GH_VL:
+      g->vl[0] = gt->orig.vl[0] + dx;
+      g->vl[1] = gt->orig.vl[1] + dy;
+      if (g->type >= 2)
+        {
+          g->vr[1] = g->vl[1];   /* one horizon */
+          if (g->lock_station)
+            g->vr[0] = gt->orig.vr[0] + dx;
+        }
+      break;
+
+    case GH_VR:
+      g->vr[0] = gt->orig.vr[0] + dx;
+      g->vr[1] = gt->orig.vr[1] + dy;
+      g->vl[1] = g->vr[1];
+      if (g->lock_station)
+        g->vl[0] = gt->orig.vl[0] + dx;
+      break;
+
+    case GH_VV:
+      g->vv[0] = gt->orig.vv[0] + dx;
+      g->vv[1] = gt->orig.vv[1] + dy;
+      break;
+
+    case GH_HORIZON:
+      g->vl[1] = gt->orig.vl[1] + dy;
+      g->vr[1] = gt->orig.vr[1] + dy;
+      break;
+
+    case GH_ORIGIN:
+      for (gint i = 0; i < 2; i++)
+        {
+          gdouble d = i ? dy : dx;
+
+          g->origin[i] = gt->orig.origin[i] + d;
+          g->vl[i]     = gt->orig.vl[i] + d;
+          g->vr[i]     = gt->orig.vr[i] + d;
+          g->vv[i]     = gt->orig.vv[i] + d;
+        }
+      break;
+
+    case GH_EXT_L:
+      if (chopgimp_pgrid_to_plane (&flat, CHOPGIMP_PLANE_FLOOR, x, y, &u, &v))
+        g->extent_l = CLAMP ((gint) RINT (-v / g->cell), 1, 500);
+      break;
+
+    case GH_EXT_R:
+      if (chopgimp_pgrid_to_plane (&flat, CHOPGIMP_PLANE_FLOOR, x, y, &u, &v))
+        g->extent_r = CLAMP ((gint) RINT (u / g->cell), 1, 500);
+      break;
+
+    case GH_HEIGHT:
+      if (chopgimp_pgrid_to_plane (&flat, CHOPGIMP_PLANE_LEFT, x, y, &u, &v))
+        g->height = CLAMP ((gint) RINT (-v / g->cell), 1, 500);
+      break;
+
+    case GH_CELL:
+      if (chopgimp_pgrid_to_plane (&flat, CHOPGIMP_PLANE_LEFT, x, y, &u, &v))
+        g->cell = CLAMP (-v, 1.0, 5000.0);
+      break;
+
+    case GH_OFF_L:
+      if (chopgimp_pgrid_to_plane (&flat, CHOPGIMP_PLANE_FLOOR, x, y, &u, &v))
+        g->offset[CHOPGIMP_PLANE_LEFT] = RINT (u);
+      break;
+
+    case GH_OFF_R:
+      if (chopgimp_pgrid_to_plane (&flat, CHOPGIMP_PLANE_FLOOR, x, y, &u, &v))
+        g->offset[CHOPGIMP_PLANE_RIGHT] = RINT (-v);
+      break;
+
+    case GH_OFF_F:
+      flat.offset[CHOPGIMP_PLANE_RIGHT] = g->extent_l * g->cell / 2.0;
+      if (chopgimp_pgrid_to_plane (&flat, CHOPGIMP_PLANE_RIGHT, x, y, &u, &v))
+        g->offset[CHOPGIMP_PLANE_FLOOR] = RINT (-v);
+      break;
+
+    default:
+      break;
+    }
+}
+
+static void
+gimp_pgrid_tool_button_press (GimpTool            *tool,
+                              const GimpCoords    *coords,
+                              guint32              time,
+                              GdkModifierType      state,
+                              GimpButtonPressType  press_type,
+                              GimpDisplay         *display)
+{
+  GimpPGridTool *gt    = (GimpPGridTool *) tool;
+  GimpImage     *image = gimp_display_get_image (display);
+
+  if (! image || press_type != GIMP_BUTTON_PRESS_NORMAL)
+    return;
+
+  if (tool->display && tool->display != display &&
+      gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+  tool->display = display;
+  grid_tool_set_image (gt, image);
+
+  if (pgrid_widget_press (display, coords))
+    {
+      gimp_image_flush (image);
+      return;
+    }
+
+  chopgimp_pgrid_get (image, &gt->orig);
+
+  if (gt->orig.locked)
+    {
+      gimp_tool_message_literal (tool, display, _("La grille de perspective est verrouillée."));
+      return;
+    }
+
+  gt->drag = grid_hit (gt, display, &gt->orig, coords->x, coords->y);
+  gt->sx   = coords->x;
+  gt->sy   = coords->y;
+
+  if (gt->drag == GH_NONE)
+    return;
+
+  gimp_tool_control_activate (tool->control);
+
+  if (! gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    gimp_draw_tool_start (GIMP_DRAW_TOOL (tool), display);
+}
+
+static void
+gimp_pgrid_tool_motion (GimpTool         *tool,
+                        const GimpCoords *coords,
+                        guint32           time,
+                        GdkModifierType   state,
+                        GimpDisplay      *display)
+{
+  GimpPGridTool *gt = (GimpPGridTool *) tool;
+  ChopGimpPGrid  g;
+
+  if (gt->drag == GH_NONE || ! gt->image)
+    return;
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  grid_drag (gt, coords->x, coords->y, &g);
+
+  /*  live, without undo: the undo step is made on release  */
+  gt->loading = TRUE;
+  chopgimp_pgrid_set (gt->image, &g, NULL, FALSE);
+  gt->loading = FALSE;
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_pgrid_tool_button_release (GimpTool              *tool,
+                                const GimpCoords      *coords,
+                                guint32                time,
+                                GdkModifierType        state,
+                                GimpButtonReleaseType  release_type,
+                                GimpDisplay           *display)
+{
+  GimpPGridTool *gt = (GimpPGridTool *) tool;
+  ChopGimpPGrid  g;
+
+  gimp_tool_control_halt (tool->control);
+
+  if (gt->drag == GH_NONE || ! gt->image)
+    return;
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  grid_drag (gt, coords->x, coords->y, &g);
+
+  gt->loading = TRUE;
+  chopgimp_pgrid_set (gt->image, &gt->orig, NULL, FALSE);
+  gt->loading = FALSE;
+
+  if (release_type != GIMP_BUTTON_RELEASE_CANCEL)
+    {
+      chopgimp_pgrid_set (gt->image, &g, _("Grille de perspective"), FALSE);
+      grid_to_options (gt, &g);
+    }
+
+  gimp_image_flush (gt->image);
+  gt->drag = GH_NONE;
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_pgrid_tool_oper_update (GimpTool         *tool,
+                             const GimpCoords *coords,
+                             GdkModifierType   state,
+                             gboolean          proximity,
+                             GimpDisplay      *display)
+{
+  GimpPGridTool *gt    = (GimpPGridTool *) tool;
+  GimpImage     *image = gimp_display_get_image (display);
+  ChopGimpPGrid  g;
+  const gchar   *tip;
+
+  if (! image || ! proximity)
+    return;
+
+  grid_tool_set_image (gt, image);
+  chopgimp_pgrid_get (image, &g);
+
+  gt->hover = grid_hit (gt, display, &g, coords->x, coords->y);
+  tip       = handle_tip (gt->hover);
+
+  gimp_tool_replace_status (tool, display, "%s",
+                            tip ? tip : _("Faites glisser un widget de la grille ; "
+                                          "1 / 2 / 3 / 4 : plan actif"));
+
+  if (! gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    {
+      tool->display = display;
+      gimp_draw_tool_start (GIMP_DRAW_TOOL (tool), display);
+    }
+  else
+    {
+      chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (tool), display);
+    }
+}
+
+static gboolean
+gimp_pgrid_tool_key_press (GimpTool    *tool,
+                           GdkEventKey *kevent,
+                           GimpDisplay *display)
+{
+  if (pgrid_plane_key (display, kevent->keyval))
+    {
+      gimp_image_flush (gimp_display_get_image (display));
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+static void
+gimp_pgrid_tool_draw (GimpDrawTool *dt)
+{
+  GimpPGridTool *gt = (GimpPGridTool *) dt;
+  GimpImage     *image;
+  ChopGimpPGrid  g;
+
+  if (! dt->display || ! (image = gimp_display_get_image (dt->display)))
+    return;
+
+  if (! chopgimp_pgrid_get (image, &g) || ! g.visible || g.locked)
+    return;
+
+  for (gint h = 0; h < GH_LAST; h++)
+    {
+      gdouble         x, y;
+      GimpCanvasItem *item;
+
+      if (! handle_pos (&g, h, &x, &y))
+        continue;
+
+      item = gimp_draw_tool_add_handle (dt, handle_type (h), x, y,
+                                        HANDLE_SIZE, HANDLE_SIZE,
+                                        GIMP_HANDLE_ANCHOR_CENTER);
+      if (h == gt->hover || h == gt->drag)
+        gimp_canvas_item_set_highlight (item, TRUE);
+    }
+
+  /*  the leading edge and the lines to the vanishing points  */
+  {
+    gdouble ox = g.origin[0], oy = g.origin[1];
+    gdouble tx, ty;
+
+    if (chopgimp_pgrid_project (&g, 0, g.height * g.cell, 0, &tx, &ty))
+      gimp_draw_tool_add_line (dt, ox, oy, tx, ty);
+
+    gimp_draw_tool_add_line (dt, ox, oy, g.vl[0], g.vl[1]);
+    if (g.type >= 2)
+      gimp_draw_tool_add_line (dt, ox, oy, g.vr[0], g.vr[1]);
+  }
+}
+
+static void
+gimp_pgrid_tool_control (GimpTool       *tool,
+                         GimpToolAction  action,
+                         GimpDisplay    *display)
+{
+  GimpPGridTool *gt = (GimpPGridTool *) tool;
+
+  if (action == GIMP_TOOL_ACTION_HALT || action == GIMP_TOOL_ACTION_COMMIT)
+    {
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+      gt->drag  = GH_NONE;
+      gt->hover = GH_NONE;
+    }
+
+  GIMP_TOOL_CLASS (gimp_pgrid_tool_parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_pgrid_tool_constructed (GObject *object)
+{
+  GimpPGridTool *gt = (GimpPGridTool *) object;
+
+  G_OBJECT_CLASS (gimp_pgrid_tool_parent_class)->constructed (object);
+
+  g_signal_connect_object (gimp_tool_get_options (GIMP_TOOL (gt)), "notify",
+                           G_CALLBACK (pgrid_options_notify), gt, 0);
+}
+
+static void
+gimp_pgrid_tool_finalize (GObject *object)
+{
+  grid_tool_set_image ((GimpPGridTool *) object, NULL);
+
+  G_OBJECT_CLASS (gimp_pgrid_tool_parent_class)->finalize (object);
+}
+
+static void
+gimp_pgrid_tool_class_init (GimpPGridToolClass *klass)
+{
+  GObjectClass      *object_class    = G_OBJECT_CLASS (klass);
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  object_class->constructed  = gimp_pgrid_tool_constructed;
+  object_class->finalize     = gimp_pgrid_tool_finalize;
+
+  tool_class->is_destructive = FALSE;
+  tool_class->control        = gimp_pgrid_tool_control;
+  tool_class->button_press   = gimp_pgrid_tool_button_press;
+  tool_class->motion         = gimp_pgrid_tool_motion;
+  tool_class->button_release = gimp_pgrid_tool_button_release;
+  tool_class->oper_update    = gimp_pgrid_tool_oper_update;
+  tool_class->key_press      = gimp_pgrid_tool_key_press;
+
+  draw_tool_class->draw      = gimp_pgrid_tool_draw;
+}
+
+static void
+gimp_pgrid_tool_init (GimpPGridTool *gt)
+{
+  GimpTool *tool = GIMP_TOOL (gt);
+
+  gt->drag  = GH_NONE;
+  gt->hover = GH_NONE;
+
+  gimp_tool_control_set_motion_mode (tool->control, GIMP_MOTION_MODE_COMPRESS);
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_PERSPECTIVE);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_MOUSE);
+}
+
+
+/*  ════════════════════ Sélection de perspective ════════════════════ */
+
+typedef struct
+{
+  GimpDrawTool     parent_instance;
+
+  /*  the object  */
+  GimpItem        *item;        /* weak: a layer, or the vector layer   */
+  GArray          *ids;         /* its objects (guint), empty: the layer */
+  gint             plane;       /* its plane (NONE: free)               */
+  gint             mode;        /* 0 none, 1 move on plane, 2 place,
+                                 * 3 plain move                          */
+  gboolean         copy;
+  gdouble          sx, sy, cx, cy;
+  gdouble          box[4];      /* x1 y1 x2 y2 at the press             */
+  GimpMatrix3      matrix;
+  gboolean         valid;
+} GimpPSelectTool;
+
+typedef struct
+{
+  GimpDrawToolClass parent_class;
+} GimpPSelectToolClass;
+
+static GType gimp_pselect_tool_get_type (void) G_GNUC_CONST;
+
+G_DEFINE_TYPE (GimpPSelectTool, gimp_pselect_tool, GIMP_TYPE_DRAW_TOOL)
+
+enum { PS_NONE, PS_MOVE, PS_PLACE, PS_FREE };
+
+
+static void
+pselect_set_item (GimpPSelectTool *st,
+                  GimpItem        *item)
+{
+  if (st->item == item)
+    return;
+
+  if (st->item)
+    g_object_remove_weak_pointer (G_OBJECT (st->item), (gpointer *) &st->item);
+
+  st->item = item;
+
+  if (item)
+    g_object_add_weak_pointer (G_OBJECT (item), (gpointer *) &st->item);
+}
+
+/*  the object under the pointer: the selected objects of the target
+ *  vector layer when one is hit, else the layer under the pointer
+ */
+static gboolean
+pselect_pick (GimpPSelectTool *st,
+              GimpImage       *image,
+              GimpDisplay     *display,
+              gdouble          x,
+              gdouble          y)
+{
+  GimpVectorLayer *vl  = chopgimp_vobjects_get_target_layer (image);
+  gdouble          tol = 4.0 / MAX (gimp_display_get_shell (display)->scale_x, 1e-6);
+  GimpLayer       *layer;
+
+  g_array_set_size (st->ids, 0);
+  pselect_set_item (st, NULL);
+
+  if (vl)
+    {
+      ChopGimpVObject *obj = chopgimp_vlayer_hit_test (vl, x, y, tol, CHOPGIMP_HIT_SELECTABLE);
+
+      if (obj)
+        {
+          const guint *sel;
+          gint         n;
+
+          if (! chopgimp_vlayer_is_selected (vl, obj->id))
+            chopgimp_vlayer_set_selection (vl, &obj->id, 1);
+
+          sel = chopgimp_vlayer_get_selection (vl, &n);
+          g_array_append_vals (st->ids, sel, n);
+          pselect_set_item (st, GIMP_ITEM (vl));
+
+          return chopgimp_vlayer_get_bounds (vl, sel, n, TRUE,
+                                             &st->box[0], &st->box[1],
+                                             &st->box[2], &st->box[3]);
+        }
+    }
+
+  layer = gimp_image_pick_layer (image, (gint) x, (gint) y, NULL);
+
+  if (layer && ! gimp_item_is_content_locked (GIMP_ITEM (layer), NULL) &&
+      ! gimp_item_is_position_locked (GIMP_ITEM (layer), NULL))
+    {
+      gint ox, oy;
+
+      /*  a layer of a group: the top group moves (Illustrator: the group)  */
+      while (gimp_viewable_get_parent (GIMP_VIEWABLE (layer)))
+        layer = GIMP_LAYER (gimp_viewable_get_parent (GIMP_VIEWABLE (layer)));
+
+      pselect_set_item (st, GIMP_ITEM (layer));
+      gimp_item_get_offset (GIMP_ITEM (layer), &ox, &oy);
+      st->box[0] = ox;
+      st->box[1] = oy;
+      st->box[2] = ox + gimp_item_get_width  (GIMP_ITEM (layer));
+      st->box[3] = oy + gimp_item_get_height (GIMP_ITEM (layer));
+
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+static gint
+pselect_item_plane (GimpPSelectTool *st)
+{
+  if (! st->item)
+    return CHOPGIMP_PLANE_NONE;
+
+  return chopgimp_pgrid_item_get_plane (st->item,
+                                        st->ids->len ? g_array_index (st->ids, guint, 0) : 0);
+}
+
+static void
+pselect_update_matrix (GimpPSelectTool *st,
+                       GimpImage       *image)
+{
+  ChopGimpPGrid g;
+
+  chopgimp_pgrid_get (image, &g);
+  st->valid = TRUE;
+
+  switch (st->mode)
+    {
+    case PS_MOVE:
+      st->valid = chopgimp_pgrid_move_matrix (&g, st->plane, st->sx, st->sy,
+                                              st->cx, st->cy, g.snap, &st->matrix);
+      break;
+
+    case PS_PLACE:
+      st->valid = chopgimp_pgrid_place_matrix (&g, st->plane, st->sx, st->sy,
+                                               st->cx, st->cy, g.snap, &st->matrix);
+      break;
+
+    case PS_FREE:
+      gimp_matrix3_identity (&st->matrix);
+      gimp_matrix3_translate (&st->matrix, RINT (st->cx - st->sx), RINT (st->cy - st->sy));
+      break;
+
+    default:
+      gimp_matrix3_identity (&st->matrix);
+      break;
+    }
+}
+
+static gboolean
+psource_is_pixel_layer (GimpItem *item)
+{
+  return GIMP_IS_LAYER (item) &&
+         ! gimp_viewable_get_children (GIMP_VIEWABLE (item)) &&
+         ! gimp_item_is_text_layer (item) &&
+         ! gimp_item_is_vector_layer (item);
+}
+
+
+/*  applies st->matrix to the object, one undo step  */
+static void
+pselect_apply (GimpPSelectTool *st,
+               GimpImage       *image)
+{
+  GimpContext *context = gimp_get_user_context (image->gimp);
+  GimpItem    *item    = st->item;
+
+  if (! item || ! st->valid || gimp_matrix3_is_identity (&st->matrix))
+    return;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC, _("Sélection de perspective"));
+
+  if (st->ids->len)
+    {
+      GimpVectorLayer *vl = GIMP_VECTOR_LAYER (item);
+
+      chopgimp_vlayer_transform (vl, (guint *) st->ids->data, st->ids->len,
+                                 &st->matrix, TRUE, TRUE);
+
+      for (guint i = 0; i < st->ids->len; i++)
+        chopgimp_pgrid_item_set_plane (item, g_array_index (st->ids, guint, i),
+                                       st->plane, TRUE);
+    }
+  else
+    {
+      if (st->copy)
+        {
+          GimpItem *dup = gimp_item_duplicate (item, G_TYPE_FROM_INSTANCE (item));
+
+          gimp_image_add_layer (image, GIMP_LAYER (dup), NULL,
+                                gimp_item_get_index (item), TRUE);
+          item = dup;
+        }
+
+      if (st->mode == PS_FREE)
+        {
+          gimp_item_translate (item, st->matrix.coeff[0][2], st->matrix.coeff[1][2], TRUE);
+          if (psource_is_pixel_layer (item))
+            chopgimp_pgrid_source_translate (item, st->matrix.coeff[0][2], st->matrix.coeff[1][2]);
+        }
+      else if (psource_is_pixel_layer (item) && ! g_getenv ("CHOPGIMP_NO_PERSP_SOURCE"))
+        {
+          /*  3.31.0 (4b): from the original, no cumulated resampling  */
+          chopgimp_pgrid_transform_from_source (item, context, &st->matrix,
+                                                image->gimp->config->interpolation_type);
+        }
+      else
+        {
+          gimp_item_transform (item, context, &st->matrix, GIMP_TRANSFORM_FORWARD,
+                               image->gimp->config->interpolation_type,
+                               GIMP_TRANSFORM_RESIZE_ADJUST, NULL);
+        }
+
+      chopgimp_pgrid_item_set_plane (item, 0, st->plane, TRUE);
+      pselect_set_item (st, item);
+    }
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+}
+
+static void
+gimp_pselect_tool_button_press (GimpTool            *tool,
+                                const GimpCoords    *coords,
+                                guint32              time,
+                                GdkModifierType      state,
+                                GimpButtonPressType  press_type,
+                                GimpDisplay         *display)
+{
+  GimpPSelectTool *st    = (GimpPSelectTool *) tool;
+  GimpImage       *image = gimp_display_get_image (display);
+  ChopGimpPGrid    g;
+  gint             active;
+
+  if (! image || press_type != GIMP_BUTTON_PRESS_NORMAL)
+    return;
+
+  if (tool->display && tool->display != display &&
+      gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+  tool->display = display;
+
+  if (pgrid_widget_press (display, coords))
+    {
+      gimp_image_flush (image);
+      return;
+    }
+
+  st->mode = PS_NONE;
+
+  if (! pselect_pick (st, image, display, coords->x, coords->y))
+    return;
+
+  chopgimp_pgrid_get (image, &g);
+  active = g.visible ? g.active_plane : CHOPGIMP_PLANE_NONE;
+
+  st->plane = pselect_item_plane (st);
+
+  if (st->plane != CHOPGIMP_PLANE_NONE && g.visible)
+    {
+      /*  Illustrator: the plane of the object becomes the active one  */
+      st->mode = PS_MOVE;
+      if (st->plane != active)
+        chopgimp_pgrid_set_active_plane (image, st->plane);
+    }
+  else if (active != CHOPGIMP_PLANE_NONE)
+    {
+      st->mode  = PS_PLACE;
+      st->plane = active;
+    }
+  else
+    {
+      st->mode  = PS_FREE;
+      st->plane = CHOPGIMP_PLANE_NONE;
+    }
+
+  st->copy = (state & GDK_MOD1_MASK) != 0 && st->ids->len == 0;
+  st->sx = st->cx = coords->x;
+  st->sy = st->cy = coords->y;
+
+  /*  a click without moving puts a free object on the plane in place  */
+  pselect_update_matrix (st, image);
+
+  gimp_tool_control_activate (tool->control);
+
+  if (! gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    gimp_draw_tool_start (GIMP_DRAW_TOOL (tool), display);
+  else
+    chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (tool), display);
+}
+
+static void
+gimp_pselect_tool_motion (GimpTool         *tool,
+                          const GimpCoords *coords,
+                          guint32           time,
+                          GdkModifierType   state,
+                          GimpDisplay      *display)
+{
+  GimpPSelectTool *st = (GimpPSelectTool *) tool;
+
+  if (st->mode == PS_NONE)
+    return;
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  st->cx = coords->x;
+  st->cy = coords->y;
+  pselect_update_matrix (st, gimp_display_get_image (display));
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_pselect_tool_button_release (GimpTool              *tool,
+                                  const GimpCoords      *coords,
+                                  guint32                time,
+                                  GdkModifierType        state,
+                                  GimpButtonReleaseType  release_type,
+                                  GimpDisplay           *display)
+{
+  GimpPSelectTool *st    = (GimpPSelectTool *) tool;
+  GimpImage       *image = gimp_display_get_image (display);
+
+  gimp_tool_control_halt (tool->control);
+
+  if (st->mode == PS_NONE)
+    return;
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  if (release_type != GIMP_BUTTON_RELEASE_CANCEL)
+    {
+      st->cx = coords->x;
+      st->cy = coords->y;
+      pselect_update_matrix (st, image);
+
+      /*  a click on a free object does not put it on the plane  */
+      if (st->mode != PS_PLACE || hypot (st->cx - st->sx, st->cy - st->sy) > 1.0)
+        pselect_apply (st, image);
+    }
+
+  st->mode = PS_NONE;
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_pselect_tool_oper_update (GimpTool         *tool,
+                               const GimpCoords *coords,
+                               GdkModifierType   state,
+                               gboolean          proximity,
+                               GimpDisplay      *display)
+{
+  GimpImage   *image = gimp_display_get_image (display);
+  ChopGimpPGrid g;
+
+  if (! image || ! proximity)
+    return;
+
+  chopgimp_pgrid_get (image, &g);
+
+  if (! g.visible)
+    gimp_tool_replace_status (tool, display, "%s",
+                              _("La grille de perspective est masquée (Affichage > "
+                                "Grille de perspective) : les objets se déplacent librement"));
+  else
+    gimp_tool_replace_status (tool, display,
+                              _("Faites glisser un objet sur le plan actif (%s) ; Alt : copie ; "
+                                "1 / 2 / 3 / 4 : plan gauche / horizontal / droit / aucun"),
+                              chopgimp_pgrid_plane_name (g.active_plane));
+}
+
+static gboolean
+gimp_pselect_tool_key_press (GimpTool    *tool,
+                             GdkEventKey *kevent,
+                             GimpDisplay *display)
+{
+  GimpPSelectTool *st    = (GimpPSelectTool *) tool;
+  GimpImage       *image = gimp_display_get_image (display);
+  ChopGimpPGrid    g;
+  gdouble          step  = (kevent->state & GDK_SHIFT_MASK) ? 10.0 : 1.0;
+  gdouble          du = 0, dv = 0;
+
+  if (pgrid_plane_key (display, kevent->keyval))
+    {
+      gimp_image_flush (image);
+      return TRUE;
+    }
+
+  switch (kevent->keyval)
+    {
+    case GDK_KEY_Left:  du = -step; break;
+    case GDK_KEY_Right: du =  step; break;
+    case GDK_KEY_Up:    dv = -step; break;
+    case GDK_KEY_Down:  dv =  step; break;
+    default:
+      return FALSE;
+    }
+
+  if (! image || ! st->item || ! chopgimp_pgrid_get (image, &g) || ! g.visible)
+    return FALSE;
+
+  st->plane = pselect_item_plane (st);
+
+  if (st->plane == CHOPGIMP_PLANE_NONE)
+    {
+      st->mode = PS_FREE;
+      st->sx = st->sy = 0;
+      st->cx = du;
+      st->cy = dv;
+    }
+  else
+    {
+      /*  a move of (du, dv) units at the object's centre  */
+      gdouble u, v, x, y;
+
+      if (! chopgimp_pgrid_to_plane (&g, st->plane,
+                                     (st->box[0] + st->box[2]) / 2.0,
+                                     (st->box[1] + st->box[3]) / 2.0, &u, &v) ||
+          ! chopgimp_pgrid_from_plane (&g, st->plane, u + du, v + dv, &x, &y))
+        return TRUE;
+
+      st->mode = PS_MOVE;
+      st->sx   = (st->box[0] + st->box[2]) / 2.0;
+      st->sy   = (st->box[1] + st->box[3]) / 2.0;
+      st->cx   = x;
+      st->cy   = y;
+    }
+
+  st->copy = FALSE;
+  pselect_update_matrix (st, image);
+
+  /*  no snapping for the arrows  */
+  if (st->mode == PS_MOVE)
+    {
+      g.snap = FALSE;
+      st->valid = chopgimp_pgrid_move_matrix (&g, st->plane, st->sx, st->sy,
+                                              st->cx, st->cy, FALSE, &st->matrix);
+    }
+
+  pselect_apply (st, image);
+
+  /*  the new box  */
+  if (st->item)
+    {
+      if (st->ids->len)
+        chopgimp_vlayer_get_bounds (GIMP_VECTOR_LAYER (st->item),
+                                    (guint *) st->ids->data, st->ids->len, TRUE,
+                                    &st->box[0], &st->box[1], &st->box[2], &st->box[3]);
+      else
+        {
+          gint ox, oy;
+
+          gimp_item_get_offset (st->item, &ox, &oy);
+          st->box[0] = ox;
+          st->box[1] = oy;
+          st->box[2] = ox + gimp_item_get_width  (st->item);
+          st->box[3] = oy + gimp_item_get_height (st->item);
+        }
+    }
+
+  st->mode = PS_NONE;
+
+  return TRUE;
+}
+
+static void
+gimp_pselect_tool_draw (GimpDrawTool *dt)
+{
+  GimpPSelectTool *st = (GimpPSelectTool *) dt;
+  GimpVector2      q[4];
+  gdouble          cx[4], cy[4];
+
+  if (st->mode == PS_NONE || ! st->valid || ! st->item)
+    return;
+
+  cx[0] = st->box[0]; cy[0] = st->box[1];
+  cx[1] = st->box[2]; cy[1] = st->box[1];
+  cx[2] = st->box[2]; cy[2] = st->box[3];
+  cx[3] = st->box[0]; cy[3] = st->box[3];
+
+  for (gint i = 0; i < 4; i++)
+    gimp_matrix3_transform_point (&st->matrix, cx[i], cy[i], &q[i].x, &q[i].y);
+
+  gimp_draw_tool_add_lines (dt, q, 4, NULL, FALSE);
+  gimp_draw_tool_add_line (dt, q[3].x, q[3].y, q[0].x, q[0].y);
+
+  /*  the vector objects themselves  */
+  if (st->ids->len)
+    {
+      GimpVectorLayer *vl = GIMP_VECTOR_LAYER (st->item);
+
+      for (guint i = 0; i < st->ids->len; i++)
+        {
+          ChopGimpVObject *obj  = chopgimp_vlayer_get_object (vl, g_array_index (st->ids, guint, i));
+          GimpPath        *path = obj ? chopgimp_vobject_get_world_path (vl, obj, FALSE) : NULL;
+
+          if (! path)
+            continue;
+
+          g_object_ref_sink (path);
+          chopgimp_vpath_transform (path, &st->matrix);
+
+          if (gimp_path_get_bezier (path))
+            {
+              GimpCanvasItem *item =
+                gimp_canvas_path_new (gimp_display_get_shell (dt->display),
+                                      gimp_path_get_bezier (path), 0, 0, FALSE,
+                                      GIMP_PATH_STYLE_DEFAULT);
+
+              gimp_draw_tool_add_item (dt, item);
+              g_object_unref (item);
+            }
+
+          g_object_unref (path);
+        }
+    }
+}
+
+static void
+gimp_pselect_tool_control (GimpTool       *tool,
+                           GimpToolAction  action,
+                           GimpDisplay    *display)
+{
+  GimpPSelectTool *st = (GimpPSelectTool *) tool;
+
+  if (action == GIMP_TOOL_ACTION_HALT || action == GIMP_TOOL_ACTION_COMMIT)
+    {
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+      st->mode = PS_NONE;
+    }
+
+  GIMP_TOOL_CLASS (gimp_pselect_tool_parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_pselect_tool_finalize (GObject *object)
+{
+  GimpPSelectTool *st = (GimpPSelectTool *) object;
+
+  pselect_set_item (st, NULL);
+  g_array_unref (st->ids);
+
+  G_OBJECT_CLASS (gimp_pselect_tool_parent_class)->finalize (object);
+}
+
+static void
+gimp_pselect_tool_class_init (GimpPSelectToolClass *klass)
+{
+  GObjectClass      *object_class    = G_OBJECT_CLASS (klass);
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  object_class->finalize     = gimp_pselect_tool_finalize;
+
+  tool_class->control        = gimp_pselect_tool_control;
+  tool_class->button_press   = gimp_pselect_tool_button_press;
+  tool_class->motion         = gimp_pselect_tool_motion;
+  tool_class->button_release = gimp_pselect_tool_button_release;
+  tool_class->oper_update    = gimp_pselect_tool_oper_update;
+  tool_class->key_press      = gimp_pselect_tool_key_press;
+
+  draw_tool_class->draw      = gimp_pselect_tool_draw;
+}
+
+static void
+gimp_pselect_tool_init (GimpPSelectTool *st)
+{
+  GimpTool *tool = GIMP_TOOL (st);
+
+  st->ids = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  gimp_tool_control_set_motion_mode (tool->control, GIMP_MOTION_MODE_COMPRESS);
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_MOVE);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_MOVE);
+}
+
+static GtkWidget *
+pselect_options_gui (GimpToolOptions *tool_options)
+{
+  GtkWidget *vbox = gimp_tool_options_gui (tool_options);
+  GtkWidget *w;
+
+  w = gtk_button_new_with_label (_("Attacher au plan actif"));
+  gimp_help_set_help_data (w, _("Les calques ou objets sélectionnés appartiennent au plan "
+                                "actif, sans changer d'aspect"), NULL);
+  g_object_set_data (G_OBJECT (w), "chopgimp-options", tool_options);
+  g_signal_connect (w, "clicked", G_CALLBACK (gui_pgrid_action),
+                    (gpointer) "view-perspective-attach");
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+
+  w = gtk_button_new_with_label (_("Libérer de la perspective"));
+  gimp_help_set_help_data (w, _("Les calques ou objets sélectionnés quittent leur plan, "
+                                "sans changer d'aspect"), NULL);
+  g_object_set_data (G_OBJECT (w), "chopgimp-options", tool_options);
+  g_signal_connect (w, "clicked", G_CALLBACK (gui_pgrid_action),
+                    (gpointer) "view-perspective-release");
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+
+  w = gtk_label_new (_("Faites glisser un calque ou un objet vectoriel : il se pose sur le "
+                       "plan actif, ou se déplace sur son plan. Alt : copie. Flèches : "
+                       "décaler sur le plan (Maj × 10). 1 / 2 / 3 / 4 : plan gauche / "
+                       "horizontal / droit / aucun. Les formes (U) se dessinent sur le "
+                       "plan actif."));
+  gtk_label_set_xalign (GTK_LABEL (w), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (w), TRUE);
+  gimp_label_set_attributes (GTK_LABEL (w), PANGO_ATTR_SCALE, PANGO_SCALE_SMALL, -1);
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+
+  gtk_widget_show_all (vbox);
+
+  return vbox;
+}
+
+
