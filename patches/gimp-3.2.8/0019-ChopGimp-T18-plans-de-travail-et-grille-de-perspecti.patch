+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+
+#include "core-types.h"
+
+#include "gimpimage.h"
+#include "gimpimage-resize.h"
+#include "gimpimage-undo.h"
+#include "gimpimage-undo-push.h"
+#include "gimpimageundo.h"
+
+#include "chopgimp-artboards.h"
+#include "chopgimp-pgrid.h"
+
+#include "gimp-intl.h"
+
+
+#define HEADER "chopgimp-artboards 1"
+
+
+/*  ─── arrays ────────────────────────────────────────────────────────── */
+
+static void
+board_clear (gpointer data)
+{
+  ChopGimpArtboard *b = data;
+
+  g_clear_pointer (&b->name, g_free);
+}
+
+GArray *
+chopgimp_artboards_new_array (void)
+{
+  GArray *a = g_array_new (FALSE, TRUE, sizeof (ChopGimpArtboard));
+
+  g_array_set_clear_func (a, board_clear);
+
+  return a;
+}
+
+void
+chopgimp_artboards_free (GArray *boards)
+{
+  if (boards)
+    g_array_unref (boards);
+}
+
+static gchar *
+clean_name (const gchar *name)
+{
+  gchar *s = g_strdup (name ? name : "");
+
+  g_strdelimit (s, "\r\n\t", ' ');
+  g_strstrip (s);
+
+  if (! *s)
+    {
+      g_free (s);
+      s = g_strdup (_("Plan de travail"));
+    }
+
+  return s;
+}
+
+GArray *
+chopgimp_artboards_parse (const gchar *data,
+                          gsize        size,
+                          gint        *active)
+{
+  GArray  *a = chopgimp_artboards_new_array ();
+  gchar   *text;
+  gchar  **lines;
+  gint     act = -1;
+
+  if (active)
+    *active = -1;
+
+  if (! data || ! size)
+    return a;
+
+  text  = g_strndup (data, size);
+  lines = g_strsplit (text, "\n", -1);
+
+  for (gint i = 0; lines[i]; i++)
+    {
+      gchar            *l = g_strstrip (lines[i]);
+      ChopGimpArtboard  b = { 0, };
+      gchar            *end;
+      gint              v[4];
+      gint              k;
+
+      if (! *l || g_str_has_prefix (l, "chopgimp-artboards"))
+        continue;
+
+      if (g_str_has_prefix (l, "active "))
+        {
+          act = atoi (l + 7);
+          continue;
+        }
+
+      for (k = 0, end = l; k < 4; k++)
+        {
+          gchar *next;
+
+          v[k] = (gint) strtol (end, &next, 10);
+          if (next == end)
+            break;
+          end = next;
+        }
+
+      if (k < 4 || v[2] < 1 || v[3] < 1)
+        continue;
+
+      b.x      = v[0];
+      b.y      = v[1];
+      b.width  = v[2];
+      b.height = v[3];
+      b.name   = clean_name (end);
+      g_array_append_val (a, b);
+    }
+
+  g_strfreev (lines);
+  g_free (text);
+
+  if (active)
+    *active = (act >= 0 && act < (gint) a->len) ? act : (a->len ? 0 : -1);
+
+  return a;
+}
+
+gchar *
+chopgimp_artboards_serialize (GArray *boards,
+                              gint    active)
+{
+  GString *s = g_string_new (HEADER "\n");
+
+  g_string_append_printf (s, "active %d\n", active);
+
+  for (guint i = 0; boards && i < boards->len; i++)
+    {
+      ChopGimpArtboard *b    = &g_array_index (boards, ChopGimpArtboard, i);
+      gchar            *name = clean_name (b->name);
+
+      g_string_append_printf (s, "%d %d %d %d %s\n",
+                              b->x, b->y, MAX (b->width, 1), MAX (b->height, 1), name);
+      g_free (name);
+    }
+
+  return g_string_free (s, FALSE);
+}
+
+gboolean
+chopgimp_artboards_parse_range (const gchar *range,
+                                gint         n,
+                                gboolean    *selected)
+{
+  gchar  **parts;
+  gchar   *trim = g_strstrip (g_strdup (range ? range : ""));
+  gboolean all  = ! *trim || ! g_strcmp0 (trim, "all");
+  gboolean ok   = TRUE;
+  gboolean any  = FALSE;
+
+  g_free (trim);
+
+  for (gint i = 0; i < n; i++)
+    selected[i] = FALSE;
+
+  if (all)
+    {
+      for (gint i = 0; i < n; i++)
+        selected[i] = TRUE;
+
+      return TRUE;
+    }
+
+  parts = g_strsplit_set (range, ",;", -1);
+
+  for (gint i = 0; parts[i]; i++)
+    {
+      gchar *p = g_strstrip (parts[i]);
+      gchar *dash;
+      gint   a, b;
+
+      if (! *p)
+        continue;
+
+      dash = strchr (p, '-');
+
+      if (dash)
+        {
+          *dash = '\0';
+          a = *g_strstrip (p) ? atoi (p) : 1;
+          b = *g_strstrip (dash + 1) ? atoi (dash + 1) : n;
+        }
+      else
+        {
+          a = b = atoi (p);
+        }
+
+      if (a < 1 || b < a)
+        {
+          ok = FALSE;
+          continue;
+        }
+
+      for (gint k = a; k <= b && k <= n; k++)
+        {
+          selected[k - 1] = TRUE;
+          any = TRUE;
+        }
+    }
+
+  g_strfreev (parts);
+
+  return ok && any;
+}
+
+gchar *
+chopgimp_artboards_file_name (const gchar *name)
+{
+  gchar *s = clean_name (name);
+
+  g_strdelimit (s, "/\\:*?\"<>|", '_');
+
+  return s;
+}
+
+
+/*  ─── image ─────────────────────────────────────────────────────────── */
+
+GArray *
+chopgimp_artboards_get (GimpImage *image,
+                        gint      *active)
+{
+  const GimpParasite *p;
+  const gchar        *data = NULL;
+  guint32             size = 0;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  p = gimp_image_parasite_find (image, CHOPGIMP_ARTBOARDS_PARASITE);
+  if (p)
+    data = gimp_parasite_get_data (p, &size);
+
+  return chopgimp_artboards_parse (data, size, active);
+}
+
+gint
+chopgimp_artboards_count (GimpImage *image)
+{
+  GArray *a = chopgimp_artboards_get (image, NULL);
+  gint    n = a ? a->len : 0;
+
+  chopgimp_artboards_free (a);
+
+  return n;
+}
+
+gboolean
+chopgimp_artboards_get_nth (GimpImage        *image,
+                            gint              index,
+                            ChopGimpArtboard *board)
+{
+  GArray   *a  = chopgimp_artboards_get (image, NULL);
+  gboolean  ok = index >= 0 && index < (gint) a->len;
+
+  if (ok)
+    {
+      *board      = g_array_index (a, ChopGimpArtboard, index);
+      board->name = g_strdup (board->name);
+    }
+
+  chopgimp_artboards_free (a);
+
+  return ok;
+}
+
+static gboolean
+can_compress (GimpImage   *image,
+              const gchar *name)
+{
+  GimpUndo *undo = gimp_image_undo_can_compress (image, GIMP_TYPE_IMAGE_UNDO,
+                                                 GIMP_UNDO_PARASITE_ATTACH);
+
+  return undo && ! g_strcmp0 (GIMP_IMAGE_UNDO (undo)->parasite_name, name);
+}
+
+static void
+artboards_write (GimpImage   *image,
+                 GArray      *boards,
+                 gint         active,
+                 const gchar *undo_desc,
+                 gboolean     compress)
+{
+  gboolean push = undo_desc && ! (compress && can_compress (image, CHOPGIMP_ARTBOARDS_PARASITE));
+
+  if (! boards || boards->len == 0)
+    {
+      if (! gimp_image_parasite_find (image, CHOPGIMP_ARTBOARDS_PARASITE))
+        return;
+
+      if (push)
+        gimp_image_undo_push_image_parasite_remove (image, undo_desc,
+                                                    CHOPGIMP_ARTBOARDS_PARASITE);
+      gimp_image_parasite_detach (image, CHOPGIMP_ARTBOARDS_PARASITE, FALSE);
+    }
+  else
+    {
+      gchar        *text = chopgimp_artboards_serialize (boards, active);
+      GimpParasite *p    = gimp_parasite_new (CHOPGIMP_ARTBOARDS_PARASITE,
+                                              GIMP_PARASITE_PERSISTENT |
+                                              GIMP_PARASITE_UNDOABLE,
+                                              strlen (text) + 1, text);
+
+      if (push)
+        gimp_image_undo_push_image_parasite (image, undo_desc, p);
+      gimp_image_parasite_attach (image, p, FALSE);
+
+      gimp_parasite_free (p);
+      g_free (text);
+    }
+}
+
+gint
+chopgimp_artboards_get_active (GimpImage *image)
+{
+  gint    active;
+  GArray *a = chopgimp_artboards_get (image, &active);
+
+  chopgimp_artboards_free (a);
+
+  return active;
+}
+
+void
+chopgimp_artboards_set_active (GimpImage *image,
+                               gint       index)
+{
+  gint    active;
+  GArray *a = chopgimp_artboards_get (image, &active);
+
+  if (a->len && index != active)
+    artboards_write (image, a, CLAMP (index, -1, (gint) a->len - 1), NULL, FALSE);
+
+  chopgimp_artboards_free (a);
+}
+
+gint
+chopgimp_artboards_add (GimpImage   *image,
+                        gint         x,
+                        gint         y,
+                        gint         width,
+                        gint         height,
+                        const gchar *name)
+{
+  GArray           *a = chopgimp_artboards_get (image, NULL);
+  ChopGimpArtboard  b;
+  gint              index;
+
+  b.x      = x;
+  b.y      = y;
+  b.width  = MAX (width, 1);
+  b.height = MAX (height, 1);
+
+  if (name)
+    {
+      b.name = g_strdup (name);
+    }
+  else
+    {
+      /*  « Plan de travail N », N not used yet  */
+      gint n = a->len + 1;
+
+      for (;;)
+        {
+          gboolean used = FALSE;
+
+          b.name = g_strdup_printf (_("Plan de travail %d"), n);
+          for (guint i = 0; i < a->len && ! used; i++)
+            used = ! g_strcmp0 (g_array_index (a, ChopGimpArtboard, i).name, b.name);
+          if (! used)
+            break;
+          g_free (b.name);
+          n++;
+        }
+    }
+
+  g_array_append_val (a, b);
+  index = a->len - 1;
+
+  artboards_write (image, a, index, _("Nouveau plan de travail"), FALSE);
+  chopgimp_artboards_free (a);
+
+  return index;
+}
+
+void
+chopgimp_artboards_remove (GimpImage *image,
+                           gint       index)
+{
+  gint    active;
+  GArray *a = chopgimp_artboards_get (image, &active);
+
+  if (index >= 0 && index < (gint) a->len)
+    {
+      g_array_remove_index (a, index);
+
+      if (active >= (gint) a->len)
+        active = (gint) a->len - 1;
+
+      artboards_write (image, a, active, _("Supprimer le plan de travail"), FALSE);
+    }
+
+  chopgimp_artboards_free (a);
+}
+
+void
+chopgimp_artboards_rename (GimpImage   *image,
+                           gint         index,
+                           const gchar *name)
+{
+  gint    active;
+  GArray *a = chopgimp_artboards_get (image, &active);
+
+  if (index >= 0 && index < (gint) a->len && name && *name)
+    {
+      ChopGimpArtboard *b = &g_array_index (a, ChopGimpArtboard, index);
+
+      if (g_strcmp0 (b->name, name))
+        {
+          g_free (b->name);
+          b->name = clean_name (name);
+          artboards_write (image, a, active, _("Renommer le plan de travail"), FALSE);
+        }
+    }
+
+  chopgimp_artboards_free (a);
+}
+
+void
+chopgimp_artboards_set_rect (GimpImage *image,
+                             gint       index,
+                             gint       x,
+                             gint       y,
+                             gint       width,
+                             gint       height,
+                             gboolean   compress)
+{
+  gint    active;
+  GArray *a = chopgimp_artboards_get (image, &active);
+
+  if (index >= 0 && index < (gint) a->len)
+    {
+      ChopGimpArtboard *b = &g_array_index (a, ChopGimpArtboard, index);
+
+      width  = MAX (width, 1);
+      height = MAX (height, 1);
+
+      if (b->x != x || b->y != y || b->width != width || b->height != height)
+        {
+          b->x      = x;
+          b->y      = y;
+          b->width  = width;
+          b->height = height;
+          artboards_write (image, a, active,
+                           _("Plan de travail : déplacer / redimensionner"), compress);
+        }
+    }
+
+  chopgimp_artboards_free (a);
+}
+
+gint
+chopgimp_artboards_duplicate (GimpImage *image,
+                              gint       index,
+                              gboolean   at,
+                              gint       x,
+                              gint       y)
+{
+  GArray *a      = chopgimp_artboards_get (image, NULL);
+  gint    result = -1;
+
+  if (index >= 0 && index < (gint) a->len)
+    {
+      ChopGimpArtboard b = g_array_index (a, ChopGimpArtboard, index);
+      gint             right = 0;
+
+      for (guint i = 0; i < a->len; i++)
+        {
+          ChopGimpArtboard *o = &g_array_index (a, ChopGimpArtboard, i);
+
+          right = MAX (right, o->x + o->width);
+        }
+
+      b.name = g_strdup_printf (_("%s copie"), b.name);
+
+      if (at)
+        {
+          b.x = x;
+          b.y = y;
+        }
+      else
+        {
+          /*  Illustrator: the copy goes to the right of all the others  */
+          b.x = right + MAX (20, b.width / 10);
+        }
+
+      g_array_append_val (a, b);
+      result = a->len - 1;
+
+      artboards_write (image, a, result, _("Dupliquer le plan de travail"), FALSE);
+    }
+
+  chopgimp_artboards_free (a);
+
+  return result;
+}
+
+void
+chopgimp_artboards_move_to (GimpImage *image,
+                            gint       index,
+                            gint       new_index)
+{
+  GArray *a = chopgimp_artboards_get (image, NULL);
+
+  new_index = CLAMP (new_index, 0, (gint) a->len - 1);
+
+  if (index >= 0 && index < (gint) a->len && index != new_index)
+    {
+      ChopGimpArtboard b = g_array_index (a, ChopGimpArtboard, index);
+
+      b.name = g_strdup (b.name);
+      g_array_remove_index (a, index);
+      g_array_insert_val (a, new_index, b);
+
+      artboards_write (image, a, new_index, _("Réordonner les plans de travail"), FALSE);
+    }
+
+  chopgimp_artboards_free (a);
+}
+
+gint
+chopgimp_artboards_find_at (GimpImage *image,
+                            gdouble    x,
+                            gdouble    y)
+{
+  GArray *a      = chopgimp_artboards_get (image, NULL);
+  gint    result = -1;
+
+  for (gint i = (gint) a->len - 1; i >= 0 && result < 0; i--)
+    {
+      ChopGimpArtboard *b = &g_array_index (a, ChopGimpArtboard, i);
+
+      if (x >= b->x && x < b->x + b->width && y >= b->y && y < b->y + b->height)
+        result = i;
+    }
+
+  chopgimp_artboards_free (a);
+
+  return result;
+}
+
+gboolean
+chopgimp_artboards_rect_for_box (GimpImage     *image,
+                                 gdouble        x1,
+                                 gdouble        y1,
+                                 gdouble        x2,
+                                 gdouble        y2,
+                                 GeglRectangle *rect)
+{
+  gint    active;
+  GArray *a = chopgimp_artboards_get (image, &active);
+  gint    i = chopgimp_artboards_find_at (image, (x1 + x2) / 2.0, (y1 + y2) / 2.0);
+
+  if (i < 0)
+    i = active;
+
+  if (i >= 0 && i < (gint) a->len)
+    {
+      ChopGimpArtboard *b = &g_array_index (a, ChopGimpArtboard, i);
+
+      *rect = *GEGL_RECTANGLE (b->x, b->y, b->width, b->height);
+      chopgimp_artboards_free (a);
+
+      return TRUE;
+    }
+
+  chopgimp_artboards_free (a);
+
+  return FALSE;
+}
+
+gboolean
+chopgimp_artboards_fit_canvas (GimpImage   *image,
+                               GimpContext *context)
+{
+  GArray *a  = chopgimp_artboards_get (image, NULL);
+  gint    x1 = 0, y1 = 0;
+  gint    x2 = gimp_image_get_width  (image);
+  gint    y2 = gimp_image_get_height (image);
+  gint    w  = x2, h = y2;
+
+  for (guint i = 0; i < a->len; i++)
+    {
+      ChopGimpArtboard *b = &g_array_index (a, ChopGimpArtboard, i);
+
+      x1 = MIN (x1, b->x);
+      y1 = MIN (y1, b->y);
+      x2 = MAX (x2, b->x + b->width);
+      y2 = MAX (y2, b->y + b->height);
+    }
+
+  chopgimp_artboards_free (a);
+
+  if (x1 == 0 && y1 == 0 && x2 == w && y2 == h)
+    return FALSE;
+
+  /*  the offset moves the content, the guides and (through
+   *  chopgimp_image_overlays_transform) the artboards and the grid
+   */
+  gimp_image_resize (image, context, x2 - x1, y2 - y1, -x1, -y1, NULL);
+
+  return TRUE;
+}
+
+
+/*  ─── image operations ──────────────────────────────────────────────── */
+
+void
+chopgimp_image_overlays_transform (GimpImage         *image,
+                                   const GimpMatrix3 *matrix)
+{
+  gint          active;
+  GArray       *a;
+  ChopGimpPGrid grid;
+
+  g_return_if_fail (GIMP_IS_IMAGE (image));
+  g_return_if_fail (matrix != NULL);
+
+  a = chopgimp_artboards_get (image, &active);
+
+  if (a->len)
+    {
+      for (guint i = 0; i < a->len; i++)
+        {
+          ChopGimpArtboard *b = &g_array_index (a, ChopGimpArtboard, i);
+          gdouble           cx[4] = { b->x, b->x + b->width, b->x + b->width, b->x };
+          gdouble           cy[4] = { b->y, b->y, b->y + b->height, b->y + b->height };
+          gdouble           minx = G_MAXDOUBLE, miny = G_MAXDOUBLE;
+          gdouble           maxx = -G_MAXDOUBLE, maxy = -G_MAXDOUBLE;
+
+          for (gint k = 0; k < 4; k++)
+            {
+              gdouble tx, ty;
+
+              gimp_matrix3_transform_point (matrix, cx[k], cy[k], &tx, &ty);
+              minx = MIN (minx, tx); maxx = MAX (maxx, tx);
+              miny = MIN (miny, ty); maxy = MAX (maxy, ty);
+            }
+
+          b->x      = (gint) RINT (minx);
+          b->y      = (gint) RINT (miny);
+          b->width  = MAX (1, (gint) RINT (maxx - minx));
+          b->height = MAX (1, (gint) RINT (maxy - miny));
+        }
+
+      artboards_write (image, a, active, _("Plans de travail"), FALSE);
+    }
+
+  chopgimp_artboards_free (a);
+
+  if (chopgimp_pgrid_get (image, &grid))
+    {
+      chopgimp_pgrid_transform (&grid, matrix);
+      chopgimp_pgrid_set (image, &grid, _("Grille de perspective"), FALSE);
+    }
+}
diff --git a/app/core/chopgimp-artboards.h b/app/core/chopgimp-artboards.h
new file mode 100644
index 0000000..452dd7a
--- /dev/null
+++ b/app/core/chopgimp-artboards.h
@@ -0,0 +1,146 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-artboards.h — ChopGimp 3.31.0 (lot 4a): Illustrator's artboards
+ *
+ * An image holds an ordered list of artboards: named rectangles in image
+ * coordinates (pages or formats of the same file). The image itself is
+ * unchanged (its canvas is the pasteboard); the artboards are drawn over
+ * the canvas (app/display/chopgimp-canvasartboards.c), follow the image
+ * operations like the guides (resize, crop, scale, flip, rotate,
+ * transform: chopgimp_image_overlays_transform()) and are saved in the
+ * XCF as the image parasite « chopgimp-artboards » (persistent, undoable).
+ *
+ * API for the exporters (PNG / JPG per artboard here, PDF / EPS / PSD /
+ * PDF with layers later):
+ *   - core:     chopgimp_artboards_get() → GArray of ChopGimpArtboard
+ *               (name, x, y, width, height), in the order of the panel;
+ *   - PDB:      chopgimp-artboards-command (image, "list") → one line per
+ *               artboard « x y width height name »;
+ *   - plug-ins: the parasite, read with
+ *               plug-ins/common/chopgimp-artboards-parse.h.
+ *
+ * Parasite format (UTF-8 text, one record per line):
+ *   chopgimp-artboards 1
+ *   active <index>                 (0-based, -1: none)
+ *   <x> <y> <width> <height> <name until the end of the line>
+ *   ...
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#define CHOPGIMP_ARTBOARDS_PARASITE "chopgimp-artboards"
+
+
+typedef struct
+{
+  gchar *name;
+  gint   x;
+  gint   y;
+  gint   width;
+  gint   height;
+} ChopGimpArtboard;
+
+
+/*  ─── parsing (no image) ────────────────────────────────────────────── */
+
+/*  @data / @size: the parasite's data; @active may be NULL  */
+GArray   * chopgimp_artboards_parse          (const gchar      *data,
+                                              gsize             size,
+                                              gint             *active);
+gchar    * chopgimp_artboards_serialize      (GArray           *boards,
+                                              gint              active);
+GArray   * chopgimp_artboards_new_array      (void);
+void       chopgimp_artboards_free           (GArray           *boards);
+/*  « 1-3, 5 » (1-based) → @selected[n]; empty or NULL: all; FALSE on a
+ *  syntax error
+ */
+gboolean   chopgimp_artboards_parse_range    (const gchar      *range,
+                                              gint              n,
+                                              gboolean         *selected);
+/*  a file name made of the artboard's name (no / \ : * ? " < > |)  */
+gchar    * chopgimp_artboards_file_name      (const gchar      *name);
+
+
+/*  ─── the artboards of an image ─────────────────────────────────────── */
+
+/*  a new array (empty when the image has none); @active may be NULL  */
+GArray   * chopgimp_artboards_get            (GimpImage        *image,
+                                              gint             *active);
+gint       chopgimp_artboards_count          (GimpImage        *image);
+/*  @board: filled with a copy (g_free (board->name)); FALSE: no such one  */
+gboolean   chopgimp_artboards_get_nth        (GimpImage        *image,
+                                              gint              index,
+                                              ChopGimpArtboard *board);
+gint       chopgimp_artboards_get_active     (GimpImage        *image);
+/*  not undoable (the panel / tool selection)  */
+void       chopgimp_artboards_set_active     (GimpImage        *image,
+                                              gint              index);
+
+/*  returns the new index; @name NULL: « Plan de travail N »  */
+gint       chopgimp_artboards_add            (GimpImage        *image,
+                                              gint              x,
+                                              gint              y,
+                                              gint              width,
+                                              gint              height,
+                                              const gchar      *name);
+void       chopgimp_artboards_remove         (GimpImage        *image,
+                                              gint              index);
+void       chopgimp_artboards_rename         (GimpImage        *image,
+                                              gint              index,
+                                              const gchar      *name);
+/*  @undo_desc NULL: « Plan de travail : déplacer / redimensionner »;
+ *  @compress: no new undo step when the last one is already a change of
+ *  the artboards (spin buttons, nudges)
+ */
+void       chopgimp_artboards_set_rect       (GimpImage        *image,
+                                              gint              index,
+                                              gint              x,
+                                              gint              y,
+                                              gint              width,
+                                              gint              height,
+                                              gboolean          compress);
+/*  a copy to the right of the original (or at @x, @y when @at); returns
+ *  its index
+ */
+gint       chopgimp_artboards_duplicate      (GimpImage        *image,
+                                              gint              index,
+                                              gboolean          at,
+                                              gint              x,
+                                              gint              y);
+void       chopgimp_artboards_move_to        (GimpImage        *image,
+                                              gint              index,
+                                              gint              new_index);
+
+/*  the topmost (last) artboard containing (x, y); -1: none  */
+gint       chopgimp_artboards_find_at        (GimpImage        *image,
+                                              gdouble           x,
+                                              gdouble           y);
+/*  the artboard of a box (the one holding its centre, else the active
+ *  one); FALSE when the image has none (« Aligner sur le plan de
+ *  travail » then uses the canvas)
+ */
+gboolean   chopgimp_artboards_rect_for_box   (GimpImage        *image,
+                                              gdouble           x1,
+                                              gdouble           y1,
+                                              gdouble           x2,
+                                              gdouble           y2,
+                                              GeglRectangle    *rect);
+/*  the canvas grows to hold all the artboards (they and the content
+ *  follow when it grows to the left or the top); TRUE when resized
+ */
+gboolean   chopgimp_artboards_fit_canvas     (GimpImage        *image,
+                                              GimpContext      *context);
+
+
+/*  ─── image operations (called next to the guides) ─────────────────── */
+
+/*  the artboards and the perspective grid follow an operation of the
+ *  whole image (old image coordinates → new ones); pushes undo steps
+ *  (the caller has an undo group)
+ */
+void       chopgimp_image_overlays_transform (GimpImage         *image,
+                                              const GimpMatrix3 *matrix);
diff --git a/app/core/chopgimp-pgrid.c b/app/core/chopgimp-pgrid.c
new file mode 100644
index 0000000..ead1a0c
--- /dev/null
+++ b/app/core/chopgimp-pgrid.c
@@ -0,0 +1,1053 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-pgrid.c — ChopGimp 3.31.0 (lot 4a): Illustrator's perspective
+ * grid (see chopgimp-pgrid.h for the model)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+
+#include "core-types.h"
+
+#include "gimpimage.h"
+#include "gimpimage-undo.h"
+#include "gimpimage-undo-push.h"
+#include "gimpimageundo.h"
+#include "gimpcontext.h"
+#include "gimpdrawable.h"
+#include "gimpitem.h"
+
+#include "chopgimp-pgrid.h"
+
+#include "gimp-intl.h"
+
+
+/*  ─── the grid ──────────────────────────────────────────────────────── */
+
+void
+chopgimp_pgrid_init (ChopGimpPGrid *grid,
+                     gint           type,
+                     gint           width,
+                     gint           height)
+{
+  gdouble w = MAX (width, 16), h = MAX (height, 16);
+
+  memset (grid, 0, sizeof (*grid));
+
+  grid->visible      = FALSE;
+  grid->snap         = TRUE;
+  grid->locked       = FALSE;
+  grid->lock_station = FALSE;
+  grid->active_plane = CHOPGIMP_PLANE_LEFT;
+
+  grid->origin[0] = w / 2.0;
+  grid->origin[1] = h * 0.80;
+
+  grid->cell     = MAX (4.0, RINT (MIN (w, h) / 20.0));
+  grid->extent_l = 10;
+  grid->extent_r = 10;
+  grid->height   = 8;
+  grid->opacity  = 0.6;
+
+  grid->color[CHOPGIMP_PLANE_NONE]  = 0x808080;
+  grid->color[CHOPGIMP_PLANE_LEFT]  = 0x2f7cf6;   /* Illustrator: blue   */
+  grid->color[CHOPGIMP_PLANE_RIGHT] = 0xe8563a;   /*              orange */
+  grid->color[CHOPGIMP_PLANE_FLOOR] = 0x3bb143;   /*              green  */
+
+  grid->vl[1] = grid->vr[1] = h * 0.45;           /* the horizon         */
+  grid->vv[0] = w / 2.0;
+  grid->vv[1] = h * 2.6;
+
+  chopgimp_pgrid_set_type (grid, type, width, height);
+}
+
+void
+chopgimp_pgrid_set_type (ChopGimpPGrid *grid,
+                         gint           type,
+                         gint           width,
+                         gint           height)
+{
+  gdouble w       = MAX (width, 16);
+  gdouble horizon = grid->vl[1];
+
+  type = CLAMP (type, 1, 3);
+
+  if (type == grid->type)
+    return;
+
+  if (type == 1)
+    {
+      /*  the central VP above the origin; the right plane is the front  */
+      grid->vl[0] = grid->origin[0];
+      grid->vr[0] = grid->origin[0] + w;
+      grid->vr[1] = horizon;
+      if (grid->active_plane == CHOPGIMP_PLANE_NONE)
+        grid->active_plane = CHOPGIMP_PLANE_RIGHT;
+    }
+  else if (grid->type <= 1)
+    {
+      grid->vl[0] = grid->origin[0] - w * 0.8;
+      grid->vr[0] = grid->origin[0] + w * 0.8;
+      grid->vr[1] = horizon;
+    }
+
+  if (type == 3 && fabs (grid->vv[1] - grid->origin[1]) < 1.0)
+    grid->vv[1] = grid->origin[1] + w * 2.0;
+
+  grid->type = type;
+}
+
+static void
+put_xy (GString       *s,
+        const gchar   *key,
+        const gdouble *p)
+{
+  gchar a[G_ASCII_DTOSTR_BUF_SIZE], b[G_ASCII_DTOSTR_BUF_SIZE];
+
+  g_string_append_printf (s, "%s=%s,%s\n", key,
+                          g_ascii_dtostr (a, sizeof (a), p[0]),
+                          g_ascii_dtostr (b, sizeof (b), p[1]));
+}
+
+static void
+put_d (GString     *s,
+       const gchar *key,
+       gdouble      v)
+{
+  gchar a[G_ASCII_DTOSTR_BUF_SIZE];
+
+  g_string_append_printf (s, "%s=%s\n", key, g_ascii_dtostr (a, sizeof (a), v));
+}
+
+gchar *
+chopgimp_pgrid_to_string (const ChopGimpPGrid *g)
+{
+  GString *s = g_string_new ("chopgimp-perspective-grid=1\n");
+  gchar    a[G_ASCII_DTOSTR_BUF_SIZE], b[G_ASCII_DTOSTR_BUF_SIZE], c[G_ASCII_DTOSTR_BUF_SIZE];
+
+  g_string_append_printf (s, "type=%d\nvisible=%d\nsnap=%d\nlocked=%d\nlock-station=%d\n"
+                          "active=%d\nextent-l=%d\nextent-r=%d\nheight=%d\n",
+                          g->type, g->visible ? 1 : 0, g->snap ? 1 : 0, g->locked ? 1 : 0,
+                          g->lock_station ? 1 : 0, g->active_plane,
+                          g->extent_l, g->extent_r, g->height);
+  put_xy (s, "vl", g->vl);
+  put_xy (s, "vr", g->vr);
+  put_xy (s, "vv", g->vv);
+  put_xy (s, "origin", g->origin);
+  put_d  (s, "cell", g->cell);
+  put_d  (s, "opacity", g->opacity);
+  g_string_append_printf (s, "offsets=%s,%s,%s\n",
+                          g_ascii_dtostr (a, sizeof (a), g->offset[CHOPGIMP_PLANE_LEFT]),
+                          g_ascii_dtostr (b, sizeof (b), g->offset[CHOPGIMP_PLANE_RIGHT]),
+                          g_ascii_dtostr (c, sizeof (c), g->offset[CHOPGIMP_PLANE_FLOOR]));
+  g_string_append_printf (s, "colors=%06x,%06x,%06x\n",
+                          g->color[CHOPGIMP_PLANE_LEFT] & 0xffffff,
+                          g->color[CHOPGIMP_PLANE_RIGHT] & 0xffffff,
+                          g->color[CHOPGIMP_PLANE_FLOOR] & 0xffffff);
+
+  return g_string_free (s, FALSE);
+}
+
+static void
+get_list (const gchar *v,
+          gdouble     *out,
+          gint         n)
+{
+  gchar **p = g_strsplit (v, ",", -1);
+
+  for (gint i = 0; i < n && p[i]; i++)
+    out[i] = g_ascii_strtod (p[i], NULL);
+
+  g_strfreev (p);
+}
+
+gboolean
+chopgimp_pgrid_from_string (ChopGimpPGrid *g,
+                            const gchar   *text)
+{
+  gchar  **lines;
+  gboolean ok = FALSE;
+
+  if (! text)
+    return FALSE;
+
+  lines = g_strsplit (text, "\n", -1);
+
+  for (gint i = 0; lines[i]; i++)
+    {
+      gchar *eq = strchr (lines[i], '=');
+      gchar *k, *v;
+
+      if (! eq)
+        continue;
+
+      *eq = '\0';
+      k   = g_strstrip (lines[i]);
+      v   = g_strstrip (eq + 1);
+
+      if      (! strcmp (k, "chopgimp-perspective-grid")) ok = TRUE;
+      else if (! strcmp (k, "type"))         g->type         = CLAMP (atoi (v), 1, 3);
+      else if (! strcmp (k, "visible"))      g->visible      = atoi (v) != 0;
+      else if (! strcmp (k, "snap"))         g->snap         = atoi (v) != 0;
+      else if (! strcmp (k, "locked"))       g->locked       = atoi (v) != 0;
+      else if (! strcmp (k, "lock-station")) g->lock_station = atoi (v) != 0;
+      else if (! strcmp (k, "active"))       g->active_plane = CLAMP (atoi (v), 0, 3);
+      else if (! strcmp (k, "extent-l"))     g->extent_l     = CLAMP (atoi (v), 1, 1000);
+      else if (! strcmp (k, "extent-r"))     g->extent_r     = CLAMP (atoi (v), 1, 1000);
+      else if (! strcmp (k, "height"))       g->height       = CLAMP (atoi (v), 1, 1000);
+      else if (! strcmp (k, "vl"))           get_list (v, g->vl, 2);
+      else if (! strcmp (k, "vr"))           get_list (v, g->vr, 2);
+      else if (! strcmp (k, "vv"))           get_list (v, g->vv, 2);
+      else if (! strcmp (k, "origin"))       get_list (v, g->origin, 2);
+      else if (! strcmp (k, "cell"))         g->cell    = MAX (1.0, g_ascii_strtod (v, NULL));
+      else if (! strcmp (k, "opacity"))      g->opacity = CLAMP (g_ascii_strtod (v, NULL), 0.05, 1.0);
+      else if (! strcmp (k, "offsets"))      get_list (v, g->offset + 1, 3);
+      else if (! strcmp (k, "colors"))
+        {
+          gchar **c = g_strsplit (v, ",", -1);
+
+          for (gint n = 0; n < 3 && c[n]; n++)
+            g->color[n + 1] = (guint32) strtoul (c[n], NULL, 16) & 0xffffff;
+
+          g_strfreev (c);
+        }
+    }
+
+  g_strfreev (lines);
+
+  return ok;
+}
+
+gboolean
+chopgimp_pgrid_get (GimpImage     *image,
+                    ChopGimpPGrid *grid)
+{
+  const GimpParasite *p;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), FALSE);
+
+  chopgimp_pgrid_init (grid, 2,
+                       gimp_image_get_width (image), gimp_image_get_height (image));
+
+  p = gimp_image_parasite_find (image, CHOPGIMP_PGRID_PARASITE);
+
+  if (p)
+    {
+      guint32  size;
+      const gchar *data = gimp_parasite_get_data (p, &size);  /* size set first */
+      gchar       *text = g_strndup (data, size);
+
+      if (chopgimp_pgrid_from_string (grid, text))
+        {
+          g_free (text);
+          return TRUE;
+        }
+
+      g_free (text);
+    }
+
+  return FALSE;
+}
+
+void
+chopgimp_pgrid_set (GimpImage           *image,
+                    const ChopGimpPGrid *grid,
+                    const gchar         *undo_desc,
+                    gboolean             compress)
+{
+  gchar        *text;
+  GimpParasite *p;
+  gboolean      push = undo_desc != NULL;
+
+  g_return_if_fail (GIMP_IS_IMAGE (image));
+
+  if (push && compress)
+    {
+      GimpUndo *undo = gimp_image_undo_can_compress (image, GIMP_TYPE_IMAGE_UNDO,
+                                                     GIMP_UNDO_PARASITE_ATTACH);
+
+      if (undo && ! g_strcmp0 (GIMP_IMAGE_UNDO (undo)->parasite_name, CHOPGIMP_PGRID_PARASITE))
+        push = FALSE;
+    }
+
+  text = chopgimp_pgrid_to_string (grid);
+  p    = gimp_parasite_new (CHOPGIMP_PGRID_PARASITE,
+                            GIMP_PARASITE_PERSISTENT | GIMP_PARASITE_UNDOABLE,
+                            strlen (text) + 1, text);
+
+  if (push)
+    gimp_image_undo_push_image_parasite (image, undo_desc, p);
+  gimp_image_parasite_attach (image, p, FALSE);
+
+  gimp_parasite_free (p);
+  g_free (text);
+}
+
+ChopGimpPlane
+chopgimp_pgrid_get_active_plane (GimpImage *image)
+{
+  ChopGimpPGrid g;
+
+  if (image && chopgimp_pgrid_get (image, &g) && g.visible)
+    return g.active_plane;
+
+  return CHOPGIMP_PLANE_NONE;
+}
+
+void
+chopgimp_pgrid_set_active_plane (GimpImage     *image,
+                                 ChopGimpPlane  plane)
+{
+  ChopGimpPGrid g;
+
+  if (image && chopgimp_pgrid_get (image, &g) && g.active_plane != (gint) plane)
+    {
+      g.active_plane = plane;
+      chopgimp_pgrid_set (image, &g, NULL, FALSE);
+    }
+}
+
+const gchar *
+chopgimp_pgrid_plane_name (ChopGimpPlane plane)
+{
+  switch (plane)
+    {
+    case CHOPGIMP_PLANE_LEFT:  return _("Plan gauche");
+    case CHOPGIMP_PLANE_RIGHT: return _("Plan droit");
+    case CHOPGIMP_PLANE_FLOOR: return _("Plan horizontal");
+    default:                   return _("Aucun plan");
+    }
+}
+
+
+/*  ─── geometry ──────────────────────────────────────────────────────── */
+
+static void
+vp_column (const gdouble *vp,
+           const gdouble *o,
+           gdouble        sign,
+           gdouble        P[3][4],
+           gint           col)
+{
+  gdouble d = MAX (hypot (vp[0] - o[0], vp[1] - o[1]), 1e-3);
+  gdouble s = sign / d;
+
+  P[0][col] = s * vp[0];
+  P[1][col] = s * vp[1];
+  P[2][col] = s;
+}
+
+void
+chopgimp_pgrid_camera (const ChopGimpPGrid *g,
+                       gdouble              P[3][4])
+{
+  /*  X: towards the right VP (1 point: horizontal)  */
+  if (g->type == 1)
+    {
+      P[0][0] = 1.0; P[1][0] = 0.0; P[2][0] = 0.0;
+    }
+  else
+    {
+      vp_column (g->vr, g->origin, 1.0, P, 0);
+    }
+
+  /*  Y: up (3 points: towards the vertical VP)  */
+  if (g->type == 3)
+    {
+      gdouble sign = (g->origin[1] - g->vv[1] >= 0.0) ? 1.0 : -1.0;
+
+      vp_column (g->vv, g->origin, sign, P, 1);
+    }
+  else
+    {
+      P[0][1] = 0.0; P[1][1] = -1.0; P[2][1] = 0.0;
+    }
+
+  /*  Z: towards the left VP (1 point: the central VP)  */
+  vp_column (g->vl, g->origin, 1.0, P, 2);
+
+  P[0][3] = g->origin[0];
+  P[1][3] = g->origin[1];
+  P[2][3] = 1.0;
+}
+
+gboolean
+chopgimp_pgrid_project (const ChopGimpPGrid *g,
+                        gdouble              X,
+                        gdouble              Y,
+                        gdouble              Z,
+                        gdouble             *x,
+                        gdouble             *y)
+{
+  gdouble P[3][4];
+  gdouble r[3];
+
+  chopgimp_pgrid_camera (g, P);
+
+  for (gint i = 0; i < 3; i++)
+    r[i] = P[i][0] * X + P[i][1] * Y + P[i][2] * Z + P[i][3];
+
+  if (r[2] < 1e-9)
+    return FALSE;
+
+  *x = r[0] / r[2];
+  *y = r[1] / r[2];
+
+  return TRUE;
+}
+
+void
+chopgimp_pgrid_plane_matrix (const ChopGimpPGrid *g,
+                             ChopGimpPlane        plane,
+                             GimpMatrix3         *H)
+{
+  gdouble P[3][4];
+  gdouble off = g->offset[CLAMP (plane, 0, 3)];
+
+  chopgimp_pgrid_camera (g, P);
+  gimp_matrix3_identity (H);
+
+  for (gint r = 0; r < 3; r++)
+    {
+      switch (plane)
+        {
+        case CHOPGIMP_PLANE_LEFT:     /* u = -Z, v = -Y, X = off */
+          H->coeff[r][0] = -P[r][2];
+          H->coeff[r][1] = -P[r][1];
+          H->coeff[r][2] =  P[r][3] + off * P[r][0];
+          break;
+
+        case CHOPGIMP_PLANE_RIGHT:    /* u = X, v = -Y, Z = off */
+          H->coeff[r][0] =  P[r][0];
+          H->coeff[r][1] = -P[r][1];
+          H->coeff[r][2] =  P[r][3] + off * P[r][2];
+          break;
+
+        case CHOPGIMP_PLANE_FLOOR:    /* u = X, v = -Z, Y = off */
+          H->coeff[r][0] =  P[r][0];
+          H->coeff[r][1] = -P[r][2];
+          H->coeff[r][2] =  P[r][3] + off * P[r][1];
+          break;
+
+        default:
+          return;
+        }
+    }
+}
+
+gboolean
+chopgimp_pgrid_to_plane (const ChopGimpPGrid *g,
+                         ChopGimpPlane        plane,
+                         gdouble              x,
+                         gdouble              y,
+                         gdouble             *u,
+                         gdouble             *v)
+{
+  GimpMatrix3 H;
+  gdouble     a, b, c;
+
+  if (plane == CHOPGIMP_PLANE_NONE)
+    {
+      *u = x;
+      *v = y;
+      return TRUE;
+    }
+
+  chopgimp_pgrid_plane_matrix (g, plane, &H);
+
+  if (fabs (gimp_matrix3_determinant (&H)) < 1e-15)
+    return FALSE;
+
+  gimp_matrix3_invert (&H);
+
+  a = H.coeff[0][0] * x + H.coeff[0][1] * y + H.coeff[0][2];
+  b = H.coeff[1][0] * x + H.coeff[1][1] * y + H.coeff[1][2];
+  c = H.coeff[2][0] * x + H.coeff[2][1] * y + H.coeff[2][2];
+
+  /*  H (u, v, 1) = (x, y, 1) / c: the point is in front when c > 0  */
+  if (c < 1e-12)
+    return FALSE;
+
+  *u = a / c;
+  *v = b / c;
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_pgrid_from_plane (const ChopGimpPGrid *g,
+                           ChopGimpPlane        plane,
+                           gdouble              u,
+                           gdouble              v,
+                           gdouble             *x,
+                           gdouble             *y)
+{
+  GimpMatrix3 H;
+  gdouble     w;
+
+  if (plane == CHOPGIMP_PLANE_NONE)
+    {
+      *x = u;
+      *y = v;
+      return TRUE;
+    }
+
+  chopgimp_pgrid_plane_matrix (g, plane, &H);
+
+  w = H.coeff[2][0] * u + H.coeff[2][1] * v + H.coeff[2][2];
+
+  if (w < 1e-9)
+    return FALSE;
+
+  *x = (H.coeff[0][0] * u + H.coeff[0][1] * v + H.coeff[0][2]) / w;
+  *y = (H.coeff[1][0] * u + H.coeff[1][1] * v + H.coeff[1][2]) / w;
+
+  return TRUE;
+}
+
+void
+chopgimp_pgrid_plane_range (const ChopGimpPGrid *g,
+                            ChopGimpPlane        plane,
+                            gdouble             *u1,
+                            gdouble             *v1,
+                            gdouble             *u2,
+                            gdouble             *v2)
+{
+  gdouble P[3][4];
+  gdouble ul = g->extent_l * g->cell;
+  gdouble ur = g->extent_r * g->cell;
+  gdouble hh = g->height   * g->cell;
+
+  chopgimp_pgrid_camera (g, P);
+
+  /*  3 points looking down: the leading edge stops before the VP  */
+  if (P[2][1] < 0.0)
+    hh = MIN (hh, 0.9 / -P[2][1]);
+
+  switch (plane)
+    {
+    case CHOPGIMP_PLANE_LEFT:
+      *u1 = -ul; *u2 = 0.0; *v1 = -hh; *v2 = 0.0;
+      break;
+
+    case CHOPGIMP_PLANE_RIGHT:
+      *u1 = (g->type == 1) ? -ur : 0.0; *u2 = ur; *v1 = -hh; *v2 = 0.0;
+      break;
+
+    case CHOPGIMP_PLANE_FLOOR:
+      *u1 = (g->type == 1) ? -ur : 0.0; *u2 = ur; *v1 = -ul; *v2 = 0.0;
+      break;
+
+    default:
+      *u1 = *v1 = *u2 = *v2 = 0.0;
+      break;
+    }
+}
+
+void
+chopgimp_pgrid_snap (const ChopGimpPGrid *g,
+                     gdouble             *u,
+                     gdouble             *v,
+                     gdouble              tolerance)
+{
+  gdouble c = MAX (g->cell, 1e-6);
+  gdouble su = RINT (*u / c) * c;
+  gdouble sv = RINT (*v / c) * c;
+
+  if (fabs (*u - su) <= tolerance)
+    *u = su;
+  if (fabs (*v - sv) <= tolerance)
+    *v = sv;
+}
+
+gboolean
+chopgimp_pgrid_move_matrix (const ChopGimpPGrid *g,
+                            ChopGimpPlane        plane,
+                            gdouble              x0,
+                            gdouble              y0,
+                            gdouble              x1,
+                            gdouble              y1,
+                            gboolean             snap,
+                            GimpMatrix3         *M)
+{
+  GimpMatrix3 H, A;
+  gdouble     u0, v0, u1, v1;
+
+  if (! chopgimp_pgrid_to_plane (g, plane, x0, y0, &u0, &v0) ||
+      ! chopgimp_pgrid_to_plane (g, plane, x1, y1, &u1, &v1))
+    return FALSE;
+
+  if (snap)
+    chopgimp_pgrid_snap (g, &u1, &v1, g->cell * 0.2);
+
+  chopgimp_pgrid_plane_matrix (g, plane, &H);
+
+  A = H;
+  gimp_matrix3_invert (&A);
+  gimp_matrix3_translate (&A, u1 - u0, v1 - v0);   /* T · H⁻¹       */
+  gimp_matrix3_mult (&H, &A);                      /* H · T · H⁻¹   */
+
+  *M = A;
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_pgrid_place_matrix (const ChopGimpPGrid *g,
+                             ChopGimpPlane        plane,
+                             gdouble              gx,
+                             gdouble              gy,
+                             gdouble              cx,
+                             gdouble              cy,
+                             gboolean             snap,
+                             GimpMatrix3         *M)
+{
+  GimpMatrix3 H, T;
+  gdouble     u, v;
+
+  if (! chopgimp_pgrid_to_plane (g, plane, cx, cy, &u, &v))
+    return FALSE;
+
+  if (snap)
+    chopgimp_pgrid_snap (g, &u, &v, g->cell * 0.2);
+
+  chopgimp_pgrid_plane_matrix (g, plane, &H);
+
+  gimp_matrix3_identity (&T);
+  gimp_matrix3_translate (&T, u - gx, v - gy);
+  gimp_matrix3_mult (&H, &T);                      /* H · T */
+
+  *M = T;
+
+  return TRUE;
+}
+
+void
+chopgimp_pgrid_transform (ChopGimpPGrid     *g,
+                          const GimpMatrix3 *m)
+{
+  gdouble *pts[4] = { g->vl, g->vr, g->vv, g->origin };
+  gdouble  s;
+
+  for (gint i = 0; i < 4; i++)
+    gimp_matrix3_transform_point (m, pts[i][0], pts[i][1], &pts[i][0], &pts[i][1]);
+
+  s = sqrt (fabs (m->coeff[0][0] * m->coeff[1][1] - m->coeff[0][1] * m->coeff[1][0]));
+
+  if (s > 1e-6)
+    {
+      g->cell = MAX (1.0, g->cell * s);
+      for (gint i = 1; i < 4; i++)
+        g->offset[i] *= s;
+    }
+}
+
+
+/*  ─── objects on a plane ────────────────────────────────────────────── */
+
+ChopGimpPlane
+chopgimp_pgrid_item_get_plane (GimpItem *item,
+                               guint     id)
+{
+  const GimpParasite *p;
+  ChopGimpPlane       plane = CHOPGIMP_PLANE_NONE;
+  guint32             size;
+  gchar              *text;
+  gchar             **lines;
+
+  g_return_val_if_fail (GIMP_IS_ITEM (item), CHOPGIMP_PLANE_NONE);
+
+  p = gimp_item_parasite_find (item, CHOPGIMP_PGRID_ITEM_PARASITE);
+  if (! p)
+    return CHOPGIMP_PLANE_NONE;
+
+  text  = (gchar *) gimp_parasite_get_data (p, &size);  /* size set before g_strndup */
+  text  = g_strndup (text, size);
+  lines = g_strsplit (text, "\n", -1);
+
+  for (gint i = 0; lines[i]; i++)
+    {
+      guint o;
+      gint  pl;
+
+      if (id == 0 && sscanf (lines[i], "layer %d", &pl) == 1)
+        plane = CLAMP (pl, 0, 3);
+      else if (id != 0 && sscanf (lines[i], "obj %u %d", &o, &pl) == 2 && o == id)
+        plane = CLAMP (pl, 0, 3);
+    }
+
+  g_strfreev (lines);
+  g_free (text);
+
+  return plane;
+}
+
+void
+chopgimp_pgrid_item_set_plane (GimpItem      *item,
+                               guint          id,
+                               ChopGimpPlane  plane,
+                               gboolean       push_undo)
+{
+  const GimpParasite *p;
+  GString            *s = g_string_new (NULL);
+
+  g_return_if_fail (GIMP_IS_ITEM (item));
+
+  if (chopgimp_pgrid_item_get_plane (item, id) == plane)
+    {
+      g_string_free (s, TRUE);
+      return;
+    }
+
+  p = gimp_item_parasite_find (item, CHOPGIMP_PGRID_ITEM_PARASITE);
+
+  if (p)
+    {
+      guint32  size;
+      const gchar *data  = gimp_parasite_get_data (p, &size);  /* size set first */
+      gchar       *text  = g_strndup (data, size);
+      gchar  **lines = g_strsplit (text, "\n", -1);
+
+      for (gint i = 0; lines[i]; i++)
+        {
+          guint o;
+          gint  pl;
+
+          if (! *lines[i])
+            continue;
+          if (id == 0 && g_str_has_prefix (lines[i], "layer "))
+            continue;
+          if (id != 0 && sscanf (lines[i], "obj %u %d", &o, &pl) == 2 && o == id)
+            continue;
+
+          g_string_append_printf (s, "%s\n", lines[i]);
+        }
+
+      g_strfreev (lines);
+      g_free (text);
+    }
+
+  if (plane != CHOPGIMP_PLANE_NONE)
+    {
+      if (id == 0)
+        g_string_append_printf (s, "layer %d\n", plane);
+      else
+        g_string_append_printf (s, "obj %u %d\n", id, plane);
+    }
+
+  if (s->len)
+    {
+      GimpParasite *np = gimp_parasite_new (CHOPGIMP_PGRID_ITEM_PARASITE,
+                                            GIMP_PARASITE_PERSISTENT | GIMP_PARASITE_UNDOABLE,
+                                            s->len + 1, s->str);
+
+      gimp_item_parasite_attach (item, np, push_undo);
+      gimp_parasite_free (np);
+    }
+  else if (p)
+    {
+      gimp_item_parasite_detach (item, CHOPGIMP_PGRID_ITEM_PARASITE, push_undo);
+    }
+
+  g_string_free (s, TRUE);
+}
+
+
+/*  ─── 3.31.0 (4b): source of a pixel layer in perspective ─────────────
+ *
+ *  A pixel layer moved on a plane several times is resampled from its
+ *  original each time, not from the previous result: the original pixels
+ *  and the matrix accumulated since are kept in the persistent, undoable
+ *  parasite « chopgimp-persp-source »:
+ *
+ *    "1|W|H|OX|OY|ENCODING|m00 m01 … m22|SHA1\n" + zlib(raw pixels)
+ *
+ *  SHA1 is the checksum of the layer's pixels after the last move: when
+ *  they were changed since (painting, filters…), the current pixels are
+ *  the new original.
+ */
+#define PSOURCE_PARASITE "chopgimp-persp-source"
+
+/*  rows of the buffer, in order, through @func  */
+static void
+psource_rows (GeglBuffer *buffer,
+              const Babl *format,
+              void      (*func) (const guchar *data, gsize len, gpointer user),
+              gpointer    user)
+{
+  const GeglRectangle *e    = gegl_buffer_get_extent (buffer);
+  gint                 bpp  = babl_format_get_bytes_per_pixel (format);
+  gint                 step = 64;
+  guchar              *rows = g_malloc ((gsize) e->width * bpp * step);
+
+  for (gint y = 0; y < e->height; y += step)
+    {
+      GeglRectangle r = { e->x, e->y + y, e->width, MIN (step, e->height - y) };
+
+      gegl_buffer_get (buffer, &r, 1.0, format, rows, GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+      func (rows, (gsize) r.width * r.height * bpp, user);
+    }
+
+  g_free (rows);
+}
+
+static void
+psource_sum_rows (const guchar *data, gsize len, gpointer user)
+{
+  g_checksum_update (user, data, len);
+}
+
+static void
+psource_zip_rows (const guchar *data, gsize len, gpointer user)
+{
+  g_output_stream_write_all (user, data, len, NULL, NULL, NULL);
+}
+
+static gchar *
+psource_checksum (GimpDrawable *drawable)
+{
+  GChecksum *cs = g_checksum_new (G_CHECKSUM_SHA1);
+  gchar     *sum;
+
+  psource_rows (gimp_drawable_get_buffer (drawable), gimp_drawable_get_format (drawable),
+                psource_sum_rows, cs);
+  sum = g_strdup (g_checksum_get_string (cs));
+  g_checksum_free (cs);
+
+  return sum;
+}
+
+static void
+psource_store (GimpItem          *item,
+               const gchar       *header_without_sum,
+               GBytes            *zipped)
+{
+  gchar        *sum    = psource_checksum (GIMP_DRAWABLE (item));
+  gchar        *header = g_strdup_printf ("%s|%s\n", header_without_sum, sum);
+  gsize         hl     = strlen (header);
+  gsize         zl     = 0;
+  const guchar *zd     = g_bytes_get_data (zipped, &zl);
+  guchar       *data   = g_malloc (hl + zl);
+  GimpParasite *p;
+
+  memcpy (data, header, hl);
+  memcpy (data + hl, zd, zl);
+  p = gimp_parasite_new (PSOURCE_PARASITE,
+                         GIMP_PARASITE_PERSISTENT | GIMP_PARASITE_UNDOABLE,
+                         hl + zl, data);
+  gimp_item_parasite_attach (item, p, TRUE);
+
+  gimp_parasite_free (p);
+  g_free (data);
+  g_free (header);
+  g_free (sum);
+}
+
+static gchar *
+psource_matrix_string (const GimpMatrix3 *m)
+{
+  GString *s = g_string_new (NULL);
+
+  for (gint i = 0; i < 9; i++)
+    {
+      gchar b[G_ASCII_DTOSTR_BUF_SIZE];
+
+      g_string_append (s, g_ascii_dtostr (b, sizeof (b), m->coeff[i / 3][i % 3]));
+      if (i < 8)
+        g_string_append_c (s, ' ');
+    }
+
+  return g_string_free (s, FALSE);
+}
+
+/*  the kept source of @item when its pixels are still the last result:
+ *  its buffer (at its offsets), the matrix since then and the rest of the
+ *  parasite (zipped pixels); FALSE otherwise
+ */
+static gboolean
+psource_get (GimpItem     *item,
+             GeglBuffer  **source,
+             GimpMatrix3  *matrix,
+             GBytes      **zipped)
+{
+  const GimpParasite *p = gimp_item_parasite_find (item, PSOURCE_PARASITE);
+  const gchar        *data;
+  const gchar        *nl;
+  guint32             size = 0;
+  gchar              *head;
+  gchar             **f;
+  gboolean            ok = FALSE;
+
+  if (! p)
+    return FALSE;
+
+  data = gimp_parasite_get_data (p, &size);
+  nl   = data ? memchr (data, '\n', size) : NULL;
+  if (! nl)
+    return FALSE;
+
+  head = g_strndup (data, nl - data);
+  f    = g_strsplit (head, "|", -1);
+
+  if (g_strv_length (f) == 8 && ! strcmp (f[0], "1"))
+    {
+      gchar *sum = psource_checksum (GIMP_DRAWABLE (item));
+      gint   w   = atoi (f[1]), h = atoi (f[2]), ox = atoi (f[3]), oy = atoi (f[4]);
+      gchar **m  = g_strsplit (f[6], " ", -1);
+
+      if (! strcmp (sum, f[7]) && g_strv_length (m) == 9 && w > 0 && h > 0)
+        {
+          const Babl    *format = babl_format_with_space (f[5],
+                                                          gimp_drawable_get_space (GIMP_DRAWABLE (item)));
+          gsize          bpp    = babl_format_get_bytes_per_pixel (format);
+          gsize          len    = (gsize) w * h * bpp;
+          GInputStream  *mem    = g_memory_input_stream_new_from_data (nl + 1, size - (nl + 1 - data), NULL);
+          GConverter    *unzip  = G_CONVERTER (g_zlib_decompressor_new (G_ZLIB_COMPRESSOR_FORMAT_ZLIB));
+          GInputStream  *in     = g_converter_input_stream_new (mem, unzip);
+          guchar        *pixels = g_try_malloc (len);
+          gsize          got    = 0;
+
+          if (pixels &&
+              g_input_stream_read_all (in, pixels, len, &got, NULL, NULL) && got == len)
+            {
+              GeglRectangle r = { ox, oy, w, h };
+
+              *source = gegl_buffer_new (&r, format);
+              gegl_buffer_set (*source, &r, 0, format, pixels, GEGL_AUTO_ROWSTRIDE);
+
+              for (gint i = 0; i < 9; i++)
+                matrix->coeff[i / 3][i % 3] = g_ascii_strtod (m[i], NULL);
+
+              *zipped = g_bytes_new (nl + 1, size - (nl + 1 - data));
+              ok = TRUE;
+            }
+
+          g_free (pixels);
+          g_object_unref (in);
+          g_object_unref (unzip);
+          g_object_unref (mem);
+        }
+
+      g_strfreev (m);
+      g_free (sum);
+    }
+
+  g_strfreev (f);
+  g_free (head);
+
+  return ok;
+}
+
+/*  @item's current pixels, zipped (its new source)  */
+static GBytes *
+psource_zip (GimpItem *item)
+{
+  GOutputStream *mem = g_memory_output_stream_new_resizable ();
+  GConverter    *zip = G_CONVERTER (g_zlib_compressor_new (G_ZLIB_COMPRESSOR_FORMAT_ZLIB, 1));
+  GOutputStream *out = g_converter_output_stream_new (mem, zip);
+  GBytes        *bytes;
+
+  psource_rows (gimp_drawable_get_buffer (GIMP_DRAWABLE (item)),
+                gimp_drawable_get_format (GIMP_DRAWABLE (item)),
+                psource_zip_rows, out);
+  g_output_stream_close (out, NULL, NULL);
+  bytes = g_memory_output_stream_steal_as_bytes (G_MEMORY_OUTPUT_STREAM (mem));
+
+  g_object_unref (out);
+  g_object_unref (zip);
+  g_object_unref (mem);
+
+  return bytes;
+}
+
+/*  transforms the pixel layer @item by @matrix from its kept source  */
+void
+chopgimp_pgrid_transform_from_source (GimpItem              *item,
+                                      GimpContext           *context,
+                                      const GimpMatrix3     *matrix,
+                                      GimpInterpolationType  interpolation)
+{
+  GeglBuffer  *source = NULL;
+  GimpMatrix3  total;
+  GBytes      *zipped = NULL;
+  gint         sw, sh, sx, sy;
+  gchar       *ms, *head;
+
+  if (psource_get (item, &source, &total, &zipped))
+    {
+      const GeglRectangle *e = gegl_buffer_get_extent (source);
+
+      sx = e->x; sy = e->y; sw = e->width; sh = e->height;
+
+      /*  back to the original, then one resampling  */
+      gimp_drawable_set_buffer_full (GIMP_DRAWABLE (item), TRUE,
+                                     _("Sélection de perspective"), source, e, FALSE);
+      g_object_unref (source);
+    }
+  else
+    {
+      gimp_item_get_offset (item, &sx, &sy);
+      sw = gimp_item_get_width (item);
+      sh = gimp_item_get_height (item);
+      gimp_matrix3_identity (&total);
+      zipped = psource_zip (item);
+    }
+
+  gimp_matrix3_mult (matrix, &total);     /*  total = matrix × total  */
+
+  gimp_item_transform (item, context, &total, GIMP_TRANSFORM_FORWARD,
+                       interpolation, GIMP_TRANSFORM_RESIZE_ADJUST, NULL);
+
+  ms   = psource_matrix_string (&total);
+  head = g_strdup_printf ("1|%d|%d|%d|%d|%s|%s", sw, sh, sx, sy,
+                          babl_format_get_encoding (gimp_drawable_get_format (GIMP_DRAWABLE (item))),
+                          ms);
+  psource_store (item, head, zipped);
+
+  g_free (head);
+  g_free (ms);
+  g_bytes_unref (zipped);
+}
+
+/*  a plain move of a pixel layer: the kept source follows  */
+void
+chopgimp_pgrid_source_translate (GimpItem *item,
+                                 gdouble   dx,
+                                 gdouble   dy)
+{
+  GeglBuffer  *source = NULL;
+  GimpMatrix3  total;
+  GBytes      *zipped = NULL;
+
+  if (psource_get (item, &source, &total, &zipped))
+    {
+      const GeglRectangle *e = gegl_buffer_get_extent (source);
+      gchar               *ms;
+      gchar               *head;
+
+      gimp_matrix3_translate (&total, dx, dy);
+      ms   = psource_matrix_string (&total);
+      head = g_strdup_printf ("1|%d|%d|%d|%d|%s|%s", e->width, e->height, e->x, e->y,
+                              babl_format_get_encoding (gegl_buffer_get_format (source)), ms);
+      psource_store (item, head, zipped);
+
+      g_free (head);
+      g_free (ms);
+      g_object_unref (source);
+      g_bytes_unref (zipped);
+    }
+}
diff --git a/app/core/chopgimp-pgrid.h b/app/core/chopgimp-pgrid.h
new file mode 100644
index 0000000..5436e93
--- /dev/null
+++ b/app/core/chopgimp-pgrid.h
@@ -0,0 +1,201 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-pgrid.h — ChopGimp 3.31.0 (lot 4a): Illustrator's perspective
+ * grid (1, 2 or 3 vanishing points)
+ *
+ * The grid is a projective camera made of its vanishing points and its
+ * origin (the « ground level » point of the leading edge):
+ *
+ *     world X → right vanishing point   (1 point: horizontal, no VP)
+ *     world Z → left vanishing point    (1 point: the central VP)
+ *     world Y → up                      (3 points: the vertical VP)
+ *
+ *     P = [ sX·VR | sY·VV | sZ·VL | O ]  (homogeneous columns), each s
+ *     making one unit one pixel at the origin.
+ *
+ * Its three planes have flat coordinates (u, v) oriented like the image
+ * (u to the right, v down), in « units » (pixels at the origin):
+ *
+ *     LEFT  (X = offset): u = -Z, v = -Y
+ *     RIGHT (Z = offset): u =  X, v = -Y   (1 point: the front plane)
+ *     FLOOR (Y = offset): u =  X, v = -Z
+ *
+ * chopgimp_pgrid_plane_matrix() is the homography flat → image of a
+ * plane: the perspective tools draw and move in flat coordinates and map
+ * the result through it. The grid is saved in the XCF as the image
+ * parasite « chopgimp-perspective-grid » (key=value text); objects placed
+ * on a plane remember it in the item parasite « chopgimp-persp-plane »
+ * (« layer <plane> » and « obj <id> <plane> » lines).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#define CHOPGIMP_PGRID_PARASITE       "chopgimp-perspective-grid"
+#define CHOPGIMP_PGRID_ITEM_PARASITE  "chopgimp-persp-plane"
+
+
+typedef enum
+{
+  CHOPGIMP_PLANE_NONE  = 0,
+  CHOPGIMP_PLANE_LEFT  = 1,
+  CHOPGIMP_PLANE_RIGHT = 2,
+  CHOPGIMP_PLANE_FLOOR = 3
+} ChopGimpPlane;
+
+typedef struct
+{
+  gint     type;          /* 1, 2 or 3 vanishing points                  */
+  gboolean visible;
+  gboolean snap;          /* objects snap to the grid lines             */
+  gboolean locked;        /* the widgets do not move                    */
+  gboolean lock_station;  /* moving one VP moves the other (2 points)   */
+  gint     active_plane;  /* ChopGimpPlane                              */
+
+  gdouble  vl[2];         /* left VP (1 point: the central VP)          */
+  gdouble  vr[2];         /* right VP (2, 3 points)                     */
+  gdouble  vv[2];         /* vertical VP (3 points)                     */
+  gdouble  origin[2];     /* ground level on the leading edge           */
+
+  gdouble  cell;          /* size of a cell, units                      */
+  gint     extent_l;      /* cells along the left plane                 */
+  gint     extent_r;      /* cells along the right plane                */
+  gint     height;        /* cells up the leading edge                  */
+  gdouble  offset[4];     /* plane offsets, units (index: ChopGimpPlane) */
+
+  gdouble  opacity;       /* 0..1                                       */
+  guint32  color[4];      /* 0xRRGGBB per plane (index: ChopGimpPlane)  */
+} ChopGimpPGrid;
+
+
+/*  ─── the grid ──────────────────────────────────────────────────────── */
+
+/*  Illustrator's default grid of @type points for an image of @width ×
+ *  @height (hidden)
+ */
+void       chopgimp_pgrid_init          (ChopGimpPGrid       *grid,
+                                         gint                 type,
+                                         gint                 width,
+                                         gint                 height);
+/*  another number of points, keeping the origin, the horizon and the
+ *  sizes
+ */
+void       chopgimp_pgrid_set_type      (ChopGimpPGrid       *grid,
+                                         gint                 type,
+                                         gint                 width,
+                                         gint                 height);
+gchar    * chopgimp_pgrid_to_string     (const ChopGimpPGrid *grid);
+gboolean   chopgimp_pgrid_from_string   (ChopGimpPGrid       *grid,
+                                         const gchar         *text);
+
+/*  FALSE when the image has no grid (@grid: the default one, hidden)  */
+gboolean   chopgimp_pgrid_get           (GimpImage           *image,
+                                         ChopGimpPGrid       *grid);
+/*  @undo_desc NULL: no undo step; @compress: none either when the last
+ *  undo step is already a change of the grid
+ */
+void       chopgimp_pgrid_set           (GimpImage           *image,
+                                         const ChopGimpPGrid *grid,
+                                         const gchar         *undo_desc,
+                                         gboolean             compress);
+/*  the active plane of the visible grid; NONE when hidden or none  */
+ChopGimpPlane chopgimp_pgrid_get_active_plane (GimpImage     *image);
+void       chopgimp_pgrid_set_active_plane    (GimpImage     *image,
+                                               ChopGimpPlane  plane);
+const gchar * chopgimp_pgrid_plane_name (ChopGimpPlane        plane);
+
+
+/*  ─── geometry ──────────────────────────────────────────────────────── */
+
+/*  the 3 × 4 camera (rows of 4: x, y, w)  */
+void       chopgimp_pgrid_camera        (const ChopGimpPGrid *grid,
+                                         gdouble              P[3][4]);
+/*  world point → image; FALSE behind the horizon  */
+gboolean   chopgimp_pgrid_project       (const ChopGimpPGrid *grid,
+                                         gdouble              X,
+                                         gdouble              Y,
+                                         gdouble              Z,
+                                         gdouble             *x,
+                                         gdouble             *y);
+/*  flat → image homography of @plane (offset included)  */
+void       chopgimp_pgrid_plane_matrix  (const ChopGimpPGrid *grid,
+                                         ChopGimpPlane        plane,
+                                         GimpMatrix3         *H);
+/*  image → flat; FALSE beyond the horizon of the plane  */
+gboolean   chopgimp_pgrid_to_plane      (const ChopGimpPGrid *grid,
+                                         ChopGimpPlane        plane,
+                                         gdouble              x,
+                                         gdouble              y,
+                                         gdouble             *u,
+                                         gdouble             *v);
+gboolean   chopgimp_pgrid_from_plane    (const ChopGimpPGrid *grid,
+                                         ChopGimpPlane        plane,
+                                         gdouble              u,
+                                         gdouble              v,
+                                         gdouble             *x,
+                                         gdouble             *y);
+/*  the range of the grid drawn on @plane (flat coordinates)  */
+void       chopgimp_pgrid_plane_range   (const ChopGimpPGrid *grid,
+                                         ChopGimpPlane        plane,
+                                         gdouble             *u1,
+                                         gdouble             *v1,
+                                         gdouble             *u2,
+                                         gdouble             *v2);
+/*  flat point snapped to the grid lines when within @tolerance units  */
+void       chopgimp_pgrid_snap          (const ChopGimpPGrid *grid,
+                                         gdouble             *u,
+                                         gdouble             *v,
+                                         gdouble              tolerance);
+/*  image point moved on @plane: H · T(du, dv) · H⁻¹ for the flat move
+ *  of (x0, y0) → (x1, y1); FALSE beyond the horizon
+ */
+gboolean   chopgimp_pgrid_move_matrix   (const ChopGimpPGrid *grid,
+                                         ChopGimpPlane        plane,
+                                         gdouble              x0,
+                                         gdouble              y0,
+                                         gdouble              x1,
+                                         gdouble              y1,
+                                         gboolean             snap,
+                                         GimpMatrix3         *M);
+/*  an object not in perspective put on @plane: its point (gx, gy) at the
+ *  image point (cx, cy) of the plane, one pixel = one unit: H · T;
+ *  FALSE beyond the horizon
+ */
+gboolean   chopgimp_pgrid_place_matrix  (const ChopGimpPGrid *grid,
+                                         ChopGimpPlane        plane,
+                                         gdouble              gx,
+                                         gdouble              gy,
+                                         gdouble              cx,
+                                         gdouble              cy,
+                                         gboolean             snap,
+                                         GimpMatrix3         *M);
+/*  the grid follows an affine change of the image coordinates  */
+void       chopgimp_pgrid_transform     (ChopGimpPGrid       *grid,
+                                         const GimpMatrix3   *matrix);
+
+
+/*  ─── objects on a plane ────────────────────────────────────────────── */
+
+/*  @id 0: the item itself, else a vector object of the (vector) layer  */
+ChopGimpPlane chopgimp_pgrid_item_get_plane (GimpItem        *item,
+                                             guint            id);
+void       chopgimp_pgrid_item_set_plane    (GimpItem        *item,
+                                             guint            id,
+                                             ChopGimpPlane    plane,
+                                             gboolean         push_undo);
+
+/*  3.31.0 (4b): a pixel layer moved on a plane several times is resampled
+ *  from its original (kept in the « chopgimp-persp-source » parasite with
+ *  the matrix since then), not from the previous result. For plain pixel
+ *  layers only (not text, vector or group layers): the callers check.
+ */
+void       chopgimp_pgrid_transform_from_source (GimpItem              *item,
+                                                 GimpContext           *context,
+                                                 const GimpMatrix3     *matrix,
+                                                 GimpInterpolationType  interpolation);
+void       chopgimp_pgrid_source_translate      (GimpItem              *item,
+                                                 gdouble                dx,
+                                                 gdouble                dy);
