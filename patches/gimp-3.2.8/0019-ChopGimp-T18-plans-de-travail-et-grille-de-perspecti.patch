+gimp_perspective_grid_tool_register (GimpToolRegisterCallback  callback,
+                                     gpointer                  data)
+{
+  (* callback) (gimp_pgrid_tool_get_type (),
+                GIMP_TYPE_PGRID_OPTIONS,
+                pgrid_options_gui,
+                0,
+                "gimp-perspective-grid-tool",
+                _("Grille de perspective"),
+                _("Grille de perspective : afficher et régler la grille à 1, 2 ou 3 "
+                  "points de fuite (Illustrator)"),
+                N_("_Grille de perspective"), NULL,
+                NULL, GIMP_HELP_TOOL_PERSPECTIVE,
+                "chopgimp-tool-perspective-grid",
+                data);
+}
+
+void
+gimp_perspective_select_tool_register (GimpToolRegisterCallback  callback,
+                                       gpointer                  data)
+{
