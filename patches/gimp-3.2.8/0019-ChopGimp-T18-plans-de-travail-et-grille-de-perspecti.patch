@@ -0,0 +1,1378 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-artboardtool.c — ChopGimp 3.31.0 (lot 4a): the « Plan de
+ * travail » tool (Illustrator's Artboard tool, Maj+O)
+ *
+ *  - drag on an empty place: a new artboard;
+ *  - drag inside an artboard: moves it (Alt: a copy), with the content
+ *    that lies inside it (« Déplacer l'illustration avec le plan »:
+ *    the layers inside its rectangle, the vector objects inside it);
+ *  - drag a handle: resizes it (Maj: keeps the proportions);
+ *  - double-click: renames it; Suppr: deletes it; arrows: nudge (Maj ×10);
+ *  - the options edit the active artboard (format, name, position, size)
+ *    and hold the buttons New / Duplicate / Delete / Export.
+ *
+ * The canvas grows to hold the artboards (option, as Illustrator's
+ * pasteboard): the content and the guides follow.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+#include <gdk/gdkkeysyms.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpconfig/gimpconfig.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "tools-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpcontext.h"
+#include "core/gimpimage.h"
+#include "core/gimpimage-undo.h"
+#include "core/gimpitem.h"
+#include "core/gimplayer.h"
+#include "core/gimptoolinfo.h"
+#include "core/gimptooloptions.h"
+#include "core/gimpviewable.h"
+#include "core/chopgimp-artboards.h"
+
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-vobject.h"
+
+#include "widgets/gimpaction.h"
+#include "widgets/gimphelp-ids.h"
+#include "widgets/gimpwidgets-utils.h"
+
+#include "display/gimpcanvasitem.h"
+#include "display/gimpdisplay.h"
+#include "display/gimpdisplayshell.h"
+#include "display/chopgimp-canvasartboards.h"
+
+#include "gimpdrawtool.h"
+#include "gimptoolcontrol.h"
+#include "gimptooloptions-gui.h"
+#include "chopgimp-tools.h"
+#include "chopgimp-artboardtool.h"
+
+#include "gimp-intl.h"
+
+
+#define HANDLE_SIZE 10
+
+
+/*  ─── options ───────────────────────────────────────────────────────── */
+
+enum
+{
+  PROP_0,
+  PROP_MOVE_ARTWORK,
+  PROP_FIT_CANVAS
+};
+
+typedef struct
+{
+  GimpToolOptions parent_instance;
+
+  gboolean        move_artwork;
+  gboolean        fit_canvas;
+} GimpArtboardOptions;
+
+typedef GimpToolOptionsClass GimpArtboardOptionsClass;
+
+static GType gimp_artboard_options_get_type (void) G_GNUC_CONST;
+
+G_DEFINE_TYPE (GimpArtboardOptions, gimp_artboard_options, GIMP_TYPE_TOOL_OPTIONS)
+
+#define GIMP_TYPE_ARTBOARD_OPTIONS (gimp_artboard_options_get_type ())
+#define ARTBOARD_OPTIONS(tool)     ((GimpArtboardOptions *) gimp_tool_get_options (GIMP_TOOL (tool)))
+
+static void
+gimp_artboard_options_set_property (GObject      *object,
+                                    guint         property_id,
+                                    const GValue *value,
+                                    GParamSpec   *pspec)
+{
+  GimpArtboardOptions *o = (GimpArtboardOptions *) object;
+
+  switch (property_id)
+    {
+    case PROP_MOVE_ARTWORK: o->move_artwork = g_value_get_boolean (value); break;
+    case PROP_FIT_CANVAS:   o->fit_canvas   = g_value_get_boolean (value); break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_artboard_options_get_property (GObject    *object,
+                                    guint       property_id,
+                                    GValue     *value,
+                                    GParamSpec *pspec)
+{
+  GimpArtboardOptions *o = (GimpArtboardOptions *) object;
+
+  switch (property_id)
+    {
+    case PROP_MOVE_ARTWORK: g_value_set_boolean (value, o->move_artwork); break;
+    case PROP_FIT_CANVAS:   g_value_set_boolean (value, o->fit_canvas);   break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_artboard_options_class_init (GimpArtboardOptionsClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->set_property = gimp_artboard_options_set_property;
+  object_class->get_property = gimp_artboard_options_get_property;
+
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, PROP_MOVE_ARTWORK,
+                            "artboard-move-artwork",
+                            "Déplacer/copier l'illustration avec le plan",
+                            "Les calques et objets vectoriels contenus dans le plan "
+                            "le suivent quand il est déplacé ou dupliqué (Alt)",
+                            TRUE,
+                            GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, PROP_FIT_CANVAS,
+                            "artboard-fit-canvas",
+                            "Agrandir le canevas pour contenir les plans",
+                            "Le canevas de l'image s'agrandit quand un plan de travail "
+                            "en sort (le contenu et les repères suivent)",
+                            TRUE,
+                            GIMP_PARAM_STATIC_STRINGS);
+}
+
+static void
+gimp_artboard_options_init (GimpArtboardOptions *options)
+{
+}
+
+
+/*  ─── options GUI: the active artboard ──────────────────────────────── */
+
+typedef struct
+{
+  const gchar *name;
+  gdouble      w, h;
+  gboolean     mm;
+} Preset;
+
+static const Preset presets[] =
+{
+  { N_("Personnalisé"),               0,      0,      FALSE },
+  { N_("A3 (297 × 420 mm)"),          297,    420,    TRUE  },
+  { N_("A4 (210 × 297 mm)"),          210,    297,    TRUE  },
+  { N_("A5 (148 × 210 mm)"),          148,    210,    TRUE  },
+  { N_("Lettre US (8,5 × 11 po)"),    215.9,  279.4,  TRUE  },
+  { N_("Tabloïd (11 × 17 po)"),       279.4,  431.8,  TRUE  },
+  { N_("Carte de visite (85 × 55 mm)"), 85,   55,     TRUE  },
+  { N_("HD 1080p (1920 × 1080)"),     1920,   1080,   FALSE },
+  { N_("HD 720p (1280 × 720)"),       1280,   720,    FALSE },
+  { N_("4K UHD (3840 × 2160)"),       3840,   2160,   FALSE },
+  { N_("Publication carrée (1080 × 1080)"), 1080, 1080, FALSE },
+  { N_("Story (1080 × 1920)"),        1080,   1920,   FALSE },
+  { N_("Bannière web (1200 × 628)"),  1200,   628,    FALSE },
+  { N_("Smartphone (1179 × 2556)"),   1179,   2556,   FALSE },
+  { N_("Icône (1024 × 1024)"),        1024,   1024,   FALSE },
+};
+
+typedef struct
+{
+  Gimp        *gimp;
+  GimpContext *context;
+  GimpImage   *image;     /* weak */
+  GtkWidget   *box;
+  GtkWidget   *preset;
+  GtkWidget   *name;
+  GtkWidget   *x, *y, *w, *h;
+  GtkWidget   *count;
+  gboolean     syncing;
+} Gui;
+
+static void gui_sync (Gui *g);
+
+static gint
+gui_active (Gui *g)
+{
+  return g->image ? chopgimp_artboards_get_active (g->image) : -1;
+}
+
+static void
+preset_size (GimpImage *image,
+             gint       index,
+             gint      *w,
+             gint      *h)
+{
+  const Preset *p = &presets[index];
+  gdouble       xres = 72.0, yres = 72.0;
+
+  if (p->mm)
+    {
+      gimp_image_get_resolution (image, &xres, &yres);
+      *w = (gint) RINT (p->w / 25.4 * xres);
+      *h = (gint) RINT (p->h / 25.4 * yres);
+    }
+  else
+    {
+      *w = (gint) p->w;
+      *h = (gint) p->h;
+    }
+}
+
+static void
+fit_and_flush (GimpImage *image,
+               Gimp      *gimp)
+{
+  GimpToolInfo *info = gimp_get_tool_info (gimp, "gimp-artboard-tool");
+
+  if (info && info->tool_options &&
+      ((GimpArtboardOptions *) info->tool_options)->fit_canvas)
+    chopgimp_artboards_fit_canvas (image, gimp_get_user_context (gimp));
+
+  gimp_image_flush (image);
+}
+
+static void
+gui_set_rect (Gui *g)
+{
+  gint i = gui_active (g);
+
+  if (g->syncing || i < 0)
+    return;
+
+  gimp_image_undo_group_start (g->image, GIMP_UNDO_GROUP_MISC, _("Plan de travail"));
+  chopgimp_artboards_set_rect (g->image, i,
+                               gtk_spin_button_get_value_as_int (GTK_SPIN_BUTTON (g->x)),
+                               gtk_spin_button_get_value_as_int (GTK_SPIN_BUTTON (g->y)),
+                               gtk_spin_button_get_value_as_int (GTK_SPIN_BUTTON (g->w)),
+                               gtk_spin_button_get_value_as_int (GTK_SPIN_BUTTON (g->h)),
+                               FALSE);
+  gimp_image_undo_group_end (g->image);
+  fit_and_flush (g->image, g->gimp);
+}
+
+static void
+gui_preset_changed (GtkComboBox *combo,
+                    Gui         *g)
+{
+  gint             p = gtk_combo_box_get_active (combo);
+  gint             i = gui_active (g);
+  ChopGimpArtboard b;
+
+  if (g->syncing || p <= 0 || i < 0 || ! chopgimp_artboards_get_nth (g->image, i, &b))
+    return;
+
+  preset_size (g->image, p, &b.width, &b.height);
+
+  gimp_image_undo_group_start (g->image, GIMP_UNDO_GROUP_MISC, _("Plan de travail : format"));
+  chopgimp_artboards_set_rect (g->image, i, b.x, b.y, b.width, b.height, FALSE);
+  gimp_image_undo_group_end (g->image);
+  g_free (b.name);
+
+  fit_and_flush (g->image, g->gimp);
+}
+
+static void
+gui_orientation (GtkWidget *button,
+                 Gui       *g)
+{
+  gint             i = gui_active (g);
+  ChopGimpArtboard b;
+
+  if (i < 0 || ! chopgimp_artboards_get_nth (g->image, i, &b))
+    return;
+
+  gimp_image_undo_group_start (g->image, GIMP_UNDO_GROUP_MISC, _("Plan de travail : orientation"));
+  chopgimp_artboards_set_rect (g->image, i, b.x, b.y, b.height, b.width, FALSE);
+  gimp_image_undo_group_end (g->image);
+  g_free (b.name);
+
+  fit_and_flush (g->image, g->gimp);
+}
+
+static void
+gui_name_activate (GtkEntry *entry,
+                   Gui      *g)
+{
+  gint i = gui_active (g);
+
+  if (! g->syncing && i >= 0)
+    {
+      chopgimp_artboards_rename (g->image, i, gtk_entry_get_text (entry));
+      gimp_image_flush (g->image);
+    }
+}
+
+static gboolean
+gui_name_focus_out (GtkWidget *entry,
+                    GdkEvent  *event,
+                    Gui       *g)
+{
+  gui_name_activate (GTK_ENTRY (entry), g);
+
+  return FALSE;
+}
+
+/*  « Nouveau »: the size of the active artboard (else the canvas), to the
+ *  right of the others
+ */
+static void
+gui_new (GtkWidget *button,
+         Gui       *g)
+{
+  GArray *a;
+  gint    x = 0, y = 0, w, h, right = 0, active;
+
+  if (! g->image)
+    return;
+
+  a = chopgimp_artboards_get (g->image, &active);
+  w = gimp_image_get_width  (g->image);
+  h = gimp_image_get_height (g->image);
+
+  for (guint i = 0; i < a->len; i++)
+    {
+      ChopGimpArtboard *b = &g_array_index (a, ChopGimpArtboard, i);
+
+      right = MAX (right, b->x + b->width);
+      if ((gint) i == active)
+        {
+          w = b->width;
+          h = b->height;
+          y = b->y;
+        }
+    }
+
+  if (a->len)
+    x = right + MAX (20, w / 10);
+
+  chopgimp_artboards_free (a);
+
+  gimp_image_undo_group_start (g->image, GIMP_UNDO_GROUP_MISC, _("Nouveau plan de travail"));
+  chopgimp_artboards_add (g->image, x, y, w, h, NULL);
+  gimp_image_undo_group_end (g->image);
+  fit_and_flush (g->image, g->gimp);
+}
+
+static void
+gui_duplicate (GtkWidget *button,
+               Gui       *g)
+{
+  gint i = gui_active (g);
+
+  if (i < 0)
+    return;
+
+  gimp_image_undo_group_start (g->image, GIMP_UNDO_GROUP_MISC, _("Dupliquer le plan de travail"));
+  chopgimp_artboards_duplicate (g->image, i, FALSE, 0, 0);
+  gimp_image_undo_group_end (g->image);
+  fit_and_flush (g->image, g->gimp);
+}
+
+static void
+gui_delete (GtkWidget *button,
+            Gui       *g)
+{
+  gint i = gui_active (g);
+
+  if (i >= 0)
+    {
+      chopgimp_artboards_remove (g->image, i);
+      gimp_image_flush (g->image);
+    }
+}
+
+static void
+gui_activate_action (Gui         *g,
+                     const gchar *name)
+{
+  GAction *action = g_action_map_lookup_action (G_ACTION_MAP (g->gimp->app), name);
+
+  if (GIMP_IS_ACTION (action))
+    gimp_action_activate (GIMP_ACTION (action));
+}
+
+static void
+gui_export (GtkWidget *button,
+            Gui       *g)
+{
+  gui_activate_action (g, "file-export-artboards");
+}
+
+static void
+gui_panel (GtkWidget *button,
+           Gui       *g)
+{
+  gui_activate_action (g, "dialogs-artboards");
+}
+
+static void
+gui_parasite (GimpImage   *image,
+              const gchar *name,
+              Gui         *g)
+{
+  if (! g_strcmp0 (name, CHOPGIMP_ARTBOARDS_PARASITE))
+    gui_sync (g);
+}
+
+static void
+gui_set_image (Gui       *g,
+               GimpImage *image)
+{
+  if (g->image == image)
+    return;
+
+  if (g->image)
+    {
+      g_signal_handlers_disconnect_by_data (g->image, g);
+      g_object_remove_weak_pointer (G_OBJECT (g->image), (gpointer *) &g->image);
+    }
+
+  g->image = image;
+
+  if (image)
+    {
+      g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &g->image);
+      g_signal_connect (image, "parasite-attached", G_CALLBACK (gui_parasite), g);
+      g_signal_connect (image, "parasite-detached", G_CALLBACK (gui_parasite), g);
+    }
+
+  gui_sync (g);
+}
+
+static void
+gui_image_changed (GimpContext *context,
+                   GimpImage   *image,
+                   Gui         *g)
+{
+  gui_set_image (g, image);
+}
+
+static void
+gui_sync (Gui *g)
+{
+  ChopGimpArtboard b;
+  gint             i = gui_active (g);
+  gboolean         have;
+  gint             n = g->image ? chopgimp_artboards_count (g->image) : 0;
+  gchar           *count;
+
+  g->syncing = TRUE;
+
+  have = i >= 0 && chopgimp_artboards_get_nth (g->image, i, &b);
+
+  gtk_widget_set_sensitive (g->name,   have);
+  gtk_widget_set_sensitive (g->x,      have);
+  gtk_widget_set_sensitive (g->y,      have);
+  gtk_widget_set_sensitive (g->w,      have);
+  gtk_widget_set_sensitive (g->h,      have);
+  gtk_widget_set_sensitive (g->preset, have);
+
+  if (have)
+    {
+      gint p = 0;
+
+      gtk_entry_set_text (GTK_ENTRY (g->name), b.name);
+      gtk_spin_button_set_value (GTK_SPIN_BUTTON (g->x), b.x);
+      gtk_spin_button_set_value (GTK_SPIN_BUTTON (g->y), b.y);
+      gtk_spin_button_set_value (GTK_SPIN_BUTTON (g->w), b.width);
+      gtk_spin_button_set_value (GTK_SPIN_BUTTON (g->h), b.height);
+
+      for (gint k = 1; k < (gint) G_N_ELEMENTS (presets) && ! p; k++)
+        {
+          gint pw, ph;
+
+          preset_size (g->image, k, &pw, &ph);
+          if (pw == b.width && ph == b.height)
+            p = k;
+        }
+
+      gtk_combo_box_set_active (GTK_COMBO_BOX (g->preset), p);
+      g_free (b.name);
+    }
+  else
+    {
+      gtk_entry_set_text (GTK_ENTRY (g->name), "");
+      gtk_combo_box_set_active (GTK_COMBO_BOX (g->preset), 0);
+    }
+
+  if (n == 0)
+    count = g_strdup (_("Aucun plan de travail : faites glisser sur le canevas pour en créer un."));
+  else
+    count = g_strdup_printf (ngettext ("%d plan de travail (actif : n° %d)",
+                                       "%d plans de travail (actif : n° %d)", n),
+                             n, i + 1);
+  gtk_label_set_text (GTK_LABEL (g->count), count);
+  g_free (count);
+
+  g->syncing = FALSE;
+}
+
+static void
+gui_free (Gui *g)
+{
+  gui_set_image (g, NULL);
+  g_signal_handlers_disconnect_by_data (g->context, g);
+  g_free (g);
+}
+
+static GtkWidget *
+spin (GtkWidget   *grid,
+      gint         row,
+      gint         col,
+      const gchar *label,
+      Gui         *g)
+{
+  GtkWidget *l = gtk_label_new (label);
+  GtkWidget *s = gtk_spin_button_new_with_range (-100000, 100000, 1);
+
+  gtk_label_set_xalign (GTK_LABEL (l), 1.0);
+  gtk_spin_button_set_digits (GTK_SPIN_BUTTON (s), 0);
+  gtk_entry_set_width_chars (GTK_ENTRY (s), 6);
+  gtk_grid_attach (GTK_GRID (grid), l, col * 2,     row, 1, 1);
+  gtk_grid_attach (GTK_GRID (grid), s, col * 2 + 1, row, 1, 1);
+  g_signal_connect_swapped (s, "value-changed", G_CALLBACK (gui_set_rect), g);
+
+  return s;
+}
+
+static GtkWidget *
+button (GtkWidget   *box,
+        const gchar *icon,
+        const gchar *tip,
+        GCallback    callback,
+        Gui         *g)
+{
+  GtkWidget *b = gtk_button_new_from_icon_name (icon, GTK_ICON_SIZE_SMALL_TOOLBAR);
+
+  gimp_help_set_help_data (b, tip, NULL);
+  g_signal_connect (b, "clicked", callback, g);
+  gtk_box_pack_start (GTK_BOX (box), b, TRUE, TRUE, 0);
+
+  return b;
+}
+
+static GtkWidget *
+artboard_options_gui (GimpToolOptions *tool_options)
+{
+  GObject   *config = G_OBJECT (tool_options);
+  GtkWidget *vbox   = gimp_tool_options_gui (tool_options);
+  GtkWidget *grid, *hbox, *w;
+  Gui       *g      = g_new0 (Gui, 1);
+
+  g->gimp    = tool_options->tool_info->gimp;
+  g->context = gimp_get_user_context (g->gimp);
+  g->box     = vbox;
+
+  g_object_set_data_full (G_OBJECT (vbox), "chopgimp-artboard-gui", g,
+                          (GDestroyNotify) gui_free);
+
+  g->count = gtk_label_new (NULL);
+  gtk_label_set_xalign (GTK_LABEL (g->count), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (g->count), TRUE);
+  gtk_box_pack_start (GTK_BOX (vbox), g->count, FALSE, FALSE, 0);
+
+  /*  format  */
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_box_pack_start (GTK_BOX (hbox), gtk_label_new (_("Format :")), FALSE, FALSE, 0);
+  g->preset = gtk_combo_box_text_new ();
+  for (gint i = 0; i < (gint) G_N_ELEMENTS (presets); i++)
+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (g->preset), _(presets[i].name));
+  gtk_combo_box_set_active (GTK_COMBO_BOX (g->preset), 0);
+  g_signal_connect (g->preset, "changed", G_CALLBACK (gui_preset_changed), g);
+  gtk_box_pack_start (GTK_BOX (hbox), g->preset, TRUE, TRUE, 0);
+  w = gtk_button_new_from_icon_name ("object-rotate-right", GTK_ICON_SIZE_SMALL_TOOLBAR);
+  gimp_help_set_help_data (w, _("Orientation : portrait ↔ paysage"), NULL);
+  g_signal_connect (w, "clicked", G_CALLBACK (gui_orientation), g);
+  gtk_box_pack_start (GTK_BOX (hbox), w, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (vbox), hbox, FALSE, FALSE, 0);
+
+  /*  name  */
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_box_pack_start (GTK_BOX (hbox), gtk_label_new (_("Nom :")), FALSE, FALSE, 0);
+  g->name = gtk_entry_new ();
+  g_signal_connect (g->name, "activate", G_CALLBACK (gui_name_activate), g);
+  g_signal_connect (g->name, "focus-out-event", G_CALLBACK (gui_name_focus_out), g);
+  gtk_box_pack_start (GTK_BOX (hbox), g->name, TRUE, TRUE, 0);
+  gtk_box_pack_start (GTK_BOX (vbox), hbox, FALSE, FALSE, 0);
+
+  /*  position and size  */
+  grid = gtk_grid_new ();
+  gtk_grid_set_row_spacing (GTK_GRID (grid), 2);
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 4);
+  g->x = spin (grid, 0, 0, _("X :"), g);
+  g->y = spin (grid, 0, 1, _("Y :"), g);
+  g->w = spin (grid, 1, 0, _("L :"), g);
+  g->h = spin (grid, 1, 1, _("H :"), g);
+  gtk_spin_button_set_range (GTK_SPIN_BUTTON (g->w), 1, 100000);
+  gtk_spin_button_set_range (GTK_SPIN_BUTTON (g->h), 1, 100000);
+  gtk_box_pack_start (GTK_BOX (vbox), grid, FALSE, FALSE, 0);
+
+  /*  buttons  */
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 2);
+  button (hbox, GIMP_ICON_DOCUMENT_NEW, _("Nouveau plan de travail (à droite des autres)"),
+          G_CALLBACK (gui_new), g);
+  button (hbox, GIMP_ICON_OBJECT_DUPLICATE, _("Dupliquer le plan actif"),
+          G_CALLBACK (gui_duplicate), g);
+  button (hbox, GIMP_ICON_EDIT_DELETE, _("Supprimer le plan actif (Suppr)"),
+          G_CALLBACK (gui_delete), g);
+  button (hbox, GIMP_ICON_DOCUMENT_SAVE_AS, _("Exporter les plans de travail…"),
+          G_CALLBACK (gui_export), g);
+  button (hbox, GIMP_ICON_DIALOG_INFORMATION, _("Panneau Plans de travail"),
+          G_CALLBACK (gui_panel), g);
+  gtk_box_pack_start (GTK_BOX (vbox), hbox, FALSE, FALSE, 0);
+
+  w = gimp_prop_check_button_new (config, "artboard-move-artwork", NULL);
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+  w = gimp_prop_check_button_new (config, "artboard-fit-canvas", NULL);
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+
+  w = gtk_label_new (_("Glisser : nouveau plan. Dans un plan : déplacer (Alt : copier). "
+                       "Poignées : redimensionner (Maj : proportions). Double-clic : "
+                       "renommer. Suppr : supprimer. Flèches : décaler (Maj × 10)."));
+  gtk_label_set_xalign (GTK_LABEL (w), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (w), TRUE);
+  gimp_label_set_attributes (GTK_LABEL (w), PANGO_ATTR_SCALE, PANGO_SCALE_SMALL, -1);
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+
+  g_signal_connect (g->context, "image-changed", G_CALLBACK (gui_image_changed), g);
+  gui_set_image (g, gimp_context_get_image (g->context));
+  gui_sync (g);
+
+  gtk_widget_show_all (vbox);
+
+  return vbox;
+}
