diff --git a/app/display/chopgimp-canvasartboards.c b/app/display/chopgimp-canvasartboards.c
new file mode 100644
index 0000000..9240773
--- /dev/null
+++ b/app/display/chopgimp-canvasartboards.c
@@ -0,0 +1,703 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-canvasartboards.c — ChopGimp 3.31.0 (lot 4a): the artboards
+ * and the perspective grid over the canvas (Illustrator)
+ *
+ * One item draws, in image space (it turns with the view), the
+ * perspective grid of the image when it is visible, then the artboards
+ * with their names (the active one in the accent color). A second one,
+ * with the unrotated items, draws the plane switching widget at the top
+ * left of the view. They read the image parasites at each draw (a few
+ * lines of text); the display is redrawn when a parasite changes.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+
+#include "display-types.h"
+
+#include "core/gimpimage.h"
+#include "core/chopgimp-artboards.h"
+#include "core/chopgimp-pgrid.h"
+
+#include "gimpdisplay.h"
+#include "gimpdisplayshell.h"
+#include "gimpdisplayshell-expose.h"
+#include "gimpdisplayshell-items.h"
+#include "gimpdisplayshell-transform.h"
+#include "chopgimp-canvasartboards.h"
+
+
+#define MAX_LINES 200   /* grid lines per direction and plane */
+
+
+typedef struct
+{
+  GimpCanvasItem parent_instance;
+
+  gboolean       widget;
+} ChopGimpCanvasArtboards;
+
+typedef struct
+{
+  GimpCanvasItemClass parent_class;
+} ChopGimpCanvasArtboardsClass;
+
+G_DEFINE_TYPE (ChopGimpCanvasArtboards, chopgimp_canvas_artboards, GIMP_TYPE_CANVAS_ITEM)
+
+
+static void             refresh_items   (GimpDisplayShell *shell);
+static cairo_region_t * compute_extents (GimpCanvasItem   *item);
+
+
+/*  ─── helpers ───────────────────────────────────────────────────────── */
+
+static void
+set_rgb (cairo_t *cr,
+         guint32  rgb,
+         gdouble  alpha)
+{
+  cairo_set_source_rgba (cr,
+                         ((rgb >> 16) & 0xff) / 255.0,
+                         ((rgb >>  8) & 0xff) / 255.0,
+                         ( rgb        & 0xff) / 255.0,
+                         alpha);
+}
+
+gboolean
+chopgimp_artboards_shown (GimpImage *image)
+{
+  return image && ! g_object_get_data (G_OBJECT (image), "chopgimp-hide-artboards");
+}
+
+void
+chopgimp_artboards_set_shown (GimpImage *image,
+                              gboolean   shown)
+{
+  g_return_if_fail (GIMP_IS_IMAGE (image));
+
+  g_object_set_data (G_OBJECT (image), "chopgimp-hide-artboards",
+                     GINT_TO_POINTER (shown ? 0 : 1));
+
+  /*  the displays redraw on a (non undoable) parasite notification:
+   *  emit it without changing anything
+   */
+  g_signal_emit_by_name (image, "parasite-attached", CHOPGIMP_ARTBOARDS_PARASITE);
+}
+
+void
+chopgimp_canvas_artboards_set_hidden (GimpDisplayShell *shell,
+                                      gint              index)
+{
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  g_object_set_data (G_OBJECT (shell), "chopgimp-artboard-hidden",
+                     GINT_TO_POINTER (index + 1));
+  refresh_items (shell);
+}
+
+
+/*  ─── the plane switching widget ────────────────────────────────────── */
+
+/*  faces of a cube corner, in canvas widget coordinates  */
+static void
+widget_faces (gdouble     faces[3][4][2],
+              gdouble    *cx,
+              gdouble    *cy,
+              gdouble    *radius)
+{
+  const gdouble x = 44.0, y = 40.0;
+  const gdouble f[3][4][2] =
+    {
+      /* left  */ { { x, y - 16 }, { x - 16, y - 8 }, { x - 16, y + 10 }, { x, y + 2 } },
+      /* right */ { { x, y - 16 }, { x + 16, y - 8 }, { x + 16, y + 10 }, { x, y + 2 } },
+      /* floor */ { { x, y + 6 },  { x + 16, y + 14 }, { x, y + 22 },     { x - 16, y + 14 } }
+    };
+
+  memcpy (faces, f, sizeof (f));
+  *cx     = x;
+  *cy     = y + 3;
+  *radius = 30.0;
+}
+
+static gboolean
+in_polygon (const gdouble p[4][2],
+            gdouble       x,
+            gdouble       y)
+{
+  gboolean in = FALSE;
+
+  for (gint i = 0, j = 3; i < 4; j = i++)
+    if (((p[i][1] > y) != (p[j][1] > y)) &&
+        (x < (p[j][0] - p[i][0]) * (y - p[i][1]) / (p[j][1] - p[i][1]) + p[i][0]))
+      in = ! in;
+
+  return in;
+}
+
+gint
+chopgimp_pgrid_widget_hit (GimpDisplayShell *shell,
+                           gdouble           sx,
+                           gdouble           sy)
+{
+  GimpImage     *image;
+  ChopGimpPGrid  grid;
+  gdouble        faces[3][4][2];
+  gdouble        cx, cy, r;
+
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), -1);
+
+  image = gimp_display_get_image (shell->display);
+
+  if (! image || ! chopgimp_pgrid_get (image, &grid) || ! grid.visible)
+    return -1;
+
+  widget_faces (faces, &cx, &cy, &r);
+
+  if (in_polygon (faces[0], sx, sy)) return CHOPGIMP_PLANE_LEFT;
+  if (in_polygon (faces[1], sx, sy)) return CHOPGIMP_PLANE_RIGHT;
+  if (in_polygon (faces[2], sx, sy)) return CHOPGIMP_PLANE_FLOOR;
+
+  if (hypot (sx - cx, sy - cy) <= r)
+    return CHOPGIMP_PLANE_NONE;
+
+  return -1;
+}
+
+static void
+draw_widget (GimpCanvasItem *item,
+             cairo_t        *cr,
+             GimpImage      *image)
+{
+  ChopGimpPGrid grid;
+  gdouble       faces[3][4][2];
+  gdouble       cx, cy, r;
+  const gint    plane[3] = { CHOPGIMP_PLANE_LEFT, CHOPGIMP_PLANE_RIGHT, CHOPGIMP_PLANE_FLOOR };
+
+  if (! chopgimp_pgrid_get (image, &grid) || ! grid.visible)
+    return;
+
+  widget_faces (faces, &cx, &cy, &r);
+
+  /*  the ring: « no plane » (active in white)  */
+  cairo_arc (cr, cx, cy, r, 0, 2 * G_PI);
+  cairo_set_source_rgba (cr, 0.12, 0.12, 0.12, 0.55);
+  cairo_fill_preserve (cr);
+  cairo_set_line_width (cr, grid.active_plane == CHOPGIMP_PLANE_NONE ? 3.0 : 1.0);
+  cairo_set_source_rgba (cr, 1, 1, 1, grid.active_plane == CHOPGIMP_PLANE_NONE ? 0.95 : 0.5);
+  cairo_stroke (cr);
+
+  for (gint i = 0; i < 3; i++)
+    {
+      gboolean active = grid.active_plane == plane[i];
+
+      cairo_move_to (cr, faces[i][0][0], faces[i][0][1]);
+      for (gint k = 1; k < 4; k++)
+        cairo_line_to (cr, faces[i][k][0], faces[i][k][1]);
+      cairo_close_path (cr);
+
+      set_rgb (cr, grid.color[plane[i]], active ? 0.95 : 0.30);
+      cairo_fill_preserve (cr);
+      cairo_set_line_width (cr, 1.0);
+      cairo_set_source_rgba (cr, 1, 1, 1, active ? 0.95 : 0.6);
+      cairo_stroke (cr);
+    }
+}
+
+
+/*  ─── the grid ──────────────────────────────────────────────────────── */
+
+static void
+grid_segment (GimpCanvasItem      *item,
+              cairo_t             *cr,
+              const ChopGimpPGrid *grid,
+              ChopGimpPlane        plane,
+              gdouble              u1,
+              gdouble              v1,
+              gdouble              u2,
+              gdouble              v2)
+{
+  gdouble x1, y1, x2, y2;
+
+  if (! chopgimp_pgrid_from_plane (grid, plane, u1, v1, &x1, &y1) ||
+      ! chopgimp_pgrid_from_plane (grid, plane, u2, v2, &x2, &y2))
+    return;
+
+  gimp_canvas_item_transform_xy_f (item, x1, y1, &x1, &y1);
+  gimp_canvas_item_transform_xy_f (item, x2, y2, &x2, &y2);
+
+  cairo_move_to (cr, x1, y1);
+  cairo_line_to (cr, x2, y2);
+}
+
+static void
+draw_plane (GimpCanvasItem      *item,
+            cairo_t             *cr,
+            const ChopGimpPGrid *grid,
+            ChopGimpPlane        plane)
+{
+  gdouble u1, v1, u2, v2;
+  gdouble step = MAX (grid->cell, 1e-3);
+  gdouble su, sv;
+  gint    nu, nv;
+
+  chopgimp_pgrid_plane_range (grid, plane, &u1, &v1, &u2, &v2);
+
+  nu = (gint) ceil ((u2 - u1) / step);
+  nv = (gint) ceil ((v2 - v1) / step);
+  su = step * MAX (1, (nu + MAX_LINES - 1) / MAX_LINES);
+  sv = step * MAX (1, (nv + MAX_LINES - 1) / MAX_LINES);
+
+  for (gdouble u = u1; u <= u2 + 1e-6; u += su)
+    grid_segment (item, cr, grid, plane, u, v1, u, v2);
+  for (gdouble v = v1; v <= v2 + 1e-6; v += sv)
+    grid_segment (item, cr, grid, plane, u1, v, u2, v);
+
+  set_rgb (cr, grid->color[plane],
+           grid->opacity * (grid->active_plane == (gint) plane ? 1.0 : 0.45));
+  cairo_set_line_width (cr, grid->active_plane == (gint) plane ? 1.2 : 0.8);
+  cairo_stroke (cr);
+}
+
+static void
+draw_grid (GimpCanvasItem *item,
+           cairo_t        *cr,
+           GimpImage      *image)
+{
+  ChopGimpPGrid grid;
+  gdouble       hx1, hy1, hx2, hy2;
+
+  if (! chopgimp_pgrid_get (image, &grid) || ! grid.visible)
+    return;
+
+  /*  the horizon, through the vanishing points  */
+  if (grid.type == 1)
+    {
+      hx1 = grid.vl[0] - 1e5; hy1 = grid.vl[1];
+      hx2 = grid.vl[0] + 1e5; hy2 = grid.vl[1];
+    }
+  else
+    {
+      gdouble dx = grid.vr[0] - grid.vl[0];
+      gdouble dy = grid.vr[1] - grid.vl[1];
+      gdouble d  = MAX (hypot (dx, dy), 1e-6);
+
+      hx1 = grid.vl[0] - dx / d * 1e5; hy1 = grid.vl[1] - dy / d * 1e5;
+      hx2 = grid.vr[0] + dx / d * 1e5; hy2 = grid.vr[1] + dy / d * 1e5;
+    }
+
+  gimp_canvas_item_transform_xy_f (item, hx1, hy1, &hx1, &hy1);
+  gimp_canvas_item_transform_xy_f (item, hx2, hy2, &hx2, &hy2);
+  cairo_move_to (cr, hx1, hy1);
+  cairo_line_to (cr, hx2, hy2);
+  cairo_set_source_rgba (cr, 0.55, 0.55, 0.55, grid.opacity);
+  cairo_set_line_width (cr, 1.0);
+  cairo_stroke (cr);
+
+  draw_plane (item, cr, &grid, CHOPGIMP_PLANE_FLOOR);
+  draw_plane (item, cr, &grid, CHOPGIMP_PLANE_LEFT);
+  draw_plane (item, cr, &grid, CHOPGIMP_PLANE_RIGHT);
+}
+
+
+/*  ─── the artboards ─────────────────────────────────────────────────── */
+
+static void
+draw_artboards (GimpCanvasItem *item,
+                cairo_t        *cr,
+                GimpImage      *image)
+{
+  GimpDisplayShell *shell  = gimp_canvas_item_get_shell (item);
+  gint              hidden = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (shell),
+                                                                 "chopgimp-artboard-hidden")) - 1;
+  gint              active;
+  GArray           *boards;
+  PangoLayout      *layout;
+  PangoFontDescription *font;
+
+  if (! chopgimp_artboards_shown (image))
+    return;
+
+  boards = chopgimp_artboards_get (image, &active);
+
+  if (! boards->len)
+    {
+      chopgimp_artboards_free (boards);
+      return;
+    }
+
+  layout = gtk_widget_create_pango_layout (gimp_canvas_item_get_canvas (item), NULL);
+  font   = pango_font_description_from_string ("Sans 8");
+  pango_layout_set_font_description (layout, font);
+  pango_font_description_free (font);
+
+  for (guint i = 0; i < boards->len; i++)
+    {
+      ChopGimpArtboard *b = &g_array_index (boards, ChopGimpArtboard, i);
+      gdouble           x1, y1, x2, y2;
+      gint              tw, th;
+      gboolean          is_active = (gint) i == active;
+
+      if ((gint) i == hidden)
+        continue;
+
+      gimp_canvas_item_transform_xy_f (item, b->x, b->y, &x1, &y1);
+      gimp_canvas_item_transform_xy_f (item, b->x + b->width, b->y + b->height, &x2, &y2);
+
+      x1 = floor (x1) + 0.5; y1 = floor (y1) + 0.5;
+      x2 = floor (x2) + 0.5; y2 = floor (y2) + 0.5;
+
+      /*  a light halo, then the outline  */
+      cairo_rectangle (cr, x1, y1, x2 - x1, y2 - y1);
+      cairo_set_source_rgba (cr, 1, 1, 1, 0.55);
+      cairo_set_line_width (cr, 3.0);
+      cairo_stroke_preserve (cr);
+
+      if (is_active)
+        cairo_set_source_rgba (cr, 0.10, 0.45, 0.91, 1.0);
+      else
+        cairo_set_source_rgba (cr, 0.13, 0.13, 0.13, 0.9);
+      cairo_set_line_width (cr, is_active ? 2.0 : 1.0);
+      cairo_stroke (cr);
+
+      /*  the name above the top left corner (Illustrator: « 01 - Nom »)  */
+      {
+        gchar *label = g_strdup_printf ("%02u - %s", i + 1, b->name);
+
+        pango_layout_set_text (layout, label, -1);
+        g_free (label);
+      }
+      pango_layout_get_pixel_size (layout, &tw, &th);
+
+      cairo_rectangle (cr, x1 - 0.5, y1 - th - 5, tw + 8, th + 3);
+      if (is_active)
+        cairo_set_source_rgba (cr, 0.10, 0.45, 0.91, 0.9);
+      else
+        cairo_set_source_rgba (cr, 0.13, 0.13, 0.13, 0.7);
+      cairo_fill (cr);
+
+      cairo_move_to (cr, x1 + 3.5, y1 - th - 3.5);
+      cairo_set_source_rgba (cr, 1, 1, 1, 1);
+      pango_cairo_show_layout (cr, layout);
+    }
+
+  g_object_unref (layout);
+  chopgimp_artboards_free (boards);
+}
+
+
+/*  ─── the item ──────────────────────────────────────────────────────── */
+
+static void
+chopgimp_canvas_artboards_draw (GimpCanvasItem *item,
+                                cairo_t        *cr)
+{
+  ChopGimpCanvasArtboards *self  = (ChopGimpCanvasArtboards *) item;
+  GimpImage               *image = gimp_canvas_item_get_image (item);
+
+  if (! image)
+    return;
+
+  /*  3.31.0 (4b): what is drawn now, in the current view, for the next
+   *  refresh_items()
+   */
+  g_object_set_data_full (G_OBJECT (gimp_canvas_item_get_shell (item)),
+                          self->widget ? "chopgimp-artboards-widget-last"
+                                       : "chopgimp-artboards-item-last",
+                          compute_extents (item),
+                          (GDestroyNotify) cairo_region_destroy);
+
+  cairo_save (cr);
+
+  if (self->widget)
+    {
+      draw_widget (item, cr, image);
+    }
+  else
+    {
+      draw_grid (item, cr, image);
+      draw_artboards (item, cr, image);
+    }
+
+  cairo_restore (cr);
+}
+
+/*  3.31.0 (4b): the area the item draws, in canvas widget coordinates:
+ *  the plane widget; the horizon (clipped to the view), the bounds of the
+ *  three planes (a projective map keeps a plane's lines inside the image
+ *  of its corners), the artboards with their halo and their name
+ */
+static void
+extents_add (cairo_region_t *region,
+             gdouble         x1,
+             gdouble         y1,
+             gdouble         x2,
+             gdouble         y2,
+             gint            margin)
+{
+  cairo_rectangle_int_t r;
+
+  r.x      = (gint) floor (MIN (x1, x2)) - margin;
+  r.y      = (gint) floor (MIN (y1, y2)) - margin;
+  r.width  = (gint) ceil (MAX (x1, x2)) + margin - r.x + 1;
+  r.height = (gint) ceil (MAX (y1, y2)) + margin - r.y + 1;
+
+  cairo_region_union_rectangle (region, &r);
+}
+
+static void
+extents_add_points (GimpCanvasItem *item,
+                    cairo_region_t *region,
+                    const gdouble  *pts,      /* image coordinates */
+                    gint            n,
+                    gint            margin)
+{
+  gdouble x1 = G_MAXDOUBLE, y1 = G_MAXDOUBLE, x2 = -G_MAXDOUBLE, y2 = -G_MAXDOUBLE;
+
+  for (gint i = 0; i < n; i++)
+    {
+      gdouble x, y;
+
+      gimp_canvas_item_transform_xy_f (item, pts[2 * i], pts[2 * i + 1], &x, &y);
+      x1 = MIN (x1, x); y1 = MIN (y1, y);
+      x2 = MAX (x2, x); y2 = MAX (y2, y);
+    }
+
+  if (n > 0)
+    extents_add (region, x1, y1, x2, y2, margin);
+}
+
+static cairo_region_t *
+compute_extents (GimpCanvasItem *item)
+{
+  ChopGimpCanvasArtboards *self   = (ChopGimpCanvasArtboards *) item;
+  GimpImage               *image  = gimp_canvas_item_get_image (item);
+  GimpDisplayShell        *shell  = gimp_canvas_item_get_shell (item);
+  GtkWidget               *canvas = gimp_canvas_item_get_canvas (item);
+  cairo_region_t          *region = cairo_region_create ();
+  ChopGimpPGrid            grid;
+  gint                     vw     = canvas ? gtk_widget_get_allocated_width (canvas)  : 0;
+  gint                     vh     = canvas ? gtk_widget_get_allocated_height (canvas) : 0;
+
+  if (! image)
+    return region;
+
+  if (self->widget)
+    {
+      if (chopgimp_pgrid_get (image, &grid) && grid.visible)
+        extents_add (region, 0, 0, 90, 90, 0);
+      return region;
+    }
+
+  if (chopgimp_pgrid_get (image, &grid) && grid.visible)
+    {
+      const ChopGimpPlane planes[3] = { CHOPGIMP_PLANE_FLOOR, CHOPGIMP_PLANE_LEFT,
+                                        CHOPGIMP_PLANE_RIGHT };
+      gboolean            all       = FALSE;
+      gdouble             hx1, hy1, hx2, hy2;
+
+      /*  the horizon crosses the view: its band (all of it when tilted)  */
+      gimp_canvas_item_transform_xy_f (item, grid.vl[0], grid.vl[1], &hx1, &hy1);
+      gimp_canvas_item_transform_xy_f (item, grid.type == 1 ? grid.vl[0] + 1.0 : grid.vr[0],
+                                       grid.type == 1 ? grid.vl[1] : grid.vr[1], &hx2, &hy2);
+      if (fabs (hy2 - hy1) < 0.5)
+        extents_add (region, 0, hy1, vw, hy1, 3);
+      else
+        all = TRUE;
+
+      for (gint i = 0; i < 3 && ! all; i++)
+        {
+          gdouble u1, v1, u2, v2;
+          gdouble uv[4][2];
+          gdouble pts[8];
+
+          chopgimp_pgrid_plane_range (&grid, planes[i], &u1, &v1, &u2, &v2);
+          uv[0][0] = u1; uv[0][1] = v1;
+          uv[1][0] = u2; uv[1][1] = v1;
+          uv[2][0] = u2; uv[2][1] = v2;
+          uv[3][0] = u1; uv[3][1] = v2;
+
+          for (gint k = 0; k < 4 && ! all; k++)
+            if (! chopgimp_pgrid_from_plane (&grid, planes[i], uv[k][0], uv[k][1],
+                                             &pts[2 * k], &pts[2 * k + 1]))
+              all = TRUE;
+
+          if (! all)
+            extents_add_points (item, region, pts, 4, 3);
+        }
+
+      if (all)
+        extents_add (region, 0, 0, vw, vh, 0);
+    }
+
+  if (chopgimp_artboards_shown (image))
+    {
+      gint         active;
+      gint         hidden = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (shell),
+                                                                "chopgimp-artboard-hidden")) - 1;
+      GArray      *boards = chopgimp_artboards_get (image, &active);
+      PangoLayout *layout = NULL;
+
+      if (boards->len && canvas)
+        {
+          PangoFontDescription *font = pango_font_description_from_string ("Sans 8");
+
+          layout = gtk_widget_create_pango_layout (canvas, NULL);
+          pango_layout_set_font_description (layout, font);
+          pango_font_description_free (font);
+        }
+
+      for (guint i = 0; layout && i < boards->len; i++)
+        {
+          ChopGimpArtboard *b = &g_array_index (boards, ChopGimpArtboard, i);
+          gdouble           pts[8] = { b->x, b->y, b->x + b->width, b->y,
+                                       b->x + b->width, b->y + b->height,
+                                       b->x, b->y + b->height };
+          gdouble           x1, y1;
+          gint              tw, th;
+          gchar            *label;
+
+          if ((gint) i == hidden)
+            continue;
+
+          extents_add_points (item, region, pts, 4, 3);
+
+          label = g_strdup_printf ("%02u - %s", i + 1, b->name);
+          pango_layout_set_text (layout, label, -1);
+          g_free (label);
+          pango_layout_get_pixel_size (layout, &tw, &th);
+
+          gimp_canvas_item_transform_xy_f (item, b->x, b->y, &x1, &y1);
+          extents_add (region, x1 - 1, y1 - th - 6, x1 + tw + 9, y1, 2);
+        }
+
+      g_clear_object (&layout);
+      chopgimp_artboards_free (boards);
+    }
+
+  return region;
+}
+
+static cairo_region_t *
+chopgimp_canvas_artboards_get_extents (GimpCanvasItem *item)
+{
+  return compute_extents (item);
+}
+
+static void
+chopgimp_canvas_artboards_class_init (ChopGimpCanvasArtboardsClass *klass)
+{
+  GimpCanvasItemClass *item_class = GIMP_CANVAS_ITEM_CLASS (klass);
+
+  item_class->draw        = chopgimp_canvas_artboards_draw;
+  item_class->get_extents = chopgimp_canvas_artboards_get_extents;
+}
+
+static void
+chopgimp_canvas_artboards_init (ChopGimpCanvasArtboards *self)
+{
+}
+
+void
+chopgimp_canvas_artboards_add_items (GimpDisplayShell *shell,
+                                     gboolean          unrotated)
+{
+  ChopGimpCanvasArtboards *item;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  item = g_object_new (CHOPGIMP_TYPE_CANVAS_ARTBOARDS, "shell", shell, NULL);
+  item->widget = unrotated;
+
+  /*  for refresh_items() (the shell keeps a reference to the item)  */
+  g_object_set_data (G_OBJECT (shell),
+                     unrotated ? "chopgimp-artboards-widget" : "chopgimp-artboards-item",
+                     item);
+
+  if (unrotated)
+    gimp_display_shell_add_unrotated_item (shell, GIMP_CANVAS_ITEM (item));
+  else
+    gimp_display_shell_add_item (shell, GIMP_CANVAS_ITEM (item));
+
+  g_object_unref (item);
+}
+
+
+/*  ─── updates ───────────────────────────────────────────────────────── */
+
+/*  3.31.0 (4b): only the area drawn before the change and the area drawn
+ *  after it are redrawn (CHOPGIMP_FULL_REDRAW=1: the whole view, as in
+ *  the first version); the last areas are kept on the shell
+ */
+static void
+refresh_items (GimpDisplayShell *shell)
+{
+  static const gchar *keys[2] = { "chopgimp-artboards-item", "chopgimp-artboards-widget" };
+
+  if (g_getenv ("CHOPGIMP_FULL_REDRAW"))
+    {
+      gimp_display_shell_expose_full (shell);
+      return;
+    }
+
+  for (gint i = 0; i < 2; i++)
+    {
+      GimpCanvasItem *item = g_object_get_data (G_OBJECT (shell), keys[i]);
+      gchar          *last_key;
+      cairo_region_t *last;
+      cairo_region_t *now;
+
+      if (! item)
+        continue;
+
+      last_key = g_strconcat (keys[i], "-last", NULL);
+      last     = g_object_get_data (G_OBJECT (shell), last_key);
+      now      = compute_extents (item);
+
+      if (last)
+        cairo_region_union (last, now);
+
+      gimp_display_shell_expose_region (shell, last ? last : now);
+
+      g_object_set_data_full (G_OBJECT (shell), last_key, now,
+                              (GDestroyNotify) cairo_region_destroy);
+      g_free (last_key);
+    }
+}
+
+static void
+parasite_changed (GimpImage        *image,
+                  const gchar      *name,
+                  GimpDisplayShell *shell)
+{
+  if (! g_strcmp0 (name, CHOPGIMP_ARTBOARDS_PARASITE) ||
+      ! g_strcmp0 (name, CHOPGIMP_PGRID_PARASITE))
+    refresh_items (shell);
+}
+
+void
+chopgimp_canvas_artboards_connect (GimpDisplayShell *shell,
+                                   GimpImage        *image)
+{
+  g_signal_connect (image, "parasite-attached", G_CALLBACK (parasite_changed), shell);
+  g_signal_connect (image, "parasite-detached", G_CALLBACK (parasite_changed), shell);
+}
+
+void
+chopgimp_canvas_artboards_disconnect (GimpDisplayShell *shell,
+                                      GimpImage        *image)
+{
+  g_signal_handlers_disconnect_by_func (image, parasite_changed, shell);
+}
