+ */
+
+#pragma once
+
+
+/*  Each selected artboard (@selected NULL: all) is exported as
+ *  <folder>/<prefix><artboard name>.<extension> (a number is added when
+ *  two names are the same) by the export procedure of @extension
+ *  (« png », « jpg »…, non-interactive, its default options) from a copy
+ *  of the image cropped to the artboard (the content outside the canvas
+ *  is transparent; JPG: flattened by the plug-in). The image itself is
+ *  unchanged. Returns the number of files written, -1 on error.
+ */
+gint   chopgimp_artboards_export (GimpImage      *image,
+                                  GimpContext    *context,
+                                  GimpProgress   *progress,
+                                  GFile          *folder,
+                                  const gchar    *extension,
+                                  const gchar    *prefix,
+                                  const gboolean *selected,
+                                  GError        **error);
