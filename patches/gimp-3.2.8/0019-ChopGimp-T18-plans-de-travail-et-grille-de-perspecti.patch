diff --git a/app/file/chopgimp-file-artboards.c b/app/file/chopgimp-file-artboards.c
new file mode 100644
index 0000000..7afd18f
--- /dev/null
+++ b/app/file/chopgimp-file-artboards.c
@@ -0,0 +1,193 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-file-artboards.c — ChopGimp 3.31.0 (lot 4a): « Exporter les
+ * plans de travail » (PNG / JPG, one file per artboard; the vector and
+ * layered formats come with the exporters of lot 4b)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "libgimpbase/gimpbase.h"
+
+#include "core/core-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpcontext.h"
+#include "core/gimpimage.h"
+#include "core/gimpimage-crop.h"
+#include "core/gimpimage-duplicate.h"
+#include "core/gimpitem.h"
+#include "core/gimplayer.h"
+#include "core/gimplayer-new.h"
+#include "core/gimpprogress.h"
+#include "core/chopgimp-artboards.h"
+
+#include "plug-in/gimppluginmanager-file.h"
+#include "plug-in/gimppluginprocedure.h"
+
+#include "file-save.h"
+#include "chopgimp-file-artboards.h"
+
+#include "gimp-intl.h"
+
+
+gint
+chopgimp_artboards_export (GimpImage      *image,
+                           GimpContext    *context,
+                           GimpProgress   *progress,
+                           GFile          *folder,
+                           const gchar    *extension,
+                           const gchar    *prefix,
+                           const gboolean *selected,
+                           GError        **error)
+{
+  GArray     *boards;
+  GHashTable *used;
+  gint        done  = 0;
+  gint        total = 0;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), -1);
+  g_return_val_if_fail (GIMP_IS_CONTEXT (context), -1);
+  g_return_val_if_fail (G_IS_FILE (folder), -1);
+
+  if (! extension || ! *extension)
+    extension = "png";
+  if (! prefix)
+    prefix = "";
+
+  boards = chopgimp_artboards_get (image, NULL);
+
+  if (! boards->len)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
+                           _("L'image n'a pas de plan de travail."));
+      chopgimp_artboards_free (boards);
+      return -1;
+    }
+
+  for (guint i = 0; i < boards->len; i++)
+    if (! selected || selected[i])
+      total++;
+
+  used = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+
+  if (progress)
+    gimp_progress_start (progress, FALSE, _("Exportation des plans de travail"));
+
+  for (guint i = 0; i < boards->len; i++)
+    {
+      ChopGimpArtboard    *b = &g_array_index (boards, ChopGimpArtboard, i);
+      GimpPlugInProcedure *proc;
+      GimpImage           *copy;
+      GFile               *file;
+      gchar               *base, *name;
+      GimpPDBStatusType    status;
+
+      if (selected && ! selected[i])
+        continue;
+
+      base = chopgimp_artboards_file_name (b->name);
+      name = g_strdup_printf ("%s%s.%s", prefix, base, extension);
+
+      for (gint n = 2; g_hash_table_contains (used, name); n++)
+        {
+          g_free (name);
+          name = g_strdup_printf ("%s%s-%d.%s", prefix, base, n, extension);
+        }
+      g_hash_table_add (used, g_strdup (name));
+
+      file = g_file_get_child (folder, name);
+      g_free (base);
+      g_free (name);
+
+      proc = gimp_plug_in_manager_file_procedure_find (image->gimp->plug_in_manager,
+                                                       GIMP_FILE_PROCEDURE_GROUP_EXPORT,
+                                                       file, error);
+      if (! proc)
+        {
+          g_object_unref (file);
+          done = -1;
+          break;
+        }
+
+      copy = gimp_image_duplicate (image);
+
+      /*  3.99.0: layers are not cropped: an artboard outside every layer
+       *  would leave an image without layers, which crashed the exporters
+       *  (file-png); the export merges what the canvas shows anyway
+       */
+      gimp_image_crop (copy, context, GIMP_FILL_TRANSPARENT,
+                       b->x, b->y, b->width, b->height, FALSE);
+
+      /*  nothing visible on the artboard: an empty layer, so that the
+       *  exporter merges something (else export_merge() fails)
+       */
+      {
+        gboolean seen = FALSE;
+
+        for (GList *l = gimp_image_get_layer_iter (copy); l && ! seen; l = l->next)
+          {
+            GimpItem *it = l->data;
+            gint      ox, oy;
+
+            gimp_item_get_offset (it, &ox, &oy);
+            seen = (gimp_item_get_visible (it) &&
+                    ox < b->width && oy < b->height &&
+                    ox + gimp_item_get_width (it) > 0 &&
+                    oy + gimp_item_get_height (it) > 0);
+          }
+
+        if (! seen)
+          {
+            GimpLayer *empty = gimp_layer_new (copy, b->width, b->height,
+                                               gimp_image_get_layer_format (copy, TRUE),
+                                               b->name, GIMP_OPACITY_OPAQUE,
+                                               GIMP_LAYER_MODE_NORMAL);
+
+            gimp_image_add_layer (copy, empty, NULL, 0, FALSE);
+          }
+      }
+
+      /*  3.31.0 (4b): the copy is one page (the PDF / EPS exports would
+       *  otherwise make a page per artboard of the copy)
+       */
+      gimp_image_parasite_detach (copy, CHOPGIMP_ARTBOARDS_PARASITE, FALSE);
+
+      status = file_save (image->gimp, copy, NULL, file, proc,
+                          GIMP_RUN_NONINTERACTIVE, FALSE, FALSE, TRUE, error);
+
+      g_object_unref (copy);
+      g_object_unref (file);
+
+      if (status != GIMP_PDB_SUCCESS)
+        {
+          if (error && ! *error)
+            g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                         _("L'exportation du plan de travail « %s » a échoué."), b->name);
+          done = -1;
+          break;
+        }
+
+      done++;
+
+      if (progress)
+        gimp_progress_set_value (progress, (gdouble) done / MAX (total, 1));
+    }
+
+  if (progress)
+    gimp_progress_end (progress);
+
+  g_hash_table_unref (used);
+  chopgimp_artboards_free (boards);
+
+  return done;
+}
