+#include "widgets/gimphelp-ids.h"
+
+#include "display/gimpdisplay.h"
+#include "display/gimpdisplayshell.h"
+#include "display/gimpdisplayshell-scale.h"
+
+#include "chopgimp-artboards-panel.h"
+
+#include "gimp-intl.h"
+
+
+typedef struct
+{
+  Gimp        *gimp;
+  GimpContext *context;
+  GtkWidget   *editor;
+  GtkWidget   *list;
+  GtkWidget   *empty;
+  GtkWidget   *buttons[10];
+  GimpImage   *image;     /* weak */
+  gboolean     loading;
+  guint        idle_id;
+} Panel;
+
+enum
+{
+  B_NEW, B_DUP, B_DEL, B_UP, B_DOWN, B_RENAME, B_SHOW, B_FROM_SEL, B_FIT, B_EXPORT
+};
+
+
+/*  ─── refresh ───────────────────────────────────────────────────────── */
+
+static void
+panel_refresh (Panel *p)
+{
+  GList  *children = gtk_container_get_children (GTK_CONTAINER (p->list));
+  GArray *boards   = p->image ? chopgimp_artboards_get (p->image, NULL) : NULL;
+  gint    active   = p->image ? chopgimp_artboards_get_active (p->image) : -1;
+  gint    n        = boards ? (gint) boards->len : 0;
+
+  p->loading = TRUE;
+
+  for (GList *l = children; l; l = l->next)
+    gtk_widget_destroy (l->data);
+  g_list_free (children);
+
+  for (gint i = 0; i < n; i++)
+    {
+      ChopGimpArtboard *b   = &g_array_index (boards, ChopGimpArtboard, i);
+      GtkWidget        *row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+      GtkWidget        *num, *name, *size;
+      gchar            *s;
+
+      gtk_container_set_border_width (GTK_CONTAINER (row), 3);
+
+      s   = g_strdup_printf ("%02d", i + 1);
+      num = gtk_label_new (s);
+      g_free (s);
+      gtk_style_context_add_class (gtk_widget_get_style_context (num), "dim-label");
+      gtk_box_pack_start (GTK_BOX (row), num, FALSE, FALSE, 0);
+
+      name = gtk_label_new (b->name);
+      gtk_label_set_xalign (GTK_LABEL (name), 0.0);
+      gtk_label_set_ellipsize (GTK_LABEL (name), PANGO_ELLIPSIZE_END);
+      gtk_box_pack_start (GTK_BOX (row), name, TRUE, TRUE, 0);
+
+      s    = g_strdup_printf ("%d × %d", b->width, b->height);
+      size = gtk_label_new (s);
+      g_free (s);
+      gtk_style_context_add_class (gtk_widget_get_style_context (size), "dim-label");
+      gtk_box_pack_end (GTK_BOX (row), size, FALSE, FALSE, 0);
+
+      gtk_widget_show_all (row);
+      gtk_list_box_insert (GTK_LIST_BOX (p->list), row, -1);
+
+      if (i == active)
+        gtk_list_box_select_row (GTK_LIST_BOX (p->list),
+                                 gtk_list_box_get_row_at_index (GTK_LIST_BOX (p->list), i));
+    }
+
+  gtk_widget_set_visible (p->empty, n == 0);
+
+  for (gint b = 0; b < (gint) G_N_ELEMENTS (p->buttons); b++)
+    {
+      gboolean sens;
+
+      switch (b)
+        {
+        case B_NEW: case B_FROM_SEL: sens = p->image != NULL;         break;
+        case B_UP:                   sens = active > 0;               break;
+        case B_DOWN:                 sens = active >= 0 && active < n - 1; break;
+        case B_FIT: case B_EXPORT:   sens = n > 0;                    break;
+        default:                     sens = active >= 0;              break;
+        }
+
+      gtk_widget_set_sensitive (p->buttons[b], sens);
+    }
+
+  if (boards)
+    chopgimp_artboards_free (boards);
+
+  p->loading = FALSE;
+}
+
+static gboolean
+panel_idle (Panel *p)
+{
+  p->idle_id = 0;
+  panel_refresh (p);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+panel_queue_refresh (Panel *p)
+{
+  if (! p->idle_id)
+    p->idle_id = g_idle_add ((GSourceFunc) panel_idle, p);
+}
+
+static void
+panel_parasite (GimpImage   *image,
+                const gchar *name,
+                Panel       *p)
+{
+  if (! g_strcmp0 (name, CHOPGIMP_ARTBOARDS_PARASITE))
+    panel_queue_refresh (p);
+}
+
+static void
+panel_set_image (Panel     *p,
+                 GimpImage *image)
+{
+  if (image == p->image)
+    return;
+
+  if (p->image)
+    {
+      g_signal_handlers_disconnect_by_data (p->image, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->image), (gpointer *) &p->image);
+    }
+
+  p->image = image;
+
+  if (image)
+    {
+      g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &p->image);
+      g_signal_connect (image, "parasite-attached", G_CALLBACK (panel_parasite), p);
+      g_signal_connect (image, "parasite-detached", G_CALLBACK (panel_parasite), p);
+    }
+
+  panel_queue_refresh (p);
+}
+
+static void
+panel_image_changed (GimpContext *context,
+                     GimpImage   *image,
+                     Panel       *p)
+{
+  panel_set_image (p, image);
+}
+
+
+/*  ─── actions ───────────────────────────────────────────────────────── */
+
+static gint
+active_of (Panel *p)
+{
+  return p->image ? chopgimp_artboards_get_active (p->image) : -1;
+}
+
+static void
+row_selected (GtkListBox    *box,
+              GtkListBoxRow *row,
+              Panel         *p)
+{
+  if (p->loading || ! p->image || ! row)
+    return;
+
+  chopgimp_artboards_set_active (p->image, gtk_list_box_row_get_index (row));
+  gimp_image_flush (p->image);
+}
+
+static void
+rename_callback (GtkWidget   *query_box,
+                 const gchar *string,
+                 gpointer     data)
+{
+  Panel *p = data;
+  gint   i = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (query_box), "chopgimp-index"));
+
+  if (p->image && string && *string)
+    {
+      chopgimp_artboards_rename (p->image, i, string);
+      gimp_image_flush (p->image);
+    }
+}
+
+static void
+rename_clicked (GtkWidget *button,
+                Panel     *p)
+{
+  gint             i = active_of (p);
+  ChopGimpArtboard b;
+  GtkWidget       *box;
+
+  if (i < 0 || ! chopgimp_artboards_get_nth (p->image, i, &b))
+    return;
+
+  box = gimp_query_string_box (_("Renommer le plan de travail"),
+                               p->editor,
+                               gimp_standard_help_func, GIMP_HELP_TOOL_CROP,
+                               _("Nom du plan de travail :"),
+                               b.name,
+                               G_OBJECT (p->editor), "destroy",
+                               rename_callback, p, NULL);
+  g_object_set_data (G_OBJECT (box), "chopgimp-index", GINT_TO_POINTER (i));
+  gtk_widget_show (box);
+
+  g_free (b.name);
+}
+
+static void
+row_activated (GtkListBox    *box,
+               GtkListBoxRow *row,
+               Panel         *p)
+{
+  rename_clicked (NULL, p);
+}
+
+static void
+new_clicked (GtkWidget *button,
+             Panel     *p)
+{
+  GArray *a;
+  gint    x = 0, y = 0, w, h, right = 0, active;
+
+  if (! p->image)
+    return;
+
+  a = chopgimp_artboards_get (p->image, &active);
+  w = gimp_image_get_width  (p->image);
+  h = gimp_image_get_height (p->image);
+
+  for (guint i = 0; i < a->len; i++)
+    {
+      ChopGimpArtboard *b = &g_array_index (a, ChopGimpArtboard, i);
+
+      right = MAX (right, b->x + b->width);
+      if ((gint) i == active)
+        {
+          w = b->width;
+          h = b->height;
+          y = b->y;
+        }
+    }
+
+  if (a->len)
+    x = right + MAX (20, w / 10);
+
+  chopgimp_artboards_free (a);
+
+  gimp_image_undo_group_start (p->image, GIMP_UNDO_GROUP_MISC, _("Nouveau plan de travail"));
+  chopgimp_artboards_add (p->image, x, y, w, h, NULL);
+  chopgimp_artboards_fit_canvas (p->image, p->context);
+  gimp_image_undo_group_end (p->image);
+  gimp_image_flush (p->image);
+}
+
+static void
+dup_clicked (GtkWidget *button,
+             Panel     *p)
+{
+  gint i = active_of (p);
+
+  if (i < 0)
+    return;
+
+  gimp_image_undo_group_start (p->image, GIMP_UNDO_GROUP_MISC, _("Dupliquer le plan de travail"));
+  chopgimp_artboards_duplicate (p->image, i, FALSE, 0, 0);
+  chopgimp_artboards_fit_canvas (p->image, p->context);
+  gimp_image_undo_group_end (p->image);
+  gimp_image_flush (p->image);
+}
+
+static void
+delete_clicked (GtkWidget *button,
+                Panel     *p)
+{
+  gint i = active_of (p);
+
+  if (i >= 0)
+    {
+      chopgimp_artboards_remove (p->image, i);
+      gimp_image_flush (p->image);
+    }
+}
+
+static void
+up_clicked (GtkWidget *button,
+            Panel     *p)
+{
+  gint i = active_of (p);
+
+  if (i > 0)
+    {
+      chopgimp_artboards_move_to (p->image, i, i - 1);
+      gimp_image_flush (p->image);
+    }
+}
+
+static void
+down_clicked (GtkWidget *button,
+              Panel     *p)
+{
+  gint i = active_of (p);
+
+  if (i >= 0)
+    {
+      chopgimp_artboards_move_to (p->image, i, i + 1);
+      gimp_image_flush (p->image);
+    }
+}
+
+static void
+show_clicked (GtkWidget *button,
+              Panel     *p)
+{
+  GimpDisplay     *display = gimp_context_get_display (p->context);
+  gint             i       = active_of (p);
+  ChopGimpArtboard b;
+
+  if (! display || i < 0 || gimp_display_get_image (display) != p->image ||
+      ! chopgimp_artboards_get_nth (p->image, i, &b))
+    return;
+
+  gimp_display_shell_scale_to_rectangle (gimp_display_get_shell (display), GIMP_ZOOM_IN,
+                                         b.x, b.y, b.width, b.height, FALSE);
+  g_free (b.name);
+}
+
+static void
+from_selection_clicked (GtkWidget *button,
+                        Panel     *p)
+{
+  GimpChannel *mask;
+  gint         x1 = G_MAXINT, y1 = G_MAXINT, x2 = G_MININT, y2 = G_MININT;
+
+  if (! p->image)
+    return;
+
+  mask = gimp_image_get_mask (p->image);
+
+  if (! gimp_channel_is_empty (mask))
+    {
+      gint x, y, w, h;
+
+      gimp_item_bounds (GIMP_ITEM (mask), &x, &y, &w, &h);
+      x1 = x; y1 = y; x2 = x + w; y2 = y + h;
+    }
+  else
+    {
+      for (GList *l = gimp_image_get_selected_layers (p->image); l; l = l->next)
+        {
+          gint ox, oy;
+
+          gimp_item_get_offset (l->data, &ox, &oy);
+          x1 = MIN (x1, ox);
+          y1 = MIN (y1, oy);
+          x2 = MAX (x2, ox + gimp_item_get_width  (l->data));
+          y2 = MAX (y2, oy + gimp_item_get_height (l->data));
+        }
+    }
+
+  if (x2 <= x1 || y2 <= y1)
+    {
+      gimp_message_literal (p->gimp, G_OBJECT (p->editor), GIMP_MESSAGE_WARNING,
+                            _("Faites une sélection ou sélectionnez des calques."));
+      return;
+    }
+
+  gimp_image_undo_group_start (p->image, GIMP_UNDO_GROUP_MISC, _("Nouveau plan de travail"));
+  chopgimp_artboards_add (p->image, x1, y1, x2 - x1, y2 - y1, NULL);
+  chopgimp_artboards_fit_canvas (p->image, p->context);
+  gimp_image_undo_group_end (p->image);
+  gimp_image_flush (p->image);
+}
+
+static void
+fit_clicked (GtkWidget *button,
+             Panel     *p)
+{
+  if (p->image && chopgimp_artboards_fit_canvas (p->image, p->context))
+    gimp_image_flush (p->image);
+}
+
+static void
+export_clicked (GtkWidget *button,
+                Panel     *p)
+{
+  if (p->image)
+    chopgimp_artboards_export_dialog (p->image, p->context, p->editor);
+}
+
+
+/*  ─── the export dialog ─────────────────────────────────────────────── */
+
+static const gchar *formats[][2] =
+{
+  { "png",  N_("PNG") },
+  { "jpg",  N_("JPEG") },
+  { "webp", N_("WebP") },
+  { "tif",  N_("TIFF") },
+  { "pdf",  N_("PDF (vectoriel)") },     /* 3.31.0 (4b) */
+  { "eps",  N_("EPS (vectoriel)") },
+};
+
+typedef struct
+{
+  GimpImage   *image;
+  GimpContext *context;
+  GtkWidget   *folder;
+  GtkWidget   *format;
+  GtkWidget   *prefix;
+  GtkWidget   *range;
+} ExportDialog;
+
+static void
+export_response (GtkWidget    *dialog,
+                 gint          response,
+                 ExportDialog *d)
+{
+  if (response == GTK_RESPONSE_OK && d->image)
+    {
+      GFile    *folder = gtk_file_chooser_get_file (GTK_FILE_CHOOSER (d->folder));
+      gint      fmt    = gtk_combo_box_get_active (GTK_COMBO_BOX (d->format));
+      gint      n      = chopgimp_artboards_count (d->image);
+      gboolean *sel    = g_new0 (gboolean, MAX (n, 1));
+      GError   *error  = NULL;
+      gint      done;
+
+      if (! folder)
+        {
+          gimp_message_literal (d->image->gimp, G_OBJECT (dialog), GIMP_MESSAGE_WARNING,
+                                _("Choisissez un dossier."));
+          g_free (sel);
+          return;
+        }
+
+      if (! chopgimp_artboards_parse_range (gtk_entry_get_text (GTK_ENTRY (d->range)), n, sel))
+        {
+          gimp_message_literal (d->image->gimp, G_OBJECT (dialog), GIMP_MESSAGE_WARNING,
+                                _("Plage de plans incorrecte (exemple : 1-3, 5)."));
+          g_object_unref (folder);
+          g_free (sel);
+          return;
+        }
+
+      done = chopgimp_artboards_export (d->image, d->context, NULL, folder,
+                                        formats[CLAMP (fmt, 0, 3)][0],
+                                        gtk_entry_get_text (GTK_ENTRY (d->prefix)),
+                                        sel, &error);
+
+      if (done < 0)
+        {
+          gimp_message_literal (d->image->gimp, G_OBJECT (dialog), GIMP_MESSAGE_ERROR,
+                                error ? error->message : _("L'exportation a échoué."));
+          g_clear_error (&error);
+        }
+      else
+        {
+          gchar *msg = g_strdup_printf (ngettext ("%d plan de travail exporté.",
+                                                  "%d plans de travail exportés.", done),
+                                        done);
+
+          gimp_message_literal (d->image->gimp, NULL, GIMP_MESSAGE_INFO, msg);
+          g_free (msg);
+        }
+
+      g_object_unref (folder);
+      g_free (sel);
+
+      if (done < 0)
+        return;
+    }
+
+  gtk_widget_destroy (dialog);
+}
+
+static void
+export_dialog_free (ExportDialog *d)
+{
+  if (d->image)
+    g_object_remove_weak_pointer (G_OBJECT (d->image), (gpointer *) &d->image);
+  g_free (d);
+}
+
+GtkWidget *
+chopgimp_artboards_export_dialog (GimpImage   *image,
+                                  GimpContext *context,
+                                  GtkWidget   *parent)
+{
+  ExportDialog *d = g_new0 (ExportDialog, 1);
+  GtkWidget    *dialog, *grid, *w;
+  GFile        *file;
+  gchar        *base;
+  gint          row = 0;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  d->image   = image;
+  d->context = context;
+  g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &d->image);
+
+  dialog = gimp_dialog_new (_("Exporter les plans de travail"),
+                            "chopgimp-export-artboards",
+                            parent, 0,
+                            gimp_standard_help_func, GIMP_HELP_FILE_EXPORT_AS,
+                            _("_Annuler"),  GTK_RESPONSE_CANCEL,
+                            _("_Exporter"), GTK_RESPONSE_OK,
+                            NULL);
+  gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_OK);
+  g_object_set_data_full (G_OBJECT (dialog), "chopgimp-export", d,
+                          (GDestroyNotify) export_dialog_free);
+  g_signal_connect (dialog, "response", G_CALLBACK (export_response), d);
+
+  grid = gtk_grid_new ();
+  gtk_grid_set_row_spacing (GTK_GRID (grid), 6);
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 8);
+  gtk_container_set_border_width (GTK_CONTAINER (grid), 12);
+  gtk_box_pack_start (GTK_BOX (gtk_dialog_get_content_area (GTK_DIALOG (dialog))),
+                      grid, TRUE, TRUE, 0);
+
+  /*  folder: the one of the image  */
+  d->folder = gtk_file_chooser_button_new (_("Dossier d'exportation"),
+                                           GTK_FILE_CHOOSER_ACTION_SELECT_FOLDER);
+  file = gimp_image_get_any_file (image);
+  if (file)
+    {
+      GFile *dir = g_file_get_parent (file);
+
+      if (dir)
+        {
+          gtk_file_chooser_set_current_folder_file (GTK_FILE_CHOOSER (d->folder), dir, NULL);
+          g_object_unref (dir);
+        }
+    }
+  else
+    {
+      gtk_file_chooser_set_current_folder (GTK_FILE_CHOOSER (d->folder), g_get_home_dir ());
+    }
+  gimp_grid_attach_aligned (GTK_GRID (grid), 0, row++, _("Dossier :"), 0.0, 0.5,
+                            d->folder, 1);
+
+  d->format = gtk_combo_box_text_new ();
+  for (gint i = 0; i < (gint) G_N_ELEMENTS (formats); i++)
+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (d->format), _(formats[i][1]));
+  gtk_combo_box_set_active (GTK_COMBO_BOX (d->format), 0);
+  gimp_grid_attach_aligned (GTK_GRID (grid), 0, row++, _("Format :"), 0.0, 0.5,
+                            d->format, 1);
+
+  /*  prefix: the image's name  */
+  d->prefix = gtk_entry_new ();
+  base = file ? g_file_get_basename (file) : g_strdup (_("Sans titre"));
+  if (strrchr (base, '.'))
+    *strrchr (base, '.') = '\0';
+  {
+    gchar *prefix = g_strdup_printf ("%s-", base);
+
+    gtk_entry_set_text (GTK_ENTRY (d->prefix), prefix);
+    g_free (prefix);
+  }
+  g_free (base);
+  gimp_grid_attach_aligned (GTK_GRID (grid), 0, row++, _("Préfixe :"), 0.0, 0.5,
+                            d->prefix, 1);
+
+  d->range = gtk_entry_new ();
+  gtk_entry_set_placeholder_text (GTK_ENTRY (d->range), _("Tous (ou : 1-3, 5)"));
+  gimp_grid_attach_aligned (GTK_GRID (grid), 0, row++, _("Plans :"), 0.0, 0.5,
+                            d->range, 1);
+
+  w = gtk_label_new (_("Un fichier par plan de travail : <préfixe><nom du plan>.<format>. "
+                       "Le contenu hors du canevas est transparent (JPEG : aplati)."));
+  gtk_label_set_xalign (GTK_LABEL (w), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (w), TRUE);
+  gimp_label_set_attributes (GTK_LABEL (w), PANGO_ATTR_SCALE, PANGO_SCALE_SMALL, -1);
+  gtk_grid_attach (GTK_GRID (grid), w, 0, row++, 2, 1);
+
+  gtk_widget_show_all (dialog);
+
+  return dialog;
+}
+
+
+/*  ─── construction ──────────────────────────────────────────────────── */
+
+static void
+panel_free (Panel *p)
+{
+  panel_set_image (p, NULL);
+
+  if (p->idle_id)
+    g_source_remove (p->idle_id);
+  p->idle_id = 0;
+
+  g_signal_handlers_disconnect_by_data (p->context, p);
+  g_free (p);
+}
+
+static GtkWidget *
+add_button (Panel       *p,
+            const gchar *icon,
+            const gchar *tip,
+            GCallback    callback)
+{
+  GtkWidget *b = gimp_editor_add_button (GIMP_EDITOR (p->editor), icon, tip, NULL,
+                                         NULL, NULL, NULL);
+
+  g_signal_connect (b, "clicked", callback, p);
+
+  return b;
+}
+
+GtkWidget *
+chopgimp_artboards_panel_new (GimpDialogFactory *factory,
+                              GimpContext       *context,
+                              GimpUIManager     *ui_manager,
+                              gint               view_size)
+{
+  Panel     *p      = g_new0 (Panel, 1);
+  GtkWidget *editor = g_object_new (GIMP_TYPE_EDITOR, NULL);
+  GtkWidget *box    = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  GtkWidget *scrolled;
+
+  p->gimp    = context->gimp;
+  p->editor  = editor;
+  p->context = gimp_get_user_context (context->gimp);
+
+  gtk_container_set_border_width (GTK_CONTAINER (box), 6);
+  gtk_box_pack_start (GTK_BOX (editor), box, TRUE, TRUE, 0);
+
+  g_object_set_data_full (G_OBJECT (editor), "chopgimp-panel", p,
+                          (GDestroyNotify) panel_free);
+
+  p->empty = gtk_label_new (_("Aucun plan de travail. Outil Plan de travail (Maj+O) : "
+                              "faites glisser sur le canevas, ou « Nouveau »."));
+  gtk_label_set_line_wrap (GTK_LABEL (p->empty), TRUE);
+  gtk_label_set_xalign (GTK_LABEL (p->empty), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (p->empty), "dim-label");
+  gtk_box_pack_start (GTK_BOX (box), p->empty, FALSE, FALSE, 0);
+  gtk_widget_set_no_show_all (p->empty, TRUE);
+
+  scrolled = gtk_scrolled_window_new (NULL, NULL);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled),
+                                  GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_box_pack_start (GTK_BOX (box), scrolled, TRUE, TRUE, 0);
+
+  p->list = gtk_list_box_new ();
+  gtk_list_box_set_selection_mode (GTK_LIST_BOX (p->list), GTK_SELECTION_SINGLE);
+  gtk_list_box_set_activate_on_single_click (GTK_LIST_BOX (p->list), FALSE);
+  g_signal_connect (p->list, "row-selected", G_CALLBACK (row_selected), p);
+  g_signal_connect (p->list, "row-activated", G_CALLBACK (row_activated), p);
+  gtk_container_add (GTK_CONTAINER (scrolled), p->list);
+
+  gtk_widget_show_all (box);
+
+  p->buttons[B_NEW]      = add_button (p, GIMP_ICON_DOCUMENT_NEW,
+                                       _("Nouveau plan de travail (à droite des autres)"),
+                                       G_CALLBACK (new_clicked));
+  p->buttons[B_DUP]      = add_button (p, GIMP_ICON_OBJECT_DUPLICATE,
+                                       _("Dupliquer le plan de travail"),
+                                       G_CALLBACK (dup_clicked));
+  p->buttons[B_DEL]      = add_button (p, GIMP_ICON_EDIT_DELETE,
+                                       _("Supprimer le plan de travail"),
+                                       G_CALLBACK (delete_clicked));
+  p->buttons[B_UP]       = add_button (p, GIMP_ICON_GO_UP,
+                                       _("Monter (ordre des pages et de l'exportation)"),
+                                       G_CALLBACK (up_clicked));
+  p->buttons[B_DOWN]     = add_button (p, GIMP_ICON_GO_DOWN,
+                                       _("Descendre"),
+                                       G_CALLBACK (down_clicked));
+  p->buttons[B_RENAME]   = add_button (p, GIMP_ICON_EDIT,
+                                       _("Renommer (double-clic)"),
+                                       G_CALLBACK (rename_clicked));
+  p->buttons[B_SHOW]     = add_button (p, GIMP_ICON_ZOOM_FIT_BEST,
+                                       _("Afficher le plan de travail dans la fenêtre"),
+                                       G_CALLBACK (show_clicked));
+  p->buttons[B_FROM_SEL] = add_button (p, GIMP_ICON_SELECTION,
+                                       _("Plan de travail d'après la sélection (sinon les "
+                                         "calques sélectionnés)"),
+                                       G_CALLBACK (from_selection_clicked));
+  p->buttons[B_FIT]      = add_button (p, GIMP_ICON_IMAGE,
+                                       _("Agrandir le canevas pour contenir tous les plans"),
+                                       G_CALLBACK (fit_clicked));
+  p->buttons[B_EXPORT]   = add_button (p, GIMP_ICON_DOCUMENT_SAVE_AS,
+                                       _("Exporter les plans de travail…"),
+                                       G_CALLBACK (export_clicked));
+
+  g_signal_connect (p->context, "image-changed",
+                    G_CALLBACK (panel_image_changed), p);
+
+  panel_set_image (p, gimp_context_get_image (p->context));
+  panel_refresh (p);
+
+  return editor;
+}
