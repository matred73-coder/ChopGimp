+/*  Illustrator's « Attacher au plan actif » / « Libérer de la
+ *  perspective »: the selected objects of the vector layer, else the
+ *  selected layers, keep their look
+ */
+static void
+pgrid_attach (GimpImage *image,
+              gint       plane)
+{
+  GimpVectorLayer *vl  = chopgimp_vobjects_get_target_layer (image);
+  const guint     *ids = NULL;
+  gint             n   = 0;
+
+  if (vl)
+    ids = chopgimp_vlayer_get_selection (vl, &n);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC,
+                               plane ? _("Attacher au plan actif")
+                                     : _("Libérer de la perspective"));
+
+  if (vl && n > 0)
+    {
+      for (gint i = 0; i < n; i++)
+        chopgimp_pgrid_item_set_plane (GIMP_ITEM (vl), ids[i], plane, TRUE);
+    }
+  else
+    {
+      for (GList *l = gimp_image_get_selected_layers (image); l; l = l->next)
+        chopgimp_pgrid_item_set_plane (l->data, 0, plane, TRUE);
+    }
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+}
+
+void
+view_perspective_attach_cmd_callback (GimpAction *action,
+                                      GVariant   *value,
+                                      gpointer    data)
+{
+  GimpImage *image;
+  gint       plane;
+  return_if_no_image (image, data);
+
+  plane = chopgimp_pgrid_get_active_plane (image);
+
+  if (plane == CHOPGIMP_PLANE_NONE)
+    {
+      gimp_message_literal (image->gimp, NULL, GIMP_MESSAGE_WARNING,
+                            _("Affichez la grille de perspective et choisissez un plan "
+                              "actif (1, 2 ou 3)."));
+      return;
+    }
+
+  pgrid_attach (image, plane);
+}
+
+void
+view_perspective_release_cmd_callback (GimpAction *action,
