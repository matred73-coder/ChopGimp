diff --git a/app/tools/gimppainttool-paint.c b/app/tools/gimppainttool-paint.c
index 4a929d4..1f24b44 100644
--- a/app/tools/gimppainttool-paint.c
+++ b/app/tools/gimppainttool-paint.c
@@ -197,6 +197,38 @@ chopgimp_paint_flush_projection (GimpImage *image)
     gimp_projection_flush_now (projection, TRUE);
 }
 
+/*  ChopGimp: « Effets à la fin du trait ». Pendant le trait, les effets
+ *  (filtres non destructifs) du calque peint sont court-circuités dans
+ *  son graphe GEGL (gimp_drawable_set_filters_bypass) : ni les filtres,
+ *  ni l'historique, ni l'état « modifié » de l'image ne sont touchés. Ils
+ *  sont rétablis et rendus une seule fois au relâchement. Les bascules
+ *  se font hors de gimp_drawable_start_paint()/end_paint() pour que la
+ *  mise à jour couvre l'étendue des effets au-delà du calque.
+ */
+static void
+chopgimp_defer_filters_begin (GimpPaintTool    *paint_tool,
+                              GimpPaintOptions *paint_options,
+                              GList            *drawables)
+{
+  GList *iter;
+
+  /*  a previous stroke not properly finished  */
+  gimp_paint_tool_paint_restore_filters (paint_tool);
+
+  if (! paint_options->defer_filters)
+    return;
+
+  for (iter = drawables; iter; iter = g_list_next (iter))
+    {
+      GimpDrawable *drawable = iter->data;
+
+      if (gimp_drawable_set_filters_bypass (drawable, TRUE))
+        paint_tool->deferred_drawables =
+          g_list_prepend (paint_tool->deferred_drawables,
+                          g_object_ref (drawable));
+    }
+}
+
 static gboolean
 gimp_paint_tool_paint_timeout (GimpPaintTool *paint_tool)
 {
@@ -323,6 +355,9 @@ gimp_paint_tool_paint_start (GimpPaintTool     *paint_tool,
   paint_tool->paint_x = curr_coords.x;
   paint_tool->paint_y = curr_coords.y;
 
+  /*  ChopGimp: bypass the painted layers' effects, before paint mode  */
+  chopgimp_defer_filters_begin (paint_tool, paint_options, drawables);
+
   /*  If we use a separate paint thread, enter paint mode before starting the
    *  paint core
    */
@@ -343,6 +378,8 @@ gimp_paint_tool_paint_start (GimpPaintTool     *paint_tool,
         gimp_drawable_end_paint (iter->data);
       g_list_free (drawables);
 
+      gimp_paint_tool_paint_restore_filters (paint_tool);
+
       return FALSE;
     }
 
@@ -509,6 +546,29 @@ gimp_paint_tool_paint_end (GimpPaintTool *paint_tool,
 
   paint_tool->display = NULL;
   g_clear_pointer (&paint_tool->drawables, g_list_free);
+
+  /*  ChopGimp: effects back, rendered once (after paint mode is left, so
+   *  the whole extent of the effects is updated; the undo step of the
+   *  stroke is already pushed and never saw the bypass anyway)
+   */
+  gimp_paint_tool_paint_restore_filters (paint_tool);
+}
+
+void
+gimp_paint_tool_paint_restore_filters (GimpPaintTool *paint_tool)
+{
+  GList *list;
+  GList *iter;
+
+  g_return_if_fail (GIMP_IS_PAINT_TOOL (paint_tool));
+
+  list = paint_tool->deferred_drawables;
+  paint_tool->deferred_drawables = NULL;
+
+  for (iter = list; iter; iter = g_list_next (iter))
+    gimp_drawable_set_filters_bypass (iter->data, FALSE);
+
+  g_list_free_full (list, g_object_unref);
 }
 
 gboolean
