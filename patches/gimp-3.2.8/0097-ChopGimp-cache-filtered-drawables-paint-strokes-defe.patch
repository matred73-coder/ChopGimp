   gimp_drawable_update_bounding_box (drawable);
 }
 
+/*  ChopGimp: filtered-output cache  */
+
+/*  only real (non-destructive) drawable filters count here,
+ *  not e.g. the floating selection filter
+ */
+static gboolean
+gimp_drawable_has_active_drawable_filters (GimpDrawable *drawable)
+{
+  GList *list;
+
+  for (list = GIMP_LIST (drawable->private->filter_stack)->queue->head;
+       list;
+       list = g_list_next (list))
+    {
+      GimpFilter *filter = list->data;
+
+      if (GIMP_IS_DRAWABLE_FILTER (filter) &&
+          gimp_filter_get_active (filter))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+static void
+gimp_drawable_filters_cache_sync (GimpDrawable *drawable)
+{
+  gboolean enable;
+
+  if (! drawable->private->source_node ||
+      ! drawable->private->filters_cache_node)
+    return;
+
+  /*  no point in caching the raw buffer while the filters are bypassed  */
+  enable = (! drawable->private->filters_bypass &&
+            gimp_drawable_has_active_drawable_filters (drawable));
+
+  if (enable != drawable->private->filters_cache_enabled)
+    {
+      /*  free the cached tiles when going back to a nop (the node keeps
+       *  its GeglCache, which stays invalidated by GEGL in the meantime);
+       *  switching the operation invalidates downstream
+       */
+      if (! enable)
+        {
+          GeglOperation *operation;
+
+          operation =
+            gegl_node_get_gegl_operation (drawable->private->filters_cache_node);
+
+          if (operation)
+            gegl_operation_invalidate (operation, NULL, TRUE);
+        }
+
+      gegl_node_set (drawable->private->filters_cache_node,
+                     "operation", enable ? "gegl:cache" : "gegl:nop",
+                     NULL);
+
+      drawable->private->filters_cache_enabled = enable;
+    }
+}
+
+static void
+gimp_drawable_filters_bypass_relink (GimpDrawable *drawable)
+{
+  GeglNode *filter;
+  GeglNode *producer = NULL;
+
+  if (! drawable->private->source_node ||
+      ! drawable->private->filters_cache_node)
+    return;
+
+  filter = gimp_filter_stack_get_graph (GIMP_FILTER_STACK (drawable->private->filter_stack));
+
+  if (drawable->private->filters_bypass)
+    producer = gegl_node_get_producer (filter, "input", NULL);
+
+  /*  gegl_node_link() replaces the previous connection of the cache
+   *  node's input and invalidates downstream
+   */
+  gegl_node_link (producer ? producer : filter,
+                  drawable->private->filters_cache_node);
+}
+
+static void
+gimp_drawable_filters_cache_stack_changed (GimpDrawable *drawable,
+                                           GimpObject   *filter)
+{
+  gimp_drawable_filters_cache_sync (drawable);
+}
+
+static void
+gimp_drawable_filters_cache_active_changed (GimpFilter   *filter,
+                                            GimpDrawable *drawable)
+{
+  gimp_drawable_filters_cache_sync (drawable);
+}
+
 static gint64
 gimp_drawable_real_estimate_memsize (GimpDrawable      *drawable,
                                      GimpComponentType  component_type,
@@ -1803,9 +1932,30 @@ gimp_drawable_get_source_node (GimpDrawable *drawable)
 
   gegl_node_link (source, filter);
 
+  /*  ChopGimp: cache node right after the filter stack, i.e. before the
+   *  layer offset/mask/opacity/mode compositing. It is a gegl:nop while
+   *  the drawable has no active filter and becomes a gegl:cache as soon
+   *  as it has one, so that the (expensive) filtered output of layers
+   *  which did not change is not recomputed whenever another region of
+   *  the projection is re-rendered (e.g. while painting on another
+   *  layer). GEGL invalidation (buffer "changed", filter property
+   *  notify, relinks) propagates through it and clears the cached
+   *  region.
+   */
+  drawable->private->filters_cache_node =
+    gegl_node_new_child (drawable->private->source_node,
+                         "operation", "gegl:nop",
+                         NULL);
+  drawable->private->filters_cache_enabled = FALSE;
+
+  gegl_node_link (filter, drawable->private->filters_cache_node);
+
   output = gegl_node_get_output_proxy (drawable->private->source_node, "output");
 
-  gegl_node_link (filter, output);
+  gegl_node_link (drawable->private->filters_cache_node, output);
+
+  gimp_drawable_filters_bypass_relink (drawable);
+  gimp_drawable_filters_cache_sync (drawable);
 
   if (gimp_drawable_get_floating_sel (drawable))
     _gimp_drawable_add_floating_sel_filter (drawable);
@@ -1824,6 +1974,54 @@ gimp_drawable_get_mode_node (GimpDrawable *drawable)
   return drawable->private->mode_node;
 }
 
+/*  ChopGimp: "effects at the end of the stroke". Returns TRUE if the
+ *  bypass state changed. Bypassing is only done for drawables which have
+ *  active drawable filters and no floating selection. The whole drawable
+ *  (bounding box including the effects' extent) is updated, so call this
+ *  outside of gimp_drawable_start_paint()/end_paint() to get the effects'
+ *  area outside of the layer bounds updated too.
+ */
+gboolean
+gimp_drawable_set_filters_bypass (GimpDrawable *drawable,
+                                  gboolean      bypass)
+{
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), FALSE);
+
+  bypass = bypass ? TRUE : FALSE;
+
+  if (bypass == drawable->private->filters_bypass)
+    return FALSE;
+
+  if (bypass &&
+      (gimp_drawable_get_floating_sel (drawable) ||
+       ! gimp_drawable_has_active_drawable_filters (drawable)))
+    return FALSE;
+
+  drawable->private->filters_bypass = bypass;
+
+  gimp_drawable_filters_bypass_relink (drawable);
+  gimp_drawable_filters_cache_sync (drawable);
+
+  /*  when bypassing, the cached bounding box is left as is (it still
+   *  includes the effects' extent), so the update below clears the
+   *  effects outside of the layer too
+   */
+  if (! bypass)
+    gimp_drawable_update_bounding_box (drawable);
+
+  gimp_drawable_update (drawable, 0, 0, -1, -1);
+
+  return TRUE;
+}
+
+gboolean
+gimp_drawable_get_filters_bypass (GimpDrawable *drawable)
+{
+  g_return_val_if_fail (GIMP_IS_DRAWABLE (drawable), FALSE);
+
+  return drawable->private->filters_bypass;
+}
+
 GeglRectangle
 gimp_drawable_get_bounding_box (GimpDrawable *drawable)
 {
