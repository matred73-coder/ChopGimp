+/*  ─── text ──────────────────────────────────────────────────────────── */
+
+static void
+ed_str (GString *s, const gchar *utf8)
+{
+  glong      n = 0;
+  gunichar2 *u = g_utf8_to_utf16 (utf8 ? utf8 : "", -1, NULL, &n, NULL);
+  glong      i;
+
+  g_string_append (s, "(\xfe\xff");
+  for (i = 0; i < n; i++)
+    {
+      guint8 c[2] = { u[i] >> 8, u[i] & 0xff };
+      gint   j;
+
+      for (j = 0; j < 2; j++)
+        {
+          if (c[j] == '(' || c[j] == ')' || c[j] == '\\')
+            g_string_append_c (s, '\\');
+          g_string_append_c (s, c[j]);
+        }
+    }
+  g_string_append_c (s, ')');
+  g_free (u);
+}
+
+static void
+ed_num (GString     *s,
+        const gchar *fmt,
+        gdouble      v)
+{
+  gchar b[G_ASCII_DTOSTR_BUF_SIZE];
+
+  g_string_append (s, g_ascii_formatd (b, sizeof (b), fmt, v));
+}
+
+/*  PostScript name: family and style without spaces, "-" between  */
+static gchar *
+ps_font_name (const gchar *fname)
+{
+  static const gchar *styles[] = { "Bold", "Italic", "Oblique", "Light", "Medium",
+                                   "Black", "Regular", "Book", "Thin", "Semibold",
+                                   "Heavy", "Condensed", NULL };
+  gchar   **words = g_strsplit (fname && *fname ? fname : "ArialMT", " ", -1);
+  GString  *ps    = g_string_new (NULL);
+  gint      n     = g_strv_length (words);
+
+  for (gint i = 0; i < n; i++)
+    {
+      if (i > 0 && g_strv_contains (styles, words[i]) &&
+          ! (i > 1 && g_strv_contains (styles, words[i - 1])))
+        g_string_append_c (ps, '-');
+      g_string_append (ps, words[i]);
+    }
+  g_strfreev (words);
+
+  return g_string_free (ps, FALSE);
+}
+
+typedef struct
+{
+  gint    length;           /*  UTF-16 units  */
+  gint    font;             /*  index in the font set  */
+  gdouble size;
+  gdouble rgba[4];
+} TextRun;
+
+/*  the style runs of the text (markup: one run per change of font, size
+ *  or color), UTF-16 lengths; the fonts in @fonts
+ */
+static GArray *
+text_runs (const gchar   *text,
+           PangoAttrList *attrs,
+           const gchar   *base_font,
+           gdouble        base_size,
+           gdouble        size_scale,
+           const gdouble  base_rgba[4],
+           GPtrArray     *fonts)
+{
+  GArray *runs = g_array_new (FALSE, FALSE, sizeof (TextRun));
+  gint    len  = strlen (text);
+  gint    pos  = 0;
+
+  while (pos < len)
+    {
+      TextRun               r   = { 0, 0, base_size, { 0 } };
+      gint                  end = len;
+      gchar                *fname = g_strdup (base_font);
+      gchar                *ps;
+      glong                 units = 0;
+      gunichar2            *u16;
+      guint                 i;
+
+      memcpy (r.rgba, base_rgba, sizeof (r.rgba));
+
+      if (attrs)
+        {
+          PangoAttrIterator    *it   = pango_attr_list_get_iterator (attrs);
+          PangoFontDescription *desc = pango_font_description_new ();
+          PangoAttribute       *fg;
+
+          do
+            {
+              gint s, e;
+
+              pango_attr_iterator_range (it, &s, &e);
+              if (pos >= s && pos < e)
+                {
+                  pango_attr_iterator_get_font (it, desc, NULL, NULL);
+                  end = MIN (e, len);
+
+                  if (pango_font_description_get_family (desc))
+                    {
+                      GString *n = g_string_new (pango_font_description_get_family (desc));
+
+                      if (pango_font_description_get_weight (desc) >= PANGO_WEIGHT_BOLD)
+                        g_string_append (n, " Bold");
+                      if (pango_font_description_get_style (desc) != PANGO_STYLE_NORMAL)
+                        g_string_append (n, " Italic");
+                      g_free (fname);
+                      fname = g_string_free (n, FALSE);
+                    }
+                  if (pango_font_description_get_set_fields (desc) & PANGO_FONT_MASK_SIZE)
+                    r.size = pango_font_description_get_size (desc) / (gdouble) PANGO_SCALE *
+                             size_scale;
+
+                  if ((fg = pango_attr_iterator_get (it, PANGO_ATTR_FOREGROUND)))
+                    {
+                      PangoColor *pc = &((PangoAttrColor *) fg)->color;
+
+                      r.rgba[0] = pc->red   / 65535.0;
+                      r.rgba[1] = pc->green / 65535.0;
+                      r.rgba[2] = pc->blue  / 65535.0;
+                    }
+                  break;
+                }
+            }
+          while (pango_attr_iterator_next (it));
+
+          pango_font_description_free (desc);
+          pango_attr_iterator_destroy (it);
+        }
+
+      if (end <= pos)
+        end = len;
+
+      ps = ps_font_name (fname);
+      r.font = -1;
+      for (i = 0; i < fonts->len; i++)
+        if (! strcmp (g_ptr_array_index (fonts, i), ps))
+          r.font = i;
+      if (r.font < 0)
+        {
+          r.font = fonts->len;
+          g_ptr_array_add (fonts, ps);
+        }
+      else
+        {
+          g_free (ps);
+        }
+
+      u16 = g_utf8_to_utf16 (text + pos, end - pos, NULL, &units, NULL);
+      g_free (u16);
+      r.length = units;
+
+      /*  one run with the previous one when nothing changes  */
+      if (runs->len > 0)
+        {
+          TextRun *p = &g_array_index (runs, TextRun, runs->len - 1);
+
+          if (p->font == r.font && p->size == r.size && ! memcmp (p->rgba, r.rgba, sizeof (r.rgba)))
+            {
+              p->length += r.length;
+              r.length = 0;
+            }
+        }
+      if (r.length > 0)
+        g_array_append_val (runs, r);
+
+      g_free (fname);
+      pos = end;
+    }
+
+  return runs;
+}
+
+static void
+ed_paragraph_props (GString *ed,
+                    gint     just,
+                    gdouble  indent)
+{
+  g_string_append_printf (ed, "<< /Justification %d /FirstLineIndent ", just);
+  ed_num (ed, "%.3f", indent);
+  g_string_append (ed, " /StartIndent 0.0 /EndIndent 0.0 /SpaceBefore 0.0 /SpaceAfter 0.0"
+                   " /AutoHyphenate true /HyphenatedWordSize 6 /PreHyphen 2 /PostHyphen 2"
+                   " /ConsecutiveHyphens 8 /Zone 36.0 /WordSpacing [ .8 1.0 1.33 ]"
+                   " /LetterSpacing [ 0.0 0.0 0.0 ] /GlyphSpacing [ 1.0 1.0 1.0 ]"
+                   " /AutoLeading 1.2 /LeadingType 0 /Hanging false /Burasagari false"
+                   " /KinsokuOrder 0 /EveryLineComposer false >>");
+}
+
+static void
+ed_style_data (GString       *ed,
+               gint           font,
+               gdouble        size,
+               gdouble        tracking,
+               gdouble        leading,
+               const gdouble  rgba[4])
+{
+  g_string_append_printf (ed, "<< /Font %d /FontSize ", font);
+  ed_num (ed, "%.4f", size);
+  g_string_append (ed, " /FauxBold false /FauxItalic false");
+  if (leading > 0)
+    {
+      g_string_append (ed, " /AutoLeading false /Leading ");
+      ed_num (ed, "%.4f", leading);
+    }
+  else
+    {
+      g_string_append (ed, " /AutoLeading true /Leading 0.0");
+    }
+  g_string_append (ed, " /HorizontalScale 1.0 /VerticalScale 1.0 /Tracking ");
+  ed_num (ed, "%.0f", tracking);
+  g_string_append (ed, " /AutoKerning true /Kerning 0 /BaselineShift 0.0 /FontCaps 0"
+                   " /FontBaseline 0 /Underline false /Strikethrough false /Ligatures true"
+                   " /DLigatures false /BaselineDirection 2 /Tsume 0.0 /StyleRunAlignment 2"
+                   " /Language 0 /NoBreak false /FillColor << /Type 1 /Values [ 1.0 ");
+  ed_num (ed, "%.5f", CLAMP (rgba[0], 0, 1)); g_string_append_c (ed, ' ');
+  ed_num (ed, "%.5f", CLAMP (rgba[1], 0, 1)); g_string_append_c (ed, ' ');
+  ed_num (ed, "%.5f", CLAMP (rgba[2], 0, 1));
+  g_string_append (ed, " ] >> /StrokeColor << /Type 1 /Values [ 1.0 0.0 0.0 0.0 ] >>"
+                   " /FillFlag true /StrokeFlag false /FillFirst true /YUnderline 1"
+                   " /OutlineWidth 1.0 /CharacterDirection 0 /HindiNumbers false"
+                   " /Kashida 1 /DiacriticPos 2 >>");
+}
+
+static void
+ed_resources (GString     *ed,
+              GPtrArray   *fonts,
+              gint         just)
+{
+  static const gdouble black[4] = { 0, 0, 0, 1 };
+
+  g_string_append (ed, "<< /KinsokuSet [ ] /MojiKumiSet [ ] /TheNormalStyleSheet 0"
+                   " /TheNormalParagraphSheet 0 /ParagraphSheetSet [ << /Name ");
+  ed_str (ed, "Normal RGB");
+  g_string_append (ed, " /DefaultStyleSheet 0 /Properties ");
+  ed_paragraph_props (ed, just, 0.0);
+  g_string_append (ed, " >> ] /StyleSheetSet [ << /Name ");
+  ed_str (ed, "Normal RGB");
+  g_string_append (ed, " /StyleSheetData ");
+  ed_style_data (ed, 0, 12.0, 0, 0, black);
+  g_string_append (ed, " >> ] /FontSet [ ");
+  for (guint i = 0; i < fonts->len; i++)
+    {
+      g_string_append (ed, "<< /Name ");
+      ed_str (ed, g_ptr_array_index (fonts, i));
+      g_string_append (ed, " /Script 0 /FontType 1 /Synthetic 0 >> ");
+    }
+  /*  Photoshop also lists AdobeInvisFont  */
+  g_string_append (ed, "<< /Name ");
+  ed_str (ed, "AdobeInvisFont");
+  g_string_append (ed, " /Script 0 /FontType 0 /Synthetic 0 >> ] /SuperscriptSize 0.583"
+                   " /SuperscriptPosition 0.333 /SubscriptSize 0.583 /SubscriptPosition 0.333"
+                   " /SmallCapSize 0.7 >>");
+}
+
+/*  cgTX: the text layer as ChopGimp has it  */
+static gboolean
+write_cgtx (GOutputStream *output,
+            GimpLayer     *layer,
+            GError       **error)
+{
+  GimpTextLayer *tl   = GIMP_TEXT_LAYER (layer);
+  GString       *s    = g_string_new (NULL);
+  GByteArray    *b    = g_byte_array_new ();
+  gchar         *text = gimp_text_layer_get_text (tl);
+  gchar         *mk   = gimp_text_layer_get_markup (tl);
+  GimpFont      *font = gimp_text_layer_get_font (tl);
+  GimpUnit      *unit = NULL;
+  gdouble        size = gimp_text_layer_get_font_size (tl, &unit);
+  GeglColor     *col  = gimp_text_layer_get_color (tl);
+  gdouble        rgba[4] = { 0, 0, 0, 1 };
+  gchar          num[G_ASCII_DTOSTR_BUF_SIZE];
+  gint           x, y;
+  gchar         *e;
+  gboolean       ok;
+
+  if (col)
+    gegl_color_get_pixel (col, babl_format ("R'G'B'A double"), rgba);
+  gimp_drawable_get_offsets (GIMP_DRAWABLE (layer), &x, &y);
+
+#define KV(k, v) G_STMT_START { e = cg_escape (v); g_string_append_printf (s, "%s=%s\n", k, e); g_free (e); } G_STMT_END
+#define KN(k, v) g_string_append_printf (s, "%s=%s\n", k, g_ascii_dtostr (num, sizeof (num), (v)))
+
+  KV ("text", text);
+  KV ("markup", mk);
+  {
+    gchar *fname = font ? gimp_resource_get_name (GIMP_RESOURCE (font)) : NULL;
+
+    KV ("font", fname ? fname : "");
+    g_free (fname);
+  }
+  KN ("size", size);
+  KV ("unit", unit ? gimp_unit_get_abbreviation (unit) : "px");
+  g_string_append_printf (s, "color=%s,", g_ascii_dtostr (num, sizeof (num), rgba[0]));
+  g_string_append_printf (s, "%s,", g_ascii_dtostr (num, sizeof (num), rgba[1]));
+  g_string_append_printf (s, "%s,", g_ascii_dtostr (num, sizeof (num), rgba[2]));
+  g_string_append_printf (s, "%s\n", g_ascii_dtostr (num, sizeof (num), rgba[3]));
+  g_string_append_printf (s, "justify=%d\n", (gint) gimp_text_layer_get_justification (tl));
+  KN ("letter-spacing", gimp_text_layer_get_letter_spacing (tl));
+  KN ("line-spacing", gimp_text_layer_get_line_spacing (tl));
+  KN ("indent", gimp_text_layer_get_indent (tl));
+  g_string_append_printf (s, "direction=%d\n", (gint) gimp_text_layer_get_base_direction (tl));
+  g_string_append_printf (s, "x=%d\ny=%d\nw=%d\nh=%d\n", x, y,
+                          gimp_drawable_get_width (GIMP_DRAWABLE (layer)),
+                          gimp_drawable_get_height (GIMP_DRAWABLE (layer)));
+
+#undef KV
+#undef KN
+
+  g_byte_array_append (b, (const guint8 *) s->str, s->len);
+  ok = write_block (output, "cgTX", b, error);
+
+  g_byte_array_free (b, TRUE);
+  g_string_free (s, TRUE);
+  g_clear_object (&col);
+  g_free (text);
+  g_free (mk);
+
+  return ok;
+}
+
+/*  TySh: a Photoshop type layer (point text), its EngineData complete
+ *  enough for Photoshop to edit it; NULL reason: written, otherwise why not
+ */
+static const gchar *
+write_text (GOutputStream *output,
+            GimpImage     *image,
+            GimpLayer     *layer,
+            gboolean      *ok,
+            GError       **error)
+{
+  GimpTextLayer *tl    = GIMP_TEXT_LAYER (layer);
+  gchar         *text  = gimp_text_layer_get_text (tl);
+  gchar         *mk    = NULL;
+  GimpFont      *font  = gimp_text_layer_get_font (tl);
+  GimpUnit      *unit  = NULL;
+  gdouble        size  = gimp_text_layer_get_font_size (tl, &unit);
+  GeglColor     *color = gimp_text_layer_get_color (tl);
+  gdouble        rgba[4] = { 0, 0, 0, 1 };
+  gdouble        scale = 1.0;
+  PangoAttrList *attrs = NULL;
+  GPtrArray     *fonts = g_ptr_array_new_with_free_func (g_free);
+  GArray        *runs;
+  gint           x, y, just;
+  gchar         *ps_text;
+  GString       *ed;
+  GByteArray    *b;
+  Desc           d;
+  gdouble        top, tracking, leading;
+  glong          n_units = 0;
+
+  *ok = TRUE;
+
+  switch (gimp_text_layer_get_base_direction (tl))
+    {
+    case GIMP_TEXT_DIRECTION_LTR:
+    case GIMP_TEXT_DIRECTION_RTL:
+      break;
+    default:
+      g_free (text);
+      g_clear_object (&color);
+      g_ptr_array_free (fonts, TRUE);
+      return "texte vertical";
+    }
+
+  if (gimp_text_layer_get_outline (tl) != GIMP_TEXT_OUTLINE_NONE)
+    {
+      g_free (text);
+      g_clear_object (&color);
+      g_ptr_array_free (fonts, TRUE);
+      return "texte au contour";
+    }
+
+  if (! text)        /*  rich text (markup): runs of styles  */
+    {
+      mk = gimp_text_layer_get_markup (tl);
+
+      if (! mk || ! pango_parse_markup (mk, -1, 0, &attrs, &text, NULL, NULL))
+        {
+          g_free (mk);
+          g_clear_object (&color);
+          g_ptr_array_free (fonts, TRUE);
+          return "mise en forme illisible";
+        }
+    }
+
+  if (color)
+    gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), rgba);
+
+  /*  the size may be in points, mm…: EngineData and the bounds want pixels  */
+  if (unit && unit != gimp_unit_pixel ())
+    {
+      gdouble xres, yres;
+
+      gimp_image_get_resolution (image, &xres, &yres);
+      scale = gimp_units_to_pixels (1.0, unit, yres);
+      size *= scale;
+    }
+
+  switch (gimp_text_layer_get_justification (tl))
+    {
+    case GIMP_TEXT_JUSTIFY_RIGHT:  just = 1; break;
+    case GIMP_TEXT_JUSTIFY_CENTER: just = 2; break;
+    case GIMP_TEXT_JUSTIFY_FILL:   just = 3; break;
+    default:                       just = 0; break;
+    }
+
+  ps_text = g_strdup_printf ("%s\r", text);
+  g_strdelimit (ps_text, "\n", '\r');
+
+  /*  runs count UTF-16 code units, like Photoshop; the final \r is in
+   *  the last run
+   */
+  {
+    gunichar2 *u16 = g_utf8_to_utf16 (ps_text, -1, NULL, &n_units, NULL);
+
+    g_free (u16);
+  }
+
+  {
+    gchar *fname = font ? gimp_resource_get_name (GIMP_RESOURCE (font)) : NULL;
+
+    runs = text_runs (ps_text, attrs, fname, size, scale, rgba, fonts);
+    g_free (fname);
+  }
+  {
+    gint total = 0;
+
+    for (guint i = 0; i < runs->len; i++)
+      total += g_array_index (runs, TextRun, i).length;
+    if (runs->len && total != n_units)
+      g_array_index (runs, TextRun, runs->len - 1).length += n_units - total;
+  }
+
+  /*  letter spacing in 1/1000 em, line spacing added to the auto leading  */
+  tracking = size > 0 ? gimp_text_layer_get_letter_spacing (tl) * scale * 1000.0 / size : 0.0;
+  leading  = gimp_text_layer_get_line_spacing (tl) != 0.0 ?
+             size * 1.2 + gimp_text_layer_get_line_spacing (tl) * scale : 0.0;
+
+  ed = g_string_new ("\n\n<<\n\t/EngineDict\n\t<<\n\t\t/Editor << /Text ");
+  ed_str (ed, ps_text);
+  g_string_append (ed, " >>\n\t\t/ParagraphRun\n\t\t<<\n\t\t\t/DefaultRunData << /ParagraphSheet"
+                   " << /DefaultStyleSheet 0 /Properties << >> >> /Adjustments << /Axis"
+                   " [ 1.0 0.0 1.0 ] /XY [ 0.0 0.0 ] >> >>\n\t\t\t/RunArray [ ");
+
+  /*  one paragraph run per paragraph  */
+  {
+    GString *lens = g_string_new (NULL);
+    gint     start = 0;
+
+    for (glong i = 0, u = 0; ps_text[i]; i = g_utf8_next_char (ps_text + i) - ps_text)
+      {
+        gunichar ch = g_utf8_get_char (ps_text + i);
+
+        u += ch > 0xffff ? 2 : 1;
+        if (ch == '\r')
+          {
+            g_string_append (ed, "<< /ParagraphSheet << /DefaultStyleSheet 0 /Properties ");
+            ed_paragraph_props (ed, just, gimp_text_layer_get_indent (tl) * scale);
+            g_string_append (ed, " >> /Adjustments << /Axis [ 1.0 0.0 1.0 ] /XY [ 0.0 0.0 ] >> >> ");
+            g_string_append_printf (lens, "%ld ", u - start);
+            start = u;
+          }
+      }
+
+    g_string_append_printf (ed, "]\n\t\t\t/RunLengthArray [ %s]\n\t\t\t/IsJoinable 1\n\t\t>>\n"
+                            "\t\t/StyleRun\n\t\t<<\n\t\t\t/DefaultRunData << /StyleSheet"
+                            " << /StyleSheetData << >> >> >>\n\t\t\t/RunArray [ ", lens->str);
+    g_string_free (lens, TRUE);
+  }
+
+  for (guint i = 0; i < runs->len; i++)
+    {
+      TextRun *r = &g_array_index (runs, TextRun, i);
+
+      g_string_append (ed, "<< /StyleSheet << /StyleSheetData ");
+      ed_style_data (ed, r->font, r->size, tracking, leading, r->rgba);
+      g_string_append (ed, " >> >> ");
+    }
+
+  g_string_append (ed, "]\n\t\t\t/RunLengthArray [ ");
+  for (guint i = 0; i < runs->len; i++)
+    g_string_append_printf (ed, "%d ", g_array_index (runs, TextRun, i).length);
+
+  g_string_append (ed, "]\n\t\t\t/IsJoinable 2\n\t\t>>\n\t\t/GridInfo << /GridIsOn false"
+                   " /ShowGrid false /GridSize 18.0 /GridLeading 22.0 /GridColor << /Type 1"
+                   " /Values [ 0.0 0.0 0.0 1.0 ] >> /GridLeadingFillColor << /Type 1 /Values"
+                   " [ 0.0 0.0 0.0 1.0 ] >> /AlignLineHeightToGridFlags false >>\n"
+                   "\t\t/AntiAlias 4\n\t\t/UseFractionalGlyphWidths true\n"
+                   "\t\t/Rendered << /Version 1 /Shapes << /WritingDirection 0 /Children [ <<"
+                   " /ShapeType 0 /Procession 0 /Lines << /WritingDirection 0 /Children [ ] >>"
+                   " /Cookie << /Photoshop << /ShapeType 0 /PointBase [ 0.0 0.0 ] /Base <<"
+                   " /ShapeType 0 /TransformPoint0 [ 1.0 0.0 ] /TransformPoint1 [ 0.0 1.0 ]"
+                   " /TransformPoint2 [ 0.0 0.0 ] >> >> >> >> ] >> >>\n\t>>\n\t/ResourceDict\n\t");
+  ed_resources (ed, fonts, just);
+  g_string_append (ed, "\n\t/DocumentResources\n\t");
+  ed_resources (ed, fonts, just);
+  g_string_append (ed, "\n>>\n");
+
+  gimp_drawable_get_offsets (GIMP_DRAWABLE (layer), &x, &y);
+  top = -size;     /*  baseline of the first line, about one size down  */
+
+  b = g_byte_array_new ();
+  put16 (b, 1);
+  put_double (b, 1.0); put_double (b, 0.0); put_double (b, 0.0); put_double (b, 1.0);
+  put_double (b, x);
+  put_double (b, y - top);
+  put16 (b, 50);
+  put32 (b, 16);
+
+  d = d_new ();
+  d_text (&d, "Txt ", ps_text);
+  d_enum (&d, "textGridding", "textGridding", "None");
+  d_enum (&d, "Ornt", "Ornt", "Hrzn");
+  d_enum (&d, "AntA", "Annt", "antiAliasSharp");
+  {
+    Desc bd = d_new ();
+
+    d_unit (&bd, "Left", "#Pnt", 0.0);
+    d_unit (&bd, "Top ", "#Pnt", top);
+    d_unit (&bd, "Rght", "#Pnt", gimp_drawable_get_width (GIMP_DRAWABLE (layer)));
+    d_unit (&bd, "Btom", "#Pnt", gimp_drawable_get_height (GIMP_DRAWABLE (layer)) + top);
+    d_obj (&d, "bounds", "bounds", &bd);
+  }
+  {
+    Desc bb = d_new ();
+
+    d_unit (&bb, "Left", "#Pnt", 0.0);
+    d_unit (&bb, "Top ", "#Pnt", top);
+    d_unit (&bb, "Rght", "#Pnt", gimp_drawable_get_width (GIMP_DRAWABLE (layer)));
+    d_unit (&bb, "Btom", "#Pnt", gimp_drawable_get_height (GIMP_DRAWABLE (layer)) + top);
+    d_obj (&d, "boundingBox", "boundingBox", &bb);
+  }
+  d_long (&d, "TextIndex", 0);
+  put_key (d.b, "EngineData");
+  put_raw (d.b, "tdta");
+  put32 (d.b, ed->len);
+  g_byte_array_append (d.b, (const guint8 *) ed->str, ed->len);
+  d.n++;
+  d_emit (b, "TxLr", &d);
+
+  put16 (b, 1);                 /*  warp: none  */
+  put32 (b, 16);
+  d = d_new ();
+  d_enum (&d, "warpStyle", "warpStyle", "warpNone");
+  d_doub (&d, "warpValue", 0.0);
+  d_doub (&d, "warpPerspective", 0.0);
+  d_doub (&d, "warpPerspectiveOther", 0.0);
+  d_enum (&d, "warpRotate", "Ornt", "Hrzn");
+  d_emit (b, "warp", &d);
+  put32 (b, x);
+  put32 (b, y);
+  put32 (b, x + gimp_drawable_get_width (GIMP_DRAWABLE (layer)));
+  put32 (b, y + gimp_drawable_get_height (GIMP_DRAWABLE (layer)));
+
+  *ok = write_block (output, "TySh", b, error);
+
+  g_byte_array_free (b, TRUE);
+  g_string_free (ed, TRUE);
+  g_array_free (runs, TRUE);
+  g_ptr_array_free (fonts, TRUE);
+  if (attrs)
+    pango_attr_list_unref (attrs);
+  g_free (ps_text);
+  g_free (text);
+  g_free (mk);
+  g_clear_object (&color);
+
+  return NULL;
+}
+
+
+/*  ─── per layer ─────────────────────────────────────────────────────── */
+
+gboolean
+chopgimp_psd_write_editable (GOutputStream *output,
+                             GimpImage     *image,
+                             GimpLayer     *layer,
+                             ChopPsd       *ctx,
+                             gboolean       shapes,
+                             gboolean       texts,
+                             GError       **error)
+{
+  GimpItem  *item = GIMP_ITEM (layer);
+  ChopLayer *cl   = ctx ? g_hash_table_lookup (ctx->layers,
+                                               GUINT_TO_POINTER (gimp_item_get_tattoo (item)))
+                        : NULL;
+  gboolean   ok   = TRUE;
+
+  /*  effects  */
+  if (cl && cl->fx.n > 0)
+    {
+      GByteArray *b = g_byte_array_new ();
+      Desc        d = d_new ();
+
+      d_unit (&d, "Scl ", "#Prc", 100.0);
+      d_bool (&d, "masterFXSwitch", TRUE);
+      g_byte_array_append (d.b, cl->fx.items->data, cl->fx.items->len);
+      d.n += cl->fx.n;
+
+      put32 (b, 0);             /*  object effects version  */
+      put32 (b, 16);            /*  descriptor version  */
+      d_emit (b, "null", &d);
+      ok = write_block (output, "lfx2", b, error);
+      g_byte_array_free (b, TRUE);
+    }
+
+  if (ok && cl && cl->cgfx && cl->cgfx->len)
+    {
+      GByteArray *b = g_byte_array_new ();
+
+      put_raw (b, cl->cgfx->str);
+      ok = write_block (output, "cgFX", b, error);
+      g_byte_array_free (b, TRUE);
+    }
+
+  if (ok && cl && cl->cgpx)
+    {
+      GByteArray *b = g_byte_array_new ();
+
+      put_raw (b, cl->cgpx);
+      ok = write_block (output, "cgPX", b, error);
+      g_byte_array_free (b, TRUE);
+    }
+
+  if (! ok)
+    return FALSE;
+
+  if (gimp_item_is_vector_layer (item) &&
+      ! gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)))
+    {
+      gchar *xml;
+
+      chopgimp_psd_is_shape (ctx, layer, TRUE);         /*  fetches the objects  */
+      xml = ctx ? g_strdup (chop_layer (ctx, item)->xml) : vobjects_xml (layer);
+
+      if (xml)
+        {
+          /*  the objects are always kept for ChopGimp (cgVX); the shape
+           *  layer or the vector mask for Photoshop when asked
+           */
+          if (shapes)
+            {
+              ok = write_vobjects (output, image, layer, xml, ctx, error);
+            }
+          else
+            {
+              GByteArray *x = g_byte_array_new ();
+
+              put_raw (x, xml);
+              ok = write_block (output, "cgVX", x, error);
+              g_byte_array_free (x, TRUE);
+            }
+          g_free (xml);
+          return ok;
+        }
+
+      return shapes ? write_shape (output, image, layer, error) : TRUE;
+    }
+
+  if (gimp_item_is_text_layer (item) &&
+      ! gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)))
+    {
+      ok = write_cgtx (output, layer, error);
+
+      if (ok && texts)
+        {
+          const gchar *why = write_text (output, image, layer, &ok, error);
+
+          if (why && ctx)
+            report_line (ctx, item, "texte exporté en pixels (%s) ; le texte reste dans le "
+                         "calque pour ChopGimp", why);
+        }
+    }
+
+  return ok;
+}
