+/* ChopGimp — PSD export of editable layers (see psd-chopgimp.c) */
+
+#ifndef __PSD_CHOPGIMP_H__
+#define __PSD_CHOPGIMP_H__
+
+typedef struct _ChopPsd ChopPsd;
+
+/*  after the composite is made, before the layers are listed: converts
+ *  the layer styles (@styles), pixelizes or merges the other filters,
+ *  turns the gradient overlays into effects; changes @image (a copy)
+ */
+ChopPsd     * chopgimp_psd_prepare        (GimpImage     *image,
+                                           gboolean       styles);
+void          chopgimp_psd_free           (ChopPsd       *ctx);
+/*  what was approximated, pixelized or merged (one line per point)  */
+const gchar * chopgimp_psd_last_report    (void);
+
+/*  a vector layer written as a Photoshop shape layer (pixels irrelevant)  */
+gboolean      chopgimp_psd_is_shape       (ChopPsd       *ctx,
+                                           GimpLayer     *layer,
+                                           gboolean       shapes);
+
+gboolean      chopgimp_psd_write_editable (GOutputStream *output,
+                                           GimpImage     *image,
+                                           GimpLayer     *layer,
+                                           ChopPsd       *ctx,
+                                           gboolean       shapes,
+                                           gboolean       texts,
+                                           GError       **error);
+
+/*  3.32.0: after the layer info: the patterns of the pattern overlays
+ *  (global mask info + « Patt »), nothing when there are none
+ */
+gboolean      chopgimp_psd_write_patterns (GOutputStream *output,
+                                           ChopPsd       *ctx,
+                                           GError       **error);
+
+#endif
