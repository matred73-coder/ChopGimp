--- /dev/null
+++ b/plug-ins/file-psd/psd-chopgimp.c
@@ -0,0 +1,3348 @@
+/*
+ * ChopGimp — PSD export of editable layers (Photoshop-like)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * Extra layer information blocks so that Photoshop sees:
+ *  - layer effects (3.31.0, lot 4b): ChopGimp's layer styles (filters
+ *    gegl:dropshadow, gegl:inner-glow, chopgimp:stroke, gegl:bevel,
+ *    gegl:color-overlay) and the gradient overlays of chopgimp_fx as
+ *    Photoshop's effects (lfx2: DrSh, OrGl, IrSh, IrGl, FrFX, ebbl, SoFi,
+ *    GrFl); 3.32.0: chopgimp:satin → ChFX, chopgimp:pattern-overlay →
+ *    patternFill, its pattern in the document's patterns (Patt, written
+ *    by chopgimp_psd_write_patterns()); a style without equivalent is
+ *    pixelized in a layer of its own,
+ *    the other filters merged into the pixels (the original kept hidden);
+ *    everything is in the report (chopgimp_psd_last_report);
+ *  - vector layers as shape layers (vmsk + vscg SoCo / GdFl + vstk); when
+ *    one fill and one stroke cannot draw all the objects, pixels with a
+ *    vector mask;
+ *  - text layers as type layers (TySh, EngineData with style runs and
+ *    paragraphs); vertical or outlined text stays pixels.
+ * Private blocks give ChopGimp its layers back exactly (cgFX filters,
+ * cgVX objects, cgTX text, cgPX layers made by the export); Photoshop
+ * ignores them. The rendered pixels are still written, so a reader that
+ * ignores these blocks gets exactly the image.
+ * Formats: Adobe « Photoshop File Formats » (descriptor version 16, path
+ * records of 26 bytes, object based effects, EngineData).
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <stdarg.h>
+#include <string.h>
+
+#include <libgimp/gimp.h>
+#include <pango/pango.h>
+
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wunused-function"
+#include "plug-ins/common/file-svg-vobjects.h"
+#pragma GCC diagnostic pop
+
+#include "psd-chopgimp.h"
+
+
+/*  big-endian byte buffer  */
+
+static void
+put32 (GByteArray *b, guint32 v)
+{
+  guint8 d[4] = { v >> 24, v >> 16, v >> 8, v };
+
+  g_byte_array_append (b, d, 4);
+}
+
+static void
+put16 (GByteArray *b, guint16 v)
+{
+  guint8 d[2] = { v >> 8, v };
+
+  g_byte_array_append (b, d, 2);
+}
+
+static void
+put_double (GByteArray *b, gdouble v)
+{
+  union { gdouble d; guint64 u; } x = { .d = v };
+  guint8 d[8];
+  gint   i;
+
+  for (i = 0; i < 8; i++)
+    d[i] = x.u >> (56 - 8 * i);
+  g_byte_array_append (b, d, 8);
+}
+
+static void
+put_raw (GByteArray *b, const gchar *s)
+{
+  g_byte_array_append (b, (const guint8 *) s, strlen (s));
+}
+
+static void
+put_key (GByteArray *b, const gchar *k)
+{
+  if (strlen (k) == 4)
+    {
+      put32 (b, 0);
+      put_raw (b, k);
+    }
+  else
+    {
+      put32 (b, strlen (k));
+      put_raw (b, k);
+    }
+}
+
+static void
+put_ustr (GByteArray *b, const gchar *utf8)
+{
+  glong      n = 0;
+  gunichar2 *u = g_utf8_to_utf16 (utf8 ? utf8 : "", -1, NULL, &n, NULL);
+  glong      i;
+
+  put32 (b, n + 1);
+  for (i = 0; i < n; i++)
+    put16 (b, u[i]);
+  put16 (b, 0);
+  g_free (u);
+}
+
+/*  descriptor items  */
+
+static void
+desc_begin (GByteArray *b, const gchar *cls, gint n_items)
+{
+  put_ustr (b, "");
+  put_key (b, cls);
+  put32 (b, n_items);
+}
+
+static void
+item_bool (GByteArray *b, const gchar *k, gboolean v)
+{
+  guint8 c = v ? 1 : 0;
+
+  put_key (b, k);
+  put_raw (b, "bool");
+  g_byte_array_append (b, &c, 1);
+}
+
+static void
+item_long (GByteArray *b, const gchar *k, gint32 v)
+{
+  put_key (b, k);
+  put_raw (b, "long");
+  put32 (b, v);
+}
+
+static void
+item_doub (GByteArray *b, const gchar *k, gdouble v)
+{
+  put_key (b, k);
+  put_raw (b, "doub");
+  put_double (b, v);
+}
+
+static void
+item_unit (GByteArray *b, const gchar *k, const gchar *unit, gdouble v)
+{
+  put_key (b, k);
+  put_raw (b, "UntF");
+  put_raw (b, unit);
+  put_double (b, v);
+}
+
+static void
+item_enum (GByteArray *b, const gchar *k, const gchar *type, const gchar *v)
+{
+  put_key (b, k);
+  put_raw (b, "enum");
+  put_key (b, type);
+  put_key (b, v);
+}
+
+static void
+item_text (GByteArray *b, const gchar *k, const gchar *v)
+{
+  put_key (b, k);
+  put_raw (b, "TEXT");
+  put_ustr (b, v);
+}
+
+static gboolean
+write_block (GOutputStream *output,
+             const gchar   *key,
+             GByteArray    *data,
+             GError       **error)
+{
+  GByteArray *head = g_byte_array_new ();
+  gboolean    ok;
+
+  if (data->len & 1)
+    {
+      guint8 z = 0;
+
+      g_byte_array_append (data, &z, 1);
+    }
+  put_raw (head, "8BIM");
+  put_raw (head, key);
+  put32 (head, data->len);
+
+  ok = g_output_stream_write_all (output, head->data, head->len, NULL, NULL, error) &&
+       g_output_stream_write_all (output, data->data, data->len, NULL, NULL, error);
+
+  g_byte_array_free (head, TRUE);
+  return ok;
+}
+
+
+
+/*  ─── descriptors with a counted list of items ──────────────────────── */
+
+typedef struct
+{
+  GByteArray *b;
+  gint        n;
+} Desc;
+
+static Desc
+d_new (void)
+{
+  Desc d = { g_byte_array_new (), 0 };
+
+  return d;
+}
+
+static void d_bool (Desc *d, const gchar *k, gboolean v)       { item_bool (d->b, k, v); d->n++; }
+static void d_long (Desc *d, const gchar *k, gint32 v)         { item_long (d->b, k, v); d->n++; }
+static void d_doub (Desc *d, const gchar *k, gdouble v)        { item_doub (d->b, k, v); d->n++; }
+static void d_text (Desc *d, const gchar *k, const gchar *v)   { item_text (d->b, k, v); d->n++; }
+static void d_unit (Desc *d, const gchar *k, const gchar *u, gdouble v)
+{
+  item_unit (d->b, k, u, v);
+  d->n++;
+}
+static void d_enum (Desc *d, const gchar *k, const gchar *t, const gchar *v)
+{
+  item_enum (d->b, k, t, v);
+  d->n++;
+}
+
+/*  the descriptor @sub (consumed) as the object @k of class @cls  */
+static void
+d_obj (Desc        *d,
+       const gchar *k,
+       const gchar *cls,
+       Desc        *sub)
+{
+  put_key (d->b, k);
+  put_raw (d->b, "Objc");
+  desc_begin (d->b, cls, sub->n);
+  g_byte_array_append (d->b, sub->b->data, sub->b->len);
+  g_byte_array_free (sub->b, TRUE);
+  sub->b = NULL;
+  d->n++;
+}
+
+static void
+d_rgb (Desc          *d,
+       const gchar   *k,
+       const gdouble  rgba[4])
+{
+  Desc c = d_new ();
+
+  d_doub (&c, "Rd  ", CLAMP (rgba[0], 0, 1) * 255.0);
+  d_doub (&c, "Grn ", CLAMP (rgba[1], 0, 1) * 255.0);
+  d_doub (&c, "Bl  ", CLAMP (rgba[2], 0, 1) * 255.0);
+  d_obj (d, k, "RGBC", &c);
+}
+
+/*  a list (VlLs) of @n objects of class @cls (consumed)  */
+static void
+d_objs (Desc        *d,
+        const gchar *k,
+        const gchar *cls,
+        Desc        *items,
+        gint         n)
+{
+  put_key (d->b, k);
+  put_raw (d->b, "VlLs");
+  put32 (d->b, n);
+  for (gint i = 0; i < n; i++)
+    {
+      put_raw (d->b, "Objc");
+      desc_begin (d->b, cls, items[i].n);
+      g_byte_array_append (d->b, items[i].b->data, items[i].b->len);
+      g_byte_array_free (items[i].b, TRUE);
+      items[i].b = NULL;
+    }
+  d->n++;
+}
+
+/*  @d (consumed) as a whole descriptor of class @cls  */
+static void
+d_emit (GByteArray  *out,
+        const gchar *cls,
+        Desc        *d)
+{
+  desc_begin (out, cls, d->n);
+  g_byte_array_append (out, d->b->data, d->b->len);
+  g_byte_array_free (d->b, TRUE);
+  d->b = NULL;
+}
+
+
+
+/*  ─── reading the settings of a filter ──────────────────────────────── */
+
+static GParamSpec *
+fx_spec (GObject     *c,
+         const gchar *p)
+{
+  return c ? g_object_class_find_property (G_OBJECT_GET_CLASS (c), p) : NULL;
+}
+
+static gdouble
+fx_num (GObject     *c,
+        const gchar *p,
+        gdouble      def)
+{
+  GParamSpec *ps = fx_spec (c, p);
+  GValue      v  = G_VALUE_INIT;
+  GValue      d  = G_VALUE_INIT;
+  gdouble     r  = def;
+
+  if (! ps || ! g_value_type_transformable (ps->value_type, G_TYPE_DOUBLE))
+    return def;
+
+  g_value_init (&v, ps->value_type);
+  g_object_get_property (c, p, &v);
+  g_value_init (&d, G_TYPE_DOUBLE);
+  if (g_value_transform (&v, &d))
+    r = g_value_get_double (&d);
+  g_value_unset (&v);
+  g_value_unset (&d);
+
+  return r;
+}
+
+/*  an enum (its nick) or a string (GEGL enums reach plug-ins as choices)  */
+static gchar *
+fx_nick (GObject     *c,
+         const gchar *p)
+{
+  GParamSpec *ps = fx_spec (c, p);
+  GValue      v  = G_VALUE_INIT;
+  gchar      *r  = NULL;
+
+  if (! ps)
+    return NULL;
+
+  g_value_init (&v, ps->value_type);
+  g_object_get_property (c, p, &v);
+
+  if (G_VALUE_HOLDS_ENUM (&v))
+    {
+      GEnumClass *klass = g_type_class_ref (ps->value_type);
+      GEnumValue *ev    = g_enum_get_value (klass, g_value_get_enum (&v));
+
+      r = ev ? g_strdup (ev->value_nick) : NULL;
+      g_type_class_unref (klass);
+    }
+  else if (G_VALUE_HOLDS_STRING (&v))
+    {
+      r = g_value_dup_string (&v);
+    }
+
+  g_value_unset (&v);
+
+  return r;
+}
+
+/*  3.32.0: a boolean property (FALSE when missing)  */
+static gboolean
+fx_bool (GObject     *c,
+         const gchar *p,
+         gboolean     def)
+{
+  GParamSpec *ps = fx_spec (c, p);
+  gboolean    v  = def;
+
+  if (ps && ps->value_type == G_TYPE_BOOLEAN)
+    g_object_get (c, p, &v, NULL);
+
+  return v;
+}
+
+static gboolean
+fx_rgba (GObject     *c,
+         const gchar *p,
+         gdouble      rgba[4])
+{
+  GParamSpec *ps    = fx_spec (c, p);
+  GeglColor  *color = NULL;
+
+  if (! ps || ! g_type_is_a (ps->value_type, GEGL_TYPE_COLOR))
+    return FALSE;
+
+  g_object_get (c, p, &color, NULL);
+  if (! color)
+    return FALSE;
+
+  gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), rgba);
+  g_object_unref (color);
+
+  return TRUE;
+}
+
+/*  GEGL / GIMP blend mode nicks → Photoshop's (BlnM); NULL: none  */
+static const gchar *
+ps_blend (const gchar *nick)
+{
+  static const gchar *const map[][2] =
+  {
+    { "normal", "Nrml" }, { "dissolve", "Dslv" }, { "darken-only", "Drkn" },
+    { "multiply", "Mltp" }, { "burn", "CBrn" }, { "linear-burn", "linearBurn" },
+    { "luma-darken-only", "darkerColor" }, { "lighten-only", "Lghn" },
+    { "screen", "Scrn" }, { "dodge", "CDdg" }, { "addition", "linearDodge" },
+    { "luma-lighten-only", "lighterColor" }, { "overlay", "Ovrl" },
+    { "softlight", "SftL" }, { "hardlight", "HrdL" }, { "vivid-light", "vividLight" },
+    { "linear-light", "linearLight" }, { "pin-light", "pinLight" },
+    { "hard-mix", "hardMix" }, { "difference", "Dfrn" }, { "exclusion", "Xclu" },
+    { "subtract", "blendSubtraction" }, { "divide", "blendDivide" },
+    { "hsv-hue", "H   " }, { "lch-hue", "H   " }, { "hsv-saturation", "Strt" },
+    { "lch-chroma", "Strt" }, { "hsl-color", "Clr " }, { "lch-color", "Clr " },
+    { "hsv-value", "Lmns" }, { "lch-lightness", "Lmns" }, { "luminance", "Lmns" },
+  };
+  gchar *base;
+
+  if (! nick)
+    return NULL;
+
+  base = g_strdup (nick);
+  if (g_str_has_suffix (base, "-legacy"))
+    base[strlen (base) - 7] = '\0';
+
+  for (guint i = 0; i < G_N_ELEMENTS (map); i++)
+    if (! strcmp (base, map[i][0]))
+      {
+        g_free (base);
+        return map[i][1];
+      }
+
+  g_free (base);
+
+  return NULL;
+}
+
+static const gchar *
+ps_blend_mode (GimpLayerMode mode)
+{
+  GEnumClass  *klass = g_type_class_ref (GIMP_TYPE_LAYER_MODE);
+  GEnumValue  *ev    = g_enum_get_value (klass, mode);
+  const gchar *r     = ev ? ps_blend (ev->value_nick) : NULL;
+
+  g_type_class_unref (klass);
+
+  return r;
+}
+
+
+/*  ─── Photoshop effects (lfx2) ──────────────────────────────────────── */
+
+/*  GEGL's contour presets are Photoshop's: TrnS (MpgS for the satin) by
+ *  name
+ */
+static void
+d_contour_key (Desc        *d,
+               const gchar *key,
+               const gchar *nick)
+{
+  static const struct { const gchar *nick, *name; gint n; gdouble pts[5][2]; } c[] =
+  {
+    { "linear",        "Linear",          2, { { 0, 0 }, { 255, 255 } } },
+    { "cone",          "Cone",            3, { { 0, 0 }, { 128, 255 }, { 255, 0 } } },
+    { "cone-inverted", "Cone - Inverted", 3, { { 0, 255 }, { 128, 0 }, { 255, 255 } } },
+    { "gaussian",      "Gaussian",        4, { { 0, 0 }, { 64, 26 }, { 191, 229 }, { 255, 255 } } },
+    { "half-round",    "Half Round",      3, { { 0, 0 }, { 64, 166 }, { 255, 255 } } },
+    { "ring",          "Ring",            4, { { 0, 0 }, { 85, 255 }, { 170, 255 }, { 255, 0 } } },
+    { "ring-double",   "Ring - Double",   5, { { 0, 0 }, { 64, 255 }, { 128, 0 }, { 191, 255 }, { 255, 0 } } },
+  };
+  gint  k = 0;
+  Desc  sh;
+  Desc  pts[5];
+
+  for (guint i = 0; nick && i < G_N_ELEMENTS (c); i++)
+    if (! strcmp (nick, c[i].nick))
+      k = i;
+
+  sh = d_new ();
+  d_text (&sh, "Nm  ", c[k].name);
+  for (gint i = 0; i < c[k].n; i++)
+    {
+      pts[i] = d_new ();
+      d_doub (&pts[i], "Hrzn", c[k].pts[i][0]);
+      d_doub (&pts[i], "Vrtc", c[k].pts[i][1]);
+    }
+  d_objs (&sh, "Crv ", "CrPt", pts, c[k].n);
+  d_obj (d, key, "ShpC", &sh);
+}
+
+static void
+d_contour (Desc        *d,
+           const gchar *nick)
+{
+  d_contour_key (d, "TrnS", nick);
+}
+
+typedef struct
+{
+  GByteArray *items;        /* the effects' items of the lfx2 descriptor */
+  gint        n;
+  guint       used;         /* one effect of each kind (bit per kind)    */
+} ChopFx;
+
+enum
+{
+  FX_DRSH = 1 << 0, FX_IRSH = 1 << 1, FX_ORGL = 1 << 2, FX_IRGL = 1 << 3,
+  FX_EBBL = 1 << 4, FX_FRFX = 1 << 5, FX_SOFI = 1 << 6, FX_GRFL = 1 << 7,
+  FX_CHFX = 1 << 8, FX_PATT = 1 << 9
+};
+
+static const gchar * patt_add (ChopPsd     *ctx,
+                               const gchar *data,
+                               gchar      **name);
+
+static void
+fx_add (ChopFx      *fx,
+        const gchar *key,
+        Desc        *e)
+{
+  Desc tmp = { fx->items, 0 };
+
+  d_obj (&tmp, key, key, e);
+  fx->items = tmp.b;
+  fx->n++;
+}
+
+static void
+d_common (Desc     *e,
+          gboolean  enabled)
+{
+  d_bool (e, "enab", enabled);
+  d_bool (e, "present", TRUE);
+  d_bool (e, "showInDialog", TRUE);
+}
+
+/*  GEGL's grow + blur → Photoshop's size and spread / choke (%)  */
+static void
+size_spread (gdouble  blur,
+             gdouble  grow,
+             gdouble *size,
+             gdouble *spread)
+{
+  *size   = MAX (0.0, grow) + 2.0 * MAX (0.0, blur);
+  *spread = *size > 0.0 ? CLAMP (100.0 * MAX (0.0, grow) / *size, 0.0, 100.0) : 0.0;
+}
+
+/*  the light angle of an offset (chopgimp_fx: x = -cos a × d, y = sin a × d)  */
+static gdouble
+offset_angle (gdouble x,
+              gdouble y)
+{
+  return (x == 0.0 && y == 0.0) ? 120.0 : atan2 (y, -x) * 180.0 / G_PI;
+}
+
+/*  @report: what was approximated  */
+static gboolean
+fx_convert (ChopPsd             *ctx,
+            ChopFx              *fx,
+            GimpDrawableFilter  *f,
+            GString             *approx)
+{
+  GObject       *c       = G_OBJECT (gimp_drawable_filter_get_config (f));
+  gchar         *op      = gimp_drawable_filter_get_operation_name (f);
+  gchar         *name    = gimp_drawable_filter_get_name (f);
+  gboolean       visible = gimp_drawable_filter_get_visible (f);
+  gdouble        fop     = gimp_drawable_filter_get_opacity (f);
+  GimpLayerMode  fmode   = gimp_drawable_filter_get_blend_mode (f);
+  gboolean       ok      = FALSE;
+  gdouble        rgba[4] = { 0, 0, 0, 1 };
+  Desc           e;
+
+  if (! op)
+    {
+      g_free (name);
+      return FALSE;
+    }
+
+  if (! strcmp (op, "gegl:dropshadow"))
+    {
+      gdouble  x = fx_num (c, "x", 0), y = fx_num (c, "y", 0);
+      gdouble  blur = fx_num (c, "radius", 0), grow = fx_num (c, "grow-radius", 0);
+      gdouble  size, spread, opacity;
+      gchar   *blend   = fx_nick (c, "blend-mode");
+      gchar   *shape   = fx_nick (c, "grow-shape");
+      gchar   *contour = fx_nick (c, "contour");
+      gboolean glow    = (name && strstr (name, "Lueur")) ||
+                         (x == 0.0 && y == 0.0 && blend && ! strcmp (blend, "screen"));
+      gboolean stroke  = name && strstr (name, "Contour") && blur == 0.0 && x == 0.0 && y == 0.0;
+      guint    kind    = stroke ? FX_FRFX : glow ? FX_ORGL : FX_DRSH;
+      const gchar *md  = ps_blend (blend ? blend : "normal");
+
+      fx_rgba (c, "color", rgba);
+      opacity = fx_num (c, "opacity", 0.5) * rgba[3] * fop;
+      size_spread (blur, grow, &size, &spread);
+
+      if (! (fx->used & kind) && md && fx_num (c, "use-gradient", 0) == 0.0)
+        {
+          if (opacity > 1.0)
+            g_string_append_printf (approx, "%s : opacité %.0f %% ramenée à 100 %%\n",
+                                    name, opacity * 100);
+          if (shape && strcmp (shape, "circle"))
+            g_string_append_printf (approx, "%s : forme « %s » rendue arrondie\n", name, shape);
+
+          e = d_new ();
+          d_common (&e, visible);
+
+          if (kind == FX_FRFX)
+            {
+              d_enum (&e, "Styl", "FStl", "OutF");
+              d_enum (&e, "PntT", "FrFl", "SClr");
+              d_enum (&e, "Md  ", "BlnM", md);
+              d_unit (&e, "Opct", "#Prc", CLAMP (opacity, 0, 1) * 100.0);
+              d_unit (&e, "Sz  ", "#Pxl", grow);
+              d_rgb (&e, "Clr ", rgba);
+              d_bool (&e, "overprint", FALSE);
+              fx_add (fx, "FrFX", &e);
+            }
+          else
+            {
+              d_enum (&e, "Md  ", "BlnM", md);
+              d_rgb (&e, "Clr ", rgba);
+              d_unit (&e, "Opct", "#Prc", CLAMP (opacity, 0, 1) * 100.0);
+              if (kind == FX_DRSH)
+                {
+                  d_bool (&e, "uglg", FALSE);
+                  d_unit (&e, "lagl", "#Ang", offset_angle (x, y));
+                  d_unit (&e, "Dstn", "#Pxl", hypot (x, y));
+                }
+              else
+                {
+                  d_enum (&e, "GlwT", "BETE", "SfBL");
+                }
+              d_unit (&e, "Ckmt", "#Pxl", spread);
+              d_unit (&e, "blur", "#Pxl", size);
+              d_unit (&e, "Nose", "#Prc", CLAMP (fx_num (c, "noise", 0), 0, 1) * 100.0);
+              d_bool (&e, "AntA", FALSE);
+              d_contour (&e, contour);
+              if (kind == FX_DRSH)
+                d_bool (&e, "layerConceals", TRUE);
+              else
+                d_unit (&e, "Inpr", "#Prc", CLAMP (fx_num (c, "range", 1), 0.01, 1) * 100.0);
+              fx_add (fx, kind == FX_DRSH ? "DrSh" : "OrGl", &e);
+            }
+
+          fx->used |= kind;
+          ok = TRUE;
+        }
+
+      g_free (blend);
+      g_free (shape);
+      g_free (contour);
+    }
+  else if (! strcmp (op, "gegl:inner-glow"))
+    {
+      gdouble      x = fx_num (c, "x", 0), y = fx_num (c, "y", 0);
+      gdouble      blur = fx_num (c, "radius", 0), grow = fx_num (c, "grow-radius", 0);
+      gdouble      size, choke, opacity;
+      gchar       *contour = fx_nick (c, "contour");
+      gboolean     shadow  = (name && strstr (name, "Ombre")) || x != 0.0 || y != 0.0;
+      guint        kind    = shadow ? FX_IRSH : FX_IRGL;
+      const gchar *md      = ps_blend_mode (fmode);
+
+      fx_rgba (c, "value", rgba);
+      opacity = fx_num (c, "opacity", 1.0) * rgba[3] * fop;
+      size_spread (blur, grow, &size, &choke);
+
+      if (! (fx->used & kind) && md && fx_num (c, "use-gradient", 0) == 0.0)
+        {
+          if (opacity > 1.0)
+            g_string_append_printf (approx, "%s : opacité %.0f %% ramenée à 100 %%\n",
+                                    name, opacity * 100);
+
+          e = d_new ();
+          d_common (&e, visible);
+          d_enum (&e, "Md  ", "BlnM", md);
+          d_rgb (&e, "Clr ", rgba);
+          d_unit (&e, "Opct", "#Prc", CLAMP (opacity, 0, 1) * 100.0);
+          if (shadow)
+            {
+              d_bool (&e, "uglg", FALSE);
+              d_unit (&e, "lagl", "#Ang", offset_angle (x, y));
+              d_unit (&e, "Dstn", "#Pxl", hypot (x, y));
+            }
+          else
+            {
+              d_enum (&e, "GlwT", "BETE", "SfBL");
+            }
+          d_unit (&e, "Ckmt", "#Pxl", choke);
+          d_unit (&e, "blur", "#Pxl", size);
+          d_unit (&e, "Nose", "#Prc", CLAMP (fx_num (c, "noise", 0), 0, 1) * 100.0);
+          d_bool (&e, "AntA", FALSE);
+          d_contour (&e, contour);
+          if (! shadow)
+            {
+              d_unit (&e, "Inpr", "#Prc", CLAMP (fx_num (c, "range", 1), 0.01, 1) * 100.0);
+              d_enum (&e, "glwS", "IGSr", "SrcE");
+            }
+          fx_add (fx, shadow ? "IrSh" : "IrGl", &e);
+          fx->used |= kind;
+          ok = TRUE;
+        }
+
+      g_free (contour);
+    }
+  else if (! strcmp (op, "chopgimp:stroke"))
+    {
+      gchar       *pos   = fx_nick (c, "position");
+      gchar       *fill  = fx_nick (c, "fill-type");
+      gchar       *mode  = fx_nick (c, "mode");
+      const gchar *md    = ps_blend (mode ? mode : "normal");
+
+      fx_rgba (c, "color", rgba);
+
+      if (! (fx->used & FX_FRFX) && md && (! fill || ! strcmp (fill, "color")))
+        {
+          e = d_new ();
+          d_common (&e, visible);
+          d_enum (&e, "Styl", "FStl", (pos && ! strcmp (pos, "inside")) ? "InsF" :
+                                      (pos && ! strcmp (pos, "center")) ? "CtrF" : "OutF");
+          d_enum (&e, "PntT", "FrFl", "SClr");
+          d_enum (&e, "Md  ", "BlnM", md);
+          d_unit (&e, "Opct", "#Prc",
+                  CLAMP (fx_num (c, "opacity", 1.0) * rgba[3] * fop, 0, 1) * 100.0);
+          d_unit (&e, "Sz  ", "#Pxl", fx_num (c, "width", 3.0));
+          d_rgb (&e, "Clr ", rgba);
+          d_bool (&e, "overprint", fx_num (c, "overprint", 0) != 0.0);
+          fx_add (fx, "FrFX", &e);
+          fx->used |= FX_FRFX;
+          ok = TRUE;
+        }
+
+      g_free (pos);
+      g_free (fill);
+      g_free (mode);
+    }
+  else if (! strcmp (op, "gegl:bevel"))
+    {
+      gchar *type = fx_nick (c, "type");
+
+      if (! (fx->used & FX_EBBL))
+        {
+          static const gdouble white[4] = { 1, 1, 1, 1 }, black[4] = { 0, 0, 0, 1 };
+
+          e = d_new ();
+          d_common (&e, visible);
+          d_enum (&e, "hglM", "BlnM", "Scrn");
+          d_rgb (&e, "hglC", white);
+          d_unit (&e, "hglO", "#Prc", 75.0 * fop);
+          d_enum (&e, "sdwM", "BlnM", "Mltp");
+          d_rgb (&e, "sdwC", black);
+          d_unit (&e, "sdwO", "#Prc", 75.0 * fop);
+          d_enum (&e, "bvlT", "bvlT", (type && ! strcmp (type, "chamfer")) ? "PrBL" : "SfBL");
+          d_enum (&e, "bvlS", "BESl", "InrB");
+          d_bool (&e, "uglg", FALSE);
+          d_unit (&e, "lagl", "#Ang", fx_num (c, "azimuth", 68.0));
+          d_unit (&e, "Lald", "#Ang", fx_num (c, "elevation", 25.0));
+          d_unit (&e, "srgR", "#Prc", CLAMP (fx_num (c, "depth", 40) * 5.0, 1, 1000));
+          d_unit (&e, "blur", "#Pxl", fx_num (c, "radius", 3.0));
+          d_enum (&e, "bvlD", "BESs", "In  ");
+          d_contour (&e, "linear");
+          d_bool (&e, "antialiasGloss", FALSE);
+          d_unit (&e, "Sftn", "#Pxl", 0.0);
+          d_bool (&e, "useShape", FALSE);
+          d_bool (&e, "useTexture", FALSE);
+          fx_add (fx, "ebbl", &e);
+          fx->used |= FX_EBBL;
+          ok = TRUE;
+          g_string_append_printf (approx, "%s : biseau GEGL rendu par le biseau de Photoshop "
+                                  "(lumière et ombre à 75 %%)\n", name);
+        }
+
+      g_free (type);
+    }
+  else if (! strcmp (op, "gegl:color-overlay"))
+    {
+      const gchar *md = ps_blend_mode (fmode);
+
+      fx_rgba (c, "value", rgba);
+
+      if (! (fx->used & FX_SOFI) && md)
+        {
+          e = d_new ();
+          d_common (&e, visible);
+          d_enum (&e, "Md  ", "BlnM", md);
+          d_rgb (&e, "Clr ", rgba);
+          d_unit (&e, "Opct", "#Prc", CLAMP (rgba[3] * fop, 0, 1) * 100.0);
+          fx_add (fx, "SoFi", &e);
+          fx->used |= FX_SOFI;
+          ok = TRUE;
+        }
+    }
+  /*  3.32.0: Satin (gimpoperationinnereffects.c) → ChFX: the same
+   *  angle, distance, size, contour, invert; the stroke's mode and
+   *  opacity (the filter's own mode and opacity multiply it)
+   */
+  else if (! strcmp (op, "chopgimp:satin"))
+    {
+      gchar       *mode    = fx_nick (c, "mode");
+      gchar       *fill    = fx_nick (c, "fill-type");
+      gchar       *contour = fx_nick (c, "contour");
+      const gchar *md      = ps_blend (mode ? mode : "multiply");
+
+      fx_rgba (c, "color", rgba);
+
+      if (fmode != GIMP_LAYER_MODE_NORMAL && fmode != GIMP_LAYER_MODE_REPLACE)
+        md = NULL;
+
+      if (! (fx->used & FX_CHFX) && md && (! fill || ! strcmp (fill, "color")))
+        {
+          e = d_new ();
+          d_common (&e, visible);
+          d_enum (&e, "Md  ", "BlnM", md);
+          d_rgb (&e, "Clr ", rgba);
+          d_bool (&e, "AntA", FALSE);
+          d_bool (&e, "Invr", fx_bool (c, "invert", TRUE));
+          d_unit (&e, "Opct", "#Prc",
+                  CLAMP (fx_num (c, "opacity", 0.5) * rgba[3] * fop, 0, 1) * 100.0);
+          d_unit (&e, "lagl", "#Ang", fx_num (c, "angle", 19.0));
+          d_unit (&e, "Dstn", "#Pxl", fx_num (c, "distance", 11.0));
+          d_unit (&e, "blur", "#Pxl", fx_num (c, "size", 14.0));
+          d_contour_key (&e, "MpgS", contour);
+          fx_add (fx, "ChFX", &e);
+          fx->used |= FX_CHFX;
+          ok = TRUE;
+          g_string_append_printf (approx, "%s : contour du satin rendu par la courbe "
+                                  "nommée de Photoshop\n", name);
+        }
+
+      g_free (mode);
+      g_free (fill);
+      g_free (contour);
+    }
+  /*  3.32.0: Incrustation de motif → patternFill, its pattern added to
+   *  the document's patterns (Patt) under a stable identifier
+   */
+  else if (! strcmp (op, "chopgimp:pattern-overlay"))
+    {
+      gchar       *mode = fx_nick (c, "mode");
+      gchar       *fill = fx_nick (c, "fill-type");
+      gchar       *data = fx_nick (c, "pattern");
+      gchar       *pname = NULL;
+      const gchar *md   = ps_blend (mode ? mode : "normal");
+      const gchar *id   = NULL;
+
+      if (fmode != GIMP_LAYER_MODE_NORMAL && fmode != GIMP_LAYER_MODE_REPLACE)
+        md = NULL;
+
+      if (! (fx->used & FX_PATT) && md && fill && ! strcmp (fill, "pattern") &&
+          data && *data)
+        id = patt_add (ctx, data, &pname);
+
+      if (id)
+        {
+          Desc    ptrn = d_new ();
+          Desc    phase = d_new ();
+          gdouble angle = fx_num (c, "pattern-angle", 0.0);
+
+          d_text (&ptrn, "Nm  ", pname ? pname : "ChopGimp");
+          d_text (&ptrn, "Idnt", id);
+
+          d_doub (&phase, "Hrzn", fx_num (c, "pattern-offset-x", 0.0));
+          d_doub (&phase, "Vrtc", fx_num (c, "pattern-offset-y", 0.0));
+
+          e = d_new ();
+          d_common (&e, visible);
+          d_enum (&e, "Md  ", "BlnM", md);
+          d_unit (&e, "Opct", "#Prc",
+                  CLAMP (fx_num (c, "opacity", 1.0) * fop, 0, 1) * 100.0);
+          d_obj (&e, "Ptrn", "Ptrn", &ptrn);
+          d_unit (&e, "Scl ", "#Prc", CLAMP (fx_num (c, "pattern-scale", 100.0), 1, 1000));
+          d_bool (&e, "Algn", fx_bool (c, "align-with-layer", TRUE));
+          d_obj (&e, "phase", "Pnt ", &phase);
+          /*  Photoshop 22+: the pattern's angle (older versions ignore it)  */
+          if (angle != 0.0)
+            d_unit (&e, "Angl", "#Ang", -angle);
+          fx_add (fx, "patternFill", &e);
+          fx->used |= FX_PATT;
+          ok = TRUE;
+        }
+
+      g_free (pname);
+      g_free (mode);
+      g_free (fill);
+      g_free (data);
+    }
+
+  g_free (op);
+  g_free (name);
+
+  return ok;
+}
+
+/*  « Incrustation de dégradé » of chopgimp_fx (a clipped layer, its settings
+ *  in the « chopgimp-fx » parasite) → GrFl; Photoshop's angle turns the
+ *  other way (y up)
+ */
+static void
+fx_gradient_overlay (ChopFx        *fx,
+                     gdouble        angle,
+                     gboolean       reverse,
+                     const gdouble  c1[4],
+                     const gdouble  c2[4],
+                     gdouble        opacity,
+                     const gchar   *md)
+{
+  Desc e    = d_new ();
+  Desc grad = d_new ();
+  Desc stops[2], trns[2];
+
+  for (gint i = 0; i < 2; i++)
+    {
+      stops[i] = d_new ();
+      d_rgb (&stops[i], "Clr ", i ? c2 : c1);
+      d_enum (&stops[i], "Type", "Clry", "UsrS");
+      d_long (&stops[i], "Lctn", i ? 4096 : 0);
+      d_long (&stops[i], "Mdpn", 50);
+
+      trns[i] = d_new ();
+      d_unit (&trns[i], "Opct", "#Prc", CLAMP ((i ? c2 : c1)[3], 0, 1) * 100.0);
+      d_long (&trns[i], "Lctn", i ? 4096 : 0);
+      d_long (&trns[i], "Mdpn", 50);
+    }
+
+  d_text (&grad, "Nm  ", "ChopGimp");
+  d_enum (&grad, "GrdF", "GrdF", "CstS");
+  d_doub (&grad, "Intr", 4096.0);
+  d_objs (&grad, "Clrs", "Clrt", stops, 2);
+  d_objs (&grad, "Trns", "TrnS", trns, 2);
+
+  d_common (&e, TRUE);
+  d_enum (&e, "Md  ", "BlnM", md ? md : "Nrml");
+  d_unit (&e, "Opct", "#Prc", CLAMP (opacity, 0, 1) * 100.0);
+  d_obj (&e, "Grad", "Grdn", &grad);
+  d_unit (&e, "Angl", "#Ang", -angle);
+  d_enum (&e, "Type", "GrdT", "Lnr ");
+  d_bool (&e, "Rvrs", reverse);
+  d_bool (&e, "Dthr", FALSE);
+  d_bool (&e, "Algn", TRUE);
+  d_unit (&e, "Scl ", "#Prc", 100.0);
+  {
+    Desc ofs = d_new ();
+
+    d_unit (&ofs, "Hrzn", "#Prc", 0.0);
+    d_unit (&ofs, "Vrtc", "#Prc", 0.0);
+    d_obj (&e, "Ofst", "Pnt ", &ofs);
+  }
+
+  fx_add (fx, "GrFl", &e);
+  fx->used |= FX_GRFL;
+}
+
+
+/*  ─── private blocks (ChopGimp's way back, ignored by Photoshop) ───────
+ *
+ *  cgFX  the filters of the layer, bottom to top, one per line:
+ *        op \t name \t visible \t mode \t opacity \t k=T:v;… (T: d double,
+ *        i integer, e enum value, b boolean, s string / choice nick,
+ *        c color « r,g,b,a » R'G'B'A; values URI-escaped)
+ *  cgVX  the objects of a vector layer (chopgimp-vobjects-get-xml)
+ *  cgTX  a text layer: k=v lines (text, markup, font, size, unit, color,
+ *        justify, letter / line spacing, indent, direction, box, x, y, w, h)
+ *  cgPX  a layer made by the export (a pixelized effect, the original of
+ *        a layer whose filters were merged): « effect <tattoo> » or
+ *        « original <tattoo> »
+ */
+
+static gchar *
+cg_escape (const gchar *s)
+{
+  return g_uri_escape_string (s ? s : "", NULL, FALSE);
+}
+
+static void
+cg_filter_line (GString            *s,
+                GimpDrawableFilter *f)
+{
+  GObject      *c     = G_OBJECT (gimp_drawable_filter_get_config (f));
+  gchar        *op    = gimp_drawable_filter_get_operation_name (f);
+  gchar        *name  = gimp_drawable_filter_get_name (f);
+  gchar        *e_op  = cg_escape (op);
+  gchar        *e_nm  = cg_escape (name);
+  gchar         num[G_ASCII_DTOSTR_BUF_SIZE];
+  GParamSpec  **specs;
+  guint         n_specs = 0;
+
+  g_string_append_printf (s, "%s\t%s\t%d\t%d\t%s\t", e_op, e_nm,
+                          gimp_drawable_filter_get_visible (f) ? 1 : 0,
+                          (gint) gimp_drawable_filter_get_blend_mode (f),
+                          g_ascii_dtostr (num, sizeof (num), gimp_drawable_filter_get_opacity (f)));
+
+  specs = g_object_class_list_properties (G_OBJECT_GET_CLASS (c), &n_specs);
+
+  for (guint i = 0; i < n_specs; i++)
+    {
+      GParamSpec *ps    = specs[i];
+      GValue      v     = G_VALUE_INIT;
+      gchar      *value = NULL;
+      gchar       type  = 0;
+
+      if (ps->owner_type != G_OBJECT_TYPE (c) || ! (ps->flags & G_PARAM_READABLE))
+        continue;
+
+      g_value_init (&v, ps->value_type);
+      g_object_get_property (c, ps->name, &v);
+
+      if (G_VALUE_HOLDS_BOOLEAN (&v))
+        {
+          type  = 'b';
+          value = g_strdup (g_value_get_boolean (&v) ? "1" : "0");
+        }
+      else if (G_VALUE_HOLDS_ENUM (&v))
+        {
+          type  = 'e';
+          value = g_strdup_printf ("%d", g_value_get_enum (&v));
+        }
+      else if (G_VALUE_HOLDS_STRING (&v))
+        {
+          type  = 's';
+          value = g_value_dup_string (&v);
+        }
+      else if (G_VALUE_HOLDS (&v, GEGL_TYPE_COLOR))
+        {
+          GeglColor *color = g_value_get_object (&v);
+          gdouble    rgba[4] = { 0, 0, 0, 1 };
+          gchar      b[4][G_ASCII_DTOSTR_BUF_SIZE];
+
+          if (color)
+            gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), rgba);
+          type  = 'c';
+          value = g_strdup_printf ("%s,%s,%s,%s",
+                                   g_ascii_dtostr (b[0], sizeof (b[0]), rgba[0]),
+                                   g_ascii_dtostr (b[1], sizeof (b[1]), rgba[1]),
+                                   g_ascii_dtostr (b[2], sizeof (b[2]), rgba[2]),
+                                   g_ascii_dtostr (b[3], sizeof (b[3]), rgba[3]));
+        }
+      else if (G_VALUE_HOLDS_INT (&v) || G_VALUE_HOLDS_UINT (&v) ||
+               G_VALUE_HOLDS_INT64 (&v) || G_VALUE_HOLDS_UINT64 (&v))
+        {
+          GValue d = G_VALUE_INIT;
+
+          g_value_init (&d, G_TYPE_INT64);
+          g_value_transform (&v, &d);
+          type  = 'i';
+          value = g_strdup_printf ("%" G_GINT64_FORMAT, g_value_get_int64 (&d));
+          g_value_unset (&d);
+        }
+      else if (g_value_type_transformable (ps->value_type, G_TYPE_DOUBLE))
+        {
+          GValue d = G_VALUE_INIT;
+
+          g_value_init (&d, G_TYPE_DOUBLE);
+          g_value_transform (&v, &d);
+          type  = 'd';
+          value = g_strdup (g_ascii_dtostr (num, sizeof (num), g_value_get_double (&d)));
+          g_value_unset (&d);
+        }
+
+      if (type)
+        {
+          gchar *ev = cg_escape (value);
+
+          g_string_append_printf (s, "%s=%c:%s;", ps->name, type, ev);
+          g_free (ev);
+        }
+
+      g_free (value);
+      g_value_unset (&v);
+    }
+
+  g_string_append_c (s, '\n');
+
+  g_free (specs);
+  g_free (e_op);
+  g_free (e_nm);
+  g_free (op);
+  g_free (name);
+}
+
+
+/*  ─── preparation of the export image ──────────────────────────────── */
+
+typedef struct
+{
+  ChopFx   fx;              /* Photoshop effects                         */
+  GString *cgfx;            /* all the filters, for ChopGimp             */
+  gchar   *cgpx;            /* « effect T » / « original T »             */
+  gboolean shape_known;     /* vector layer: shape layer or not          */
+  gboolean shape;
+  gchar   *xml;             /* its objects (chopgimp-vobjects-get-xml)   */
+} ChopLayer;
+
+struct _ChopPsd
+{
+  GHashTable *layers;       /* tattoo → ChopLayer *                      */
+  GString    *report;
+  gboolean    styles;
+  GByteArray *patt;         /* 3.32.0: the patterns (Patt) of the overlays */
+  GHashTable *patt_ids;     /* MD5 of the pattern data → identifier      */
+};
+
+static GString *chop_last_report = NULL;
+
+static ChopLayer *
+chop_layer (ChopPsd  *ctx,
+            GimpItem *item)
+{
+  gpointer   key = GUINT_TO_POINTER (gimp_item_get_tattoo (item));
+  ChopLayer *cl  = g_hash_table_lookup (ctx->layers, key);
+
+  if (! cl)
+    {
+      cl = g_new0 (ChopLayer, 1);
+      cl->fx.items = g_byte_array_new ();
+      g_hash_table_insert (ctx->layers, key, cl);
+    }
+
+  return cl;
+}
+
+static void
+chop_layer_free (ChopLayer *cl)
+{
+  g_byte_array_free (cl->fx.items, TRUE);
+  if (cl->cgfx)
+    g_string_free (cl->cgfx, TRUE);
+  g_free (cl->cgpx);
+  g_free (cl->xml);
+  g_free (cl);
+}
+
+static void
+report_line (ChopPsd     *ctx,
+             GimpItem    *item,
+             const gchar *fmt,
+             ...) G_GNUC_PRINTF (3, 4);
+
+static void
+report_line (ChopPsd     *ctx,
+             GimpItem    *item,
+             const gchar *fmt,
+             ...)
+{
+  va_list  args;
+  gchar   *name = gimp_item_get_name (item);
+  gchar   *msg;
+
+  va_start (args, fmt);
+  msg = g_strdup_vprintf (fmt, args);
+  va_end (args);
+
+  g_string_append_printf (ctx->report, "« %s » : %s\n", name, msg);
+
+  g_free (msg);
+  g_free (name);
+}
+
+/*  a number after « "key": » in the JSON of a parasite (no JSON library)  */
+static gboolean
+json_num (const gchar *json,
+          const gchar *key,
+          gdouble     *values,
+          gint         n)
+{
+  gchar       *pat = g_strdup_printf ("\"%s\"", key);
+  const gchar *p   = strstr (json, pat);
+
+  g_free (pat);
+  if (! p)
+    return FALSE;
+
+  p = strchr (p + strlen (key) + 2, ':');
+  if (! p)
+    return FALSE;
+  p++;
+
+  while (*p == ' ' || *p == '[')
+    p++;
+
+  for (gint i = 0; i < n; i++)
+    {
+      gchar *end;
+
+      while (*p == ' ' || *p == ',')
+        p++;
+      if (! strncmp (p, "true", 4))
+        {
+          values[i] = 1.0;
+          end = (gchar *) p + 4;
+        }
+      else if (! strncmp (p, "false", 5))
+        {
+          values[i] = 0.0;
+          end = (gchar *) p + 5;
+        }
+      else
+        {
+          values[i] = g_ascii_strtod (p, &end);
+        }
+      if (end == p)
+        return FALSE;
+      p = end;
+    }
+
+  return TRUE;
+}
+
+/*  gradient overlays of chopgimp_fx → GrFl of their base layer; the
+ *  overlay layers leave the export image
+ */
+static void
+prepare_gradient_overlays (ChopPsd   *ctx,
+                           GimpImage *image)
+{
+  GList *layers = gimp_image_list_layers (image);
+  GList *all    = NULL;
+  GList *l;
+
+  /*  every layer, groups' children too  */
+  for (l = layers; l; l = l->next)
+    all = g_list_prepend (all, l->data);
+  for (GList *q = all; q; q = q->next)
+    if (gimp_item_is_group (q->data))
+      {
+        GimpItem **ch = gimp_item_get_children (q->data);
+
+        for (gint i = 0; ch[i]; i++)
+          all = g_list_append (all, ch[i]);
+        g_free (ch);
+      }
+
+  for (l = all; l; l = l->next)
+    {
+      GimpItem     *item = l->data;
+      GimpParasite *par  = gimp_item_get_parasite (item, "chopgimp-fx");
+      const gchar  *data;
+      guint32       size = 0;
+      gchar        *json;
+      gdouble       angle = 90, reverse = 0, c1[4] = { 0, 0, 0, 1 }, c2[4] = { 1, 1, 1, 1 };
+      gdouble       src = 0;
+      GimpLayer    *base;
+
+      if (! par)
+        continue;
+
+      data = gimp_parasite_get_data (par, &size);
+      json = g_strndup (data, size);
+
+      if (strstr (json, "chopgimp-fx-gradient-overlay") &&
+          json_num (json, "src-tattoo", &src, 1) &&
+          (base = gimp_image_get_layer_by_tattoo (image, (guint) src)) &&
+          gimp_layer_get_composite_mode (GIMP_LAYER (item)) == GIMP_LAYER_COMPOSITE_CLIP_TO_BACKDROP &&
+          gimp_item_get_visible (item))
+        {
+          ChopLayer *cl = chop_layer (ctx, GIMP_ITEM (base));
+
+          json_num (json, "angle", &angle, 1);
+          json_num (json, "reverse", &reverse, 1);
+          json_num (json, "color1", c1, 4);
+          json_num (json, "color2", c2, 4);
+
+          if (! (cl->fx.used & FX_GRFL))
+            {
+              fx_gradient_overlay (&cl->fx, angle, reverse != 0.0, c1, c2,
+                                   gimp_layer_get_opacity (GIMP_LAYER (item)) / 100.0,
+                                   ps_blend_mode (gimp_layer_get_mode (GIMP_LAYER (item))));
+              report_line (ctx, GIMP_ITEM (base),
+                           "incrustation de dégradé en style de calque (le calque écrêté "
+                           "« Incrustation de dégradé » devient l'effet)");
+              gimp_image_remove_layer (image, GIMP_LAYER (item));
+            }
+        }
+
+      g_free (json);
+      gimp_parasite_free (par);
+    }
+
+  g_list_free (all);
+  g_list_free (layers);
+}
+
+/*  filters of the styles (layer effects) and the others  */
+static gboolean
+is_style_op (const gchar *op)
+{
+  return op && (! strcmp (op, "gegl:dropshadow") || ! strcmp (op, "gegl:inner-glow") ||
+                ! strcmp (op, "chopgimp:stroke") || ! strcmp (op, "gegl:bevel") ||
+                ! strcmp (op, "gegl:color-overlay") ||
+                /*  3.32.0  */
+                ! strcmp (op, "chopgimp:satin") ||
+                ! strcmp (op, "chopgimp:pattern-overlay"));
+}
+
+static gboolean
+is_behind_op (const gchar *op)
+{
+  return op && ! strcmp (op, "gegl:dropshadow");
+}
+
+/*  a style converted (or pixelized) as an effect; otherwise merged  */
+static gboolean
+as_style (ChopPsd     *ctx,
+          const gchar *op)
+{
+  return ctx->styles && is_style_op (op);
+}
+
+/*  a copy of @layer with its filter @keep only, merged; inserted under
+ *  @layer (@below) or above it, clipped; → the copy
+ */
+static GimpLayer *
+pixelize_effect (ChopPsd    *ctx,
+                 GimpImage  *image,
+                 GimpLayer  *layer,
+                 gint        keep,
+                 gboolean    below,
+                 const gchar *label)
+{
+  GimpLayer           *dup    = gimp_layer_copy (layer);
+  GimpItem            *parent = gimp_item_get_parent (GIMP_ITEM (layer));
+  gint                 pos    = gimp_image_get_item_position (image, GIMP_ITEM (layer));
+  GimpDrawableFilter **fl;
+  gchar               *lname  = gimp_item_get_name (GIMP_ITEM (layer));
+  gchar               *name   = g_strdup_printf ("%s — %s (pixellisé)", lname, label);
+  ChopLayer           *cl;
+
+  gimp_image_insert_layer (image, dup, GIMP_LAYER (parent), below ? pos + 1 : pos);
+
+  fl = gimp_drawable_get_filters (GIMP_DRAWABLE (dup));
+  for (gint i = 0; fl && fl[i]; i++)
+    if (i != keep)
+      gimp_drawable_filter_delete (fl[i]);
+  g_free (fl);
+
+  gimp_drawable_merge_filters (GIMP_DRAWABLE (dup));
+  gimp_item_set_name (GIMP_ITEM (dup), name);
+  if (! below)
+    gimp_layer_set_composite_mode (dup, GIMP_LAYER_COMPOSITE_CLIP_TO_BACKDROP);
+
+  cl = chop_layer (ctx, GIMP_ITEM (dup));
+  g_free (cl->cgpx);
+  cl->cgpx = g_strdup_printf ("effect %u", gimp_item_get_tattoo (GIMP_ITEM (layer)));
+
+  g_free (name);
+  g_free (lname);
+
+  return dup;
+}
+
+static void
+prepare_layer (ChopPsd   *ctx,
+               GimpImage *image,
+               GimpLayer *layer)
+{
+  GimpItem            *item  = GIMP_ITEM (layer);
+  GimpDrawableFilter **fl    = gimp_drawable_get_filters (GIMP_DRAWABLE (layer));
+  gint                 n     = 0;
+  gboolean             group = gimp_item_is_group (item);
+  gboolean            *conv;
+  gboolean             any_generic = FALSE;
+  ChopLayer           *cl;
+  GString             *approx;
+
+  while (fl && fl[n])
+    n++;
+
+  if (group)
+    {
+      GimpItem **ch = gimp_item_get_children (item);
+
+      for (gint i = 0; ch[i]; i++)
+        prepare_layer (ctx, image, GIMP_LAYER (ch[i]));
+      g_free (ch);
+    }
+
+  if (n == 0)
+    {
+      g_free (fl);
+      return;
+    }
+
+  cl     = chop_layer (ctx, item);
+  conv   = g_new0 (gboolean, n);
+  approx = g_string_new (NULL);
+
+  /*  all of them for ChopGimp, bottom to top  */
+  cl->cgfx = g_string_new (NULL);
+  for (gint i = n - 1; i >= 0; i--)
+    cg_filter_line (cl->cgfx, fl[i]);
+
+  /*  Photoshop's effects, bottom to top  */
+  for (gint i = n - 1; i >= 0; i--)
+    {
+      gchar *op = gimp_drawable_filter_get_operation_name (fl[i]);
+
+      if (as_style (ctx, op))
+        conv[i] = fx_convert (ctx, &cl->fx, fl[i], approx);
+      else if (gimp_drawable_filter_get_visible (fl[i]))
+        any_generic = TRUE;
+
+      g_free (op);
+    }
+
+  if (approx->len)
+    {
+      gchar **lines = g_strsplit (approx->str, "\n", -1);
+
+      for (gint i = 0; lines[i] && *lines[i]; i++)
+        report_line (ctx, item, "%s (approché)", lines[i]);
+      g_strfreev (lines);
+    }
+
+  if (group)
+    {
+      /*  Photoshop has group effects; the other filters of a group stay
+       *  for ChopGimp only (cgFX)
+       */
+      for (gint i = 0; i < n; i++)
+        if (! conv[i] && gimp_drawable_filter_get_visible (fl[i]))
+          {
+            gchar *name = gimp_drawable_filter_get_name (fl[i]);
+
+            report_line (ctx, item, "filtre de groupe « %s » sans équivalent Photoshop "
+                         "(gardé pour ChopGimp, absent de Photoshop)", name);
+            g_free (name);
+          }
+    }
+  else
+    {
+      /*  styles without equivalent: each one pixelized in a layer of its own  */
+      for (gint i = 0; i < n; i++)
+        {
+          gchar *op = gimp_drawable_filter_get_operation_name (fl[i]);
+
+          if (! conv[i] && as_style (ctx, op) && gimp_drawable_filter_get_visible (fl[i]))
+            {
+              gchar *name = gimp_drawable_filter_get_name (fl[i]);
+
+              pixelize_effect (ctx, image, layer, i, is_behind_op (op), name);
+              report_line (ctx, item, "effet « %s » sans équivalent Photoshop : pixellisé "
+                           "dans un calque séparé", name);
+              g_free (name);
+            }
+          g_free (op);
+        }
+
+      /*  other filters (blur, colors…): merged into the pixels; the
+       *  original (hidden) keeps the layer for ChopGimp
+       */
+      if (any_generic)
+        {
+          GimpLayer           *orig   = gimp_layer_copy (layer);
+          GimpItem            *parent = gimp_item_get_parent (item);
+          gint                 pos    = gimp_image_get_item_position (image, item);
+          GimpDrawableFilter **ofl;
+          ChopLayer           *ocl;
+          gchar               *lname  = gimp_item_get_name (item);
+          gchar               *oname  = g_strdup_printf ("%s ⟲ original", lname);
+          GString             *names  = g_string_new (NULL);
+
+          gimp_image_insert_layer (image, orig, GIMP_LAYER (parent), pos + 1);
+          ofl = gimp_drawable_get_filters (GIMP_DRAWABLE (orig));
+          for (gint i = 0; ofl && ofl[i]; i++)
+            gimp_drawable_filter_delete (ofl[i]);
+          g_free (ofl);
+          gimp_item_set_name (GIMP_ITEM (orig), oname);
+          gimp_item_set_visible (GIMP_ITEM (orig), FALSE);
+
+          ocl = chop_layer (ctx, GIMP_ITEM (orig));
+          ocl->cgpx = g_strdup_printf ("original %u", gimp_item_get_tattoo (item));
+
+          /*  the styles are effects (or layers of their own): only the
+           *  other visible filters are merged
+           */
+          for (gint i = 0; i < n; i++)
+            {
+              gchar *op = gimp_drawable_filter_get_operation_name (fl[i]);
+
+              if (as_style (ctx, op) || ! gimp_drawable_filter_get_visible (fl[i]))
+                {
+                  gimp_drawable_filter_delete (fl[i]);
+                }
+              else
+                {
+                  gchar *name = gimp_drawable_filter_get_name (fl[i]);
+
+                  g_string_append_printf (names, "%s« %s »", names->len ? ", " : "", name);
+                  g_free (name);
+                }
+              g_free (op);
+            }
+          gimp_drawable_merge_filters (GIMP_DRAWABLE (layer));
+
+          report_line (ctx, item, "filtres %s fusionnés dans les pixels (l'original, masqué, "
+                       "est gardé pour ChopGimp)", names->str);
+
+          g_string_free (names, TRUE);
+          g_free (oname);
+          g_free (lname);
+        }
+    }
+
+  g_string_free (approx, TRUE);
+  g_free (conv);
+  g_free (fl);
+}
+
+ChopPsd *
+chopgimp_psd_prepare (GimpImage *image,
+                      gboolean   styles)
+{
+  ChopPsd    *ctx = g_new0 (ChopPsd, 1);
+  GimpLayer **layers;
+
+  ctx->layers = g_hash_table_new_full (NULL, NULL, NULL, (GDestroyNotify) chop_layer_free);
+  ctx->report = g_string_new (NULL);
+  ctx->styles = styles;
+
+  if (styles)
+    prepare_gradient_overlays (ctx, image);
+
+  layers = gimp_image_get_layers (image);
+  for (gint i = 0; layers[i]; i++)
+    prepare_layer (ctx, image, layers[i]);
+  g_free (layers);
+
+  if (! chop_last_report)
+    chop_last_report = g_string_new (NULL);
+  g_string_assign (chop_last_report, ctx->report->str);
+
+  return ctx;
+}
+
+void
+chopgimp_psd_free (ChopPsd *ctx)
+{
+  if (! ctx)
+    return;
+
+  g_hash_table_destroy (ctx->layers);
+  g_string_free (ctx->report, TRUE);
+  if (ctx->patt)
+    g_byte_array_free (ctx->patt, TRUE);
+  if (ctx->patt_ids)
+    g_hash_table_destroy (ctx->patt_ids);
+  g_free (ctx);
+}
+
+const gchar *
+chopgimp_psd_last_report (void)
+{
+  return chop_last_report ? chop_last_report->str : "";
+}
+
+
+/*  ─── 3.32.0: patterns of the « Incrustation de motif » (Patt) ─────────
+ *
+ *  The overlay stores its pattern as base64 of a zlib-compressed GIMP
+ *  .pat file (app/propgui/gimppropgui-layer-style.c); Photoshop finds the
+ *  pattern of a patternFill effect by its identifier among the patterns
+ *  of the document: the « Patt » block after the layers (Adobe « Photoshop
+ *  File Formats »: pattern, version 1, RGB, then a virtual memory array
+ *  list of 24 channels + user mask (the alpha) + sheet mask, raw 8 bits).
+ */
+
+static guint32
+be32 (const guchar *p)
+{
+  return ((guint32) p[0] << 24) | ((guint32) p[1] << 16) | ((guint32) p[2] << 8) | p[3];
+}
+
+/*  → RGBA 8 bits (width × height × 4), NULL if unreadable  */
+static guchar *
+pat_decode (const gchar *data,
+            gint        *width,
+            gint        *height,
+            gchar      **name)
+{
+  guchar        *z;
+  gsize          nz;
+  GInputStream  *mem;
+  GInputStream  *in;
+  GConverter    *dec;
+  GByteArray    *raw = g_byte_array_new ();
+  guchar         buf[16384];
+  gssize         r;
+  guchar        *rgba = NULL;
+  guint32        hsize, version, w, h, bpp;
+
+  z = g_base64_decode (data, &nz);
+  if (! z || nz == 0)
+    {
+      g_free (z);
+      g_byte_array_free (raw, TRUE);
+      return NULL;
+    }
+
+  mem = g_memory_input_stream_new_from_data (z, nz, g_free);
+  dec = G_CONVERTER (g_zlib_decompressor_new (G_ZLIB_COMPRESSOR_FORMAT_ZLIB));
+  in  = g_converter_input_stream_new (mem, dec);
+
+  while ((r = g_input_stream_read (in, buf, sizeof (buf), NULL, NULL)) > 0 &&
+         raw->len < (256u << 20))
+    g_byte_array_append (raw, buf, r);
+
+  g_object_unref (in);
+  g_object_unref (dec);
+  g_object_unref (mem);
+
+  if (raw->len < 24 || memcmp (raw->data + 20, "GPAT", 4))
+    goto out;
+
+  hsize   = be32 (raw->data);
+  version = be32 (raw->data + 4);
+  w       = be32 (raw->data + 8);
+  h       = be32 (raw->data + 12);
+  bpp     = be32 (raw->data + 16);
+
+  if (version != 1 || bpp < 1 || bpp > 4 || w == 0 || h == 0 ||
+      w > 30000 || h > 30000 || hsize < 24 || hsize > raw->len ||
+      (guint64) hsize + (guint64) w * h * bpp > raw->len)
+    goto out;
+
+  if (name)
+    *name = (hsize > 24) ? g_strndup ((const gchar *) raw->data + 24, hsize - 24) : NULL;
+
+  rgba = g_malloc ((gsize) w * h * 4);
+
+  for (gsize i = 0; i < (gsize) w * h; i++)
+    {
+      const guchar *p = raw->data + hsize + i * bpp;
+      guchar       *o = rgba + i * 4;
+
+      switch (bpp)
+        {
+        case 1: o[0] = o[1] = o[2] = p[0]; o[3] = 255;  break;
+        case 2: o[0] = o[1] = o[2] = p[0]; o[3] = p[1]; break;
+        case 3: o[0] = p[0]; o[1] = p[1]; o[2] = p[2]; o[3] = 255;  break;
+        default: o[0] = p[0]; o[1] = p[1]; o[2] = p[2]; o[3] = p[3]; break;
+        }
+    }
+
+  *width  = w;
+  *height = h;
+
+ out:
+  g_byte_array_free (raw, TRUE);
+
+  return rgba;
+}
+
+/*  one channel of a pattern: a written virtual memory array, raw 8 bits  */
+static void
+patt_channel (GByteArray   *b,
+              const guchar *rgba,
+              gint          w,
+              gint          h,
+              gint          c)
+{
+  put32 (b, 1);                         /* written            */
+  put32 (b, 23 + (guint32) w * h);      /* length of the rest */
+  put32 (b, 8);                         /* depth              */
+  put32 (b, 0); put32 (b, 0); put32 (b, h); put32 (b, w);
+  put16 (b, 8);                         /* pixel depth        */
+  g_byte_array_append (b, (const guint8 *) "\0", 1);   /* raw  */
+
+  for (gsize i = 0; i < (gsize) w * h; i++)
+    g_byte_array_append (b, rgba + i * 4 + c, 1);
+}
+
+/*  the identifier of the pattern (added to ctx->patt once), NULL if the
+ *  data can't be read; @name: the pattern's name (to free)
+ */
+static const gchar *
+patt_add (ChopPsd     *ctx,
+          const gchar *data,
+          gchar      **name)
+{
+  gchar       *md5 = g_compute_checksum_for_string (G_CHECKSUM_MD5, data, -1);
+  const gchar *id;
+  GByteArray  *p, *vm;
+  guchar      *rgba;
+  gchar       *pname = NULL;
+  gchar       *uuid;
+  gint         w = 0, h = 0;
+  gboolean     alpha = FALSE;
+
+  if (! ctx->patt_ids)
+    ctx->patt_ids = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+  if (! ctx->patt)
+    ctx->patt = g_byte_array_new ();
+
+  id = g_hash_table_lookup (ctx->patt_ids, md5);
+  if (id)
+    {
+      g_free (md5);
+      *name = NULL;
+      return id;
+    }
+
+  rgba = pat_decode (data, &w, &h, &pname);
+  if (! rgba)
+    {
+      g_free (md5);
+      return NULL;
+    }
+
+  /*  an identifier like Photoshop's (a UUID), stable for the same data  */
+  uuid = g_strdup_printf ("%.8s-%.4s-%.4s-%.4s-%.12s",
+                          md5, md5 + 8, md5 + 12, md5 + 16, md5 + 20);
+
+  for (gsize i = 0; i < (gsize) w * h && ! alpha; i++)
+    alpha = rgba[i * 4 + 3] != 255;
+
+  p = g_byte_array_new ();
+  put32 (p, 1);                         /* version  */
+  put32 (p, 3);                         /* RGB      */
+  put16 (p, h);
+  put16 (p, w);
+  put_ustr (p, pname ? pname : "ChopGimp");
+  {
+    guint8 n = (guint8) strlen (uuid);
+
+    g_byte_array_append (p, &n, 1);
+    put_raw (p, uuid);
+  }
+
+  vm = g_byte_array_new ();
+  put32 (vm, 0); put32 (vm, 0); put32 (vm, h); put32 (vm, w);
+  put32 (vm, 24);                       /* channels (+ user and sheet masks) */
+  for (gint c = 0; c < 24; c++)
+    {
+      if (c < 3)
+        patt_channel (vm, rgba, w, h, c);
+      else
+        put32 (vm, 0);
+    }
+  if (alpha)
+    patt_channel (vm, rgba, w, h, 3);   /* user mask: the alpha */
+  else
+    put32 (vm, 0);
+  put32 (vm, 0);                        /* sheet mask */
+
+  put32 (p, 3);                         /* list version */
+  put32 (p, vm->len);
+  g_byte_array_append (p, vm->data, vm->len);
+  g_byte_array_free (vm, TRUE);
+
+  put32 (ctx->patt, p->len);
+  g_byte_array_append (ctx->patt, p->data, p->len);
+  while (ctx->patt->len & 3)
+    g_byte_array_append (ctx->patt, (const guint8 *) "\0", 1);
+  g_byte_array_free (p, TRUE);
+
+  g_hash_table_insert (ctx->patt_ids, md5, uuid);
+  g_free (rgba);
+
+  *name = pname;
+
+  return uuid;
+}
+
+/*  after the layers: the global layer mask info (none) and the « Patt »
+ *  block of the overlays' patterns, if any
+ */
+gboolean
+chopgimp_psd_write_patterns (GOutputStream *output,
+                             ChopPsd       *ctx,
+                             GError       **error)
+{
+  GByteArray *head;
+  gboolean    ok;
+
+  if (! ctx || ! ctx->patt || ctx->patt->len == 0)
+    return TRUE;
+
+  head = g_byte_array_new ();
+  put32 (head, 0);                      /* global layer mask info: none */
+  put_raw (head, "8BIM");
+  put_raw (head, "Patt");
+  put32 (head, ctx->patt->len);         /* a multiple of 4 */
+
+  ok = g_output_stream_write_all (output, head->data, head->len, NULL, NULL, error) &&
+       g_output_stream_write_all (output, ctx->patt->data, ctx->patt->len,
+                                  NULL, NULL, error);
+
+  g_byte_array_free (head, TRUE);
+
+  return ok;
+}
+
+
+/*  ─── shapes ────────────────────────────────────────────────────────── */
+
+static void
+put_fixed (GByteArray *b, gdouble v, gdouble size)
+{
+  put32 (b, (guint32) (gint32) floor (v / size * 16777216.0 + 0.5));
+}
+
+static void
+put_knot (GByteArray   *b,
+          guint16       selector,
+          const gdouble pts[6],     /* in x,y  anchor x,y  out x,y */
+          gdouble       w,
+          gdouble       h)
+{
+  gint i;
+
+  put16 (b, selector);
+  for (i = 0; i < 3; i++)
+    {
+      put_fixed (b, pts[i * 2 + 1], h);
+      put_fixed (b, pts[i * 2],     w);
+    }
+}
+
+/*  the subpath length record: count, operation (1 union, 0 xor), …  */
+static void
+put_subpath (GByteArray *b,
+             gboolean    closed,
+             gint        n_knots,
+             gint        operation)
+{
+  guint8 zero[18] = { 0 };
+
+  put16 (b, closed ? 0 : 3);
+  put16 (b, n_knots);
+  put16 (b, operation);
+  put16 (b, 1);
+  g_byte_array_append (b, zero, 18);
+}
+
+static void
+put_path_head (GByteArray *b,
+               guint32     flags)
+{
+  guint8 zero[24] = { 0 };
+
+  put32 (b, 3);                 /*  version  */
+  put32 (b, flags);             /*  1 invert, 2 not linked, 4 disabled  */
+  put16 (b, 6);                 /*  path fill rule record  */
+  g_byte_array_append (b, zero, 24);
+}
+
+static GByteArray *
+path_records (GimpPath *path,
+              gdouble   w,
+              gdouble   h)
+{
+  GByteArray *b = g_byte_array_new ();
+  gint       *strokes;
+  gsize       n_strokes, s;
+
+  put_path_head (b, 0);
+
+  strokes = gimp_path_get_strokes (path, &n_strokes);
+
+  for (s = 0; s < n_strokes; s++)
+    {
+      gdouble  *points   = NULL;
+      gsize     n_points = 0;
+      gboolean  closed   = FALSE;
+      gsize     n_knots, k;
+
+      if (gimp_path_stroke_get_points (path, strokes[s], &n_points, &points, &closed) !=
+          GIMP_PATH_STROKE_TYPE_BEZIER || n_points < 6)
+        {
+          g_free (points);
+          continue;
+        }
+
+      n_knots = n_points / 6;     /*  (in, anchor, out) × (x, y)  */
+
+      put_subpath (b, closed, n_knots, s == 0 ? 1 : 0);
+
+      for (k = 0; k < n_knots; k++)
+        put_knot (b, closed ? 1 : 4, points + k * 6, w, h);
+
+      g_free (points);
+    }
+  g_free (strokes);
+
+  return b;
+}
+
+/*  knots of the sub-paths of an SVG d (M, L, H, V, C, Z), transformed by
+ *  @m: in, anchor, out (6 doubles) per knot; @subs: GArray of knot counts
+ *  (negative: open)
+ */
+static void
+d_to_knots (const gchar   *d,
+            const gdouble  m[6],
+            GArray        *knots,
+            GArray        *subs)
+{
+  const gchar *s     = d;
+  gchar        cmd   = 0;
+  gdouble      x = 0, y = 0, sx = 0, sy = 0;
+  gint         first = -1;          /*  index of the sub-path's first knot  */
+
+#define XF(px, py, ox, oy) G_STMT_START {                       \
+      (ox) = m[0] * (px) + m[2] * (py) + m[4];                  \
+      (oy) = m[1] * (px) + m[3] * (py) + m[5];                  \
+    } G_STMT_END
+
+#define CLOSE_SUB(closed) G_STMT_START {                                      \
+      if (first >= 0)                                                         \
+        {                                                                     \
+          gint cnt = (gint) (knots->len / 6) - first;                         \
+          gdouble *kk = (gdouble *) knots->data;                              \
+          /*  an explicit last knot on the first one: they become one  */     \
+          if ((closed) && cnt > 1 &&                                          \
+              fabs (kk[(first + cnt - 1) * 6 + 2] - kk[first * 6 + 2]) < 1e-6 && \
+              fabs (kk[(first + cnt - 1) * 6 + 3] - kk[first * 6 + 3]) < 1e-6)   \
+            {                                                                 \
+              kk[first * 6 + 0] = kk[(first + cnt - 1) * 6 + 0];              \
+              kk[first * 6 + 1] = kk[(first + cnt - 1) * 6 + 1];              \
+              g_array_set_size (knots, knots->len - 6);                       \
+              cnt--;                                                          \
+            }                                                                 \
+          if (cnt > 0)                                                        \
+            {                                                                 \
+              gint sc = (closed) ? cnt : -cnt;                                \
+              g_array_append_val (subs, sc);                                  \
+            }                                                                 \
+          else                                                                \
+            g_array_set_size (knots, first * 6);                              \
+        }                                                                     \
+      first = -1;                                                             \
+    } G_STMT_END
+
+  while (s && *s)
+    {
+      gdouble  v[6];
+      gint     n, i;
+      gboolean rel;
+
+      while (*s == ' ' || *s == ',' || *s == '\t' || *s == '\n' || *s == '\r')
+        s++;
+      if (! *s)
+        break;
+
+      if (g_ascii_isalpha (*s))
+        cmd = *s++;
+      else if (! cmd)
+        break;
+
+      rel = g_ascii_islower (cmd);
+
+      switch (g_ascii_toupper (cmd))
+        {
+        case 'Z':
+          CLOSE_SUB (TRUE);
+          x = sx;
+          y = sy;
+          cmd = 0;
+          continue;
+        case 'M': case 'L': n = 2; break;
+        case 'H': case 'V': n = 1; break;
+        case 'C':           n = 6; break;
+        default:            CLOSE_SUB (FALSE); return;
+        }
+
+      for (i = 0; i < n; i++)
+        {
+          gchar *end;
+
+          while (*s == ' ' || *s == ',' || *s == '\t' || *s == '\n' || *s == '\r')
+            s++;
+          v[i] = g_ascii_strtod (s, &end);
+          if (end == s)
+            {
+              CLOSE_SUB (FALSE);
+              return;
+            }
+          s = end;
+        }
+
+      if (g_ascii_toupper (cmd) == 'H')
+        {
+          v[1] = y;
+          if (rel) v[0] += x;
+          rel = FALSE;
+          n = 2;
+        }
+      else if (g_ascii_toupper (cmd) == 'V')
+        {
+          v[1] = rel ? v[0] + y : v[0];
+          v[0] = x;
+          rel = FALSE;
+          n = 2;
+        }
+
+      if (rel)
+        for (i = 0; i < n; i += 2)
+          {
+            v[i]     += x;
+            v[i + 1] += y;
+          }
+
+      if (g_ascii_toupper (cmd) == 'M')
+        {
+          gdouble k[6];
+
+          CLOSE_SUB (FALSE);
+          first = knots->len / 6;
+          XF (v[0], v[1], k[2], k[3]);
+          k[0] = k[4] = k[2];
+          k[1] = k[5] = k[3];
+          g_array_append_vals (knots, k, 6);
+          x = sx = v[0];
+          y = sy = v[1];
+          cmd = rel ? 'l' : 'L';
+        }
+      else
+        {
+          gdouble  k[6];
+          gdouble *prev;
+
+          if (first < 0)          /*  a segment after Z: from the start point  */
+            {
+              first = knots->len / 6;
+              XF (sx, sy, k[2], k[3]);
+              k[0] = k[4] = k[2];
+              k[1] = k[5] = k[3];
+              g_array_append_vals (knots, k, 6);
+            }
+
+          prev = &g_array_index (knots, gdouble, knots->len - 6);
+
+          if (g_ascii_toupper (cmd) == 'C')
+            {
+              XF (v[0], v[1], prev[4], prev[5]);    /*  out of the previous  */
+              XF (v[2], v[3], k[0], k[1]);          /*  in of this one       */
+              XF (v[4], v[5], k[2], k[3]);
+              x = v[4];
+              y = v[5];
+            }
+          else
+            {
+              XF (v[0], v[1], k[2], k[3]);
+              k[0] = k[2];
+              k[1] = k[3];
+              x = v[0];
+              y = v[1];
+            }
+          k[4] = k[2];
+          k[5] = k[3];
+          g_array_append_vals (knots, k, 6);
+        }
+    }
+
+  CLOSE_SUB (FALSE);
+
+#undef CLOSE_SUB
+#undef XF
+}
+
+/*  the visible leaves of the objects, with their whole transformation  */
+static void
+collect_leaves (const SvgVNode *n,
+                const gdouble   parent[6],
+                GPtrArray      *leaves,
+                GArray         *mats)
+{
+  gdouble m[6];
+
+  if (! n->visible)
+    return;
+
+  if (n->has_transform)
+    svg_vmatrix_mul (parent, n->m, m);
+  else
+    memcpy (m, parent, sizeof (m));
+
+  if (n->group)
+    {
+      for (guint i = 0; n->children && i < n->children->len; i++)
+        collect_leaves (g_ptr_array_index (n->children, i), m, leaves, mats);
+    }
+  else if (n->d && *n->d)
+    {
+      g_ptr_array_add (leaves, (gpointer) n);
+      g_array_append_vals (mats, m, 6);
+    }
+}
+
+/*  nothing a shape layer cannot hold: no group opacity, mode, clip, mask  */
+static gboolean
+tree_is_plain (const SvgVNode *n)
+{
+  if (n->opacity < 1.0 || g_strcmp0 (n->mode, "normal") || n->clip || n->opmask)
+    return FALSE;
+
+  for (guint i = 0; n->group && n->children && i < n->children->len; i++)
+    if (! tree_is_plain (g_ptr_array_index (n->children, i)))
+      return FALSE;
+
+  return TRUE;
+}
+
+static gboolean
+paint_equal (const SvgVEntry *a,
+             const SvgVEntry *b)
+{
+  if (! a || ! b)
+    return a == b;
+
+  if (g_strcmp0 (a->paint.type, b->paint.type) || a->opacity != b->opacity ||
+      g_strcmp0 (a->paint.material, b->paint.material))
+    return FALSE;
+
+  if (memcmp (a->paint.rgba, b->paint.rgba, sizeof (a->paint.rgba)))
+    return FALSE;
+
+  if (a->stroke &&
+      (a->width != b->width || g_strcmp0 (a->align, b->align) || g_strcmp0 (a->cap, b->cap) ||
+       g_strcmp0 (a->join, b->join) || g_strcmp0 (a->dash, b->dash) || a->miter != b->miter))
+    return FALSE;
+
+  if (svg_vpaint_is_gradient (&a->paint))
+    {
+      if (a->paint.x1 != b->paint.x1 || a->paint.y1 != b->paint.y1 ||
+          a->paint.x2 != b->paint.x2 || a->paint.y2 != b->paint.y2 ||
+          a->paint.r != b->paint.r || a->paint.stops->len != b->paint.stops->len ||
+          memcmp (a->paint.stops->data, b->paint.stops->data,
+                  sizeof (SvgVStop) * a->paint.stops->len))
+        return FALSE;
+    }
+
+  return TRUE;
+}
+
+/*  the one fill and the one stroke of every leaf, when they are the same
+ *  for all and Photoshop can draw them (a color or a gradient fill, a color
+ *  stroke without profile nor arrowheads)
+ */
+static gboolean
+uniform_style (GPtrArray        *leaves,
+               const SvgVEntry **fill,
+               const SvgVEntry **stroke)
+{
+  *fill = *stroke = NULL;
+
+  for (guint i = 0; i < leaves->len; i++)
+    {
+      const SvgVNode  *n  = g_ptr_array_index (leaves, i);
+      GPtrArray       *pe = svg_vpainted (n, FALSE);
+      const SvgVEntry *f  = NULL, *s = NULL;
+      gboolean         ok = TRUE;
+
+      if (n->opacity < 1.0 || g_strcmp0 (n->mode, "normal"))
+        ok = FALSE;
+
+      for (guint j = 0; ok && j < pe->len; j++)
+        {
+          const SvgVEntry *e = g_ptr_array_index (pe, j);
+
+          if (g_strcmp0 (e->mode, "normal") || e->paint.material)
+            ok = FALSE;
+          else if (e->stroke)
+            ok = ! s && ! e->profile && ! svg_vhas_arrows (e) &&
+                 ! g_strcmp0 (e->paint.type, "color") && (s = e);
+          else
+            ok = ! f && ! s &&
+                 (! g_strcmp0 (e->paint.type, "color") || svg_vpaint_is_gradient (&e->paint)) &&
+                 (f = e);
+        }
+
+      g_ptr_array_free (pe, TRUE);
+
+      if (! ok)
+        return FALSE;
+
+      if (i == 0)
+        {
+          *fill   = f;
+          *stroke = s;
+        }
+      else if (! paint_equal (*fill, f) || ! paint_equal (*stroke, s))
+        {
+          return FALSE;
+        }
+    }
+
+  return leaves->len > 0;
+}
+
+static gchar *
+vobjects_xml (GimpLayer *layer)
+{
+  GimpProcedure  *procedure;
+  GimpValueArray *retvals;
+  gchar          *xml = NULL;
+
+  procedure = gimp_pdb_lookup_procedure (gimp_get_pdb (), "chopgimp-vobjects-get-xml");
+  if (! procedure)
+    return NULL;
+
+  retvals = gimp_procedure_run (procedure, "layer", layer, NULL);
+
+  if (GIMP_VALUES_GET_ENUM (retvals, 0) == GIMP_PDB_SUCCESS)
+    {
+      const gchar *s = GIMP_VALUES_GET_STRING (retvals, 1);
+
+      if (s && *s)
+        xml = g_strdup (s);
+    }
+
+  gimp_value_array_unref (retvals);
+
+  return xml;
+}
+
+static const gchar *
+cap_name (const gchar *cap)
+{
+  return ! g_strcmp0 (cap, "round")  ? "strokeStyleRoundCap"  :
+         ! g_strcmp0 (cap, "square") ? "strokeStyleSquareCap" : "strokeStyleButtCap";
+}
+
+static const gchar *
+join_name (const gchar *join)
+{
+  return ! g_strcmp0 (join, "round") ? "strokeStyleRoundJoin" :
+         ! g_strcmp0 (join, "bevel") ? "strokeStyleBevelJoin" : "strokeStyleMiterJoin";
+}
+
+/*  vstk: the stroke of a shape layer  */
+static gboolean
+write_vstk (GOutputStream  *output,
+            gboolean        stroke_on,
+            gboolean        fill_on,
+            gdouble         width,
+            gdouble         miter,
+            const gchar    *cap,
+            const gchar    *join,
+            const gchar    *align,
+            const gdouble  *dashes,
+            gint            n_dashes,
+            gdouble         dash_offset,
+            gdouble         opacity,
+            const gdouble   rgba[4],
+            GError        **error)
+{
+  GByteArray *b = g_byte_array_new ();
+  Desc        d = d_new ();
+  Desc        c = d_new ();
+  gboolean    ok;
+
+  d_long (&d, "strokeStyleVersion", 2);
+  d_bool (&d, "strokeEnabled", stroke_on);
+  d_bool (&d, "fillEnabled", fill_on);
+  d_unit (&d, "strokeStyleLineWidth", "#Pxl", width);
+  d_unit (&d, "strokeStyleLineDashOffset", "#Pnt", dash_offset);
+  d_doub (&d, "strokeStyleMiterLimit", miter);
+  d_enum (&d, "strokeStyleLineCapType", "strokeStyleLineCapType", cap_name (cap));
+  d_enum (&d, "strokeStyleLineJoinType", "strokeStyleLineJoinType", join_name (join));
+  d_enum (&d, "strokeStyleLineAlignment", "strokeStyleLineAlignment",
+          ! g_strcmp0 (align, "inside")  ? "strokeStyleAlignInside"  :
+          ! g_strcmp0 (align, "outside") ? "strokeStyleAlignOutside" : "strokeStyleAlignCenter");
+  d_bool (&d, "strokeStyleScaleLock", FALSE);
+  d_bool (&d, "strokeStyleStrokeAdjust", FALSE);
+
+  /*  dashes, in stroke widths (as the model and Photoshop count them)  */
+  put_key (d.b, "strokeStyleLineDashSet");
+  put_raw (d.b, "VlLs");
+  put32 (d.b, n_dashes);
+  for (gint i = 0; i < n_dashes; i++)
+    {
+      put_raw (d.b, "UntF");
+      put_raw (d.b, "#Nne");
+      put_double (d.b, dashes[i]);
+    }
+  d.n++;
+
+  d_enum (&d, "strokeStyleBlendMode", "BlnM", "Nrml");
+  d_unit (&d, "strokeStyleOpacity", "#Prc", CLAMP (opacity, 0, 1) * 100.0);
+  d_rgb (&c, "Clr ", rgba);
+  d_obj (&d, "strokeStyleContent", "solidColorLayer", &c);
+  d_doub (&d, "strokeStyleResolution", 72.0);
+
+  put32 (b, 16);
+  d_emit (b, "strokeStyle", &d);
+  ok = write_block (output, "vstk", b, error);
+  g_byte_array_free (b, TRUE);
+
+  return ok;
+}
+
+/*  vscg: the content of a shape layer (a color or a gradient)  */
+static gboolean
+write_vscg (GOutputStream    *output,
+            const SvgVEntry  *fill,
+            const gdouble     box[4],
+            GError          **error)
+{
+  GByteArray *b = g_byte_array_new ();
+  Desc        d = d_new ();
+  gboolean    ok;
+
+  if (fill && svg_vpaint_is_gradient (&fill->paint))
+    {
+      const SvgVPaint *p      = &fill->paint;
+      gboolean         linear = ! strcmp (p->type, "linear");
+      gint             n      = p->stops->len;
+      Desc            *stops  = g_new (Desc, n);
+      Desc            *trns   = g_new (Desc, n);
+      Desc             grad   = d_new ();
+      Desc             ofs    = d_new ();
+      gdouble          bw     = box[2] - box[0], bh = box[3] - box[1];
+      gdouble          dx     = (p->x2 - p->x1) * bw, dy = (p->y2 - p->y1) * bh;
+      gdouble          len, diag, angle;
+      gdouble          cx, cy;
+
+      for (gint i = 0; i < n; i++)
+        {
+          SvgVStop *st = &g_array_index (p->stops, SvgVStop, i);
+
+          stops[i] = d_new ();
+          d_rgb (&stops[i], "Clr ", st->rgba);
+          d_enum (&stops[i], "Type", "Clry", "UsrS");
+          d_long (&stops[i], "Lctn", (gint) RINT (CLAMP (st->offset, 0, 1) * 4096));
+          d_long (&stops[i], "Mdpn", 50);
+
+          trns[i] = d_new ();
+          d_unit (&trns[i], "Opct", "#Prc", CLAMP (st->rgba[3] * fill->opacity, 0, 1) * 100.0);
+          d_long (&trns[i], "Lctn", (gint) RINT (CLAMP (st->offset, 0, 1) * 4096));
+          d_long (&trns[i], "Mdpn", 50);
+        }
+
+      d_text (&grad, "Nm  ", "ChopGimp");
+      d_enum (&grad, "GrdF", "GrdF", "CstS");
+      d_doub (&grad, "Intr", 4096.0);
+      d_objs (&grad, "Clrs", "Clrt", stops, n);
+      d_objs (&grad, "Trns", "TrnS", trns, n);
+
+      /*  Photoshop: angle (y up), scale relative to the box, offset of
+       *  the centre (linear) or of the start (radial) from the box centre
+       */
+      if (linear)
+        {
+          angle = -atan2 (dy, dx) * 180.0 / G_PI;
+          len   = hypot (dx, dy);
+          diag  = fabs (bw * cos (atan2 (dy, dx))) + fabs (bh * sin (atan2 (dy, dx)));
+          cx    = (p->x1 + p->x2) / 2.0;
+          cy    = (p->y1 + p->y2) / 2.0;
+        }
+      else
+        {
+          angle = 90.0;
+          len   = p->r * hypot (bw, bh) / G_SQRT2;
+          diag  = MAX (bw, bh) / 2.0;
+          cx    = p->x1;
+          cy    = p->y1;
+        }
+
+      d_obj (&d, "Grad", "Grdn", &grad);
+      d_unit (&d, "Angl", "#Ang", angle);
+      d_enum (&d, "Type", "GrdT", linear ? "Lnr " : "Rdl ");
+      d_bool (&d, "Rvrs", FALSE);
+      d_bool (&d, "Dthr", FALSE);
+      d_bool (&d, "Algn", TRUE);
+      d_unit (&d, "Scl ", "#Prc", diag > 0 ? 100.0 * len / diag : 100.0);
+      d_unit (&ofs, "Hrzn", "#Prc", (cx - 0.5) * 100.0);
+      d_unit (&ofs, "Vrtc", "#Prc", (cy - 0.5) * 100.0);
+      d_obj (&d, "Ofst", "Pnt ", &ofs);
+
+      put_raw (b, "GdFl");
+      put32 (b, 16);
+      d_emit (b, "null", &d);
+
+      g_free (stops);
+      g_free (trns);
+    }
+  else
+    {
+      gdouble rgba[4] = { 0, 0, 0, 1 };
+
+      if (fill)
+        memcpy (rgba, fill->paint.rgba, sizeof (rgba));
+
+      d_rgb (&d, "Clr ", rgba);
+      put_raw (b, "SoCo");
+      put32 (b, 16);
+      d_emit (b, "null", &d);
+    }
+
+  ok = write_block (output, "vscg", b, error);
+  g_byte_array_free (b, TRUE);
+
+  return ok;
+}
+
+/*  a vector layer with ChopGimp's objects: a shape layer when one fill
+ *  and one stroke can draw it all, otherwise its pixels with a vector
+ *  mask (disabled when a stroke goes past the outlines); the objects
+ *  themselves in cgVX
+ */
+static gboolean
+write_vobjects (GOutputStream *output,
+                GimpImage     *image,
+                GimpLayer     *layer,
+                const gchar   *xml,
+                ChopPsd       *ctx,
+                GError       **error)
+{
+  static const gdouble identity[6] = { 1, 0, 0, 1, 0, 0 };
+  SvgVNode         *root   = svg_vobjects_parse (xml);
+  GPtrArray        *leaves = g_ptr_array_new ();
+  GArray           *mats   = g_array_new (FALSE, FALSE, sizeof (gdouble));
+  GArray           *knots  = g_array_new (FALSE, FALSE, sizeof (gdouble));
+  GArray           *subs   = g_array_new (FALSE, FALSE, sizeof (gint));
+  GArray           *first  = g_array_new (FALSE, FALSE, sizeof (gint));
+  const SvgVEntry  *fill   = NULL, *stroke = NULL;
+  gboolean          shape  = FALSE;
+  gboolean          any_stroke = FALSE;
+  gdouble           w      = gimp_image_get_width (image);
+  gdouble           h      = gimp_image_get_height (image);
+  gdouble           box[4] = { G_MAXDOUBLE, G_MAXDOUBLE, -G_MAXDOUBLE, -G_MAXDOUBLE };
+  GByteArray       *b;
+  gboolean          ok     = TRUE;
+  gint              k0     = 0;
+
+  if (! root)
+    goto done;
+
+  collect_leaves (root, identity, leaves, mats);
+  if (! leaves->len)
+    goto done;
+
+  shape = tree_is_plain (root) && uniform_style (leaves, &fill, &stroke);
+
+  for (guint i = 0; i < leaves->len; i++)
+    {
+      const SvgVNode *n  = g_ptr_array_index (leaves, i);
+      GPtrArray      *pe = svg_vpainted (n, FALSE);
+      gint            sub0 = subs->len;
+
+      for (guint j = 0; j < pe->len; j++)
+        if (((SvgVEntry *) g_ptr_array_index (pe, j))->stroke)
+          any_stroke = TRUE;
+      g_ptr_array_free (pe, TRUE);
+
+      d_to_knots (n->d, &g_array_index (mats, gdouble, i * 6), knots, subs);
+      g_array_append_val (first, sub0);
+    }
+
+  /*  the bounds of the outlines (gradients of the shape layer)  */
+  for (guint i = 0; i < knots->len; i += 6)
+    {
+      const gdouble *k = &g_array_index (knots, gdouble, i);
+
+      box[0] = MIN (box[0], k[2]); box[1] = MIN (box[1], k[3]);
+      box[2] = MAX (box[2], k[2]); box[3] = MAX (box[3], k[3]);
+    }
+
+  /*  vmsk  */
+  b = g_byte_array_new ();
+  put_path_head (b, (! shape && any_stroke) ? 4 : 0);
+
+  for (guint sp = 0, leaf = 0; sp < subs->len; sp++)
+    {
+      gint     cnt    = g_array_index (subs, gint, sp);
+      gboolean closed = cnt > 0;
+      gint     n_k    = ABS (cnt);
+      gint     op;
+
+      /*  the first sub-path of each object adds to the others (union),
+       *  its other sub-paths make holes (xor)
+       */
+      while (leaf + 1 < first->len && (gint) sp >= g_array_index (first, gint, leaf + 1))
+        leaf++;
+      op = ((gint) sp == g_array_index (first, gint, leaf)) ? 1 : 0;
+
+      put_subpath (b, closed, n_k, op);
+      for (gint k = 0; k < n_k; k++)
+        put_knot (b, closed ? 1 : 4, &g_array_index (knots, gdouble, (k0 + k) * 6), w, h);
+      k0 += n_k;
+    }
+
+  if (shape)
+    ok = write_vscg (output, fill, box, error);
+  if (ok)
+    ok = write_block (output, "vmsk", b, error);
+  g_byte_array_free (b, TRUE);
+
+  if (ok && shape)
+    {
+      gdouble dashes[64];
+      gint    n_d   = 0;
+      gdouble black[4] = { 0, 0, 0, 1 };
+
+      if (stroke && stroke->dash && *stroke->dash)
+        n_d = svg_vnums (stroke->dash, dashes, G_N_ELEMENTS (dashes));
+
+      ok = write_vstk (output, stroke != NULL, fill != NULL,
+                       stroke ? stroke->width : 1.0, stroke ? stroke->miter : 10.0,
+                       stroke ? stroke->cap : "butt", stroke ? stroke->join : "miter",
+                       stroke ? stroke->align : "center", dashes, n_d,
+                       stroke ? stroke->dash_offset : 0.0,
+                       stroke ? stroke->opacity : 1.0,
+                       stroke ? stroke->paint.rgba : black, error);
+    }
+
+  if (! shape)
+    report_line (ctx, GIMP_ITEM (layer),
+                 "calque vectoriel en pixels avec un masque vectoriel%s (plusieurs styles, "
+                 "groupes, effets ou matières qu'un calque de forme ne sait pas porter ; les "
+                 "objets sont gardés pour ChopGimp)",
+                 any_stroke ? " désactivé" : "");
+
+done:
+  if (ok)
+    {
+      /*  the objects, for ChopGimp  */
+      GByteArray *x = g_byte_array_new ();
+
+      put_raw (x, xml);
+      ok = write_block (output, "cgVX", x, error);
+      g_byte_array_free (x, TRUE);
+    }
+
+  g_array_free (first, TRUE);
+  g_array_free (subs, TRUE);
+  g_array_free (knots, TRUE);
+  g_array_free (mats, TRUE);
+  g_ptr_array_free (leaves, TRUE);
+  svg_vnode_free (root);
+
+  return ok;
+}
+
+/*  a shape layer (one fill, one stroke for all the objects): its pixels
+ *  are then irrelevant (flag 0x10), Photoshop draws the shape
+ */
+gboolean
+chopgimp_psd_is_shape (ChopPsd   *ctx,
+                       GimpLayer *layer,
+                       gboolean   shapes)
+{
+  ChopLayer *cl;
+
+  if (! ctx || ! shapes || ! gimp_item_is_vector_layer (GIMP_ITEM (layer)) ||
+      gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)))
+    return FALSE;
+
+  cl = chop_layer (ctx, GIMP_ITEM (layer));
+
+  if (! cl->shape_known)
+    {
+      cl->shape_known = TRUE;
+      cl->xml         = vobjects_xml (layer);
+
+      if (cl->xml)
+        {
+          static const gdouble identity[6] = { 1, 0, 0, 1, 0, 0 };
+          SvgVNode        *root   = svg_vobjects_parse (cl->xml);
+          GPtrArray       *leaves = g_ptr_array_new ();
+          GArray          *mats   = g_array_new (FALSE, FALSE, sizeof (gdouble));
+          const SvgVEntry *fill, *stroke;
+
+          if (root)
+            collect_leaves (root, identity, leaves, mats);
+          cl->shape = root && leaves->len && tree_is_plain (root) &&
+                      uniform_style (leaves, &fill, &stroke);
+
+          g_array_free (mats, TRUE);
+          g_ptr_array_free (leaves, TRUE);
+          svg_vnode_free (root);
+        }
+      else
+        {
+          cl->shape = gimp_vector_layer_get_path (GIMP_VECTOR_LAYER (layer)) != NULL;
+        }
+    }
+
+  return cl->shape;
+}
+
+/*  a GIMP vector layer without ChopGimp's objects: its path, fill, stroke  */
+static gboolean
+write_shape (GOutputStream *output,
+             GimpImage     *image,
+             GimpLayer     *layer,
+             GError       **error)
+{
+  GimpVectorLayer *vl   = GIMP_VECTOR_LAYER (layer);
+  GimpPath        *path = gimp_vector_layer_get_path (vl);
+  GByteArray      *b;
+  GeglColor       *fill, *stroke;
+  gdouble          frgba[4] = { 0, 0, 0, 1 }, srgba[4] = { 0, 0, 0, 1 };
+  gdouble         *dashes = NULL;
+  gsize            n_dashes = 0;
+  gboolean         ok;
+
+  if (! path)
+    return TRUE;
+
+  fill   = gimp_vector_layer_get_fill_color (vl);
+  stroke = gimp_vector_layer_get_stroke_color (vl);
+  if (fill)
+    gegl_color_get_pixel (fill, babl_format ("R'G'B'A double"), frgba);
+  if (stroke)
+    gegl_color_get_pixel (stroke, babl_format ("R'G'B'A double"), srgba);
+
+  /*  fill content: solid color  */
+  b = g_byte_array_new ();
+  {
+    Desc d = d_new ();
+
+    d_rgb (&d, "Clr ", frgba);
+    put_raw (b, "SoCo");
+    put32 (b, 16);
+    d_emit (b, "null", &d);
+  }
+  ok = write_block (output, "vscg", b, error);
+  g_byte_array_free (b, TRUE);
+
+  /*  outline  */
+  if (ok)
+    {
+      b = path_records (path, gimp_image_get_width (image), gimp_image_get_height (image));
+      ok = write_block (output, "vmsk", b, error);
+      g_byte_array_free (b, TRUE);
+    }
+
+  /*  stroke  */
+  if (ok)
+    {
+      GimpCapStyle  cap  = gimp_vector_layer_get_stroke_cap_style (vl);
+      GimpJoinStyle join = gimp_vector_layer_get_stroke_join_style (vl);
+
+      gimp_vector_layer_get_stroke_dash_pattern (vl, &n_dashes, &dashes);
+      ok = write_vstk (output,
+                       gimp_vector_layer_get_enable_stroke (vl),
+                       gimp_vector_layer_get_enable_fill (vl),
+                       gimp_vector_layer_get_stroke_width (vl),
+                       gimp_vector_layer_get_stroke_miter_limit (vl),
+                       cap == GIMP_CAP_ROUND ? "round" : cap == GIMP_CAP_SQUARE ? "square" : "butt",
+                       join == GIMP_JOIN_ROUND ? "round" : join == GIMP_JOIN_BEVEL ? "bevel" : "miter",
+                       "center", dashes, MIN (n_dashes, 64),
+                       gimp_vector_layer_get_stroke_dash_offset (vl), 1.0, srgba, error);
+      g_free (dashes);
+    }
+
+  g_clear_object (&fill);
+  g_clear_object (&stroke);
+
+  return ok;
+}
