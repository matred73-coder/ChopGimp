+static void pdfv_node (cairo_t        *cr,
+                       const SvgVNode *n,
+                       gint            depth);
+
+static const gchar *
+pdfv_skip (const gchar *s)
+{
+  while (*s == ' ' || *s == ',' || *s == '\t' || *s == '\n' || *s == '\r')
+    s++;
+  return s;
+}
+
+/*  d (M, L, H, V, C, Z, absolute or relative) appended to the current path  */
+static void
+pdfv_path (cairo_t     *cr,
+           const gchar *d)
+{
+  const gchar *s   = d;
+  gchar        cmd = 0;
+  gdouble      x = 0, y = 0, sx = 0, sy = 0;
+
+  while (s && *(s = pdfv_skip (s)))
+    {
+      gdouble  v[6];
+      gint     n, i;
+      gboolean rel;
+
+      if (g_ascii_isalpha (*s))
+        cmd = *s++;
+      else if (! cmd)
+        return;
+
+      rel = g_ascii_islower (cmd);
+
+      switch (g_ascii_toupper (cmd))
+        {
+        case 'Z':
+          cairo_close_path (cr);
+          x = sx;
+          y = sy;
+          cmd = 0;
+          continue;
+        case 'M': case 'L': n = 2; break;
+        case 'H': case 'V': n = 1; break;
+        case 'C':           n = 6; break;
+        default:            return;
+        }
+
+      for (i = 0; i < n; i++)
+        {
+          gchar *end;
+
+          s    = pdfv_skip (s);
+          v[i] = g_ascii_strtod (s, &end);
+          if (end == s)
+            return;
+          s = end;
+        }
+
+      switch (g_ascii_toupper (cmd))
+        {
+        case 'M':
+          if (rel) { v[0] += x; v[1] += y; }
+          cairo_move_to (cr, v[0], v[1]);
+          x = sx = v[0];
+          y = sy = v[1];
+          cmd = rel ? 'l' : 'L';     /*  following pairs: line-to  */
+          break;
+        case 'L':
+          if (rel) { v[0] += x; v[1] += y; }
+          cairo_line_to (cr, v[0], v[1]);
+          x = v[0];
+          y = v[1];
+          break;
+        case 'H':
+          if (rel) v[0] += x;
+          cairo_line_to (cr, v[0], y);
+          x = v[0];
+          break;
+        case 'V':
+          if (rel) v[0] += y;
+          cairo_line_to (cr, x, v[0]);
+          y = v[0];
+          break;
+        case 'C':
+          if (rel)
+            for (i = 0; i < 6; i += 2)
+              {
+                v[i]     += x;
+                v[i + 1] += y;
+              }
+          cairo_curve_to (cr, v[0], v[1], v[2], v[3], v[4], v[5]);
+          x = v[4];
+          y = v[5];
+          break;
+        }
+    }
+}
+
+/*  bounds of the geometry of d, in user space (gradients' bounding box)  */
+static gboolean
+pdfv_box (cairo_t     *cr,
+          const gchar *d,
+          gdouble      box[4])
+{
+  cairo_new_path (cr);
+  pdfv_path (cr, d);
+  cairo_path_extents (cr, &box[0], &box[1], &box[2], &box[3]);
+  cairo_new_path (cr);
+
+  return box[2] > box[0] || box[3] > box[1];
+}
+
+static cairo_operator_t
+pdfv_operator (const gchar *mode)
+{
+  static const struct { const gchar *name; cairo_operator_t op; } map[] =
+  {
+    { "multiply",       CAIRO_OPERATOR_MULTIPLY       },
+    { "screen",         CAIRO_OPERATOR_SCREEN         },
+    { "overlay",        CAIRO_OPERATOR_OVERLAY        },
+    { "darken-only",    CAIRO_OPERATOR_DARKEN         },
+    { "lighten-only",   CAIRO_OPERATOR_LIGHTEN        },
+    { "dodge",          CAIRO_OPERATOR_COLOR_DODGE    },
+    { "burn",           CAIRO_OPERATOR_COLOR_BURN     },
+    { "hardlight",      CAIRO_OPERATOR_HARD_LIGHT     },
+    { "softlight",      CAIRO_OPERATOR_SOFT_LIGHT     },
+    { "difference",     CAIRO_OPERATOR_DIFFERENCE     },
+    { "exclusion",      CAIRO_OPERATOR_EXCLUSION      },
+    { "lch-hue",        CAIRO_OPERATOR_HSL_HUE        },
+    { "hsv-hue",        CAIRO_OPERATOR_HSL_HUE        },
+    { "lch-chroma",     CAIRO_OPERATOR_HSL_SATURATION },
+    { "hsv-saturation", CAIRO_OPERATOR_HSL_SATURATION },
+    { "hsl-color",      CAIRO_OPERATOR_HSL_COLOR      },
+    { "lch-color",      CAIRO_OPERATOR_HSL_COLOR      },
+    { "lch-lightness",  CAIRO_OPERATOR_HSL_LUMINOSITY },
+    { "luminance",      CAIRO_OPERATOR_HSL_LUMINOSITY },
+    { "hsv-value",      CAIRO_OPERATOR_HSL_LUMINOSITY },
+    { "addition",       CAIRO_OPERATOR_ADD            },
+  };
+
+  for (guint i = 0; mode && i < G_N_ELEMENTS (map); i++)
+    if (! strcmp (mode, map[i].name))
+      return map[i].op;
+
+  return CAIRO_OPERATOR_OVER;
+}
+
+static void
+pdfv_mesh_patch (cairo_pattern_t *pat,
+                 const gdouble    p[4][2],
+                 const gdouble    ctl[4][4],
+                 const gdouble    col[4][4])
+{
+  cairo_mesh_pattern_begin_patch (pat);
+  cairo_mesh_pattern_move_to (pat, p[0][0], p[0][1]);
+
+  for (gint i = 1; i <= 4; i++)
+    cairo_mesh_pattern_curve_to (pat, ctl[i - 1][0], ctl[i - 1][1],
+                                 ctl[i - 1][2], ctl[i - 1][3],
+                                 p[i % 4][0], p[i % 4][1]);
+
+  for (gint i = 0; i < 4; i++)
+    cairo_mesh_pattern_set_corner_color_rgba (pat, i, col[i][0], col[i][1],
+                                              col[i][2], col[i][3]);
+
+  cairo_mesh_pattern_end_patch (pat);
+}
+
+/*  « filet de dégradé » (spec of svg_vput_mesh()), in the box, as the
+ *  model draws it (chopgimp-vmaterial.c, mesh_source)
+ */
+static cairo_pattern_t *
+pdfv_mesh (const gchar   *spec,
+           gdouble        alpha,
+           const gdouble  box[4])
+{
+  gchar           **parts;
+  gint              rows = 0, cols = 0, n, k = 0;
+  SvgVMeshNode     *nodes;
+  cairo_pattern_t  *pat;
+  gdouble           w = box[2] - box[0], h = box[3] - box[1];
+
+  if (! spec)
+    return NULL;
+
+  parts = g_strsplit (spec, ";", -1);
+
+  if (! parts[0] || sscanf (parts[0], "%d %d", &rows, &cols) != 2 ||
+      rows < 1 || cols < 1 || rows > 64 || cols > 64)
+    {
+      g_strfreev (parts);
+      return NULL;
+    }
+
+  n     = (rows + 1) * (cols + 1);
+  nodes = g_new0 (SvgVMeshNode, n);
+
+  for (gint i = 1; parts[i] && k < n; i++)
+    {
+      gchar **f = g_strsplit (parts[i], ",", 7);
+
+      if (f[0] && f[1] && f[2])
+        {
+          const gchar *hx = f[2];
+          guint        v[4] = { 0, 0, 0, 255 };
+
+          nodes[k].x = g_ascii_strtod (f[0], NULL);
+          nodes[k].y = g_ascii_strtod (f[1], NULL);
+
+          while (*hx == '#' || *hx == ' ')
+            hx++;
+          for (gint j = 0; j < 4 && g_ascii_isxdigit (hx[0]) && g_ascii_isxdigit (hx[1]); j++, hx += 2)
+            v[j] = g_ascii_xdigit_value (hx[0]) * 16 + g_ascii_xdigit_value (hx[1]);
+          for (gint j = 0; j < 4; j++)
+            nodes[k].rgba[j] = v[j] / 255.0;
+
+          if (f[3] && f[4] && f[5] && f[6])
+            {
+              nodes[k].th[0] = g_ascii_strtod (f[3], NULL);
+              nodes[k].th[1] = g_ascii_strtod (f[4], NULL);
+              nodes[k].tv[0] = g_ascii_strtod (f[5], NULL);
+              nodes[k].tv[1] = g_ascii_strtod (f[6], NULL);
+            }
+          k++;
+        }
+
+      g_strfreev (f);
+    }
+
+  g_strfreev (parts);
+
+  if (k < n)
+    {
+      g_free (nodes);
+      return NULL;
+    }
+
+  pat = cairo_pattern_create_mesh ();
+
+  for (gint r = 0; r < rows; r++)
+    for (gint c = 0; c < cols; c++)
+      {
+        gint    corner[4] = { r * (cols + 1) + c, r * (cols + 1) + c + 1,
+                              (r + 1) * (cols + 1) + c + 1, (r + 1) * (cols + 1) + c };
+        gdouble p[4][2], ctl[4][4], col[4][4];
+
+        for (gint i = 0; i < 4; i++)
+          {
+            const SvgVMeshNode *a = &nodes[corner[i]];
+            gdouble             cc[6];
+
+            p[i][0] = box[0] + a->x * w;
+            p[i][1] = box[1] + a->y * h;
+
+            /*  control points relative to the start of the side  */
+            svg_vmesh_edge (nodes, corner[i], corner[(i + 1) % 4], cc);
+            ctl[i][0] = box[0] + (a->x + cc[0]) * w;
+            ctl[i][1] = box[1] + (a->y + cc[1]) * h;
+            ctl[i][2] = box[0] + (a->x + cc[2]) * w;
+            ctl[i][3] = box[1] + (a->y + cc[3]) * h;
+
+            memcpy (col[i], a->rgba, sizeof (col[i]));
+            col[i][3] *= alpha;
+          }
+
+        pdfv_mesh_patch (pat, p, ctl, col);
+      }
+
+  g_free (nodes);
+
+  return pat;
+}
+
+/*  « dégradé libre »: inverse distance weighting (power 2) of the points
+ *  and lines, as chopgimp-vmaterial.c freeform_color() does
+ */
+typedef struct
+{
+  gdouble  x, y, rgba[4];
+  gboolean link;
+} PdfvFreePoint;
+
+static void
+pdfv_freeform_color (GArray  *pts,
+                     gdouble  x,
+                     gdouble  y,
+                     gdouble  rgba[4])
+{
+  gdouble sum = 0.0;
+  gdouble acc[4] = { 0, 0, 0, 0 };
+
+  for (guint i = 1; i < pts->len; i++)
+    {
+      PdfvFreePoint *a = &g_array_index (pts, PdfvFreePoint, i - 1);
+      PdfvFreePoint *b = &g_array_index (pts, PdfvFreePoint, i);
+      gdouble        ex, ey, l2, u, qx, qy, d2, wt;
+
+      if (! b->link)
+        continue;
+
+      ex = b->x - a->x;
+      ey = b->y - a->y;
+      l2 = ex * ex + ey * ey;
+      u  = l2 > 1e-12 ? CLAMP (((x - a->x) * ex + (y - a->y) * ey) / l2, 0.0, 1.0) : 0.0;
+      qx = a->x + u * ex;
+      qy = a->y + u * ey;
+      d2 = (qx - x) * (qx - x) + (qy - y) * (qy - y);
+
+      if (d2 < 1e-10)
+        {
+          for (gint k = 0; k < 4; k++)
+            rgba[k] = a->rgba[k] + (b->rgba[k] - a->rgba[k]) * u;
+          return;
+        }
+
+      wt   = 1.0 / d2;
+      sum += wt;
+      for (gint k = 0; k < 4; k++)
+        acc[k] += (a->rgba[k] + (b->rgba[k] - a->rgba[k]) * u) * wt;
+    }
+
+  for (guint i = 0; i < pts->len; i++)
+    {
+      PdfvFreePoint *nd = &g_array_index (pts, PdfvFreePoint, i);
+      gdouble        d2 = (nd->x - x) * (nd->x - x) + (nd->y - y) * (nd->y - y);
+      gdouble        wt;
+
+      if (nd->link ||
+          (i + 1 < pts->len && g_array_index (pts, PdfvFreePoint, i + 1).link))
+        continue;
+
+      if (d2 < 1e-10)
+        {
+          memcpy (rgba, nd->rgba, sizeof (gdouble) * 4);
+          return;
+        }
+
+      wt   = 1.0 / d2;
+      sum += wt;
+      for (gint k = 0; k < 4; k++)
+        acc[k] += nd->rgba[k] * wt;
+    }
+
+  for (gint k = 0; k < 4; k++)
+    rgba[k] = sum > 0 ? acc[k] / sum : 0.0;
+}
+
+static cairo_pattern_t *
+pdfv_freeform (const gchar   *spec,       /* « points;x,y,#rrggbbaa[,l];… » */
+               gdouble        alpha,
+               const gdouble  box[4])
+{
+  const gint        G = 20;
+  GArray           *pts;
+  gchar           **parts;
+  gdouble          *grid;
+  cairo_pattern_t  *pat;
+
+  if (! spec || strncmp (spec, "points", 6))
+    return NULL;
+
+  pts   = g_array_new (FALSE, TRUE, sizeof (PdfvFreePoint));
+  parts = g_strsplit (spec + 6, ";", -1);
+
+  for (gint i = 0; parts[i]; i++)
+    {
+      gchar        **f  = g_strsplit (parts[i], ",", 4);
+      PdfvFreePoint  nd = { 0, };
+
+      if (f[0] && f[1] && f[2])
+        {
+          const gchar *hx = f[2];
+          guint        v[4] = { 0, 0, 0, 255 };
+
+          nd.x = g_ascii_strtod (f[0], NULL);
+          nd.y = g_ascii_strtod (f[1], NULL);
+          while (*hx == '#' || *hx == ' ')
+            hx++;
+          for (gint j = 0; j < 4 && g_ascii_isxdigit (hx[0]) && g_ascii_isxdigit (hx[1]); j++, hx += 2)
+            v[j] = g_ascii_xdigit_value (hx[0]) * 16 + g_ascii_xdigit_value (hx[1]);
+          for (gint j = 0; j < 4; j++)
+            nd.rgba[j] = v[j] / 255.0;
+          nd.link = (f[3] && f[3][0] == 'l' && pts->len > 0);
+          g_array_append_val (pts, nd);
+        }
+
+      g_strfreev (f);
+    }
+
+  g_strfreev (parts);
+
+  if (pts->len == 0)
+    {
+      g_array_free (pts, TRUE);
+      return NULL;
+    }
+
+  grid = g_new (gdouble, (G + 1) * (G + 1) * 4);
+
+  /*  a slightly larger area than the box, as the model  */
+  for (gint r = 0; r <= G; r++)
+    for (gint c = 0; c <= G; c++)
+      pdfv_freeform_color (pts, -0.1 + 1.2 * c / G, -0.1 + 1.2 * r / G,
+                           &grid[(r * (G + 1) + c) * 4]);
+
+  pat = cairo_pattern_create_mesh ();
+
+  for (gint r = 0; r < G; r++)
+    for (gint c = 0; c < G; c++)
+      {
+        gdouble p[4][2], col[4][4], ctl[4][4];
+        gint    idx[4][2] = { { r, c }, { r, c + 1 }, { r + 1, c + 1 }, { r + 1, c } };
+
+        for (gint i = 0; i < 4; i++)
+          {
+            gdouble u = -0.1 + 1.2 * idx[i][1] / G, v = -0.1 + 1.2 * idx[i][0] / G;
+
+            p[i][0] = box[0] + u * (box[2] - box[0]);
+            p[i][1] = box[1] + v * (box[3] - box[1]);
+            memcpy (col[i], &grid[(idx[i][0] * (G + 1) + idx[i][1]) * 4], sizeof (gdouble) * 4);
+            col[i][3] *= alpha;
+          }
+
+        for (gint i = 0; i < 4; i++)
+          {
+            const gdouble *a = p[i], *b = p[(i + 1) % 4];
+
+            ctl[i][0] = a[0] + (b[0] - a[0]) / 3.0;
+            ctl[i][1] = a[1] + (b[1] - a[1]) / 3.0;
+            ctl[i][2] = a[0] + (b[0] - a[0]) * 2.0 / 3.0;
+            ctl[i][3] = a[1] + (b[1] - a[1]) * 2.0 / 3.0;
+          }
+
+        pdfv_mesh_patch (pat, p, ctl, col);
+      }
+
+  g_free (grid);
+  g_array_free (pts, TRUE);
+
+  return pat;
+}
+
+/*  vector pattern (« type=… w=… h=… hs=… vs=… |<objects> ») → a tiling
+ *  pattern of a recording surface (PDF: a tiling pattern of vectors),
+ *  tiled as svg_vput_vpattern() does
+ */
+static cairo_pattern_t *
+pdfv_vpattern (const gchar *spec,
+               gint         depth)
+{
+  const gchar          *bar = strchr (spec, '|');
+  gchar                *head;
+  gchar               **words;
+  const gchar          *type = "grid";
+  gdouble               tw = 20.0, th = 20.0, hs = 0.0, vs = 0.0;
+  gdouble               sx, sy, cw, ch;
+  gdouble               offs[3][2] = { { 0, 0 }, };
+  gint                  n_offs = 1;
+  SvgVNode             *root;
+  cairo_surface_t      *rec;
+  cairo_t              *rcr;
+  cairo_pattern_t      *pat;
+  cairo_rectangle_t     ext;
+
+  if (! bar || depth > CHOP_MAX_DEPTH)
+    return NULL;
+
+  root = svg_vobjects_parse (bar + 1);
+  if (! root)
+    return NULL;
+
+  head  = g_strndup (spec, bar - spec);
+  words = g_strsplit (head, " ", -1);
+
+  for (gint i = 0; words[i]; i++)
+    {
+      gchar *eq = strchr (words[i], '=');
+
+      if (! eq)
+        continue;
+      *eq = '\0';
+      if (! strcmp (words[i], "type"))
+        type = (! strcmp (eq + 1, "brick-row")    ? "brick-row"    :
+                ! strcmp (eq + 1, "brick-column") ? "brick-column" :
+                ! strcmp (eq + 1, "hex")          ? "hex"          : "grid");
+      else if (! strcmp (words[i], "w"))
+        tw = MAX (1.0, g_ascii_strtod (eq + 1, NULL));
+      else if (! strcmp (words[i], "h"))
+        th = MAX (1.0, g_ascii_strtod (eq + 1, NULL));
+      else if (! strcmp (words[i], "hs"))
+        hs = g_ascii_strtod (eq + 1, NULL);
+      else if (! strcmp (words[i], "vs"))
+        vs = g_ascii_strtod (eq + 1, NULL);
+    }
+
+  sx = MAX (1.0, tw + hs);
+  sy = MAX (1.0, th + vs);
+  cw = sx;
+  ch = sy;
+
+  if (! strcmp (type, "brick-row"))
+    {
+      ch = 2 * sy;
+      offs[1][0] = sx / 2;  offs[1][1] = sy;
+      offs[2][0] = -sx / 2; offs[2][1] = sy;
+      n_offs = 3;
+    }
+  else if (! strcmp (type, "brick-column"))
+    {
+      cw = 2 * sx;
+      offs[1][0] = sx; offs[1][1] = sy / 2;
+      offs[2][0] = sx; offs[2][1] = -sy / 2;
+      n_offs = 3;
+    }
+  else if (! strcmp (type, "hex"))
+    {
+      cw = 1.5 * sx;
+      offs[1][0] = 0.75 * sx; offs[1][1] = sy / 2;
+      offs[2][0] = 0.75 * sx; offs[2][1] = -sy / 2;
+      n_offs = 3;
+    }
+
+  ext.x      = 0;
+  ext.y      = 0;
+  ext.width  = cw;
+  ext.height = ch;
+  rec = cairo_recording_surface_create (CAIRO_CONTENT_COLOR_ALPHA, &ext);
+  rcr = cairo_create (rec);
+
+  /*  each copy and its neighbours (a tile larger than its cell overflows
+   *  into them), clipped to the cell by the recording surface's extents
+   */
+  for (gint k = 0; k < n_offs; k++)
+    for (gint dy = -1; dy <= 1; dy++)
+      for (gint dx = -1; dx <= 1; dx++)
+        {
+          cairo_save (rcr);
+          cairo_translate (rcr, offs[k][0] + dx * cw, offs[k][1] + dy * ch);
+          for (guint i = 0; root->children && i < root->children->len; i++)
+            pdfv_node (rcr, g_ptr_array_index (root->children, i), depth + 1);
+          cairo_restore (rcr);
+        }
+
+  cairo_destroy (rcr);
+
+  pat = cairo_pattern_create_for_surface (rec);
+  cairo_pattern_set_extend (pat, CAIRO_EXTEND_REPEAT);
+  cairo_surface_destroy (rec);
+
+  g_strfreev (words);
+  g_free (head);
+  svg_vnode_free (root);
+
+  return pat;
+}
+
+/*  a GIMP pattern: its image, repeated from the origin  */
+static cairo_pattern_t *
+pdfv_gimp_pattern (const gchar *name)
+{
+  GimpPattern     *pattern = name ? gimp_pattern_get_by_name (name) : NULL;
+  GeglBuffer      *src;
+  GeglBuffer      *dst;
+  cairo_surface_t *surface;
+  cairo_pattern_t *pat;
+
+  if (! pattern)
+    return NULL;
+
+  src = gimp_pattern_get_buffer (pattern, 0, 0, NULL);
+  if (! src)
+    return NULL;
+
+  surface = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+                                        gegl_buffer_get_width (src),
+                                        gegl_buffer_get_height (src));
+  dst = gimp_cairo_surface_get_buffer (surface, NULL, TRUE);
+  gegl_buffer_copy (src, NULL, GEGL_ABYSS_NONE, dst, NULL);
+  g_object_unref (dst);
+  g_object_unref (src);
+  cairo_surface_mark_dirty (surface);
+
+  pat = cairo_pattern_create_for_surface (surface);
+  cairo_pattern_set_extend (pat, CAIRO_EXTEND_REPEAT);
+  cairo_surface_destroy (surface);
+
+  return pat;
+}
+
+/*  the cairo source of a fill / stroke; *alpha_done: @alpha is in it  */
+static cairo_pattern_t *
+pdfv_source (const SvgVPaint *p,
+             gdouble          alpha,
+             const gdouble    box[4],
+             gint             depth,
+             gboolean        *alpha_done)
+{
+  cairo_pattern_t *pat = NULL;
+  gdouble          bw  = box[2] - box[0];
+  gdouble          bh  = box[3] - box[1];
+
+  *alpha_done = TRUE;
+
+  if (p->material && g_str_has_prefix (p->material, "mesh:"))
+    return pdfv_mesh (p->material + 5, alpha, box);
+
+  if (p->material && g_str_has_prefix (p->material, "freeform:"))
+    return pdfv_freeform (p->material + 9, alpha, box);
+
+  if (! p->type || ! strcmp (p->type, "none"))
+    return NULL;
+
+  if (! strcmp (p->type, "color"))
+    return cairo_pattern_create_rgba (p->rgba[0], p->rgba[1], p->rgba[2],
+                                      CLAMP (p->rgba[3], 0.0, 1.0) * alpha);
+
+  if (svg_vpaint_is_gradient (p))
+    {
+      cairo_matrix_t m;
+
+      /*  objectBoundingBox units: nothing for a flat box (as SVG)  */
+      if (bw <= 0.0 || bh <= 0.0)
+        return NULL;
+
+      if (! strcmp (p->type, "linear"))
+        pat = cairo_pattern_create_linear (p->x1, p->y1, p->x2, p->y2);
+      else
+        pat = cairo_pattern_create_radial (p->x2, p->y2, 0.0, p->x1, p->y1, p->r);
+
+      for (guint i = 0; i < p->stops->len; i++)
+        {
+          SvgVStop *st = &g_array_index (p->stops, SvgVStop, i);
+
+          cairo_pattern_add_color_stop_rgba (pat, st->offset, st->rgba[0], st->rgba[1],
+                                             st->rgba[2], CLAMP (st->rgba[3], 0.0, 1.0) * alpha);
+        }
+
+      cairo_matrix_init (&m, bw, 0, 0, bh, box[0], box[1]);
+      cairo_matrix_invert (&m);
+      cairo_pattern_set_matrix (pat, &m);
+
+      return pat;
+    }
+
+  *alpha_done = FALSE;
+
+  if (! strcmp (p->type, "vpattern") && p->material)
+    pat = pdfv_vpattern (p->material, depth);
+  else if (! strcmp (p->type, "pattern"))
+    pat = pdfv_gimp_pattern (p->pattern);
+
+  return pat;
+}
+
+static void
+pdfv_stroke_settings (cairo_t         *cr,
+                      const SvgVEntry *e,
+                      gdouble          width)
+{
+  cairo_set_line_width (cr, width);
+  cairo_set_line_cap (cr, ! g_strcmp0 (e->cap, "round")  ? CAIRO_LINE_CAP_ROUND  :
+                          ! g_strcmp0 (e->cap, "square") ? CAIRO_LINE_CAP_SQUARE :
+                                                           CAIRO_LINE_CAP_BUTT);
+  cairo_set_line_join (cr, ! g_strcmp0 (e->join, "round") ? CAIRO_LINE_JOIN_ROUND :
+                           ! g_strcmp0 (e->join, "bevel") ? CAIRO_LINE_JOIN_BEVEL :
+                                                            CAIRO_LINE_JOIN_MITER);
+  cairo_set_miter_limit (cr, MAX (1.0, e->miter));
+
+  if (e->dash && *e->dash)
+    {
+      gdouble dash[64];
+      gint    n = svg_vnums (e->dash, dash, G_N_ELEMENTS (dash));
+
+      /*  the model counts dashes in stroke widths  */
+      for (gint i = 0; i < n; i++)
+        dash[i] *= e->width;
+      if (n > 0)
+        cairo_set_dash (cr, dash, n, e->dash_offset);
+    }
+}
+
+/*  draws the current figure of @e: kind 0 fill d, 1 stroke d (aligned),
+ *  2 fill d nonzero (an outline, an arrowhead), 3 stroke d (arrowhead)
+ */
+static void
+pdfv_paint (cairo_t         *cr,
+            const SvgVNode  *n,
+            const SvgVEntry *e,
+            const gchar     *d,
+            gint             kind,
+            const gdouble    box[4],
+            gint             depth)
+{
+  gboolean          alpha_done = TRUE;
+  cairo_pattern_t  *src        = pdfv_source (&e->paint, e->opacity, box, depth, &alpha_done);
+  cairo_operator_t  op         = pdfv_operator (e->mode);
+  gboolean          group;
+
+  if (! src)
+    return;
+
+  group = ! alpha_done && e->opacity < 1.0;
+
+  cairo_save (cr);
+
+  if (group)
+    cairo_push_group (cr);
+  else
+    cairo_set_operator (cr, op);
+
+  cairo_set_source (cr, src);
+  cairo_new_path (cr);
+
+  if (kind == 0 || kind == 2)
+    {
+      pdfv_path (cr, d);
+      cairo_set_fill_rule (cr, (kind == 2 || n->nonzero) ? CAIRO_FILL_RULE_WINDING
+                                                         : CAIRO_FILL_RULE_EVEN_ODD);
+      cairo_fill (cr);
+    }
+  else if (kind == 3)
+    {
+      pdfv_path (cr, d);
+      cairo_stroke (cr);
+    }
+  else
+    {
+      gdouble w = e->width;
+
+      if (w > 0.0)
+        {
+          if (! g_strcmp0 (e->align, "inside"))
+            {
+              /*  the inner half of a stroke twice as wide  */
+              pdfv_path (cr, d);
+              cairo_set_fill_rule (cr, n->nonzero ? CAIRO_FILL_RULE_WINDING
+                                                  : CAIRO_FILL_RULE_EVEN_ODD);
+              cairo_clip (cr);
+              pdfv_stroke_settings (cr, e, 2.0 * w);
+            }
+          else if (! g_strcmp0 (e->align, "outside"))
+            {
+              gdouble m = w * (2.0 + MAX (e->miter, 1.0)) + 2.0;
+
+              cairo_rectangle (cr, box[0] - m, box[1] - m,
+                               box[2] - box[0] + 2 * m, box[3] - box[1] + 2 * m);
+              pdfv_path (cr, d);
+              cairo_set_fill_rule (cr, CAIRO_FILL_RULE_EVEN_ODD);
+              cairo_clip (cr);
+              pdfv_stroke_settings (cr, e, 2.0 * w);
+            }
+          else
+            {
+              pdfv_stroke_settings (cr, e, w);
+            }
+
+          pdfv_path (cr, d);
+          cairo_stroke (cr);
+        }
+    }
+
+  if (group)
+    {
+      cairo_pop_group_to_source (cr);
+      cairo_set_operator (cr, op);
+      cairo_paint_with_alpha (cr, e->opacity);
+    }
+
+  cairo_restore (cr);
+  cairo_pattern_destroy (src);
+}
+
+/*  arrowheads on the open ends of the path, as svg_vmarker_id() draws them  */
+static void
+pdfv_arrows (cairo_t         *cr,
+             const SvgVNode  *n,
+             const SvgVEntry *e,
+             const gdouble    box[4],
+             gint             depth)
+{
+  GPtrArray *polys = svg_vflatten (n->d);
+
+  for (gint end = 0; end < 2 && polys->len > 0; end++)
+    {
+      const gchar *shape = end ? e->arrow_end : e->arrow_start;
+      SvgVPoly    *p     = g_ptr_array_index (polys, end ? polys->len - 1 : 0);
+      gint         np    = p->pts->len / 2;
+      gdouble     *v     = (gdouble *) p->pts->data;
+      gdouble      tx, ty, ox, oy, angle;
+      gdouble      sg    = end ? 1.0 : -1.0;
+      gdouble      scale = CLAMP (e->arrow_scale, 0.1, 20.0);
+      gdouble      L     = 4.0 * MAX (e->width, 0.5) * scale;
+      gdouble      W     = L * 0.5;
+      gint         i;
+      SvgVEntry    fill_e;
+      cairo_matrix_t mtx;
+      GString     *ad;
+
+      if (! shape || p->closed || np < 2)
+        continue;
+
+      /*  the end point and the nearest distinct point before it  */
+      if (end)
+        {
+          tx = v[2 * (np - 1)];
+          ty = v[2 * (np - 1) + 1];
+          for (i = np - 2; i > 0 && v[2 * i] == tx && v[2 * i + 1] == ty; i--)
+            ;
+          ox = v[2 * i];
+          oy = v[2 * i + 1];
+          angle = atan2 (ty - oy, tx - ox);
+        }
+      else
+        {
+          tx = v[0];
+          ty = v[1];
+          for (i = 1; i < np - 1 && v[2 * i] == tx && v[2 * i + 1] == ty; i++)
+            ;
+          ox = v[2 * i];
+          oy = v[2 * i + 1];
+          angle = atan2 (oy - ty, ox - tx);
+        }
+
+      /*  the shape in the end's frame, as a path in user space  */
+      cairo_matrix_init_translate (&mtx, tx, ty);
+      cairo_matrix_rotate (&mtx, angle);
+
+      ad = g_string_new (NULL);
+
+#define PT(px, py) G_STMT_START {                                         \
+          gdouble _x = (px), _y = (py);                                   \
+          gchar   _b[2][G_ASCII_DTOSTR_BUF_SIZE];                         \
+          cairo_matrix_transform_point (&mtx, &_x, &_y);                  \
+          g_string_append_printf (ad, "%s %s ",                           \
+                                  g_ascii_dtostr (_b[0], sizeof (_b[0]), _x), \
+                                  g_ascii_dtostr (_b[1], sizeof (_b[1]), _y)); \
+        } G_STMT_END
+
+      if (! strcmp (shape, "arrow"))
+        {
+          g_string_append (ad, "M ");  PT (-sg * L, W);
+          g_string_append (ad, "L ");  PT (0, 0);
+          g_string_append (ad, "L ");  PT (-sg * L, -W);
+        }
+      else if (! strcmp (shape, "circle"))
+        {
+          /*  centre W behind the tip, radius W: 4 Bézier quarters  */
+          const gdouble kk = 0.5522847498 * W;
+          gdouble       cx = -sg * W;
+
+          g_string_append (ad, "M "); PT (cx + W, 0);
+          g_string_append (ad, "C "); PT (cx + W, kk);  PT (cx + kk, W);  PT (cx, W);
+          g_string_append (ad, "C "); PT (cx - kk, W);  PT (cx - W, kk);  PT (cx - W, 0);
+          g_string_append (ad, "C "); PT (cx - W, -kk); PT (cx - kk, -W); PT (cx, -W);
+          g_string_append (ad, "C "); PT (cx + kk, -W); PT (cx + W, -kk); PT (cx + W, 0);
+          g_string_append (ad, "Z");
+        }
+      else if (! strcmp (shape, "square") || ! strcmp (shape, "bar"))
+        {
+          gdouble len = ! strcmp (shape, "bar") ? MAX (e->width, 0.5) : L;
+
+          g_string_append (ad, "M "); PT (0, W);
+          g_string_append (ad, "L "); PT (0, -W);
+          g_string_append (ad, "L "); PT (-sg * len, -W);
+          g_string_append (ad, "L "); PT (-sg * len, W);
+          g_string_append (ad, "Z");
+        }
+      else          /*  triangle (and unknown shapes)  */
+        {
+          g_string_append (ad, "M "); PT (0, 0);
+          g_string_append (ad, "L "); PT (-sg * L, W);
+          g_string_append (ad, "L "); PT (-sg * L, -W);
+          g_string_append (ad, "Z");
+        }
+
+#undef PT
+
+      /*  the stroke's paint; an « arrow » is stroked, without dashes  */
+      fill_e      = *e;
+      fill_e.dash = NULL;
+
+      if (! strcmp (shape, "arrow"))
+        {
+          cairo_save (cr);
+          fill_e.join = (gchar *) "miter";
+          pdfv_stroke_settings (cr, &fill_e, e->width);
+          pdfv_paint (cr, n, &fill_e, ad->str, 3, box, depth);
+          cairo_restore (cr);
+        }
+      else
+        {
+          pdfv_paint (cr, n, &fill_e, ad->str, 2, box, depth);
+        }
+
+      g_string_free (ad, TRUE);
+    }
+
+  g_ptr_array_free (polys, TRUE);
+}
+
+static void
+pdfv_leaf (cairo_t        *cr,
+           const SvgVNode *n,
+           gint            depth)
+{
+  GPtrArray *painted;
+  gdouble    box[4];
+
+  if (! n->d || ! *n->d)
+    return;
+
+  pdfv_box (cr, n->d, box);
+  painted = svg_vpainted (n, FALSE);
+
+  for (guint i = 0; i < painted->len; i++)
+    {
+      const SvgVEntry *e = g_ptr_array_index (painted, i);
+
+      if (e->stroke && e->profile)
+        {
+          gchar *outline = svg_vprofile_outline (n->d, e->profile, e->width);
+
+          if (outline)
+            pdfv_paint (cr, n, e, outline, 2, box, depth);
+          g_free (outline);
+        }
+      else
+        {
+          pdfv_paint (cr, n, e, n->d, e->stroke ? 1 : 0, box, depth);
+        }
+
+      if (svg_vhas_arrows (e))
+        pdfv_arrows (cr, n, e, box, depth);
+    }
+
+  g_ptr_array_free (painted, TRUE);
+}
+
+/*  the leaves of @n appended to the current path (a clipping shape)  */
+static void
+pdfv_clip_path (cairo_t        *cr,
+                const SvgVNode *n)
+{
+  cairo_matrix_t saved;
+
+  cairo_get_matrix (cr, &saved);
+
+  if (n->has_transform)
+    {
+      cairo_matrix_t m;
+
+      cairo_matrix_init (&m, n->m[0], n->m[1], n->m[2], n->m[3], n->m[4], n->m[5]);
+      cairo_transform (cr, &m);
+    }
+
+  if (n->group)
+    {
+      for (guint i = 0; n->children && i < n->children->len; i++)
+        pdfv_clip_path (cr, g_ptr_array_index (n->children, i));
+    }
+  else if (n->d)
+    {
+      pdfv_path (cr, n->d);
+    }
+
+  cairo_set_matrix (cr, &saved);
+}
+
+/*  « masque d'opacité »: the luminance of the top child @mask, rendered
+ *  at twice the image resolution (cairo has alpha masks only), masks the
+ *  other children, already pushed as a group
+ */
+static void
+pdfv_luminance_mask (cairo_t        *cr,
+                     const SvgVNode *mask,
+                     gint            flags,
+                     gint            depth)
+{
+  cairo_pattern_t *content = cairo_pop_group (cr);
+  gdouble          b[4];
+  gboolean         outside_shows = ! (flags & 2) && ! (flags & 4);
+  const gdouble    s = 2.0;
+  gint             w, h;
+
+  cairo_new_path (cr);
+  pdfv_clip_path (cr, mask);
+  cairo_path_extents (cr, &b[0], &b[1], &b[2], &b[3]);
+  cairo_new_path (cr);
+
+  w = (gint) ceil ((b[2] - b[0]) * s) + 2;
+  h = (gint) ceil ((b[3] - b[1]) * s) + 2;
+
+  if (b[2] > b[0] && b[3] > b[1] && w < 16384 && h < 16384)
+    {
+      cairo_surface_t *img = cairo_image_surface_create (CAIRO_FORMAT_ARGB32, w, h);
+      cairo_surface_t *a8  = cairo_image_surface_create (CAIRO_FORMAT_A8, w, h);
+      cairo_t         *mcr = cairo_create (img);
+      guchar          *src, *dst;
+      gint             ss, ds;
+      cairo_pattern_t *mpat;
+      cairo_matrix_t   mm;
+
+      cairo_scale (mcr, s, s);
+      cairo_translate (mcr, -b[0] + 1.0 / s, -b[1] + 1.0 / s);
+      if (outside_shows)
+        {
+          cairo_set_source_rgb (mcr, 1, 1, 1);
+          cairo_paint (mcr);
+        }
+      pdfv_node (mcr, mask, depth + 1);
+      cairo_destroy (mcr);
+      cairo_surface_flush (img);
+      cairo_surface_flush (a8);
+
+      src = cairo_image_surface_get_data (img);
+      dst = cairo_image_surface_get_data (a8);
+      ss  = cairo_image_surface_get_stride (img);
+      ds  = cairo_image_surface_get_stride (a8);
+
+      for (gint y = 0; y < h; y++)
+        for (gint x = 0; x < w; x++)
+          {
+            guint32 px  = *(guint32 *) (src + y * ss + 4 * x);
+            gdouble a   = ((px >> 24) & 0xff);
+            gdouble lum = 0.2126 * ((px >> 16) & 0xff) + 0.7152 * ((px >> 8) & 0xff) +
+                          0.0722 * (px & 0xff);     /*  premultiplied  */
+
+            if (flags & 4)
+              lum = a - lum;                        /*  « Inverser »  */
+            dst[y * ds + x] = (guchar) CLAMP (lum + 0.5, 0, 255);
+          }
+      cairo_surface_mark_dirty (a8);
+
+      mpat = cairo_pattern_create_for_surface (a8);
+      cairo_matrix_init (&mm, s, 0, 0, s, (-b[0] + 1.0 / s) * s, (-b[1] + 1.0 / s) * s);
+      cairo_pattern_set_matrix (mpat, &mm);
+
+      cairo_save (cr);
+      cairo_rectangle (cr, b[0] - 1.0 / s, b[1] - 1.0 / s, w / s, h / s);
+      cairo_clip (cr);
+      cairo_set_source (cr, content);
+      cairo_mask (cr, mpat);
+      cairo_restore (cr);
+
+      if (outside_shows)
+        {
+          cairo_save (cr);
+          cairo_rectangle (cr, -1e6, -1e6, 2e6, 2e6);
+          cairo_rectangle (cr, b[0] - 1.0 / s, b[1] - 1.0 / s, w / s, h / s);
+          cairo_set_fill_rule (cr, CAIRO_FILL_RULE_EVEN_ODD);
+          cairo_clip (cr);
+          cairo_set_source (cr, content);
+          cairo_paint (cr);
+          cairo_restore (cr);
+        }
+
+      cairo_pattern_destroy (mpat);
+      cairo_surface_destroy (a8);
+      cairo_surface_destroy (img);
+    }
+  else if (outside_shows)
+    {
+      cairo_set_source (cr, content);
+      cairo_paint (cr);
+    }
+
+  cairo_pattern_destroy (content);
+}
+
+static void
+pdfv_node (cairo_t        *cr,
+           const SvgVNode *n,
+           gint            depth)
+{
+  cairo_operator_t op = pdfv_operator (n->mode);
+  gboolean         grp;
+
+  if (! n->visible || depth > CHOP_MAX_DEPTH)
+    return;
+
+  cairo_save (cr);
+
+  if (n->has_transform)
+    {
+      cairo_matrix_t m;
+
+      cairo_matrix_init (&m, n->m[0], n->m[1], n->m[2], n->m[3], n->m[4], n->m[5]);
+      cairo_transform (cr, &m);
+    }
+
+  grp = n->opacity < 1.0 || op != CAIRO_OPERATOR_OVER;
+  if (grp)
+    cairo_push_group (cr);
+
+  if (n->group)
+    {
+      guint nc = n->children ? n->children->len : 0;
+
+      if (n->clip && nc > 0)
+        {
+          cairo_new_path (cr);
+          pdfv_clip_path (cr, g_ptr_array_index (n->children, nc - 1));
+          cairo_set_fill_rule (cr, CAIRO_FILL_RULE_WINDING);
+          cairo_clip (cr);
+          nc--;
+
+          for (guint i = 0; i < nc; i++)
+            pdfv_node (cr, g_ptr_array_index (n->children, i), depth);
+        }
+      else if ((n->opmask & 1) && nc > 1)
+        {
+          cairo_push_group (cr);
+          for (guint i = 0; i < nc - 1; i++)
+            pdfv_node (cr, g_ptr_array_index (n->children, i), depth);
+          pdfv_luminance_mask (cr, g_ptr_array_index (n->children, nc - 1),
+                               n->opmask, depth);
+        }
+      else
+        {
+          for (guint i = 0; i < nc; i++)
+            pdfv_node (cr, g_ptr_array_index (n->children, i), depth);
+        }
+    }
+  else
+    {
+      pdfv_leaf (cr, n, depth);
+    }
+
+  if (grp)
+    {
+      cairo_pop_group_to_source (cr);
+      cairo_set_operator (cr, op);
+      cairo_paint_with_alpha (cr, n->opacity);
+    }
+
+  cairo_restore (cr);
+}
+
+/*  the objects of a vector layer (chopgimp-vobjects-get-xml), NULL
+ *  without ChopGimp's objects
+ */
+static gchar *
+pdfv_get_xml (GimpLayer *layer)
+{
+  GimpProcedure  *procedure;
+  GimpValueArray *retvals;
+  gchar          *xml = NULL;
+
+  procedure = gimp_pdb_lookup_procedure (gimp_get_pdb (), "chopgimp-vobjects-get-xml");
+  if (! procedure)
+    return NULL;
+
+  retvals = gimp_procedure_run (procedure, "layer", layer, NULL);
+
+  if (GIMP_VALUES_GET_ENUM (retvals, 0) == GIMP_PDB_SUCCESS)
+    {
+      const gchar *s = GIMP_VALUES_GET_STRING (retvals, 1);
+
+      if (s && *s)
+        xml = g_strdup (s);
+    }
+
+  gimp_value_array_unref (retvals);
+
+  return xml;
+}
+
+/*  TRUE when the objects of @layer were drawn  */
+static gboolean
+pdfv_draw_vector_layer (cairo_t   *cr,
+                        GimpLayer *layer)
+{
+  gchar    *xml = pdfv_get_xml (layer);
+  SvgVNode *root;
+
+  if (! xml)
+    return FALSE;
+
+  root = svg_vobjects_parse (xml);
+  g_free (xml);
+
+  if (! root)
+    return FALSE;
+
+  pdfv_node (cr, root, 0);
+  svg_vnode_free (root);
+
+  return TRUE;
+}
+
+
+/*  ─── layers ────────────────────────────────────────────────────────── */
+
+typedef struct
+{
+  gdouble x, y, w, h;
+  gchar  *name;
+} ChopBoard;
+
+typedef struct
+{
+  GimpImage         *image;
+  gboolean           vectorize;
+  gboolean           ignore_hidden;
+  gboolean           convert_text;
+  gboolean           fill_bg;
+  gboolean           ocg;            /* PDF layers                        */
+  gdouble            x_res, y_res;
+  gdouble            bg[3];
+  cairo_surface_t   *surface;
+  gboolean           eps;
+  const ChopBoard   *board;
+  GString           *json;           /* OCG: the layers of the page       */
+  gint               n_pages;        /* intermediate pages written        */
+  gint               n_items;
+  gint               done_items;
+  GError           **error;
+} ChopPdf;
+
+/*  GIMP's layer modes as cairo operators (PDF blend modes); the modes PDF
+ *  does not have use the nearest one; *name: the PDF name (OCG groups)
+ */
+static cairo_operator_t
+chop_pdf_operator (GimpLayerMode  mode,
+                   const gchar  **name)
+{
+  const gchar      *n  = "Normal";
+  cairo_operator_t  op = CAIRO_OPERATOR_OVER;
+
+  switch (mode)
+    {
+    case GIMP_LAYER_MODE_MULTIPLY:
+    case GIMP_LAYER_MODE_MULTIPLY_LEGACY:
+      op = CAIRO_OPERATOR_MULTIPLY;    n = "Multiply";   break;
+    case GIMP_LAYER_MODE_SCREEN:
+    case GIMP_LAYER_MODE_SCREEN_LEGACY:
+      op = CAIRO_OPERATOR_SCREEN;      n = "Screen";     break;
+    case GIMP_LAYER_MODE_OVERLAY:
+    case GIMP_LAYER_MODE_OVERLAY_LEGACY:
+    case GIMP_LAYER_MODE_GRAIN_MERGE:            /*  nearest  */
+    case GIMP_LAYER_MODE_GRAIN_MERGE_LEGACY:
+      op = CAIRO_OPERATOR_OVERLAY;     n = "Overlay";    break;
+    case GIMP_LAYER_MODE_DARKEN_ONLY:
+    case GIMP_LAYER_MODE_DARKEN_ONLY_LEGACY:
+    case GIMP_LAYER_MODE_LUMA_DARKEN_ONLY:
+      op = CAIRO_OPERATOR_DARKEN;      n = "Darken";     break;
+    case GIMP_LAYER_MODE_LIGHTEN_ONLY:
+    case GIMP_LAYER_MODE_LIGHTEN_ONLY_LEGACY:
+    case GIMP_LAYER_MODE_LUMA_LIGHTEN_ONLY:
+      op = CAIRO_OPERATOR_LIGHTEN;     n = "Lighten";    break;
+    case GIMP_LAYER_MODE_DODGE:
+    case GIMP_LAYER_MODE_DODGE_LEGACY:
+    case GIMP_LAYER_MODE_DIVIDE:                 /*  nearest  */
+    case GIMP_LAYER_MODE_DIVIDE_LEGACY:
+    case GIMP_LAYER_MODE_VIVID_LIGHT:
+      op = CAIRO_OPERATOR_COLOR_DODGE; n = "ColorDodge"; break;
+    case GIMP_LAYER_MODE_BURN:
+    case GIMP_LAYER_MODE_BURN_LEGACY:
+    case GIMP_LAYER_MODE_LINEAR_BURN:            /*  nearest  */
+      op = CAIRO_OPERATOR_COLOR_BURN;  n = "ColorBurn";  break;
+    case GIMP_LAYER_MODE_HARDLIGHT:
+    case GIMP_LAYER_MODE_HARDLIGHT_LEGACY:
+    case GIMP_LAYER_MODE_LINEAR_LIGHT:           /*  nearest  */
+    case GIMP_LAYER_MODE_PIN_LIGHT:
+    case GIMP_LAYER_MODE_HARD_MIX:
+      op = CAIRO_OPERATOR_HARD_LIGHT;  n = "HardLight";  break;
+    case GIMP_LAYER_MODE_SOFTLIGHT:
+    case GIMP_LAYER_MODE_SOFTLIGHT_LEGACY:
+      op = CAIRO_OPERATOR_SOFT_LIGHT;  n = "SoftLight";  break;
+    case GIMP_LAYER_MODE_DIFFERENCE:
+    case GIMP_LAYER_MODE_DIFFERENCE_LEGACY:
+    case GIMP_LAYER_MODE_SUBTRACT:               /*  nearest  */
+    case GIMP_LAYER_MODE_SUBTRACT_LEGACY:
+    case GIMP_LAYER_MODE_GRAIN_EXTRACT:
+    case GIMP_LAYER_MODE_GRAIN_EXTRACT_LEGACY:
+      op = CAIRO_OPERATOR_DIFFERENCE;  n = "Difference"; break;
+    case GIMP_LAYER_MODE_EXCLUSION:
+      op = CAIRO_OPERATOR_EXCLUSION;   n = "Exclusion";  break;
+    case GIMP_LAYER_MODE_HSV_HUE:
+    case GIMP_LAYER_MODE_HSV_HUE_LEGACY:
+    case GIMP_LAYER_MODE_LCH_HUE:
+      op = CAIRO_OPERATOR_HSL_HUE;     n = "Hue";        break;
+    case GIMP_LAYER_MODE_HSV_SATURATION:
+    case GIMP_LAYER_MODE_HSV_SATURATION_LEGACY:
+    case GIMP_LAYER_MODE_LCH_CHROMA:
+      op = CAIRO_OPERATOR_HSL_SATURATION; n = "Saturation"; break;
+    case GIMP_LAYER_MODE_HSL_COLOR:
+    case GIMP_LAYER_MODE_HSL_COLOR_LEGACY:
+    case GIMP_LAYER_MODE_LCH_COLOR:
+      op = CAIRO_OPERATOR_HSL_COLOR;   n = "Color";      break;
+    case GIMP_LAYER_MODE_HSV_VALUE:
+    case GIMP_LAYER_MODE_HSV_VALUE_LEGACY:
+    case GIMP_LAYER_MODE_LCH_LIGHTNESS:
+    case GIMP_LAYER_MODE_LUMINANCE:
+      op = CAIRO_OPERATOR_HSL_LUMINOSITY; n = "Luminosity"; break;
+    case GIMP_LAYER_MODE_ADDITION:
+    case GIMP_LAYER_MODE_ADDITION_LEGACY:
+      /*  no PDF mode: cairo rasterizes the area (fallback image)  */
+      op = CAIRO_OPERATOR_ADD;         n = "Screen";     break;
+    default:
+      break;
+    }
+
+  if (name)
+    *name = n;
+
+  return op;
+}
+
+/*  the content of a layer, without its opacity, mode and mask  */
+static gboolean
+chop_pdf_draw_content (ChopPdf   *cp,
+                       cairo_t   *cr,
+                       GimpLayer *layer)
+{
+  GimpItem *item = GIMP_ITEM (layer);
+  gint      x, y;
+
+  gimp_drawable_get_offsets (GIMP_DRAWABLE (layer), &x, &y);
+
+  if (gimp_item_is_vector_layer (item) &&
+      ! gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)))
+    {
+      if (! pdfv_draw_vector_layer (cr, layer))
+        drawPath (layer, 1.0, cr, cp->x_res, cp->y_res);
+      return TRUE;
+    }
+
+  if (gimp_item_is_text_layer (item) && ! cp->convert_text &&
+      ! gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)))
+    {
+      drawText (layer, 1.0, cr, cp->x_res, cp->y_res);
+      return TRUE;
+    }
+
+  {
+    GeglColor *color;
+    gboolean   single = FALSE;
+
+    color = get_layer_color (layer, &single);
+
+    if (cp->vectorize && single)
+      {
+        /*  4.0.0: the color itself, not the monitor's rendering  */
+        gdouble rgba[4];
+
+        cairo_rectangle (cr, x, y,
+                         gimp_drawable_get_width  (GIMP_DRAWABLE (layer)),
+                         gimp_drawable_get_height (GIMP_DRAWABLE (layer)));
+        gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), rgba);
+        cairo_set_source_rgba (cr, rgba[0], rgba[1], rgba[2], rgba[3]);
+        cairo_fill (cr);
+      }
+    else
+      {
+        cairo_surface_t *img = get_cairo_surface (GIMP_DRAWABLE (layer), FALSE, cp->error);
+
+        if (! img)
+          {
+            g_object_unref (color);
+            return FALSE;
+          }
+
+        cairo_set_source_surface (cr, img, x, y);
+        cairo_rectangle (cr, x, y,
+                         gimp_drawable_get_width  (GIMP_DRAWABLE (layer)),
+                         gimp_drawable_get_height (GIMP_DRAWABLE (layer)));
+        cairo_fill (cr);
+        cairo_surface_destroy (img);
+      }
+
+    g_object_unref (color);
+  }
+
+  return TRUE;
+}
+
+static gboolean chop_pdf_draw_item (ChopPdf   *cp,
+                                    cairo_t   *cr,
+                                    GimpLayer *layer,
+                                    gboolean   force);
+
+/*  the children of a group, bottom to top  */
+static gboolean
+chop_pdf_draw_children (ChopPdf   *cp,
+                        cairo_t   *cr,
+                        GimpLayer *group)
+{
+  GimpItem **children = gimp_item_get_children (GIMP_ITEM (group));
+  gint       n        = gimp_core_object_array_get_length ((GObject **) children);
+  gboolean   ok       = TRUE;
+
+  for (gint i = n - 1; i >= 0 && ok; i--)
+    ok = chop_pdf_draw_item (cp, cr, GIMP_LAYER (children[i]), FALSE);
+
+  g_free (children);
+
+  return ok;
+}
+
+/*  a layer (or group) with its opacity, blend mode and mask; @force: drawn
+ *  even when hidden (a hidden PDF layer)
+ */
+static gboolean
+chop_pdf_draw_item (ChopPdf   *cp,
+                    cairo_t   *cr,
+                    GimpLayer *layer,
+                    gboolean   force)
+{
+  gdouble           opacity = gimp_layer_get_opacity (layer) / 100.0;
+  GimpLayerMode     mode    = gimp_layer_get_mode (layer);
+  gboolean          group   = gimp_item_is_group (GIMP_ITEM (layer));
+  GimpLayerMask    *mask    = NULL;
+  cairo_operator_t  op      = chop_pdf_operator (mode, NULL);
+  gboolean          wrap;
+  gboolean          ok;
+
+  if (! force &&
+      ! gimp_item_get_visible (GIMP_ITEM (layer)) && cp->ignore_hidden)
+    return TRUE;
+  if (opacity <= 0.0 && cp->ignore_hidden && ! force)
+    return TRUE;
+
+  if (gimp_layer_get_mask (layer) && gimp_layer_get_apply_mask (layer))
+    mask = gimp_layer_get_mask (layer);
+
+  /*  a pass-through group without opacity nor mask: its children directly  */
+  if (group && mode == GIMP_LAYER_MODE_PASS_THROUGH)
+    op = CAIRO_OPERATOR_OVER;
+  wrap = opacity < 1.0 || op != CAIRO_OPERATOR_OVER || mask ||
+         (group && mode != GIMP_LAYER_MODE_PASS_THROUGH);
+
+  cairo_save (cr);
+
+  if (wrap)
+    cairo_push_group (cr);
+
+  ok = group ? chop_pdf_draw_children (cp, cr, layer) : chop_pdf_draw_content (cp, cr, layer);
+
+  if (! group && cp->n_items > 0)
+    gimp_progress_update ((gdouble) ++cp->done_items / cp->n_items);
+
+  if (wrap)
+    {
+      cairo_pattern_t *content = cairo_pop_group (cr);
+
+      if (mask)
+        {
+          cairo_surface_t *mimg = get_cairo_surface (GIMP_DRAWABLE (mask), TRUE, cp->error);
+          gint             mx, my;
+
+          gimp_drawable_get_offsets (GIMP_DRAWABLE (mask), &mx, &my);
+
+          if (mimg)
+            {
+              /*  content × mask, then the opacity and the mode  */
+              cairo_push_group (cr);
+              cairo_set_source (cr, content);
+              cairo_mask_surface (cr, mimg, mx, my);
+              cairo_pattern_destroy (content);
+              content = cairo_pop_group (cr);
+              cairo_surface_destroy (mimg);
+            }
+          else
+            {
+              ok = FALSE;
+            }
+        }
+
+      cairo_set_source (cr, content);
+      cairo_set_operator (cr, op);
+      cairo_paint_with_alpha (cr, opacity);
+      cairo_pattern_destroy (content);
+    }
+
+  cairo_restore (cr);
+
+  return ok;
+}
+
+static gint
+chop_pdf_count (GimpLayer **layers)
+{
+  gint n = 0;
+
+  for (gint i = 0; layers && layers[i]; i++)
+    {
+      if (gimp_item_is_group (GIMP_ITEM (layers[i])))
+        {
+          GimpItem **ch = gimp_item_get_children (GIMP_ITEM (layers[i]));
+
+          n += chop_pdf_count ((GimpLayer **) ch);
+          g_free (ch);
+        }
+      else
+        {
+          n++;
+        }
+    }
+
+  return n;
+}
+
+
+/*  ─── pages ─────────────────────────────────────────────────────────── */
+
+static void
+chop_pdf_page_begin (ChopPdf *cp,
+                     cairo_t *cr)
+{
+  const ChopBoard *b  = cp->board;
+  gdouble          xs = 72.0 / cp->x_res;
+  gdouble          ys = 72.0 / cp->y_res;
+
+  if (cp->eps)
+    cairo_ps_surface_set_size (cp->surface, b->w * xs, b->h * ys);
+  else
+    cairo_pdf_surface_set_size (cp->surface, b->w * xs, b->h * ys);
+
+  cairo_surface_set_fallback_resolution (cp->surface, cp->x_res, cp->y_res);
+
+  cairo_save (cr);
+  cairo_scale (cr, xs, ys);
+  cairo_translate (cr, -b->x, -b->y);
+  cairo_rectangle (cr, b->x, b->y, b->w, b->h);
+  cairo_clip (cr);
+}
+
+static void
+chop_pdf_page_end (ChopPdf *cp,
+                   cairo_t *cr)
+{
+  cairo_restore (cr);
+  cairo_show_page (cr);
+}
+
+static void
+chop_json_string (GString     *s,
+                  const gchar *str)
+{
+  g_string_append_c (s, '"');
+  for (const gchar *p = str ? str : ""; *p; p++)
+    {
+      guchar c = (guchar) *p;
+
+      if (c == '"' || c == '\\')
+        g_string_append_printf (s, "\\%c", c);
+      else if (c < 0x20)
+        g_string_append_printf (s, "\\u%04x", c);
+      else
+        g_string_append_c (s, c);
+    }
+  g_string_append_c (s, '"');
+}
+
+static gboolean chop_pdf_ocg_items (ChopPdf    *cp,
+                                    cairo_t    *cr,
+                                    GimpItem  **items);
+
+/*  OCG: one intermediate page per layer (a group with a mask: one page),
+ *  its node in cp->json
+ */
+static gboolean
+chop_pdf_ocg_item (ChopPdf   *cp,
+                   cairo_t   *cr,
+                   GimpLayer *layer)
+{
+  GimpItem      *item    = GIMP_ITEM (layer);
+  gboolean       visible = gimp_item_get_visible (item);
+  GimpLayerMode  mode    = gimp_layer_get_mode (layer);
+  gchar         *name    = gimp_item_get_name (item);
+  gchar          num[G_ASCII_DTOSTR_BUF_SIZE];
+  gboolean       ok      = TRUE;
+
+  g_string_append_printf (cp->json, "{\"id\": %d, \"name\": ", gimp_item_get_tattoo (item));
+  chop_json_string (cp->json, name);
+  g_string_append_printf (cp->json, ", \"visible\": %s", visible ? "true" : "false");
+  g_free (name);
+
+  if (gimp_item_is_group (item) &&
+      ! (gimp_layer_get_mask (layer) && gimp_layer_get_apply_mask (layer)))
+    {
+      const gchar *pdf_mode = "Normal";
+      GimpItem   **children = gimp_item_get_children (item);
+
+      if (mode != GIMP_LAYER_MODE_PASS_THROUGH)
+        chop_pdf_operator (mode, &pdf_mode);
+
+      g_string_append_printf (cp->json, ", \"opacity\": %s, \"mode\": \"%s\", \"children\": [",
+                              g_ascii_dtostr (num, sizeof (num), gimp_layer_get_opacity (layer) / 100.0),
+                              pdf_mode);
+      ok = chop_pdf_ocg_items (cp, cr, children);
+      g_string_append (cp->json, "]}");
+      g_free (children);
+    }
+  else
+    {
+      g_string_append_printf (cp->json, ", \"page\": %d}", cp->n_pages);
+
+      chop_pdf_page_begin (cp, cr);
+      ok = chop_pdf_draw_item (cp, cr, layer, TRUE);
+      chop_pdf_page_end (cp, cr);
+      cp->n_pages++;
+    }
+
+  return ok;
+}
+
+/*  @items: top first (as GIMP lists them); the JSON lists them bottom first  */
+static gboolean
+chop_pdf_ocg_items (ChopPdf    *cp,
+                    cairo_t    *cr,
+                    GimpItem  **items)
+{
+  gint     n     = gimp_core_object_array_get_length ((GObject **) items);
+  gboolean first = TRUE;
+  gboolean ok    = TRUE;
+
+  for (gint i = n - 1; i >= 0 && ok; i--)
+    {
+      if (! first)
+        g_string_append (cp->json, ", ");
+      first = FALSE;
+      ok = chop_pdf_ocg_item (cp, cr, GIMP_LAYER (items[i]));
+    }
+
+  return ok;
+}
+
+/*  one page (board) of the image, without PDF layers  */
+static gboolean
+chop_pdf_flat_page (ChopPdf *cp,
+                    cairo_t *cr)
+{
+  GimpLayer **layers = gimp_image_get_layers (cp->image);
+  gint        n      = gimp_core_object_array_get_length ((GObject **) layers);
+  gboolean    ok     = TRUE;
+
+  chop_pdf_page_begin (cp, cr);
+
+  if (cp->fill_bg)
+    {
+      cairo_set_source_rgb (cr, cp->bg[0], cp->bg[1], cp->bg[2]);
+      cairo_paint (cr);
+    }
+
+  for (gint i = n - 1; i >= 0 && ok; i--)
+    ok = chop_pdf_draw_item (cp, cr, layers[i], FALSE);
+
+  chop_pdf_page_end (cp, cr);
+  g_free (layers);
+
+  return ok;
+}
+
+/*  writes @path: the boards as pages, with PDF layers when cp->ocg  */
+static gboolean
+chop_pdf_write (ChopPdf         *cp,
+                const gchar     *path,
+                const ChopBoard *boards,
+                gint             n_boards)
+{
+  GimpProcedure *ocg_proc = NULL;
+  gchar         *target   = NULL;
+  FILE          *fp;
+  cairo_t       *cr;
+  gboolean       ok       = TRUE;
+  gboolean       layered  = FALSE;
+
+  if (cp->ocg && ! cp->eps)
+    ocg_proc = gimp_pdb_lookup_procedure (gimp_get_pdb (), CHOP_OCG_PROC);
+
+  layered = ocg_proc != NULL;
+  target  = layered ? g_strdup_printf ("%s.chopgimp-layers.pdf", path) : g_strdup (path);
+
+  fp = g_fopen (target, "wb");
+  if (! fp)
+    {
+      g_set_error (cp->error, G_FILE_ERROR, g_file_error_from_errno (errno),
+                   _("Could not open '%s' for writing: %s"),
+                   gimp_filename_to_utf8 (target), g_strerror (errno));
+      g_free (target);
+      return FALSE;
+    }
+
+  if (cp->eps)
+    {
+      cp->surface = cairo_ps_surface_create_for_stream (write_func, fp, 1, 1);
+      cairo_ps_surface_set_eps (cp->surface, TRUE);
+    }
+  else
+    {
+      cp->surface = cairo_pdf_surface_create_for_stream (write_func, fp, 1, 1);
+      /*  the layers' module reads a classic xref (no object streams), as
+       *  the « Exporter pour l'imprimeur » post-processing (4.2.0)
+       */
+      if (layered || g_str_has_suffix (path, ".chopgimp-print.pdf"))
+        cairo_pdf_surface_restrict_to_version (cp->surface, CAIRO_PDF_VERSION_1_4);
+    }
+
+  if (cairo_surface_status (cp->surface) != CAIRO_STATUS_SUCCESS)
+    {
+      g_set_error (cp->error, G_FILE_ERROR, G_FILE_ERROR_FAILED,
+                   "Cairo: %s", cairo_status_to_string (cairo_surface_status (cp->surface)));
+      cairo_surface_destroy (cp->surface);
+      fclose (fp);
+      g_free (target);
+      return FALSE;
+    }
+
+  cr = cairo_create (cp->surface);
+
+  if (layered)
+    cp->json = g_string_new ("{\"pages\": [");
+  cp->n_pages = 0;
+
+  for (gint b = 0; b < n_boards && ok; b++)
+    {
+      cp->board      = &boards[b];
+      cp->done_items = 0;
+
+      if (layered)
+        {
+          GimpLayer **layers = gimp_image_get_layers (cp->image);
+          gchar       w[G_ASCII_DTOSTR_BUF_SIZE], h[G_ASCII_DTOSTR_BUF_SIZE];
+
+          g_string_append_printf (cp->json, "%s{\"w\": %s, \"h\": %s, \"bg\": ", b ? ", " : "",
+                                  g_ascii_dtostr (w, sizeof (w), boards[b].w * 72.0 / cp->x_res),
+                                  g_ascii_dtostr (h, sizeof (h), boards[b].h * 72.0 / cp->y_res));
+          if (cp->fill_bg)
+            {
+              gchar c[3][G_ASCII_DTOSTR_BUF_SIZE];
+
+              g_string_append_printf (cp->json, "[%s, %s, %s]",
+                                      g_ascii_dtostr (c[0], sizeof (c[0]), cp->bg[0]),
+                                      g_ascii_dtostr (c[1], sizeof (c[1]), cp->bg[1]),
+                                      g_ascii_dtostr (c[2], sizeof (c[2]), cp->bg[2]));
+            }
+          else
+            {
+              g_string_append (cp->json, "null");
+            }
+          g_string_append (cp->json, ", \"layers\": [");
+          ok = chop_pdf_ocg_items (cp, cr, (GimpItem **) layers);
+          g_string_append (cp->json, "]}");
+          g_free (layers);
+        }
+      else
+        {
+          ok = chop_pdf_flat_page (cp, cr);
+        }
+    }
+
+  /*  cairo needs at least one page  */
+  if (layered && cp->n_pages == 0)
+    {
+      cp->board = &boards[0];
+      chop_pdf_page_begin (cp, cr);
+      chop_pdf_page_end (cp, cr);
+    }
+
+  cairo_destroy (cr);
+  cairo_surface_finish (cp->surface);
+  if (cairo_surface_status (cp->surface) != CAIRO_STATUS_SUCCESS && ok)
+    {
+      g_set_error (cp->error, G_FILE_ERROR, G_FILE_ERROR_FAILED,
+                   "Cairo: %s", cairo_status_to_string (cairo_surface_status (cp->surface)));
+      ok = FALSE;
+    }
+  cairo_surface_destroy (cp->surface);
+  cp->surface = NULL;
+  fclose (fp);
+
+  if (layered)
+    {
+      g_string_append (cp->json, "]}");
+
+      if (ok)
+        {
+          GFile          *in  = g_file_new_for_path (target);
+          GFile          *out = g_file_new_for_path (path);
+          GimpValueArray *ret;
+
+          ret = gimp_procedure_run (ocg_proc,
+                                    "input",  in,
+                                    "output", out,
+                                    "spec",   cp->json->str,
+                                    NULL);
+
+          if (GIMP_VALUES_GET_ENUM (ret, 0) != GIMP_PDB_SUCCESS)
+            {
+              /*  a PDF without layers rather than none  */
+              g_printerr ("ChopGimp PDF: PDF layers failed, exported without them\n");
+              cp->ocg = FALSE;
+              g_string_free (cp->json, TRUE);
+              cp->json = NULL;
+              gimp_value_array_unref (ret);
+              g_object_unref (in);
+              g_object_unref (out);
+              g_unlink (target);
+              g_free (target);
+
+              ok = chop_pdf_write (cp, path, boards, n_boards);
+              cp->ocg = TRUE;
+              return ok;
+            }
+
+          gimp_value_array_unref (ret);
+          g_object_unref (in);
+          g_object_unref (out);
+        }
+
+      g_string_free (cp->json, TRUE);
+      cp->json = NULL;
+      g_unlink (target);
+    }
+
+  g_free (target);
+
+  return ok;
+}
+
+/*  « dir/name.pdf » + artboard 2 « Couverture » → « dir/name-02-Couverture.pdf »  */
+static gchar *
+chop_board_path (const gchar *path,
+                 gint         index,
+                 const gchar *name)
+{
+  const gchar *dot   = strrchr (path, '.');
+  const gchar *slash = strrchr (path, G_DIR_SEPARATOR);
+  gchar       *stem;
+  gchar       *safe;
+  gchar       *out;
+
+  if (! dot || (slash && dot < slash))
+    dot = path + strlen (path);
+
+  stem = g_strndup (path, dot - path);
+  safe = g_strdup (name && *name ? name : "Plan");
+  g_strdelimit (safe, "/\\:*?\"<>|", '_');
+
+  out = g_strdup_printf ("%s-%02d-%s%s", stem, index + 1, safe, dot);
+
+  g_free (safe);
+  g_free (stem);
+
+  return out;
+}
+
+/*  the export: @image is the export image (effects merged); @artboards:
+ *  "image", "pages" or "files"
+ */
+static GimpPDBStatusType
+chop_pdf_export (GimpImage           *image,
+                 GimpProcedureConfig *config,
+                 const gchar         *path,
+                 gboolean             eps,
+                 GError             **error)
+{
+  ChopPdf                 cp    = { 0, };
+  ChopGimpPlugInArtboard *ab    = NULL;
+  gint                    n_ab  = 0;
+  ChopBoard              *boards;
+  gint                    n_boards;
+  gint                    mode;
+  gboolean                ok    = TRUE;
+  GeglColor              *bg;
+  GimpLayer             **layers;
+
+  g_object_get (config,
+                "vectorize",             &cp.vectorize,
+                "ignore-hidden",         &cp.ignore_hidden,
+                "fill-background-color", &cp.fill_bg,
+                NULL);
+  if (! eps)
+    g_object_get (config,
+                  "convert-text-layers", &cp.convert_text,
+                  "pdf-layers",          &cp.ocg,
+                  NULL);
+
+  /*  0 image, 1 one page per artboard, 2 one file per artboard  */
+  mode = gimp_procedure_config_get_choice_id (config, "artboards");
+  if (eps && mode == 1)
+    mode = 2;
+
+  cp.image = image;
+  cp.eps   = eps;
+  cp.error = error;
+  gimp_image_get_resolution (image, &cp.x_res, &cp.y_res);
+
+  bg = gimp_context_get_background ();
+  gegl_color_get_pixel (bg, babl_format ("R'G'B' double"), cp.bg);
+  g_object_unref (bg);
+
+  layers     = gimp_image_get_layers (image);
+  cp.n_items = chop_pdf_count (layers);
+  g_free (layers);
+
+  if (mode != 0)
+    ab = chopgimp_plug_in_artboards_get (image, &n_ab);
+
+  if (n_ab > 0)
+    {
+      boards   = g_new0 (ChopBoard, n_ab);
+      n_boards = n_ab;
+      for (gint i = 0; i < n_ab; i++)
+        {
+          boards[i].x    = ab[i].x;
+          boards[i].y    = ab[i].y;
+          boards[i].w    = ab[i].width;
+          boards[i].h    = ab[i].height;
+          boards[i].name = ab[i].name;
+        }
+    }
+  else
+    {
+      mode     = 0;
+      boards   = g_new0 (ChopBoard, 1);
+      n_boards = 1;
+      boards[0].w = gimp_image_get_width (image);
+      boards[0].h = gimp_image_get_height (image);
+    }
+
+  if (mode == 2 || (eps && n_boards > 1))
+    {
+      for (gint i = 0; i < n_boards && ok; i++)
+        {
+          gchar *p = chop_board_path (path, i, boards[i].name);
+
+          cp.done_items = 0;
+          ok = chop_pdf_write (&cp, p, &boards[i], 1);
+          g_free (p);
+        }
+    }
+  else
+    {
+      ok = chop_pdf_write (&cp, path, boards, n_boards);
+    }
+
+  gimp_progress_update (1.0);
+
+  g_free (boards);
+  chopgimp_plug_in_artboards_free (ab, n_ab);
+
+  return ok ? GIMP_PDB_SUCCESS : GIMP_PDB_EXECUTION_ERROR;
+}
