   GtkWidget   *dialog_button;
 } ColorPop;
@@ -259,6 +297,8 @@ colorpop_swatch_clicked (GtkWidget *button,
   if (color)
     {
       g_object_set (cp->options, cp->prop, color, NULL);
+      if (cp->style_prop)
+        g_object_set (cp->options, cp->style_prop, GIMP_CUSTOM_STYLE_SOLID_COLOR, NULL);
       if (cp->enable_prop)
         g_object_set (cp->options, cp->enable_prop, TRUE, NULL);
