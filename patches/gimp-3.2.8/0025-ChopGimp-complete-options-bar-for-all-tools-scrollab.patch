+    GtkWidget *scrolled = gtk_scrolled_window_new (NULL, NULL);
+
+    gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled),
+                                    GTK_POLICY_AUTOMATIC, GTK_POLICY_NEVER);
+    gtk_scrolled_window_set_propagate_natural_height (GTK_SCROLLED_WINDOW (scrolled), TRUE);
+    gtk_scrolled_window_set_overlay_scrolling (GTK_SCROLLED_WINDOW (scrolled), TRUE);
+    gtk_box_pack_start (GTK_BOX (bar), scrolled, TRUE, TRUE, 0);
+    gtk_widget_set_visible (scrolled, TRUE);
+
+    box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 10);
+    gtk_container_add (GTK_CONTAINER (scrolled), box);
+    gtk_widget_set_visible (box, TRUE);
+  }
   g_object_set_data (G_OBJECT (bar), "photogimp-box", box);
 
   more = gtk_button_new_from_icon_name ("gimp-tool-options", GTK_ICON_SIZE_SMALL_TOOLBAR);
