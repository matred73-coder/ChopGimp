@@ -267,6 +307,25 @@ colorpop_swatch_clicked (GtkWidget *button,
   gtk_popover_popdown (GTK_POPOVER (cp->popover));
 }
 
+static void
+colorpop_pattern_clicked (GtkWidget *button,
+                          ColorPop  *cp)
+{
+  GimpPattern *pattern = g_object_get_data (G_OBJECT (button), "photogimp-pattern");
+
+  if (pattern && cp->style_prop && cp->pattern_prop)
+    {
+      g_object_set (cp->options,
+                    cp->pattern_prop, pattern,
+                    cp->style_prop,   GIMP_CUSTOM_STYLE_PATTERN,
+                    NULL);
+      if (cp->enable_prop)
+        g_object_set (cp->options, cp->enable_prop, TRUE, NULL);
+    }
+
+  gtk_popover_popdown (GTK_POPOVER (cp->popover));
+}
+
 static void
 colorpop_none_clicked (GtkWidget *button,
                        ColorPop  *cp)
@@ -378,6 +437,36 @@ colorpop_build (GtkWidget *popover,
         }
     }
 
+  /*  patterns (fill / stroke of shapes)  */
+  if (cp->pattern_prop)
+    {
+      GimpContainer *patterns = gimp_data_factory_get_container (cp->gimp->pattern_factory);
+      GimpContext   *context  = gimp_get_user_context (cp->gimp);
+      GtkWidget     *label    = gtk_label_new (_("Motifs"));
+      GtkWidget     *pgrid    = gtk_grid_new ();
+      GList         *plist;
+
+      gtk_widget_set_halign (label, GTK_ALIGN_START);
+      gtk_style_context_add_class (gtk_widget_get_style_context (label), "dim-label");
+      gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 0);
+      gtk_box_pack_start (GTK_BOX (vbox), pgrid, FALSE, FALSE, 0);
+
+      for (plist = GIMP_LIST (patterns)->queue->head, i = 0; plist && i < 36;
+           plist = plist->next, i++)
+        {
+          GtkWidget *pbutton = gtk_button_new ();
+          GtkWidget *view    = gimp_view_new (context, GIMP_VIEWABLE (plist->data), 24, 1, FALSE);
+
+          gtk_container_add (GTK_CONTAINER (pbutton), view);
+          gtk_button_set_relief (GTK_BUTTON (pbutton), GTK_RELIEF_NONE);
+          gtk_style_context_add_class (gtk_widget_get_style_context (pbutton), "chopgimp-swatch");
+          gimp_help_set_help_data (pbutton, gimp_object_get_name (plist->data), NULL);
+          g_object_set_data (G_OBJECT (pbutton), "photogimp-pattern", plist->data);
+          g_signal_connect (pbutton, "clicked", G_CALLBACK (colorpop_pattern_clicked), cp);
+          gtk_grid_attach (GTK_GRID (pgrid), pbutton, i % 12, i / 12, 1, 1);
+        }
+    }
+
