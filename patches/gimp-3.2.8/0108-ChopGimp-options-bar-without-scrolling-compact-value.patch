+/*  the box of the bar: minimum width 0, children past the end hidden  */
+typedef GtkBox      ChopGimpBarBox;
+typedef GtkBoxClass ChopGimpBarBoxClass;
+
+GType chopgimp_bar_box_get_type (void);
+
+G_DEFINE_TYPE (ChopGimpBarBox, chopgimp_bar_box, GTK_TYPE_BOX)
+
+static void
+chopgimp_bar_box_get_preferred_width (GtkWidget *widget,
+                                      gint      *minimum,
+                                      gint      *natural)
+{
+  GTK_WIDGET_CLASS (chopgimp_bar_box_parent_class)->get_preferred_width (widget,
+                                                                         minimum,
+                                                                         natural);
+  /*  what does not fit goes into « ⋯ »  */
+  *minimum = 0;
+}
+
+static void
+chopgimp_bar_box_get_preferred_height_for_width (GtkWidget *widget,
+                                                 gint       width,
+                                                 gint      *minimum,
+                                                 gint      *natural)
+{
+  GTK_WIDGET_CLASS (chopgimp_bar_box_parent_class)->get_preferred_height (widget,
+                                                                          minimum,
+                                                                          natural);
+}
+
+static void
+chopgimp_bar_box_get_preferred_height_and_baseline_for_width (GtkWidget *widget,
+                                                              gint       width,
+                                                              gint      *minimum,
+                                                              gint      *natural,
+                                                              gint      *minimum_baseline,
+                                                              gint      *natural_baseline)
+{
+  GTK_WIDGET_CLASS (chopgimp_bar_box_parent_class)->get_preferred_height_and_baseline_for_width (widget, -1,
+                                                                                                minimum,
+                                                                                                natural,
+                                                                                                minimum_baseline,
+                                                                                                natural_baseline);
+}
+
+static void
+chopgimp_bar_box_size_allocate (GtkWidget     *widget,
+                                GtkAllocation *allocation)
+{
+  BarState      *st   = g_object_get_data (G_OBJECT (widget), BAR_STATE_KEY);
+  GtkAllocation  real = *allocation;
+  GList         *children;
+  GList         *iter;
+  gint           minimum;
+
+  /*  GtkBox never gets less than its true minimum...  */
+  GTK_WIDGET_CLASS (chopgimp_bar_box_parent_class)->get_preferred_width (widget,
+                                                                         &minimum,
+                                                                         NULL);
+  real.width = MAX (real.width, minimum);
+
+  GTK_WIDGET_CLASS (chopgimp_bar_box_parent_class)->size_allocate (widget, &real);
+
+  /*  ...and what goes past the end is hidden until the idle moves it  */
+  children = gtk_container_get_children (GTK_CONTAINER (widget));
+  for (iter = children; iter; iter = iter->next)
+    {
+      GtkWidget     *child = iter->data;
+      GtkAllocation  ca;
+      gboolean       fits;
+
+      if (! gtk_widget_get_visible (child))
+        continue;
+
+      gtk_widget_get_allocation (child, &ca);
+      fits = ca.x + ca.width <= allocation->x + allocation->width;
+
+      if (gtk_widget_get_child_visible (child) != fits)
+        gtk_widget_set_child_visible (child, fits);
+    }
+  g_list_free (children);
+
+  if (real.width != allocation->width)
+    {
+      gtk_widget_set_allocation (widget, allocation);
+      gtk_widget_set_clip (widget, allocation);
+    }
+
+  if (st)
+    {
+      st->avail = allocation->width;
+
+      if (! st->idle_id)
+        st->idle_id = g_idle_add_full (G_PRIORITY_HIGH_IDLE + 15,
+                                       bar_relayout_idle, st, NULL);
+    }
+}
+
+static void
+chopgimp_bar_box_class_init (ChopGimpBarBoxClass *klass)
+{
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  widget_class->get_preferred_width            = chopgimp_bar_box_get_preferred_width;
+  widget_class->get_preferred_height_for_width = chopgimp_bar_box_get_preferred_height_for_width;
+  widget_class->get_preferred_height_and_baseline_for_width =
+    chopgimp_bar_box_get_preferred_height_and_baseline_for_width;
+  widget_class->size_allocate                  = chopgimp_bar_box_size_allocate;
+}
