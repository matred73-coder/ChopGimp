+/*  ChopGimp: unit shown after the value  */
+static const gchar *
+gimp_options_bar_unit (GObject     *options,
+                       const gchar *prop)
+{
+  static const gchar *const px[] =
+  {
+    "brush-size", "size", "feather-radius", "stroke-width", "corner-radius",
+    "average-radius", "effect-size", "stabilizer-length", "square-size", NULL
+  };
+  static const gchar *const percent[] =
+  {
+    "flow", "exposure", "rate", "offset", NULL
+  };
+  gint i;
+
+  if (! strcmp (prop, "font-size") &&
+      g_object_class_find_property (G_OBJECT_GET_CLASS (options), "font-size-unit"))
+    {
+      GimpUnit    *unit = NULL;
+      const gchar *abbr = "px";
+
+      g_object_get (options, "font-size-unit", &unit, NULL);
+      if (unit)
+        {
+          abbr = gimp_unit_get_abbreviation (unit);
+          g_object_unref (unit);
+        }
+
+      return abbr;
+    }
+
+  if (strstr (prop, "angle"))
+    return "°";
+
+  for (i = 0; px[i]; i++)
+    if (! strcmp (prop, px[i]))
+      return "px";
+
+  for (i = 0; percent[i]; i++)
+    if (! strcmp (prop, percent[i]))
+      return "%";
+
+  return NULL;
+}
 
