+/*  ─── pixel art (depixelize) ────────────────────────────────────────── */
+
+void
+append_pathvector (PathBuilder &pb, const Geom::PathVector &pv)
+{
+  for (const Geom::Path &path : pv)
+    {
+      if (path.empty ())
+        continue;
+      Geom::Point s = path.initialPoint ();
+      pb.move (s[Geom::X], s[Geom::Y]);
+      for (const Geom::Curve &c : path)
+        {
+          Geom::Point e = c.finalPoint ();
+          if (auto cb = dynamic_cast<const Geom::CubicBezier *> (&c))
+            {
+              pb.curve ((*cb)[1][Geom::X], (*cb)[1][Geom::Y],
+                        (*cb)[2][Geom::X], (*cb)[2][Geom::Y], e[Geom::X], e[Geom::Y]);
+            }
+          else if (auto qb = dynamic_cast<const Geom::QuadraticBezier *> (&c))
+            {
+              Geom::Point p0 = (*qb)[0], p1 = (*qb)[1], p2 = (*qb)[2];
+              Geom::Point c1 = p0 + (p1 - p0) * (2.0 / 3.0);
+              Geom::Point c2 = p2 + (p1 - p2) * (2.0 / 3.0);
+              pb.curve (c1[Geom::X], c1[Geom::Y], c2[Geom::X], c2[Geom::Y],
+                        e[Geom::X], e[Geom::Y]);
+            }
+          else
+            {
+              pb.line (e[Geom::X], e[Geom::Y]);
+            }
+        }
+      if (path.closed ())
+        pb.close ();
+    }
+}
+
+bool
+trace_pixelart (Job &job, std::vector<Shape> &out, GError **error)
+{
+  const ChopGimpTraceOptions *o = job.o;
+
+  if ((gint64) job.w * job.h > 1024 * 1024)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                   _("Pixel art : l'image est trop grande (%d × %d pixels, "
+                     "au plus 1 million de pixels). Réduisez-la ou "
+                     "choisissez un autre moteur."), job.w, job.h);
+      return false;
+    }
+
+  /* transparent pixels (ignored) stay transparent, else on white */
+  std::vector<guint8> px (job.rgba);
+  for (gsize i = 0; i < (gsize) job.w * job.h; i++)
+    if (job.labels[i] == NO_LABEL)
+      memset (&px[i * 4], 0, 4);
+
+  Tracer::Image img = { px.data (), job.w, job.h, job.w * 4, 4 };
+  Tracer::Kopf2011::Options kopts;
+  kopts.optimize = o->paths < 80.0;
+  kopts.curvesMultiplier = 1.0 + (100.0 - CLAMP (o->corners, 0.0, 100.0)) / 100.0;
+
+  Tracer::Splines splines;
+  try
+    {
+      splines = o->paths >= 95.0 ? Tracer::Kopf2011::to_voronoi (img, kopts)
+                                 : Tracer::Kopf2011::to_splines (img, kopts);
+    }
+  catch (...)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                   _("Pixel art : la vectorisation a échoué."));
+      return false;
+    }
+
+  for (const Tracer::Splines::Path &p : splines)
+    {
+      if (p.rgba[3] < 128)
+        continue;
+      if (o->ignore_white)
+        {
+          Lab l = rgb_to_lab (p.rgba);
+          if (l.L >= 95.0f && fabsf (l.a) < 4 && fabsf (l.b) < 4)
+            continue;
+        }
+
+      PathBuilder pb (job.ox, job.oy);
+      append_pathvector (pb, p.pathVector);
+      if (pb.anchors == 0)
+        continue;
+
+      Shape sh;
+      memcpy (sh.rgb, p.rgba, 3);
+      sh.stroke  = FALSE;
+      sh.width   = 0;
+      sh.anchors = pb.anchors;
+      sh.d       = std::move (pb.d);
+      sh.g       = std::move (pb.g);
+      out.push_back (std::move (sh));
+    }
+  return true;
+}
