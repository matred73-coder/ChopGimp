+/*  ─── options as text ───────────────────────────────────────────────── */
+
+struct EnumName { int value; const gchar *name; };
+
+const EnumName engine_names[] = { { CHOPGIMP_TRACE_ENGINE_POTRACE, "potrace" },
+                                  { CHOPGIMP_TRACE_ENGINE_CENTERLINE, "centerline" },
+                                  { CHOPGIMP_TRACE_ENGINE_PIXELART, "pixelart" } };
+const EnumName mode_names[]   = { { CHOPGIMP_TRACE_MODE_COLOR, "color" },
+                                  { CHOPGIMP_TRACE_MODE_GRAY, "gray" },
+                                  { CHOPGIMP_TRACE_MODE_BW, "bw" } };
+const EnumName palette_names[] = { { CHOPGIMP_TRACE_PALETTE_AUTO, "auto" },
+                                   { CHOPGIMP_TRACE_PALETTE_LIMITED, "limited" },
+                                   { CHOPGIMP_TRACE_PALETTE_CUSTOM, "custom" } };
+const EnumName method_names[] = { { CHOPGIMP_TRACE_METHOD_ABUTTING, "abutting" },
+                                  { CHOPGIMP_TRACE_METHOD_OVERLAPPING, "overlapping" } };
+
+template<gsize N>
+const gchar *
+enum_name (const EnumName (&names)[N], int value)
+{
+  for (const EnumName &e : names)
+    if (e.value == value)
+      return e.name;
+  return names[0].name;
+}
+
+template<gsize N>
+int
+enum_value (const EnumName (&names)[N], const gchar *name, int fallback)
+{
+  for (const EnumName &e : names)
+    if (! g_ascii_strcasecmp (e.name, name))
+      return e.value;
+  return fallback;
+}
