+extern "C" void
+chopgimp_trace_options_init (ChopGimpTraceOptions *options)
+{
+  g_return_if_fail (options != NULL);
+
+  memset (options, 0, sizeof (*options));
+  options->engine             = CHOPGIMP_TRACE_ENGINE_POTRACE;
+  options->mode               = CHOPGIMP_TRACE_MODE_BW;
+  options->palette            = CHOPGIMP_TRACE_PALETTE_AUTO;
+  options->n_colors           = 6;
+  options->color_fidelity     = 50.0;
+  options->threshold          = 128.0;
+  options->invert             = FALSE;
+  options->paths              = 50.0;
+  options->corners            = 75.0;
+  options->noise              = 25;
+  options->blur               = 0.0;
+  options->method             = CHOPGIMP_TRACE_METHOD_ABUTTING;
+  options->fills              = TRUE;
+  options->strokes            = FALSE;
+  options->max_stroke_width   = 10.0;
+  options->min_stroke_length  = 20.0;
+  options->snap_lines         = FALSE;
+  options->ignore_white       = TRUE;
+  options->ignore_transparent = TRUE;
+}
