+extern "C" const gchar * const *
+chopgimp_trace_get_presets (void)
+{
+  static std::once_flag once;
+
+  std::call_once (once, []
+    {
+      for (gsize i = 0; i < G_N_ELEMENTS (presets); i++)
+        preset_ids[i] = presets[i].id;
+      preset_ids[G_N_ELEMENTS (presets)] = NULL;
+    });
+  return preset_ids;
+}
+
+extern "C" const gchar *
+chopgimp_trace_get_preset_label (const gchar *id)
+{
+  for (const Preset &p : presets)
+    if (! g_strcmp0 (p.id, id))
+      return _(p.label);
+  return NULL;
+}
+
+extern "C" gboolean
+chopgimp_trace_options_set_preset (ChopGimpTraceOptions *o,
+                                   const gchar          *id)
+{
+  g_return_val_if_fail (o != NULL, FALSE);
+
+  if (! chopgimp_trace_get_preset_label (id))
+    return FALSE;
+
+  chopgimp_trace_options_clear (o);
+  chopgimp_trace_options_init (o);
+
+  if (! strcmp (id, "photo-high"))
+    {
+      o->mode = CHOPGIMP_TRACE_MODE_COLOR; o->palette = CHOPGIMP_TRACE_PALETTE_AUTO;
+      o->n_colors = 48; o->color_fidelity = 90;
+      o->paths = 90; o->corners = 75; o->noise = 4;
+      o->method = CHOPGIMP_TRACE_METHOD_OVERLAPPING; o->ignore_white = FALSE;
+    }
+  else if (! strcmp (id, "photo-low"))
+    {
+      o->mode = CHOPGIMP_TRACE_MODE_COLOR; o->palette = CHOPGIMP_TRACE_PALETTE_AUTO;
+      o->n_colors = 24; o->color_fidelity = 50;
+      o->paths = 70; o->corners = 75; o->noise = 16; o->blur = 1.0;
+      o->method = CHOPGIMP_TRACE_METHOD_OVERLAPPING; o->ignore_white = FALSE;
+    }
+  else if (! strcmp (id, "3-colors") || ! strcmp (id, "6-colors") || ! strcmp (id, "16-colors"))
+    {
+      o->mode = CHOPGIMP_TRACE_MODE_COLOR; o->palette = CHOPGIMP_TRACE_PALETTE_LIMITED;
+      o->n_colors = id[0] == '3' ? 3 : id[0] == '6' ? 6 : 16;
+      o->paths = o->n_colors == 16 ? 80 : 75; o->corners = 75;
+      o->noise = o->n_colors == 16 ? 12 : 25; o->blur = 0.5;
+      o->ignore_white = FALSE;
+    }
+  else if (! strcmp (id, "gray"))
+    {
+      o->mode = CHOPGIMP_TRACE_MODE_GRAY; o->palette = CHOPGIMP_TRACE_PALETTE_LIMITED;
+      o->n_colors = 8; o->paths = 75; o->corners = 75; o->noise = 16;
+      o->method = CHOPGIMP_TRACE_METHOD_OVERLAPPING; o->ignore_white = FALSE;
+    }
+  else if (! strcmp (id, "bw-logo"))
+    {
+      o->threshold = 128; o->paths = 90; o->corners = 90; o->noise = 10;
+      o->snap_lines = TRUE;
+    }
+  else if (! strcmp (id, "sketch"))
+    {
+      o->threshold = 185; o->paths = 50; o->corners = 50; o->noise = 40; o->blur = 1.0;
+    }
+  else if (! strcmp (id, "silhouettes"))
+    {
+      o->threshold = 220; o->paths = 50; o->corners = 75; o->noise = 50; o->blur = 2.0;
+    }
+  else if (! strcmp (id, "line-art"))
+    {
+      o->engine = CHOPGIMP_TRACE_ENGINE_CENTERLINE;
+      o->threshold = 128; o->paths = 50; o->corners = 50; o->noise = 25;
+      o->fills = FALSE; o->strokes = TRUE;
+      o->max_stroke_width = 10; o->min_stroke_length = 10;
+    }
+  else if (! strcmp (id, "technical"))
+    {
+      o->engine = CHOPGIMP_TRACE_ENGINE_CENTERLINE;
+      o->threshold = 128; o->paths = 85; o->corners = 95; o->noise = 10;
+      o->fills = FALSE; o->strokes = TRUE; o->snap_lines = TRUE;
+      o->max_stroke_width = 4; o->min_stroke_length = 5;
+    }
+  else if (! strcmp (id, "pixel-art"))
+    {
+      o->engine = CHOPGIMP_TRACE_ENGINE_PIXELART;
+      o->mode = CHOPGIMP_TRACE_MODE_COLOR; o->paths = 50; o->corners = 50;
+      o->noise = 0; o->ignore_white = FALSE;
+    }
+  return TRUE;
+}
