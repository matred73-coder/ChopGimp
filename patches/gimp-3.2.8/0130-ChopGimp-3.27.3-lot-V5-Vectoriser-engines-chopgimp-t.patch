+/*  ─── small helpers ─────────────────────────────────────────────────── */
+
+struct Lab { float L, a, b; };
+
+float srgb_lut[256];
+std::once_flag lut_once;
+
+void
+init_lut ()
+{
+  for (int i = 0; i < 256; i++)
+    {
+      double c = i / 255.0;
+      srgb_lut[i] = (float) (c <= 0.04045 ? c / 12.92 : pow ((c + 0.055) / 1.055, 2.4));
+    }
+}
+
+inline float
+lab_f (float t)
+{
+  return t > 0.008856f ? cbrtf (t) : 7.787f * t + 16.0f / 116.0f;
+}
+
+Lab
+rgb_to_lab (const guint8 *p)
+{
+  float r = srgb_lut[p[0]], g = srgb_lut[p[1]], b = srgb_lut[p[2]];
+  float x = (0.4124f * r + 0.3576f * g + 0.1805f * b) / 0.95047f;
+  float y =  0.2126f * r + 0.7152f * g + 0.0722f * b;
+  float z = (0.0193f * r + 0.1192f * g + 0.9505f * b) / 1.08883f;
+  float fx = lab_f (x), fy = lab_f (y), fz = lab_f (z);
+
+  return { 116.0f * fy - 16.0f, 500.0f * (fx - fy), 200.0f * (fy - fz) };
+}
+
+inline float
+lab_dist2 (const Lab &a, const Lab &b)
+{
+  float dl = a.L - b.L, da = a.a - b.a, db = a.b - b.b;
+  return dl * dl + da * da + db * db;
+}
+
+/*  numbers for SVG: locale independent, trailing zeros dropped  */
+void
+append_num (std::string &s, double v)
+{
+  char buf[G_ASCII_DTOSTR_BUF_SIZE];
+
+  if (fabs (v) < 0.005)
+    v = 0.0;
+  g_ascii_formatd (buf, sizeof (buf), "%.2f", v);
+
+  char *dot = strchr (buf, '.');
+  if (dot)
+    {
+      char *e = buf + strlen (buf) - 1;
+      while (e > dot && *e == '0')
+        *e-- = '\0';
+      if (e == dot)
+        *e = '\0';
+    }
+  if (! strcmp (buf, "-0"))
+    strcpy (buf, "0");
+  s += buf;
+}
+
+void
+append_pt (std::string &s, double x, double y)
+{
+  append_num (s, x);
+  s += ' ';
+  append_num (s, y);
+}
+
+
+/*  ─── geometry kept for drawing ─────────────────────────────────────── */
+
+enum Op : guint8 { OP_MOVE, OP_LINE, OP_CURVE, OP_CLOSE };
+
+struct Geometry
+{
+  std::vector<guint8> ops;
+  std::vector<float>  pts;     /* MOVE / LINE: 2, CURVE: 6, CLOSE: 0 */
+};
+
+/*  builds the d string and the geometry together  */
+struct PathBuilder
+{
+  std::string d;
+  Geometry    g;
+  gint        anchors = 0;
+  double      ox, oy;          /* offset added to every point */
+  double      cx = 0, cy = 0;
+  double      sx = 0, sy = 0;
+  double      length = 0;
+
+  PathBuilder (double offx, double offy) : ox (offx), oy (offy) {}
+
+  void move (double x, double y)
+  {
+    if (! d.empty ())
+      d += ' ';
+    d += 'M';
+    append_pt (d, x + ox, y + oy);
+    g.ops.push_back (OP_MOVE);
+    g.pts.push_back ((float) (x + ox));
+    g.pts.push_back ((float) (y + oy));
+    cx = sx = x; cy = sy = y;
+    anchors++;
+  }
+
+  void line (double x, double y)
+  {
+    d += " L";
+    append_pt (d, x + ox, y + oy);
+    g.ops.push_back (OP_LINE);
+    g.pts.push_back ((float) (x + ox));
+    g.pts.push_back ((float) (y + oy));
+    length += hypot (x - cx, y - cy);
+    cx = x; cy = y;
+    anchors++;
+  }
+
+  void curve (double x1, double y1, double x2, double y2, double x, double y)
+  {
+    d += " C";
+    append_pt (d, x1 + ox, y1 + oy); d += ' ';
+    append_pt (d, x2 + ox, y2 + oy); d += ' ';
+    append_pt (d, x + ox, y + oy);
+    g.ops.push_back (OP_CURVE);
+    for (double v : { x1 + ox, y1 + oy, x2 + ox, y2 + oy, x + ox, y + oy })
+      g.pts.push_back ((float) v);
+    /* chord + control polygon / 2: good enough for a length threshold */
+    length += (hypot (x - cx, y - cy) +
+               hypot (x1 - cx, y1 - cy) + hypot (x2 - x1, y2 - y1) + hypot (x - x2, y - y2)) / 2;
+    cx = x; cy = y;
+    anchors++;
+  }
+
+  /*  a curve, or a line when « snap lines » and the controls are on the
+   *  chord (within @tol pixels)
+   */
+  void curve_or_line (double x1, double y1, double x2, double y2, double x, double y,
+                      gboolean snap, double tol)
+  {
+    if (snap)
+      {
+        double dx = x - cx, dy = y - cy;
+        double len = hypot (dx, dy);
+
+        if (len > 1e-9)
+          {
+            double d1 = fabs ((x1 - cx) * dy - (y1 - cy) * dx) / len;
+            double d2 = fabs ((x2 - cx) * dy - (y2 - cy) * dx) / len;
+            if (d1 < tol && d2 < tol)
+              {
+                line (x, y);
+                return;
+              }
+          }
+      }
+    curve (x1, y1, x2, y2, x, y);
+  }
+
+  void close ()
+  {
+    d += " Z";
+    g.ops.push_back (OP_CLOSE);
+    length += hypot (sx - cx, sy - cy);
+    cx = sx; cy = sy;
+  }
+};
