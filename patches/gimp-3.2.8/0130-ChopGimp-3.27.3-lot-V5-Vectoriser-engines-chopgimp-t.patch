+/*  « strokes » with fills: the thin parts of @mask (narrower than the
+ *  maximum stroke width, long enough) are taken out of it into @thin
+ */
+bool
+split_thin (Job &job, std::vector<guint8> &mask, std::vector<guint8> &thin)
+{
+  const ChopGimpTraceOptions *o = job.o;
+  const int   w = job.w, h = job.h;
+  const gsize n = (gsize) w * h;
+  const float r = (float) MAX (0.5, o->max_stroke_width / 2.0);
+
+  /* opening by a disk of radius r: eroded = dist > r, opened = within r
+   * of the eroded set
+   */
+  std::vector<float>  d = distance_transform (mask, w, h);
+  std::vector<guint8> not_eroded (n);
+  for (gsize i = 0; i < n; i++)
+    not_eroded[i] = ! (d[i] > r * r);
+  std::vector<float>  d2 = distance_transform (not_eroded, w, h);
+
+  thin.assign (n, 0);
+  bool any = false;
+  for (gsize i = 0; i < n; i++)
+    if (mask[i] && ! (d2[i] <= (r + 0.5f) * (r + 0.5f) && d2[i] > 0) && d[i] <= r * r)
+      {
+        thin[i] = 1;
+        any = true;
+      }
+  if (! any)
+    return false;
+
+  /* keep the thin components that make real strokes */
+  const gint64 min_area = (gint64) MAX (4.0, o->max_stroke_width *
+                                        MAX (o->min_stroke_length, 2.0 * o->max_stroke_width));
+  std::vector<gint32> stack, members;
+  std::vector<guint8> seen (n, 0);
+  any = false;
+  for (gsize s = 0; s < n; s++)
+    {
+      if (! thin[s] || seen[s])
+        continue;
+      members.clear ();
+      stack.assign (1, (gint32) s);
+      seen[s] = 1;
+      while (! stack.empty ())
+        {
+          gint32 i = stack.back (); stack.pop_back ();
+          members.push_back (i);
+          int x = i % w, y = i / w;
+          for (int dy = -1; dy <= 1; dy++)
+            for (int dx = -1; dx <= 1; dx++)
+              {
+                int qx = x + dx, qy = y + dy;
+                if (qx < 0 || qy < 0 || qx >= w || qy >= h)
+                  continue;
+                gint32 j = qy * w + qx;
+                if (thin[j] && ! seen[j])
+                  seen[j] = 1, stack.push_back (j);
+              }
+        }
+      if ((gint64) members.size () < min_area)
+        for (gint32 i : members)
+          thin[i] = 0;
+      else
+        {
+          any = true;
+          for (gint32 i : members)
+            mask[i] = 0;
+        }
+    }
+  return any;
+}
