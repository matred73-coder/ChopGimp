+
+GeglColor *
+color_new (const guint8 rgb[3])
+{
+  GeglColor *c = gegl_color_new (NULL);
+  gdouble    v[4] = { rgb[0] / 255.0, rgb[1] / 255.0, rgb[2] / 255.0, 1.0 };
+
+  gegl_color_set_pixel (c, babl_format ("R'G'B'A double"), v);
+  return c;
+}
+
+void
+color_get (GeglColor *c, guint8 rgb[3])
+{
+  gdouble v[4] = { 0, 0, 0, 1 };
+
+  gegl_color_get_pixel (c, babl_format ("R'G'B'A double"), v);
+  for (int i = 0; i < 3; i++)
+    rgb[i] = (guint8) CLAMP (lround (v[i] * 255.0), 0, 255);
+}
+
+
+/*  ─── the job ───────────────────────────────────────────────────────── */
+
+const guint16 NO_LABEL = 0xffff;
+
+struct Color
+{
+  Lab     lab;
+  double  sum[3] = { 0, 0, 0 };
+  gint64  area = 0;
+  guint8  rgb[3];
+};
+
+struct Job
+{
+  const ChopGimpTraceOptions *o;
+  gint                        w, h;
+  gint                        ox, oy;
+  std::vector<guint8>         rgba;       /* w × h × 4 */
+  std::vector<guint16>        labels;     /* w × h */
+  std::vector<Color>          colors;
+
+  GCancellable               *cancellable;
+  std::atomic<bool>           cancelled { false };
+
+  /*  progress: work units done / total  */
+  std::atomic<gint64>         done { 0 };
+  gint64                      total = 1;
+
+  std::mutex                  lock;       /* shapes */
+  std::vector<std::vector<Shape>> pass_shapes;   /* per pass */
+
+  bool is_cancelled ()
+  {
+    if (cancelled.load ())
+      return true;
+    if (cancellable && g_cancellable_is_cancelled (cancellable))
+      {
+        cancelled = true;
+        return true;
+      }
+    return false;
+  }
+};
+
+
+/*  ─── pre-processing ────────────────────────────────────────────────── */
+
+void
+box_blur_rgb (Job &job, int radius)
+{
+  const int w = job.w, h = job.h;
+  std::vector<guint8> tmp (job.rgba.size ());
+
+  for (int pass = 0; pass < 3; pass++)
+    {
+      /* horizontal: rgba → tmp */
+      for (int y = 0; y < h; y++)
+        {
+          const guint8 *src = &job.rgba[(gsize) y * w * 4];
+          guint8       *dst = &tmp[(gsize) y * w * 4];
+
+          for (int c = 0; c < 4; c++)
+            {
+              int sum = 0;
+              for (int x = -radius; x <= radius; x++)
+                sum += src[CLAMP (x, 0, w - 1) * 4 + c];
+              for (int x = 0; x < w; x++)
+                {
+                  dst[x * 4 + c] = (guint8) (sum / (2 * radius + 1));
+                  sum += src[MIN (x + radius + 1, w - 1) * 4 + c] -
+                         src[MAX (x - radius, 0) * 4 + c];
+                }
+            }
+        }
+      /* vertical: tmp → rgba */
+      for (int x = 0; x < w; x++)
+        for (int c = 0; c < 4; c++)
+          {
+            int sum = 0;
+            for (int y = -radius; y <= radius; y++)
+              sum += tmp[((gsize) CLAMP (y, 0, h - 1) * w + x) * 4 + c];
+            for (int y = 0; y < h; y++)
+              {
+                job.rgba[((gsize) y * w + x) * 4 + c] = (guint8) (sum / (2 * radius + 1));
+                sum += tmp[((gsize) MIN (y + radius + 1, h - 1) * w + x) * 4 + c] -
+                       tmp[((gsize) MAX (y - radius, 0) * w + x) * 4 + c];
+              }
+          }
+    }
+}
+
+/*  transparent pixels: NO_LABEL when ignored, else composited on white  */
+void
+prepare_alpha (Job &job)
+{
+  const gsize n = (gsize) job.w * job.h;
+
+  job.labels.assign (n, 0);
+  for (gsize i = 0; i < n; i++)
+    {
+      guint8 *p = &job.rgba[i * 4];
+
+      if (p[3] < 128 && job.o->ignore_transparent)
+        {
+          job.labels[i] = NO_LABEL;
+        }
+      else if (p[3] < 255)
+        {
+          for (int c = 0; c < 3; c++)
+            p[c] = (guint8) ((p[c] * p[3] + 255 * (255 - p[3]) + 127) / 255);
+          p[3] = 255;
+        }
+    }
+}
+
+
+/*  ─── quantization ──────────────────────────────────────────────────── */
+
+void
+kmeans (std::vector<Lab> &samples, std::vector<Lab> &centers, int k)
+{
+  GRand *rand = g_rand_new_with_seed (0xC40F);
+  const gsize n = samples.size ();
+
+  centers.clear ();
+  if (n == 0)
+    {
+      g_rand_free (rand);
+      return;
+    }
+
+  /* k-means++ (deterministic seed) */
+  std::vector<float> dist (n, G_MAXFLOAT);
+  centers.push_back (samples[g_rand_int_range (rand, 0, (gint) n)]);
+
+  while ((int) centers.size () < k)
+    {
+      double total = 0;
+      const Lab &c = centers.back ();
+
+      for (gsize i = 0; i < n; i++)
+        {
+          dist[i] = MIN (dist[i], lab_dist2 (samples[i], c));
+          total += dist[i];
+        }
+      if (total <= 1e-6)
+        break;
+
+      double r = g_rand_double (rand) * total;
+      gsize  i = 0;
+      for (; i < n - 1; i++)
+        {
+          r -= dist[i];
+          if (r <= 0)
+            break;
+        }
+      centers.push_back (samples[i]);
+    }
+  g_rand_free (rand);
+
+  /* Lloyd iterations */
+  std::vector<double> acc (centers.size () * 4);
+  for (int iter = 0; iter < 24; iter++)
+    {
+      std::fill (acc.begin (), acc.end (), 0.0);
+      for (gsize i = 0; i < n; i++)
+        {
+          int   best = 0;
+          float bd   = G_MAXFLOAT;
+          for (gsize j = 0; j < centers.size (); j++)
+            {
+              float d = lab_dist2 (samples[i], centers[j]);
+              if (d < bd)
+                bd = d, best = (int) j;
+            }
+          acc[best * 4 + 0] += samples[i].L;
+          acc[best * 4 + 1] += samples[i].a;
+          acc[best * 4 + 2] += samples[i].b;
+          acc[best * 4 + 3] += 1;
+        }
+
+      double shift = 0;
+      std::vector<Lab> next;
+      for (gsize j = 0; j < centers.size (); j++)
+        {
+          if (acc[j * 4 + 3] < 1)
+            continue;       /* empty cluster: dropped */
+          Lab c = { (float) (acc[j * 4] / acc[j * 4 + 3]),
+                    (float) (acc[j * 4 + 1] / acc[j * 4 + 3]),
+                    (float) (acc[j * 4 + 2] / acc[j * 4 + 3]) };
+          shift = MAX (shift, lab_dist2 (c, centers[j]));
+          next.push_back (c);
+        }
+      bool changed = next.size () != centers.size ();
+      centers.swap (next);
+      if (! changed && shift < 0.01)
+        break;
+    }
+}
+
+/*  AUTO: merges the closest centers while closer than @threshold (ΔE76)  */
+void
+merge_close (std::vector<Lab> &centers, std::vector<double> &weights, double threshold)
+{
+  const float t2 = (float) (threshold * threshold);
+
+  while (centers.size () > 2)
+    {
+      float bd = G_MAXFLOAT;
+      gsize bi = 0, bj = 0;
+
+      for (gsize i = 0; i < centers.size (); i++)
+        for (gsize j = i + 1; j < centers.size (); j++)
+          {
+            float d = lab_dist2 (centers[i], centers[j]);
+            if (d < bd)
+              bd = d, bi = i, bj = j;
+          }
+      if (bd >= t2)
+        break;
+
+      double wi = MAX (weights[bi], 1.0), wj = MAX (weights[bj], 1.0), ws = wi + wj;
+      centers[bi] = { (float) ((centers[bi].L * wi + centers[bj].L * wj) / ws),
+                      (float) ((centers[bi].a * wi + centers[bj].a * wj) / ws),
+                      (float) ((centers[bi].b * wi + centers[bj].b * wj) / ws) };
+      weights[bi] = ws;
+      centers.erase (centers.begin () + bj);
+      weights.erase (weights.begin () + bj);
+    }
+}
+
+/*  labels of every pixel from @centers (6 bits per channel lookup table)  */
+void
+assign_labels (Job &job, const std::vector<Lab> &centers, bool gray)
+{
+  const gsize n = (gsize) job.w * job.h;
+  std::vector<guint16> lut (1 << 18, NO_LABEL);
+
+  for (gsize i = 0; i < n; i++)
+    {
+      if (job.labels[i] == NO_LABEL)
+        continue;
+
+      const guint8 *p   = &job.rgba[i * 4];
+      guint         key = ((p[0] >> 2) << 12) | ((p[1] >> 2) << 6) | (p[2] >> 2);
+
+      if (lut[key] == NO_LABEL)
+        {
+          guint8 q[3] = { (guint8) ((p[0] & 0xfc) | 2), (guint8) ((p[1] & 0xfc) | 2),
+                          (guint8) ((p[2] & 0xfc) | 2) };
+          Lab    l = rgb_to_lab (q);
+          float  bd = G_MAXFLOAT;
+          int    best = 0;
+
+          if (gray)
+            l.a = l.b = 0;
+          for (gsize j = 0; j < centers.size (); j++)
+            {
+              float d = lab_dist2 (l, centers[j]);
+              if (d < bd)
+                bd = d, best = (int) j;
+            }
+          lut[key] = (guint16) best;
+        }
+      job.labels[i] = lut[key];
+    }
+}
+
+void
+quantize (Job &job)
+{
+  const ChopGimpTraceOptions *o = job.o;
+  const gsize                 n = (gsize) job.w * job.h;
+  std::vector<Lab>            centers;
+
+  if (o->mode == CHOPGIMP_TRACE_MODE_BW)
+    {
+      /* label 0: traced side (black, or white when inverted), 1: the rest */
+      for (gsize i = 0; i < n; i++)
+        {
+          if (job.labels[i] == NO_LABEL)
+            continue;
+          const guint8 *p   = &job.rgba[i * 4];
+          double        lum = 0.2126 * p[0] + 0.7152 * p[1] + 0.0722 * p[2];
+          bool          dark = lum < o->threshold;
+
+          job.labels[i] = (dark != (bool) o->invert) ? 0 : 1;
+        }
+      job.colors.resize (2);
+      guint8 black[3] = { 0, 0, 0 }, white[3] = { 255, 255, 255 };
+      memcpy (job.colors[0].rgb, o->invert ? white : black, 3);
+      memcpy (job.colors[1].rgb, o->invert ? black : white, 3);
+      job.colors[0].lab = rgb_to_lab (job.colors[0].rgb);
+      job.colors[1].lab = rgb_to_lab (job.colors[1].rgb);
+      for (gsize i = 0; i < n; i++)
+        if (job.labels[i] != NO_LABEL)
+          job.colors[job.labels[i]].area++;
+      return;
+    }
+
+  const bool gray = o->mode == CHOPGIMP_TRACE_MODE_GRAY;
+
+  if (o->palette == CHOPGIMP_TRACE_PALETTE_CUSTOM && o->custom && o->n_custom > 0)
+    {
+      for (int i = 0; i < MIN (o->n_custom, 256); i++)
+        {
+          guint8 rgb[3];
+          color_get (o->custom[i], rgb);
+          Lab l = rgb_to_lab (rgb);
+          if (gray)
+            l.a = l.b = 0;
+          centers.push_back (l);
+        }
+    }
+  else
+    {
+      /* samples: up to ~250 000 pixels, regular stride */
+      std::vector<Lab> samples;
+      gsize            step = MAX ((gsize) 1, n / 250000);
+
+      for (gsize i = 0; i < n; i += step)
+        if (job.labels[i] != NO_LABEL)
+          {
+            Lab l = rgb_to_lab (&job.rgba[i * 4]);
+            if (gray)
+              l.a = l.b = 0;
+            samples.push_back (l);
+          }
+
+      int k = CLAMP (o->n_colors, 2, 256);
+      if (o->palette == CHOPGIMP_TRACE_PALETTE_AUTO)
+        {
+          double fid = CLAMP (o->color_fidelity, 0.0, 100.0) / 100.0;
+          k = CLAMP ((int) lround (2 + (k - 2) * (0.3 + 0.7 * fid)), 2, 256);
+        }
+      kmeans (samples, centers, k);
+
+      if (o->palette == CHOPGIMP_TRACE_PALETTE_AUTO && centers.size () > 2)
+        {
+          std::vector<double> weights (centers.size (), 0.0);
+          for (const Lab &s : samples)
+            {
+              float bd = G_MAXFLOAT; gsize best = 0;
+              for (gsize j = 0; j < centers.size (); j++)
+                {
+                  float d = lab_dist2 (s, centers[j]);
+                  if (d < bd)
+                    bd = d, best = j;
+                }
+              weights[best] += 1;
+            }
+          merge_close (centers, weights,
+                       2.0 + (100.0 - CLAMP (o->color_fidelity, 0.0, 100.0)) * 0.2);
+        }
+    }
+
+  if (centers.empty ())
+    centers.push_back ({ 0, 0, 0 });
+
+  assign_labels (job, centers, gray);
+
+  /* the color of each label: the mean of its pixels (CUSTOM: exact) */
+  job.colors.assign (centers.size (), Color ());
+  for (gsize i = 0; i < n; i++)
+    {
+      guint16 l = job.labels[i];
+      if (l == NO_LABEL)
+        continue;
+      Color &c = job.colors[l];
+      const guint8 *p = &job.rgba[i * 4];
+      c.sum[0] += p[0]; c.sum[1] += p[1]; c.sum[2] += p[2];
+      c.area++;
+    }
+  for (gsize j = 0; j < job.colors.size (); j++)
+    {
+      Color &c = job.colors[j];
+
+      if (o->palette == CHOPGIMP_TRACE_PALETTE_CUSTOM && o->custom && (int) j < o->n_custom)
+        {
+          color_get (o->custom[j], c.rgb);
+        }
+      else if (c.area > 0)
+        {
+          for (int k = 0; k < 3; k++)
+            c.rgb[k] = (guint8) CLAMP (lround (c.sum[k] / c.area), 0, 255);
+        }
+      if (gray && ! (o->palette == CHOPGIMP_TRACE_PALETTE_CUSTOM))
+        {
+          guint8 g = (guint8) CLAMP (lround (0.2126 * c.rgb[0] + 0.7152 * c.rgb[1] +
+                                             0.0722 * c.rgb[2]), 0, 255);
+          c.rgb[0] = c.rgb[1] = c.rgb[2] = g;
+        }
+      c.lab = rgb_to_lab (c.rgb);
+    }
+}
+
+
+/*  ─── speckles: regions below « noise » pixels join their neighbour ── */
+
+void
+merge_speckles (Job &job, int min_area)
+{
+  if (min_area <= 1)
+    return;
+
+  const int w = job.w, h = job.h;
+  const gsize n = (gsize) w * h;
+  std::vector<gint32> comp (n, -1);
+  std::vector<gint32> stack;
+  std::vector<gint32> members;
+  std::vector<gint64> votes (job.colors.size (), 0);
+  gint32 id = 0;
+
+  for (gsize start = 0; start < n; start++)
+    {
+      if (comp[start] >= 0 || job.labels[start] == NO_LABEL)
+        continue;
+
+      guint16 lab = job.labels[start];
+      members.clear ();
+      stack.clear ();
+      stack.push_back ((gint32) start);
+      comp[start] = id;
+      bool big = false;
+
+      while (! stack.empty ())
+        {
+          gint32 i = stack.back ();
+          stack.pop_back ();
+          if (! big)
+            {
+              members.push_back (i);
+              if ((int) members.size () >= min_area)
+                big = true;
+            }
+          int x = i % w, y = i / w;
+          const int nb[4][2] = { { x - 1, y }, { x + 1, y }, { x, y - 1 }, { x, y + 1 } };
+          for (auto &q : nb)
+            {
+              if (q[0] < 0 || q[1] < 0 || q[0] >= w || q[1] >= h)
+                continue;
+              gint32 j = q[1] * w + q[0];
+              if (comp[j] < 0 && job.labels[j] == lab)
+                {
+                  comp[j] = id;
+                  stack.push_back (j);
+                }
+            }
+        }
+
+      if (! big)
+        {
+          /* the most common other label around it */
+          std::fill (votes.begin (), votes.end (), 0);
+          for (gint32 i : members)
+            {
+              int x = i % w, y = i / w;
+              const int nb[4][2] = { { x - 1, y }, { x + 1, y }, { x, y - 1 }, { x, y + 1 } };
+              for (auto &q : nb)
+                {
+                  if (q[0] < 0 || q[1] < 0 || q[0] >= w || q[1] >= h)
+                    continue;
+                  guint16 l = job.labels[q[1] * w + q[0]];
+                  if (l != lab && l != NO_LABEL)
+                    votes[l]++;
+                }
+            }
+          gint64 best = 0; int bl = -1;
+          for (gsize l = 0; l < votes.size (); l++)
+            if (votes[l] > best)
+              best = votes[l], bl = (int) l;
+          if (bl >= 0)
+            {
+              for (gint32 i : members)
+                job.labels[i] = (guint16) bl;
+              job.colors[lab].area -= members.size ();
+              job.colors[bl].area  += members.size ();
+            }
+        }
+      id++;
+
+      if ((start & 0xffff) == 0 && job.is_cancelled ())
+        return;
+    }
+}
+
+
+/*  ─── distance transform (squared euclidean, Felzenszwalb) ──────────── */
+
+void
+edt_1d (const float *f, float *d, int *v, float *z, int n)
+{
+  int k = 0;
+  v[0] = 0; z[0] = -G_MAXFLOAT; z[1] = G_MAXFLOAT;
+  for (int q = 1; q < n; q++)
+    {
+      float s;
+      while (true)
+        {
+          s = ((f[q] + (float) q * q) - (f[v[k]] + (float) v[k] * v[k])) / (2.0f * q - 2.0f * v[k]);
+          if (s <= z[k] && k > 0)
+            k--;
+          else
+            break;
+        }
+      if (s <= z[k])     /* k == 0 */
+        {
+          v[0] = q; z[0] = -G_MAXFLOAT; z[1] = G_MAXFLOAT;
+          continue;
+        }
+      k++;
+      v[k] = q; z[k] = s; z[k + 1] = G_MAXFLOAT;
+    }
+  k = 0;
+  for (int q = 0; q < n; q++)
+    {
+      while (z[k + 1] < q)
+        k++;
+      d[q] = (float) (q - v[k]) * (q - v[k]) + f[v[k]];
+    }
+}
+
+/*  squared distance of every foreground pixel to the nearest background
+ *  pixel (outside the image counts as background)
+ */
+std::vector<float>
+distance_transform (const std::vector<guint8> &mask, int w, int h)
+{
+  const float INF = 1e12f;
+  int n = MAX (w, h) + 2;
+  std::vector<float> out ((gsize) w * h), f (n), d (n), z (n + 1);
+  std::vector<int>   v (n);
+
+  /* columns (padded with background) */
+  for (int x = 0; x < w; x++)
+    {
+      f[0] = 0;
+      for (int y = 0; y < h; y++)
+        f[y + 1] = mask[(gsize) y * w + x] ? INF : 0;
+      f[h + 1] = 0;
+      edt_1d (f.data (), d.data (), v.data (), z.data (), h + 2);
+      for (int y = 0; y < h; y++)
+        out[(gsize) y * w + x] = d[y + 1];
+    }
+  /* rows */
+  for (int y = 0; y < h; y++)
+    {
+      f[0] = 0;
+      for (int x = 0; x < w; x++)
+        f[x + 1] = out[(gsize) y * w + x];
+      f[w + 1] = 0;
+      edt_1d (f.data (), d.data (), v.data (), z.data (), w + 2);
+      for (int x = 0; x < w; x++)
+        out[(gsize) y * w + x] = d[x + 1];
+    }
+  return out;
+}
+
+
+/*  ─── centerline (autotrace) ────────────────────────────────────────── */
+
+std::mutex autotrace_lock;
+
+/*  strokes of @mask (w × h, 1 = ink) → @shapes  */
+void
+trace_centerline (Job &job, const std::vector<guint8> &mask, const guint8 rgb[3],
+                  std::vector<Shape> &shapes)
+{
+  const ChopGimpTraceOptions *o = job.o;
+  const int w = job.w, h = job.h;
+
+  if (w > 65535 || h > 65535)
+    return;
+
+  std::vector<float>  dist = distance_transform (mask, w, h);
+  std::vector<guint8> rgb_bitmap ((gsize) w * h * 3);
+  for (gsize i = 0; i < (gsize) w * h; i++)
+    memset (&rgb_bitmap[i * 3], mask[i] ? 0 : 255, 3);
+
+  std::lock_guard<std::mutex> guard (autotrace_lock);
+
+  static std::once_flag init;
+  std::call_once (init, [] { autotrace_init (); });
+
+  at_fitting_opts_type *opts = at_fitting_opts_new ();
+  opts->background_color  = at_color_new (255, 255, 255);
+  opts->centerline        = TRUE;
+  opts->preserve_width    = FALSE;
+  opts->color_count       = 0;
+  opts->despeckle_level   = 0;
+  opts->error_threshold   = (gfloat) (0.5 + (100.0 - o->paths) / 100.0 * 3.0);
+  opts->filter_iterations = (unsigned) (1 + (100.0 - o->paths) / 25.0);
+  opts->corner_threshold  = (gfloat) (60.0 + o->corners * 0.8);
+  opts->line_threshold    = o->snap_lines ? 2.0f : 1.0f;
+
+  at_bitmap bitmap;
+  bitmap.width  = (unsigned short) w;
+  bitmap.height = (unsigned short) h;
+  bitmap.bitmap = rgb_bitmap.data ();
+  bitmap.np     = 3;
+
+  at_splines_type *splines =
+    at_splines_new_full (&bitmap, opts, NULL, NULL, NULL, NULL,
+                         [] (gpointer data) -> gboolean
+                         { return ((Job *) data)->is_cancelled (); }, &job);
+
+  if (splines)
+    {
+      for (unsigned i = 0; i < splines->length; i++)
+        {
+          at_spline_list_type &list = splines->data[i];
+          if (list.length == 0)
+            continue;
+
+          PathBuilder        pb (job.ox, job.oy);
+          std::vector<float> widths;
+          auto px = [&] (const at_real_coord &c) { return (double) c.x + 0.5; };
+          auto py = [&] (const at_real_coord &c) { return (double) (h - c.y) - 0.5; };
+          auto sample = [&] (double x, double y)
+            {
+              int ix = CLAMP ((int) floor (x), 0, w - 1), iy = CLAMP ((int) floor (y), 0, h - 1);
+              float best = dist[(gsize) iy * w + ix];
+              /* the skeleton may sit between two pixels: largest around */
+              for (int dy = -1; dy <= 1; dy++)
+                for (int dx = -1; dx <= 1; dx++)
+                  {
+                    int qx = ix + dx, qy = iy + dy;
+                    if (qx >= 0 && qy >= 0 && qx < w && qy < h)
+                      best = MAX (best, dist[(gsize) qy * w + qx]);
+                  }
+              if (best > 0)
+                widths.push_back (2.0f * sqrtf (best) - 0.5f);  /* ± 0.5 px */
+            };
+
+          const at_spline_type &first = list.data[0];
+          pb.move (px (first.v[0]), py (first.v[0]));
+          sample (px (first.v[0]), py (first.v[0]));
+          for (unsigned j = 0; j < list.length; j++)
+            {
+              const at_spline_type &s = list.data[j];
+              if (s.degree == AT_LINEARTYPE)
+                pb.line (px (s.v[3]), py (s.v[3]));
+              else
+                pb.curve_or_line (px (s.v[1]), py (s.v[1]), px (s.v[2]), py (s.v[2]),
+                                  px (s.v[3]), py (s.v[3]), o->snap_lines, 0.5);
+              sample (px (s.v[3]), py (s.v[3]));
+            }
+          if (! list.open)
+            pb.close ();
+
+          if (pb.length < MAX (1.0, o->min_stroke_length))
+            continue;
+
+          double width = 1.0;
+          if (! widths.empty ())
+            {
+              std::nth_element (widths.begin (), widths.begin () + widths.size () / 2,
+                                widths.end ());
+              width = MAX (1.0, widths[widths.size () / 2]);
+            }
+          if (o->max_stroke_width > 0)
+            width = MIN (width, MAX (1.0, o->max_stroke_width));
+
+          Shape sh;
+          memcpy (sh.rgb, rgb, 3);
+          sh.stroke  = TRUE;
+          sh.width   = width;
+          sh.anchors = pb.anchors;
+          sh.d       = std::move (pb.d);
+          sh.g       = std::move (pb.g);
+          shapes.push_back (std::move (sh));
+        }
+      at_splines_free (splines);
+    }
+  at_fitting_opts_free (opts);
+}
+
+
+/*  ─── potrace ───────────────────────────────────────────────────────── */
+
+#ifdef CHOPGIMP_HAVE_POTRACE
+
+void
+potrace_shapes (Job &job, const std::vector<guint8> &mask, const guint8 rgb[3],
+                std::vector<Shape> &shapes)
+{
+  const ChopGimpTraceOptions *o = job.o;
+  const int w = job.w, h = job.h;
+  const int bpw = 8 * sizeof (potrace_word);
+  const int dy  = (w + bpw - 1) / bpw;
+
+  std::vector<potrace_word> map ((gsize) dy * h, 0);
+  bool any = false;
+
+  for (int y = 0; y < h; y++)
+    {
+      const guint8 *m = &mask[(gsize) y * w];
+      potrace_word *line = &map[(gsize) y * dy];
+      for (int x = 0; x < w; x++)
+        if (m[x])
+          {
+            line[x / bpw] |= ((potrace_word) 1) << (bpw - 1 - (x % bpw));
+            any = true;
+          }
+    }
+  if (! any)
+    return;
+
+  potrace_bitmap_t bm = { w, h, dy, map.data () };
+  potrace_param_t *param = potrace_param_default ();
+
+  param->turdsize     = MAX (0, o->noise);
+  param->alphamax     = 1.3334 * (1.0 - CLAMP (o->corners, 0.0, 100.0) / 100.0);
+  param->opticurve    = 1;
+  param->opttolerance = 1.0 - 0.95 * CLAMP (o->paths, 0.0, 100.0) / 100.0;
+
+  potrace_state_t *st = potrace_trace (param, &bm);
+  potrace_param_free (param);
+
+  if (! st || st->status != POTRACE_STATUS_OK)
+    {
+      if (st)
+        potrace_state_free (st);
+      return;
+    }
+
+  /* a shape = an outer path (+) and its holes (its children) */
+  std::vector<potrace_path_t *> outers;
+  for (potrace_path_t *p = st->plist; p; p = p->next)
+    if (p->sign == '+')
+      outers.push_back (p);
+
+  auto add_curve = [&] (PathBuilder &pb, potrace_curve_t *c)
+    {
+      int n = c->n;
+      if (n <= 0)
+        return;
+      pb.move (c->c[n - 1][2].x, c->c[n - 1][2].y);
+      for (int i = 0; i < n; i++)
+        {
+          if (c->tag[i] == POTRACE_CORNER)
+            {
+              pb.line (c->c[i][1].x, c->c[i][1].y);
+              pb.line (c->c[i][2].x, c->c[i][2].y);
+            }
+          else
+            {
+              pb.curve_or_line (c->c[i][0].x, c->c[i][0].y, c->c[i][1].x, c->c[i][1].y,
+                                c->c[i][2].x, c->c[i][2].y, o->snap_lines, 0.35);
+            }
+        }
+      pb.close ();
+    };
+
+  for (potrace_path_t *p : outers)
+    {
+      PathBuilder pb (job.ox, job.oy);
+
+      add_curve (pb, &p->curve);
+      for (potrace_path_t *c = p->childlist; c; c = c->sibling)
+        add_curve (pb, &c->curve);
+
+      Shape sh;
+      memcpy (sh.rgb, rgb, 3);
+      sh.stroke  = FALSE;
+      sh.width   = 0;
+      sh.anchors = pb.anchors;
+      sh.d       = std::move (pb.d);
+      sh.g       = std::move (pb.g);
+      shapes.push_back (std::move (sh));
+    }
+
+  potrace_state_free (st);
+}
+
+#endif
