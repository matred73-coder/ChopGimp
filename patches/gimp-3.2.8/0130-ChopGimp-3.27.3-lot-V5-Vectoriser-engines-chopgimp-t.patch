+extern "C" gchar *
+chopgimp_trace_options_to_string (const ChopGimpTraceOptions *o)
+{
+  g_return_val_if_fail (o != NULL, NULL);
+
+  GString *s = g_string_new (NULL);
+  char     buf[G_ASCII_DTOSTR_BUF_SIZE];
+
+  auto num = [&] (const gchar *key, double v)
+    {
+      g_string_append_printf (s, "%s=%s;", key, g_ascii_dtostr (buf, sizeof (buf), v));
+    };
+
+  g_string_append_printf (s, "engine=%s;mode=%s;palette=%s;method=%s;",
+                          enum_name (engine_names, o->engine),
+                          enum_name (mode_names, o->mode),
+                          enum_name (palette_names, o->palette),
+                          enum_name (method_names, o->method));
+  g_string_append_printf (s, "colors=%d;noise=%d;", o->n_colors, o->noise);
+  num ("fidelity", o->color_fidelity);
+  num ("threshold", o->threshold);
+  num ("paths", o->paths);
+  num ("corners", o->corners);
+  num ("blur", o->blur);
+  num ("max-stroke", o->max_stroke_width);
+  num ("min-stroke", o->min_stroke_length);
+  g_string_append_printf (s, "invert=%d;fills=%d;strokes=%d;snap-lines=%d;"
+                          "ignore-white=%d;ignore-transparent=%d",
+                          !! o->invert, !! o->fills, !! o->strokes, !! o->snap_lines,
+                          !! o->ignore_white, !! o->ignore_transparent);
+  if (o->custom && o->n_custom > 0)
+    {
+      g_string_append (s, ";custom=");
+      for (int i = 0; i < o->n_custom; i++)
+        {
+          guint8 rgb[3];
+          color_get (o->custom[i], rgb);
+          g_string_append_printf (s, "%s#%02x%02x%02x", i ? "," : "", rgb[0], rgb[1], rgb[2]);
+        }
+    }
+  return g_string_free (s, FALSE);
+}
+
+extern "C" void
+chopgimp_trace_options_from_string (ChopGimpTraceOptions *o,
+                                    const gchar          *string)
+{
+  g_return_if_fail (o != NULL);
+
+  if (! string)
+    return;
+
+  gchar **items = g_strsplit (string, ";", -1);
+
+  for (gchar **it = items; *it; it++)
+    {
+      gchar *eq = strchr (*it, '=');
+      if (! eq)
+        continue;
+      *eq = '\0';
+      const gchar *k = g_strstrip (*it);
+      const gchar *v = g_strstrip (eq + 1);
+      double       d = g_ascii_strtod (v, NULL);
+
+      if      (! strcmp (k, "engine"))   o->engine  = (ChopGimpTraceEngine) enum_value (engine_names, v, o->engine);
+      else if (! strcmp (k, "mode"))     o->mode    = (ChopGimpTraceMode) enum_value (mode_names, v, o->mode);
+      else if (! strcmp (k, "palette"))  o->palette = (ChopGimpTracePalette) enum_value (palette_names, v, o->palette);
+      else if (! strcmp (k, "method"))   o->method  = (ChopGimpTraceMethod) enum_value (method_names, v, o->method);
+      else if (! strcmp (k, "colors"))   o->n_colors = CLAMP ((int) d, 2, 256);
+      else if (! strcmp (k, "noise"))    o->noise = MAX (0, (int) d);
+      else if (! strcmp (k, "fidelity")) o->color_fidelity = CLAMP (d, 0.0, 100.0);
+      else if (! strcmp (k, "threshold")) o->threshold = CLAMP (d, 0.0, 255.0);
+      else if (! strcmp (k, "paths"))    o->paths = CLAMP (d, 0.0, 100.0);
+      else if (! strcmp (k, "corners"))  o->corners = CLAMP (d, 0.0, 100.0);
+      else if (! strcmp (k, "blur"))     o->blur = CLAMP (d, 0.0, 10.0);
+      else if (! strcmp (k, "max-stroke")) o->max_stroke_width = MAX (0.0, d);
+      else if (! strcmp (k, "min-stroke")) o->min_stroke_length = MAX (0.0, d);
+      else if (! strcmp (k, "invert"))   o->invert = d != 0;
+      else if (! strcmp (k, "fills"))    o->fills = d != 0;
+      else if (! strcmp (k, "strokes"))  o->strokes = d != 0;
+      else if (! strcmp (k, "snap-lines")) o->snap_lines = d != 0;
+      else if (! strcmp (k, "ignore-white")) o->ignore_white = d != 0;
+      else if (! strcmp (k, "ignore-transparent")) o->ignore_transparent = d != 0;
+      else if (! strcmp (k, "custom"))
+        {
+          gchar    **cols = g_strsplit (v, ",", -1);
+          GPtrArray *arr  = g_ptr_array_new ();
+
+          for (gchar **c = cols; *c; c++)
+            {
+              const gchar *h = g_strstrip (*c);
+              guint        r, g, b;
+              if (sscanf (h, "#%02x%02x%02x", &r, &g, &b) == 3)
+                {
+                  guint8 rgb[3] = { (guint8) r, (guint8) g, (guint8) b };
+                  g_ptr_array_add (arr, color_new (rgb));
+                }
+            }
+          g_strfreev (cols);
+
+          {
+            /* replaces our own previous array only */
+            std::lock_guard<std::mutex> guard (owned_lock);
+            auto it2 = std::find (owned_custom.begin (), owned_custom.end (), (void *) o->custom);
+            if (o->custom && it2 != owned_custom.end ())
+              {
+                for (int i = 0; i < o->n_custom; i++)
+                  g_object_unref (o->custom[i]);
+                g_free (o->custom);
+                owned_custom.erase (it2);
+              }
+          }
+          o->n_custom = (gint) arr->len;
+          o->custom   = (GeglColor **) g_ptr_array_free (arr, FALSE);
+          if (o->n_custom == 0)
+            {
+              g_free (o->custom);
+              o->custom = NULL;
+            }
+          else
+            {
+              std::lock_guard<std::mutex> guard (owned_lock);
+              owned_custom.push_back ((void *) o->custom);
+            }
+        }
+    }
+  g_strfreev (items);
+}
+
+extern "C" void
+chopgimp_trace_options_clear (ChopGimpTraceOptions *o)
+{
+  g_return_if_fail (o != NULL);
+
+  if (o->custom)
+    {
+      std::lock_guard<std::mutex> guard (owned_lock);
+      auto it = std::find (owned_custom.begin (), owned_custom.end (), (void *) o->custom);
+      if (it != owned_custom.end ())
+        {
+          for (int i = 0; i < o->n_custom; i++)
+            g_object_unref (o->custom[i]);
+          g_free (o->custom);
+          owned_custom.erase (it);
+        }
+    }
+  o->custom   = NULL;
+  o->n_custom = 0;
+}
+
+
+/*  ─── public: tracing ───────────────────────────────────────────────── */
+
+extern "C" gboolean
+chopgimp_trace_engine_available (ChopGimpTraceEngine engine)
+{
+  switch (engine)
+    {
+    case CHOPGIMP_TRACE_ENGINE_POTRACE:
+#ifdef CHOPGIMP_HAVE_POTRACE
+      return TRUE;
+#else
+      return FALSE;
+#endif
+    case CHOPGIMP_TRACE_ENGINE_CENTERLINE:
+    case CHOPGIMP_TRACE_ENGINE_PIXELART:
+      return TRUE;
+    }
+  return FALSE;
+}
+
+extern "C" ChopGimpTraceResult *
+chopgimp_trace_run (GeglBuffer                 *buffer,
+                    const GeglRectangle        *rect,
+                    GeglBuffer                 *mask,
+                    const ChopGimpTraceOptions *options,
+                    GCancellable               *cancellable,
+                    ChopGimpTraceProgress       progress,
+                    gpointer                    progress_data,
+                    GError                    **error)
+{
+  g_return_val_if_fail (GEGL_IS_BUFFER (buffer), NULL);
+  g_return_val_if_fail (options != NULL, NULL);
+  g_return_val_if_fail (error == NULL || *error == NULL, NULL);
+
+  std::call_once (lut_once, init_lut);
+
+  if (! chopgimp_trace_engine_available (options->engine))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+                   _("Ce moteur de vectorisation n'est pas disponible dans cette version."));
+      return NULL;
+    }
+
+  GeglRectangle r = rect ? *rect : *gegl_buffer_get_extent (buffer);
+  if (r.width <= 0 || r.height <= 0)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                   _("Rien à vectoriser : la zone est vide."));
+      return NULL;
+    }
+
+  Job job;
+  job.o  = options;
+  job.w  = r.width;
+  job.h  = r.height;
+  job.ox = r.x;
+  job.oy = r.y;
+  job.cancellable = cancellable;
+
+  const gsize n = (gsize) job.w * job.h;
+
+  auto report = [&] (double f)
+    {
+      if (progress)
+        progress (CLAMP (f, 0.0, 1.0), progress_data);
+    };
+  auto cancelled = [&] () -> bool
+    {
+      if (job.is_cancelled ())
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED, _("Vectorisation annulée."));
+          return true;
+        }
+      return false;
+    };
+
+  report (0.0);
+
+  /* pixels */
+  job.rgba.resize (n * 4);
+  gegl_buffer_get (buffer, &r, 1.0, babl_format ("R'G'B'A u8"), job.rgba.data (),
+                   GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+  if (mask)
+    {
+      std::vector<guint8> m (n);
+      gegl_buffer_get (mask, &r, 1.0, babl_format ("Y u8"), m.data (),
+                       GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+      for (gsize i = 0; i < n; i++)
+        job.rgba[i * 4 + 3] = (guint8) ((job.rgba[i * 4 + 3] * m[i] + 127) / 255);
+    }
+
+  /* outside the selection is never traced */
+  std::vector<guint8> outside;
+  if (mask)
+    {
+      outside.resize (n);
+      for (gsize i = 0; i < n; i++)
+        outside[i] = job.rgba[i * 4 + 3] < 128;
+    }
+
+  if (options->blur >= 0.5 && options->engine != CHOPGIMP_TRACE_ENGINE_PIXELART)
+    box_blur_rgb (job, MAX (1, (int) lround (options->blur * 0.75)));
+
+  prepare_alpha (job);
+  if (mask)
+    for (gsize i = 0; i < n; i++)
+      if (outside[i])
+        job.labels[i] = NO_LABEL;
+
+  if (cancelled ())
+    return NULL;
+  report (0.05);
+
+  std::vector<Shape> shapes;
+
+  if (options->engine == CHOPGIMP_TRACE_ENGINE_PIXELART)
+    {
+      if (! trace_pixelart (job, shapes, error))
+        return NULL;
+    }
+  else
+    {
+      /* centerline: a black and white image unless asked otherwise */
+      quantize (job);
+      if (cancelled ())
+        return NULL;
+      report (0.15);
+
+      merge_speckles (job, options->noise);
+      if (cancelled ())
+        return NULL;
+      report (0.2);
+
+      /* « ignore white »: the background side (BW), else the lightest
+       * color when it is near white
+       */
+      if (options->ignore_white && ! job.colors.empty ())
+        {
+          int drop = -1;
+          if (options->mode == CHOPGIMP_TRACE_MODE_BW)
+            drop = 1;
+          else
+            {
+              float best = -1;
+              for (gsize j = 0; j < job.colors.size (); j++)
+                if (job.colors[j].area > 0 && job.colors[j].lab.L > best)
+                  best = job.colors[j].lab.L, drop = (int) j;
+              if (best < 95.0f)
+                drop = -1;
+            }
+          if (drop >= 0)
+            {
+              for (gsize i = 0; i < n; i++)
+                if (job.labels[i] == drop)
+                  job.labels[i] = NO_LABEL;
+              job.colors[drop].area = 0;
+            }
+        }
+
+      /* stack: largest area at the bottom */
+      std::vector<Pass> passes;
+      for (gsize j = 0; j < job.colors.size (); j++)
+        if (job.colors[j].area > 0)
+          passes.push_back ({ 0, (guint16) j });
+      std::stable_sort (passes.begin (), passes.end (), [&] (const Pass &a, const Pass &b)
+                        { return job.colors[a.label].area > job.colors[b.label].area; });
+      std::vector<int> order_of (job.colors.size (), G_MAXINT);
+      for (gsize p = 0; p < passes.size (); p++)
+        {
+          passes[p].order = (int) p;
+          order_of[passes[p].label] = (int) p;
+        }
+
+      /* passes in parallel; progress and cancellation from here */
+      job.pass_shapes.assign (passes.size (), {});
+      std::atomic<int>        next { 0 };
+      std::atomic<int>        finished { 0 };
+      std::mutex              m;
+      std::condition_variable cv;
+      int nthreads = (int) MIN ((guint) passes.size (), MAX (1u, g_get_num_processors ()));
+      if (options->engine == CHOPGIMP_TRACE_ENGINE_CENTERLINE)
+        nthreads = MIN (nthreads, 2);   /* autotrace is serialized */
+
+      std::vector<std::thread> workers;
+      for (int t = 0; t < nthreads; t++)
+        workers.emplace_back ([&]
+          {
+            while (true)
+              {
+                int p = next++;
+                if (p >= (int) passes.size () || job.is_cancelled ())
+                  break;
+                run_pass (job, passes, order_of, p, job.pass_shapes[p]);
+                finished++;
+                std::lock_guard<std::mutex> g (m);
+                cv.notify_all ();
+              }
+          });
+
+      {
+        std::unique_lock<std::mutex> lk (m);
+        while (finished.load () < (int) passes.size ())
+          {
+            cv.wait_for (lk, std::chrono::milliseconds (60));
+            if (job.is_cancelled ())
+              break;
+            if (! passes.empty ())
+              report (0.2 + 0.75 * finished.load () / (double) passes.size ());
+          }
+      }
+      for (std::thread &t : workers)
+        t.join ();
+
+      if (cancelled ())
+        return NULL;
+
+      for (auto &v : job.pass_shapes)
+        for (Shape &s : v)
+          shapes.push_back (std::move (s));
+    }
+
+  report (0.97);
+
+  /* the result */
+  ResultPriv *rp = new ResultPriv ();
+  ChopGimpTraceResult *res = &rp->pub;
+
+  res->shapes   = g_ptr_array_new ();
+  res->width    = r.width;
+  res->height   = r.height;
+  res->offset_x = r.x;
+  res->offset_y = r.y;
+
+  std::vector<guint32> used;
+  for (Shape &s : shapes)
+    {
+      ChopGimpTraceShape *ts = g_new0 (ChopGimpTraceShape, 1);
+      ts->color     = color_new (s.rgb);
+      ts->d         = g_strdup (s.d.c_str ());
+      ts->stroke    = s.stroke;
+      ts->width     = s.width;
+      ts->n_anchors = s.anchors;
+      g_ptr_array_add (res->shapes, ts);
+
+      rp->geom.push_back (std::move (s.g));
+      rp->rgb.push_back ({ s.rgb[0], s.rgb[1], s.rgb[2] });
+
+      guint32 key = (s.rgb[0] << 16) | (s.rgb[1] << 8) | s.rgb[2];
+      if (std::find (used.begin (), used.end (), key) == used.end ())
+        used.push_back (key);
+      res->n_paths++;
+      res->n_anchors += s.anchors;
+    }
+  res->n_colors = (gint) used.size ();
+
+  report (1.0);
+  return res;
+}
+
+extern "C" void
+chopgimp_trace_result_free (ChopGimpTraceResult *result)
+{
+  if (! result)
+    return;
+
+  for (guint i = 0; i < result->shapes->len; i++)
+    {
+      ChopGimpTraceShape *s = (ChopGimpTraceShape *) g_ptr_array_index (result->shapes, i);
+      g_clear_object (&s->color);
+      g_free (s->d);
+      g_free (s);
+    }
+  g_ptr_array_free (result->shapes, TRUE);
+
+  delete (ResultPriv *) result;
+}
+
+extern "C" gchar *
+chopgimp_trace_result_to_xml (const ChopGimpTraceResult *result,
+                              gboolean                   flat)
+{
+  g_return_val_if_fail (result != NULL, NULL);
+
+  GString *s  = g_string_new (NULL);
+  gint     id = 0;
+  gboolean in_group = FALSE;
+  guint8   group_rgb[3] = { 0, 0, 0 };
+  char     c[3][G_ASCII_DTOSTR_BUF_SIZE];
+
+  auto color_attr = [&] (GeglColor *color)
+    {
+      gdouble v[4] = { 0, 0, 0, 1 };
+      gegl_color_get_pixel (color, babl_format ("R'G'B'A double"), v);
+      g_string_append_printf (s, "%s %s %s 1",
+                              g_ascii_formatd (c[0], sizeof (c[0]), "%.6g", v[0]),
+                              g_ascii_formatd (c[1], sizeof (c[1]), "%.6g", v[1]),
+                              g_ascii_formatd (c[2], sizeof (c[2]), "%.6g", v[2]));
+    };
+
+  for (guint i = 0; i < result->shapes->len; i++)
+    {
+      ChopGimpTraceShape *sh = (ChopGimpTraceShape *) g_ptr_array_index (result->shapes, i);
+      guint8 rgb[3];
+
+      color_get (sh->color, rgb);
+
+      if (! flat && (! in_group || memcmp (rgb, group_rgb, 3)))
+        {
+          if (in_group)
+            g_string_append (s, "</group>\n");
+          g_string_append_printf (s, "<group id=\"%d\" name=\"#%02x%02x%02x\" opacity=\"1\" "
+                                  "mode=\"normal\" visible=\"1\" locked=\"0\">\n",
+                                  ++id, rgb[0], rgb[1], rgb[2]);
+          memcpy (group_rgb, rgb, 3);
+          in_group = TRUE;
+        }
+
+      gchar *name = g_markup_escape_text (sh->stroke ? _("Trait") : _("Zone"), -1);
+      g_string_append_printf (s, "<path id=\"%d\" name=\"%s\" opacity=\"1\" mode=\"normal\" "
+                              "visible=\"1\" locked=\"0\" fill-rule=\"evenodd\" "
+                              "antialias=\"1\" d=\"%s\">\n", ++id, name, sh->d);
+      g_free (name);
+
+      if (sh->stroke)
+        {
+          g_string_append (s, "<fill type=\"none\"/>\n<stroke type=\"color\" color=\"");
+          color_attr (sh->color);
+          g_string_append_printf (s, "\" width=\"%s\" align=\"center\" cap=\"round\" "
+                                  "join=\"round\" miter=\"4\"/>\n",
+                                  g_ascii_formatd (c[0], sizeof (c[0]), "%.3g", sh->width));
+        }
+      else
+        {
+          g_string_append (s, "<fill type=\"color\" color=\"");
+          color_attr (sh->color);
+          g_string_append (s, "\"/>\n<stroke type=\"none\" width=\"1\" align=\"center\" "
+                              "cap=\"butt\" join=\"miter\" miter=\"4\"/>\n");
+        }
+      g_string_append (s, "</path>\n");
+    }
+  if (in_group)
+    g_string_append (s, "</group>\n");
+
+  gchar *head = g_strdup_printf ("<chopgimp-vobjects version=\"2\" next-id=\"%d\">\n"
+                                 "<group id=\"0\" name=\"\">\n", id + 1);
+  g_string_prepend (s, head);
+  g_free (head);
+  g_string_append (s, "</group>\n</chopgimp-vobjects>\n");
+
+  return g_string_free (s, FALSE);
+}
+
+extern "C" void
+chopgimp_trace_result_draw (const ChopGimpTraceResult *result,
+                            gpointer                   cr_ptr,
+                            gint                       view)
+{
+  g_return_if_fail (result != NULL && cr_ptr != NULL);
+
+  cairo_t          *cr = (cairo_t *) cr_ptr;
+  const ResultPriv *rp = (const ResultPriv *) result;
+
+  auto make_path = [&] (const Geometry &g)
+    {
+      gsize k = 0;
+      cairo_new_path (cr);
+      for (guint8 op : g.ops)
+        switch (op)
+          {
+          case OP_MOVE:  cairo_move_to (cr, g.pts[k], g.pts[k + 1]); k += 2; break;
+          case OP_LINE:  cairo_line_to (cr, g.pts[k], g.pts[k + 1]); k += 2; break;
+          case OP_CURVE: cairo_curve_to (cr, g.pts[k], g.pts[k + 1], g.pts[k + 2],
+                                         g.pts[k + 3], g.pts[k + 4], g.pts[k + 5]);
+                         k += 6; break;
+          case OP_CLOSE: cairo_close_path (cr); break;
+          }
+    };
+
+  cairo_save (cr);
+  cairo_set_fill_rule (cr, CAIRO_FILL_RULE_EVEN_ODD);
+
+  if (view == 0 || view == 2)
+    {
+      for (guint i = 0; i < result->shapes->len; i++)
+        {
+          const ChopGimpTraceShape *sh = (const ChopGimpTraceShape *)
+                                         g_ptr_array_index (result->shapes, i);
+          const auto &rgb = rp->rgb[i];
+
+          make_path (rp->geom[i]);
+          cairo_set_source_rgb (cr, rgb[0] / 255.0, rgb[1] / 255.0, rgb[2] / 255.0);
+          if (sh->stroke)
+            {
+              cairo_set_line_width (cr, sh->width);
+              cairo_set_line_cap (cr, CAIRO_LINE_CAP_ROUND);
+              cairo_set_line_join (cr, CAIRO_LINE_JOIN_ROUND);
+              cairo_stroke (cr);
+            }
+          else
+            cairo_fill (cr);
+        }
+    }
+
+  if (view == 1 || view == 2)
+    {
+      double lw = 1.0, dummy = 0.0;
+      cairo_device_to_user_distance (cr, &lw, &dummy);
+      lw = hypot (lw, dummy);
+
+      cairo_set_line_width (cr, lw);
+      cairo_set_line_cap (cr, CAIRO_LINE_CAP_BUTT);
+      cairo_set_line_join (cr, CAIRO_LINE_JOIN_MITER);
+      for (guint i = 0; i < result->shapes->len; i++)
+        {
+          make_path (rp->geom[i]);
+          if (view == 2)
+            cairo_set_source_rgba (cr, 0.1, 0.45, 0.95, 0.9);
+          else
+            cairo_set_source_rgba (cr, 0.1, 0.1, 0.1, 0.9);
+          cairo_stroke (cr);
+        }
+    }
+
+  cairo_restore (cr);
+}
