+
+/*  ─── one pass: one color ───────────────────────────────────────────── */
+
+struct Pass
+{
+  int     order;            /* position in the stack, 0 = bottom */
+  guint16 label;
+};
+
+void
+run_pass (Job &job, const std::vector<Pass> &passes, const std::vector<int> &order_of,
+          int p, std::vector<Shape> &out)
+{
+  const ChopGimpTraceOptions *o = job.o;
+  const gsize n = (gsize) job.w * job.h;
+  const Pass &pass = passes[p];
+  const guint8 *rgb = job.colors[pass.label].rgb;
+  std::vector<guint8> mask (n, 0);
+  bool overlapping = o->method == CHOPGIMP_TRACE_METHOD_OVERLAPPING &&
+                     o->engine == CHOPGIMP_TRACE_ENGINE_POTRACE && o->fills;
+
+  for (gsize i = 0; i < n; i++)
+    {
+      guint16 l = job.labels[i];
+      if (l == NO_LABEL)
+        continue;
+      if (overlapping ? order_of[l] >= pass.order : l == pass.label)
+        mask[i] = 1;
+    }
+
+  if (o->engine == CHOPGIMP_TRACE_ENGINE_CENTERLINE || ! o->fills)
+    {
+      trace_centerline (job, mask, rgb, out);
+      return;
+    }
+
+  std::vector<guint8> thin;
+  bool has_thin = o->strokes && split_thin (job, mask, thin);
+
+#ifdef CHOPGIMP_HAVE_POTRACE
+  potrace_shapes (job, mask, rgb, out);
+#endif
+
+  if (has_thin && ! job.is_cancelled ())
+    trace_centerline (job, thin, rgb, out);
+}
