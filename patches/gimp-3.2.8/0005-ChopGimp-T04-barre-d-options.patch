+/*  ChopGimp: Photoshop-like color drop-down for fill / stroke / text color:
+ *  « None », recent colors, a swatch grid and the full color picker.
+ */
+#define CHOPGIMP_PALETTE "ChopGimp — Nuancier"
+
+typedef struct
+{
+  Gimp        *gimp;
+  GObject     *options;
+  gchar       *prop;
+  const gchar *enable_prop;
+  const gchar *style_prop;    /* fill/stroke-custom-style (path tool) */
+  const gchar *pattern_prop;  /* fill/stroke-pattern      (path tool) */
+  GtkWidget   *popover;
+  GtkWidget   *dialog_button;
+  GtkWidget   *link;          /* ◆ (3.27.2: the paint follows a global color) */
+} ColorPop;
+
+#define CHOPGIMP_GLOBAL_HOOKS "chopgimp-global-color-hooks"
+
+void
+chopgimp_options_bar_set_global_hooks (GObject                        *options,
+                                       const ChopGimpGlobalColorHooks *hooks)
+{
+  g_return_if_fail (G_IS_OBJECT (options));
+
+  g_object_set_data (options, CHOPGIMP_GLOBAL_HOOKS, (gpointer) hooks);
+}
+
+static const ChopGimpGlobalColorHooks *
+colorpop_hooks (ColorPop *cp)
+{
+  if (! chopgimp_vobjects_enabled ())
+    return NULL;
+
+  return g_object_get_data (cp->options, CHOPGIMP_GLOBAL_HOOKS);
+}
+
+/*  the ◆ next to the swatch  */
+static void
+colorpop_update_link (GtkWidget *link)
+{
+  ColorPop                       *cp    = g_object_get_data (G_OBJECT (link), "chopgimp-colorpop");
+  const ChopGimpGlobalColorHooks *hooks = cp ? colorpop_hooks (cp) : NULL;
+  GimpImage                      *image = hooks ? hooks->get_image (cp->options) : NULL;
+  const gchar                    *id    = image ? hooks->get_global (cp->options, cp->prop) : NULL;
+  const ChopGimpVColor           *c     = id ? chopgimp_vcolors_lookup (image, id) : NULL;
+
+  gtk_widget_set_visible (link, c != NULL);
+
+  if (c)
+    {
+      gchar *tip = g_strdup_printf (_("Couleur globale « %s » : la modifier dans le "
+                                      "panneau Couleurs globales change tous les "
+                                      "objets liés"), c->name);
+
+      gimp_help_set_help_data (link, tip, NULL);
+      g_free (tip);
+    }
+}
+
+static void
+colorpop_global_clicked (GtkWidget *button,
+                         ColorPop  *cp)
+{
+  const ChopGimpGlobalColorHooks *hooks = colorpop_hooks (cp);
+  const gchar                    *id    = g_object_get_data (G_OBJECT (button), "chopgimp-global");
+
+  gtk_popover_popdown (GTK_POPOVER (cp->popover));
+
+  if (hooks)
+    hooks->set_global (cp->options, cp->prop, id);
+
+  if (cp->link)
+    colorpop_update_link (cp->link);
+}
+
+static void
+colorpop_global_new_clicked (GtkWidget *button,
+                             ColorPop  *cp)
+{
+  const ChopGimpGlobalColorHooks *hooks = colorpop_hooks (cp);
+  GimpImage                      *image = hooks ? hooks->get_image (cp->options) : NULL;
+  GeglColor                      *color = NULL;
+  GList                          *list;
+  gchar                          *name;
+  gchar                          *id;
+
+  gtk_popover_popdown (GTK_POPOVER (cp->popover));
+
+  if (! image)
+    return;
+
+  g_object_get (cp->options, cp->prop, &color, NULL);
+  if (! color)
+    color = gegl_color_new ("black");
+
+  list = chopgimp_vcolors_list (image);
+  name = g_strdup_printf (_("Couleur globale %d"), g_list_length (list) + 1);
+  g_list_free (list);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC, _("Nouvelle couleur globale"));
+
+  id = chopgimp_vcolors_add (image, name, color, NULL, TRUE);
+  if (id)
+    hooks->set_global (cp->options, cp->prop, id);
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+
+  g_free (id);
+  g_free (name);
+  g_object_unref (color);
+
+  if (cp->link)
+    colorpop_update_link (cp->link);
+}
+
+/*  « Couleurs globales »: the global colors of the image  */
+static void
+colorpop_build_globals (ColorPop  *cp,
+                        GtkWidget *vbox)
+{
+  const ChopGimpGlobalColorHooks *hooks = colorpop_hooks (cp);
+  GimpImage                      *image = hooks ? hooks->get_image (cp->options) : NULL;
+  const gchar                    *cur;
+  GtkWidget                      *label;
+  GtkWidget                      *grid;
+  GtkWidget                      *row;
+  GtkWidget                      *button;
+  GList                          *colors;
+  gint                            i;
+
+  if (! image)
+    return;
+
+  cur    = hooks->get_global (cp->options, cp->prop);
+  colors = chopgimp_vcolors_list (image);
+
+  label = gtk_label_new (_("Couleurs globales"));
+  gtk_widget_set_halign (label, GTK_ALIGN_START);
+  gtk_style_context_add_class (gtk_widget_get_style_context (label), "dim-label");
+  gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 0);
+
+  grid = gtk_grid_new ();
+  gtk_box_pack_start (GTK_BOX (vbox), grid, FALSE, FALSE, 0);
+
+  i = 0;
+  for (GList *l = colors; l && i < 48; l = l->next, i++)
+    {
+      const ChopGimpVColor *c = l->data;
+
+      button = gtk_button_new ();
+      gtk_container_add (GTK_CONTAINER (button), chopgimp_global_swatch_new (c->color, 18));
+      gtk_button_set_relief (GTK_BUTTON (button),
+                             ! g_strcmp0 (c->id, cur) ? GTK_RELIEF_NORMAL : GTK_RELIEF_NONE);
+      gtk_style_context_add_class (gtk_widget_get_style_context (button), "chopgimp-swatch");
+      gimp_help_set_help_data (button, c->name, NULL);
+      g_object_set_data_full (G_OBJECT (button), "chopgimp-global", g_strdup (c->id), g_free);
+      g_signal_connect (button, "clicked", G_CALLBACK (colorpop_global_clicked), cp);
+      gtk_grid_attach (GTK_GRID (grid), button, i % 12, i / 12, 1, 1);
+    }
+
+  row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_box_pack_start (GTK_BOX (vbox), row, FALSE, FALSE, 0);
+
+  button = gtk_button_new_with_label (_("＋ Nouvelle couleur globale"));
+  gimp_help_set_help_data (button, _("Faire de la couleur actuelle une couleur globale, "
+                                     "suivie par ce fond ou ce contour"), NULL);
+  g_signal_connect (button, "clicked", G_CALLBACK (colorpop_global_new_clicked), cp);
+  gtk_box_pack_start (GTK_BOX (row), button, FALSE, FALSE, 0);
+
+  if (cur)
+    {
+      button = gtk_button_new_with_label (_("Délier"));
+      gimp_help_set_help_data (button, _("Ne plus suivre la couleur globale (la couleur "
+                                         "reste)"), NULL);
+      g_signal_connect (button, "clicked", G_CALLBACK (colorpop_global_clicked), cp);
+      gtk_box_pack_start (GTK_BOX (row), button, FALSE, FALSE, 0);
+    }
+
+  g_list_free (colors);
+}
+
+static void
+colorpop_free (ColorPop *cp)
+{
+  if (cp->link)
+    {
+      g_object_set_data (G_OBJECT (cp->link), "chopgimp-colorpop", NULL);
+      g_object_remove_weak_pointer (G_OBJECT (cp->link), (gpointer *) &cp->link);
+    }
+
+  g_free (cp->prop);
+  g_free (cp);
+}
+
+static void
+colorpop_swatch_clicked (GtkWidget *button,
+                         ColorPop  *cp)
+{
+  GeglColor *color = g_object_get_data (G_OBJECT (button), "photogimp-color");
+
+  if (color)
+    {
+      g_object_set (cp->options, cp->prop, color, NULL);
+      if (cp->style_prop)
+        g_object_set (cp->options, cp->style_prop, GIMP_CUSTOM_STYLE_SOLID_COLOR, NULL);
+      if (cp->enable_prop)
+        g_object_set (cp->options, cp->enable_prop, TRUE, NULL);
+      gimp_palettes_add_color_history (cp->gimp, color);
+    }
+
+  gtk_popover_popdown (GTK_POPOVER (cp->popover));
+}
+
+static void
+colorpop_pattern_clicked (GtkWidget *button,
+                          ColorPop  *cp)
+{
+  GimpPattern *pattern = g_object_get_data (G_OBJECT (button), "photogimp-pattern");
+
+  if (pattern && cp->style_prop && cp->pattern_prop)
+    {
+      g_object_set (cp->options,
+                    cp->pattern_prop, pattern,
+                    cp->style_prop,   GIMP_CUSTOM_STYLE_PATTERN,
+                    NULL);
+      if (cp->enable_prop)
+        g_object_set (cp->options, cp->enable_prop, TRUE, NULL);
+    }
+
+  gtk_popover_popdown (GTK_POPOVER (cp->popover));
+}
+
+static void
+colorpop_none_clicked (GtkWidget *button,
+                       ColorPop  *cp)
+{
+  if (cp->enable_prop)
+    g_object_set (cp->options, cp->enable_prop, FALSE, NULL);
+
+  gtk_popover_popdown (GTK_POPOVER (cp->popover));
+}
+
+static void
+colorpop_picker_clicked (GtkWidget *button,
+                         ColorPop  *cp)
+{
+  gtk_popover_popdown (GTK_POPOVER (cp->popover));
+
+  if (cp->enable_prop)
+    g_object_set (cp->options, cp->enable_prop, TRUE, NULL);
+
+  gtk_button_clicked (GTK_BUTTON (cp->dialog_button));
