+
+static GtkWidget *
+colorpop_swatch (ColorPop  *cp,
+                 GeglColor *color,
+                 gint       size)
+{
+  GtkWidget *button = gtk_button_new ();
+  GtkWidget *area   = gimp_color_area_new (color, GIMP_COLOR_AREA_SMALL_CHECKS, 0);
+
+  gtk_widget_set_size_request (area, size, size);
+  gtk_container_add (GTK_CONTAINER (button), area);
+  gtk_button_set_relief (GTK_BUTTON (button), GTK_RELIEF_NONE);
+  gtk_style_context_add_class (gtk_widget_get_style_context (button), "chopgimp-swatch");
+  g_object_set_data_full (G_OBJECT (button), "photogimp-color",
+                          gegl_color_duplicate (color), g_object_unref);
+  g_signal_connect (button, "clicked", G_CALLBACK (colorpop_swatch_clicked), cp);
+
+  return button;
+}
+
+static void
+colorpop_build (GtkWidget *popover,
+                ColorPop  *cp)
+{
+  GtkWidget     *old = gtk_bin_get_child (GTK_BIN (popover));
+  GtkWidget     *vbox;
+  GtkWidget     *row;
+  GtkWidget     *grid;
+  GtkWidget     *button;
+  GimpPalette   *history;
+  GimpContainer *palettes;
+  GimpObject    *palette;
+  GList         *list;
+  gint           i;
+
+  if (old)
+    gtk_widget_destroy (old);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_container_set_border_width (GTK_CONTAINER (vbox), 8);
+
+  /*  « None » + recent colors  */
+  row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 2);
+  gtk_box_pack_start (GTK_BOX (vbox), row, FALSE, FALSE, 0);
+
+  if (cp->enable_prop)
+    {
+      button = gtk_button_new_with_label (_("⊘ Aucune"));
+      gimp_help_set_help_data (button, _("Pas de couleur (désactive le fond ou le contour)"), NULL);
+      g_signal_connect (button, "clicked", G_CALLBACK (colorpop_none_clicked), cp);
+      gtk_box_pack_start (GTK_BOX (row), button, FALSE, FALSE, 4);
+    }
+
+  history = gimp_palettes_get_color_history (cp->gimp);
+  if (history)
+    for (list = gimp_palette_get_colors (history), i = 0; list && i < 10;
+         list = list->next, i++)
+      {
+        GimpPaletteEntry *entry = list->data;
+
+        gtk_box_pack_start (GTK_BOX (row), colorpop_swatch (cp, entry->color, 18),
+                            FALSE, FALSE, 0);
+      }
+
+  /*  swatch grid  */
+  palettes = gimp_data_factory_get_container (cp->gimp->palette_factory);
+  palette  = gimp_container_get_child_by_name (palettes, CHOPGIMP_PALETTE);
+  if (! palette)
+    palette = gimp_container_get_child_by_name (palettes, "Default");
+
+  if (palette)
+    {
+      gint cols = gimp_palette_get_columns (GIMP_PALETTE (palette));
+
+      if (cols <= 0)
+        cols = 12;
+
+      grid = gtk_grid_new ();
+      gtk_box_pack_start (GTK_BOX (vbox), grid, FALSE, FALSE, 0);
+
+      for (list = gimp_palette_get_colors (GIMP_PALETTE (palette)), i = 0;
+           list && i < 144; list = list->next, i++)
+        {
+          GimpPaletteEntry *entry = list->data;
+
+          gtk_grid_attach (GTK_GRID (grid), colorpop_swatch (cp, entry->color, 16),
+                           i % cols, i / cols, 1, 1);
+        }
+    }
+
+  /*  3.27.2: the global colors of the image  */
+  colorpop_build_globals (cp, vbox);
+
+  /*  patterns (fill / stroke of shapes)  */
+  if (cp->pattern_prop)
+    {
+      GimpContainer *patterns = gimp_data_factory_get_container (cp->gimp->pattern_factory);
+      GimpContext   *context  = gimp_get_user_context (cp->gimp);
+      GtkWidget     *label    = gtk_label_new (_("Motifs"));
+      GtkWidget     *pgrid    = gtk_grid_new ();
+      GList         *plist;
+
+      gtk_widget_set_halign (label, GTK_ALIGN_START);
+      gtk_style_context_add_class (gtk_widget_get_style_context (label), "dim-label");
+      gtk_box_pack_start (GTK_BOX (vbox), label, FALSE, FALSE, 0);
+      gtk_box_pack_start (GTK_BOX (vbox), pgrid, FALSE, FALSE, 0);
+
+      for (plist = GIMP_LIST (patterns)->queue->head, i = 0; plist && i < 36;
+           plist = plist->next, i++)
+        {
+          GtkWidget *pbutton = gtk_button_new ();
+          GtkWidget *view    = gimp_view_new (context, GIMP_VIEWABLE (plist->data), 24, 1, FALSE);
+
+          gtk_container_add (GTK_CONTAINER (pbutton), view);
+          gtk_button_set_relief (GTK_BUTTON (pbutton), GTK_RELIEF_NONE);
+          gtk_style_context_add_class (gtk_widget_get_style_context (pbutton), "chopgimp-swatch");
+          gimp_help_set_help_data (pbutton, gimp_object_get_name (plist->data), NULL);
+          g_object_set_data (G_OBJECT (pbutton), "photogimp-pattern", plist->data);
+          g_signal_connect (pbutton, "clicked", G_CALLBACK (colorpop_pattern_clicked), cp);
+          gtk_grid_attach (GTK_GRID (pgrid), pbutton, i % 12, i / 12, 1, 1);
+        }
+    }
+
+  /*  full color picker  */
+  button = gtk_button_new_with_label (_("Sélecteur de couleur…"));
+  g_signal_connect (button, "clicked", G_CALLBACK (colorpop_picker_clicked), cp);
+  gtk_box_pack_start (GTK_BOX (vbox), button, FALSE, FALSE, 0);
+
+  gtk_container_add (GTK_CONTAINER (popover), vbox);
+  gtk_widget_show_all (vbox);
+}
+
+static GtkWidget *
+gimp_options_bar_color_dropdown (GObject     *options,
+                                 const gchar *prop,
+                                 const gchar *title,
+                                 const gchar *label)
+{
+  ColorPop  *cp   = g_new0 (ColorPop, 1);
+  GtkWidget *hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 2);
+  GtkWidget *menu = gtk_menu_button_new ();
+  GtkWidget *area;
+
+  cp->options = options;
+  cp->prop    = g_strdup (prop);
+  if (! strcmp (prop, "fill-foreground"))
+    {
+      cp->enable_prop  = "enable-fill";
+      cp->style_prop   = "fill-custom-style";
+      cp->pattern_prop = "fill-pattern";
+    }
+  else if (! strcmp (prop, "stroke-foreground"))
+    {
+      cp->enable_prop  = "enable-stroke";
+      cp->style_prop   = "stroke-custom-style";
+      cp->pattern_prop = "stroke-pattern";
+    }
+
+  /*  lot V2: also the object mode of the bar (not a context)  */
+  cp->gimp    = GIMP_IS_CONTEXT (options) ? GIMP_CONTEXT (options)->gimp
+                                          : g_object_get_data (options, "gimp");
+
+  /*  hidden swatch button: opens GIMP's full color dialog  */
+  cp->dialog_button = gimp_prop_color_button_new (options, prop, title, TRUE,
+                                                  20, 20, GIMP_COLOR_AREA_SMALL_CHECKS);
+  /*  ChopGimp 4.2.5: GimpColorDialog needs a context, else « Sélecteur
+   *  de couleur… » silently opened nothing (object mode of the bar).
+   */
+  if (cp->gimp)
+    gimp_color_panel_set_context (GIMP_COLOR_PANEL (cp->dialog_button),
+                                  gimp_get_user_context (cp->gimp));
+  gtk_box_pack_end (GTK_BOX (hbox), cp->dialog_button, FALSE, FALSE, 0);
+  gtk_widget_set_no_show_all (cp->dialog_button, TRUE);
+  gtk_widget_set_visible (cp->dialog_button, FALSE);
+
+  area = gimp_prop_color_area_new (options, prop, 34, 18, GIMP_COLOR_AREA_SMALL_CHECKS);
+  gtk_container_add (GTK_CONTAINER (menu), area);
+  gtk_widget_set_visible (area, TRUE);
+  gimp_help_set_help_data (menu, title, NULL);
+
+  cp->popover = gtk_popover_new (menu);
+  gtk_menu_button_set_popover (GTK_MENU_BUTTON (menu), cp->popover);
+  g_signal_connect (cp->popover, "show", G_CALLBACK (colorpop_build), cp);
+  g_object_set_data_full (G_OBJECT (menu), "photogimp-colorpop", cp,
+                          (GDestroyNotify) colorpop_free);
+
+  if (label)
+    {
+      GtkWidget *l = gtk_label_new (label);
+
+      gtk_style_context_add_class (gtk_widget_get_style_context (l), "dim-label");
+      gtk_box_pack_start (GTK_BOX (hbox), l, FALSE, FALSE, 2);
+      gtk_widget_set_visible (l, TRUE);
+    }
+
+  gtk_box_pack_start (GTK_BOX (hbox), menu, FALSE, FALSE, 0);
+  gtk_widget_set_visible (menu, TRUE);
+  gtk_widget_set_visible (hbox, TRUE);
+
+  /*  3.27.2: ◆ when the paint follows a global color  */
+  if (colorpop_hooks (cp))
+    {
+      const gchar *props[] = { prop, cp->enable_prop, cp->style_prop };
+
+      cp->link = gtk_label_new ("◆");
+      gtk_style_context_add_class (gtk_widget_get_style_context (cp->link),
+                                   "chopgimp-global-link");
+      g_object_set_data (G_OBJECT (cp->link), "chopgimp-colorpop", cp);
+      g_object_add_weak_pointer (G_OBJECT (cp->link), (gpointer *) &cp->link);
+      gtk_box_pack_start (GTK_BOX (hbox), cp->link, FALSE, FALSE, 0);
+      gtk_widget_set_no_show_all (cp->link, TRUE);
+
+      for (guint i = 0; i < G_N_ELEMENTS (props); i++)
+        if (props[i])
+          {
+            gchar *signal = g_strdup_printf ("notify::%s", props[i]);
+
+            g_signal_connect_object (options, signal,
+                                     G_CALLBACK (colorpop_update_link), cp->link,
+                                     G_CONNECT_SWAPPED);
+            g_free (signal);
+          }
+
+      colorpop_update_link (cp->link);
+    }
+
+  return hbox;
+}
+
+GtkWidget *
+chopgimp_options_bar_color_dropdown (GObject     *options,
+                                     const gchar *prop,
+                                     const gchar *title,
+                                     const gchar *label)
+{
+  g_return_val_if_fail (G_IS_OBJECT (options), NULL);
+  g_return_val_if_fail (prop != NULL, NULL);
+
+  return gimp_options_bar_color_dropdown (options, prop, title, label);
+}
+
+/*  ChopGimp: unit shown after the value  */
+static const gchar *
+gimp_options_bar_unit (GObject     *options,
+                       const gchar *prop)
+{
+  static const gchar *const px[] =
+  {
+    "brush-size", "size", "feather-radius", "stroke-width", "corner-radius", "brush-radius",
+    "average-radius", "effect-size", "stabilizer-length", "square-size",
+    /*  Pango letter_spacing attribute, in device units (pixels) whatever
+     *  the text unit (gimp_text_layout_apply_tags ())
+     */
+    "letter-spacing", NULL
+  };
+  static const gchar *const percent[] =
+  {
+    "flow", "exposure", "rate", "offset",
+    /*  warp: hardness / 100, spacing in % of the effect size  */
+    "effect-hardness", "effect-strength", "stroke-spacing", NULL
+  };
+  gint i;
+
+  /*  the line spacing is in the text unit, like the font size
+   *  (gimp_text_layout_new (): gimp_units_to_pixels (line_spacing, unit))
+   */
+  if ((! strcmp (prop, "font-size") || ! strcmp (prop, "line-spacing")) &&
+      g_object_class_find_property (G_OBJECT_GET_CLASS (options), "font-size-unit"))
+    {
+      GimpUnit    *unit = NULL;
+      const gchar *abbr = "px";
+
+      g_object_get (options, "font-size-unit", &unit, NULL);
+      if (unit)
+        {
+          abbr = gimp_unit_get_abbreviation (unit);
+          g_object_unref (unit);
+        }
+
+      return abbr;
+    }
+
+  if (strstr (prop, "angle"))
+    return "°";
+
+  for (i = 0; px[i]; i++)
+    if (! strcmp (prop, px[i]))
+      return "px";
+
+  for (i = 0; percent[i]; i++)
+    if (! strcmp (prop, percent[i]))
+      return "%";
+
+  return NULL;
+}
+
+static void
+gimp_options_bar_font_unit_changed (GObject            *options,
+                                    GParamSpec         *pspec,
+                                    ChopGimpValueField *field)
+{
+  const gchar *prop = g_object_get_data (G_OBJECT (field),
+                                         "chopgimp-options-bar-prop");
+
+  chopgimp_value_field_set_unit (field,
+                                 gimp_options_bar_unit (options,
+                                                        prop ? prop : "font-size"));
+}
+
+/*  ChopGimp: compact value field « Dureté [50 % ▾] » for a numeric option  */
+static GtkWidget *
+gimp_options_bar_value_field (GObject     *options,
+                              const gchar *prop,
+                              GParamSpec  *pspec)
+{
+  const gchar        *label = gimp_options_bar_label (prop);
+  const gchar        *unit  = gimp_options_bar_unit (options, prop);
+  const gchar        *nick  = g_param_spec_get_nick (pspec);
+  ChopGimpValueField *field;
+  GtkWidget          *w;
+  gdouble             lower = 0.0, upper = 0.0;
+
+  if (G_IS_PARAM_SPEC_DOUBLE (pspec))
+    {
+      lower = G_PARAM_SPEC_DOUBLE (pspec)->minimum;
+      upper = G_PARAM_SPEC_DOUBLE (pspec)->maximum;
+    }
+
+  /*  the brush preview stands for the label of the size  */
+  if (! strcmp (prop, "brush-size"))
+    label = NULL;
+  else if (! strcmp (prop, "font-size"))
+    label = NULL;
+  else if (! strcmp (prop, "letter-spacing"))
+    label = "VA";
+  else if (! strcmp (prop, "line-spacing"))
+    label = "↕";
+  else if (! label)
+    label = nick;
+
+  w = chopgimp_value_field_new (options, prop, label, NULL);
+  if (! w)
+    return NULL;
+
+  field = CHOPGIMP_VALUE_FIELD (w);
+
+  if (G_IS_PARAM_SPEC_DOUBLE (pspec) && lower == 0.0 && upper == 1.0)
+    {
+      /*  0..1 shown in %  */
+      chopgimp_value_field_set_factor (field, 100.0);
+      unit = "%";
+    }
+  else if (G_IS_PARAM_SPEC_DOUBLE (pspec) && upper - lower <= 10.0)
+    {
+      chopgimp_value_field_set_digits (field, 2);
+      chopgimp_value_field_set_increments (field, 0.01, 0.1);
+    }
+
+  chopgimp_value_field_set_unit (field, unit);
+
+  if (! strcmp (prop, "brush-size") || ! strcmp (prop, "font-size"))
+    {
+      chopgimp_value_field_set_scale_limits (field, 1.0, 1000.0);
+      chopgimp_value_field_set_gamma (field, 1.7);
+    }
+  else if (! strcmp (prop, "stroke-width"))
+    {
+      chopgimp_value_field_set_digits (field, 1);
+      chopgimp_value_field_set_scale_limits (field, 0.0, 100.0);
+    }
+  else if (! strcmp (prop, "letter-spacing"))
+    {
+      chopgimp_value_field_set_digits (field, 1);
+      chopgimp_value_field_set_scale_limits (field, -100.0, 100.0);
+    }
+  else if (! strcmp (prop, "line-spacing"))
+    {
+      chopgimp_value_field_set_digits (field, 1);
+      chopgimp_value_field_set_scale_limits (field, -50.0, 200.0);
+    }
+  else if (G_IS_PARAM_SPEC_DOUBLE (pspec) && upper - lower > 2000.0)
+    {
+      /*  huge ranges: a usable slider, typing goes beyond  */
+      if (lower >= 0.0)
+        {
+          chopgimp_value_field_set_scale_limits (field, lower, MAX (lower + 1.0, 1000.0));
+          chopgimp_value_field_set_gamma (field, 1.7);
+        }
+      else
+        {
+          chopgimp_value_field_set_scale_limits (field, -500.0, 500.0);
+        }
+    }
+
+  if (! strcmp (prop, "font-size") || ! strcmp (prop, "line-spacing"))
+    {
+      g_object_set_data_full (G_OBJECT (field), "chopgimp-options-bar-prop",
+                              g_strdup (prop), g_free);
+      g_signal_connect_object (options, "notify::font-size-unit",
+                               G_CALLBACK (gimp_options_bar_font_unit_changed),
+                               field, 0);
+    }
+
+  /*  popover title and tooltip: the full name  */
+  if (! strcmp (prop, "letter-spacing"))
+    nick = _("Approche");
+  else if (! strcmp (prop, "line-spacing"))
+    nick = _("Interlignage");
+  else if (! strcmp (prop, "font-size"))
+    nick = _("Taille de police");
+  else if (! strcmp (prop, "brush-size"))
+    nick = _("Taille");
+  else if (gimp_options_bar_label (prop))
+    nick = gimp_options_bar_label (prop);
+
+  chopgimp_value_field_set_title (field, nick);
+  if (g_param_spec_get_blurb (pspec))
+    gimp_help_set_help_data (w, g_param_spec_get_blurb (pspec), NULL);
+
+  gtk_widget_set_visible (w, TRUE);
+
+  return w;
+}
