+/*  ChopGimp: priority of an option in the bar: when the window is too
+ *  narrow, the lowest ones go first into the « ⋯ » menu (at equal
+ *  priority, the rightmost one first).
+ */
+static gint
+gimp_options_bar_priority (const gchar *prop)
+{
+  static const gchar *const high[] =    /*  never moved unless really needed  */
+  {
+    "brush", "brush-size", "size", "radius", "font", "font-size", "foreground",
+    "operation", "paint-mode", "opacity", "gradient", "gradient-type", "fill-mode",
+    "shape-type", "path-edit-mode", "type", "behavior", "effect-size", "cage-mode",
+    "move-current", "zoom-type", "orientation", "draw-mode", "mode", "clone-type",
+    "sample-average", "blob-type", "fixed-rule-active", "fixed-rule",
+    "enable-fill", "fill-foreground", "enable-stroke", "stroke-foreground",
+    "stroke-width", "align-reference", "@nodes", "flip-type", "@vobjects",
+    NULL
+  };
+  /*  3.32.0: the main option of its tool, kept before everything else
+   *  (the Width tool's profile went into « ⋯ » before the objects' bar)
+   */
+  static const gchar *const top[] =
+  {
+    "@widthprofile", NULL
+  };
+  static const gchar *const medium[] =
+  {
+    "brush-hardness", "hardness", "brush-angle", "flow", "exposure", "rate",
+    "feather", "feather-radius", "antialias", "justify", "@text-style", "@align",
+    "threshold", "interpolation", "@fill-opacity", "@stroke-opacity", "corner-radius",
+    "move-type", "average-radius", "fill-area", "sides", "star-ratio",
+    "spiral-turns", "spiral-decay", "arc-closed", "arc-concave", "grid-rows",
+    "grid-cols", "grid-frame",
+    "add-to-vector-layer", NULL
+  };
+  static const gchar *const low[] =     /*  first ones in « ⋯ »  */
+  {
+    "defer-filters", "@pressure", "quickshape", "paper-texture", "pattern",
+    "paper-strength", "use-info-window", "auto-resize", "show-preview", "grid-type",
+    "clip", "highlight", "guide", "dither", "instant", "distance-metric",
+    "diagonal-neighbors", "select-transparent", "fill-transparent", "sample-merged",
+    "@text", "@vector-layer", "@stroke-dash", "box-mode", "mesh-visible",
+    "abyss-policy", "preview-mode", "engine", "show-scribbles", NULL
+  };
+  gint i;
+
+  for (i = 0; top[i]; i++)
+    if (! strcmp (prop, top[i]))
+      return 100;
+
+  for (i = 0; high[i]; i++)
+    if (! strcmp (prop, high[i]))
+      return 90;
+
+  for (i = 0; medium[i]; i++)
+    if (! strcmp (prop, medium[i]))
+      return 70;
+
+  for (i = 0; low[i]; i++)
+    if (! strcmp (prop, low[i]))
+      return 20;
+
+  return 50;
+}
