+/*  « ⚡ » is highlighted when one of its two settings is on  */
+static void
+gimp_options_bar_bolt_update (GObject    *config,
+                              GParamSpec *pspec,
+                              GtkWidget  *bolt)
+{
+  gboolean fast       = FALSE;
+  gboolean background = FALSE;
+
+  g_object_get (config,
+                "fast-preview",      &fast,
+                "background-render", &background,
+                NULL);
+
+  if (fast || background)
+    gtk_style_context_add_class (gtk_widget_get_style_context (bolt), "chopgimp-active");
+  else
+    gtk_style_context_remove_class (gtk_widget_get_style_context (bolt), "chopgimp-active");
+}
