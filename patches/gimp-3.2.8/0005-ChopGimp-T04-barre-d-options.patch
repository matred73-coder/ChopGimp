+                                       "fast-preview",
+                                       _("Aperçu rapide"));
+  gimp_help_set_help_data (button,
+                           _("Aperçu rapide pendant les actions : pendant "
+                             "qu'on modifie l'image, la partie visible est "
+                             "calculée d'abord, par petites tranches qui "
+                             "laissent le pointeur fluide ; le reste est "
+                             "calculé dès que les modifications s'arrêtent ; "
+                             "pendant l'action, les zones modifiées sont "
+                             "d'abord montrées en basse résolution "
+                             "(brouillon), puis affinées. "
+                             "Le rendu final est identique."),
+                           NULL);
+  gtk_box_pack_start (GTK_BOX (vbox), button, FALSE, FALSE, 0);
+
+  button = gimp_prop_check_button_new (G_OBJECT (gimp->config),
+                                       "background-render",
+                                       _("Rendu en arrière-plan"));
+  gimp_help_set_help_data (button,
+                           _("Rendu en arrière-plan : l'image est calculée "
+                             "dans un fil d'exécution à part, l'interface "
+                             "ne bloque plus sur les images lourdes. "
+                             "Expérimental (désactivable aussi par "
+                             "CHOPGIMP_NO_THREADED_RENDER=1). "
+                             "Le rendu final est identique."),
