+static void
+gimp_options_bar_destroy (GtkWidget *bar,
+                          BarState  *st)
+{
+  if (st->idle_id)
+    {
+      g_source_remove (st->idle_id);
+      st->idle_id = 0;
+    }
+
+  if (st->box)
+    g_object_set_data (G_OBJECT (st->box), BAR_STATE_KEY, NULL);
+
+  st->box = NULL;
+}
