+static void
+gimp_options_bar_add_item (BarState    *st,
+                           GtkWidget   *widget,
+                           const gchar *prop,
+                           const gchar *title,
+                           gint         group)
+{
+  BarItem *item = g_new0 (BarItem, 1);
+
+  item->widget   = widget;
+  item->title    = g_strdup (title);
+  item->priority = gimp_options_bar_priority (prop);
+  item->group    = group;
+
+  gtk_widget_set_halign (widget, GTK_ALIGN_START);
+  gtk_widget_set_valign (widget, GTK_ALIGN_CENTER);
+  gimp_options_bar_pack (st->box, widget);
+  g_ptr_array_add (st->items, item);
+}
