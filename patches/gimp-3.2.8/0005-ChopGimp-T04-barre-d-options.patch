+  gtk_style_context_add_class (gtk_widget_get_style_context (popover),
+                               "chopgimp-more-popover");
+  gtk_menu_button_set_popover (GTK_MENU_BUTTON (st->more), popover);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_container_set_border_width (GTK_CONTAINER (vbox), 6);
+  gtk_container_add (GTK_CONTAINER (popover), vbox);
+
+  st->more_title = gimp_options_bar_popover_title (_("Autres réglages"));
+  gtk_box_pack_start (GTK_BOX (vbox), st->more_title, FALSE, FALSE, 0);
+
+  st->more_grid = gtk_grid_new ();
+  gtk_grid_set_row_spacing (GTK_GRID (st->more_grid), 6);
+  gtk_grid_set_column_spacing (GTK_GRID (st->more_grid), 8);
+  gtk_box_pack_start (GTK_BOX (vbox), st->more_grid, FALSE, FALSE, 0);
+
+  st->more_sep = gtk_separator_new (GTK_ORIENTATION_HORIZONTAL);
+  gtk_box_pack_start (GTK_BOX (vbox), st->more_sep, FALSE, FALSE, 0);
+
+  button = gtk_button_new_with_label (_("Toutes les options de l'outil…"));
+  gtk_button_set_relief (GTK_BUTTON (button), GTK_RELIEF_NONE);
+  gtk_label_set_xalign (GTK_LABEL (gtk_bin_get_child (GTK_BIN (button))), 0.0);
+  gimp_help_set_help_data (button, _("Afficher toutes les options de l'outil"), NULL);
+  g_signal_connect (button, "clicked",
+                    G_CALLBACK (gimp_options_bar_more_clicked), gimp);
+  gtk_box_pack_start (GTK_BOX (vbox), button, FALSE, FALSE, 0);
+
+  gtk_widget_show_all (vbox);
+  gtk_widget_set_visible (st->more_title, FALSE);
+  gtk_widget_set_visible (st->more_grid,  FALSE);
+  gtk_widget_set_visible (st->more_sep,   FALSE);
+
+  gtk_box_pack_end (GTK_BOX (bar), st->more, FALSE, FALSE, 0);
+  gtk_widget_set_visible (st->more, TRUE);
+
+  g_signal_connect_object (context, "tool-changed",
+                           G_CALLBACK (gimp_options_bar_tool_changed),
+                           bar, 0);
+
+  gimp_options_bar_tool_changed (context, gimp_context_get_tool (context), bar);
+
+  return bar;
+}
