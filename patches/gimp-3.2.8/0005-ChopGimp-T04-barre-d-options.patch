+/*  Build the bar item (widget, with its label if any) for @prop of
+ *  @options, or NULL. *title is set to the name shown in front of the
+ *  item in the « ⋯ » menu, for items without a label of their own.
+ */
+static GtkWidget *
+gimp_options_bar_widget (GObject      *options,
+                         const gchar  *prop,
+                         const gchar **title)
+{
+  GimpContext *context = GIMP_CONTEXT (options);
+  GParamSpec  *pspec;
+  GtkWidget   *w = NULL;
+
+  *title = NULL;
+
+  if (! strcmp (prop, "brush"))
+    {
+      *title = _("Brosse");
+      return gimp_prop_brush_box_new (NULL, context, NULL, 2,
+                                      "brush-view-type", "brush-view-size",
+                                      "gimp-brush-editor", _("Edit this brush"));
+    }
+  if (! strcmp (prop, "font"))
+    {
+      *title = _("Police");
+      w = gimp_prop_font_box_new (NULL, context, NULL, 2,
+                                  "font-view-type", "font-view-size");
+      gimp_options_bar_widen_entry (w, GINT_TO_POINTER (130));
+      return w;
+    }
+  if (! strcmp (prop, "gradient"))
+    {
+      *title = _("Dégradé");
+      return gimp_prop_gradient_box_new (NULL, context, NULL, 2,
+                                         "gradient-view-type", "gradient-view-size",
+                                         "gradient-reverse",
+                                         "gradient-blend-color-space",
+                                         "gimp-gradient-editor",
+                                         _("Edit this gradient"));
+    }
+
+  if (GIMP_IS_PATH_OPTIONS (options) && prop[0] == '@')
+    gimp_path_options_ensure_fill_stroke (GIMP_PATH_OPTIONS (options));
+
+  if (GIMP_IS_PATH_OPTIONS (options) && ! strcmp (prop, "@fill-opacity"))
+    return gimp_options_bar_sub_opacity (G_OBJECT (GIMP_PATH_OPTIONS (options)->fill_options),
+                                         _("Opacité"), _("Opacité du fond"));
+
+  if (GIMP_IS_PATH_OPTIONS (options) && ! strcmp (prop, "@stroke-opacity"))
+    return gimp_options_bar_sub_opacity (G_OBJECT (GIMP_PATH_OPTIONS (options)->stroke_options),
+                                         _("Opacité"), _("Opacité du contour"));
+
+  if (GIMP_IS_PATH_OPTIONS (options) && ! strcmp (prop, "@stroke-dash"))
+    {
+      *title = _("Tracé");
+      w = gtk_combo_box_text_new ();
+      gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (w), _("Trait plein"));
+      gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (w), _("Tirets"));
+      gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (w), _("Pointillés"));
+      gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (w), _("Tiret-point"));
+      gtk_combo_box_set_active (GTK_COMBO_BOX (w), 0);
+      g_signal_connect (w, "changed", G_CALLBACK (gimp_options_bar_dash_changed),
+                        GIMP_PATH_OPTIONS (options)->stroke_options);
+      return w;
+    }
+
+  if (! strcmp (prop, "@pathfinder"))
+    {
+      *title = _("Pathfinder");
+      return gimp_options_bar_action_row (chopgimp_pathfinder_buttons);
+    }
+
+  if (! strcmp (prop, "@distort"))
+    {
+      *title = _("Distorsion");
+      return gimp_options_bar_action_row (chopgimp_distort_buttons);
+    }
+
+  /*  3.27.6: outil Largeur  */
+  if (! strcmp (prop, "@widthprofile"))
+    {
+      *title = _("Profil de largeur");
+      return chopgimp_width_profile_box_new (GIMP_CONTEXT (options)->gimp);
+    }
+
+  if (! strcmp (prop, "@text"))
+    {
+      *title = _("Texte");
+      return gimp_options_bar_action_row (chopgimp_text_buttons);
+    }
+
+  if (! strcmp (prop, "@text-style"))
+    {
+      *title = _("Style");
+      return gimp_options_bar_text_style_row (GIMP_CONTEXT (options)->gimp);
+    }
+
+  if (! strcmp (prop, "@align"))
+    {
+      *title = _("Aligner");
+      return gimp_options_bar_align_row (GIMP_CONTEXT (options)->gimp);
+    }
+
+  /*  ChopGimp lot V2: the selected objects of a vector layer  */
+  if (! strcmp (prop, "@vobjects"))
+    return chopgimp_vobject_bar_new (GIMP_CONTEXT (options)->gimp,
+                                     gimp_options_bar_color_dropdown);
+
+  if (! strcmp (prop, "@pressure"))
+    return gimp_options_bar_pressure_combo (GIMP_CONTEXT (options)->gimp);
+
+  if (! strcmp (prop, "@nodes"))
+    {
+      *title = _("Nœuds");
+      return gimp_options_bar_action_row (chopgimp_nodes_buttons);
+    }
+
+  if (! strcmp (prop, "@vector-layer"))
+    {
+      w = gtk_button_new_with_label (_("Créer un calque vectoriel"));
+      gimp_help_set_help_data (w, _("Transforme le chemin tracé en forme vectorielle "
+                                    "modifiable (fond et contour)"), NULL);
+      g_signal_connect (w, "clicked",
+                        G_CALLBACK (gimp_options_bar_vector_layer_clicked), options);
+      return w;
+    }
+
+  pspec = g_object_class_find_property (G_OBJECT_GET_CLASS (options), prop);
+
+  if (! pspec)
+    return NULL;
+
+  if (GIMP_IS_PARAM_SPEC_COLOR (pspec) || GEGL_IS_PARAM_SPEC_COLOR (pspec))
+    {
+      const gchar *ctitle = g_param_spec_get_nick (pspec);
+
+      if (! strcmp (prop, "fill-foreground"))
+        ctitle = _("Couleur du fond");
+      else if (! strcmp (prop, "stroke-foreground"))
+        ctitle = _("Couleur du contour");
+      else if (! strcmp (prop, "foreground"))
+        ctitle = _("Couleur");
+
+      *title = (ctitle && *ctitle) ? ctitle : _("Color");
+
+      /*  text: the swatch alone, like Photoshop (tooltip « Couleur »)  */
+      return gimp_options_bar_color_dropdown (options, prop,
+                                              (ctitle && *ctitle) ? ctitle : _("Color"),
+                                              NULL);
+    }
+
+  if (G_IS_PARAM_SPEC_BOOLEAN (pspec) && gimp_options_bar_label (prop))
+    return gimp_prop_check_button_new (options, prop, gimp_options_bar_label (prop));
+
+  if (! strcmp (prop, "paint-mode"))
+    {
+      w = gimp_prop_layer_mode_box_new (options, prop,
+                                        GIMP_LAYER_MODE_CONTEXT_PAINT);
+      gimp_layer_mode_box_set_label (GIMP_LAYER_MODE_BOX (w), _("Mode"));
+      /*  the longest mode name made the box ~240 px wide  */
+      gimp_layer_mode_box_set_ellipsize (GIMP_LAYER_MODE_BOX (w),
+                                         PANGO_ELLIPSIZE_END);
+      gtk_container_foreach (GTK_CONTAINER (w),
+                             gimp_options_bar_cap_combo_width, NULL);
+      return w;
+    }
+
+  if (! strcmp (prop, "operation"))
+    {
+      *title = _("Mode de sélection");
+      return gimp_prop_enum_icon_box_new (options, prop, "gimp-selection", 0, 0);
+    }
+
+  if (! strcmp (prop, "justify"))
+    {
+      *title = _("Alignement");
+      return gimp_prop_enum_icon_box_new (options, prop, "format-justify", 0, 0);
+    }
+
+  if (! strcmp (prop, "type") && G_IS_PARAM_SPEC_ENUM (pspec) &&
+      g_object_class_find_property (G_OBJECT_GET_CLASS (options), "direction"))
+    {
+      *title = g_param_spec_get_nick (pspec);
+      return gimp_prop_enum_icon_box_new (options, prop, "gimp", 0, 0);
+    }
+
+  if (! strcmp (prop, "move-current"))
+    {
+      w = gimp_prop_boolean_combo_box_new (options, prop,
+                                           _("Déplacer le calque actif"),
+                                           _("Sélection automatique du calque"));
+      *title = _("Déplacer");
+      return w;
+    }
+
+  if (G_IS_PARAM_SPEC_BOOLEAN (pspec))
+    return gimp_prop_check_button_new (options, prop, NULL);
+
+  if (G_IS_PARAM_SPEC_ENUM (pspec))
+    {
+      w = gimp_prop_enum_combo_box_new (options, prop, 0, 0);
+
+      return gimp_options_bar_labeled (gimp_options_bar_label (prop) ?
+                                       gimp_options_bar_label (prop) :
+                                       g_param_spec_get_nick (pspec), w);
+    }
+
+  if (G_IS_PARAM_SPEC_DOUBLE (pspec) || G_IS_PARAM_SPEC_INT (pspec))
+    {
+      w = gimp_options_bar_value_field (options, prop, pspec);
+
+      if (w && (! strcmp (prop, "brush-size") || ! strcmp (prop, "font-size")))
+        *title = ! strcmp (prop, "brush-size") ? _("Taille") : _("Taille de police");
+
+      return w;
+    }
+
+  return NULL;
+}
