+
+/*  Photoshop's two stylus buttons: « always use pressure for size » and
+ *  « always use pressure for opacity ». They map to GIMP dynamics:
+ *  none = dynamics off, size = "Pressure Size", opacity = "Pressure
+ *  Opacity", both = "Pression taille + opacité" (shipped by ChopGimp).
+ */
+#define DYN_SIZE    "Pressure Size"
+#define DYN_OPACITY "Pressure Opacity"
+#define DYN_BOTH    "Pression taille + opacité"
+
+typedef struct
+{
+  GObject   *options;
+  GtkWidget *size;
+  GtkWidget *opacity;
+  gboolean   updating;
+} PressureUI;
+
+static void
+pressure_sync (PressureUI *ui)
+{
+  GimpDynamics *dyn;
+  const gchar  *name = "";
+  gboolean      enabled;
+
+  if (! ui || ! ui->size || ! ui->opacity)
+    return;
+
+  g_object_get (ui->options, "dynamics-enabled", &enabled, NULL);
+  dyn = gimp_context_get_dynamics (GIMP_CONTEXT (ui->options));
+  if (dyn)
+    name = gimp_object_get_name (dyn);
+
+  ui->updating = TRUE;
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (ui->size),
+                                enabled && (! strcmp (name, DYN_SIZE) ||
+                                            ! strcmp (name, DYN_BOTH)));
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (ui->opacity),
+                                enabled && (! strcmp (name, DYN_OPACITY) ||
+                                            ! strcmp (name, DYN_BOTH)));
+  ui->updating = FALSE;
+}
+
+static void
+pressure_notify (GObject    *options,
+                 GParamSpec *pspec,
+                 GtkWidget  *button)
+{
+  pressure_sync (g_object_get_data (G_OBJECT (button), "pressure-ui"));
+}
+
+static void
+pressure_dynamics_changed (GimpContext  *context,
+                           GimpDynamics *dynamics,
+                           GtkWidget    *button)
+{
+  pressure_sync (g_object_get_data (G_OBJECT (button), "pressure-ui"));
+}
+
+static void
+pressure_toggled (GtkToggleButton *button,
+                  PressureUI      *ui)
+{
+  gboolean     size, opacity;
+  const gchar *name;
+
+  if (ui->updating || ! ui->size || ! ui->opacity)
+    return;
+
+  size    = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (ui->size));
+  opacity = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (ui->opacity));
+
+  if (! size && ! opacity)
+    {
+      g_object_set (ui->options, "dynamics-enabled", FALSE, NULL);
+      return;
+    }
+
+  name = (size && opacity) ? DYN_BOTH : (size ? DYN_SIZE : DYN_OPACITY);
+
+  {
+    Gimp          *gimp = GIMP_CONTEXT (ui->options)->gimp;
+    GimpContainer *container;
+    GimpObject    *dyn;
+
+    container = gimp_data_factory_get_container (gimp->dynamics_factory);
+    dyn       = gimp_container_get_child_by_name (container, name);
+
+    if (dyn)
+      gimp_context_set_dynamics (GIMP_CONTEXT (ui->options), GIMP_DYNAMICS (dyn));
+  }
+
+  g_object_set (ui->options, "dynamics-enabled", TRUE, NULL);
+}
+
+static GtkWidget *
+pressure_button (PressureUI  *ui,
+                 const gchar *icon,
+                 const gchar *tooltip)
+{
+  GtkWidget *b = gtk_toggle_button_new ();
+
+  gtk_container_add (GTK_CONTAINER (b),
+                     gtk_image_new_from_icon_name (icon, GTK_ICON_SIZE_SMALL_TOOLBAR));
+  gtk_widget_show_all (b);
+  gtk_button_set_relief (GTK_BUTTON (b), GTK_RELIEF_NONE);
+  gimp_help_set_help_data (b, tooltip, NULL);
+  g_object_set_data (G_OBJECT (b), "pressure-ui", ui);
+  g_signal_connect (b, "toggled", G_CALLBACK (pressure_toggled), ui);
+  g_signal_connect_object (ui->options, "notify::dynamics-enabled",
+                           G_CALLBACK (pressure_notify), b, 0);
+  g_signal_connect_object (ui->options, "dynamics-changed",
+                           G_CALLBACK (pressure_dynamics_changed), b, 0);
+  return b;
+}
+
+static void
+pressure_ui_free (PressureUI *ui)
+{
+  g_free (ui);
+}
+
+static void
+pressure_widget_destroyed (GtkWidget  *widget,
+                           PressureUI *ui)
+{
+  g_object_set_data (G_OBJECT (widget), "pressure-ui", NULL);
+
+  if (widget == ui->size)
+    ui->size = NULL;
+  if (widget == ui->opacity)
+    ui->opacity = NULL;
+}
+
+/*  ChopGimp: the bar never scrolls. Each option is an « item » (the
+ *  control with its label, and the stylus button next to the size and
+ *  the opacity); when the window is too narrow, the items of lowest
+ *  priority go into the « ⋯ » menu, and come back when there is room.
+ *
+ *  - the box of the bar reports a minimum width of 0, so it never
+ *    widens the window;
+ *  - in size-allocate, the children that would go past the end are
+ *    only hidden (child-visible), nothing is moved there;
+ *  - an idle then computes, from the natural widths, which items fit
+ *    (greedy: lowest priority, rightmost first) and moves them between
+ *    the bar and the menu. Items come back only when they fit with a
+ *    margin (BAR_HYSTERESIS): no back and forth at a given width, and a
+ *    second pass finds the same result and changes nothing (no loop).
+ */
+#define BAR_STATE_KEY   "chopgimp-bar-state"
+#define BAR_ROW_LABEL   "chopgimp-bar-row-label"
+#define BAR_HYSTERESIS  24
+
+typedef struct
+{
+  GtkWidget *widget;
+  gchar     *title;      /* name in front of it in « ⋯ », or NULL */
+  gint       priority;
+  gint       group;
+  gint       width;      /* natural width, measured in the bar */
+  gboolean   overflow;   /* currently in « ⋯ » */
+} BarItem;
+
+typedef struct
+{
+  GtkWidget *box;        /* tool icon and name, separators, items */
+  GtkWidget *more;       /* « ⋯ » */
+  GtkWidget *more_count;
+  GtkWidget *more_title;
+  GtkWidget *more_grid;
+  GtkWidget *more_sep;
+  GtkWidget *bolt;       /* « ⚡ » */
+  GPtrArray *items;      /* BarItem, in bar order */
+  GPtrArray *seps;       /* separator before group i */
+  gint       n_fixed;    /* children of box before the first item */
+  gint       avail;
+  guint      idle_id;
+} BarState;
+
+static void
+bar_item_free (BarItem *item)
+{
+  g_free (item->title);
+  g_free (item);
+}
+
+static void
+bar_state_free (BarState *st)
+{
+  if (st->idle_id)
+    g_source_remove (st->idle_id);
+
+  g_ptr_array_free (st->items, TRUE);
+  g_ptr_array_free (st->seps, TRUE);
+  g_free (st);
+}
+
+static gint
+bar_natural_width (GtkWidget *widget)
+{
+  gint natural = 0;
+
+  gtk_widget_get_preferred_width (widget, NULL, &natural);
+
+  return natural;
+}
+
+/*  separator before group @g (g >= 1): shown when this group and an
+ *  earlier one have items in the bar
+ */
+static gboolean
+bar_sep_visible (BarState       *st,
+                 const gboolean *overflow,
+                 gint            g)
+{
+  gboolean before = FALSE;
+  gboolean here   = FALSE;
+  guint    i;
+
+  for (i = 0; i < st->items->len; i++)
+    {
+      BarItem *item = g_ptr_array_index (st->items, i);
+
+      if (overflow[i])
+        continue;
+
+      if (item->group < g)
+        before = TRUE;
+      else if (item->group == g)
+        here = TRUE;
+    }
+
+  return before && here;
+}
+
+static gint
+bar_needed_width (BarState       *st,
+                  const gint     *widths,
+                  const gboolean *overflow,
+                  gint            fixed,
+                  gint            sep_width,
+                  gint            spacing)
+{
+  gint  total = fixed;
+  guint i;
+
+  for (i = 0; i < st->items->len; i++)
+    if (! overflow[i])
+      total += widths[i] + spacing;
+
+  for (i = 1; i < st->seps->len; i++)
+    if (bar_sep_visible (st, overflow, i))
+      total += sep_width + spacing;
+
+  return total - spacing;
+}
+
+/*  greedy: send to « ⋯ » the lowest priority item (rightmost at equal
+ *  priority) until the rest fits; returns the number of items sent
+ */
+static gint
+bar_compute (BarState   *st,
+             gint        avail,
+             const gint *widths,
+             gboolean   *overflow,
+             gint        fixed,
+             gint        sep_width,
+             gint        spacing)
+{
+  gint  count = 0;
+  guint i;
+
+  for (i = 0; i < st->items->len; i++)
+    overflow[i] = FALSE;
+
+  while (bar_needed_width (st, widths, overflow, fixed, sep_width, spacing) > avail)
+    {
+      gint victim = -1;
+
+      for (i = 0; i < st->items->len; i++)
+        {
+          BarItem *item = g_ptr_array_index (st->items, i);
+
+          if (overflow[i])
+            continue;
+
+          if (victim < 0 ||
+              item->priority <= ((BarItem *) g_ptr_array_index (st->items, victim))->priority)
+            victim = i;
+        }
+
+      if (victim < 0)
+        break;
+
+      overflow[victim] = TRUE;
+      count++;
+    }
+
+  return count;
+}
+
+/*  move the items between the bar and « ⋯ » as told by @overflow  */
+static void
+bar_apply (BarState       *st,
+           const gboolean *overflow)
+{
+  GList *children;
+  GList *iter;
+  gint   pos;
+  gint   row   = 0;
+  gint   count = 0;
+  guint  i;
+  guint  g;
+
+  /*  take out what moves (and everything in the menu, rebuilt below)  */
+  for (i = 0; i < st->items->len; i++)
+    {
+      BarItem *item = g_ptr_array_index (st->items, i);
+
+      if (item->overflow)
+        {
+          g_object_ref (item->widget);
+          gtk_container_remove (GTK_CONTAINER (st->more_grid), item->widget);
+        }
+      else if (overflow[i])
+        {
+          g_object_ref (item->widget);
+          gtk_container_remove (GTK_CONTAINER (st->box), item->widget);
+        }
+    }
+
+  children = gtk_container_get_children (GTK_CONTAINER (st->more_grid));
+  for (iter = children; iter; iter = iter->next)
+    gtk_widget_destroy (iter->data);
+  g_list_free (children);
+
+  /*  back into the bar  */
+  for (i = 0; i < st->items->len; i++)
+    {
+      BarItem *item = g_ptr_array_index (st->items, i);
+
+      if (item->overflow && ! overflow[i])
+        {
+          gtk_box_pack_start (GTK_BOX (st->box), item->widget, FALSE, FALSE, 0);
+          g_object_unref (item->widget);
+        }
+    }
+
+  /*  order of the bar and its separators  */
+  pos = st->n_fixed;
+  for (g = 0; g < MAX (st->seps->len, 1); g++)
+    {
+      if (g >= 1)
+        {
+          GtkWidget *sep = g_ptr_array_index (st->seps, g);
+
+          gtk_widget_set_visible (sep, bar_sep_visible (st, overflow, g));
+          gtk_box_reorder_child (GTK_BOX (st->box), sep, pos++);
+        }
+
+      for (i = 0; i < st->items->len; i++)
+        {
+          BarItem *item = g_ptr_array_index (st->items, i);
+
+          if (item->group == (gint) g && ! overflow[i])
+            gtk_box_reorder_child (GTK_BOX (st->box), item->widget, pos++);
+        }
+    }
+
+  /*  « ⋯ » menu: one row per item, its name in front when needed  */
+  for (i = 0; i < st->items->len; i++)
+    {
+      BarItem *item = g_ptr_array_index (st->items, i);
+
+      if (overflow[i])
+        {
+          if (item->title)
+            {
+              GtkWidget *label = gtk_label_new (item->title);
+
+              gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+              gtk_style_context_add_class (gtk_widget_get_style_context (label),
+                                           "dim-label");
+              g_object_set_data (G_OBJECT (label), BAR_ROW_LABEL, GINT_TO_POINTER (1));
+              gtk_grid_attach (GTK_GRID (st->more_grid), label, 0, row, 1, 1);
+              gtk_widget_set_visible (label, TRUE);
+              gtk_grid_attach (GTK_GRID (st->more_grid), item->widget, 1, row, 1, 1);
+            }
+          else
+            {
+              gtk_grid_attach (GTK_GRID (st->more_grid), item->widget, 0, row, 2, 1);
+            }
+
+          g_object_unref (item->widget);   /*  ref taken when removed  */
+
+          row++;
+          count++;
+        }
+
+      item->overflow = overflow[i];
+    }
+
+  /*  « ⋯ 3 »  */
+  if (count > 0)
+    {
+      gchar *text = g_strdup_printf ("%d", count);
+
+      gtk_label_set_text (GTK_LABEL (st->more_count), text);
+      g_free (text);
+    }
+  gtk_widget_set_visible (st->more_count, count > 0);
+  gtk_widget_set_visible (st->more_title, count > 0);
+  gtk_widget_set_visible (st->more_grid,  count > 0);
+  gtk_widget_set_visible (st->more_sep,   count > 0);
+}
+
+static void
+bar_relayout (BarState *st,
+              gboolean  force)
+{
+  GList    *children;
+  GList    *iter;
+  gint     *widths;
+  gboolean *overflow;
+  gint      spacing;
+  gint      fixed     = 0;
+  gint      sep_width = 0;
+  gint      n_cur     = 0;
+  gint      n_new;
+  gboolean  changed   = force;
+  guint     i;
+  gint      k;
+
+  if (! st->box)
+    return;
+
+  /*  not allocated yet: everything stays in the bar for now  */
+  if (st->avail <= 1 && ! force)
+    return;
+
+  spacing  = gtk_box_get_spacing (GTK_BOX (st->box));
+  widths   = g_new0 (gint, MAX (st->items->len, 1));
+  overflow = g_new0 (gboolean, MAX (st->items->len, 1));
+
+  children = gtk_container_get_children (GTK_CONTAINER (st->box));
+  for (iter = children, k = 0; iter && k < st->n_fixed; iter = iter->next, k++)
+    fixed += bar_natural_width (iter->data) + spacing;
+  g_list_free (children);
+
+  if (st->seps->len > 0)
+    sep_width = bar_natural_width (g_ptr_array_index (st->seps, 0));
+
+  for (i = 0; i < st->items->len; i++)
+    {
+      BarItem *item = g_ptr_array_index (st->items, i);
+
+      /*  measured in the bar only: the style differs in the menu, and
+       *  a different width there could make an item go back and forth
+       */
+      if (! item->overflow || item->width <= 0)
+        item->width = bar_natural_width (item->widget);
+
+      widths[i] = item->width;
+      if (item->overflow)
+        n_cur++;
+    }
+
+  if (st->avail > 1)
+    {
+      n_new = bar_compute (st, st->avail, widths, overflow, fixed, sep_width, spacing);
+
+      /*  coming back into the bar: only with some room to spare  */
+      if (n_new < n_cur)
+        bar_compute (st, st->avail - BAR_HYSTERESIS, widths, overflow,
+                     fixed, sep_width, spacing);
+    }
+
+  for (i = 0; i < st->items->len; i++)
+    if (overflow[i] != ((BarItem *) g_ptr_array_index (st->items, i))->overflow)
+      changed = TRUE;
+
+  if (changed)
+    bar_apply (st, overflow);
+
+  g_free (widths);
+  g_free (overflow);
+}
+
+static gboolean
+bar_relayout_idle (gpointer data)
+{
+  BarState *st = data;
+
+  st->idle_id = 0;
+  bar_relayout (st, FALSE);
+
+  return G_SOURCE_REMOVE;
+}
