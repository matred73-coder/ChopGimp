+static void
+gimp_options_bar_tool_changed (GimpContext  *context,
+                               GimpToolInfo *tool_info,
+                               GtkWidget    *bar)
+{
+  BarState      *st = g_object_get_data (G_OBJECT (bar), BAR_STATE_KEY);
+  GtkWidget     *box;
+  GtkWidget     *icon;
+  GtkWidget     *label;
+  const BarSpec *spec;
+  GList         *children;
+  GList         *iter;
+  gint           i;
+
+  if (! st || ! st->box || ! tool_info)
+    return;
+
+  if (g_object_get_data (G_OBJECT (bar), BAR_KEY) == tool_info)
+    return;
+
+  g_object_set_data (G_OBJECT (bar), BAR_KEY, tool_info);
+
+  box = st->box;
+
+  children = gtk_container_get_children (GTK_CONTAINER (st->more_grid));
+  for (iter = children; iter; iter = iter->next)
+    gtk_widget_destroy (iter->data);
+  g_list_free (children);
+
+  children = gtk_container_get_children (GTK_CONTAINER (box));
+  for (iter = children; iter; iter = iter->next)
+    gtk_widget_destroy (iter->data);
+  g_list_free (children);
+
+  g_ptr_array_set_size (st->items, 0);
+  g_ptr_array_set_size (st->seps, 0);
+
+  /*  tool icon + name, like Photoshop's tool preset picker  */
+  icon = gtk_image_new_from_icon_name (gimp_viewable_get_icon_name (GIMP_VIEWABLE (tool_info)),
+                                       GTK_ICON_SIZE_LARGE_TOOLBAR);
+  gimp_options_bar_pack (box, icon);
+
+  label = gtk_label_new (tool_info->label);
+  gtk_style_context_add_class (gtk_widget_get_style_context (label), "photogimp-tool-name");
+  gimp_options_bar_pack (box, label);
+
+  st->n_fixed = 2;
+
+  spec = gimp_options_bar_get_spec (gimp_object_get_name (tool_info));
+
+  if (spec && tool_info->tool_options)
+    {
+      GObject    *options  = G_OBJECT (tool_info->tool_options);
+      PressureUI *pressure = NULL;
+      GtkWidget  *sep;
+      gint        group    = 0;
+
+      sep = gtk_separator_new (GTK_ORIENTATION_VERTICAL);
+      gimp_options_bar_pack (box, sep);
+      g_ptr_array_add (st->seps, sep);
+      st->n_fixed = 3;
+
+      if (g_object_class_find_property (G_OBJECT_GET_CLASS (options), "dynamics-enabled"))
+        {
+          pressure = g_new0 (PressureUI, 1);
+          pressure->options = options;
+          g_object_set_data_full (G_OBJECT (box), "pressure-ui", pressure,
+                                  (GDestroyNotify) pressure_ui_free);
+        }
+
+      for (i = 0; spec->props[i]; i++)
+        {
+          const gchar *title = NULL;
+          GtkWidget   *w;
+          GtkWidget   *stylus = NULL;
+
+          if (! strcmp (spec->props[i], "|"))
+            {
+              sep = gtk_separator_new (GTK_ORIENTATION_VERTICAL);
+              gimp_options_bar_pack (box, sep);
+              g_ptr_array_add (st->seps, sep);
+              group++;
+              continue;
+            }
+
+          w = gimp_options_bar_widget (options, spec->props[i], &title);
+
+          if (! w)
+            continue;
+
+          /*  Photoshop: stylus buttons next to opacity and size  */
+          if (pressure && ! strcmp (spec->props[i], "opacity"))
+            {
+              pressure->opacity = pressure_button (pressure, "chopgimp-pressure-opacity",
+                                                   _("Toujours utiliser la pression pour l'opacité"));
+              g_signal_connect (pressure->opacity, "destroy",
+                                G_CALLBACK (pressure_widget_destroyed), pressure);
+              stylus = pressure->opacity;
+            }
+          else if (pressure && ! strcmp (spec->props[i], "brush-size"))
+            {
+              pressure->size = pressure_button (pressure, "chopgimp-pressure-size",
+                                                _("Toujours utiliser la pression pour la taille"));
+              g_signal_connect (pressure->size, "destroy",
+                                G_CALLBACK (pressure_widget_destroyed), pressure);
+              stylus = pressure->size;
+            }
+
+          if (stylus)
+            {
+              GtkWidget *hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 2);
+
+              gtk_box_pack_start (GTK_BOX (hbox), w, FALSE, FALSE, 0);
+              gtk_widget_set_visible (w, TRUE);
+              gtk_box_pack_start (GTK_BOX (hbox), stylus, FALSE, FALSE, 0);
+              gtk_widget_set_visible (stylus, TRUE);
+              w = hbox;
+            }
+
+          gimp_options_bar_add_item (st, w, spec->props[i], title, group);
+        }
+
+      if (pressure)
+        pressure_sync (pressure);
+    }
+
+  /*  initial placement with the current width (no frame with
+   *  everything in the bar)
+   */
+  bar_relayout (st, TRUE);
+}
