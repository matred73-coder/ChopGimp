+/*  ChopGimp: wider font picker, the full font name shows  */
+static void
+gimp_options_bar_widen_entry (GtkWidget *widget,
+                              gpointer   width)
+{
+  if (GTK_IS_ENTRY (widget))
+    {
+      gtk_entry_set_width_chars (GTK_ENTRY (widget), 16);
+      gtk_widget_set_size_request (widget, GPOINTER_TO_INT (width), -1);
+    }
+  else if (GTK_IS_CONTAINER (widget))
