diff --git a/app/widgets/chopgimp-value-field.c b/app/widgets/chopgimp-value-field.c
new file mode 100644
index 0000000..40352e1
--- /dev/null
+++ b/app/widgets/chopgimp-value-field.c
@@ -0,0 +1,975 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-value-field.c — ChopGimp: compact value field of the options bar
+ * Copyright (C) 2026 ChopGimp
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*  Photoshop-like compact field bound to a numeric property:
+ *
+ *    Dureté [ 50 % ▾ ]
+ *
+ *  - dragging the label (↔ pointer) scrubs the value, Shift = fine (× 0.1),
+ *    the slider range being mapped over SCRUB_SPAN pixels;
+ *  - the number can be typed (Enter / focus out), the wheel and the
+ *    Up / Down keys change it (Shift = × 10, Page Up / Down = page);
+ *  - « ▾ » opens a popover with a thin slider, live; Escape closes it.
+ *
+ *  Like GimpSpinScale it knows a display factor (× 100 for 0..1
+ *  properties shown in %), scale limits and a gamma for the slider
+ *  (non-linear mapping, e.g. 1.7 for the brush size).
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+#include <gdk/gdkkeysyms.h>
+
+#include "libgimpwidgets/gimpwidgets.h"
+#include "libgimpwidgets/gimpeevl-private.h"
+
+#include "widgets-types.h"
+
+#include "chopgimp-value-field.h"
+
+
+#define SCRUB_SPAN 300.0   /* pixels for the whole slider range */
+
+
+struct _ChopGimpValueField
+{
+  GtkBox      parent_instance;
+
+  GObject    *config;
+  gchar      *property;
+  GParamSpec *pspec;
+  gchar      *title;
+
+  gdouble     factor;
+  gint        digits;
+  gdouble     step;
+  gdouble     page;
+  gdouble     lower;        /* display units (property × factor) */
+  gdouble     upper;
+  gboolean    has_limits;
+  gdouble     slider_lower;
+  gdouble     slider_upper;
+  gdouble     gamma;
+  gdouble     value;        /* display units */
+
+  GtkWidget  *label_box;
+  GtkWidget  *label;
+  GtkWidget  *frame;
+  GtkWidget  *entry;
+  GtkWidget  *unit;
+  GtkWidget  *arrow;
+  GtkWidget  *popover;
+  GtkWidget  *pop_title;
+  GtkWidget  *scale;
+  GtkWidget  *pop_value;
+
+  gboolean    updating;
+  gboolean    mixed;        /* 4.1.1: shows « mixte » */
+
+  gboolean    scrubbing;
+  gdouble     anchor_x;
+  gdouble     anchor_pos;
+  gboolean    anchor_fine;
+};
+
+
+static void     chopgimp_value_field_dispose  (GObject            *object);
+static void     chopgimp_value_field_finalize (GObject            *object);
+
+static void     value_field_sync              (ChopGimpValueField *field,
+                                               gboolean            sync_scale);
+
+
+G_DEFINE_TYPE (ChopGimpValueField, chopgimp_value_field, GTK_TYPE_BOX)
+
+#define parent_class chopgimp_value_field_parent_class
+
+
+static void
+chopgimp_value_field_class_init (ChopGimpValueFieldClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->dispose  = chopgimp_value_field_dispose;
+  object_class->finalize = chopgimp_value_field_finalize;
+}
+
+static void
+chopgimp_value_field_init (ChopGimpValueField *field)
+{
+  field->factor = 1.0;
+  field->step   = 1.0;
+  field->page   = 10.0;
+  field->gamma  = 1.0;
+}
+
+static void
+chopgimp_value_field_dispose (GObject *object)
+{
+  ChopGimpValueField *field = CHOPGIMP_VALUE_FIELD (object);
+
+  if (field->popover)
+    {
+      GtkWidget *popover = field->popover;
+
+      field->popover   = NULL;
+      field->scale     = NULL;
+      field->pop_value = NULL;
+      field->pop_title = NULL;
+      gtk_widget_destroy (popover);
+    }
+
+  field->entry = NULL;
+  field->unit  = NULL;
+
+  G_OBJECT_CLASS (parent_class)->dispose (object);
+}
+
+static void
+chopgimp_value_field_finalize (GObject *object)
+{
+  ChopGimpValueField *field = CHOPGIMP_VALUE_FIELD (object);
+
+  g_clear_object (&field->config);
+  g_clear_pointer (&field->property, g_free);
+  g_clear_pointer (&field->title, g_free);
+
+  G_OBJECT_CLASS (parent_class)->finalize (object);
+}
+
+
+/*  value <-> property  */
+
+static gdouble
+value_field_get_property (ChopGimpValueField *field)
+{
+  GValue  v = G_VALUE_INIT;
+  gdouble d = 0.0;
+
+  g_value_init (&v, field->pspec->value_type);
+  g_object_get_property (field->config, field->property, &v);
+
+  switch (G_TYPE_FUNDAMENTAL (field->pspec->value_type))
+    {
+    case G_TYPE_DOUBLE: d = g_value_get_double (&v); break;
+    case G_TYPE_FLOAT:  d = g_value_get_float  (&v); break;
+    case G_TYPE_INT:    d = g_value_get_int    (&v); break;
+    case G_TYPE_UINT:   d = g_value_get_uint   (&v); break;
+    default: break;
+    }
+
+  g_value_unset (&v);
+
+  return d * field->factor;
+}
+
+static void
+value_field_set_property (ChopGimpValueField *field,
+                          gdouble             display)
+{
+  GValue  v = G_VALUE_INIT;
+  gdouble d = display / field->factor;
+
+  g_value_init (&v, field->pspec->value_type);
+
+  switch (G_TYPE_FUNDAMENTAL (field->pspec->value_type))
+    {
+    case G_TYPE_DOUBLE: g_value_set_double (&v, d);                  break;
+    case G_TYPE_FLOAT:  g_value_set_float  (&v, d);                  break;
+    case G_TYPE_INT:    g_value_set_int    (&v, (gint) floor (d + 0.5));  break;
+    case G_TYPE_UINT:   g_value_set_uint   (&v, (guint) floor (MAX (d, 0.0) + 0.5)); break;
+    default: break;
+    }
+
+  g_param_value_validate (field->pspec, &v);
+  g_object_set_property (field->config, field->property, &v);
+  g_value_unset (&v);
+}
+
+static gdouble
+value_field_round (ChopGimpValueField *field,
+                   gdouble             value)
+{
+  gdouble scale = pow (10.0, field->digits);
+
+  value = floor (value * scale + 0.5) / scale;
+
+  if (fabs (value) < 0.5 / scale)
+    value = 0.0;
+
+  return value;
+}
+
+static void
+value_field_slider_range (ChopGimpValueField *field,
+                          gdouble            *lo,
+                          gdouble            *hi)
+{
+  *lo = field->has_limits ? field->slider_lower : field->lower;
+  *hi = field->has_limits ? field->slider_upper : field->upper;
+
+  if (*hi <= *lo)
+    *hi = *lo + 1.0;
+}
+
+/*  slider position (0..1 inside the slider range) <-> value, with gamma  */
+static gdouble
+value_field_value_to_pos (ChopGimpValueField *field,
+                          gdouble             value)
+{
+  gdouble lo, hi, t;
+
+  value_field_slider_range (field, &lo, &hi);
+  t = (value - lo) / (hi - lo);
+
+  if (t <= 0.0)
+    return t;
+
+  return pow (t, 1.0 / field->gamma);
+}
+
+static gdouble
+value_field_pos_to_value (ChopGimpValueField *field,
+                          gdouble             pos)
+{
+  gdouble lo, hi;
+
+  value_field_slider_range (field, &lo, &hi);
+
+  if (pos <= 0.0)
+    return lo + pos * (hi - lo);
+
+  return lo + pow (pos, field->gamma) * (hi - lo);
+}
+
+static gchar *
+value_field_format (ChopGimpValueField *field,
+                    gdouble             value)
+{
+  gchar *text = g_strdup_printf ("%.*f", field->digits, value);
+
+  /*  « 2,50 » -> « 2,5 », « 3,00 » -> « 3 »  */
+  if (field->digits > 0 && (strchr (text, '.') || strchr (text, ',')))
+    {
+      gchar *end = text + strlen (text) - 1;
+
+      while (end > text && *end == '0')
+        *end-- = '\0';
+      if (*end == '.' || *end == ',')
+        *end = '\0';
+    }
+
+  return text;
+}
+
+static void
+value_field_set_value (ChopGimpValueField *field,
+                       gdouble             value,
+                       gboolean            sync_scale)
+{
+  value = value_field_round (field, CLAMP (value, field->lower, field->upper));
+
+  if (value != field->value || value != value_field_get_property (field))
+    {
+      field->updating = TRUE;
+      value_field_set_property (field, value);
+      field->updating = FALSE;
+    }
+
+  field->value = value_field_round (field, value_field_get_property (field));
+  value_field_sync (field, sync_scale);
+}
+
+static void
+value_field_sync (ChopGimpValueField *field,
+                  gboolean            sync_scale)
+{
+  gchar *text = field->mixed ? g_strdup ("mixte")
+                             : value_field_format (field, field->value);
+
+  if (field->entry)
+    {
+      gtk_entry_set_text (GTK_ENTRY (field->entry), text);
+      g_object_set_data (G_OBJECT (field->entry), "chopgimp-dirty", NULL);
+    }
+
+  if (field->pop_value)
+    {
+      const gchar *unit = field->unit ? gtk_label_get_text (GTK_LABEL (field->unit)) : "";
+      gchar       *full = g_strdup_printf ("%s %s", text, unit);
+
+      gtk_label_set_text (GTK_LABEL (field->pop_value), g_strstrip (full));
+      g_free (full);
+    }
+
+  if (sync_scale && field->scale)
+    {
+      gboolean old = field->updating;
+
+      field->updating = TRUE;
+      gtk_range_set_value (GTK_RANGE (field->scale),
+                           value_field_value_to_pos (field, field->value));
+      field->updating = old;
+    }
+
+  g_free (text);
+}
+
+static void
+value_field_notify (GObject            *config,
+                    GParamSpec         *pspec,
+                    ChopGimpValueField *field)
+{
+  if (field->updating || ! field->entry)
+    return;
+
+  field->value = value_field_round (field, value_field_get_property (field));
+  value_field_sync (field, TRUE);
+}
+
+
+/*  typed value  */
+
+/*  units are not converted here: every identifier is a dimensionless
+ *  factor of 1 ("2px*5" = 10), so GimpEevl only does the arithmetic
+ */
+static gboolean
+value_field_eevl_unit_resolver (const gchar      *identifier,
+                                GimpEevlQuantity *factor,
+                                gdouble          *offset,
+                                gpointer          data)
+{
+  factor->value     = 1.0;
+  factor->dimension = 0;
+  *offset           = 0.0;
+
+  return identifier == NULL                   ||
+         ! g_ascii_strcasecmp (identifier, "px") ||
+         ! g_ascii_strcasecmp (identifier, "pt");
+}
+
+/*  "2*5", "50+10", "100/3", "(1+2)*3" — the expression parser of
+ *  GimpSpinButton / GimpSizeEntry
+ */
+static gboolean
+value_field_evaluate (const gchar *text,
+                      gdouble     *value)
+{
+  GimpEevlOptions   options   = GIMP_EEVL_OPTIONS_INIT;
+  GimpEevlQuantity  result    = { 0.0, 0 };
+  const gchar      *error_pos = NULL;
+  GError           *error     = NULL;
+
+  if (! text || ! *text)
+    return FALSE;
+
+  options.unit_resolver_proc = value_field_eevl_unit_resolver;
+
+  if (! gimp_eevl_evaluate (text, &options, &result, &error_pos, &error))
+    {
+      g_clear_error (&error);
+      return FALSE;
+    }
+
+  if (! isfinite (result.value))
+    return FALSE;
+
+  *value = result.value;
+
+  return TRUE;
+}
+
+static void
+value_field_commit (ChopGimpValueField *field)
+{
+  gchar   *text;
+  gchar   *p;
+  gchar   *end;
+  gdouble  value;
+
+  if (! field->entry ||
+      ! g_object_get_data (G_OBJECT (field->entry), "chopgimp-dirty"))
+    return;
+
+  text = g_strdup (gtk_entry_get_text (GTK_ENTRY (field->entry)));
+
+  for (p = text; *p; p++)
+    if (*p == ',')
+      *p = '.';
+
+  g_strstrip (text);
+
+  /*  drop the unit typed or left after the number ("51 px", "50 %")  */
+  if (field->unit)
+    {
+      const gchar *unit = gtk_label_get_text (GTK_LABEL (field->unit));
+
+      if (unit && *unit && g_str_has_suffix (text, unit))
+        {
+          text[strlen (text) - strlen (unit)] = '\0';
+          g_strstrip (text);
+        }
+    }
+
+  if (value_field_evaluate (text, &value))
+    {
+      value_field_set_value (field, value, TRUE);
+    }
+  else
+    {
+      value = g_ascii_strtod (text, &end);
+
+      if (end == text)
+        value_field_sync (field, TRUE);       /*  not a number: revert  */
+      else
+        value_field_set_value (field, value, TRUE);
+    }
+
+  g_free (text);
+}
+
+static void
+value_field_nudge (ChopGimpValueField *field,
+                   gdouble             delta)
+{
+  value_field_commit (field);
+  value_field_set_value (field, field->value + delta, TRUE);
+}
+
+static void
+value_field_entry_changed (GtkEditable        *editable,
+                           ChopGimpValueField *field)
+{
+  g_object_set_data (G_OBJECT (editable), "chopgimp-dirty", GINT_TO_POINTER (1));
+}
+
+static void
+value_field_entry_activate (GtkEntry           *entry,
+                            ChopGimpValueField *field)
+{
+  value_field_commit (field);
+  gtk_editable_select_region (GTK_EDITABLE (entry), 0, -1);
+}
+
+static gboolean
+value_field_entry_focus_out (GtkWidget          *widget,
+                             GdkEventFocus      *event,
+                             ChopGimpValueField *field)
+{
+  value_field_commit (field);
+
+  return FALSE;
+}
+
+static gboolean
+value_field_entry_key_press (GtkWidget          *widget,
+                             GdkEventKey        *event,
+                             ChopGimpValueField *field)
+{
+  gdouble mult = (event->state & GDK_SHIFT_MASK) ? 10.0 : 1.0;
+
+  switch (event->keyval)
+    {
+    case GDK_KEY_Up:
+    case GDK_KEY_KP_Up:
+      value_field_nudge (field, field->step * mult);
+      return TRUE;
+
+    case GDK_KEY_Down:
+    case GDK_KEY_KP_Down:
+      value_field_nudge (field, -field->step * mult);
+      return TRUE;
+
+    case GDK_KEY_Page_Up:
+    case GDK_KEY_KP_Page_Up:
+      value_field_nudge (field, field->page);
+      return TRUE;
+
+    case GDK_KEY_Page_Down:
+    case GDK_KEY_KP_Page_Down:
+      value_field_nudge (field, -field->page);
+      return TRUE;
+
+    case GDK_KEY_Escape:
+      value_field_sync (field, TRUE);     /*  forget the typed text  */
+      gtk_editable_select_region (GTK_EDITABLE (widget), 0, -1);
+      return TRUE;
+
+    default:
+      break;
+    }
+
+  return FALSE;
+}
+
+static gboolean
+value_field_scroll (GtkWidget          *widget,
+                    GdkEventScroll     *event,
+                    ChopGimpValueField *field)
+{
+  gdouble mult = (event->state & GDK_SHIFT_MASK) ? 10.0 : 1.0;
+  gdouble dy   = 0.0;
+
+  switch (event->direction)
+    {
+    case GDK_SCROLL_UP:     dy = -1.0; break;
+    case GDK_SCROLL_DOWN:   dy =  1.0; break;
+    case GDK_SCROLL_SMOOTH: dy = event->delta_y; break;
+    default: return FALSE;
+    }
+
+  if (dy == 0.0)
+    return TRUE;
+
+  value_field_nudge (field, (dy < 0.0 ? 1.0 : -1.0) * field->step * mult);
+
+  return TRUE;
+}
+
+
+/*  label scrubbing  */
+
+static void
+value_field_label_realize (GtkWidget *widget,
+                           gpointer   data)
+{
+  GdkCursor *cursor = gdk_cursor_new_from_name (gtk_widget_get_display (widget),
+                                                "ew-resize");
+
+  if (cursor)
+    {
+      gdk_window_set_cursor (gtk_widget_get_window (widget), cursor);
+      g_object_unref (cursor);
+    }
+}
+
+static gboolean
+value_field_label_press (GtkWidget          *widget,
+                         GdkEventButton     *event,
+                         ChopGimpValueField *field)
+{
+  if (event->button != 1 || event->type != GDK_BUTTON_PRESS)
+    return FALSE;
+
+  value_field_commit (field);
+
+  field->scrubbing   = TRUE;
+  field->anchor_x    = event->x_root;
+  field->anchor_pos  = value_field_value_to_pos (field, field->value);
+  field->anchor_fine = (event->state & GDK_SHIFT_MASK) != 0;
+
+  gtk_style_context_add_class (gtk_widget_get_style_context (widget), "scrubbing");
+
+  return TRUE;
+}
+
+static gboolean
+value_field_label_motion (GtkWidget          *widget,
+                          GdkEventMotion     *event,
+                          ChopGimpValueField *field)
+{
+  gboolean fine;
+  gdouble  pos;
+
+  if (! field->scrubbing)
+    return FALSE;
+
+  fine = (event->state & GDK_SHIFT_MASK) != 0;
+
+  /*  Shift pressed or released while dragging: start again from here  */
+  if (fine != field->anchor_fine)
+    {
+      field->anchor_x    = event->x_root;
+      field->anchor_pos  = value_field_value_to_pos (field, field->value);
+      field->anchor_fine = fine;
+    }
+
+  pos = field->anchor_pos +
+        (event->x_root - field->anchor_x) / SCRUB_SPAN * (fine ? 0.1 : 1.0);
+  pos = CLAMP (pos, MIN (0.0, field->anchor_pos), MAX (1.0, field->anchor_pos));
+
+  value_field_set_value (field, value_field_pos_to_value (field, pos), TRUE);
+
+  return TRUE;
+}
+
+static gboolean
+value_field_label_release (GtkWidget          *widget,
+                           GdkEventButton     *event,
+                           ChopGimpValueField *field)
+{
+  if (event->button != 1 || ! field->scrubbing)
+    return FALSE;
+
+  field->scrubbing = FALSE;
+  gtk_style_context_remove_class (gtk_widget_get_style_context (widget), "scrubbing");
+
+  return TRUE;
+}
+
+
+/*  slider popover  */
+
+static void
+value_field_scale_changed (GtkRange           *range,
+                           ChopGimpValueField *field)
+{
+  if (field->updating)
+    return;
+
+  /*  don't move the slider under the pointer (rounding)  */
+  value_field_set_value (field,
+                         value_field_pos_to_value (field, gtk_range_get_value (range)),
+                         FALSE);
+}
+
+static void
+value_field_build_popover (ChopGimpValueField *field)
+{
+  GtkWidget *vbox;
+  GtkWidget *hbox;
+
+  field->popover = gtk_popover_new (field->frame);
+  gtk_popover_set_position (GTK_POPOVER (field->popover), GTK_POS_BOTTOM);
+  gtk_style_context_add_class (gtk_widget_get_style_context (field->popover),
+                               "chopgimp-value-popover");
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 4);
+  gtk_container_set_border_width (GTK_CONTAINER (vbox), 4);
+  gtk_container_add (GTK_CONTAINER (field->popover), vbox);
+
+  field->pop_title = gtk_label_new (field->title);
+  gtk_label_set_xalign (GTK_LABEL (field->pop_title), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (field->pop_title),
+                               "chopgimp-popover-title");
+  gtk_box_pack_start (GTK_BOX (vbox), field->pop_title, FALSE, FALSE, 0);
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+  gtk_box_pack_start (GTK_BOX (vbox), hbox, FALSE, FALSE, 0);
+
+  field->scale = gtk_scale_new_with_range (GTK_ORIENTATION_HORIZONTAL,
+                                           0.0, 1.0, 0.001);
+  gtk_range_set_increments (GTK_RANGE (field->scale), 0.01, 0.1);
+  gtk_scale_set_draw_value (GTK_SCALE (field->scale), FALSE);
+  gtk_widget_set_size_request (field->scale, 180, -1);
+  gtk_style_context_add_class (gtk_widget_get_style_context (field->scale),
+                               "chopgimp-thin-scale");
+  gtk_box_pack_start (GTK_BOX (hbox), field->scale, TRUE, TRUE, 0);
+
+  field->pop_value = gtk_label_new (NULL);
+  gtk_label_set_width_chars (GTK_LABEL (field->pop_value), 7);
+  gtk_label_set_xalign (GTK_LABEL (field->pop_value), 1.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (field->pop_value),
+                               "dim-label");
+  gtk_box_pack_start (GTK_BOX (hbox), field->pop_value, FALSE, FALSE, 0);
+
+  g_signal_connect (field->scale, "value-changed",
+                    G_CALLBACK (value_field_scale_changed), field);
+
+  gtk_widget_show_all (vbox);
+}
+
+static void
+value_field_arrow_clicked (GtkWidget          *button,
+                           ChopGimpValueField *field)
+{
+  value_field_commit (field);
+
+  if (! field->popover)
+    value_field_build_popover (field);
+
+  if (gtk_widget_get_visible (field->popover))
+    {
+      gtk_popover_popdown (GTK_POPOVER (field->popover));
+      return;
+    }
+
+  value_field_sync (field, TRUE);
+  gtk_popover_popup (GTK_POPOVER (field->popover));
+  gtk_widget_grab_focus (field->scale);
+}
+
+
+/*  public functions  */
+
+GtkWidget *
+chopgimp_value_field_new (GObject     *config,
+                          const gchar *property_name,
+                          const gchar *label,
+                          const gchar *unit)
+{
+  ChopGimpValueField *field;
+  GParamSpec         *pspec;
+  gchar              *signal;
+
+  g_return_val_if_fail (G_IS_OBJECT (config), NULL);
+  g_return_val_if_fail (property_name != NULL, NULL);
+
+  pspec = g_object_class_find_property (G_OBJECT_GET_CLASS (config), property_name);
+
+  if (! pspec)
+    return NULL;
+
+  field = g_object_new (CHOPGIMP_TYPE_VALUE_FIELD,
+                        "orientation", GTK_ORIENTATION_HORIZONTAL,
+                        "spacing",     4,
+                        NULL);
+
+  field->config   = g_object_ref (config);
+  field->property = g_strdup (property_name);
+  field->pspec    = pspec;
+  field->title    = g_strdup ((label && *label) ? label : g_param_spec_get_nick (pspec));
+
+  if (G_IS_PARAM_SPEC_DOUBLE (pspec))
+    {
+      field->lower = G_PARAM_SPEC_DOUBLE (pspec)->minimum;
+      field->upper = G_PARAM_SPEC_DOUBLE (pspec)->maximum;
+    }
+  else if (G_IS_PARAM_SPEC_FLOAT (pspec))
+    {
+      field->lower = G_PARAM_SPEC_FLOAT (pspec)->minimum;
+      field->upper = G_PARAM_SPEC_FLOAT (pspec)->maximum;
+    }
+  else if (G_IS_PARAM_SPEC_INT (pspec))
+    {
+      field->lower = G_PARAM_SPEC_INT (pspec)->minimum;
+      field->upper = G_PARAM_SPEC_INT (pspec)->maximum;
+    }
+  else if (G_IS_PARAM_SPEC_UINT (pspec))
+    {
+      field->lower = G_PARAM_SPEC_UINT (pspec)->minimum;
+      field->upper = G_PARAM_SPEC_UINT (pspec)->maximum;
+    }
+  else
+    {
+      g_warning ("%s: property '%s' is not numeric", G_STRFUNC, property_name);
+      g_object_ref_sink (field);
+      g_object_unref (field);
+      return NULL;
+    }
+
+  gtk_style_context_add_class (gtk_widget_get_style_context (GTK_WIDGET (field)),
+                               "chopgimp-value-field");
+
+  /*  label, drag it to change the value  */
+  field->label_box = gtk_event_box_new ();
+  gtk_event_box_set_visible_window (GTK_EVENT_BOX (field->label_box), TRUE);
+  gtk_widget_add_events (field->label_box,
+                         GDK_BUTTON_PRESS_MASK | GDK_BUTTON_RELEASE_MASK |
+                         GDK_POINTER_MOTION_MASK);
+  gtk_style_context_add_class (gtk_widget_get_style_context (field->label_box),
+                               "chopgimp-scrub-label");
+  gtk_box_pack_start (GTK_BOX (field), field->label_box, FALSE, FALSE, 0);
+
+  field->label = gtk_label_new (label);
+  gtk_style_context_add_class (gtk_widget_get_style_context (field->label), "dim-label");
+  gtk_container_add (GTK_CONTAINER (field->label_box), field->label);
+  gtk_widget_set_visible (field->label, TRUE);
+  gtk_widget_set_visible (field->label_box, label && *label);
+
+  g_signal_connect (field->label_box, "realize",
+                    G_CALLBACK (value_field_label_realize), NULL);
+  g_signal_connect (field->label_box, "button-press-event",
+                    G_CALLBACK (value_field_label_press), field);
+  g_signal_connect (field->label_box, "motion-notify-event",
+                    G_CALLBACK (value_field_label_motion), field);
+  g_signal_connect (field->label_box, "button-release-event",
+                    G_CALLBACK (value_field_label_release), field);
+
+  /*  [ 51 px ▾ ]  */
+  field->frame = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_set_valign (field->frame, GTK_ALIGN_CENTER);
+  gtk_style_context_add_class (gtk_widget_get_style_context (field->frame),
+                               "chopgimp-field");
+  gtk_box_pack_start (GTK_BOX (field), field->frame, FALSE, FALSE, 0);
+  gtk_widget_set_visible (field->frame, TRUE);
+
+  field->entry = gtk_entry_new ();
+  gtk_entry_set_has_frame (GTK_ENTRY (field->entry), FALSE);
+  gtk_entry_set_width_chars (GTK_ENTRY (field->entry), 4);
+  gtk_entry_set_max_width_chars (GTK_ENTRY (field->entry), 5);
+  gtk_entry_set_alignment (GTK_ENTRY (field->entry), 1.0);
+  gtk_entry_set_input_purpose (GTK_ENTRY (field->entry), GTK_INPUT_PURPOSE_NUMBER);
+  gtk_widget_add_events (field->entry, GDK_SCROLL_MASK | GDK_SMOOTH_SCROLL_MASK);
+  gtk_box_pack_start (GTK_BOX (field->frame), field->entry, FALSE, FALSE, 0);
+  gtk_widget_set_visible (field->entry, TRUE);
+
+  g_signal_connect (field->entry, "changed",
+                    G_CALLBACK (value_field_entry_changed), field);
+  g_signal_connect (field->entry, "activate",
+                    G_CALLBACK (value_field_entry_activate), field);
+  g_signal_connect (field->entry, "focus-out-event",
+                    G_CALLBACK (value_field_entry_focus_out), field);
+  g_signal_connect (field->entry, "key-press-event",
+                    G_CALLBACK (value_field_entry_key_press), field);
+  g_signal_connect (field->entry, "scroll-event",
+                    G_CALLBACK (value_field_scroll), field);
+
+  field->unit = gtk_label_new (unit);
+  gtk_style_context_add_class (gtk_widget_get_style_context (field->unit),
+                               "chopgimp-unit");
+  gtk_box_pack_start (GTK_BOX (field->frame), field->unit, FALSE, FALSE, 0);
+  gtk_widget_set_visible (field->unit, unit && *unit);
+
+  field->arrow = gtk_button_new_with_label ("▾");
+  gtk_button_set_relief (GTK_BUTTON (field->arrow), GTK_RELIEF_NONE);
+  gtk_widget_set_can_focus (field->arrow, FALSE);
+  gtk_style_context_add_class (gtk_widget_get_style_context (field->arrow),
+                               "chopgimp-field-arrow");
+  gimp_help_set_help_data (field->arrow, field->title, NULL);
+  gtk_box_pack_start (GTK_BOX (field->frame), field->arrow, FALSE, FALSE, 0);
+  gtk_widget_set_visible (field->arrow, TRUE);
+
+  g_signal_connect (field->arrow, "clicked",
+                    G_CALLBACK (value_field_arrow_clicked), field);
+
+  /*  the wheel works on the whole field  */
+  gtk_widget_add_events (field->arrow, GDK_SCROLL_MASK | GDK_SMOOTH_SCROLL_MASK);
+  g_signal_connect (field->arrow, "scroll-event",
+                    G_CALLBACK (value_field_scroll), field);
+
+  signal = g_strconcat ("notify::", property_name, NULL);
+  g_signal_connect_object (config, signal,
+                           G_CALLBACK (value_field_notify), field, 0);
+  g_free (signal);
+
+  field->value = value_field_round (field, value_field_get_property (field));
+  value_field_sync (field, TRUE);
+
+  return GTK_WIDGET (field);
+}
+
+/*  property × factor is shown (100 for 0..1 properties shown in %)  */
+void
+chopgimp_value_field_set_factor (ChopGimpValueField *field,
+                                 gdouble             factor)
+{
+  g_return_if_fail (CHOPGIMP_IS_VALUE_FIELD (field));
+  g_return_if_fail (factor > 0.0);
+
+  field->lower  = field->lower / field->factor * factor;
+  field->upper  = field->upper / field->factor * factor;
+  field->factor = factor;
+
+  field->value = value_field_round (field, value_field_get_property (field));
+  value_field_sync (field, TRUE);
+}
+
+void
+chopgimp_value_field_set_digits (ChopGimpValueField *field,
+                                 gint                digits)
+{
+  g_return_if_fail (CHOPGIMP_IS_VALUE_FIELD (field));
+
+  field->digits = CLAMP (digits, 0, 6);
+  gtk_entry_set_width_chars (GTK_ENTRY (field->entry), digits > 0 ? 5 : 4);
+
+  field->value = value_field_round (field, value_field_get_property (field));
+  value_field_sync (field, TRUE);
+}
+
+void
+chopgimp_value_field_set_increments (ChopGimpValueField *field,
+                                     gdouble             step,
+                                     gdouble             page)
+{
+  g_return_if_fail (CHOPGIMP_IS_VALUE_FIELD (field));
+
+  field->step = step;
+  field->page = page;
+}
+
+/*  range of the popover slider and of the label drag (display units);
+ *  typed values may go beyond, up to the property limits
+ */
+void
+chopgimp_value_field_set_scale_limits (ChopGimpValueField *field,
+                                       gdouble             lower,
+                                       gdouble             upper)
+{
+  g_return_if_fail (CHOPGIMP_IS_VALUE_FIELD (field));
+
+  field->has_limits   = TRUE;
+  field->slider_lower = MAX (lower, field->lower);
+  field->slider_upper = MIN (upper, field->upper);
+
+  value_field_sync (field, TRUE);
+}
+
+void
+chopgimp_value_field_set_gamma (ChopGimpValueField *field,
+                                gdouble             gamma)
+{
+  g_return_if_fail (CHOPGIMP_IS_VALUE_FIELD (field));
+  g_return_if_fail (gamma > 0.0);
+
+  field->gamma = gamma;
+
+  value_field_sync (field, TRUE);
+}
+
+void
+chopgimp_value_field_set_unit (ChopGimpValueField *field,
+                               const gchar        *unit)
+{
+  g_return_if_fail (CHOPGIMP_IS_VALUE_FIELD (field));
+
+  gtk_label_set_text (GTK_LABEL (field->unit), unit ? unit : "");
+  gtk_widget_set_visible (field->unit, unit && *unit);
+
+  value_field_sync (field, FALSE);
+}
+
+/*  title of the slider popover and tooltip of « ▾ »  */
+void
+chopgimp_value_field_set_title (ChopGimpValueField *field,
+                                const gchar        *title)
+{
+  g_return_if_fail (CHOPGIMP_IS_VALUE_FIELD (field));
+
+  g_free (field->title);
+  field->title = g_strdup (title ? title : "");
+
+  if (field->pop_title)
+    gtk_label_set_text (GTK_LABEL (field->pop_title), field->title);
+
+  gimp_help_set_help_data (field->arrow, field->title, NULL);
+}
+
+/*  4.1.1: the objects edited have different values: « mixte » until the
+ *  next value
+ */
+void
+chopgimp_value_field_set_mixed (ChopGimpValueField *field,
+                                gboolean            mixed)
+{
+  g_return_if_fail (CHOPGIMP_IS_VALUE_FIELD (field));
+
+  if (field->mixed == mixed)
+    return;
+
+  field->mixed = mixed;
+  value_field_sync (field, FALSE);
+}
