+/* GIMP - The GNU Image Manipulation Program
+ * gimpoptionsbar.h — PhotoGIMP Pro: Photoshop-like horizontal tool options bar
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+GtkWidget * gimp_options_bar_new (Gimp *gimp);
+
+/*  ChopGimp 3.27.2: the color drop-down of the bar (none, recent colors,
+ *  swatches, patterns, color dialog) for the « Aspect » panel. @prop is
+ *  « fill-foreground » or « stroke-foreground »; @options must also have
+ *  the « enable- », « -custom-style » and « -pattern » properties of that
+ *  kind, and a « gimp » data when it is not a GimpContext.
+ */
+GtkWidget * chopgimp_options_bar_color_dropdown (GObject     *options,
+                                                 const gchar *prop,
+                                                 const gchar *title,
+                                                 const gchar *label);
+
+/*  ChopGimp 3.27.2 (lot V6 point 2): « Couleurs globales » in the color
+ *  drop-down. When @options carries these hooks (set before the drop-down
+ *  is made), its popover has a « Couleurs globales » row (a click links
+ *  the paint, « Nouvelle couleur globale » makes one from the current
+ *  color and links it, « Délier »), and a ◆ next to the swatch tells that
+ *  the paint follows a global color. @hooks must stay valid (static).
+ */
+typedef struct
+{
+  GimpImage   * (* get_image)  (GObject     *options);
+  /*  the global color followed by the paint of @prop, or NULL  */
+  const gchar * (* get_global) (GObject     *options,
+                                const gchar *prop);
+  /*  the paint of @prop follows @id (NULL: unlinked, keeps the color)  */
+  void          (* set_global) (GObject     *options,
+                                const gchar *prop,
+                                const gchar *id);
+} ChopGimpGlobalColorHooks;
+
+void        chopgimp_options_bar_set_global_hooks (GObject                        *options,
+                                                   const ChopGimpGlobalColorHooks *hooks);
