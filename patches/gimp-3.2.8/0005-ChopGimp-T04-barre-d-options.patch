+GtkWidget *
+gimp_options_bar_new (Gimp *gimp)
+{
+  GimpContext *context;
+  BarState    *st;
+  GtkWidget   *bar;
+  GtkWidget   *box;
+  GtkWidget   *popover;
+  GtkWidget   *vbox;
+  GtkWidget   *hbox;
+  GtkWidget   *label;
+  GtkWidget   *button;
+
+  g_return_val_if_fail (GIMP_IS_GIMP (gimp), NULL);
+
+  context = gimp_get_user_context (gimp);
+
+  st        = g_new0 (BarState, 1);
+  st->items = g_ptr_array_new_with_free_func ((GDestroyNotify) bar_item_free);
+  st->seps  = g_ptr_array_new ();
+
+  bar = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 2);
+  gtk_widget_set_name (bar, "photogimp-options-bar");
+  gtk_container_set_border_width (GTK_CONTAINER (bar), 2);
+  g_object_set_data_full (G_OBJECT (bar), BAR_STATE_KEY, st,
+                          (GDestroyNotify) bar_state_free);
+  g_signal_connect (bar, "destroy",
+                    G_CALLBACK (gimp_options_bar_destroy), st);
+
+  /*  no scrolling: what does not fit goes into « ⋯ »  */
+  box = g_object_new (chopgimp_bar_box_get_type (),
+                      "orientation", GTK_ORIENTATION_HORIZONTAL,
+                      "spacing",     8,
+                      NULL);
+  g_object_set_data (G_OBJECT (box), BAR_STATE_KEY, st);
+  gtk_box_pack_start (GTK_BOX (bar), box, TRUE, TRUE, 0);
+  gtk_widget_set_visible (box, TRUE);
+  st->box = box;
+
+  /*  « ⚡ » : Aperçu rapide / Rendu en arrière-plan (display preferences,
+   *  whatever the tool)
+   */
+  st->bolt = gtk_menu_button_new ();
+  label = gtk_label_new ("⚡\xef\xb8\x8e");   /*  U+26A1 U+FE0E (text style)  */
+  gtk_container_add (GTK_CONTAINER (st->bolt), label);
+  gtk_widget_set_visible (label, TRUE);
+  gtk_button_set_relief (GTK_BUTTON (st->bolt), GTK_RELIEF_NONE);
+  gtk_widget_set_can_focus (st->bolt, FALSE);
+  gtk_style_context_add_class (gtk_widget_get_style_context (st->bolt),
+                               "chopgimp-bar-menu");
+  gimp_help_set_help_data (st->bolt, _("Rendu : Aperçu rapide, Rendu en arrière-plan"),
+                           NULL);
+
+  popover = gtk_popover_new (st->bolt);
+  gtk_menu_button_set_popover (GTK_MENU_BUTTON (st->bolt), popover);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 4);
