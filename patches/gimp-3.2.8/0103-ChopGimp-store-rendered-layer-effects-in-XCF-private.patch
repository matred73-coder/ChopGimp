+/*  GEGL's node cache (a GeglBuffer subclass) has no public API to mark a
+ *  region as computed; these functions are exported by libgegl (see
+ *  gegl/graph/gegl-cache.h and gegl-node-private.h, GEGL 0.4.72).
+ */
+GType        gegl_cache_get_type               (void);
+GeglBuffer * gegl_node_get_cache               (GeglNode             *node);
+void         gegl_cache_computed               (GeglBuffer           *cache,
+                                                const GeglRectangle  *rect,
+                                                gint                  level);
+gboolean     gegl_buffer_list_valid_rectangles (GeglBuffer           *buffer,
+                                                GeglRectangle       **rectangles,
+                                                gint                 *n_rectangles);
+
+
+#define FX_CACHE_MAGIC          "CGFX"
+#define FX_CACHE_VERSION        1
+#define FX_CACHE_KEY_SIZE       32
+#define FX_CACHE_MAX_RECTS      65536
+#define FX_CACHE_MAX_NODES      20000
+#define FX_CACHE_STRIP_PIXELS   (256 * 1024)
+#define FX_CACHE_CONFIG_TTL     (5 * G_TIME_SPAN_SECOND)
+
+
+typedef struct
+{
+  gboolean enabled;
+  gboolean strict;
+  gboolean debug;
+  gint64   min_pixels;
+  gint64   max_bytes;
+  gint64   budget_us;
+  gint     zlib_level;
+  gint64   loaded_at;
+} FxCacheConfig;
+
+
+/*  config  */
+
+static const FxCacheConfig *
+fx_cache_config (void)
+{
+  static FxCacheConfig config = { 0, };
+  gint64               now    = g_get_monotonic_time ();
+
+  if (config.loaded_at == 0 || now - config.loaded_at > FX_CACHE_CONFIG_TTL)
+    {
+      GKeyFile    *rc   = g_key_file_new ();
+      GFile       *file = gimp_directory_file ("chopgimprc", NULL);
+      gchar       *path = g_file_get_path (file);
+      const gchar *env;
+      GError      *error = NULL;
+      gint64       value;
+
+      config.enabled    = TRUE;
+      config.strict     = FALSE;
+      config.min_pixels = 65536;
+      config.max_bytes  = (gint64) 256 * 1024 * 1024;
+      config.budget_us  = 3000 * G_TIME_SPAN_MILLISECOND;
+      config.zlib_level = 1;
+
+      if (path && g_key_file_load_from_file (rc, path, G_KEY_FILE_NONE, NULL))
+        {
+          gboolean b;
+
+          b = g_key_file_get_boolean (rc, "xcf", "fx-cache", &error);
+          if (! error) config.enabled = b;
+          g_clear_error (&error);
+
+          b = g_key_file_get_boolean (rc, "xcf", "fx-cache-strict", &error);
+          if (! error) config.strict = b;
+          g_clear_error (&error);
+
+          value = g_key_file_get_int64 (rc, "xcf", "fx-cache-min-pixels", &error);
+          if (! error) config.min_pixels = MAX (value, 0);
+          g_clear_error (&error);
+
+          value = g_key_file_get_int64 (rc, "xcf", "fx-cache-max-mb", &error);
+          if (! error) config.max_bytes = CLAMP (value, 1, 512) * 1024 * 1024;
+          g_clear_error (&error);
+
+          value = g_key_file_get_int64 (rc, "xcf", "fx-cache-save-budget-ms", &error);
+          if (! error) config.budget_us = MAX (value, 0) * G_TIME_SPAN_MILLISECOND;
+          g_clear_error (&error);
+
+          value = g_key_file_get_int64 (rc, "xcf", "fx-cache-zlib-level", &error);
+          if (! error) config.zlib_level = CLAMP (value, 1, 9);
+          g_clear_error (&error);
+        }
+
+      env = g_getenv ("CHOPGIMP_NO_XCF_FX_CACHE");
+      if (env && *env && strcmp (env, "0"))
+        config.enabled = FALSE;
+
+      env = g_getenv ("CHOPGIMP_FX_CACHE_DEBUG");
+      config.debug = (env && *env && strcmp (env, "0"));
+
+      config.loaded_at = now;
+
+      g_free (path);
+      g_object_unref (file);
+      g_key_file_free (rc);
+    }
+
+  return &config;
+}
+
+#define fx_debug(...) G_STMT_START {          \
+    if (fx_cache_config ()->debug)            \
+      g_printerr ("chopgimp-fx-cache: " __VA_ARGS__); \
+  } G_STMT_END
+
+
+/*  build identity: the build-ids of the executable (GIMP's own operations
+ *  are linked in it) and of the loaded GEGL and babl libraries and
+ *  modules (which include the CPU-specific variants babl picked)
+ */
+
+#ifdef CHOPGIMP_FX_CACHE_HAVE_BUILD_ID
+
+static gboolean
+fx_cache_build_id_wanted (const gchar *name)
+{
+  if (! name || ! *name)
+    return TRUE; /* the executable */
+
+  return (strstr (name, "gegl") || strstr (name, "babl") ||
+          strstr (name, "libgimp"));
+}
+
+static int
+fx_cache_build_id_cb (struct dl_phdr_info *info,
+                      size_t               size,
+                      void                *data)
+{
+  GPtrArray *ids = data;
+  gint       i;
+
+  if (! fx_cache_build_id_wanted (info->dlpi_name))
+    return 0;
+
+  for (i = 0; i < info->dlpi_phnum; i++)
+    {
+      const ElfW(Phdr) *phdr = &info->dlpi_phdr[i];
+      const guint8     *note;
+      const guint8     *end;
+
+      if (phdr->p_type != PT_NOTE)
+        continue;
+
+      note = (const guint8 *) (info->dlpi_addr + phdr->p_vaddr);
+      end  = note + phdr->p_memsz;
+
+      while (note + sizeof (ElfW(Nhdr)) <= end)
+        {
+          const ElfW(Nhdr) *nhdr = (const ElfW(Nhdr) *) note;
+          const guint8     *name = note + sizeof (ElfW(Nhdr));
+          const guint8     *desc = name + ((nhdr->n_namesz + 3) & ~3u);
+          const guint8     *next = desc + ((nhdr->n_descsz + 3) & ~3u);
+
+          if (next > end || next <= note)
+            break;
+
+          if (nhdr->n_type == NT_GNU_BUILD_ID &&
+              nhdr->n_namesz == 4 && ! memcmp (name, "GNU", 4) &&
+              nhdr->n_descsz > 0)
+            {
+              GString *str = g_string_new (NULL);
+              guint    j;
+
+              g_string_append_printf (str, "%s=",
+                                      *info->dlpi_name ?
+                                      info->dlpi_name : "<exe>");
+
+              for (j = 0; j < nhdr->n_descsz; j++)
+                g_string_append_printf (str, "%02x", desc[j]);
+
+              g_ptr_array_add (ids, g_string_free (str, FALSE));
+            }
+
+          note = next;
+        }
+    }
+
+  return 0;
+}
+
+static gint
+fx_cache_strcmp (gconstpointer a,
+                 gconstpointer b)
+{
+  return strcmp (*(const gchar * const *) a, *(const gchar * const *) b);
+}
+
+#endif /* CHOPGIMP_FX_CACHE_HAVE_BUILD_ID */
+
+/*  NULL if the executable has no build-id: then the feature is off  */
+static const gchar *
+fx_cache_build_identity (void)
+{
+  static gsize  done     = 0;
+  static gchar *identity = NULL;
+
+  if (g_once_init_enter (&done))
+    {
+#ifdef CHOPGIMP_FX_CACHE_HAVE_BUILD_ID
+      GPtrArray *ids = g_ptr_array_new_with_free_func (g_free);
+      gboolean   exe = FALSE;
+      GString   *str;
+      gint       major, minor, micro;
+      guint      i;
+
+      dl_iterate_phdr (fx_cache_build_id_cb, ids);
+
+      g_ptr_array_sort (ids, fx_cache_strcmp);
+
+      str = g_string_new (GIMP_VERSION);
+
+      gegl_get_version (&major, &minor, &micro);
+      g_string_append_printf (str, ";gegl=%d.%d.%d", major, minor, micro);
+
+      babl_get_version (&major, &minor, &micro);
+      g_string_append_printf (str, ";babl=%d.%d.%d", major, minor, micro);
+
+      for (i = 0; i < ids->len; i++)
+        {
+          const gchar *id = g_ptr_array_index (ids, i);
+
+          if (g_str_has_prefix (id, "<exe>="))
+            exe = TRUE;
+
+          g_string_append_printf (str, ";%s", id);
+        }
+
+      if (exe)
+        identity = g_string_free (str, FALSE);
+      else
+        g_string_free (str, TRUE);
+
+      g_ptr_array_unref (ids);
+#endif
+
+      g_once_init_leave (&done, 1);
+    }
+
+  return identity;
+}
+
+
+/*  a fast 128-bit hash for pixel data (not cryptographic: the pixels of
+ *  the layer are the user's, a stored render is only trusted with them)
+ */
+
+#define FX_P1 G_GUINT64_CONSTANT (0x9E3779B185EBCA87)
+#define FX_P2 G_GUINT64_CONSTANT (0xC2B2AE3D27D4EB4F)
+#define FX_P3 G_GUINT64_CONSTANT (0x165667B19E3779F9)
+#define FX_P4 G_GUINT64_CONSTANT (0x85EBCA77C2B2AE63)
+
+typedef struct
+{
+  guint64 v[4];
+  guint64 total;
+} FxFastHash;
+
+static inline guint64
+fx_rotl (guint64 x,
+         gint    r)
+{
+  return (x << r) | (x >> (64 - r));
+}
+
+static inline guint64
+fx_round (guint64 acc,
+          guint64 input)
+{
+  acc += input * FX_P2;
+  acc  = fx_rotl (acc, 31);
+
+  return acc * FX_P1;
+}
+
+static inline guint64
+fx_avalanche (guint64 h)
+{
+  h ^= h >> 33;
+  h *= FX_P2;
+  h ^= h >> 29;
+  h *= FX_P3;
+  h ^= h >> 32;
+
+  return h;
+}
+
+static void
+fx_fast_hash_init (FxFastHash *h)
+{
+  h->v[0]  = FX_P1 + FX_P2;
+  h->v[1]  = FX_P2;
+  h->v[2]  = 0;
+  h->v[3]  = (guint64) 0 - FX_P1;
+  h->total = 0;
+}
+
+static void
+fx_fast_hash_update (FxFastHash   *h,
+                     const guint8 *p,
+                     gsize         len)
+{
+  guint64 v0 = h->v[0];
+  guint64 v1 = h->v[1];
+  guint64 v2 = h->v[2];
+  guint64 v3 = h->v[3];
+
+  h->total += len;
+
+  while (len >= 32)
+    {
+      guint64 w[4];
+
+      memcpy (w, p, 32);
+
+      v0 = fx_round (v0, w[0]);
+      v1 = fx_round (v1, w[1]);
+      v2 = fx_round (v2, w[2]);
+      v3 = fx_round (v3, w[3]);
+
+      p   += 32;
+      len -= 32;
+    }
+
+  while (len >= 8)
+    {
+      guint64 w;
+
+      memcpy (&w, p, 8);
+
+      v0 = fx_round (v0 ^ v3, w);
+      v3 = fx_rotl (v3, 27) + v0;
+
+      p   += 8;
+      len -= 8;
+    }
+
+  if (len > 0)
+    {
+      guint64 w = 0;
+
+      memcpy (&w, p, len);
+
+      v1 = fx_round (v1, w ^ ((guint64) len << 56));
+    }
+
+  h->v[0] = v0;
+  h->v[1] = v1;
+  h->v[2] = v2;
+  h->v[3] = v3;
+}
+
+static void
+fx_fast_hash_final (FxFastHash *h,
+                    guint64     out[2])
+{
+  guint64 a;
+  guint64 b;
+
+  a = fx_rotl (h->v[0], 1) + fx_rotl (h->v[1], 7) +
+      fx_rotl (h->v[2], 12) + fx_rotl (h->v[3], 18);
+  a ^= h->total * FX_P4;
+
+  b = (h->v[0] ^ fx_rotl (h->v[2], 29)) + h->v[1] * FX_P1;
+  b ^= h->v[3] * FX_P2;
+  b += h->total * FX_P3;
+
+  out[0] = fx_avalanche (a);
+  out[1] = fx_avalanche (b ^ out[0]);
+}
+
+
+/*  key  */
+
+typedef struct
+{
+  GChecksum   *sum;
+  GHashTable  *nodes;    /* GeglNode * -> index + 1                  */
+  GHashTable  *buffers;  /* GeglBuffer * -> 16-byte digest (g_malloc) */
+  gint         n_nodes;
+  gboolean     strict;
+  gchar       *failure;
+} FxKey;
+
+static void
+fx_key_fail (FxKey       *key,
+             const gchar *format,
+             ...) G_GNUC_PRINTF (2, 3);
+
+static void
+fx_key_fail (FxKey       *key,
+             const gchar *format,
+             ...)
+{
+  va_list args;
+
+  if (key->failure)
+    return;
+
+  va_start (args, format);
+  key->failure = g_strdup_vprintf (format, args);
+  va_end (args);
+}
+
+static void
+fx_key_bytes (FxKey         *key,
+              gconstpointer  data,
+              gsize          len)
+{
+  guint64 n = len;
+
+  g_checksum_update (key->sum, (const guchar *) &n, sizeof (n));
+
+  if (len > 0)
+    g_checksum_update (key->sum, data, len);
+}
+
+static void
+fx_key_int (FxKey  *key,
+            gint64  value)
+{
+  g_checksum_update (key->sum, (const guchar *) &value, sizeof (value));
+}
+
+static void
+fx_key_str (FxKey       *key,
+            const gchar *str)
+{
+  if (str)
+    {
+      fx_key_int (key, 1);
+      fx_key_bytes (key, str, strlen (str));
+    }
+  else
+    {
+      fx_key_int (key, 0);
+    }
+}
+
+static void
+fx_key_format (FxKey      *key,
+               const Babl *format)
+{
+  const Babl *space;
+  const char *icc;
+  int         icc_length = 0;
+
+  if (! format)
+    {
+      fx_key_str (key, NULL);
+      return;
+    }
+
+  fx_key_str (key, babl_format_get_encoding (format));
+
+  space = babl_format_get_space (format);
+  icc   = space ? babl_space_get_icc (space, &icc_length) : NULL;
+
+  if (icc && icc_length > 0)
+    fx_key_bytes (key, icc, icc_length);
+  else
+    fx_key_str (key, space ? babl_get_name (space) : NULL);
+}
+
+/*  the buffer's content, extent and format  */
+static void
+fx_key_buffer (FxKey      *key,
+               GeglBuffer *buffer)
+{
+  guint64 *digest;
+
+  digest = g_hash_table_lookup (key->buffers, buffer);
+
+  if (! digest)
+    {
+      const GeglRectangle *extent = gegl_buffer_get_extent (buffer);
+      const Babl          *format = gegl_buffer_get_format (buffer);
+      gint                 bpp    = babl_format_get_bytes_per_pixel (format);
+      FxFastHash           hash;
+      guint8              *data;
+      gint                 rows;
+      gint                 y;
+
+      fx_fast_hash_init (&hash);
+
+      digest = g_new0 (guint64, 2);
+
+      if (extent->width > 0 && extent->height > 0)
+        {
+          rows = MAX (1, FX_CACHE_STRIP_PIXELS / extent->width);
+          rows = MIN (rows, extent->height);
+          data = g_malloc ((gsize) extent->width * rows * bpp);
+
+          for (y = 0; y < extent->height; y += rows)
+            {
+              GeglRectangle strip = { extent->x, extent->y + y,
+                                      extent->width,
+                                      MIN (rows, extent->height - y) };
+
+              gegl_buffer_get (buffer, &strip, 1.0, format, data,
+                               GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+
+              fx_fast_hash_update (&hash, data,
+                                   (gsize) strip.width * strip.height * bpp);
+            }
+
+          g_free (data);
+        }
+
+      fx_fast_hash_final (&hash, digest);
+
+      g_hash_table_insert (key->buffers, buffer, digest);
+    }
+
+  fx_key_str (key, "buffer");
+  fx_key_format (key, gegl_buffer_get_format (buffer));
+  fx_key_bytes (key, gegl_buffer_get_extent (buffer), sizeof (GeglRectangle));
+  fx_key_bytes (key, digest, 2 * sizeof (guint64));
+}
+
+static void
+fx_key_double (FxKey   *key,
+               gdouble  value)
+{
+  if (key->strict)
+    {
+      fx_key_bytes (key, &value, sizeof (value));
+    }
+  else
+    {
+      /*  XCF stores filter arguments as floats  */
+      gfloat f = value;
+
+      fx_key_bytes (key, &f, sizeof (f));
+    }
+}
+
+static void
+fx_key_object (FxKey       *key,
+               const gchar *operation,
+               GParamSpec  *pspec,
+               GObject     *object)
+{
+  if (! object)
+    {
+      fx_key_str (key, NULL);
+    }
+  else if (GEGL_IS_BUFFER (object))
+    {
+      /*  the node's own cache, set as a property by gegl:cache  */
+      if (! g_strcmp0 (operation, "gegl:cache") &&
+          ! strcmp (pspec->name, "cache"))
+        fx_key_str (key, "skipped");
+      else
+        fx_key_buffer (key, GEGL_BUFFER (object));
+    }
+  else if (GEGL_IS_COLOR (object))
+    {
+      GeglColor  *color  = GEGL_COLOR (object);
+      const Babl *format = gegl_color_get_format (color);
+      GBytes     *bytes  = gegl_color_get_bytes (color, format);
+      gsize       size;
+      gconstpointer data = g_bytes_get_data (bytes, &size);
+
+      fx_key_str (key, "color");
+      fx_key_format (key, format);
+      fx_key_bytes (key, data, size);
+
+      g_bytes_unref (bytes);
+    }
+  else if (GEGL_IS_PATH (object))
+    {
+      gchar *str = gegl_path_to_string (GEGL_PATH (object));
+
+      fx_key_str (key, "path");
+      fx_key_str (key, str);
+
+      g_free (str);
+    }
+  else if (GEGL_IS_CURVE (object))
+    {
+      GeglCurve *curve = GEGL_CURVE (object);
+      gdouble    min_y, max_y;
+      gint       n = gegl_curve_num_points (curve);
+      gint       i;
+
+      gegl_curve_get_y_bounds (curve, &min_y, &max_y);
+
+      fx_key_str (key, "curve");
+      fx_key_double (key, min_y);
+      fx_key_double (key, max_y);
+      fx_key_int (key, n);
+
+      for (i = 0; i < n; i++)
+        {
+          gdouble x, y;
+
+          gegl_curve_get_point (curve, i, &x, &y);
+
+          fx_key_double (key, x);
+          fx_key_double (key, y);
+        }
+    }
+  else if (GIMP_IS_CONFIG (object))
+    {
+      gchar *str = gimp_config_serialize_to_string (GIMP_CONFIG (object),
+                                                    NULL);
+
+      fx_key_str (key, G_OBJECT_TYPE_NAME (object));
+      fx_key_str (key, str);
+
+      g_free (str);
+    }
+  else
+    {
+      fx_key_fail (key, "%s: property '%s' holds a %s",
+                   operation, pspec->name, G_OBJECT_TYPE_NAME (object));
+    }
+}
+
+static void
+fx_key_properties (FxKey       *key,
+                   GeglNode    *node,
+                   const gchar *operation)
+{
+  GParamSpec **pspecs;
+  guint        n_pspecs = 0;
+  guint        i;
+
+  pspecs = gegl_operation_list_properties (operation, &n_pspecs);
+
+  for (i = 0; i < n_pspecs && ! key->failure; i++)
+    {
+      GParamSpec *pspec = pspecs[i];
+      GValue      value = G_VALUE_INIT;
+      GType       type  = G_TYPE_FUNDAMENTAL (pspec->value_type);
+
+      if (! (pspec->flags & G_PARAM_READABLE))
+        continue;
+
+      g_value_init (&value, pspec->value_type);
+      gegl_node_get_property (node, pspec->name, &value);
+
+      fx_key_str (key, pspec->name);
+
+      if (pspec->value_type == G_TYPE_GTYPE)
+        {
+          fx_key_str (key, g_type_name (g_value_get_gtype (&value)));
+        }
+      else switch (type)
+        {
+        case G_TYPE_BOOLEAN:
+          fx_key_int (key, g_value_get_boolean (&value) ? 1 : 0);
+          break;
+
+        case G_TYPE_CHAR:
+          fx_key_int (key, g_value_get_schar (&value));
+          break;
+
+        case G_TYPE_UCHAR:
+          fx_key_int (key, g_value_get_uchar (&value));
+          break;
+
+        case G_TYPE_INT:
+          fx_key_int (key, g_value_get_int (&value));
+          break;
+
+        case G_TYPE_UINT:
+          fx_key_int (key, g_value_get_uint (&value));
+          break;
+
+        case G_TYPE_LONG:
+          fx_key_int (key, g_value_get_long (&value));
+          break;
+
+        case G_TYPE_ULONG:
+          fx_key_int (key, (gint64) g_value_get_ulong (&value));
+          break;
+
+        case G_TYPE_INT64:
+          fx_key_int (key, g_value_get_int64 (&value));
+          break;
+
+        case G_TYPE_UINT64:
+          fx_key_int (key, (gint64) g_value_get_uint64 (&value));
+          break;
+
+        case G_TYPE_ENUM:
+          fx_key_int (key, g_value_get_enum (&value));
+          break;
+
+        case G_TYPE_FLAGS:
+          fx_key_int (key, g_value_get_flags (&value));
+          break;
+
+        case G_TYPE_FLOAT:
+          {
+            gfloat f = g_value_get_float (&value);
+
+            fx_key_bytes (key, &f, sizeof (f));
+          }
+          break;
+
+        case G_TYPE_DOUBLE:
+          fx_key_double (key, g_value_get_double (&value));
+          break;
+
+        case G_TYPE_STRING:
+          fx_key_str (key, g_value_get_string (&value));
+          break;
+
+        case G_TYPE_POINTER:
+          if (GEGL_IS_PARAM_SPEC_FORMAT (pspec))
+            fx_key_format (key, g_value_get_pointer (&value));
+          else if (! g_value_get_pointer (&value))
+            fx_key_str (key, NULL);
+          else
+            fx_key_fail (key, "%s: pointer property '%s'",
+                         operation, pspec->name);
+          break;
+
+        case G_TYPE_OBJECT:
+          fx_key_object (key, operation, pspec, g_value_get_object (&value));
+          break;
+
+        case G_TYPE_BOXED:
+          if (! g_value_get_boxed (&value))
+            {
+              fx_key_str (key, NULL);
+            }
+          else if (pspec->value_type == GEGL_TYPE_MATRIX3)
+            {
+              GeglMatrix3 *matrix = g_value_get_boxed (&value);
+              gint         r, c;
+
+              for (r = 0; r < 3; r++)
+                for (c = 0; c < 3; c++)
+                  fx_key_double (key, matrix->coeff[r][c]);
+            }
+          else
+            {
+              fx_key_fail (key, "%s: property '%s' holds a %s",
+                           operation, pspec->name,
+                           g_type_name (pspec->value_type));
+            }
+          break;
+
+        default:
+          fx_key_fail (key, "%s: property '%s' of type %s",
+                       operation, pspec->name,
+                       g_type_name (pspec->value_type));
+          break;
+        }
+
+      g_value_unset (&value);
+    }
+
+  g_free (pspecs);
+}
+
+static gint
+fx_key_pad_cmp (gconstpointer a,
+                gconstpointer b)
+{
+  return strcmp (*(const gchar * const *) a, *(const gchar * const *) b);
+}
+
+/*  the node, its properties, and recursively the nodes feeding it  */
+static void
+fx_key_node (FxKey       *key,
+             GeglNode    *node,
+             const gchar *output_pad)
+{
+  const gchar *operation;
+  gpointer     index;
+
+  if (key->failure)
+    return;
+
+  if (! node)
+    {
+      fx_key_str (key, "none");
+      return;
+    }
+
+  index = g_hash_table_lookup (key->nodes, node);
+
+  if (index)
+    {
+      fx_key_str (key, "ref");
+      fx_key_int (key, GPOINTER_TO_INT (index));
+      fx_key_str (key, output_pad);
+      return;
+    }
+
+  if (++key->n_nodes > FX_CACHE_MAX_NODES)
+    {
+      fx_key_fail (key, "graph too large");
+      return;
+    }
+
+  g_hash_table_insert (key->nodes, node, GINT_TO_POINTER (key->n_nodes));
+
+  operation = gegl_node_get_operation (node);
+
+  fx_key_str (key, "node");
+  fx_key_str (key, output_pad);
+  fx_key_str (key, operation);
+
+  if (! operation)
+    {
+      /*  a plain graph (filter stack, applicator...): continue inside,
+       *  from its output proxy
+       */
+      if (gegl_node_is_graph (node))
+        fx_key_node (key,
+                     gegl_node_get_output_proxy (node,
+                                                 output_pad ? output_pad :
+                                                              "output"),
+                     "output");
+      else
+        fx_key_fail (key, "node without operation");
+
+      return;
+    }
+
+  fx_key_properties (key, node, operation);
+
+  if (! key->failure)
+    {
+      gchar **pads = gegl_node_list_input_pads (node);
+      guint   n    = pads ? g_strv_length (pads) : 0;
+      guint   i;
+
+      if (n > 1)
+        qsort (pads, n, sizeof (gchar *), fx_key_pad_cmp);
+
+      for (i = 0; i < n && ! key->failure; i++)
+        {
+          GeglNode *producer;
+          gchar    *producer_pad = NULL;
+
+          producer = gegl_node_get_producer (node, pads[i], &producer_pad);
+
+          fx_key_str (key, "pad");
+          fx_key_str (key, pads[i]);
+          fx_key_node (key, producer, producer_pad);
+
+          g_free (producer_pad);
+        }
+
+      g_strfreev (pads);
+    }
+}
+
+/*  the key of the content of the layer's filters cache  */
+static gboolean
+fx_cache_compute_key (GimpLayer           *layer,
+                      GeglNode            *cache_node,
+                      const Babl          *cache_format,
+                      const GeglRectangle *bounds,
+                      guint8               out[FX_CACHE_KEY_SIZE],
+                      gchar              **failure)
+{
+  GimpImage    *image    = gimp_item_get_image (GIMP_ITEM (layer));
+  const gchar  *identity = fx_cache_build_identity ();
+  FxKey         key      = { 0, };
+  const guint8 *icc;
+  gsize         icc_length = 0;
+  gsize         length     = FX_CACHE_KEY_SIZE;
+  gchar        *producer_pad = NULL;
+  GeglNode     *producer;
+
+  if (! identity)
+    {
+      *failure = g_strdup ("no build identity");
+      return FALSE;
+    }
+
+  key.sum     = g_checksum_new (G_CHECKSUM_SHA256);
+  key.nodes   = g_hash_table_new (NULL, NULL);
+  key.buffers = g_hash_table_new_full (NULL, NULL, NULL, g_free);
+  key.strict  = fx_cache_config ()->strict;
+
+  fx_key_str (&key, "ChopGimp fx-cache 1");
+  fx_key_int (&key, key.strict);
+  fx_key_str (&key, identity);
+
+  fx_key_int (&key, gimp_image_get_base_type (image));
+  fx_key_int (&key, gimp_image_get_precision (image));
+
+  icc = gimp_color_managed_get_icc_profile (GIMP_COLOR_MANAGED (image),
+                                            &icc_length);
+  fx_key_bytes (&key, icc, icc ? icc_length : 0);
+
+  fx_key_format (&key, cache_format);
+  fx_key_bytes (&key, bounds, sizeof (GeglRectangle));
+
+  producer = gegl_node_get_producer (cache_node, "input", &producer_pad);
+  fx_key_node (&key, producer, producer_pad);
+  g_free (producer_pad);
+
+  if (! key.failure)
+    g_checksum_get_digest (key.sum, out, &length);
+
+  g_checksum_free (key.sum);
+  g_hash_table_unref (key.nodes);
+  g_hash_table_unref (key.buffers);
+
+  if (key.failure)
+    {
+      *failure = key.failure;
+      return FALSE;
+    }
+
+  return length == FX_CACHE_KEY_SIZE;
+}
+
+
+/*  eligible layers: plain (not group) layers whose filters cache is in
+ *  use, without floating selection, not being painted, effects shown
+ */
+static GeglNode *
+fx_cache_layer_node (GimpLayer *layer)
+{
+  GimpDrawable        *drawable = GIMP_DRAWABLE (layer);
+  GimpDrawablePrivate *private  = drawable->private;
+
+  if (gimp_viewable_get_children (GIMP_VIEWABLE (layer)) ||
+      gimp_layer_is_floating_sel (layer)                 ||
+      private->floating_selection                        ||
+      private->paint_count > 0                           ||
+      private->filters_bypass                            ||
+      ! private->filters_cache_enabled                   ||
+      ! private->filters_cache_node)
+    return NULL;
+
+  return private->filters_cache_node;
+}
+
+static gboolean
+fx_cache_is_node_cache (GeglBuffer *cache)
+{
+  return cache && G_TYPE_CHECK_INSTANCE_TYPE (cache, gegl_cache_get_type ());
+}
+
+static gint
+fx_cache_shuffle_unit (const Babl *format)
+{
+  gint bpp = babl_format_get_bytes_per_pixel (format);
+  gint n   = babl_format_get_n_components (format);
+
+  if (n > 0 && bpp % n == 0)
+    return bpp / n;
+
+  return 1;
+}
+
+/*  byte planes: compresses float and 16-bit data much better  */
+static void
+fx_cache_shuffle (const guint8 *src,
+                  guint8       *dest,
+                  gsize         len,
+                  gint          unit)
+{
+  gsize n = len / unit;
+  gsize i;
+  gint  j;
+
+  for (j = 0; j < unit; j++)
+    for (i = 0; i < n; i++)
+      dest[j * n + i] = src[i * unit + j];
+}
+
+static void
+fx_cache_unshuffle (const guint8 *src,
+                    guint8       *dest,
+                    gsize         len,
+                    gint          unit)
+{
+  gsize n = len / unit;
+  gsize i;
+  gint  j;
+
+  for (j = 0; j < unit; j++)
+    for (i = 0; i < n; i++)
+      dest[i * unit + j] = src[j * n + i];
+}
+
+
+/*  payload writer / reader (big-endian)  */
+
+static void
+fx_put_u32 (GByteArray *array,
+            guint32     value)
+{
+  guint32 be = GUINT32_TO_BE (value);
+
+  g_byte_array_append (array, (const guint8 *) &be, 4);
+}
+
+static void
+fx_put_rect (GByteArray          *array,
+             const GeglRectangle *rect)
+{
+  fx_put_u32 (array, (guint32) rect->x);
+  fx_put_u32 (array, (guint32) rect->y);
+  fx_put_u32 (array, (guint32) rect->width);
+  fx_put_u32 (array, (guint32) rect->height);
+}
+
+typedef struct
+{
+  const guint8 *p;
+  gsize         left;
+  gboolean      ok;
+} FxReader;
+
+static guint32
+fx_get_u32 (FxReader *r)
+{
+  guint32 be;
+
+  if (! r->ok || r->left < 4)
+    {
+      r->ok = FALSE;
+      return 0;
+    }
+
+  memcpy (&be, r->p, 4);
+  r->p    += 4;
+  r->left -= 4;
+
+  return GUINT32_FROM_BE (be);
+}
+
+static const guint8 *
+fx_get_bytes (FxReader *r,
+              gsize     len)
+{
+  const guint8 *p = r->p;
+
+  if (! r->ok || r->left < len)
+    {
+      r->ok = FALSE;
+      return NULL;
+    }
+
+  r->p    += len;
+  r->left -= len;
+
+  return p;
+}
+
+static void
+fx_get_rect (FxReader      *r,
+             GeglRectangle *rect)
+{
+  rect->x      = (gint32) fx_get_u32 (r);
+  rect->y      = (gint32) fx_get_u32 (r);
+  rect->width  = (gint32) fx_get_u32 (r);
+  rect->height = (gint32) fx_get_u32 (r);
+}
+
+
+/*  public API  */
+
+gboolean
+chopgimp_fx_cache_is_enabled (void)
+{
+  return fx_cache_config ()->enabled && fx_cache_build_identity () != NULL;
+}
+
+/*  Payload:
+ *    "CGFX", u32 version, key[32],
+ *    u32 length + format encoding, u32 bytes per pixel, u32 shuffle unit,
+ *    rect bounds (the cache node's bounding box),
+ *    u32 n_rects, n_rects * rect,
+ *    u32 uncompressed size (high), u32 (low), u32 compressed size,
+ *    zlib stream of the rects' pixels, row by row, in strips whose bytes
+ *    are shuffled by the shuffle unit.
+ */
+GBytes *
+chopgimp_fx_cache_save_layer (GimpLayer *layer,
+                              gint64    *save_time_us)
+{
+  const FxCacheConfig *config = fx_cache_config ();
+  const gchar         *name;
+  GeglNode            *cache_node;
+  GeglBuffer          *cache;
+  const Babl          *format;
+  GeglRectangle        bounds;
+  GeglRectangle       *valid   = NULL;
+  gint                 n_valid = 0;
+  GArray              *rects;
+  guint8               key[FX_CACHE_KEY_SIZE];
+  gchar               *failure = NULL;
+  GByteArray          *payload;
+  const gchar         *encoding;
+  gint64               start;
+  gint64               area = 0;
+  gint64               raw_size;
+  gint                 bpp;
+  gint                 unit;
+  z_stream             zs;
+  guint8              *strip   = NULL;
+  guint8              *shuffled = NULL;
+  gsize                header_size;
+  gboolean             success = FALSE;
+  gint                 i;
+
+  g_return_val_if_fail (GIMP_IS_LAYER (layer), NULL);
+  g_return_val_if_fail (save_time_us != NULL, NULL);
+
+  if (! chopgimp_fx_cache_is_enabled ())
+    return NULL;
+
+  cache_node = fx_cache_layer_node (layer);
+
+  if (! cache_node)
+    return NULL;
+
+  name = gimp_object_get_name (layer);
+
+  if (*save_time_us >= config->budget_us)
+    {
+      fx_debug ("save '%s': time budget used up\n", name);
+      return NULL;
+    }
+
+  start = g_get_monotonic_time ();
+
+  bounds = gegl_node_get_bounding_box (cache_node);
+  cache  = gegl_node_get_cache (cache_node);
+
+  if (! fx_cache_is_node_cache (cache) || gegl_rectangle_is_empty (&bounds))
+    return NULL;
+
+  format = gegl_buffer_get_format (cache);
+  bpp    = babl_format_get_bytes_per_pixel (format);
+  unit   = fx_cache_shuffle_unit (format);
+
+  gegl_buffer_list_valid_rectangles (cache, &valid, &n_valid);
+
+  rects = g_array_new (FALSE, FALSE, sizeof (GeglRectangle));
+
+  for (i = 0; i < n_valid; i++)
+    {
+      GeglRectangle rect;
+
+      if (gegl_rectangle_intersect (&rect, &valid[i], &bounds))
+        {
+          g_array_append_val (rects, rect);
+          area += (gint64) rect.width * rect.height;
+        }
+    }
+
+  g_free (valid);
+
+  raw_size = area * bpp;
+
+  if (rects->len == 0 || rects->len > FX_CACHE_MAX_RECTS ||
+      area < MAX (config->min_pixels, 1) || raw_size > config->max_bytes)
+    {
+      fx_debug ("save '%s': not stored (%u valid rects, %" G_GINT64_FORMAT
+                " px of %" G_GINT64_FORMAT ", %" G_GINT64_FORMAT " bytes)\n",
+                name, rects->len, area,
+                (gint64) bounds.width * bounds.height, raw_size);
+      g_array_free (rects, TRUE);
+      return NULL;
+    }
+
+  if (! fx_cache_compute_key (layer, cache_node, format, &bounds,
+                              key, &failure))
+    {
+      fx_debug ("save '%s': no key: %s\n", name, failure);
+      g_free (failure);
+      g_array_free (rects, TRUE);
+      *save_time_us += g_get_monotonic_time () - start;
+      return NULL;
+    }
+
+  encoding = babl_format_get_encoding (format);
+
+  payload = g_byte_array_new ();
+  g_byte_array_append (payload, (const guint8 *) FX_CACHE_MAGIC, 4);
+  fx_put_u32 (payload, FX_CACHE_VERSION);
+  g_byte_array_append (payload, key, FX_CACHE_KEY_SIZE);
+  fx_put_u32 (payload, strlen (encoding));
+  g_byte_array_append (payload, (const guint8 *) encoding, strlen (encoding));
+  fx_put_u32 (payload, bpp);
+  fx_put_u32 (payload, unit);
+  fx_put_rect (payload, &bounds);
+  fx_put_u32 (payload, rects->len);
+
+  for (i = 0; i < (gint) rects->len; i++)
+    fx_put_rect (payload, &g_array_index (rects, GeglRectangle, i));
+
+  fx_put_u32 (payload, (guint32) ((guint64) raw_size >> 32));
+  fx_put_u32 (payload, (guint32) ((guint64) raw_size & 0xffffffff));
+  fx_put_u32 (payload, 0); /* compressed size, set below */
+
+  header_size = payload->len;
+
+  memset (&zs, 0, sizeof (zs));
+
+  if (deflateInit (&zs, config->zlib_level) != Z_OK)
+    goto out;
+
+  for (i = 0; i < (gint) rects->len; i++)
+    {
+      const GeglRectangle *rect = &g_array_index (rects, GeglRectangle, i);
+      gint                 rows = MAX (1, FX_CACHE_STRIP_PIXELS / rect->width);
+      gint                 y;
+
+      rows = MIN (rows, rect->height);
+
+      strip    = g_realloc (strip,    (gsize) rect->width * rows * bpp);
+      shuffled = g_realloc (shuffled, (gsize) rect->width * rows * bpp);
+
+      for (y = 0; y < rect->height; y += rows)
+        {
+          GeglRectangle part = { rect->x, rect->y + y, rect->width,
+                                 MIN (rows, rect->height - y) };
+          gsize         len  = (gsize) part.width * part.height * bpp;
+          gint          ret;
+
+          if (*save_time_us + g_get_monotonic_time () - start >
+              config->budget_us)
+            {
+              fx_debug ("save '%s': time budget exceeded\n", name);
+              deflateEnd (&zs);
+              goto out;
+            }
+
+          gegl_buffer_get (cache, &part, 1.0, format, strip,
+                           GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+
+          fx_cache_shuffle (strip, shuffled, len, unit);
+
+          zs.next_in  = shuffled;
+          zs.avail_in = len;
+
+          do
+            {
+              if (payload->len - header_size >= CHOPGIMP_FX_CACHE_MAX_PAYLOAD)
+                {
+                  deflateEnd (&zs);
+                  goto out;
+                }
+
+              {
+                guint old = payload->len;
+
+                g_byte_array_set_size (payload, old + 256 * 1024);
+
+                zs.next_out  = payload->data + old;
+                zs.avail_out = 256 * 1024;
+
+                ret = deflate (&zs, Z_NO_FLUSH);
+
+                g_byte_array_set_size (payload,
+                                       old + 256 * 1024 - zs.avail_out);
+              }
+
+              if (ret == Z_STREAM_ERROR)
+                {
+                  deflateEnd (&zs);
+                  goto out;
+                }
+            }
+          while (zs.avail_in > 0 || zs.avail_out == 0);
+        }
+    }
+
+  for (;;)
+    {
+      guint old = payload->len;
+      gint  ret;
+
+      g_byte_array_set_size (payload, old + 256 * 1024);
+
+      zs.next_out  = payload->data + old;
+      zs.avail_out = 256 * 1024;
+
+      ret = deflate (&zs, Z_FINISH);
+
+      g_byte_array_set_size (payload, old + 256 * 1024 - zs.avail_out);
+
+      if (ret == Z_STREAM_END)
+        break;
+
+      if (ret != Z_OK && ret != Z_BUF_ERROR)
+        {
+          deflateEnd (&zs);
+          goto out;
+        }
+    }
+
+  deflateEnd (&zs);
+
+  if (payload->len > CHOPGIMP_FX_CACHE_MAX_PAYLOAD)
+    goto out;
+
+  {
+    guint32 be = GUINT32_TO_BE ((guint32) (payload->len - header_size));
+
+    memcpy (payload->data + header_size - 4, &be, 4);
+  }
+
+  success = TRUE;
+
+ out:
+  g_free (strip);
+  g_free (shuffled);
+  g_array_free (rects, TRUE);
+
+  *save_time_us += g_get_monotonic_time () - start;
+
+  if (! success)
+    {
+      g_byte_array_unref (payload);
+      return NULL;
+    }
+
+  fx_debug ("save '%s': stored %" G_GINT64_FORMAT " px (%s), %"
+            G_GINT64_FORMAT " -> %u bytes in %.1f ms\n",
+            name, area, encoding, raw_size, payload->len,
+            (g_get_monotonic_time () - start) / 1000.0);
+
+  return g_byte_array_free_to_bytes (payload);
+}
+
+void
+chopgimp_fx_cache_attach (GimpLayer *layer,
+                          GBytes    *payload)
+{
+  g_return_if_fail (GIMP_IS_LAYER (layer));
+
+  g_object_set_data_full (G_OBJECT (layer), CHOPGIMP_FX_CACHE_DATA_KEY,
+                          payload ? g_bytes_ref (payload) : NULL,
+                          (GDestroyNotify) g_bytes_unref);
+}
+
+static void
+fx_cache_debug_invalidated (GeglNode            *node,
+                            const GeglRectangle *rect,
+                            GimpLayer           *layer)
+{
+  g_printerr ("chopgimp-fx-cache: '%s': seeded cache invalidated "
+              "(%d,%d %dx%d)\n",
+              gimp_object_get_name (layer),
+              rect ? rect->x : 0, rect ? rect->y : 0,
+              rect ? rect->width : 0, rect ? rect->height : 0);
+
+  g_signal_handlers_disconnect_by_func (node, fx_cache_debug_invalidated,
+                                        layer);
+}
+
+static gboolean
+fx_cache_seed (GimpLayer *layer,
+               GBytes    *bytes,
+               gchar    **failure)
+{
+  const guint8  *data;
+  gsize          size;
+  FxReader       r;
+  const guint8  *stored_key;
+  const guint8  *encoding;
+  guint32        encoding_len;
+  guint32        bpp;
+  guint32        unit;
+  GeglRectangle  stored_bounds;
+  GeglRectangle  bounds;
+  guint32        n_rects;
+  GeglRectangle *rects     = NULL;
+  guint64        raw_size;
+  guint64        total     = 0;
+  guint32        zsize;
+  const guint8  *zdata;
+  GeglNode      *cache_node;
+  GeglBuffer    *cache;
+  const Babl    *format;
+  guint8         key[FX_CACHE_KEY_SIZE];
+  z_stream       zs;
+  guint8        *strip     = NULL;
+  guint8        *shuffled  = NULL;
+  gboolean       success   = FALSE;
+  guint32        i;
+
+  data = g_bytes_get_data (bytes, &size);
+
+  r.p    = data;
+  r.left = size;
+  r.ok   = TRUE;
+
+  if (size < 4 || memcmp (fx_get_bytes (&r, 4), FX_CACHE_MAGIC, 4) ||
+      fx_get_u32 (&r) != FX_CACHE_VERSION)
+    {
+      *failure = g_strdup ("unknown payload");
+      return FALSE;
+    }
+
+  stored_key   = fx_get_bytes (&r, FX_CACHE_KEY_SIZE);
+  encoding_len = fx_get_u32 (&r);
+
+  if (encoding_len == 0 || encoding_len > 256)
+    r.ok = FALSE;
+
+  encoding = fx_get_bytes (&r, encoding_len);
+  bpp      = fx_get_u32 (&r);
+  unit     = fx_get_u32 (&r);
+  fx_get_rect (&r, &stored_bounds);
+  n_rects  = fx_get_u32 (&r);
+
+  if (! r.ok || bpp == 0 || bpp > 64 || unit == 0 || bpp % unit != 0 ||
+      n_rects == 0 || n_rects > FX_CACHE_MAX_RECTS ||
+      stored_bounds.width <= 0 || stored_bounds.height <= 0)
+    {
+      *failure = g_strdup ("corrupt header");
+      return FALSE;
+    }
+
+  rects = g_new (GeglRectangle, n_rects);
+
+  for (i = 0; i < n_rects; i++)
+    {
+      fx_get_rect (&r, &rects[i]);
+
+      if (rects[i].width <= 0 || rects[i].height <= 0 ||
+          ! gegl_rectangle_contains (&stored_bounds, &rects[i]))
+        r.ok = FALSE;
+      else
+        total += (guint64) rects[i].width * rects[i].height * bpp;
+    }
+
+  raw_size  = (guint64) fx_get_u32 (&r) << 32;
+  raw_size |= fx_get_u32 (&r);
+  zsize     = fx_get_u32 (&r);
+  zdata     = fx_get_bytes (&r, zsize);
+
+  if (! r.ok || raw_size != total || zsize == 0)
+    {
+      *failure = g_strdup ("corrupt data");
+      goto out;
+    }
+
+  /*  the layer as loaded, with its filters  */
+
+  gimp_drawable_get_source_node (GIMP_DRAWABLE (layer));
+  gimp_drawable_filters_cache_update (GIMP_DRAWABLE (layer));
+
+  cache_node = fx_cache_layer_node (layer);
+
+  if (! cache_node)
+    {
+      *failure = g_strdup ("layer not eligible (no active filters?)");
+      goto out;
+    }
+
+  bounds = gegl_node_get_bounding_box (cache_node);
+
+  if (! gegl_rectangle_equal (&bounds, &stored_bounds))
+    {
+      *failure = g_strdup_printf ("bounding box %d,%d %dx%d, stored %d,%d %dx%d",
+                                  bounds.x, bounds.y,
+                                  bounds.width, bounds.height,
+                                  stored_bounds.x, stored_bounds.y,
+                                  stored_bounds.width, stored_bounds.height);
+      goto out;
+    }
+
+  cache = gegl_node_get_cache (cache_node);
+
+  if (! fx_cache_is_node_cache (cache))
+    {
+      *failure = g_strdup ("no node cache");
+      goto out;
+    }
+
+  format = gegl_buffer_get_format (cache);
+
+  if (strlen (babl_format_get_encoding (format)) != encoding_len ||
+      memcmp (babl_format_get_encoding (format), encoding, encoding_len) ||
+      babl_format_get_bytes_per_pixel (format) != (gint) bpp ||
+      fx_cache_shuffle_unit (format) != (gint) unit)
+    {
+      *failure = g_strdup_printf ("format %s differs",
+                                  babl_format_get_encoding (format));
+      goto out;
+    }
+
+  if (! fx_cache_compute_key (layer, cache_node, format, &bounds, key,
+                              failure))
+    goto out;
+
+  if (memcmp (key, stored_key, FX_CACHE_KEY_SIZE))
+    {
+      *failure = g_strdup ("key mismatch (layer, filters or build changed)");
+      goto out;
+    }
+
+  /*  decompress into the cache, then mark the regions as computed  */
+
+  memset (&zs, 0, sizeof (zs));
+
+  if (inflateInit (&zs) != Z_OK)
+    {
+      *failure = g_strdup ("zlib");
+      goto out;
+    }
+
+  zs.next_in  = (Bytef *) zdata;
+  zs.avail_in = zsize;
+
+  for (i = 0; i < n_rects; i++)
+    {
+      const GeglRectangle *rect = &rects[i];
+      gint                 rows = MAX (1, FX_CACHE_STRIP_PIXELS / rect->width);
+      gint                 y;
+
+      rows = MIN (rows, rect->height);
+
+      strip    = g_realloc (strip,    (gsize) rect->width * rows * bpp);
+      shuffled = g_realloc (shuffled, (gsize) rect->width * rows * bpp);
+
+      for (y = 0; y < rect->height; y += rows)
+        {
+          GeglRectangle part = { rect->x, rect->y + y, rect->width,
+                                 MIN (rows, rect->height - y) };
+          gsize         len  = (gsize) part.width * part.height * bpp;
+          gint          ret;
+
+          zs.next_out  = shuffled;
+          zs.avail_out = len;
+
+          do
+            {
+              ret = inflate (&zs, Z_NO_FLUSH);
+            }
+          while (ret == Z_OK && zs.avail_out > 0 && zs.avail_in > 0);
+
+          if (zs.avail_out > 0 || (ret != Z_OK && ret != Z_STREAM_END))
+            {
+              inflateEnd (&zs);
+              *failure = g_strdup ("truncated or corrupt pixel data");
+              goto out;
+            }
+
+          fx_cache_unshuffle (shuffled, strip, len, unit);
+
+          gegl_buffer_set (cache, &part, 0, format, strip,
+                           GEGL_AUTO_ROWSTRIDE);
+        }
+    }
+
+  inflateEnd (&zs);
+
+  for (i = 0; i < n_rects; i++)
+    gegl_cache_computed (cache, &rects[i], 0);
+
+  if (fx_cache_config ()->debug)
+    g_signal_connect_object (cache_node, "invalidated",
+                             G_CALLBACK (fx_cache_debug_invalidated),
+                             layer, 0);
+
+  success = TRUE;
+
+ out:
+  g_free (rects);
+  g_free (strip);
+  g_free (shuffled);
+
+  return success;
+}
+
+void
+chopgimp_fx_cache_load_image (GimpImage *image)
+{
+  GList *layers;
+  GList *list;
+
+  g_return_if_fail (GIMP_IS_IMAGE (image));
+
+  layers = gimp_image_get_layer_list (image);
+
+  for (list = layers; list; list = g_list_next (list))
+    {
+      GimpLayer *layer   = list->data;
+      GBytes    *payload = g_object_get_data (G_OBJECT (layer),
+                                              CHOPGIMP_FX_CACHE_DATA_KEY);
+
+      if (payload)
+        {
+          gchar  *failure = NULL;
+          gint64  start   = g_get_monotonic_time ();
+
+          if (chopgimp_fx_cache_is_enabled () &&
+              fx_cache_seed (layer, payload, &failure))
+            {
+              fx_debug ("load '%s': effects seeded in %.1f ms\n",
+                        gimp_object_get_name (layer),
+                        (g_get_monotonic_time () - start) / 1000.0);
+            }
+          else
+            {
+              fx_debug ("load '%s': stored effects ignored: %s\n",
+                        gimp_object_get_name (layer),
+                        failure ? failure : "disabled");
+            }
+
+          g_free (failure);
+
+          g_object_set_data (G_OBJECT (layer), CHOPGIMP_FX_CACHE_DATA_KEY,
+                             NULL);
+        }
+    }
+
+  g_list_free (layers);
+}
