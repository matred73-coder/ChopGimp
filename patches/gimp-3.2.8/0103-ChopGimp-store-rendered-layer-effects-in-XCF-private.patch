+/*  ChopGimp: the rendered output of the layer's filters, kept until the
+ *  layer is complete (see xcf_load_layer()) and seeded into the layer's
+ *  filters cache once the image is (chopgimp_fx_cache_load_image())
+ */
+static gboolean
+xcf_load_chopgimp_fx_cache (XcfInfo *info,
+                            guint32  size)
+{
+  g_clear_pointer (&info->chopgimp_fx_cache, g_bytes_unref);
+
+  if (size > 0                                 &&
+      size <= CHOPGIMP_FX_CACHE_MAX_PAYLOAD    &&
+      chopgimp_fx_cache_is_enabled ())
+    {
+      guint8 *data = g_try_malloc (size);
+
+      if (data)
+        {
+          if (xcf_read_int8 (info, data, size) != size)
+            {
+              g_free (data);
+              return FALSE;
+            }
+
+          info->chopgimp_fx_cache = g_bytes_new_take (data, size);
+
+          return TRUE;
+        }
+    }
+
+  return xcf_seek_pos (info, info->cp + size, NULL);
+}
