 app/core/chopgimp-fx-cache.h |   29 +
 app/core/meson.build         |    2 +
 app/xcf/xcf-load.c           |   62 ++
 app/xcf/xcf-private.h        |   12 +
 app/xcf/xcf-save.c           |   57 ++
