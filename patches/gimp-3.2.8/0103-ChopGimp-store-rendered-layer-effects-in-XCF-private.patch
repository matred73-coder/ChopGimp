+/*  ChopGimp: the already rendered output of the layer's filters, when its
+ *  cache is valid (nothing is rendered here), see core/chopgimp-fx-cache.c
+ */
+static gboolean
+xcf_save_chopgimp_fx_cache (XcfInfo    *info,
+                            GimpLayer  *layer,
+                            GError    **error)
+{
+  GBytes       *payload;
+  const guint8 *data;
+  gsize         size;
+  guint32       values[2];
+  GError       *tmp_error = NULL;
+
+  payload = chopgimp_fx_cache_save_layer (layer, &info->chopgimp_fx_cache_us);
+
+  if (! payload)
+    return TRUE;
+
+  data = g_bytes_get_data (payload, &size);
+
+  if (size == 0 || size > CHOPGIMP_FX_CACHE_MAX_PAYLOAD)
+    {
+      g_bytes_unref (payload);
+      return TRUE;
+    }
+
+  values[0] = PROP_CHOPGIMP_FX_CACHE;
+  values[1] = size;
+
+  xcf_write_int32 (info, values, 2, &tmp_error);
+
+  if (! tmp_error)
+    xcf_write_int8 (info, data, size, &tmp_error);
+
+  g_bytes_unref (payload);
+
+  if (tmp_error)
+    {
+      g_propagate_error (error, tmp_error);
+      return FALSE;
+    }
+
+  return TRUE;
+}
