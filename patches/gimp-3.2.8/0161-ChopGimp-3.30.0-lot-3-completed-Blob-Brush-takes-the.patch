+static ChopGimpVObject *
+selected_repeat (GimpVectorLayer *layer)
+{
+  const guint     *ids;
+  gint             n = 0;
+  ChopGimpVObject *o;
+
+  if (! layer || ! chopgimp_vrepeat_enabled () || ! chopgimp_vlayer_get_root (layer))
+    return NULL;
+
+  ids = chopgimp_vlayer_get_selection (layer, &n);
+
+  if (n != 1 || ! (o = chopgimp_vlayer_get_object (layer, ids[0])) ||
+      ! is_repeat_group (o) || chopgimp_vobject_is_locked (o))
+    return NULL;
+
+  return o;
+}
+
+static ChopGimpVObject *
+source_of (ChopGimpVObject *g)
+{
+  for (guint i = 0; i < g->children->len; i++)
+    if (! is_instance (g_ptr_array_index (g->children, i)))
+      return g_ptr_array_index (g->children, i);
+
+  return NULL;
+}
+
+static void
+add_handle (ChopGimpRepeatWidgets *w,
+            const GimpMatrix3     *m,
+            gint                   handle,
+            gdouble                x,
+            gdouble                y)
+{
+  if (w->n >= 4)
+    return;
+
+  w->handle[w->n] = handle;
+  gimp_matrix3_transform_point (m, x, y, &w->x[w->n], &w->y[w->n]);
+  w->n++;
+}
+
+gboolean
+chopgimp_vrepeat_get_widgets (GimpVectorLayer       *layer,
+                              ChopGimpRepeatWidgets *w)
+{
+  ChopGimpVObject      *g = selected_repeat (layer);
+  ChopGimpVObject      *src;
+  ChopGimpRepeatOptions o;
+  GimpMatrix3           m;
+  gdouble               b[4], cx, cy, wd, ht;
+
+  memset (w, 0, sizeof (*w));
+
+  if (! g || ! (src = source_of (g)) || ! source_box (layer, src, g, b))
+    return FALSE;
+
+  spec_get (g->blend, &o);
+  chopgimp_vobject_get_world_matrix (g, &m);
+
+  cx = (b[0] + b[2]) / 2.0;
+  cy = (b[1] + b[3]) / 2.0;
+  wd = b[2] - b[0];
+  ht = b[3] - b[1];
+
+  switch (o.type)
+    {
+    case CHOPGIMP_REPEAT_RADIAL:
+      {
+        gdouble ar = o.angle * G_PI / 180.0;
+        gdouble ox = cx - o.radius * cos (ar);
+        gdouble oy = cy - o.radius * sin (ar);
+        gdouble a2 = ar + 2.0 * G_PI / o.count;
+        gdouble sx, sy;
+
+        add_handle (w, &m, CHOPGIMP_REPEAT_HANDLE_CENTER, ox, oy);
+        add_handle (w, &m, CHOPGIMP_REPEAT_HANDLE_RADIUS,
+                    ox - o.radius * cos (ar), oy - o.radius * sin (ar));
+        add_handle (w, &m, CHOPGIMP_REPEAT_HANDLE_COUNT,
+                    ox + o.radius * cos (a2), oy + o.radius * sin (a2));
+
+        w->circle = TRUE;
+        gimp_matrix3_transform_point (&m, ox, oy, &w->cx, &w->cy);
+        gimp_matrix3_transform_point (&m, ox + o.radius, oy, &sx, &sy);
+        w->r = hypot (sx - w->cx, sy - w->cy);
+      }
+      break;
+
+    case CHOPGIMP_REPEAT_GRID:
+      add_handle (w, &m, CHOPGIMP_REPEAT_HANDLE_HGAP, b[2] + o.hgap, cy);
+      add_handle (w, &m, CHOPGIMP_REPEAT_HANDLE_VGAP, cx, b[3] + o.vgap);
+      add_handle (w, &m, CHOPGIMP_REPEAT_HANDLE_SIZE,
+                  b[0] + o.cols * (wd + o.hgap) - o.hgap,
+                  b[1] + o.rows * (ht + o.vgap) - o.vgap);
+      break;
+
+    case CHOPGIMP_REPEAT_MIRROR:
+      {
+        gdouble ar = o.angle * G_PI / 180.0;
+        gdouble ax = cx + o.offset * cos (ar - G_PI / 2.0);
+        gdouble ay = cy + o.offset * sin (ar - G_PI / 2.0);
+        gdouble l  = MAX (wd, ht) / 2.0 + 20.0;
+
+        add_handle (w, &m, CHOPGIMP_REPEAT_HANDLE_AXIS, ax, ay);
+        add_handle (w, &m, CHOPGIMP_REPEAT_HANDLE_AXIS_END,
+                    ax + l * cos (ar), ay + l * sin (ar));
+
+        w->line = TRUE;
+        gimp_matrix3_transform_point (&m, ax - l * cos (ar), ay - l * sin (ar), &w->x1, &w->y1);
+        gimp_matrix3_transform_point (&m, ax + l * cos (ar), ay + l * sin (ar), &w->x2, &w->y2);
+      }
+      break;
+    }
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vrepeat_drag_handle (GimpVectorLayer *layer,
+                              gint             handle,
+                              gdouble          x,
+                              gdouble          y)
+{
+  ChopGimpVObject      *g = selected_repeat (layer);
+  ChopGimpVObject      *src;
+  ChopGimpRepeatOptions o;
+  GimpMatrix3           m, inv;
+  gdouble               b[4], cx, cy, px, py, wd, ht;
+  gdouble               move_x = 0.0, move_y = 0.0;
+
+  if (! g || ! (src = source_of (g)) || ! source_box (layer, src, g, b))
+    return FALSE;
+
+  spec_get (g->blend, &o);
+  chopgimp_vobject_get_world_matrix (g, &m);
+  inv = m;
+  gimp_matrix3_invert (&inv);
+  gimp_matrix3_transform_point (&inv, x, y, &px, &py);
+
+  cx = (b[0] + b[2]) / 2.0;
+  cy = (b[1] + b[3]) / 2.0;
+  wd = MAX (b[2] - b[0], 1e-6);
+  ht = MAX (b[3] - b[1], 1e-6);
+
+  switch (handle)
+    {
+    case CHOPGIMP_REPEAT_HANDLE_CENTER:
+      o.radius = hypot (cx - px, cy - py);
+      if (o.radius > 1e-6)
+        o.angle = atan2 (cy - py, cx - px) * 180.0 / G_PI;
+      break;
+
+    case CHOPGIMP_REPEAT_HANDLE_RADIUS:
+      {
+        /*  the centre stays: the source moves along its direction  */
+        gdouble ar = o.angle * G_PI / 180.0;
+        gdouble ox = cx - o.radius * cos (ar);
+        gdouble oy = cy - o.radius * sin (ar);
+        gdouble nr = MAX (hypot (px - ox, py - oy), 0.0);
+
+        move_x   = (nr - o.radius) * cos (ar);
+        move_y   = (nr - o.radius) * sin (ar);
+        o.radius = nr;
+      }
+      break;
+
+    case CHOPGIMP_REPEAT_HANDLE_COUNT:
+      {
+        gdouble ar = o.angle * G_PI / 180.0;
+        gdouble ox = cx - o.radius * cos (ar);
+        gdouble oy = cy - o.radius * sin (ar);
+        gdouble d  = atan2 (py - oy, px - ox) - ar;
+
+        while (d <= 0.0)
+          d += 2.0 * G_PI;
+        while (d > 2.0 * G_PI)
+          d -= 2.0 * G_PI;
+
+        o.count = CLAMP ((gint) floor (2.0 * G_PI / MAX (d, 1e-3) + 0.5), 2, 360);
+      }
+      break;
+
+    case CHOPGIMP_REPEAT_HANDLE_HGAP:
+      o.hgap = px - b[2];
+      break;
+
+    case CHOPGIMP_REPEAT_HANDLE_VGAP:
+      o.vgap = py - b[3];
+      break;
+
+    case CHOPGIMP_REPEAT_HANDLE_SIZE:
+      o.cols = MAX (1, (gint) floor ((px - b[0] + o.hgap) / MAX (wd + o.hgap, 1.0) + 0.5));
+      o.rows = MAX (1, (gint) floor ((py - b[1] + o.vgap) / MAX (ht + o.vgap, 1.0) + 0.5));
+      break;
+
+    case CHOPGIMP_REPEAT_HANDLE_AXIS:
+      {
+        gdouble ar = o.angle * G_PI / 180.0;
+
+        o.offset = (px - cx) * cos (ar - G_PI / 2.0) + (py - cy) * sin (ar - G_PI / 2.0);
+      }
+      break;
+
+    case CHOPGIMP_REPEAT_HANDLE_AXIS_END:
+      {
+        /*  turned about the point of the axis nearest the source  */
+        gdouble ar = o.angle * G_PI / 180.0;
+        gdouble ax = cx + o.offset * cos (ar - G_PI / 2.0);
+        gdouble ay = cy + o.offset * sin (ar - G_PI / 2.0);
+        gdouble na = atan2 (py - ay, px - ax);
+
+        o.angle  = na * 180.0 / G_PI;
+        o.offset = (ax - cx) * cos (na - G_PI / 2.0) + (ay - cy) * sin (na - G_PI / 2.0);
+      }
+      break;
+
+    default:
+      return FALSE;
+    }
+
+  spec_set (g, &o, NULL);
+
+  if (move_x != 0.0 || move_y != 0.0)
+    {
+      /*  group space → image space (a vector)  */
+      gdouble ix0, iy0, ix1, iy1;
+
+      gimp_matrix3_transform_point (&m, 0.0, 0.0, &ix0, &iy0);
+      gimp_matrix3_transform_point (&m, move_x, move_y, &ix1, &iy1);
+
+      /*  the repeat is made again by the change hook (new spec, moved source)  */
+      chopgimp_vlayer_translate (layer, &src->id, 1, ix1 - ix0, iy1 - iy0, FALSE);
+    }
+  else
+    {
+      repeat_regen (layer, g, TRUE);
+      chopgimp_vlayer_subtree_changed (layer, g, NULL);
+    }
+
+  return TRUE;
+}
