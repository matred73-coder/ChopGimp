+/*  ─── the library (Formes panel) ────────────────────────────────────── */
+
+#define LIBRARY_PARASITE "chopgimp-brushes"
+
+typedef struct
+{
+  ChopGimpVBrushLibraryFunc func;
+  gpointer                  data;
+} Watcher;
+
+static GList    *library        = NULL;   /* ChopGimpVBrushDef *, owned */
+static gboolean  library_loaded = FALSE;
+static GList    *watchers       = NULL;   /* Watcher *                  */
+
+void
+chopgimp_vbrush_def_free (ChopGimpVBrushDef *def)
+{
+  if (! def)
+    return;
+
+  g_free (def->id);
+  g_free (def->name);
+  g_free (def->spec);
+  g_free (def);
+}
+
+static ChopGimpVBrushDef *
+def_new (const gchar *id,
+         const gchar *name,
+         const gchar *spec)
+{
+  ChopGimpVBrushDef *def = g_new0 (ChopGimpVBrushDef, 1);
+
+  def->id   = g_strdup (id);
+  def->name = g_strdup (name ? name : "");
+  def->spec = g_strdup (spec ? spec : "brush type=calligraphic");
+
+  return def;
+}
+
+static ChopGimpVBrushDef *
+def_copy (const ChopGimpVBrushDef *def)
+{
+  return def_new (def->id, def->name, def->spec);
+}
+
+static gchar *
+library_file (void)
+{
+  return g_build_filename (gimp_directory (), "chopgimp-brushes", NULL);
+}
+
+/*  the brushes of a key file (one group per id: name, spec)  */
+static GList *
+defs_from_keyfile (GKeyFile *kf)
+{
+  gchar **groups = g_key_file_get_groups (kf, NULL);
+  GList  *list   = NULL;
+
+  for (gchar **gr = groups; gr && *gr; gr++)
+    {
+      gchar *name = g_key_file_get_string (kf, *gr, "name", NULL);
+      gchar *spec = g_key_file_get_string (kf, *gr, "spec", NULL);
+
+      if (spec && g_str_has_prefix (spec, "brush"))
+        list = g_list_append (list, def_new (*gr, name, spec));
+
+      g_free (name);
+      g_free (spec);
+    }
+
+  g_strfreev (groups);
+
+  return list;
+}
+
+static void
+defs_to_keyfile (GKeyFile *kf,
+                 GList    *list)
+{
+  for (GList *l = list; l; l = l->next)
+    {
+      ChopGimpVBrushDef *def = l->data;
+
+      g_key_file_set_string (kf, def->id, "name", def->name);
+      g_key_file_set_string (kf, def->id, "spec", def->spec);
+    }
+}
+
+static void
+library_load (void)
+{
+  GKeyFile *kf;
+  gchar    *file;
+
+  if (library_loaded)
+    return;
+
+  library_loaded = TRUE;
+
+  kf   = g_key_file_new ();
+  file = library_file ();
+
+  if (g_key_file_load_from_file (kf, file, G_KEY_FILE_NONE, NULL))
+    library = defs_from_keyfile (kf);
+
+  g_key_file_free (kf);
+  g_free (file);
+}
+
+static void
+library_changed (void)
+{
+  GKeyFile *kf   = g_key_file_new ();
+  gchar    *file = library_file ();
+
+  defs_to_keyfile (kf, library);
+  g_key_file_save_to_file (kf, file, NULL);
+  g_key_file_free (kf);
+  g_free (file);
+
+  for (GList *l = watchers; l; )
+    {
+      Watcher *w = l->data;
+
+      l = l->next;   /* a watcher may go away */
+      w->func (w->data);
+    }
+}
+
+void
+chopgimp_vbrush_library_watch (ChopGimpVBrushLibraryFunc func,
+                               gpointer                  data)
+{
+  Watcher *w = g_new0 (Watcher, 1);
+
+  w->func  = func;
+  w->data  = data;
+  watchers = g_list_append (watchers, w);
+}
+
+void
+chopgimp_vbrush_library_unwatch (ChopGimpVBrushLibraryFunc func,
+                                 gpointer                  data)
+{
+  for (GList *l = watchers; l; l = l->next)
+    {
+      Watcher *w = l->data;
+
+      if (w->func == func && w->data == data)
+        {
+          watchers = g_list_delete_link (watchers, l);
+          g_free (w);
+          return;
+        }
+    }
+}
+
+static ChopGimpVBrushDef *
+library_find (const gchar *id)
+{
+  library_load ();
+
+  for (GList *l = library; l; l = l->next)
+    if (! g_strcmp0 (((ChopGimpVBrushDef *) l->data)->id, id))
+      return l->data;
+
+  return NULL;
+}
+
+GList *
+chopgimp_vbrush_library_list (void)
+{
+  GList *list = NULL;
+
+  library_load ();
+
+  for (GList *l = library; l; l = l->next)
+    list = g_list_append (list, def_copy (l->data));
+
+  return list;
+}
+
+void
+chopgimp_vbrush_library_free (GList *list)
+{
+  g_list_free_full (list, (GDestroyNotify) chopgimp_vbrush_def_free);
+}
+
+gboolean
+chopgimp_vbrush_def_get_options (const ChopGimpVBrushDef *def,
+                                 ChopGimpVBrushOptions   *options)
+{
+  if (! def)
+    return FALSE;
+
+  spec_get (def->spec, options);
+
+  return TRUE;
+}
+
+ChopGimpVObject *
+chopgimp_vbrush_def_get_art (GimpImage               *image,
+                             const ChopGimpVBrushDef *def,
+                             ChopGimpVBrushTile       tile)
+{
+  ChopGimpVBrushOptions o;
+
+  if (! def || ! image)
+    return NULL;
+
+  spec_get (def->spec, &o);
+
+  if (o.type == CHOPGIMP_VBRUSH_CALLIGRAPHIC)
+    return NULL;
+
+  return art_of (image, def->spec, tile_keys[CLAMP (tile, 0, 4)], o.type);
+}
+
+/*  the brush @def kept in @image too (XCF)  */
+static void
+library_store_in_image (GimpImage               *image,
+                        const ChopGimpVBrushDef *def)
+{
+  const GimpParasite *old;
+  GimpParasite       *parasite;
+  GKeyFile           *kf;
+  gchar              *data;
+  gsize               len;
+
+  if (! GIMP_IS_IMAGE (image) || ! def)
+    return;
+
+  kf = g_key_file_new ();
+
+  if ((old = gimp_image_parasite_find (image, LIBRARY_PARASITE)))
+    {
+      guint32      size = 0;
+      const gchar *d    = gimp_parasite_get_data (old, &size);
+
+      if (d && size)
+        g_key_file_load_from_data (kf, d, size, G_KEY_FILE_NONE, NULL);
+    }
+
+  g_key_file_set_string (kf, def->id, "name", def->name);
+  g_key_file_set_string (kf, def->id, "spec", def->spec);
+
+  data     = g_key_file_to_data (kf, &len, NULL);
+  parasite = gimp_parasite_new (LIBRARY_PARASITE, GIMP_PARASITE_PERSISTENT, len, data);
+  gimp_image_parasite_attach (image, parasite, FALSE);
+
+  gimp_parasite_free (parasite);
+  g_free (data);
+  g_key_file_free (kf);
+}
+
+void
+chopgimp_vbrush_library_merge_image (GimpImage *image)
+{
+  const GimpParasite *parasite;
+  GKeyFile           *kf;
+  GList              *defs;
+  gboolean            any = FALSE;
+  guint32             size = 0;
+  const gchar        *d;
+
+  if (! GIMP_IS_IMAGE (image) ||
+      ! (parasite = gimp_image_parasite_find (image, LIBRARY_PARASITE)))
+    return;
+
+  d = gimp_parasite_get_data (parasite, &size);
+
+  if (! d || ! size)
+    return;
+
+  kf = g_key_file_new ();
+
+  if (g_key_file_load_from_data (kf, d, size, G_KEY_FILE_NONE, NULL))
+    {
+      defs = defs_from_keyfile (kf);
+
+      for (GList *l = defs; l; l = l->next)
+        {
+          ChopGimpVBrushDef *def = l->data;
+
+          if (! library_find (def->id))
+            {
+              library = g_list_append (library, def);
+              l->data = NULL;
+              any     = TRUE;
+            }
+        }
+
+      g_list_free_full (defs, (GDestroyNotify) chopgimp_vbrush_def_free);
+    }
+
+  g_key_file_free (kf);
+
+  if (any)
+    library_changed ();
+}
+
+static gchar *
+new_id (void)
+{
+  static guint counter = 0;
+
+  return g_strdup_printf ("b%08x%04x", g_random_int (), ++counter & 0xffff);
+}
+
+gchar *
+chopgimp_vbrush_library_add (GimpVectorLayer    *layer,
+                             ChopGimpVBrushType  type,
+                             const gchar        *name)
+{
+  static const gchar   *labels[] = { N_("Calligraphique"), N_("Art"), N_("Motif"),
+                                     N_("Dispersion") };
+  ChopGimpVBrushOptions o;
+  ChopGimpVBrushDef    *def;
+  gchar                *arts = NULL, *spec, *label;
+
+  library_load ();
+
+  chopgimp_vbrush_default_options (type, &o);
+
+  if (type != CHOPGIMP_VBRUSH_CALLIGRAPHIC && layer && chopgimp_vlayer_get_root (layer))
+    {
+      GList *sel = chopgimp_vlayer_get_selected_objects (layer);
+
+      if (sel)
+        {
+          gchar *xml = chopgimp_vobjects_to_xml (sel);
+          gchar *b64 = xml_b64 (xml);
+
+          arts = g_strdup_printf ("art=%s", b64);
+          g_free (b64);
+          g_free (xml);
+        }
+
+      g_list_free (sel);
+    }
+
+  spec  = spec_compose (&o, arts, NULL, NULL);
+  label = name ? g_strdup (name)
+               : g_strdup_printf ("%s %d", _(labels[CLAMP (type, 0, 3)]),
+                                  g_list_length (library) + 1);
+  def   = def_new (NULL, label, spec);
+  g_free (def->id);
+  def->id = new_id ();
+
+  library = g_list_append (library, def);
+
+  if (layer)
+    library_store_in_image (gimp_item_get_image (GIMP_ITEM (layer)), def);
+
+  library_changed ();
+
+  g_free (label);
+  g_free (spec);
+  g_free (arts);
+
+  return g_strdup (def->id);
+}
+
+static void
+collect_def_users (ChopGimpVObject  *o,
+                   const gchar      *id,
+                   GList           **list)
+{
+  if (o->kind != CHOPGIMP_VOBJECT_GROUP)
+    return;
+
+  if (is_brush_group (o))
+    {
+      gchar *def = spec_word (o->blend, "def");
+
+      if (! g_strcmp0 (def, id))
+        *list = g_list_prepend (*list, o);
+
+      g_free (def);
+    }
+
+  for (guint i = 0; i < o->children->len; i++)
+    collect_def_users (g_ptr_array_index (o->children, i), id, list);
+}
+
+/*  the brushed paths of @image using @def take its spec  */
+static void
+library_update_users (const ChopGimpVBrushDef *def,
+                      GimpImage               *image)
+{
+  GList *layers;
+
+  if (! GIMP_IS_IMAGE (image))
+    return;
+
+  layers = gimp_image_get_layer_list (image);
+
+  for (GList *l = layers; l; l = l->next)
+    {
+      GimpVectorLayer       *layer;
+      GList                 *users = NULL;
+      ChopGimpVBrushOptions  o;
+      gchar                 *arts;
+
+      if (! gimp_item_is_vector_layer (GIMP_ITEM (l->data)))
+        continue;
+
+      layer = l->data;
+
+      if (! chopgimp_vlayer_has_objects (layer) || chopgimp_vlayer_is_legacy (layer))
+        continue;
+
+      collect_def_users (chopgimp_vlayer_get_root (layer), def->id, &users);
+
+      if (! users)
+        continue;
+
+      spec_get (def->spec, &o);
+      arts = spec_arts (def->spec);
+
+      chopgimp_vlayer_push_undo (layer, _("Modifier la forme de pinceau"));
+      chopgimp_vlayer_freeze (layer);
+
+      for (GList *u = users; u; u = u->next)
+        {
+          ChopGimpVObject *g = u->data;
+
+          spec_set (g, &o, arts, def->id, NULL);
+          brush_regen (layer, g, TRUE);
+          chopgimp_vlayer_subtree_changed (layer, g, NULL);
+        }
+
+      chopgimp_vlayer_thaw (layer);
+
+      g_free (arts);
+      g_list_free (users);
+    }
+
+  g_list_free (layers);
+}
+
+gboolean
+chopgimp_vbrush_library_set_options (const gchar                 *id,
+                                     const ChopGimpVBrushOptions *options,
+                                     GimpImage                   *image)
+{
+  ChopGimpVBrushDef *def = library_find (id);
+  gchar             *arts;
+
+  if (! def || ! options)
+    return FALSE;
+
+  arts = spec_arts (def->spec);
+  g_free (def->spec);
+  def->spec = spec_compose (options, arts, NULL, NULL);
+  g_free (arts);
+
+  library_changed ();
+
+  if (image)
+    {
+      library_update_users (def, image);
+      library_store_in_image (image, def);
+    }
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vbrush_library_set_tile (const gchar        *id,
+                                  GimpVectorLayer    *layer,
+                                  ChopGimpVBrushTile  tile)
+{
+  ChopGimpVBrushDef *def = library_find (id);
+  GList             *sel;
+  gchar             *xml, *b64, *spec;
+
+  if (! def || ! layer || ! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  sel = chopgimp_vlayer_get_selected_objects (layer);
+
+  if (! sel)
+    return FALSE;
+
+  xml  = chopgimp_vobjects_to_xml (sel);
+  b64  = xml_b64 (xml);
+  spec = spec_replace (def->spec, tile_keys[CLAMP (tile, 0, 4)], b64);
+
+  g_free (def->spec);
+  def->spec = spec;
+
+  g_free (b64);
+  g_free (xml);
+  g_list_free (sel);
+
+  library_changed ();
+  library_update_users (def, gimp_item_get_image (GIMP_ITEM (layer)));
+  library_store_in_image (gimp_item_get_image (GIMP_ITEM (layer)), def);
+
+  return TRUE;
+}
+
+gchar *
+chopgimp_vbrush_library_duplicate (const gchar *id)
+{
+  ChopGimpVBrushDef *def = library_find (id);
+  ChopGimpVBrushDef *copy;
+  gchar             *name;
+
+  if (! def)
+    return NULL;
+
+  name = g_strdup_printf (_("%s copie"), def->name);
+  copy = def_new (NULL, name, def->spec);
+  g_free (copy->id);
+  copy->id = new_id ();
+  g_free (name);
+
+  library = g_list_append (library, copy);
+  library_changed ();
+
+  return g_strdup (copy->id);
+}
+
+gboolean
+chopgimp_vbrush_library_rename (const gchar *id,
+                                const gchar *name)
+{
+  ChopGimpVBrushDef *def = library_find (id);
+
+  if (! def || ! name || ! *name)
+    return FALSE;
+
+  g_free (def->name);
+  def->name = g_strdup (name);
+  library_changed ();
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vbrush_library_remove (const gchar *id)
+{
+  ChopGimpVBrushDef *def = library_find (id);
+
+  if (! def)
+    return FALSE;
+
+  /*  the brushed paths keep their spec (and their artwork)  */
+  library = g_list_remove (library, def);
+  chopgimp_vbrush_def_free (def);
+  library_changed ();
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vbrush_apply_def (GimpVectorLayer *layer,
+                           const gchar     *id)
+{
+  ChopGimpVBrushDef    *def = library_find (id);
+  ChopGimpVBrushOptions o;
+  gchar                *arts;
+  gboolean              done;
+
+  if (! def || ! layer)
+    return FALSE;
+
+  spec_get (def->spec, &o);
+  arts = spec_arts (def->spec);
+  done = apply_internal (layer, &o, arts, def->id);
+  g_free (arts);
+
+  if (done)
+    library_store_in_image (gimp_item_get_image (GIMP_ITEM (layer)), def);
+
+  return done;
+}
