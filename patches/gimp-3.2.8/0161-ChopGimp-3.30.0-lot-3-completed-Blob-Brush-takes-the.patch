+
+#include "widgets/gimpeditor.h"
+#include "widgets/gimphelp-ids.h"
+
+#include "chopgimp-material-dialogs.h"
+#include "chopgimp-brushes-panel.h"
+
+#include "gimp-intl.h"
+
+
+#define PREVIEW_W 72
+#define PREVIEW_H 28
+
+typedef struct
+{
+  Gimp            *gimp;
+  GimpContext     *context;
+  GtkWidget       *editor;
+  GtkWidget       *list;
+  GtkWidget       *empty;
+  GtkWidget       *type_combo;
+  GtkWidget       *tile_combo;
+
+  GtkWidget       *new_button;
+  GtkWidget       *apply_button;
+  GtkWidget       *edit_button;
+  GtkWidget       *tile_button;
+  GtkWidget       *dup_button;
+  GtkWidget       *rename_button;
+  GtkWidget       *delete_button;
+
+  GimpImage       *image;      /* weak */
+  GimpVectorLayer *layer;      /* weak */
+  gchar           *selected;   /* brush id */
+  gboolean         loading;
+  guint            idle_id;
+} Panel;
+
+static void panel_queue_refresh (Panel *p);
+
+
+/*  ─── previews ──────────────────────────────────────────────────────── */
+
+static gboolean
+preview_draw (GtkWidget *widget,
+              cairo_t   *cr,
+              Panel     *p)
+{
+  const gchar       *id  = g_object_get_data (G_OBJECT (widget), "chopgimp-id");
+  gint               w   = gtk_widget_get_allocated_width (widget);
+  gint               h   = gtk_widget_get_allocated_height (widget);
+  GList             *lib = chopgimp_vbrush_library_list ();
+  ChopGimpVBrushDef *def = NULL;
+  GdkRGBA            fg;
+
+  gtk_style_context_get_color (gtk_widget_get_style_context (widget),
+                               gtk_widget_get_state_flags (widget), &fg);
+
+  for (GList *l = lib; l; l = l->next)
+    if (! g_strcmp0 (((ChopGimpVBrushDef *) l->data)->id, id))
+      def = l->data;
+
+  if (def)
+    {
+      ChopGimpVBrushOptions o;
+      ChopGimpVObject      *art = NULL;
+      gdouble               b[4];
+
+      chopgimp_vbrush_def_get_options (def, &o);
+
+      if (p->image)
+        art = chopgimp_vbrush_def_get_art (p->image, def, CHOPGIMP_VBRUSH_TILE_SIDE);
+
+      if (art && chopgimp_vobject_preview_bounds (art, b))
+        {
+          gdouble s = MIN ((w - 4) / MAX (b[2] - b[0], 1.0),
+                           (h - 4) / MAX (b[3] - b[1], 1.0));
+
+          cairo_save (cr);
+          cairo_translate (cr, w / 2.0, h / 2.0);
+          cairo_scale (cr, s, s);
+          cairo_translate (cr, -(b[0] + b[2]) / 2.0, -(b[1] + b[3]) / 2.0);
+          chopgimp_vobject_draw_preview (art, cr);
+          cairo_restore (cr);
+        }
+      else
+        {
+          /*  calligraphic: the nib along a wave  */
+          gdouble a = -o.angle * G_PI / 180.0;
+          gdouble r = MAX (o.roundness / 100.0, 0.05);
+
+          gdk_cairo_set_source_rgba (cr, &fg);
+
+          for (gint i = 0; i <= 40; i++)
+            {
+              gdouble t = i / 40.0;
+
+              cairo_save (cr);
+              cairo_translate (cr, 6 + t * (w - 12), h / 2.0 + sin (t * 2 * G_PI) * (h / 4.0));
+              cairo_rotate (cr, a);
+              cairo_scale (cr, 1.0, r);
+              cairo_arc (cr, 0, 0, 3.0, 0, 2 * G_PI);
+              cairo_restore (cr);
+              cairo_fill (cr);
+            }
+        }
+
+      if (art)
+        chopgimp_vobject_unref (art);
+    }
+
+  chopgimp_vbrush_library_free (lib);
+
+  return FALSE;
+}
+
+
+/*  ─── refresh ───────────────────────────────────────────────────────── */
+
+static void
+panel_update_sensitivity (Panel *p)
+{
+  gboolean sel   = p->selected != NULL;
+  gboolean apply = p->layer && chopgimp_vbrush_can_apply (p->layer);
+  gboolean objs  = p->layer && chopgimp_vobjects_n_selected (p->layer) > 0;
+
+  gtk_widget_set_sensitive (p->new_button,    TRUE);
+  gtk_widget_set_sensitive (p->apply_button,  sel && apply);
+  gtk_widget_set_sensitive (p->edit_button,   sel);
+  gtk_widget_set_sensitive (p->tile_button,   sel && objs);
+  gtk_widget_set_sensitive (p->dup_button,    sel);
+  gtk_widget_set_sensitive (p->rename_button, sel);
+  gtk_widget_set_sensitive (p->delete_button, sel);
+}
+
+static void
+list_selection_changed (GtkListBox    *box,
+                        GtkListBoxRow *row,
+                        Panel         *p)
+{
+  if (p->loading)
+    return;
+
+  g_free (p->selected);
+  p->selected = row ? g_strdup (g_object_get_data (G_OBJECT (row), "chopgimp-id")) : NULL;
+
+  panel_update_sensitivity (p);
+}
+
+static void
+panel_refresh (Panel *p)
+{
+  GList    *lib, *children;
+  gboolean  found = FALSE;
+
+  p->loading = TRUE;
+
+  children = gtk_container_get_children (GTK_CONTAINER (p->list));
+  for (GList *l = children; l; l = l->next)
+    gtk_widget_destroy (l->data);
+  g_list_free (children);
+
+  lib = chopgimp_vbrush_library_list ();
+
+  for (GList *l = lib; l; l = l->next)
+    {
+      ChopGimpVBrushDef *def  = l->data;
+      GtkWidget         *row  = gtk_list_box_row_new ();
+      GtkWidget         *hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+      GtkWidget         *area = gtk_drawing_area_new ();
+      GtkWidget         *label = gtk_label_new (def->name);
+
+      gtk_widget_set_size_request (area, PREVIEW_W, PREVIEW_H);
+      g_object_set_data_full (G_OBJECT (area), "chopgimp-id", g_strdup (def->id), g_free);
+      g_signal_connect (area, "draw", G_CALLBACK (preview_draw), p);
+
+      gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+      gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_END);
+
+      gtk_box_pack_start (GTK_BOX (hbox), area, FALSE, FALSE, 0);
+      gtk_box_pack_start (GTK_BOX (hbox), label, TRUE, TRUE, 0);
+      gtk_container_set_border_width (GTK_CONTAINER (hbox), 2);
+      gtk_container_add (GTK_CONTAINER (row), hbox);
+
+      g_object_set_data_full (G_OBJECT (row), "chopgimp-id", g_strdup (def->id), g_free);
+      gtk_container_add (GTK_CONTAINER (p->list), row);
+      gtk_widget_show_all (row);
+
+      if (! g_strcmp0 (def->id, p->selected))
+        {
+          gtk_list_box_select_row (GTK_LIST_BOX (p->list), GTK_LIST_BOX_ROW (row));
+          found = TRUE;
+        }
+    }
+
+  gtk_widget_set_visible (p->empty, lib == NULL);
+
+  if (! found)
+    g_clear_pointer (&p->selected, g_free);
+
+  chopgimp_vbrush_library_free (lib);
+  p->loading = FALSE;
+
+  panel_update_sensitivity (p);
+}
+
+static gboolean
+panel_refresh_idle (gpointer data)
+{
+  Panel *p = data;
+
+  p->idle_id = 0;
+  panel_refresh (p);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+panel_queue_refresh (Panel *p)
+{
+  if (! p->idle_id)
+    p->idle_id = g_idle_add (panel_refresh_idle, p);
+}
+
+static void
+library_changed (gpointer data)
+{
+  panel_queue_refresh (data);
+}
+
+
+/*  ─── following the image ───────────────────────────────────────────── */
+
+static void
+panel_set_layer (Panel           *p,
+                 GimpVectorLayer *layer)
+{
+  if (layer == p->layer)
+    return;
+
+  if (p->layer)
+    {
+      g_signal_handlers_disconnect_by_data (p->layer, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->layer), (gpointer *) &p->layer);
+    }
+
+  p->layer = layer;
+
+  if (layer)
+    {
+      g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &p->layer);
+      g_signal_connect_swapped (layer, "object-selection-changed",
+                                G_CALLBACK (panel_update_sensitivity), p);
+    }
+
+  panel_update_sensitivity (p);
+}
+
+static void
+panel_layers_changed (Panel *p)
+{
+  panel_set_layer (p, p->image ? chopgimp_vobjects_get_target_layer (p->image) : NULL);
+}
+
+static void
+panel_set_image (Panel     *p,
+                 GimpImage *image)
+{
+  if (image == p->image)
+    return;
+
+  panel_set_layer (p, NULL);
+
+  if (p->image)
+    {
+      g_signal_handlers_disconnect_by_data (p->image, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->image), (gpointer *) &p->image);
+    }
+
+  p->image = image;
+
+  if (image)
+    {
+      g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &p->image);
+      g_signal_connect_swapped (image, "selected-layers-changed",
+                                G_CALLBACK (panel_layers_changed), p);
+
+      /*  the brushes kept in the image (XCF) join the library  */
+      chopgimp_vbrush_library_merge_image (image);
+
+      panel_set_layer (p, chopgimp_vobjects_get_target_layer (image));
+    }
+
+  panel_queue_refresh (p);
+}
+
+static void
+panel_image_changed (GimpContext *context,
+                     GimpImage   *image,
+                     Panel       *p)
+{
+  panel_set_image (p, image);
+}
+
+
+/*  ─── actions ───────────────────────────────────────────────────────── */
+
+static void
+new_clicked (GtkWidget *button,
+             Panel     *p)
+{
+  gint   type = gtk_combo_box_get_active (GTK_COMBO_BOX (p->type_combo));
+  gchar *id   = chopgimp_vbrush_library_add (p->layer, CLAMP (type, 0, 3), NULL);
+
+  g_free (p->selected);
+  p->selected = id;
+  panel_queue_refresh (p);
+}
+
+static void
+apply_clicked (GtkWidget *button,
+               Panel     *p)
+{
+  if (p->layer && p->selected && chopgimp_vbrush_apply_def (p->layer, p->selected))
+    gimp_image_flush (p->image);
+}
+
+static void
+row_activated (GtkListBox    *box,
+               GtkListBoxRow *row,
+               Panel         *p)
+{
+  apply_clicked (NULL, p);
+}
+
+static void
+edit_clicked (GtkWidget *button,
+              Panel     *p)
+{
+  GList                *lib = chopgimp_vbrush_library_list ();
+  ChopGimpVBrushOptions o;
+  gboolean              found = FALSE;
+
+  for (GList *l = lib; l; l = l->next)
+    if (! g_strcmp0 (((ChopGimpVBrushDef *) l->data)->id, p->selected))
+      found = chopgimp_vbrush_def_get_options (l->data, &o);
+
+  chopgimp_vbrush_library_free (lib);
+
+  if (found &&
+      chopgimp_brush_options_edit (p->editor, _("Modifier la forme"), &o, FALSE) &&
+      chopgimp_vbrush_library_set_options (p->selected, &o, p->image) && p->image)
+    gimp_image_flush (p->image);
+}
+
+static void
+tile_clicked (GtkWidget *button,
+              Panel     *p)
+{
+  gint tile = gtk_combo_box_get_active (GTK_COMBO_BOX (p->tile_combo));
+
+  if (p->layer && p->selected &&
+      chopgimp_vbrush_library_set_tile (p->selected, p->layer, CLAMP (tile, 0, 4)))
+    gimp_image_flush (p->image);
+}
+
+static void
+dup_clicked (GtkWidget *button,
+             Panel     *p)
+{
+  gchar *id = p->selected ? chopgimp_vbrush_library_duplicate (p->selected) : NULL;
+
+  if (id)
+    {
+      g_free (p->selected);
+      p->selected = id;
+    }
+}
+
+static void
+rename_callback (GtkWidget   *query_box,
+                 const gchar *string,
+                 gpointer     data)
+{
+  const gchar *id = g_object_get_data (G_OBJECT (query_box), "chopgimp-id");
+
+  if (id && string && *string)
+    chopgimp_vbrush_library_rename (id, string);
+}
+
+static void
+rename_clicked (GtkWidget *button,
+                Panel     *p)
+{
+  GList       *lib  = chopgimp_vbrush_library_list ();
+  const gchar *name = NULL;
+  GtkWidget   *box;
+
+  for (GList *l = lib; l; l = l->next)
+    if (! g_strcmp0 (((ChopGimpVBrushDef *) l->data)->id, p->selected))
+      name = ((ChopGimpVBrushDef *) l->data)->name;
+
+  if (name)
+    {
+      box = gimp_query_string_box (_("Renommer la forme"),
+                                   p->editor,
+                                   gimp_standard_help_func, GIMP_HELP_PATH_DIALOG,
+                                   _("Nom de la forme :"),
+                                   name,
+                                   G_OBJECT (p->editor), "destroy",
+                                   rename_callback, NULL, NULL);
+      g_object_set_data_full (G_OBJECT (box), "chopgimp-id", g_strdup (p->selected), g_free);
+      gtk_widget_show (box);
+    }
+
+  chopgimp_vbrush_library_free (lib);
+}
+
+static void
+delete_clicked (GtkWidget *button,
+                Panel     *p)
+{
+  if (p->selected)
+    chopgimp_vbrush_library_remove (p->selected);
+}
+
+
+/*  ─── construction ──────────────────────────────────────────────────── */
+
+static void
+panel_free (Panel *p)
+{
+  chopgimp_vbrush_library_unwatch (library_changed, p);
+  panel_set_image (p, NULL);
+
+  if (p->idle_id)
+    g_source_remove (p->idle_id);
+  p->idle_id = 0;
+
+  g_signal_handlers_disconnect_by_data (p->context, p);
+
+  g_free (p->selected);
+  g_free (p);
+}
+
+static GtkWidget *
+add_button (Panel       *p,
+            const gchar *icon,
+            const gchar *tip,
+            GCallback    callback)
+{
+  GtkWidget *b = gimp_editor_add_button (GIMP_EDITOR (p->editor), icon, tip, NULL,
+                                         NULL, NULL, NULL);
+
+  g_signal_connect (b, "clicked", callback, p);
+
+  return b;
+}
+
+static GtkWidget *
+labelled_combo (GtkWidget    *box,
+                const gchar  *label,
+                const gchar **items,
+                gint          active)
+{
+  GtkWidget *hbox  = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  GtkWidget *combo = gtk_combo_box_text_new ();
+
+  gtk_box_pack_start (GTK_BOX (hbox), gtk_label_new (label), FALSE, FALSE, 0);
+
+  for (gint i = 0; items[i]; i++)
+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (combo), _(items[i]));
+
+  gtk_combo_box_set_active (GTK_COMBO_BOX (combo), active);
+  gtk_box_pack_start (GTK_BOX (hbox), combo, TRUE, TRUE, 0);
+  gtk_box_pack_start (GTK_BOX (box), hbox, FALSE, FALSE, 0);
+
+  return combo;
+}
+
+GtkWidget *
+chopgimp_brushes_panel_new (GimpDialogFactory *factory,
+                            GimpContext       *context,
+                            GimpUIManager     *ui_manager,
+                            gint               view_size)
+{
+  static const gchar *types[] = { N_("Calligraphique"), N_("Art"), N_("Motif"),
+                                  N_("Dispersion"), NULL };
+  static const gchar *tiles[] = { N_("Côté"), N_("Angle extérieur"), N_("Angle intérieur"),
+                                  N_("Début"), N_("Fin"), NULL };
+  Panel     *p      = g_new0 (Panel, 1);
+  GtkWidget *editor = g_object_new (GIMP_TYPE_EDITOR, NULL);
+  GtkWidget *box    = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  GtkWidget *scrolled;
+
+  p->gimp    = context->gimp;
+  p->editor  = editor;
+  p->context = gimp_get_user_context (context->gimp);
+
+  gtk_container_set_border_width (GTK_CONTAINER (box), 6);
+  gtk_box_pack_start (GTK_BOX (editor), box, TRUE, TRUE, 0);
+
+  g_object_set_data_full (G_OBJECT (editor), "chopgimp-panel", p,
+                          (GDestroyNotify) panel_free);
+
+  p->empty = gtk_label_new (_("Aucune forme. « Nouvelle forme » en crée une ; pour Art, "
+                              "Motif et Dispersion, les objets sélectionnés deviennent "
+                              "son illustration."));
+  gtk_label_set_line_wrap (GTK_LABEL (p->empty), TRUE);
+  gtk_label_set_xalign (GTK_LABEL (p->empty), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (p->empty), "dim-label");
