+          gdouble         *x1,
+          gdouble         *y1,
+          gdouble         *x2,
+          gdouble         *y2)
+{
+  const guint *ids;
+  gint         n = 0;
+
+  if (! layer || ! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  ids = chopgimp_vlayer_get_selection (layer, &n);
+
+  return n > 0 && chopgimp_vlayer_get_bounds (layer, ids, n, TRUE, x1, y1, x2, y2);
+}
+
+static void
+handle_point (gint     i,
+              gdouble  x1,
+              gdouble  y1,
+              gdouble  x2,
+              gdouble  y2,
+              gdouble *x,
+              gdouble *y)
+{
+  static const gdouble fx[8] = { 0, 0.5, 1, 1, 1, 0.5, 0, 0 };
+  static const gdouble fy[8] = { 0, 0, 0, 0.5, 1, 1, 1, 0.5 };
+
+  *x = x1 + (x2 - x1) * fx[i];
+  *y = y1 + (y2 - y1) * fy[i];
+}
+
+/*  the handle under the pointer (0..7), -1 if none; *rotate: in the
+ *  rotation zone just outside a corner
+ */
+static gint
+vsel_handle_at (ChopGimpVSel     *vsel,
+                GimpDisplay      *display,
+                const GimpCoords *coords,
+                gboolean         *rotate)
+{
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           x1, y1, x2, y2;
+  gdouble           sx, sy;
+  gint              best = -1;
+  gdouble           best_d = G_MAXDOUBLE;
+
+  *rotate = FALSE;
+
+  if (! vsel_box (vsel->layer, &x1, &y1, &x2, &y2))
+    return -1;
+
+  gimp_display_shell_transform_xy_f (shell, coords->x, coords->y, &sx, &sy);
+
+  for (gint i = 0; i < 8; i++)
+    {
+      gdouble hx, hy, hsx, hsy, d;
+
+      handle_point (i, x1, y1, x2, y2, &hx, &hy);
+      gimp_display_shell_transform_xy_f (shell, hx, hy, &hsx, &hsy);
+      d = hypot (hsx - sx, hsy - sy);
+
+      if (d < best_d)
+        {
+          best_d = d;
+          best   = i;
+        }
+    }
+
+  if (best_d <= HANDLE_HIT)
+    return best;
+
+  /*  rotation: near a corner, outside the box  */
+  if (best % 2 == 0 && best_d <= ROTATE_ZONE &&
+      (coords->x < x1 || coords->x > x2 || coords->y < y1 || coords->y > y2))
+    {
+      *rotate = TRUE;
+      return best;
+    }
+
+  return -1;
+}
+
+/*  the vector layer the press works on, or NULL (layer mode)  */
+static GimpVectorLayer *
+vsel_target (ChopGimpVSel     *vsel,
+             GimpImage        *image,
+             const GimpCoords *coords,
+             gdouble           tolerance,
+             gboolean          auto_select)
+{
+  GimpVectorLayer *active = chopgimp_vobjects_get_active_layer (image);
+  GimpLayer       *picked;
+
+  if (! chopgimp_vobjects_enabled () || ! auto_select)
+    return active;
+
+  picked = gimp_image_pick_layer (image, coords->x, coords->y, NULL);
+
+  if (! picked || GIMP_LAYER (active) == picked)
+    return active;
+
+  /*  an object of the active layer under the pointer wins, and so does
+   *  its empty area (rectangle selection), within the layer's bounds
+   */
+  if (active)
+    {
+      GimpItem *item = GIMP_ITEM (active);
+      gint      ox, oy;
+
+      gimp_item_get_offset (item, &ox, &oy);
+
+      if (chopgimp_vlayer_hit_test (active, coords->x, coords->y, tolerance,
+                                    CHOPGIMP_HIT_SELECTABLE))
+        return active;
+
+      if (coords->x >= ox && coords->x < ox + gimp_item_get_width (item) &&
+          coords->y >= oy && coords->y < oy + gimp_item_get_height (item) &&
+          ! (GIMP_IS_VECTOR_LAYER (picked) &&
+             chopgimp_vobjects_layer_is_multi (GIMP_VECTOR_LAYER (picked))))
+        return active;
+    }
+
+  if (GIMP_IS_VECTOR_LAYER (picked) &&
+      chopgimp_vobjects_layer_is_multi (GIMP_VECTOR_LAYER (picked)))
+    {
+      GList *list = g_list_prepend (NULL, picked);
+
+      gimp_image_set_selected_layers (image, list);
+      g_list_free (list);
+
+      return GIMP_VECTOR_LAYER (picked);
+    }
+
+  return NULL;
+}
+
+static void
+vsel_take_ids (ChopGimpVSel *vsel)
+{
+  const guint *ids;
+  gint         n = 0;
+
+  g_clear_pointer (&vsel->ids, g_free);
+  vsel->n_ids = 0;
+
+  ids = chopgimp_vlayer_get_selection (vsel->layer, &n);
+
+  if (n > 0)
+    {
+      vsel->ids   = g_memdup2 (ids, sizeof (guint) * n);
+      vsel->n_ids = n;
+    }
+}
+
+static gboolean
+vsel_is_double (ChopGimpVSel        *vsel,
+                GimpDisplay         *display,
+                const GimpCoords    *coords,
+                guint32              time,
+                GimpButtonPressType  press_type)
+{
+  gint     dbl_time = 400;
+  gint     dbl_dist = 5;
+  gdouble  sx, sy;
+  gboolean dbl;
+
+  g_object_get (gtk_settings_get_default (),
+                "gtk-double-click-time",     &dbl_time,
+                "gtk-double-click-distance", &dbl_dist,
+                NULL);
+
+  gimp_display_shell_transform_xy_f (gimp_display_get_shell (display),
+                                     coords->x, coords->y, &sx, &sy);
+
+  dbl = (press_type == GIMP_BUTTON_PRESS_DOUBLE ||
+         (vsel->last_time &&
+          time - vsel->last_time < (guint32) dbl_time &&
+          fabs (sx - vsel->last_sx) <= MAX (dbl_dist, 6) &&
+          fabs (sy - vsel->last_sy) <= MAX (dbl_dist, 6)));
+
+  vsel->last_time = dbl ? 0 : time;
+  vsel->last_sx   = sx;
+  vsel->last_sy   = sy;
+
+  return dbl;
+}
+
+static void
+vsel_ensure_drawing (ChopGimpVSel *vsel,
+                     GimpDisplay  *display)
+{
+  GimpDrawTool *dt = vsel->tool;
+
+  if (gimp_draw_tool_is_active (dt) && dt->display != display)
+    gimp_draw_tool_stop (dt);
+
+  if (! gimp_draw_tool_is_active (dt))
+    gimp_draw_tool_start (dt, display);
+  else
+    vsel_redraw (vsel);
+}
+
+static void
+vsel_end_drag (ChopGimpVSel *vsel)
+{
+  vsel->drag = DRAG_NONE;
+  g_clear_pointer (&vsel->ids, g_free);
+  vsel->n_ids = 0;
+  g_clear_pointer (&vsel->snap, chopgimp_vsnap_free);
+}
+
+
+/*  ─── API ───────────────────────────────────────────────────────────── */
+
+ChopGimpVSel *
+chopgimp_vsel_new (GimpDrawTool *tool)
+{
+  ChopGimpVSel *vsel = g_new0 (ChopGimpVSel, 1);
+
+  vsel->tool = tool;
+  gimp_matrix3_identity (&vsel->applied);
+
+  return vsel;
+}
+
+void
+chopgimp_vsel_free (ChopGimpVSel *vsel)
+{
+  if (! vsel)
+    return;
+
+  vsel_end_drag (vsel);
+  vsel_watch (vsel, NULL);
+  g_free (vsel);
+}
+
+gboolean
+chopgimp_vsel_is_active (ChopGimpVSel *vsel,
+                         GimpImage    *image)
+{
+  return vsel && image && chopgimp_vobjects_get_active_layer (image) != NULL;
+}
+
+void
+chopgimp_vsel_halt (ChopGimpVSel *vsel)
+{
+  if (! vsel)
+    return;
+
+  vsel_end_drag (vsel);
+  vsel_watch (vsel, NULL);
+}
+
+void
+chopgimp_vsel_arm_style_picker (Gimp *gimp)
+{
+  GimpToolInfo *info = gimp_get_tool_info (gimp, "gimp-move-tool");
+
+  style_picker_armed = TRUE;
+
+  if (info)
+    gimp_context_set_tool (gimp_get_user_context (gimp), info);
+}
+
+gboolean
+chopgimp_vsel_button_press (ChopGimpVSel        *vsel,
+                            const GimpCoords    *coords,
+                            guint32              time,
+                            GdkModifierType      state,
+                            GimpButtonPressType  press_type,
+                            GimpDisplay         *display,
+                            gboolean             auto_select)
+{
+  GimpTool         *tool  = GIMP_TOOL (vsel->tool);
+  GimpImage        *image = gimp_display_get_image (display);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           tol   = HIT_TOLERANCE / MAX (shell->scale_x, 1e-6);
+  GimpVectorLayer  *layer;
+  ChopGimpVObject  *hit;
+  gboolean          shift = (state & gimp_get_extend_selection_mask ()) != 0;
+  gboolean          rotate;
+  gboolean          dbl;
+  gint              handle;
+
+  if (! chopgimp_vobjects_enabled () || ! image)
+    return FALSE;
+
+  /*  « Pipette de style »: the clicked object gives its style  */
+  if (style_picker_armed)
+    {
+      style_picker_armed = FALSE;
+      layer = chopgimp_vobjects_get_active_layer (image);
+
+      if (layer &&
+          (hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y, tol,
+                                           CHOPGIMP_HIT_LEAF)) &&
+          chopgimp_vobjects_copy_style (layer, hit))
+        gimp_image_flush (image);
+
+      return TRUE;
+    }
+
+  layer = vsel_target (vsel, image, coords, tol, auto_select);
+
+  if (! layer)
+    return FALSE;
+
+  vsel_watch (vsel, layer);
+  vsel_end_drag (vsel);
+
+  tool->display     = display;
+  vsel->px          = coords->x;
+  vsel->py          = coords->y;
+  vsel->pushed      = FALSE;
+  vsel->duplicate   = FALSE;
+  vsel->dx_applied  = vsel->dy_applied = 0.0;
+  vsel->from_center = (state & GDK_MOD1_MASK) != 0;
+  gimp_matrix3_identity (&vsel->applied);
+
+  vsel_box (layer, &vsel->bx1, &vsel->by1, &vsel->bx2, &vsel->by2);
+
+  /*  the handles of the box  */
+  handle = vsel_handle_at (vsel, display, coords, &rotate);
+
+  if (handle >= 0)
+    {
+      vsel->drag   = rotate ? DRAG_ROTATE : DRAG_SCALE;
+      vsel->handle = handle;
+    }
+  else
+    {
+      guint entered;
+
+      dbl = vsel_is_double (vsel, display, coords, time, press_type);
+      hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y, tol,
+                                      CHOPGIMP_HIT_SELECTABLE);
+
+      /*  a click outside of the entered group leaves it  */
+      entered = chopgimp_vlayer_get_entered_group (layer);
+      if (entered)
+        {
+          ChopGimpVObject *group = chopgimp_vlayer_get_object (layer, entered);
+
+          if (! hit || ! group || ! chopgimp_vobject_is_ancestor (group, hit))
+            {
+              chopgimp_vlayer_enter_group (layer, 0);
+              hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y, tol,
+                                              CHOPGIMP_HIT_SELECTABLE);
+            }
+        }
+
+      /*  double-click on a group: enter it  */
+      if (dbl && hit && hit->kind == CHOPGIMP_VOBJECT_GROUP)
+        {
+          chopgimp_vlayer_enter_group (layer, hit->id);
+          hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y, tol,
+                                          CHOPGIMP_HIT_SELECTABLE);
+          if (hit)
+            chopgimp_vlayer_set_selection (layer, &hit->id, 1);
+          else
+            chopgimp_vlayer_set_selection (layer, NULL, 0);
+
+          gimp_image_flush (image);
+          vsel_ensure_drawing (vsel, display);
+
+          return TRUE;
+        }
+
+      if (hit)
+        {
+          gboolean selected = chopgimp_vlayer_is_selected (layer, hit->id);
+
+          if (shift && selected)
+            {
+              chopgimp_vlayer_deselect (layer, hit->id);
+              gimp_image_flush (image);
+              vsel_ensure_drawing (vsel, display);
+
+              return TRUE;
+            }
+
+          if (shift)
+            chopgimp_vlayer_select (layer, hit->id, TRUE);
+          else if (! selected)
+            chopgimp_vlayer_set_selection (layer, &hit->id, 1);
+
+          vsel->drag      = DRAG_MOVE;
+          vsel->duplicate = (state & GDK_MOD1_MASK) != 0;
+
+          vsel_box (layer, &vsel->bx1, &vsel->by1, &vsel->bx2, &vsel->by2);
+        }
+      else
+        {
+          vsel->drag = DRAG_RUBBER;
+          vsel->rx   = coords->x;
+          vsel->ry   = coords->y;
+        }
+    }
+
+  vsel_take_ids (vsel);
+
+  gimp_tool_control_activate (tool->control);
+  vsel_ensure_drawing (vsel, display);
+
+  return TRUE;
+}
+
+static void
+vsel_start_change (ChopGimpVSel *vsel,
+                   const gchar  *desc)
+{
+  GimpImage *image = gimp_item_get_image (GIMP_ITEM (vsel->layer));
+
+  if (vsel->pushed)
+    return;
+
+  chopgimp_vlayer_push_undo (vsel->layer, desc);
+  vsel->pushed = TRUE;
+
+  /*  Alt+drag: the copies move, the originals stay  */
+  if (vsel->duplicate && chopgimp_vobjects_duplicate_selection (vsel->layer, FALSE))
+    vsel_take_ids (vsel);
+
+  vsel->snap = chopgimp_vsnap_new (image, vsel->layer, vsel->ids, vsel->n_ids);
+}
+
+gboolean
+chopgimp_vsel_motion (ChopGimpVSel     *vsel,
+                      const GimpCoords *coords,
+                      GdkModifierType   state,
+                      GimpDisplay      *display)
+{
+  GimpDisplayShell *shell;
+  gdouble           scale;
+  gdouble           tol;
+  gboolean          shift, ctrl;
+
+  if (vsel->drag == DRAG_NONE)
+    return FALSE;
+
+  if (! vsel->layer)
+    {
+      vsel_end_drag (vsel);
+      return TRUE;
+    }
+
+  shell = gimp_display_get_shell (display);
+  scale = MAX (shell->scale_x, 1e-6);
+  tol   = SNAP_TOLERANCE / scale;
+  shift = (state & gimp_get_extend_selection_mask ()) != 0;
+  ctrl  = (state & gimp_get_toggle_behavior_mask ()) != 0;
+
+  gimp_draw_tool_pause (vsel->tool);
+
+  switch (vsel->drag)
+    {
+    case DRAG_RUBBER:
+      vsel->rx = coords->x;
+      vsel->ry = coords->y;
+      break;
+
+    case DRAG_MOVE:
+      {
+        gdouble dx = coords->x - vsel->px;
+        gdouble dy = coords->y - vsel->py;
+
+        if (! vsel->pushed && hypot (dx, dy) * scale < DRAG_THRESHOLD)
+          break;
+
+        if (shift)
+          {
+            if (fabs (dx) > 2.0 * fabs (dy))
+              dy = 0.0;
+            else if (fabs (dy) > 2.0 * fabs (dx))
+              dx = 0.0;
+            else
+              {
+                gdouble d = (fabs (dx) + fabs (dy)) / 2.0;
+
+                dx = dx < 0 ? -d : d;
+                dy = dy < 0 ? -d : d;
+              }
+          }
+
+        vsel_start_change (vsel, _("Déplacer les objets"));
+
+        if (vsel->snap)
+          {
+            gdouble cx = 0.0, cy = 0.0;
+
+            if (! ctrl &&
+                chopgimp_vsnap_bounds (vsel->snap,
+                                       vsel->bx1 + dx, vsel->by1 + dy,
+                                       vsel->bx2 + dx, vsel->by2 + dy,
+                                       tol, &cx, &cy))
+              {
+                dx += cx;
+                dy += cy;
+              }
+            else if (ctrl)
+              {
+                chopgimp_vsnap_reset (vsel->snap);
+              }
+          }
+
+        if (dx != vsel->dx_applied || dy != vsel->dy_applied)
+          {
+            chopgimp_vlayer_translate (vsel->layer, vsel->ids, vsel->n_ids,
+                                       dx - vsel->dx_applied,
+                                       dy - vsel->dy_applied, FALSE);
+            vsel->dx_applied = dx;
+            vsel->dy_applied = dy;
+          }
+      }
+      break;
+
+    case DRAG_SCALE:
+    case DRAG_ROTATE:
+      {
+        GimpMatrix3 m, inc;
+        gdouble     cx = (vsel->bx1 + vsel->bx2) / 2.0;
+        gdouble     cy = (vsel->by1 + vsel->by2) / 2.0;
+
+        gimp_matrix3_identity (&m);
+
+        if (vsel->drag == DRAG_ROTATE)
+          {
+            gdouble a = atan2 (coords->y - cy, coords->x - cx) -
+                        atan2 (vsel->py - cy, vsel->px - cx);
+
+            if (shift)
+              a = RINT (a / (G_PI / 12.0)) * (G_PI / 12.0);
+
+            gimp_matrix3_translate (&m, -cx, -cy);
+            gimp_matrix3_rotate    (&m, a);
+            gimp_matrix3_translate (&m, cx, cy);
+
+            vsel_start_change (vsel, _("Faire pivoter les objets"));
+          }
+        else
+          {
+            gint    h  = vsel->handle;
+            gint    o  = (h + 4) % 8;
+            gdouble hx, hy, ax, ay;
+            gdouble x  = coords->x, y = coords->y;
+            gdouble sx = 1.0, sy = 1.0;
+            gboolean corner = (h % 2 == 0);
+            gboolean horiz  = (h == 3 || h == 7);
+            gboolean vert   = (h == 1 || h == 5);
+
+            handle_point (h, vsel->bx1, vsel->by1, vsel->bx2, vsel->by2, &hx, &hy);
+
+            if (vsel->from_center || (state & GDK_MOD1_MASK))
+              {
+                ax = cx;
+                ay = cy;
+              }
+            else
+              {
+                handle_point (o, vsel->bx1, vsel->by1, vsel->bx2, vsel->by2, &ax, &ay);
+              }
+
+            vsel_start_change (vsel, _("Redimensionner les objets"));
+
+            if (vsel->snap && ! ctrl)
+              chopgimp_vsnap_point (vsel->snap, x, y, tol, &x, &y);
+            else if (vsel->snap)
+              chopgimp_vsnap_reset (vsel->snap);
+
+            if ((corner || horiz) && fabs (hx - ax) > 1e-6)
+              sx = (x - ax) / (hx - ax);
+            if ((corner || vert) && fabs (hy - ay) > 1e-6)
+              sy = (y - ay) / (hy - ay);
+
+            if (shift)
+              {
+                if (corner)
+                  {
+                    gdouble s = fabs (sx) > fabs (sy) ? fabs (sx) : fabs (sy);
+
+                    sx = sx < 0 ? -s : s;
+                    sy = sy < 0 ? -s : s;
+                  }
+                else if (horiz)
+                  sy = fabs (sx);
+                else
+                  sx = fabs (sy);
+              }
+
+            if (fabs (sx) < 1e-3) sx = sx < 0 ? -1e-3 : 1e-3;
+            if (fabs (sy) < 1e-3) sy = sy < 0 ? -1e-3 : 1e-3;
+
+            gimp_matrix3_translate (&m, -ax, -ay);
+            gimp_matrix3_scale     (&m, sx, sy);
+            gimp_matrix3_translate (&m, ax, ay);
+          }
+
+        /*  inc = m · applied⁻¹  */
+        inc = vsel->applied;
+        gimp_matrix3_invert (&inc);
+        gimp_matrix3_mult (&m, &inc);
+
+        chopgimp_vlayer_transform (vsel->layer, vsel->ids, vsel->n_ids,
+                                   &inc, FALSE, FALSE);
+        vsel->applied = m;
+      }
+      break;
+    }
+
+  gimp_draw_tool_resume (vsel->tool);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vsel_button_release (ChopGimpVSel          *vsel,
+                              const GimpCoords      *coords,
+                              GdkModifierType        state,
+                              GimpButtonReleaseType  release_type,
+                              GimpDisplay           *display)
+{
+  GimpTool  *tool  = GIMP_TOOL (vsel->tool);
+  GimpImage *image = gimp_display_get_image (display);
+  gint       drag  = vsel->drag;
+
+  if (drag == DRAG_NONE)
+    return FALSE;
+
+  gimp_tool_control_halt (tool->control);
+  gimp_draw_tool_pause (vsel->tool);
+
+  if (! vsel->layer)
+    {
+      vsel_end_drag (vsel);
+      gimp_draw_tool_resume (vsel->tool);
+      return TRUE;
+    }
+
+  if (release_type == GIMP_BUTTON_RELEASE_CANCEL)
+    {
+      if (vsel->pushed)
+        gimp_image_undo (image);
+    }
+  else if (drag == DRAG_RUBBER)
+    {
+      GimpDisplayShell *shell = gimp_display_get_shell (display);
+      gboolean          shift = (state & gimp_get_extend_selection_mask ()) != 0;
+      gdouble           x     = MIN (vsel->px, vsel->rx);
+      gdouble           y     = MIN (vsel->py, vsel->ry);
+      gdouble           w     = fabs (vsel->rx - vsel->px);
+      gdouble           h     = fabs (vsel->ry - vsel->py);
+
+      if (MAX (w, h) * shell->scale_x < DRAG_THRESHOLD)
+        {
+          if (! shift)
+            chopgimp_vlayer_set_selection (vsel->layer, NULL, 0);
+        }
+      else
+        {
+          GList *list = chopgimp_vlayer_objects_in_rect (vsel->layer, x, y, w, h, TRUE);
+
+          if (! shift)
+            chopgimp_vlayer_set_selection (vsel->layer, NULL, 0);
+
+          for (GList *l = list; l; l = l->next)
+            chopgimp_vlayer_select (vsel->layer,
+                                    ((ChopGimpVObject *) l->data)->id, TRUE);
+
+          g_list_free (list);
+        }
+    }
+
+  vsel_end_drag (vsel);
+  gimp_image_flush (image);
+
+  gimp_draw_tool_resume (vsel->tool);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vsel_key_press (ChopGimpVSel *vsel,
+                         GdkEventKey  *kevent,
+                         GimpDisplay  *display)
+{
+  GimpImage       *image = gimp_display_get_image (display);
+  GimpVectorLayer *layer = chopgimp_vobjects_get_active_layer (image);
+  gint             n     = chopgimp_vobjects_n_selected (layer);
+  gdouble          step  = (kevent->state & gimp_get_extend_selection_mask ()) ? 10.0 : 1.0;
+  gdouble          dx    = 0.0, dy = 0.0;
+
+  if (! layer)
+    {
+      if (kevent->keyval == GDK_KEY_Escape && style_picker_armed)
+        {
+          style_picker_armed = FALSE;
+          return TRUE;
+        }
+
+      return FALSE;
+    }
+
+  switch (kevent->keyval)
+    {
+    case GDK_KEY_Left:  case GDK_KEY_KP_Left:  dx = -step; break;
+    case GDK_KEY_Right: case GDK_KEY_KP_Right: dx =  step; break;
+    case GDK_KEY_Up:    case GDK_KEY_KP_Up:    dy = -step; break;
+    case GDK_KEY_Down:  case GDK_KEY_KP_Down:  dy =  step; break;
+
+    case GDK_KEY_Escape:
+      if (style_picker_armed)
+        {
+          style_picker_armed = FALSE;
+          return TRUE;
+        }
+      else if (chopgimp_vlayer_get_entered_group (layer))
+        {
+          guint group = chopgimp_vlayer_get_entered_group (layer);
+
+          chopgimp_vlayer_enter_group (layer, 0);
+          chopgimp_vlayer_set_selection (layer, &group, 1);
+        }
+      else if (n > 0)
+        {
+          chopgimp_vlayer_set_selection (layer, NULL, 0);
+        }
+      else
+        {
+          return FALSE;
+        }
+
+      gimp_image_flush (image);
+      return TRUE;
+
+    case GDK_KEY_Delete:
+    case GDK_KEY_KP_Delete:
+    case GDK_KEY_BackSpace:
+      if (n == 0)
+        return FALSE;
+
+      chopgimp_vobjects_delete_selection (layer);
+      gimp_image_flush (image);
+      return TRUE;
+
+    default:
+      return FALSE;
+    }
+
+  if (n == 0)
+    return FALSE;
+
+  {
+    const guint *ids = chopgimp_vlayer_get_selection (layer, &n);
+    guint       *copy = g_memdup2 (ids, sizeof (guint) * n);
+
+    chopgimp_vlayer_translate (layer, copy, n, dx, dy, TRUE);
+    g_free (copy);
+  }
+
+  gimp_image_flush (image);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vsel_oper_update (ChopGimpVSel     *vsel,
+                           const GimpCoords *coords,
+                           GdkModifierType   state,
+                           gboolean          proximity,
+                           GimpDisplay      *display)
+{
+  GimpImage        *image = gimp_display_get_image (display);
+  GimpVectorLayer  *layer = chopgimp_vobjects_get_active_layer (image);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  ChopGimpVObject  *hit   = NULL;
+  guint             hover;
+
+  vsel_watch (vsel, layer);
+
+  if (! layer)
+    return FALSE;
+
+  if (proximity)
+    hit = chopgimp_vlayer_hit_test (layer, coords->x, coords->y,
+                                    HIT_TOLERANCE / MAX (shell->scale_x, 1e-6),
+                                    CHOPGIMP_HIT_SELECTABLE);
+
+  hover = hit ? hit->id : 0;
+
+  if (! gimp_draw_tool_is_active (vsel->tool) ||
+      vsel->tool->display != display)
+    {
+      vsel->hover_id = hover;
+      vsel_ensure_drawing (vsel, display);
+    }
+  else if (hover != vsel->hover_id)
+    {
+      vsel->hover_id = hover;
+      vsel_redraw (vsel);
+    }
+
+  if (style_picker_armed)
+    gimp_tool_replace_status (GIMP_TOOL (vsel->tool), display,
+                              _("Pipette de style : cliquez sur l'objet dont copier "
+                                "le fond et le contour (Échap : annuler)"));
+  else
+    gimp_tool_replace_status (GIMP_TOOL (vsel->tool), display,
+                              _("Objets : clic pour sélectionner, Maj+clic pour ajouter, "
+                                "glisser dans le vide pour encadrer, Alt+glisser pour "
+                                "dupliquer, double-clic pour entrer dans un groupe"));
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vsel_cursor_update (ChopGimpVSel     *vsel,
+                             const GimpCoords *coords,
+                             GdkModifierType   state,
+                             GimpDisplay      *display)
+{
+  static const GimpCursorType handle_cursors[8] =
+  {
+    GIMP_CURSOR_CORNER_TOP_LEFT,     GIMP_CURSOR_SIDE_TOP,
+    GIMP_CURSOR_CORNER_TOP_RIGHT,    GIMP_CURSOR_SIDE_RIGHT,
+    GIMP_CURSOR_CORNER_BOTTOM_RIGHT, GIMP_CURSOR_SIDE_BOTTOM,
+    GIMP_CURSOR_CORNER_BOTTOM_LEFT,  GIMP_CURSOR_SIDE_LEFT
+  };
+  GimpTool           *tool  = GIMP_TOOL (vsel->tool);
+  GimpImage          *image = gimp_display_get_image (display);
+  GimpVectorLayer    *layer = chopgimp_vobjects_get_active_layer (image);
+  GimpCursorType      cursor      = GIMP_CURSOR_MOUSE;
+  GimpToolCursorType  tool_cursor = GIMP_TOOL_CURSOR_MOVE;
+  GimpCursorModifier  modifier    = GIMP_CURSOR_MODIFIER_NONE;
+  gboolean            rotate;
+  gint                handle;
+
+  if (! layer)
+    return FALSE;
+
+  vsel_watch (vsel, layer);
+
+  if (style_picker_armed)
+    {
+      tool_cursor = GIMP_TOOL_CURSOR_COLOR_PICKER;
+    }
+  else if ((handle = vsel_handle_at (vsel, display, coords, &rotate)) >= 0)
+    {
+      if (rotate)
+        tool_cursor = GIMP_TOOL_CURSOR_ROTATE;
+      else
+        {
+          cursor      = handle_cursors[handle];
+          tool_cursor = GIMP_TOOL_CURSOR_NONE;
+        }
+    }
+  else if (vsel->hover_id)
+    {
+      modifier = GIMP_CURSOR_MODIFIER_MOVE;
+    }
+
+  gimp_tool_control_set_cursor          (tool->control, cursor);
+  gimp_tool_control_set_tool_cursor     (tool->control, tool_cursor);
+  gimp_tool_control_set_cursor_modifier (tool->control, modifier);
+
+  return TRUE;
+}
+
+static void
+vsel_draw_outline (ChopGimpVSel    *vsel,
+                   ChopGimpVObject *o,
+                   gboolean         highlight)
+{
+  GimpDrawTool   *dt = vsel->tool;
+  GimpPath       *wp = chopgimp_vobject_get_world_path (vsel->layer, o, FALSE);
+  GimpCanvasItem *item;
+
+  if (! wp)
+    return;
+
+  g_object_ref_sink (wp);
+
+  if (gimp_path_get_n_strokes (wp) > 0 && gimp_path_get_bezier (wp))
+    {
+      item = gimp_canvas_path_new (gimp_display_get_shell (dt->display),
+                                   gimp_path_get_bezier (wp), 0, 0, FALSE,
+                                   GIMP_PATH_STYLE_DEFAULT);
+      gimp_canvas_item_set_highlight (item, highlight);
+      gimp_draw_tool_add_item (dt, item);
+      g_object_unref (item);
+    }
+
+  g_object_unref (wp);
+}
+
+gboolean
+chopgimp_vsel_draw (ChopGimpVSel *vsel)
+{
+  GimpDrawTool *dt = vsel->tool;
+  GimpImage    *image;
+  gdouble       x1, y1, x2, y2;
+
+  if (! dt->display)
+    return FALSE;
+
+  image = gimp_display_get_image (dt->display);
+
+  if (! vsel->layer || ! image ||
+      gimp_item_get_image (GIMP_ITEM (vsel->layer)) != image ||
+      chopgimp_vobjects_get_active_layer (image) != vsel->layer)
+    return FALSE;
+
+  /*  outlines of the selected objects, and of the one under the pointer  */
+  {
+    GList *objs = chopgimp_vlayer_get_selected_objects (vsel->layer);
+    gint   k    = 0;
+
+    for (GList *l = objs; l && k < MAX_OUTLINES; l = l->next, k++)
+      vsel_draw_outline (vsel, l->data, FALSE);
+
+    g_list_free (objs);
+
+    if (vsel->hover_id && vsel->drag == DRAG_NONE &&
+        ! chopgimp_vlayer_is_selected (vsel->layer, vsel->hover_id))
+      {
+        ChopGimpVObject *o = chopgimp_vlayer_get_object (vsel->layer, vsel->hover_id);
+
+        if (o)
+          vsel_draw_outline (vsel, o, TRUE);
+      }
+  }
+
+  /*  the box and its handles  */
+  if (vsel->drag != DRAG_RUBBER && vsel_box (vsel->layer, &x1, &y1, &x2, &y2))
+    {
+      gimp_draw_tool_add_rectangle (dt, FALSE, x1, y1, x2 - x1, y2 - y1);
+
+      if (vsel->drag == DRAG_NONE)
+        for (gint i = 0; i < 8; i++)
+          {
+            gdouble hx, hy;
+
+            handle_point (i, x1, y1, x2, y2, &hx, &hy);
+            gimp_draw_tool_add_handle (dt, GIMP_HANDLE_SQUARE, hx, hy,
+                                       HANDLE_SIZE, HANDLE_SIZE,
+                                       GIMP_HANDLE_ANCHOR_CENTER);
+          }
+    }
+
+  /*  the entered group  */
+  {
+    guint entered = chopgimp_vlayer_get_entered_group (vsel->layer);
+    ChopGimpVObject *group = entered ? chopgimp_vlayer_get_object (vsel->layer, entered)
+                                     : NULL;
+
+    if (group && chopgimp_vobject_get_bounds (vsel->layer, group, TRUE,
+                                              &x1, &y1, &x2, &y2))
+      {
+        GimpCanvasItem *item = gimp_draw_tool_add_rectangle (dt, FALSE, x1, y1,
+                                                             x2 - x1, y2 - y1);
+
+        gimp_canvas_item_set_highlight (item, TRUE);
+      }
+  }
+
+  if (vsel->drag == DRAG_RUBBER)
+    gimp_draw_tool_add_rectangle (dt, FALSE,
+                                  MIN (vsel->px, vsel->rx), MIN (vsel->py, vsel->ry),
+                                  fabs (vsel->rx - vsel->px), fabs (vsel->ry - vsel->py));
+
+  if (vsel->snap && vsel->drag != DRAG_NONE)
+    chopgimp_vsnap_draw (vsel->snap, dt);
+
+  return TRUE;
+}
