new file mode 100644
index 0000000..194cb80
--- /dev/null
+++ b/app/actions/vector-objects-commands.c
@@ -0,0 +1,169 @@
+/* GIMP - The GNU Image Manipulation Program
+ * vector-objects-commands.c — ChopGimp 3.27 (lot V2): commands of the
+ * « Objet » menu on the selected objects of the active vector layer
+ * (path/chopgimp-vobject-ops.c). The actions are in layers-actions.c
+ * (« layers-vobjects-* »).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "actions-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpimage.h"
+
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vobject-ops.h"
+
+#include "tools/chopgimp-vobjecttool.h"
+
+#include "actions.h"
+#include "vector-objects-commands.h"
+
+#include "gimp-intl.h"
+
+
+#define return_if_no_vlayer(image,layer,data) \
+  return_if_no_image (image, data);            \
+  layer = chopgimp_vobjects_get_active_layer (image); \
+  if (! layer)                                 \
+    return
+
+
+gboolean
+vector_objects_has_selection (GimpImage *image)
+{
+  return chopgimp_vobjects_n_selected (chopgimp_vobjects_get_active_layer (image)) > 0;
+}
+
+gboolean
+vector_objects_dispatch (GimpImage        *image,
+                         VObjectsDispatch  what)
+{
+  GimpVectorLayer *layer = chopgimp_vobjects_get_active_layer (image);
+
+  if (chopgimp_vobjects_n_selected (layer) == 0)
+    return FALSE;
+
+  switch (what)
+    {
+    case VOBJECTS_DISPATCH_GROUP:
+      chopgimp_vobjects_group_selection (layer);
+      break;
+    case VOBJECTS_DISPATCH_RAISE:
+      chopgimp_vobjects_arrange (layer, CHOPGIMP_VARRANGE_FORWARD);
+      break;
+    case VOBJECTS_DISPATCH_RAISE_TO_TOP:
+      chopgimp_vobjects_arrange (layer, CHOPGIMP_VARRANGE_FRONT);
+      break;
+    case VOBJECTS_DISPATCH_LOWER:
+      chopgimp_vobjects_arrange (layer, CHOPGIMP_VARRANGE_BACKWARD);
+      break;
+    case VOBJECTS_DISPATCH_LOWER_TO_BOTTOM:
+      chopgimp_vobjects_arrange (layer, CHOPGIMP_VARRANGE_BACK);
+      break;
+    case VOBJECTS_DISPATCH_DELETE:
+      chopgimp_vobjects_delete_selection (layer);
+      break;
+    }
+
+  gimp_image_flush (image);
+
+  return TRUE;
+}
+
+#define SIMPLE_COMMAND(name, call)                         \
+void                                                       \
+vector_objects_##name##_cmd_callback (GimpAction *action,  \
+                                      GVariant   *value,   \
+                                      gpointer    data)    \
+{                                                          \
+  GimpImage       *image;                                  \
+  GimpVectorLayer *layer;                                  \
+  return_if_no_vlayer (image, layer, data);                \
+                                                           \
+  if (call (layer))                                        \
+    gimp_image_flush (image);                              \
+}
+
+SIMPLE_COMMAND (group,        chopgimp_vobjects_group_selection)
+SIMPLE_COMMAND (ungroup,      chopgimp_vobjects_ungroup_selection)
+SIMPLE_COMMAND (lock,         chopgimp_vobjects_lock_selection)
+SIMPLE_COMMAND (unlock_all,   chopgimp_vobjects_unlock_all)
+SIMPLE_COMMAND (hide,         chopgimp_vobjects_hide_selection)
+SIMPLE_COMMAND (show_all,     chopgimp_vobjects_show_all)
+SIMPLE_COMMAND (clip_make,    chopgimp_vobjects_clip_make)
+SIMPLE_COMMAND (clip_release, chopgimp_vobjects_clip_release)
+SIMPLE_COMMAND (select_all,   chopgimp_vobjects_select_all)
+SIMPLE_COMMAND (delete,       chopgimp_vobjects_delete_selection)
+
+void
+vector_objects_arrange_cmd_callback (GimpAction *action,
+                                     GVariant   *value,
+                                     gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_vlayer (image, layer, data);
+
+  if (chopgimp_vobjects_arrange (layer, (ChopGimpVArrange) g_variant_get_int32 (value)))
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_align_cmd_callback (GimpAction *action,
+                                   GVariant   *value,
+                                   gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_vlayer (image, layer, data);
+
+  if (chopgimp_vobjects_align (layer, (ChopGimpVAlign) g_variant_get_int32 (value)))
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_pathfinder_cmd_callback (GimpAction *action,
+                                        GVariant   *value,
+                                        gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_vlayer (image, layer, data);
+
+  if (chopgimp_vobjects_pathfinder (layer,
+                                    (ChopGimpVPathfinder) g_variant_get_int32 (value)))
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_style_picker_cmd_callback (GimpAction *action,
+                                          GVariant   *value,
+                                          gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_vlayer (image, layer, data);
+
+  chopgimp_vsel_arm_style_picker (image->gimp);
+}
