diff --git a/app/display/chopgimp-vobjectbar.c b/app/display/chopgimp-vobjectbar.c
new file mode 100644
index 0000000..2d8eb8a
--- /dev/null
+++ b/app/display/chopgimp-vobjectbar.c
@@ -0,0 +1,783 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * chopgimp-vobjectbar.c — ChopGimp 3.27 (lot V2): the options bar in
+ * object mode. While objects of the active vector layer are selected, the
+ * bar shows their Fond (color, pattern or none), Contour, Épaisseur,
+ * Opacité, X / Y / L / H and Rotation, with the compact fields of 3.26
+ * (widgets/chopgimp-value-field.c) and the color drop-downs of the bar.
+ *
+ * A small GObject (ChopGimpVObjectProps) carries these values as
+ * properties: the widgets are bound to it, it reads the first selected
+ * object and writes every change to all the selected objects (one undo
+ * step per burst of changes).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpconfig/gimpconfig.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "display-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpcontext.h"
+#include "core/gimpimage.h"
+#include "core/gimppattern.h"
+
+#include "path/gimppath.h"
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-vobject.h"
+#include "path/chopgimp-vobject-ops.h"
+
+#include "widgets/chopgimp-value-field.h"
+
+#include "chopgimp-vobjectbar.h"
+
+#include "gimp-intl.h"
+
+
+enum
+{
+  PROP_0,
+  PROP_ENABLE_FILL,
+  PROP_FILL_FOREGROUND,
+  PROP_FILL_CUSTOM_STYLE,
+  PROP_FILL_PATTERN,
+  PROP_ENABLE_STROKE,
+  PROP_STROKE_FOREGROUND,
+  PROP_STROKE_CUSTOM_STYLE,
+  PROP_STROKE_PATTERN,
+  PROP_STROKE_WIDTH,
+  PROP_OPACITY,
+  PROP_X,
+  PROP_Y,
+  PROP_WIDTH,
+  PROP_HEIGHT,
+  PROP_ROTATION
+};
+
+#define CHOPGIMP_TYPE_VOBJECT_PROPS (chopgimp_vobject_props_get_type ())
+#define CHOPGIMP_VOBJECT_PROPS(obj) (G_TYPE_CHECK_INSTANCE_CAST ((obj), CHOPGIMP_TYPE_VOBJECT_PROPS, ChopGimpVObjectProps))
+
+typedef struct
+{
+  GObject          parent_instance;
+
+  Gimp            *gimp;
+  GimpImage       *image;      /* weak */
+  GimpVectorLayer *layer;      /* weak */
+  GtkWidget       *content;    /* shown while objects are selected */
+
+  gboolean         loading;
+  gboolean         applying;
+  guint            idle_id;
+  gint64           last_push;
+  guint            last_prop;
+
+  gboolean         enable_fill;
+  GeglColor       *fill_color;
+  GimpCustomStyle  fill_style;
+  GimpPattern     *fill_pattern;
+  gboolean         enable_stroke;
+  GeglColor       *stroke_color;
+  GimpCustomStyle  stroke_style;
+  GimpPattern     *stroke_pattern;
+  gdouble          stroke_width;
+  gdouble          opacity;
+  gdouble          x, y, width, height;
+  gdouble          rotation;
+} ChopGimpVObjectProps;
+
+typedef GObjectClass ChopGimpVObjectPropsClass;
+
+GType chopgimp_vobject_props_get_type (void);
+
+G_DEFINE_TYPE (ChopGimpVObjectProps, chopgimp_vobject_props, G_TYPE_OBJECT)
+
+
+static void props_apply (ChopGimpVObjectProps *p,
+                         guint                 prop);
+static void props_watch_layer (ChopGimpVObjectProps *p);
+
+
+/*  ─── reading the selection ─────────────────────────────────────────── */
+
+static GeglColor *
+paint_color (const ChopGimpPaint *paint)
+{
+  if (paint->type == CHOPGIMP_PAINT_COLOR)
+    return paint->color;
+
+  if ((paint->type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+       paint->type == CHOPGIMP_PAINT_RADIAL_GRADIENT) &&
+      paint->stops && paint->stops->len)
+    return g_array_index (paint->stops, ChopGimpGradientStop, 0).color;
+
+  return NULL;
+}
+
+static gboolean
+props_bounds (ChopGimpVObjectProps *p,
+              gdouble              *x1,
+              gdouble              *y1,
+              gdouble              *x2,
+              gdouble              *y2)
+{
+  const guint *ids;
+  gint         n = 0;
+
+  ids = chopgimp_vlayer_get_selection (p->layer, &n);
+
+  return n > 0 && chopgimp_vlayer_get_bounds (p->layer, ids, n, FALSE, x1, y1, x2, y2);
+}
+
+static gdouble
+object_rotation (ChopGimpVObject *o)
+{
+  GimpMatrix3 m;
+
+  chopgimp_vobject_get_world_matrix (o, &m);
+
+  return atan2 (m.coeff[1][0], m.coeff[0][0]) * 180.0 / G_PI;
+}
+
+static void
+props_load (ChopGimpVObjectProps *p)
+{
+  GList           *objs = p->layer ? chopgimp_vlayer_get_selected_objects (p->layer) : NULL;
+  ChopGimpVObject *first;
+  ChopGimpVObject *leaf;
+  GObject         *object = G_OBJECT (p);
+
+  gtk_widget_set_visible (p->content, objs != NULL);
+
+  if (! objs)
+    return;
+
+  first = objs->data;
+  leaf  = chopgimp_vobjects_first_leaf (first);
+  g_list_free (objs);
+
+  p->loading = TRUE;
+  g_object_freeze_notify (object);
+
+  if (leaf)
+    {
+      const ChopGimpVStyle *st = &leaf->style;
+      GeglColor            *c;
+
+      p->enable_fill = st->fill.type != CHOPGIMP_PAINT_NONE;
+      p->fill_style  = (st->fill.type == CHOPGIMP_PAINT_PATTERN)
+                       ? GIMP_CUSTOM_STYLE_PATTERN : GIMP_CUSTOM_STYLE_SOLID_COLOR;
+      if ((c = paint_color (&st->fill)))
+        {
+          g_clear_object (&p->fill_color);
+          p->fill_color = gegl_color_duplicate (c);
+        }
+      if (st->fill.pattern)
+        g_set_object (&p->fill_pattern, st->fill.pattern);
+
+      p->enable_stroke = (st->stroke.type != CHOPGIMP_PAINT_NONE &&
+                          st->stroke_width > 0.0);
+      p->stroke_style  = (st->stroke.type == CHOPGIMP_PAINT_PATTERN)
+                         ? GIMP_CUSTOM_STYLE_PATTERN : GIMP_CUSTOM_STYLE_SOLID_COLOR;
+      if ((c = paint_color (&st->stroke)))
+        {
+          g_clear_object (&p->stroke_color);
+          p->stroke_color = gegl_color_duplicate (c);
+        }
+      if (st->stroke.pattern)
+        g_set_object (&p->stroke_pattern, st->stroke.pattern);
+
+      p->stroke_width = st->stroke_width;
+    }
+
+  p->opacity  = first->opacity;
+  p->rotation = object_rotation (first);
+
+  {
+    gdouble x1, y1, x2, y2;
+
+    if (props_bounds (p, &x1, &y1, &x2, &y2))
+      {
+        p->x      = x1;
+        p->y      = y1;
+        p->width  = x2 - x1;
+        p->height = y2 - y1;
+      }
+  }
+
+  {
+    static const gchar *const names[] =
+    {
+      "enable-fill", "fill-foreground", "fill-custom-style", "fill-pattern",
+      "enable-stroke", "stroke-foreground", "stroke-custom-style", "stroke-pattern",
+      "stroke-width", "opacity", "x", "y", "width", "height", "rotation"
+    };
+
+    for (guint i = 0; i < G_N_ELEMENTS (names); i++)
+      g_object_notify (object, names[i]);
+  }
+
+  g_object_thaw_notify (object);
+  p->loading = FALSE;
+}
+
+static gboolean
+props_load_idle (gpointer data)
+{
+  ChopGimpVObjectProps *p = data;
+
+  p->idle_id = 0;
+  props_load (p);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+props_queue_load (ChopGimpVObjectProps *p)
+{
+  if (p->applying)
+    return;
+
+  if (! p->idle_id)
+    p->idle_id = g_idle_add_full (G_PRIORITY_DEFAULT_IDLE, props_load_idle, p, NULL);
+}
+
+static void
+props_layer_changed (GimpVectorLayer      *layer,
+                     gpointer              dirty,
+                     ChopGimpVObjectProps *p)
+{
+  props_queue_load (p);
+}
+
+static void
+props_selection_changed (GimpVectorLayer      *layer,
+                         ChopGimpVObjectProps *p)
+{
+  props_queue_load (p);
+}
+
+static void
+props_set_layer (ChopGimpVObjectProps *p,
+                 GimpVectorLayer      *layer)
+{
+  if (p->layer == layer)
+    return;
+
+  if (p->layer)
+    {
+      g_signal_handlers_disconnect_by_data (p->layer, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->layer), (gpointer *) &p->layer);
+    }
+
+  p->layer = layer;
+
+  if (layer)
+    {
+      g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &p->layer);
+      g_signal_connect (layer, "objects-changed",
+                        G_CALLBACK (props_layer_changed), p);
+      g_signal_connect (layer, "object-selection-changed",
+                        G_CALLBACK (props_selection_changed), p);
+    }
+}
+
+static void
+props_watch_layer (ChopGimpVObjectProps *p)
+{
+  props_set_layer (p, p->image ? chopgimp_vobjects_get_active_layer (p->image) : NULL);
+  props_queue_load (p);
+}
+
+static void
+props_layers_changed (GimpImage            *image,
+                      ChopGimpVObjectProps *p)
+{
+  props_watch_layer (p);
+}
+
+static void
+props_image_changed (GimpContext          *context,
+                     GimpImage            *image,
+                     ChopGimpVObjectProps *p)
+{
+  if (p->image)
+    {
+      g_signal_handlers_disconnect_by_data (p->image, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->image), (gpointer *) &p->image);
+    }
+
+  p->image = image;
+
+  if (image)
+    {
+      g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &p->image);
+      g_signal_connect (image, "selected-layers-changed",
+                        G_CALLBACK (props_layers_changed), p);
+    }
+
+  props_watch_layer (p);
+}
+
+
+/*  ─── writing to the selection ──────────────────────────────────────── */
+
+static void
+props_apply (ChopGimpVObjectProps *p,
+             guint                 prop)
+{
+  GimpVectorLayer *layer = p->layer;
+  GList           *objs;
+  gint64           now   = g_get_monotonic_time ();
+  gboolean         style = (prop <= PROP_STROKE_WIDTH);
+
+  if (! layer || ! chopgimp_vobjects_layer_is_multi (layer))
+    return;
+
+  objs = chopgimp_vlayer_get_selected_objects (layer);
+  if (! objs)
+    return;
+
+  p->applying = TRUE;
+
+  /*  a burst of changes (a slider, a drag in a field) is one undo step  */
+  if (prop != p->last_prop || now - p->last_push > 700000)
+    chopgimp_vlayer_push_undo (layer, style ? _("Style des objets")
+                                            : _("Transformer les objets"));
+  p->last_prop = prop;
+  p->last_push = now;
+
+  chopgimp_vlayer_freeze (layer);
+
+  if (style)
+    {
+      for (GList *o = objs; o; o = o->next)
+        {
+          GList *leaves = chopgimp_vobjects_leaves_of (o->data);
+
+          for (GList *l = leaves; l; l = l->next)
+            {
+              ChopGimpVObject *leaf = l->data;
+              ChopGimpVStyle   st;
+
+              chopgimp_vstyle_init (&st);
+              chopgimp_vstyle_copy (&st, &leaf->style);
+
+              switch (prop)
+                {
+                case PROP_ENABLE_FILL:
+                case PROP_FILL_FOREGROUND:
+                case PROP_FILL_CUSTOM_STYLE:
+                case PROP_FILL_PATTERN:
+                  if (! p->enable_fill)
+                    chopgimp_vpaint_clear (&st.fill);
+                  else if (p->fill_style == GIMP_CUSTOM_STYLE_PATTERN && p->fill_pattern)
+                    chopgimp_vpaint_set_pattern (&st.fill, p->fill_pattern);
+                  else if (prop != PROP_ENABLE_FILL ||
+                           st.fill.type == CHOPGIMP_PAINT_NONE)
+                    chopgimp_vpaint_set_color (&st.fill, p->fill_color);
+                  break;
+
+                case PROP_ENABLE_STROKE:
+                case PROP_STROKE_FOREGROUND:
+                case PROP_STROKE_CUSTOM_STYLE:
+                case PROP_STROKE_PATTERN:
+                  if (! p->enable_stroke)
+                    chopgimp_vpaint_clear (&st.stroke);
+                  else if (p->stroke_style == GIMP_CUSTOM_STYLE_PATTERN && p->stroke_pattern)
+                    chopgimp_vpaint_set_pattern (&st.stroke, p->stroke_pattern);
+                  else if (prop != PROP_ENABLE_STROKE ||
+                           st.stroke.type == CHOPGIMP_PAINT_NONE)
+                    chopgimp_vpaint_set_color (&st.stroke, p->stroke_color);
+
+                  if (p->enable_stroke && st.stroke_width <= 0.0)
+                    st.stroke_width = MAX (p->stroke_width, 1.0);
+                  break;
+
+                case PROP_STROKE_WIDTH:
+                  st.stroke_width = p->stroke_width;
+                  if (p->stroke_width > 0.0 && st.stroke.type == CHOPGIMP_PAINT_NONE)
+                    chopgimp_vpaint_set_color (&st.stroke, p->stroke_color);
+                  break;
+                }
+
+              chopgimp_vlayer_set_style (layer, leaf->id, &st, FALSE);
+              chopgimp_vstyle_clear (&st);
+            }
+
+          g_list_free (leaves);
+        }
+    }
+  else if (prop == PROP_OPACITY)
+    {
+      for (GList *o = objs; o; o = o->next)
+        chopgimp_vlayer_set_props (layer, ((ChopGimpVObject *) o->data)->id,
+                                   NULL, p->opacity, -1, -1, -1, FALSE);
+    }
+  else
+    {
+      const guint *sel;
+      guint       *ids;
+      gint         n = 0;
+      gdouble      x1, y1, x2, y2;
+
+      sel = chopgimp_vlayer_get_selection (layer, &n);
+      ids = g_memdup2 (sel, sizeof (guint) * MAX (n, 1));
+
+      if (n > 0 && props_bounds (p, &x1, &y1, &x2, &y2))
+        {
+          GimpMatrix3 m;
+
+          gimp_matrix3_identity (&m);
+
+          switch (prop)
+            {
+            case PROP_X:
+              chopgimp_vlayer_translate (layer, ids, n, p->x - x1, 0.0, FALSE);
+              break;
+
+            case PROP_Y:
+              chopgimp_vlayer_translate (layer, ids, n, 0.0, p->y - y1, FALSE);
+              break;
+
+            case PROP_WIDTH:
+            case PROP_HEIGHT:
+              {
+                gdouble sx = 1.0, sy = 1.0;
+
+                if (prop == PROP_WIDTH && x2 - x1 > 1e-6 && p->width > 0.0)
+                  sx = p->width / (x2 - x1);
+                if (prop == PROP_HEIGHT && y2 - y1 > 1e-6 && p->height > 0.0)
+                  sy = p->height / (y2 - y1);
+
+                gimp_matrix3_translate (&m, -x1, -y1);
+                gimp_matrix3_scale     (&m, sx, sy);
+                gimp_matrix3_translate (&m, x1, y1);
+                chopgimp_vlayer_transform (layer, ids, n, &m, FALSE, FALSE);
+              }
+              break;
+
+            case PROP_ROTATION:
+              {
+                gdouble cx = (x1 + x2) / 2.0, cy = (y1 + y2) / 2.0;
+                gdouble a  = (p->rotation - object_rotation (objs->data)) * G_PI / 180.0;
+
+                gimp_matrix3_translate (&m, -cx, -cy);
+                gimp_matrix3_rotate    (&m, a);
+                gimp_matrix3_translate (&m, cx, cy);
+                chopgimp_vlayer_transform (layer, ids, n, &m, FALSE, FALSE);
+              }
+              break;
+            }
+        }
+
+      g_free (ids);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+
+  g_list_free (objs);
+  p->applying = FALSE;
+
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
+}
+
+
+/*  ─── GObject ───────────────────────────────────────────────────────── */
+
+static void
+chopgimp_vobject_props_set_property (GObject      *object,
+                                     guint         property_id,
+                                     const GValue *value,
+                                     GParamSpec   *pspec)
+{
+  ChopGimpVObjectProps *p = CHOPGIMP_VOBJECT_PROPS (object);
+
+  switch (property_id)
+    {
+    case PROP_ENABLE_FILL:       p->enable_fill   = g_value_get_boolean (value); break;
+    case PROP_FILL_FOREGROUND:
+      if (g_value_get_object (value))
+        {
+          g_clear_object (&p->fill_color);
+          p->fill_color = gegl_color_duplicate (g_value_get_object (value));
+        }
+      break;
+    case PROP_FILL_CUSTOM_STYLE: p->fill_style    = g_value_get_enum (value); break;
+    case PROP_FILL_PATTERN:      g_set_object (&p->fill_pattern, g_value_get_object (value)); break;
+    case PROP_ENABLE_STROKE:     p->enable_stroke = g_value_get_boolean (value); break;
+    case PROP_STROKE_FOREGROUND:
+      if (g_value_get_object (value))
+        {
+          g_clear_object (&p->stroke_color);
+          p->stroke_color = gegl_color_duplicate (g_value_get_object (value));
+        }
+      break;
+    case PROP_STROKE_CUSTOM_STYLE: p->stroke_style = g_value_get_enum (value); break;
+    case PROP_STROKE_PATTERN:    g_set_object (&p->stroke_pattern, g_value_get_object (value)); break;
+    case PROP_STROKE_WIDTH:      p->stroke_width  = g_value_get_double (value); break;
+    case PROP_OPACITY:           p->opacity       = g_value_get_double (value); break;
+    case PROP_X:                 p->x             = g_value_get_double (value); break;
+    case PROP_Y:                 p->y             = g_value_get_double (value); break;
+    case PROP_WIDTH:             p->width         = g_value_get_double (value); break;
+    case PROP_HEIGHT:            p->height        = g_value_get_double (value); break;
+    case PROP_ROTATION:          p->rotation      = g_value_get_double (value); break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      return;
+    }
+
+  if (! p->loading)
+    props_apply (p, property_id);
+}
+
+static void
+chopgimp_vobject_props_get_property (GObject    *object,
+                                     guint       property_id,
+                                     GValue     *value,
+                                     GParamSpec *pspec)
+{
+  ChopGimpVObjectProps *p = CHOPGIMP_VOBJECT_PROPS (object);
+
+  switch (property_id)
+    {
+    case PROP_ENABLE_FILL:         g_value_set_boolean (value, p->enable_fill);   break;
+    case PROP_FILL_FOREGROUND:     g_value_set_object  (value, p->fill_color);    break;
+    case PROP_FILL_CUSTOM_STYLE:   g_value_set_enum    (value, p->fill_style);    break;
+    case PROP_FILL_PATTERN:        g_value_set_object  (value, p->fill_pattern);  break;
+    case PROP_ENABLE_STROKE:       g_value_set_boolean (value, p->enable_stroke); break;
+    case PROP_STROKE_FOREGROUND:   g_value_set_object  (value, p->stroke_color);  break;
+    case PROP_STROKE_CUSTOM_STYLE: g_value_set_enum    (value, p->stroke_style);  break;
+    case PROP_STROKE_PATTERN:      g_value_set_object  (value, p->stroke_pattern); break;
+    case PROP_STROKE_WIDTH:        g_value_set_double  (value, p->stroke_width);  break;
+    case PROP_OPACITY:             g_value_set_double  (value, p->opacity);       break;
+    case PROP_X:                   g_value_set_double  (value, p->x);             break;
+    case PROP_Y:                   g_value_set_double  (value, p->y);             break;
+    case PROP_WIDTH:               g_value_set_double  (value, p->width);         break;
+    case PROP_HEIGHT:              g_value_set_double  (value, p->height);        break;
+    case PROP_ROTATION:            g_value_set_double  (value, p->rotation);      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+chopgimp_vobject_props_dispose (GObject *object)
+{
+  ChopGimpVObjectProps *p = CHOPGIMP_VOBJECT_PROPS (object);
+
+  if (p->idle_id)
+    {
+      g_source_remove (p->idle_id);
+      p->idle_id = 0;
+    }
+
+  props_set_layer (p, NULL);
+
+  if (p->image)
+    {
+      g_signal_handlers_disconnect_by_data (p->image, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->image), (gpointer *) &p->image);
+      p->image = NULL;
+    }
+
+  G_OBJECT_CLASS (chopgimp_vobject_props_parent_class)->dispose (object);
+}
+
+static void
+chopgimp_vobject_props_finalize (GObject *object)
+{
+  ChopGimpVObjectProps *p = CHOPGIMP_VOBJECT_PROPS (object);
+
+  g_clear_object (&p->fill_color);
+  g_clear_object (&p->stroke_color);
+  g_clear_object (&p->fill_pattern);
+  g_clear_object (&p->stroke_pattern);
+
+  G_OBJECT_CLASS (chopgimp_vobject_props_parent_class)->finalize (object);
+}
+
+static void
+chopgimp_vobject_props_class_init (ChopGimpVObjectPropsClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GeglColor    *black        = gegl_color_new ("black");
+
+  object_class->set_property = chopgimp_vobject_props_set_property;
+  object_class->get_property = chopgimp_vobject_props_get_property;
+  object_class->dispose      = chopgimp_vobject_props_dispose;
+  object_class->finalize     = chopgimp_vobject_props_finalize;
+
+#define FLAGS (G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS)
+
+  g_object_class_install_property (object_class, PROP_ENABLE_FILL,
+    g_param_spec_boolean ("enable-fill", "Fond", NULL, TRUE, FLAGS));
+  g_object_class_install_property (object_class, PROP_FILL_FOREGROUND,
+    gegl_param_spec_color ("fill-foreground", "Couleur du fond", NULL, black, FLAGS));
+  g_object_class_install_property (object_class, PROP_FILL_CUSTOM_STYLE,
+    g_param_spec_enum ("fill-custom-style", NULL, NULL, GIMP_TYPE_CUSTOM_STYLE,
+                       GIMP_CUSTOM_STYLE_SOLID_COLOR, FLAGS));
+  g_object_class_install_property (object_class, PROP_FILL_PATTERN,
+    g_param_spec_object ("fill-pattern", NULL, NULL, GIMP_TYPE_PATTERN, FLAGS));
+  g_object_class_install_property (object_class, PROP_ENABLE_STROKE,
+    g_param_spec_boolean ("enable-stroke", "Contour", NULL, FALSE, FLAGS));
+  g_object_class_install_property (object_class, PROP_STROKE_FOREGROUND,
+    gegl_param_spec_color ("stroke-foreground", "Couleur du contour", NULL, black, FLAGS));
+  g_object_class_install_property (object_class, PROP_STROKE_CUSTOM_STYLE,
+    g_param_spec_enum ("stroke-custom-style", NULL, NULL, GIMP_TYPE_CUSTOM_STYLE,
+                       GIMP_CUSTOM_STYLE_SOLID_COLOR, FLAGS));
+  g_object_class_install_property (object_class, PROP_STROKE_PATTERN,
+    g_param_spec_object ("stroke-pattern", NULL, NULL, GIMP_TYPE_PATTERN, FLAGS));
+  g_object_class_install_property (object_class, PROP_STROKE_WIDTH,
+    g_param_spec_double ("stroke-width", "Épaisseur", "Épaisseur du contour des objets",
+                         0.0, 2000.0, 1.0, FLAGS));
+  g_object_class_install_property (object_class, PROP_OPACITY,
+    g_param_spec_double ("opacity", "Opacité", "Opacité des objets",
+                         0.0, 1.0, 1.0, FLAGS));
+  g_object_class_install_property (object_class, PROP_X,
+    g_param_spec_double ("x", "X", "Position horizontale de la sélection",
+                         -GIMP_MAX_IMAGE_SIZE, GIMP_MAX_IMAGE_SIZE, 0.0, FLAGS));
+  g_object_class_install_property (object_class, PROP_Y,
+    g_param_spec_double ("y", "Y", "Position verticale de la sélection",
+                         -GIMP_MAX_IMAGE_SIZE, GIMP_MAX_IMAGE_SIZE, 0.0, FLAGS));
+  g_object_class_install_property (object_class, PROP_WIDTH,
+    g_param_spec_double ("width", "L", "Largeur de la sélection",
+                         0.0, GIMP_MAX_IMAGE_SIZE, 0.0, FLAGS));
+  g_object_class_install_property (object_class, PROP_HEIGHT,
+    g_param_spec_double ("height", "H", "Hauteur de la sélection",
+                         0.0, GIMP_MAX_IMAGE_SIZE, 0.0, FLAGS));
+  g_object_class_install_property (object_class, PROP_ROTATION,
+    g_param_spec_double ("rotation", "Rotation", "Angle de rotation (°)",
+                         -360.0, 360.0, 0.0, FLAGS));
+#undef FLAGS
+
+  g_object_unref (black);
+}
+
+static void
+chopgimp_vobject_props_init (ChopGimpVObjectProps *p)
+{
+  p->enable_fill  = TRUE;
+  p->fill_color   = gegl_color_new ("black");
+  p->stroke_color = gegl_color_new ("black");
+  p->stroke_width = 1.0;
+  p->opacity      = 1.0;
+}
+
+
+/*  ─── the widget ────────────────────────────────────────────────────── */
+
+static GtkWidget *
+field (ChopGimpVObjectProps *p,
+       const gchar          *prop,
+       const gchar          *label,
+       const gchar          *unit,
+       const gchar          *title,
+       gdouble               factor,
+       gint                  digits)
+{
+  GtkWidget *w = chopgimp_value_field_new (G_OBJECT (p), prop, label, unit);
+
+  if (! w)
+    return NULL;
+
+  if (factor != 1.0)
+    chopgimp_value_field_set_factor (CHOPGIMP_VALUE_FIELD (w), factor);
+  if (digits >= 0)
+    chopgimp_value_field_set_digits (CHOPGIMP_VALUE_FIELD (w), digits);
+  chopgimp_value_field_set_title (CHOPGIMP_VALUE_FIELD (w), title);
+  gtk_widget_set_visible (w, TRUE);
+
+  return w;
+}
+
+static void
+pack (GtkWidget *box,
+      GtkWidget *w)
+{
+  if (w)
+    {
+      gtk_box_pack_start (GTK_BOX (box), w, FALSE, FALSE, 0);
+      gtk_widget_set_visible (w, TRUE);
+    }
+}
+
+GtkWidget *
+chopgimp_vobject_bar_new (Gimp                      *gimp,
+                          ChopGimpColorDropdownFunc  color_dropdown)
+{
+  ChopGimpVObjectProps *p;
+  GimpContext          *context;
+  GtkWidget            *outer;
+  GtkWidget            *box;
+
+  g_return_val_if_fail (GIMP_IS_GIMP (gimp), NULL);
+
+  outer = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+
+  if (! chopgimp_vobjects_enabled ())
+    return outer;
+
+  p = g_object_new (CHOPGIMP_TYPE_VOBJECT_PROPS, NULL);
+  p->gimp = gimp;
+  g_object_set_data (G_OBJECT (p), "gimp", gimp);   /* for the color drop-downs */
+  g_object_set_data_full (G_OBJECT (outer), "chopgimp-vobject-props", p, g_object_unref);
+
+  box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  gtk_widget_set_no_show_all (box, TRUE);
+  gtk_box_pack_start (GTK_BOX (outer), box, FALSE, FALSE, 0);
+  p->content = box;
+
+  if (color_dropdown)
+    {
+      pack (box, color_dropdown (G_OBJECT (p), "fill-foreground",
+                                 _("Fond des objets"), _("Fond")));
+      pack (box, color_dropdown (G_OBJECT (p), "stroke-foreground",
+                                 _("Contour des objets"), _("Contour")));
+    }
+
+  pack (box, field (p, "stroke-width", _("Épaisseur"), "px",
+                    _("Épaisseur du contour des objets"), 1.0, 1));
+  pack (box, field (p, "opacity", _("Opacité"), "%",
+                    _("Opacité des objets"), 100.0, 0));
+  pack (box, gtk_separator_new (GTK_ORIENTATION_VERTICAL));
+  pack (box, field (p, "x", "X", "px", _("Position horizontale (bord gauche)"), 1.0, 1));
+  pack (box, field (p, "y", "Y", "px", _("Position verticale (bord haut)"), 1.0, 1));
+  pack (box, field (p, "width",  "L", "px", _("Largeur de la sélection"), 1.0, 1));
+  pack (box, field (p, "height", "H", "px", _("Hauteur de la sélection"), 1.0, 1));
+  pack (box, field (p, "rotation", _("Rotation"), "°",
+                    _("Angle de rotation des objets"), 1.0, 1));
+
+  context = gimp_get_user_context (gimp);
+  g_signal_connect_object (context, "image-changed",
+                           G_CALLBACK (props_image_changed), p, 0);
+  props_image_changed (context, gimp_context_get_image (context), p);
+  props_load (p);
+
+  return outer;
+}
