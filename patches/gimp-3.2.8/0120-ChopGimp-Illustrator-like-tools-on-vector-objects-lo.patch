+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vobject-ops.h — ChopGimp 3.27 (lot V2): commands on the
+ * selected objects of a vector layer (Objet menu, options bar, Move,
+ * Shape Builder and Pathfinder), built on the API of chopgimp-vobject.h
+ *
+ * Every command is one undo step and returns TRUE when it changed
+ * something; the caller flushes the image.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include "chopgimp-vobject.h"
+
+G_BEGIN_DECLS
+
+
+typedef enum
+{
+  CHOPGIMP_VARRANGE_FRONT,      /* Premier plan   */
+  CHOPGIMP_VARRANGE_FORWARD,    /* Avancer        */
+  CHOPGIMP_VARRANGE_BACKWARD,   /* Reculer        */
+  CHOPGIMP_VARRANGE_BACK        /* Arrière-plan   */
+} ChopGimpVArrange;
+
+typedef enum
+{
+  CHOPGIMP_VALIGN_LEFT,
+  CHOPGIMP_VALIGN_HCENTER,
+  CHOPGIMP_VALIGN_RIGHT,
+  CHOPGIMP_VALIGN_TOP,
+  CHOPGIMP_VALIGN_VCENTER,
+  CHOPGIMP_VALIGN_BOTTOM,
+  CHOPGIMP_VALIGN_DISTRIBUTE_H,
+  CHOPGIMP_VALIGN_DISTRIBUTE_V
+} ChopGimpVAlign;
+
+typedef enum
+{
+  CHOPGIMP_VPATHFINDER_UNION,
+  CHOPGIMP_VPATHFINDER_MINUS,       /* the bottom one minus the others */
+  CHOPGIMP_VPATHFINDER_INTERSECT,
+  CHOPGIMP_VPATHFINDER_EXCLUDE,
+  CHOPGIMP_VPATHFINDER_DIVIDE
+} ChopGimpVPathfinder;
+
+
+/*  a vector layer worked on as objects: not rasterized, objects enabled,
+ *  and several objects or already edited as objects
+ */
+gboolean          chopgimp_vobjects_layer_is_multi   (GimpVectorLayer *layer);
+/*  the only selected layer of @image when it is such a layer, else NULL
+ *  (always NULL with CHOPGIMP_NO_VOBJECTS=1)
+ */
+GimpVectorLayer * chopgimp_vobjects_get_active_layer (GimpImage       *image);
+gint              chopgimp_vobjects_n_selected       (GimpVectorLayer *layer);
+/*  the vector layer a new shape is added to (« Ajouter au calque
+ *  vectoriel actif »): the only selected layer when it is a vector layer
+ *  (one object or more), else NULL
+ */
+GimpVectorLayer * chopgimp_vobjects_get_target_layer (GimpImage       *image);
+/*  adds a new path object (@path in image coordinates) to @layer, in the
+ *  entered group or on top, and selects it; one undo step
+ */
+ChopGimpVObject * chopgimp_vobjects_add_path         (GimpVectorLayer *layer,
+                                                      GimpPath        *path,
+                                                      const gchar     *name,
+                                                      const ChopGimpVStyle *style);
+
+/*  the path objects of @object (itself for a path), bottom → top
+ *  (g_list_free only)
+ */
+GList           * chopgimp_vobjects_leaves_of        (ChopGimpVObject *object);
+/*  the first leaf of @object (its style), or NULL  */
+ChopGimpVObject * chopgimp_vobjects_first_leaf       (ChopGimpVObject *object);
+/*  @world (image coordinates) in the local space of @object: a new
+ *  unattached path (g_object_unref)
+ */
+GimpPath        * chopgimp_vobjects_path_to_local    (ChopGimpVObject *object,
+                                                      GimpPath        *world);
+/*  inserts @object whose path is in image coordinates into @parent
+ *  (NULL: root) at @position, corrected for the transformation of the
+ *  parent; no undo step (the caller pushed one)
+ */
+void              chopgimp_vobjects_insert_world     (GimpVectorLayer *layer,
+                                                      ChopGimpVObject *object,
+                                                      ChopGimpVObject *parent,
+                                                      gint             position);
+/*  the style of a new object made with the fill / stroke of a tool
+ *  (GimpPathOptions: enable-fill, fill-options, enable-stroke,
+ *  stroke-options), to clear with chopgimp_vstyle_clear()
+ */
+void              chopgimp_vobjects_style_from_tool  (ChopGimpVStyle  *style,
+                                                      GimpImage       *image,
+                                                      gboolean         enable_fill,
+                                                      GimpFillOptions *fill_options,
+                                                      gboolean         enable_stroke,
+                                                      GimpStrokeOptions *stroke_options);
+
+/*  ─── sensitivity ───────────────────────────────────────────────────── */
+
+gboolean          chopgimp_vobjects_can_group        (GimpVectorLayer *layer);
+gboolean          chopgimp_vobjects_can_ungroup      (GimpVectorLayer *layer);
+gboolean          chopgimp_vobjects_can_clip_make    (GimpVectorLayer *layer);
+gboolean          chopgimp_vobjects_can_clip_release (GimpVectorLayer *layer);
+gboolean          chopgimp_vobjects_can_pathfinder   (GimpVectorLayer *layer);
+
+/*  ─── commands ──────────────────────────────────────────────────────── */
+
+gboolean          chopgimp_vobjects_select_all       (GimpVectorLayer *layer);
+gboolean          chopgimp_vobjects_delete_selection (GimpVectorLayer *layer);
+/*  the copies go right above their originals and become the selection  */
+gboolean          chopgimp_vobjects_duplicate_selection (GimpVectorLayer *layer,
