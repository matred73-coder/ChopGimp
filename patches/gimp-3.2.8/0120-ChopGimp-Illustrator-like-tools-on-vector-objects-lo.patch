+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpconfig/gimpconfig.h"
+#include "libgimpmath/gimpmath.h"
+
+#include "path-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpchannel.h"
+#include "core/gimpfilloptions.h"
+#include "core/gimpimage.h"
+#include "core/gimpitem.h"
+#include "core/gimprasterizable.h"
+#include "core/gimpstrokeoptions.h"
+
+#include "gimppath.h"
+#include "gimpstroke.h"
+#include "gimpvectorlayer.h"
+#include "gimpvectorlayeroptions.h"
+#include "chopgimp-geom.h"
+#include "chopgimp-vobject.h"
+#include "chopgimp-vobject-ops.h"
+
+#include "gimp-intl.h"
+
+
+/*  ─── helpers ───────────────────────────────────────────────────────── */
+
+gboolean
+chopgimp_vobjects_layer_is_multi (GimpVectorLayer *layer)
+{
+  if (! chopgimp_vobjects_enabled () || ! GIMP_IS_VECTOR_LAYER (layer) ||
+      ! gimp_item_is_attached (GIMP_ITEM (layer)) ||
+      ! gimp_item_is_vector_layer (GIMP_ITEM (layer)) ||
+      ! chopgimp_vlayer_get_root (layer))
+    return FALSE;
+
+  return (chopgimp_vlayer_count_leaves (layer) >= 2 ||
+          ! chopgimp_vlayer_is_legacy (layer));
+}
+
+GimpVectorLayer *
+chopgimp_vobjects_get_active_layer (GimpImage *image)
+{
+  GList *layers;
+
+  if (! chopgimp_vobjects_enabled () || ! GIMP_IS_IMAGE (image))
+    return NULL;
+
+  layers = gimp_image_get_selected_layers (image);
+
+  if (g_list_length (layers) != 1 || ! GIMP_IS_VECTOR_LAYER (layers->data) ||
+      ! chopgimp_vobjects_layer_is_multi (layers->data))
+    return NULL;
+
+  return layers->data;
+}
+
+GimpVectorLayer *
+chopgimp_vobjects_get_target_layer (GimpImage *image)
+{
+  GList *layers;
+
+  if (! chopgimp_vobjects_enabled () || ! GIMP_IS_IMAGE (image))
+    return NULL;
+
+  layers = gimp_image_get_selected_layers (image);
+
+  if (g_list_length (layers) != 1 || ! GIMP_IS_VECTOR_LAYER (layers->data) ||
+      ! gimp_item_is_vector_layer (GIMP_ITEM (layers->data)) ||
+      ! chopgimp_vlayer_get_root (layers->data))
+    return NULL;
+
+  return layers->data;
+}
+
+ChopGimpVObject *
+chopgimp_vobjects_add_path (GimpVectorLayer      *layer,
+                            GimpPath             *path,
+                            const gchar          *name,
+                            const ChopGimpVStyle *style)
+{
+  GimpImage       *image   = gimp_item_get_image (GIMP_ITEM (layer));
+  guint            entered = chopgimp_vlayer_get_entered_group (layer);
+  ChopGimpVObject *parent  = entered ? chopgimp_vlayer_get_object (layer, entered) : NULL;
+  ChopGimpVObject *object;
+
+  object = chopgimp_vobject_new_path (image, path, name, style);
+
+  chopgimp_vlayer_push_undo (layer, _("Ajouter un objet"));
+  chopgimp_vlayer_freeze (layer);
+  chopgimp_vobjects_insert_world (layer, object, parent, -1);
+  chopgimp_vlayer_thaw (layer);
+
+  chopgimp_vlayer_set_selection (layer, &object->id, 1);
+  chopgimp_vobject_unref (object);   /* the layer holds it */
+
+  return object;
+}
+
+gint
+chopgimp_vobjects_n_selected (GimpVectorLayer *layer)
+{
+  gint n = 0;
+
+  if (! layer || ! chopgimp_vlayer_get_root (layer))
+    return 0;
+
+  chopgimp_vlayer_get_selection (layer, &n);
+
+  return n;
+}
+
+static void
+leaves_rec (ChopGimpVObject  *o,
+            GList           **list)
+{
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    {
+      *list = g_list_prepend (*list, o);
+      return;
+    }
+
+  for (guint i = 0; i < o->children->len; i++)
+    leaves_rec (g_ptr_array_index (o->children, i), list);
+}
+
+GList *
+chopgimp_vobjects_leaves_of (ChopGimpVObject *object)
+{
+  GList *list = NULL;
+
+  if (object)
+    leaves_rec (object, &list);
+
+  return g_list_reverse (list);
+}
+
+ChopGimpVObject *
+chopgimp_vobjects_first_leaf (ChopGimpVObject *object)
+{
+  GList           *leaves = chopgimp_vobjects_leaves_of (object);
+  ChopGimpVObject *first  = NULL;
+
+  for (GList *l = leaves; l && ! first; l = l->next)
+    if (gimp_path_get_n_strokes (((ChopGimpVObject *) l->data)->path) > 0)
+      first = l->data;
+
+  if (! first && leaves)
+    first = leaves->data;
+
+  g_list_free (leaves);
+
+  return first;
+}
+
+GimpPath *
+chopgimp_vobjects_path_to_local (ChopGimpVObject *object,
+                                 GimpPath        *world)
+{
+  GimpMatrix3  wm;
+  GimpPath    *local;
+  GimpStroke  *s;
+
+  local = gimp_path_new (gimp_item_get_image (GIMP_ITEM (world)),
+                         gimp_object_get_name (world));
+  g_object_ref_sink (local);
+
+  chopgimp_vobject_get_world_matrix (object, &wm);
+
+  if (gimp_matrix3_is_identity (&wm))
+    {
+      gimp_path_copy_strokes (world, local);
+      return local;
+    }
+
+  gimp_matrix3_invert (&wm);
+
+  gimp_path_freeze (local);
+
+  for (s = gimp_path_stroke_get_next (world, NULL); s;
+       s = gimp_path_stroke_get_next (world, s))
+    {
+      GimpStroke *d = gimp_stroke_duplicate (s);
+
+      gimp_stroke_transform (d, &wm, NULL);
+      gimp_path_stroke_add (local, d);
+      g_object_unref (d);
+    }
+
+  gimp_path_thaw (local);
+
+  return local;
+}
+
+void
+chopgimp_vobjects_insert_world (GimpVectorLayer *layer,
+                                ChopGimpVObject *object,
+                                ChopGimpVObject *parent,
+                                gint             position)
+{
+  GimpMatrix3 pw;
+
+  chopgimp_vlayer_insert (layer, object, parent, position, FALSE);
+
+  if (parent && parent->parent)
+    {
+      chopgimp_vobject_get_world_matrix (parent, &pw);
+
+      if (! gimp_matrix3_is_identity (&pw))
+        {
+          gimp_matrix3_invert (&pw);
+          chopgimp_vlayer_transform (layer, &object->id, 1, &pw, TRUE, FALSE);
+        }
+    }
+}
+
+void
+chopgimp_vobjects_style_from_tool (ChopGimpVStyle    *style,
+                                   GimpImage         *image,
+                                   gboolean           enable_fill,
+                                   GimpFillOptions   *fill_options,
+                                   gboolean           enable_stroke,
+                                   GimpStrokeOptions *stroke_options)
+{
+  GimpVectorLayerOptions *options;
+
+  options = g_object_new (GIMP_TYPE_VECTOR_LAYER_OPTIONS,
+                          "gimp", image->gimp,
+                          NULL);
+
+  g_object_set (options,
+                "enable-fill",   enable_fill,
+                "enable-stroke", enable_stroke,
+                NULL);
+
+  if (fill_options)
+    gimp_config_sync (G_OBJECT (fill_options),
+                      G_OBJECT (options->fill_options), 0);
+  if (stroke_options)
+    gimp_config_sync (G_OBJECT (stroke_options),
+                      G_OBJECT (options->stroke_options), 0);
+
+  chopgimp_vstyle_init (style);
+  chopgimp_vstyle_from_options (style, options);
+
+  g_object_unref (options);
+}
+
+/*  the selected objects, sorted bottom → top in their parent  */
+static gint
+cmp_index (gconstpointer a,
+           gconstpointer b)
+{
+  ChopGimpVObject *oa = *(ChopGimpVObject **) a;
+  ChopGimpVObject *ob = *(ChopGimpVObject **) b;
+
+  if (oa->parent != ob->parent)
+    return (oa->parent < ob->parent) ? -1 : 1;
+
+  return chopgimp_vobject_get_index (oa) - chopgimp_vobject_get_index (ob);
+}
+
+static GPtrArray *
+selected_sorted (GimpVectorLayer *layer)
+{
+  GPtrArray   *objs = g_ptr_array_new ();
+  const guint *ids;
+  gint         n = 0;
+
+  if (! layer || ! chopgimp_vlayer_get_root (layer))
+    return objs;
+
+  ids = chopgimp_vlayer_get_selection (layer, &n);
+
+  for (gint i = 0; i < n; i++)
+    {
+      ChopGimpVObject *o = chopgimp_vlayer_get_object (layer, ids[i]);
+
+      if (o && o->id != 0)
+        g_ptr_array_add (objs, o);
+    }
+
+  g_ptr_array_sort (objs, cmp_index);
+
+  return objs;
+}
+
+static gboolean
+same_parent (GPtrArray *objs)
+{
+  for (guint i = 1; i < objs->len; i++)
+    if (((ChopGimpVObject *) objs->pdata[i])->parent !=
+        ((ChopGimpVObject *) objs->pdata[0])->parent)
+      return FALSE;
+
+  return objs->len > 0;
+}
+
+static void
+begin (GimpVectorLayer *layer,
+       const gchar     *desc)
+{
+  chopgimp_vlayer_push_undo (layer, desc);
+  chopgimp_vlayer_freeze (layer);
+}
+
+static void
+end (GimpVectorLayer *layer)
+{
+  chopgimp_vlayer_thaw (layer);
+}
+
+static void
+select_objects (GimpVectorLayer *layer,
+                GPtrArray       *objs)
+{
+  guint *ids = g_new0 (guint, MAX (objs->len, 1));
+
+  for (guint i = 0; i < objs->len; i++)
+    ids[i] = ((ChopGimpVObject *) objs->pdata[i])->id;
+
+  chopgimp_vlayer_set_selection (layer, ids, objs->len);
+  g_free (ids);
+}
+
+
+/*  ─── sensitivity ───────────────────────────────────────────────────── */
+
+gboolean
+chopgimp_vobjects_can_group (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+  gboolean   ok   = same_parent (objs);
+
+  g_ptr_array_free (objs, TRUE);
+
+  return ok;
+}
+
+gboolean
+chopgimp_vobjects_can_ungroup (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+  gboolean   ok   = FALSE;
+
+  for (guint i = 0; i < objs->len && ! ok; i++)
+    if (((ChopGimpVObject *) objs->pdata[i])->kind == CHOPGIMP_VOBJECT_GROUP)
+      ok = TRUE;
+
+  g_ptr_array_free (objs, TRUE);
+
+  return ok;
+}
+
+gboolean
+chopgimp_vobjects_can_clip_make (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+  gboolean   ok   = objs->len >= 2 && same_parent (objs);
+
+  g_ptr_array_free (objs, TRUE);
+
+  return ok;
+}
+
+gboolean
+chopgimp_vobjects_can_clip_release (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+  gboolean   ok   = FALSE;
+
+  for (guint i = 0; i < objs->len && ! ok; i++)
+    if (((ChopGimpVObject *) objs->pdata[i])->clip)
+      ok = TRUE;
+
+  g_ptr_array_free (objs, TRUE);
+
+  return ok;
+}
+
+/*  the shapes of a Pathfinder operation, bottom first: the selected
+ *  objects, or the children of the only selected group
+ */
+static GPtrArray *
+pathfinder_inputs (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+
+  if (objs->len == 1 &&
+      ((ChopGimpVObject *) objs->pdata[0])->kind == CHOPGIMP_VOBJECT_GROUP)
+    {
+      ChopGimpVObject *group = objs->pdata[0];
+
+      g_ptr_array_set_size (objs, 0);
+
+      for (guint i = 0; i < group->children->len; i++)
+        g_ptr_array_add (objs, g_ptr_array_index (group->children, i));
+    }
+
+  if (objs->len < 2 || ! same_parent (objs))
+    g_ptr_array_set_size (objs, 0);
+
+  return objs;
+}
+
+gboolean
+chopgimp_vobjects_can_pathfinder (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = pathfinder_inputs (layer);
+  gboolean   ok   = objs->len >= 2;
+
+  g_ptr_array_free (objs, TRUE);
+
+  return ok;
+}
+
+
+/*  ─── commands ──────────────────────────────────────────────────────── */
+
+gboolean
+chopgimp_vobjects_select_all (GimpVectorLayer *layer)
+{
+  ChopGimpVObject *root = chopgimp_vlayer_get_root (layer);
+  ChopGimpVObject *context;
+  GPtrArray       *objs;
+  guint            entered;
+
+  if (! root)
+    return FALSE;
+
+  entered = chopgimp_vlayer_get_entered_group (layer);
+  context = entered ? chopgimp_vlayer_get_object (layer, entered) : NULL;
+
+  if (! context || context->kind != CHOPGIMP_VOBJECT_GROUP)
+    context = root;
+
+  objs = g_ptr_array_new ();
+
+  for (guint i = 0; i < context->children->len; i++)
+    {
+      ChopGimpVObject *o = g_ptr_array_index (context->children, i);
+
+      if (chopgimp_vobject_is_visible (o) && ! chopgimp_vobject_is_locked (o))
+        g_ptr_array_add (objs, o);
+    }
+
+  select_objects (layer, objs);
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_delete_selection (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+
+  if (objs->len == 0)
+    {
+      g_ptr_array_free (objs, TRUE);
+      return FALSE;
+    }
+
+  begin (layer, _("Supprimer les objets"));
+
+  for (guint i = 0; i < objs->len; i++)
+    chopgimp_vlayer_remove (layer, ((ChopGimpVObject *) objs->pdata[i])->id, FALSE);
+
+  end (layer);
+
+  chopgimp_vlayer_set_selection (layer, NULL, 0);
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_duplicate_selection (GimpVectorLayer *layer,
+                                       gboolean         push_undo)
+{
+  GPtrArray *objs   = selected_sorted (layer);
+  GPtrArray *copies = g_ptr_array_new ();
+  GimpImage *image  = gimp_item_get_image (GIMP_ITEM (layer));
+
+  if (objs->len == 0)
+    {
+      g_ptr_array_free (objs, TRUE);
+      g_ptr_array_free (copies, TRUE);
+      return FALSE;
+    }
+
+  if (push_undo)
+    chopgimp_vlayer_push_undo (layer, _("Dupliquer les objets"));
+
+  chopgimp_vlayer_freeze (layer);
+
+  /*  from the top: the indices of the objects below stay valid  */
+  for (gint i = (gint) objs->len - 1; i >= 0; i--)
+    {
+      ChopGimpVObject *o    = objs->pdata[i];
+      ChopGimpVObject *copy = chopgimp_vobject_copy (o, image);
+
+      chopgimp_vlayer_insert (layer, copy, o->parent,
+                              chopgimp_vobject_get_index (o) + 1, FALSE);
+      g_ptr_array_add (copies, copy);
+      chopgimp_vobject_unref (copy);
+    }
+
+  chopgimp_vlayer_thaw (layer);
+
+  select_objects (layer, copies);
+
+  g_ptr_array_free (objs, TRUE);
+  g_ptr_array_free (copies, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_group_selection (GimpVectorLayer *layer)
+{
+  GPtrArray       *objs = selected_sorted (layer);
+  ChopGimpVObject *group;
+  guint           *ids;
+
+  if (! same_parent (objs))
+    {
+      g_ptr_array_free (objs, TRUE);
+      return FALSE;
+    }
+
+  ids = g_new0 (guint, objs->len);
+  for (guint i = 0; i < objs->len; i++)
+    ids[i] = ((ChopGimpVObject *) objs->pdata[i])->id;
+
+  group = chopgimp_vlayer_group (layer, ids, objs->len, _("Groupe"), TRUE);
+
+  g_free (ids);
+  g_ptr_array_free (objs, TRUE);
+
+  if (! group)
+    return FALSE;
+
+  chopgimp_vlayer_set_selection (layer, &group->id, 1);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_ungroup_selection (GimpVectorLayer *layer)
+{
+  GPtrArray *objs     = selected_sorted (layer);
+  GPtrArray *children = g_ptr_array_new ();
+  gboolean   any      = FALSE;
+
+  for (guint i = 0; i < objs->len; i++)
+    if (((ChopGimpVObject *) objs->pdata[i])->kind == CHOPGIMP_VOBJECT_GROUP)
+      any = TRUE;
+
+  if (! any)
+    {
+      g_ptr_array_free (objs, TRUE);
+      g_ptr_array_free (children, TRUE);
+      return FALSE;
+    }
+
+  begin (layer, _("Dissocier"));
+
+  for (guint i = 0; i < objs->len; i++)
+    {
+      ChopGimpVObject *o = objs->pdata[i];
+
+      if (o->kind == CHOPGIMP_VOBJECT_GROUP)
+        {
+          guint id = o->id;
+
+          for (guint k = 0; k < o->children->len; k++)
+            g_ptr_array_add (children,
+                             chopgimp_vobject_ref (g_ptr_array_index (o->children, k)));
+
+          chopgimp_vlayer_ungroup (layer, id, FALSE);
+        }
+      else
+        {
+          g_ptr_array_add (children, chopgimp_vobject_ref (o));
+        }
+    }
+
+  end (layer);
+
+  select_objects (layer, children);
+
+  for (guint i = 0; i < children->len; i++)
+    chopgimp_vobject_unref (children->pdata[i]);
+
+  g_ptr_array_free (children, TRUE);
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+static gboolean
+is_in (GPtrArray       *objs,
+       ChopGimpVObject *o)
+{
+  return g_ptr_array_find (objs, o, NULL);
+}
+
+gboolean
+chopgimp_vobjects_arrange (GimpVectorLayer  *layer,
+                           ChopGimpVArrange  how)
+{
+  GPtrArray *objs    = selected_sorted (layer);
+  gboolean   changed = FALSE;
+  gint       i;
+
+  if (objs->len == 0)
+    {
+      g_ptr_array_free (objs, TRUE);
+      return FALSE;
+    }
+
+  begin (layer, _("Disposition des objets"));
+
+  switch (how)
+    {
+    case CHOPGIMP_VARRANGE_FRONT:
+      for (i = 0; i < (gint) objs->len; i++)
+        {
+          ChopGimpVObject *o = objs->pdata[i];
+
+          if (chopgimp_vobject_get_index (o) != (gint) o->parent->children->len - 1)
+            changed = TRUE;
+          chopgimp_vlayer_reorder (layer, o->id, o->parent, -1, FALSE);
+        }
+      break;
+
+    case CHOPGIMP_VARRANGE_BACK:
+      for (i = (gint) objs->len - 1; i >= 0; i--)
+        {
+          ChopGimpVObject *o = objs->pdata[i];
+
+          if (chopgimp_vobject_get_index (o) != 0)
+            changed = TRUE;
+          chopgimp_vlayer_reorder (layer, o->id, o->parent, 0, FALSE);
+        }
+      break;
+
+    case CHOPGIMP_VARRANGE_FORWARD:
+      for (i = (gint) objs->len - 1; i >= 0; i--)
+        {
+          ChopGimpVObject *o   = objs->pdata[i];
+          gint             idx = chopgimp_vobject_get_index (o);
+
+          if (idx + 1 < (gint) o->parent->children->len &&
+              ! is_in (objs, g_ptr_array_index (o->parent->children, idx + 1)))
+            {
+              chopgimp_vlayer_reorder (layer, o->id, o->parent, idx + 1, FALSE);
+              changed = TRUE;
+            }
+        }
+      break;
+
+    case CHOPGIMP_VARRANGE_BACKWARD:
+      for (i = 0; i < (gint) objs->len; i++)
+        {
+          ChopGimpVObject *o   = objs->pdata[i];
+          gint             idx = chopgimp_vobject_get_index (o);
+
+          if (idx > 0 &&
+              ! is_in (objs, g_ptr_array_index (o->parent->children, idx - 1)))
+            {
+              chopgimp_vlayer_reorder (layer, o->id, o->parent, idx - 1, FALSE);
+              changed = TRUE;
+            }
+        }
+      break;
+    }
+
+  end (layer);
+  g_ptr_array_free (objs, TRUE);
+
+  return changed;
+}
+
+static gboolean
+set_flags_selection (GimpVectorLayer *layer,
+                     const gchar     *desc,
+                     gint             visible,
+                     gint             locked)
+{
+  GPtrArray *objs = selected_sorted (layer);
+
+  if (objs->len == 0)
+    {
+      g_ptr_array_free (objs, TRUE);
+      return FALSE;
+    }
+
+  begin (layer, desc);
+
+  for (guint i = 0; i < objs->len; i++)
+    chopgimp_vlayer_set_props (layer, ((ChopGimpVObject *) objs->pdata[i])->id,
+                               NULL, -1.0, -1, visible, locked, FALSE);
+
+  end (layer);
+
+  chopgimp_vlayer_set_selection (layer, NULL, 0);
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_lock_selection (GimpVectorLayer *layer)
+{
+  return set_flags_selection (layer, _("Verrouiller les objets"), -1, 1);
+}
+
+gboolean
+chopgimp_vobjects_hide_selection (GimpVectorLayer *layer)
+{
+  return set_flags_selection (layer, _("Masquer les objets"), 0, -1);
+}
+
+static void
+collect_flagged (ChopGimpVObject *o,
+                 gboolean         hidden,
+                 GPtrArray       *out)
+{
+  if (o->id != 0 && (hidden ? ! o->visible : o->locked))
+    g_ptr_array_add (out, o);
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      collect_flagged (g_ptr_array_index (o->children, i), hidden, out);
+}
+
+static gboolean
+clear_flag_all (GimpVectorLayer *layer,
+                gboolean         hidden,
+                const gchar     *desc)
+{
+  ChopGimpVObject *root = chopgimp_vlayer_get_root (layer);
+  GPtrArray       *objs;
+
+  if (! root)
+    return FALSE;
+
+  objs = g_ptr_array_new ();
+  collect_flagged (root, hidden, objs);
+
+  if (objs->len > 0)
+    {
+      begin (layer, desc);
+
+      for (guint i = 0; i < objs->len; i++)
+        chopgimp_vlayer_set_props (layer, ((ChopGimpVObject *) objs->pdata[i])->id,
+                                   NULL, -1.0, -1,
+                                   hidden ? 1 : -1, hidden ? -1 : 0, FALSE);
+
+      end (layer);
+    }
+
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_unlock_all (GimpVectorLayer *layer)
+{
+  return clear_flag_all (layer, FALSE, _("Tout déverrouiller"));
+}
+
+gboolean
+chopgimp_vobjects_show_all (GimpVectorLayer *layer)
+{
+  return clear_flag_all (layer, TRUE, _("Tout afficher"));
+}
+
+typedef struct
+{
+  guint   id;
+  gdouble x1, y1, x2, y2;
+} Box;
+
+static gint
+cmp_box_x (gconstpointer a, gconstpointer b)
+{
+  gdouble d = ((const Box *) a)->x1 - ((const Box *) b)->x1;
+
+  return d < 0 ? -1 : d > 0 ? 1 : 0;
+}
+
+static gint
+cmp_box_y (gconstpointer a, gconstpointer b)
+{
+  gdouble d = ((const Box *) a)->y1 - ((const Box *) b)->y1;
+
+  return d < 0 ? -1 : d > 0 ? 1 : 0;
+}
+
+gboolean
+chopgimp_vobjects_align (GimpVectorLayer *layer,
+                         ChopGimpVAlign   mode)
+{
+  GPtrArray *objs  = selected_sorted (layer);
+  GimpImage *image = gimp_item_get_image (GIMP_ITEM (layer));
+  GArray    *boxes = g_array_new (FALSE, FALSE, sizeof (Box));
+  gdouble    rx1, ry1, rx2, ry2;
+  gboolean   dist  = (mode == CHOPGIMP_VALIGN_DISTRIBUTE_H ||
+                      mode == CHOPGIMP_VALIGN_DISTRIBUTE_V);
+
+  for (guint i = 0; i < objs->len; i++)
+    {
+      ChopGimpVObject *o = objs->pdata[i];
+      Box              b;
+
+      if (chopgimp_vobject_is_locked (o))
+        continue;
+
+      b.id = o->id;
+      if (chopgimp_vobject_get_bounds (layer, o, TRUE, &b.x1, &b.y1, &b.x2, &b.y2))
+        g_array_append_val (boxes, b);
+    }
+
+  g_ptr_array_free (objs, TRUE);
+
+  if (boxes->len == 0 || (dist && boxes->len < 3))
+    {
+      g_array_free (boxes, TRUE);
+      return FALSE;
+    }
+
+  /*  the reference rectangle  */
+  if (boxes->len == 1)
+    {
+      GimpChannel *mask = gimp_image_get_mask (image);
+
+      if (! gimp_channel_is_empty (mask))
+        {
+          gint x, y, w, h;
+
+          gimp_item_bounds (GIMP_ITEM (mask), &x, &y, &w, &h);
+          rx1 = x; ry1 = y; rx2 = x + w; ry2 = y + h;
+        }
+      else
+        {
+          rx1 = ry1 = 0;
+          rx2 = gimp_image_get_width  (image);
+          ry2 = gimp_image_get_height (image);
+        }
+    }
+  else
+    {
+      rx1 = ry1 = G_MAXDOUBLE;
+      rx2 = ry2 = -G_MAXDOUBLE;
+
+      for (guint i = 0; i < boxes->len; i++)
+        {
+          Box *b = &g_array_index (boxes, Box, i);
+
+          rx1 = MIN (rx1, b->x1); ry1 = MIN (ry1, b->y1);
+          rx2 = MAX (rx2, b->x2); ry2 = MAX (ry2, b->y2);
+        }
+    }
+
+  begin (layer, dist ? _("Répartir les objets") : _("Aligner les objets"));
+
+  if (dist)
+    {
+      gboolean h     = (mode == CHOPGIMP_VALIGN_DISTRIBUTE_H);
+      gdouble  total = 0.0, gap, pos;
+
+      g_array_sort (boxes, h ? cmp_box_x : cmp_box_y);
+
+      for (guint i = 0; i < boxes->len; i++)
+        {
+          Box *b = &g_array_index (boxes, Box, i);
+
+          total += h ? b->x2 - b->x1 : b->y2 - b->y1;
+        }
+
+      gap = ((h ? rx2 - rx1 : ry2 - ry1) - total) / (boxes->len - 1);
+      pos = h ? rx1 : ry1;
+
+      for (guint i = 0; i < boxes->len; i++)
+        {
+          Box *b = &g_array_index (boxes, Box, i);
+
+          if (h)
+            chopgimp_vlayer_translate (layer, &b->id, 1, pos - b->x1, 0, FALSE);
+          else
+            chopgimp_vlayer_translate (layer, &b->id, 1, 0, pos - b->y1, FALSE);
+
+          pos += (h ? b->x2 - b->x1 : b->y2 - b->y1) + gap;
+        }
+    }
+  else
+    {
+      for (guint i = 0; i < boxes->len; i++)
+        {
+          Box     *b  = &g_array_index (boxes, Box, i);
+          gdouble  dx = 0.0, dy = 0.0;
+
+          switch (mode)
+            {
+            case CHOPGIMP_VALIGN_LEFT:    dx = rx1 - b->x1; break;
+            case CHOPGIMP_VALIGN_HCENTER: dx = (rx1 + rx2 - b->x1 - b->x2) / 2.0; break;
+            case CHOPGIMP_VALIGN_RIGHT:   dx = rx2 - b->x2; break;
+            case CHOPGIMP_VALIGN_TOP:     dy = ry1 - b->y1; break;
+            case CHOPGIMP_VALIGN_VCENTER: dy = (ry1 + ry2 - b->y1 - b->y2) / 2.0; break;
+            case CHOPGIMP_VALIGN_BOTTOM:  dy = ry2 - b->y2; break;
+            default: break;
+            }
+
+          if (dx != 0.0 || dy != 0.0)
+            chopgimp_vlayer_translate (layer, &b->id, 1, dx, dy, FALSE);
+        }
+    }
+
+  end (layer);
+  g_array_free (boxes, TRUE);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vobjects_clip_make (GimpVectorLayer *layer)
+{
+  GPtrArray       *objs = selected_sorted (layer);
+  ChopGimpVObject *group;
+  guint           *ids;
+
+  if (objs->len < 2 || ! same_parent (objs))
+    {
+      g_ptr_array_free (objs, TRUE);
+      return FALSE;
+    }
+
+  ids = g_new0 (guint, objs->len);
+  for (guint i = 0; i < objs->len; i++)
+    ids[i] = ((ChopGimpVObject *) objs->pdata[i])->id;
+
+  begin (layer, _("Créer un masque d'écrêtage"));
+
+  group = chopgimp_vlayer_group (layer, ids, objs->len, _("Groupe de découpe"), FALSE);
+  if (group)
+    chopgimp_vlayer_set_clip (layer, group->id, TRUE, FALSE);
+
+  end (layer);
+
+  if (group)
+    chopgimp_vlayer_set_selection (layer, &group->id, 1);
+
+  g_free (ids);
+  g_ptr_array_free (objs, TRUE);
+
+  return group != NULL;
+}
+
+gboolean
+chopgimp_vobjects_clip_release (GimpVectorLayer *layer)
+{
+  GPtrArray *objs = selected_sorted (layer);
+  gboolean   any  = FALSE;
+
+  for (guint i = 0; i < objs->len; i++)
+    if (((ChopGimpVObject *) objs->pdata[i])->clip)
+      any = TRUE;
+
+  if (any)
+    {
+      begin (layer, _("Libérer le masque d'écrêtage"));
+
+      for (guint i = 0; i < objs->len; i++)
+        if (((ChopGimpVObject *) objs->pdata[i])->clip)
+          chopgimp_vlayer_set_clip (layer, ((ChopGimpVObject *) objs->pdata[i])->id,
+                                    FALSE, FALSE);
+
+      end (layer);
+    }
+
+  g_ptr_array_free (objs, TRUE);
+
+  return any;
+}
+
+/*  the input that gives its style to a piece: the topmost one containing
+ *  a point of it
+ */
+static ChopGimpVObject *
+piece_owner (GPtrArray *inputs,
+             GPtrArray *worlds,
+             GimpPath  *piece)
+{
+  gdouble x, y;
+
+  if (chopgimp_geom_interior_point (piece, &x, &y))
+    for (gint i = (gint) inputs->len - 1; i >= 0; i--)
+      if (chopgimp_geom_contains (worlds->pdata[i], x, y))
+        return inputs->pdata[i];
+
+  return inputs->pdata[inputs->len - 1];
+}
+
+gboolean
+chopgimp_vobjects_pathfinder (GimpVectorLayer     *layer,
+                              ChopGimpVPathfinder  op)
+{
+  GimpImage       *image  = gimp_item_get_image (GIMP_ITEM (layer));
+  GPtrArray       *inputs = pathfinder_inputs (layer);
+  GPtrArray       *worlds;
+  GPtrArray       *result;
+  ChopGimpVObject *top, *parent;
+  gint             position;
+  static const gchar *const descs[] =
+  {
+    N_("Pathfinder : réunir"), N_("Pathfinder : soustraire"),
+    N_("Pathfinder : intersection"), N_("Pathfinder : exclure"),
+    N_("Pathfinder : diviser")
+  };
+
+  if (inputs->len < 2)
+    {
+      g_ptr_array_free (inputs, TRUE);
+      return FALSE;
+    }
+
+  worlds = g_ptr_array_new_with_free_func (g_object_unref);
+  for (guint i = 0; i < inputs->len; i++)
+    {
+      GimpPath *w = chopgimp_vobject_get_world_path (layer, inputs->pdata[i], FALSE);
+
+      g_object_ref_sink (w);
+      g_ptr_array_add (worlds, w);
+    }
+
+  top      = inputs->pdata[inputs->len - 1];
+  parent   = top->parent;
+  position = chopgimp_vobject_get_index (top) + 1;
+  result   = g_ptr_array_new ();
+
+  if (op == CHOPGIMP_VPATHFINDER_DIVIDE)
+    {
+      gint       n_pieces = 0;
+      GimpPath **pieces   = chopgimp_geom_divide ((GimpPath **) worlds->pdata,
+                                                  worlds->len, &n_pieces);
+
+      if (pieces && n_pieces > 0)
+        {
+          ChopGimpVObject *group;
+
+          begin (layer, _(descs[op]));
+
+          group = chopgimp_vobject_new_group (_("Division"));
+          chopgimp_vlayer_insert (layer, group, parent, position, FALSE);
+
+          for (gint i = 0; i < n_pieces; i++)
+            {
+              ChopGimpVObject *owner = chopgimp_vobjects_first_leaf (piece_owner (inputs, worlds,
+                                                                                  pieces[i]));
+              ChopGimpVObject *piece;
+
+              piece = chopgimp_vobject_new_path (image, pieces[i],
+                                                 owner ? owner->name : _("Morceau"),
+                                                 owner ? &owner->style : NULL);
+              chopgimp_vobjects_insert_world (layer, piece, group, -1);
+              chopgimp_vobject_unref (piece);
+              g_object_unref (pieces[i]);
+            }
+
+          g_ptr_array_add (result, group);
+          chopgimp_vobject_unref (group);
+        }
+
+      g_free (pieces);
+    }
+  else
+    {
+      static const ChopGimpBoolOp ops[] = { CHOPGIMP_BOOL_UNION, CHOPGIMP_BOOL_DIFFERENCE,
+                                            CHOPGIMP_BOOL_INTERSECTION,
+                                            CHOPGIMP_BOOL_EXCLUSION };
+      GimpPath *shape = chopgimp_geom_boolean ((GimpPath **) worlds->pdata, worlds->len,
+                                               ops[op]);
+
+      if (shape)
+        {
+          ChopGimpVObject *src   = (op == CHOPGIMP_VPATHFINDER_MINUS) ? inputs->pdata[0] : top;
+          ChopGimpVObject *style = chopgimp_vobjects_first_leaf (src);
+          ChopGimpVObject *obj;
+
+          begin (layer, _(descs[op]));
+
+          obj = chopgimp_vobject_new_path (image, shape, src->name,
+                                           style ? &style->style : NULL);
+
+          /*  a union fills everything inside it, even when lib2geom had
+           *  to give back the operands (shared edges)
+           */
+          if (op == CHOPGIMP_VPATHFINDER_UNION)
+            obj->style.fill_nonzero = TRUE;
+          chopgimp_vobjects_insert_world (layer, obj, parent, position);
+          g_ptr_array_add (result, obj);
+          chopgimp_vobject_unref (obj);
+          g_object_unref (shape);
+        }
+    }
+
+  if (result->len > 0)
+    {
+      for (guint i = 0; i < inputs->len; i++)
+        chopgimp_vlayer_remove (layer, ((ChopGimpVObject *) inputs->pdata[i])->id, FALSE);
+
+      end (layer);
+
+      select_objects (layer, result);
+    }
+
+  {
+    gboolean done = result->len > 0;
+
+    g_ptr_array_free (result, TRUE);
+    g_ptr_array_free (worlds, TRUE);
+    g_ptr_array_free (inputs, TRUE);
+
+    return done;
+  }
+}
+
+gboolean
+chopgimp_vobjects_copy_style (GimpVectorLayer *layer,
+                              ChopGimpVObject *from)
+{
+  GPtrArray       *objs = selected_sorted (layer);
+  ChopGimpVObject *leaf = chopgimp_vobjects_first_leaf (from);
+  ChopGimpVStyle   style;
+
+  if (! leaf || objs->len == 0)
+    {
+      g_ptr_array_free (objs, TRUE);
+      return FALSE;
+    }
+
+  /*  a copy: setting the style of @from itself would free it  */
+  chopgimp_vstyle_init (&style);
+  chopgimp_vstyle_copy (&style, &leaf->style);
+
+  begin (layer, _("Pipette de style"));
+
+  for (guint i = 0; i < objs->len; i++)
+    if (objs->pdata[i] != leaf)
+      chopgimp_vlayer_set_style (layer, ((ChopGimpVObject *) objs->pdata[i])->id,
+                                 &style, FALSE);
+
+  end (layer);
+
+  chopgimp_vstyle_clear (&style);
+  g_ptr_array_free (objs, TRUE);
+
+  return TRUE;
+}
