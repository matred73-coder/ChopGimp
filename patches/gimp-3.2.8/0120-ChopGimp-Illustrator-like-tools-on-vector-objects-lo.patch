+
+/*  ─── ChopGimp 3.27 lot V2: objects of vector layers ──────────────── */
+
+static gboolean
+gimp_path_tool_is_direct (GimpPathTool *path_tool)
+{
+  return g_object_get_data (G_OBJECT (path_tool), "chopgimp-direct-select") != NULL;
+}
+
+static void
+gimp_path_tool_vobj_detach (GimpPathTool *path_tool)
+{
+  if (path_tool->vobj_layer)
+    {
+      g_signal_handlers_disconnect_by_data (path_tool->vobj_layer, path_tool);
+      g_object_remove_weak_pointer (G_OBJECT (path_tool->vobj_layer),
+                                    (gpointer *) &path_tool->vobj_layer);
+      path_tool->vobj_layer = NULL;
+    }
+
+  if (path_tool->vobj_path)
+    {
+      g_signal_handlers_disconnect_by_data (path_tool->vobj_path, path_tool);
+      path_tool->vobj_path = NULL;   /* the reference is path_tool->path's */
+    }
+
+  path_tool->vobj_id = 0;
+}
+
+/*  the edited copy changed (a node moved…): into the object  */
+static void
+gimp_path_tool_vobj_thaw (GimpPath     *path,
+                          GimpPathTool *path_tool)
+{
+  ChopGimpVObject *o;
+  GimpPath        *local;
+
+  if (path_tool->vobj_writing || ! path_tool->vobj_layer)
+    return;
+
+  o = chopgimp_vlayer_get_object (path_tool->vobj_layer, path_tool->vobj_id);
+  if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+    return;
+
+  local = chopgimp_vobjects_path_to_local (o, path);
+
+  path_tool->vobj_writing = TRUE;
+  chopgimp_vlayer_set_path (path_tool->vobj_layer, o->id, local, FALSE);
+  path_tool->vobj_writing = FALSE;
+
+  g_object_unref (local);
+
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (path_tool->vobj_layer)));
+}
+
+/*  the object changed elsewhere (undo…): the edited copy follows  */
+static void
+gimp_path_tool_vobj_changed (GimpVectorLayer *layer,
+                             gpointer         dirty,
+                             GimpPathTool    *path_tool)
+{
+  ChopGimpVObject *o;
+  GimpPath        *world;
+  GimpStroke      *s;
+
+  if (path_tool->vobj_writing || ! path_tool->vobj_path)
+    return;
+
+  o = chopgimp_vlayer_get_object (layer, path_tool->vobj_id);
+
+  if (! o || o->kind != CHOPGIMP_VOBJECT_PATH)
+    {
+      gimp_path_tool_set_path (path_tool, NULL, NULL);
+      return;
+    }
+
+  world = chopgimp_vobject_get_world_path (layer, o, FALSE);
+  g_object_ref_sink (world);
+
+  path_tool->vobj_writing = TRUE;
+  gimp_path_freeze (path_tool->vobj_path);
+
+  while ((s = gimp_path_stroke_get_next (path_tool->vobj_path, NULL)))
+    gimp_path_stroke_remove (path_tool->vobj_path, s);
+
+  gimp_path_copy_strokes (world, path_tool->vobj_path);
+  gimp_path_thaw (path_tool->vobj_path);
+  path_tool->vobj_writing = FALSE;
+
+  g_object_unref (world);
+}
+
+/*  Direct Selection (A) on an object: its nodes only  */
+static void
+gimp_path_tool_vobj_edit (GimpPathTool    *path_tool,
+                          GimpVectorLayer *layer,
+                          ChopGimpVObject *object)
+{
+  GimpPath *world = chopgimp_vobject_get_world_path (layer, object, FALSE);
+
+  g_object_ref_sink (world);
+  gimp_object_set_name (GIMP_OBJECT (world), object->name);
+
+  gimp_path_tool_set_layer (path_tool, NULL);
+  gimp_path_tool_set_path (path_tool, NULL, NULL);
+
+  gimp_path_tool_set_path (path_tool, NULL, world);
+  g_object_unref (world);
+
+  if (path_tool->path != world)
+    return;
+
+  path_tool->vobj_path  = world;
+  path_tool->vobj_layer = layer;
+  path_tool->vobj_id    = object->id;
+  g_object_add_weak_pointer (G_OBJECT (layer), (gpointer *) &path_tool->vobj_layer);
+
+  g_signal_connect_after (world, "thaw",
+                          G_CALLBACK (gimp_path_tool_vobj_thaw), path_tool);
+  g_signal_connect (layer, "objects-changed",
+                    G_CALLBACK (gimp_path_tool_vobj_changed), path_tool);
+
+  chopgimp_vlayer_set_selection (layer, &object->id, 1);
+}
+
+/*  TRUE when the press was used  */
+static gboolean
+gimp_path_tool_vobj_press (GimpPathTool     *path_tool,
+                           const GimpCoords *coords,
+                           GdkModifierType   state,
+                           GimpDisplay      *display)
+{
+  GimpTool         *tool  = GIMP_TOOL (path_tool);
+  GimpImage        *image = gimp_display_get_image (display);
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  GimpVectorLayer  *layer = chopgimp_vobjects_get_active_layer (image);
+  ChopGimpVObject  *leaf;
+
+  if (! layer)
+    return FALSE;
+
+  /*  on the nodes of the edited object: the path widget  */
+  if (path_tool->vobj_layer == layer && path_tool->widget &&
+      tool->display == display &&
+      gimp_tool_widget_hit (path_tool->widget, coords, state, TRUE) != GIMP_HIT_NONE)
+    return FALSE;
+
+  leaf = chopgimp_vlayer_hit_test (layer, coords->x, coords->y,
+                                   3.0 / MAX (shell->scale_x, 1e-6),
+                                   CHOPGIMP_HIT_LEAF);
+
+  if (leaf && (leaf->id != path_tool->vobj_id || path_tool->vobj_layer != layer))
+    {
+      gimp_path_tool_vobj_edit (path_tool, layer, leaf);
+      gimp_image_flush (image);
+
+      if (path_tool->widget)
+        gimp_tool_widget_hover (path_tool->widget, coords, state, TRUE);
+
+      return FALSE;   /* the press goes on to the nodes */
+    }
+
+  /*  in the void: a selection rectangle on the edited object's nodes,
+   *  never a new path
+   */
+  return (path_tool->vobj_layer != layer || ! path_tool->widget);
+}
