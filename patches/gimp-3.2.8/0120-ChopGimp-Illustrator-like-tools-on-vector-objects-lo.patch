+/*  ChopGimp lot V2: the shapes are the path objects of the selected
+ *  objects (all the objects when none is selected)
+ */
+static void
+shape_builder_update_objects (GimpShapeBuilderTool *sb,
+                              GimpVectorLayer      *layer)
+{
+  GList     *objs   = chopgimp_vlayer_get_selected_objects (layer);
+  GList     *leaves = NULL;
+  GimpPath **pieces;
+  gint       n_pieces = 0;
+
+  sb->vlayer = layer;
+
+  if (objs)
+    {
+      for (GList *o = objs; o; o = o->next)
+        leaves = g_list_concat (leaves, chopgimp_vobjects_leaves_of (o->data));
+      g_list_free (objs);
+    }
+  else
+    {
+      leaves = chopgimp_vlayer_get_leaves (layer);
+    }
+
+  for (GList *l = leaves; l && sb->objs->len < MAX_SHAPES * 2; l = l->next)
+    {
+      ChopGimpVObject *o = l->data;
+      GimpPath        *w;
+
+      if (! chopgimp_vobject_is_visible (o) || chopgimp_vobject_is_locked (o) ||
+          gimp_path_get_n_strokes (o->path) == 0)
+        continue;
+
+      w = chopgimp_vobject_get_world_path (layer, o, FALSE);
+      g_object_ref_sink (w);
+
+      g_ptr_array_add (sb->objs, chopgimp_vobject_ref (o));
+      g_ptr_array_add (sb->worlds, w);
+    }
+
+  g_list_free (leaves);
+
+  if (sb->objs->len == 0)
+    return;
+
+  pieces = chopgimp_geom_divide ((GimpPath **) sb->worlds->pdata, sb->worlds->len,
+                                 &n_pieces);
+
+  for (gint i = 0; i < n_pieces; i++)
+    g_ptr_array_add (sb->regions, pieces[i]);
+
+  g_free (pieces);
+}
