From b16c32fe6e24fb55638843f496b8d2ea59d1deef Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Sat, 14 Nov 2026 22:19:02 +0100
Subject: [PATCH] ChopGimp: plug-in dialogs not modal (GNOME
 attach-modal-dialogs closed them at once)

---
 libgimp/gimpui.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/libgimp/gimpui.c b/libgimp/gimpui.c
index 8adc1c6..8665db6 100644
--- a/libgimp/gimpui.c
+++ b/libgimp/gimpui.c
@@ -275,6 +275,12 @@ chopgimp_dialog_realize_hook (GSignalInvocationHint *ihint,
       GBytes *handle = gimp_progress_get_window_handle ();
 
       g_object_set_data (object, "chopgimp-transient", GINT_TO_POINTER (1));
+      /*  « modale » n'a pas de sens entre deux processus (le greffon ne
+       *  bloque pas ChopGimp), et GNOME avec « attach-modal-dialogs »
+       *  (réglage par défaut d'Ubuntu) referme aussitôt une fenêtre modale
+       *  rattachée à la fenêtre d'un autre programme.
+       */
+      gtk_window_set_modal (GTK_WINDOW (object), FALSE);
       if (handle)
         gimp_window_set_transient (GTK_WINDOW (object));
       else
-- 
2.53.0

