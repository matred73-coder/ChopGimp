+/*  ChopGimp 3.28.3: [ and ] for the « Sélection rapide »  */
+void
+tools_paint_select_size_cmd_callback (GimpAction *action,
+                                      GVariant   *value,
+                                      gpointer    data)
+{
+  GimpContext          *context;
+  GimpToolInfo         *tool_info;
+  GimpActionSelectType  select_type;
+  return_if_no_context (context, data);
+
+  select_type = (GimpActionSelectType) g_variant_get_int32 (value);
+
+  tool_info = gimp_context_get_tool (context);
+
+  if (tool_info && GIMP_IS_PAINT_SELECT_OPTIONS (tool_info->tool_options))
+    {
+      action_select_property (select_type,
+                              action_data_get_display (data),
+                              G_OBJECT (tool_info->tool_options),
+                              "stroke-width",
+                              1.0, 4.0, 16.0, 0.1, FALSE);
+    }
+}
+
 void
 tools_transform_preview_opacity_cmd_callback (GimpAction *action,
                                               GVariant   *value,
@@ -941,3 +1070,58 @@ tools_activate_enum_action (const gchar *action_desc,
         }
     }
 }
+
+
+/*  PhotoGIMP Pro (Photoshop): number keys set the opacity  */
+void
+tools_ps_opacity_cmd_callback (GimpAction *action,
+                               GVariant   *value,
+                               gpointer    data)
+{
+  GimpContext *context;
+  GimpTool    *tool;
+  const gchar *name;
+  const gchar *dash;
+  gdouble      opacity;
+  return_if_no_context (context, data);
+
+  name = gimp_action_get_name (action);
+  dash = strrchr (name, '-');
+
+  if (! dash)
+    return;
+
+  opacity = CLAMP (g_ascii_strtod (dash + 1, NULL) / 100.0, 0.0, 1.0);
+
+  tool = tool_manager_get_active (context->gimp);
+
+  if (tool && GIMP_IS_PAINT_TOOL (tool))
+    {
+      g_object_set (tool->tool_info->tool_options,
+                    "opacity", opacity,
+                    NULL);
+    }
+  else
+    {
+      GimpImage *image = gimp_context_get_image (context);
+      GList     *layers;
+      GList     *iter;
+
+      if (! image)
+        return;
+
+      layers = gimp_image_get_selected_layers (image);
+
+      if (! layers)
+        return;
+
+      gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_ITEM_PROPERTIES,
+                                   _("Set Layer Opacity"));
+
+      for (iter = layers; iter; iter = iter->next)
+        gimp_layer_set_opacity (iter->data, opacity, TRUE);
+
+      gimp_image_undo_group_end (image);
+      gimp_image_flush (image);
+    }
+}
