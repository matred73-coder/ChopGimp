+#include "gimpoperationcontour.h"
+
+
+/*  Photoshop's contours (the same nicks as GEGL's "contour" of
+ *  gegl:dropshadow / gegl:inner-glow, which the PSD export maps to
+ *  Photoshop's named curves)
+ */
+typedef enum
+{
+  GIMP_SATIN_CONTOUR_LINEAR,
+  GIMP_SATIN_CONTOUR_CONE,
+  GIMP_SATIN_CONTOUR_CONE_INVERTED,
+  GIMP_SATIN_CONTOUR_GAUSSIAN,
+  GIMP_SATIN_CONTOUR_HALF_ROUND,
+  GIMP_SATIN_CONTOUR_RING,
+  GIMP_SATIN_CONTOUR_RING_DOUBLE
+} GimpSatinContour;
+
+#define GIMP_TYPE_SATIN_CONTOUR (gimp_satin_contour_get_type ())
+
+GType gimp_satin_contour_get_type (void) G_GNUC_CONST;
+
+
+#define GIMP_TYPE_OPERATION_SATIN            (gimp_operation_satin_get_type ())
+#define GIMP_OPERATION_SATIN(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), GIMP_TYPE_OPERATION_SATIN, GimpOperationSatin))
+#define GIMP_IS_OPERATION_SATIN(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), GIMP_TYPE_OPERATION_SATIN))
+
+#define GIMP_TYPE_OPERATION_PATTERN_OVERLAY  (gimp_operation_pattern_overlay_get_type ())
+#define GIMP_IS_OPERATION_PATTERN_OVERLAY(obj) (G_TYPE_CHECK_INSTANCE_TYPE ((obj), GIMP_TYPE_OPERATION_PATTERN_OVERLAY))
+
+
+typedef struct _GimpOperationSatin                GimpOperationSatin;
+typedef struct _GimpOperationSatinClass           GimpOperationSatinClass;
+typedef struct _GimpOperationPatternOverlay       GimpOperationPatternOverlay;
+typedef struct _GimpOperationPatternOverlayClass  GimpOperationPatternOverlayClass;
+
+struct _GimpOperationSatin
+{
+  GimpOperationContour  parent_instance;
+
+  gdouble               angle;      /*  degrees, Photoshop's light angle  */
+  gdouble               distance;   /*  pixels                            */
+  gdouble               size;       /*  pixels (blur)                     */
+  gboolean              invert;
+  GimpSatinContour      contour;
+};
+
+struct _GimpOperationSatinClass
+{
+  GimpOperationContourClass  parent_class;
+};
+
+struct _GimpOperationPatternOverlay
+{
+  GimpOperationContour  parent_instance;
+};
+
+struct _GimpOperationPatternOverlayClass
+{
+  GimpOperationContourClass  parent_class;
+};
+
+
+GType   gimp_operation_satin_get_type           (void) G_GNUC_CONST;
+GType   gimp_operation_pattern_overlay_get_type (void) G_GNUC_CONST;
