+    }
+}
+
+static void
+gimp_operation_satin_set_property (GObject      *object,
+                                   guint         property_id,
+                                   const GValue *value,
+                                   GParamSpec   *pspec)
+{
+  GimpOperationSatin *self = GIMP_OPERATION_SATIN (object);
+
+  switch (property_id)
+    {
+    case PROP_ANGLE:
+      self->angle = g_value_get_double (value);
+      break;
+
+    case PROP_DISTANCE:
+      self->distance = g_value_get_double (value);
