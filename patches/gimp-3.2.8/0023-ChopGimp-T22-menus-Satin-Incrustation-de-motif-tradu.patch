+
+/*  the radius of each of the 3 box blurs approximating a gaussian of
+ *  standard deviation size / 2 (Photoshop's size, as for the glows:
+ *  psd-chopgimp.c, size_spread())
+ */
+static gint
+gimp_operation_satin_box_radius (gdouble size)
+{
+  gdouble sigma = size / 2.0;
+  gdouble w     = sqrt (4.0 * sigma * sigma + 1.0);
+
+  return MAX (0, (gint) floor ((w - 1.0) / 2.0 + 0.5));
+}
+
+static gint
+gimp_operation_satin_margin (GimpOperationContour *contour,
+                             gdouble               scale)
+{
+  GimpOperationSatin *self = GIMP_OPERATION_SATIN (contour);
+  gint                r    = gimp_operation_satin_box_radius (self->size * scale);
+
+  return (gint) ceil (self->distance * scale) + 3 * r + 2;
+}
+
+/*  one box blur of radius r along n values (stride apart), zero outside  */
+static void
+satin_box_1d (gfloat *data,
+              gint    n,
+              gint    stride,
+              gint    r,
+              gfloat *tmp)
+{
+  gfloat sum = 0.0f;
+  gfloat inv = 1.0f / (2 * r + 1);
+  gint   i;
+
+  for (i = 0; i < n; i++)
+    tmp[i] = data[(gsize) i * stride];
+
+  for (i = 0; i < MIN (r, n); i++)
+    sum += tmp[i];
+
+  for (i = 0; i < n; i++)
+    {
+      if (i + r < n)
+        sum += tmp[i + r];
+
+      if (i - r - 1 >= 0)
+        sum -= tmp[i - r - 1];
+
+      data[(gsize) i * stride] = MAX (sum, 0.0f) * inv;
+    }
+}
+
+/*  the blurred alpha at x, y (buffer coordinates, pixel centers at
+ *  .5), bilinear, zero outside
+ */
+static gfloat
+satin_sample (const gfloat *buf,
+              gint          w,
+              gint          h,
+              gdouble       x,
+              gdouble       y)
+{
+  gdouble fx = floor (x - 0.5);
+  gdouble fy = floor (y - 0.5);
+  gfloat  tx = (x - 0.5) - fx;
+  gfloat  ty = (y - 0.5) - fy;
+  gint    x0 = (gint) fx;
+  gint    y0 = (gint) fy;
+  gfloat  v[4];
+  gint    k;
+
+  for (k = 0; k < 4; k++)
+    {
+      gint xx = x0 + (k & 1);
+      gint yy = y0 + (k >> 1);
+
+      v[k] = (xx >= 0 && yy >= 0 && xx < w && yy < h) ?
+             buf[(gsize) yy * w + xx] : 0.0f;
+    }
+
+  return (v[0] * (1.0f - tx) + v[1] * tx) * (1.0f - ty) +
+         (v[2] * (1.0f - tx) + v[3] * tx) * ty;
+}
+
+static gboolean
+gimp_operation_satin_coverage (GimpOperationContour *contour,
+                               GeglBuffer           *input,
+                               const GeglRectangle  *in_rect,
+                               const GeglRectangle  *roi,
+                               gint                  level,
+                               guchar               *mask,
+                               gint                  mask_stride)
+{
+  GimpOperationSatin *self  = GIMP_OPERATION_SATIN (contour);
+  gdouble             scale = 1.0 / (1 << MAX (level, 0));
+  gdouble             angle = self->angle * G_PI / 180.0;
+  gdouble             dist  = self->distance * scale;
+  gint                r     = gimp_operation_satin_box_radius (self->size * scale);
+  gint                margin;
+  gdouble             ox, oy;
+  GeglRectangle       area;
+  gfloat             *buf;
+  gfloat             *tmp;
+  gint                x, y, pass;
+
+  /*  the offset of the light angle, as the drop shadow's
+   *  (x = -cos a × d, y = sin a × d)
+   */
+  ox = -cos (angle) * dist;
+  oy =  sin (angle) * dist;
+
+  margin = (gint) ceil (dist) + 3 * r + 2;
+
+  area.x      = roi->x - margin;
+  area.y      = roi->y - margin;
+  area.width  = roi->width  + 2 * margin;
+  area.height = roi->height + 2 * margin;
+
+  if (! gegl_rectangle_intersect (&area, &area, in_rect))
+    return FALSE;
+
+  buf = g_try_new (gfloat, (gsize) area.width * area.height);
+  tmp = g_try_new (gfloat, MAX (area.width, area.height));
+
+  if (! buf || ! tmp)
+    {
+      g_free (buf);
+      g_free (tmp);
+      return FALSE;
+    }
+
+  gegl_buffer_get (input, &area, scale, babl_format ("A float"),
+                   buf, GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+
+  /*  the blur: 3 box blurs each way (outside the input, alpha is 0)  */
+  if (r > 0)
+    {
+      for (pass = 0; pass < 3; pass++)
+        {
+          for (y = 0; y < area.height; y++)
+            satin_box_1d (buf + (gsize) y * area.width, area.width, 1, r, tmp);
+
+          for (x = 0; x < area.width; x++)
+            satin_box_1d (buf + x, area.height, area.width, r, tmp);
+        }
+    }
+
+  /*  the difference of the two shifted copies, through the contour  */
+  for (y = 0; y < roi->height; y++)
+    {
+      guchar  *m  = mask + (gsize) y * mask_stride;
+      gdouble  py = roi->y + y + 0.5 - area.y;
+
+      for (x = 0; x < roi->width; x++)
+        {
+          gdouble px = roi->x + x + 0.5 - area.x;
+          gfloat  a  = satin_sample (buf, area.width, area.height,
+                                     px + ox, py + oy);
+          gfloat  b  = satin_sample (buf, area.width, area.height,
+                                     px - ox, py - oy);
+          gfloat  v  = satin_contour_map (self->contour, fabsf (a - b));
+
+          if (self->invert)
+            v = 1.0f - v;
+
+          m[x] = (guchar) (CLAMP (v, 0.0f, 1.0f) * 255.0f + 0.5f);
+        }
+    }
+
+  g_free (buf);
+  g_free (tmp);
+
+  return TRUE;
+}
+
+
+/*  ─── Incrustation de motif ─────────────────────────────────────────── */
+
+static gboolean gimp_operation_pattern_overlay_coverage (GimpOperationContour *contour,
+                                                         GeglBuffer           *input,
+                                                         const GeglRectangle  *in_rect,
+                                                         const GeglRectangle  *roi,
+                                                         gint                  level,
+                                                         guchar               *mask,
+                                                         gint                  mask_stride);
+
+
+G_DEFINE_TYPE (GimpOperationPatternOverlay, gimp_operation_pattern_overlay,
+               GIMP_TYPE_OPERATION_CONTOUR)
+
+
+static void
+gimp_operation_pattern_overlay_class_init (GimpOperationPatternOverlayClass *klass)
+{
+  GeglOperationClass        *operation_class = GEGL_OPERATION_CLASS (klass);
+  GimpOperationContourClass *contour_class   = GIMP_OPERATION_CONTOUR_CLASS (klass);
+
+  gegl_operation_class_set_keys (operation_class,
+                                 "name",        "chopgimp:pattern-overlay",
+                                 "title",       "Incrustation de motif",
+                                 "categories",  "light",
+                                 "description", "Recouvre le calque d'un motif "
+                                                "(style de calque)",
+                                 NULL);
+
+  contour_class->fill_coverage = gimp_operation_pattern_overlay_coverage;
+  contour_class->fill_margin   = NULL;
+}
+
+static void
+gimp_operation_pattern_overlay_init (GimpOperationPatternOverlay *self)
+{
+}
+
+static gboolean
+gimp_operation_pattern_overlay_coverage (GimpOperationContour *contour,
+                                         GeglBuffer           *input,
+                                         const GeglRectangle  *in_rect,
+                                         const GeglRectangle  *roi,
+                                         gint                  level,
+                                         guchar               *mask,
+                                         gint                  mask_stride)
+{
+  /*  no pattern chosen yet: nothing (not the stroke's black fallback)  */
+  if (contour->fill_type == GIMP_CONTOUR_FILL_PATTERN &&
+      (! contour->pattern_data || ! *contour->pattern_data))
+    return FALSE;
+
+  if (! gegl_rectangle_intersect (NULL, roi, in_rect))
+    return FALSE;
+
+  memset (mask, 255, (gsize) mask_stride * roi->height);
+
+  return TRUE;
+}
