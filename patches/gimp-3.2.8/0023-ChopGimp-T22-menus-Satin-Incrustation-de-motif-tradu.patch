+/*  ─── contours ─────────────────────────────────────────────────────── */
+
+GType
+gimp_satin_contour_get_type (void)
+{
+  static const GEnumValue values[] =
+  {
+    { GIMP_SATIN_CONTOUR_LINEAR,        "GIMP_SATIN_CONTOUR_LINEAR",        "linear"        },
+    { GIMP_SATIN_CONTOUR_CONE,          "GIMP_SATIN_CONTOUR_CONE",          "cone"          },
+    { GIMP_SATIN_CONTOUR_CONE_INVERTED, "GIMP_SATIN_CONTOUR_CONE_INVERTED", "cone-inverted" },
+    { GIMP_SATIN_CONTOUR_GAUSSIAN,      "GIMP_SATIN_CONTOUR_GAUSSIAN",      "gaussian"      },
+    { GIMP_SATIN_CONTOUR_HALF_ROUND,    "GIMP_SATIN_CONTOUR_HALF_ROUND",    "half-round"    },
+    { GIMP_SATIN_CONTOUR_RING,          "GIMP_SATIN_CONTOUR_RING",          "ring"          },
+    { GIMP_SATIN_CONTOUR_RING_DOUBLE,   "GIMP_SATIN_CONTOUR_RING_DOUBLE",   "ring-double"   },
+    { 0, NULL, NULL }
+  };
+
+  static const GimpEnumDesc descs[] =
+  {
+    { GIMP_SATIN_CONTOUR_LINEAR,        "Linéaire",       NULL },
+    { GIMP_SATIN_CONTOUR_CONE,          "Cône",           NULL },
+    { GIMP_SATIN_CONTOUR_CONE_INVERTED, "Cône inversé",   NULL },
+    { GIMP_SATIN_CONTOUR_GAUSSIAN,      "Gaussienne",     NULL },
+    { GIMP_SATIN_CONTOUR_HALF_ROUND,    "Demi-cercle",    NULL },
+    { GIMP_SATIN_CONTOUR_RING,          "Anneau",         NULL },
+    { GIMP_SATIN_CONTOUR_RING_DOUBLE,   "Double anneau",  NULL },
+    { 0, NULL, NULL }
+  };
+
+  static GType type = 0;
+
+  if (G_UNLIKELY (! type))
+    {
+      type = g_enum_register_static ("GimpSatinContour", values);
+      gimp_enum_set_value_descriptions (type, descs);
+    }
+
+  return type;
+}
+
+/*  the points of Photoshop's named curves (0 – 255), as the PSD export
+ *  writes them (psd-chopgimp.c, d_contour())
+ */
+static const struct
+{
+  gint    n;
+  gdouble pts[5][2];
+} satin_contours[] =
+{
+  { 2, { { 0, 0 }, { 255, 255 } } },
+  { 3, { { 0, 0 }, { 128, 255 }, { 255, 0 } } },
+  { 3, { { 0, 255 }, { 128, 0 }, { 255, 255 } } },
+  { 4, { { 0, 0 }, { 64, 26 }, { 191, 229 }, { 255, 255 } } },
+  { 3, { { 0, 0 }, { 64, 166 }, { 255, 255 } } },
+  { 4, { { 0, 0 }, { 85, 255 }, { 170, 255 }, { 255, 0 } } },
+  { 5, { { 0, 0 }, { 64, 255 }, { 128, 0 }, { 191, 255 }, { 255, 0 } } },
+};
+
+/*  the curve at v (0 – 1), piecewise linear  */
+static gfloat
+satin_contour_map (GimpSatinContour contour,
+                   gfloat           v)
+{
+  gint    k = CLAMP ((gint) contour, 0, (gint) G_N_ELEMENTS (satin_contours) - 1);
+  gdouble x = CLAMP (v, 0.0f, 1.0f) * 255.0;
+  gint    i;
+
+  for (i = 1; i < satin_contours[k].n; i++)
+    {
+      const gdouble *p0 = satin_contours[k].pts[i - 1];
+      const gdouble *p1 = satin_contours[k].pts[i];
+
+      if (x <= p1[0] || i == satin_contours[k].n - 1)
+        {
+          gdouble t = (p1[0] > p0[0]) ? (x - p0[0]) / (p1[0] - p0[0]) : 1.0;
+
+          t = CLAMP (t, 0.0, 1.0);
+
+          return (p0[1] + (p1[1] - p0[1]) * t) / 255.0;
+        }
+    }
+
+  return v;
+}
