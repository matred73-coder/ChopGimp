+static void
+gimp_operation_satin_init (GimpOperationSatin *self)
+{
+}
+
+static void
+gimp_operation_satin_get_property (GObject    *object,
+                                   guint       property_id,
+                                   GValue     *value,
+                                   GParamSpec *pspec)
+{
+  GimpOperationSatin *self = GIMP_OPERATION_SATIN (object);
+
