+#define CONTENT_BOUNDS_KEY "chopgimp-content-bounds"
+
+typedef struct
+{
+  gboolean computed;
+  gboolean stale;
+  gboolean ok;
+  gboolean pending;
+  gint64   time;
+  gpointer buffer;        /* compared only: a new buffer, new bounds */
+  gint     x, y, w, h;
+} ContentBounds;
+
+static void
+content_bounds_update (GimpDrawable *drawable,
+                       gint          x,
+                       gint          y,
+                       gint          width,
+                       gint          height,
+                       gpointer      data)
+{
+  ContentBounds *cb = g_object_get_data (G_OBJECT (drawable), CONTENT_BOUNDS_KEY);
+
+  if (cb)
+    cb->stale = TRUE;
+}
+
+static void
+content_bounds_invalidated (GimpViewable *viewable,
+                            gpointer      data)
+{
+  ContentBounds *cb = g_object_get_data (G_OBJECT (viewable), CONTENT_BOUNDS_KEY);
+
+  if (cb)
+    cb->stale = TRUE;
+}
+
+static void
+content_bounds_size_changed (GimpViewable *viewable,
+                             gpointer      data)
+{
+  ContentBounds *cb = g_object_get_data (G_OBJECT (viewable), CONTENT_BOUNDS_KEY);
+
+  /*  a new size: the old bounds are wrong, not just late  */
+  if (cb)
+    cb->computed = FALSE;
+}
+
+static gboolean
+content_bounds_refresh (gpointer data)
+{
+  GimpLayer     *layer = data;
+  ContentBounds *cb    = g_object_get_data (G_OBJECT (layer), CONTENT_BOUNDS_KEY);
+
+  if (cb)
+    cb->pending = FALSE;
+
+  gimp_viewable_invalidate_preview (GIMP_VIEWABLE (layer));
+
+  /*  the group showing it too  */
+  if (gimp_layer_get_parent (layer))
+    gimp_viewable_invalidate_preview (GIMP_VIEWABLE (gimp_layer_get_parent (layer)));
+
+  g_object_unref (layer);
+
+  return G_SOURCE_REMOVE;
+}
+
 /*  content bounds of a layer in its own coordinates; for a group, the
  *  union of its visible children (its projection may not be rendered yet)
  */
