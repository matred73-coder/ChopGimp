+/*  the layer mask follows its layer when the effect moves it  */
+void
+chopgimp_text_fx_sync_mask (GimpTextLayer *layer)
+{
+  GimpLayerMask *mask = gimp_layer_get_mask (GIMP_LAYER (layer));
+
+  if (mask)
+    gimp_item_set_offset (GIMP_ITEM (mask),
+                          gimp_item_get_offset_x (GIMP_ITEM (layer)),
+                          gimp_item_get_offset_y (GIMP_ITEM (layer)));
