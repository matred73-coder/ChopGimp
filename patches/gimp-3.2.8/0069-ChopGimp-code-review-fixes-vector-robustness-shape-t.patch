 /*  the style of the selection (or of the layer)  */
+static void styles_capture_named (Styles *st, const gchar *name);
+
+/*  a key file group name cannot hold [ ] or control characters  */
+static gchar *
+style_name_clean (const gchar *name)
+{
+  gchar *clean = g_strdup (name);
+  gchar *p;
+
+  for (p = clean; *p; p++)
+    if (*p == '[')
+      *p = '(';
+    else if (*p == ']')
+      *p = ')';
+    else if ((guchar) *p < 0x20)
+      *p = ' ';
+
+  return g_strstrip (clean);
+}
+
+static void
+styles_capture (Styles *st, const gchar *raw_name)
+{
+  gchar *name = raw_name ? style_name_clean (raw_name) : NULL;
+
+  styles_capture_named (st, name);
+  g_free (name);
+}
+
 static void
-styles_capture (Styles *st, const gchar *name)
+styles_capture_named (Styles *st, const gchar *name)
 {
   Target    t;
   GKeyFile *kf;
