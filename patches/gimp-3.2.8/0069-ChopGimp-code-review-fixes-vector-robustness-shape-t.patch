-      return TRUE;
-
-    case GIMP_AUTO_SHRINK_UNSHRINKABLE:
-      *x = 0; *y = 0;
-      *w = gimp_item_get_width  (item);
-      *h = gimp_item_get_height (item);
-      return TRUE;
-
-    default:
-      return FALSE;
-    }
+  /*  the scan of the whole layer is cached: while painting, the bounds
+   *  are recomputed at most once a second
+   */
+  {
+    ContentBounds *cb  = g_object_get_data (G_OBJECT (layer), CONTENT_BOUNDS_KEY);
+    gint64         now = g_get_monotonic_time ();
+
+    if (! cb)
+      {
+        cb = g_new0 (ContentBounds, 1);
+        g_object_set_data_full (G_OBJECT (layer), CONTENT_BOUNDS_KEY, cb, g_free);
+        g_signal_connect (layer, "update",
+                          G_CALLBACK (content_bounds_update), NULL);
+        /*  some layers (vector layers) redraw without « update »  */
+        g_signal_connect (layer, "invalidate-preview",
+                          G_CALLBACK (content_bounds_invalidated), NULL);
+        g_signal_connect (layer, "size-changed",
+                          G_CALLBACK (content_bounds_size_changed), NULL);
+      }
