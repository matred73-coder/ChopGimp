+    if (cb->buffer != (gpointer) gimp_drawable_get_buffer (GIMP_DRAWABLE (layer)))
+      cb->computed = FALSE;
+
+    if (cb->computed && (! cb->stale || now - cb->time < G_USEC_PER_SEC))
+      {
