+          *natural_width += SLIDER_GAP + label_width +
+                            SLIDER_GAP + TRACK_NATURAL;
+        }
+      else
+        {
+          *minimum_width += SLIDER_GAP + 2 * knob;
+          *natural_width += SLIDER_GAP + TRACK_NATURAL;
+        }
