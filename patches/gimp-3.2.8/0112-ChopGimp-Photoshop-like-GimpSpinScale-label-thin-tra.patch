+/*  ChopGimp: Photoshop-like slider layout (unless the environment
+ *  variable CHOPGIMP_CLASSIC_SPIN_SCALE is set to a non-empty value
+ *  other than "0", which restores GIMP's filled bar):
+ *
+ *    Label     ────────●──────────  [ 50 ] %
+ *
+ *  - the label is drawn on the left, ellipsized, in the normal text color;
+ *  - a thin track with a round knob: click / drag = absolute value;
+ *  - the GtkEntry text (right-aligned) is framed as a small value field,
+ *    clicking it edits the text; the optional "unit-suffix" is drawn
+ *    after the field;
+ *  - dragging the label scrubs the value (relative), Shift+drag or the
+ *    right button anywhere on the label / track = fine relative drag;
+ *  - the -/+ buttons of GtkSpinButton are given no width and no input.
+ *
+ *  Colors and sizes come from the theme, through style classes added
+ *  to the GimpSpinScale node while rendering each part:
+ *    .chopgimp-slider-track  (min-height = track thickness)
+ *    .chopgimp-slider-fill
+ *    .chopgimp-slider-knob   (min-width  = knob diameter)
+ *    .chopgimp-slider-field
+ *    .chopgimp-slider-unit   (color)
+ *  every part also has .chopgimp-slider-part; the widget itself has
+ *  .chopgimp-slider.  Neutral defaults are installed with a low priority
+ *  for themes that know nothing about these classes.
+ */
+#define SLIDER_GAP           8    /* label ↔ track ↔ field              */
+#define FIELD_PAD            5    /* inner horizontal padding of field  */
+#define UNIT_GAP             3    /* field ↔ unit suffix                */
+#define TRACK_MIN           40    /* below: compact layout              */
+#define TRACK_NATURAL      100
+#define LABEL_MIN_CHARS      3
+#define LABEL_COL_FRACTION 0.30   /* label column, so tracks line up    */
+#define LABEL_COL_MAX      110
+#define COMPACT_KNOB         7
+#define COMPACT_TRACK        2
+
 
