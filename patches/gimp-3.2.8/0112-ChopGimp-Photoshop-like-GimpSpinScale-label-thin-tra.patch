                                        pango_context_get_font_description (context),
                                        pango_context_get_language (context));
 
+  if (! scale->classic)
+    {
+      gint char_pixels;
+      gint knob = COMPACT_KNOB + 2;
+
+      char_pixels = PANGO_PIXELS (MAX (pango_font_metrics_get_approximate_char_width (metrics),
+                                       pango_font_metrics_get_approximate_digit_width (metrics)));
