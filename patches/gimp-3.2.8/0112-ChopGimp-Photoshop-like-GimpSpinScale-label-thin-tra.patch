+typedef enum
+{
+  ZONE_LABEL,
+  ZONE_TRACK,
+  ZONE_FIELD
+} SliderZone;
+
+/*  all x coordinates are left-to-right ones (mirrored for RTL),
+ *  relative to the widget allocation
+ */
+typedef struct
+{
+  gint     width;
+  gint     height;
+  gboolean field_only;   /* too narrow: only the value field          */
+  gboolean compact;      /* narrow: label over a track at the bottom  */
+  gint     label_x;
+  gint     label_w;
+  gdouble  label_y;      /* vertical centre of the label              */
+  gdouble  track_x0;     /* knob centre range                         */
+  gdouble  track_x1;
+  gdouble  track_y;      /* vertical centre of the track              */
+  gdouble  track_h;
+  gdouble  knob_d;
+  gint     field_x;
+  gint     field_w;
+  gint     unit_x;
+} SliderGeometry;
+
 
