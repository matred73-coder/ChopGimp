+/*  x, y: relative to the text area (as given by
+ *  gimp_spin_scale_event_to_widget_coords())
+ */
+static SliderZone
+gimp_spin_scale_get_zone (GimpSpinScale  *scale,
+                          gdouble         x,
+                          gdouble         y,
+                          gboolean       *inside)
+{
+  GtkWidget      *widget = GTK_WIDGET (scale);
+  GdkRectangle    text_area;
+  SliderGeometry  geo;
+  gdouble         lx;
+
+  gtk_entry_get_text_area (GTK_ENTRY (widget), &text_area);
+  gimp_spin_scale_get_geometry (scale, &geo);
+
+  x += text_area.x;
+  y += text_area.y;
+
+  *inside = (x >= 0 && x < geo.width && y >= 0 && y < geo.height);
+
+  lx = (gtk_widget_get_direction (widget) == GTK_TEXT_DIR_RTL) ?
+       geo.width - x : x;
+
+  if (geo.field_only || lx >= geo.field_x - SLIDER_GAP / 2)
+    return ZONE_FIELD;
+
+  if (geo.compact || ! scale->label ||
+      lx >= geo.track_x0 - geo.knob_d / 2.0 - SLIDER_GAP / 2)
+    return ZONE_TRACK;
+
+  return ZONE_LABEL;
+}
+
+static SpinScaleTarget
+gimp_spin_scale_get_slider_target (GtkWidget *widget,
+                                   gdouble    x,
+                                   gdouble    y,
+                                   GdkEvent  *event)
+{
+  SliderZone zone;
+  gboolean   inside;
+
+  zone = gimp_spin_scale_get_zone (GIMP_SPIN_SCALE (widget), x, y, &inside);
+
+  if (! inside)
+    return TARGET_NONE;
+
+  if (event && event->type != GDK_MOTION_NOTIFY)
+    {
+      GdkEventButton *event_button = (GdkEventButton *) event;
+
+      switch (event_button->button)
+        {
+        case 1:
+          if (zone == ZONE_FIELD)
+            return TARGET_NUMBER;
+          else if (event_button->state & GDK_SHIFT_MASK)
+            return TARGET_RELATIVE;
+          else if (zone == ZONE_TRACK)
+            return TARGET_GRABBING;
