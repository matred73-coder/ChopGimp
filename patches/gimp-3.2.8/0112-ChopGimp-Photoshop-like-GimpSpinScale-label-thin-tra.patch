 {
   PROP_0,
-  PROP_LABEL
+  PROP_LABEL,
+  PROP_UNIT_SUFFIX
 };
 
 typedef enum
@@ -50,9 +90,39 @@ typedef enum
   TARGET_NUMBER,
   TARGET_GRAB,
   TARGET_GRABBING,
-  TARGET_RELATIVE
