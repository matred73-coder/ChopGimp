+
+static void
+gimp_spin_scale_unrealize (GtkWidget *widget)
+{
+  GIMP_SPIN_SCALE (widget)->text_window = NULL;
+
+  GTK_WIDGET_CLASS (parent_class)->unrealize (widget);
+}
+
+/*  GtkSpinButton keeps an input-only window over each of its -/+
+ *  buttons.  The slider layout gives the buttons no width (CSS), but
+ *  their windows would still catch the clicks on the value: hide them.
+ *  The entry's own text window is the child window matching the text
+ *  area; if none matches (unexpected GTK internals), nothing is hidden
+ *  and clicks on foreign windows only focus the field.
+ */
+static void
+gimp_spin_scale_hide_spin_panels (GimpSpinScale *scale)
+{
+  GtkWidget     *widget = GTK_WIDGET (scale);
+  GdkWindow     *window;
+  GtkAllocation  allocation;
+  GdkRectangle   text_area;
+  GList         *children;
+  GList         *list;
+  GdkWindow     *text_window = NULL;
+
+  scale->text_window = NULL;
+
+  if (scale->classic || ! gtk_widget_get_realized (widget))
+    return;
+
+  window = gtk_widget_get_window (widget);
+  if (! window)
+    return;
+
+  gtk_widget_get_allocation (widget, &allocation);
+  gtk_entry_get_text_area (GTK_ENTRY (widget), &text_area);
+
+  children = gdk_window_peek_children (window);
+
+  for (list = children; list; list = g_list_next (list))
+    {
+      GdkWindow *child     = list->data;
+      gpointer   user_data = NULL;
+      gint       x, y, w, h;
+
+      gdk_window_get_user_data (child, &user_data);
+      if (user_data != widget)
+        continue;
+
+      gdk_window_get_geometry (child, &x, &y, &w, &h);
+
+      if (x - allocation.x == text_area.x &&
+          y - allocation.y == text_area.y &&
+          w == text_area.width            &&
+          h == text_area.height)
+        {
+          text_window = child;
+          break;
+        }
+    }
+
+  if (! text_window)
+    return;
+
+  scale->text_window = text_window;
+
+  for (list = children; list; list = g_list_next (list))
+    {
+      GdkWindow *child     = list->data;
+      gpointer   user_data = NULL;
+
+      gdk_window_get_user_data (child, &user_data);
+
+      if (user_data == widget && child != text_window &&
+          gdk_window_is_visible (child))
+        {
+          gdk_window_hide (child);
+        }
+    }
 }
 
