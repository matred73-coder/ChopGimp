+/*  ChopGimp slider: CSS, geometry and drawing  */
+
+/*  Structural rules, above the themes (which use
+ *  GTK_STYLE_PROVIDER_PRIORITY_APPLICATION + 1): the widget node and
+ *  its entry draw nothing themselves, the -/+ buttons get no width
+ *  (their 16 px icon is cancelled by a negative margin) and are
+ *  invisible.
+ */
+static const gchar slider_structure_css[] =
+  "GimpSpinScale.chopgimp-slider:not(.chopgimp-slider-part) {"
+  "  background: none; border-style: none; box-shadow: none;"
+  "}"
+  "GimpSpinScale.chopgimp-slider entry {"
+  "  background: none; border-style: none; box-shadow: none;"
+  "  margin: 0; padding-left: 5px; padding-right: 5px;"
+  "}"
+  "GimpSpinScale.chopgimp-slider entry progress {"
+  "  background: none; border-style: none; box-shadow: none;"
+  "}"
+  "GimpSpinScale.chopgimp-slider button,"
+  "GimpSpinScale.chopgimp-slider button:hover,"
+  "GimpSpinScale.chopgimp-slider button:active,"
+  "GimpSpinScale.chopgimp-slider button:disabled {"
+  "  background: none; border-style: none; box-shadow: none;"
+  "  color: transparent; -gtk-icon-shadow: none; opacity: 0;"
+  "  min-width: 0; min-height: 0; padding: 0;"
+  "  margin: 0 0 0 -16px;"
+  "}"
+  "GimpSpinScale.chopgimp-slider-part {"
+  "  background-image: none; box-shadow: none;"
+  "}";
+
+/*  Neutral defaults below the themes, for themes which do not style
+ *  the slider parts (ChopGimp themes do, in ps-overrides.css).
+ */
+static const gchar slider_default_css[] =
+  "GimpSpinScale.chopgimp-slider-track {"
+  "  background-color: alpha(currentColor, 0.25);"
+  "  border-style: none; border-radius: 2px; min-height: 3px;"
+  "}"
+  "GimpSpinScale.chopgimp-slider-fill {"
+  "  background-color: alpha(currentColor, 0.75);"
+  "  border-style: none; border-radius: 2px;"
+  "}"
+  "GimpSpinScale.chopgimp-slider-knob {"
+  "  background-color: currentColor;"
+  "  border-style: none; border-radius: 50%;"
+  "  min-width: 11px; min-height: 11px;"
+  "}"
+  "GimpSpinScale.chopgimp-slider-field {"
+  "  background-color: alpha(currentColor, 0.06);"
+  "  border: 1px solid alpha(currentColor, 0.25); border-radius: 2px;"
+  "}";
+
+static void
+gimp_spin_scale_install_css (void)
+{
+  static gboolean  installed = FALSE;
+  GdkScreen       *screen;
+  GtkCssProvider  *provider;
+
+  if (installed)
+    return;
+
+  screen = gdk_screen_get_default ();
+  if (! screen)
+    return;
+
+  installed = TRUE;
+
+  provider = gtk_css_provider_new ();
+  gtk_css_provider_load_from_data (provider, slider_structure_css, -1, NULL);
+  gtk_style_context_add_provider_for_screen (screen,
+                                             GTK_STYLE_PROVIDER (provider),
+                                             GTK_STYLE_PROVIDER_PRIORITY_USER);
+  g_object_unref (provider);
+
+  provider = gtk_css_provider_new ();
+  gtk_css_provider_load_from_data (provider, slider_default_css, -1, NULL);
+  gtk_style_context_add_provider_for_screen (screen,
+                                             GTK_STYLE_PROVIDER (provider),
+                                             GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
+  g_object_unref (provider);
+}
+
+/*  The unit suffix is drawn after the value field: keep room for it
+ *  on the outer side of the entry text, with a per-widget provider.
+ */
+static void
+gimp_spin_scale_update_unit_css (GimpSpinScale *scale)
+{
+  GtkWidget *widget = GTK_WIDGET (scale);
+  gchar     *css;
+
+  if (scale->classic)
+    return;
+
+  if (scale->unit_suffix && *scale->unit_suffix)
+    {
+      gint width;
+
+      if (! scale->unit_layout)
+        scale->unit_layout = gtk_widget_create_pango_layout (widget,
+                                                             scale->unit_suffix);
+
+      pango_layout_get_pixel_size (scale->unit_layout, &width, NULL);
+
+      css = g_strdup_printf ("entry { padding-%s: %dpx; }",
+                             gtk_widget_get_direction (widget) == GTK_TEXT_DIR_RTL ?
+                             "left" : "right",
+                             FIELD_PAD + UNIT_GAP + width);
+    }
+  else
+    {
+      css = g_strdup ("");
+    }
+
+  if (! scale->unit_provider && ! *css)
+    {
+      g_free (css);
+      return;
+    }
+
+  if (g_strcmp0 (css, scale->unit_css))
+    {
+      if (! scale->unit_provider)
+        {
+          scale->unit_provider = gtk_css_provider_new ();
+
+          gtk_style_context_add_provider (gtk_widget_get_style_context (widget),
+                                          GTK_STYLE_PROVIDER (scale->unit_provider),
+                                          GTK_STYLE_PROVIDER_PRIORITY_USER + 1);
+        }
+
+      g_free (scale->unit_css);
+      scale->unit_css = css;
+
+      gtk_css_provider_load_from_data (scale->unit_provider, css, -1, NULL);
+    }
+  else
+    {
+      g_free (css);
+    }
+}
+
+static void
+gimp_spin_scale_render_part (GtkStyleContext *style,
+                             cairo_t         *cr,
+                             const gchar     *part,
+                             gdouble          x,
+                             gdouble          y,
+                             gdouble          width,
+                             gdouble          height)
+{
+  if (width <= 0.0 || height <= 0.0)
+    return;
+
+  gtk_style_context_save (style);
+  gtk_style_context_add_class (style, "chopgimp-slider-part");
+  gtk_style_context_add_class (style, part);
+
+  gtk_render_background (style, cr, x, y, width, height);
+  gtk_render_frame      (style, cr, x, y, width, height);
+
+  gtk_style_context_restore (style);
+}
+
+static gint
+gimp_spin_scale_get_part_size (GtkWidget   *widget,
+                               const gchar *part,
+                               const gchar *property,
+                               gint         fallback)
+{
+  GtkStyleContext *style = gtk_widget_get_style_context (widget);
+  gint             size  = 0;
+
+  gtk_style_context_save (style);
+  gtk_style_context_add_class (style, "chopgimp-slider-part");
+  gtk_style_context_add_class (style, part);
+
+  gtk_style_context_get (style, gtk_style_context_get_state (style),
+                         property, &size,
+                         NULL);
+
+  gtk_style_context_restore (style);
+
+  return (size > 0) ? size : fallback;
+}
+
+static gint
+gimp_spin_scale_measure (GimpSpinScale *scale,
+                         const gchar   *text)
+{
+  gint width;
+
+  if (! scale->measure_layout)
+    scale->measure_layout = gtk_widget_create_pango_layout (GTK_WIDGET (scale),
+                                                            NULL);
+
+  pango_layout_set_text (scale->measure_layout, text, -1);
+  pango_layout_get_pixel_size (scale->measure_layout, &width, NULL);
+
+  return width;
+}
+
+/*  width of the value text inside the field: wide enough for the
+ *  adjustment bounds (between "000" and "0000000"), and for what is
+ *  currently typed
+ */
+static gint
+gimp_spin_scale_get_field_text_width (GimpSpinScale *scale)
+{
+  GtkSpinButton  *spin_button = GTK_SPIN_BUTTON (scale);
+  GtkAdjustment  *adjustment  = gtk_spin_button_get_adjustment (spin_button);
+  gdouble         lower       = gtk_adjustment_get_lower (adjustment);
+  gdouble         upper       = gtk_adjustment_get_upper (adjustment);
+  gint            digits      = gtk_spin_button_get_digits (spin_button);
+  PangoRectangle  logical;
+  gint            width;
+
+  if (scale->bounds_width < 0       ||
+      scale->bounds_lower  != lower ||
+      scale->bounds_upper  != upper ||
+      scale->bounds_digits != digits)
+    {
+      gchar *text;
+      gint   min_w = gimp_spin_scale_measure (scale, "000");
+      gint   max_w = gimp_spin_scale_measure (scale, "0000000");
+
+      text  = g_strdup_printf ("%.*f", digits, lower);
+      width = gimp_spin_scale_measure (scale, text);
+      g_free (text);
+
+      text  = g_strdup_printf ("%.*f", digits, upper);
+      width = MAX (width, gimp_spin_scale_measure (scale, text));
+      g_free (text);
+
+      scale->bounds_width  = CLAMP (width, min_w, max_w);
+      scale->bounds_lower  = lower;
+      scale->bounds_upper  = upper;
+      scale->bounds_digits = digits;
+    }
+
+  pango_layout_get_pixel_extents (gtk_entry_get_layout (GTK_ENTRY (scale)),
+                                  NULL, &logical);
+
+  return MAX (scale->bounds_width, logical.width);
+}
+
+static PangoLayout *
+gimp_spin_scale_ensure_label_layout (GimpSpinScale *scale)
+{
+  if (! scale->layout)
+    {
+      scale->layout = gtk_widget_create_pango_layout (GTK_WIDGET (scale),
+                                                      scale->label_text);
+      pango_layout_set_ellipsize (scale->layout, PANGO_ELLIPSIZE_END);
+      pango_layout_set_auto_dir (scale->layout, FALSE);
+
+      if (scale->mnemonics_visible)
+        {
+          PangoAttrList *attrs;
+
+          attrs = pattern_to_attrs (scale->label_text,
+                                    scale->label_pattern);
+          if (attrs)
+            {
+              pango_layout_set_attributes (scale->layout, attrs);
+              pango_attr_list_unref (attrs);
+            }
+        }
+    }
+
+  return scale->layout;
+}
+
+static void
+gimp_spin_scale_get_geometry (GimpSpinScale  *scale,
+                              SliderGeometry *geo)
+{
+  GtkWidget     *widget = GTK_WIDGET (scale);
+  GtkAllocation  allocation;
+  GdkRectangle   text_area;
+  gint           text_edge;
+  gint           avail;
+  gint           label_width = 0;
+  gdouble        knob_r;
+
+  memset (geo, 0, sizeof (SliderGeometry));
+
+  gtk_widget_get_allocation (widget, &allocation);
+  gtk_entry_get_text_area (GTK_ENTRY (widget), &text_area);
+
+  geo->width   = allocation.width;
+  geo->height  = allocation.height;
+  if (! scale->track_h_px)
+    scale->track_h_px = gimp_spin_scale_get_part_size (widget,
+                                                       "chopgimp-slider-track",
+                                                       "min-height", 3);
+  if (! scale->knob_d_px)
+    scale->knob_d_px = gimp_spin_scale_get_part_size (widget,
+                                                      "chopgimp-slider-knob",
+                                                      "min-width", 11);
+
+  geo->track_h = scale->track_h_px;
+  geo->knob_d  = scale->knob_d_px;
+
+  /*  the inner edge of the text area: the value is right-aligned
+   *  (left-aligned in RTL) against it
+   */
+  if (gtk_widget_get_direction (widget) == GTK_TEXT_DIR_RTL)
+    text_edge = geo->width - text_area.x;
+  else
+    text_edge = text_area.x + text_area.width;
+
+  geo->field_w = gimp_spin_scale_get_field_text_width (scale) + 2 * FIELD_PAD;
+  geo->field_x = text_edge + FIELD_PAD - geo->field_w;
+  geo->unit_x  = text_edge + FIELD_PAD + UNIT_GAP;
+
+  geo->label_y = geo->height / 2.0;
+  geo->track_y = geo->height / 2.0;
+
+  avail = geo->field_x - SLIDER_GAP;
+
+  if (scale->label)
+    {
+      PangoLayout *layout = gimp_spin_scale_ensure_label_layout (scale);
+
+      pango_layout_set_width (layout, -1);
+      pango_layout_get_pixel_size (layout, &label_width, NULL);
+    }
+
+  if (! scale->char_px)
+    {
+      PangoContext     *context = gtk_widget_get_pango_context (widget);
+      PangoFontMetrics *metrics;
+
+      metrics = pango_context_get_metrics (context,
+                                           pango_context_get_font_description (context),
+                                           pango_context_get_language (context));
+      scale->char_px =
+        PANGO_PIXELS (MAX (pango_font_metrics_get_approximate_char_width (metrics),
+                           pango_font_metrics_get_approximate_digit_width (metrics)));
+      pango_font_metrics_unref (metrics);
+    }
+
+  knob_r = geo->knob_d / 2.0;
+
+  if (! scale->label)
+    {
+      geo->track_x0 = knob_r;
+      geo->track_x1 = avail - knob_r;
+    }
+  else if (avail >= (scale->char_px * LABEL_MIN_CHARS + SLIDER_GAP +
+                     TRACK_MIN + geo->knob_d))
+    {
+      gint column;
+
+      /*  a label column proportional to the width, so that the tracks
+       *  of a column of sliders line up; longer labels push the track
+       */
+      column = MIN (geo->width * LABEL_COL_FRACTION, LABEL_COL_MAX);
+      column = MAX (column, label_width);
+      column = MIN (column, avail - SLIDER_GAP - TRACK_MIN - (gint) geo->knob_d);
+
+      geo->label_x  = 0;
+      geo->label_w  = column;
+      geo->track_x0 = column + SLIDER_GAP + knob_r;
+      geo->track_x1 = avail - knob_r;
+    }
+  else
+    {
+      /*  compact: the label over a thinner track along the bottom  */
+      geo->compact  = TRUE;
+      geo->knob_d   = MIN (geo->knob_d, COMPACT_KNOB);
+      geo->track_h  = MIN (geo->track_h, COMPACT_TRACK);
+      knob_r        = geo->knob_d / 2.0;
+
+      geo->label_x  = 0;
+      geo->label_w  = avail;
+      geo->label_y  = (geo->height - geo->knob_d) / 2.0;
+      geo->track_y  = geo->height - knob_r - 1.0;
+      geo->track_x0 = knob_r;
+      geo->track_x1 = avail - knob_r;
+    }
+
+  if (geo->track_x1 - geo->track_x0 < 8.0)
+    {
+      geo->field_only = TRUE;
+      geo->compact    = FALSE;
+      geo->label_w    = 0;
+    }
+}
+
+static gdouble
+gimp_spin_scale_get_fraction (GimpSpinScale *scale)
+{
+  GtkAdjustment *adjustment;
+  gdouble        lower, upper, value;
+  gdouble        x0, x1, x;
+
+  adjustment = gtk_spin_button_get_adjustment (GTK_SPIN_BUTTON (scale));
+
+  gimp_spin_scale_get_limits (scale, &lower, &upper);
+
+  value = CLAMP (gtk_adjustment_get_value (adjustment), lower, upper);
+
+  x0 = odd_pow (lower, 1.0 / scale->gamma);
+  x1 = odd_pow (upper, 1.0 / scale->gamma);
+  x  = odd_pow (value, 1.0 / scale->gamma);
+
+  if (x1 == x0)
+    return 0.0;
+
+  return CLAMP ((x - x0) / (x1 - x0), 0.0, 1.0);
+}
+
+static gboolean
+gimp_spin_scale_draw_slider (GtkWidget *widget,
+                             cairo_t   *cr)
+{
+  GimpSpinScale   *scale = GIMP_SPIN_SCALE (widget);
+  GtkStyleContext *style = gtk_widget_get_style_context (widget);
+  GtkStateFlags    state = gtk_widget_get_state_flags (widget);
+  gboolean         rtl   = (gtk_widget_get_direction (widget) == GTK_TEXT_DIR_RTL);
+  SliderGeometry   geo;
+  GdkRGBA          text_color;
+
+  gimp_spin_scale_get_geometry (scale, &geo);
+
+#define MIRROR(x, w) (rtl ? geo.width - (x) - (w) : (x))
+
+  gtk_style_context_get_color (style, state, &text_color);
+
+  /*  the value field, the entry draws its text over it  */
+  gimp_spin_scale_render_part (style, cr, "chopgimp-slider-field",
+                               MIRROR (geo.field_x, geo.field_w), 0,
+                               geo.field_w, geo.height);
+
+  /*  the unit suffix  */
+  if (scale->unit_suffix && *scale->unit_suffix)
+    {
+      GdkRGBA unit_color;
+      gint    width, height;
+
+      if (! scale->unit_layout)
+        scale->unit_layout = gtk_widget_create_pango_layout (widget,
+                                                             scale->unit_suffix);
+
+      pango_layout_get_pixel_size (scale->unit_layout, &width, &height);
+
+      gtk_style_context_save (style);
+      gtk_style_context_add_class (style, "chopgimp-slider-part");
+      gtk_style_context_add_class (style, "chopgimp-slider-unit");
+      gtk_style_context_get_color (style, state, &unit_color);
+      gtk_style_context_restore (style);
+
+      cairo_move_to (cr,
+                     MIRROR (geo.unit_x, width),
+                     (geo.height - height) / 2.0);
+      gdk_cairo_set_source_rgba (cr, &unit_color);
+      pango_cairo_show_layout (cr, scale->unit_layout);
+    }
+
+  /*  the label  */
+  if (scale->label && geo.label_w > 0)
+    {
+      PangoLayout    *layout = gimp_spin_scale_ensure_label_layout (scale);
+      PangoRectangle  logical;
+
+      pango_layout_set_width (layout, PANGO_SCALE * geo.label_w);
+      pango_layout_get_pixel_extents (layout, NULL, &logical);
+
+      cairo_move_to (cr,
+                     MIRROR (geo.label_x, MIN (logical.width, geo.label_w)) - logical.x,
+                     geo.label_y - logical.height / 2.0);
+      gdk_cairo_set_source_rgba (cr, &text_color);
+      pango_cairo_show_layout (cr, layout);
+    }
+
+  /*  the track, its filled part and the knob  */
+  if (! geo.field_only)
+    {
+      gdouble span   = geo.track_x1 - geo.track_x0;
+      gdouble knob_x = geo.track_x0 + gimp_spin_scale_get_fraction (scale) * span;
+      gdouble ty     = geo.track_y - geo.track_h / 2.0;
+      gdouble kr     = geo.knob_d / 2.0;
+
+      gimp_spin_scale_render_part (style, cr, "chopgimp-slider-track",
+                                   MIRROR (geo.track_x0, span), ty,
+                                   span, geo.track_h);
+
+      gimp_spin_scale_render_part (style, cr, "chopgimp-slider-fill",
+                                   MIRROR (geo.track_x0, knob_x - geo.track_x0), ty,
+                                   knob_x - geo.track_x0, geo.track_h);
+
+      gimp_spin_scale_render_part (style, cr, "chopgimp-slider-knob",
+                                   MIRROR (knob_x - kr, geo.knob_d),
+                                   geo.track_y - kr,
+                                   geo.knob_d, geo.knob_d);
+    }
+
+#undef MIRROR
+
+  /*  the entry: its text (and cursor, selection) in the field  */
+  cairo_save (cr);
+  GTK_WIDGET_CLASS (parent_class)->draw (widget, cr);
+  cairo_restore (cr);
+
+  return FALSE;
+}
+
