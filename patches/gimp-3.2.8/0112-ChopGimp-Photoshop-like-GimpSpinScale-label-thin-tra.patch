   if (scale->label)
     {
       gint char_width;
@@ -313,6 +511,113 @@ gimp_spin_scale_style_updated (GtkWidget *widget)
   GTK_WIDGET_CLASS (parent_class)->style_updated (widget);
 
   g_clear_object (&scale->layout);
+  g_clear_object (&scale->unit_layout);
+  g_clear_object (&scale->measure_layout);
