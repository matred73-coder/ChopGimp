Subject: [PATCH] =?UTF-8?q?ChopGimp=203.99.0:=20document=20tab=20labels=20?=
 =?UTF-8?q?keep=2020=20characters=20(an=20ellipsized=20label=20asked=20for?=
 =?UTF-8?q?=20no=20width:=20the=20tabs=20showed=20only=20=C2=AB=20?=
 =?UTF-8?q?=E2=80=A6=20=C2=BB)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 app/display/gimpimagewindow.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/app/display/gimpimagewindow.c b/app/display/gimpimagewindow.c
index 92963a6..332c696 100644
--- a/app/display/gimpimagewindow.c
+++ b/app/display/gimpimagewindow.c
@@ -3108,6 +3108,10 @@ gimp_image_window_create_tab_label (GimpImageWindow  *window,
 
       gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_MIDDLE);
       gtk_label_set_max_width_chars (GTK_LABEL (label), 36);
+      /*  3.99.0: an ellipsized label asks for no width at all: the tabs
+       *  showed « … » only; keep about a name and its zoom visible
+       */
+      gtk_label_set_width_chars (GTK_LABEL (label), 20);
       gtk_box_pack_start (GTK_BOX (hbox), label, FALSE, FALSE, 0);
       gtk_widget_set_visible (label, TRUE);
 
