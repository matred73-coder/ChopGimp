+#define GIMP_IS_OPERATION_CONTOUR_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass),  GIMP_TYPE_OPERATION_CONTOUR))
+#define GIMP_OPERATION_CONTOUR_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj),  GIMP_TYPE_OPERATION_CONTOUR, GimpOperationContourClass))
+
+
+/*  ChopGimp: fill of the stroke, as Photoshop's "Contour" layer style  */
+typedef enum
+{
+  GIMP_CONTOUR_FILL_COLOR,
+  GIMP_CONTOUR_FILL_GRADIENT,
+  GIMP_CONTOUR_FILL_PATTERN
+} GimpContourFillType;
+
+#define GIMP_TYPE_CONTOUR_FILL_TYPE (gimp_contour_fill_type_get_type ())
+
+GType gimp_contour_fill_type_get_type (void) G_GNUC_CONST;
+
+typedef enum
+{
+  GIMP_CONTOUR_GRADIENT_LINEAR,
+  GIMP_CONTOUR_GRADIENT_RADIAL,
+  GIMP_CONTOUR_GRADIENT_ANGLE,
+  GIMP_CONTOUR_GRADIENT_REFLECTED,
+  GIMP_CONTOUR_GRADIENT_DIAMOND,
+  GIMP_CONTOUR_GRADIENT_SHAPE_BURST
+} GimpContourGradientStyle;
+
+#define GIMP_TYPE_CONTOUR_GRADIENT_STYLE (gimp_contour_gradient_style_get_type ())
+
+GType gimp_contour_gradient_style_get_type (void) G_GNUC_CONST;
+
+
+typedef struct _GimpOperationContour      GimpOperationContour;
+typedef struct _GimpOperationContourClass GimpOperationContourClass;
+typedef struct _GimpContourOutline        GimpContourOutline;
+typedef struct _GimpContourFill           GimpContourFill;
+
+struct _GimpOperationContour
+{
+  GeglOperationFilter  parent_instance;
+
+  GimpContourPosition  position;
+  gdouble              width;
+  GeglColor           *color;
+  gdouble              opacity;
+  gboolean             antialias;
+  GimpContourDash      dash_preset;
+  GimpCapStyle         cap_style;
+  GimpJoinStyle        join_style;
+  gdouble              miter_limit;
+  gdouble              threshold;
+
+  /*  ChopGimp: Photoshop "Contour" options; their defaults give the
+   *  stroke of the first version (normal, solid color)
+   */
+  GimpLayerMode             mode;
+  gboolean                  overprint;
+  GimpContourFillType       fill_type;
+  gchar                    *gradient_data;   /* a .ggr file's contents  */
+  gboolean                  gradient_reverse;
+  GimpContourGradientStyle  gradient_style;
+  gdouble                   gradient_angle;
+  gdouble                   gradient_scale;
+  gdouble                   gradient_offset_x;
+  gdouble                   gradient_offset_y;
+  gchar                    *pattern_data;    /* base64 of a .pat file   */
+  gdouble                   pattern_scale;
+  gdouble                   pattern_angle;
+  gdouble                   pattern_offset_x;
+  gdouble                   pattern_offset_y;
+
+  /*  "align-with-layer" (Photoshop's « Aligner sur le calque »): the
+   *  gradient spans the layer and the pattern starts at its origin; off,
+   *  both follow the image canvas, whose rectangle in layer coordinates
+   *  the drawable filter gives (gimp_operation_contour_set_canvas())
+   */
+  gboolean                  align_with_layer;
+  GeglRectangle             canvas;          /* layer coordinates       */
+
+  /*  the gradient and pattern parsed from the data above, and their
+   *  colors converted to the processing format (cached)
+   */
+  GMutex                    fill_mutex;
+  GObject                  *gradient;
+  GObject                  *pattern;
+  gint                      fill_generation;
+  GimpContourFill          *fill;
+
+  /*  the outline of the whole layer, kept for dashed strokes (the dashes
+   *  depend on the whole outline); valid while "generation" does not
+   *  change, i.e. until the input or a property changes
+   */
+  GMutex               outline_mutex;
+  GimpContourOutline  *outline;
+  GeglRectangle        outline_rect;
+  gint                 outline_level;
+  guint                outline_generation;
+  gint                 generation;
+};
+
+struct _GimpOperationContourClass
+{
+  GeglOperationFilterClass  parent_class;
+
+  /*  ChopGimp 3.32.0: effects covering the inside of the layer instead of
+   *  stroking its edge (Satin, Incrustation de motif), subclasses of the
+   *  stroke sharing its fills, modes and compositing. fill_coverage()
+   *  renders the coverage of roi (level coordinates, A8 mask of the
+   *  given stride, cleared) from the input whose extent at the level is
+   *  in_rect; FALSE: nothing to draw. fill_margin() is how far around a
+   *  pixel the input is read, at the given scale (1 / 2^level). The
+   *  effect is composited inside the layer ("source-atop": the layer's
+   *  alpha is kept).
+   */
+  gboolean (* fill_coverage) (GimpOperationContour *self,
+                              GeglBuffer           *input,
+                              const GeglRectangle  *in_rect,
+                              const GeglRectangle  *roi,
+                              gint                  level,
+                              guchar               *mask,
+                              gint                  mask_stride);
+  gint     (* fill_margin)   (GimpOperationContour *self,
+                              gdouble               scale);
+};
+
+
+GType   gimp_operation_contour_get_type (void);
+
+
+/*  ChopGimp: building blocks of the stroke, shared with
+ *  chopgimp:layer-style-fused (gimpoperationlayerstylefused.c).
+ *  Rectangles and coordinates are those of the mipmap level.
+ */
+
+typedef struct _GimpContourComposite GimpContourComposite;
+
+void       gimp_operation_contour_scale_rect       (const GeglRectangle  *rect,
+                                                    gint                  level,
+                                                    GeglRectangle        *result);
+gint       gimp_operation_contour_get_level_margin (GimpOperationContour *self,
+                                                    gint                  level);
+gboolean   gimp_operation_contour_get_is_local     (GimpOperationContour *self);
+gboolean   gimp_operation_contour_get_needs_burst  (GimpOperationContour *self);
+gint       gimp_operation_contour_mask_stride      (gint                  width);
+void       gimp_operation_contour_input_changed    (GimpOperationContour *self);
+
+/*  the image canvas in layer coordinates (-offset_x, -offset_y, image
+ *  width, height), used when "align-with-layer" is off; returns whether
+ *  it changed the rendering (the caller invalidates)
+ */
+gboolean   gimp_operation_contour_set_canvas       (GimpOperationContour *self,
+                                                    const GeglRectangle  *canvas);
+gboolean   gimp_operation_contour_get_align_with_layer
+                                                   (GimpOperationContour *self);
+
+gboolean   gimp_operation_contour_render_coverage  (GimpOperationContour *self,
+                                                    const gfloat         *alpha,
+                                                    const GeglRectangle  *alpha_rect,
+                                                    const GeglRectangle  *rect,
+                                                    gint                  level,
+                                                    guchar               *mask,
+                                                    gint                  mask_stride,
+                                                    guchar               *burst,
+                                                    gint                  burst_stride);
+
+GimpContourComposite *
+           gimp_operation_contour_composite_new    (GimpOperationContour *self,
+                                                    const Babl           *format,
+                                                    const GeglRectangle  *in_rect,
+                                                    gint                  level,
+                                                    gint                  max_width);
+void       gimp_operation_contour_composite_free   (GimpContourComposite *comp);
+void       gimp_operation_contour_composite_row    (GimpContourComposite *comp,
+                                                    const gfloat         *in,
+                                                    gfloat               *out,
+                                                    const guchar         *m,
+                                                    const guchar         *b,
+                                                    gint                  x,
+                                                    gint                  y,
+                                                    gint                  width);
