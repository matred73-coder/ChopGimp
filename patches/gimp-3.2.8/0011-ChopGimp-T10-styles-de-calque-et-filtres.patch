+static void
+gimp_operation_contour_set_property (GObject      *object,
+                                     guint         property_id,
+                                     const GValue *value,
+                                     GParamSpec   *pspec)
+{
+  GimpOperationContour *self = GIMP_OPERATION_CONTOUR (object);
+
+  switch (property_id)
+    {
+    case PROP_POSITION:
+      self->position = g_value_get_enum (value);
+      break;
+
+    case PROP_WIDTH:
+      self->width = g_value_get_double (value);
+      break;
+
+    case PROP_COLOR:
+      g_clear_object (&self->color);
+      self->color = g_value_dup_object (value);
+      break;
+
+    case PROP_OPACITY:
+      self->opacity = g_value_get_double (value);
+      break;
+
+    case PROP_ANTIALIAS:
+      self->antialias = g_value_get_boolean (value);
+      break;
+
+    case PROP_DASH_PRESET:
+      self->dash_preset = g_value_get_enum (value);
+      break;
+
+    case PROP_CAP_STYLE:
+      self->cap_style = g_value_get_enum (value);
+      break;
+
+    case PROP_JOIN_STYLE:
+      self->join_style = g_value_get_enum (value);
+      break;
+
+    case PROP_MITER_LIMIT:
+      self->miter_limit = g_value_get_double (value);
+      break;
+
+    case PROP_THRESHOLD:
+      self->threshold = g_value_get_double (value);
+      break;
+
+    case PROP_MODE:
+      self->mode = g_value_get_enum (value);
+      break;
+
+    case PROP_OVERPRINT:
+      self->overprint = g_value_get_boolean (value);
+      break;
+
+    case PROP_FILL_TYPE:
+      self->fill_type = g_value_get_enum (value);
+      break;
+
+    case PROP_GRADIENT:
+      {
+        const gchar *data = g_value_get_string (value);
+
+        if (g_strcmp0 (data, self->gradient_data))
+          {
+            GObject *gradient = gimp_operation_contour_parse_gradient (data);
+
+            g_free (self->gradient_data);
+            self->gradient_data = g_strdup (data);
+
+            g_mutex_lock (&self->fill_mutex);
+            g_clear_object (&self->gradient);
+            self->gradient = gradient;
+            self->fill_generation++;
+            g_mutex_unlock (&self->fill_mutex);
+          }
+      }
+      break;
+
+    case PROP_GRADIENT_REVERSE:
+      self->gradient_reverse = g_value_get_boolean (value);
+      break;
+
+    case PROP_GRADIENT_STYLE:
+      self->gradient_style = g_value_get_enum (value);
+      break;
+
+    case PROP_GRADIENT_ANGLE:
+      self->gradient_angle = g_value_get_double (value);
+      break;
+
+    case PROP_GRADIENT_SCALE:
+      self->gradient_scale = g_value_get_double (value);
+      break;
+
+    case PROP_GRADIENT_OFFSET_X:
+      self->gradient_offset_x = g_value_get_double (value);
+      break;
+
+    case PROP_GRADIENT_OFFSET_Y:
+      self->gradient_offset_y = g_value_get_double (value);
+      break;
+
+    case PROP_PATTERN:
+      {
+        const gchar *data = g_value_get_string (value);
+
+        if (g_strcmp0 (data, self->pattern_data))
+          {
+            GObject *pattern = gimp_operation_contour_parse_pattern (data);
+
+            g_free (self->pattern_data);
+            self->pattern_data = g_strdup (data);
+
+            g_mutex_lock (&self->fill_mutex);
+            g_clear_object (&self->pattern);
+            self->pattern = pattern;
+            self->fill_generation++;
+            g_mutex_unlock (&self->fill_mutex);
+          }
+      }
+      break;
+
+    case PROP_PATTERN_SCALE:
+      self->pattern_scale = g_value_get_double (value);
+      break;
+
+    case PROP_PATTERN_ANGLE:
+      self->pattern_angle = g_value_get_double (value);
+      break;
+
+    case PROP_PATTERN_OFFSET_X:
+      self->pattern_offset_x = g_value_get_double (value);
+      break;
+
+    case PROP_PATTERN_OFFSET_Y:
+      self->pattern_offset_y = g_value_get_double (value);
+      break;
+
+    case PROP_ALIGN_WITH_LAYER:
+      self->align_with_layer = g_value_get_boolean (value);
+      break;
+
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      return;
+    }
+
+  /*  the cached outline depends on the threshold only, but keep it simple  */
+  g_atomic_int_inc (&self->generation);
+}
+
+static void
+gimp_operation_contour_prepare (GeglOperation *operation)
+{
+  const Babl *space  = gegl_operation_get_source_space (operation, "input");
+  const Babl *format = babl_format_with_space ("RGBA float", space);
+
+  gegl_operation_set_format (operation, "input",  format);
+  gegl_operation_set_format (operation, "output", format);
+}
+
+/*  how far the stroke goes beyond the layer's edge, in pixels  */
+static gint
+gimp_operation_contour_get_grow (GimpOperationContour *self)
+{
+  gdouble half;
+
+  /*  ChopGimp 3.32.0: Satin, Incrustation de motif stay inside  */
+  if (self->position == GIMP_CONTOUR_POSITION_INSIDE ||
+      GIMP_OPERATION_CONTOUR_GET_CLASS (self)->fill_coverage)
+    return 0;
+
+  if (self->position == GIMP_CONTOUR_POSITION_CENTER)
+    half = self->width / 2.0;
+  else
+    half = self->width;
+
+  /*  the outline only has right angles: a miter (or a square cap)
+   *  goes at most half * sqrt (2) away from the path, plus a pixel
+   *  of antialiasing
+   */
+  return (gint) ceil (half * G_SQRT2) + 2;
+}
+
+/*  how far from a pixel the outline can be and still affect it: the
+ *  stroke's reach on both sides of the path, whatever the position.
+ *  Solid strokes are local: a region of the output only depends on the
+ *  input's alpha in that region grown by this margin. The outline found
+ *  on such a crop has extra edges along the crop's border, more than the
+ *  stroke's reach away from the region, so they don't touch it.
+ */
+static gint
+gimp_operation_contour_get_margin_scaled (GimpOperationContour *self,
+                                          gdouble               scale)
+{
+  GimpOperationContourClass *klass = GIMP_OPERATION_CONTOUR_GET_CLASS (self);
+  gdouble                    half;
+
+  if (klass->fill_coverage)
+    return klass->fill_margin ? klass->fill_margin (self, scale) : 0;
+
+  if (self->position == GIMP_CONTOUR_POSITION_CENTER)
+    half = self->width / 2.0;
+  else
+    half = self->width;
+
+  return (gint) ceil (half * scale * G_SQRT2) + 3;
+}
+
+static gint
+gimp_operation_contour_get_margin (GimpOperationContour *self)
+{
+  return gimp_operation_contour_get_margin_scaled (self, 1.0);
+}
+
+/*  dashes depend on the whole outline (where each closed path starts
+ *  and how long it is), only solid strokes can be computed locally
+ */
+static gboolean
+gimp_operation_contour_is_local (GimpOperationContour *self)
+{
+  /*  the inside effects only read around each pixel  */
+  if (GIMP_OPERATION_CONTOUR_GET_CLASS (self)->fill_coverage)
+    return TRUE;
+
+  return self->dash_preset == GIMP_CONTOUR_DASH_LINE;
+}
+
+static GeglRectangle
+gimp_operation_contour_get_bounding_box (GeglOperation *operation)
+{
+  GimpOperationContour *self   = GIMP_OPERATION_CONTOUR (operation);
+  GeglRectangle         result = { 0, 0, 0, 0 };
+  const GeglRectangle  *in_rect;
+  gint                  grow;
+
+  in_rect = gegl_operation_source_get_bounding_box (operation, "input");
+
+  if (! in_rect)
+    return result;
+
+  if (gegl_rectangle_is_infinite_plane (in_rect) ||
+      gegl_rectangle_is_empty (in_rect))
+    return *in_rect;
+
+  grow = gimp_operation_contour_get_grow (self);
+
+  result.x      = in_rect->x - grow;
+  result.y      = in_rect->y - grow;
+  result.width  = in_rect->width  + 2 * grow;
+  result.height = in_rect->height + 2 * grow;
+
+  return result;
+}
+
+static GeglRectangle
+gimp_operation_contour_get_required_for_output (GeglOperation       *operation,
+                                                const gchar         *input_pad,
+                                                const GeglRectangle *roi)
+{
+  GimpOperationContour *self = GIMP_OPERATION_CONTOUR (operation);
+  const GeglRectangle  *in_rect;
+  GeglRectangle         result;
+  gint                  margin;
+
+  in_rect = gegl_operation_source_get_bounding_box (operation, "input");
+
+  if (! in_rect || gegl_rectangle_is_infinite_plane (in_rect))
+    return *roi;
+
+  /*  a dashed outline depends on the whole layer  */
+  if (! gimp_operation_contour_is_local (self))
+    return *in_rect;
+
+  margin = gimp_operation_contour_get_margin (self);
+
+  result.x      = roi->x - margin;
+  result.y      = roi->y - margin;
+  result.width  = roi->width  + 2 * margin;
+  result.height = roi->height + 2 * margin;
+
+  gegl_rectangle_intersect (&result, &result, in_rect);
+
+  return result;
+}
+
+static GeglRectangle
+gimp_operation_contour_get_invalidated_by_change (GeglOperation       *operation,
+                                                  const gchar         *input_pad,
+                                                  const GeglRectangle *input_region)
+{
+  GimpOperationContour *self = GIMP_OPERATION_CONTOUR (operation);
+  GeglRectangle         result;
+  gint                  margin;
+
+  /*  the input changed: the cached outline is outdated  */
+  g_atomic_int_inc (&self->generation);
+
+  /*  a change anywhere can move the dashes everywhere  */
+  if (! gimp_operation_contour_is_local (self))
+    return gimp_operation_contour_get_bounding_box (operation);
+
+  margin = gimp_operation_contour_get_margin (self);
+
+  result.x      = input_region->x - margin;
+  result.y      = input_region->y - margin;
+  result.width  = input_region->width  + 2 * margin;
+  result.height = input_region->height + 2 * margin;
+
+  return result;
+}
+
+static GeglRectangle
+gimp_operation_contour_get_cached_region (GeglOperation       *operation,
+                                          const GeglRectangle *roi)
+{
+  /*  only the requested region is rendered: solid strokes need the
+   *  region grown by their reach, dashed strokes reuse the cached
+   *  outline of the whole layer
+   */
+  return *roi;
+}
+
+/*  finds the sorted outline of the input's alpha, at the threshold, in
+ *  rect; the segments are relative to rect's origin. Returns NULL if
+ *  there is no outline.
+ */
+static GimpBoundSeg *
+gimp_operation_contour_find_outline_alpha (GimpOperationContour *self,
+                                           const gfloat         *alpha,
+                                           const GeglRectangle  *rect,
+                                           gint                 *n_groups)
+{
+  GeglBuffer   *alpha_buffer;
+  GimpBoundSeg *segs;
+  GimpBoundSeg *sorted;
+  gint          n_segs = 0;
+
+  *n_groups = 0;
+
+  /*  gimp_boundary_find() wants a buffer starting at 0, 0  */
+  alpha_buffer =
+    gegl_buffer_linear_new_from_data ((gpointer) alpha, babl_format ("Y float"),
+                                      GEGL_RECTANGLE (0, 0,
+                                                      rect->width,
+                                                      rect->height),
+                                      rect->width * sizeof (gfloat),
+                                      NULL, NULL);
+
+  segs = gimp_boundary_find (alpha_buffer, NULL, babl_format ("Y float"),
+                             GIMP_BOUNDARY_WITHIN_BOUNDS,
+                             0, 0, rect->width, rect->height,
+                             self->threshold,
+                             &n_segs);
+
+  g_object_unref (alpha_buffer);
+
+  if (n_segs == 0)
+    {
+      g_free (segs);
+      return NULL;
+    }
+
+  sorted = gimp_boundary_sort (segs, n_segs, n_groups);
+  g_free (segs);
+
+  return sorted;
+}
+
+/*  rect is in the coordinates of the mipmap level  */
+static GimpBoundSeg *
+gimp_operation_contour_find_outline (GimpOperationContour *self,
+                                     GeglBuffer           *input,
+                                     const GeglRectangle  *rect,
+                                     gint                  level,
+                                     gint                 *n_groups)
+{
+  GimpBoundSeg *sorted;
+  gfloat       *alpha;
+
+  *n_groups = 0;
+
+  alpha = g_try_new (gfloat, (gsize) rect->width * rect->height);
+
+  if (! alpha)
+    return NULL;
+
+  gegl_buffer_get (input, rect, 1.0 / (1 << level), babl_format ("A float"),
+                   alpha, GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+
+  sorted = gimp_operation_contour_find_outline_alpha (self, alpha, rect,
+                                                      n_groups);
+
+  g_free (alpha);
+
+  return sorted;
+}
+
+/*  returns a reference to the outline of the whole input (in_rect),
+ *  computed once and kept until the input or a property changes
+ */
+static GimpContourOutline *
+gimp_operation_contour_get_outline (GimpOperationContour *self,
+                                    GeglBuffer           *input,
+                                    const GeglRectangle  *in_rect,
+                                    gint                  level)
+{
+  GimpContourOutline *outline = NULL;
+  gint                generation;
+
+  generation = g_atomic_int_get (&self->generation);
+
+  g_mutex_lock (&self->outline_mutex);
+
+  if (self->outline                                     &&
+      self->outline_generation == (guint) generation    &&
+      self->outline_level      == level                 &&
+      gegl_rectangle_equal (&self->outline_rect, in_rect))
+    {
+      outline = gimp_contour_outline_ref (self->outline);
+    }
+
+  g_mutex_unlock (&self->outline_mutex);
+
+  if (outline)
+    return outline;
+
+  outline = g_slice_new0 (GimpContourOutline);
+  outline->ref_count = 1;
+  outline->segs      = gimp_operation_contour_find_outline (self, input,
+                                                            in_rect, level,
+                                                            &outline->n_groups);
+
+  g_mutex_lock (&self->outline_mutex);
+
+  /*  don't keep an outline computed from an input which changed meanwhile  */
+  if (g_atomic_int_get (&self->generation) == generation)
+    {
+      g_clear_pointer (&self->outline, gimp_contour_outline_unref);
+
+      self->outline            = gimp_contour_outline_ref (outline);
+      self->outline_rect       = *in_rect;
+      self->outline_level      = level;
+      self->outline_generation = generation;
+    }
+
+  g_mutex_unlock (&self->outline_mutex);
+
+  return outline;
+}
+
+/*  appends the sorted boundary groups to cr's path as closed polygons,
+ *  dropping the vertices where the outline goes straight on
+ */
+static void
+gimp_operation_contour_append_path (cairo_t            *cr,
+                                    const GimpBoundSeg *segs,
+                                    gint                n_groups)
+{
+  gint seg = 0;
+  gint group;
+
+  for (group = 0; group < n_groups; group++)
+    {
+      gint first = seg;
+      gint i;
+
+      while (segs[seg].x1 != -1 ||
+             segs[seg].y1 != -1 ||
+             segs[seg].x2 != -1 ||
+             segs[seg].y2 != -1)
+        seg++;
+
+      if (seg - first >= 2)
+        {
+          cairo_move_to (cr, segs[first].x1, segs[first].y1);
+
+          for (i = first + 1; i < seg; i++)
+            {
+              const GimpBoundSeg *prev = &segs[i - 1];
+              const GimpBoundSeg *cur  = &segs[i];
+
+              if ((prev->x1 == cur->x1 && cur->x1 == cur->x2) ||
+                  (prev->y1 == cur->y1 && cur->y1 == cur->y2))
+                continue;
+
+              cairo_line_to (cr, cur->x1, cur->y1);
+            }
+
+          cairo_close_path (cr);
+        }
+
+      /*  skip the group's end marker  */
+      seg++;
+    }
+}
+
+/*  returns a reference to the gradient's colors and the pattern's pixels
+ *  in format, computed once per change, or NULL if there are none
+ */
+static GimpContourFill *
+gimp_operation_contour_get_fill (GimpOperationContour *self,
+                                 const Babl           *format)
+{
+  GimpContourFill *fill = NULL;
+
+  g_mutex_lock (&self->fill_mutex);
+
+  if (self->fill                                    &&
+      self->fill->format     == format              &&
+      self->fill->generation == self->fill_generation)
+    {
+      fill = self->fill;
+      g_atomic_int_inc (&fill->ref_count);
+    }
+  else if (self->gradient || self->pattern)
+    {
+      fill = g_slice_new0 (GimpContourFill);
+
+      fill->ref_count  = 1;
+      fill->format     = format;
+      fill->generation = self->fill_generation;
+
+      if (self->gradient)
+        {
+          GimpGradient        *gradient = GIMP_GRADIENT (self->gradient);
+          GimpGradientSegment *seg      = NULL;
+          gint                 i;
+
+          fill->lut = g_new (gfloat, 4 * GRADIENT_LUT_SIZE);
+
+          for (i = 0; i < GRADIENT_LUT_SIZE; i++)
+            {
+              GeglColor *color = NULL;
+
+              seg = gimp_gradient_get_color_at (gradient, NULL, seg,
+                                                (gdouble) i /
+                                                (GRADIENT_LUT_SIZE - 1),
+                                                FALSE,
+                                                GIMP_GRADIENT_BLEND_RGB_PERCEPTUAL,
+                                                &color);
+
+              gegl_color_get_pixel (color, format, fill->lut + 4 * i);
+              g_object_unref (color);
+            }
+        }
+
+      if (self->pattern)
+        {
+          GimpTempBuf *mask   = gimp_pattern_get_mask (GIMP_PATTERN (self->pattern));
+          gint         width  = gimp_temp_buf_get_width  (mask);
+          gint         height = gimp_temp_buf_get_height (mask);
+
+          fill->pattern = g_try_new (gfloat, (gsize) width * height * 4);
+
+          if (fill->pattern)
+            {
+              /*  premultiplied, for the bilinear interpolation  */
+              babl_process (babl_fish (gimp_temp_buf_get_format (mask),
+                                       babl_format_with_space ("RaGaBaA float",
+                                                               format)),
+                            gimp_temp_buf_get_data (mask),
+                            fill->pattern,
+                            (glong) width * height);
+
+              fill->pattern_width  = width;
+              fill->pattern_height = height;
+            }
+        }
+
+      g_clear_pointer (&self->fill, gimp_contour_fill_unref);
+
+      self->fill = fill;
+      g_atomic_int_inc (&fill->ref_count);
+    }
+
+  g_mutex_unlock (&self->fill_mutex);
+
+  return fill;
+}
+
+/*  how far the stroke reaches from the outline, on its side(s)  */
+static gdouble
+gimp_operation_contour_get_reach (GimpOperationContour *self,
+                                  gdouble               scale)
+{
+  if (self->position == GIMP_CONTOUR_POSITION_CENTER)
+    return self->width * scale / 2.0;
+
+  return self->width * scale;
+}
+
+/*  sets cr up for stroking the outline: origin, antialiasing, clip on
+ *  the stroke's side of the outline, caps, joins and dashes; the line
+ *  width is left to the caller
+ */
+static void
+gimp_operation_contour_setup_cairo (GimpOperationContour *self,
+                                    cairo_t              *cr,
+                                    const GimpBoundSeg   *sorted,
+                                    gint                  n_groups,
+                                    const GeglRectangle  *origin,
+                                    const GeglRectangle  *roi,
+                                    gdouble               scale)
+{
+  /*  boundary coordinates are relative to the origin of the region
+   *  they were found in
+   */
+  cairo_translate (cr, origin->x - roi->x, origin->y - roi->y);
+
+  cairo_set_antialias (cr, self->antialias ?
+                           CAIRO_ANTIALIAS_DEFAULT : CAIRO_ANTIALIAS_NONE);
+  cairo_set_fill_rule (cr, CAIRO_FILL_RULE_EVEN_ODD);
+
+  switch (self->position)
+    {
+    case GIMP_CONTOUR_POSITION_OUTSIDE:
+      /*  keep the outer half of the stroke only  */
+      cairo_rectangle (cr,
+                       roi->x - origin->x, roi->y - origin->y,
+                       roi->width, roi->height);
+      gimp_operation_contour_append_path (cr, sorted, n_groups);
+      cairo_clip (cr);
+      break;
+
+    case GIMP_CONTOUR_POSITION_CENTER:
+      break;
+
+    case GIMP_CONTOUR_POSITION_INSIDE:
+      /*  keep the inner half of the stroke only  */
+      gimp_operation_contour_append_path (cr, sorted, n_groups);
+      cairo_clip (cr);
+      break;
+    }
+
+  switch (self->cap_style)
+    {
+    case GIMP_CAP_BUTT:
+      cairo_set_line_cap (cr, CAIRO_LINE_CAP_BUTT);
+      break;
+    case GIMP_CAP_ROUND:
+      cairo_set_line_cap (cr, CAIRO_LINE_CAP_ROUND);
+      break;
+    case GIMP_CAP_SQUARE:
+      cairo_set_line_cap (cr, CAIRO_LINE_CAP_SQUARE);
+      break;
+    }
+
+  switch (self->join_style)
+    {
+    case GIMP_JOIN_MITER:
+      cairo_set_line_join (cr, CAIRO_LINE_JOIN_MITER);
+      break;
+    case GIMP_JOIN_ROUND:
+      cairo_set_line_join (cr, CAIRO_LINE_JOIN_ROUND);
+      break;
+    case GIMP_JOIN_BEVEL:
+      cairo_set_line_join (cr, CAIRO_LINE_JOIN_BEVEL);
+      break;
+    }
+
+  cairo_set_miter_limit (cr, self->miter_limit);
+
+  if (self->dash_preset != GIMP_CONTOUR_DASH_LINE)
+    {
+      GArray *pattern;
+
+      /*  GimpContourDash is GimpDashPreset without GIMP_DASH_CUSTOM  */
+      pattern = gimp_dash_pattern_new_from_preset ((GimpDashPreset)
+                                                   (self->dash_preset +
+                                                    GIMP_DASH_LINE));
+
+      if (pattern)
+        {
+          gdouble *dashes;
+          guint    i;
+
+          /*  dash lengths are in units of the visible stroke width,
+           *  like gimp_scan_convert_stroke() does
+           */
+          dashes = g_new (gdouble, pattern->len);
+
+          for (i = 0; i < pattern->len; i++)
+            dashes[i] = MAX (self->width * scale, 1.0) *
+                        g_array_index (pattern, gdouble, i);
+
+          cairo_set_dash (cr, dashes, pattern->len, 0.0);
+
+          g_free (dashes);
+          gimp_dash_pattern_free (pattern);
+        }
+    }
+
+  cairo_new_path (cr);
+  gimp_operation_contour_append_path (cr, sorted, n_groups);
+}
+
+/*  "shape burst": how far each pixel is from the outline, across the
+ *  stroke. The stroke is drawn n times, growing, each adding 1/n: a
+ *  pixel at a fraction t of the reach gets about (1 - t) * 255
+ */
+static void
+gimp_operation_contour_render_burst (GimpOperationContour *self,
+                                     cairo_surface_t      *surface,
+                                     const GimpBoundSeg   *sorted,
+                                     gint                  n_groups,
+                                     const GeglRectangle  *origin,
+                                     const GeglRectangle  *roi,
+                                     gdouble               scale)
+{
+  cairo_t         *cr;
+  gdouble          reach = gimp_operation_contour_get_reach (self, scale);
+  gint             n_levels;
+  gint             k;
+
+  n_levels = CLAMP ((gint) ceil (reach), 4, SHAPE_BURST_MAX_LEVELS);
+
+  cr = cairo_create (surface);
+
+  gimp_operation_contour_setup_cairo (self, cr, sorted, n_groups,
+                                      origin, roi, scale);
+
+  cairo_set_operator (cr, CAIRO_OPERATOR_ADD);
+  cairo_set_source_rgba (cr, 0.0, 0.0, 0.0, 1.0 / n_levels);
+
+  for (k = 1; k <= n_levels; k++)
+    {
+      cairo_set_line_width (cr, 2.0 * reach * k / n_levels);
+      cairo_stroke_preserve (cr);
+    }
+
+  cairo_destroy (cr);
+
+  cairo_surface_flush (surface);
+}
+
+/*  position (0..1) in the gradient of the pixel whose center is x, y
+ *  (layer coordinates), for the geometric styles; the gradient spans
+ *  in_rect: the layer (aligned with the layer, as Photoshop's default)
+ *  or the image canvas
+ */
+static gfloat
+gimp_operation_contour_gradient_pos (GimpOperationContour *self,
+                                     const GeglRectangle  *in_rect,
+                                     gdouble               x,
+                                     gdouble               y)
+{
+  gdouble angle = self->gradient_angle * G_PI / 180.0;
+  gdouble scale = MAX (self->gradient_scale, 1.0) / 100.0;
+  gdouble ux    = cos (angle);
+  gdouble uy    = -sin (angle);
+  gdouble w     = in_rect->width;
+  gdouble h     = in_rect->height;
+  gdouble dx    = x - (in_rect->x + w / 2.0 + self->gradient_offset_x);
+  gdouble dy    = y - (in_rect->y + h / 2.0 + self->gradient_offset_y);
+  gdouble pos   = 0.0;
+  gdouble len;
+
+  switch (self->gradient_style)
+    {
+    case GIMP_CONTOUR_GRADIENT_LINEAR:
+      len = (fabs (w * ux) + fabs (h * uy)) * scale;
+      pos = (dx * ux + dy * uy) / MAX (len, 1.0) + 0.5;
+      break;
+
+    case GIMP_CONTOUR_GRADIENT_REFLECTED:
+      len = (fabs (w * ux) + fabs (h * uy)) * scale;
+      pos = fabs (dx * ux + dy * uy) / MAX (len / 2.0, 1.0);
+      break;
+
+    case GIMP_CONTOUR_GRADIENT_RADIAL:
+      len = sqrt (w * w + h * h) / 2.0 * scale;
+      pos = sqrt (dx * dx + dy * dy) / MAX (len, 1.0);
+      break;
+
+    case GIMP_CONTOUR_GRADIENT_ANGLE:
+      pos = atan2 (-dy, dx) - angle;
+      pos = fmod (pos, 2.0 * G_PI);
+      if (pos < 0.0)
+        pos += 2.0 * G_PI;
+      pos /= 2.0 * G_PI;
+      break;
+
+    case GIMP_CONTOUR_GRADIENT_DIAMOND:
+      {
+        gdouble rx = dx * ux + dy * uy;
+        gdouble ry = dy * ux - dx * uy;
+
+        len = MAX (w, h) / 2.0 * scale;
+        pos = (fabs (rx) + fabs (ry)) / MAX (len, 1.0);
+      }
+      break;
+
+    case GIMP_CONTOUR_GRADIENT_SHAPE_BURST:
+      /*  computed from the burst surface  */
+      break;
+    }
+
+  return CLAMP (pos, 0.0, 1.0);
+}
+
+/*  premultiplied pattern color at x, y (layer coordinates), tiled,
+ *  bilinear
+ */
+static void
+gimp_operation_contour_pattern_color (GimpOperationContour  *self,
+                                      const GimpContourFill *fill,
+                                      gdouble                cos_a,
+                                      gdouble                sin_a,
+                                      gdouble                inv_scale,
+                                      gdouble                x,
+                                      gdouble                y,
+                                      gfloat                *color)
+{
+  gint     w  = fill->pattern_width;
+  gint     h  = fill->pattern_height;
+  gdouble  px = x - self->pattern_offset_x;
+  gdouble  py = y - self->pattern_offset_y;
+  gdouble  u  = ( px * cos_a + py * sin_a) * inv_scale - 0.5;
+  gdouble  v  = (-px * sin_a + py * cos_a) * inv_scale - 0.5;
+  gdouble  fu = floor (u);
+  gdouble  fv = floor (v);
+  gfloat   tu = u - fu;
+  gfloat   tv = v - fv;
+  gint     x0 = (gint) fmod (fu, w);
+  gint     y0 = (gint) fmod (fv, h);
+  gint     x1, y1;
+  const gfloat *p00, *p01, *p10, *p11;
+  gint     c;
+
+  if (x0 < 0) x0 += w;
+  if (y0 < 0) y0 += h;
+
+  x1 = (x0 + 1) % w;
+  y1 = (y0 + 1) % h;
+
+  p00 = fill->pattern + 4 * ((gsize) y0 * w + x0);
+  p10 = fill->pattern + 4 * ((gsize) y0 * w + x1);
+  p01 = fill->pattern + 4 * ((gsize) y1 * w + x0);
+  p11 = fill->pattern + 4 * ((gsize) y1 * w + x1);
+
+  for (c = 0; c < 4; c++)
+    color[c] = (p00[c] * (1.0f - tu) + p10[c] * tu) * (1.0f - tv) +
+               (p01[c] * (1.0f - tu) + p11[c] * tu) * tv;
+}
+
+static const Babl *
+gimp_operation_contour_get_blend_format (GimpLayerMode  mode,
+                                         const Babl    *format)
+{
+  switch (gimp_layer_mode_get_blend_space (mode))
+    {
+    case GIMP_LAYER_COLOR_SPACE_RGB_NON_LINEAR:
+      return babl_format_with_space ("R'G'B'A float", format);
+
+    case GIMP_LAYER_COLOR_SPACE_RGB_PERCEPTUAL:
+      return babl_format_with_space ("R~G~B~A float", format);
+
+    case GIMP_LAYER_COLOR_SPACE_LAB:
+      return babl_format_with_space ("CIE Lab alpha float", format);
+
+    default:
+      return format;
+    }
+}
+
+
+/*  ChopGimp: the stroke is rendered in two steps, shared with
+ *  chopgimp:layer-style-fused (gimpoperationlayerstylefused.c):
+ *
+ *  1. its coverage: cairo strokes the outline of the input's alpha into
+ *     an A8 mask (and the "shape burst" distances into another one),
+ *     gimp_operation_contour_render_coverage();
+ *  2. the compositing of the stroke with the layer, one row at a time,
+ *     gimp_operation_contour_composite_row().
+ *
+ *  Mipmap levels: at level L, the coordinates are those of the level
+ *  (1 / 2^L of the image's), the stroke's width, dashes and reach are
+ *  scaled by 1 / 2^L, and the gradient and pattern are positioned in
+ *  image coordinates, so a zoomed-out (draft) rendering shows the same
+ *  stroke, smaller.
+ */
+
+struct _GimpContourComposite
+{
+  GimpOperationContour   *self;
+  const Babl             *format;
+  GeglRectangle           in_rect;     /*  gradient's area, level 0  */
+  gdouble                 pattern_x;   /*  pattern's origin, level 0  */
+  gdouble                 pattern_y;
+  gint                    factor;      /*  1 << level  */
+  gfloat                  color[4];
+  gfloat                  strength;
+  gboolean                behind;
+  gboolean                clip_alpha;
+  gboolean                atop;        /*  inside effect, alpha kept  */
+  gboolean                simple;
+  GimpContourFill        *fill;
+  GimpContourFillType     fill_type;
+  GimpLayerModeBlendFunc  blend_func;
+  const Babl             *to_blend;
+  const Babl             *from_blend;
+  gdouble                 cos_a;
+  gdouble                 sin_a;
+  gdouble                 inv_scale;
+  gint                    max_width;
+  gfloat                 *src_row;
+  gfloat                 *alpha_row;
+  gfloat                 *in_row;
+  gfloat                 *layer_row;
+  gfloat                 *comp_row;
+};
+
+void
+gimp_operation_contour_scale_rect (const GeglRectangle *rect,
+                                   gint                 level,
+                                   GeglRectangle       *result)
+{
+  gint x1, y1, x2, y2;
+
+  if (level <= 0)
+    {
+      *result = *rect;
+      return;
+    }
+
+  /*  the level's pixels touching rect  */
+  x1 = rect->x >> level;
+  y1 = rect->y >> level;
+  x2 = (rect->x + rect->width  + (1 << level) - 1) >> level;
+  y2 = (rect->y + rect->height + (1 << level) - 1) >> level;
+
+  result->x      = x1;
+  result->y      = y1;
+  result->width  = x2 - x1;
+  result->height = y2 - y1;
+}
+
+gint
+gimp_operation_contour_get_level_margin (GimpOperationContour *self,
+                                         gint                  level)
+{
+  return gimp_operation_contour_get_margin_scaled (self,
+                                                   1.0 / (1 << MAX (level, 0)));
+}
+
+gboolean
+gimp_operation_contour_get_is_local (GimpOperationContour *self)
+{
+  return gimp_operation_contour_is_local (self);
+}
+
+gboolean
+gimp_operation_contour_get_needs_burst (GimpOperationContour *self)
+{
+  return (self->fill_type      == GIMP_CONTOUR_FILL_GRADIENT &&
+          self->gradient_style == GIMP_CONTOUR_GRADIENT_SHAPE_BURST);
+}
+
+gint
+gimp_operation_contour_mask_stride (gint width)
+{
+  return cairo_format_stride_for_width (CAIRO_FORMAT_A8, width);
+}
+
+void
+gimp_operation_contour_input_changed (GimpOperationContour *self)
+{
+  g_atomic_int_inc (&self->generation);
+}
+
+/*  renders the stroke's coverage of rect into mask (and the shape burst
+ *  distances into burst, if not NULL), A8 with the given strides (see
+ *  gimp_operation_contour_mask_stride()). The outline is the one of
+ *  sorted / n_groups, relative to origin. Returns FALSE (masks cleared)
+ *  if nothing is stroked.
+ */
+static gboolean
+gimp_operation_contour_render_masks (GimpOperationContour *self,
+                                     const GimpBoundSeg   *sorted,
+                                     gint                  n_groups,
+                                     const GeglRectangle  *origin,
+                                     const GeglRectangle  *rect,
+                                     gint                  level,
+                                     guchar               *mask,
+                                     gint                  mask_stride,
+                                     guchar               *burst,
+                                     gint                  burst_stride)
+{
+  gdouble          scale = 1.0 / (1 << MAX (level, 0));
+  cairo_surface_t *surface;
+  cairo_t         *cr;
+
+  memset (mask, 0, (gsize) mask_stride * rect->height);
+
+  if (burst)
+    memset (burst, 0, (gsize) burst_stride * rect->height);
+
+  if (! sorted || n_groups == 0 || self->opacity <= 0.0)
+    return FALSE;
+
+  surface = cairo_image_surface_create_for_data (mask, CAIRO_FORMAT_A8,
+                                                 rect->width, rect->height,
+                                                 mask_stride);
+
+  if (cairo_surface_status (surface) != CAIRO_STATUS_SUCCESS)
+    {
+      cairo_surface_destroy (surface);
+      return FALSE;
+    }
+
+  cr = cairo_create (surface);
+
+  gimp_operation_contour_setup_cairo (self, cr, sorted, n_groups,
+                                      origin, rect, scale);
+
+  cairo_set_line_width (cr,
+                        2.0 * gimp_operation_contour_get_reach (self, scale));
+  cairo_set_source_rgba (cr, 0.0, 0.0, 0.0, 1.0);
+  cairo_stroke (cr);
+
+  cairo_destroy (cr);
+
+  cairo_surface_flush (surface);
+  cairo_surface_destroy (surface);
+
+  if (burst)
+    {
+      surface = cairo_image_surface_create_for_data (burst, CAIRO_FORMAT_A8,
+                                                     rect->width,
+                                                     rect->height,
+                                                     burst_stride);
+
+      if (cairo_surface_status (surface) == CAIRO_STATUS_SUCCESS)
+        gimp_operation_contour_render_burst (self, surface,
+                                             sorted, n_groups,
+                                             origin, rect, scale);
+
+      cairo_surface_destroy (surface);
+    }
+
+  return TRUE;
+}
+
+/*  the coverage of rect (level coordinates) by a solid (local) stroke,
+ *  from the input's alpha in alpha_rect, which must hold rect grown by
+ *  gimp_operation_contour_get_level_margin(), clipped to the input's
+ *  extent at that level
+ */
+gboolean
+gimp_operation_contour_render_coverage (GimpOperationContour *self,
+                                        const gfloat         *alpha,
+                                        const GeglRectangle  *alpha_rect,
+                                        const GeglRectangle  *rect,
+                                        gint                  level,
+                                        guchar               *mask,
+                                        gint                  mask_stride,
+                                        guchar               *burst,
+                                        gint                  burst_stride)
+{
+  GimpBoundSeg *sorted   = NULL;
+  gint          n_groups = 0;
+  gboolean      result;
+
+  if (alpha_rect->width > 0 && alpha_rect->height > 0 &&
+      self->opacity > 0.0)
+    {
+      sorted = gimp_operation_contour_find_outline_alpha (self, alpha,
+                                                          alpha_rect,
+                                                          &n_groups);
+    }
+
+  result = gimp_operation_contour_render_masks (self, sorted, n_groups,
+                                                alpha_rect, rect, level,
+                                                mask, mask_stride,
+                                                burst, burst_stride);
+
+  g_free (sorted);
+
+  return result;
+}
+
+GimpContourComposite *
+gimp_operation_contour_composite_new (GimpOperationContour *self,
+                                      const Babl           *format,
+                                      const GeglRectangle  *in_rect,
+                                      gint                  level,
+                                      gint                  max_width)
+{
+  GimpContourComposite *comp = g_slice_new0 (GimpContourComposite);
+
+  comp->self      = self;
+  comp->format    = format;
+  comp->in_rect   = *in_rect;
+
+  /*  not aligned with the layer: the image canvas  */
+  if (! self->align_with_layer &&
+      self->canvas.width > 0 && self->canvas.height > 0)
+    {
+      comp->in_rect   = self->canvas;
+      comp->pattern_x = self->canvas.x;
+      comp->pattern_y = self->canvas.y;
+    }
+  comp->factor    = 1 << MAX (level, 0);
+  comp->max_width = max_width;
+
+  comp->color[0] = comp->color[1] = comp->color[2] = 0.0f;
+  comp->color[3] = 1.0f;
+
+  /*  the fill: a missing gradient or pattern falls back to the color  */
+
+  comp->fill_type = self->fill_type;
+
+  if (comp->fill_type != GIMP_CONTOUR_FILL_COLOR)
+    {
+      comp->fill = gimp_operation_contour_get_fill (self, format);
+
+      if (! comp->fill                                                      ||
+          (comp->fill_type == GIMP_CONTOUR_FILL_GRADIENT && ! comp->fill->lut) ||
+          (comp->fill_type == GIMP_CONTOUR_FILL_PATTERN  && ! comp->fill->pattern))
+        {
+          comp->fill_type = GIMP_CONTOUR_FILL_COLOR;
+        }
+    }
+
+  if (self->color)
+    gegl_color_get_pixel (self->color, format, comp->color);
+
+  comp->behind     = (self->position == GIMP_CONTOUR_POSITION_OUTSIDE &&
+                      ! self->overprint);
+  comp->clip_alpha = (self->position == GIMP_CONTOUR_POSITION_INSIDE);
+
+  /*  ChopGimp 3.32.0: Satin, Incrustation de motif: the effect is
+   *  composited inside the layer, whose alpha stays (Photoshop's overlays)
+   */
+  if (GIMP_OPERATION_CONTOUR_GET_CLASS (self)->fill_coverage)
+    {
+      comp->atop       = TRUE;
+      comp->behind     = FALSE;
+      comp->clip_alpha = FALSE;
+    }
+
+  if (! comp->behind && self->mode != GIMP_LAYER_MODE_NORMAL)
+    comp->blend_func = gimp_layer_mode_get_blend_function (self->mode);
+
+  comp->simple = (comp->fill_type == GIMP_CONTOUR_FILL_COLOR &&
+                  ! comp->blend_func);
+
+  if (comp->simple)
+    {
+      /*  a solid color, normal mode: the stroke of the first version  */
+      comp->strength = self->opacity * CLAMP (comp->color[3], 0.0, 1.0) / 255.0;
+    }
+  else
+    {
+      comp->strength = self->opacity / 255.0;
+
+      if (comp->fill_type == GIMP_CONTOUR_FILL_COLOR)
+        comp->strength *= CLAMP (comp->color[3], 0.0, 1.0);
+
+      if (comp->fill_type == GIMP_CONTOUR_FILL_PATTERN)
+        {
+          gdouble angle = self->pattern_angle * G_PI / 180.0;
+
+          comp->cos_a     = cos (angle);
+          comp->sin_a     = sin (angle);
+          comp->inv_scale = 100.0 / MAX (self->pattern_scale, 1.0);
+        }
+
+      comp->src_row   = g_new (gfloat, 4 * max_width);
+      comp->alpha_row = g_new (gfloat, max_width);
+
+      if (comp->blend_func)
+        {
+          const Babl *blend_format;
+
+          blend_format = gimp_operation_contour_get_blend_format (self->mode,
+                                                                  format);
+          comp->in_row    = g_new (gfloat, 4 * max_width);
+          comp->layer_row = g_new (gfloat, 4 * max_width);
+          comp->comp_row  = g_new (gfloat, 4 * max_width);
+
+          if (blend_format != format)
+            {
+              comp->to_blend   = babl_fish (format, blend_format);
+              comp->from_blend = babl_fish (blend_format, format);
+            }
+        }
+    }
+
+  return comp;
+}
+
+void
+gimp_operation_contour_composite_free (GimpContourComposite *comp)
+{
+  if (comp->fill)
+    gimp_contour_fill_unref (comp->fill);
+
+  g_free (comp->src_row);
+  g_free (comp->alpha_row);
+  g_free (comp->in_row);
+  g_free (comp->layer_row);
+  g_free (comp->comp_row);
+
+  g_slice_free (GimpContourComposite, comp);
+}
+
+/*  composites the stroke with width pixels of the layer (in, "RGBA float"
+ *  in the composite's format), starting at x, y (level coordinates),
+ *  into out (which may be in); m and b are the coverage and shape burst
+ *  of these pixels (b may be NULL). The output's alpha only depends on
+ *  the input's alpha.
+ */
+void
+gimp_operation_contour_composite_row (GimpContourComposite *comp,
+                                      const gfloat         *in,
+                                      gfloat               *out,
+                                      const guchar         *m,
+                                      const guchar         *b,
+                                      gint                  x0,
+                                      gint                  y0,
+                                      gint                  width)
+{
+  GimpOperationContour *self       = comp->self;
+  const gfloat         *color      = comp->color;
+  gboolean              behind     = comp->behind;
+  gboolean              clip_alpha = comp->clip_alpha;
+  gint                  factor     = comp->factor;
+  gint                  x;
+
+  g_return_if_fail (width <= comp->max_width);
+
+  if (comp->simple)
+    {
+      gfloat strength = comp->strength;
+
+      for (x = 0; x < width; x++)
+        {
+          gfloat la = in[3];
+          gfloat sa = m[x] * strength;
+          gfloat a;
+          gint   c;
+
+          if (sa <= 0.0f)
+            {
+              out[0] = in[0];
+              out[1] = in[1];
+              out[2] = in[2];
+              out[3] = in[3];
+            }
+          else if (comp->atop)
+            {
+              /*  inside effect: mixed with the layer, alpha kept  */
+              sa = MIN (sa, 1.0f);
+
+              for (c = 0; c < 3; c++)
+                out[c] = in[c] + (color[c] - in[c]) * sa;
+
+              out[3] = la;
+              a      = la;
+            }
+          else
+            {
+              if (clip_alpha)
+                sa *= la;
+
+              if (behind)
+                {
+                  /*  layer OVER stroke  */
+                  gfloat k = sa * (1.0f - la);
+
+                  a = la + k;
+
+                  for (c = 0; c < 3; c++)
+                    out[c] = (a > 1e-7f ?
+                              (in[c] * la + color[c] * k) / a : 0.0f);
+                }
+              else
+                {
+                  /*  stroke OVER layer  */
+                  gfloat k = la * (1.0f - sa);
+
+                  a = sa + k;
+
+                  for (c = 0; c < 3; c++)
+                    out[c] = (a > 1e-7f ?
+                              (color[c] * sa + in[c] * k) / a : 0.0f);
+                }
+
+              out[3] = a;
+            }
+
+          in  += 4;
+          out += 4;
+        }
+    }
+  else
+    {
+      /*  a color per pixel (gradient, pattern) and/or a blend mode: the
+       *  blend mode (GIMP's layer modes) mixes the stroke with the layer's
+       *  pixels, the result is composited like a layer in that mode
+       *  (W3C compositing: Cs' = (1 - ab) Cs + ab B (Cb, Cs))
+       */
+      GimpContourFill *fill      = comp->fill;
+      gfloat          *src_row   = comp->src_row;
+      gfloat          *alpha_row = comp->alpha_row;
+      gfloat          *in_row    = comp->in_row;
+      gfloat          *layer_row = comp->layer_row;
+      gfloat          *comp_row  = comp->comp_row;
+      gfloat           strength  = comp->strength;
+      gdouble          py        = (y0 + 0.5) * factor;
+
+      /*  the stroke's color and alpha on this row  */
+
+      for (x = 0; x < width; x++)
+        {
+          gfloat *src = src_row + 4 * x;
+          gfloat  sa  = m[x] * strength;
+
+          if (sa <= 0.0f)
+            {
+              alpha_row[x] = 0.0f;
+              src[0] = src[1] = src[2] = 0.0f;
+              src[3] = 1.0f;
+              continue;
+            }
+
+          switch (comp->fill_type)
+            {
+            case GIMP_CONTOUR_FILL_COLOR:
+              src[0] = color[0];
+              src[1] = color[1];
+              src[2] = color[2];
+              break;
+
+            case GIMP_CONTOUR_FILL_GRADIENT:
+              {
+                gfloat        pos;
+                const gfloat *lut;
+
+                if (b)
+                  {
+                    gfloat f = b[x] / 255.0f;
+
+                    switch (self->position)
+                      {
+                      case GIMP_CONTOUR_POSITION_OUTSIDE:
+                        pos = 1.0f - f;
+                        break;
+
+                      case GIMP_CONTOUR_POSITION_INSIDE:
+                        pos = f;
+                        break;
+
+                      case GIMP_CONTOUR_POSITION_CENTER:
+                      default:
+                        /*  the inner half from the inside, the
+                         *  outer half from the edge
+                         */
+                        if (in[4 * x + 3] > self->threshold)
+                          pos = f / 2.0f;
+                        else
+                          pos = 0.5f + (1.0f - f) / 2.0f;
+                        break;
+                      }
+
+                    pos = CLAMP (pos, 0.0f, 1.0f);
+                  }
+                else
+                  {
+                    pos = gimp_operation_contour_gradient_pos (self,
+                                                               &comp->in_rect,
+                                                               (x0 + x + 0.5) *
+                                                               factor,
+                                                               py);
+                  }
+
+                if (self->gradient_reverse)
+                  pos = 1.0f - pos;
+
+                lut = fill->lut +
+                      4 * (gint) (pos * (GRADIENT_LUT_SIZE - 1) + 0.5f);
+
+                src[0] = lut[0];
+                src[1] = lut[1];
+                src[2] = lut[2];
+                sa    *= CLAMP (lut[3], 0.0f, 1.0f);
+              }
+              break;
+
+            case GIMP_CONTOUR_FILL_PATTERN:
+              {
+                gfloat pa;
+
+                gimp_operation_contour_pattern_color (self, fill,
+                                                      comp->cos_a,
+                                                      comp->sin_a,
+                                                      comp->inv_scale,
+                                                      (x0 + x + 0.5) * factor -
+                                                      comp->pattern_x,
+                                                      py - comp->pattern_y,
+                                                      src);
+                pa = CLAMP (src[3], 0.0f, 1.0f);
+
+                if (pa > 1e-7f)
+                  {
+                    src[0] /= pa;
+                    src[1] /= pa;
+                    src[2] /= pa;
+                  }
+
+                sa *= pa;
+              }
+              break;
+            }
+
+          src[3] = 1.0f;
+
+          if (clip_alpha)
+            sa *= in[4 * x + 3];
+
+          alpha_row[x] = sa;
+        }
+
+      /*  the blend mode, in its color space  */
+
+      if (comp->blend_func)
+        {
+          /*  the layer's colors, opaque, in comp_row first  */
+          for (x = 0; x < width; x++)
+            {
+              comp_row[4 * x + 0] = in[4 * x + 0];
+              comp_row[4 * x + 1] = in[4 * x + 1];
+              comp_row[4 * x + 2] = in[4 * x + 2];
+              comp_row[4 * x + 3] = 1.0f;
+            }
+
+          if (comp->to_blend)
+            {
+              babl_process (comp->to_blend, comp_row, in_row, width);
+              babl_process (comp->to_blend, src_row, layer_row, width);
+            }
+          else
+            {
+              memcpy (in_row, comp_row, sizeof (gfloat) * 4 * width);
+              memcpy (layer_row, src_row, sizeof (gfloat) * 4 * width);
+            }
+
+          comp->blend_func (NULL, in_row, layer_row, comp_row, width);
+
+          /*  back to the processing format, in layer_row  */
+          if (comp->from_blend)
+            babl_process (comp->from_blend, comp_row, layer_row, width);
+          else
+            memcpy (layer_row, comp_row, sizeof (gfloat) * 4 * width);
+        }
+
+      /*  the compositing  */
+
+      for (x = 0; x < width; x++)
+        {
+          const gfloat *L  = in  + 4 * x;
+          gfloat       *o  = out + 4 * x;
+          const gfloat *S  = src_row + 4 * x;
+          gfloat        sa = alpha_row[x];
+          gfloat        la = L[3];
+          gfloat        a;
+          gint          c;
+
+          if (sa <= 0.0f)
+            {
+              o[0] = L[0];
+              o[1] = L[1];
+              o[2] = L[2];
+              o[3] = L[3];
+              continue;
+            }
+
+          if (comp->atop)
+            {
+              /*  inside effect (Satin, Incrustation de motif): mixed
+               *  with the layer's colors (blended in the mode), the
+               *  layer's alpha kept
+               */
+              const gfloat *X = comp->blend_func ? layer_row + 4 * x : S;
+
+              sa = MIN (sa, 1.0f);
+
+              for (c = 0; c < 3; c++)
+                o[c] = L[c] + (X[c] - L[c]) * sa;
+
+              a = la;
+            }
+          else if (behind)
+            {
+              /*  layer OVER stroke  */
+              gfloat k = sa * (1.0f - la);
+
+              a = la + k;
+
+              for (c = 0; c < 3; c++)
+                o[c] = (a > 1e-7f ?
+                        (L[c] * la + S[c] * k) / a : 0.0f);
+            }
+          else if (comp->blend_func)
+            {
+              const gfloat *B = layer_row + 4 * x;
+
+              a = sa + la - sa * la;
+
+              for (c = 0; c < 3; c++)
+                o[c] = (a > 1e-7f ?
+                        (sa * (1.0f - la) * S[c] +
+                         sa * la          * B[c] +
+                         (1.0f - sa) * la * L[c]) / a : 0.0f);
+            }
+          else
+            {
+              /*  stroke OVER layer  */
+              gfloat k = la * (1.0f - sa);
+
+              a = sa + k;
+
+              for (c = 0; c < 3; c++)
+                o[c] = (a > 1e-7f ?
+                        (S[c] * sa + L[c] * k) / a : 0.0f);
+            }
+
+          o[3] = a;
+        }
+    }
+}
+
+/*  copies the input (gegl_buffer_copy() only copies level 0)  */
+static void
+gimp_operation_contour_copy (GeglBuffer          *input,
+                             GeglBuffer          *output,
+                             const GeglRectangle *roi,
+                             gint                 level)
+{
+  const Babl         *format = gegl_buffer_get_format (output);
+  GeglBufferIterator *iter;
+
+  if (level == 0)
+    {
+      gegl_buffer_copy (input, roi, GEGL_ABYSS_NONE, output, roi);
+      return;
+    }
+
+  iter = gegl_buffer_iterator_new (output, roi, level, format,
+                                   GEGL_ACCESS_WRITE, GEGL_ABYSS_NONE, 2);
+  gegl_buffer_iterator_add (iter, input, roi, level, format,
+                            GEGL_ACCESS_READ, GEGL_ABYSS_NONE);
+
+  while (gegl_buffer_iterator_next (iter))
+    memcpy (iter->items[0].data, iter->items[1].data,
+            (gsize) iter->length * babl_format_get_bytes_per_pixel (format));
+}
+
+static gboolean
+gimp_operation_contour_process (GeglOperation       *operation,
+                                GeglBuffer          *input,
+                                GeglBuffer          *output,
+                                const GeglRectangle *roi0,
+                                gint                 level)
+{
+  GimpOperationContour *self    = GIMP_OPERATION_CONTOUR (operation);
+  GimpOperationContourClass *klass = GIMP_OPERATION_CONTOUR_GET_CLASS (self);
+  const Babl           *format  = gegl_operation_get_format (operation, "output");
+  const GeglRectangle  *in_rect0;
+  GeglRectangle         in_rect;
+  GeglRectangle         origin;
+  GeglBufferIterator   *iter;
+  GimpContourOutline   *outline = NULL;
+  GimpBoundSeg         *local   = NULL;
+  const GimpBoundSeg   *sorted;
+  gint                  n_groups = 0;
+  GimpContourComposite *comp;
+  guchar               *mask;
+  guchar               *burst  = NULL;
+  gint                  stride;
+
+  GeglRectangle         roi_level;
+  const GeglRectangle  *roi = &roi_level;
+
+  in_rect0 = gegl_operation_source_get_bounding_box (operation, "input");
+
+  if (level < 0)
+    level = 0;
+
+  /*  GEGL gives the region in level 0 coordinates (like to
+   *  gegl:gblur-1d), the buffers are accessed in the level's
+   */
+  roi_level.x      = roi0->x >> level;
+  roi_level.y      = roi0->y >> level;
+  roi_level.width  = ((roi0->x + roi0->width)  >> level) - roi_level.x;
+  roi_level.height = ((roi0->y + roi0->height) >> level) - roi_level.y;
+
+  if (! in_rect0                                  ||
+      gegl_rectangle_is_empty (in_rect0)          ||
+      gegl_rectangle_is_infinite_plane (in_rect0) ||
+      self->opacity <= 0.0                        ||
+      roi->width  > 32767                         ||
+      roi->height > 32767)
+    {
+      gimp_operation_contour_copy (input, output, roi, level);
+      return TRUE;
+    }
+
+  /*  the input's extent at the level  */
+  gimp_operation_contour_scale_rect (in_rect0, level, &in_rect);
+
+  /*  ChopGimp 3.32.0: Satin, Incrustation de motif: their own coverage
+   *  of the layer's inside, then the stroke's compositing
+   */
+  if (klass->fill_coverage)
+    {
+      stride = gimp_operation_contour_mask_stride (roi->width);
+      mask   = g_try_malloc0 ((gsize) stride * roi->height);
+
+      if (! mask ||
+          ! klass->fill_coverage (self, input, &in_rect, roi, level,
+                                  mask, stride))
+        {
+          g_free (mask);
+          gimp_operation_contour_copy (input, output, roi, level);
+          return TRUE;
+        }
+
+      goto composite;
+    }
+
+  /*  1. the outline of the layer's alpha, at the threshold: around the
+   *  region for a solid stroke, of the whole layer (cached) for dashes
+   */
+
+  if (gimp_operation_contour_is_local (self))
+    {
+      gint margin = gimp_operation_contour_get_level_margin (self, level);
+
+      origin.x      = roi->x - margin;
+      origin.y      = roi->y - margin;
+      origin.width  = roi->width  + 2 * margin;
+      origin.height = roi->height + 2 * margin;
+
+      if (gegl_rectangle_intersect (&origin, &origin, &in_rect))
+        local = gimp_operation_contour_find_outline (self, input, &origin,
+                                                     level, &n_groups);
+
+      sorted = local;
+    }
+  else
+    {
+      origin  = in_rect;
+      outline = gimp_operation_contour_get_outline (self, input, &in_rect,
+                                                    level);
+
+      sorted   = outline->segs;
+      n_groups = outline->n_groups;
+    }
+
+  if (! sorted || n_groups == 0)
+    {
+      g_free (local);
+      g_clear_pointer (&outline, gimp_contour_outline_unref);
+      gimp_operation_contour_copy (input, output, roi, level);
+      return TRUE;
+    }
+
+  /*  2. the stroke's coverage, rendered by cairo  */
+
+  stride = gimp_operation_contour_mask_stride (roi->width);
+  mask   = g_try_malloc ((gsize) stride * roi->height);
+
+  if (mask && gimp_operation_contour_get_needs_burst (self))
+    burst = g_try_malloc ((gsize) stride * roi->height);
+
+  if (! mask ||
+      ! gimp_operation_contour_render_masks (self, sorted, n_groups,
+                                             &origin, roi, level,
+                                             mask, stride,
+                                             burst, stride))
+    {
+      g_free (mask);
+      g_free (burst);
+      g_free (local);
+      g_clear_pointer (&outline, gimp_contour_outline_unref);
+      gimp_operation_contour_copy (input, output, roi, level);
+      return TRUE;
+    }
+
+  g_free (local);
+  g_clear_pointer (&outline, gimp_contour_outline_unref);
+
+  /*  3. composite the stroke with the layer, in linear light  */
+
+ composite:
+
+  comp = gimp_operation_contour_composite_new (self, format, in_rect0, level,
+                                               roi->width);
+
+  iter = gegl_buffer_iterator_new (output, roi, level, format,
+                                   GEGL_ACCESS_WRITE, GEGL_ABYSS_NONE, 2);
+
+  gegl_buffer_iterator_add (iter, input, roi, level, format,
+                            GEGL_ACCESS_READ, GEGL_ABYSS_NONE);
+
+  while (gegl_buffer_iterator_next (iter))
+    {
+      gfloat              *out  = iter->items[0].data;
+      const gfloat        *in   = iter->items[1].data;
+      const GeglRectangle *rect = &iter->items[0].roi;
+      gint                 y;
+
+      for (y = 0; y < rect->height; y++)
+        {
+          gsize offset = (gsize) (rect->y + y - roi->y) * stride +
+                         (rect->x - roi->x);
+
+          gimp_operation_contour_composite_row (comp, in, out,
+                                                mask + offset,
+                                                burst ? burst + offset : NULL,
+                                                rect->x, rect->y + y,
+                                                rect->width);
+
+          in  += 4 * rect->width;
+          out += 4 * rect->width;
+        }
+    }
+
+  gimp_operation_contour_composite_free (comp);
+
+  g_free (mask);
+  g_free (burst);
+
+  return TRUE;
+}
+
+
+/*  ChopGimp: « Aligner sur le calque » off  */
+
+gboolean
+gimp_operation_contour_set_canvas (GimpOperationContour *self,
+                                   const GeglRectangle  *canvas)
+{
+  g_return_val_if_fail (GIMP_IS_OPERATION_CONTOUR (self), FALSE);
+  g_return_val_if_fail (canvas != NULL, FALSE);
+
+  if (gegl_rectangle_equal (&self->canvas, canvas))
+    return FALSE;
+
+  self->canvas = *canvas;
+
+  /*  only the gradient and pattern fills of a stroke not aligned with
+   *  the layer use it
+   */
+  return (! self->align_with_layer &&
+          self->fill_type != GIMP_CONTOUR_FILL_COLOR);
+}
+
+gboolean
+gimp_operation_contour_get_align_with_layer (GimpOperationContour *self)
+{
+  g_return_val_if_fail (GIMP_IS_OPERATION_CONTOUR (self), TRUE);
+
+  return self->align_with_layer;
+}
