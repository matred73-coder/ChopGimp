+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * gimpoperationcontour.c
+ * ChopGimp : style de calque « Contour » (chopgimp:stroke)
+ *
+ * Trace le bord des pixels du calque (contour de son alpha), avec les
+ * mêmes options que « Tracer la sélection » (épaisseur, couleur,
+ * anticrénelage, extrémités, jointures, limite d'onglet, pointillés),
+ * à l'extérieur, au centre ou à l'intérieur du bord.  C'est un filtre
+ * GEGL ordinaire : il reste modifiable (icône fx du calque) et il est
+ * enregistré dans le XCF comme tout autre filtre.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <cairo.h>
+#include <gegl.h>
+#include <gdk-pixbuf/gdk-pixbuf.h>
+
+#include "libgimpbase/gimpbase.h"
+
+#include "operations-types.h"
+
+#include "core/gimpboundary.h"
+#include "core/gimpdashpattern.h"
+#include "core/gimpgradient.h"
+#include "core/gimpgradient-load.h"
+#include "core/gimppattern.h"
+#include "core/gimppattern-load.h"
+#include "core/gimptempbuf.h"
+
+#include "layer-modes/gimp-layer-modes.h"
+
+#include "gimpoperationcontour.h"
+
+
+/*  colors of the gradient, sampled once per change  */
+#define GRADIENT_LUT_SIZE 1024
+
+/*  most distance levels used for the "shape burst" gradient style  */
+#define SHAPE_BURST_MAX_LEVELS 48
+
+
+enum
+{
+  PROP_0,
+  PROP_POSITION,
+  PROP_WIDTH,
+  PROP_COLOR,
+  PROP_OPACITY,
+  PROP_ANTIALIAS,
+  PROP_DASH_PRESET,
+  PROP_CAP_STYLE,
+  PROP_JOIN_STYLE,
+  PROP_MITER_LIMIT,
+  PROP_THRESHOLD,
+  PROP_MODE,
+  PROP_OVERPRINT,
+  PROP_FILL_TYPE,
+  PROP_GRADIENT,
+  PROP_GRADIENT_REVERSE,
+  PROP_GRADIENT_STYLE,
+  PROP_GRADIENT_ANGLE,
+  PROP_GRADIENT_SCALE,
+  PROP_GRADIENT_OFFSET_X,
+  PROP_GRADIENT_OFFSET_Y,
+  PROP_PATTERN,
+  PROP_PATTERN_SCALE,
+  PROP_PATTERN_ANGLE,
+  PROP_PATTERN_OFFSET_X,
+  PROP_PATTERN_OFFSET_Y,
+  PROP_ALIGN_WITH_LAYER
+};
+
+
+/*  the gradient's colors and the pattern's pixels, in the processing
+ *  format, shared between the threads rendering the stroke
+ */
+struct _GimpContourFill
+{
+  gint        ref_count;
+  const Babl *format;
+  gint        generation;
+
+  gfloat     *lut;            /* GRADIENT_LUT_SIZE RGBA colors, or NULL  */
+
+  gfloat     *pattern;        /* pattern_width * pattern_height RGBA,
+                               * premultiplied, or NULL
+                               */
+  gint        pattern_width;
+  gint        pattern_height;
+};
+
+
+GType
+gimp_contour_fill_type_get_type (void)
+{
+  static const GEnumValue values[] =
+  {
+    { GIMP_CONTOUR_FILL_COLOR,    "GIMP_CONTOUR_FILL_COLOR",    "color"    },
+    { GIMP_CONTOUR_FILL_GRADIENT, "GIMP_CONTOUR_FILL_GRADIENT", "gradient" },
+    { GIMP_CONTOUR_FILL_PATTERN,  "GIMP_CONTOUR_FILL_PATTERN",  "pattern"  },
+    { 0, NULL, NULL }
+  };
+
+  static const GimpEnumDesc descs[] =
+  {
+    { GIMP_CONTOUR_FILL_COLOR,    "Couleur", NULL },
+    { GIMP_CONTOUR_FILL_GRADIENT, "Dégradé", NULL },
+    { GIMP_CONTOUR_FILL_PATTERN,  "Motif",   NULL },
+    { 0, NULL, NULL }
+  };
+
+  static GType type = 0;
+
+  if (G_UNLIKELY (! type))
+    {
+      type = g_enum_register_static ("GimpContourFillType", values);
+      gimp_enum_set_value_descriptions (type, descs);
+    }
+
+  return type;
+}
+
+GType
+gimp_contour_gradient_style_get_type (void)
+{
+  static const GEnumValue values[] =
+  {
+    { GIMP_CONTOUR_GRADIENT_LINEAR,      "GIMP_CONTOUR_GRADIENT_LINEAR",      "linear"      },
+    { GIMP_CONTOUR_GRADIENT_RADIAL,      "GIMP_CONTOUR_GRADIENT_RADIAL",      "radial"      },
+    { GIMP_CONTOUR_GRADIENT_ANGLE,       "GIMP_CONTOUR_GRADIENT_ANGLE",       "angle"       },
+    { GIMP_CONTOUR_GRADIENT_REFLECTED,   "GIMP_CONTOUR_GRADIENT_REFLECTED",   "reflected"   },
+    { GIMP_CONTOUR_GRADIENT_DIAMOND,     "GIMP_CONTOUR_GRADIENT_DIAMOND",     "diamond"     },
+    { GIMP_CONTOUR_GRADIENT_SHAPE_BURST, "GIMP_CONTOUR_GRADIENT_SHAPE_BURST", "shape-burst" },
+    { 0, NULL, NULL }
+  };
+
+  static const GimpEnumDesc descs[] =
+  {
+    { GIMP_CONTOUR_GRADIENT_LINEAR,      "Linéaire",       NULL },
+    { GIMP_CONTOUR_GRADIENT_RADIAL,      "Radial",         NULL },
+    { GIMP_CONTOUR_GRADIENT_ANGLE,       "Angle",          NULL },
+    { GIMP_CONTOUR_GRADIENT_REFLECTED,   "Réfléchi",       NULL },
+    { GIMP_CONTOUR_GRADIENT_DIAMOND,     "Losange",        NULL },
+    { GIMP_CONTOUR_GRADIENT_SHAPE_BURST, "Éclat de forme", NULL },
+    { 0, NULL, NULL }
+  };
+
+  static GType type = 0;
+
+  if (G_UNLIKELY (! type))
+    {
+      type = g_enum_register_static ("GimpContourGradientStyle", values);
+      gimp_enum_set_value_descriptions (type, descs);
+    }
+
+  return type;
+}
+
+
+static void          gimp_operation_contour_finalize      (GObject             *object);
+static void          gimp_operation_contour_get_property  (GObject             *object,
+                                                           guint                property_id,
+                                                           GValue              *value,
+                                                           GParamSpec          *pspec);
+static void          gimp_operation_contour_set_property  (GObject             *object,
+                                                           guint                property_id,
+                                                           const GValue        *value,
+                                                           GParamSpec          *pspec);
+
+static void          gimp_operation_contour_prepare       (GeglOperation       *operation);
+static GeglRectangle gimp_operation_contour_get_bounding_box
+                                                          (GeglOperation       *operation);
+static GeglRectangle gimp_operation_contour_get_required_for_output
+                                                          (GeglOperation       *operation,
+                                                           const gchar         *input_pad,
+                                                           const GeglRectangle *roi);
+static GeglRectangle gimp_operation_contour_get_invalidated_by_change
+                                                          (GeglOperation       *operation,
+                                                           const gchar         *input_pad,
+                                                           const GeglRectangle *input_region);
+static GeglRectangle gimp_operation_contour_get_cached_region
+                                                          (GeglOperation       *operation,
+                                                           const GeglRectangle *roi);
+
+static gboolean      gimp_operation_contour_process       (GeglOperation       *operation,
+                                                           GeglBuffer          *input,
+                                                           GeglBuffer          *output,
+                                                           const GeglRectangle *roi,
+                                                           gint                 level);
+
+
+G_DEFINE_TYPE (GimpOperationContour, gimp_operation_contour,
+               GEGL_TYPE_OPERATION_FILTER)
+
+#define parent_class gimp_operation_contour_parent_class
+
+
+/*  a sorted outline (gimp_boundary_sort() groups), shared between the
+ *  threads rendering a dashed stroke
+ */
+struct _GimpContourOutline
+{
+  gint          ref_count;
+  GimpBoundSeg *segs;
+  gint          n_groups;
+};
+
+static GimpContourOutline *
+gimp_contour_outline_ref (GimpContourOutline *outline)
+{
+  g_atomic_int_inc (&outline->ref_count);
+
+  return outline;
+}
+
+static void
+gimp_contour_outline_unref (GimpContourOutline *outline)
+{
+  if (g_atomic_int_dec_and_test (&outline->ref_count))
+    {
+      g_free (outline->segs);
+      g_slice_free (GimpContourOutline, outline);
+    }
+}
+
+
+static void
+gimp_operation_contour_class_init (GimpOperationContourClass *klass)
+{
+  GObjectClass             *object_class    = G_OBJECT_CLASS (klass);
+  GeglOperationClass       *operation_class = GEGL_OPERATION_CLASS (klass);
+  GeglOperationFilterClass *filter_class    = GEGL_OPERATION_FILTER_CLASS (klass);
+  GParamSpec               *pspec;
+
+  object_class->finalize     = gimp_operation_contour_finalize;
+  object_class->set_property = gimp_operation_contour_set_property;
+  object_class->get_property = gimp_operation_contour_get_property;
+
+  gegl_operation_class_set_keys (operation_class,
+                                 "name",        "chopgimp:stroke",
+                                 "title",       "Contour",
+                                 "categories",  "light",
+                                 "description", "Trace un contour autour des "
+                                                "pixels du calque (style de "
+                                                "calque)",
+                                 NULL);
+
+  operation_class->prepare                   = gimp_operation_contour_prepare;
+  operation_class->get_bounding_box          = gimp_operation_contour_get_bounding_box;
+  operation_class->get_required_for_output   = gimp_operation_contour_get_required_for_output;
+  operation_class->get_invalidated_by_change = gimp_operation_contour_get_invalidated_by_change;
+  operation_class->get_cached_region         = gimp_operation_contour_get_cached_region;
+  /*  not threaded: splitting a region between threads makes each
+   *  thread find the outline in its part grown by the stroke's reach,
+   *  which measured slower than one pass; GIMP renders the projection
+   *  in chunks anyway, and each chunk only costs its own area
+   */
+  operation_class->threaded                  = FALSE;
+
+  filter_class->process                      = gimp_operation_contour_process;
+
+  /*  the properties are listed in the order of the filter dialog  */
+
+  g_object_class_install_property (object_class, PROP_POSITION,
+                                   g_param_spec_enum ("position",
+                                                      "Position",
+                                                      "Place du contour par "
+                                                      "rapport au bord du calque",
+                                                      GIMP_TYPE_CONTOUR_POSITION,
+                                                      GIMP_CONTOUR_POSITION_OUTSIDE,
+                                                      G_PARAM_READWRITE |
+                                                      G_PARAM_CONSTRUCT));
+
+  pspec = gegl_param_spec_double ("width",
+                                  "Épaisseur",
+                                  "Épaisseur du contour, en pixels",
+                                  0.5, 500.0, 3.0,
+                                  0.5, 100.0, 1.5,
+                                  G_PARAM_READWRITE |
+                                  G_PARAM_CONSTRUCT);
+  gegl_param_spec_double_set_steps (GEGL_PARAM_SPEC_DOUBLE (pspec), 0.5, 5.0);
+  gegl_param_spec_double_set_digits (GEGL_PARAM_SPEC_DOUBLE (pspec), 1);
+  gegl_param_spec_set_property_key (pspec, "unit", "pixel-distance");
+  g_object_class_install_property (object_class, PROP_WIDTH, pspec);
+
+  g_object_class_install_property (object_class, PROP_COLOR,
+                                   gegl_param_spec_color_from_string ("color",
+                                                                      "Couleur",
+                                                                      "Couleur du contour",
+                                                                      "black",
+                                                                      G_PARAM_READWRITE |
+                                                                      G_PARAM_CONSTRUCT));
+
+  pspec = gegl_param_spec_double ("opacity",
+                                  "Opacité",
+                                  "Opacité du contour",
+                                  0.0, 1.0, 1.0,
+                                  0.0, 1.0, 1.0,
+                                  G_PARAM_READWRITE |
+                                  G_PARAM_CONSTRUCT);
+  gegl_param_spec_double_set_steps (GEGL_PARAM_SPEC_DOUBLE (pspec), 0.01, 0.1);
+  gegl_param_spec_double_set_digits (GEGL_PARAM_SPEC_DOUBLE (pspec), 2);
+  g_object_class_install_property (object_class, PROP_OPACITY, pspec);
+
