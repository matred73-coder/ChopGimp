+/*  ChopGimp: copy / paste layer style (Photoshop)  */
+
+/*  ChopGimp: Calque > Style de calque > Options de fusion… opens the
+ *  « Style de calque » window (tools/gimpfiltertool-layerstyle.c) on the
+ *  first effect of the layer in Photoshop's order, as a double-click in
+ *  the fx list does; on a layer without style, on an unchecked Ombre
+ *  portée (nothing is added unless an effect is checked)
+ */
+void
+layers_style_dialog_cmd_callback (GimpAction *action,
+                                  GVariant   *value,
+                                  gpointer    data)
+{
+  GimpImage          *image;
+  GList              *layers;
+  GimpDisplay        *display;
+  GimpContainer      *filters;
+  GimpDrawableFilter *first      = NULL;
+  gint                first_rank = G_MAXINT;
+  GList              *list;
+  return_if_no_layers (image, layers, data);
+  return_if_no_display (display, data);
+
+  if (g_list_length (layers) != 1)
+    return;
+
+  filters = gimp_drawable_get_filters (GIMP_DRAWABLE (layers->data));
+
+  for (list = filters ? GIMP_LIST (filters)->queue->head : NULL;
+       list;
+       list = g_list_next (list))
+    {
+      GimpDrawableFilter *filter = list->data;
+      GeglNode           *node;
+      gchar              *operation = NULL;
+      gint                rank;
+
+      if (! GIMP_IS_DRAWABLE_FILTER (filter) ||
+          gimp_drawable_filter_get_temporary (filter))
+        continue;
+
+      node = gimp_drawable_filter_get_operation (filter);
+      if (! node)
+        continue;
+
+      gegl_node_get (node, "operation", &operation, NULL);
+
+      rank = chopgimp_layer_style_rank (
+               chopgimp_layer_style_find (operation,
+                                          gimp_object_get_name (filter)));
+      g_free (operation);
+
+      if (rank >= 0 && rank < first_rank)
+        {
+          first      = filter;
+          first_rank = rank;
+        }
+    }
+
+  if (first)
+    {
+      GimpProcedure *procedure;
+      gchar         *operation = NULL;
+
+      gegl_node_get (gimp_drawable_filter_get_operation (first),
+                     "operation", &operation,
+                     NULL);
+
+      /*  as gimpdrawabletreeview-filters.c edits a filter  */
+      procedure = gimp_gegl_procedure_new (image->gimp,
+                                           first,
+                                           GIMP_RUN_INTERACTIVE, NULL,
+                                           operation,
+                                           gimp_object_get_name (first),
+                                           gimp_object_get_name (first),
+                                           NULL, NULL, NULL);
+
+      filters_run_procedure (image->gimp, display, procedure,
+                             GIMP_RUN_INTERACTIVE);
+
+      g_object_unref (procedure);
+      g_free (operation);
+    }
+  else
+    {
+      GAction *shadow;
+
+      shadow = g_action_map_lookup_action (G_ACTION_MAP (image->gimp->app),
+                                           "filters-dropshadow");
+
+      if (GIMP_IS_ACTION (shadow))
+        {
+          /*  read by gimp_filter_tool_layer_style_start()  */
+          g_object_set_data (G_OBJECT (image->gimp),
+                             "chopgimp-layer-style-unchecked",
+                             GSIZE_TO_POINTER (g_get_monotonic_time () /
+                                               G_TIME_SPAN_SECOND));
+
+          gimp_action_activate (GIMP_ACTION (shadow));
+        }
+    }
+}
+
+void
+layers_style_copy_cmd_callback (GimpAction *action,
+                                GVariant   *value,
+                                gpointer    data)
+{
+  GimpImage *image;
+  GList     *layers;
+  return_if_no_layers (image, layers, data);
+
+  if (g_list_length (layers) != 1)
+    return;
+
+  if (chopgimp_style_clipboard_copy_drawable (layers->data) > 0)
+    /*  no undo step: only lets the actions update (paste sensitivity)  */
+    gimp_image_flush (image);
+}
+
+static void
+layers_style_paste (gpointer data,
+                    gboolean replace)
+{
+  GimpImage *image;
+  GList     *layers;
+  return_if_no_layers (image, layers, data);
+
+  if (chopgimp_style_clipboard_paste (image, layers, replace) > 0)
+    gimp_image_flush (image);
+}
+
+void
+layers_style_paste_cmd_callback (GimpAction *action,
+                                 GVariant   *value,
+                                 gpointer    data)
+{
+  layers_style_paste (data, TRUE);
+}
+
+void
+layers_style_paste_add_cmd_callback (GimpAction *action,
+                                     GVariant   *value,
+                                     gpointer    data)
+{
+  layers_style_paste (data, FALSE);
+}
+
+/*  ChopGimp: « Pixelliser le style de calque » (Photoshop's Rasterize
+ *  Layer Style). Reuses gimp_drawable_merge_filters(), the merge button
+ *  of the fx popover, on every selected layer, in one undo group. Like
+ *  Photoshop, a text, link or vector layer is rasterized first.
+ */
+
+gboolean
+layers_style_can_rasterize (GimpLayer *layer)
+{
+  GList *list;
+
+  g_return_val_if_fail (GIMP_IS_LAYER (layer), FALSE);
+
+  if (gimp_viewable_get_children (GIMP_VIEWABLE (layer)) ||
+      gimp_layer_is_floating_sel (layer)                 ||
+      gimp_item_is_content_locked (GIMP_ITEM (layer), NULL))
+    return FALSE;
+
+  if (! gimp_drawable_has_visible_filters (GIMP_DRAWABLE (layer)))
+    return FALSE;
+
+  /*  a filter tool is previewing on this layer: it must be committed or
+   *  canceled first, otherwise its preview would be merged
+   */
+  for (list = GIMP_LIST (gimp_drawable_get_filters (GIMP_DRAWABLE (layer)))->queue->head;
+       list;
+       list = g_list_next (list))
+    {
+      if (GIMP_IS_DRAWABLE_FILTER (list->data) &&
+          gimp_drawable_filter_get_temporary (list->data))
+        return FALSE;
+    }
+
+  return TRUE;
+}
+
+void
+layers_style_rasterize_cmd_callback (GimpAction *action,
+                                     GVariant   *value,
+                                     gpointer    data)
+{
+  GimpImage *image;
+  GList     *layers;
+  GList     *targets = NULL;
+  GList     *iter;
+  return_if_no_layers (image, layers, data);
+
+  for (iter = layers; iter; iter = iter->next)
+    if (layers_style_can_rasterize (iter->data))
+      targets = g_list_prepend (targets, iter->data);
+
+  if (! targets)
+    return;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_DRAWABLE,
+                               "Pixelliser le style de calque");
+
+  for (iter = targets; iter; iter = iter->next)
+    {
+      GimpLayer *layer = iter->data;
+
+      if (GIMP_IS_RASTERIZABLE (layer) &&
+          ! gimp_rasterizable_is_rasterized (GIMP_RASTERIZABLE (layer)))
+        gimp_rasterizable_rasterize (GIMP_RASTERIZABLE (layer), TRUE);
+
+      gimp_drawable_merge_filters (GIMP_DRAWABLE (layer));
+    }
+
+  gimp_image_undo_group_end (image);
+
+  g_list_free (targets);
+
+  gimp_image_flush (image);
+}
+
+
+/*  ChopGimp 3.27: vector layers with several objects  */
+
+void
+layers_vobjects_merge_cmd_callback (GimpAction *action,
+                                    GVariant   *value,
+                                    gpointer    data)
+{
+  GimpImage   *image;
+  GimpContext *context;
+  GList       *layers;
+  return_if_no_layers (image, layers, data);
+  return_if_no_context (context, data);
+
+  if (chopgimp_vlayer_merge_layers (image, layers, context))
+    gimp_image_flush (image);
+}
+
+void
+layers_vobjects_split_cmd_callback (GimpAction *action,
+                                    GVariant   *value,
+                                    gpointer    data)
+{
+  GimpImage   *image;
+  GimpContext *context;
+  GList       *layers;
+  GList       *targets = NULL;
+  GList       *iter;
+  gboolean     done    = FALSE;
+  return_if_no_layers (image, layers, data);
+  return_if_no_context (context, data);
+
+  for (iter = layers; iter; iter = iter->next)
+    if (GIMP_IS_VECTOR_LAYER (iter->data) &&
+        chopgimp_vlayer_can_split (iter->data))
+      targets = g_list_prepend (targets, iter->data);
+
+  if (! targets)
+    return;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_LAYER_ADD,
+                               "Dissocier en calques");
+
+  for (iter = targets; iter; iter = iter->next)
+    {
+      GList *new_layers = chopgimp_vlayer_split_to_layers (iter->data, context);
+
+      if (new_layers)
+        done = TRUE;
+
+      g_list_free (new_layers);
+    }
+
+  gimp_image_undo_group_end (image);
+
+  g_list_free (targets);
+
+  if (done)
+    gimp_image_flush (image);
+}
+
+void
+layers_vobjects_decompose_cmd_callback (GimpAction *action,
+                                        GVariant   *value,
+                                        gpointer    data)
+{
+  GimpImage *image;
+  GList     *layers;
+  GList     *iter;
+  gint       n = 0;
+  return_if_no_layers (image, layers, data);
+
+  layers = g_list_copy (layers);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_ITEM_PROPERTIES,
+                               "Décomposer les sous-tracés en objets");
+
+  for (iter = layers; iter; iter = iter->next)
+    if (GIMP_IS_VECTOR_LAYER (iter->data) &&
+        chopgimp_vlayer_can_decompose (iter->data))
+      n += chopgimp_vlayer_decompose (iter->data, TRUE);
+
+  gimp_image_undo_group_end (image);
+
+  g_list_free (layers);
+
+  if (n > 0)
+    gimp_image_flush (image);
+}
 
 /*  private functions  */
 
