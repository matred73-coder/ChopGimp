+      g_value_set_enum (value, self->cap_style);
+      break;
+
+    case PROP_JOIN_STYLE:
+      g_value_set_enum (value, self->join_style);
+      break;
+
+    case PROP_MITER_LIMIT:
+      g_value_set_double (value, self->miter_limit);
+      break;
+
+    case PROP_THRESHOLD:
+      g_value_set_double (value, self->threshold);
+      break;
+
+    case PROP_MODE:
+      g_value_set_enum (value, self->mode);
+      break;
+
+    case PROP_OVERPRINT:
+      g_value_set_boolean (value, self->overprint);
+      break;
+
+    case PROP_FILL_TYPE:
+      g_value_set_enum (value, self->fill_type);
+      break;
+
+    case PROP_GRADIENT:
+      g_value_set_string (value, self->gradient_data);
+      break;
+
+    case PROP_GRADIENT_REVERSE:
+      g_value_set_boolean (value, self->gradient_reverse);
+      break;
+
+    case PROP_GRADIENT_STYLE:
+      g_value_set_enum (value, self->gradient_style);
+      break;
+
+    case PROP_GRADIENT_ANGLE:
+      g_value_set_double (value, self->gradient_angle);
+      break;
+
+    case PROP_GRADIENT_SCALE:
+      g_value_set_double (value, self->gradient_scale);
+      break;
+
+    case PROP_GRADIENT_OFFSET_X:
+      g_value_set_double (value, self->gradient_offset_x);
+      break;
+
+    case PROP_GRADIENT_OFFSET_Y:
+      g_value_set_double (value, self->gradient_offset_y);
+      break;
+
+    case PROP_PATTERN:
+      g_value_set_string (value, self->pattern_data);
+      break;
+
+    case PROP_PATTERN_SCALE:
+      g_value_set_double (value, self->pattern_scale);
+      break;
+
+    case PROP_PATTERN_ANGLE:
+      g_value_set_double (value, self->pattern_angle);
+      break;
+
+    case PROP_PATTERN_OFFSET_X:
+      g_value_set_double (value, self->pattern_offset_x);
