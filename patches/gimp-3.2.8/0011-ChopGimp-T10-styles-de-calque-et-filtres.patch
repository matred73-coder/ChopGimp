diff --git a/app/operations/gimpoperationbehindknockout.c b/app/operations/gimpoperationbehindknockout.c
new file mode 100644
index 0000000..0fc0fd1
--- /dev/null
+++ b/app/operations/gimpoperationbehindknockout.c
@@ -0,0 +1,157 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * gimpoperationbehindknockout.c
+ * ChopGimp: a "behind" layer effect alone (drop shadow, outer glow),
+ * knocked out by the layer
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*  input: the output of a drop shadow filter, i.e. the layer L over its
+ *  shadow S; aux: the filter's input, the layer L. In premultiplied
+ *  components, input = L + S (1 - aL), so input - aux = S (1 - aL): the
+ *  shadow alone where the layer does not cover it, which is Photoshop's
+ *  "Layer Knocks Out Drop Shadow" (on by default). The result is then
+ *  composited onto the layers below with the shadow's own blend mode
+ *  (app/core/chopgimp-behind-effects.c). Exact for any shadow (color,
+ *  gradient, noise, contour) and for the filter's opacity (in replace
+ *  mode the filter's output is mix (L, L over S, opacity)).
+ *
+ *  A point operation: renders the same at every mipmap level.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gegl.h>
+
+#include "operations-types.h"
+
+#include "gimpoperationbehindknockout.h"
+
+
+static void            gimp_operation_behind_knockout_prepare          (GeglOperation       *operation);
+static GeglRectangle   gimp_operation_behind_knockout_get_bounding_box (GeglOperation       *operation);
+static gboolean        gimp_operation_behind_knockout_process          (GeglOperation       *operation,
+                                                                        void                *in_buf,
+                                                                        void                *aux_buf,
+                                                                        void                *out_buf,
+                                                                        glong                samples,
+                                                                        const GeglRectangle *roi,
+                                                                        gint                 level);
+
+
+G_DEFINE_TYPE (GimpOperationBehindKnockout, gimp_operation_behind_knockout,
+               GEGL_TYPE_OPERATION_POINT_COMPOSER)
+
+#define parent_class gimp_operation_behind_knockout_parent_class
+
+
+static void
+gimp_operation_behind_knockout_class_init (GimpOperationBehindKnockoutClass *klass)
+{
+  GeglOperationClass              *operation_class = GEGL_OPERATION_CLASS (klass);
+  GeglOperationPointComposerClass *point_class     = GEGL_OPERATION_POINT_COMPOSER_CLASS (klass);
+
+  gegl_operation_class_set_keys (operation_class,
+                                 "name",        "chopgimp:behind-knockout",
+                                 "categories",  "hidden",
+                                 "description", "Input minus aux, premultiplied "
+                                                "(a layer effect alone, knocked "
+                                                "out by the layer)",
+                                 NULL);
+
+  operation_class->prepare          = gimp_operation_behind_knockout_prepare;
+  operation_class->get_bounding_box = gimp_operation_behind_knockout_get_bounding_box;
+
+  point_class->process              = gimp_operation_behind_knockout_process;
+}
+
+static void
+gimp_operation_behind_knockout_init (GimpOperationBehindKnockout *self)
+{
+}
+
+static void
+gimp_operation_behind_knockout_prepare (GeglOperation *operation)
+{
+  const Babl *space  = gegl_operation_get_source_space (operation, "input");
+  const Babl *format = babl_format_with_space ("RaGaBaA float", space);
+
+  gegl_operation_set_format (operation, "input",  format);
+  gegl_operation_set_format (operation, "aux",    format);
+  gegl_operation_set_format (operation, "output", format);
+}
+
+/*  the effect lies within the filter's output  */
+static GeglRectangle
+gimp_operation_behind_knockout_get_bounding_box (GeglOperation *operation)
+{
+  const GeglRectangle *in_rect;
+
+  in_rect = gegl_operation_source_get_bounding_box (operation, "input");
+
+  if (in_rect)
+    return *in_rect;
+
+  return *GEGL_RECTANGLE (0, 0, 0, 0);
+}
+
+static gboolean
+gimp_operation_behind_knockout_process (GeglOperation       *operation,
+                                        void                *in_buf,
+                                        void                *aux_buf,
+                                        void                *out_buf,
+                                        glong                samples,
+                                        const GeglRectangle *roi,
+                                        gint                 level)
+{
+  const gfloat *in  = in_buf;
+  const gfloat *aux = aux_buf;
+  gfloat       *out = out_buf;
+
+  if (! aux)
+    {
+      memcpy (out, in, samples * 4 * sizeof (gfloat));
+
+      return TRUE;
+    }
+
+  while (samples--)
+    {
+      gfloat a = in[3] - aux[3];
+
+      /*  covered by the layer (up to rounding): nothing  */
+      if (a < 1e-5f)
+        {
+          out[0] = out[1] = out[2] = out[3] = 0.0f;
+        }
+      else
+        {
+          /*  not clamped: out-of-gamut shadow colors stay as they are  */
+          out[0] = in[0] - aux[0];
+          out[1] = in[1] - aux[1];
+          out[2] = in[2] - aux[2];
+          out[3] = a;
+        }
+
+      in  += 4;
+      aux += 4;
+      out += 4;
+    }
+
+  return TRUE;
+}
