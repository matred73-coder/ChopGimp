 typedef struct _GimpFilterStackClass GimpFilterStackClass;
 
+/*  ChopGimp: a function replacing runs of filters by single nodes in the
+ *  stack's graph (layer styles, gimpdrawable-fused-styles.c). It gets the
+ *  active filters from the bottom up, and returns the nodes to chain
+ *  instead, in the same order: filter nodes, or nodes of its own standing
+ *  for several filters (the stack adds them to its graph, and removes
+ *  them when they are no longer returned).
+ */
+typedef GList * (* GimpFilterStackFuseFunc) (GimpFilterStack *stack,
+                                             GList           *filters,
+                                             gpointer         user_data);
+
+/*  ChopGimp: "behind" filters (chopgimp-behind-effects.c): drop shadows
+ *  and outer glows composited with their own blend mode onto what lies
+ *  below the layer, as in Photoshop. Such a filter is not chained: its
+ *  node gets the chain's output at its place as input, the chain goes
+ *  on without it, and a chopgimp:behind-knockout node (the filter's
+ *  output minus its input: the effect alone, knocked out by the layer)
+ *  is kept for it, for the layer to composite. behind_func tells which
+ *  active filters are; changed_func is called after each relink.
+ */
+typedef gboolean (* GimpFilterStackBehindFunc)        (GimpFilterStack *stack,
+                                                       GimpFilter      *filter,
+                                                       gpointer         user_data);
+typedef void     (* GimpFilterStackBehindChangedFunc) (GimpFilterStack *stack,
+                                                       gpointer         user_data);
+
+typedef struct
+{
+  GimpFilter *filter;    /*  not referenced                         */
+  GeglNode   *knockout;  /*  chopgimp:behind-knockout, in the graph  */
+} GimpFilterStackBehind;
+
 struct _GimpFilterStack
 {
-  GimpList  parent_instance;
+  GimpList                          parent_instance;
+
+  GeglNode                         *graph;
+
+  GimpFilterStackFuseFunc           fuse_func;
+  gpointer                          fuse_data;
+  GList                            *fused_nodes;
 
-  GeglNode *graph;
+  GimpFilterStackBehindFunc         behind_func;
+  GimpFilterStackBehindChangedFunc  behind_changed_func;
+  gpointer                          behind_data;
+  GList                            *behind;   /*  GimpFilterStackBehind, bottom up  */
 };
 
 struct _GimpFilterStackClass
@@ -49,3 +90,14 @@ GType           gimp_filter_stack_get_type  (void);
 GimpContainer * gimp_filter_stack_new       (GType            filter_type);
 
 GeglNode *      gimp_filter_stack_get_graph (GimpFilterStack *stack);
+
+void            gimp_filter_stack_set_fuse_func (GimpFilterStack         *stack,
+                                                 GimpFilterStackFuseFunc  func,
+                                                 gpointer                 user_data);
+void            gimp_filter_stack_relink        (GimpFilterStack         *stack);
+
+void            gimp_filter_stack_set_behind_func (GimpFilterStack                  *stack,
+                                                   GimpFilterStackBehindFunc         func,
+                                                   GimpFilterStackBehindChangedFunc  changed_func,
+                                                   gpointer                          user_data);
