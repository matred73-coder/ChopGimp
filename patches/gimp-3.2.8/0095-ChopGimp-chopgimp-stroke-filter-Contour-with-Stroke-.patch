+GType
+gimp_contour_dash_get_type (void)
+{
+  static const GEnumValue values[] =
+  {
+    { GIMP_CONTOUR_DASH_LINE, "GIMP_CONTOUR_DASH_LINE", "line" },
+    { GIMP_CONTOUR_DASH_LONG_DASH, "GIMP_CONTOUR_DASH_LONG_DASH", "long-dash" },
+    { GIMP_CONTOUR_DASH_MEDIUM_DASH, "GIMP_CONTOUR_DASH_MEDIUM_DASH", "medium-dash" },
+    { GIMP_CONTOUR_DASH_SHORT_DASH, "GIMP_CONTOUR_DASH_SHORT_DASH", "short-dash" },
+    { GIMP_CONTOUR_DASH_SPARSE_DOTS, "GIMP_CONTOUR_DASH_SPARSE_DOTS", "sparse-dots" },
+    { GIMP_CONTOUR_DASH_NORMAL_DOTS, "GIMP_CONTOUR_DASH_NORMAL_DOTS", "normal-dots" },
+    { GIMP_CONTOUR_DASH_DENSE_DOTS, "GIMP_CONTOUR_DASH_DENSE_DOTS", "dense-dots" },
+    { GIMP_CONTOUR_DASH_STIPPLES, "GIMP_CONTOUR_DASH_STIPPLES", "stipples" },
+    { GIMP_CONTOUR_DASH_DASH_DOT, "GIMP_CONTOUR_DASH_DASH_DOT", "dash-dot" },
+    { GIMP_CONTOUR_DASH_DASH_DOT_DOT, "GIMP_CONTOUR_DASH_DASH_DOT_DOT", "dash-dot-dot" },
+    { 0, NULL, NULL }
+  };
+
+  static const GimpEnumDesc descs[] =
+  {
+    { GIMP_CONTOUR_DASH_LINE, NC_("contour-dash", "Ligne continue"), NULL },
+    { GIMP_CONTOUR_DASH_LONG_DASH, NC_("contour-dash", "Tirets longs"), NULL },
+    { GIMP_CONTOUR_DASH_MEDIUM_DASH, NC_("contour-dash", "Tirets moyens"), NULL },
+    { GIMP_CONTOUR_DASH_SHORT_DASH, NC_("contour-dash", "Tirets courts"), NULL },
+    { GIMP_CONTOUR_DASH_SPARSE_DOTS, NC_("contour-dash", "Points espacés"), NULL },
+    { GIMP_CONTOUR_DASH_NORMAL_DOTS, NC_("contour-dash", "Points normaux"), NULL },
+    { GIMP_CONTOUR_DASH_DENSE_DOTS, NC_("contour-dash", "Points serrés"), NULL },
+    { GIMP_CONTOUR_DASH_STIPPLES, NC_("contour-dash", "Pointillés fins"), NULL },
+    { GIMP_CONTOUR_DASH_DASH_DOT, NC_("contour-dash", "Tiret, point"), NULL },
+    { GIMP_CONTOUR_DASH_DASH_DOT_DOT, NC_("contour-dash", "Tiret, point, point"), NULL },
+    { 0, NULL, NULL }
+  };
+
+  static GType type = 0;
+
+  if (G_UNLIKELY (! type))
+    {
+      type = g_enum_register_static ("GimpContourDash", values);
+      gimp_type_set_translation_domain (type, GETTEXT_PACKAGE "-libgimp");
+      gimp_type_set_translation_context (type, "contour-dash");
+      gimp_enum_set_value_descriptions (type, descs);
+    }
+
+  return type;
+}
