+
+static void
+gimp_operation_contour_class_init (GimpOperationContourClass *klass)
+{
+  GObjectClass             *object_class    = G_OBJECT_CLASS (klass);
+  GeglOperationClass       *operation_class = GEGL_OPERATION_CLASS (klass);
+  GeglOperationFilterClass *filter_class    = GEGL_OPERATION_FILTER_CLASS (klass);
+  GParamSpec               *pspec;
+
+  object_class->finalize     = gimp_operation_contour_finalize;
+  object_class->set_property = gimp_operation_contour_set_property;
+  object_class->get_property = gimp_operation_contour_get_property;
+
+  gegl_operation_class_set_keys (operation_class,
+                                 "name",        "chopgimp:stroke",
+                                 "title",       "Contour",
+                                 "categories",  "light",
+                                 "description", "Trace un contour autour des "
+                                                "pixels du calque (style de "
+                                                "calque)",
+                                 NULL);
+
+  operation_class->prepare                   = gimp_operation_contour_prepare;
+  operation_class->get_bounding_box          = gimp_operation_contour_get_bounding_box;
+  operation_class->get_required_for_output   = gimp_operation_contour_get_required_for_output;
+  operation_class->get_invalidated_by_change = gimp_operation_contour_get_invalidated_by_change;
+  operation_class->get_cached_region         = gimp_operation_contour_get_cached_region;
+  operation_class->threaded                  = FALSE;
+
+  filter_class->process                      = gimp_operation_contour_process;
+
+  /*  the properties are listed in the order of the filter dialog  */
+
+  g_object_class_install_property (object_class, PROP_POSITION,
+                                   g_param_spec_enum ("position",
+                                                      "Position",
+                                                      "Place du contour par "
+                                                      "rapport au bord du calque",
+                                                      GIMP_TYPE_CONTOUR_POSITION,
+                                                      GIMP_CONTOUR_POSITION_OUTSIDE,
+                                                      G_PARAM_READWRITE |
+                                                      G_PARAM_CONSTRUCT));
+
+  pspec = gegl_param_spec_double ("width",
+                                  "Épaisseur",
+                                  "Épaisseur du contour, en pixels",
+                                  0.5, 500.0, 3.0,
+                                  0.5, 100.0, 1.5,
+                                  G_PARAM_READWRITE |
+                                  G_PARAM_CONSTRUCT);
+  gegl_param_spec_double_set_steps (GEGL_PARAM_SPEC_DOUBLE (pspec), 0.5, 5.0);
+  gegl_param_spec_double_set_digits (GEGL_PARAM_SPEC_DOUBLE (pspec), 1);
+  gegl_param_spec_set_property_key (pspec, "unit", "pixel-distance");
+  g_object_class_install_property (object_class, PROP_WIDTH, pspec);
+
+  g_object_class_install_property (object_class, PROP_COLOR,
+                                   gegl_param_spec_color_from_string ("color",
+                                                                      "Couleur",
+                                                                      "Couleur du contour",
+                                                                      "black",
+                                                                      G_PARAM_READWRITE |
+                                                                      G_PARAM_CONSTRUCT));
+
+  pspec = gegl_param_spec_double ("opacity",
+                                  "Opacité",
+                                  "Opacité du contour",
+                                  0.0, 1.0, 1.0,
+                                  0.0, 1.0, 1.0,
+                                  G_PARAM_READWRITE |
+                                  G_PARAM_CONSTRUCT);
+  gegl_param_spec_double_set_steps (GEGL_PARAM_SPEC_DOUBLE (pspec), 0.01, 0.1);
+  gegl_param_spec_double_set_digits (GEGL_PARAM_SPEC_DOUBLE (pspec), 2);
+  g_object_class_install_property (object_class, PROP_OPACITY, pspec);
+
+  g_object_class_install_property (object_class, PROP_ANTIALIAS,
+                                   g_param_spec_boolean ("antialias",
+                                                         "Anticrénelage",
+                                                         "Lisser les bords du "
+                                                         "contour",
+                                                         TRUE,
+                                                         G_PARAM_READWRITE |
+                                                         G_PARAM_CONSTRUCT));
+
+  g_object_class_install_property (object_class, PROP_DASH_PRESET,
+                                   g_param_spec_enum ("dash-preset",
+                                                      "Pointillés",
+                                                      "Contour continu ou en "
+                                                      "pointillés",
+                                                      GIMP_TYPE_CONTOUR_DASH,
+                                                      GIMP_CONTOUR_DASH_LINE,
+                                                      G_PARAM_READWRITE |
+                                                      G_PARAM_CONSTRUCT));
+
+  /*  a closed outline has no ends: the caps only matter for dashes  */
+  pspec = g_param_spec_enum ("cap-style",
+                             "Extrémités",
+                             "Forme des extrémités des tirets",
+                             GIMP_TYPE_CAP_STYLE,
+                             GIMP_CAP_BUTT,
+                             G_PARAM_READWRITE |
+                             G_PARAM_CONSTRUCT);
+  gegl_param_spec_set_property_key (pspec, "sensitive", "! dash-preset {line}");
+  g_object_class_install_property (object_class, PROP_CAP_STYLE, pspec);
+
+  g_object_class_install_property (object_class, PROP_JOIN_STYLE,
+                                   g_param_spec_enum ("join-style",
+                                                      "Jointures",
+                                                      "Forme des angles du "
+                                                      "contour",
+                                                      GIMP_TYPE_JOIN_STYLE,
+                                                      GIMP_JOIN_ROUND,
+                                                      G_PARAM_READWRITE |
+                                                      G_PARAM_CONSTRUCT));
+
+  pspec = gegl_param_spec_double ("miter-limit",
+                                  "Limite d'onglet",
+                                  "Au-delà de cette limite, les angles en "
+                                  "onglet sont biseautés",
+                                  0.0, 100.0, 10.0,
+                                  0.0, 20.0, 1.0,
+                                  G_PARAM_READWRITE |
+                                  G_PARAM_CONSTRUCT);
+  gegl_param_spec_double_set_steps (GEGL_PARAM_SPEC_DOUBLE (pspec), 0.1, 1.0);
+  gegl_param_spec_double_set_digits (GEGL_PARAM_SPEC_DOUBLE (pspec), 1);
+  gegl_param_spec_set_property_key (pspec, "sensitive", "join-style {miter}");
+  g_object_class_install_property (object_class, PROP_MITER_LIMIT, pspec);
+
+  pspec = gegl_param_spec_double ("threshold",
+                                  "Seuil d'opacité",
+                                  "Opacité à partir de laquelle un pixel fait "
+                                  "partie du calque",
+                                  0.0, 0.99, 0.5,
+                                  0.0, 0.99, 1.0,
+                                  G_PARAM_READWRITE |
+                                  G_PARAM_CONSTRUCT);
+  gegl_param_spec_double_set_steps (GEGL_PARAM_SPEC_DOUBLE (pspec), 0.01, 0.1);
+  gegl_param_spec_double_set_digits (GEGL_PARAM_SPEC_DOUBLE (pspec), 2);
+  g_object_class_install_property (object_class, PROP_THRESHOLD, pspec);
+}
+
+static void
+gimp_operation_contour_init (GimpOperationContour *self)
+{
+}
+
+static void
+gimp_operation_contour_finalize (GObject *object)
+{
+  GimpOperationContour *self = GIMP_OPERATION_CONTOUR (object);
+
+  g_clear_object (&self->color);
+
+  G_OBJECT_CLASS (parent_class)->finalize (object);
+}
+
+static void
+gimp_operation_contour_get_property (GObject    *object,
+                                     guint       property_id,
+                                     GValue     *value,
+                                     GParamSpec *pspec)
+{
+  GimpOperationContour *self = GIMP_OPERATION_CONTOUR (object);
+
+  switch (property_id)
+    {
+    case PROP_POSITION:
+      g_value_set_enum (value, self->position);
+      break;
+
+    case PROP_WIDTH:
+      g_value_set_double (value, self->width);
+      break;
+
+    case PROP_COLOR:
+      g_value_set_object (value, self->color);
+      break;
+
+    case PROP_OPACITY:
+      g_value_set_double (value, self->opacity);
+      break;
+
+    case PROP_ANTIALIAS:
+      g_value_set_boolean (value, self->antialias);
+      break;
+
+    case PROP_DASH_PRESET:
+      g_value_set_enum (value, self->dash_preset);
+      break;
+
+    case PROP_CAP_STYLE:
+      g_value_set_enum (value, self->cap_style);
+      break;
+
+    case PROP_JOIN_STYLE:
+      g_value_set_enum (value, self->join_style);
+      break;
+
+    case PROP_MITER_LIMIT:
+      g_value_set_double (value, self->miter_limit);
+      break;
+
+    case PROP_THRESHOLD:
+      g_value_set_double (value, self->threshold);
+      break;
+
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_operation_contour_set_property (GObject      *object,
+                                     guint         property_id,
+                                     const GValue *value,
+                                     GParamSpec   *pspec)
+{
+  GimpOperationContour *self = GIMP_OPERATION_CONTOUR (object);
+
+  switch (property_id)
+    {
+    case PROP_POSITION:
+      self->position = g_value_get_enum (value);
+      break;
+
+    case PROP_WIDTH:
+      self->width = g_value_get_double (value);
+      break;
+
+    case PROP_COLOR:
+      g_clear_object (&self->color);
+      self->color = g_value_dup_object (value);
+      break;
+
+    case PROP_OPACITY:
+      self->opacity = g_value_get_double (value);
+      break;
+
+    case PROP_ANTIALIAS:
+      self->antialias = g_value_get_boolean (value);
+      break;
+
+    case PROP_DASH_PRESET:
+      self->dash_preset = g_value_get_enum (value);
+      break;
+
+    case PROP_CAP_STYLE:
+      self->cap_style = g_value_get_enum (value);
+      break;
+
+    case PROP_JOIN_STYLE:
+      self->join_style = g_value_get_enum (value);
+      break;
+
+    case PROP_MITER_LIMIT:
+      self->miter_limit = g_value_get_double (value);
+      break;
+
+    case PROP_THRESHOLD:
+      self->threshold = g_value_get_double (value);
+      break;
+
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_operation_contour_prepare (GeglOperation *operation)
+{
+  const Babl *space  = gegl_operation_get_source_space (operation, "input");
+  const Babl *format = babl_format_with_space ("RGBA float", space);
+
+  gegl_operation_set_format (operation, "input",  format);
+  gegl_operation_set_format (operation, "output", format);
+}
+
+/*  how far the stroke goes beyond the layer's edge, in pixels  */
+static gint
+gimp_operation_contour_get_grow (GimpOperationContour *self)
+{
+  gdouble half;
+
+  if (self->position == GIMP_CONTOUR_POSITION_INSIDE)
+    return 0;
+
+  if (self->position == GIMP_CONTOUR_POSITION_CENTER)
+    half = self->width / 2.0;
+  else
+    half = self->width;
+
+  /*  the outline only has right angles: a miter (or a square cap)
+   *  goes at most half * sqrt (2) away from the path, plus a pixel
+   *  of antialiasing
+   */
+  return (gint) ceil (half * G_SQRT2) + 2;
+}
+
+static GeglRectangle
+gimp_operation_contour_get_bounding_box (GeglOperation *operation)
+{
+  GimpOperationContour *self   = GIMP_OPERATION_CONTOUR (operation);
+  GeglRectangle         result = { 0, 0, 0, 0 };
+  const GeglRectangle  *in_rect;
+  gint                  grow;
+
+  in_rect = gegl_operation_source_get_bounding_box (operation, "input");
+
+  if (! in_rect)
+    return result;
+
+  if (gegl_rectangle_is_infinite_plane (in_rect) ||
+      gegl_rectangle_is_empty (in_rect))
+    return *in_rect;
+
+  grow = gimp_operation_contour_get_grow (self);
+
+  result.x      = in_rect->x - grow;
+  result.y      = in_rect->y - grow;
+  result.width  = in_rect->width  + 2 * grow;
+  result.height = in_rect->height + 2 * grow;
+
+  return result;
+}
+
+static GeglRectangle
+gimp_operation_contour_get_required_for_output (GeglOperation       *operation,
+                                                const gchar         *input_pad,
+                                                const GeglRectangle *roi)
+{
+  const GeglRectangle *in_rect;
+
+  /*  the outline depends on the whole layer  */
+  in_rect = gegl_operation_source_get_bounding_box (operation, "input");
+
+  if (in_rect && ! gegl_rectangle_is_infinite_plane (in_rect))
+    return *in_rect;
+
+  return *roi;
+}
+
+static GeglRectangle
+gimp_operation_contour_get_invalidated_by_change (GeglOperation       *operation,
+                                                  const gchar         *input_pad,
+                                                  const GeglRectangle *input_region)
+{
+  /*  a change anywhere can move the dashes everywhere  */
+  return gimp_operation_contour_get_bounding_box (operation);
+}
+
+static GeglRectangle
+gimp_operation_contour_get_cached_region (GeglOperation       *operation,
+                                          const GeglRectangle *roi)
+{
+  GeglRectangle result = gimp_operation_contour_get_bounding_box (operation);
+
+  if (gegl_rectangle_is_infinite_plane (&result))
+    return *roi;
+
+  return result;
+}
+
+/*  appends the sorted boundary groups to cr's path as closed polygons,
+ *  dropping the vertices where the outline goes straight on
+ */
+static void
+gimp_operation_contour_append_path (cairo_t            *cr,
+                                    const GimpBoundSeg *segs,
+                                    gint                n_groups)
+{
+  gint seg = 0;
+  gint group;
+
+  for (group = 0; group < n_groups; group++)
+    {
+      gint first = seg;
+      gint i;
+
+      while (segs[seg].x1 != -1 ||
+             segs[seg].y1 != -1 ||
+             segs[seg].x2 != -1 ||
+             segs[seg].y2 != -1)
+        seg++;
+
+      if (seg - first >= 2)
+        {
+          cairo_move_to (cr, segs[first].x1, segs[first].y1);
+
+          for (i = first + 1; i < seg; i++)
+            {
+              const GimpBoundSeg *prev = &segs[i - 1];
+              const GimpBoundSeg *cur  = &segs[i];
+
+              if ((prev->x1 == cur->x1 && cur->x1 == cur->x2) ||
+                  (prev->y1 == cur->y1 && cur->y1 == cur->y2))
+                continue;
+
+              cairo_line_to (cr, cur->x1, cur->y1);
+            }
+
+          cairo_close_path (cr);
+        }
+
+      /*  skip the group's end marker  */
+      seg++;
+    }
+}
+
+static gboolean
+gimp_operation_contour_process (GeglOperation       *operation,
+                                GeglBuffer          *input,
+                                GeglBuffer          *output,
+                                const GeglRectangle *roi,
+                                gint                 level)
+{
+  GimpOperationContour *self   = GIMP_OPERATION_CONTOUR (operation);
+  const Babl           *format = gegl_operation_get_format (operation, "output");
+  const GeglRectangle  *in_rect;
+  GeglBuffer           *alpha_buffer;
+  GeglBufferIterator   *iter;
+  GimpBoundSeg         *segs;
+  GimpBoundSeg         *sorted;
+  gint                  n_segs   = 0;
+  gint                  n_groups = 0;
+  gfloat               *alpha;
+  cairo_surface_t      *surface;
+  cairo_t              *cr;
+  const guchar         *mask;
+  gint                  stride;
+  gfloat                color[4] = { 0.0, 0.0, 0.0, 1.0 };
+  gfloat                strength;
+  gboolean              behind;
+  gboolean              clip_alpha;
+
+  in_rect = gegl_operation_source_get_bounding_box (operation, "input");
+
+  if (! in_rect                              ||
+      gegl_rectangle_is_empty (in_rect)      ||
+      gegl_rectangle_is_infinite_plane (in_rect) ||
+      self->opacity <= 0.0                   ||
+      roi->width  > 32767                    ||
+      roi->height > 32767)
+    {
+      gegl_buffer_copy (input, roi, GEGL_ABYSS_NONE, output, roi);
+      return TRUE;
+    }
+
+  /*  1. the outline of the layer's alpha, at the threshold  */
+
+  alpha = g_try_new (gfloat, (gsize) in_rect->width * in_rect->height);
+
+  if (! alpha)
+    {
+      gegl_buffer_copy (input, roi, GEGL_ABYSS_NONE, output, roi);
+      return TRUE;
+    }
+
+  gegl_buffer_get (input, in_rect, 1.0, babl_format ("A float"),
+                   alpha, GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+
+  /*  gimp_boundary_find() wants a buffer starting at 0, 0  */
+  alpha_buffer =
+    gegl_buffer_linear_new_from_data (alpha, babl_format ("Y float"),
+                                      GEGL_RECTANGLE (0, 0,
+                                                      in_rect->width,
+                                                      in_rect->height),
+                                      in_rect->width * sizeof (gfloat),
+                                      NULL, NULL);
+
+  segs = gimp_boundary_find (alpha_buffer, NULL, babl_format ("Y float"),
+                             GIMP_BOUNDARY_WITHIN_BOUNDS,
+                             0, 0, in_rect->width, in_rect->height,
+                             self->threshold,
+                             &n_segs);
+
+  g_object_unref (alpha_buffer);
+  g_free (alpha);
+
+  if (n_segs == 0)
+    {
+      g_free (segs);
+      gegl_buffer_copy (input, roi, GEGL_ABYSS_NONE, output, roi);
+      return TRUE;
+    }
+
+  sorted = gimp_boundary_sort (segs, n_segs, &n_groups);
+  g_free (segs);
+
+  /*  2. the stroke's coverage, rendered by cairo  */
+
+  surface = cairo_image_surface_create (CAIRO_FORMAT_A8,
+                                        roi->width, roi->height);
+
+  if (cairo_surface_status (surface) != CAIRO_STATUS_SUCCESS)
+    {
+      cairo_surface_destroy (surface);
+      g_free (sorted);
+      gegl_buffer_copy (input, roi, GEGL_ABYSS_NONE, output, roi);
+      return TRUE;
+    }
+
+  cr = cairo_create (surface);
+
+  /*  boundary coordinates are relative to the layer's origin  */
+  cairo_translate (cr, in_rect->x - roi->x, in_rect->y - roi->y);
+
+  cairo_set_antialias (cr, self->antialias ?
+                           CAIRO_ANTIALIAS_DEFAULT : CAIRO_ANTIALIAS_NONE);
+  cairo_set_fill_rule (cr, CAIRO_FILL_RULE_EVEN_ODD);
+
+  switch (self->position)
+    {
+    case GIMP_CONTOUR_POSITION_OUTSIDE:
+      /*  keep the outer half of the stroke only  */
+      cairo_rectangle (cr,
+                       roi->x - in_rect->x, roi->y - in_rect->y,
+                       roi->width, roi->height);
+      gimp_operation_contour_append_path (cr, sorted, n_groups);
+      cairo_clip (cr);
+      cairo_set_line_width (cr, 2.0 * self->width);
+      break;
+
+    case GIMP_CONTOUR_POSITION_CENTER:
+      cairo_set_line_width (cr, self->width);
+      break;
+
+    case GIMP_CONTOUR_POSITION_INSIDE:
+      /*  keep the inner half of the stroke only  */
+      gimp_operation_contour_append_path (cr, sorted, n_groups);
+      cairo_clip (cr);
+      cairo_set_line_width (cr, 2.0 * self->width);
+      break;
+    }
+
+  switch (self->cap_style)
+    {
+    case GIMP_CAP_BUTT:
+      cairo_set_line_cap (cr, CAIRO_LINE_CAP_BUTT);
+      break;
+    case GIMP_CAP_ROUND:
+      cairo_set_line_cap (cr, CAIRO_LINE_CAP_ROUND);
+      break;
+    case GIMP_CAP_SQUARE:
+      cairo_set_line_cap (cr, CAIRO_LINE_CAP_SQUARE);
+      break;
+    }
+
+  switch (self->join_style)
+    {
+    case GIMP_JOIN_MITER:
+      cairo_set_line_join (cr, CAIRO_LINE_JOIN_MITER);
+      break;
+    case GIMP_JOIN_ROUND:
+      cairo_set_line_join (cr, CAIRO_LINE_JOIN_ROUND);
+      break;
+    case GIMP_JOIN_BEVEL:
+      cairo_set_line_join (cr, CAIRO_LINE_JOIN_BEVEL);
+      break;
+    }
+
+  cairo_set_miter_limit (cr, self->miter_limit);
+
+  if (self->dash_preset != GIMP_CONTOUR_DASH_LINE)
+    {
+      GArray *pattern;
+
+      /*  GimpContourDash is GimpDashPreset without GIMP_DASH_CUSTOM  */
+      pattern = gimp_dash_pattern_new_from_preset ((GimpDashPreset)
+                                                   (self->dash_preset +
+                                                    GIMP_DASH_LINE));
+
+      if (pattern)
+        {
+          gdouble *dashes;
+          guint    i;
+
+          /*  dash lengths are in units of the visible stroke width,
+           *  like gimp_scan_convert_stroke() does
+           */
+          dashes = g_new (gdouble, pattern->len);
+
+          for (i = 0; i < pattern->len; i++)
+            dashes[i] = MAX (self->width, 1.0) *
+                        g_array_index (pattern, gdouble, i);
+
+          cairo_set_dash (cr, dashes, pattern->len, 0.0);
+
+          g_free (dashes);
+          gimp_dash_pattern_free (pattern);
+        }
+    }
+
+  cairo_new_path (cr);
+  gimp_operation_contour_append_path (cr, sorted, n_groups);
+  cairo_set_source_rgba (cr, 0.0, 0.0, 0.0, 1.0);
+  cairo_stroke (cr);
+
+  cairo_destroy (cr);
+  g_free (sorted);
+
+  cairo_surface_flush (surface);
+
+  mask   = cairo_image_surface_get_data (surface);
+  stride = cairo_image_surface_get_stride (surface);
+
+  /*  3. composite the stroke with the layer, in linear light  */
+
+  if (self->color)
+    gegl_color_get_pixel (self->color, format, color);
+
+  strength   = self->opacity * CLAMP (color[3], 0.0, 1.0) / 255.0;
+  behind     = (self->position == GIMP_CONTOUR_POSITION_OUTSIDE);
+  clip_alpha = (self->position == GIMP_CONTOUR_POSITION_INSIDE);
+
+  iter = gegl_buffer_iterator_new (output, roi, 0, format,
+                                   GEGL_ACCESS_WRITE, GEGL_ABYSS_NONE, 2);
+
+  gegl_buffer_iterator_add (iter, input, roi, 0, format,
+                            GEGL_ACCESS_READ, GEGL_ABYSS_NONE);
+
+  while (gegl_buffer_iterator_next (iter))
+    {
+      gfloat              *out  = iter->items[0].data;
+      const gfloat        *in   = iter->items[1].data;
+      const GeglRectangle *rect = &iter->items[0].roi;
+      gint                 x, y;
+
+      for (y = 0; y < rect->height; y++)
+        {
+          const guchar *m = mask +
+                            (rect->y + y - roi->y) * stride +
+                            (rect->x - roi->x);
+
+          for (x = 0; x < rect->width; x++)
+            {
+              gfloat la = in[3];
+              gfloat sa = m[x] * strength;
+              gfloat a;
+              gint   c;
+
+              if (sa <= 0.0f)
+                {
+                  out[0] = in[0];
+                  out[1] = in[1];
+                  out[2] = in[2];
+                  out[3] = in[3];
+                }
+              else
+                {
+                  if (clip_alpha)
+                    sa *= la;
+
+                  if (behind)
+                    {
+                      /*  layer OVER stroke  */
+                      gfloat k = sa * (1.0f - la);
+
+                      a = la + k;
+
+                      for (c = 0; c < 3; c++)
+                        out[c] = (a > 1e-7f ?
+                                  (in[c] * la + color[c] * k) / a : 0.0f);
+                    }
+                  else
+                    {
+                      /*  stroke OVER layer  */
+                      gfloat k = la * (1.0f - sa);
+
+                      a = sa + k;
+
+                      for (c = 0; c < 3; c++)
+                        out[c] = (a > 1e-7f ?
+                                  (color[c] * sa + in[c] * k) / a : 0.0f);
+                    }
+
+                  out[3] = a;
+                }
+
+              in  += 4;
+              out += 4;
+            }
+        }
+    }
+
+  cairo_surface_destroy (surface);
+
+  return TRUE;
+}
