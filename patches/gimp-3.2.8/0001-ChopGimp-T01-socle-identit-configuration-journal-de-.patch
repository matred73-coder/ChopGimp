+/*  ChopGimp: instead of GIMP's Wilber, the empty image window shows the
+ *  ChopGimp logo (4.2.8: the application icon, images/chopgimp-logo.png,
+ *  installed by tools/install_data.sh from branding/) and how to get
+ *  started.
+ */
+static GdkPixbuf *
+chopgimp_drop_zone_logo (void)
+{
+  static GdkPixbuf *logo   = NULL;
+  static gboolean   loaded = FALSE;
+
+  if (! loaded)
+    {
+      GFile *file = gimp_data_directory_file ("images", "chopgimp-logo.png",
+                                              NULL);
+      gchar *path = g_file_get_path (file);
+
+      loaded = TRUE;
+      logo   = gdk_pixbuf_new_from_file (path, NULL);
+
+      g_free (path);
+      g_object_unref (file);
+    }
+
+  return logo;
+}
+
+static void
+chopgimp_draw_drop_zone (GimpDisplayShell *shell,
+                         cairo_t          *cr)
+{
+  GtkAllocation         a;
+  PangoLayout          *layout;
+  PangoFontDescription *font;
+  GdkPixbuf            *logo;
+  gdouble               cx, cy, r;
+  gint                  w, h;
+
+  gtk_widget_get_allocation (shell->canvas, &a);
+
+  r  = CLAMP (MIN (a.width, a.height) * 0.16, 48.0, 150.0);
+  cx = a.width  / 2.0;
+  cy = a.height / 2.0 - r * 0.5;
+
+  /* logo */
+  logo = chopgimp_drop_zone_logo ();
+
+  if (logo)
+    {
+      gdouble scale = 2.0 * r / MAX (gdk_pixbuf_get_width (logo),
+                                     gdk_pixbuf_get_height (logo));
+
+      cairo_save (cr);
+      cairo_translate (cr,
+                       cx - gdk_pixbuf_get_width  (logo) * scale / 2.0,
+                       cy - gdk_pixbuf_get_height (logo) * scale / 2.0);
+      cairo_scale (cr, scale, scale);
+      gdk_cairo_set_source_pixbuf (cr, logo, 0, 0);
+      cairo_pattern_set_filter (cairo_get_source (cr), CAIRO_FILTER_GOOD);
+      cairo_paint_with_alpha (cr, shell->blink ? 1.0 : 0.85);
+      cairo_restore (cr);
+    }
+
+  layout = gtk_widget_create_pango_layout (shell->canvas, NULL);
+  font   = pango_font_description_from_string ("Sans");
+
+  /* hints */
+  pango_layout_set_text (layout,
+                         _("Ctrl+O : ouvrir une image      Ctrl+N : nouveau document\n"
+                           "ou glissez-déposez des images ici"), -1);
+  pango_font_description_set_absolute_size (font, 13 * PANGO_SCALE);
+  pango_layout_set_font_description (layout, font);
+  pango_layout_set_alignment (layout, PANGO_ALIGN_CENTER);
+  pango_layout_get_pixel_size (layout, &w, &h);
+  cairo_set_source_rgba (cr, 1.0, 1.0, 1.0, 0.45);
+  cairo_move_to (cr, cx - w / 2.0, cy + r + 18);
+  pango_cairo_show_layout (cr, layout);
+
+  pango_font_description_free (font);
+  g_object_unref (layout);
+}
+
 static void
 gimp_display_shell_canvas_draw_drop_zone (GimpDisplayShell *shell,
                                           cairo_t          *cr)
@@ -642,7 +725,7 @@ gimp_display_shell_canvas_draw_drop_zone (GimpDisplayShell *shell,
 
   gimp_display_shell_draw_background (shell, cr);
 
-  gimp_cairo_draw_drop_wilber (shell->canvas, cr, shell->blink);
+  chopgimp_draw_drop_zone (shell, cr);
 
   cairo_restore (cr);
 
