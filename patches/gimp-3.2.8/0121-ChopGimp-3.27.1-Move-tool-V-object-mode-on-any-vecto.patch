  */
 gint              chopgimp_vlayer_decompose        (GimpVectorLayer  *layer,
                                                     gboolean          push_undo);
+/*  3.27.1: a vector layer just made from a path (« Créer un calque
+ *  vectoriel »): one object per island (an outer sub-path and its holes),
+ *  each with the layer's fill / stroke; nothing when there is a single
+ *  island (the layer stays « legacy »). No undo step: part of the
+ *  creation. Returns the number of objects made.
+ */
+gint              chopgimp_vlayer_split_new        (GimpVectorLayer  *layer);
 
 
