+/*  ChopGimp 3.27.1: TRUE when a press at @coords starts a new stroke (an
+ *  empty area, no extendable anchor selected), the « void » of the Pen
+ */
+gboolean
+gimp_tool_path_creates_stroke (GimpToolPath     *tool_path,
+                               const GimpCoords *coords,
+                               GdkModifierType   state)
+{
+  g_return_val_if_fail (GIMP_IS_TOOL_PATH (tool_path), FALSE);
+  g_return_val_if_fail (coords != NULL, FALSE);
+
+  return gimp_tool_path_get_function (tool_path, coords, state) ==
+         VECTORS_CREATE_STROKE;
+}
