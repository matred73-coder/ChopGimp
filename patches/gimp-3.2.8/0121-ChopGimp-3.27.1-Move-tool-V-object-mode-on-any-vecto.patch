diff --git a/app/path/chopgimp-vobject-ops.h b/app/path/chopgimp-vobject-ops.h
index aef5c86..97a30d5 100644
--- a/app/path/chopgimp-vobject-ops.h
+++ b/app/path/chopgimp-vobject-ops.h
@@ -50,9 +50,14 @@ typedef enum
 
 
 /*  a vector layer worked on as objects: not rasterized, objects enabled,
- *  and several objects or already edited as objects
+ *  and several objects, already edited as objects, or with selected
+ *  objects (3.27.1)
  */
 gboolean          chopgimp_vobjects_layer_is_multi   (GimpVectorLayer *layer);
+/*  3.27.1: any vector layer the Move tool works on as objects (one legacy
+ *  object or more): attached, not rasterized, objects enabled
+ */
+gboolean          chopgimp_vobjects_layer_is_target  (GimpVectorLayer *layer);
 /*  the only selected layer of @image when it is such a layer, else NULL
  *  (always NULL with CHOPGIMP_NO_VOBJECTS=1)
  */
diff --git a/app/path/chopgimp-vobject.c b/app/path/chopgimp-vobject.c
index dc77229..6df33d9 100644
--- a/app/path/chopgimp-vobject.c
+++ b/app/path/chopgimp-vobject.c
@@ -4960,6 +4960,36 @@ chopgimp_vlayer_decompose (GimpVectorLayer *layer,
 }
 
 
+gint
+chopgimp_vlayer_split_new (GimpVectorLayer *layer)
+{
+  gint n;
+
+  if (! chopgimp_vobjects_enabled () || ! layer_usable (layer) ||
+      ! layer->options || ! layer->options->path ||
+      gimp_path_get_n_strokes (layer->options->path) < 2)
+    return 0;
+
+  /*  never edited as objects: object #1 is the layer itself  */
+  if (layer->vobjects && ! layer->vobjects->legacy)
+    return 0;
+
+  if (! vlayer_ensure (layer))
+    return 0;
+
+  /*  the fill / stroke set just after the creation  */
+  vlayer_style_from_options (layer);
+  g_array_set_size (layer->vobjects->selection, 0);
+
+  n = chopgimp_vlayer_decompose (layer, FALSE);
+
+  if (n > 0)
+    chopgimp_vlayer_set_selection (layer, NULL, 0);
+
+  return n;
+}
+
