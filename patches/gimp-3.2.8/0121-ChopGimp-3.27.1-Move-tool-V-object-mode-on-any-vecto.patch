+gboolean
+chopgimp_vobjects_layer_is_target (GimpVectorLayer *layer)
+{
+  return (chopgimp_vobjects_enabled () && GIMP_IS_VECTOR_LAYER (layer) &&
+          gimp_item_is_attached (GIMP_ITEM (layer)) &&
+          gimp_item_is_vector_layer (GIMP_ITEM (layer)) &&
+          chopgimp_vlayer_get_root (layer) != NULL);
 }
 
