From 547a7e34603118a69e231958a89665b1b665e4fd Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Wed, 11 Nov 2026 12:53:32 +0100
Subject: [PATCH 09/10] PhotoGIMP Pro: Photoshop-like horizontal tool options
 bar

A new GimpOptionsBar below the menubar follows the active tool and shows its
most used options as compact widgets bound to the same GimpToolOptions as
the Tool Options dockable, plus a button opening the full dockable.
---
 app/display/gimpimagewindow.c |  10 +
 app/display/gimpoptionsbar.c  | 382 ++++++++++++++++++++++++++++++++++
 app/display/gimpoptionsbar.h  |  12 ++
 app/display/meson.build       |   1 +
 4 files changed, 405 insertions(+)
 create mode 100644 app/display/gimpoptionsbar.c
 create mode 100644 app/display/gimpoptionsbar.h

diff --git a/app/display/gimpimagewindow.c b/app/display/gimpimagewindow.c
index 228a067..84b87ee 100644
--- a/app/display/gimpimagewindow.c
+++ b/app/display/gimpimagewindow.c
@@ -95,6 +95,7 @@
 #include "gimpdisplayshell-tool-events.h"
 #include "gimpdisplayshell-transform.h"
 #include "gimpimagewindow.h"
+#include "gimpoptionsbar.h"
 #include "gimpstatusbar.h"
 
 #include "gimp-log.h"
@@ -582,6 +583,15 @@ gimp_image_window_constructed (GObject *object)
         }
     }
 
+  /*  PhotoGIMP Pro: Photoshop-like tool options bar below the menubar  */
+  {
+    GtkWidget *options_bar = gimp_options_bar_new (private->gimp);
+
+    gtk_box_pack_start (GTK_BOX (private->main_vbox), options_bar,
+                        FALSE, FALSE, 0);
+    gtk_widget_set_visible (options_bar, TRUE);
+  }
+
 #ifdef GDK_WINDOWING_QUARTZ
   menus_quartz_app_menu (private->gimp);
 #else
diff --git a/app/display/gimpoptionsbar.c b/app/display/gimpoptionsbar.c
new file mode 100644
index 0000000..033646e
--- /dev/null
+++ b/app/display/gimpoptionsbar.c
@@ -0,0 +1,382 @@
