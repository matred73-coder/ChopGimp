+
   if (gimp_paint_options_are_dynamics_enabled (paint_options))
     {
       gimp_brush_core_set_dynamics (core, gimp_context_get_dynamics (context));
@@ -963,6 +985,52 @@ gimp_brush_core_set_dynamics (GimpBrushCore *core,
     g_signal_emit (core, core_signals[SET_DYNAMICS], 0, dynamics);
 }
 
+/*  ChopGimp: the brush mask modulated by the paper grain, in canvas
+ *  coordinates (the grain stays still on the sheet). Returns a new mask, or
+ *  NULL when there is no texture.
+ */
+static GimpTempBuf *
+chopgimp_paper_mask (GimpBrushCore     *core,
+                     const GimpTempBuf *mask,
+                     gint               x0,
+                     gint               y0)
+{
+  GimpTempBuf *out;
+  gfloat      *data;
+  gint         w, h, i, j;
+  gdouble      k, s;
+
+  if (! core->paper || gimp_temp_buf_get_format (mask) != babl_format ("Y float"))
+    return NULL;
+
+  out  = gimp_temp_buf_copy (mask);
+  data = (gfloat *) gimp_temp_buf_get_data (out);
+  w    = gimp_temp_buf_get_width  (out);
+  h    = gimp_temp_buf_get_height (out);
+  k    = 1.0 / MAX (core->paper_scale, 0.01);
+  s    = core->paper_strength;
+
+  for (j = 0; j < h; j++)
+    {
+      gint py = ((gint) floor ((y0 + j) * k)) % core->paper_h;
+
+      if (py < 0)
+        py += core->paper_h;
+
+      for (i = 0; i < w; i++)
+        {
+          gint px = ((gint) floor ((x0 + i) * k)) % core->paper_w;
+
+          if (px < 0)
+            px += core->paper_w;
+
+          data[j * w + i] *= (gfloat) (1.0 - s + s * core->paper[py * core->paper_w + px]);
+        }
+    }
+
+  return out;
+}
+
 void
 gimp_brush_core_paste_canvas (GimpBrushCore            *core,
                               GimpDrawable             *drawable,
@@ -994,13 +1062,19 @@ gimp_brush_core_paste_canvas (GimpBrushCore            *core,
       off_x = (x < 0) ? -x : 0;
       off_y = (y < 0) ? -y : 0;
 
-      gimp_paint_core_paste (paint_core, brush_mask,
-                             off_x, off_y,
-                             drawable,
-                             brush_opacity,
-                             image_opacity,
-                             paint_mode,
-                             mode);
+      {
+        GimpTempBuf *paper = chopgimp_paper_mask (core, brush_mask, x, y);
+
+        gimp_paint_core_paste (paint_core, paper ? paper : brush_mask,
+                               off_x, off_y,
+                               drawable,
+                               brush_opacity,
+                               image_opacity,
+                               paint_mode,
+                               mode);
+        if (paper)
+          gimp_temp_buf_unref (paper);
+      }
     }
 }
 
