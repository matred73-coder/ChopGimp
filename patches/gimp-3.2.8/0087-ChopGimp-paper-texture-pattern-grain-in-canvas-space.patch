+/*  ChopGimp: QuickShape (Procreate). The pen held still for a moment at the
+ *  end of a stroke: an almost straight stroke becomes a line, an almost
+ *  closed round one an ellipse (or a circle). The freehand stroke is
+ *  cancelled and the shape is painted with the same brush.
+ */
+#define QS_DELAY 800
+
+static gboolean
+chopgimp_quickshape_fit (GArray     *pts,
+                         GimpCoords *out,
+                         gint       *n_out,
+                         gint        max_out)
+{
+  GimpCoords *p = (GimpCoords *) pts->data;
+  gint        n = pts->len, i;
+  gdouble     ax = p[0].x, ay = p[0].y, bx = p[n - 1].x, by = p[n - 1].y;
+  gdouble     len = hypot (bx - ax, by - ay), path = 0.0, dev = 0.0, pressure = 0.0;
+  gdouble     x1 = G_MAXDOUBLE, y1 = G_MAXDOUBLE, x2 = -G_MAXDOUBLE, y2 = -G_MAXDOUBLE;
+
+  if (n < 8)
+    return FALSE;
+
+  for (i = 0; i < n; i++)
+    {
+      if (i)
+        path += hypot (p[i].x - p[i - 1].x, p[i].y - p[i - 1].y);
+      if (len > 0)
+        dev = MAX (dev, fabs ((bx - ax) * (ay - p[i].y) - (ax - p[i].x) * (by - ay)) / len);
+      x1 = MIN (x1, p[i].x); y1 = MIN (y1, p[i].y);
+      x2 = MAX (x2, p[i].x); y2 = MAX (y2, p[i].y);
+      pressure += p[i].pressure;
+    }
+  pressure /= n;
+
+  /*  line  */
+  if (len > 15.0 && dev < MAX (4.0, 0.05 * len))
+    {
+      gint steps = MIN (max_out - 1, (gint) (len / 2.0) + 1);
+
+      for (i = 0; i <= steps; i++)
+        {
+          out[i]          = p[0];
+          out[i].x        = ax + (bx - ax) * i / steps;
+          out[i].y        = ay + (by - ay) * i / steps;
+          out[i].pressure = pressure;
+        }
+      *n_out = steps + 1;
+      return TRUE;
+    }
+
+  /*  ellipse / circle  */
+  if (path > 60.0 && len < 0.25 * path)
+    {
+      gdouble cx = (x1 + x2) / 2, cy = (y1 + y2) / 2;
+      gdouble rx = (x2 - x1) / 2, ry = (y2 - y1) / 2, err = 0.0;
+      gint    steps = max_out - 1;
+
+      if (rx < 4 || ry < 4)
+        return FALSE;
+      for (i = 0; i < n; i++)
+        err += fabs (SQR ((p[i].x - cx) / rx) + SQR ((p[i].y - cy) / ry) - 1.0);
+      if (err / n > 0.3)
+        return FALSE;
+      if (fabs (rx - ry) < 0.12 * MAX (rx, ry))
+        rx = ry = (rx + ry) / 2;
+
+      for (i = 0; i <= steps; i++)
+        {
+          gdouble a = 2 * G_PI * i / steps;
+
+          out[i]          = p[0];
+          out[i].x        = cx + rx * cos (a);
+          out[i].y        = cy + ry * sin (a);
+          out[i].pressure = pressure;
+        }
+      *n_out = steps + 1;
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+static gboolean
+chopgimp_quickshape_timeout (GimpPaintTool *paint_tool)
+{
+  GimpDisplay *display = paint_tool->display;
+  GimpCoords   shape[400];
+  gint         n = 0, i;
+
+  paint_tool->qs_timer = 0;
+
+  if (! display || ! paint_tool->qs_points || paint_tool->qs_done ||
+      ! gimp_paint_tool_paint_is_active (paint_tool) ||
+      ! chopgimp_quickshape_fit (paint_tool->qs_points, shape, &n, G_N_ELEMENTS (shape)))
+    return G_SOURCE_REMOVE;
+
+  paint_tool->qs_done = TRUE;
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (paint_tool));
+
+  /*  the freehand stroke goes, the shape comes  */
+  gimp_paint_tool_paint_end (paint_tool, 0, TRUE);
+  if (gimp_paint_tool_paint_start (paint_tool, display, &shape[0], 0, FALSE, NULL))
+    {
+      paint_tool->core->stab_release = TRUE;   /*  no stabilizer lag on the shape  */
+      for (i = 1; i < n; i++)
+        gimp_paint_tool_paint_motion (paint_tool, &shape[i], 0);
+      gimp_paint_tool_paint_end (paint_tool, 0, FALSE);
+    }
+
+  gimp_image_flush (gimp_display_get_image (display));
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (paint_tool));
+  gimp_tool_push_status (GIMP_TOOL (paint_tool), display,
+                         _("QuickShape : forme redressée (Ctrl+Z pour annuler)"));
+
+  return G_SOURCE_REMOVE;
+}
+
 static void
 gimp_paint_tool_button_release (GimpTool              *tool,
                                 const GimpCoords      *coords,
@@ -433,7 +566,17 @@ gimp_paint_tool_button_release (GimpTool              *tool,
 
   cancel = (release_type == GIMP_BUTTON_RELEASE_CANCEL);
 
-  gimp_paint_tool_paint_end (paint_tool, time, cancel);
+  if (paint_tool->qs_timer)
+    {
+      g_source_remove (paint_tool->qs_timer);
+      paint_tool->qs_timer = 0;
+    }
+  g_clear_pointer (&paint_tool->qs_points, g_array_unref);
+
+  if (paint_tool->qs_done)
+    paint_tool->qs_done = FALSE;          /*  QuickShape already finished it  */
+  else
+    gimp_paint_tool_paint_end (paint_tool, time, cancel);
 
   gimp_tool_control_halt (tool->control);
 
@@ -461,6 +604,26 @@ gimp_paint_tool_motion (GimpTool         *tool,
   if (gimp_color_tool_is_enabled (GIMP_COLOR_TOOL (tool)))
     return;
 
+  if (paint_tool->qs_done)
+    return;
+
+  /*  ChopGimp: QuickShape, record the stroke and wait for the pen to rest  */
+  if (paint_tool->qs_points)
+    {
+      GimpCoords *last = paint_tool->qs_points->len ?
+        &g_array_index (paint_tool->qs_points, GimpCoords, paint_tool->qs_points->len - 1) : NULL;
+
+      if (! last || hypot (coords->x - last->x, coords->y - last->y) > 2.0)
+        {
+          g_array_append_val (paint_tool->qs_points, *coords);
+          if (paint_tool->qs_timer)
+            g_source_remove (paint_tool->qs_timer);
+          paint_tool->qs_timer = g_timeout_add (QS_DELAY,
+                                                (GSourceFunc) chopgimp_quickshape_timeout,
+                                                paint_tool);
+        }
+    }
+
   if (! paint_tool->snap_brush)
     gimp_draw_tool_pause  (GIMP_DRAW_TOOL (tool));
 
