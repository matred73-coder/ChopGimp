From d3dbddda6489a5fbe4d496f668d730a9b025102c Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Sat, 14 Nov 2026 21:35:10 +0100
Subject: [PATCH] ChopGimp: Ctrl+click on thumbnail keeps the active layer
 selected

---
 app/widgets/gimpcontainertreeview.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/app/widgets/gimpcontainertreeview.c b/app/widgets/gimpcontainertreeview.c
index 7a3f160..181d6da 100644
--- a/app/widgets/gimpcontainertreeview.c
+++ b/app/widgets/gimpcontainertreeview.c
@@ -1569,6 +1569,23 @@ gimp_container_tree_view_button (GtkWidget             *widget,
                   gchar *path_str = gtk_tree_path_to_string (path);
 
                   handled = FALSE;
+
+                  /* ChopGimp (Photoshop) : Ctrl+clic sur la vignette
+                   * charge le contour au relâchement (« pre-clicked »).
+                   * L'appui ne doit pas passer à la sélection multiple
+                   * de GtkTreeView, qui retirait le calque actif de la
+                   * sélection (plus de calque où peindre).
+                   */
+                  if (is_button_press && clicked_cell                       &&
+                      (modifiers & GDK_CONTROL_MASK)                        &&
+                      ! (modifiers & ~(GDK_MOD1_MASK | GDK_SHIFT_MASK |
+                                       GDK_CONTROL_MASK))                   &&
+                      g_signal_has_handler_pending (clicked_cell,
+                                                    g_signal_lookup ("pre-clicked",
+                                                                     G_TYPE_FROM_INSTANCE (clicked_cell)),
+                                                    0, TRUE))
+                    handled = TRUE;
+
                   if (is_button_release && clicked_cell)
                     handled =
                       gimp_cell_renderer_viewable_pre_clicked (clicked_cell,
-- 
