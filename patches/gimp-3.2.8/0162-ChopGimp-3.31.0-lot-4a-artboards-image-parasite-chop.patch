+/*  ─── the export dialog ─────────────────────────────────────────────── */
+
+static const gchar *formats[][2] =
+{
+  { "png",  N_("PNG") },
+  { "jpg",  N_("JPEG") },
+  { "webp", N_("WebP") },
+  { "tif",  N_("TIFF") },
+};
