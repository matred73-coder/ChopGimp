+typedef struct
+{
+  GimpToolOptions parent_instance;
+
+  gboolean        move_artwork;
+  gboolean        fit_canvas;
+} GimpArtboardOptions;
+
+typedef GimpToolOptionsClass GimpArtboardOptionsClass;
+
+static GType gimp_artboard_options_get_type (void) G_GNUC_CONST;
+
+G_DEFINE_TYPE (GimpArtboardOptions, gimp_artboard_options, GIMP_TYPE_TOOL_OPTIONS)
+
+#define GIMP_TYPE_ARTBOARD_OPTIONS (gimp_artboard_options_get_type ())
+#define ARTBOARD_OPTIONS(tool)     ((GimpArtboardOptions *) gimp_tool_get_options (GIMP_TOOL (tool)))
+
+static void
+gimp_artboard_options_set_property (GObject      *object,
+                                    guint         property_id,
+                                    const GValue *value,
+                                    GParamSpec   *pspec)
+{
+  GimpArtboardOptions *o = (GimpArtboardOptions *) object;
+
+  switch (property_id)
+    {
+    case PROP_MOVE_ARTWORK: o->move_artwork = g_value_get_boolean (value); break;
+    case PROP_FIT_CANVAS:   o->fit_canvas   = g_value_get_boolean (value); break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_artboard_options_get_property (GObject    *object,
+                                    guint       property_id,
+                                    GValue     *value,
+                                    GParamSpec *pspec)
+{
+  GimpArtboardOptions *o = (GimpArtboardOptions *) object;
+
+  switch (property_id)
+    {
+    case PROP_MOVE_ARTWORK: g_value_set_boolean (value, o->move_artwork); break;
+    case PROP_FIT_CANVAS:   g_value_set_boolean (value, o->fit_canvas);   break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_artboard_options_class_init (GimpArtboardOptionsClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->set_property = gimp_artboard_options_set_property;
+  object_class->get_property = gimp_artboard_options_get_property;
+
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, PROP_MOVE_ARTWORK,
+                            "artboard-move-artwork",
+                            "Déplacer/copier l'illustration avec le plan",
+                            "Les calques et objets vectoriels contenus dans le plan "
+                            "le suivent quand il est déplacé ou dupliqué (Alt)",
+                            TRUE,
+                            GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, PROP_FIT_CANVAS,
+                            "artboard-fit-canvas",
+                            "Agrandir le canevas pour contenir les plans",
+                            "Le canevas de l'image s'agrandit quand un plan de travail "
+                            "en sort (le contenu et les repères suivent)",
+                            TRUE,
+                            GIMP_PARAM_STATIC_STRINGS);
+}
