diff --git a/plug-ins/common/chopgimp-artboards-parse.h b/plug-ins/common/chopgimp-artboards-parse.h
new file mode 100644
index 0000000..c3752cd
--- /dev/null
+++ b/plug-ins/common/chopgimp-artboards-parse.h
@@ -0,0 +1,124 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-artboards-parse.h — ChopGimp 3.31.0 (lot 4a): the artboards of
+ * an image, for the export plug-ins (PDF / EPS / PSD / PDF with layers:
+ * one page, one artboard or one crop per artboard)
+ *
+ * The image parasite « chopgimp-artboards » (written by
+ * app/core/chopgimp-artboards.c) is UTF-8 text, one record per line:
+ *
+ *   chopgimp-artboards 1
+ *   active <index>
+ *   <x> <y> <width> <height> <name until the end of the line>
+ *
+ * in image pixels, in the order of the Artboards panel (the order of the
+ * pages). The same list is returned by the PDB procedure
+ * « chopgimp-artboards-command » (image, "list").
+ *
+ *   gint n;
+ *   ChopGimpPlugInArtboard *a = chopgimp_plug_in_artboards_get (image, &n);
+ *   for (gint i = 0; i < n; i++) … a[i].name, a[i].x, a[i].y, a[i].width, a[i].height
+ *   chopgimp_plug_in_artboards_free (a, n);
+ *
+ * Header only (static functions), include it once per plug-in.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <libgimp/gimp.h>
+
+
+typedef struct
+{
+  gchar *name;
+  gint   x;
+  gint   y;
+  gint   width;
+  gint   height;
+} ChopGimpPlugInArtboard;
+
+
+static void G_GNUC_UNUSED
+chopgimp_plug_in_artboards_free (ChopGimpPlugInArtboard *boards,
+                                 gint                    n)
+{
+  for (gint i = 0; boards && i < n; i++)
+    g_free (boards[i].name);
+
+  g_free (boards);
+}
+
+/*  the artboards of @image (NULL and *n = 0 when it has none)  */
+static ChopGimpPlugInArtboard * G_GNUC_UNUSED
+chopgimp_plug_in_artboards_get (GimpImage *image,
+                                gint      *n)
+{
+  GimpParasite           *parasite;
+  ChopGimpPlugInArtboard *boards = NULL;
+  gchar                  *text;
+  gchar                 **lines;
+  guint32                 size = 0;
+  const gchar            *data;
+
+  *n = 0;
+
+  parasite = gimp_image_get_parasite (image, "chopgimp-artboards");
+  if (! parasite)
+    return NULL;
+
+  data  = gimp_parasite_get_data (parasite, &size);
+  text  = g_strndup (data, size);
+  lines = g_strsplit (text, "\n", -1);
+
+  boards = g_new0 (ChopGimpPlugInArtboard, g_strv_length (lines) + 1);
+
+  for (gint i = 0; lines[i]; i++)
+    {
+      gchar *l = g_strstrip (lines[i]);
+      gchar *end;
+      gint   v[4];
+      gint   k;
+
+      if (! *l || g_str_has_prefix (l, "chopgimp-artboards") || g_str_has_prefix (l, "active "))
+        continue;
+
+      for (k = 0, end = l; k < 4; k++)
+        {
+          gchar *next;
+
+          v[k] = (gint) strtol (end, &next, 10);
+          if (next == end)
+            break;
+          end = next;
+        }
+
+      if (k < 4 || v[2] < 1 || v[3] < 1)
+        continue;
+
+      boards[*n].x      = v[0];
+      boards[*n].y      = v[1];
+      boards[*n].width  = v[2];
+      boards[*n].height = v[3];
+      boards[*n].name   = g_strdup (g_strstrip (end));
+      (*n)++;
+    }
+
+  g_strfreev (lines);
+  g_free (text);
+  gimp_parasite_free (parasite);
+
+  if (*n == 0)
+    {
+      g_free (boards);
+      return NULL;
+    }
+
+  return boards;
+}
