+                           "Taille d'une cellule de la grille (pixels au niveau du sol)",
+                           1.0, 5000.0, 40.0,
+                           GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_INT (object_class, GP_PROP_EXTENT_L,
+                        "pgrid-extent-l", "Étendue gauche",
+                        "Nombre de cellules du plan gauche",
+                        1, 500, 10,
+                        GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_INT (object_class, GP_PROP_EXTENT_R,
+                        "pgrid-extent-r", "Étendue droite",
+                        "Nombre de cellules du plan droit",
+                        1, 500, 10,
+                        GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_INT (object_class, GP_PROP_HEIGHT,
+                        "pgrid-height", "Hauteur",
+                        "Nombre de cellules en hauteur",
+                        1, 500, 8,
+                        GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_DOUBLE (object_class, GP_PROP_OPACITY,
+                           "pgrid-opacity", "Opacité de la grille",
+                           "Opacité de la grille (%)",
+                           5.0, 100.0, 60.0,
+                           GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, GP_PROP_SNAP,
+                            "pgrid-snap", "Magnétisme de la grille",
+                            "Les objets s'accrochent aux lignes de la grille",
+                            TRUE,
+                            GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, GP_PROP_LOCKED,
+                            "pgrid-locked", "Verrouiller la grille",
+                            "Les widgets de la grille ne bougent plus",
+                            FALSE,
+                            GIMP_PARAM_STATIC_STRINGS);
+  GIMP_CONFIG_PROP_BOOLEAN (object_class, GP_PROP_LOCK_STATION,
+                            "pgrid-lock-station", "Verrouiller le point de station",
+                            "Déplacer un point de fuite déplace l'autre (2 et 3 points)",
+                            FALSE,
+                            GIMP_PARAM_STATIC_STRINGS);
+
+  c = rgb_color (0x2f7cf6);
+  GIMP_CONFIG_PROP_COLOR (object_class, GP_PROP_COLOR_LEFT,
+                          "pgrid-color-left", "Plan gauche", "Couleur du plan gauche",
+                          FALSE, c, GIMP_PARAM_STATIC_STRINGS);
+  g_object_unref (c);
+  c = rgb_color (0xe8563a);
+  GIMP_CONFIG_PROP_COLOR (object_class, GP_PROP_COLOR_RIGHT,
+                          "pgrid-color-right", "Plan droit", "Couleur du plan droit",
+                          FALSE, c, GIMP_PARAM_STATIC_STRINGS);
+  g_object_unref (c);
+  c = rgb_color (0x3bb143);
+  GIMP_CONFIG_PROP_COLOR (object_class, GP_PROP_COLOR_FLOOR,
+                          "pgrid-color-floor", "Plan horizontal", "Couleur du plan horizontal",
+                          FALSE, c, GIMP_PARAM_STATIC_STRINGS);
+  g_object_unref (c);
+}
