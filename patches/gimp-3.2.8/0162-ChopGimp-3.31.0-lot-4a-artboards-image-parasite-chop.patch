+typedef struct
+{
+  GimpImage   *image;
+  GimpContext *context;
+  GtkWidget   *folder;
+  GtkWidget   *format;
+  GtkWidget   *prefix;
+  GtkWidget   *range;
+} ExportDialog;
+
+static void
+export_response (GtkWidget    *dialog,
+                 gint          response,
+                 ExportDialog *d)
+{
+  if (response == GTK_RESPONSE_OK && d->image)
+    {
+      GFile    *folder = gtk_file_chooser_get_file (GTK_FILE_CHOOSER (d->folder));
+      gint      fmt    = gtk_combo_box_get_active (GTK_COMBO_BOX (d->format));
+      gint      n      = chopgimp_artboards_count (d->image);
+      gboolean *sel    = g_new0 (gboolean, MAX (n, 1));
+      GError   *error  = NULL;
+      gint      done;
+
+      if (! folder)
+        {
+          gimp_message_literal (d->image->gimp, G_OBJECT (dialog), GIMP_MESSAGE_WARNING,
+                                _("Choisissez un dossier."));
+          g_free (sel);
+          return;
+        }
+
+      if (! chopgimp_artboards_parse_range (gtk_entry_get_text (GTK_ENTRY (d->range)), n, sel))
+        {
+          gimp_message_literal (d->image->gimp, G_OBJECT (dialog), GIMP_MESSAGE_WARNING,
+                                _("Plage de plans incorrecte (exemple : 1-3, 5)."));
+          g_object_unref (folder);
+          g_free (sel);
+          return;
+        }
+
+      done = chopgimp_artboards_export (d->image, d->context, NULL, folder,
+                                        formats[CLAMP (fmt, 0, 3)][0],
+                                        gtk_entry_get_text (GTK_ENTRY (d->prefix)),
+                                        sel, &error);
+
+      if (done < 0)
+        {
+          gimp_message_literal (d->image->gimp, G_OBJECT (dialog), GIMP_MESSAGE_ERROR,
+                                error ? error->message : _("L'exportation a échoué."));
+          g_clear_error (&error);
+        }
+      else
+        {
+          gchar *msg = g_strdup_printf (ngettext ("%d plan de travail exporté.",
+                                                  "%d plans de travail exportés.", done),
+                                        done);
+
+          gimp_message_literal (d->image->gimp, NULL, GIMP_MESSAGE_INFO, msg);
+          g_free (msg);
+        }
+
+      g_object_unref (folder);
+      g_free (sel);
+
+      if (done < 0)
+        return;
+    }
+
+  gtk_widget_destroy (dialog);
+}
+
+static void
+export_dialog_free (ExportDialog *d)
+{
+  if (d->image)
+    g_object_remove_weak_pointer (G_OBJECT (d->image), (gpointer *) &d->image);
+  g_free (d);
+}
+
+GtkWidget *
+chopgimp_artboards_export_dialog (GimpImage   *image,
+                                  GimpContext *context,
+                                  GtkWidget   *parent)
+{
+  ExportDialog *d = g_new0 (ExportDialog, 1);
+  GtkWidget    *dialog, *grid, *w;
+  GFile        *file;
+  gchar        *base;
+  gint          row = 0;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  d->image   = image;
+  d->context = context;
+  g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &d->image);
+
+  dialog = gimp_dialog_new (_("Exporter les plans de travail"),
+                            "chopgimp-export-artboards",
+                            parent, 0,
+                            gimp_standard_help_func, GIMP_HELP_FILE_EXPORT_AS,
+                            _("_Annuler"),  GTK_RESPONSE_CANCEL,
+                            _("_Exporter"), GTK_RESPONSE_OK,
+                            NULL);
+  gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_OK);
+  g_object_set_data_full (G_OBJECT (dialog), "chopgimp-export", d,
+                          (GDestroyNotify) export_dialog_free);
+  g_signal_connect (dialog, "response", G_CALLBACK (export_response), d);
+
+  grid = gtk_grid_new ();
+  gtk_grid_set_row_spacing (GTK_GRID (grid), 6);
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 8);
+  gtk_container_set_border_width (GTK_CONTAINER (grid), 12);
+  gtk_box_pack_start (GTK_BOX (gtk_dialog_get_content_area (GTK_DIALOG (dialog))),
+                      grid, TRUE, TRUE, 0);
+
+  /*  folder: the one of the image  */
+  d->folder = gtk_file_chooser_button_new (_("Dossier d'exportation"),
+                                           GTK_FILE_CHOOSER_ACTION_SELECT_FOLDER);
+  file = gimp_image_get_any_file (image);
+  if (file)
+    {
+      GFile *dir = g_file_get_parent (file);
+
+      if (dir)
+        {
+          gtk_file_chooser_set_current_folder_file (GTK_FILE_CHOOSER (d->folder), dir, NULL);
+          g_object_unref (dir);
+        }
+    }
+  else
+    {
+      gtk_file_chooser_set_current_folder (GTK_FILE_CHOOSER (d->folder), g_get_home_dir ());
+    }
+  gimp_grid_attach_aligned (GTK_GRID (grid), 0, row++, _("Dossier :"), 0.0, 0.5,
+                            d->folder, 1);
+
+  d->format = gtk_combo_box_text_new ();
+  for (gint i = 0; i < (gint) G_N_ELEMENTS (formats); i++)
+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (d->format), _(formats[i][1]));
+  gtk_combo_box_set_active (GTK_COMBO_BOX (d->format), 0);
+  gimp_grid_attach_aligned (GTK_GRID (grid), 0, row++, _("Format :"), 0.0, 0.5,
+                            d->format, 1);
+
+  /*  prefix: the image's name  */
+  d->prefix = gtk_entry_new ();
+  base = file ? g_file_get_basename (file) : g_strdup (_("Sans titre"));
+  if (strrchr (base, '.'))
+    *strrchr (base, '.') = '\0';
+  {
+    gchar *prefix = g_strdup_printf ("%s-", base);
+
+    gtk_entry_set_text (GTK_ENTRY (d->prefix), prefix);
+    g_free (prefix);
+  }
+  g_free (base);
+  gimp_grid_attach_aligned (GTK_GRID (grid), 0, row++, _("Préfixe :"), 0.0, 0.5,
+                            d->prefix, 1);
+
+  d->range = gtk_entry_new ();
+  gtk_entry_set_placeholder_text (GTK_ENTRY (d->range), _("Tous (ou : 1-3, 5)"));
+  gimp_grid_attach_aligned (GTK_GRID (grid), 0, row++, _("Plans :"), 0.0, 0.5,
+                            d->range, 1);
+
+  w = gtk_label_new (_("Un fichier par plan de travail : <préfixe><nom du plan>.<format>. "
+                       "Le contenu hors du canevas est transparent (JPEG : aplati)."));
+  gtk_label_set_xalign (GTK_LABEL (w), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (w), TRUE);
+  gimp_label_set_attributes (GTK_LABEL (w), PANGO_ATTR_SCALE, PANGO_SCALE_SMALL, -1);
+  gtk_grid_attach (GTK_GRID (grid), w, 0, row++, 2, 1);
+
+  gtk_widget_show_all (dialog);
+
+  return dialog;
+}
+
+
+/*  ─── construction ──────────────────────────────────────────────────── */
+
+static void
+panel_free (Panel *p)
+{
+  panel_set_image (p, NULL);
+
+  if (p->idle_id)
+    g_source_remove (p->idle_id);
+  p->idle_id = 0;
+
+  g_signal_handlers_disconnect_by_data (p->context, p);
+  g_free (p);
+}
+
+static GtkWidget *
+add_button (Panel       *p,
+            const gchar *icon,
+            const gchar *tip,
+            GCallback    callback)
+{
+  GtkWidget *b = gimp_editor_add_button (GIMP_EDITOR (p->editor), icon, tip, NULL,
+                                         NULL, NULL, NULL);
+
+  g_signal_connect (b, "clicked", callback, p);
+
+  return b;
+}
+
+GtkWidget *
+chopgimp_artboards_panel_new (GimpDialogFactory *factory,
+                              GimpContext       *context,
+                              GimpUIManager     *ui_manager,
+                              gint               view_size)
+{
+  Panel     *p      = g_new0 (Panel, 1);
+  GtkWidget *editor = g_object_new (GIMP_TYPE_EDITOR, NULL);
+  GtkWidget *box    = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  GtkWidget *scrolled;
+
+  p->gimp    = context->gimp;
+  p->editor  = editor;
+  p->context = gimp_get_user_context (context->gimp);
+
+  gtk_container_set_border_width (GTK_CONTAINER (box), 6);
+  gtk_box_pack_start (GTK_BOX (editor), box, TRUE, TRUE, 0);
+
+  g_object_set_data_full (G_OBJECT (editor), "chopgimp-panel", p,
+                          (GDestroyNotify) panel_free);
+
+  p->empty = gtk_label_new (_("Aucun plan de travail. Outil Plan de travail (Maj+O) : "
+                              "faites glisser sur le canevas, ou « Nouveau »."));
+  gtk_label_set_line_wrap (GTK_LABEL (p->empty), TRUE);
+  gtk_label_set_xalign (GTK_LABEL (p->empty), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (p->empty), "dim-label");
+  gtk_box_pack_start (GTK_BOX (box), p->empty, FALSE, FALSE, 0);
+  gtk_widget_set_no_show_all (p->empty, TRUE);
+
+  scrolled = gtk_scrolled_window_new (NULL, NULL);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled),
+                                  GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_box_pack_start (GTK_BOX (box), scrolled, TRUE, TRUE, 0);
+
+  p->list = gtk_list_box_new ();
+  gtk_list_box_set_selection_mode (GTK_LIST_BOX (p->list), GTK_SELECTION_SINGLE);
+  gtk_list_box_set_activate_on_single_click (GTK_LIST_BOX (p->list), FALSE);
+  g_signal_connect (p->list, "row-selected", G_CALLBACK (row_selected), p);
+  g_signal_connect (p->list, "row-activated", G_CALLBACK (row_activated), p);
+  gtk_container_add (GTK_CONTAINER (scrolled), p->list);
+
+  gtk_widget_show_all (box);
+
+  p->buttons[B_NEW]      = add_button (p, GIMP_ICON_DOCUMENT_NEW,
+                                       _("Nouveau plan de travail (à droite des autres)"),
+                                       G_CALLBACK (new_clicked));
+  p->buttons[B_DUP]      = add_button (p, GIMP_ICON_OBJECT_DUPLICATE,
+                                       _("Dupliquer le plan de travail"),
+                                       G_CALLBACK (dup_clicked));
+  p->buttons[B_DEL]      = add_button (p, GIMP_ICON_EDIT_DELETE,
+                                       _("Supprimer le plan de travail"),
+                                       G_CALLBACK (delete_clicked));
+  p->buttons[B_UP]       = add_button (p, GIMP_ICON_GO_UP,
+                                       _("Monter (ordre des pages et de l'exportation)"),
+                                       G_CALLBACK (up_clicked));
+  p->buttons[B_DOWN]     = add_button (p, GIMP_ICON_GO_DOWN,
+                                       _("Descendre"),
+                                       G_CALLBACK (down_clicked));
+  p->buttons[B_RENAME]   = add_button (p, GIMP_ICON_EDIT,
+                                       _("Renommer (double-clic)"),
+                                       G_CALLBACK (rename_clicked));
+  p->buttons[B_SHOW]     = add_button (p, GIMP_ICON_ZOOM_FIT_BEST,
+                                       _("Afficher le plan de travail dans la fenêtre"),
+                                       G_CALLBACK (show_clicked));
+  p->buttons[B_FROM_SEL] = add_button (p, GIMP_ICON_SELECTION,
+                                       _("Plan de travail d'après la sélection (sinon les "
+                                         "calques sélectionnés)"),
+                                       G_CALLBACK (from_selection_clicked));
+  p->buttons[B_FIT]      = add_button (p, GIMP_ICON_IMAGE,
+                                       _("Agrandir le canevas pour contenir tous les plans"),
+                                       G_CALLBACK (fit_clicked));
+  p->buttons[B_EXPORT]   = add_button (p, GIMP_ICON_DOCUMENT_SAVE_AS,
+                                       _("Exporter les plans de travail…"),
+                                       G_CALLBACK (export_clicked));
+
+  g_signal_connect (p->context, "image-changed",
+                    G_CALLBACK (panel_image_changed), p);
+
+  panel_set_image (p, gimp_context_get_image (p->context));
+  panel_refresh (p);
+
+  return editor;
+}
