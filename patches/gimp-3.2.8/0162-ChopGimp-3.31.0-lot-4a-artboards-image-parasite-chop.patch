+enum
+{
+  GP_PROP_0,
+  GP_PROP_TYPE,
+  GP_PROP_CELL,
+  GP_PROP_EXTENT_L,
+  GP_PROP_EXTENT_R,
+  GP_PROP_HEIGHT,
+  GP_PROP_OPACITY,
+  GP_PROP_SNAP,
+  GP_PROP_LOCKED,
+  GP_PROP_LOCK_STATION,
+  GP_PROP_COLOR_LEFT,
+  GP_PROP_COLOR_RIGHT,
+  GP_PROP_COLOR_FLOOR
+};
+
+typedef struct
+{
+  GimpToolOptions parent_instance;
+
+  gint            type;
+  gdouble         cell;
+  gint            extent_l;
+  gint            extent_r;
+  gint            height;
+  gdouble         opacity;      /* % */
+  gboolean        snap;
+  gboolean        locked;
+  gboolean        lock_station;
+  GeglColor      *color[4];     /* index: ChopGimpPlane */
+} GimpPGridOptions;
+
+typedef GimpToolOptionsClass GimpPGridOptionsClass;
+
+static GType gimp_pgrid_options_get_type (void) G_GNUC_CONST;
+
+G_DEFINE_TYPE (GimpPGridOptions, gimp_pgrid_options, GIMP_TYPE_TOOL_OPTIONS)
+
+#define GIMP_TYPE_PGRID_OPTIONS (gimp_pgrid_options_get_type ())
+#define PGRID_OPTIONS(tool)     ((GimpPGridOptions *) gimp_tool_get_options (GIMP_TOOL (tool)))
+
+static void
+gimp_pgrid_options_set_property (GObject      *object,
+                                 guint         property_id,
+                                 const GValue *value,
+                                 GParamSpec   *pspec)
+{
+  GimpPGridOptions *o = (GimpPGridOptions *) object;
+  gint              c = -1;
+
+  switch (property_id)
+    {
+    case GP_PROP_TYPE:         o->type         = g_value_get_int     (value); break;
+    case GP_PROP_CELL:         o->cell         = g_value_get_double  (value); break;
+    case GP_PROP_EXTENT_L:     o->extent_l     = g_value_get_int     (value); break;
+    case GP_PROP_EXTENT_R:     o->extent_r     = g_value_get_int     (value); break;
+    case GP_PROP_HEIGHT:       o->height       = g_value_get_int     (value); break;
+    case GP_PROP_OPACITY:      o->opacity      = g_value_get_double  (value); break;
+    case GP_PROP_SNAP:         o->snap         = g_value_get_boolean (value); break;
+    case GP_PROP_LOCKED:       o->locked       = g_value_get_boolean (value); break;
+    case GP_PROP_LOCK_STATION: o->lock_station = g_value_get_boolean (value); break;
+    case GP_PROP_COLOR_LEFT:   c = CHOPGIMP_PLANE_LEFT;  break;
+    case GP_PROP_COLOR_RIGHT:  c = CHOPGIMP_PLANE_RIGHT; break;
+    case GP_PROP_COLOR_FLOOR:  c = CHOPGIMP_PLANE_FLOOR; break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+
+  if (c > 0)
+    {
+      g_clear_object (&o->color[c]);
+      o->color[c] = gegl_color_duplicate (g_value_get_object (value));
+    }
+}
+
+static void
+gimp_pgrid_options_get_property (GObject    *object,
+                                 guint       property_id,
+                                 GValue     *value,
+                                 GParamSpec *pspec)
+{
+  GimpPGridOptions *o = (GimpPGridOptions *) object;
+
+  switch (property_id)
+    {
+    case GP_PROP_TYPE:         g_value_set_int     (value, o->type);         break;
+    case GP_PROP_CELL:         g_value_set_double  (value, o->cell);         break;
+    case GP_PROP_EXTENT_L:     g_value_set_int     (value, o->extent_l);     break;
+    case GP_PROP_EXTENT_R:     g_value_set_int     (value, o->extent_r);     break;
+    case GP_PROP_HEIGHT:       g_value_set_int     (value, o->height);       break;
+    case GP_PROP_OPACITY:      g_value_set_double  (value, o->opacity);      break;
+    case GP_PROP_SNAP:         g_value_set_boolean (value, o->snap);         break;
+    case GP_PROP_LOCKED:       g_value_set_boolean (value, o->locked);       break;
+    case GP_PROP_LOCK_STATION: g_value_set_boolean (value, o->lock_station); break;
+    case GP_PROP_COLOR_LEFT:   g_value_set_object  (value, o->color[CHOPGIMP_PLANE_LEFT]);  break;
+    case GP_PROP_COLOR_RIGHT:  g_value_set_object  (value, o->color[CHOPGIMP_PLANE_RIGHT]); break;
+    case GP_PROP_COLOR_FLOOR:  g_value_set_object  (value, o->color[CHOPGIMP_PLANE_FLOOR]); break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_pgrid_options_finalize (GObject *object)
+{
+  GimpPGridOptions *o = (GimpPGridOptions *) object;
+
+  for (gint i = 0; i < 4; i++)
+    g_clear_object (&o->color[i]);
+
+  G_OBJECT_CLASS (gimp_pgrid_options_parent_class)->finalize (object);
+}
+
+static GeglColor *
+rgb_color (guint32 rgb)
+{
+  GeglColor *c = gegl_color_new (NULL);
+
+  gegl_color_set_rgba (c,
+                       ((rgb >> 16) & 0xff) / 255.0,
+                       ((rgb >>  8) & 0xff) / 255.0,
+                       ( rgb        & 0xff) / 255.0,
+                       1.0);
+  return c;
+}
+
+static guint32
+color_rgb (GeglColor *c)
+{
+  gdouble r = 0.5, g = 0.5, b = 0.5, a;
+
+  if (c)
+    gegl_color_get_rgba (c, &r, &g, &b, &a);
+
+  return (((guint32) CLAMP (RINT (r * 255), 0, 255)) << 16) |
+         (((guint32) CLAMP (RINT (g * 255), 0, 255)) << 8)  |
+          ((guint32) CLAMP (RINT (b * 255), 0, 255));
+}
