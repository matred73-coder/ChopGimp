+/*  the plane switching widget and the keys 1 2 3 4 (Illustrator)  */
+static gboolean
+pgrid_widget_press (GimpDisplay      *display,
+                    const GimpCoords *coords)
+{
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  GimpImage        *image = gimp_display_get_image (display);
+  gdouble           sx, sy;
+  gint              plane;
+
+  gimp_display_shell_transform_xy_f (shell, coords->x, coords->y, &sx, &sy);
+  plane = chopgimp_pgrid_widget_hit (shell, sx, sy);
+
+  if (plane < 0)
+    return FALSE;
+
+  chopgimp_pgrid_set_active_plane (image, plane);
+
+  return TRUE;
+}
+
+static gboolean
+pgrid_plane_key (GimpDisplay *display,
+                 guint        keyval)
+{
+  GimpImage     *image = gimp_display_get_image (display);
+  ChopGimpPGrid  grid;
+  gint           plane;
+
+  switch (keyval)
+    {
+    case GDK_KEY_1: case GDK_KEY_KP_1: plane = CHOPGIMP_PLANE_LEFT;  break;
+    case GDK_KEY_2: case GDK_KEY_KP_2: plane = CHOPGIMP_PLANE_FLOOR; break;
+    case GDK_KEY_3: case GDK_KEY_KP_3: plane = CHOPGIMP_PLANE_RIGHT; break;
+    case GDK_KEY_4: case GDK_KEY_KP_4: plane = CHOPGIMP_PLANE_NONE;  break;
+    default:
+      return FALSE;
+    }
+
+  if (! image || ! chopgimp_pgrid_get (image, &grid) || ! grid.visible)
+    return FALSE;
+
+  chopgimp_pgrid_set_active_plane (image, plane);
+
+  return TRUE;
+}
