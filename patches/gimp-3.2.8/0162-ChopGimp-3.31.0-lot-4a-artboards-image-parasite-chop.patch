+/*  ─── 3.31.0 (lot 4a): artboards and perspective grid ─────────────── */
+
+static GimpValueArray *
+artboards_command_invoker (GimpProcedure         *procedure,
+                           Gimp                  *gimp,
+                           GimpContext           *context,
+                           GimpProgress          *progress,
+                           const GimpValueArray  *args,
+                           GError               **error)
+{
+  GimpImage      *image = ARG_OBJECT (0);
+  const gchar    *cmd   = g_value_get_string (gimp_value_array_index (args, 1));
+  gchar         **v;
+  gint            n;
+  gchar          *out  = NULL;
+  gboolean        done = FALSE;
+  GimpValueArray *return_vals;
+
+  if (! cmd)
+    cmd = "";
+
+  /*  « export|folder|ext|prefix|range »: « | » (paths may hold « : »)  */
+  v = g_strsplit (cmd, g_str_has_prefix (cmd, "export|") ? "|" : ":", 6);
+  n = g_strv_length (v);
+
+  if (n >= 1 && ! strcmp (v[0], "list"))
+    {
+      GArray  *a = chopgimp_artboards_get (image, NULL);
+      GString *s = g_string_new (NULL);
+
+      for (guint i = 0; i < a->len; i++)
+        {
+          ChopGimpArtboard *b = &g_array_index (a, ChopGimpArtboard, i);
+
+          g_string_append_printf (s, "%d %d %d %d %s\n", b->x, b->y, b->width, b->height, b->name);
+        }
+
+      chopgimp_artboards_free (a);
+      out  = g_string_free (s, FALSE);
+      done = TRUE;
+    }
+  else if (n >= 5 && ! strcmp (v[0], "add"))
+    {
+      gint i = chopgimp_artboards_add (image, atoi (v[1]), atoi (v[2]), atoi (v[3]), atoi (v[4]),
+                                       n >= 6 ? v[5] : NULL);
+
+      out  = g_strdup_printf ("%d", i);
+      done = TRUE;
+    }
+  else if (n >= 2 && ! strcmp (v[0], "remove"))
+    {
+      done = atoi (v[1]) < chopgimp_artboards_count (image);
+      chopgimp_artboards_remove (image, atoi (v[1]));
+    }
+  else if (n >= 3 && ! strcmp (v[0], "rename"))
+    {
+      chopgimp_artboards_rename (image, atoi (v[1]), v[2]);
+      done = TRUE;
+    }
+  else if (n >= 6 && ! strcmp (v[0], "rect"))
+    {
+      chopgimp_artboards_set_rect (image, atoi (v[1]), atoi (v[2]), atoi (v[3]),
+                                   atoi (v[4]), atoi (v[5]), FALSE);
+      done = TRUE;
+    }
+  else if (n >= 2 && ! strcmp (v[0], "duplicate"))
+    {
+      gint i = chopgimp_artboards_duplicate (image, atoi (v[1]), FALSE, 0, 0);
+
+      out  = g_strdup_printf ("%d", i);
+      done = i >= 0;
+    }
+  else if (n >= 3 && ! strcmp (v[0], "move"))
+    {
+      chopgimp_artboards_move_to (image, atoi (v[1]), atoi (v[2]));
+      done = TRUE;
+    }
+  else if (n >= 1 && ! strcmp (v[0], "active"))
+    {
+      if (n >= 2)
+        chopgimp_artboards_set_active (image, atoi (v[1]));
+      out  = g_strdup_printf ("%d", chopgimp_artboards_get_active (image));
+      done = TRUE;
+    }
+  else if (n >= 3 && ! strcmp (v[0], "find"))
+    {
+      out  = g_strdup_printf ("%d", chopgimp_artboards_find_at (image, g_ascii_strtod (v[1], NULL),
+                                                                 g_ascii_strtod (v[2], NULL)));
+      done = TRUE;
+    }
+  else if (n >= 1 && ! strcmp (v[0], "fit"))
+    {
+      done = chopgimp_artboards_fit_canvas (image, context);
+    }
+  else if (n >= 3 && ! strcmp (v[0], "export"))
+    {
+      GFile    *folder = g_file_new_for_path (v[1]);
+      gint      count  = chopgimp_artboards_count (image);
+      gboolean *sel    = g_new0 (gboolean, MAX (count, 1));
+      gint      written;
+
+      chopgimp_artboards_parse_range (n >= 5 ? v[4] : NULL, count, sel);
+      written = chopgimp_artboards_export (image, context, progress, folder, v[2],
+                                           n >= 4 ? v[3] : "", sel, error);
+      out  = g_strdup_printf ("%d", written);
+      done = written >= 0;
+
+      g_free (sel);
+      g_object_unref (folder);
+    }
+
+  g_strfreev (v);
+  gimp_image_flush (image);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), done);
+  g_value_take_string (gimp_value_array_index (return_vals, 2), out ? out : g_strdup (""));
+
+  return return_vals;
+}
+
+/*  the selected objects of @item when it is a vector layer with some,
+ *  else none (the item itself)
+ */
+static GArray *
+pgrid_objects (GimpItem *item)
+{
+  GArray *ids = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  if (GIMP_IS_VECTOR_LAYER (item) && gimp_item_is_vector_layer (item))
+    {
+      gint         n;
+      const guint *sel = chopgimp_vlayer_get_selection (GIMP_VECTOR_LAYER (item), &n);
+
+      g_array_append_vals (ids, sel, n);
+    }
+
+  return ids;
+}
+
+static GimpValueArray *
+perspective_command_invoker (GimpProcedure         *procedure,
+                             Gimp                  *gimp,
+                             GimpContext           *context,
+                             GimpProgress          *progress,
+                             const GimpValueArray  *args,
+                             GError               **error)
+{
+  GimpImage      *image = ARG_OBJECT (0);
+  GimpItem       *item  = ARG_OBJECT (1);
+  const gchar    *cmd   = g_value_get_string (gimp_value_array_index (args, 2));
+  gchar         **v;
+  gint            n;
+  gchar          *out  = NULL;
+  gboolean        done = FALSE;
+  ChopGimpPGrid   g;
+  GimpValueArray *return_vals;
+
+  if (! cmd)
+    cmd = "";
+
+  v = g_strsplit (cmd, ":", 8);
+  n = g_strv_length (v);
+
+  chopgimp_pgrid_get (image, &g);
+
+  if (n >= 1 && ! strcmp (v[0], "get"))
+    {
+      out  = chopgimp_pgrid_to_string (&g);
+      done = TRUE;
+    }
+  else if (n >= 2 && ! strcmp (v[0], "set"))
+    {
+      /*  « set:key=value;key=value… » (the keys of the parasite)  */
+      gchar *text = g_strdelimit (g_strdup (cmd + 4), ";", '\n');
+
+      chopgimp_pgrid_from_string (&g, text);
+      g_free (text);
+      chopgimp_pgrid_set (image, &g, "Grille de perspective", FALSE);
+      done = TRUE;
+    }
+  else if (n >= 1 && (! strcmp (v[0], "show") || ! strcmp (v[0], "hide")))
+    {
+      g.visible = ! strcmp (v[0], "show");
+      chopgimp_pgrid_set (image, &g, "Grille de perspective", FALSE);
+      done = TRUE;
+    }
+  else if (n >= 2 && ! strcmp (v[0], "type"))
+    {
+      chopgimp_pgrid_set_type (&g, atoi (v[1]),
+                               gimp_image_get_width (image), gimp_image_get_height (image));
+      chopgimp_pgrid_set (image, &g, "Grille de perspective", FALSE);
+      done = TRUE;
+    }
+  else if (n >= 2 && ! strcmp (v[0], "plane"))
+    {
+      chopgimp_pgrid_set_active_plane (image, CLAMP (atoi (v[1]), 0, 3));
+      done = TRUE;
+    }
+  else if (n >= 4 && (! strcmp (v[0], "project") || ! strcmp (v[0], "unproject")))
+    {
+      gdouble a = g_ascii_strtod (v[2], NULL), b = g_ascii_strtod (v[3], NULL);
+      gdouble x, y;
+
+      done = ! strcmp (v[0], "project")
+             ? chopgimp_pgrid_from_plane (&g, atoi (v[1]), a, b, &x, &y)
+             : chopgimp_pgrid_to_plane   (&g, atoi (v[1]), a, b, &x, &y);
+      if (done)
+        out = g_strdup_printf ("%.3f %.3f", x, y);
+    }
+  else if (n >= 1 && ! strcmp (v[0], "item-plane") && item)
+    {
+      out  = g_strdup_printf ("%d", chopgimp_pgrid_item_get_plane (item, n >= 2 ? atoi (v[1]) : 0));
+      done = TRUE;
+    }
+  else if (n >= 1 && (! strcmp (v[0], "attach") || ! strcmp (v[0], "release")) && item)
+    {
+      GArray *ids   = pgrid_objects (item);
+      gint    plane = ! strcmp (v[0], "attach")
+                      ? (n >= 2 ? atoi (v[1]) : (gint) chopgimp_pgrid_get_active_plane (image))
+                      : CHOPGIMP_PLANE_NONE;
+
+      if (ids->len)
+        for (guint i = 0; i < ids->len; i++)
+          chopgimp_pgrid_item_set_plane (item, g_array_index (ids, guint, i), plane, TRUE);
+      else
+        chopgimp_pgrid_item_set_plane (item, 0, plane, TRUE);
+
+      g_array_free (ids, TRUE);
+      done = TRUE;
+    }
+  else if (n >= 5 && ! strcmp (v[0], "drag") && item)
+    {
+      /*  « Sélection de perspective »: drag:x0:y0:x1:y1 (the object or the
+       *  selected objects of @item; placed on the active plane when free)
+       */
+      GArray      *ids   = pgrid_objects (item);
+      guint        first = ids->len ? g_array_index (ids, guint, 0) : 0;
+      gint         plane = chopgimp_pgrid_item_get_plane (item, first);
+      gboolean     place = FALSE;
+      GimpMatrix3  M;
+      gdouble      x0 = g_ascii_strtod (v[1], NULL), y0 = g_ascii_strtod (v[2], NULL);
+      gdouble      x1 = g_ascii_strtod (v[3], NULL), y1 = g_ascii_strtod (v[4], NULL);
+
+      if (plane == CHOPGIMP_PLANE_NONE)
+        {
+          plane = g.visible ? g.active_plane : CHOPGIMP_PLANE_NONE;
+          place = TRUE;
+        }
+
+      if (plane != CHOPGIMP_PLANE_NONE &&
+          (place ? chopgimp_pgrid_place_matrix (&g, plane, x0, y0, x1, y1, g.snap, &M)
+                 : chopgimp_pgrid_move_matrix  (&g, plane, x0, y0, x1, y1, g.snap, &M)))
+        {
+          gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC, "Sélection de perspective");
+
+          if (ids->len)
+            {
+              chopgimp_vlayer_transform (GIMP_VECTOR_LAYER (item), (guint *) ids->data,
+                                         ids->len, &M, TRUE, TRUE);
+              for (guint i = 0; i < ids->len; i++)
+                chopgimp_pgrid_item_set_plane (item, g_array_index (ids, guint, i), plane, TRUE);
+            }
+          else
+            {
+              gimp_item_transform (item, context, &M, GIMP_TRANSFORM_FORWARD,
+                                   gimp->config->interpolation_type,
+                                   GIMP_TRANSFORM_RESIZE_ADJUST, NULL);
+              chopgimp_pgrid_item_set_plane (item, 0, plane, TRUE);
+            }
+
+          gimp_image_undo_group_end (image);
+          done = TRUE;
+        }
+
+      g_array_free (ids, TRUE);
+    }
+  else if (n >= 5 && ! strcmp (v[0], "rect") && item && GIMP_IS_VECTOR_LAYER (item))
+    {
+      /*  a rectangle drawn on the active plane (the shape tool): rect:x0:y0:x1:y1
+       *  in image coordinates, its corners on the plane
+       */
+      gint     plane = chopgimp_pgrid_get_active_plane (image);
+      gdouble  u0, v0, u1, v1;
+
+      if (plane != CHOPGIMP_PLANE_NONE &&
+          chopgimp_pgrid_to_plane (&g, plane, g_ascii_strtod (v[1], NULL),
+                                   g_ascii_strtod (v[2], NULL), &u0, &v0) &&
+          chopgimp_pgrid_to_plane (&g, plane, g_ascii_strtod (v[3], NULL),
+                                   g_ascii_strtod (v[4], NULL), &u1, &v1))
+        {
+          GimpPath        *path = gimp_path_new (image, "Rectangle");
+          GimpStroke      *stroke;
+          GimpCoords       c = GIMP_COORDS_DEFAULT_VALUES;
+          GimpMatrix3      H;
+          ChopGimpVStyle   style;
+          ChopGimpVObject *obj;
+
+          if (g.snap)
+            {
+              chopgimp_pgrid_snap (&g, &u0, &v0, g.cell * 0.2);
+              chopgimp_pgrid_snap (&g, &u1, &v1, g.cell * 0.2);
+            }
+
+          g_object_ref_sink (path);
+          c.x = u0; c.y = v0; stroke = gimp_bezier_stroke_new_moveto (&c);
+          c.x = u1; c.y = v0; gimp_bezier_stroke_lineto (stroke, &c);
+          c.x = u1; c.y = v1; gimp_bezier_stroke_lineto (stroke, &c);
+          c.x = u0; c.y = v1; gimp_bezier_stroke_lineto (stroke, &c);
+          gimp_stroke_close (stroke);
+          gimp_path_stroke_add (path, stroke);
+          g_object_unref (stroke);
+
+          chopgimp_pgrid_plane_matrix (&g, plane, &H);
+          chopgimp_vpath_transform (path, &H);
+
+          memset (&style, 0, sizeof (style));
+          chopgimp_vobjects_style_from_tool (&style, image, TRUE, NULL, FALSE, NULL);
+          obj = chopgimp_vobjects_add_path (GIMP_VECTOR_LAYER (item), path, "Rectangle", &style);
+          chopgimp_vstyle_clear (&style);
+          g_object_unref (path);
+
+          if (obj)
+            {
+              chopgimp_pgrid_item_set_plane (item, obj->id, plane, FALSE);
+              out  = g_strdup_printf ("%u", obj->id);
+              done = TRUE;
+            }
+        }
+    }
+
+  g_strfreev (v);
+  gimp_image_flush (image);
+
+  return_vals = gimp_procedure_get_return_values (procedure, TRUE, NULL);
+  g_value_set_boolean (gimp_value_array_index (return_vals, 1), done);
+  g_value_take_string (gimp_value_array_index (return_vals, 2), out ? out : g_strdup (""));
+
+  return return_vals;
+}
+
 static GimpProcedure *
 chopgimp_procedure (GimpPDB          *pdb,
                     GimpMarshalFunc   invoker,
@@ -1973,4 +2324,49 @@ register_chopgimp_procs (GimpPDB *pdb)
                                                               GIMP_PARAM_READWRITE));
   gimp_pdb_register_procedure (pdb, p);
   g_object_unref (p);
+
+  /*  3.31.0 (lot 4a)  */
+  p = chopgimp_procedure (pdb, artboards_command_invoker, "chopgimp-artboards-command",
+                          "Artboards of @image (see app/core/chopgimp-artboards.h): « list » "
+                          "(one line per artboard: « x y width height name », in their "
+                          "order), « add:x:y:w:h[:name] », « remove:i », « rename:i:name », "
+                          "« rect:i:x:y:w:h », « duplicate:i », « move:i:j », « active[:i] », "
+                          "« find:x:y », « fit » (the canvas grows to hold them), "
+                          "« export|folder|ext|prefix|range » (one file per artboard, "
+                          "returns the number written). Indexes from 0.");
+  gimp_procedure_add_argument (p, gimp_param_spec_image ("image", "image", "The image",
+                                                         FALSE, GIMP_PARAM_READWRITE));
+  gimp_procedure_add_argument (p, gimp_param_spec_string ("command", "command", "The command",
+                                                          FALSE, FALSE, FALSE, NULL,
+                                                          GIMP_PARAM_READWRITE));
+  gimp_procedure_add_return_value (p, g_param_spec_boolean ("done", "done", "Done",
+                                                            FALSE, GIMP_PARAM_READWRITE));
+  gimp_procedure_add_return_value (p, gimp_param_spec_string ("result", "result", "The result",
+                                                              FALSE, TRUE, FALSE, NULL,
+                                                              GIMP_PARAM_READWRITE));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
+
+  p = chopgimp_procedure (pdb, perspective_command_invoker, "chopgimp-perspective-command",
+                          "Perspective grid of @image (see app/core/chopgimp-pgrid.h): « get », "
+                          "« set:key=value;… », « show », « hide », « type:1|2|3 », "
+                          "« plane:0..3 » (none, left, right, horizontal), « project:plane:u:v », "
+                          "« unproject:plane:x:y »; on @item: « item-plane[:id] », "
+                          "« attach[:plane] », « release », « drag:x0:y0:x1:y1 » (the "
+                          "perspective selection tool), « rect:x0:y0:x1:y1 » (a rectangle "
+                          "drawn on the active plane, in the vector layer @item).");
+  gimp_procedure_add_argument (p, gimp_param_spec_image ("image", "image", "The image",
+                                                         FALSE, GIMP_PARAM_READWRITE));
+  gimp_procedure_add_argument (p, gimp_param_spec_item ("item", "item", "A layer (or none)",
+                                                        TRUE, GIMP_PARAM_READWRITE));
+  gimp_procedure_add_argument (p, gimp_param_spec_string ("command", "command", "The command",
+                                                          FALSE, FALSE, FALSE, NULL,
+                                                          GIMP_PARAM_READWRITE));
+  gimp_procedure_add_return_value (p, g_param_spec_boolean ("done", "done", "Done",
+                                                            FALSE, GIMP_PARAM_READWRITE));
+  gimp_procedure_add_return_value (p, gimp_param_spec_string ("result", "result", "The result",
+                                                              FALSE, TRUE, FALSE, NULL,
+                                                              GIMP_PARAM_READWRITE));
+  gimp_pdb_register_procedure (pdb, p);
+  g_object_unref (p);
 }
