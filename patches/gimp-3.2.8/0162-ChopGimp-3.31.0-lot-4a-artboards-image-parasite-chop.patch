+
+/*  ─── the tool ──────────────────────────────────────────────────────── */
+
+typedef enum
+{
+  AB_NONE,
+  AB_CREATE,
+  AB_MOVE,
+  AB_RESIZE
+} AbMode;
+
+typedef struct
+{
+  GimpDrawTool  parent_instance;
+
+  AbMode        mode;
+  gint          index;          /* the artboard dragged            */
+  gint          handle;         /* 0..7: NW N NE E SE S SW W       */
+  gdouble       sx, sy;         /* press                           */
+  gdouble       cx, cy;         /* pointer                         */
+  gint          ox, oy, ow, oh; /* rectangle at the press          */
+  gint          rx, ry, rw, rh; /* current rectangle               */
+  gboolean      copy;           /* Alt                             */
+  gboolean      constrain;      /* Maj                             */
+
+  gint          hover_index;
+  gint          hover_handle;
+} GimpArtboardTool;
+
+typedef struct
+{
+  GimpDrawToolClass parent_class;
+} GimpArtboardToolClass;
+
+static GType gimp_artboard_tool_get_type (void) G_GNUC_CONST;
+
+G_DEFINE_TYPE (GimpArtboardTool, gimp_artboard_tool, GIMP_TYPE_DRAW_TOOL)
+
+
+static void
+handle_pos (gint     x,
+            gint     y,
+            gint     w,
+            gint     h,
+            gint     handle,
+            gdouble *hx,
+            gdouble *hy)
+{
+  static const gdouble fx[8] = { 0, 0.5, 1, 1, 1, 0.5, 0, 0 };
+  static const gdouble fy[8] = { 0, 0, 0, 0.5, 1, 1, 1, 0.5 };
+
+  *hx = x + fx[handle] * w;
+  *hy = y + fy[handle] * h;
+}
+
+/*  the handle of the active artboard under the pointer, else -1  */
+static gint
+hit_handle (GimpArtboardTool *at,
+            GimpDisplay      *display,
+            gdouble           x,
+            gdouble           y,
+            gint             *index)
+{
+  GimpImage        *image = gimp_display_get_image (display);
+  gint              active;
+  GArray           *a;
+  gint              result = -1;
+
+  *index = -1;
+
+  if (! image)
+    return -1;
+
+  a = chopgimp_artboards_get (image, &active);
+
+  if (active >= 0 && active < (gint) a->len)
+    {
+      ChopGimpArtboard *b = &g_array_index (a, ChopGimpArtboard, active);
+
+      for (gint k = 0; k < 8 && result < 0; k++)
+        {
+          gdouble hx, hy;
+
+          handle_pos (b->x, b->y, b->width, b->height, k, &hx, &hy);
+
+          if (gimp_draw_tool_on_handle (GIMP_DRAW_TOOL (at), display, x, y,
+                                        GIMP_HANDLE_SQUARE, hx, hy,
+                                        HANDLE_SIZE + 4, HANDLE_SIZE + 4,
+                                        GIMP_HANDLE_ANCHOR_CENTER))
+            {
+              result = k;
+              *index = active;
+            }
+        }
+    }
+
+  chopgimp_artboards_free (a);
+
+  return result;
+}
+
+static void
+update_rect (GimpArtboardTool *at)
+{
+  gdouble dx = at->cx - at->sx;
+  gdouble dy = at->cy - at->sy;
+
+  switch (at->mode)
+    {
+    case AB_CREATE:
+      at->rx = (gint) RINT (MIN (at->sx, at->cx));
+      at->ry = (gint) RINT (MIN (at->sy, at->cy));
+      at->rw = (gint) RINT (fabs (dx));
+      at->rh = (gint) RINT (fabs (dy));
+      if (at->constrain)
+        at->rw = at->rh = MAX (at->rw, at->rh);
+      break;
+
+    case AB_MOVE:
+      at->rx = at->ox + (gint) RINT (dx);
+      at->ry = at->oy + (gint) RINT (dy);
+      at->rw = at->ow;
+      at->rh = at->oh;
+      break;
+
+    case AB_RESIZE:
+      {
+        gdouble x1 = at->ox, y1 = at->oy;
+        gdouble x2 = at->ox + at->ow, y2 = at->oy + at->oh;
+        gint    h  = at->handle;
+
+        if (h == 0 || h == 6 || h == 7) x1 += dx;
+        if (h == 2 || h == 3 || h == 4) x2 += dx;
+        if (h == 0 || h == 1 || h == 2) y1 += dy;
+        if (h == 4 || h == 5 || h == 6) y2 += dy;
+
+        if (at->constrain && at->ow > 0 && at->oh > 0 && (h % 2) == 0)
+          {
+            gdouble ratio = (gdouble) at->ow / at->oh;
+            gdouble w     = fabs (x2 - x1);
+            gdouble hh    = fabs (y2 - y1);
+
+            if (w / MAX (hh, 1) > ratio)
+              hh = w / ratio;
+            else
+              w = hh * ratio;
+
+            if (h == 0 || h == 6) x1 = x2 - w; else x2 = x1 + w;
+            if (h == 0 || h == 2) y1 = y2 - hh; else y2 = y1 + hh;
+          }
+
+        at->rx = (gint) RINT (MIN (x1, x2));
+        at->ry = (gint) RINT (MIN (y1, y2));
+        at->rw = MAX (1, (gint) RINT (fabs (x2 - x1)));
+        at->rh = MAX (1, (gint) RINT (fabs (y2 - y1)));
+      }
+      break;
+
+    default:
+      break;
+    }
+}
+
+/*  the content inside the artboard follows (or is copied with) it  */
+static void
+move_artwork (GimpImage *image,
+              gint       x,
+              gint       y,
+              gint       w,
+              gint       h,
+              gint       dx,
+              gint       dy,
+              gboolean   copy)
+{
+  GList *layers = gimp_image_get_layer_list (image);
+
+  for (GList *l = layers; l; l = l->next)
+    {
+      GimpItem *item = l->data;
+      gint      ix, iy;
+
+      if (gimp_viewable_get_parent (GIMP_VIEWABLE (item)))
+        continue;   /* groups move with their children */
+
+      if (gimp_item_is_vector_layer (item))
+        {
+          GimpVectorLayer *vl   = GIMP_VECTOR_LAYER (item);
+          GList           *objs = chopgimp_vlayer_objects_in_rect (vl, x, y, w, h, FALSE);
+          GArray          *ids  = g_array_new (FALSE, FALSE, sizeof (guint));
+
+          for (GList *o = objs; o; o = o->next)
+            {
+              ChopGimpVObject *obj = o->data;
+
+              /*  top-level objects only (groups carry their children)  */
+              if (! obj->parent || ! obj->parent->parent)
+                g_array_append_val (ids, obj->id);
+            }
+
+          if (ids->len && ! copy)
+            chopgimp_vlayer_translate (vl, (guint *) ids->data, ids->len, dx, dy, TRUE);
+
+          g_array_free (ids, TRUE);
+          g_list_free (objs);
+          continue;
+        }
+
+      gimp_item_get_offset (item, &ix, &iy);
+
+      if (ix >= x && iy >= y &&
+          ix + gimp_item_get_width (item)  <= x + w &&
+          iy + gimp_item_get_height (item) <= y + h)
+        {
+          if (copy)
+            {
+              GimpItem *dup = gimp_item_duplicate (item, G_TYPE_FROM_INSTANCE (item));
+
+              gimp_image_add_layer (image, GIMP_LAYER (dup), NULL,
+                                    gimp_item_get_index (item), TRUE);
+              item = dup;
+            }
+
+          gimp_item_translate (item, dx, dy, TRUE);
+        }
+    }
+
+  g_list_free (layers);
+}
+
+static void
+commit (GimpArtboardTool *at,
+        GimpDisplay      *display)
+{
+  GimpArtboardOptions *o     = ARTBOARD_OPTIONS (at);
+  GimpImage           *image = gimp_display_get_image (display);
+  Gimp                *gimp  = image->gimp;
+
+  switch (at->mode)
+    {
+    case AB_CREATE:
+      if (at->rw < 2 || at->rh < 2)
+        {
+          /*  a click: the artboard under it becomes active  */
+          gint i = chopgimp_artboards_find_at (image, at->sx, at->sy);
+
+          if (i >= 0)
+            chopgimp_artboards_set_active (image, i);
+          return;
+        }
+
+      gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC, _("Nouveau plan de travail"));
+      chopgimp_artboards_add (image, at->rx, at->ry, at->rw, at->rh, NULL);
+      break;
+
+    case AB_MOVE:
+      if (at->rx == at->ox && at->ry == at->oy && ! at->copy)
+        return;
+
+      gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC,
+                                   at->copy ? _("Dupliquer le plan de travail")
+                                            : _("Déplacer le plan de travail"));
+      if (o->move_artwork)
+        move_artwork (image, at->ox, at->oy, at->ow, at->oh,
+                      at->rx - at->ox, at->ry - at->oy, at->copy);
+
+      if (at->copy)
+        chopgimp_artboards_duplicate (image, at->index, TRUE, at->rx, at->ry);
+      else
+        chopgimp_artboards_set_rect (image, at->index, at->rx, at->ry, at->rw, at->rh, FALSE);
+      break;
+
+    case AB_RESIZE:
+      gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC, _("Redimensionner le plan de travail"));
+      chopgimp_artboards_set_rect (image, at->index, at->rx, at->ry, at->rw, at->rh, FALSE);
+      break;
+
+    default:
+      return;
+    }
+
+  if (o->fit_canvas)
+    chopgimp_artboards_fit_canvas (image, gimp_get_user_context (gimp));
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+}
+
+static void
+rename_callback (GtkWidget   *query_box,
+                 const gchar *string,
+                 gpointer     data)
+{
+  GimpImage *image = g_object_get_data (G_OBJECT (query_box), "chopgimp-image");
+  gint       index = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (query_box), "chopgimp-index"));
+
+  if (image && string && *string)
+    {
+      chopgimp_artboards_rename (image, index, string);
+      gimp_image_flush (image);
+    }
+}
+
+static void
+rename_dialog (GimpDisplay *display,
+               gint         index)
+{
+  GimpImage        *image = gimp_display_get_image (display);
+  ChopGimpArtboard  b;
+  GtkWidget        *box;
+
+  if (! chopgimp_artboards_get_nth (image, index, &b))
+    return;
+
+  box = gimp_query_string_box (_("Renommer le plan de travail"),
+                               GTK_WIDGET (gimp_display_get_shell (display)),
+                               gimp_standard_help_func, GIMP_HELP_TOOL_CROP,
+                               _("Nom du plan de travail :"),
+                               b.name,
+                               G_OBJECT (image), "disconnect",
+                               rename_callback, NULL, NULL);
+  g_object_set_data (G_OBJECT (box), "chopgimp-image", image);
+  g_object_set_data (G_OBJECT (box), "chopgimp-index", GINT_TO_POINTER (index));
+  gtk_widget_show (box);
+
+  g_free (b.name);
+}
+
+static void
+gimp_artboard_tool_button_press (GimpTool            *tool,
+                                 const GimpCoords    *coords,
+                                 guint32              time,
+                                 GdkModifierType      state,
+                                 GimpButtonPressType  press_type,
+                                 GimpDisplay         *display)
+{
+  GimpArtboardTool *at    = (GimpArtboardTool *) tool;
+  GimpImage        *image = gimp_display_get_image (display);
+  ChopGimpArtboard  b;
+  gint              index;
+  gint              handle;
+
+  if (! image)
+    return;
+
+  if (tool->display && tool->display != display &&
+      gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+  tool->display = display;
+
+  if (press_type == GIMP_BUTTON_PRESS_DOUBLE)
+    {
+      index = chopgimp_artboards_find_at (image, coords->x, coords->y);
+
+      if (index >= 0)
+        rename_dialog (display, index);
+
+      return;
+    }
+
+  if (press_type != GIMP_BUTTON_PRESS_NORMAL)
+    return;
+
+  at->sx = at->cx = coords->x;
+  at->sy = at->cy = coords->y;
+  at->copy      = (state & GDK_MOD1_MASK) != 0;
+  at->constrain = (state & gimp_get_extend_selection_mask ()) != 0;
+
+  handle = hit_handle (at, display, coords->x, coords->y, &index);
+
+  if (handle >= 0)
+    {
+      at->mode   = AB_RESIZE;
+      at->handle = handle;
+    }
+  else if ((index = chopgimp_artboards_find_at (image, coords->x, coords->y)) >= 0)
+    {
+      at->mode = AB_MOVE;
+      chopgimp_artboards_set_active (image, index);
+    }
+  else
+    {
+      at->mode = AB_CREATE;
+    }
+
+  at->index = index;
+
+  if (index >= 0 && chopgimp_artboards_get_nth (image, index, &b))
+    {
+      at->ox = b.x; at->oy = b.y; at->ow = b.width; at->oh = b.height;
+      g_free (b.name);
+    }
+
+  update_rect (at);
+
+  if (at->mode != AB_CREATE && ! at->copy)
+    chopgimp_canvas_artboards_set_hidden (gimp_display_get_shell (display), index);
+
+  gimp_tool_control_activate (tool->control);
+
+  if (! gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    gimp_draw_tool_start (GIMP_DRAW_TOOL (tool), display);
+  else
+    chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (tool), display);
+}
+
+static void
+gimp_artboard_tool_motion (GimpTool         *tool,
+                           const GimpCoords *coords,
+                           guint32           time,
+                           GdkModifierType   state,
+                           GimpDisplay      *display)
+{
+  GimpArtboardTool *at = (GimpArtboardTool *) tool;
+
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  at->cx        = coords->x;
+  at->cy        = coords->y;
+  at->constrain = (state & gimp_get_extend_selection_mask ()) != 0;
+  update_rect (at);
+
+  gimp_tool_pop_status (tool, display);
+  gimp_tool_push_status (tool, display, "%d × %d px  (%d, %d)", at->rw, at->rh, at->rx, at->ry);
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_artboard_tool_button_release (GimpTool              *tool,
+                                   const GimpCoords      *coords,
+                                   guint32                time,
+                                   GdkModifierType        state,
+                                   GimpButtonReleaseType  release_type,
+                                   GimpDisplay           *display)
+{
+  GimpArtboardTool *at = (GimpArtboardTool *) tool;
+
+  gimp_tool_control_halt (tool->control);
+  gimp_tool_pop_status (tool, display);
+  gimp_draw_tool_pause (GIMP_DRAW_TOOL (tool));
+
+  chopgimp_canvas_artboards_set_hidden (gimp_display_get_shell (display), -1);
+
+  if (release_type != GIMP_BUTTON_RELEASE_CANCEL)
+    commit (at, display);
+
+  at->mode = AB_NONE;
+
+  gimp_draw_tool_resume (GIMP_DRAW_TOOL (tool));
+}
+
+static void
+gimp_artboard_tool_oper_update (GimpTool         *tool,
+                                const GimpCoords *coords,
+                                GdkModifierType   state,
+                                gboolean          proximity,
+                                GimpDisplay      *display)
+{
+  GimpArtboardTool *at    = (GimpArtboardTool *) tool;
+  GimpImage        *image = gimp_display_get_image (display);
+  gint              index;
+
+  if (! image || ! proximity)
+    return;
+
+  at->hover_handle = hit_handle (at, display, coords->x, coords->y, &index);
+  at->hover_index  = at->hover_handle >= 0 ? index
+                                           : chopgimp_artboards_find_at (image, coords->x, coords->y);
+
+  if (at->hover_handle >= 0)
+    gimp_tool_replace_status (tool, display, "%s",
+                              _("Redimensionner le plan de travail (Maj : proportions)"));
+  else if (at->hover_index >= 0)
+    gimp_tool_replace_status (tool, display, "%s",
+                              _("Déplacer le plan de travail (Alt : copier ; "
+                                "double-clic : renommer)"));
+  else
+    gimp_tool_replace_status (tool, display, "%s",
+                              _("Faites glisser pour créer un plan de travail"));
+
+  if (! gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+    {
+      tool->display = display;
+      gimp_draw_tool_start (GIMP_DRAW_TOOL (tool), display);
+    }
+  else
+    {
+      chopgimp_draw_tool_redraw (GIMP_DRAW_TOOL (tool), display);
+    }
+}
+
+static void
+gimp_artboard_tool_cursor_update (GimpTool         *tool,
+                                  const GimpCoords *coords,
+                                  GdkModifierType   state,
+                                  GimpDisplay      *display)
+{
+  static const GimpCursorType cursors[8] =
+    {
+      GIMP_CURSOR_CORNER_TOP_LEFT,     GIMP_CURSOR_SIDE_TOP,
+      GIMP_CURSOR_CORNER_TOP_RIGHT,    GIMP_CURSOR_SIDE_RIGHT,
+      GIMP_CURSOR_CORNER_BOTTOM_RIGHT, GIMP_CURSOR_SIDE_BOTTOM,
+      GIMP_CURSOR_CORNER_BOTTOM_LEFT,  GIMP_CURSOR_SIDE_LEFT
+    };
+  GimpArtboardTool *at     = (GimpArtboardTool *) tool;
+  GimpCursorType    cursor = GIMP_CURSOR_CROSSHAIR_SMALL;
+
+  if (at->hover_handle >= 0 && at->hover_handle < 8)
+    cursor = cursors[at->hover_handle];
+  else if (at->hover_index >= 0)
+    cursor = GIMP_CURSOR_MOVE;
+
+  gimp_tool_control_set_cursor (tool->control, cursor);
+
+  GIMP_TOOL_CLASS (gimp_artboard_tool_parent_class)->cursor_update (tool, coords, state, display);
+}
+
+static gboolean
+gimp_artboard_tool_key_press (GimpTool    *tool,
+                              GdkEventKey *kevent,
+                              GimpDisplay *display)
+{
+  GimpImage        *image = gimp_display_get_image (display);
+  gint              active;
+  gint              step  = (kevent->state & GDK_SHIFT_MASK) ? 10 : 1;
+  gint              dx = 0, dy = 0;
+  ChopGimpArtboard  b;
+
+  if (! image || (active = chopgimp_artboards_get_active (image)) < 0)
+    return FALSE;
+
+  switch (kevent->keyval)
+    {
+    case GDK_KEY_Delete:
+    case GDK_KEY_BackSpace:
+    case GDK_KEY_KP_Delete:
+      chopgimp_artboards_remove (image, active);
+      gimp_image_flush (image);
+      return TRUE;
+
+    case GDK_KEY_Left:  dx = -step; break;
+    case GDK_KEY_Right: dx =  step; break;
+    case GDK_KEY_Up:    dy = -step; break;
+    case GDK_KEY_Down:  dy =  step; break;
+
+    default:
+      return FALSE;
+    }
+
+  if (chopgimp_artboards_get_nth (image, active, &b))
+    {
+      chopgimp_artboards_set_rect (image, active, b.x + dx, b.y + dy, b.width, b.height, TRUE);
+      g_free (b.name);
+      gimp_image_flush (image);
+    }
+
+  return TRUE;
+}
+
+static void
+gimp_artboard_tool_draw (GimpDrawTool *dt)
+{
+  GimpArtboardTool *at = (GimpArtboardTool *) dt;
+  GimpImage        *image;
+  ChopGimpArtboard  b;
+  gint              active;
+
+  if (! dt->display || ! (image = gimp_display_get_image (dt->display)))
+    return;
+
+  if (at->mode != AB_NONE)
+    {
+      GimpCanvasItem *item;
+
+      item = gimp_draw_tool_add_rectangle (dt, FALSE, at->rx, at->ry, at->rw, at->rh);
+      gimp_canvas_item_set_highlight (item, TRUE);
+      return;
+    }
+
+  /*  the handles of the active artboard  */
+  active = chopgimp_artboards_get_active (image);
+
+  if (active >= 0 && chopgimp_artboards_get_nth (image, active, &b))
+    {
+      for (gint k = 0; k < 8; k++)
+        {
+          gdouble hx, hy;
+
+          handle_pos (b.x, b.y, b.width, b.height, k, &hx, &hy);
+          gimp_draw_tool_add_handle (dt, k == at->hover_handle ? GIMP_HANDLE_FILLED_SQUARE
+                                                               : GIMP_HANDLE_SQUARE,
+                                     hx, hy, HANDLE_SIZE, HANDLE_SIZE,
+                                     GIMP_HANDLE_ANCHOR_CENTER);
+        }
+
+      /*  the centre mark (Illustrator)  */
+      gimp_draw_tool_add_handle (dt, GIMP_HANDLE_CROSS,
+                                 b.x + b.width / 2.0, b.y + b.height / 2.0,
+                                 HANDLE_SIZE, HANDLE_SIZE, GIMP_HANDLE_ANCHOR_CENTER);
+      g_free (b.name);
+    }
+}
+
+static void
+gimp_artboard_tool_control (GimpTool       *tool,
+                            GimpToolAction  action,
+                            GimpDisplay    *display)
+{
+  GimpArtboardTool *at = (GimpArtboardTool *) tool;
+
+  if (action == GIMP_TOOL_ACTION_HALT || action == GIMP_TOOL_ACTION_COMMIT)
+    {
+      if (gimp_draw_tool_is_active (GIMP_DRAW_TOOL (tool)))
+        gimp_draw_tool_stop (GIMP_DRAW_TOOL (tool));
+
+      if (display)
+        chopgimp_canvas_artboards_set_hidden (gimp_display_get_shell (display), -1);
+
+      at->mode         = AB_NONE;
+      at->hover_index  = -1;
+      at->hover_handle = -1;
+    }
+
+  GIMP_TOOL_CLASS (gimp_artboard_tool_parent_class)->control (tool, action, display);
+}
+
+static void
+gimp_artboard_tool_class_init (GimpArtboardToolClass *klass)
+{
+  GimpToolClass     *tool_class      = GIMP_TOOL_CLASS (klass);
+  GimpDrawToolClass *draw_tool_class = GIMP_DRAW_TOOL_CLASS (klass);
+
+  tool_class->is_destructive = FALSE;
+  tool_class->control        = gimp_artboard_tool_control;
+  tool_class->button_press   = gimp_artboard_tool_button_press;
+  tool_class->motion         = gimp_artboard_tool_motion;
+  tool_class->button_release = gimp_artboard_tool_button_release;
+  tool_class->oper_update    = gimp_artboard_tool_oper_update;
+  tool_class->cursor_update  = gimp_artboard_tool_cursor_update;
+  tool_class->key_press      = gimp_artboard_tool_key_press;
+
+  draw_tool_class->draw      = gimp_artboard_tool_draw;
+}
+
+static void
+gimp_artboard_tool_init (GimpArtboardTool *at)
+{
+  GimpTool *tool = GIMP_TOOL (at);
+
+  at->index        = -1;
+  at->hover_index  = -1;
+  at->hover_handle = -1;
+
+  gimp_tool_control_set_motion_mode (tool->control, GIMP_MOTION_MODE_COMPRESS);
+  gimp_tool_control_set_tool_cursor (tool->control, GIMP_TOOL_CURSOR_CROP);
+  gimp_tool_control_set_cursor      (tool->control, GIMP_CURSOR_CROSSHAIR_SMALL);
+  gimp_tool_control_set_wants_double_click (tool->control, TRUE);
+}
