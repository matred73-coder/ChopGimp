+{
+  (* callback) (gimp_artboard_tool_get_type (),
+                GIMP_TYPE_ARTBOARD_OPTIONS,
+                artboard_options_gui,
+                0,
+                "gimp-artboard-tool",
+                _("Plan de travail"),
+                _("Plan de travail : créer, déplacer, redimensionner, renommer, "
+                  "dupliquer et supprimer les plans de travail (pages et formats "
+                  "d'un même fichier)"),
+                N_("Plan de _travail"), NULL,
+                NULL, GIMP_HELP_TOOL_CROP,
+                "chopgimp-tool-artboard",
+                data);
+}
