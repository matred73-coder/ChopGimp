+
+static void
+gui_parasite (GimpImage   *image,
+              const gchar *name,
+              Gui         *g)
+{
+  if (! g_strcmp0 (name, CHOPGIMP_ARTBOARDS_PARASITE))
+    gui_sync (g);
+}
+
+static void
+gui_set_image (Gui       *g,
+               GimpImage *image)
+{
+  if (g->image == image)
+    return;
+
+  if (g->image)
+    {
+      g_signal_handlers_disconnect_by_data (g->image, g);
+      g_object_remove_weak_pointer (G_OBJECT (g->image), (gpointer *) &g->image);
+    }
+
+  g->image = image;
+
+  if (image)
+    {
+      g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &g->image);
+      g_signal_connect (image, "parasite-attached", G_CALLBACK (gui_parasite), g);
+      g_signal_connect (image, "parasite-detached", G_CALLBACK (gui_parasite), g);
+    }
+
+  gui_sync (g);
+}
+
+static void
+gui_image_changed (GimpContext *context,
+                   GimpImage   *image,
+                   Gui         *g)
+{
+  gui_set_image (g, image);
+}
+
+static void
+gui_sync (Gui *g)
+{
+  ChopGimpArtboard b;
+  gint             i = gui_active (g);
+  gboolean         have;
+  gint             n = g->image ? chopgimp_artboards_count (g->image) : 0;
+  gchar           *count;
+
+  g->syncing = TRUE;
+
+  have = i >= 0 && chopgimp_artboards_get_nth (g->image, i, &b);
+
+  gtk_widget_set_sensitive (g->name,   have);
+  gtk_widget_set_sensitive (g->x,      have);
+  gtk_widget_set_sensitive (g->y,      have);
+  gtk_widget_set_sensitive (g->w,      have);
+  gtk_widget_set_sensitive (g->h,      have);
+  gtk_widget_set_sensitive (g->preset, have);
+
+  if (have)
+    {
+      gint p = 0;
+
+      gtk_entry_set_text (GTK_ENTRY (g->name), b.name);
+      gtk_spin_button_set_value (GTK_SPIN_BUTTON (g->x), b.x);
+      gtk_spin_button_set_value (GTK_SPIN_BUTTON (g->y), b.y);
+      gtk_spin_button_set_value (GTK_SPIN_BUTTON (g->w), b.width);
+      gtk_spin_button_set_value (GTK_SPIN_BUTTON (g->h), b.height);
+
+      for (gint k = 1; k < (gint) G_N_ELEMENTS (presets) && ! p; k++)
+        {
+          gint pw, ph;
+
+          preset_size (g->image, k, &pw, &ph);
+          if (pw == b.width && ph == b.height)
+            p = k;
+        }
+
+      gtk_combo_box_set_active (GTK_COMBO_BOX (g->preset), p);
+      g_free (b.name);
+    }
+  else
+    {
+      gtk_entry_set_text (GTK_ENTRY (g->name), "");
+      gtk_combo_box_set_active (GTK_COMBO_BOX (g->preset), 0);
+    }
+
+  if (n == 0)
+    count = g_strdup (_("Aucun plan de travail : faites glisser sur le canevas pour en créer un."));
+  else
+    count = g_strdup_printf (ngettext ("%d plan de travail (actif : n° %d)",
+                                       "%d plans de travail (actif : n° %d)", n),
+                             n, i + 1);
+  gtk_label_set_text (GTK_LABEL (g->count), count);
+  g_free (count);
+
+  g->syncing = FALSE;
+}
+
+static void
+gui_free (Gui *g)
+{
+  gui_set_image (g, NULL);
+  g_signal_handlers_disconnect_by_data (g->context, g);
+  g_free (g);
+}
+
+static GtkWidget *
+spin (GtkWidget   *grid,
+      gint         row,
+      gint         col,
+      const gchar *label,
+      Gui         *g)
+{
+  GtkWidget *l = gtk_label_new (label);
+  GtkWidget *s = gtk_spin_button_new_with_range (-100000, 100000, 1);
+
+  gtk_label_set_xalign (GTK_LABEL (l), 1.0);
+  gtk_spin_button_set_digits (GTK_SPIN_BUTTON (s), 0);
+  gtk_entry_set_width_chars (GTK_ENTRY (s), 6);
+  gtk_grid_attach (GTK_GRID (grid), l, col * 2,     row, 1, 1);
+  gtk_grid_attach (GTK_GRID (grid), s, col * 2 + 1, row, 1, 1);
+  g_signal_connect_swapped (s, "value-changed", G_CALLBACK (gui_set_rect), g);
+
+  return s;
+}
+
+static GtkWidget *
+button (GtkWidget   *box,
+        const gchar *icon,
+        const gchar *tip,
+        GCallback    callback,
+        Gui         *g)
+{
+  GtkWidget *b = gtk_button_new_from_icon_name (icon, GTK_ICON_SIZE_SMALL_TOOLBAR);
+
+  gimp_help_set_help_data (b, tip, NULL);
+  g_signal_connect (b, "clicked", callback, g);
+  gtk_box_pack_start (GTK_BOX (box), b, TRUE, TRUE, 0);
+
+  return b;
+}
+
+static GtkWidget *
+artboard_options_gui (GimpToolOptions *tool_options)
+{
+  GObject   *config = G_OBJECT (tool_options);
+  GtkWidget *vbox   = gimp_tool_options_gui (tool_options);
+  GtkWidget *grid, *hbox, *w;
+  Gui       *g      = g_new0 (Gui, 1);
+
+  g->gimp    = tool_options->tool_info->gimp;
+  g->context = gimp_get_user_context (g->gimp);
+  g->box     = vbox;
+
+  g_object_set_data_full (G_OBJECT (vbox), "chopgimp-artboard-gui", g,
+                          (GDestroyNotify) gui_free);
+
+  g->count = gtk_label_new (NULL);
+  gtk_label_set_xalign (GTK_LABEL (g->count), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (g->count), TRUE);
+  gtk_box_pack_start (GTK_BOX (vbox), g->count, FALSE, FALSE, 0);
+
+  /*  format  */
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_box_pack_start (GTK_BOX (hbox), gtk_label_new (_("Format :")), FALSE, FALSE, 0);
+  g->preset = gtk_combo_box_text_new ();
+  for (gint i = 0; i < (gint) G_N_ELEMENTS (presets); i++)
+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (g->preset), _(presets[i].name));
+  gtk_combo_box_set_active (GTK_COMBO_BOX (g->preset), 0);
+  g_signal_connect (g->preset, "changed", G_CALLBACK (gui_preset_changed), g);
+  gtk_box_pack_start (GTK_BOX (hbox), g->preset, TRUE, TRUE, 0);
+  w = gtk_button_new_from_icon_name ("object-rotate-right", GTK_ICON_SIZE_SMALL_TOOLBAR);
+  gimp_help_set_help_data (w, _("Orientation : portrait ↔ paysage"), NULL);
+  g_signal_connect (w, "clicked", G_CALLBACK (gui_orientation), g);
+  gtk_box_pack_start (GTK_BOX (hbox), w, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (vbox), hbox, FALSE, FALSE, 0);
+
+  /*  name  */
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_box_pack_start (GTK_BOX (hbox), gtk_label_new (_("Nom :")), FALSE, FALSE, 0);
+  g->name = gtk_entry_new ();
+  g_signal_connect (g->name, "activate", G_CALLBACK (gui_name_activate), g);
+  g_signal_connect (g->name, "focus-out-event", G_CALLBACK (gui_name_focus_out), g);
+  gtk_box_pack_start (GTK_BOX (hbox), g->name, TRUE, TRUE, 0);
+  gtk_box_pack_start (GTK_BOX (vbox), hbox, FALSE, FALSE, 0);
+
+  /*  position and size  */
+  grid = gtk_grid_new ();
+  gtk_grid_set_row_spacing (GTK_GRID (grid), 2);
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 4);
+  g->x = spin (grid, 0, 0, _("X :"), g);
+  g->y = spin (grid, 0, 1, _("Y :"), g);
+  g->w = spin (grid, 1, 0, _("L :"), g);
+  g->h = spin (grid, 1, 1, _("H :"), g);
+  gtk_spin_button_set_range (GTK_SPIN_BUTTON (g->w), 1, 100000);
+  gtk_spin_button_set_range (GTK_SPIN_BUTTON (g->h), 1, 100000);
+  gtk_box_pack_start (GTK_BOX (vbox), grid, FALSE, FALSE, 0);
+
+  /*  buttons  */
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 2);
+  button (hbox, GIMP_ICON_DOCUMENT_NEW, _("Nouveau plan de travail (à droite des autres)"),
+          G_CALLBACK (gui_new), g);
+  button (hbox, GIMP_ICON_OBJECT_DUPLICATE, _("Dupliquer le plan actif"),
+          G_CALLBACK (gui_duplicate), g);
+  button (hbox, GIMP_ICON_EDIT_DELETE, _("Supprimer le plan actif (Suppr)"),
+          G_CALLBACK (gui_delete), g);
+  button (hbox, GIMP_ICON_DOCUMENT_SAVE_AS, _("Exporter les plans de travail…"),
+          G_CALLBACK (gui_export), g);
+  button (hbox, GIMP_ICON_DIALOG_INFORMATION, _("Panneau Plans de travail"),
+          G_CALLBACK (gui_panel), g);
+  gtk_box_pack_start (GTK_BOX (vbox), hbox, FALSE, FALSE, 0);
+
+  w = gimp_prop_check_button_new (config, "artboard-move-artwork", NULL);
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+  w = gimp_prop_check_button_new (config, "artboard-fit-canvas", NULL);
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+
+  w = gtk_label_new (_("Glisser : nouveau plan. Dans un plan : déplacer (Alt : copier). "
+                       "Poignées : redimensionner (Maj : proportions). Double-clic : "
+                       "renommer. Suppr : supprimer. Flèches : décaler (Maj × 10)."));
+  gtk_label_set_xalign (GTK_LABEL (w), 0.0);
+  gtk_label_set_line_wrap (GTK_LABEL (w), TRUE);
+  gimp_label_set_attributes (GTK_LABEL (w), PANGO_ATTR_SCALE, PANGO_SCALE_SMALL, -1);
+  gtk_box_pack_start (GTK_BOX (vbox), w, FALSE, FALSE, 0);
+
+  g_signal_connect (g->context, "image-changed", G_CALLBACK (gui_image_changed), g);
+  gui_set_image (g, gimp_context_get_image (g->context));
+  gui_sync (g);
+
+  gtk_widget_show_all (vbox);
+
+  return vbox;
+}
