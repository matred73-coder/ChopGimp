+/*  ─── ChopGimp 3.31.0: perspective grid (Affichage > Grille de
+ *  perspective) and artboards
+ */
+
+static void
+pgrid_change (GimpImage   *image,
+              const gchar *what,
+              gint         value)
+{
+  ChopGimpPGrid g;
+
+  chopgimp_pgrid_get (image, &g);
+
+  if (! strcmp (what, "show"))
+    {
+      if (g.visible == (value != 0))
+        return;
+      g.visible = value != 0;
+    }
+  else if (! strcmp (what, "snap"))
+    {
+      if (g.snap == (value != 0))
+        return;
+      g.snap = value != 0;
+    }
+  else if (! strcmp (what, "lock"))
+    {
+      if (g.locked == (value != 0))
+        return;
+      g.locked = value != 0;
+    }
+  else if (! strcmp (what, "type"))
+    {
+      chopgimp_pgrid_set_type (&g, value,
+                               gimp_image_get_width (image), gimp_image_get_height (image));
+      g.visible = TRUE;
+    }
+  else if (! strcmp (what, "reset"))
+    {
+      chopgimp_pgrid_init (&g, g.type ? g.type : 2,
+                           gimp_image_get_width (image), gimp_image_get_height (image));
+      g.visible = TRUE;
+    }
+
+  chopgimp_pgrid_set (image, &g, _("Grille de perspective"), FALSE);
+  gimp_image_flush (image);
+}
+
+void
+view_perspective_grid_show_cmd_callback (GimpAction *action,
+                                         GVariant   *value,
+                                         gpointer    data)
+{
+  GimpImage *image;
+  return_if_no_image (image, data);
+
+  pgrid_change (image, "show", g_variant_get_boolean (value));
+}
+
+void
+view_perspective_grid_snap_cmd_callback (GimpAction *action,
+                                         GVariant   *value,
+                                         gpointer    data)
+{
+  GimpImage *image;
+  return_if_no_image (image, data);
+
+  pgrid_change (image, "snap", g_variant_get_boolean (value));
+}
+
+void
+view_perspective_grid_lock_cmd_callback (GimpAction *action,
+                                         GVariant   *value,
+                                         gpointer    data)
+{
+  GimpImage *image;
+  return_if_no_image (image, data);
+
+  pgrid_change (image, "lock", g_variant_get_boolean (value));
+}
+
+void
+view_perspective_grid_type_cmd_callback (GimpAction *action,
+                                         GVariant   *value,
+                                         gpointer    data)
+{
+  GimpImage *image;
+  return_if_no_image (image, data);
+
+  pgrid_change (image, "type", (gint) g_variant_get_int32 (value));
+}
+
+void
+view_perspective_grid_reset_cmd_callback (GimpAction *action,
+                                          GVariant   *value,
+                                          gpointer    data)
+{
+  GimpImage *image;
+  return_if_no_image (image, data);
+
+  pgrid_change (image, "reset", 0);
+}
+
+/*  Illustrator's « Attacher au plan actif » / « Libérer de la
+ *  perspective »: the selected objects of the vector layer, else the
+ *  selected layers, keep their look
+ */
+static void
+pgrid_attach (GimpImage *image,
+              gint       plane)
+{
+  GimpVectorLayer *vl  = chopgimp_vobjects_get_target_layer (image);
+  const guint     *ids = NULL;
+  gint             n   = 0;
+
+  if (vl)
+    ids = chopgimp_vlayer_get_selection (vl, &n);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_MISC,
+                               plane ? _("Attacher au plan actif")
+                                     : _("Libérer de la perspective"));
+
+  if (vl && n > 0)
+    {
+      for (gint i = 0; i < n; i++)
+        chopgimp_pgrid_item_set_plane (GIMP_ITEM (vl), ids[i], plane, TRUE);
+    }
+  else
+    {
+      for (GList *l = gimp_image_get_selected_layers (image); l; l = l->next)
+        chopgimp_pgrid_item_set_plane (l->data, 0, plane, TRUE);
+    }
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+}
+
+void
+view_perspective_attach_cmd_callback (GimpAction *action,
+                                      GVariant   *value,
+                                      gpointer    data)
+{
+  GimpImage *image;
+  gint       plane;
+  return_if_no_image (image, data);
+
+  plane = chopgimp_pgrid_get_active_plane (image);
+
+  if (plane == CHOPGIMP_PLANE_NONE)
+    {
+      gimp_message_literal (image->gimp, NULL, GIMP_MESSAGE_WARNING,
+                            _("Affichez la grille de perspective et choisissez un plan "
+                              "actif (1, 2 ou 3)."));
+      return;
+    }
+
+  pgrid_attach (image, plane);
+}
+
+void
+view_perspective_release_cmd_callback (GimpAction *action,
+                                       GVariant   *value,
+                                       gpointer    data)
+{
+  GimpImage *image;
+  return_if_no_image (image, data);
+
+  pgrid_attach (image, CHOPGIMP_PLANE_NONE);
+}
+
+void
+view_show_artboards_cmd_callback (GimpAction *action,
+                                  GVariant   *value,
+                                  gpointer    data)
+{
+  GimpImage *image;
+  gboolean   show = g_variant_get_boolean (value);
+  return_if_no_image (image, data);
+
+  if (show != chopgimp_artboards_shown (image))
+    chopgimp_artboards_set_shown (image, show);
+}
