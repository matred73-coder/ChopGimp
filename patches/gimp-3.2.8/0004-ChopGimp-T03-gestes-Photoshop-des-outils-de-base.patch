+/*  ChopGimp : cliquer sur une case à cocher ou un choix d'option bascule
+ *  l'option sans refermer le menu (on peut en régler plusieurs d'affilée).
+ *  Les commandes ordinaires et le clavier gardent le comportement normal.
+ */
+static gboolean
+chopgimp_menu_button_release (GtkWidget      *widget,
+                              GdkEventButton *event,
+                              gpointer        data)
+{
+  GtkWidget *item = gtk_menu_shell_get_selected_item (GTK_MENU_SHELL (widget));
+
+  if (event->button == 1                &&
+      item                              &&
+      GTK_IS_CHECK_MENU_ITEM (item)     &&
+      gtk_widget_is_sensitive (item))
+    {
+      gtk_menu_item_activate (GTK_MENU_ITEM (item));
+
+      return TRUE;
+    }
+
+  return FALSE;
+}
