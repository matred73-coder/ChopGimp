     }
 }
 
+/*  ChopGimp: an override cursor with a tool cursor (the Photoshop hand
+ *  of the space bar).  override_cursor cannot describe it, so it is reset
+ *  and any later gimp_display_shell_set_override_cursor() installs its
+ *  cursor again.
+ */
+void
+gimp_display_shell_set_override_tool_cursor (GimpDisplayShell   *shell,
+                                             GimpCursorType      cursor_type,
+                                             GimpToolCursorType  tool_cursor)
+{
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  shell->override_cursor       = (GimpCursorType) -1;
+  shell->using_override_cursor = TRUE;
+
+  if (gtk_widget_get_realized (shell->canvas))
+    gimp_cursor_set (shell->canvas,
+                     shell->cursor_handedness,
+                     cursor_type,
+                     tool_cursor,
+                     GIMP_CURSOR_MODIFIER_NONE);
+}
+
 void
 gimp_display_shell_unset_override_cursor (GimpDisplayShell *shell)
 {
@@ -227,6 +250,7 @@ gimp_display_shell_real_set_cursor (GimpDisplayShell   *shell,
                                     GimpCursorModifier  modifier,
                                     gboolean            always_install)
 {
+  GimpCursorMode cursor_mode;
   GimpHandedness cursor_handedness;
 
   g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
@@ -241,11 +265,24 @@ gimp_display_shell_real_set_cursor (GimpDisplayShell   *shell,
       return;
     }
 
+  /*  ChopGimp (Photoshop): Caps Lock gives the precise crosshair, also
+   *  for the paint tools that otherwise only show the brush outline
+   */
+  cursor_mode = shell->display->config->cursor_mode;
+
+  if (gdk_keymap_get_caps_lock_state (gdk_keymap_get_for_display (gtk_widget_get_display (shell->canvas))))
+    {
+      cursor_mode = GIMP_CURSOR_MODE_CROSSHAIR;
+
+      if (cursor_type == GIMP_CURSOR_NONE || cursor_type == GIMP_CURSOR_SINGLE_DOT)
+        cursor_type = GIMP_CURSOR_CROSSHAIR;
+    }
+
   if (cursor_type != GIMP_CURSOR_NONE &&
       cursor_type != GIMP_CURSOR_BAD  &&
       cursor_type != GIMP_CURSOR_SINGLE_DOT)
     {
-      switch (shell->display->config->cursor_mode)
+      switch (cursor_mode)
         {
         case GIMP_CURSOR_MODE_TOOL_ICON:
           break;
