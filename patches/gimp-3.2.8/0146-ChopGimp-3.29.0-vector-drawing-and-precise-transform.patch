+
+#define KEY_DATA "chopgimp-key-object"
+
+static GimpMatrix3     last_matrix;
+static gboolean        last_copy  = FALSE;
+static gboolean        last_valid = FALSE;
+static ChopGimpAlignTo align_to   = CHOPGIMP_ALIGN_TO_SELECTION;
+
+
+/*  ─── helpers ───────────────────────────────────────────────────────── */
+
+void
+chopgimp_vtransform_ref_point (gint     ref,
+                               gdouble  x1,
+                               gdouble  y1,
+                               gdouble  x2,
+                               gdouble  y2,
+                               gdouble *x,
+                               gdouble *y)
+{
+  gint col = CLAMP (ref, 0, 8) % 3;
+  gint row = CLAMP (ref, 0, 8) / 3;
+
+  *x = x1 + (x2 - x1) * col / 2.0;
+  *y = y1 + (y2 - y1) * row / 2.0;
+}
+
+/*  a copy of the selection ids (g_free)  */
+static guint *
+selection_copy (GimpVectorLayer *layer,
+                gint            *n)
+{
+  const guint *ids = chopgimp_vlayer_get_selection (layer, n);
+
+  if (*n <= 0)
+    return NULL;
+
+  return g_memdup2 (ids, *n * sizeof (guint));
+}
+
+static gboolean
+editable (GimpVectorLayer *layer)
+{
+  return layer && chopgimp_vobjects_enabled () &&
+         chopgimp_vobjects_layer_is_target (layer);
+}
+
+/*  @world (image coordinates, floating or not) becomes the path of @o  */
+static void
+set_world_path (GimpVectorLayer *layer,
+                ChopGimpVObject *o,
+                GimpPath        *world)
+{
+  GimpPath *local = chopgimp_vobjects_path_to_local (o, world);
+
+  if (local)
+    {
+      chopgimp_vlayer_set_path (layer, o->id, local, FALSE);
+      g_object_unref (local);
+    }
+}
+
+static GimpPath *
+world_path (GimpVectorLayer *layer,
+            ChopGimpVObject *o)
+{
+  GimpPath *p = chopgimp_vobject_get_world_path (layer, o, FALSE);
+
+  if (p)
+    g_object_ref_sink (p);
+
+  return p;
+}
+
+static gint
+count_strokes (GimpPath *path)
+{
+  return path ? gimp_path_get_n_strokes (path) : 0;
+}
+
+/*  @o takes the first piece, copies of @o (same style, right above it)
+ *  the others; @pieces: world paths
+ */
+static void
+replace_with_pieces (GimpVectorLayer *layer,
+                     ChopGimpVObject *o,
+                     GimpPath       **pieces,
+                     gint             n)
+{
+  GimpImage *image = gimp_item_get_image (GIMP_ITEM (layer));
+  gint       pos   = chopgimp_vobject_get_index (o) + 1;
+
+  for (gint i = n - 1; i >= 1; i--)
+    {
+      ChopGimpVObject *copy = chopgimp_vobject_copy (o, image);
+
+      chopgimp_vlayer_insert (layer, copy, o->parent, pos, FALSE);
+      set_world_path (layer, copy, pieces[i]);
+      chopgimp_vobject_unref (copy);
+    }
+
+  set_world_path (layer, o, pieces[0]);
+}
+
+/*  each stroke of @path as its own path (ref'ed, g_object_unref)  */
+static GimpPath **
+split_strokes (GimpPath *path,
+               gint     *n)
+{
+  GimpImage   *image  = gimp_item_get_image (GIMP_ITEM (path));
+  GPtrArray   *array  = g_ptr_array_new ();
+  GimpStroke  *stroke = NULL;
+
+  while ((stroke = gimp_path_stroke_get_next (path, stroke)))
+    {
+      GimpPath   *p    = gimp_path_new (image, gimp_object_get_name (path));
+      GimpStroke *copy = gimp_stroke_duplicate (stroke);
+
+      g_object_ref_sink (p);
+      gimp_path_stroke_add (p, copy);
+      g_object_unref (copy);
+      g_ptr_array_add (array, p);
+    }
+
+  *n = array->len;
+
+  return (GimpPath **) g_ptr_array_free (array, FALSE);
+}
