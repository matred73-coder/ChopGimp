+/* ─── 3.29.0 « Angles dynamiques » (live corners) ──────────────────── */
+
+/*  the curves of @p, degenerate ones (and an empty closing segment)
+ *  left out
+ */
+static std::vector<std::unique_ptr<Geom::Curve>>
+corner_curves (const Geom::Path &p)
+{
+  std::vector<std::unique_ptr<Geom::Curve>> curves;
+  size_t                                    n = p.closed () ? p.size_closed () : p.size_open ();
+
+  for (size_t i = 0; i < n; i++)
+    if (! p[i].isDegenerate ())
+      curves.emplace_back (p[i].duplicate ());
+
+  return curves;
+}
+
+/*  a corner between @a (incoming) and @b (outgoing): the angle between
+ *  their tangents is more than about 2°
+ */
+static bool
+is_corner (const Geom::Curve &a,
+           const Geom::Curve &b,
+           double            *turn)
+{
+  Point  tin  = a.unitTangentAt (1.0);
+  Point  tout = b.unitTangentAt (0.0);
+  double c    = CLAMP (Geom::dot (tin, tout), -1.0, 1.0);
+  double t    = acos (c);
+
+  if (turn)
+    *turn = t;
+
+  return t > 0.035 && t < G_PI - 0.01;
+}
+
+/*  the time on @c (from its end when @from_end) at distance @len from
+ *  that end, by bisection
+ */
+static double
+time_at_distance (const Geom::Curve &c,
+                  double             len,
+                  bool               from_end)
+{
+  Point  o  = from_end ? c.finalPoint () : c.initialPoint ();
+  double lo = 0.0, hi = 1.0;
+
+  if (Geom::distance (o, from_end ? c.initialPoint () : c.finalPoint ()) <= len)
+    return from_end ? 0.0 : 1.0;
+
+  for (int i = 0; i < 40; i++)
+    {
+      double m = (lo + hi) / 2.0;
+      double t = from_end ? 1.0 - m : m;
+
+      if (Geom::distance (o, c.pointAt (t)) < len)
+        lo = m;
+      else
+        hi = m;
+    }
+
+  return from_end ? 1.0 - (lo + hi) / 2.0 : (lo + hi) / 2.0;
+}
+
+/*  « corners » effect: radius=R (all corners), radii=« k:r,k:r » (corner
+ *  k of the shape, in the order of chopgimp_geom_corner_points), mode=
+ *  round | inverted | chamfer
+ */
+static Geom::PathVector
+corners_pv (const Geom::PathVector &in,
+            double                  radius,
+            const std::string      &radii,
+            const std::string      &mode)
+{
+  Geom::PathVector                   out;
+  std::unordered_map<int, double>    per;
+  int                                k = 0;
+
+  if (! radii.empty ())
+    {
+      gchar **v = g_strsplit (radii.c_str (), ",", -1);
+
+      for (gchar **s = v; s && *s; s++)
+        {
+          gchar *c = strchr (*s, ':');
+
+          if (c)
+            per[atoi (*s)] = g_ascii_strtod (c + 1, NULL);
+        }
+
+      g_strfreev (v);
+    }
+
+  for (const Geom::Path &p : in)
+    {
+      auto   curves = corner_curves (p);
+      size_t n      = curves.size ();
+      bool   closed = p.closed ();
+
+      if (n < 2)
+        {
+          out.push_back (p);
+          continue;
+        }
+
+      /*  for each node j (between curve j-1 and j): its cut length  */
+      std::vector<double> cut (n, 0.0);
+      std::vector<double> rad (n, 0.0);
+
+      for (size_t j = closed ? 0 : 1; j < n; j++)
+        {
+          const Geom::Curve &a = *curves[(j + n - 1) % n];
+          const Geom::Curve &b = *curves[j];
+          double             turn;
+
+          if (! is_corner (a, b, &turn))
+            continue;
+
+          double r = per.count (k) ? per[k] : radius;
+
+          k++;
+
+          if (r <= 0.01)
+            continue;
+
+          /*  the tangent length of a circle of radius r in that corner,
+           *  at most half of each neighbouring segment
+           */
+          double len  = r * tan (turn / 2.0);
+          double maxl = 0.5 * std::min (Geom::distance (a.initialPoint (), a.finalPoint ()),
+                                        Geom::distance (b.initialPoint (), b.finalPoint ()));
+
+          cut[j] = std::min (len, maxl);
+          rad[j] = r;
+        }
+
+      Geom::Path res;
+      bool       started = false;
+
+      res.setStitching (true);   /* tiny gaps from the portions: a segment */
+
+      for (size_t i = 0; i < n; i++)
+        {
+          const Geom::Curve &c   = *curves[i];
+          double             t0  = 0.0, t1 = 1.0;
+          size_t             nxt = (i + 1) % n;
+
+          if (cut[i] > 0)
+            t0 = time_at_distance (c, cut[i], false);
+          if ((closed || i + 1 < n) && cut[nxt] > 0)
+            t1 = time_at_distance (c, cut[nxt], true);
+
+          if (t1 <= t0 + 1e-6)
+            continue;
+
+          std::unique_ptr<Geom::Curve> part (c.portion (t0, t1));
+
+          if (! started)
+            {
+              res.start (part->initialPoint ());
+              started = true;
+            }
+          else if (Geom::distance (res.finalPoint (), part->initialPoint ()) > 1e-6)
+            {
+              res.appendNew<Geom::LineSegment> (part->initialPoint ());
+            }
+
+          res.append (*part);
+
+          /*  the corner after this curve  */
+          if ((closed || i + 1 < n) && cut[nxt] > 0)
+            {
+              const Geom::Curve &b    = *curves[nxt];
+              double             tb   = time_at_distance (b, cut[nxt], false);
+              Point              A    = res.finalPoint ();
+              Point              B    = b.pointAt (tb);
+              Point              P    = c.finalPoint ();
+              Point              tin  = c.unitTangentAt (1.0);
+              Point              tout = b.unitTangentAt (0.0);
+
+              if (mode == "chamfer")
+                {
+                  res.appendNew<Geom::LineSegment> (B);
+                }
+              else if (mode == "inverted")
+                {
+                  /*  a concave arc centred on the corner  */
+                  Point  va    = A - P, vb = B - P;
+                  double ang   = Geom::angle_between (va, vb);
+                  double h     = 4.0 / 3.0 * tan (fabs (ang) / 4.0) * Geom::L2 (va);
+                  Point  na    = Geom::rot90 (Geom::unit_vector (va));
+                  Point  nb    = Geom::rot90 (Geom::unit_vector (vb));
+
+                  if (Geom::dot (na, vb) < 0) na = -na;
+                  if (Geom::dot (nb, va) < 0) nb = -nb;
+
+                  res.appendNew<Geom::CubicBezier> (A + na * h, B + nb * h, B);
+                }
+              else
+                {
+                  double turn = acos (CLAMP (Geom::dot (tin, tout), -1.0, 1.0));
+                  double r    = Geom::distance (A, P) / MAX (tan (turn / 2.0), 1e-6);
+                  double h    = 4.0 / 3.0 * tan (turn / 4.0) * r;
+
+                  res.appendNew<Geom::CubicBezier> (A + tin * h, B - tout * h, B);
+                }
+            }
+        }
+
+      if (started)
+        {
+          if (closed)
+            res.close (true);
+
+          out.push_back (res);
+        }
+      else
+        {
+          out.push_back (p);
+        }
+    }
+
+  return out;
+}
