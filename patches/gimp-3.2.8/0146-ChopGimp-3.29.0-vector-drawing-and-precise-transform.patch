+/*  3.29.0: Spirale, Arc, Grilles (several strokes for the grids); NULL
+ *  for the other shapes (shape_build_stroke)
+ */
+static GList *
+shape_build_extra (GimpShapeTool    *shape,
+                   GimpShapeOptions *options)
+{
+  GList      *list = NULL;
+  GimpStroke *st;
+  GimpCoords  c, c1, c2;
+  gdouble     x, y, w, h;
+  const gdouble k = 0.5523;
+
+  shape_bounds (shape, &x, &y, &w, &h);
+
+  if (w < 1 && h < 1)
+    return NULL;
+
+  switch (options->shape_type)
+    {
+    case CHOPGIMP_SHAPE_SPIRAL:
+      {
+        /*  from the outside (start point side) to the center, a
+         *  logarithmic spiral: the radius × decay per turn; one cubic per
+         *  quarter turn
+         */
+        gdouble cx    = x + w / 2, cy = y + h / 2;
+        gdouble rx    = w / 2, ry = h / 2;
+        gdouble decay = options->spiral_decay / 100.0;
+        gint    n     = MAX (1, (gint) (options->spiral_turns * 4 + 0.5));
+        gdouble a0    = atan2 (shape->start_y - cy, shape->start_x - cx);
+        gdouble prev_x = 0, prev_y = 0, prev_tx = 0, prev_ty = 0;
+
+        st = NULL;
+
+        for (gint i = 0; i <= n; i++)
+          {
+            gdouble a   = a0 + i * G_PI / 2;
+            gdouble f   = pow (decay, i / 4.0);
+            gdouble px  = cx + rx * f * cos (a);
+            gdouble py  = cy + ry * f * sin (a);
+            /*  the derivative of (f(a) cos a, f(a) sin a) per quarter turn  */
+            gdouble lf  = log (decay) / (2 * G_PI);
+            gdouble tx  = rx * f * (lf * cos (a) - sin (a)) * (G_PI / 2) / 3.0;
+            gdouble ty  = ry * f * (lf * sin (a) + cos (a)) * (G_PI / 2) / 3.0;
+
+            if (i == 0)
+              {
+                c  = xy (px, py);
+                st = gimp_bezier_stroke_new_moveto (&c);
+              }
+            else
+              {
+                c1 = xy (prev_x + prev_tx, prev_y + prev_ty);
+                c2 = xy (px - tx, py - ty);
+                c  = xy (px, py);
+                gimp_bezier_stroke_cubicto (st, &c1, &c2, &c);
+              }
+
+            prev_x = px; prev_y = py; prev_tx = tx; prev_ty = ty;
+          }
+
+        list = g_list_append (list, st);
+      }
+      break;
+
+    case CHOPGIMP_SHAPE_ARC:
+      {
+        /*  a quarter ellipse from the bottom left to the top right of the
+         *  box; convex: centred on the top left corner, concave: on the
+         *  bottom right one; closed: through that corner
+         */
+        gdouble ox = options->arc_concave ? x + w : x;
+        gdouble oy = options->arc_concave ? y + h : y;
+
+        c  = xy (x, y + h);
+        st = gimp_bezier_stroke_new_moveto (&c);
+
+        if (options->arc_concave)
+          {
+            c1 = xy (x, y + h - k * h);
+            c2 = xy (x + w - k * w, y);
+          }
+        else
+          {
+            c1 = xy (x + k * w, y + h);
+            c2 = xy (x + w, y + k * h);
+          }
+
+        c = xy (x + w, y);
+        gimp_bezier_stroke_cubicto (st, &c1, &c2, &c);
+
+        if (options->arc_closed)
+          {
+            c = xy (ox, oy);
+            gimp_bezier_stroke_lineto (st, &c);
+            gimp_stroke_close (st);
+          }
+
+        list = g_list_append (list, st);
+      }
+      break;
+
+    case CHOPGIMP_SHAPE_RECT_GRID:
+      {
+        gint rows = MAX (1, options->grid_rows);
+        gint cols = MAX (1, options->grid_cols);
+
+        for (gint i = 1; i < rows; i++)
+          {
+            c  = xy (x, y + h * i / rows);
+            st = gimp_bezier_stroke_new_moveto (&c);
+            c  = xy (x + w, y + h * i / rows);
+            gimp_bezier_stroke_lineto (st, &c);
+            list = g_list_append (list, st);
+          }
+
+        for (gint i = 1; i < cols; i++)
+          {
+            c  = xy (x + w * i / cols, y);
+            st = gimp_bezier_stroke_new_moveto (&c);
+            c  = xy (x + w * i / cols, y + h);
+            gimp_bezier_stroke_lineto (st, &c);
+            list = g_list_append (list, st);
+          }
+
+        if (options->grid_frame)
+          {
+            c  = xy (x, y);         st = gimp_bezier_stroke_new_moveto (&c);
+            c  = xy (x + w, y);     gimp_bezier_stroke_lineto (st, &c);
+            c  = xy (x + w, y + h); gimp_bezier_stroke_lineto (st, &c);
+            c  = xy (x, y + h);     gimp_bezier_stroke_lineto (st, &c);
+            gimp_stroke_close (st);
+            list = g_list_append (list, st);
+          }
+      }
+      break;
+
+    case CHOPGIMP_SHAPE_POLAR_GRID:
+      {
+        gint    rings    = MAX (1, options->grid_rows);
+        gint    dividers = MAX (0, options->grid_cols);
+        gdouble cx       = x + w / 2, cy = y + h / 2;
+
+        for (gint i = 1; i <= rings; i++)
+          {
+            if (i == rings && ! options->grid_frame)
+              break;
+
+            c  = xy (cx, cy);
+            st = gimp_bezier_stroke_new_ellipse (&c, w / 2 * i / rings,
+                                                 h / 2 * i / rings, 0.0);
+            list = g_list_append (list, st);
+          }
+
+        for (gint i = 0; i < dividers; i++)
+          {
+            gdouble a = -G_PI / 2 + 2 * G_PI * i / dividers;
+
+            c  = xy (cx, cy);
+            st = gimp_bezier_stroke_new_moveto (&c);
+            c  = xy (cx + w / 2 * cos (a), cy + h / 2 * sin (a));
+            gimp_bezier_stroke_lineto (st, &c);
+            list = g_list_append (list, st);
+          }
+      }
+      break;
+
+    default:
+      break;
+    }
+
+  return list;
+}
+
+/*  adds @stroke and the strokes of @extra (unref'ed / freed) to @path  */
+static void
+shape_add_strokes (GimpPath   *path,
+                   GimpStroke *stroke,
+                   GList      *extra)
+{
+  if (stroke)
+    {
+      gimp_path_stroke_add (path, stroke);
+      g_object_unref (stroke);
+    }
+
+  for (GList *l = extra; l; l = l->next)
+    {
+      gimp_path_stroke_add (path, l->data);
+      g_object_unref (l->data);
+    }
+
+  g_list_free (extra);
+}
+
+/*  open shapes: stroked, not filled  */
+static gboolean
+shape_is_open (GimpShapeOptions *options)
+{
+  switch (options->shape_type)
+    {
+    case CHOPGIMP_SHAPE_LINE:
+    case CHOPGIMP_SHAPE_SPIRAL:
+    case CHOPGIMP_SHAPE_RECT_GRID:
+    case CHOPGIMP_SHAPE_POLAR_GRID:
+      return TRUE;
+    case CHOPGIMP_SHAPE_ARC:
+      return ! options->arc_closed;
+    default:
+      return FALSE;
+    }
+}
