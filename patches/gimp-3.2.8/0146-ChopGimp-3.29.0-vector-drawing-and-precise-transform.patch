+static void
+vpen_add_object (GimpVPenTool *vt,
+                 GimpDisplay  *display,
+                 GimpPath     *path,
+                 const gchar  *name,
+                 gboolean      open)
+{
+  GimpPathOptions *popts = GIMP_PATH_OPTIONS (gimp_tool_get_options (GIMP_TOOL (vt)));
+  GimpImage       *image = gimp_display_get_image (display);
+  GimpVectorLayer *layer;
+
+  gimp_path_options_ensure_fill_stroke (popts);
+
+  if (popts->add_to_vector_layer &&
+      (layer = chopgimp_vobjects_get_target_layer (image)))
+    {
+      ChopGimpVStyle style;
+
+      chopgimp_vobjects_style_from_tool (&style, image,
+                                         open ? FALSE : popts->enable_fill,
+                                         popts->fill_options,
+                                         open ? TRUE  : popts->enable_stroke,
+                                         popts->stroke_options);
+      chopgimp_vobjects_add_path (layer, path, name, &style);
+      chopgimp_vstyle_clear (&style);
+    }
+  else
+    {
+      GimpPath *copy = GIMP_PATH (gimp_item_duplicate (GIMP_ITEM (path), GIMP_TYPE_PATH));
+
+      gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_DRAWABLE, name);
+
+      gimp_object_set_name (GIMP_OBJECT (copy), name);
+      gimp_image_add_path (image, copy, GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+
+      layer = gimp_vector_layer_new (image, copy, gimp_get_user_context (image->gimp));
+
+      g_object_set (layer->options,
+                    "enable-fill",   open ? FALSE : popts->enable_fill,
+                    "enable-stroke", open ? TRUE  : popts->enable_stroke,
+                    NULL);
+      gimp_config_sync (G_OBJECT (popts->fill_options),
+                        G_OBJECT (layer->options->fill_options), 0);
+      gimp_config_sync (G_OBJECT (popts->stroke_options),
+                        G_OBJECT (layer->options->stroke_options), 0);
+
+      gimp_image_add_layer (image, GIMP_LAYER (layer), GIMP_IMAGE_ACTIVE_PARENT, -1, TRUE);
+      gimp_vector_layer_refresh (layer);
+
+      gimp_image_undo_group_end (image);
+    }
+
+  gimp_image_flush (image);
+}
