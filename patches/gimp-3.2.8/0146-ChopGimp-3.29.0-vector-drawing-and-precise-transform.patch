+/*  3.29.0 « Angles dynamiques »: the only selected object when it is a
+ *  path object (its corner widgets are shown)
+ */
+static ChopGimpVObject *
+vsel_corner_object (ChopGimpVSel *vsel)
+{
+  const guint     *ids;
+  gint             n = 0;
+  ChopGimpVObject *o;
+
+  if (! vsel->layer)
+    return NULL;
+
+  ids = chopgimp_vlayer_get_selection (vsel->layer, &n);
+
+  if (n != 1 || ! (o = chopgimp_vlayer_get_object (vsel->layer, ids[0])) ||
+      o->kind != CHOPGIMP_VOBJECT_PATH || chopgimp_vobject_is_locked (o))
+    return NULL;
+
+  return o;
+}
+
+/*  the corner widget at @coords: its index, -1 if none  */
+static gint
+vsel_corner_at (ChopGimpVSel     *vsel,
+                GimpDisplay      *display,
+                const GimpCoords *coords,
+                gdouble          *bx,
+                gdouble          *by)
+{
+  GimpDisplayShell *shell = gimp_display_get_shell (display);
+  gdouble           scale = MAX (shell->scale_x, 1e-6);
+  ChopGimpVObject  *o     = vsel_corner_object (vsel);
+  gdouble          *v;
+  gint              n = 0, found = -1;
+
+  if (! o || ! (v = chopgimp_vtransform_corners (vsel->layer, o->id, &n)))
+    return -1;
+
+  for (gint i = 0; i < MIN (n, MAX_CORNERS) && found < 0; i++)
+    {
+      gdouble wx = v[4 * i]     + v[4 * i + 2] * CORNER_OFFSET / scale;
+      gdouble wy = v[4 * i + 1] + v[4 * i + 3] * CORNER_OFFSET / scale;
+
+      if (hypot (coords->x - wx, coords->y - wy) * scale <= CORNER_HIT)
+        {
+          found = i;
+          *bx   = v[4 * i + 2];
+          *by   = v[4 * i + 3];
+        }
+    }
+
+  g_free (v);
+
+  return found;
+}
