+}
+
+void
+gimp_vjoin_tool_register (GimpToolRegisterCallback  callback,
+                          gpointer                  data)
+{
+  (* callback) (gimp_vjoin_tool_get_type (),
+                GIMP_TYPE_VPEN_OPTIONS,
+                gimp_tool_options_empty_gui,
+                0,
+                "gimp-vjoin-tool",
+                _("Jonction"),
+                _("Jonction : frotter par-dessus deux extrémités ouvertes les relie"),
