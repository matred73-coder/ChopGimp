+/*  ─── Répéter la transformation ─────────────────────────────────────── */
+
+void
+chopgimp_vtransform_record (const GimpMatrix3 *matrix,
+                            gboolean           copy)
+{
+  if (! matrix)
+    return;
+
+  last_matrix = *matrix;
+  last_copy   = copy;
+  last_valid  = TRUE;
+}
+
+gboolean
+chopgimp_vtransform_can_repeat (GimpVectorLayer *layer)
+{
+  return last_valid && editable (layer) && chopgimp_vobjects_n_selected (layer) > 0;
+}
+
+gboolean
+chopgimp_vtransform_repeat (GimpVectorLayer *layer)
+{
+  guint *ids;
+  gint   n = 0;
+
+  if (! chopgimp_vtransform_can_repeat (layer))
+    return FALSE;
+
+  chopgimp_vlayer_push_undo (layer, _("Répéter la transformation"));
+  chopgimp_vlayer_freeze (layer);
+
+  if (last_copy)
+    chopgimp_vobjects_duplicate_selection (layer, FALSE);
+
+  ids = selection_copy (layer, &n);
+
+  if (ids)
+    chopgimp_vlayer_transform (layer, ids, n, &last_matrix, FALSE, FALSE);
+
+  chopgimp_vlayer_thaw (layer);
+  g_free (ids);
+
+  return n > 0;
+}
