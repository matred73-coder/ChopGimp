@@ -96,6 +101,22 @@ select_none_cmd_callback (GimpAction *action,
   GimpImage *image;
   return_if_no_image (image, data);
 
+  /*  ChopGimp 3.29.0: Ctrl+D is « Désélectionner » (Photoshop); with no
+   *  pixel selection and objects selected in a vector layer after a move /
+   *  scale / rotation of objects, it is « Répéter la transformation »
+   *  (Illustrator)
+   */
+  if (gimp_channel_is_empty (gimp_image_get_mask (image)))
+    {
+      GimpVectorLayer *layer = chopgimp_vobjects_get_active_layer (image);
+
+      if (chopgimp_vtransform_can_repeat (layer) && chopgimp_vtransform_repeat (layer))
+        {
+          gimp_image_flush (image);
+          return;
+        }
+    }
+
   gimp_channel_clear (gimp_image_get_mask (image), NULL, TRUE);
   gimp_image_flush (image);
 }
