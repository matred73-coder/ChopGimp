+/*  ─── 3.29.0: Vecteur > Transformer ──────────────────────────────────── */
+
+void
+vector_objects_transform_again_cmd_callback (GimpAction *action,
+                                             GVariant   *value,
+                                             gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_vlayer (image, layer, data);
+
+  if (chopgimp_vtransform_repeat (layer))
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_transform_each_cmd_callback (GimpAction *action,
+                                            GVariant   *value,
+                                            gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  GtkWidget       *widget;
+  return_if_no_vlayer (image, layer, data);
+  return_if_no_widget (widget, data);
+
+  chopgimp_transform_each_dialog_show (image, layer, widget);
+}
+
+void
+vector_objects_flip_h_cmd_callback (GimpAction *action,
+                                    GVariant   *value,
+                                    gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_vlayer (image, layer, data);
+
+  if (chopgimp_vtransform_flip (layer, 4, TRUE))
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_flip_v_cmd_callback (GimpAction *action,
+                                    GVariant   *value,
+                                    gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_vlayer (image, layer, data);
+
+  if (chopgimp_vtransform_flip (layer, 4, FALSE))
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_key_none_cmd_callback (GimpAction *action,
+                                      GVariant   *value,
+                                      gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  return_if_no_vlayer (image, layer, data);
+
+  chopgimp_vtransform_set_key (layer, 0);
+  gimp_image_flush (image);
+}
+
+void
+vector_objects_corners_reset_cmd_callback (GimpAction *action,
+                                           GVariant   *value,
+                                           gpointer    data)
+{
+  GimpImage       *image;
+  GimpVectorLayer *layer;
+  gboolean         done = FALSE;
+  return_if_no_vlayer (image, layer, data);
+
+  chopgimp_vtransform_command (layer, "corners:0", &done);
+
+  if (done)
+    gimp_image_flush (image);
+}
+
+void
+vector_objects_align_to_cmd_callback (GimpAction *action,
+                                      GVariant   *value,
+                                      gpointer    data)
+{
+  chopgimp_vtransform_set_align_to ((ChopGimpAlignTo) g_variant_get_int32 (value));
+}
+
 void
 vector_objects_distort_warp_cmd_callback (GimpAction *action,
                                           GVariant   *value,
