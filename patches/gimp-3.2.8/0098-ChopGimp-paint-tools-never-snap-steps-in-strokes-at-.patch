From 33e079158fb9d4acc524ac45483afba62ee23596 Mon Sep 17 00:00:00 2001
From: ChopGimp <mathieu.redon@proton.me>
Date: Sun, 15 Nov 2026 18:53:48 +0100
Subject: [PATCH] ChopGimp: paint tools never snap (steps in strokes at snap
 lines)

---
 app/tools/gimppainttool.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/app/tools/gimppainttool.c b/app/tools/gimppainttool.c
index 4a37bd3..2de15b3 100644
--- a/app/tools/gimppainttool.c
+++ b/app/tools/gimppainttool.c
@@ -166,6 +166,11 @@ gimp_paint_tool_init (GimpPaintTool *paint_tool)
 
   gimp_tool_control_set_motion_mode    (tool->control, GIMP_MOTION_MODE_EXACT);
   gimp_tool_control_set_scroll_lock    (tool->control, TRUE);
+  /*  ChopGimp (Photoshop) : la peinture n'est jamais aimantée (guides,
+   *  bords et milieu du canevas, bords des calques…) : l'aimantation
+   *  déformait les traits en paliers au passage d'une ligne d'accroche.
+   */
+  gimp_tool_control_set_snap_to        (tool->control, FALSE);
   gimp_tool_control_set_action_opacity (tool->control,
                                         "context-opacity-set");
 
-- 
2.53.0

