+/*  ─── applying ──────────────────────────────────────────────────────── */
+
+typedef void (* StyleFunc) (ChopGimpVStyle *st,
+                            gpointer        data);
+
+static void
+refresh_all (void)
+{
+  for (GList *l = all_panels; l; l = l->next)
+    panel_queue_refresh (l->data);
+}
+
+/*  @key: 0 for one undo step, else a burst of changes of the same key
+ *  (one value) is one undo step
+ */
+static void
+panel_apply (Panel       *p,
+             gint         key,
+             const gchar *undo_desc,
+             StyleFunc    func,
+             gpointer     data)
+{
+  GList  *targets = panel_targets (p);
+  gint64  now     = g_get_monotonic_time ();
+
+  if (! targets)
+    return;
+
+  if (key == 0 || key != p->last_key || now - p->last_push > BURST_US)
+    chopgimp_vlayer_push_undo (p->layer, undo_desc);
+
+  p->last_key  = key;
+  p->last_push = now;
+
+  chopgimp_vlayer_freeze (p->layer);
+
+  for (GList *l = targets; l; l = l->next)
+    {
+      ChopGimpVObject *leaf = l->data;
+      ChopGimpVStyle   st;
+
+      chopgimp_vstyle_init (&st);
+      chopgimp_vstyle_copy (&st, &leaf->style);
+      func (&st, data);
+      chopgimp_vlayer_set_style (p->layer, leaf->id, &st, FALSE);
+      chopgimp_vstyle_clear (&st);
+    }
+
+  chopgimp_vlayer_thaw (p->layer);
+
+  g_list_free (targets);
+
+  if (p->image)
+    gimp_image_flush (p->image);
+
+  refresh_all ();
+}
+
+/*  a change of one field of an entry  */
+typedef enum
+{
+  F_VISIBLE,
+  F_OPACITY,
+  F_MODE,
+  F_WIDTH,
+  F_ALIGN,
+  F_CAP,
+  F_JOIN,
+  F_MITER,
+  F_DASHES,
+  F_ARROW_START,
+  F_ARROW_END,
+  F_ARROW_SCALE,
+  F_PROFILE,
+  F_PAINT_NONE,
+  F_PAINT_COLOR,
+  F_PAINT_PATTERN,
+  F_PAINT_GRADIENT,
+  F_GRADIENT_TYPE,
+  F_GRADIENT_REVERSE
+} Field;
+
+typedef struct
+{
+  EntryRef       ref;
+  Field          field;
+  gdouble        value;
+  gint           ivalue;
+  const gchar   *str;
+  GeglColor     *color;
+  GimpPattern   *pattern;
+  GArray        *dashes;
+  ChopGimpPaint *gradient;
+} FieldChange;
+
+static void
+set_gradient_geometry (ChopGimpPaint *paint,
+                       gboolean       radial)
+{
+  paint->type = radial ? CHOPGIMP_PAINT_RADIAL_GRADIENT
+                       : CHOPGIMP_PAINT_LINEAR_GRADIENT;
+
+  if (radial)
+    {
+      paint->x1 = paint->y1 = 0.5;
+      paint->x2 = paint->y2 = 0.5;
+      paint->r  = 0.5;
+    }
+  else
+    {
+      paint->x1 = 0.0;  paint->y1 = 0.5;
+      paint->x2 = 1.0;  paint->y2 = 0.5;
+      paint->r  = 0.5;
+    }
+}
+
+static void
+apply_field (ChopGimpVStyle *st,
+             gpointer        data)
+{
+  FieldChange    *fc = data;
+  ChopGimpVEntry *e  = ref_entry (st, fc->ref);
+
+  if (! e)
+    return;
+
+  switch (fc->field)
+    {
+    case F_VISIBLE:     e->visible     = fc->ivalue != 0;            break;
+    case F_OPACITY:     e->opacity     = CLAMP (fc->value, 0.0, 1.0); break;
+    case F_MODE:        e->mode        = fc->ivalue;                  break;
+    case F_WIDTH:       e->width       = MAX (fc->value, 0.0);        break;
+    case F_ALIGN:       e->align       = fc->ivalue;                  break;
+    case F_CAP:         e->cap         = fc->ivalue;                  break;
+    case F_JOIN:        e->join        = fc->ivalue;                  break;
+    case F_MITER:       e->miter_limit = MAX (fc->value, 1.0);        break;
+    case F_ARROW_SCALE: e->arrow_scale = CLAMP (fc->value, 0.1, 20.0); break;
+
+    case F_DASHES:
+      if (e->dashes)
+        g_array_free (e->dashes, TRUE);
+      e->dashes = (fc->dashes && fc->dashes->len > 0) ?
+                  g_array_copy (fc->dashes) : NULL;
+      /*  round dots need round caps  */
+      if (fc->ivalue)
+        e->cap = GIMP_CAP_ROUND;
+      break;
+
+    case F_ARROW_START:
+      g_free (e->arrow_start);
+      e->arrow_start = g_strdup (fc->str);
+      break;
+
+    case F_ARROW_END:
+      g_free (e->arrow_end);
+      e->arrow_end = g_strdup (fc->str);
+      break;
+
+    case F_PROFILE:
+      g_free (e->profile);
+      e->profile = (fc->str && strcmp (fc->str, "uniform")) ? g_strdup (fc->str) : NULL;
+      break;
+
+    case F_PAINT_NONE:
+      chopgimp_vpaint_clear (&e->paint);
+      break;
+
+    case F_PAINT_COLOR:
+      chopgimp_vpaint_set_color (&e->paint, fc->color);
+      e->visible = TRUE;
+      if (e->kind == CHOPGIMP_VENTRY_STROKE && e->width <= 0.0)
+        e->width = 1.0;
+      break;
+
+    case F_PAINT_PATTERN:
+      chopgimp_vpaint_set_pattern (&e->paint, fc->pattern);
+      e->visible = TRUE;
+      break;
+
+    case F_PAINT_GRADIENT:
+      {
+        gboolean radial = (e->paint.type == CHOPGIMP_PAINT_RADIAL_GRADIENT);
+        gboolean keep   = (e->paint.type == CHOPGIMP_PAINT_LINEAR_GRADIENT || radial);
+        gdouble  g[5]   = { e->paint.x1, e->paint.y1, e->paint.x2, e->paint.y2, e->paint.r };
+
+        chopgimp_vpaint_copy (&e->paint, fc->gradient);
+
+        if (keep)
+          {
+            e->paint.type = radial ? CHOPGIMP_PAINT_RADIAL_GRADIENT
+                                   : CHOPGIMP_PAINT_LINEAR_GRADIENT;
+            e->paint.x1 = g[0]; e->paint.y1 = g[1];
+            e->paint.x2 = g[2]; e->paint.y2 = g[3];
+            e->paint.r  = g[4];
+          }
+
+        e->visible = TRUE;
+      }
+      break;
+
+    case F_GRADIENT_TYPE:
+      if (e->paint.type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+          e->paint.type == CHOPGIMP_PAINT_RADIAL_GRADIENT)
+        set_gradient_geometry (&e->paint, fc->ivalue != 0);
+      break;
+
+    case F_GRADIENT_REVERSE:
+      if (e->paint.stops && e->paint.stops->len > 1)
+        {
+          GArray *old = e->paint.stops;
+
+          e->paint.stops = NULL;
+
+          for (gint i = old->len - 1; i >= 0; i--)
+            {
+              ChopGimpGradientStop *s = &g_array_index (old, ChopGimpGradientStop, i);
+
+              chopgimp_vpaint_add_stop (&e->paint, 1.0 - s->offset, s->color);
+              g_clear_object (&s->color);
+            }
+
+          g_array_free (old, TRUE);
+        }
+      break;
+    }
+}
+
+static void
+panel_change (Panel       *p,
+              FieldChange *fc,
+              gint         key,
+              const gchar *undo_desc)
+{
+  if (p->loading)
+    return;
+
+  panel_apply (p, key, undo_desc, apply_field, fc);
+}
+
+
+/*  ─── structural actions (Aspect) ───────────────────────────────────── */
+
+static void
+apply_add (ChopGimpVStyle *st,
+           gpointer        data)
+{
+  ChopGimpVEntryKind kind = GPOINTER_TO_INT (data);
+  ChopGimpVEntry    *e    = chopgimp_ventry_new (kind);
+  ChopGimpVEntry    *top  = (kind == CHOPGIMP_VENTRY_FILL) ? chopgimp_vstyle_get_fill (st)
+                                                           : chopgimp_vstyle_get_stroke (st);
+
+  /*  like Illustrator: the new one is a copy of the top one of its kind,
+   *  on top of the stack (a fill: above the fills, under the strokes)
+   */
+  if (top)
+    {
+      chopgimp_ventry_free (e);
+      e = chopgimp_ventry_copy (top);
+      e->visible = TRUE;
+    }
+
+  if (kind == CHOPGIMP_VENTRY_FILL)
+    {
+      gint pos = top ? chopgimp_vstyle_get_entry_index (st, top) + 1 : 0;
+
+      chopgimp_vstyle_insert_entry (st, e, pos);
+    }
+  else
+    {
+      chopgimp_vstyle_insert_entry (st, e, -1);
+    }
+}
+
+static void
+apply_duplicate (ChopGimpVStyle *st,
+                 gpointer        data)
+{
+  gint i = ref_index (st, current);
+
+  if (i >= 0)
+    chopgimp_vstyle_insert_entry (st, chopgimp_ventry_copy (chopgimp_vstyle_get_entry (st, i)),
+                                  i + 1);
+}
+
+static void
+apply_delete (ChopGimpVStyle *st,
+              gpointer        data)
+{
+  gint i = ref_index (st, current);
+
+  if (i >= 0)
+    chopgimp_vstyle_remove_entry (st, i);
+}
+
+static void
+apply_move (ChopGimpVStyle *st,
+            gpointer        data)
+{
+  gint dir = GPOINTER_TO_INT (data);   /* +1: up (toward the top) */
+  gint i   = ref_index (st, current);
+
+  if (i >= 0)
+    chopgimp_vstyle_move_entry (st, i, i + dir);
+}
+
+static GList *
+panel_reference (Panel           *p,
+                 ChopGimpVObject **leaf)
+{
+  GList *targets = panel_targets (p);
+
+  *leaf = targets ? targets->data : NULL;
+
+  return targets;
+}
+
+static void
+add_clicked (GtkWidget *button,
+             Panel     *p)
+{
+  ChopGimpVEntryKind kind = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (button),
+                                                                "chopgimp-kind"));
+  ChopGimpVObject   *leaf;
+  GList             *targets = panel_reference (p, &leaf);
+
+  g_list_free (targets);
+
+  if (! leaf)
+    return;
+
+  panel_apply (p, 0, kind == CHOPGIMP_VENTRY_FILL ? _("Ajouter un fond")
+                                                  : _("Ajouter un contour"),
+               apply_add, GINT_TO_POINTER (kind));
+
+  /*  the new one is current: the top fill / stroke  */
+  current.kind = kind;
+  current.nth  = 0;
+  refresh_all ();
+}
+
+static void
+editor_button_clicked (GtkWidget *button,
+                       GObject   *editor)
+{
+  Panel       *p      = g_object_get_data (editor, "chopgimp-panel");
+  const gchar *action = g_object_get_data (G_OBJECT (button), "chopgimp-action");
+
+  if (! p || ! action || current.nth < 0)
+    return;
+
+  if (! strcmp (action, "duplicate"))
+    {
+      panel_apply (p, 0, _("Dupliquer le fond ou le contour"), apply_duplicate, NULL);
+      /*  the copy is above: one more of its kind under it  */
+    }
+  else if (! strcmp (action, "delete"))
+    {
+      panel_apply (p, 0, _("Supprimer le fond ou le contour"), apply_delete, NULL);
+      current.nth = -1;
+    }
+  else if (! strcmp (action, "up") || ! strcmp (action, "down"))
+    {
+      gint             dir = ! strcmp (action, "up") ? 1 : -1;
+      ChopGimpVObject *leaf;
+      GList           *targets = panel_reference (p, &leaf);
+      EntryRef         moved   = current;
+
+      if (leaf)
+        {
+          gint i = ref_index (&leaf->style, current);
+          gint j = i + dir;
+
+          if (i >= 0 && j >= 0 && j < chopgimp_vstyle_get_n_entries (&leaf->style))
+            {
+              ChopGimpVEntry *other = chopgimp_vstyle_get_entry (&leaf->style, j);
+
+              /*  it passes one of its kind: its rank changes  */
+              if (other->kind == current.kind)
+                moved.nth += (dir > 0) ? -1 : 1;
+
+              panel_apply (p, 0, _("Réorganiser l'aspect"), apply_move,
+                           GINT_TO_POINTER (dir));
+              current = moved;
+            }
+        }
+
+      g_list_free (targets);
+    }
+
+  refresh_all ();
+}
+
+
+/*  ─── rows (Aspect) ─────────────────────────────────────────────────── */
+
+static void
+row_free (Row *r)
+{
+  if (r->proxy)
+    {
+      r->proxy->changed = NULL;
+      g_object_unref (r->proxy);
+    }
+
+  g_free (r);
+}
+
+static void
+row_proxy_changed (gpointer data,
+                   guint    prop)
+{
+  Row         *r = data;
+  Panel       *p = r->panel;
+  FieldChange  fc = { r->ref, };
+
+  if (p->loading)
+    return;
+
+  switch (prop)
+    {
+    case PROXY_PROP_ENABLE:
+      if (r->proxy->enabled)
+        return;   /* followed by the color or the pattern */
+      fc.field = F_PAINT_NONE;
+      panel_change (p, &fc, 0, _("Aspect : aucune couleur"));
+      break;
+
+    case PROXY_PROP_COLOR:
+      fc.field = F_PAINT_COLOR;
+      fc.color = r->proxy->color;
+      panel_change (p, &fc, 100 + r->ref.kind * 10 + r->ref.nth, _("Aspect : couleur"));
+      break;
+
+    case PROXY_PROP_PATTERN:
+    case PROXY_PROP_STYLE:
+      if (r->proxy->style == GIMP_CUSTOM_STYLE_PATTERN && r->proxy->pattern)
+        {
+          fc.field   = F_PAINT_PATTERN;
+          fc.pattern = r->proxy->pattern;
+          panel_change (p, &fc, 0, _("Aspect : motif"));
+        }
+      break;
+    }
+}
+
+static void
+row_eye_toggled (GtkToggleButton *button,
+                 Row             *r)
+{
+  FieldChange fc = { r->ref, F_VISIBLE };
+
+  fc.ivalue = gtk_toggle_button_get_active (button);
+  panel_change (r->panel, &fc, 0, fc.ivalue ? _("Afficher le fond ou le contour")
+                                            : _("Masquer le fond ou le contour"));
+}
+
+static void
+row_opacity_changed (GtkSpinButton *spin,
+                     Row           *r)
+{
+  FieldChange fc = { r->ref, F_OPACITY };
+
+  fc.value = gtk_spin_button_get_value (spin) / 100.0;
+  panel_change (r->panel, &fc, 200 + r->ref.kind * 10 + r->ref.nth, _("Aspect : opacité"));
+}
+
+static void
+row_width_changed (GtkSpinButton *spin,
+                   Row           *r)
+{
+  FieldChange fc = { r->ref, F_WIDTH };
+
+  fc.value = gtk_spin_button_get_value (spin);
+  panel_change (r->panel, &fc, 300 + r->ref.nth, _("Épaisseur du contour"));
+}
+
+static void
+row_mode_changed (GtkComboBox *combo,
+                  Row         *r)
+{
+  FieldChange fc = { r->ref, F_MODE };
+  gint        i  = gtk_combo_box_get_active (combo);
+
+  if (i < 0 || i >= (gint) G_N_ELEMENTS (modes))
+    return;
+
+  fc.ivalue = modes[i].mode;
+  panel_change (r->panel, &fc, 0, _("Aspect : mode de fusion"));
+}
+
+/*  the GIMP gradient @gradient as stops  */
+static void
+paint_from_gradient (ChopGimpPaint *paint,
+                     GimpGradient  *gradient,
+                     GimpContext   *context)
+{
+  GimpGradientSegment *seg = NULL;
+  const gint           n   = 17;
+
+  memset (paint, 0, sizeof (ChopGimpPaint));
+  set_gradient_geometry (paint, FALSE);
+
+  for (gint i = 0; i < n; i++)
+    {
+      gdouble    pos   = (gdouble) i / (n - 1);
+      GeglColor *color = NULL;
+
+      seg = gimp_gradient_get_color_at (gradient, context, seg, pos, FALSE,
+                                        GIMP_GRADIENT_BLEND_RGB_PERCEPTUAL, &color);
+      chopgimp_vpaint_add_stop (paint, pos, color);
+      g_object_unref (color);
+    }
+}
+
+static void
+gradient_chosen (GtkButton *button,
+                 Row       *r)
+{
+  GimpGradient *gradient = g_object_get_data (G_OBJECT (button), "chopgimp-gradient");
+  Panel        *p        = r->panel;
+  GtkWidget    *popover  = gtk_widget_get_ancestor (GTK_WIDGET (button), GTK_TYPE_POPOVER);
+  ChopGimpPaint paint;
+  FieldChange   fc       = { r->ref, F_PAINT_GRADIENT };
+
+  if (! gradient)
+    return;
+
+  paint_from_gradient (&paint, gradient, p->context);
+  fc.gradient = &paint;
+  panel_change (p, &fc, 0, _("Aspect : dégradé"));
+  chopgimp_vpaint_clear (&paint);
+
+  if (popover)
+    gtk_popover_popdown (GTK_POPOVER (popover));
+}
+
+static void
+gradient_option (GtkButton *button,
+                 Row       *r)
+{
+  const gchar *what = g_object_get_data (G_OBJECT (button), "chopgimp-what");
+  FieldChange  fc   = { r->ref, F_GRADIENT_TYPE };
+
+  if (! strcmp (what, "reverse"))
+    fc.field = F_GRADIENT_REVERSE;
+  else
+    fc.ivalue = ! strcmp (what, "radial");
+
+  panel_change (r->panel, &fc, 0, _("Aspect : dégradé"));
+}
+
+static void
+gradient_popover_build (GtkWidget *popover,
+                        Row       *r)
+{
+  Panel         *p = r->panel;
+  GtkWidget     *old = gtk_bin_get_child (GTK_BIN (popover));
+  GtkWidget     *vbox;
+  GtkWidget     *hbox;
+  GtkWidget     *grid;
+  GimpContainer *gradients;
+  GList         *list;
+  gint           i;
+  static const struct { const gchar *what; const gchar *label; } opts[] =
+  {
+    { "linear",  N_("Linéaire") },
+    { "radial",  N_("Radial")   },
+    { "reverse", N_("Inverser") }
+  };
+
+  if (old)
+    gtk_widget_destroy (old);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_container_set_border_width (GTK_CONTAINER (vbox), 8);
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_box_pack_start (GTK_BOX (vbox), hbox, FALSE, FALSE, 0);
+
+  for (guint k = 0; k < G_N_ELEMENTS (opts); k++)
+    {
+      GtkWidget *b = gtk_button_new_with_label (_(opts[k].label));
+
+      g_object_set_data (G_OBJECT (b), "chopgimp-what", (gpointer) opts[k].what);
+      g_signal_connect (b, "clicked", G_CALLBACK (gradient_option), r);
+      gtk_box_pack_start (GTK_BOX (hbox), b, TRUE, TRUE, 0);
+    }
+
+  grid = gtk_grid_new ();
+  gtk_grid_set_row_spacing (GTK_GRID (grid), 2);
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 2);
+  gtk_box_pack_start (GTK_BOX (vbox), grid, FALSE, FALSE, 0);
+
+  gradients = gimp_data_factory_get_container (p->gimp->gradient_factory);
+
+  for (list = GIMP_LIST (gradients)->queue->head, i = 0; list && i < 60;
+       list = list->next, i++)
+    {
+      GtkWidget *b    = gtk_button_new ();
+      GtkWidget *view = gimp_view_new_full (p->context, GIMP_VIEWABLE (list->data),
+                                            72, 16, 1, FALSE, FALSE, FALSE);
+
+      gtk_button_set_relief (GTK_BUTTON (b), GTK_RELIEF_NONE);
+      gtk_container_add (GTK_CONTAINER (b), view);
+      gimp_help_set_help_data (b, gimp_object_get_name (list->data), NULL);
+      g_object_set_data (G_OBJECT (b), "chopgimp-gradient", list->data);
+      g_signal_connect (b, "clicked", G_CALLBACK (gradient_chosen), r);
+      gtk_grid_attach (GTK_GRID (grid), b, i % 3, i / 3, 1, 1);
+    }
+
+  gtk_container_add (GTK_CONTAINER (popover), vbox);
+  gtk_widget_show_all (vbox);
+}
