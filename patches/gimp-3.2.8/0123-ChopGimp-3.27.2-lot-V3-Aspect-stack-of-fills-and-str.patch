+  gtk_container_add (GTK_CONTAINER (button), hbox);
+  gtk_widget_set_visible (hbox, TRUE);
+
+  strip->arrow = gtk_image_new_from_icon_name ("pan-down-symbolic", GTK_ICON_SIZE_MENU);
+  gtk_image_set_pixel_size (GTK_IMAGE (strip->arrow), 12);
+  gtk_box_pack_start (GTK_BOX (hbox), strip->arrow, FALSE, FALSE, 0);
+  gtk_widget_set_visible (strip->arrow, TRUE);
+
+  image = gtk_image_new_from_icon_name (GIMP_ICON_PATH, GTK_ICON_SIZE_MENU);
+  gtk_image_set_pixel_size (GTK_IMAGE (image), 16);
+  gtk_box_pack_start (GTK_BOX (hbox), image, FALSE, FALSE, 0);
+  gtk_widget_set_visible (image, TRUE);
+
+  label = gtk_label_new (_("Objets"));
+  gtk_box_pack_start (GTK_BOX (hbox), label, FALSE, FALSE, 0);
+  gtk_widget_set_visible (label, TRUE);
+
+  strip->count = gtk_label_new (NULL);
+  gtk_label_set_xalign (GTK_LABEL (strip->count), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (strip->count), "dim-label");
+  gtk_box_pack_start (GTK_BOX (hbox), strip->count, TRUE, TRUE, 0);
+  gtk_widget_set_visible (strip->count, TRUE);
+
+  /*  the tree  */
+  strip->store = gtk_tree_store_new (N_COLS,
+                                     G_TYPE_UINT,      /* COL_ID       */
+                                     G_TYPE_STRING,    /* COL_NAME     */
+                                     G_TYPE_STRING,    /* COL_RAW_NAME */
+                                     G_TYPE_STRING,    /* COL_EYE      */
+                                     G_TYPE_STRING,    /* COL_LOCK     */
+                                     GDK_TYPE_PIXBUF,  /* COL_SWATCH   */
+                                     G_TYPE_STRING,    /* COL_ICON     */
+                                     G_TYPE_BOOLEAN,   /* COL_DIM      */
+                                     G_TYPE_BOOLEAN);  /* COL_IS_GROUP */
+
+  strip->scrolled = gtk_scrolled_window_new (NULL, NULL);
+  gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (strip->scrolled),
+                                  GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+  gtk_scrolled_window_set_propagate_natural_height (GTK_SCROLLED_WINDOW (strip->scrolled),
+                                                    TRUE);
+  gtk_scrolled_window_set_max_content_height (GTK_SCROLLED_WINDOW (strip->scrolled),
+                                              MAX_HEIGHT);
+  gtk_box_pack_start (GTK_BOX (strip), strip->scrolled, FALSE, FALSE, 0);
+  gtk_widget_set_visible (strip->scrolled, strip_expanded);
+
