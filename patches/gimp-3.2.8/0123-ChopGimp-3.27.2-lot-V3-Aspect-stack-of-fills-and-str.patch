+  /*  Opacité  100 %   Normal ▾  */
+  line = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_widget_set_margin_start (line, 28);
+  gtk_box_pack_start (GTK_BOX (vbox), line, FALSE, FALSE, 0);
