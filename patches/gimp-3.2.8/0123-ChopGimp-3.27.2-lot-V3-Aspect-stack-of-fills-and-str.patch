+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (r->mode), _(modes[k].label));
+  gimp_help_set_help_data (r->mode, _("Mode de fusion"), NULL);
+  gtk_box_pack_end (GTK_BOX (line), r->mode, FALSE, FALSE, 0);
+  g_signal_connect (r->mode, "changed", G_CALLBACK (row_mode_changed), r);
+
+  gtk_widget_show_all (r->row);
+
+  return r;
+}
+
+static void
+row_load (Row                  *r,
+          const ChopGimpVEntry *e)
+{
+  GeglColor *color = chopgimp_vpaint_get_main_color (&e->paint);
+  gint       mode  = 0;
+  gchar     *text;
+
+  r->proxy->loading = TRUE;
+  g_object_set (r->proxy,
+                "enable-fill",       e->paint.type != CHOPGIMP_PAINT_NONE,
+                "fill-custom-style", (e->paint.type == CHOPGIMP_PAINT_PATTERN ?
+                                      GIMP_CUSTOM_STYLE_PATTERN :
+                                      GIMP_CUSTOM_STYLE_SOLID_COLOR),
+                NULL);
+  if (color)
+    g_object_set (r->proxy, "fill-foreground", color, NULL);
+  if (e->paint.pattern)
+    g_object_set (r->proxy, "fill-pattern", e->paint.pattern, NULL);
+  r->proxy->loading = FALSE;
+
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (r->eye), e->visible);
+  gtk_widget_set_opacity (r->eye_image, e->visible ? 1.0 : 0.25);
+
+  switch (e->paint.type)
+    {
+    case CHOPGIMP_PAINT_NONE:
+      text = g_strdup_printf ("%s ⊘", e->kind == CHOPGIMP_VENTRY_STROKE ? _("Contour") : _("Fond"));
+      break;
+    case CHOPGIMP_PAINT_LINEAR_GRADIENT:
+    case CHOPGIMP_PAINT_RADIAL_GRADIENT:
+      text = g_strdup_printf ("%s ∇", e->kind == CHOPGIMP_VENTRY_STROKE ? _("Contour") : _("Fond"));
+      break;
+    default:
+      text = g_strdup (e->kind == CHOPGIMP_VENTRY_STROKE ? _("Contour") : _("Fond"));
+      break;
+    }
+  gtk_label_set_text (GTK_LABEL (r->label), text);
+  g_free (text);
+
+  gtk_widget_set_visible (r->global, e->paint.global_id != NULL);
+
+  if (r->width)
+    gtk_spin_button_set_value (GTK_SPIN_BUTTON (r->width), e->width);
+
+  gtk_spin_button_set_value (GTK_SPIN_BUTTON (r->opacity), e->opacity * 100.0);
+
+  for (guint k = 0; k < G_N_ELEMENTS (modes); k++)
+    if (modes[k].mode == e->mode)
+      mode = k;
+  gtk_combo_box_set_active (GTK_COMBO_BOX (r->mode), mode);
+}
+
+static void
+appearance_load (Panel                *p,
+                 const ChopGimpVStyle *st)
+{
+  GString *structure = g_string_new (NULL);
+  gint     n         = chopgimp_vstyle_get_n_entries (st);
+  gint     cur_index = ref_index (st, current);
+
+  for (gint i = n - 1; i >= 0; i--)
+    g_string_append_c (structure,
+                       chopgimp_vstyle_get_entry (st, i)->kind == CHOPGIMP_VENTRY_STROKE ? 'S' : 'F');
+
+  if (g_strcmp0 (structure->str, p->structure))
+    {
+      GList *children = gtk_container_get_children (GTK_CONTAINER (p->list));
+
+      for (GList *l = children; l; l = l->next)
+        gtk_widget_destroy (l->data);
+      g_list_free (children);
+
+      g_ptr_array_set_size (p->rows, 0);
+
+      for (gint i = n - 1; i >= 0; i--)
+        {
+          Row *r = row_new (p, ref_of_index (st, i));
+
+          gtk_container_add (GTK_CONTAINER (p->list), r->row);
+          g_ptr_array_add (p->rows, r);
+        }
+
+      g_free (p->structure);
+      p->structure = g_strdup (structure->str);
+    }
+
+  g_string_free (structure, TRUE);
+
+  for (guint k = 0; k < p->rows->len; k++)
+    {
+      Row            *r = g_ptr_array_index (p->rows, k);
+      ChopGimpVEntry *e = chopgimp_vstyle_get_entry (st, n - 1 - k);
+
+      if (e)
+        row_load (r, e);
+
+      if ((gint) (n - 1 - k) == cur_index)
+        gtk_list_box_select_row (GTK_LIST_BOX (p->list), GTK_LIST_BOX_ROW (r->row));
+    }
+
+  if (cur_index < 0)
+    gtk_list_box_unselect_all (GTK_LIST_BOX (p->list));
+
+  gtk_widget_set_sensitive (p->dup_button,  cur_index >= 0);
+  gtk_widget_set_sensitive (p->del_button,  cur_index >= 0);
+  gtk_widget_set_sensitive (p->up_button,   cur_index >= 0 && cur_index < n - 1);
+  gtk_widget_set_sensitive (p->down_button, cur_index > 0);
+}
