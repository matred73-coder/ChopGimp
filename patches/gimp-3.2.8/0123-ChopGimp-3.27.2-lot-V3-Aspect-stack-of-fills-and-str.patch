+/*  the paints of @o and its children following @id (NULL: any global)
+ *  take the colors of the registry; the changed leaves are invalidated
+ *  and added to @changed (when not NULL). Returns the number of changed
+ *  leaves.
+ */
+static gint
+vobj_resolve_globals (ChopGimpVObject *o,
+                      GimpImage       *image,
+                      const gchar     *id,
+                      GList          **changed)
+{
+  gint n = 0;
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    {
+      gboolean any = FALSE;
+
+      for (gint k = 0; k < chopgimp_vstyle_get_n_entries (&o->style); k++)
+        if (paint_resolve_global (&chopgimp_vstyle_get_entry (&o->style, k)->paint,
+                                  image, id))
+          any = TRUE;
+
+      if (any)
+        {
+          vobj_invalidate (o);
+          if (changed)
+            *changed = g_list_prepend (*changed, o);
+          n++;
+        }
+    }
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      n += vobj_resolve_globals (g_ptr_array_index (o->children, i), image, id, changed);
+
+  return n;
+}
+
+static gint
+vobj_count_global_users (ChopGimpVObject *o,
+                         const gchar     *id)
+{
+  gint n = 0;
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH && chopgimp_vstyle_uses_global (&o->style, id))
+    n++;
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      n += vobj_count_global_users (g_ptr_array_index (o->children, i), id);
+
+  return n;
+}
