+static void
+row_selected (GtkListBox    *list,
+              GtkListBoxRow *lrow,
+              Panel         *p)
+{
+  Row *r;
+
+  if (p->loading || ! lrow)
+    return;
+
+  r = g_object_get_data (G_OBJECT (lrow), "chopgimp-row");
+
+  if (r && (r->ref.kind != current.kind || r->ref.nth != current.nth))
+    {
+      current = r->ref;
+      refresh_all ();
+    }
+}
