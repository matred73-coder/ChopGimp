+/*  ─── the targets ───────────────────────────────────────────────────── */
+
+static GimpVectorLayer *
+panel_find_layer (Panel *p)
+{
+  GimpImage *image = gimp_context_get_image (p->context);
+  GList     *layers;
+
+  if (! image || ! chopgimp_vobjects_enabled ())
+    return NULL;
+
+  layers = gimp_image_get_selected_layers (image);
+
+  if (layers && ! layers->next && GIMP_IS_VECTOR_LAYER (layers->data) &&
+      chopgimp_vlayer_get_root (layers->data))
+    return layers->data;
+
+  return NULL;
+}
+
+/*  the path objects edited: those of the selected objects, else the only
+ *  object of the layer
+ */
+static GList *
+panel_targets (Panel *p)
+{
+  GList *objs;
+  GList *leaves = NULL;
+
+  if (! p->layer)
+    return NULL;
+
+  objs = chopgimp_vlayer_get_selected_objects (p->layer);
+
+  for (GList *o = objs; o; o = o->next)
+    leaves = g_list_concat (leaves, chopgimp_vobjects_leaves_of (o->data));
+
+  g_list_free (objs);
+
+  if (! leaves && chopgimp_vlayer_count_leaves (p->layer) == 1)
+    leaves = chopgimp_vlayer_get_leaves (p->layer);
+
+  return leaves;
+}
+
+static gint
+ref_index (const ChopGimpVStyle *st,
+           EntryRef              ref)
+{
+  gint n = 0;
+
+  if (ref.nth < 0)
+    return -1;
+
+  for (gint i = chopgimp_vstyle_get_n_entries (st) - 1; i >= 0; i--)
+    if (chopgimp_vstyle_get_entry (st, i)->kind == ref.kind)
+      {
+        if (n == ref.nth)
+          return i;
+        n++;
+      }
+
+  return -1;
+}
+
+static ChopGimpVEntry *
+ref_entry (const ChopGimpVStyle *st,
+           EntryRef              ref)
+{
+  return chopgimp_vstyle_get_entry (st, ref_index (st, ref));
+}
+
+static EntryRef
+ref_of_index (const ChopGimpVStyle *st,
+              gint                  index)
+{
+  EntryRef        ref = { CHOPGIMP_VENTRY_FILL, -1 };
+  ChopGimpVEntry *e   = chopgimp_vstyle_get_entry (st, index);
+
+  if (! e)
+    return ref;
+
+  ref.kind = e->kind;
+  ref.nth  = 0;
+
+  for (gint i = chopgimp_vstyle_get_n_entries (st) - 1; i > index; i--)
+    if (chopgimp_vstyle_get_entry (st, i)->kind == e->kind)
+      ref.nth++;
+
+  return ref;
+}
+
+/*  the current stroke for « Contour »: the current entry when it is a
+ *  stroke, else the topmost
+ */
+static EntryRef
+stroke_ref (void)
+{
+  EntryRef ref = { CHOPGIMP_VENTRY_STROKE, 0 };
+
+  if (current.kind == CHOPGIMP_VENTRY_STROKE && current.nth >= 0)
+    ref.nth = current.nth;
+
+  return ref;
+}
