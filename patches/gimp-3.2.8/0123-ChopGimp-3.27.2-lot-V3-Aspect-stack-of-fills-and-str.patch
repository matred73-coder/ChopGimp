+static Row *
+row_new (Panel    *p,
+         EntryRef  ref)
+{
+  Row       *r = g_new0 (Row, 1);
+  GtkWidget *vbox;
+  GtkWidget *line;
+  GtkWidget *menu;
+  GtkWidget *popover;
+  GtkWidget *label;
+  gboolean   stroke = (ref.kind == CHOPGIMP_VENTRY_STROKE);
+
+  r->panel = p;
+  r->ref   = ref;
+
+  r->row = gtk_list_box_row_new ();
+  g_object_set_data_full (G_OBJECT (r->row), "chopgimp-row", r, (GDestroyNotify) row_free);
+
+  vbox = gtk_box_new (GTK_ORIENTATION_VERTICAL, 2);
+  gtk_container_set_border_width (GTK_CONTAINER (vbox), 3);
+  gtk_container_add (GTK_CONTAINER (r->row), vbox);
+
+  /*  👁 Contour  [■▾] [∇] ◆  2 px  */
+  line = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_box_pack_start (GTK_BOX (vbox), line, FALSE, FALSE, 0);
+
+  r->eye = gtk_toggle_button_new ();
+  gtk_button_set_relief (GTK_BUTTON (r->eye), GTK_RELIEF_NONE);
+  gtk_widget_set_can_focus (r->eye, FALSE);
+  gimp_help_set_help_data (r->eye, _("Afficher ou masquer"), NULL);
+  r->eye_image = gtk_image_new_from_icon_name (GIMP_ICON_VISIBLE, GTK_ICON_SIZE_MENU);
+  gtk_container_add (GTK_CONTAINER (r->eye), r->eye_image);
+  gtk_box_pack_start (GTK_BOX (line), r->eye, FALSE, FALSE, 0);
+  g_signal_connect (r->eye, "toggled", G_CALLBACK (row_eye_toggled), r);
+
+  r->label = gtk_label_new (stroke ? _("Contour") : _("Fond"));
+  gtk_label_set_xalign (GTK_LABEL (r->label), 0.0);
+  gtk_label_set_width_chars (GTK_LABEL (r->label), 7);
+  gtk_box_pack_start (GTK_BOX (line), r->label, FALSE, FALSE, 0);
+
+  r->proxy = g_object_new (CHOPGIMP_TYPE_PAINT_PROXY, NULL);
+  g_object_set_data (G_OBJECT (r->proxy), "gimp", p->gimp);
+  r->proxy->changed = row_proxy_changed;
+  r->proxy->data    = r;
+
+  gtk_box_pack_start (GTK_BOX (line),
+                      chopgimp_options_bar_color_dropdown (G_OBJECT (r->proxy),
+                                                           "fill-foreground",
+                                                           stroke ? _("Couleur du contour")
+                                                                  : _("Couleur du fond"),
+                                                           NULL),
+                      FALSE, FALSE, 0);
+
+  menu = gtk_menu_button_new ();
+  gtk_container_add (GTK_CONTAINER (menu),
+                     gtk_image_new_from_icon_name (GIMP_ICON_TOOL_GRADIENT,
+                                                   GTK_ICON_SIZE_MENU));
+  gimp_help_set_help_data (menu, _("Dégradé (dégradés de GIMP, linéaire ou radial)"), NULL);
+  popover = gtk_popover_new (menu);
+  gtk_menu_button_set_popover (GTK_MENU_BUTTON (menu), popover);
+  g_signal_connect (popover, "show", G_CALLBACK (gradient_popover_build), r);
+  gtk_box_pack_start (GTK_BOX (line), menu, FALSE, FALSE, 0);
+
+  r->global = gtk_label_new ("◆");
+  gimp_help_set_help_data (r->global, _("Couleur globale : la modifier dans le "
+                                        "nuancier change tous les objets qui "
+                                        "l'utilisent"), NULL);
+  gtk_box_pack_start (GTK_BOX (line), r->global, FALSE, FALSE, 0);
+  gtk_widget_set_no_show_all (r->global, TRUE);
+
+  if (stroke)
+    {
+      r->width = spin_new (0.0, 1000.0, 0.5, 1);
+      gimp_help_set_help_data (r->width, _("Épaisseur (px)"), NULL);
+      gtk_box_pack_end (GTK_BOX (line), gtk_label_new ("px"), FALSE, FALSE, 0);
+      gtk_box_pack_end (GTK_BOX (line), r->width, FALSE, FALSE, 0);
+      g_signal_connect (r->width, "value-changed", G_CALLBACK (row_width_changed), r);
+    }
