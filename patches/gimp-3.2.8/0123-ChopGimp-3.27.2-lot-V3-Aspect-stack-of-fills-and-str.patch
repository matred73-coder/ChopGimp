+/*  the direction at an end of a polyline, away from the path  */
+static gboolean
+end_direction (GArray  *pts,
+               gboolean at_end,
+               gdouble *x,
+               gdouble *y,
+               gdouble *dx,
+               gdouble *dy)
+{
+  gint        n = pts->len;
+  GimpCoords *p0;
+
+  if (n < 2)
+    return FALSE;
+
+  p0 = &g_array_index (pts, GimpCoords, at_end ? n - 1 : 0);
+
+  for (gint k = 1; k < n; k++)
+    {
+      GimpCoords *q = &g_array_index (pts, GimpCoords, at_end ? n - 1 - k : k);
+      gdouble     ex = p0->x - q->x;
+      gdouble     ey = p0->y - q->y;
+      gdouble     l  = sqrt (ex * ex + ey * ey);
+
+      if (l > 1e-3)
+        {
+          *x  = p0->x;
+          *y  = p0->y;
+          *dx = ex / l;
+          *dy = ey / l;
+          return TRUE;
+        }
+    }
+
+  return FALSE;
+}
