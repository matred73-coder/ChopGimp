+{
+  GtkWidget         *header;
+  GtkWidget         *button;
+  GtkWidget         *hbox;
+  GtkWidget         *image;
+  GtkWidget         *label;
+  GtkTreeViewColumn *column;
+  GtkCellRenderer   *cell;
+  GtkTreeSelection  *sel;
+
+  strip->expanded = g_hash_table_new (NULL, NULL);
+  strip->drag_ids = g_array_new (FALSE, FALSE, sizeof (guint));
