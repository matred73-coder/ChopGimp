+/*  ─── global colors ─────────────────────────────────────────────────── */
+
+gboolean
+chopgimp_vlayer_update_global_color (GimpVectorLayer *layer,
+                                     const gchar     *id)
+{
+  ChopGimpVLayer *vl;
+  GList          *changed = NULL;
+  GeglRectangle   r;
+  gboolean        any = FALSE;
+
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), FALSE);
+
+  if (! chopgimp_vobjects_enabled () || ! (vl = layer->vobjects))
+    return FALSE;
+
+  /*  the old area of the changed leaves (their bounds do not change:
+   *  only colors), then the new one
+   */
+  if (vobj_resolve_globals (vl->root, gimp_item_get_image (GIMP_ITEM (layer)),
+                            id, &changed) == 0)
+    return FALSE;
+
+  for (GList *l = changed; l; l = l->next)
+    dirty_of (layer, l->data, &r, &any);
+
+  g_list_free (changed);
+
+  /*  a never edited layer has no global color: nothing to do for GIMP's
+   *  renderer; else the objects are drawn again (no undo step)
+   */
+  vlayer_commit (layer, CHANGE_STYLE, any ? &r : NULL);
+
+  return TRUE;
+}
+
+gint
+chopgimp_vlayer_count_global_users (GimpVectorLayer *layer,
+                                    const gchar     *id)
+{
+  g_return_val_if_fail (GIMP_IS_VECTOR_LAYER (layer), 0);
+
+  if (! chopgimp_vobjects_enabled () || ! layer->vobjects)
+    return 0;
+
+  return vobj_count_global_users (layer->vobjects->root, id);
+}
