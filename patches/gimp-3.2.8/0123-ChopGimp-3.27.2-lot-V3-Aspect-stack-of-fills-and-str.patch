+/*  ─── drag and drop ─────────────────────────────────────────────────── */
+
+static void
+strip_drag_begin (GtkWidget            *widget,
+                  GdkDragContext       *context,
+                  ChopGimpObjectsStrip *strip)
+{
+  GtkTreeSelection *sel  = gtk_tree_view_get_selection (GTK_TREE_VIEW (widget));
+  GList            *rows = gtk_tree_selection_get_selected_rows (sel, NULL);
+
+  g_array_set_size (strip->drag_ids, 0);
+
+  for (GList *l = rows; l; l = l->next)
+    {
+      guint id = strip_id_at (strip, l->data);
+
+      if (id)
+        g_array_append_val (strip->drag_ids, id);
+    }
+
+  g_list_free_full (rows, (GDestroyNotify) gtk_tree_path_free);
+}
+
+static void
+strip_drag_data_get (GtkWidget            *widget,
+                     GdkDragContext       *context,
+                     GtkSelectionData     *data,
+                     guint                 info,
+                     guint                 time,
+                     ChopGimpObjectsStrip *strip)
+{
+  gtk_selection_data_set (data, gtk_selection_data_get_target (data), 8,
+                          (const guchar *) "vobjects", 8);
+
+  g_signal_stop_emission_by_name (widget, "drag-data-get");
+}
+
+static void
+strip_drag_data_delete (GtkWidget            *widget,
+                        GdkDragContext       *context,
+                        ChopGimpObjectsStrip *strip)
+{
+  /*  the rows are rebuilt from the objects  */
+  g_signal_stop_emission_by_name (widget, "drag-data-delete");
+}
+
+/*  depth-first order of every object, bottom → top  */
+static void
+order_rec (ChopGimpVObject *o,
+           GHashTable      *order,
+           gint            *n)
+{
+  g_hash_table_insert (order, o, GINT_TO_POINTER ((*n)++));
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      order_rec (g_ptr_array_index (o->children, i), order, n);
+}
+
+static GHashTable *order_table = NULL;
+
+static gint
+compare_order (gconstpointer a,
+               gconstpointer b)
+{
+  return (GPOINTER_TO_INT (g_hash_table_lookup (order_table, *(gpointer *) a)) -
+          GPOINTER_TO_INT (g_hash_table_lookup (order_table, *(gpointer *) b)));
+}
+
+/*  the index @ref will have once @o is detached  */
+static gint
+index_without (ChopGimpVObject *ref,
+               ChopGimpVObject *o)
+{
+  gint i = chopgimp_vobject_get_index (ref);
+
+  if (o->parent == ref->parent && chopgimp_vobject_get_index (o) < i)
+    i--;
+
+  return i;
+}
+
+static void
+strip_drag_data_received (GtkWidget            *widget,
+                          GdkDragContext       *context,
+                          gint                  x,
+                          gint                  y,
+                          GtkSelectionData     *data,
+                          guint                 info,
+                          guint                 time,
+                          ChopGimpObjectsStrip *strip)
+{
+  GtkTreePath             *path = NULL;
+  GtkTreeViewDropPosition  pos  = GTK_TREE_VIEW_DROP_AFTER;
+  ChopGimpVObject         *root = strip_root (strip);
+  ChopGimpVObject         *target = NULL;
+  ChopGimpVObject         *parent;
+  GPtrArray               *objs;
+  gint                     n = 0;
+  gboolean                 into  = FALSE;
+  gboolean                 below = FALSE;
+
+  g_signal_stop_emission_by_name (widget, "drag-data-received");
+
+  if (! root || strip->drag_ids->len == 0)
+    {
+      gtk_drag_finish (context, FALSE, FALSE, time);
+      return;
+    }
+
+  if (gtk_tree_view_get_dest_row_at_pos (GTK_TREE_VIEW (widget), x, y, &path, &pos))
+    {
+      target = chopgimp_vlayer_get_object (strip->layer, strip_id_at (strip, path));
+      gtk_tree_path_free (path);
+    }
+
+  /*  the dragged objects, without those inside another dragged group  */
+  objs = g_ptr_array_new ();
+
+  for (guint i = 0; i < strip->drag_ids->len; i++)
+    {
+      ChopGimpVObject *o = chopgimp_vlayer_get_object (strip->layer,
+                                                       g_array_index (strip->drag_ids, guint, i));
+      gboolean         inside = FALSE;
+
+      if (! o)
+        continue;
+
+      for (guint k = 0; k < strip->drag_ids->len; k++)
+        {
+          ChopGimpVObject *other = chopgimp_vlayer_get_object (strip->layer,
+                                                               g_array_index (strip->drag_ids, guint, k));
+
+          if (other && other != o && chopgimp_vobject_is_ancestor (other, o))
+            inside = TRUE;
+        }
+
+      /*  onto itself or into itself: nothing  */
+      if (target && (target == o || chopgimp_vobject_is_ancestor (o, target)))
+        {
+          g_ptr_array_free (objs, TRUE);
+          gtk_drag_finish (context, FALSE, FALSE, time);
+          return;
+        }
+
+      if (! inside)
+        g_ptr_array_add (objs, o);
+    }
+
+  if (objs->len == 0)
+    {
+      g_ptr_array_free (objs, TRUE);
+      gtk_drag_finish (context, FALSE, FALSE, time);
+      return;
+    }
+
+  order_table = g_hash_table_new (NULL, NULL);
+  order_rec (root, order_table, &n);
+  g_ptr_array_sort (objs, compare_order);
+  g_clear_pointer (&order_table, g_hash_table_unref);
+
+  if (target && target->kind == CHOPGIMP_VOBJECT_GROUP &&
+      (pos == GTK_TREE_VIEW_DROP_INTO_OR_BEFORE ||
+       pos == GTK_TREE_VIEW_DROP_INTO_OR_AFTER))
+    {
+      into   = TRUE;
+      parent = target;
+    }
+  else if (target)
+    {
+      parent = target->parent;
+      /*  the rows show the top first: « after » a row is under it  */
+      below  = (pos == GTK_TREE_VIEW_DROP_AFTER ||
+                pos == GTK_TREE_VIEW_DROP_INTO_OR_AFTER);
+    }
+  else
+    {
+      /*  under the last row: the bottom of the layer  */
+      parent = root;
+    }
+
+  chopgimp_vlayer_push_undo (strip->layer, _("Réorganiser les objets"));
+  chopgimp_vlayer_freeze (strip->layer);
+
+  {
+    ChopGimpVObject *ref = NULL;
+
+    for (guint i = 0; i < objs->len; i++)
+      {
+        ChopGimpVObject *o = g_ptr_array_index (objs, i);
+        gint             position;
+
+        if (into)
+          position = -1;                              /* on top, in order */
+        else if (ref)
+          position = index_without (ref, o) + 1;      /* above the previous */
+        else if (! target)
+          position = 0;                               /* the bottom */
+        else if (below)
+          position = index_without (target, o);       /* under the target */
+        else
+          position = index_without (target, o) + 1;   /* above the target */
+
+        chopgimp_vlayer_reorder (strip->layer, o->id, parent, position, FALSE);
+
+        ref = o;
+      }
+  }
+
+  chopgimp_vlayer_thaw (strip->layer);
+
+  if (into)
+    {
+      g_hash_table_add (strip->expanded, GUINT_TO_POINTER (target->id));
+    }
+
+  g_ptr_array_free (objs, TRUE);
+
+  gtk_drag_finish (context, TRUE, FALSE, time);
+
+  strip_flush (strip);
+  strip_rebuild (strip, TRUE);
+}
+
