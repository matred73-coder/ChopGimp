+
+  gtk_style_context_add_class (gtk_widget_get_style_context (GTK_WIDGET (strip)),
+                               "chopgimp-objects-strip");
+  gtk_style_context_add_class (gtk_widget_get_style_context (GTK_WIDGET (strip)),
+                               CHOPGIMP_PANELS_CLASS);
+
+  /*  header: [▾ ◇ Objets  n]  */
+  header = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  gtk_style_context_add_class (gtk_widget_get_style_context (header),
+                               "chopgimp-objects-header");
+  gtk_box_pack_start (GTK_BOX (strip), header, FALSE, FALSE, 0);
+  gtk_widget_set_visible (header, TRUE);
