diff --git a/app/path/chopgimp-vcolors.c b/app/path/chopgimp-vcolors.c
new file mode 100644
index 0000000..682aef8
--- /dev/null
+++ b/app/path/chopgimp-vcolors.c
@@ -0,0 +1,647 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vcolors.c — ChopGimp 3.27.2: global colors of the vector
+ * objects (see chopgimp-vcolors.h)
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <cairo.h>
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpcolor/gimpcolor.h"
+
+#include "path-types.h"
+
+#include "core/gimpimage.h"
+#include "core/gimpimage-undo.h"
+
+#include "gimpvectorlayer.h"
+#include "chopgimp-vobject.h"
+#include "chopgimp-vcolors.h"
+
+#include "gimp-intl.h"
+
+
+#define REGISTRY_KEY "chopgimp-vcolors"
+
+
+/*  ─── the registry object ───────────────────────────────────────────── */
+
+#define CHOPGIMP_TYPE_VCOLORS (chopgimp_vcolors_get_type ())
+#define CHOPGIMP_VCOLORS(obj) (G_TYPE_CHECK_INSTANCE_CAST ((obj), CHOPGIMP_TYPE_VCOLORS, ChopGimpVColors))
+
+typedef struct
+{
+  GObject    parent_instance;
+
+  GimpImage *image;     /* the owner (not referenced)     */
+  GPtrArray *colors;    /* ChopGimpVColor *               */
+} ChopGimpVColors;
+
+typedef GObjectClass ChopGimpVColorsClass;
+
+enum
+{
+  GLOBAL_COLOR_CHANGED,
+  GLOBAL_COLORS_CHANGED,
+  LAST_SIGNAL
+};
+
+static guint vcolors_signals[LAST_SIGNAL] = { 0 };
+
+GType chopgimp_vcolors_get_type (void);
+
+G_DEFINE_TYPE (ChopGimpVColors, chopgimp_vcolors, G_TYPE_OBJECT)
+
+
+static void
+vcolor_free (ChopGimpVColor *c)
+{
+  g_free (c->id);
+  g_free (c->name);
+  g_clear_object (&c->color);
+  g_free (c);
+}
+
+static void
+chopgimp_vcolors_finalize (GObject *object)
+{
+  ChopGimpVColors *reg = CHOPGIMP_VCOLORS (object);
+
+  g_ptr_array_free (reg->colors, TRUE);
+
+  G_OBJECT_CLASS (chopgimp_vcolors_parent_class)->finalize (object);
+}
+
+static void
+chopgimp_vcolors_class_init (ChopGimpVColorsClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->finalize = chopgimp_vcolors_finalize;
+
+  vcolors_signals[GLOBAL_COLOR_CHANGED] =
+    g_signal_new ("global-color-changed",
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0, NULL, NULL, NULL,
+                  G_TYPE_NONE, 1,
+                  G_TYPE_STRING);
+
+  vcolors_signals[GLOBAL_COLORS_CHANGED] =
+    g_signal_new ("global-colors-changed",
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0, NULL, NULL, NULL,
+                  G_TYPE_NONE, 0);
+}
+
+static void
+chopgimp_vcolors_init (ChopGimpVColors *reg)
+{
+  reg->colors = g_ptr_array_new_with_free_func ((GDestroyNotify) vcolor_free);
+}
+
+
+/*  ─── text ──────────────────────────────────────────────────────────── */
+
+static void
+put_num (GString *s,
+         gdouble  v)
+{
+  gchar buf[G_ASCII_DTOSTR_BUF_SIZE];
+
+  if (fabs (v) < 1e-12)
+    v = 0.0;
+
+  g_string_append (s, g_ascii_formatd (buf, sizeof (buf), "%.12g", v));
+}
+
+static gchar *
+registry_serialize (GPtrArray *colors)
+{
+  GString *s = g_string_new ("<chopgimp-global-colors version=\"1\">\n");
+
+  for (guint i = 0; i < colors->len; i++)
+    {
+      ChopGimpVColor *c    = g_ptr_array_index (colors, i);
+      gchar          *id   = g_markup_escape_text (c->id, -1);
+      gchar          *name = g_markup_escape_text (c->name ? c->name : "", -1);
+      gdouble         rgba[4];
+
+      gegl_color_get_pixel (c->color, babl_format ("R'G'B'A double"), rgba);
+
+      g_string_append_printf (s, "<color id=\"%s\" name=\"%s\" color=\"", id, name);
+      for (gint k = 0; k < 4; k++)
+        {
+          if (k)
+            g_string_append_c (s, ' ');
+          put_num (s, rgba[k]);
+        }
+      g_string_append (s, "\"/>\n");
+
+      g_free (id);
+      g_free (name);
+    }
+
+  g_string_append (s, "</chopgimp-global-colors>\n");
+
+  return g_string_free (s, FALSE);
+}
+
+static void
+parse_start (GMarkupParseContext  *context,
+             const gchar          *element,
+             const gchar         **names,
+             const gchar         **values,
+             gpointer              user_data,
+             GError              **error)
+{
+  GPtrArray      *colors = user_data;
+  const gchar    *id = NULL, *name = NULL, *color = NULL;
+  ChopGimpVColor *c;
+  gdouble         rgba[4] = { 0, 0, 0, 1 };
+
+  if (strcmp (element, "color"))
+    return;
+
+  for (gint i = 0; names[i]; i++)
+    {
+      if (! strcmp (names[i], "id"))
+        id = values[i];
+      else if (! strcmp (names[i], "name"))
+        name = values[i];
+      else if (! strcmp (names[i], "color"))
+        color = values[i];
+    }
+
+  if (! id || ! *id)
+    return;
+
+  for (guint i = 0; i < colors->len; i++)
+    if (! strcmp (((ChopGimpVColor *) g_ptr_array_index (colors, i))->id, id))
+      return;   /* a duplicate */
+
+  if (color)
+    {
+      const gchar *p = color;
+      gchar       *end;
+
+      for (gint k = 0; k < 4 && *p; k++)
+        {
+          rgba[k] = g_ascii_strtod (p, &end);
+          if (end == p)
+            break;
+          p = end;
+        }
+    }
+
+  c        = g_new0 (ChopGimpVColor, 1);
+  c->id    = g_strdup (id);
+  c->name  = g_strdup (name ? name : "");
+  c->color = gegl_color_new (NULL);
+  gegl_color_set_pixel (c->color, babl_format ("R'G'B'A double"), rgba);
+
+  g_ptr_array_add (colors, c);
+}
+
+static GPtrArray *
+registry_parse (GimpImage *image)
+{
+  static const GMarkupParser parser   = { parse_start, NULL, NULL, NULL, NULL };
+  GPtrArray                 *colors   = g_ptr_array_new_with_free_func ((GDestroyNotify) vcolor_free);
+  const GimpParasite        *parasite = gimp_image_parasite_find (image, CHOPGIMP_VCOLORS_PARASITE);
+  const gchar               *data;
+  guint32                    len      = 0;
+
+  if (! parasite)
+    return colors;
+
+  data = gimp_parasite_get_data (parasite, &len);
+
+  if (data && len > 0)
+    {
+      GMarkupParseContext *context = g_markup_parse_context_new (&parser, 0, colors, NULL);
+      GError              *error   = NULL;
+
+      if (! g_markup_parse_context_parse (context, data, len, &error) ||
+          ! g_markup_parse_context_end_parse (context, &error))
+        {
+          g_printerr ("ChopGimp: invalid global colors: %s\n",
+                      error ? error->message : "?");
+          g_clear_error (&error);
+        }
+
+      g_markup_parse_context_free (context);
+    }
+
+  return colors;
+}
+
+
+/*  ─── propagation ───────────────────────────────────────────────────── */
+
+static gboolean
+same_color (GeglColor *a,
+            GeglColor *b)
+{
+  gdouble x[4], y[4];
+
+  gegl_color_get_pixel (a, babl_format ("R'G'B'A double"), x);
+  gegl_color_get_pixel (b, babl_format ("R'G'B'A double"), y);
+
+  return (fabs (x[0] - y[0]) < 1e-9 && fabs (x[1] - y[1]) < 1e-9 &&
+          fabs (x[2] - y[2]) < 1e-9 && fabs (x[3] - y[3]) < 1e-9);
+}
+
+static void
+update_layers (GimpImage   *image,
+               const gchar *id)
+{
+  GList *layers = gimp_image_get_layer_list (image);
+
+  for (GList *l = layers; l; l = l->next)
+    if (GIMP_IS_VECTOR_LAYER (l->data))
+      chopgimp_vlayer_update_global_color (l->data, id);
+
+  g_list_free (layers);
+}
+
+/*  the parasite changed (our change, an undo, a script…): read it again,
+ *  update the objects of the changed colors, tell the views
+ */
+static void
+registry_reload (ChopGimpVColors *reg)
+{
+  GPtrArray *old = reg->colors;
+  GPtrArray *new = registry_parse (reg->image);
+  GPtrArray *changed = g_ptr_array_new_with_free_func (g_free);
+  gboolean   list_changed = (old->len != new->len);
+
+  for (guint i = 0; i < new->len; i++)
+    {
+      ChopGimpVColor *n     = g_ptr_array_index (new, i);
+      ChopGimpVColor *o     = NULL;
+
+      for (guint k = 0; k < old->len; k++)
+        if (! strcmp (((ChopGimpVColor *) g_ptr_array_index (old, k))->id, n->id))
+          {
+            o = g_ptr_array_index (old, k);
+
+            if (k != i)
+              list_changed = TRUE;
+            break;
+          }
+
+      if (! o)
+        {
+          /*  a new one (or one back by an undo): its objects follow it  */
+          list_changed = TRUE;
+          g_ptr_array_add (changed, g_strdup (n->id));
+        }
+      else
+        {
+          if (g_strcmp0 (o->name, n->name))
+            list_changed = TRUE;
+
+          if (! same_color (o->color, n->color))
+            g_ptr_array_add (changed, g_strdup (n->id));
+        }
+    }
+
+  reg->colors = new;
+  g_ptr_array_free (old, TRUE);
+
+  for (guint i = 0; i < changed->len; i++)
+    update_layers (reg->image, g_ptr_array_index (changed, i));
+
+  g_object_ref (reg);
+
+  for (guint i = 0; i < changed->len; i++)
+    g_signal_emit (reg, vcolors_signals[GLOBAL_COLOR_CHANGED], 0,
+                   g_ptr_array_index (changed, i));
+
+  if (list_changed || changed->len > 0)
+    g_signal_emit (reg, vcolors_signals[GLOBAL_COLORS_CHANGED], 0);
+
+  g_object_unref (reg);
+
+  g_ptr_array_free (changed, TRUE);
+}
+
+static void
+registry_parasite_changed (GimpImage       *image,
+                           const gchar     *name,
+                           ChopGimpVColors *reg)
+{
+  if (name && ! strcmp (name, CHOPGIMP_VCOLORS_PARASITE))
+    registry_reload (reg);
+}
+
+static ChopGimpVColors *
+registry_get (GimpImage *image)
+{
+  ChopGimpVColors *reg;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  reg = g_object_get_data (G_OBJECT (image), REGISTRY_KEY);
+
+  if (! reg)
+    {
+      reg         = g_object_new (CHOPGIMP_TYPE_VCOLORS, NULL);
+      reg->image  = image;
+      g_ptr_array_free (reg->colors, TRUE);
+      reg->colors = registry_parse (image);
+
+      g_object_set_data_full (G_OBJECT (image), REGISTRY_KEY, reg, g_object_unref);
+
+      g_signal_connect_object (image, "parasite-attached",
+                               G_CALLBACK (registry_parasite_changed), reg, 0);
+      g_signal_connect_object (image, "parasite-detached",
+                               G_CALLBACK (registry_parasite_changed), reg, 0);
+    }
+
+  return reg;
+}
+
+/*  writes @colors (taken) as the image's parasite; the « parasite-attached »
+ *  handler then updates everything
+ */
+static void
+registry_store (ChopGimpVColors *reg,
+                GPtrArray       *colors,
+                const gchar     *undo_desc,
+                gboolean         push_undo)
+{
+  gchar        *xml = registry_serialize (colors);
+  GimpParasite *parasite;
+
+  g_ptr_array_free (colors, TRUE);
+
+  parasite = gimp_parasite_new (CHOPGIMP_VCOLORS_PARASITE,
+                                GIMP_PARASITE_PERSISTENT | GIMP_PARASITE_UNDOABLE,
+                                strlen (xml) + 1, xml);
+  g_free (xml);
+
+  if (push_undo)
+    gimp_image_undo_group_start (reg->image, GIMP_UNDO_GROUP_PARASITE_ATTACH,
+                                 undo_desc);
+
+  gimp_image_parasite_attach (reg->image, parasite, push_undo);
+
+  if (push_undo)
+    gimp_image_undo_group_end (reg->image);
+
+  gimp_parasite_free (parasite);
+}
+
+/*  a copy of the current list, to change then store  */
+static GPtrArray *
+registry_copy (ChopGimpVColors *reg)
+{
+  GPtrArray *copy = g_ptr_array_new_with_free_func ((GDestroyNotify) vcolor_free);
+
+  for (guint i = 0; i < reg->colors->len; i++)
+    {
+      ChopGimpVColor *c = g_ptr_array_index (reg->colors, i);
+      ChopGimpVColor *d = g_new0 (ChopGimpVColor, 1);
+
+      d->id    = g_strdup (c->id);
+      d->name  = g_strdup (c->name);
+      d->color = gegl_color_duplicate (c->color);
+      g_ptr_array_add (copy, d);
+    }
+
+  return copy;
+}
+
+static gint
+find_index (GPtrArray   *colors,
+            const gchar *id)
+{
+  if (id)
+    for (guint i = 0; i < colors->len; i++)
+      if (! strcmp (((ChopGimpVColor *) g_ptr_array_index (colors, i))->id, id))
+        return i;
+
+  return -1;
+}
+
+
+/*  ─── public functions ──────────────────────────────────────────────── */
+
+GObject *
+chopgimp_vcolors_get_registry (GimpImage *image)
+{
+  return G_OBJECT (registry_get (image));
+}
+
+GList *
+chopgimp_vcolors_list (GimpImage *image)
+{
+  ChopGimpVColors *reg  = registry_get (image);
+  GList           *list = NULL;
+
+  if (reg)
+    for (gint i = reg->colors->len - 1; i >= 0; i--)
+      list = g_list_prepend (list, g_ptr_array_index (reg->colors, i));
+
+  return list;
+}
+
+const ChopGimpVColor *
+chopgimp_vcolors_lookup (GimpImage   *image,
+                         const gchar *id)
+{
+  ChopGimpVColors *reg = registry_get (image);
+  gint             i;
+
+  if (! reg || (i = find_index (reg->colors, id)) < 0)
+    return NULL;
+
+  return g_ptr_array_index (reg->colors, i);
+}
+
+GeglColor *
+chopgimp_vcolors_get_color (GimpImage   *image,
+                            const gchar *id)
+{
+  const ChopGimpVColor *c = chopgimp_vcolors_lookup (image, id);
+
+  return c ? c->color : NULL;
+}
+
+gchar *
+chopgimp_vcolors_add (GimpImage   *image,
+                      const gchar *name,
+                      GeglColor   *color,
+                      const gchar *id,
+                      gboolean     push_undo)
+{
+  ChopGimpVColors *reg = registry_get (image);
+  GPtrArray       *colors;
+  ChopGimpVColor  *c;
+  gchar           *new_id;
+
+  g_return_val_if_fail (GEGL_IS_COLOR (color), NULL);
+
+  if (! reg)
+    return NULL;
+
+  if (id)
+    {
+      if (! *id || find_index (reg->colors, id) >= 0)
+        return NULL;
+
+      new_id = g_strdup (id);
+    }
+  else
+    {
+      gchar *uuid = g_uuid_string_random ();
+
+      new_id = g_strdup_printf ("g-%s", uuid);
+      g_free (uuid);
+    }
+
+  colors   = registry_copy (reg);
+  c        = g_new0 (ChopGimpVColor, 1);
+  c->id    = g_strdup (new_id);
+  c->name  = g_strdup (name && *name ? name : _("Couleur globale"));
+  c->color = gegl_color_duplicate (color);
+  g_ptr_array_add (colors, c);
+
+  registry_store (reg, colors, _("Ajouter une couleur globale"), push_undo);
+
+  return new_id;
+}
+
+gboolean
+chopgimp_vcolors_set_color (GimpImage   *image,
+                            const gchar *id,
+                            GeglColor   *color,
+                            gboolean     push_undo)
+{
+  ChopGimpVColors *reg = registry_get (image);
+  GPtrArray       *colors;
+  ChopGimpVColor  *c;
+  gint             i;
+
+  g_return_val_if_fail (GEGL_IS_COLOR (color), FALSE);
+
+  if (! reg || (i = find_index (reg->colors, id)) < 0)
+    return FALSE;
+
+  if (same_color (((ChopGimpVColor *) g_ptr_array_index (reg->colors, i))->color, color))
+    return TRUE;
+
+  colors = registry_copy (reg);
+  c      = g_ptr_array_index (colors, i);
+  g_object_unref (c->color);
+  c->color = gegl_color_duplicate (color);
+
+  registry_store (reg, colors, _("Modifier une couleur globale"), push_undo);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vcolors_rename (GimpImage   *image,
+                         const gchar *id,
+                         const gchar *name,
+                         gboolean     push_undo)
+{
+  ChopGimpVColors *reg = registry_get (image);
+  GPtrArray       *colors;
+  ChopGimpVColor  *c;
+  gint             i;
+
+  if (! reg || ! name || (i = find_index (reg->colors, id)) < 0)
+    return FALSE;
+
+  colors = registry_copy (reg);
+  c      = g_ptr_array_index (colors, i);
+  g_free (c->name);
+  c->name = g_strdup (name);
+
+  registry_store (reg, colors, _("Renommer une couleur globale"), push_undo);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vcolors_remove (GimpImage   *image,
+                         const gchar *id,
+                         gboolean     push_undo)
+{
+  ChopGimpVColors *reg = registry_get (image);
+  GPtrArray       *colors;
+  gint             i;
+
+  if (! reg || (i = find_index (reg->colors, id)) < 0)
+    return FALSE;
+
+  colors = registry_copy (reg);
+  g_ptr_array_remove_index (colors, i);
+
+  registry_store (reg, colors, _("Supprimer une couleur globale"), push_undo);
+
+  return TRUE;
+}
+
+gboolean
+chopgimp_vcolors_reorder (GimpImage   *image,
+                          const gchar *id,
+                          gint         position,
+                          gboolean     push_undo)
+{
+  ChopGimpVColors *reg = registry_get (image);
+  GPtrArray       *colors;
+  gpointer         c;
+  gint             i;
+
+  if (! reg || (i = find_index (reg->colors, id)) < 0)
+    return FALSE;
+
+  colors = registry_copy (reg);
+  c      = g_ptr_array_steal_index (colors, i);
+
+  if (position < 0 || position > (gint) colors->len)
+    position = colors->len;
+
+  g_ptr_array_insert (colors, position, c);
+
+  registry_store (reg, colors, _("Réorganiser les couleurs globales"), push_undo);
+
+  return TRUE;
+}
+
+gint
+chopgimp_vcolors_count_users (GimpImage   *image,
+                              const gchar *id)
+{
+  GList *layers;
+  gint   n = 0;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), 0);
+
+  layers = gimp_image_get_layer_list (image);
+
+  for (GList *l = layers; l; l = l->next)
+    if (GIMP_IS_VECTOR_LAYER (l->data))
+      n += chopgimp_vlayer_count_global_users (l->data, id);
+
+  g_list_free (layers);
+
+  return n;
+}
diff --git a/app/path/chopgimp-vcolors.h b/app/path/chopgimp-vcolors.h
new file mode 100644
index 0000000..213e608
--- /dev/null
+++ b/app/path/chopgimp-vcolors.h
@@ -0,0 +1,94 @@
+/* GIMP - The GNU Image Manipulation Program
+ * chopgimp-vcolors.h — ChopGimp 3.27.2: global colors of the vector
+ * objects (Illustrator's « nuances globales »)
+ *
+ * Each image has a registry of global colors (id, name, color), kept in
+ * the persistent, undoable image parasite « chopgimp-global-colors »,
+ * so that files are self-contained:
+ *
+ *   <chopgimp-global-colors version="1">
+ *     <color id="g-…" name="Bleu marque" color="r g b a"/>   sRGB R'G'B'A
+ *   </chopgimp-global-colors>
+ *
+ * A paint of an object (ChopGimpPaint.global_id) follows a global color:
+ * changing the color in the registry (one undo step) changes every
+ * object using it in every vector layer of the image, re-rendered. The
+ * parasite is the truth: an undo, a script attaching the parasite, or a
+ * file load update the objects the same way.
+ *
+ * Signals of the registry object (chopgimp_vcolors_get_registry()):
+ *   "global-color-changed"   (GObject *registry, const gchar *id)
+ *       the color of @id changed (the objects are already updated)
+ *   "global-colors-changed"  (GObject *registry)
+ *       the list changed (added, removed, renamed, reordered, reloaded)
+ *
+ * Removing a global color leaves its objects with the last color (their
+ * link is kept, inactive, and comes back on undo).
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#pragma once
+
+G_BEGIN_DECLS
+
+
+#define CHOPGIMP_VCOLORS_PARASITE "chopgimp-global-colors"
+
+typedef struct
+{
+  gchar     *id;
+  gchar     *name;
+  GeglColor *color;
+} ChopGimpVColor;
+
+
+/*  the registry of @image (created on first use; owned by the image)  */
+GObject              * chopgimp_vcolors_get_registry (GimpImage   *image);
+
+/*  the global colors in their order (const ChopGimpVColor *, owned by
+ *  the registry: g_list_free only)
+ */
+GList                * chopgimp_vcolors_list         (GimpImage   *image);
+const ChopGimpVColor * chopgimp_vcolors_lookup       (GimpImage   *image,
+                                                      const gchar *id);
+/*  borrowed, NULL when @id is not (or no longer) a global color  */
+GeglColor            * chopgimp_vcolors_get_color    (GimpImage   *image,
+                                                      const gchar *id);
+
+/*  a new global color; @id NULL: a new unique id. Returns the id
+ *  (g_free), NULL if @id is already used.
+ */
+gchar                * chopgimp_vcolors_add          (GimpImage   *image,
+                                                      const gchar *name,
+                                                      GeglColor   *color,
+                                                      const gchar *id,
+                                                      gboolean     push_undo);
+gboolean               chopgimp_vcolors_set_color    (GimpImage   *image,
+                                                      const gchar *id,
+                                                      GeglColor   *color,
+                                                      gboolean     push_undo);
+gboolean               chopgimp_vcolors_rename       (GimpImage   *image,
+                                                      const gchar *id,
+                                                      const gchar *name,
+                                                      gboolean     push_undo);
+gboolean               chopgimp_vcolors_remove       (GimpImage   *image,
+                                                      const gchar *id,
+                                                      gboolean     push_undo);
+/*  moves @id to @position in the list (-1: the end)  */
+gboolean               chopgimp_vcolors_reorder      (GimpImage   *image,
+                                                      const gchar *id,
+                                                      gint         position,
+                                                      gboolean     push_undo);
+
+/*  the number of path objects, in all the vector layers of @image,
+ *  with a paint following @id (NULL: any global color)
+ */
+gint                   chopgimp_vcolors_count_users  (GimpImage   *image,
+                                                      const gchar *id);
+
+
+G_END_DECLS
diff --git a/app/path/chopgimp-vobject.c b/app/path/chopgimp-vobject.c
index 3a7e408..9804d44 100644
--- a/app/path/chopgimp-vobject.c
+++ b/app/path/chopgimp-vobject.c
@@ -72,6 +72,7 @@
 #include "gimpvectorlayeroptions.h"
 #include "chopgimp-geom.h"
 #include "chopgimp-vobject.h"
+#include "chopgimp-vcolors.h"
 
 #include "gimp-intl.h"
 
@@ -754,6 +755,7 @@ paint_clear (ChopGimpPaint *p)
 {
   g_clear_object (&p->color);
   g_clear_object (&p->pattern);
+  g_clear_pointer (&p->global_id, g_free);
 
   if (p->stops)
     {
@@ -771,12 +773,16 @@ static void
 paint_copy (ChopGimpPaint       *dest,
             const ChopGimpPaint *src)
 {
+  if (dest == src)
+    return;
+
   paint_clear (dest);
 
   *dest = *src;
-  dest->color   = src->color   ? gegl_color_duplicate (src->color) : NULL;
-  dest->pattern = src->pattern ? g_object_ref (src->pattern)       : NULL;
-  dest->stops   = NULL;
+  dest->color     = src->color   ? gegl_color_duplicate (src->color) : NULL;
+  dest->pattern   = src->pattern ? g_object_ref (src->pattern)       : NULL;
+  dest->global_id = g_strdup (src->global_id);
+  dest->stops     = NULL;
 
   if (src->stops)
     for (guint i = 0; i < src->stops->len; i++)
@@ -787,6 +793,13 @@ paint_copy (ChopGimpPaint       *dest,
       }
 }
 
+void
+chopgimp_vpaint_copy (ChopGimpPaint       *dest,
+                      const ChopGimpPaint *src)
+{
+  paint_copy (dest, src);
+}
+
 void
 chopgimp_vpaint_set_color (ChopGimpPaint *paint,
                            GeglColor     *color)
@@ -837,31 +850,459 @@ chopgimp_vpaint_add_stop (ChopGimpPaint *paint,
   g_array_insert_val (paint->stops, i, st);
 }
 
+void
+chopgimp_vpaint_set_global (ChopGimpPaint *paint,
+                            GimpImage     *image,
+                            const gchar   *id)
+{
+  GeglColor *color;
+
+  if (! id)
+    {
+      g_clear_pointer (&paint->global_id, g_free);
+      return;
+    }
+
+  color = image ? chopgimp_vcolors_get_color (image, id) : NULL;
+
+  if (color || paint->type != CHOPGIMP_PAINT_COLOR)
+    chopgimp_vpaint_set_color (paint, color ? color : chopgimp_vpaint_get_main_color (paint));
+
+  g_free (paint->global_id);
+  paint->global_id = g_strdup (id);
+}
+
+GeglColor *
+chopgimp_vpaint_get_main_color (const ChopGimpPaint *p)
+{
+  if (p->type == CHOPGIMP_PAINT_COLOR)
+    return p->color;
+
+  if ((p->type == CHOPGIMP_PAINT_LINEAR_GRADIENT ||
+       p->type == CHOPGIMP_PAINT_RADIAL_GRADIENT) && p->stops && p->stops->len)
+    return g_array_index (p->stops, ChopGimpGradientStop, 0).color;
+
+  return NULL;
+}
+
+/*  the paint takes the color of its global swatch; TRUE when it changed  */
+static gboolean
+paint_resolve_global (ChopGimpPaint *p,
+                      GimpImage     *image,
+                      const gchar   *id)
+{
+  GeglColor *color;
+  gdouble    a[4], b[4];
+
+  if (! p->global_id || (id && strcmp (p->global_id, id)) || ! image)
+    return FALSE;
+
+  color = chopgimp_vcolors_get_color (image, p->global_id);
+
+  if (! color)
+    return FALSE;   /* a removed swatch: the paint keeps its color */
+
+  if (p->type == CHOPGIMP_PAINT_COLOR && p->color)
+    {
+      gegl_color_get_pixel (p->color, babl_format ("R'G'B'A double"), a);
+      gegl_color_get_pixel (color,    babl_format ("R'G'B'A double"), b);
+
+      if (fabs (a[0] - b[0]) < 1e-9 && fabs (a[1] - b[1]) < 1e-9 &&
+          fabs (a[2] - b[2]) < 1e-9 && fabs (a[3] - b[3]) < 1e-9)
+        return FALSE;
+
+      g_object_unref (p->color);
+      p->color = gegl_color_duplicate (color);
+    }
+  else
+    {
+      gchar *gid = g_strdup (p->global_id);
+
+      chopgimp_vpaint_set_color (p, color);
+      p->global_id = gid;
+    }
+
+  return TRUE;
+}
+
+
+/*  ─── the appearance stack ──────────────────────────────────────────── */
+
+ChopGimpVEntry *
+chopgimp_ventry_new (ChopGimpVEntryKind kind)
+{
+  ChopGimpVEntry *e = g_new0 (ChopGimpVEntry, 1);
+
+  e->kind        = kind;
+  e->opacity     = 1.0;
+  e->mode        = GIMP_LAYER_MODE_NORMAL;
+  e->visible     = TRUE;
+  e->width       = 1.0;
+  e->align       = CHOPGIMP_STROKE_ALIGN_CENTER;
+  e->cap         = GIMP_CAP_BUTT;
+  e->join        = GIMP_JOIN_MITER;
+  e->miter_limit = 10.0;
+  e->arrow_scale = 1.0;
+
+  chopgimp_vpaint_set_color (&e->paint, NULL);
+
+  return e;
+}
+
+void
+chopgimp_ventry_free (ChopGimpVEntry *e)
+{
+  if (! e)
+    return;
+
+  paint_clear (&e->paint);
+
+  if (e->dashes)
+    g_array_free (e->dashes, TRUE);
+
+  g_free (e->profile);
+  g_free (e->arrow_start);
+  g_free (e->arrow_end);
+  g_free (e);
+}
+
+ChopGimpVEntry *
+chopgimp_ventry_copy (const ChopGimpVEntry *src)
+{
+  ChopGimpVEntry *e = g_new0 (ChopGimpVEntry, 1);
+
+  *e = *src;
+  memset (&e->paint, 0, sizeof (ChopGimpPaint));
+  paint_copy (&e->paint, &src->paint);
+
+  e->dashes      = (src->dashes && src->dashes->len > 0) ?
+                   gimp_dash_pattern_copy (src->dashes) : NULL;
+  e->profile     = g_strdup (src->profile);
+  e->arrow_start = g_strdup (src->arrow_start);
+  e->arrow_end   = g_strdup (src->arrow_end);
+
+  return e;
+}
+
+gboolean
+chopgimp_ventry_is_painted (const ChopGimpVEntry *e)
+{
+  return (e && e->visible && e->opacity > 0.0 &&
+          e->paint.type != CHOPGIMP_PAINT_NONE &&
+          (e->kind == CHOPGIMP_VENTRY_FILL || e->width > 0.0));
+}
+
+static gboolean
+profile_is_uniform (const gchar *profile)
+{
+  return ! profile || ! *profile || ! strcmp (profile, "uniform");
+}
+
+/*  the width profile presets (Illustrator's « Profil de largeur »)  */
+static const struct
+{
+  const gchar *name;
+  const gchar *label;
+  const gchar *points;
+}
+profile_presets[] =
+{
+  { "uniform",     N_("Uniforme"),              "0:1,1:1"                         },
+  { "lens",        N_("Fuseau (fin - épais - fin)"), "0:0,0.5:1,1:0"              },
+  { "taper-end",   N_("Effilé à la fin"),       "0:1,1:0"                         },
+  { "taper-start", N_("Effilé au début"),       "0:0,1:1"                         },
+  { "taper-both",  N_("Effilé aux deux bouts"), "0:0,0.15:1,0.85:1,1:0"           },
+  { "pinch",       N_("Pincé au milieu"),       "0:1,0.5:0.25,1:1"                },
+  { "bulge-start", N_("Goutte (épais au début)"), "0:0.4,0.2:1,1:0"               },
+  { "wave",        N_("Ondulé"),                "0:0.4,0.25:1,0.5:0.4,0.75:1,1:0.4" }
+};
+
+const gchar * const *
+chopgimp_vstyle_get_profile_presets (void)
+{
+  static const gchar *names[G_N_ELEMENTS (profile_presets) + 1] = { NULL, };
+
+  if (! names[0])
+    for (guint i = 0; i < G_N_ELEMENTS (profile_presets); i++)
+      names[i] = profile_presets[i].name;
+
+  return names;
+}
+
+const gchar *
+chopgimp_vstyle_get_profile_label (const gchar *profile)
+{
+  if (profile_is_uniform (profile))
+    return _(profile_presets[0].label);
+
+  for (guint i = 0; i < G_N_ELEMENTS (profile_presets); i++)
+    if (! strcmp (profile, profile_presets[i].name))
+      return _(profile_presets[i].label);
+
+  return _("Personnalisé");
+}
+
+/*  « t:w,… » with w in fractions of the width  */
+static const gchar *
+profile_points (const gchar *profile)
+{
+  for (guint i = 0; i < G_N_ELEMENTS (profile_presets); i++)
+    if (! strcmp (profile, profile_presets[i].name))
+      return profile_presets[i].points;
+
+  return profile;
+}
+
+gint
+chopgimp_vstyle_get_n_entries (const ChopGimpVStyle *style)
+{
+  return style->entries ? style->entries->len : 0;
+}
+
+ChopGimpVEntry *
+chopgimp_vstyle_get_entry (const ChopGimpVStyle *style,
+                           gint                  index)
+{
+  if (! style->entries || index < 0 || index >= (gint) style->entries->len)
+    return NULL;
+
+  return g_ptr_array_index (style->entries, index);
+}
+
+gint
+chopgimp_vstyle_get_entry_index (const ChopGimpVStyle *style,
+                                 const ChopGimpVEntry *entry)
+{
+  guint i;
+
+  if (style->entries && g_ptr_array_find (style->entries, entry, &i))
+    return i;
+
+  return -1;
+}
+
+static void
+style_ensure_array (ChopGimpVStyle *style)
+{
+  if (! style->entries)
+    style->entries = g_ptr_array_new_with_free_func ((GDestroyNotify) chopgimp_ventry_free);
+}
+
+void
+chopgimp_vstyle_insert_entry (ChopGimpVStyle *style,
+                              ChopGimpVEntry *entry,
+                              gint            position)
+{
+  g_return_if_fail (entry != NULL);
+
+  style_ensure_array (style);
+
+  if (position < 0 || position > (gint) style->entries->len)
+    position = style->entries->len;
+
+  g_ptr_array_insert (style->entries, position, entry);
+}
+
+void
+chopgimp_vstyle_remove_entry (ChopGimpVStyle *style,
+                              gint            index)
+{
+  if (style->entries && index >= 0 && index < (gint) style->entries->len)
+    g_ptr_array_remove_index (style->entries, index);
+}
+
+void
+chopgimp_vstyle_move_entry (ChopGimpVStyle *style,
+                            gint            from,
+                            gint            to)
+{
+  gpointer e;
+
+  if (! style->entries || from < 0 || from >= (gint) style->entries->len)
+    return;
+
+  to = CLAMP (to, 0, (gint) style->entries->len - 1);
+
+  if (to == from)
+    return;
+
+  e = g_ptr_array_steal_index (style->entries, from);
+  g_ptr_array_insert (style->entries, to, e);
+}
+
+static ChopGimpVEntry *
+style_top_of_kind (const ChopGimpVStyle *style,
+                   ChopGimpVEntryKind    kind)
+{
+  if (style->entries)
+    for (gint i = style->entries->len - 1; i >= 0; i--)
+      {
+        ChopGimpVEntry *e = g_ptr_array_index (style->entries, i);
+
+        if (e->kind == kind)
+          return e;
+      }
+
+  return NULL;
+}
+
+ChopGimpVEntry *
+chopgimp_vstyle_get_fill (const ChopGimpVStyle *style)
+{
+  return style_top_of_kind (style, CHOPGIMP_VENTRY_FILL);
+}
+
+ChopGimpVEntry *
+chopgimp_vstyle_get_stroke (const ChopGimpVStyle *style)
+{
+  return style_top_of_kind (style, CHOPGIMP_VENTRY_STROKE);
+}
+
+ChopGimpVEntry *
+chopgimp_vstyle_ensure_fill (ChopGimpVStyle *style)
+{
+  ChopGimpVEntry *e = chopgimp_vstyle_get_fill (style);
+  gint            pos;
+
+  if (e)
+    return e;
+
+  e = chopgimp_ventry_new (CHOPGIMP_VENTRY_FILL);
+  paint_clear (&e->paint);
+
+  /*  under the lowest stroke  */
+  style_ensure_array (style);
+
+  for (pos = 0; pos < (gint) style->entries->len; pos++)
+    if (((ChopGimpVEntry *) g_ptr_array_index (style->entries, pos))->kind ==
+        CHOPGIMP_VENTRY_STROKE)
+      break;
+
+  chopgimp_vstyle_insert_entry (style, e, pos);
+
+  return e;
+}
+
+ChopGimpVEntry *
+chopgimp_vstyle_ensure_stroke (ChopGimpVStyle *style)
+{
+  ChopGimpVEntry *e = chopgimp_vstyle_get_stroke (style);
+
+  if (e)
+    return e;
+
+  e = chopgimp_ventry_new (CHOPGIMP_VENTRY_STROKE);
+  paint_clear (&e->paint);
+  chopgimp_vstyle_insert_entry (style, e, -1);
+
+  return e;
+}
+
+gboolean
+chopgimp_vstyle_has_fill (const ChopGimpVStyle *style)
+{
+  for (gint i = 0; i < chopgimp_vstyle_get_n_entries (style); i++)
+    {
+      ChopGimpVEntry *e = g_ptr_array_index (style->entries, i);
+
+      if (e->kind == CHOPGIMP_VENTRY_FILL && chopgimp_ventry_is_painted (e))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+gboolean
+chopgimp_vstyle_has_stroke (const ChopGimpVStyle *style)
+{
+  for (gint i = 0; i < chopgimp_vstyle_get_n_entries (style); i++)
+    {
+      ChopGimpVEntry *e = g_ptr_array_index (style->entries, i);
+
+      if (e->kind == CHOPGIMP_VENTRY_STROKE && chopgimp_ventry_is_painted (e))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+void
+chopgimp_vstyle_copy_primary_fill (ChopGimpVStyle       *dest,
+                                   const ChopGimpVStyle *src)
+{
+  ChopGimpVEntry *s = chopgimp_vstyle_get_fill (src);
+  ChopGimpVEntry *d = chopgimp_vstyle_ensure_fill (dest);
+
+  if (s)
+    paint_copy (&d->paint, &s->paint);
+  else
+    paint_clear (&d->paint);
+}
+
+void
+chopgimp_vstyle_copy_primary_stroke (ChopGimpVStyle       *dest,
+                                     const ChopGimpVStyle *src)
+{
+  ChopGimpVEntry *s = chopgimp_vstyle_get_stroke (src);
+  ChopGimpVEntry *d = chopgimp_vstyle_ensure_stroke (dest);
+
+  if (! s)
+    {
+      paint_clear (&d->paint);
+      return;
+    }
+
+  paint_copy (&d->paint, &s->paint);
+
+  d->width       = s->width;
+  d->cap         = s->cap;
+  d->join        = s->join;
+  d->miter_limit = s->miter_limit;
+  d->dash_offset = s->dash_offset;
+
+  if (d->dashes)
+    g_array_free (d->dashes, TRUE);
+  d->dashes = (s->dashes && s->dashes->len > 0) ? gimp_dash_pattern_copy (s->dashes) : NULL;
+}
+
+gboolean
+chopgimp_vstyle_uses_global (const ChopGimpVStyle *style,
+                             const gchar          *id)
+{
+  for (gint i = 0; i < chopgimp_vstyle_get_n_entries (style); i++)
+    {
+      ChopGimpVEntry *e = g_ptr_array_index (style->entries, i);
+
+      if (e->paint.global_id && (! id || ! strcmp (e->paint.global_id, id)))
+        return TRUE;
+    }
+
+  return FALSE;
+}
