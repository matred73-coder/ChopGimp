+/*  ─── the paint proxy (bound to the color drop-down) ────────────────── */
+
+enum
+{
+  PROXY_PROP_0,
+  PROXY_PROP_ENABLE,
+  PROXY_PROP_COLOR,
+  PROXY_PROP_STYLE,
+  PROXY_PROP_PATTERN
+};
+
+typedef void (* ProxyChanged) (gpointer data,
+                               guint    prop);
+
+#define CHOPGIMP_TYPE_PAINT_PROXY (chopgimp_paint_proxy_get_type ())
+#define CHOPGIMP_PAINT_PROXY(obj) (G_TYPE_CHECK_INSTANCE_CAST ((obj), CHOPGIMP_TYPE_PAINT_PROXY, ChopGimpPaintProxy))
+
+typedef struct
+{
+  GObject          parent_instance;
+
+  gboolean         enabled;
+  GeglColor       *color;
+  GimpCustomStyle  style;
+  GimpPattern     *pattern;
+
+  gboolean         loading;
+  ProxyChanged     changed;
+  gpointer         data;
+} ChopGimpPaintProxy;
+
+typedef GObjectClass ChopGimpPaintProxyClass;
+
+GType chopgimp_paint_proxy_get_type (void);
+
+G_DEFINE_TYPE (ChopGimpPaintProxy, chopgimp_paint_proxy, G_TYPE_OBJECT)
+
+static void
+proxy_set_property (GObject      *object,
+                    guint         prop_id,
+                    const GValue *value,
+                    GParamSpec   *pspec)
+{
+  ChopGimpPaintProxy *p = CHOPGIMP_PAINT_PROXY (object);
+
+  switch (prop_id)
+    {
+    case PROXY_PROP_ENABLE:
+      p->enabled = g_value_get_boolean (value);
+      break;
+    case PROXY_PROP_COLOR:
+      g_clear_object (&p->color);
+      p->color = g_value_get_object (value) ?
+                 gegl_color_duplicate (g_value_get_object (value)) :
+                 gegl_color_new ("black");
+      break;
+    case PROXY_PROP_STYLE:
+      p->style = g_value_get_enum (value);
+      break;
+    case PROXY_PROP_PATTERN:
+      g_set_object (&p->pattern, g_value_get_object (value));
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      return;
+    }
+
+  if (! p->loading && p->changed)
+    p->changed (p->data, prop_id);
+}
+
+static void
+proxy_get_property (GObject    *object,
+                    guint       prop_id,
+                    GValue     *value,
+                    GParamSpec *pspec)
+{
+  ChopGimpPaintProxy *p = CHOPGIMP_PAINT_PROXY (object);
+
+  switch (prop_id)
+    {
+    case PROXY_PROP_ENABLE:  g_value_set_boolean (value, p->enabled); break;
+    case PROXY_PROP_COLOR:   g_value_set_object  (value, p->color);   break;
+    case PROXY_PROP_STYLE:   g_value_set_enum    (value, p->style);   break;
+    case PROXY_PROP_PATTERN: g_value_set_object  (value, p->pattern); break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+    }
+}
+
+static void
+proxy_finalize (GObject *object)
+{
+  ChopGimpPaintProxy *p = CHOPGIMP_PAINT_PROXY (object);
+
+  g_clear_object (&p->color);
+  g_clear_object (&p->pattern);
+
+  G_OBJECT_CLASS (chopgimp_paint_proxy_parent_class)->finalize (object);
+}
+
+static void
+chopgimp_paint_proxy_class_init (ChopGimpPaintProxyClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GeglColor    *black        = gegl_color_new ("black");
+
+  object_class->set_property = proxy_set_property;
+  object_class->get_property = proxy_get_property;
+  object_class->finalize     = proxy_finalize;
+
+#define FLAGS (G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS)
+  g_object_class_install_property (object_class, PROXY_PROP_ENABLE,
+    g_param_spec_boolean ("enable-fill", NULL, NULL, TRUE, FLAGS));
+  g_object_class_install_property (object_class, PROXY_PROP_COLOR,
+    gegl_param_spec_color ("fill-foreground", _("Couleur"), NULL, black, FLAGS));
+  g_object_class_install_property (object_class, PROXY_PROP_STYLE,
+    g_param_spec_enum ("fill-custom-style", NULL, NULL, GIMP_TYPE_CUSTOM_STYLE,
+                       GIMP_CUSTOM_STYLE_SOLID_COLOR, FLAGS));
+  g_object_class_install_property (object_class, PROXY_PROP_PATTERN,
+    g_param_spec_object ("fill-pattern", NULL, NULL, GIMP_TYPE_PATTERN, FLAGS));
+#undef FLAGS
+
+  g_object_unref (black);
+}
+
+static void
+chopgimp_paint_proxy_init (ChopGimpPaintProxy *p)
+{
+  p->enabled = TRUE;
+  p->color   = gegl_color_new ("black");
+}
