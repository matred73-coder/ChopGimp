+  g_signal_connect (strip->view, "row-activated",
+                    G_CALLBACK (strip_row_activated), strip);
+  g_signal_connect (strip->view, "row-expanded",
+                    G_CALLBACK (strip_row_expanded), strip);
+  g_signal_connect (strip->view, "row-collapsed",
+                    G_CALLBACK (strip_row_collapsed), strip);
+
+  /*  drag and drop inside the tree  */
+  gtk_tree_view_enable_model_drag_source (GTK_TREE_VIEW (strip->view),
+                                          GDK_BUTTON1_MASK,
+                                          strip_targets, G_N_ELEMENTS (strip_targets),
+                                          GDK_ACTION_MOVE);
+  gtk_tree_view_enable_model_drag_dest (GTK_TREE_VIEW (strip->view),
+                                        strip_targets, G_N_ELEMENTS (strip_targets),
+                                        GDK_ACTION_MOVE);
+  g_signal_connect (strip->view, "drag-begin",
+                    G_CALLBACK (strip_drag_begin), strip);
+  g_signal_connect (strip->view, "drag-data-get",
+                    G_CALLBACK (strip_drag_data_get), strip);
+  g_signal_connect (strip->view, "drag-data-delete",
+                    G_CALLBACK (strip_drag_data_delete), strip);
+  g_signal_connect (strip->view, "drag-data-received",
+                    G_CALLBACK (strip_drag_data_received), strip);
+
+  /*  nothing to show until a vector layer is set  */
+  gtk_widget_set_no_show_all (GTK_WIDGET (strip), TRUE);
+}
+
+static void
+chopgimp_objects_strip_dispose (GObject *object)
+{
+  ChopGimpObjectsStrip *strip = CHOPGIMP_OBJECTS_STRIP (object);
+
+  chopgimp_objects_strip_set_layer (strip, NULL);
+
+  if (strip->rebuild_id)
+    {
+      g_source_remove (strip->rebuild_id);
+      strip->rebuild_id = 0;
+    }
+
+  if (strip->sync_id)
+    {
+      g_source_remove (strip->sync_id);
+      strip->sync_id = 0;
+    }
+
+  G_OBJECT_CLASS (parent_class)->dispose (object);
+}
+
+static void
+chopgimp_objects_strip_finalize (GObject *object)
+{
+  ChopGimpObjectsStrip *strip = CHOPGIMP_OBJECTS_STRIP (object);
+
+  g_hash_table_unref (strip->expanded);
+  g_array_free (strip->drag_ids, TRUE);
+  g_free (strip->signature);
+
+  G_OBJECT_CLASS (parent_class)->finalize (object);
+}
+
+
+/*  ─── public functions ──────────────────────────────────────────────── */
+
+GtkWidget *
+chopgimp_objects_strip_new (void)
+{
+  return g_object_new (CHOPGIMP_TYPE_OBJECTS_STRIP, NULL);
+}
+
+static void
+strip_layer_finalized (gpointer  data,
+                       GObject  *where_the_object_was)
+{
+  ChopGimpObjectsStrip *strip = CHOPGIMP_OBJECTS_STRIP (data);
+
+  strip->layer = NULL;
+  strip_queue_rebuild (strip);
+}
+
+void
+chopgimp_objects_strip_set_layer (ChopGimpObjectsStrip *strip,
+                                  GimpLayer            *layer)
+{
+  GimpVectorLayer *vlayer = NULL;
+
+  g_return_if_fail (CHOPGIMP_IS_OBJECTS_STRIP (strip));
+
+  if (layer && GIMP_IS_VECTOR_LAYER (layer) && chopgimp_vobjects_enabled ())
+    vlayer = GIMP_VECTOR_LAYER (layer);
+
+  if (vlayer == strip->layer)
+    return;
+
+  if (strip->layer)
+    {
+      g_signal_handlers_disconnect_by_data (strip->layer, strip);
+      g_object_weak_unref (G_OBJECT (strip->layer), strip_layer_finalized, strip);
+    }
+
+  strip->layer = vlayer;
+  g_hash_table_remove_all (strip->expanded);
+
+  if (strip->layer)
+    {
+      g_object_weak_ref (G_OBJECT (strip->layer), strip_layer_finalized, strip);
+      g_signal_connect (strip->layer, "objects-changed",
+                        G_CALLBACK (strip_layer_objects_changed), strip);
+      g_signal_connect (strip->layer, "object-selection-changed",
+                        G_CALLBACK (strip_layer_selection_changed), strip);
+    }
+
+  if (strip->rebuild_id)
+    {
+      g_source_remove (strip->rebuild_id);
+      strip->rebuild_id = 0;
+    }
+
+  /*  at once: the strip shows / hides with the selection, no flicker  */
+  if (! gtk_widget_in_destruction (GTK_WIDGET (strip)))
+    strip_rebuild (strip, TRUE);
+}
