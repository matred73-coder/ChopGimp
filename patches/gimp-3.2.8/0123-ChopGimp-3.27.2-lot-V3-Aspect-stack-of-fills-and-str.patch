+static void
+stroke_toggle (GtkToggleButton *button,
+               Panel           *p)
+{
+  Field        field = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (button), "chopgimp-field"));
+  gint         value = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (button), "chopgimp-value"));
+  FieldChange  fc    = { stroke_ref (), field };
+
+  if (p->loading || ! gtk_toggle_button_get_active (button))
+    {
+      /*  a toggle of the group stays down  */
+      if (! p->loading)
+        {
+          p->loading = TRUE;
+          gtk_toggle_button_set_active (button, TRUE);
+          p->loading = FALSE;
+        }
+      return;
+    }
+
+  fc.ivalue = value;
+  panel_change (p, &fc, 0, _("Contour"));
+}
+
+static void
+stroke_spin (GtkSpinButton *spin,
+             Panel         *p)
+{
+  Field       field = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (spin), "chopgimp-field"));
+  FieldChange fc    = { stroke_ref (), field };
+
+  fc.value = gtk_spin_button_get_value (spin);
+
+  if (field == F_ARROW_SCALE)
+    fc.value /= 100.0;
+
+  panel_change (p, &fc, 400 + field, _("Contour"));
+}
+
+static gdouble
+current_width (Panel *p)
+{
+  ChopGimpVObject *leaf;
+  GList           *targets = panel_reference (p, &leaf);
+  ChopGimpVEntry  *e       = leaf ? ref_entry (&leaf->style, stroke_ref ()) : NULL;
+  gdouble          w       = e ? e->width : 1.0;
+
+  g_list_free (targets);
+
+  return MAX (w, 0.01);
+}
+
+static void
+stroke_dashes_changed (GtkWidget *widget,
+                       Panel     *p)
+{
+  FieldChange fc     = { stroke_ref (), F_DASHES };
+  GArray     *dashes = g_array_new (FALSE, FALSE, sizeof (gdouble));
+  gdouble     width  = current_width (p);
+  gint        preset;
+
+  if (p->loading)
+    {
+      g_array_free (dashes, TRUE);
+      return;
+    }
+
+  preset = gtk_combo_box_get_active (GTK_COMBO_BOX (p->s_dash_preset));
+
+  if (widget == p->s_dash_preset && preset >= 0 &&
+      strcmp (dash_presets[preset].name, "custom"))
+    {
+      for (gint i = 0; i < dash_presets[preset].n; i++)
+        g_array_append_val (dashes, dash_presets[preset].d[i]);
+
+      fc.ivalue = ! strcmp (dash_presets[preset].name, "dot-round");
+    }
+  else
+    {
+      /*  dash / gap pairs, in pixels → multiples of the width  */
+      for (gint i = 0; i < 6; i += 2)
+        {
+          gdouble d = gtk_spin_button_get_value (GTK_SPIN_BUTTON (p->s_dash[i]));
+          gdouble g = gtk_spin_button_get_value (GTK_SPIN_BUTTON (p->s_dash[i + 1]));
+
+          if (d <= 0.0 && g <= 0.0)
+            break;
+
+          d /= width;
+          g /= width;
+          g_array_append_val (dashes, d);
+          g_array_append_val (dashes, g);
+        }
+    }
+
+  fc.dashes = dashes;
+  panel_change (p, &fc, widget == p->s_dash_preset ? 0 : 500, _("Contour : tirets"));
+  g_array_free (dashes, TRUE);
+}
+
+static void
+stroke_combo (GtkComboBox *combo,
+              Panel       *p)
+{
+  Field        field = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (combo), "chopgimp-field"));
+  FieldChange  fc    = { stroke_ref (), field };
+  gint         i     = gtk_combo_box_get_active (combo);
+
+  if (i < 0)
+    return;
+
+  if (field == F_PROFILE)
+    fc.str = chopgimp_vstyle_get_profile_presets ()[i];
+  else
+    fc.str = arrows[i].name;
+
+  panel_change (p, &fc, 0, field == F_PROFILE ? _("Contour : profil de largeur")
+                                              : _("Contour : flèches"));
+}
+
+static void
+stroke_add_clicked (GtkButton *button,
+                    Panel     *p)
+{
+  panel_apply (p, 0, _("Ajouter un contour"), apply_add,
+               GINT_TO_POINTER (CHOPGIMP_VENTRY_STROKE));
+  current.kind = CHOPGIMP_VENTRY_STROKE;
+  current.nth  = 0;
+  refresh_all ();
+}
+
+static GtkWidget *
+toggle_group (Panel       *p,
+              GtkWidget  **toggles,
+              Field        field,
+              const gchar *labels[3],
+              const gint   values[3],
+              const gchar *tips[3])
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+
+  gtk_style_context_add_class (gtk_widget_get_style_context (box), "linked");
+
+  for (gint i = 0; i < 3; i++)
+    {
+      toggles[i] = gtk_toggle_button_new_with_label (labels[i]);
+      g_object_set_data (G_OBJECT (toggles[i]), "chopgimp-field", GINT_TO_POINTER (field));
+      g_object_set_data (G_OBJECT (toggles[i]), "chopgimp-value", GINT_TO_POINTER (values[i]));
+      gimp_help_set_help_data (toggles[i], tips[i], NULL);
+      g_signal_connect (toggles[i], "toggled", G_CALLBACK (stroke_toggle), p);
+      gtk_box_pack_start (GTK_BOX (box), toggles[i], TRUE, TRUE, 0);
+    }
+
+  return box;
+}
+
+static void
+grid_row (GtkWidget   *grid,
+          gint         row,
+          const gchar *label,
+          GtkWidget   *widget)
+{
+  GtkWidget *l = gtk_label_new (label);
+
+  gtk_label_set_xalign (GTK_LABEL (l), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (l), "dim-label");
+  gtk_grid_attach (GTK_GRID (grid), l, 0, row, 1, 1);
+  gtk_widget_set_hexpand (widget, TRUE);
+  gtk_grid_attach (GTK_GRID (grid), widget, 1, row, 1, 1);
+}
+
+static GtkWidget *
+stroke_spin_new (Panel  *p,
+                 Field   field,
+                 gdouble lower,
+                 gdouble upper,
+                 gdouble step,
+                 gint    digits)
+{
+  GtkWidget *spin = spin_new (lower, upper, step, digits);
+
+  g_object_set_data (G_OBJECT (spin), "chopgimp-field", GINT_TO_POINTER (field));
+  g_signal_connect (spin, "value-changed", G_CALLBACK (stroke_spin), p);
+
+  return spin;
+}
+
+static void
+stroke_build (Panel     *p,
+              GtkWidget *box)
+{
+  static const gchar *align_l[3] = { N_("Centre"), N_("Intérieur"), N_("Extérieur") };
+  static const gint   align_v[3] = { CHOPGIMP_STROKE_ALIGN_CENTER,
+                                     CHOPGIMP_STROKE_ALIGN_INSIDE,
+                                     CHOPGIMP_STROKE_ALIGN_OUTSIDE };
+  static const gchar *align_t[3] = { N_("Contour centré sur le tracé"),
+                                     N_("Contour à l'intérieur (formes fermées)"),
+                                     N_("Contour à l'extérieur (formes fermées)") };
+  static const gchar *cap_l[3]   = { N_("Plate"), N_("Arrondie"), N_("Carrée") };
+  static const gint   cap_v[3]   = { GIMP_CAP_BUTT, GIMP_CAP_ROUND, GIMP_CAP_SQUARE };
+  static const gchar *cap_t[3]   = { N_("Extrémité plate"), N_("Extrémité arrondie"),
+                                     N_("Extrémité carrée (dépasse d'une demi-épaisseur)") };
+  static const gchar *join_l[3]  = { N_("Pointu"), N_("Arrondi"), N_("Biseau") };
+  static const gint   join_v[3]  = { GIMP_JOIN_MITER, GIMP_JOIN_ROUND, GIMP_JOIN_BEVEL };
+  static const gchar *join_t[3]  = { N_("Angle pointu (limite ci-dessous)"),
+                                     N_("Angle arrondi"), N_("Angle biseauté") };
+  const gchar *l[3], *t[3];
+  GtkWidget   *grid;
+  GtkWidget   *hbox;
+  GtkWidget   *button;
+  gint         row = 0;
+
+  /*  no stroke: a button  */
+  p->no_stroke = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_box_pack_start (GTK_BOX (box), p->no_stroke, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (p->no_stroke),
+                      gtk_label_new (_("L'objet n'a pas de contour.")), FALSE, FALSE, 0);
+  button = gtk_button_new_with_label (_("Ajouter un contour"));
+  g_signal_connect (button, "clicked", G_CALLBACK (stroke_add_clicked), p);
+  gtk_box_pack_start (GTK_BOX (p->no_stroke), button, FALSE, FALSE, 0);
+  gtk_widget_show_all (p->no_stroke);
+  gtk_widget_set_no_show_all (p->no_stroke, TRUE);
+
+  grid = gtk_grid_new ();
+  gtk_grid_set_row_spacing (GTK_GRID (grid), 4);
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 6);
+  gtk_box_pack_start (GTK_BOX (box), grid, FALSE, FALSE, 0);
+  p->stroke_box = grid;
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  p->s_width = stroke_spin_new (p, F_WIDTH, 0.0, 1000.0, 0.5, 1);
+  gtk_box_pack_start (GTK_BOX (hbox), p->s_width, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (hbox), gtk_label_new ("px"), FALSE, FALSE, 0);
+  grid_row (grid, row++, _("Épaisseur"), hbox);
+
+  for (gint i = 0; i < 3; i++) l[i] = _(align_l[i]), t[i] = _(align_t[i]);
+  grid_row (grid, row++, _("Alignement"),
+            toggle_group (p, p->s_align, F_ALIGN, l, align_v, t));
+
+  for (gint i = 0; i < 3; i++) l[i] = _(cap_l[i]), t[i] = _(cap_t[i]);
+  grid_row (grid, row++, _("Extrémités"),
+            toggle_group (p, p->s_cap, F_CAP, l, cap_v, t));
+
+  for (gint i = 0; i < 3; i++) l[i] = _(join_l[i]), t[i] = _(join_t[i]);
+  grid_row (grid, row++, _("Angles"),
+            toggle_group (p, p->s_join, F_JOIN, l, join_v, t));
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  p->s_miter = stroke_spin_new (p, F_MITER, 1.0, 100.0, 1.0, 1);
+  gtk_box_pack_start (GTK_BOX (hbox), p->s_miter, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (hbox), gtk_label_new ("×"), FALSE, FALSE, 0);
+  grid_row (grid, row++, _("Limite"), hbox);
+
+  /*  dashes  */
+  p->s_dash_preset = gtk_combo_box_text_new ();
+  for (guint k = 0; k < G_N_ELEMENTS (dash_presets); k++)
+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (p->s_dash_preset),
+                                    _(dash_presets[k].label));
+  g_signal_connect (p->s_dash_preset, "changed", G_CALLBACK (stroke_dashes_changed), p);
+  grid_row (grid, row++, _("Tirets"), p->s_dash_preset);
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 2);
+  for (gint i = 0; i < 6; i++)
+    {
+      p->s_dash[i] = spin_new (0.0, 1000.0, 1.0, 1);
+      gtk_entry_set_width_chars (GTK_ENTRY (p->s_dash[i]), 3);
+      gimp_help_set_help_data (p->s_dash[i], (i % 2) ? _("Espace (px)") : _("Tiret (px)"), NULL);
+      g_signal_connect (p->s_dash[i], "value-changed", G_CALLBACK (stroke_dashes_changed), p);
+      gtk_box_pack_start (GTK_BOX (hbox), p->s_dash[i], TRUE, TRUE, 0);
+    }
+  grid_row (grid, row++, _("Tiret / espace"), hbox);
+
+  /*  arrowheads  */
+  p->s_arrow_start = gtk_combo_box_text_new ();
+  p->s_arrow_end   = gtk_combo_box_text_new ();
+  for (guint k = 0; k < G_N_ELEMENTS (arrows); k++)
+    {
+      gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (p->s_arrow_start), _(arrows[k].label));
+      gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (p->s_arrow_end),   _(arrows[k].label));
+    }
+  g_object_set_data (G_OBJECT (p->s_arrow_start), "chopgimp-field", GINT_TO_POINTER (F_ARROW_START));
+  g_object_set_data (G_OBJECT (p->s_arrow_end),   "chopgimp-field", GINT_TO_POINTER (F_ARROW_END));
+  g_signal_connect (p->s_arrow_start, "changed", G_CALLBACK (stroke_combo), p);
+  g_signal_connect (p->s_arrow_end,   "changed", G_CALLBACK (stroke_combo), p);
+  grid_row (grid, row++, _("Flèche début"), p->s_arrow_start);
+  grid_row (grid, row++, _("Flèche fin"),   p->s_arrow_end);
+
+  hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+  p->s_arrow_scale = stroke_spin_new (p, F_ARROW_SCALE, 10.0, 2000.0, 10.0, 0);
+  gtk_box_pack_start (GTK_BOX (hbox), p->s_arrow_scale, FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (hbox), gtk_label_new ("%"), FALSE, FALSE, 0);
+  grid_row (grid, row++, _("Taille des flèches"), hbox);
+
+  /*  width profile  */
+  p->s_profile = gtk_combo_box_text_new ();
+  for (const gchar * const *n = chopgimp_vstyle_get_profile_presets (); *n; n++)
+    gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (p->s_profile),
+                                    chopgimp_vstyle_get_profile_label (*n));
+  g_object_set_data (G_OBJECT (p->s_profile), "chopgimp-field", GINT_TO_POINTER (F_PROFILE));
+  g_signal_connect (p->s_profile, "changed", G_CALLBACK (stroke_combo), p);
+  gimp_help_set_help_data (p->s_profile,
+                           _("Profil de largeur : le contour s'affine ou "
+                             "s'épaissit le long du tracé (centré, sans "
+                             "tirets)"), NULL);
+  grid_row (grid, row++, _("Profil"), p->s_profile);
+
+  gtk_widget_show_all (grid);
+  gtk_widget_set_no_show_all (grid, TRUE);
+}
+
+static gint
+combo_index_of_arrow (const gchar *name)
+{
+  for (guint k = 0; k < G_N_ELEMENTS (arrows); k++)
+    if (! g_strcmp0 (arrows[k].name, name))
+      return k;
+
+  return 0;
+}
+
+static void
+stroke_load (Panel                *p,
+             const ChopGimpVStyle *st)
+{
+  ChopGimpVEntry *e = ref_entry (st, stroke_ref ());
+  gint            preset = G_N_ELEMENTS (dash_presets) - 1;   /* custom */
+  gint            k;
+
+  gtk_widget_set_visible (p->no_stroke, e == NULL);
+  gtk_widget_set_visible (p->stroke_box, e != NULL);
+
+  if (! e)
+    return;
+
+  gtk_spin_button_set_value (GTK_SPIN_BUTTON (p->s_width), e->width);
+  toggles_set (p->s_align, 3, e->align == CHOPGIMP_STROKE_ALIGN_INSIDE  ? 1 :
+                              e->align == CHOPGIMP_STROKE_ALIGN_OUTSIDE ? 2 : 0);
+  toggles_set (p->s_cap,   3, e->cap  == GIMP_CAP_ROUND  ? 1 : e->cap  == GIMP_CAP_SQUARE ? 2 : 0);
+  toggles_set (p->s_join,  3, e->join == GIMP_JOIN_ROUND ? 1 : e->join == GIMP_JOIN_BEVEL ? 2 : 0);
+  gtk_spin_button_set_value (GTK_SPIN_BUTTON (p->s_miter), e->miter_limit);
+  gtk_widget_set_sensitive (p->s_miter, e->join == GIMP_JOIN_MITER);
+
+  /*  the alignment is for uniform strokes of closed shapes  */
+  for (k = 0; k < 3; k++)
+    gtk_widget_set_sensitive (p->s_align[k], e->profile == NULL);
+
+  if (! e->dashes || e->dashes->len == 0)
+    {
+      preset = 0;
+    }
+  else
+    {
+      for (guint i = 1; i + 1 < G_N_ELEMENTS (dash_presets); i++)
+        {
+          gboolean same = (dash_presets[i].n == (gint) e->dashes->len);
+
+          for (gint j = 0; same && j < dash_presets[i].n; j++)
+            if (fabs (dash_presets[i].d[j] - g_array_index (e->dashes, gdouble, j)) > 1e-6)
+              same = FALSE;
+
+          if (same)
+            {
+              preset = i;
+              break;
+            }
+        }
+    }
+
+  gtk_combo_box_set_active (GTK_COMBO_BOX (p->s_dash_preset), preset);
+
+  for (k = 0; k < 6; k++)
+    {
+      gdouble v = (e->dashes && k < (gint) e->dashes->len) ?
+                  g_array_index (e->dashes, gdouble, k) * e->width : 0.0;
+
+      gtk_spin_button_set_value (GTK_SPIN_BUTTON (p->s_dash[k]), v);
+    }
+
+  gtk_combo_box_set_active (GTK_COMBO_BOX (p->s_arrow_start), combo_index_of_arrow (e->arrow_start));
+  gtk_combo_box_set_active (GTK_COMBO_BOX (p->s_arrow_end),   combo_index_of_arrow (e->arrow_end));
+  gtk_spin_button_set_value (GTK_SPIN_BUTTON (p->s_arrow_scale), e->arrow_scale * 100.0);
+
+  k = 0;
+  if (e->profile)
+    {
+      const gchar * const *names = chopgimp_vstyle_get_profile_presets ();
+
+      for (gint i = 0; names[i]; i++)
+        if (! strcmp (names[i], e->profile))
+          k = i;
+    }
+  gtk_combo_box_set_active (GTK_COMBO_BOX (p->s_profile), k);
+}
+
+
+/*  ─── following the image ───────────────────────────────────────────── */
+
+static void
+panel_set_layer (Panel           *p,
+                 GimpVectorLayer *layer)
+{
+  if (layer == p->layer)
+    return;
+
+  if (p->layer)
+    {
+      g_signal_handlers_disconnect_by_data (p->layer, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->layer), (gpointer *) &p->layer);
+    }
+
+  p->layer = layer;
+
+  if (p->layer)
+    {
+      g_object_add_weak_pointer (G_OBJECT (p->layer), (gpointer *) &p->layer);
+      g_signal_connect_swapped (p->layer, "objects-changed",
+                                G_CALLBACK (panel_queue_refresh), p);
+      g_signal_connect_swapped (p->layer, "object-selection-changed",
+                                G_CALLBACK (panel_queue_refresh), p);
+    }
+}
+
+static void
+panel_set_image (Panel     *p,
+                 GimpImage *image)
+{
+  if (image == p->image)
+    return;
+
+  panel_set_layer (p, NULL);
+
+  if (p->image)
+    {
+      g_signal_handlers_disconnect_by_data (p->image, p);
+      g_object_remove_weak_pointer (G_OBJECT (p->image), (gpointer *) &p->image);
+    }
+
+  p->image = image;
+
+  if (p->image)
+    {
+      g_object_add_weak_pointer (G_OBJECT (p->image), (gpointer *) &p->image);
+      g_signal_connect_swapped (p->image, "selected-layers-changed",
+                                G_CALLBACK (panel_queue_refresh), p);
+    }
+}
+
+static void
+panel_refresh (Panel *p)
+{
+  ChopGimpVObject *leaf    = NULL;
+  GList           *targets = NULL;
+
+  if (! chopgimp_vobjects_enabled ())
+    return;
+
+  panel_set_image (p, gimp_context_get_image (p->context));
+  panel_set_layer (p, panel_find_layer (p));
+
+  targets = panel_reference (p, &leaf);
+
+  gtk_widget_set_visible (p->hint,    leaf == NULL);
+  gtk_widget_set_visible (p->content, leaf != NULL);
+
+  if (leaf)
+    {
+      p->loading = TRUE;
+
+      if (p->kind == PANEL_APPEARANCE)
+        appearance_load (p, &leaf->style);
+      else
+        stroke_load (p, &leaf->style);
+
+      p->loading = FALSE;
+    }
+
+  g_list_free (targets);
+}
+
+static gboolean
+panel_refresh_idle (gpointer data)
+{
+  Panel *p = data;
+
+  p->idle_id = 0;
+  panel_refresh (p);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+panel_queue_refresh (Panel *p)
+{
+  if (! p->idle_id && gtk_widget_get_mapped (p->editor))
+    p->idle_id = g_idle_add (panel_refresh_idle, p);
+}
+
+static void
+panel_image_changed (GimpContext *context,
+                     GimpImage   *image,
+                     Panel       *p)
+{
+  panel_set_image (p, image);
+  panel_queue_refresh (p);
+}
+
+static void
+panel_free (Panel *p)
+{
+  all_panels = g_list_remove (all_panels, p);
+
+  if (p->idle_id)
+    g_source_remove (p->idle_id);
+
+  panel_set_image (p, NULL);
+  g_signal_handlers_disconnect_by_data (p->context, p);
+
+  if (p->rows)
+    g_ptr_array_free (p->rows, TRUE);
+
+  g_free (p->structure);
+  g_free (p);
+}
+
+static GtkWidget *
+panel_new (GimpContext *context,
+           PanelKind    kind)
+{
+  Panel     *p      = g_new0 (Panel, 1);
+  GtkWidget *editor = g_object_new (GIMP_TYPE_EDITOR, NULL);
+  GtkWidget *box    = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+
+  p->gimp    = context->gimp;
+  p->kind    = kind;
+  p->editor  = editor;
+  p->context = gimp_get_user_context (context->gimp);
+
+  gtk_style_context_add_class (gtk_widget_get_style_context (editor),
+                               kind == PANEL_APPEARANCE ? "chopgimp-appearance"
+                                                        : "chopgimp-stroke-panel");
+
+  gtk_container_set_border_width (GTK_CONTAINER (box), 6);
+  gtk_box_pack_start (GTK_BOX (editor), box, TRUE, TRUE, 0);
+  gtk_widget_set_visible (box, TRUE);
+
+  g_object_set_data_full (G_OBJECT (editor), "chopgimp-panel", p,
+                          (GDestroyNotify) panel_free);
+
+  if (! chopgimp_vobjects_enabled ())
+    {
+      GtkWidget *label = gtk_label_new (_("Les objets vectoriels sont désactivés "
+                                          "(CHOPGIMP_NO_VOBJECTS=1)."));
+
+      gtk_label_set_line_wrap (GTK_LABEL (label), TRUE);
+      gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+      gtk_widget_set_visible (label, TRUE);
+
+      p->hint    = label;
+      p->content = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+
+      return editor;
+    }
+
+  p->hint = gtk_label_new (_("Sélectionnez un ou plusieurs objets d'un calque "
+                             "vectoriel (outil Déplacement V, ou la liste "
+                             "Objets du panneau Calques)."));
+  gtk_label_set_line_wrap (GTK_LABEL (p->hint), TRUE);
+  gtk_label_set_xalign (GTK_LABEL (p->hint), 0.0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (p->hint), "dim-label");
+  gtk_box_pack_start (GTK_BOX (box), p->hint, FALSE, FALSE, 0);
+  gtk_widget_set_no_show_all (p->hint, TRUE);
+
+  p->content = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+  gtk_box_pack_start (GTK_BOX (box), p->content, TRUE, TRUE, 0);
+
+  if (kind == PANEL_APPEARANCE)
+    {
+      GtkWidget *hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+      GtkWidget *scrolled;
+      GtkWidget *button;
+
+      gtk_box_pack_start (GTK_BOX (p->content), hbox, FALSE, FALSE, 0);
+
+      button = gtk_button_new_with_label (_("Ajouter un fond"));
+      g_object_set_data (G_OBJECT (button), "chopgimp-kind",
+                         GINT_TO_POINTER (CHOPGIMP_VENTRY_FILL));
+      g_signal_connect (button, "clicked", G_CALLBACK (add_clicked), p);
+      gtk_box_pack_start (GTK_BOX (hbox), button, TRUE, TRUE, 0);
+
+      button = gtk_button_new_with_label (_("Ajouter un contour"));
+      g_object_set_data (G_OBJECT (button), "chopgimp-kind",
+                         GINT_TO_POINTER (CHOPGIMP_VENTRY_STROKE));
+      g_signal_connect (button, "clicked", G_CALLBACK (add_clicked), p);
+      gtk_box_pack_start (GTK_BOX (hbox), button, TRUE, TRUE, 0);
+
+      scrolled = gtk_scrolled_window_new (NULL, NULL);
+      gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scrolled),
+                                      GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+      gtk_box_pack_start (GTK_BOX (p->content), scrolled, TRUE, TRUE, 0);
+
+      p->list = gtk_list_box_new ();
+      gtk_list_box_set_selection_mode (GTK_LIST_BOX (p->list), GTK_SELECTION_SINGLE);
+      gtk_list_box_set_activate_on_single_click (GTK_LIST_BOX (p->list), TRUE);
+      g_signal_connect (p->list, "row-selected", G_CALLBACK (row_selected), p);
+      gtk_container_add (GTK_CONTAINER (scrolled), p->list);
+
+      p->rows = g_ptr_array_new ();
+
+      gtk_widget_show_all (p->content);
+
+#define ADD(icon, tip, action, field)                                          \
+      p->field = gimp_editor_add_button (GIMP_EDITOR (editor), icon, tip, NULL, \
+                                         G_CALLBACK (editor_button_clicked),    \
+                                         NULL, G_OBJECT (editor));              \
+      g_object_set_data (G_OBJECT (p->field), "chopgimp-action", action);
+
+      ADD (GIMP_ICON_OBJECT_DUPLICATE, _("Dupliquer le fond ou le contour sélectionné"),
+           "duplicate", dup_button);
+      ADD (GIMP_ICON_EDIT_DELETE, _("Supprimer le fond ou le contour sélectionné"),
+           "delete", del_button);
+      ADD (GIMP_ICON_GO_UP, _("Monter (dessiné plus haut)"), "up", up_button);
+      ADD (GIMP_ICON_GO_DOWN, _("Descendre (dessiné plus bas)"), "down", down_button);
+#undef ADD
+    }
+  else
+    {
+      stroke_build (p, p->content);
+      gtk_widget_set_visible (p->content, TRUE);
+    }
+
+  gtk_widget_set_no_show_all (p->content, TRUE);
+
+  g_signal_connect (p->context, "image-changed",
+                    G_CALLBACK (panel_image_changed), p);
+  g_signal_connect_data (editor, "map", G_CALLBACK (panel_queue_refresh), p, NULL,
+                         G_CONNECT_SWAPPED | G_CONNECT_AFTER);
+
+  all_panels = g_list_prepend (all_panels, p);
+
+  panel_set_image (p, gimp_context_get_image (p->context));
+  panel_refresh (p);
+
+  return editor;
+}
+
+
+/*  ─── public functions ──────────────────────────────────────────────── */
+
+GtkWidget *
+chopgimp_appearance_editor_new (GimpDialogFactory *factory,
+                                GimpContext       *context,
+                                GimpUIManager     *ui_manager,
+                                gint               view_size)
+{
+  return panel_new (context, PANEL_APPEARANCE);
+}
+
+GtkWidget *
+chopgimp_stroke_editor_new (GimpDialogFactory *factory,
+                            GimpContext       *context,
+                            GimpUIManager     *ui_manager,
+                            gint               view_size)
+{
+  return panel_new (context, PANEL_STROKE);
+}
