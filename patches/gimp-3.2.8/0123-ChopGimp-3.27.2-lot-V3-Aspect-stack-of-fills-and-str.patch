+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*  Under the layers list (and the « fx » strip), for the one selected
+ *  vector layer:
+ *
+ *    ▾ ◇ Objets  4
+ *      👁 🔒 ■ Cercle
+ *      👁    ▸ 🗀 Groupe
+ *      👁    ■ Tracé (vide)
+ *
+ *  - top of the stack first, as the layers;
+ *  - a click selects the object on the canvas (Maj / Ctrl: several), and
+ *    the canvas selection is shown here;
+ *  - the eye shows / hides, the padlock locks (one undo step each);
+ *  - a double click renames;
+ *  - drag and drop reorders, into a group (on its row) or out of it;
+ *  - groups expand / collapse (the selected objects are always shown).
+ *
+ *  As the « fx » strip of 3.26.1: the rows of the layers list stay one per
+ *  layer (GimpContainerTreeView rows are viewables), hence this strip
+ *  with its own small tree.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <cairo.h>
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpcolor/gimpcolor.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "widgets-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpimage.h"
+#include "core/gimplayer.h"
+#include "core/gimprasterizable.h"
+
+#include "path/gimppath.h"
+#include "path/gimpvectorlayer.h"
+#include "path/chopgimp-vobject.h"
+
+#include "chopgimp-objects-strip.h"
+#include "chopgimp-panels.h"
+
+#include "gimp-intl.h"
+
+
+#define REBUILD_DELAY   120   /* ms: bursts of changes (a drag) */
+#define SWATCH_SIZE     16
+#define MAX_HEIGHT      260
+
+enum
+{
+  COL_ID,
+  COL_NAME,
+  COL_RAW_NAME,
+  COL_EYE,
+  COL_LOCK,
+  COL_SWATCH,
+  COL_ICON,
+  COL_DIM,
+  COL_IS_GROUP,
+  N_COLS
+};
+
+struct _ChopGimpObjectsStrip
+{
+  GtkBox             parent_instance;
+
+  GimpVectorLayer   *layer;           /* weak */
+
+  GtkWidget         *arrow;
+  GtkWidget         *count;
+  GtkWidget         *scrolled;
+  GtkWidget         *view;
+  GtkTreeStore      *store;
+  GtkTreeViewColumn *eye_column;
+  GtkTreeViewColumn *lock_column;
+  GtkTreeViewColumn *name_column;
+  GtkCellRenderer   *name_cell;
+
+  GHashTable        *expanded;        /* group ids the user expanded */
+  gchar             *signature;       /* of what the tree shows      */
+  gboolean           updating;
+  guint              rebuild_id;
+  guint              sync_id;
+  GArray            *drag_ids;
+};
+
+
+static void   chopgimp_objects_strip_dispose  (GObject              *object);
+static void   chopgimp_objects_strip_finalize (GObject              *object);
+
+static void   strip_rebuild                   (ChopGimpObjectsStrip *strip,
+                                               gboolean              force);
+static void   strip_sync_selection            (ChopGimpObjectsStrip *strip);
+static void   strip_queue_rebuild             (ChopGimpObjectsStrip *strip);
+static void   strip_queue_sync                (ChopGimpObjectsStrip *strip);
+
+
+G_DEFINE_TYPE (ChopGimpObjectsStrip, chopgimp_objects_strip, GTK_TYPE_BOX)
+
+#define parent_class chopgimp_objects_strip_parent_class
+
+
+/*  the list is shown or not for all the strips, for the session  */
+static gboolean strip_expanded = TRUE;
+
+static const GtkTargetEntry strip_targets[] =
+{
+  { "CHOPGIMP_VOBJECT", GTK_TARGET_SAME_WIDGET, 0 }
+};
+
+
+/*  ─── helpers ───────────────────────────────────────────────────────── */
+
+static GimpImage *
+strip_image (ChopGimpObjectsStrip *strip)
+{
+  return strip->layer ? gimp_item_get_image (GIMP_ITEM (strip->layer)) : NULL;
+}
+
+static ChopGimpVObject *
+strip_root (ChopGimpObjectsStrip *strip)
+{
+  if (! strip->layer || ! chopgimp_vobjects_enabled () ||
+      ! gimp_item_is_attached (GIMP_ITEM (strip->layer)))
+    return NULL;
+
+  return chopgimp_vlayer_get_root (strip->layer);
+}
+
+static gboolean
+object_is_empty (ChopGimpVObject *o)
+{
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    return ! o->path || gimp_path_get_n_strokes (o->path) == 0;
+
+  for (guint i = 0; i < o->children->len; i++)
+    if (! object_is_empty (g_ptr_array_index (o->children, i)))
+      return FALSE;
+
+  return TRUE;
+}
+
+static void
+color_u8 (GeglColor *color,
+          guchar     rgba[4])
+{
+  if (color)
+    gegl_color_get_pixel (color, babl_format ("R'G'B'A u8"), rgba);
+  else
+    rgba[0] = rgba[1] = rgba[2] = rgba[3] = 0;
+}
+
+/*  the primary fill and stroke colors (alpha 0: none)  */
+static void
+object_colors (ChopGimpVObject *o,
+               guchar           fill[4],
+               guchar           stroke[4])
+{
+  const ChopGimpVEntry *f = chopgimp_vstyle_get_fill (&o->style);
+  const ChopGimpVEntry *s = chopgimp_vstyle_get_stroke (&o->style);
+
+  color_u8 (f && chopgimp_ventry_is_painted (f) ?
+            chopgimp_vpaint_get_main_color (&f->paint) : NULL, fill);
+  color_u8 (s && chopgimp_ventry_is_painted (s) ?
+            chopgimp_vpaint_get_main_color (&s->paint) : NULL, stroke);
+
+  /*  a pattern: grey  */
+  if (f && chopgimp_ventry_is_painted (f) && f->paint.type == CHOPGIMP_PAINT_PATTERN)
+    fill[0] = fill[1] = fill[2] = 128, fill[3] = 255;
+  if (s && chopgimp_ventry_is_painted (s) && s->paint.type == CHOPGIMP_PAINT_PATTERN)
+    stroke[0] = stroke[1] = stroke[2] = 128, stroke[3] = 255;
+}
+
+static GdkPixbuf *
+object_swatch (ChopGimpVObject *o)
+{
+  cairo_surface_t *surf = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+                                                      SWATCH_SIZE, SWATCH_SIZE);
+  cairo_t         *cr   = cairo_create (surf);
+  GdkPixbuf       *pixbuf;
+  guchar           fill[4], stroke[4];
+
+  object_colors (o, fill, stroke);
+
+  /*  checks under a transparent fill  */
+  cairo_set_source_rgb (cr, 0.8, 0.8, 0.8);
+  cairo_rectangle (cr, 1, 1, SWATCH_SIZE - 2, SWATCH_SIZE - 2);
+  cairo_fill (cr);
+  cairo_set_source_rgb (cr, 0.6, 0.6, 0.6);
+  cairo_rectangle (cr, 1, 1, (SWATCH_SIZE - 2) / 2, (SWATCH_SIZE - 2) / 2);
+  cairo_rectangle (cr, SWATCH_SIZE / 2, SWATCH_SIZE / 2,
+                   (SWATCH_SIZE - 2) / 2, (SWATCH_SIZE - 2) / 2);
+  cairo_fill (cr);
+
+  if (fill[3])
+    {
+      cairo_set_source_rgba (cr, fill[0] / 255.0, fill[1] / 255.0,
+                             fill[2] / 255.0, fill[3] / 255.0);
+      cairo_rectangle (cr, 1, 1, SWATCH_SIZE - 2, SWATCH_SIZE - 2);
+      cairo_fill (cr);
+    }
+  else
+    {
+      /*  no fill: a red diagonal  */
+      cairo_set_source_rgb (cr, 0.85, 0.1, 0.1);
+      cairo_set_line_width (cr, 1.5);
+      cairo_move_to (cr, 2, SWATCH_SIZE - 2);
+      cairo_line_to (cr, SWATCH_SIZE - 2, 2);
+      cairo_stroke (cr);
+    }
+
+  if (stroke[3])
+    {
+      cairo_set_source_rgba (cr, stroke[0] / 255.0, stroke[1] / 255.0,
+                             stroke[2] / 255.0, stroke[3] / 255.0);
+      cairo_set_line_width (cr, 3.0);
+      cairo_rectangle (cr, 2.5, 2.5, SWATCH_SIZE - 5, SWATCH_SIZE - 5);
+    }
+  else
+    {
+      cairo_set_source_rgba (cr, 0.4, 0.4, 0.4, 0.8);
+      cairo_set_line_width (cr, 1.0);
+      cairo_rectangle (cr, 0.5, 0.5, SWATCH_SIZE - 1, SWATCH_SIZE - 1);
+    }
+  cairo_stroke (cr);
+
+  cairo_destroy (cr);
+  cairo_surface_flush (surf);
+
+  pixbuf = gdk_pixbuf_get_from_surface (surf, 0, 0, SWATCH_SIZE, SWATCH_SIZE);
+  cairo_surface_destroy (surf);
+
+  return pixbuf;
+}
+
+static gchar *
+object_label (ChopGimpVObject *o,
+              gint             index)
+{
+  const gchar *name = o->name;
+  GString     *s    = g_string_new (NULL);
+
+  if (name && *name)
+    g_string_append (s, name);
+  else if (o->kind == CHOPGIMP_VOBJECT_GROUP)
+    g_string_append (s, _("Groupe"));
+  else
+    g_string_append_printf (s, _("Objet %d"), index + 1);
+
+  if (o->kind == CHOPGIMP_VOBJECT_GROUP && o->clip)
+    g_string_append (s, _(" (masque d'écrêtage)"));
+
+  if (object_is_empty (o))
+    g_string_append (s, _(" (vide)"));
+
+  return g_string_free (s, FALSE);
+}
+
+/*  what the tree shows, to rebuild it only when it changed  */
+static void
+signature_of (GString         *s,
+              ChopGimpVObject *o)
+{
+  guchar fill[4], stroke[4];
+
+  if (o->kind == CHOPGIMP_VOBJECT_PATH)
+    object_colors (o, fill, stroke);
+  else
+    memset (fill, 0, 4), memset (stroke, 0, 4);
+
+  g_string_append_printf (s, "%u%c%d%d%d%d|%s|%02x%02x%02x%02x%02x%02x%02x%02x",
+                          o->id,
+                          o->kind == CHOPGIMP_VOBJECT_GROUP ? 'g' : 'p',
+                          o->visible, o->locked, o->clip,
+                          o->kind == CHOPGIMP_VOBJECT_PATH ? object_is_empty (o) : 0,
+                          o->name ? o->name : "",
+                          fill[0], fill[1], fill[2], fill[3],
+                          stroke[0], stroke[1], stroke[2], stroke[3]);
+
+  if (o->children)
+    {
+      g_string_append_c (s, '[');
+      for (guint i = 0; i < o->children->len; i++)
+        signature_of (s, g_ptr_array_index (o->children, i));
+      g_string_append_c (s, ']');
+    }
+
+  g_string_append_c (s, ';');
+}
+
+static void
+strip_add_children (ChopGimpObjectsStrip *strip,
+                    GtkTreeIter          *parent,
+                    ChopGimpVObject      *group)
+{
+  /*  top of the stack first  */
+  for (gint i = group->children->len - 1; i >= 0; i--)
+    {
+      ChopGimpVObject *o     = g_ptr_array_index (group->children, i);
+      gboolean         grp   = (o->kind == CHOPGIMP_VOBJECT_GROUP);
+      gchar           *label = object_label (o, i);
+      GdkPixbuf       *swatch = grp ? NULL : object_swatch (o);
+      GtkTreeIter      iter;
+
+      gtk_tree_store_insert_with_values (strip->store, &iter, parent, -1,
+                                         COL_ID,       o->id,
+                                         COL_NAME,     label,
+                                         COL_RAW_NAME, o->name ? o->name : "",
+                                         COL_EYE,      o->visible ? GIMP_ICON_VISIBLE : NULL,
+                                         COL_LOCK,     o->locked  ? GIMP_ICON_LOCK    : NULL,
+                                         COL_SWATCH,   swatch,
+                                         COL_ICON,     grp ? "gimp-group-layer" : NULL,
+                                         COL_DIM,      (! o->visible || object_is_empty (o)),
+                                         COL_IS_GROUP, grp,
+                                         -1);
+      g_free (label);
+      if (swatch)
+        g_object_unref (swatch);
+
+      if (grp)
+        strip_add_children (strip, &iter, o);
+    }
+}
+
+static gint
+strip_count (ChopGimpVObject *o)
+{
+  gint n = 0;
+
+  if (o->children)
+    for (guint i = 0; i < o->children->len; i++)
+      n += 1 + strip_count (g_ptr_array_index (o->children, i));
+
+  return n;
+}
+
+typedef struct
+{
+  guint        id;
+  GtkTreePath *path;
+} FindData;
+
+static gboolean
+find_row (GtkTreeModel *model,
+          GtkTreePath  *path,
+          GtkTreeIter  *iter,
+          gpointer      data)
+{
+  FindData *fd = data;
+  guint     id;
+
+  gtk_tree_model_get (model, iter, COL_ID, &id, -1);
+
+  if (id == fd->id)
+    {
+      fd->path = gtk_tree_path_copy (path);
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+static GtkTreePath *
+strip_path_of (ChopGimpObjectsStrip *strip,
+               guint                 id)
+{
+  FindData fd = { id, NULL };
+
+  gtk_tree_model_foreach (GTK_TREE_MODEL (strip->store), find_row, &fd);
+
+  return fd.path;
+}
+
+static guint
+strip_id_at (ChopGimpObjectsStrip *strip,
+             GtkTreePath          *path)
+{
+  GtkTreeIter iter;
+  guint       id = 0;
+
+  if (gtk_tree_model_get_iter (GTK_TREE_MODEL (strip->store), &iter, path))
+    gtk_tree_model_get (GTK_TREE_MODEL (strip->store), &iter, COL_ID, &id, -1);
+
+  return id;
+}
+
+static void
+strip_restore_expanded (ChopGimpObjectsStrip *strip)
+{
+  GHashTableIter iter;
+  gpointer       key;
+  GList         *gone = NULL;
+
+  g_hash_table_iter_init (&iter, strip->expanded);
+
+  while (g_hash_table_iter_next (&iter, &key, NULL))
+    {
+      GtkTreePath *path = strip_path_of (strip, GPOINTER_TO_UINT (key));
+
+      if (path)
+        {
+          gtk_tree_view_expand_row (GTK_TREE_VIEW (strip->view), path, FALSE);
+          gtk_tree_path_free (path);
+        }
+      else
+        {
+          gone = g_list_prepend (gone, key);
+        }
+    }
+
+  for (GList *l = gone; l; l = l->next)
+    g_hash_table_remove (strip->expanded, l->data);
+
+  g_list_free (gone);
+}
+
+
+/*  ─── rebuilding ────────────────────────────────────────────────────── */
+
+static void
+strip_update_header (ChopGimpObjectsStrip *strip,
+                     ChopGimpVObject      *root)
+{
+  gchar *text = g_strdup_printf ("%d", root ? strip_count (root) : 0);
+
+  gtk_label_set_text (GTK_LABEL (strip->count), text);
+  g_free (text);
+
+  gtk_image_set_from_icon_name (GTK_IMAGE (strip->arrow),
+                                strip_expanded ?
+                                "pan-down-symbolic" : "pan-end-symbolic",
+                                GTK_ICON_SIZE_MENU);
+  gtk_widget_set_visible (strip->scrolled, strip_expanded);
+}
+
+static void
+strip_rebuild (ChopGimpObjectsStrip *strip,
+               gboolean              force)
+{
+  ChopGimpVObject *root = strip_root (strip);
+  GString         *sig;
+
+  if (! root)
+    {
+      g_clear_pointer (&strip->signature, g_free);
+      strip->updating = TRUE;
+      gtk_tree_store_clear (strip->store);
+      strip->updating = FALSE;
+      gtk_widget_set_visible (GTK_WIDGET (strip), FALSE);
+      return;
+    }
+
+  sig = g_string_new (NULL);
+  signature_of (sig, root);
+
+  if (force || g_strcmp0 (sig->str, strip->signature))
+    {
+      GtkAdjustment *vadj  = gtk_scrolled_window_get_vadjustment (GTK_SCROLLED_WINDOW (strip->scrolled));
+      gdouble        value = gtk_adjustment_get_value (vadj);
+
+      g_free (strip->signature);
+      strip->signature = g_strdup (sig->str);
+
+      strip->updating = TRUE;
+      gtk_tree_store_clear (strip->store);
+      strip_add_children (strip, NULL, root);
+      strip_restore_expanded (strip);
+      strip->updating = FALSE;
+
+      gtk_adjustment_set_value (vadj, value);
+    }
+
+  g_string_free (sig, TRUE);
+
+  strip_update_header (strip, root);
+  strip_sync_selection (strip);
+
+  gtk_widget_set_visible (GTK_WIDGET (strip), TRUE);
+}
+
+static gboolean
+strip_rebuild_timeout (gpointer data)
+{
+  ChopGimpObjectsStrip *strip = data;
+
+  strip->rebuild_id = 0;
+  strip_rebuild (strip, FALSE);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+strip_queue_rebuild (ChopGimpObjectsStrip *strip)
+{
+  if (! strip->rebuild_id)
+    strip->rebuild_id = g_timeout_add (REBUILD_DELAY, strip_rebuild_timeout, strip);
+}
+
+static void
+strip_sync_selection (ChopGimpObjectsStrip *strip)
+{
+  GtkTreeSelection *sel = gtk_tree_view_get_selection (GTK_TREE_VIEW (strip->view));
+  const guint      *ids;
+  gint              n = 0;
+  gboolean          scrolled = FALSE;
+
+  if (! strip->layer || ! strip->signature)
+    return;
+
+  ids = chopgimp_vlayer_get_selection (strip->layer, &n);
+
+  strip->updating = TRUE;
+
+  gtk_tree_selection_unselect_all (sel);
+
+  for (gint i = 0; i < n; i++)
+    {
+      GtkTreePath *path = strip_path_of (strip, ids[i]);
+
+      if (! path)
+        continue;
+
+      /*  a selected object is always shown  */
+      if (gtk_tree_path_get_depth (path) > 1)
+        {
+          GtkTreePath *parent = gtk_tree_path_copy (path);
+
+          gtk_tree_path_up (parent);
+          gtk_tree_view_expand_to_path (GTK_TREE_VIEW (strip->view), parent);
+          gtk_tree_path_free (parent);
+        }
+
+      gtk_tree_selection_select_path (sel, path);
+
+      if (! scrolled && gtk_widget_get_realized (strip->view))
+        {
+          gtk_tree_view_scroll_to_cell (GTK_TREE_VIEW (strip->view), path,
+                                        NULL, FALSE, 0, 0);
+          scrolled = TRUE;
+        }
+
+      gtk_tree_path_free (path);
+    }
+
+  strip->updating = FALSE;
+}
+
+static gboolean
+strip_sync_idle (gpointer data)
+{
+  ChopGimpObjectsStrip *strip = data;
+
+  strip->sync_id = 0;
+  strip_sync_selection (strip);
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+strip_queue_sync (ChopGimpObjectsStrip *strip)
+{
+  if (! strip->sync_id)
+    strip->sync_id = g_idle_add (strip_sync_idle, strip);
+}
+
+
+/*  ─── user actions ──────────────────────────────────────────────────── */
+
+static void
+strip_flush (ChopGimpObjectsStrip *strip)
+{
+  GimpImage *image = strip_image (strip);
+
+  if (image)
+    gimp_image_flush (image);
+}
+
+static void
+strip_selection_changed (GtkTreeSelection     *sel,
+                         ChopGimpObjectsStrip *strip)
+{
+  GList           *rows;
+  GArray          *ids;
+  ChopGimpVObject *parent = NULL;
+  gboolean         same   = TRUE;
+
+  if (strip->updating || ! strip->layer)
+    return;
+
+  rows = gtk_tree_selection_get_selected_rows (sel, NULL);
+  ids  = g_array_new (FALSE, FALSE, sizeof (guint));
+
+  for (GList *l = rows; l; l = l->next)
+    {
+      guint            id = strip_id_at (strip, l->data);
+      ChopGimpVObject *o  = chopgimp_vlayer_get_object (strip->layer, id);
+
+      if (! o)
+        continue;
+
+      if (ids->len == 0)
+        parent = o->parent;
+      else if (o->parent != parent)
+        same = FALSE;
+
+      g_array_append_val (ids, id);
+    }
+
+  g_list_free_full (rows, (GDestroyNotify) gtk_tree_path_free);
+
+  strip->updating = TRUE;
+
+  /*  objects of a group: the move tool works « inside » it, as after a
+   *  double click on the canvas
+   */
+  chopgimp_vlayer_enter_group (strip->layer,
+                               (same && parent && parent->parent) ? parent->id : 0);
+  chopgimp_vlayer_set_selection (strip->layer, (guint *) ids->data, ids->len);
+
+  strip->updating = FALSE;
+
+  g_array_free (ids, TRUE);
+
+  strip_flush (strip);
+}
+
+static void
+strip_layer_selection_changed (GimpVectorLayer      *layer,
+                               ChopGimpObjectsStrip *strip)
+{
+  if (! strip->updating)
+    strip_queue_sync (strip);
+}
+
+static void
+strip_layer_objects_changed (GimpVectorLayer      *layer,
+                             gpointer              dirty,
+                             ChopGimpObjectsStrip *strip)
+{
+  strip_queue_rebuild (strip);
+}
+
+static gboolean
+strip_button_press (GtkWidget            *widget,
+                    GdkEventButton       *bevent,
+                    ChopGimpObjectsStrip *strip)
+{
+  GtkTreeView       *view = GTK_TREE_VIEW (widget);
+  GtkTreePath       *path = NULL;
+  GtkTreeViewColumn *column = NULL;
+  ChopGimpVObject   *o;
+  guint              id;
+
+  if (bevent->button != 1 || bevent->type != GDK_BUTTON_PRESS ||
+      bevent->window != gtk_tree_view_get_bin_window (view) || ! strip->layer)
+    return FALSE;
+
+  if (! gtk_tree_view_get_path_at_pos (view, bevent->x, bevent->y,
+                                       &path, &column, NULL, NULL))
+    return FALSE;
+
+  id = strip_id_at (strip, path);
+  gtk_tree_path_free (path);
+
+  o = chopgimp_vlayer_get_object (strip->layer, id);
+
+  if (! o)
+    return FALSE;
+
+  if (column == strip->eye_column)
+    {
+      chopgimp_vlayer_set_props (strip->layer, id, NULL, -1, -1,
+                                 ! o->visible, -1, TRUE);
+      strip_flush (strip);
+      return TRUE;
+    }
+  else if (column == strip->lock_column)
+    {
+      chopgimp_vlayer_set_props (strip->layer, id, NULL, -1, -1,
+                                 -1, ! o->locked, TRUE);
+      strip_flush (strip);
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+static void
+strip_row_activated (GtkTreeView          *view,
+                     GtkTreePath          *path,
+                     GtkTreeViewColumn    *column,
+                     ChopGimpObjectsStrip *strip)
+{
+  GtkTreeIter iter;
+  gchar      *raw = NULL;
+
+  if (column == strip->eye_column || column == strip->lock_column)
+    return;
+
+  /*  the raw name in the entry, not « Objet 3 (vide) »  */
+  if (gtk_tree_model_get_iter (GTK_TREE_MODEL (strip->store), &iter, path))
+    {
+      gtk_tree_model_get (GTK_TREE_MODEL (strip->store), &iter, COL_RAW_NAME, &raw, -1);
+      gtk_tree_store_set (strip->store, &iter, COL_NAME, raw, -1);
+      g_free (raw);
+    }
+
+  g_object_set (strip->name_cell, "editable", TRUE, NULL);
+  gtk_tree_view_set_cursor_on_cell (view, path, strip->name_column,
+                                    strip->name_cell, TRUE);
+}
+
+static void
+strip_name_edited (GtkCellRendererText  *cell,
+                   const gchar          *path_str,
+                   const gchar          *new_text,
+                   ChopGimpObjectsStrip *strip)
+{
+  GtkTreePath *path = gtk_tree_path_new_from_string (path_str);
+  guint        id   = strip_id_at (strip, path);
+
+  gtk_tree_path_free (path);
+  g_object_set (cell, "editable", FALSE, NULL);
+
+  if (strip->layer && id)
+    {
+      ChopGimpVObject *o = chopgimp_vlayer_get_object (strip->layer, id);
+
+      if (o && g_strcmp0 (o->name, new_text))
+        {
+          chopgimp_vlayer_set_props (strip->layer, id, new_text, -1, -1, -1, -1, TRUE);
+          strip_flush (strip);
+        }
+    }
+
+  strip_rebuild (strip, TRUE);
+}
+
+static void
+strip_name_canceled (GtkCellRenderer      *cell,
+                     ChopGimpObjectsStrip *strip)
+{
+  g_object_set (cell, "editable", FALSE, NULL);
+  strip_rebuild (strip, TRUE);
+}
+
+static void
+strip_row_expanded (GtkTreeView          *view,
+                    GtkTreeIter          *iter,
+                    GtkTreePath          *path,
+                    ChopGimpObjectsStrip *strip)
+{
+  guint id;
+
+  gtk_tree_model_get (GTK_TREE_MODEL (strip->store), iter, COL_ID, &id, -1);
+  g_hash_table_add (strip->expanded, GUINT_TO_POINTER (id));
+}
+
+static void
+strip_row_collapsed (GtkTreeView          *view,
+                     GtkTreeIter          *iter,
+                     GtkTreePath          *path,
+                     ChopGimpObjectsStrip *strip)
+{
+  guint id;
+
+  gtk_tree_model_get (GTK_TREE_MODEL (strip->store), iter, COL_ID, &id, -1);
+  g_hash_table_remove (strip->expanded, GUINT_TO_POINTER (id));
+}
