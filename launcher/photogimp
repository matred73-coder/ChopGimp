#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# PhotoGIMP Pro v2 — lanceur
# Lance GIMP (Snap) avec la barre de menus « Photoshop ».
# Si GIMP a été mis à jour, les menus sont régénérés à partir des
# nouveaux menus GIMP ; en cas d'échec, GIMP démarre avec ses menus
# d'origine (jamais de plantage dû aux menus).
# ═══════════════════════════════════════════════════════════════

PG_DIR="$HOME/.config/GIMP/3.2/photogimp"
MENUS="$PG_DIR/menus"
STAMP="$PG_DIR/menus.stamp"
SRC_MENUS="/snap/gimp/current/usr/share/gimp/3.0/menus"
GIMP_BIN="/snap/bin/gimp"

# Lancé depuis une autre application Snap (ex. terminal de VS Code), on hérite
# de son environnement GTK : ses décodeurs d'images (sans SVG) font disparaître
# toutes les icônes. On restaure les valeurs d'origine et on retire le reste.
for v in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)_VSCODE_SNAP_ORIG=.*/\1/p'); do
    orig="${v}_VSCODE_SNAP_ORIG"
    if [ -n "${!orig}" ]; then export "$v=${!orig}"; else unset "$v"; fi
    unset "$orig"
done
unset GDK_PIXBUF_MODULE_FILE GDK_PIXBUF_MODULEDIR GTK_PATH GTK_EXE_PREFIX \
      GTK_IM_MODULE_FILE GIO_MODULE_DIR LOCPATH GSETTINGS_SCHEMA_DIR

current="$(readlink -f /snap/gimp/current 2>/dev/null)"

if [ -d "$SRC_MENUS" ] && [ "$(cat "$STAMP" 2>/dev/null)" != "$current" ]; then
    rm -rf "$MENUS.tmp"
    if python3 -I "$PG_DIR/build_menus.py" "$SRC_MENUS" "$MENUS.tmp" >/dev/null 2>"$PG_DIR/menus.log"; then
        rm -rf "$MENUS" && mv "$MENUS.tmp" "$MENUS" && echo "$current" > "$STAMP"
    else
        rm -rf "$MENUS.tmp" "$MENUS" "$STAMP"
    fi
fi

if [ -f "$MENUS/image-menu.ui" ]; then
    export GIMP_TESTING_MENUS_PATH="$MENUS"
fi

exec "$GIMP_BIN" "$@"
