# GIMP tool preset file — PhotoGIMP Pro

(icon-name "gimp-tool-pencil")
(name "Crayon 1 px")
(tool-options "GimpPencilOptions"
    (tool "gimp-pencil-tool")
    (brush "2. Hardness 100")
    (dynamics-enabled no)
    (brush-size 1.0)
    (opacity 1.00)
)
(use-fg-bg no)
(use-brush yes)
(use-dynamics yes)
(use-gradient no)
(use-pattern no)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
