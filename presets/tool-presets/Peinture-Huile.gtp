# GIMP tool preset file — ChopGimp

(icon-name "gimp-tool-paintbrush")
(name "Huile (texture toile)")
(tool-options "GimpPaintOptions"
    (tool "gimp-paintbrush-tool")
    (brush "Oils 02")
    (dynamics "Pressure Opacity")
    (brush-size 70.000000)
    (opacity 1.000000)
    (pattern "Burlap")
    (paper-texture yes)
    (paper-strength 0.550000)
    (paper-scale 1.000000)
    (dynamics-enabled yes))
(use-fg-bg no)
(use-brush yes)
(use-dynamics yes)
(use-gradient no)
(use-pattern yes)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
