# GIMP tool preset file — PhotoGIMP Pro

(icon-name "gimp-tool-heal")
(name "Correcteur")
(tool-options "GimpSourceOptions"
    (tool "gimp-heal-tool")
    (brush "2. Hardness 075")
    (dynamics-enabled no)
    (brush-size 30.0)
    (opacity 1.00)
)
(use-fg-bg no)
(use-brush yes)
(use-dynamics yes)
(use-gradient no)
(use-pattern no)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
