# GIMP tool preset file — PhotoGIMP Pro

(icon-name "gimp-tool-clone")
(name "Tampon de duplication (aligné)")
(tool-options "GimpCloneOptions"
    (tool "gimp-clone-tool")
    (brush "2. Hardness 050")
    (dynamics-enabled no)
    (brush-size 50.0)
    (opacity 1.00)
    (align-mode aligned)
)
(use-fg-bg no)
(use-brush yes)
(use-dynamics yes)
(use-gradient no)
(use-pattern no)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
