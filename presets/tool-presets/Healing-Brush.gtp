# GIMP tool preset file

(icon-name "gimp-tool-heal")
(name "Healing Brush")
(tool-options "GimpHealOptions"
    (tool "gimp-heal-tool")
    (foreground (color-rgb 0.000000 0.000000 0.000000))
    (brush "2. Hardness 050")
    (dynamics "Pressure Opacity")
    (brush-size 60.000000)
    (sample-merged yes)
    (alignment none))
(use-fg-bg no)
(use-brush yes)
(use-dynamics yes)
(use-gradient no)
(use-pattern no)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
