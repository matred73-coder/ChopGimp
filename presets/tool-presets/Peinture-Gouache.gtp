# GIMP tool preset file — ChopGimp

(icon-name "gimp-tool-paintbrush")
(name "Gouache")
(tool-options "GimpPaintOptions"
    (tool "gimp-paintbrush-tool")
    (brush "Acrylic 01")
    (dynamics "Pressure Size")
    (brush-size 45.000000)
    (opacity 0.950000)
    (pattern "Paper")
    (paper-texture yes)
    (paper-strength 0.300000)
    (paper-scale 1.000000)
    (dynamics-enabled yes))
(use-fg-bg no)
(use-brush yes)
(use-dynamics yes)
(use-gradient no)
(use-pattern yes)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
