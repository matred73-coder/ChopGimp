# GIMP tool preset file

(icon-name "gimp-tool-eraser")
(name "Eraser Hard")
(tool-options "GimpEraserOptions"
    (tool "gimp-eraser-tool")
    (brush "2. Hardness 100")
    (dynamics "Pressure Opacity")
    (brush-size 30.000000)
    (hard yes)
    (anti-erase no))
(use-fg-bg no)
(use-brush yes)
(use-dynamics yes)
(use-gradient no)
(use-pattern no)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
