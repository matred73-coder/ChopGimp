# GIMP tool preset file — PhotoGIMP Pro

(icon-name "gimp-tool-eraser")
(name "Gomme ronde dure")
(tool-options "GimpEraserOptions"
    (tool "gimp-eraser-tool")
    (brush "2. Hardness 100")
    (dynamics-enabled no)
    (brush-size 40.0)
    (opacity 1.00)
)
(use-fg-bg no)
(use-brush yes)
(use-dynamics yes)
(use-gradient no)
(use-pattern no)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
