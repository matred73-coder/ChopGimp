# GIMP tool preset file — ChopGimp

(icon-name "gimp-tool-smudge")
(name "Pinceau mélangeur (sec)")
(tool-options "GimpSmudgeOptions"
    (tool "gimp-smudge-tool")
    (brush "Bristles 02")
    (dynamics "Pressure Opacity")
    (brush-size 40.000000)
    (opacity 1.000000)
    (rate 30.0)
    (flow 0.0)
    (no-erasing yes)
    (dynamics-enabled yes))
(use-fg-bg no)
(use-brush yes)
(use-dynamics yes)
(use-gradient no)
(use-pattern no)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
