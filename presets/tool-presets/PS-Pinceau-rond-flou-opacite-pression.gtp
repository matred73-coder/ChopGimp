# GIMP tool preset file — PhotoGIMP Pro

(icon-name "gimp-tool-paintbrush")
(name "Pinceau rond flou (opacité pression)")
(tool-options "GimpPaintOptions"
    (tool "gimp-paintbrush-tool")
    (brush "2. Hardness 025")
    (dynamics "Pressure Opacity")
    (dynamics-enabled yes)
    (brush-size 60.0)
    (opacity 1.00)
)
(use-fg-bg no)
(use-brush yes)
(use-dynamics yes)
(use-gradient no)
(use-pattern no)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
